// Bounded RFC 9000 wire parsers. All peer input errors are recoverable values.
use "errors" as errors

public constant MAX_VARINT = 0x3fffffffffffffff
public constant INITIAL = 0
public constant ZERO_RTT = 1
public constant HANDSHAKE = 2
public constant RETRY = 3
public constant ONE_RTT = 4
public constant VERSION_NEGOTIATION = 5
constant VERSION_2 = 0x6b3343cf

public record Varint {
    valid: Boolean
    value: Integer
    end: Integer
}
public function varint(data: Bytes, at: Integer): Varint {
    if at < 0 || at >= data.length { return Varint { valid: false; value: 0; end: at } }
    let length = 1 << (data[at] >> 6)
    if length > data.length - at { return Varint { valid: false; value: 0; end: at } }
    let value = data[at] & 63
    for index in 1..length { value = (value << 8) | data[at + index] }
    return Varint { valid: true; value: value; end: at + length }
}
public function encode(value: Integer): errors.BytesResult {
    if value < 0 || value > MAX_VARINT { return errors.bytesFailure(errors.make(errors.invalidDataCode(), 0, "QUIC integer is outside the 62-bit range")) }
    let length = 1
    let prefix = 0
    if value > 63 { length = 2; prefix = 64 }
    if value > 16383 { length = 4; prefix = 128 }
    if value > 0x3fffffff { length = 8; prefix = 192 }
    let result = Bytes(length)
    for index in 0..length { result[length - 1 - index] = (value >> (index * 8)) & 255 }
    result[0] = result[0] | prefix
    return errors.bytes(result)
}

record Cursor {
    data: Bytes
    at: Integer
    bad: Boolean
}
function integer(cursor: Cursor): Integer {
    if cursor.bad { return 0 }
    let result = varint(cursor.data, cursor.at)
    if !result.valid { cursor.bad = true; return 0 }
    cursor.at = result.end
    return result.value
}
function octet(cursor: Cursor): Integer {
    if cursor.bad || cursor.at >= cursor.data.length { cursor.bad = true; return 0 }
    let result = cursor.data[cursor.at]; cursor.at += 1
    return result
}
function take(cursor: Cursor, length: Integer): Bytes {
    if cursor.bad || length < 0 || length > cursor.data.length - cursor.at { cursor.bad = true; return Bytes() }
    let result = cursor.data.slice(cursor.at, cursor.at + length)
    cursor.at += length
    return result
}
function error(message: Text): errors.Error { return errors.make(errors.protocolCode(), 0, message) }

public record Header {
    valid: Boolean
    kind: Integer
    version: Integer
    destination: Bytes
    source: Bytes
    token: Bytes
    numberOffset: Integer
    end: Integer
    error: errors.Error
}
function badHeader(message: Text): Header {
    return Header { valid: false; kind: -1; version: 0; destination: Bytes(); source: Bytes(); token: Bytes(); numberOffset: 0; end: 0; error: error(message) }
}
// Routing metadata only: connection IDs are unprotected and unauthenticated.
// Do not allocate authentication/application state based on this result.
public function destinationId(data: Bytes, shortDestinationLength: Integer): errors.BytesResult {
    if data.length < 1 || data.length > 65535 || shortDestinationLength < 0 || shortDestinationLength > 20 {
        return errors.bytesFailure(error("invalid routing header bounds"))
    }
    if (data[0] & 128) == 0 {
        if (data[0] & 64) == 0 || data.length < 1 + shortDestinationLength { return errors.bytesFailure(error("truncated routing short header")) }
        return errors.bytes(data.slice(1, 1 + shortDestinationLength))
    }
    if data.length < 6 || data[5] > 20 || data[5] > data.length - 6 { return errors.bytesFailure(error("truncated routing long header")) }
    return errors.bytes(data.slice(6, 6 + data[5]))
}
// Stateless server response. Unknown-version Initial-sized datagrams receive
// the supported live version, with source/destination CIDs swapped (RFC 9000
// Section 6). Recognized versions and truncated/small packets get no response.
public function negotiateVersion(data: Bytes): errors.BytesResult {
    if data.length < 1200 || data.length > 65535 || (data[0] & 128) == 0 { return errors.bytesFailure(error("not an unsupported-version Initial")) }
    let version = 0; for index in 1..5 { version = (version << 8) | data[index] }
    if version == 0 || version == 1 { return errors.bytesFailure(error("no version negotiation required")) }
    let cursor = Cursor { data: data; at: 5; bad: false }
    let size = octet(cursor); if size > 20 { return errors.bytesFailure(error("invalid negotiation destination CID")) }
    let destination = take(cursor, size); size = octet(cursor)
    if size > 20 { return errors.bytesFailure(error("invalid negotiation source CID")) }
    let source = take(cursor, size)
    if cursor.bad { return errors.bytesFailure(error("truncated version negotiation request")) }
    let result = Bytes(); result.add(128 | (randomBytes(1)[0] & 127))
    result.addBytes(Bytes(4)); result.add(source.length); result.addBytes(source)
    result.add(destination.length); result.addBytes(destination); result.addBytes(Bytes(3)); result.add(1)
    return errors.bytes(result)
}
public function header(data: Bytes, start: Integer, shortDestinationLength: Integer): Header {
    if start < 0 || start >= data.length || data.length > 65535 || shortDestinationLength < 0 || shortDestinationLength > 20 { return badHeader("invalid QUIC datagram size or offset") }
    let cursor = Cursor { data: data; at: start; bad: false }
    let first = octet(cursor)
    if (first & 128) == 0 {
        if (first & 64) == 0 { return badHeader("invalid short header fixed bit") }
        let destination = take(cursor, shortDestinationLength)
        if cursor.bad || data.length - cursor.at < 20 { return badHeader("truncated short header packet") }
        return Header { valid: true; kind: ONE_RTT; version: 0; destination: destination; source: Bytes(); token: Bytes(); numberOffset: cursor.at; end: data.length; error: errors.none() }
    }
    let version = 0
    for index in 0..4 { version = (version << 8) | octet(cursor) }
    let length = octet(cursor)
    if length > 20 { return badHeader("destination connection ID exceeds 20 bytes") }
    let destination = take(cursor, length)
    length = octet(cursor)
    if length > 20 { return badHeader("source connection ID exceeds 20 bytes") }
    let source = take(cursor, length)
    if cursor.bad { return badHeader("truncated long header") }
    if version == 0 {
        if data.length - cursor.at < 4 || (data.length - cursor.at) % 4 != 0 { return badHeader("invalid version negotiation list") }
        return Header { valid: true; kind: VERSION_NEGOTIATION; version: 0; destination: destination; source: source; token: take(cursor, data.length - cursor.at); numberOffset: 0; end: data.length; error: errors.none() }
    }
    if version != 1 && version != VERSION_2 { return badHeader("unsupported QUIC version") }
    if (first & 64) == 0 { return badHeader("invalid long header fixed bit") }
    let kind = (first >> 4) & 3
    if version == VERSION_2 { kind = (kind + 3) & 3 }
    let token = Bytes()
    if kind == RETRY {
        if data.length - cursor.at <= 16 { return badHeader("empty or truncated Retry token") }
        token = take(cursor, data.length - cursor.at - 16)
        return Header { valid: true; kind: RETRY; version: version; destination: destination; source: source; token: token; numberOffset: 0; end: data.length; error: errors.none() }
    }
    if kind == INITIAL { token = take(cursor, integer(cursor)) }
    length = integer(cursor)
    if cursor.bad || length < 20 || length > data.length - cursor.at { return badHeader("truncated protected long header packet") }
    return Header { valid: true; kind: kind; version: version; destination: destination; source: source; token: token; numberOffset: cursor.at; end: cursor.at + length; error: errors.none() }
}

public record Range { first: Integer; last: Integer }
public record Frame {
    type: Integer
    stream: Integer
    offset: Integer
    fin: Boolean
    value: Integer
    values: List<Integer>
    ranges: List<Range>
    data: Bytes
}
public record Frames {
    valid: Boolean
    frames: List<Frame>
    error: errors.Error
}
function badFrames(message: Text): Frames { return Frames { valid: false; frames: []; error: error(message) } }
public function frames(data: Bytes): Frames {
    if data.length > 65535 { return badFrames("QUIC payload exceeds maximum datagram size") }
    let cursor = Cursor { data: data; at: 0; bad: false }
    let result: List<Frame> = []
    while cursor.at < data.length && !cursor.bad {
        if result.length >= 4096 { return badFrames("too many QUIC frames in one packet") }
        let start = cursor.at
        let type = integer(cursor)
        // Frame types, uniquely among QUIC integer fields, must be minimal.
        if cursor.bad || cursor.at != start + 1 || type > 30 { return badFrames("unknown or nonminimal frame type") }
        let frame = Frame { type: type; stream: 0; offset: 0; fin: false; value: 0; values: []; ranges: []; data: Bytes() }
        if type == 0 {
            while cursor.at < data.length && data[cursor.at] == 0 { cursor.at += 1 }
        } else if type == 2 || type == 3 {
            let largest = integer(cursor); let delay = integer(cursor); let count = integer(cursor); let range = integer(cursor)
            if cursor.bad || range > largest || count > 256 { return badFrames("invalid ACK range or count") }
            frame.value = largest; frame.values.add(delay)
            let low = largest - range
            frame.ranges.add(Range { first: low; last: largest })
            for index in 0..count {
                let gap = integer(cursor); range = integer(cursor)
                if cursor.bad || low < 2 || gap > low - 2 { return badFrames("ACK gap underflow") }
                let high = low - gap - 2
                if range > high { return badFrames("ACK range underflow") }
                low = high - range
                frame.ranges.add(Range { first: low; last: high })
            }
            if type == 3 { for index in 0..3 { frame.values.add(integer(cursor)) } }
        } else if type == 4 {
            frame.stream = integer(cursor); frame.value = integer(cursor); frame.offset = integer(cursor)
        } else if type == 5 {
            frame.stream = integer(cursor); frame.value = integer(cursor)
        } else if type == 6 {
            frame.offset = integer(cursor); let length = integer(cursor)
            if length > MAX_VARINT - frame.offset { return badFrames("CRYPTO offset overflow") }
            frame.data = take(cursor, length)
        } else if type == 7 {
            let length = integer(cursor)
            if length == 0 { return badFrames("NEW_TOKEN must not be empty") }
            frame.data = take(cursor, length)
        } else if type >= 8 && type <= 15 {
            frame.stream = integer(cursor); frame.fin = (type & 1) != 0
            if (type & 4) != 0 { frame.offset = integer(cursor) }
            let length = data.length - cursor.at
            if (type & 2) != 0 { length = integer(cursor) }
            if length > MAX_VARINT - frame.offset { return badFrames("STREAM offset overflow") }
            frame.data = take(cursor, length)
        } else if type == 16 || type == 18 || type == 19 || type == 20 || type == 22 || type == 23 || type == 25 {
            frame.value = integer(cursor)
            if (type == 18 || type == 19 || type == 22 || type == 23) && frame.value > (1 << 60) { return badFrames("stream count exceeds 60-bit limit") }
        } else if type == 17 || type == 21 {
            frame.stream = integer(cursor); frame.value = integer(cursor)
        } else if type == 24 {
            frame.value = integer(cursor); frame.offset = integer(cursor)
            let length = octet(cursor)
            if frame.offset > frame.value || length < 1 || length > 20 { return badFrames("invalid NEW_CONNECTION_ID") }
            frame.data = take(cursor, length + 16)
        } else if type == 26 || type == 27 { frame.data = take(cursor, 8) }
        else if type == 28 || type == 29 {
            frame.value = integer(cursor)
            if type == 28 { frame.offset = integer(cursor) }
            frame.data = take(cursor, integer(cursor))
        }
        if cursor.bad { return badFrames("truncated QUIC frame") }
        result.add(frame)
    }
    return Frames { valid: true; frames: result; error: errors.none() }
}

public function allowed(frame: Frame, level: Integer, receivingServer: Boolean): Boolean {
    let type = frame.type
    if level == INITIAL || level == HANDSHAKE { return type == 0 || type == 1 || type == 2 || type == 3 || type == 6 || type == 28 }
    if level == ZERO_RTT && (type == 2 || type == 3 || type == 6 || type == 7 || type == 27 || type == 30) { return false }
    if receivingServer && (type == 7 || type == 30) { return false }
    return level == ZERO_RTT || level == ONE_RTT
}

public record Parameter { id: Integer; value: Bytes; integer: Integer }
public record Parameters { valid: Boolean; parameters: List<Parameter>; error: errors.Error }
function badParameters(message: Text): Parameters { return Parameters { valid: false; parameters: []; error: error(message) } }
public function parameters(data: Bytes, fromServer: Boolean): Parameters {
    if data.length > 65535 { return badParameters("QUIC transport parameters exceed size limit") }
    let cursor = Cursor { data: data; at: 0; bad: false }
    let result: List<Parameter> = []
    let initialSource = false
    while cursor.at < data.length {
        if result.length >= 128 { return badParameters("too many transport parameters") }
        let id = integer(cursor); let length = integer(cursor); let value = take(cursor, length)
        if cursor.bad { return badParameters("truncated transport parameter") }
        for previous in result { if previous.id == id { return badParameters("duplicate transport parameter") } }
        if !fromServer && (id == 0 || id == 2 || id == 13 || id == 16) { return badParameters("client sent server-only transport parameter") }
        let decoded = 0
        if (id >= 1 && id <= 11 && id != 2) || id == 14 {
            let number = varint(value, 0)
            if !number.valid || number.end != value.length { return badParameters("invalid integer transport parameter") }
            decoded = number.value
            if (id == 3 && decoded < 1200) || (id == 10 && decoded > 20) || (id == 11 && decoded >= 16384) || (id == 14 && decoded < 2) || ((id == 8 || id == 9) && decoded > (1 << 60)) { return badParameters("transport parameter value outside RFC bounds") }
        } else if id == 0 || id == 15 || id == 16 {
            if value.length > 20 { return badParameters("transport connection ID exceeds 20 bytes") }
            if id == 15 { initialSource = true }
        } else if id == 2 {
            if value.length != 16 { return badParameters("invalid stateless reset token length") }
        } else if id == 12 {
            if value.length != 0 { return badParameters("disable_active_migration must be empty") }
        } else if id == 13 {
            if value.length < 41 || value[24] < 1 || value[24] > 20 || value.length != 41 + value[24] { return badParameters("invalid preferred address") }
        }
        result.add(Parameter { id: id; value: value; integer: decoded })
    }
    if !initialSource { return badParameters("missing initial_source_connection_id") }
    return Parameters { valid: true; parameters: result; error: errors.none() }
}
