// Checked DMA capabilities. Cpu/Pending moves and primitive borrows are compiler
// rules, not reference-count properties. Handles are managed records and allocate.
// Use only from one serialized boot CPU, outside interrupt context. Hardware
// backends require coherent, identity-mapped storage; fences do not map an IOMMU
// or maintain noncoherent caches. Raw machine/native access is outside this API.

public record Cpu native "dma_cpu" {}
public record Pending native "dma_pending" {}
public record Queue native "dma_queue" {}

// Fresh exclusive zeroed storage. No existing Bytes/Memory/address can be adopted.
public function allocate(size: Integer, alignment: Integer): Cpu { native "dma" }

// Nonescaping borrows. A reclaimed CPU buffer exposes only the completed prefix.
public function load8(cpu: Cpu, offset: Integer): Integer { native "dma" }
public function store8(cpu: Cpu, offset: Integer, value: Integer) { native "dma" }
public function copyOut(cpu: Cpu, offset: Integer, count: Integer): Bytes { native "dma" }

// Consumes Cpu. Hardware-exposed backing stays pinned until VM exit even here.
public function dispose(cpu: Cpu) { native "dma" }

// Consumes Cpu; the device writes at most length bytes. No payload/address access
// exists on Pending. A queue holds one outstanding request per slot (model rings
// have up to 64; the virtio bridge has one); each Pending checks its own slot.
public function submit(queue: Queue, cpu: Cpu, length: Integer): Pending { native "dma" }

// Borrows Pending; reads device completion and acquires it, never trusts an IRQ.
public function ready(pending: Pending): Boolean { native "dma" }

// Consumes Pending. One initial check plus at most maxSpins retries (0..1000000).
// Timeout quarantines backing and stops; it never returns CPU ownership or frees
// live DMA. Only a validated private completion witness can return Cpu.
public function reclaim(pending: Pending, maxSpins: Integer): Cpu { native "dma" }

// Consumes Pending into permanent quarantine. Does not cancel, reset, free or
// reuse a possibly live allocation or queue. There is no safe-close API yet.
public function retire(pending: Pending) { native "dma" }
