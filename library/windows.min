// Native Windows controls. See docs/windows.md. All calls use the owning UI thread.
public constant NONE = 0
public constant ACTION = 1
public constant CHANGE = 2
public constant CLOSED = 3
public constant RESIZED = 4
public constant QUIT = 5
public constant SUBMIT = 6

public function initialize(name: Text) { native "windows" }
public function window(title: Text, width: Integer, height: Integer): Integer { native "windows" }
public function show(window: Integer) { native "windows" }
public function hide(window: Integer) { native "windows" }
public function close(window: Integer) { native "windows" }
public function destroy(handle: Integer) { native "windows" }
public function column(parent: Integer, spacing: Integer): Integer { native "windows" }
public function row(parent: Integer, spacing: Integer): Integer { native "windows" }
public function padding(container: Integer, points: Integer) { native "windows" }
public function label(parent: Integer, text: Text): Integer { native "windows" }
public function button(parent: Integer, text: Text): Integer { native "windows" }
public function textField(parent: Integer, text: Text): Integer { native "windows" }
public function checkbox(parent: Integer, text: Text, checked: Boolean): Integer { native "windows" }
// Sizes and font weights use the macOS bridge's 1..1000 ranges; 400 is regular.
public function font(handle: Integer, family: Text, size: Float, weight: Float) { native "windows" }
public function text(handle: Integer): Text { native "windows" }
// Programmatic changes do not enqueue CHANGE.
public function setText(handle: Integer, text: Text) { native "windows" }
public function checked(checkbox: Integer): Boolean { native "windows" }
public function setChecked(checkbox: Integer, checked: Boolean) { native "windows" }
// Windows menu bars belong to a specific window. key must currently be empty.
public function menu(window: Integer, title: Text): Integer { native "windows" }
public function menuItem(menu: Integer, title: Text, key: Text): Integer { native "windows" }
public function menuSeparator(menu: Integer) { native "windows" }
// Hide/show windows in the taskbar. Tray icons remain available.
public function accessory(enabled: Boolean): Boolean { native "windows" }
// Uses the application icon; symbol is reserved for future platform icon mapping.
public function statusItem(title: Text, symbol: Text): Integer { native "windows" }
public function statusMenu(item: Integer): Integer { native "windows" }
public function statusRemove(item: Integer) { native "windows" }
// Timeout yields NONE. False after QUIT. Native message dispatch stays bounded.
public function nextEvent(timeout: Float): Boolean { native "windows" }
public function eventType(): Integer { native "windows" }
public function eventSource(): Integer { native "windows" }
public function eventText(): Text { native "windows" }
public function quit() { native "windows" }
