// Narrow native AES primitive provider. QUIC packet/transport logic is Minyar.
// decrypt returns a private status byte followed by authenticated plaintext;
// callers use quiccrypto, which exposes a recoverable BytesResult instead.
public function encrypt(key: Bytes, nonce: Bytes, additional: Bytes, plaintext: Bytes): Bytes { native "aes" }
public function decrypt(key: Bytes, nonce: Bytes, additional: Bytes, ciphertext: Bytes): Bytes { native "aes" }
public function block(key: Bytes, plaintext: Bytes): Bytes { native "aes" }
