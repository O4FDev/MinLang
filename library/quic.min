function advanceWrite(connection: Connection, space: Space) {
    space.write = protection.update(space.write); space.writeGeneration += 1; space.writeFirst = space.next; space.writePackets = 0; space.writeUpdatedAt = connection.now
}
public function updateKeys(connection: Connection): errors.BooleanResult {
    let space = connection.spaces[2]
    if connection.state != ESTABLISHED || !connection.confirmed || space.largestAck < space.writeFirst || space.writeGeneration > space.readGeneration ||
       (space.writeUpdatedAt >= 0 && connection.now - space.writeUpdatedAt < 3 * recovery.pto(connection.congestion, true)) {
        return errors.booleanFailure(errors.make(errors.wouldBlockCode(), 0, "QUIC key update awaits handshake/ACK/reordering confirmation"))
    }
    advanceWrite(connection, space)
    return errors.boolean(true)
}
public function ping(connection: Connection): errors.BooleanResult {
    if connection.state != ESTABLISHED { return errors.booleanFailure(errors.make(errors.unavailableCode(), 0, "QUIC ping awaits authentication")) }
    enqueue(connection, 2, crypto.fromHex("01"), false)
    return errors.boolean(connection.state == ESTABLISHED)
}
public function nextTimer(connection: Connection): Integer {
    if connection.state == FAILED || connection.state == CLOSED { return -1 }
    if connection.now < 0 { return 0 }
    let deadline = connection.lastActivity + connection.idleTimeout
    for space in connection.spaces { if space.active && space.sent.length > 0 && space.probe >= 0 { deadline = min(deadline, space.probe) } }
    for path in connection.paths { if path.deadline >= 0 { deadline = min(deadline, path.deadline) } }
    return deadline
}
function pathIndex(connection: Connection, id: Integer): Integer {
    for index in 0..connection.paths.length { if connection.paths[index].id == id { return index } }
    return -1
}
function challengePath(connection: Connection, path: Path) {
    let frame = Bytes(); add(frame, 26); frame.addBytes(path.challenge)
    enqueuePath(connection, 2, frame, true, path.id); path.attempts += 1
    path.deadline = connection.now + recovery.pto(connection.congestion, true)
}
function candidatePath(connection: Connection, id: Integer, local: Boolean): Integer {
    let retained: List<Path> = []
    for path in connection.paths {
        if path.id == connection.activePath { retained.add(path) }
        else if path.challenge.length == 8 { return -1 }
    }
    let path = Path { id: id; validated: false; eligible: local; challenge: randomBytes(8); deadline: -1; attempts: 0; received: 0; sent: 0 }
    retained.add(path); connection.paths = retained; challengePath(connection, path)
    return retained.length - 1
