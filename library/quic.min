        let space = connection.spaces[level]
        if space.active && space.sent.length > 0 && space.probe >= 0 && (level < 2 || connection.confirmed) { deadline = min(deadline,space.probe) }
        if space.active && space.ack && !space.ackQueued && space.ackDeadline >= 0 && space.write.key.length > 0 &&
           (level != 2 || connection.state == ESTABLISHED) { deadline = min(deadline,space.ackDeadline) }
        if space.active { for sent in space.sent { if sent.number <= recoveryAck(connection,space,sent) { deadline = min(deadline,sent.time + recovery.lossDelay(connection.congestion)) } } }
    }
    for path in connection.paths { if path.deadline >= 0 { deadline = min(deadline, path.deadline) } }
