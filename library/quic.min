        }
        let pathAt = pathIndex(connection, pathId)
        if pathAt < 0 {
            if level == 0 && connection.state == STARTING && connection.spaces[0].largest < 0 && connection.paths.length == 1 && connection.paths[0].received == 0 {
                connection.paths[0].id = pathId; connection.activePath = pathId; pathAt = 0
            } else {
                if level != 2 || !connection.confirmed { continue }
                pathAt = candidatePath(connection, pathId, false)
            }
            if pathAt < 0 { continue }
        }
        let path = connection.paths[pathAt]
        if !countedPath { path.received += datagram.length; countedPath = true }
        connection.lastActivity = now
        let parsed = wire.frames(packet.payload)
        if !parsed.valid || parsed.frames.length == 0 { terminate(connection, 7, "malformed or empty QUIC payload"); return }
        if packet.number > space.largest && path.id != connection.activePath {
            for frame in parsed.frames { if frame.type != 0 && frame.type != 24 && frame.type != 26 && frame.type != 27 { path.eligible = true } }
            if path.validated && path.eligible { connection.activePath = path.id; connection.congestion = recovery.create(1200) }
        }
