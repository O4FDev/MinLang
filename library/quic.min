// Cancel the application context without bypassing RESET final-size or ACK
// accounting. Protocol state stays bounded until the peer completes reset.
public function cancelStream(connection: Connection, id: Integer, code: Integer): errors.BooleanResult {
    if code < 0 || code > wire.MAX_VARINT { return errors.booleanFailure(errors.make(errors.invalidDataCode(),0,"invalid stream application error")) }
    let index = streamIndex(connection,id)
    if connection.state != ESTABLISHED || index < 0 { return errors.booleanFailure(errors.make(errors.closedCode(),0,"stream is unavailable")) }
    let input = connection.streams[index]
    if (id & 2) == 0 || localInitiated(connection,id) { resetSend(connection,input,code) }
    if (id & 2) == 0 || !localInitiated(connection,id) { stopSending(connection,id,code); input.receiveObserved = true }
    input.cancelled = true
    if connection.state != ESTABLISHED { return errors.booleanFailure(errors.make(errors.protocolCode(),0,connection.error)) }
    return errors.boolean(true)
}

public function close(connection: Connection, code: Integer, reason: Bytes): errors.BooleanResult {
    if code < 0 || code > wire.MAX_VARINT || reason.length > 1024 { return errors.booleanFailure(errors.make(errors.invalidDataCode(), 0, "invalid QUIC close code or reason")) }
    if connection.state == CLOSED || connection.state == FAILED { return errors.boolean(true) }
    if connection.state != ESTABLISHED { terminate(connection, code, Text(reason)); return errors.boolean(true) }
    connection.pending = []
