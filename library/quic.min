public function probePreferredPath(connection: Connection, pathId: Integer, now: Integer): errors.BooleanResult {
    if !connection.peerPreferred.valid || remoteRetired(connection,1) {
        return errors.booleanFailure(errors.make(errors.unavailableCode(),0,"authenticated preferred address is unavailable"))
    }
    return probePath(connection,pathId,now)
