function packetHeader(connection: Connection, level: Integer, length: Integer, number: Integer): Bytes {
    let header = Bytes()
    if level == 2 { header.add(0x43 | ((connection.spaces[2].writeGeneration & 1) << 2)); header.addBytes(connection.remote) }
    else {
        let first = 0xc3
        if level == 1 { first = 0xe3 }
        if level == 3 { first = 0xd3 }
        header.add(first)
        for index in 0..4 { header.add((connection.version >> ((3 - index) * 8)) & 255) }
        header.add(connection.remote.length); header.addBytes(connection.remote); header.add(connection.local.length); header.addBytes(connection.local)
        if level == 0 { add(header, 0) }
        add(header, length + 20)
    }
    for index in 0..4 { header.add((number >> ((3 - index) * 8)) & 255) }
    return header
}
public function poll(connection: Connection, now: Integer): List<Bytes> {
    let outgoing: List<Bytes> = []
    connection.outgoingPaths = []
    if ((connection.state == FAILED || connection.state == CLOSED) && !connection.closing) || now < 0 || now < connection.now { return outgoing }
    if connection.now < 0 { connection.lastActivity = now }
    connection.now = now
    for path in connection.paths {
        if path.challenge.length == 8 && path.deadline >= 0 && now >= path.deadline {
            if path.attempts < 3 { challengePath(connection, path) }
            else { path.challenge = Bytes(); path.deadline = -1 }
        }
    }
    if !connection.closing && now - connection.lastActivity >= connection.idleTimeout { terminate(connection, 0, "QUIC idle timeout"); return outgoing }
    for level in 0..3 {
        let space = connection.spaces[level]
        if !space.active { continue }
        if space.previousUntil >= 0 && now > space.previousUntil { space.previousRead = protection.traffic(1, 0, Bytes()); space.previousUntil = -1 }
        let remaining: List<Sent> = []
        for sent in space.sent {
            if recovery.isLost(connection.congestion, sent.number, space.largestAck, sent.time, now) {
                connection.flight = max(0, connection.flight - sent.bytes)
                recovery.lost(connection.congestion, now, sent.time); enqueuePath(connection, sent.level, sent.payload, false, sent.path)
            } else { remaining.add(sent) }
        }
        space.sent = remaining
        if remaining.length > 0 && space.probe >= 0 && now >= space.probe {
            enqueuePath(connection, remaining[0].level, remaining[0].payload, true, remaining[0].path)
            connection.congestion.probes += 1; space.probe = now + recovery.pto(connection.congestion, connection.confirmed)
        }
        if space.ack && space.write.key.length > 0 && (level != 2 || connection.state == ESTABLISHED) { enqueuePath(connection, level, ackFrame(space), false, space.ackPath); space.ack = false }
    }
    let unsent: List<Pending> = []
    for pending in connection.pending {
        let level = pending.level; let index = level
        if level == 3 { index = 2; if connection.spaces[2].write.key.length > 0 { level = 2; pending.level = 2 } }
        let space = connection.spaces[index]; let keys = space.write
        if level == 3 { keys = connection.earlyWrite }
        if !space.active || keys.key.length == 0 { continue }
        if level == 2 && connection.state != ESTABLISHED && !connection.closing { unsent.add(pending); continue }
        let route = pending.path
        if route < 0 { route = connection.activePath }
        let pathAt = pathIndex(connection, route)
        if pathAt < 0 { continue }
        let path = connection.paths[pathAt]
        let payload = pending.payload.slice(0, pending.payload.length)
        let header = packetHeader(connection, level, payload.length, space.next)
        if level == 0 {
            let padding = 1200 - header.length - payload.length - 16
            if padding > 0 {
                payload.resize(payload.length + padding); header = packetHeader(connection, level, payload.length, space.next)
                payload.resize(1200 - header.length - 16); header = packetHeader(connection, level, payload.length, space.next)
            }
        }
        if level == 2 {
            let isChallenge = false
            let frames = wire.frames(pending.payload)
            for frame in frames.frames { if frame.type == 26 { isChallenge = true } }
            if isChallenge && (connection.clientRole || path.validated || 3 * path.received - path.sent >= 1200) {
                payload.resize(max(payload.length, 1200 - header.length - 16)); header = packetHeader(connection, level, payload.length, space.next)
            }
        }
        let size = header.length + payload.length + 16
        let ackEliciting = false
        let parsed = wire.frames(pending.payload)
        for frame in parsed.frames { if frame.type != 0 && frame.type != 2 && frame.type != 3 && frame.type != 28 && frame.type != 29 { ackEliciting = true } }
        if (!connection.addressValidated && size > 3 * connection.receivedBytes - connection.sentBytes) ||
           (!connection.clientRole && !path.validated && size > 3 * path.received - path.sent) ||
           (ackEliciting && !pending.probe && size > connection.congestion.window - connection.flight) {
            unsent.add(pending); continue
        }
        if space.next > 0xffffffff { terminate(connection, 15, "QUIC packet number budget exhausted"); return [] }
        if level == 3 && connection.earlyPackets >= (1 << 23) { terminate(connection, 15, "QUIC early AEAD key usage limit reached"); return [] }
        if level != 3 && space.write.suite == protection.AES128_GCM && space.writePackets >= (1 << 23) {
            if pending.level != 2 || !errors.booleanOk(updateKeys(connection)) { terminate(connection, 15, "QUIC AEAD key usage limit reached"); return [] }
            header = packetHeader(connection, level, payload.length, space.next); keys = space.write
        }
        let encrypted = protection.protect(keys, header, header.length - 4, space.next, payload)
        if !errors.bytesOk(encrypted) { terminate(connection, 1, errors.message(errors.bytesError(encrypted))); return [] }
        outgoing.add(errors.bytesValue(encrypted)); connection.outgoingPaths.add(route); connection.sentBytes += size; path.sent += size
        if ackEliciting {
            if space.sent.length >= 4096 { terminate(connection, 1, "QUIC outstanding packet limit exceeded"); return [] }
            space.sent.add(Sent { number: space.next; time: now; bytes: size; payload: pending.payload; path: pending.path; level: level })
            connection.flight += size
            if space.probe < 0 { space.probe = now + recovery.pto(connection.congestion, connection.confirmed) }
        }
        space.next += 1; if level == 3 { connection.earlyPackets += 1 } else { space.writePackets += 1 }
        for frame in parsed.frames { if level == 2 && (frame.type == 2 || frame.type == 3) && frame.value >= space.readFirst { space.readAcknowledged = true } }
