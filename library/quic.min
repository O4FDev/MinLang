            let permitted = !connection.peerDisabledMigration || (connection.peerPreferred.valid && equal(known.id,connection.peerPreferred.connectionId))
            if !used && permitted && known.sequence >= connection.retirePrior && sequence < 0 { sequence = known.sequence; destination = known.id }
