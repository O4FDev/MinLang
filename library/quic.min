        input.reset = true; input.resetCode = code; consumeDiscard(connection,input)
        if input.final < 0 { let frame = Bytes(); add(frame,5); add(frame,id); add(frame,code); enqueue(connection,2,frame,false) }
    }
    return errors.boolean(true)
