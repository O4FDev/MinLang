}
// Release buffers and secrets after the caller finishes closing packets.
public function release(connection: Connection): Boolean {
    if (connection.state != CLOSED && connection.state != FAILED) || connection.closing || connection.draining { return false }
    connection.clientTLS = tls.none(); connection.serverTLS = tlsserver.none()
    connection.spaces = []; connection.pending = []; connection.streams = []; connection.remoteIds = []; connection.localIds = []
    connection.history = []; connection.lossFirst = -1; connection.lossLast = -1; connection.lossAfter = -1; connection.handshakeProbe = -1; connection.handshakeAcknowledged = false
    connection.closedStreams = []
    connection.paths = []; connection.outgoingPaths = []; connection.earlyStreams = []; connection.peerPreferred = noPreferredAddress(); connection.retiredRemote = []; connection.remoteRetireOutstanding = []
    connection.earlyWrite = protection.traffic(1,0,Bytes()); connection.earlyRead = protection.traffic(1,0,Bytes())
    connection.originalDestination = Bytes(); connection.local = Bytes(); connection.remote = Bytes(); connection.peerSource = Bytes()
    connection.initialDestination = Bytes(); connection.initialHandshake = Bytes(); connection.retrySource = Bytes(); connection.retryToken = Bytes()
