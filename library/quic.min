    }
    let entropy = secureRandom.bytes(24)
    if entropy.length != 24 || equal(entropy.slice(0,8),connection.local) {
        return errors.booleanFailure(errors.make(errors.unavailableCode(),0,"preferred connection ID generation failed"))
    }
