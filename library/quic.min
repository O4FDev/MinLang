            if pending.level != 2 || !errors.booleanOk(updateKeys(connection)) { terminate(connection, 15, "QUIC AEAD key usage limit reached"); return [] }
            header = packetHeader(connection, level, payload.length, space.next); keys = space.write
        }
        let encrypted = protection.protect(keys, header, header.length - 4, space.next, payload)
        if !errors.bytesOk(encrypted) { terminate(connection, 1, errors.message(errors.bytesError(encrypted))); return [] }
        outgoing.add(errors.bytesValue(encrypted)); connection.outgoingPaths.add(route); connection.sentBytes += size; path.sent += size
        if connection.closing {
            connection.closeResponseAt = now + max(1,connection.closeInterval / 16) * (1 << min(12,connection.closeAttempts))
            connection.closeAttempts += 1
        }
        if ackEliciting {
            if connection.flight == 0 && connection.emptySince >= 0 { recovery.idle(connection.congestion,now - connection.emptySince) }
            connection.emptySince = -1
            connection.paceCredit = max(0.0,connection.paceCredit - Float(size))
            if space.sent.length >= 4096 { terminate(connection, 1, "QUIC outstanding packet limit exceeded"); return [] }
            let sent = Sent { number: space.next; time: now; bytes: size; payload: pending.payload; path: pending.path; level: level; status: 0; measured: connection.congestion.measured }
            space.sent.add(sent); connection.history.add(sent)
            connection.flight += size
            if space.probe < 0 { space.probe = now + recovery.pto(connection.congestion, connection.confirmed) }
        } else {
