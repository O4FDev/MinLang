               (generation > space.readGeneration && packet.number <= space.largest) { terminate(connection, 14, "QUIC key phase violates packet number ordering"); return }
            if generation > space.readGeneration {
                if !connection.confirmed || !space.readAcknowledged { terminate(connection, 14, "QUIC key update before confirmation"); return }
                space.previousRead = space.read; space.previousUntil = now + 3 * recovery.pto(connection.congestion, true)
                space.read = selected; space.nextRead = protection.update(selected); space.readGeneration = generation; space.readFirst = packet.number; space.readAcknowledged = false
                if space.writeGeneration < generation { advanceWrite(connection, space) }
