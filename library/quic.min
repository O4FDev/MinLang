// Socket-independent QUIC v1 transport. Supply monotonic milliseconds and
// datagrams; send poll()'s datagrams. No upstream transport is embedded.
// Current scope: authenticated handshake, ACKs, bounded ordered streams,
// flow control, RFC 9002 recovery/CUBIC. See docs/quic.md for remaining work.
use "tls" as tls
use "tlsserver" as tlsserver
use "crypto" as crypto
use "quiccrypto" as protection
use "quicwire" as wire
use "quicstream" as stream
use "quicrecovery" as recovery
use "errors" as errors
use "tlstickets" as tickets
use "quicretry" as retry

public constant STARTING = 0
public constant ESTABLISHED = 1
public constant CLOSED = 2
public constant FAILED = 3
record Sent { number: Integer; time: Integer; bytes: Integer; payload: Bytes; path: Integer; level: Integer; status: Integer; measured: Boolean }
record Pending { level: Integer; payload: Bytes; probe: Boolean; path: Integer }
public record Datagram { data: Bytes; pathId: Integer }
public record Path {
    id: Integer; validated: Boolean; eligible: Boolean; challenge: Bytes
    deadline: Integer; attempts: Integer; received: Integer; sent: Integer
}
record ConnectionId { sequence: Integer; id: Bytes; token: Bytes }
record SentTime { number: Integer; time: Integer }
public record ClosedStreams { kind: Integer; first: Integer; last: Integer }
record Space {
    read: protection.Keys; write: protection.Keys; next: Integer; largest: Integer; largestAck: Integer
    ackTimes: List<SentTime>
    ranges: List<wire.Range>; ack: Boolean; sent: List<Sent>; active: Boolean; probe: Integer
    receivedCrypto: stream.Stream; sendCrypto: Integer
    nextRead: protection.Keys; previousRead: protection.Keys; previousUntil: Integer
    readGeneration: Integer; writeGeneration: Integer; readFirst: Integer; writeFirst: Integer; writePackets: Integer
    readAcknowledged: Boolean; writeUpdatedAt: Integer
    ackPath: Integer
}
public record Connection {
    state: Integer; error: Text; code: Integer; clientRole: Boolean; version: Integer
    originalDestination: Bytes; local: Bytes; remote: Bytes; peerSource: Bytes; peerKnown: Boolean
    initialDestination: Bytes; initialHandshake: Bytes; retryAccepted: Boolean; retrySource: Bytes; retryToken: Bytes
    remoteIds: List<ConnectionId>; retirePrior: Integer
    clientTLS: tls.Session; serverTLS: tlsserver.Session; spaces: List<Space>; pending: List<Pending>
    streams: List<stream.Stream>; nextBidi: Integer; nextUni: Integer
    closedStreams: List<ClosedStreams>; incomingBidi: Integer; incomingUni: Integer; receiveBidi: Integer; receiveUni: Integer
    peerMaxData: Integer; peerBidi: Integer; peerUni: Integer; peerBidiLocal: Integer; peerBidiRemote: Integer; peerUniData: Integer
    sentData: Integer; receivedData: Integer; receiveMaxData: Integer; parametersChecked: Boolean
    congestion: recovery.State; flight: Integer; receivedBytes: Integer; sentBytes: Integer
    history: List<Sent>; lossFirst: Integer; lossLast: Integer; emptySince: Integer
    addressValidated: Boolean; confirmed: Boolean; lastActivity: Integer; now: Integer
    earlyWrite: protection.Keys; earlyRead: protection.Keys; earlyRejected: Boolean; earlyStreams: List<Integer>; earlyData: Integer; earlyPackets: Integer
    closing: Boolean; draining: Boolean; closeUntil: Integer; closeResponseAt: Integer; closeInterval: Integer; closeAttempts: Integer; closeFrame: Bytes; closeLevel: Integer
    paceCredit: Float; paceAt: Integer; paceNext: Integer
    ackExponent: Integer; idleTimeout: Integer; failedAuthentication: Integer
    activePath: Integer; incomingPath: Integer; paths: List<Path>; outgoingPaths: List<Integer>; peerDisabledMigration: Boolean
}
function contains(values: List<Integer>, value: Integer): Boolean { for item in values { if item == value { return true } }; return false }
function add(data: Bytes, value: Integer) { data.addBytes(errors.bytesValue(wire.encode(value))) }
function equal(left: Bytes, right: Bytes): Boolean { return crypto.hex(left) == crypto.hex(right) }
function parameters(local: Bytes, original: Bytes, server: Boolean): Bytes {
    let result = Bytes()
    if server { add(result, 0); add(result, original.length); result.addBytes(original) }
    add(result, 15); add(result, local.length); result.addBytes(local)
    let ids = [1, 3, 4, 5, 6, 7, 8, 9, 14]
    let values = [45000, 1200, 262144, 65536, 65536, 65536, 16, 16, 2]
    for index in 0..ids.length {
        let value = errors.bytesValue(wire.encode(values[index]))
        add(result, ids[index]); add(result, value.length); result.addBytes(value)
    }
    return result
}
function create(entropy: Bytes, original: Bytes, client: Boolean): Connection {
    let local = Bytes(); let destination = original
    if entropy.length >= 80 {
        local = entropy.slice(64, 72)
        if client { destination = entropy.slice(72, 80) }
    }
    let spaces: List<Space> = []
    for level in 0..3 {
        let read = protection.traffic(1, 0, Bytes()); let write = read
        if level == 0 { read = protection.initial(1, destination, client); write = protection.initial(1, destination, !client) }
        spaces.add(Space {
            read: read; write: write; next: 0; largest: -1; largestAck: -1; ranges: []; ack: false; sent: []; active: true; probe: -1
            ackTimes: []
            receivedCrypto: stream.create(level, 1048576, 1048576); sendCrypto: 0
            nextRead: protection.traffic(1, 0, Bytes()); previousRead: protection.traffic(1, 0, Bytes()); previousUntil: -1
            readGeneration: 0; writeGeneration: 0; readFirst: 0; writeFirst: 0; writePackets: 0
            readAcknowledged: true; writeUpdatedAt: -1
            ackPath: -1
        })
    }
    let role = 1
    if client { role = 0 }
    let result = Connection {
        state: STARTING; error: ""; code: 0; clientRole: client; version: 1
        originalDestination: destination; local: local; remote: destination; peerSource: Bytes(); peerKnown: false
        initialDestination: destination; initialHandshake: Bytes(); retryAccepted: false; retrySource: Bytes(); retryToken: Bytes()
        remoteIds: []; retirePrior: 0
        clientTLS: tls.none(); serverTLS: tlsserver.none(); spaces: spaces; pending: []; streams: []; nextBidi: role; nextUni: role + 2
        closedStreams: []; incomingBidi: 0; incomingUni: 0; receiveBidi: 16; receiveUni: 16
        peerMaxData: 0; peerBidi: 0; peerUni: 0; peerBidiLocal: 0; peerBidiRemote: 0; peerUniData: 0
        sentData: 0; receivedData: 0; receiveMaxData: 262144; parametersChecked: false
        congestion: recovery.create(1200); flight: 0; receivedBytes: 0; sentBytes: 0
        history: []; lossFirst: -1; lossLast: -1; emptySince: -1
        addressValidated: client; confirmed: false; lastActivity: -1; now: -1
        earlyWrite: protection.traffic(1, 0, Bytes()); earlyRead: protection.traffic(1, 0, Bytes()); earlyRejected: false; earlyStreams: []; earlyData: 0; earlyPackets: 0
        closing: false; draining: false; closeUntil: -1; closeResponseAt: -1; closeInterval: 0; closeAttempts: 0; closeFrame: Bytes(); closeLevel: 0
        paceCredit: 12000.0; paceAt: -1; paceNext: -1
        ackExponent: 3; idleTimeout: 45000; failedAuthentication: 0
        activePath: 0; incomingPath: 0; paths: [Path { id: 0; validated: client; eligible: true; challenge: Bytes(); deadline: -1; attempts: 0; received: 0; sent: 0 }]; outgoingPaths: []; peerDisabledMigration: false
    }
    if entropy.length < 80 || destination.length < 1 || destination.length > 20 { terminate(result, 1, "invalid QUIC entropy or destination connection ID") }
    return result
}
public function client(host: Text, entropy: Bytes, protocol: Text, roots: List<Bytes>, identity: List<Bytes>, key: Bytes): Connection {
    let connection = create(entropy, Bytes(), true)
    if connection.state == FAILED { return connection }
    connection.clientTLS = tls.quicClient(host, entropy, protocol, parameters(connection.local, connection.originalDestination, false), roots, identity, key)
    synchronize(connection)
    return connection
}
public function server(entropy: Bytes, protocol: Text, original: Bytes, identity: List<Bytes>, key: Bytes, roots: List<Bytes>, requireClient: Boolean): Connection {
    let connection = create(entropy, original, false)
    if connection.state == FAILED { return connection }
    connection.serverTLS = tlsserver.quicServer(entropy, protocol, parameters(connection.local, original, true), identity, key, roots, requireClient)
    synchronize(connection)
    return connection
}
public function serverAfterRetry(entropy: Bytes, protocol: Text, validated: retry.Opened, identity: List<Bytes>, key: Bytes, roots: List<Bytes>, requireClient: Boolean): Connection {
    let connection = create(entropy,retry.source(validated),false)
    if !retry.valid(validated) || retry.version(validated) != 1 { terminate(connection,11,"invalid validated Retry context"); return connection }
    connection.originalDestination = retry.original(validated); connection.retrySource = retry.source(validated); connection.retryAccepted = true; connection.addressValidated = true
    connection.paths[0].validated = true
    let transport = parameters(connection.local,connection.originalDestination,true)
    add(transport,16); add(transport,connection.retrySource.length); transport.addBytes(connection.retrySource)
    connection.serverTLS = tlsserver.quicServer(entropy,protocol,transport,identity,key,roots,requireClient)
    synchronize(connection); return connection
}
public function clientResumed(host: Text, entropy: Bytes, protocol: Text, roots: List<Bytes>, identity: List<Bytes>, key: Bytes, ticket: tickets.Client): Connection {
    let connection = create(entropy, Bytes(), true)
    if connection.state == FAILED { return connection }
    connection.clientTLS = tls.quicClientResumed(host, entropy, protocol, parameters(connection.local, connection.originalDestination, false), roots, identity, key, ticket)
    synchronize(connection)
    return connection
}
// Callers promise early payloads are safe to replay. Rejection retires their
// stream handles and never copies application bytes to a replacement stream.
public function clientEarly(host: Text, entropy: Bytes, protocol: Text, roots: List<Bytes>, identity: List<Bytes>, key: Bytes, ticket: tickets.Client): Connection {
    let connection = create(entropy, Bytes(), true)
    if connection.state == FAILED { return connection }
    connection.clientTLS = tls.quicClientEarly(host, entropy, protocol, parameters(connection.local, connection.originalDestination, false), roots, identity, key, ticket)
    if connection.clientTLS.earlyOffered {
        let parsed = wire.parameters(ticket.parameters, true)
        for parameter in parsed.parameters { rememberedLimit(connection, parameter.id, parameter.integer) }
    }
    synchronize(connection)
    return connection
}
public function serverWithTickets(entropy: Bytes, protocol: Text, original: Bytes, identity: List<Bytes>, key: Bytes, roots: List<Bytes>, requireClient: Boolean, store: tickets.Store): Connection {
    let connection = create(entropy, original, false)
    if connection.state == FAILED { return connection }
    connection.serverTLS = tlsserver.quicServerWithTickets(entropy, protocol, parameters(connection.local, original, true), identity, key, roots, requireClient, store)
    synchronize(connection)
    return connection
}
public function takeTicket(connection: Connection): tickets.Client { return tls.takeTicket(connection.clientTLS) }
function terminate(connection: Connection, code: Integer, message: Text) {
    if connection.state == FAILED || connection.state == CLOSED { return }
    connection.state = FAILED; connection.code = code; connection.error = message
    connection.pending = []; connection.flight = 0
    connection.history = []
    for space in connection.spaces { space.sent = []; space.ack = false }
    connection.streams = []
    let level = 0
    if connection.spaces[1].write.key.length > 0 { level = 1 }
    if connection.spaces[2].write.key.length > 0 && connection.confirmed { level = 2 }
    let close = Bytes(); add(close, 28); add(close, max(0, code)); add(close, 0)
    let reason = Bytes(message); if reason.length > 256 { reason.resize(256) }
    add(close, reason.length); close.addBytes(reason)
    beginClosing(connection,level,close)
}
function beginClosing(connection: Connection, level: Integer, frame: Bytes) {
    connection.closing = true; connection.draining = false; connection.closeUntil = -1; connection.closeResponseAt = -1
    connection.closeInterval = recovery.pto(connection.congestion,connection.confirmed); connection.closeAttempts = 0; connection.closeFrame = frame; connection.closeLevel = level
    connection.pending = [Pending { level: level; payload: frame; probe: false; path: -1 }]; connection.flight = 0
    connection.history = []
    for space in connection.spaces { space.sent = []; space.ack = false }
    for path in connection.paths { path.challenge = Bytes(); path.deadline = -1 }
}
function beginDraining(connection: Connection, code: Integer) {
    connection.state = CLOSED; connection.code = code; connection.closing = false; connection.draining = true
    connection.closeUntil = max(connection.closeUntil,connection.now + 3 * recovery.pto(connection.congestion,connection.confirmed))
    connection.pending = []; connection.flight = 0; connection.streams = []; connection.closeFrame = Bytes()
    connection.history = []
    for space in connection.spaces { space.sent = []; space.ack = false }
    for path in connection.paths { path.challenge = Bytes(); path.deadline = -1 }
}
function enqueue(connection: Connection, level: Integer, payload: Bytes, probe: Boolean) {
    enqueuePath(connection, level, payload, probe, -1)
}
function enqueuePath(connection: Connection, level: Integer, payload: Bytes, probe: Boolean, path: Integer) {
    if connection.pending.length >= 4096 { terminate(connection, 1, "QUIC send queue exceeds bounded packet count"); return }
    if connection.emptySince >= 0 && payload.length > 0 && payload[0] != 0 && payload[0] != 2 && payload[0] != 3 && payload[0] != 28 && payload[0] != 29 {
        recovery.idle(connection.congestion,max(0,connection.now - connection.emptySince)); connection.emptySince = -1
    }
    connection.pending.add(Pending { level: level; payload: payload; probe: probe; path: path })
}
function cryptoData(connection: Connection, level: Integer, data: Bytes) {
    if connection.clientRole && level == 0 && data.length > 0 && connection.initialHandshake.length == 0 { connection.initialHandshake = data.slice(0,data.length) }
    let space = connection.spaces[level]
    let at = 0
    while at < data.length {
        let capacity = 1000
        if level == 0 && connection.clientRole { capacity = min(capacity,1100 - connection.retryToken.length) }
        let count = min(capacity, data.length - at)
        let frame = Bytes(); add(frame, 6); add(frame, space.sendCrypto); add(frame, count); frame.addBytes(data.slice(at, at + count))
        enqueue(connection, level, frame, false)
        space.sendCrypto += count; at += count
    }
}
function rememberedLimit(connection: Connection, id: Integer, value: Integer) {
    if id == 4 { connection.peerMaxData = value }
    if id == 5 { connection.peerBidiLocal = value }
    if id == 6 { connection.peerBidiRemote = value }
    if id == 7 { connection.peerUniData = value }
    if id == 8 { connection.peerBidi = value }
    if id == 9 { connection.peerUni = value }
}
function rejectEarly(connection: Connection) {
    if connection.earlyRejected { return }
    connection.earlyRejected = true; connection.earlyWrite = protection.traffic(1, 0, Bytes())
    let retained: List<Pending> = []
    for pending in connection.pending { if pending.level != 3 { retained.add(pending) } }
    connection.pending = retained
    let sent: List<Sent> = []
    for packet in connection.spaces[2].sent {
        if packet.level == 3 { connection.flight = max(0, connection.flight - packet.bytes); packet.status = 3; packet.payload = Bytes() }
        else { sent.add(packet) }
    }
    connection.spaces[2].sent = sent
    connection.sentData = max(0, connection.sentData - connection.earlyData)
    for id in connection.earlyStreams {
        let index = streamIndex(connection, id)
        if index >= 0 { connection.streams[index].reset = true; connection.streams[index].sendClosed = true }
    }
}
public function earlyRejectedCode(): Integer { return 1001 }
function peerParameters(connection: Connection, bytes: Bytes) {
    let parsed = wire.parameters(bytes, connection.clientRole)
    if !parsed.valid { terminate(connection, 8, errors.message(parsed.error)); return }
    let original = !connection.clientRole
    let source = false; let retryBound = !connection.retryAccepted
    for parameter in parsed.parameters {
        let id = parameter.id
        if id == 0 { original = equal(parameter.value, connection.originalDestination) }
        if id == 15 { source = equal(parameter.value, connection.peerSource) }
        if id == 16 {
            if !connection.retryAccepted || !equal(parameter.value,connection.retrySource) { terminate(connection,8,"Retry source connection ID is not bound"); return }
            retryBound = true
        }
        if id == 13 { terminate(connection,8,"preferred address migration is unsupported"); return }
        if id == 4 { connection.peerMaxData = parameter.integer }
        if id == 5 { connection.peerBidiLocal = parameter.integer }
        if id == 6 { connection.peerBidiRemote = parameter.integer }
        if id == 7 { connection.peerUniData = parameter.integer }
        if id == 8 { connection.peerBidi = parameter.integer }
        if id == 9 { connection.peerUni = parameter.integer }
        if id == 11 { connection.congestion.maxAckDelay = parameter.integer }
        if id == 10 { connection.ackExponent = parameter.integer }
        if id == 1 && parameter.integer > 0 { connection.idleTimeout = min(connection.idleTimeout, parameter.integer) }
        if id == 12 { connection.peerDisabledMigration = true }
    }
    if !connection.clientRole { retryBound = true }
    if !original || !source || !retryBound { terminate(connection, 8, "transport parameters do not bind the observed connection IDs"); return }
    connection.parametersChecked = true
}
function synchronize(connection: Connection) {
    let clientSecret = Bytes(); let serverSecret = Bytes(); let clientApplication = Bytes(); let serverApplication = Bytes()
    let suite = 0; let parameters = Bytes(); let established = false
    if connection.clientRole {
        let session = connection.clientTLS
        if session.state == tls.FAILED { terminate(connection, 0x100, session.error); return }
        clientSecret = session.clientSecret; serverSecret = session.serverSecret
        clientApplication = session.clientApplication; serverApplication = session.serverApplication; suite = session.cipherSuite
        parameters = session.peerTransportParameters; established = session.state == tls.ESTABLISHED
        if session.clientEarlySecret.length == 32 && connection.earlyWrite.key.length == 0 && !connection.earlyRejected {
            connection.earlyWrite = protection.traffic(connection.version, session.ticket.suite, session.clientEarlySecret)
        }
        if session.earlyOffered && session.stage >= 2 && !session.earlyAccepted { rejectEarly(connection) }
        let outgoing = tls.takeOutgoing(session)
        if outgoing.length > 0 { cryptoData(connection, session.outgoingLevel, outgoing) }
    } else {
        let session = connection.serverTLS
        if session.state == tlsserver.FAILED { terminate(connection, 0x100, session.error); return }
        clientSecret = session.clientSecret; serverSecret = session.serverSecret
        clientApplication = session.clientApplication; serverApplication = session.serverApplication; suite = session.cipherSuite
        parameters = session.peerTransportParameters; established = session.state == tlsserver.ESTABLISHED
        if session.earlyAccepted && session.clientEarlySecret.length == 32 && connection.earlyRead.key.length == 0 {
            connection.earlyRead = protection.traffic(connection.version, suite, session.clientEarlySecret)
        }
        cryptoData(connection, 0, tlsserver.takeInitial(session)); cryptoData(connection, 1, tlsserver.takeHandshake(session))
        cryptoData(connection, 2, tlsserver.takeApplication(session))
    }
    if clientSecret.length == 32 && connection.spaces[1].read.key.length == 0 {
        let client = protection.traffic(connection.version, suite, clientSecret); let server = protection.traffic(connection.version, suite, serverSecret)
        if connection.clientRole { connection.spaces[1].read = server; connection.spaces[1].write = client }
        else { connection.spaces[1].read = client; connection.spaces[1].write = server }
    }
    if clientApplication.length == 32 && connection.spaces[2].read.key.length == 0 {
        let client = protection.traffic(connection.version, suite, clientApplication); let server = protection.traffic(connection.version, suite, serverApplication)
        if connection.clientRole { connection.spaces[2].read = server; connection.spaces[2].write = client }
        else { connection.spaces[2].read = client; connection.spaces[2].write = server }
        connection.spaces[2].nextRead = protection.update(connection.spaces[2].read)
        connection.spaces[2].writeFirst = connection.spaces[2].next; connection.spaces[2].writePackets = 0
    }
    if parameters.length > 0 && !connection.parametersChecked { peerParameters(connection, parameters) }
    if established && connection.state != ESTABLISHED && connection.state != FAILED {
        connection.state = ESTABLISHED
        if !connection.clientRole { enqueue(connection, 2, crypto.fromHex("1e"), false); connection.confirmed = true; discard(connection, 1) }
    }
}
function acknowledge(space: Space, number: Integer): Boolean {
    for range in space.ranges { if number >= range.first && number <= range.last { space.ack = true; return false } }
    let ordered: List<wire.Range> = []; let inserted = false
    for range in space.ranges {
        if !inserted && number > range.last { ordered.add(wire.Range { first: number; last: number }); inserted = true }
        ordered.add(range)
    }
    if !inserted { ordered.add(wire.Range { first: number; last: number }) }
    let merged: List<wire.Range> = []
    for range in ordered {
        if merged.length > 0 && merged[merged.length - 1].first <= range.last + 1 { merged[merged.length - 1].first = range.first }
        else if merged.length < 256 { merged.add(range) }
    }
    space.ranges = merged; space.largest = max(space.largest, number)
    return true
}
function ackFrame(space: Space): Bytes {
    let result = Bytes()
    if space.ranges.length == 0 { return result }
    let first = space.ranges[0]
    add(result, 2); add(result, first.last); add(result, 0); add(result, space.ranges.length - 1); add(result, first.last - first.first)
    let low = first.first
    for index in 1..space.ranges.length {
        let range = space.ranges[index]
        add(result, low - range.last - 2); add(result, range.last - range.first); low = range.first
    }
    return result
}
function processAck(connection: Connection, space: Space, frame: wire.Frame) {
    if frame.value >= space.next { terminate(connection, 10, "peer acknowledged an unsent packet"); return }
    let sampleAt = -1; let eliciting = false
    for sent in space.sent {
        for range in frame.ranges {
            if sent.number >= range.first && sent.number <= range.last { eliciting = true; if sent.number == frame.value { sampleAt = sent.time } }
        }
    }
    let retainedTimes: List<SentTime> = []
    for time in space.ackTimes {
        if time.number == frame.value { sampleAt = time.time }
        if time.number > max(space.largestAck,frame.value) { retainedTimes.add(time) }
    }
    space.ackTimes = retainedTimes
    // The largest newly ACKed packet can be ACK-only. RFC9002 still requires
    // its send time when another newly ACKed packet was ack-eliciting.
    if eliciting && sampleAt >= 0 && frame.value > space.largestAck {
        let delay = 0
        if frame.values.length > 0 { delay = min(frame.values[0], connection.congestion.maxAckDelay * 1000) * (1 << connection.ackExponent) / 1000 }
        recovery.sample(connection.congestion,connection.now - sampleAt,delay,connection.confirmed)
    }
    let remaining: List<Sent> = []
    for sent in space.sent {
        let acknowledged = false
        for range in frame.ranges { if sent.number >= range.first && sent.number <= range.last { acknowledged = true } }
        if acknowledged {
            let frames = wire.frames(sent.payload)
            for item in frames.frames {
                if (item.type >= 8 && item.type <= 15) || item.type == 4 {
                    let index = streamIndex(connection,item.stream)
                    if index >= 0 {
                        let output = connection.streams[index]
                        if item.type == 4 { output.resetAcknowledged = true }
                        else if !stream.acknowledgeSend(output,item.offset,item.data.length,item.fin) { terminate(connection,1,"stream acknowledgement ranges exceed buffer bound"); return }
                    }
                }
            }
            connection.flight = max(0, connection.flight - sent.bytes)
            recovery.acknowledged(connection.congestion, sent.bytes, connection.now, sent.time)
            connection.congestion.probes = 0
            sent.status = 1; sent.payload = Bytes()
        } else { remaining.add(sent) }
    }
    space.sent = remaining; space.largestAck = max(space.largestAck, frame.value)
    if connection.flight == 0 && connection.pending.length == 0 && connection.emptySince < 0 { connection.emptySince = connection.now }
    space.probe = -1
    if remaining.length > 0 { space.probe = connection.now + recovery.pto(connection.congestion, connection.confirmed) }
}
function discard(connection: Connection, level: Integer) {
    let space = connection.spaces[level]
    if !space.active { return }
    space.active = false; space.ack = false
    for sent in space.sent { connection.flight = max(0, connection.flight - sent.bytes); sent.status = 3; sent.payload = Bytes() }
    space.sent = []; space.ackTimes = []; space.read = protection.traffic(1, 0, Bytes()); space.write = space.read
}
function streamIndex(connection: Connection, id: Integer): Integer {
    for index in 0..connection.streams.length { if connection.streams[index].id == id { return index } }
    return -1
}
function localInitiated(connection: Connection, id: Integer): Boolean {
    let role = 1
    if connection.clientRole { role = 0 }
    return (id & 1) == role
}
function streamRetired(connection: Connection, id: Integer): Boolean {
    for range in connection.closedStreams { if range.kind == (id & 3) && id / 4 >= range.first && id / 4 <= range.last { return true } }
    return false
}
function retireStream(connection: Connection, id: Integer) {
    let kind = id & 3; let first = id / 4; let last = first
    let merged: List<ClosedStreams> = []
    for range in connection.closedStreams {
        if range.kind == kind && range.first <= last + 1 && first <= range.last + 1 { first = min(first,range.first); last = max(last,range.last) }
        else { merged.add(range) }
    }
    let remaining: List<ClosedStreams> = []
    for range in merged {
        if range.kind == kind && range.first <= last + 1 && first <= range.last + 1 { first = min(first,range.first); last = max(last,range.last) }
        else { remaining.add(range) }
    }
    remaining.add(ClosedStreams { kind: kind; first: first; last: last }); connection.closedStreams = remaining
    if remaining.length > 256 { terminate(connection,1,"closed stream range bound exceeded") }
    if !localInitiated(connection,id) {
        let update = Bytes()
        if (id & 2) != 0 { connection.receiveUni += 1; add(update,19); add(update,connection.receiveUni) }
        else { connection.receiveBidi += 1; add(update,18); add(update,connection.receiveBidi) }
        enqueue(connection,2,update,false)
