public function probePath(connection: Connection, pathId: Integer, now: Integer): errors.BooleanResult {
    if !connection.clientRole || !connection.confirmed || connection.state != ESTABLISHED || connection.peerDisabledMigration || pathId < 0 || now < connection.now {
        return errors.booleanFailure(errors.make(errors.unavailableCode(), 0, "QUIC path migration is unavailable"))
    }
    connection.now = now
    if pathId == connection.activePath { return errors.boolean(true) }
    let index = pathIndex(connection, pathId)
    if index < 0 { index = candidatePath(connection, pathId, true) }
    if index < 0 { return errors.booleanFailure(errors.make(errors.wouldBlockCode(), 0, "QUIC path validation already in progress")) }
    let path = connection.paths[index]
    if path.challenge.length == 0 {
        path.challenge = randomBytes(8); path.eligible = true; path.validated = false; path.attempts = 0; challengePath(connection, path)
    }
    return errors.boolean(true)
}
public function pollDatagrams(connection: Connection, now: Integer): List<Datagram> {
    let bytes = poll(connection, now); let result: List<Datagram> = []
    for index in 0..bytes.length { result.add(Datagram { data: bytes[index]; pathId: connection.outgoingPaths[index] }) }
    return result
}
public function openStream(connection: Connection, unidirectional: Boolean): errors.IntegerResult {
    return open(connection, unidirectional, false)
}
public function openEarlyStream(connection: Connection, unidirectional: Boolean): errors.IntegerResult {
    return open(connection, unidirectional, true)
}
function open(connection: Connection, unidirectional: Boolean, early: Boolean): errors.IntegerResult {
    if early {
        if !connection.clientRole || connection.state != STARTING || connection.earlyWrite.key.length == 0 || connection.earlyRejected {
            return errors.integerFailure(errors.make(errors.unavailableCode(), 0, "QUIC replay-safe early streams are unavailable"))
        }
    } else if connection.state != ESTABLISHED { return errors.integerFailure(errors.make(errors.wouldBlockCode(), 0, "QUIC handshake is incomplete")) }
    let id = connection.nextBidi; let count = connection.peerBidi; let limit = connection.peerBidiRemote
    if unidirectional { id = connection.nextUni; count = connection.peerUni; limit = connection.peerUniData }
    if id / 4 >= count || connection.streams.length >= 128 { return errors.integerFailure(errors.make(errors.wouldBlockCode(), 0, "QUIC stream limit reached")) }
    connection.streams.add(stream.create(id, 65536, limit))
    if early { connection.earlyStreams.add(id) }
    if unidirectional { connection.nextUni += 4 } else { connection.nextBidi += 4 }
    return errors.integer(id)
}
public function writeStream(connection: Connection, id: Integer, data: Bytes, fin: Boolean): errors.IntegerResult {
    return write(connection, id, data, fin, false)
}
public function writeEarlyStream(connection: Connection, id: Integer, data: Bytes, fin: Boolean): errors.IntegerResult {
    return write(connection, id, data, fin, true)
}
function write(connection: Connection, id: Integer, data: Bytes, fin: Boolean, early: Boolean): errors.IntegerResult {
    if connection.earlyRejected && contains(connection.earlyStreams, id) { return errors.integerFailure(errors.make(earlyRejectedCode(), 0, "QUIC early stream was rejected; explicit retry required")) }
    if early && (!connection.clientRole || connection.state != STARTING || connection.earlyWrite.key.length == 0 || !contains(connection.earlyStreams, id)) {
        return errors.integerFailure(errors.make(errors.unavailableCode(), 0, "QUIC replay-safe early stream is unavailable"))
    }
    let index = streamIndex(connection, id)
    if (!early && connection.state != ESTABLISHED) || index < 0 { return errors.integerFailure(errors.make(errors.closedCode(), 0, "QUIC stream is unavailable")) }
    let output = connection.streams[index]
    if output.sendClosed || (!localInitiated(connection, id) && (id & 2) != 0) { return errors.integerFailure(errors.make(errors.closedCode(), 0, "QUIC stream is send-closed")) }
    let count = min(data.length, min(output.sendLimit - output.sendOffset, connection.peerMaxData - connection.sentData))
    if count < data.length || data.length > 1048576 || connection.pending.length + (data.length + 999) / 1000 > 4096 { return errors.integerFailure(errors.make(errors.wouldBlockCode(), 0, "QUIC flow credit or send buffer exhausted")) }
    let at = 0
    while at < count || (fin && count == 0) {
        let length = min(1000, count - at); let type = 14
        if fin && at + length == count { type = 15 }
        let frame = Bytes(); add(frame, type); add(frame, id); add(frame, output.sendOffset); add(frame, length); frame.addBytes(data.slice(at, at + length))
        let level = 2; if early { level = 3; connection.earlyData += length }
        enqueue(connection, level, frame, false); output.sendOffset += length; connection.sentData += length; at += length
        if count == 0 { break }
    }
    if fin { output.sendClosed = true }
    return errors.integer(count)
}
public function readStream(connection: Connection, id: Integer): errors.BytesResult {
    if connection.earlyRejected && contains(connection.earlyStreams, id) { return errors.bytesFailure(errors.make(earlyRejectedCode(), 0, "QUIC early stream was rejected; explicit retry required")) }
    let index = streamIndex(connection, id)
    if index < 0 { return errors.wouldBlock(0) }
    let input = connection.streams[index]
    let result = stream.take(input)
    if result.length > 0 {
        input.receiveLimit += result.length; connection.receiveMaxData += result.length
        let update = Bytes(); add(update, 17); add(update, id); add(update, input.receiveLimit); add(update, 16); add(update, connection.receiveMaxData)
        enqueue(connection, 2, update, false)
        return errors.bytes(result)
    }
    if stream.finished(input) { return errors.endOfStream() }
    return errors.wouldBlock(0)
}

public function close(connection: Connection, code: Integer, reason: Bytes): errors.BooleanResult {
    if code < 0 || code > wire.MAX_VARINT || reason.length > 1024 { return errors.booleanFailure(errors.make(errors.invalidDataCode(), 0, "invalid QUIC close code or reason")) }
    if connection.state == CLOSED || connection.state == FAILED { return errors.boolean(true) }
    if connection.state != ESTABLISHED { terminate(connection, code, Text(reason)); return errors.boolean(true) }
    connection.pending = []
    let frame = Bytes(); add(frame, 29); add(frame, code); add(frame, reason.length); frame.addBytes(reason)
    enqueue(connection, 2, frame, false); connection.closing = true
    return errors.boolean(true)
}
