            // timestamp retention; normal ACK progress releases this list.
            if space.ackTimes.length >= 4096 {
                let retained: List<SentTime> = []
                for index in 1..space.ackTimes.length { retained.add(space.ackTimes[index]) }
                space.ackTimes = retained
            }
            space.ackTimes.add(SentTime { number: space.next; time: now })
        }
        space.next += 1; if level == 3 { connection.earlyPackets += 1 } else { space.writePackets += 1 }
        for frame in parsed.frames { if level == 2 && (frame.type == 2 || frame.type == 3) && frame.value >= space.readFirst { space.readAcknowledged = true } }
        if connection.clientRole && level == 1 { discard(connection, 0) }
