public function streamResetCode(): Integer { return 1003 }
public function resetStream(connection: Connection, id: Integer, code: Integer): errors.BooleanResult {
    if code < 0 || code > wire.MAX_VARINT { return errors.booleanFailure(errors.make(errors.invalidDataCode(),0,"invalid stream application error")) }
    let index = streamIndex(connection,id)
    if connection.state != ESTABLISHED || index < 0 || (!localInitiated(connection,id) && (id & 2) != 0) { return errors.booleanFailure(errors.make(errors.closedCode(),0,"stream sending is unavailable")) }
    resetSend(connection,connection.streams[index],code)
    return errors.boolean(true)
}
public function stopSending(connection: Connection, id: Integer, code: Integer): errors.BooleanResult {
    if code < 0 || code > wire.MAX_VARINT { return errors.booleanFailure(errors.make(errors.invalidDataCode(),0,"invalid stream application error")) }
    let index = streamIndex(connection,id)
    if connection.state != ESTABLISHED || index < 0 || (localInitiated(connection,id) && (id & 2) != 0) { return errors.booleanFailure(errors.make(errors.closedCode(),0,"stream receiving is unavailable")) }
    let input = connection.streams[index]
