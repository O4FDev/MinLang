use "random" as secureRandom
// Socket-independent QUIC v1 transport. Supply monotonic milliseconds and
// datagrams; send poll()'s datagrams. No upstream transport is embedded.
// Current scope: authenticated handshake, ACKs, bounded ordered streams,
// flow control, RFC 9002 recovery/CUBIC. See docs/quic.md for remaining work.
use "tls" as tls
use "tlsserver" as tlsserver
use "crypto" as crypto
use "quiccrypto" as protection
use "quicwire" as wire
use "quicstream" as stream
use "quicrecovery" as recovery
use "errors" as errors
use "tlstickets" as tickets
use "quicretry" as retry

public constant STARTING = 0
public constant ESTABLISHED = 1
public constant CLOSED = 2
public constant FAILED = 3
record Sent { number: Integer; time: Integer; bytes: Integer; payload: Bytes; path: Integer; recoveryGeneration: Integer; level: Integer; status: Integer; measured: Boolean }
record Pending { level: Integer; payload: Bytes; probe: Boolean; path: Integer; acknowledgement: Boolean }
record PolledPayload { payload: Bytes; largestAck: Integer; eliciting: Boolean; challenge: Boolean }
public record Datagram { data: Bytes; pathId: Integer }
public record Path {
    id: Integer; validated: Boolean; eligible: Boolean; challenge: Bytes
    remoteSequence: Integer; remoteId: Bytes; localId: Bytes; intentional: Boolean
    deadline: Integer; attempts: Integer; received: Integer; sent: Integer
}
record ConnectionId { sequence: Integer; id: Bytes; token: Bytes }
public record PreferredAddress {
    valid: Boolean; ipv4: Bytes; ipv4Port: Integer; ipv6: Bytes; ipv6Port: Integer
    connectionId: Bytes; resetToken: Bytes
}
function noPreferredAddress(): PreferredAddress {
    return PreferredAddress { valid: false; ipv4: Bytes(); ipv4Port: 0; ipv6: Bytes(); ipv6Port: 0; connectionId: Bytes(); resetToken: Bytes() }
}
record SentTime { number: Integer; time: Integer; path: Integer; recoveryGeneration: Integer }
record SentStream { id: Integer; first: Integer; length: Integer; fin: Boolean; reset: Boolean }
record LostStreams { number: Integer; level: Integer; time: Integer; path: Integer; recoveryGeneration: Integer; measured: Boolean; streams: List<SentStream> }
public record ClosedStreams { kind: Integer; first: Integer; last: Integer }
record Space {
    read: protection.Keys; write: protection.Keys; next: Integer; largest: Integer; largestAck: Integer; recoveryLargestAck: Integer
    ackTimes: List<SentTime>; lostStreams: List<LostStreams>; lostStreamsAt: Integer; lostReferences: Integer; historyPassed: Integer; lastEliciting: Integer; recoveryLastEliciting: Integer
    ranges: List<wire.Range>; ack: Boolean; sent: List<Sent>; active: Boolean; probe: Integer
    receivedCrypto: stream.Stream; sendCrypto: Integer
    nextRead: protection.Keys; previousRead: protection.Keys; previousUntil: Integer
    readGeneration: Integer; writeGeneration: Integer; readFirst: Integer; writeFirst: Integer; writePackets: Integer
    readAcknowledged: Boolean; writeUpdatedAt: Integer
    ackPath: Integer; ackDeadline: Integer; ackCount: Integer; ackQueued: Boolean
    largestReceivedAt: Integer; largestElicitingReceived: Integer; receiveFloor: Integer
}
public record Connection {
    state: Integer; error: Text; code: Integer; clientRole: Boolean; version: Integer
    originalDestination: Bytes; local: Bytes; remote: Bytes; peerSource: Bytes; peerKnown: Boolean
    initialDestination: Bytes; initialHandshake: Bytes; retryAccepted: Boolean; retrySource: Bytes; retryToken: Bytes
    remoteIds: List<ConnectionId>; retirePrior: Integer; peerPreferred: PreferredAddress
    retiredRemote: List<wire.Range>; remoteRetireOutstanding: List<Integer>
    localIds: List<ConnectionId>; nextLocalSequence: Integer; peerIdLimit: Integer; connectionIdVersion: Integer
    clientTLS: tls.Session; serverTLS: tlsserver.Session; spaces: List<Space>; pending: List<Pending>
    streams: List<stream.Stream>; nextBidi: Integer; nextUni: Integer
    closedStreams: List<ClosedStreams>; incomingBidi: Integer; incomingUni: Integer; receiveBidi: Integer; receiveUni: Integer
    peerMaxData: Integer; peerBidi: Integer; peerUni: Integer; peerBidiLocal: Integer; peerBidiRemote: Integer; peerUniData: Integer
    sentData: Integer; receivedData: Integer; consumedData: Integer; receiveMaxData: Integer; parametersChecked: Boolean
    congestion: recovery.State; recoveryGeneration: Integer; flight: Integer; receivedBytes: Integer; sentBytes: Integer
    history: List<Sent>; lossFirst: Integer; lossLast: Integer; lossAfter: Integer; emptySince: Integer
    addressValidated: Boolean; confirmed: Boolean; handshakeAcknowledged: Boolean; handshakeProbe: Integer; lastActivity: Integer; idleSendAllowed: Boolean; now: Integer
    earlyWrite: protection.Keys; earlyRead: protection.Keys; earlyRejected: Boolean; earlyStreams: List<Integer>; earlyData: Integer; earlyPackets: Integer
    closing: Boolean; draining: Boolean; closeUntil: Integer; closeResponseAt: Integer; closeInterval: Integer; closeAttempts: Integer; closeFrame: Bytes; closeLevel: Integer
    paceCredit: Float; paceAt: Integer; paceNext: Integer
    ackExponent: Integer; idleTimeout: Integer; failedAuthentication: Integer
    activePath: Integer; incomingPath: Integer; paths: List<Path>; outgoingPaths: List<Integer>; peerDisabledMigration: Boolean
    highestAuthenticatedLocalSequence: Integer; localRetirePrior: Integer
}
function contains(values: List<Integer>, value: Integer): Boolean { for item in values { if item == value { return true } }; return false }
function add(data: Bytes, value: Integer) { data.addBytes(errors.bytesValue(wire.encode(value))) }
function equal(left: Bytes, right: Bytes): Boolean { return crypto.hex(left) == crypto.hex(right) }
function localIdSequence(connection: Connection, id: Bytes): Integer {
    for known in connection.localIds { if equal(known.id, id) { return known.sequence } }
    return -1
}
public function ownsConnectionId(connection: Connection, id: Bytes): Boolean {
    return localIdSequence(connection,id) >= 0
}
// A retired sequence is remembered as bounded merged ranges; retransmissions
// share one outstanding retirement until one copy is acknowledged.
function remoteRetired(connection: Connection, sequence: Integer): Boolean {
    for range in connection.retiredRemote { if sequence >= range.first && sequence <= range.last { return true } }
    return false
}
function retireRemote(connection: Connection, sequence: Integer) {
    if remoteRetired(connection,sequence) { return }
    // RFC9000 5.1.2: twice our advertised active_connection_id_limit.
    if connection.remoteRetireOutstanding.length >= 4 { terminate(connection,9,"outstanding connection ID retirement limit exceeded"); return }
    let first = sequence; let last = sequence; let retained: List<wire.Range> = []
    for range in connection.retiredRemote {
        if range.last + 1 >= first && range.first <= last + 1 { first = min(first,range.first); last = max(last,range.last) }
        else { retained.add(range) }
    }
    // Coalesce a second pass when the first merge joined earlier ranges.
    let ranges: List<wire.Range> = []
    for range in retained {
        if range.last + 1 >= first && range.first <= last + 1 { first = min(first,range.first); last = max(last,range.last) }
        else { ranges.add(range) }
    }
    if ranges.length >= 64 { terminate(connection,9,"connection ID retirement history limit exceeded"); return }
    ranges.add(wire.Range { first: first; last: last }); connection.retiredRemote = ranges
    connection.remoteRetireOutstanding.add(sequence)
    let frame = Bytes(); add(frame,25); add(frame,sequence); enqueue(connection,2,frame,false)
}
function acknowledgeRetirement(connection: Connection, sequence: Integer) {
    let retained: List<Integer> = []
    for known in connection.remoteRetireOutstanding { if known != sequence { retained.add(known) } }
    connection.remoteRetireOutstanding = retained
}
function remoteIdIndex(connection: Connection, sequence: Integer): Integer {
    for index in 0..connection.remoteIds.length { if connection.remoteIds[index].sequence == sequence { return index } }
    return -1
}
function abandonPath(connection: Connection, path: Path) {
    if path.id == connection.activePath {
        // Failed revalidation must not discard the last validated fallback.
        path.challenge = Bytes(); path.deadline = -1; path.attempts = 0; return
    }
    let retained: List<Path> = []; let shared = false
    for known in connection.paths {
        if known.id != path.id { retained.add(known); if known.remoteSequence == path.remoteSequence { shared = true } }
    }
    connection.paths = retained
    let pending: List<Pending> = []
    for frame in connection.pending { if frame.path != path.id { pending.add(frame) } }
    connection.pending = pending
    if path.intentional && !shared {
        retireRemote(connection,path.remoteSequence)
        let ids: List<ConnectionId> = []
        for known in connection.remoteIds { if known.sequence != path.remoteSequence { ids.add(known) } }
        connection.remoteIds = ids
    }
    path.challenge = Bytes(); path.deadline = -1
}
function currentRecovery(connection: Connection, path: Integer, generation: Integer): Boolean {
    return path == connection.activePath && generation == connection.recoveryGeneration
}
function recoveryAck(connection: Connection, space: Space, sent: Sent): Integer {
    // Global ACK progress remains authoritative for packet validity/delivery.
    // Loss for the active route uses only that route's current recovery epoch.
    if currentRecovery(connection,sent.path,sent.recoveryGeneration) { return space.recoveryLargestAck }
    return space.largestAck
}
function recoveryFlight(connection: Connection): Integer {
    // The common single-route connection preserves O(1) admission. Probing
    // or migrated connections scan only the bounded outstanding lists;
    // Connection.flight always remains the total across every route/epoch.
    if connection.recoveryGeneration == 0 && connection.paths.length == 1 { return connection.flight }
    let bytes = 0
    for space in connection.spaces { for sent in space.sent {
        if currentRecovery(connection,sent.path,sent.recoveryGeneration) { bytes += sent.bytes }
    } }
    return bytes
}
function activatePath(connection: Connection, path: Path) {
    if path.id == connection.activePath { return }
    let previous = connection.activePath
    // A retained validated fallback needs fresh non-probing traffic to move
    // back. Its earlier eligibility cannot turn a probe into migration.
    for known in connection.paths { if known.id == previous { known.eligible = false } }
    connection.activePath = path.id; connection.remote = path.remoteId
    connection.congestion = recovery.create(1200); connection.recoveryGeneration += 1
    connection.lossFirst = -1; connection.lossLast = -1; connection.lossAfter = -1; connection.emptySince = -1
    // Validation sends on this very route belong to its new controller. An
    // earlier use of the same route ID keeps its original generation.
    for space in connection.spaces {
        space.recoveryLargestAck = -1; space.recoveryLastEliciting = -1
        for sent in space.sent {
            if sent.path == path.id && sent.recoveryGeneration == connection.recoveryGeneration - 1 {
                sent.recoveryGeneration = connection.recoveryGeneration; sent.measured = false
                space.recoveryLastEliciting = max(space.recoveryLastEliciting,sent.time)
            }
        }
        // Old delivery can still need retransmission on the new route even
        // if no validation packet remains outstanding at activation.
        if space.sent.length > 0 && space.recoveryLastEliciting < 0 { space.recoveryLastEliciting = connection.now }
        for time in space.ackTimes {
            if time.path == path.id && time.recoveryGeneration == connection.recoveryGeneration - 1 { time.recoveryGeneration = connection.recoveryGeneration }
        }
    }
    rearmProbes(connection,-1)
    if path.intentional {
        // Keep the authenticated candidate, then retire the abandoned route.
        let retained: List<Path> = []
        for known in connection.paths {
            if known.id == previous {
                if known.remoteSequence != path.remoteSequence {
                    retireRemote(connection,known.remoteSequence)
                    let ids: List<ConnectionId> = []
                    for id in connection.remoteIds { if id.sequence != known.remoteSequence { ids.add(id) } }
                    connection.remoteIds = ids
                }
            } else { retained.add(known) }
        }
        connection.paths = retained
    }
}
function repairRemotePaths(connection: Connection) {
    // Repair the active route first; an unserviceable candidate is abandoned.
    let ordered: List<Path> = []
    for path in connection.paths { if path.id == connection.activePath { ordered.add(path) } }
    for path in connection.paths { if path.id != connection.activePath { ordered.add(path) } }
    for path in ordered {
        if remoteIdIndex(connection,path.remoteSequence) < 0 {
            let replacement = -1
            for index in 0..connection.remoteIds.length {
                let known = connection.remoteIds[index]; let used = false
                for other in connection.paths {
                    if other.id != path.id && other.remoteSequence == known.sequence && (path.intentional || other.intentional) { used = true }
                }
                if !used && replacement < 0 { replacement = index }
            }
            if replacement < 0 {
                if path.id == connection.activePath { terminate(connection,9,"retired active connection ID has no replacement"); return }
                abandonPath(connection,path)
            } else {
                path.remoteSequence = connection.remoteIds[replacement].sequence; path.remoteId = connection.remoteIds[replacement].id
            }
        }
    }
    let active = pathIndex(connection,connection.activePath)
    if active >= 0 { connection.remote = connection.paths[active].remoteId }
}
function issueConnectionIds(connection: Connection) {
    // Keep the initial two-ID stock. Consumption of the newest live ID or
    // retirement of an unused spare can make room for one bounded replacement.
    let newest = -1
    for known in connection.localIds { newest = max(newest,known.sequence) }
    let live = 0
    for known in connection.localIds { if known.sequence >= connection.localRetirePrior { live += 1 } }
    let limit = min(connection.peerIdLimit,8); let target = min(2,limit)
    if newest <= connection.highestAuthenticatedLocalSequence { target = min(limit,max(2,live + 1)) }
    let attempts = 0
    while live < target {
        if connection.nextLocalSequence > wire.MAX_VARINT || attempts >= 8 { terminate(connection, 1, "connection ID generation exhausted"); return }
        attempts += 1
        let entropy = secureRandom.bytes(24)
        if entropy.length != 24 { terminate(connection, 1, "connection ID generation failed"); return }
        let id = entropy.slice(0, 8); let token = entropy.slice(8, 24)
        let reusedToken = false
        for known in connection.localIds { if known.token.length == 16 && equal(known.token,token) { reusedToken = true } }
        if equal(id,connection.local) || ownsConnectionId(connection,id) || reusedToken { continue }
        let sequence = connection.nextLocalSequence; connection.nextLocalSequence += 1
        connection.localIds.add(ConnectionId { sequence: sequence; id: id; token: token }); connection.connectionIdVersion += 1
        let prior = sequence
        for known in connection.localIds { prior = min(prior, known.sequence) }
        prior = max(prior,connection.localRetirePrior)
        let frame = Bytes(); add(frame, 24); add(frame, sequence); add(frame, prior)
        frame.add(id.length); frame.addBytes(id); frame.addBytes(token)
        enqueue(connection, 2, frame, false)
        live += 1
    }
}
function pressureConnectionIds(connection: Connection) {
    let limit = min(connection.peerIdLimit,8);let live = 0;let oldest = -1;let newest = -1;let id = Bytes()
    for known in connection.localIds {
        if known.sequence < connection.localRetirePrior { return }
        live += 1;newest = max(newest,known.sequence)
        if oldest < 0 || known.sequence < oldest { oldest = known.sequence;id = known.id }
    }
    if live < limit || oldest < 0 || oldest >= newest || newest > connection.highestAuthenticatedLocalSequence { return }
    for path in connection.paths { if equal(path.localId,id) { return } }
    connection.localRetirePrior = oldest + 1
    issueConnectionIds(connection)
}
function parameters(local: Bytes, original: Bytes, server: Boolean): Bytes {
    let result = Bytes()
    if server { add(result, 0); add(result, original.length); result.addBytes(original) }
    add(result, 15); add(result, local.length); result.addBytes(local)
    let ids = [1, 3, 4, 5, 6, 7, 8, 9, 14]
    let values = [45000, 1500, 262144, 65536, 65536, 65536, 16, 16, 2]
    for index in 0..ids.length {
        let value = errors.bytesValue(wire.encode(values[index]))
        add(result, ids[index]); add(result, value.length); result.addBytes(value)
    }
    return result
}
function create(entropy: Bytes, original: Bytes, client: Boolean): Connection {
    let local = Bytes(); let destination = original
    if entropy.length >= 80 {
        local = entropy.slice(64, 72)
        if client { destination = entropy.slice(72, 80) }
    }
    let spaces: List<Space> = []
    for level in 0..3 {
        let read = protection.traffic(1, 0, Bytes()); let write = read
        if level == 0 { read = protection.initial(1, destination, client); write = protection.initial(1, destination, !client) }
        spaces.add(Space {
            read: read; write: write; next: 0; largest: -1; largestAck: -1; recoveryLargestAck: -1; ranges: []; ack: false; sent: []; active: true; probe: -1
            ackTimes: []; lostStreams: []; lostStreamsAt: 0; lostReferences: 0; historyPassed: -1; lastEliciting: -1; recoveryLastEliciting: -1
            receivedCrypto: stream.create(level, 1048576, 1048576); sendCrypto: 0
            nextRead: protection.traffic(1, 0, Bytes()); previousRead: protection.traffic(1, 0, Bytes()); previousUntil: -1
            readGeneration: 0; writeGeneration: 0; readFirst: 0; writeFirst: 0; writePackets: 0
            readAcknowledged: true; writeUpdatedAt: -1
            ackPath: -1; ackDeadline: -1; ackCount: 0; ackQueued: false
            largestReceivedAt: -1; largestElicitingReceived: -1; receiveFloor: 0
        })
    }
    let role = 1
    if client { role = 0 }
    let result = Connection {
        state: STARTING; error: ""; code: 0; clientRole: client; version: 1
        originalDestination: destination; local: local; remote: destination; peerSource: Bytes(); peerKnown: false
        initialDestination: destination; initialHandshake: Bytes(); retryAccepted: false; retrySource: Bytes(); retryToken: Bytes()
        remoteIds: []; retirePrior: 0; peerPreferred: noPreferredAddress(); retiredRemote: []; remoteRetireOutstanding: []
        localIds: [ConnectionId { sequence: 0; id: local; token: Bytes() }]; nextLocalSequence: 1; peerIdLimit: 2; connectionIdVersion: 0
        clientTLS: tls.none(); serverTLS: tlsserver.none(); spaces: spaces; pending: []; streams: []; nextBidi: role; nextUni: role + 2
        closedStreams: []; incomingBidi: 0; incomingUni: 0; receiveBidi: 16; receiveUni: 16
        peerMaxData: 0; peerBidi: 0; peerUni: 0; peerBidiLocal: 0; peerBidiRemote: 0; peerUniData: 0
        sentData: 0; receivedData: 0; consumedData: 0; receiveMaxData: 262144; parametersChecked: false
        congestion: recovery.create(1200); recoveryGeneration: 0; flight: 0; receivedBytes: 0; sentBytes: 0
        history: []; lossFirst: -1; lossLast: -1; lossAfter: -1; emptySince: -1
        addressValidated: client; confirmed: false; handshakeAcknowledged: false; handshakeProbe: -1; lastActivity: -1; idleSendAllowed: true; now: -1
        earlyWrite: protection.traffic(1, 0, Bytes()); earlyRead: protection.traffic(1, 0, Bytes()); earlyRejected: false; earlyStreams: []; earlyData: 0; earlyPackets: 0
        closing: false; draining: false; closeUntil: -1; closeResponseAt: -1; closeInterval: 0; closeAttempts: 0; closeFrame: Bytes(); closeLevel: 0
        paceCredit: 12000.0; paceAt: -1; paceNext: -1
        ackExponent: 3; idleTimeout: 45000; failedAuthentication: 0
        activePath: 0; incomingPath: 0; paths: [Path { id: 0; validated: client; eligible: true; challenge: Bytes(); remoteSequence: 0; remoteId: destination; localId: local; intentional: false; deadline: -1; attempts: 0; received: 0; sent: 0 }]; outgoingPaths: []; peerDisabledMigration: false
        highestAuthenticatedLocalSequence: 0; localRetirePrior: 0
    }
    if entropy.length < 80 || destination.length < 1 || destination.length > 20 { terminate(result, 1, "invalid QUIC entropy or destination connection ID") }
    return result
}
public function client(host: Text, entropy: Bytes, protocol: Text, roots: List<Bytes>, identity: List<Bytes>, key: Bytes): Connection {
    let connection = create(entropy, Bytes(), true)
    if connection.state == FAILED { return connection }
    connection.clientTLS = tls.quicClient(host, entropy, protocol, parameters(connection.local, connection.originalDestination, false), roots, identity, key)
    synchronize(connection)
    return connection
}
public function server(entropy: Bytes, protocol: Text, original: Bytes, identity: List<Bytes>, key: Bytes, roots: List<Bytes>, requireClient: Boolean): Connection {
    let connection = create(entropy, original, false)
    if connection.state == FAILED { return connection }
    connection.serverTLS = tlsserver.quicServer(entropy, protocol, parameters(connection.local, original, true), identity, key, roots, requireClient)
    synchronize(connection)
    return connection
}
public function serverAfterRetry(entropy: Bytes, protocol: Text, validated: retry.Opened, identity: List<Bytes>, key: Bytes, roots: List<Bytes>, requireClient: Boolean): Connection {
    let connection = create(entropy,retry.source(validated),false)
    if !retry.valid(validated) || retry.version(validated) != 1 { terminate(connection,11,"invalid validated Retry context"); return connection }
    connection.originalDestination = retry.original(validated); connection.retrySource = retry.source(validated); connection.retryAccepted = true; connection.addressValidated = true
    connection.paths[0].validated = true
    let transport = parameters(connection.local,connection.originalDestination,true)
    add(transport,16); add(transport,connection.retrySource.length); transport.addBytes(connection.retrySource)
    connection.serverTLS = tlsserver.quicServer(entropy,protocol,transport,identity,key,roots,requireClient)
    synchronize(connection); return connection
}
public function clientResumed(host: Text, entropy: Bytes, protocol: Text, roots: List<Bytes>, identity: List<Bytes>, key: Bytes, ticket: tickets.Client): Connection {
    let connection = create(entropy, Bytes(), true)
    if connection.state == FAILED { return connection }
    connection.clientTLS = tls.quicClientResumed(host, entropy, protocol, parameters(connection.local, connection.originalDestination, false), roots, identity, key, ticket)
    synchronize(connection)
    return connection
}
// Callers promise early payloads are safe to replay. Rejection retires their
// stream handles and never copies application bytes to a replacement stream.
public function clientEarly(host: Text, entropy: Bytes, protocol: Text, roots: List<Bytes>, identity: List<Bytes>, key: Bytes, ticket: tickets.Client): Connection {
    let connection = create(entropy, Bytes(), true)
    if connection.state == FAILED { return connection }
    connection.clientTLS = tls.quicClientEarly(host, entropy, protocol, parameters(connection.local, connection.originalDestination, false), roots, identity, key, ticket)
    if connection.clientTLS.earlyOffered {
        let parsed = wire.parameters(ticket.parameters, true)
        for parameter in parsed.parameters { rememberedLimit(connection, parameter.id, parameter.integer) }
    }
    synchronize(connection)
    return connection
}
public function serverWithTickets(entropy: Bytes, protocol: Text, original: Bytes, identity: List<Bytes>, key: Bytes, roots: List<Bytes>, requireClient: Boolean, store: tickets.Store): Connection {
    let connection = create(entropy, original, false)
    if connection.state == FAILED { return connection }
    connection.serverTLS = tlsserver.quicServerWithTickets(entropy, protocol, parameters(connection.local, original, true), identity, key, roots, requireClient, store)
    synchronize(connection)
    return connection
}
public function setCipherSuites(connection: Connection, suites: List<Integer>): errors.BooleanResult {
    if connection.state != STARTING || connection.now >= 0 {
        return errors.booleanFailure(errors.make(errors.unavailableCode(),0,"QUIC cipher policy must precede network processing"))
    }
    let accepted = false
    if connection.clientRole {
        // No application payload may be queued while rebuilding ClientHello.
        for pending in connection.pending {
            if pending.level != 0 { return errors.booleanFailure(errors.make(errors.unavailableCode(),0,"cipher policy must precede queued early data")) }
        }
        accepted = tls.setCipherSuites(connection.clientTLS,suites)
        if accepted {
            connection.pending = []; connection.initialHandshake = Bytes(); connection.spaces[0].sendCrypto = 0
            if !connection.clientTLS.earlyOffered {
                connection.earlyWrite = protection.traffic(1,0,Bytes())
                connection.peerMaxData = 0; connection.peerBidi = 0; connection.peerUni = 0; connection.peerBidiLocal = 0; connection.peerBidiRemote = 0; connection.peerUniData = 0
            }
            synchronize(connection)
        }
    } else { accepted = tlsserver.setCipherSuites(connection.serverTLS,suites) }
    if !accepted { return errors.booleanFailure(errors.make(errors.unavailableCode(),0,"invalid QUIC cipher policy")) }
    return errors.boolean(true)
}
public function takeTicket(connection: Connection): tickets.Client { return tls.takeTicket(connection.clientTLS) }
function terminate(connection: Connection, code: Integer, message: Text) {
    if connection.state == FAILED || connection.state == CLOSED { return }
    connection.state = FAILED; connection.code = code; connection.error = message
    connection.pending = []; connection.flight = 0
    connection.history = []; connection.lossFirst = -1; connection.lossLast = -1; connection.lossAfter = -1; connection.handshakeProbe = -1; connection.handshakeAcknowledged = false
    for space in connection.spaces { space.sent = []; space.lostStreams = []; space.lostStreamsAt = 0; space.lostReferences = 0; space.historyPassed = -1; space.lastEliciting = -1; space.recoveryLastEliciting = -1; space.recoveryLargestAck = -1; clearAck(space) }
    connection.streams = []
    let level = 0
    if connection.spaces[1].write.key.length > 0 { level = 1 }
    if connection.spaces[2].write.key.length > 0 && connection.confirmed { level = 2 }
    let close = Bytes(); add(close, 28); add(close, max(0, code)); add(close, 0)
    let reason = Bytes(message); if reason.length > 256 { reason.resize(256) }
    add(close, reason.length); close.addBytes(reason)
    beginClosing(connection,level,close)
}
function beginClosing(connection: Connection, level: Integer, frame: Bytes) {
    connection.closing = true; connection.draining = false; connection.closeUntil = -1; connection.closeResponseAt = -1
    connection.closeInterval = recovery.pto(connection.congestion,connection.confirmed); connection.closeAttempts = 0; connection.closeFrame = frame; connection.closeLevel = level
    connection.pending = [Pending { level: level; payload: frame; probe: false; path: -1; acknowledgement: false }]; connection.flight = 0
    connection.history = []; connection.lossFirst = -1; connection.lossLast = -1; connection.lossAfter = -1; connection.handshakeProbe = -1; connection.handshakeAcknowledged = false
    for space in connection.spaces { space.sent = []; space.lostStreams = []; space.lostStreamsAt = 0; space.lostReferences = 0; space.historyPassed = -1; space.lastEliciting = -1; space.recoveryLastEliciting = -1; space.recoveryLargestAck = -1; clearAck(space) }
    for path in connection.paths { path.challenge = Bytes(); path.deadline = -1 }
