    let value = Bytes(); value.addBytes(ipv4); value.add(ipv4Port >> 8); value.add(ipv4Port & 255)
    value.addBytes(ipv6); value.add(ipv6Port >> 8); value.add(ipv6Port & 255); value.add(id.length); value.addBytes(id); value.addBytes(token)
    let parameters = connection.serverTLS.transportParameters.slice(0,connection.serverTLS.transportParameters.length)
    add(parameters,13); add(parameters,value.length); parameters.addBytes(value)
    connection.serverTLS.transportParameters = parameters
    connection.localIds.add(ConnectionId { sequence: 1; id: id; token: token }); connection.nextLocalSequence = 2; connection.connectionIdVersion += 1
