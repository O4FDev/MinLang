function advanceWrite(connection: Connection, space: Space) {
    space.write = protection.update(space.write); space.writeGeneration += 1; space.writeFirst = space.next; space.writePackets = 0; space.writeUpdatedAt = connection.now
}
public function updateKeys(connection: Connection): errors.BooleanResult {
    if connection.state != ESTABLISHED { return errors.booleanFailure(errors.make(errors.unavailableCode(),0,"QUIC key update awaits authentication")) }
    let space = connection.spaces[2]
    if connection.state != ESTABLISHED || !connection.confirmed || space.largestAck < space.writeFirst || space.writeGeneration > space.readGeneration ||
       (space.writeUpdatedAt >= 0 && connection.now - space.writeUpdatedAt < 3 * recovery.pto(connection.congestion, true)) {
        return errors.booleanFailure(errors.make(errors.wouldBlockCode(), 0, "QUIC key update awaits handshake/ACK/reordering confirmation"))
    }
    advanceWrite(connection, space)
    return errors.boolean(true)
}
public function ping(connection: Connection): errors.BooleanResult {
    if connection.state != ESTABLISHED { return errors.booleanFailure(errors.make(errors.unavailableCode(), 0, "QUIC ping awaits authentication")) }
    enqueue(connection, 2, crypto.fromHex("01"), false)
    return errors.boolean(connection.state == ESTABLISHED)
}
public function nextTimer(connection: Connection): Integer {
    if connection.closing || connection.draining { if connection.closeUntil < 0 { return max(0,connection.now) }; return connection.closeUntil }
    if connection.state == FAILED || connection.state == CLOSED { return -1 }
    if connection.now < 0 { return 0 }
    let deadline = connection.lastActivity + connection.idleTimeout
    if connection.paceNext >= 0 { deadline = min(deadline,connection.paceNext) }
    for space in connection.spaces {
        if space.active && space.sent.length > 0 && space.probe >= 0 { deadline = min(deadline,space.probe) }
        if space.active { for sent in space.sent { if sent.number <= space.largestAck { deadline = min(deadline,sent.time + recovery.lossDelay(connection.congestion)) } } }
    }
    for path in connection.paths { if path.deadline >= 0 { deadline = min(deadline, path.deadline) } }
    return deadline
}
function pathIndex(connection: Connection, id: Integer): Integer {
    for index in 0..connection.paths.length { if connection.paths[index].id == id { return index } }
    return -1
}
function challengePath(connection: Connection, path: Path) {
    let frame = Bytes(); add(frame, 26); frame.addBytes(path.challenge)
    enqueuePath(connection, 2, frame, true, path.id); path.attempts += 1
    path.deadline = connection.now + recovery.pto(connection.congestion, true)
}
function candidatePath(connection: Connection, id: Integer, local: Boolean): Integer {
    let retained: List<Path> = []
    for path in connection.paths {
        if path.id == connection.activePath { retained.add(path) }
        else if path.challenge.length == 8 { return -1 }
    }
    let path = Path { id: id; validated: false; eligible: local; challenge: randomBytes(8); deadline: -1; attempts: 0; received: 0; sent: 0 }
    retained.add(path); connection.paths = retained; challengePath(connection, path)
    return retained.length - 1
}
public function probePath(connection: Connection, pathId: Integer, now: Integer): errors.BooleanResult {
    if !connection.clientRole || !connection.confirmed || connection.state != ESTABLISHED || connection.peerDisabledMigration || pathId < 0 || now < connection.now {
        return errors.booleanFailure(errors.make(errors.unavailableCode(), 0, "QUIC path migration is unavailable"))
    }
    connection.now = now
    if pathId == connection.activePath { return errors.boolean(true) }
    let index = pathIndex(connection, pathId)
    if index < 0 { index = candidatePath(connection, pathId, true) }
    if index < 0 { return errors.booleanFailure(errors.make(errors.wouldBlockCode(), 0, "QUIC path validation already in progress")) }
    let path = connection.paths[index]
    if path.challenge.length == 0 {
        path.challenge = randomBytes(8); path.eligible = true; path.validated = false; path.attempts = 0; challengePath(connection, path)
    }
    return errors.boolean(true)
}
public function pollDatagrams(connection: Connection, now: Integer): List<Datagram> {
    let bytes = poll(connection, now); let result: List<Datagram> = []
    for index in 0..bytes.length { result.add(Datagram { data: bytes[index]; pathId: connection.outgoingPaths[index] }) }
    return result
}
public function openStream(connection: Connection, unidirectional: Boolean): errors.IntegerResult {
    return open(connection, unidirectional, false)
}
public function openEarlyStream(connection: Connection, unidirectional: Boolean): errors.IntegerResult {
    return open(connection, unidirectional, true)
}
function open(connection: Connection, unidirectional: Boolean, early: Boolean): errors.IntegerResult {
    if early {
        if !connection.clientRole || connection.state != STARTING || connection.earlyWrite.key.length == 0 || connection.earlyRejected {
            return errors.integerFailure(errors.make(errors.unavailableCode(), 0, "QUIC replay-safe early streams are unavailable"))
        }
    } else if connection.state != ESTABLISHED { return errors.integerFailure(errors.make(errors.wouldBlockCode(), 0, "QUIC handshake is incomplete")) }
    let id = connection.nextBidi; let count = connection.peerBidi; let limit = connection.peerBidiRemote
    if unidirectional { id = connection.nextUni; count = connection.peerUni; limit = connection.peerUniData }
    if id / 4 >= count || connection.streams.length >= 128 { return errors.integerFailure(errors.make(errors.wouldBlockCode(), 0, "QUIC stream limit reached")) }
    connection.streams.add(stream.create(id, 65536, limit))
    if early { connection.earlyStreams.add(id) }
    if unidirectional { connection.nextUni += 4 } else { connection.nextBidi += 4 }
    return errors.integer(id)
}
public function writeStream(connection: Connection, id: Integer, data: Bytes, fin: Boolean): errors.IntegerResult {
    return write(connection, id, data, fin, false)
}
public function writeEarlyStream(connection: Connection, id: Integer, data: Bytes, fin: Boolean): errors.IntegerResult {
    return write(connection, id, data, fin, true)
}
function write(connection: Connection, id: Integer, data: Bytes, fin: Boolean, early: Boolean): errors.IntegerResult {
    if connection.earlyRejected && contains(connection.earlyStreams, id) { return errors.integerFailure(errors.make(earlyRejectedCode(), 0, "QUIC early stream was rejected; explicit retry required")) }
    if early && (!connection.clientRole || connection.state != STARTING || connection.earlyWrite.key.length == 0 || !contains(connection.earlyStreams, id)) {
        return errors.integerFailure(errors.make(errors.unavailableCode(), 0, "QUIC replay-safe early stream is unavailable"))
    }
    let index = streamIndex(connection, id)
    if (!early && connection.state != ESTABLISHED) || index < 0 { return errors.integerFailure(errors.make(errors.closedCode(), 0, "QUIC stream is unavailable")) }
    let output = connection.streams[index]
    if output.sendReset { return errors.integerFailure(errors.make(streamResetCode(),output.sendResetCode,"QUIC stream sending was reset")) }
    if output.sendClosed || (!localInitiated(connection, id) && (id & 2) != 0) { return errors.integerFailure(errors.make(errors.closedCode(), 0, "QUIC stream is send-closed")) }
    let count = min(data.length, min(output.sendLimit - output.sendOffset, connection.peerMaxData - connection.sentData))
    let retained = connection.pending.length + connection.history.length
    // Application data leaves room for recovery/control packets. Checking only
    // pending data lets a full queue fail when in-flight packets need retry.
    if count < data.length || data.length > 1048576 || retained + (data.length + 999) / 1000 > 3072 { return errors.integerFailure(errors.make(errors.wouldBlockCode(), 0, "QUIC flow credit or send buffer exhausted")) }
    let at = 0
    while at < count || (fin && count == 0) {
        let length = min(1000, count - at); let type = 14
        if fin && at + length == count { type = 15 }
        let frame = Bytes(); add(frame, type); add(frame, id); add(frame, output.sendOffset); add(frame, length); frame.addBytes(data.slice(at, at + length))
        let level = 2; if early { level = 3; connection.earlyData += length }
        enqueue(connection, level, frame, false); output.sendOffset += length; connection.sentData += length; at += length
        if count == 0 { break }
    }
    if fin { output.sendClosed = true }
    return errors.integer(count)
}
public function readStream(connection: Connection, id: Integer): errors.BytesResult {
    if connection.earlyRejected && contains(connection.earlyStreams, id) { return errors.bytesFailure(errors.make(earlyRejectedCode(), 0, "QUIC early stream was rejected; explicit retry required")) }
    let index = streamIndex(connection, id)
    if index < 0 { if streamRetired(connection,id) { return errors.endOfStream() }; return errors.wouldBlock(0) }
    let input = connection.streams[index]
    if input.reset { input.receiveObserved = true; return errors.bytesFailure(errors.make(streamResetCode(),input.resetCode,"QUIC stream receiving was reset")) }
    let result = stream.take(input)
    if result.length > 0 {
        input.receiveLimit += result.length; connection.receiveMaxData += result.length
        input.consumed += result.length
        let update = Bytes(); add(update, 17); add(update, id); add(update, input.receiveLimit); add(update, 16); add(update, connection.receiveMaxData)
        enqueue(connection, 2, update, false)
        return errors.bytes(result)
    }
    if stream.finished(input) { input.receiveObserved = true; return errors.endOfStream() }
    return errors.wouldBlock(0)
}
public function streamResetCode(): Integer { return 1003 }
public function resetStream(connection: Connection, id: Integer, code: Integer): errors.BooleanResult {
    if code < 0 || code > wire.MAX_VARINT { return errors.booleanFailure(errors.make(errors.invalidDataCode(),0,"invalid stream application error")) }
    let index = streamIndex(connection,id)
    if connection.state != ESTABLISHED || index < 0 || (!localInitiated(connection,id) && (id & 2) != 0) { return errors.booleanFailure(errors.make(errors.closedCode(),0,"stream sending is unavailable")) }
    resetSend(connection,connection.streams[index],code)
    return errors.boolean(true)
}
public function stopSending(connection: Connection, id: Integer, code: Integer): errors.BooleanResult {
    if code < 0 || code > wire.MAX_VARINT { return errors.booleanFailure(errors.make(errors.invalidDataCode(),0,"invalid stream application error")) }
    let index = streamIndex(connection,id)
    if connection.state != ESTABLISHED || index < 0 || (localInitiated(connection,id) && (id & 2) != 0) { return errors.booleanFailure(errors.make(errors.closedCode(),0,"stream receiving is unavailable")) }
    let input = connection.streams[index]
    if !input.reset {
        input.reset = true; input.resetCode = code; consumeDiscard(connection,input)
        if input.final < 0 { let frame = Bytes(); add(frame,5); add(frame,id); add(frame,code); enqueue(connection,2,frame,false) }
    }
    return errors.boolean(true)
}

public function close(connection: Connection, code: Integer, reason: Bytes): errors.BooleanResult {
    if code < 0 || code > wire.MAX_VARINT || reason.length > 1024 { return errors.booleanFailure(errors.make(errors.invalidDataCode(), 0, "invalid QUIC close code or reason")) }
    if connection.state == CLOSED || connection.state == FAILED { return errors.boolean(true) }
    if connection.state != ESTABLISHED { terminate(connection, code, Text(reason)); return errors.boolean(true) }
    connection.pending = []
    let frame = Bytes(); add(frame, 29); add(frame, code); add(frame, reason.length); frame.addBytes(reason)
    connection.state = CLOSED; beginClosing(connection,2,frame)
    return errors.boolean(true)
}
// Release buffers and secrets after the caller finishes closing packets.
public function release(connection: Connection): Boolean {
    if (connection.state != CLOSED && connection.state != FAILED) || connection.closing || connection.draining { return false }
    connection.clientTLS = tls.none(); connection.serverTLS = tlsserver.none()
    connection.spaces = []; connection.pending = []; connection.streams = []; connection.remoteIds = []
    connection.history = []
    connection.closedStreams = []
    connection.paths = []; connection.outgoingPaths = []; connection.earlyStreams = []
    connection.earlyWrite = protection.traffic(1,0,Bytes()); connection.earlyRead = protection.traffic(1,0,Bytes())
    connection.originalDestination = Bytes(); connection.local = Bytes(); connection.remote = Bytes(); connection.peerSource = Bytes()
    connection.initialDestination = Bytes(); connection.initialHandshake = Bytes(); connection.retrySource = Bytes(); connection.retryToken = Bytes()
    return true
}
