// Contained failures: run code that may stop with a program error (a plugin,
// an extension function, a request handler) and get the error back as a value
// instead of the whole process ending.
//
//     match boundary.run(function() { extension.body(call) }) {
//         Ok() { reply(call) }
//         Err(problem) { report(problem.message()) }   // e.g. "List position 5 is outside its length of 1."
//     }
//
// Contained: fail(...), unwrap of None or Err, a position outside a List, Text or
// Bytes, Map keys that are absent, Integer overflow, division and shifts, Integer(Text),
// clamp and Character checks, invalid UTF-8 (text.decodeOrStop). The error's code is
// errors.stoppedCode() and its message is the stop's message.
// Not contained, still ending the process: running out of memory or call depth, runtime
// invariant failures, native-library stops, and a stop inside code the runtime itself
// called (a Map's record key methods, a sort comparator, a parallel loop, a thread).
// Nothing is rolled back: what the body changed before it stopped stays changed,
// so give it state you can throw away (neo-db gives each call its own result
// buffer). Every ownership frame above the boundary is released as on a normal
// return. Linux and macOS; elsewhere the body runs without a boundary.
use "errors" as errors

public function run(body: () -> Nothing): Result<Nothing, errors.Error> { native "boundary" }
// The same with one argument passed to body: a host calling plugin code per item
// (an extension function per row) needs no closure, so a run allocates nothing.
public function runWith<Item>(item: Item, body: (Item) -> Nothing): Result<Nothing, errors.Error> { native "boundary" }

function boundarySuccess(): Result<Nothing, errors.Error> { return Ok() }
function boundaryFailure(message: Text): Result<Nothing, errors.Error> {
    return Err(errors.make(errors.stoppedCode(), 0, message))
}
