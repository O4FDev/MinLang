// Hosted certificate trust and asymmetric signatures. This provider does not
// run a TLS handshake or touch sockets; tls.min owns the TLS protocol.
// Chains and anchors are DER certificates encoded as TLS CertificateEntry
// sequences (three-byte length, certificate, two-byte extension length).
public function chain(host: Text, certificates: Bytes, anchors: Bytes): Text { native "tlsverify" }
public function clientChain(certificates: Bytes, anchors: Bytes): Text { native "tlsverify" }
public function signature(certificate: Bytes, scheme: Integer, content: Bytes, signature: Bytes): Boolean { native "tlsverify" }
// PKCS#8 DER private key, or macOS keychain.signingReference. An unsupported
// or invalid key returns empty Bytes. A Keychain signer never exports its key.
public function sign(privateKey: Bytes, scheme: Integer, content: Bytes): Bytes { native "tlsverify" }
public function currentTimeMilliseconds(): Integer { native "tlsverify" }
// Time bounds only; this does not verify signatures, purpose or trust.
// Return earliest notAfter while every supplied certificate is current,
// otherwise zero. Call chain/clientChain separately for peer authentication.
public function currentCertificateExpiry(certificates: Bytes): Integer { native "tlsverify" }

// Provider-generated ephemeral secp256r1 key material. Private representation
// is native and opaque; the public key is a 65-byte uncompressed SEC1 point.
// Invalid key/point input returns empty Bytes. No signing identity is reused.
public function p256Key(): Bytes { native "tlsverify" }
public function p256Public(privateKey: Bytes): Bytes { native "tlsverify" }
public function p256(privateKey: Bytes, publicKey: Bytes): Bytes { native "tlsverify" }
