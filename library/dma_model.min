// Deterministic device model, not a hardware queue factory. Delivery copies data
// and publishes a queue/slot/generation completion; readiness still validates it.
use "dma" as dma

public function modelQueue(): dma.Queue { native "dma_model" }

// A ring of 1..64 slots: that many requests may be in flight at once, each
// with its own Pending capability, and the model may complete them in any order.
public function modelRing(slots: Integer): dma.Queue { native "dma_model" }

// Completes the oldest outstanding request. False when none is waiting or the
// data exceeds its submitted capacity. Hardware queues reject this model-only API.
public function modelDeliver(queue: dma.Queue, data: Bytes): Boolean { native "dma_model" }

// The same for the newest outstanding request, so completions can overtake.
public function modelDeliverNewest(queue: dma.Queue, data: Bytes): Boolean { native "dma_model" }

// Device/test fault injection after delivery and before ready/reclaim. Kinds:
// 0 device ID, 1 queue ID, 2 slot, 3 request generation, 4 reported length,
// 5 queue epoch, 6 publication sequence. Never operates on hardware queues.
public function modelCorrupt(queue: dma.Queue, kind: Integer, value: Integer) { native "dma_model" }
