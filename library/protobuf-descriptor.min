use "protobuf" as protobuf

/// `google.protobuf.FileDescriptorProto`
public record FileDescriptorProto {
    name: Maybe<Text>
    package: Maybe<Text>
    dependency: List<Text>
    messageType: List<DescriptorProto>
    enumType: List<EnumDescriptorProto>
    service: List<ServiceDescriptorProto>
    syntax: Maybe<Text>
    unknownFields: Bytes
}

public function newFileDescriptorProto(): FileDescriptorProto {
    return FileDescriptorProto {
        name: None
        package: None
        dependency: []
        messageType: []
        enumType: []
        service: []
        syntax: None
        unknownFields: Bytes()
    }
}

public function FileDescriptorProto.name(): Text {
    if self.name is Some(value) { return value }
    return ""
}

public function FileDescriptorProto.package(): Text {
    if self.package is Some(value) { return value }
    return ""
}

public function FileDescriptorProto.syntax(): Text {
    if self.syntax is Some(value) { return value }
    return ""
}

public function readFileDescriptorProto(reader: protobuf.Reader, message: FileDescriptorProto) {
    while reader.more() {
        let tag = reader.readTag()
        match tag {
            10 { message.name = Some(reader.readText()) }
            18 { message.package = Some(reader.readText()) }
            26 { message.dependency.add(reader.readText()) }
            34 {
                let outer = reader.enter()
                if outer >= 0 {
                    let created = newDescriptorProto()
                    readDescriptorProto(reader, created)
                    message.messageType.add(created)
                    reader.leave(outer)
                }
            }
            42 {
                let outer = reader.enter()
                if outer >= 0 {
                    let created = newEnumDescriptorProto()
                    readEnumDescriptorProto(reader, created)
                    message.enumType.add(created)
                    reader.leave(outer)
                }
            }
            50 {
                let outer = reader.enter()
                if outer >= 0 {
                    let created = newServiceDescriptorProto()
                    readServiceDescriptorProto(reader, created)
                    message.service.add(created)
                    reader.leave(outer)
                }
            }
            98 { message.syntax = Some(reader.readText()) }
            _ { reader.keep(tag, message.unknownFields) }
        }
    }
}

