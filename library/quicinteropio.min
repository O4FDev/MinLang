// Bounded file and environment I/O for the isolated interop-runner fixture.
// Not used by QUIC, TLS or application transports.
public function openRead(path: Text): Integer { native "quicinteropio" }
public function openWrite(path: Text): Integer { native "quicinteropio" }
public function size(handle: Integer): Integer { native "quicinteropio" }
public function read(handle: Integer, maximum: Integer): Bytes { native "quicinteropio" }
public function write(handle: Integer, data: Bytes): Integer { native "quicinteropio" }
public function close(handle: Integer): Boolean { native "quicinteropio" }
public function append(path: Text, data: Text): Boolean { native "quicinteropio" }
