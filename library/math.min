// Floating-point mathematics. Integer/Float abs, min, max and clamp remain
// core conveniences. These scalar functions are safe in parallel functions.
/// The nonnegative square root of a Float. Negative inputs produce NaN.
/// This scalar operation can also be called from a parallel function.
///
/// ```minyar
/// print(api.sqrt(9.0))
/// ```
/// ```output
/// 3.0
/// ```
public parallel function sqrt(value: Float): Float { native "runtime" }
/// The sine of an angle in radians.
public parallel function sin(value: Float): Float { native "runtime" }
/// The cosine of an angle in radians.
public parallel function cos(value: Float): Float { native "runtime" }
/// The tangent of an angle in radians.
public parallel function tan(value: Float): Float { native "runtime" }
/// The inverse sine, in radians. Inputs outside -1.0 to 1.0 produce NaN.
public parallel function asin(value: Float): Float { native "runtime" }
/// The inverse cosine, in radians. Inputs outside -1.0 to 1.0 produce NaN.
public parallel function acos(value: Float): Float { native "runtime" }
/// The inverse tangent, in radians.
public parallel function atan(value: Float): Float { native "runtime" }
/// The natural exponential: e raised to the given Float.
public parallel function exp(value: Float): Float { native "runtime" }
/// The natural logarithm. Zero produces negative infinity; negative inputs produce NaN.
public parallel function log(value: Float): Float { native "runtime" }
/// Round toward negative infinity, returning a Float.
public parallel function floor(value: Float): Float { native "runtime" }
/// Round toward positive infinity, returning a Float.
public parallel function ceil(value: Float): Float { native "runtime" }
/// Round to the nearest whole Float; halfway values move away from zero.
///
/// ```minyar
/// print(api.round(-2.5))
/// print(api.floor(2.8))
/// ```
/// ```output
/// -3.0
/// 2.0
/// ```
public parallel function round(value: Float): Float { native "runtime" }
/// The angle in radians for a point: the first argument is y, the second is x.
public parallel function atan2(first: Float, second: Float): Float { native "runtime" }
/// Raise the first Float to the power of the second.
public parallel function pow(first: Float, second: Float): Float { native "runtime" }
