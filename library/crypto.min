// Cryptography for TLS 1.3: SHA-256, HMAC, HKDF, ChaCha20-Poly1305 and X25519.
// Import it with `use "crypto" as crypto`.
//
// SHA-256/HMAC/HKDF use fixed-shape Minyar arithmetic. X25519 and
// ChaCha20/Poly1305 use pinned unmodified Monocypher native primitives.
// See vendor/README.md for provenance and the limits of upstream audit evidence.
use "securecrypto" as native

constant MASK = 0xFFFFFFFF

// ----- SHA-256 -----

function rotateRight(value: Integer, count: Integer): Integer {
    return ((value >> count) | (value << (32 - count))) & MASK
}

function roundConstants(): List<Integer> {
    return [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]
}

// The SHA-256 digest of `data`: 32 bytes.
public function sha256(data: Bytes): Bytes {
    let k = roundConstants()
    let h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    let message = data.slice(0, data.length)
    let bits = data.length * 8
    message.add(0x80)
    while message.length % 64 != 56 {
        message.add(0)
    }
    for index in 0..8 {
        message.add((bits >> ((7 - index) * 8)) & 255)
    }
    let w: List<Integer> = []
    for index in 0..64 { w.add(0) }
    let block = 0
    while block < message.length {
        for index in 0..16 {
            let at = block + index * 4
            w[index] = (message[at] << 24) | (message[at + 1] << 16) | (message[at + 2] << 8) | message[at + 3]
        }
        for index in 16..64 {
            let s0 = rotateRight(w[index - 15], 7) ^ rotateRight(w[index - 15], 18) ^ (w[index - 15] >> 3)
            let s1 = rotateRight(w[index - 2], 17) ^ rotateRight(w[index - 2], 19) ^ (w[index - 2] >> 10)
            w[index] = (w[index - 16] + s0 + w[index - 7] + s1) & MASK
        }
        let a = h[0]
        let b = h[1]
        let c = h[2]
        let d = h[3]
        let e = h[4]
        let f = h[5]
        let g = h[6]
        let hh = h[7]
        for index in 0..64 {
            let s1 = rotateRight(e, 6) ^ rotateRight(e, 11) ^ rotateRight(e, 25)
            let choose = (e & f) ^ ((~e & MASK) & g)
            let first = (hh + s1 + choose + k[index] + w[index]) & MASK
            let s0 = rotateRight(a, 2) ^ rotateRight(a, 13) ^ rotateRight(a, 22)
            let majority = (a & b) ^ (a & c) ^ (b & c)
            let second = (s0 + majority) & MASK
            hh = g
            g = f
            f = e
            e = (d + first) & MASK
            d = c
            c = b
            b = a
            a = (first + second) & MASK
        }
        h[0] = (h[0] + a) & MASK
        h[1] = (h[1] + b) & MASK
        h[2] = (h[2] + c) & MASK
        h[3] = (h[3] + d) & MASK
        h[4] = (h[4] + e) & MASK
        h[5] = (h[5] + f) & MASK
        h[6] = (h[6] + g) & MASK
        h[7] = (h[7] + hh) & MASK
        block += 64
    }
    let digest = Bytes()
    for word in h {
        digest.add((word >> 24) & 255)
        digest.add((word >> 16) & 255)
        digest.add((word >> 8) & 255)
        digest.add(word & 255)
    }
    return digest
}

public function hex(data: Bytes): Text {
    let digits = "0123456789abcdef"
    let parts: List<Text> = []
    for byte in data {
        parts.add(Text(digits[byte >> 4]))
        parts.add(Text(digits[byte & 15]))
    }
    return joinText(parts)
}

public function fromHex(text: Text): Bytes {
    let result = Bytes()
    let index = 0
    while index + 1 < text.length {
        result.add(hexValue(text[index]) * 16 + hexValue(text[index + 1]))
        index += 2
    }
    return result
}

function hexValue(character: Character): Integer {
    let code = Integer(character)
    if code >= 97 { return code - 87 }
    if code >= 65 { return code - 55 }
    return code - 48
}

// ----- HMAC and HKDF -----

public function hmac(key: Bytes, message: Bytes): Bytes {
    let block = key.slice(0, key.length)
    if block.length > 64 { block = sha256(block) }
    block.resize(64)
    let inner = Bytes()
    let outer = Bytes()
    for byte in block {
        inner.add(byte ^ 0x36)
        outer.add(byte ^ 0x5c)
    }
    inner.addBytes(message)
    outer.addBytes(sha256(inner))
    return sha256(outer)
}

public function hkdfExtract(salt: Bytes, keyMaterial: Bytes): Bytes {
    let key = salt
    if key.length == 0 { key = Bytes(32) }
    return hmac(key, keyMaterial)
}

public function hkdfExpand(secret: Bytes, info: Bytes, length: Integer): Bytes {
    let result = Bytes()
    let previous = Bytes()
    let counter = 1
    while result.length < length {
        let input = previous.slice(0, previous.length)
        input.addBytes(info)
        input.add(counter)
        previous = hmac(secret, input)
        result.addBytes(previous)
        counter += 1
    }
    result.resize(length)
    return result
}

// TLS 1.3's HKDF-Expand-Label.
public function expandLabel(secret: Bytes, label: Text, context: Bytes, length: Integer): Bytes {
    let full = Bytes("tls13 " + label)
    let info = Bytes()
    info.add((length >> 8) & 255)
    info.add(length & 255)
    info.add(full.length)
    info.addBytes(full)
    info.add(context.length)
    info.addBytes(context)
    return hkdfExpand(secret, info, length)
}

// Native constant-time primitive provider; public lengths remain observable.
public function chachaBlock(key: Bytes, counter: Integer, nonce: Bytes): Bytes {
    return native.chacha20(key, counter, nonce, Bytes(64))
}
public function chacha20(key: Bytes, counter: Integer, nonce: Bytes, data: Bytes): Bytes { return native.chacha20(key, counter, nonce, data) }
public function poly1305(key: Bytes, message: Bytes): Bytes { return native.poly1305(key, message) }
public function seal(key: Bytes, nonce: Bytes, additional: Bytes, plaintext: Bytes): Bytes { return native.seal(key, nonce, additional, plaintext) }
public record Opened { valid: Boolean; plaintext: Bytes }
public function open(key: Bytes, nonce: Bytes, additional: Bytes, sealed: Bytes): Opened {
    let result = native.open(key, nonce, additional, sealed)
    if result.length == 0 { return Opened { valid: false; plaintext: Bytes() } }
    return Opened { valid: true; plaintext: result.slice(1, result.length) }
}
public function x25519(scalar: Bytes, point: Bytes): Bytes { return native.x25519(scalar, point) }
public function constantTimeEqual(left: Bytes, right: Bytes): Boolean { return native.equal(left, right) }
public function x25519Public(privateKey: Bytes): Bytes {
    let base = Bytes(32); base[0] = 9; return native.x25519(privateKey, base)
}
