// Typed adapters for ordinary networking status records. Compile clients with
// the opt-in Result frontend; ordinary net/errors modules keep their ABI.
use "errors" as errors
use "net" as net

public record Read {
    private dataBytes: Bytes
    private eofFlag: Boolean
}
public record ReadFailure {
    private diagnostic: errors.Error
    private readablePrefix: Bytes
}

public function data(read: Read): Bytes { return read.dataBytes }
public function ended(read: Read): Boolean { return read.eofFlag }
public function error(failure: ReadFailure): errors.Error { return failure.diagnostic }
public function prefix(failure: ReadFailure): Bytes { return failure.readablePrefix }

public function integer(result: errors.IntegerResult): Result<Integer, errors.Error> {
    if errors.integerOk(result) { return Ok<Integer, errors.Error>(errors.integerValue(result)) }
    return Err<Integer, errors.Error>(errors.integerError(result))
}
public function boolean(result: errors.BooleanResult): Result<Boolean, errors.Error> {
    if errors.booleanOk(result) { return Ok<Boolean, errors.Error>(errors.booleanValue(result)) }
    return Err<Boolean, errors.Error>(errors.booleanError(result))
}
public function bytes(result: errors.BytesResult): Result<Read, ReadFailure> {
    let status = errors.bytesStatus(result)
    if status == errors.successStatus() || status == errors.endOfStreamStatus() {
        return Ok<Read, ReadFailure>(Read {
            dataBytes: errors.bytesValue(result); eofFlag: status == errors.endOfStreamStatus()
        })
    }
    let readable = Bytes()
    if status == errors.truncatedStatus() { readable = errors.bytesValue(result) }
    return Err<Read, ReadFailure>(ReadFailure {
        diagnostic: errors.bytesError(result); readablePrefix: readable
    })
}
public function read(connection: Integer, limit: Integer): Result<Read, ReadFailure> {
    return bytes(net.read(connection, limit))
}
public function receiveDatagram(connection: Integer, limit: Integer): Result<Read, ReadFailure> {
    return bytes(net.receiveDatagram(connection, limit))
}
public function write(connection: Integer, data: Bytes): Result<Integer, errors.Error> {
    return integer(net.write(connection, data))
}
public function connectStart(address: Text, port: Integer): Result<Integer, errors.Error> {
    return integer(net.connectStart(address, port))
}
public function connectFinish(connection: Integer): Result<Boolean, errors.Error> {
    return boolean(net.connectFinish(connection))
}

