// Pinned unmodified Monocypher primitives. Protocols remain Minyar.
// Invalid sizes, counter exhaustion and low-order X25519 return empty Bytes.
public function x25519(privateKey: Bytes, publicKey: Bytes): Bytes { native "securecrypto" }
public function chacha20(key: Bytes, counter: Integer, nonce: Bytes, input: Bytes): Bytes { native "securecrypto" }
public function poly1305(key: Bytes, message: Bytes): Bytes { native "securecrypto" }
public function seal(key: Bytes, nonce: Bytes, additional: Bytes, plaintext: Bytes): Bytes { native "securecrypto" }
// A status byte followed by authenticated plaintext; failure is empty.
public function open(key: Bytes, nonce: Bytes, additional: Bytes, sealed: Bytes): Bytes { native "securecrypto" }
public function equal(left: Bytes, right: Bytes): Boolean { native "securecrypto" }
