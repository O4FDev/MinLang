function parseReady(server: Server, slot: Integer, now: Integer, ready: List<Request>) {
    let connection = server.connections[slot]
    let result = parseNext(connection, server.limits, now, server.handle, slot, server.nextTicket)
    if result.status == -2 { drop(server, slot); return }
    if result.status > 0 { reject(server, slot, result.status); return }
    match result.request {
        Some(request) {
            server.nextTicket += 1
            removeWatch(server, connection)
            ready.add(request)
        }
        None {}
    }
