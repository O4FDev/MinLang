// Write the last chunk. The connection then serves its next request or closes.
public function finishStream(server: Server, request: Request): Boolean {
    if !streamActive(server, request) { return false }
    let connection = server.connections[request.slot]
    let now = net.monotonicMilliseconds()
    let last = finishChunks(connection, server.limits, now)
    if last.length > 0 && !place(server, request.slot, last) { return false }
    if !watch(server, request.slot, loop.writableInterest()) { return false }
    flush(server, request.slot, now)
    return true
}

// Clamp a shared loop's wait to the earliest deadline and buffered pipeline work.
public function waitMilliseconds(server: Server, requested: Integer): Integer {
    if server.closed { return 0 }
    let now = net.monotonicMilliseconds()
    let timeout = requested
    if timeout < 0 { timeout = 86400000 }
    for connection in server.connections {
        if connection.active {
            if connection.needsParse { return 0 }
            timeout = min(timeout, max(0, connection.deadline - now))
            if connection.phase == 2 && connection.writeProbeAt >= 0 {
                timeout = min(timeout, max(0, connection.writeProbeAt - now))
            }
        }
    }
    return timeout
}
function takeEnded(server: Server): List<Integer> {
    let ended = server.ended
    server.ended = []
