        if connection.input.length - start >= 5 {
            head = connection.input[start] == 72 && connection.input[start + 1] == 69 && connection.input[start + 2] == 65 &&
                connection.input[start + 3] == 68 && connection.input[start + 4] == 32
        }
    }
