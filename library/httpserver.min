}
function validResponse(response: Response, limits: Limits): Boolean {
    if response.status < 200 || response.status > 599 || response.body.length > limits.maxResponseBytes ||
        response.headers.length > limits.maxHeaders { return false }
    let bytes = 128
    for field in response.headers {
        let name = Bytes(field.name)
        if name.length == 0 { return false }
        for byte in name { if !tokenByte(byte) { return false } }
        let lower = lowercase(name)
        if lower == "content-length" || lower == "transfer-encoding" || lower == "connection" || lower == "trailer" || lower == "upgrade" { return false }
        for byte in Bytes(field.value) { if (byte < 32 && byte != 9) || byte >= 127 { return false } }
        let size = field.name.byteLength + field.value.byteLength + 4
        if size > limits.maxHeaderBytes - bytes { return false }
        bytes += size
    }
    return true
}
public function respond(server: Server, request: Request, response: Response): Boolean {
    if !requestActive(server, request) || !validResponse(response, server.limits) { return false }
    let connection = server.connections[request.slot]
