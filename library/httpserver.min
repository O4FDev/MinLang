// TLS connections feed socket bytes through their session; only authenticated
// plaintext reaches the HTTP parser. Handshake output is written before more
// input is read, and a failed handshake or record closes this connection only.
function readSecure(server: Server, slot: Integer, now: Integer, ready: List<Request>) {
    let connection = server.connections[slot]
    let ops = tlsSession(server, slot)
    let capacity = server.limits.maxHeaderBytes + server.limits.maxBodyBytes
    let pending = ops.takeIncoming()
    if pending.length > 0 { connection.input.addBytes(pending) }
    let buffered = connection.input.length - connection.inputStart
    if buffered < capacity {
        let count = ops.feed(connection.socket, min(server.limits.ioBudget, capacity - buffered))
        if count == -2 { drop(server, slot); return }
        if count == 0 {
            // The transport is gone. Without an authenticated close no request
            // in progress can complete, so the session ends with the socket.
            ops.endInput()
            if ops.state() != TRANSPORT_ESTABLISHED { drop(server, slot); return }
            connection.eof = true
        }
        if ops.state() == TRANSPORT_FAILED || ops.state() == TRANSPORT_CLOSED {
            drop(server, slot); return
        }
        pending = ops.takeIncoming()
        if pending.length > 0 { connection.input.addBytes(pending) }
    }
    if !connection.started {
        connection.started = true; connection.deadline = now + server.limits.headerMilliseconds
    }
    let reply = ops.takeOutgoing()
    if reply.length > 0 {
        connection.output.addBytes(reply)
        // Handshake bytes must reach the peer before it can send its next flight.
        if connection.phase == 0 {
            connection.phase = 2; connection.closing = false; connection.closeSent = false
            connection.writeHup = false; connection.writeProbeAt = -1
            connection.deadline = now + server.limits.headerMilliseconds
            if !watch(server, slot, loop.writableInterest()) { return }
            flush(server, slot, now)
        }
        if connection.phase == 2 { return }
    }
    parseReady(server, slot, now, ready)
}
function readReady(server: Server, slot: Integer, now: Integer, ready: List<Request>) {
    let connection = server.connections[slot]
    if isTls(server, slot) { readSecure(server, slot, now, ready); return }
    let capacity = server.limits.maxHeaderBytes + server.limits.maxBodyBytes
    let buffered = connection.input.length - connection.inputStart
    // A single bounded native read per readiness turn; cached headers avoid rescans.
    // The read reserves its whole limit, so a connection with nothing buffered
    // reads 4 KiB first: idle keep-alive connections keep a few KiB, and a
    // request that needs more gets full-budget reads.
    let limit = min(server.limits.ioBudget, capacity - buffered)
    if buffered == 0 { limit = min(limit, 4096) }
    let count = net.readInto(connection.socket, connection.input, limit)
    if count == -1 { return }
    if count == -2 { drop(server, slot); return }
    if count == 0 {
        connection.eof = true
        if connection.inputStart == connection.input.length { drop(server, slot); return }
    }
    if !connection.started {
        connection.started = true; connection.deadline = now + server.limits.headerMilliseconds
    }
    parseReady(server, slot, now, ready)
