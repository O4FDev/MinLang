// End a stream: the last chunk is written, then the next request is served.
function finishChunks(connection: Connection, limits: Limits, now: Integer): Bytes {
    connection.phase = 2; connection.ticket = 0
    connection.deadline = now + limits.writeMilliseconds
    if connection.quiet { return Bytes() }
    return Bytes("0\r\n\r\n")
