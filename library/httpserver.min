// Socket driver.
function flush(server: Server, slot: Integer, now: Integer) {
    let connection = server.connections[slot]
    connection.writeProbeAt = -1
    let budget = server.limits.ioBudget
    let secure = isTls(server, slot)
    while budget > 0 {
        if secure {
            let ops = tlsSession(server, slot)
            // The socket only ever carries TLS records: encrypt the plaintext
            // body in bounded records once the queued ciphertext is drained.
            if connection.sent == connection.output.length && connection.bodySent < connection.body.length {
                let take = min(16384, connection.body.length - connection.bodySent)
                ops.send(connection.body.slice(connection.bodySent, connection.bodySent + take))
                connection.bodySent += take
                connection.output = ops.takeOutgoing()
                connection.sent = 0
                if ops.state() != TRANSPORT_ESTABLISHED { drop(server, slot); return }
            }
            // A closing TLS connection ends with an authenticated close_notify.
            if connection.phase == 2 && connection.closing && !connection.closeSent && connection.sent == connection.output.length &&
               connection.bodySent == connection.body.length && ops.state() == TRANSPORT_ESTABLISHED {
                connection.closeSent = true
                ops.close()
                connection.output = ops.takeOutgoing()
                connection.sent = 0
            }
        }
        let data = connection.output
        let offset = connection.sent
        let writingHead = true
        if offset == data.length && !secure { data = connection.body; offset = connection.bodySent; writingHead = false }
        if offset == data.length { break }
        let count = net.writeRange(connection.socket, data, offset, min(budget, data.length - offset))
        if count == -1 {
            // HUP remains ready even with writable-only or zero interest.
            // Keep the socket/unsent body, but remove the persistent watch and
            // let shared-loop wait clamping schedule a bounded direct probe.
            if connection.writeHup {
                removeWatch(server, connection)
                connection.writeProbeAt = now + 10
            }
            return
        }
        if count <= 0 { drop(server, slot); return }
        if writingHead { connection.sent += count } else { connection.bodySent += count }
        budget -= count
        // A stream's deadline only bounds a stalled reader.
        if connection.phase == 3 { connection.deadline = now + server.limits.writeMilliseconds }
    }
    if queuedOutput(connection) != 0 || secure && connection.phase == 2 && connection.closing && !connection.closeSent {
        // A paused writer that used its I/O budget made real progress. Give it
        // one more bounded turn without reinstalling a permanently ready HUP.
        if connection.registration < 0 { connection.writeProbeAt = now }
        return
    }
    if connection.phase == 3 {
        streamDrained(connection)
        watch(server, slot, loop.readableInterest())
