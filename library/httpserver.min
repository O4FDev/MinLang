// The response is written: return to reading the next request.
function nextRequest(connection: Connection, limits: Limits, now: Integer) {
    connection.output.clear(); connection.sent = 0; connection.body = Bytes()
    connection.phase = 0
    let unread = connection.input.length - connection.inputStart
    // Keep retained storage bounded without copying the unread pipeline after
    // every request. Copy only when the consumed prefix can pay for the tail.
    if connection.inputStart >= 65536 && connection.inputStart >= unread {
        connection.input = connection.input.slice(connection.inputStart, connection.input.length)
        connection.inputStart = 0
    }
    connection.started = connection.inputStart < connection.input.length
    connection.needsParse = connection.started
    connection.scan = connection.inputStart; connection.headerBytes = 0; connection.parsed = badHead(0)
