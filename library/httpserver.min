// A streaming connection reads only to notice the client leaving: end of
// input or a reset releases the stream. Pipelined bytes wait in the bounded
// input until the stream finishes; a client that overfills it is dropped.
function readStreaming(server: Server, slot: Integer) {
    let connection = server.connections[slot]
    let capacity = server.limits.maxHeaderBytes + server.limits.maxBodyBytes
    let buffered = connection.input.length - connection.inputStart
    if buffered >= capacity { drop(server, slot); return }
    let limit = min(min(server.limits.ioBudget, 4096), capacity - buffered)
    if isTls(server, slot) {
        let ops = tlsSession(server, slot)
        let count = ops.feed(connection.socket, limit)
        if count == 0 || count == -2 || ops.state() != TRANSPORT_ESTABLISHED { drop(server, slot); return }
        let pending = ops.takeIncoming()
        if pending.length > 0 { connection.input.addBytes(pending) }
        let reply = ops.takeOutgoing()
        if reply.length > 0 {
            append(connection, reply)
            watch(server, slot, loop.readWriteInterest())
        }
        return
    }
    let count = net.readInto(connection.socket, connection.input, limit)
    if count == 0 || count == -2 { drop(server, slot) }
