    }
    connection.bodySent = 0; connection.writeHup = false; connection.writeProbeAt = -1; connection.closeSent = false
    connection.closing = closing
    connection.quiet = streaming && head
    connection.deadline = now + limits.writeMilliseconds
    if streaming { connection.phase = 3 } else { connection.phase = 2; connection.ticket = 0 }
