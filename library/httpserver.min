public function stream(server: Server, request: Request, response: Response): Boolean {
    if !requestActive(server, request) || !validResponse(response, server.limits) || bodiless(response.status) { return false }
    let connection = server.connections[request.slot]
    return startResponse(server, request.slot, response, connection.parsed.method == "HEAD",
        closingAfter(connection, server.limits, server.draining), true)
