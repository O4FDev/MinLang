    let connection = server.connections[request.slot]
    if !streamRoom(connection, server.limits, piece.length) { return false }
    if piece.length == 0 || connection.quiet { return true }
    let now = net.monotonicMilliseconds()
    let idle = queuedOutput(connection) == 0
    if !place(server, request.slot, chunk(piece)) { return false }
    if idle {
        connection.deadline = now + server.limits.writeMilliseconds
        if !watch(server, request.slot, loop.readWriteInterest()) { return false }
    }
    flush(server, request.slot, now)
    return true
