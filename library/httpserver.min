// Bounded, single-owner HTTP/1.1 server over the portable event loop.
// No callbacks: poll/advance returns requests; respond consumes a private ticket.
// Request transfer codings are deliberately rejected (501 + close).
// A TLS module (library/httpstls.min) can terminate TLS 1.3 per connection with
// the same Server API through listenWith; plain HTTP never imports or links it.
// See docs/http-server.md.
use "net" as net
use "eventloop" as loop
use "errors" as errors
use "text" as utf8

// A per-connection byte-stream transport supplied by a TLS module. The server
// only ever hands it socket records and authenticated plaintext, so the HTTP
// core itself names no TLS type and links no crypto code.
public constant TRANSPORT_ESTABLISHED = 3
public constant TRANSPORT_CLOSED = 4
public constant TRANSPORT_FAILED = 5
public record TlsOps {
    state: () -> Integer
    takeIncoming: () -> Bytes
    takeOutgoing: () -> Bytes
    send: (Bytes) -> Nothing
    endInput: () -> Nothing
    close: () -> Nothing
    // Read up to limit socket bytes into the session; net.readInto count rules.
    feed: (Integer, Integer) -> Integer
}
public record TlsFactory {
    // "" when the identity/key can serve; otherwise the configuration error.
    validate: () -> Text
    // One transport per accepted socket, or None when this handshake cannot start.
    open: () -> Maybe<TlsOps>
}
// One optional reference on Server: plain listening keeps it None, so a plain
// connection stores no TLS field and a plain server allocates no TLS state.
record TlsState { factory: TlsFactory; ops: List<Maybe<TlsOps>> }

public record Limits {
    maxConnections: Integer
    maxHeaderBytes: Integer
    maxHeaders: Integer
    maxBodyBytes: Integer
    maxResponseBytes: Integer
    maxRequestsPerConnection: Integer
    acceptBudget: Integer
    ioBudget: Integer
    maxEvents: Integer
    idleMilliseconds: Integer
    headerMilliseconds: Integer
    bodyMilliseconds: Integer
    applicationMilliseconds: Integer
    writeMilliseconds: Integer
    // Unsent bytes one streamed response may queue before send returns false.
    streamBufferBytes: Integer
}
public function defaults(): Limits {
    return Limits { maxConnections: 1024; maxHeaderBytes: 16384; maxHeaders: 64;
        maxBodyBytes: 1048576; maxResponseBytes: 16777216; maxRequestsPerConnection: 1000;
        acceptBudget: 32; ioBudget: 65536; maxEvents: 256; idleMilliseconds: 30000;
        headerMilliseconds: 5000; bodyMilliseconds: 10000; applicationMilliseconds: 30000;
        writeMilliseconds: 10000; streamBufferBytes: 65536 }
}
public record Header { name: Text; value: Text }
public record Request {
    method: Text
    target: Text
    headers: List<Header>
    body: Bytes
    keepAlive: Boolean
    private owner: Integer
    private slot: Integer
    private ticket: Integer
}
public record Response { status: Integer; headers: List<Header>; body: Bytes }
public function response(status: Integer, contentType: Text, body: Bytes): Response {
    return Response { status: status; headers: [Header { name: "content-type"; value: contentType }]; body: body }
}
public function requestId(request: Request): Integer { return request.ticket }
public function header(request: Request, name: Text): Text {
    let lower = lowercase(Bytes(name))
    for field in request.headers { if field.name == lower { return field.value } }
    return ""
}

record Head {
    status: Integer
    method: Text
    target: Text
    headers: List<Header>
    length: Integer
    // Transfer-Encoding: chunked; the body is decoded as it arrives.
    chunked: Boolean
    keepAlive: Boolean
}
record Connection {
    active: Boolean
    socket: Integer
    registration: Integer
    // 0 reading, 1 application (unwatched), 2 writing, 3 streaming a chunked
    // body (the request ticket stays valid until finishStream).
    phase: Integer
    input: Bytes
    inputStart: Integer
    scan: Integer
    headerBytes: Integer
    parsed: Head
    deadline: Integer
    started: Boolean
    needsParse: Boolean
    eof: Boolean
    ticket: Integer
    count: Integer
    output: Bytes
    body: Bytes
    sent: Integer
    bodySent: Integer
    closing: Boolean
    closeSent: Boolean
    writeHup: Boolean
    writeProbeAt: Integer
    // Chunked request body: the next chunk-size line and the decoded bytes.
    chunkAt: Integer
    decoded: Bytes
    // A streamed HEAD response: pieces are accepted and not sent.
    quiet: Boolean
}
public record Server {
    private handle: Integer
    private listener: Integer
    private listenerRegistration: Integer
    private limits: Limits
    // None for plain listen, so a plain server allocates no TLS state at all.
    private tls: Maybe<TlsState>
    private connections: List<Connection>
    private freeSlots: List<Integer>
    private freeCount: Integer
    private active: Integer
    private nextTicket: Integer
    private closed: Boolean
    private draining: Boolean
    private error: errors.Error
    // Tickets of streams released since the last Batch.
    private ended: List<Integer>
}
public record Batch { private requests: List<Request>; private error: errors.Error; private ended: List<Integer>; private accepted: Integer }
public function requests(batch: Batch): List<Request> { return batch.requests }
public function batchError(batch: Batch): errors.Error { return batch.error }
// requestIds of streams the server released (client disconnect, stalled
// writes or close) since the previous Batch; their send calls return false.
public function endedStreams(batch: Batch): List<Integer> { return batch.ended }
// Bytes a Session.receive call consumed; the caller offers the rest later.
public function accepted(batch: Batch): Integer { return batch.accepted }
function makeBatch(requests: List<Request>, error: errors.Error, ended: List<Integer>): Batch {
    return Batch { requests: requests; error: error; ended: ended; accepted: 0 }
}
public function serverError(server: Server): errors.Error { return server.error }
public function ok(server: Server): Boolean { return !server.closed && !errors.isError(server.error) }
public function port(server: Server): Integer {
    if server.closed { return -1 }
    return net.localPort(server.listener)
}
public function loopHandle(server: Server): Integer { return server.handle }
public function connectionCount(server: Server): Integer { return server.active }
public function slotCount(server: Server): Integer { return server.connections.length }

function durationValid(value: Integer): Boolean { return value > 0 && value <= 86400000 }
function validLimits(limits: Limits): Boolean {
    return limits.maxConnections > 0 && limits.maxConnections <= 65536 &&
        limits.maxHeaderBytes >= 256 && limits.maxHeaderBytes <= 1048576 &&
        limits.maxHeaders > 0 && limits.maxHeaders <= 4096 &&
        limits.maxBodyBytes >= 0 && limits.maxBodyBytes <= 16777216 &&
        limits.maxResponseBytes >= 0 && limits.maxResponseBytes <= 16777216 &&
        limits.maxRequestsPerConnection > 0 && limits.maxRequestsPerConnection <= 1000000 &&
        limits.acceptBudget > 0 && limits.acceptBudget <= 1024 &&
        limits.ioBudget > 0 && limits.ioBudget <= 1048576 &&
        limits.maxEvents > 0 && limits.maxEvents <= 4096 &&
        durationValid(limits.idleMilliseconds) && durationValid(limits.headerMilliseconds) &&
        durationValid(limits.bodyMilliseconds) && durationValid(limits.applicationMilliseconds) &&
        durationValid(limits.writeMilliseconds) &&
        limits.streamBufferBytes >= 1024 && limits.streamBufferBytes <= 16777216
}
// Snapshot mutable Limits so callers cannot raise bounds mid-connection.
function copyLimits(limits: Limits): Limits {
    return Limits { maxConnections: limits.maxConnections; maxHeaderBytes: limits.maxHeaderBytes;
        maxHeaders: limits.maxHeaders; maxBodyBytes: limits.maxBodyBytes; maxResponseBytes: limits.maxResponseBytes;
        maxRequestsPerConnection: limits.maxRequestsPerConnection; acceptBudget: limits.acceptBudget;
        ioBudget: limits.ioBudget; maxEvents: limits.maxEvents; idleMilliseconds: limits.idleMilliseconds;
        headerMilliseconds: limits.headerMilliseconds; bodyMilliseconds: limits.bodyMilliseconds;
        applicationMilliseconds: limits.applicationMilliseconds; writeMilliseconds: limits.writeMilliseconds;
        streamBufferBytes: limits.streamBufferBytes }
}
public function listen(host: Text, port: Integer, limits: Limits): Server {
    return start(host, port, limits, None)
}
// The same Server API over a transport supplied by a TLS module: socket bytes
// are TLS records and requests/responses stay plaintext in memory. Plain
// callers use listen and never reach any of this code.
public function listenWith(host: Text, port: Integer, limits: Limits, factory: TlsFactory): Server {
    return start(host, port, limits, Some(TlsState { factory: factory; ops: [] }))
}
function start(host: Text, port: Integer, limits: Limits, tls: Maybe<TlsState>): Server {
    let copied = copyLimits(limits)
    let server = Server { handle: -1; listener: -1; listenerRegistration: -1; limits: copied;
        tls: tls;
        connections: []; freeSlots: []; freeCount: 0; active: 0; nextTicket: 1; closed: false; draining: false; error: errors.none(); ended: [] }
    if !validLimits(copied) {
        server.error = errors.make(errors.invalidDataCode(), 0, "invalid HTTP server limits")
        server.closed = true
        return server
    }
    // Validate the transport's configuration once, before accepting: a
    // configuration error must never turn into per-connection failures.
    match tls {
        Some(state) {
            let problem = state.factory.validate()
            if problem != "" {
                server.error = errors.make(errors.invalidDataCode(), 0, problem)
                server.closed = true
                return server
            }
        }
        None {}
    }
    let created = loop.create()
    if !errors.integerOk(created) {
        server.error = errors.integerError(created); server.closed = true; return server
    }
    server.handle = errors.integerValue(created)
    server.listener = net.listen(host, port, copied.maxConnections)
    if server.listener < 0 {
        server.error = errors.make(errors.systemCode(), net.lastErrorCode(), "HTTP listen failed")
        close(server); return server
    }
    let watched = loop.watch(server.handle, server.listener, loop.readableInterest(), -1)
    if !errors.integerOk(watched) {
        server.error = errors.integerError(watched); close(server); return server
    }
    server.listenerRegistration = errors.integerValue(watched)
    return server
}

// The connection is gone: report an open stream and free its buffers.
function release(connection: Connection, ended: List<Integer>) {
    if connection.phase == 3 && connection.ticket != 0 { ended.add(connection.ticket) }
    connection.active = false
    connection.ticket = 0
    connection.input = Bytes(); connection.output = Bytes(); connection.body = Bytes(); connection.decoded = Bytes()
    connection.parsed = badHead(0)
}
function badHead(status: Integer): Head {
    return Head { status: status; method: ""; target: ""; headers: []; length: 0; chunked: false; keepAlive: false }
}
function newConnection(socket: Integer, deadline: Integer): Connection {
    return Connection { active: true; socket: socket; registration: -1;
        phase: 0; input: Bytes();
        inputStart: 0; scan: 0; headerBytes: 0; parsed: badHead(0); deadline: deadline; started: false;
        needsParse: false; eof: false; ticket: 0; count: 0; output: Bytes(); body: Bytes();
        sent: 0; bodySent: 0; closing: false; closeSent: false; writeHup: false; writeProbeAt: -1; chunkAt: 0; decoded: Bytes(); quiet: false }
}
function removeWatch(server: Server, connection: Connection) {
    if connection.registration >= 0 {
        loop.remove(server.handle, connection.registration)
        connection.registration = -1
    }
}
// TLS state lives beside the connection slots, never inside Connection: a
// plain connection carries no TLS field at all, and dropping the Maybe releases
// the session, keys and handshake buffers with its slot.
function tlsAt(server: Server, slot: Integer): Maybe<TlsOps> {
    match server.tls {
        Some(state) {
            if slot >= 0 && slot < state.ops.length { return state.ops[slot] }
        }
        None {}
    }
    return None
}
function isTls(server: Server, slot: Integer): Boolean {
    return tlsAt(server, slot).isSome()
}
function tlsSession(server: Server, slot: Integer): TlsOps {
    match tlsAt(server, slot) {
        Some(ops) { return ops }
        None { fail("httpserver: the connection is not using TLS") }
    }
}
function drop(server: Server, slot: Integer) {
    let connection = server.connections[slot]
    if !connection.active { return }
    removeWatch(server, connection)
    net.close(connection.socket)
    release(connection, server.ended)
    match server.tls {
        Some(state) { if slot < state.ops.length { state.ops[slot] = None } }
        None {}
    }
    server.active -= 1
    if server.freeCount < server.freeSlots.length { server.freeSlots[server.freeCount] = slot }
    else { server.freeSlots.add(slot) }
    server.freeCount += 1
    // Unwatch the full listener (rather than interest=0) to avoid HUP spin.
    if !server.closed && !server.draining && server.listenerRegistration < 0 {
        let watched = loop.watch(server.handle, server.listener, loop.readableInterest(), -1)
        if errors.integerOk(watched) { server.listenerRegistration = errors.integerValue(watched) }
        else { server.error = errors.integerError(watched) }
    }
}
public function close(server: Server) {
    if server.closed { return }
    server.closed = true
    for slot in 0..server.connections.length { drop(server, slot) }
    if server.listenerRegistration >= 0 {
        loop.remove(server.handle, server.listenerRegistration); server.listenerRegistration = -1
    }
    if server.listener >= 0 { net.close(server.listener); server.listener = -1 }
    if server.handle >= 0 { loop.close(server.handle) }
    server.tls = None
}
// Stop accepting and reading new requests. Already dispatched requests retain
// their tickets; their responses finish before closing. Keep advancing the
// shared loop until connectionCount reaches zero, then close the server.
public function drain(server: Server) {
    if server.closed || server.draining { return }
    server.draining = true
    if server.listenerRegistration >= 0 {
        loop.remove(server.handle, server.listenerRegistration); server.listenerRegistration = -1
    }
    if server.listener >= 0 { net.close(server.listener); server.listener = -1 }
    for slot in 0..server.connections.length {
        let connection = server.connections[slot]
        if connection.active {
            if connection.phase == 0 { drop(server, slot) }
            else { connection.closing = true }
        }
    }
}
function watch(server: Server, slot: Integer, interest: Integer): Boolean {
    let connection = server.connections[slot]
    if connection.registration >= 0 {
        if errors.booleanOk(loop.update(server.handle, connection.registration, interest, slot)) { return true }
    } else {
        let watched = loop.watch(server.handle, connection.socket, interest, slot)
        if errors.integerOk(watched) { connection.registration = errors.integerValue(watched); return true }
    }
    drop(server, slot)
    return false
}
function acceptReady(server: Server, now: Integer) {
    for turn in 0..server.limits.acceptBudget {
        if server.active >= server.limits.maxConnections { break }
        let socket = net.accept(server.listener)
        if socket < 0 { break }
        net.setNoDelay(socket, true)
        let tls: Maybe<TlsOps> = None
        match server.tls {
            Some(state) {
                tls = state.factory.open()
                if tls.isNone() {
                    // The listener configuration was validated; refuse this
                    // socket instead of consuming a bounded connection slot.
                    net.close(socket)
                    continue
                }
            }
            None {}
        }
        let connection = newConnection(socket, now + server.limits.idleMilliseconds)
        let slot = server.connections.length
        if server.freeCount > 0 {
            server.freeCount -= 1; slot = server.freeSlots[server.freeCount]; server.connections[slot] = connection
        } else { server.connections.add(connection) }
        match server.tls {
            Some(state) {
                if tls.isSome() {
                    while state.ops.length <= slot { state.ops.add(None) }
                    state.ops[slot] = tls
                }
            }
            None {}
        }
        server.active += 1
        watch(server, slot, loop.readableInterest())
    }
    if server.active >= server.limits.maxConnections && server.listenerRegistration >= 0 {
        loop.remove(server.handle, server.listenerRegistration); server.listenerRegistration = -1
    }
}

function tokenByte(byte: Integer): Boolean {
    return byte >= 48 && byte <= 57 || byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 ||
        byte == 33 || byte == 35 || byte == 36 || byte == 37 || byte == 38 || byte == 39 ||
        byte == 42 || byte == 43 || byte == 45 || byte == 46 || byte == 94 || byte == 95 ||
        byte == 96 || byte == 124 || byte == 126
}
function lowercase(data: Bytes): Text {
    let result = Bytes()
    for byte in data {
        let lower = byte
        if byte >= 65 && byte <= 90 { lower += 32 }
        result.add(lower)
    }
    // Callers pass token bytes, which are visible ASCII.
    return utf8.decodeOrStop(result)
}
function sameBytes(left: Bytes, right: Bytes): Boolean {
    if left.length != right.length { return false }
    for at in 0..left.length { if left[at] != right[at] { return false } }
    return true
}
function findByte(data: Bytes, byte: Integer, start: Integer, end: Integer): Integer {
    for at in start..end { if data[at] == byte { return at } }
    return -1
}
function decimal(data: Bytes, start: Integer, end: Integer, maximum: Integer): Integer {
    if start >= end { return -1 }
    let value = 0
    for at in start..end {
        let byte = data[at]
        if byte < 48 || byte > 57 { return -1 }
        if value > maximum / 10 || value == maximum / 10 && byte - 48 > maximum % 10 { return -2 }
        value = value * 10 + byte - 48
    }
    return value
}
// RFC 4291 text form: eight hex groups, one optional "::" and an optional
// dotted IPv4 tail. Checked here rather than natively so a Session stays pure.
function ipv6Literal(data: Bytes, from: Integer, to: Integer): Boolean {
    let groups = 0
    let compressed = false
    let at = from
    if to - from >= 2 && data[from] == 58 && data[from + 1] == 58 {
        compressed = true
        at = from + 2
    } else { if at >= to || data[at] == 58 { return false } }
    while at < to {
        let start = at
        while at < to && at - start < 5 && hexValue(data[at]) >= 0 { at += 1 }
        if at < to && data[at] == 46 {
            if !ipv4Tail(data, start, to) { return false }
            groups += 2
            at = to
        } else {
            if at == start || at - start > 4 { return false }
            groups += 1
            if at < to {
                if data[at] != 58 || at + 1 == to { return false }
                at += 1
                if data[at] == 58 {
                    if compressed { return false }
                    compressed = true
                    at += 1
                }
            }
        }
    }
    if compressed { return groups <= 7 }
    return groups == 8
}
function ipv4Tail(data: Bytes, from: Integer, to: Integer): Boolean {
    let parts = 0
    let at = from
    while at < to {
        let start = at
        let value = 0
        while at < to && data[at] >= 48 && data[at] <= 57 && at - start < 3 { value = value * 10 + data[at] - 48; at += 1 }
        if at == start || value > 255 || at - start > 1 && data[start] == 48 { return false }
        parts += 1
        if at < to {
            if data[at] != 46 || parts == 4 { return false }
            at += 1
            if at == to { return false }
        }
    }
    return parts == 4
}
function validHost(data: Bytes): Boolean {
    if data.length == 0 { return false }
    let hostEnd = data.length
    let portAt = -1
    if data[0] == 91 {
        let end = findByte(data, 93, 1, data.length)
        if end < 0 || !ipv6Literal(data, 1, end) { return false }
        if end + 1 < data.length {
            if data[end + 1] != 58 { return false }
            portAt = end + 2
        }
    } else {
        let colon = findByte(data, 58, 0, data.length)
        if colon >= 0 { hostEnd = colon; portAt = colon + 1 }
        if hostEnd == 0 { return false }
        for at in 0..hostEnd {
            let byte = data[at]
            if !(byte >= 48 && byte <= 57 || byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 ||
                byte == 45 || byte == 46) { return false }
        }
    }
    if portAt >= 0 { if decimal(data, portAt, data.length, 65535) <= 0 { return false } }
    return true
}
function connectionClose(data: Bytes): Integer {
    let start = 0
    let closing = 0
    while start < data.length {
        let end = findByte(data, 44, start, data.length)
        if end < 0 { end = data.length }
        let from = start
        let to = end
        while from < to && (data[from] == 32 || data[from] == 9) { from += 1 }
        while to > from && (data[to - 1] == 32 || data[to - 1] == 9) { to -= 1 }
        if from == to { return -1 }
        for at in from..to { if !tokenByte(data[at]) { return -1 } }
        if lowercase(data.slice(from, to)) == "close" { closing = 1 }
        start = end + 1
        if start == data.length { return -1 }
    }
    if data.length == 0 { return -1 }
    return closing
}
function parseHead(data: Bytes, start: Integer, end: Integer, limits: Limits): Head {
    let lineEnd = findByte(data, 13, start, end)
    if lineEnd < 0 { return badHead(400) }
    let first = findByte(data, 32, start, lineEnd)
    if first <= start { return badHead(400) }
    let second = findByte(data, 32, first + 1, lineEnd)
    if second <= first + 1 { return badHead(400) }
    for at in start..first { if !tokenByte(data[at]) { return badHead(400) } }
    for at in first + 1..second { if data[at] <= 32 || data[at] >= 127 || data[at] == 35 { return badHead(400) } }
    if !sameBytes(data.slice(second + 1, lineEnd), Bytes("HTTP/1.1")) { return badHead(400) }
    // The method is token bytes and the target visible ASCII, both checked above.
    let method = utf8.decodeOrStop(data.slice(start, first))
    let target = utf8.decodeOrStop(data.slice(first + 1, second))
    if method == "CONNECT" { return badHead(405) }
    if data[first + 1] != 47 && !(target == "*" && method == "OPTIONS") { return badHead(400) }
    let fields: List<Header> = []
    let hostCount = 0
    let lengthCount = 0
    let transferCount = 0
    let chunked = false
    let length = 0
    let framingStatus = 0
    let closing = false
    let expectation = false
    let upgrade = false
    let fieldStart = lineEnd + 2
    while fieldStart < end - 2 {
        let stop = findByte(data, 13, fieldStart, end)
        if stop < 0 { return badHead(400) }
        let colon = findByte(data, 58, fieldStart, stop)
        if colon <= fieldStart { return badHead(400) }
        for at in fieldStart..colon { if !tokenByte(data[at]) { return badHead(400) } }
        let from = colon + 1
        let to = stop
        while from < to && (data[from] == 32 || data[from] == 9) { from += 1 }
        while to > from && (data[to - 1] == 32 || data[to - 1] == 9) { to -= 1 }
        let name = lowercase(data.slice(fieldStart, colon))
        let raw = data.slice(from, to)
        let value = ""
        match utf8.decode(raw) {
            Ok(decoded) { value = decoded }
            Err(error) { return badHead(400) }
        }
        if fields.length >= limits.maxHeaders { return badHead(431) }
        fields.add(Header { name: name; value: value })
        if name == "host" { hostCount += 1; if !validHost(raw) { return badHead(400) } }
        if name == "content-length" {
            lengthCount += 1
            length = decimal(data, from, to, limits.maxBodyBytes)
            if length == -1 { framingStatus = 400 }
            if length == -2 && framingStatus == 0 { framingStatus = 413 }
        }
        if name == "transfer-encoding" {
            transferCount += 1
            // Only chunked is decoded; any other coding (or a list) is 501.
            chunked = from < to && lowercase(raw) == "chunked"
        }
        if name == "expect" { expectation = true }
        if name == "upgrade" { upgrade = true }
        if name == "connection" {
            let result = connectionClose(raw)
            if result < 0 { return badHead(400) }
            if result == 1 { closing = true }
        }
        fieldStart = stop + 2
    }
    if hostCount != 1 || lengthCount > 1 || transferCount > 1 || transferCount > 0 && lengthCount > 0 {
        return badHead(400)
    }
    if framingStatus != 0 { return badHead(framingStatus) }
    if transferCount > 0 && !chunked { return badHead(501) }
    if expectation { return badHead(417) }
    if upgrade { return badHead(501) }
    return Head { status: 0; method: method; target: target; headers: fields; length: length; chunked: chunked; keepAlive: !closing }
}

function reason(status: Integer): Text {
    if status == 200 { return "OK" }
    if status == 204 { return "No Content" }
    if status == 205 { return "Reset Content" }
    if status == 304 { return "Not Modified" }
    if status == 400 { return "Bad Request" }
    if status == 404 { return "Not Found" }
    if status == 405 { return "Method Not Allowed" }
    if status == 408 { return "Request Timeout" }
    if status == 413 { return "Content Too Large" }
    if status == 417 { return "Expectation Failed" }
    if status == 431 { return "Request Header Fields Too Large" }
    if status == 501 { return "Not Implemented" }
    if status == 502 { return "Bad Gateway" }
    return "Response"
}

// Connection core: request parsing, response framing and streaming state.
// Nothing here touches a socket, the event loop or a clock, so Server and
// Session share it and a deterministic simulation can drive a Session.
constant NEVER = 9223372036854775807
record Parsed { status: Integer; request: Maybe<Request> }
function parsed(status: Integer): Parsed { return Parsed { status: status; request: None } }
function bodiless(status: Integer): Boolean { return status == 204 || status == 205 || status == 304 }
function hexValue(byte: Integer): Integer {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 65 && byte <= 70 { return byte - 55 }
    if byte >= 97 && byte <= 102 { return byte - 87 }
    return -1
}
function chunk(piece: Bytes): Bytes {
    let framed = Bytes(utf8.hex(piece.length) + "\r\n")
    framed.addBytes(piece)
    framed.addBytes(Bytes("\r\n"))
    return framed
}
// Queue bytes after any unsent output, replacing a drained buffer.
function append(connection: Connection, bytes: Bytes) {
