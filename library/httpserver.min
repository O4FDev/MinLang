// Queue response bytes for the socket, sealing them first on TLS.
function place(server: Server, slot: Integer, bytes: Bytes): Boolean {
    let connection = server.connections[slot]
    if isTls(server, slot) {
        // Keep any queued TLS control records first, then the sealed bytes.
        let ops = tlsSession(server, slot)
        ops.send(bytes)
        append(connection, ops.takeOutgoing())
        if ops.state() != TRANSPORT_ESTABLISHED { drop(server, slot); return false }
    } else { append(connection, bytes) }
