// The end of the CRLF-terminated line starting at `from` (the CR), -1 when it
// is not complete before `limit`, or -2 for a bare CR/LF or a control byte.
function lineEnd(data: Bytes, from: Integer, limit: Integer): Integer {
    for at in from..limit {
        let byte = data[at]
        if byte == 13 {
            if at + 1 == data.length { return -1 }
            if data[at + 1] != 10 { return -2 }
            return at
        }
        if (byte < 32 && byte != 9) || byte == 127 { return -2 }
    }
    return -1
}
// Decode complete chunks from chunkAt into `decoded`, consuming their framing
// so it never counts against the input bound. Chunk extensions and trailer
// fields are read and discarded. Returns 0 when the body is complete (chunkAt
// then ends the request), -1 to wait for input, or a rejection status.
function decodeChunks(connection: Connection, limits: Limits): Integer {
    while true {
        let data = connection.input
        let at = connection.chunkAt
        let line = lineEnd(data, at, min(data.length, at + 1024))
        if line == -2 { return 400 }
        if line < 0 {
            if data.length - at >= 1024 { return 400 }
            return -1
        }
        let size = 0
        let digits = 0
        let cursor = at
        while cursor < line && hexValue(data[cursor]) >= 0 {
            size = size * 16 + hexValue(data[cursor])
            if size > limits.maxBodyBytes { return 413 }
            digits += 1
            cursor += 1
        }
        if digits == 0 || cursor < line && data[cursor] != 59 && data[cursor] != 32 && data[cursor] != 9 { return 400 }
        if size > limits.maxBodyBytes - connection.decoded.length { return 413 }
        if size == 0 {
            // The trailer section: fields until an empty line, bounded like a header.
            let field = line + 2
            while true {
                let end = lineEnd(data, field, min(data.length, line + 2 + limits.maxHeaderBytes))
                if end == -2 { return 400 }
                if end < 0 {
                    if data.length - line - 2 >= limits.maxHeaderBytes { return 431 }
                    return -1
                }
                if end == field { connection.chunkAt = end + 2; return 0 }
                if findByte(data, 58, field, end) <= field { return 400 }
                field = end + 2
            }
        }
        let after = line + 2 + size
        if data.length < after + 2 { return -1 }
        if data[after] != 13 || data[after + 1] != 10 { return 400 }
        connection.decoded.addBytes(data.slice(line + 2, after))
        connection.chunkAt = after + 2
        connection.inputStart = connection.chunkAt
        let unread = data.length - connection.inputStart
