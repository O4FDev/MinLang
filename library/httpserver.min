// Serialize a response head with a small body or a stream's first chunk, and
// move the connection to writing (phase 2) or streaming (phase 3). The caller
// queues the returned bytes, through TLS when the connection uses it.
function queueResponse(connection: Connection, limits: Limits, response: Response, head: Boolean, closing: Boolean, streaming: Boolean, now: Integer): Bytes {
    let output = Bytes("HTTP/1.1 " + Text(response.status) + " " + reason(response.status) + "\r\n")
    for field in response.headers { output.addBytes(Bytes(field.name + ": " + field.value + "\r\n")) }
    if streaming { output.addBytes(Bytes("transfer-encoding: chunked\r\n")) }
    else {
        let length = response.body.length
        if response.status == 205 { length = 0 }
        if response.status != 204 { output.addBytes(Bytes("content-length: " + Text(length) + "\r\n")) }
    }
    if closing { output.addBytes(Bytes("connection: close\r\n\r\n")) }
    else { output.addBytes(Bytes("connection: keep-alive\r\n\r\n")) }
    connection.body = Bytes()
    if streaming {
