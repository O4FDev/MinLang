}
public function advance(server: Server, batch: loop.Batch): Batch {
    let ready: List<Request> = []
    if server.closed { return makeBatch(ready, server.error, takeEnded(server)) }
    if errors.isError(loop.batchError(batch)) {
        server.error = loop.batchError(batch); close(server)
        return makeBatch(ready, server.error, takeEnded(server))
    }
    let now = net.monotonicMilliseconds()
    // Each connection gets at most one buffered dispatch per batch.
    for slot in 0..server.connections.length {
        let connection = server.connections[slot]
        if connection.active {
            if now >= connection.deadline {
                // Application/write deadlines close directly; a parser timeout sends
                // one finite reply. A TLS handshake that cannot finish in time closes.
