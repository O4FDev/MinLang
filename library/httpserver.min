// Parse the next buffered request. Status 0 waits for input, a positive status
// is the rejection to send, -2 means tickets are exhausted, and -1 carries a
// Request that moves the connection to the application phase.
function parseNext(connection: Connection, limits: Limits, now: Integer, owner: Integer, slot: Integer, ticket: Integer): Parsed {
    connection.needsParse = false
    let data = connection.input
    let start = connection.inputStart
    if connection.headerBytes == 0 {
        let at = connection.scan
        while at < data.length {
            let byte = data[at]
            // Validate all header octets before Text conversion, including CRLF.
            if byte == 13 {
                if at + 1 == data.length { break }
                if data[at + 1] != 10 { return parsed(400) }
            } else {
                if byte == 10 {
                    if at == 0 || data[at - 1] != 13 { return parsed(400) }
                } else {
                    if (byte < 32 && byte != 9) || byte >= 127 { return parsed(400) }
                }
            }
            if at >= start + 3 && byte == 10 && data[at - 1] == 13 && data[at - 2] == 10 && data[at - 3] == 13 {
                connection.headerBytes = at + 1 - start; break
            }
            at += 1
            if at - start >= limits.maxHeaderBytes { return parsed(431) }
        }
        connection.scan = at
        if connection.headerBytes == 0 {
            if connection.eof { return parsed(400) }
            return parsed(0)
        }
        connection.parsed = parseHead(data, start, start + connection.headerBytes, limits)
        if connection.parsed.status != 0 { return parsed(connection.parsed.status) }
        connection.deadline = now + limits.bodyMilliseconds
        connection.chunkAt = start + connection.headerBytes
        connection.decoded = Bytes()
    }
    let body = Bytes()
    let total = start + connection.headerBytes + connection.parsed.length
    if connection.parsed.chunked {
        let status = decodeChunks(connection, limits)
        if status == -1 {
            if connection.eof { return parsed(400) }
            return parsed(0)
        }
        if status > 0 { return parsed(status) }
        body = connection.decoded
        connection.decoded = Bytes()
        total = connection.chunkAt
    } else {
