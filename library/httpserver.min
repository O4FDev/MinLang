                    if connection.phase == 0 { readReady(server, slot, now, ready) }
                    else {
                        if connection.phase == 2 {
                            if loop.isClosed(event) {
                                connection.writeHup = true
                                // Do not wait for another closed-only event:
                                // each bounded successful write can still leave
                                // HUP ready, even before the final would-block.
                                removeWatch(server, connection)
                            }
                            flush(server, slot, now)
                        } else {
                            if connection.phase == 3 {
                                if loop.isReadable(event) || loop.isClosed(event) || loop.isError(event) { readStreaming(server, slot) }
                                if connection.active && connection.phase == 3 && loop.isWritable(event) { flush(server, slot, now) }
                            }
                        }
                    }
                }
            }
        }
    }
    return makeBatch(ready, server.error, takeEnded(server))
}
public function poll(server: Server, timeoutMilliseconds: Integer): Batch {
    if server.closed { return makeBatch([], server.error, takeEnded(server)) }
    return advance(server, loop.wait(server.handle, waitMilliseconds(server, timeoutMilliseconds), server.limits.maxEvents))
}

/// One HTTP/1.1 server connection without a socket or clock. Offer the peer's
/// bytes with receive, send what takeOutgoing returns, and answer requests with
/// the same respond and stream operations as a Server. Every call takes or
/// reuses the caller's millisecond clock, so a deterministic simulation can
/// drive it. Use a Request only with the Session that returned it.
public record Session {
    private connection: Connection
    private limits: Limits
    private nextTicket: Integer
    private now: Integer
    private ended: List<Integer>
    private error: errors.Error
}
public function session(limits: Limits, nowMillis: Integer): Session {
    let copied = copyLimits(limits)
    let state = Session { connection: newConnection(-1, nowMillis + copied.idleMilliseconds); limits: copied; nextTicket: 1
        now: nowMillis; ended: []; error: errors.none() }
    if !validLimits(copied) {
        state.error = errors.make(errors.invalidDataCode(), 0, "invalid HTTP server limits")
        state.connection.active = false
    }
    return state
}
public function Session.error(): errors.Error { return self.error }
// The session closed its connection: close the transport after sending what
// takeOutgoing returned. A closed session accepts and returns no more bytes.
public function Session.closed(): Boolean { return !self.connection.active }
public function Session.pendingOutput(): Integer {
    if !self.connection.active { return 0 }
    return queuedOutput(self.connection)
}
function Session.finish(ready: List<Request>, accepted: Integer): Batch {
    let ended = self.ended
    self.ended = []
    return Batch { requests: ready; error: self.error; ended: ended; accepted: accepted }
}
function Session.drop() { if self.connection.active { release(self.connection, self.ended) } }
function Session.reject(status: Integer) {
    let head = rejectHead(self.connection)
    append(self.connection, queueResponse(self.connection, self.limits, response(status, "text/plain", Bytes(reason(status))), head, true, false, self.now))
}
function Session.parse(ready: List<Request>) {
    let result = parseNext(self.connection, self.limits, self.now, -1, 0, self.nextTicket)
    if result.status == -2 { self.drop(); return }
    if result.status > 0 { self.reject(result.status); return }
    match result.request {
        Some(request) { self.nextTicket += 1; ready.add(request) }
        None {}
    }
}
// Deadlines first: false when the connection expired at the current time.
function Session.current(nowMillis: Integer): Boolean {
    self.now = max(self.now, nowMillis)
    let connection = self.connection
    if !connection.active { return false }
    if self.now < connection.deadline { return true }
    if connection.phase == 0 && connection.started { self.reject(408) } else { self.drop() }
    return false
}
/// Apply deadlines and dispatch a buffered pipelined request. Call it after
/// takeOutgoing completes a response and whenever the clock advances.
public function Session.tick(nowMillis: Integer): Batch {
    let ready: List<Request> = []
    if self.current(nowMillis) && self.connection.phase == 0 && self.connection.needsParse { self.parse(ready) }
    return self.finish(ready, 0)
}
/// Offer bytes from the peer. The Batch reports how many were accepted; input
/// is bounded like a Server's, so offer the rest after the session has answered.
public function Session.receive(bytes: Bytes, nowMillis: Integer): Batch {
    let ready: List<Request> = []
    if !self.current(nowMillis) || self.connection.eof { return self.finish(ready, 0) }
    let connection = self.connection
    let capacity = self.limits.maxHeaderBytes + self.limits.maxBodyBytes
    let take = max(0, min(bytes.length, capacity - (connection.input.length - connection.inputStart)))
    if take == bytes.length { connection.input.addBytes(bytes) }
    else { if take > 0 { connection.input.addBytes(bytes.slice(0, take)) } }
    if connection.phase == 0 {
        if !connection.started && take > 0 { connection.started = true; connection.deadline = self.now + self.limits.headerMilliseconds }
        if take > 0 || connection.needsParse { self.parse(ready) }
    }
    return self.finish(ready, take)
}
/// The peer ended its input. An open stream is released, a partial request is
/// answered with 400, and queued responses can still be taken.
public function Session.finishInput(nowMillis: Integer): Batch {
    let ready: List<Request> = []
    if self.current(nowMillis) && !self.connection.eof {
        let connection = self.connection
        connection.eof = true
        if connection.phase == 3 { self.drop() }
        else {
            if connection.phase == 0 {
                if connection.inputStart == connection.input.length { self.drop() } else { self.parse(ready) }
            }
        }
    }
    return self.finish(ready, 0)
}
/// Up to `maximum` bytes for the peer, in order.
public function Session.takeOutgoing(maximum: Integer): Bytes {
    if maximum < 1 { fail("httpserver: outgoing maximum must be positive") }
    let result = Bytes()
    let connection = self.connection
    if !connection.active { return result }
    while result.length < maximum {
        if connection.sent < connection.output.length {
            let take = min(maximum - result.length, connection.output.length - connection.sent)
            result.addBytes(connection.output.slice(connection.sent, connection.sent + take))
            connection.sent += take
        } else {
            if connection.bodySent >= connection.body.length { break }
            let take = min(maximum - result.length, connection.body.length - connection.bodySent)
            result.addBytes(connection.body.slice(connection.bodySent, connection.bodySent + take))
            connection.bodySent += take
        }
    }
    if result.length > 0 && connection.phase == 3 { connection.deadline = self.now + self.limits.writeMilliseconds }
    if queuedOutput(connection) == 0 {
        if connection.phase == 3 { streamDrained(connection) }
        if connection.phase == 2 {
            if connection.closing { self.drop() } else { nextRequest(connection, self.limits, self.now) }
        }
    }
    return result
}
public function Session.requestActive(request: Request): Boolean {
    let connection = self.connection
    return request.owner == -1 && connection.active && connection.phase == 1 && connection.ticket == request.ticket &&
        self.now < connection.deadline
}
public function Session.streamActive(request: Request): Boolean {
    let connection = self.connection
    return request.owner == -1 && connection.active && connection.phase == 3 && connection.ticket == request.ticket
}
public function Session.respond(request: Request, response: Response): Boolean {
    if !self.requestActive(request) || !validResponse(response, self.limits) { return false }
    let connection = self.connection
    append(connection, queueResponse(connection, self.limits, response, connection.parsed.method == "HEAD",
        closingAfter(connection, self.limits, false), false, self.now))
    return true
}
public function Session.stream(request: Request, response: Response): Boolean {
    if !self.requestActive(request) || !validResponse(response, self.limits) || bodiless(response.status) { return false }
    let connection = self.connection
    append(connection, queueResponse(connection, self.limits, response, connection.parsed.method == "HEAD",
        closingAfter(connection, self.limits, false), true, self.now))
    return true
}
public function Session.send(request: Request, piece: Bytes): Boolean {
    if !self.streamActive(request) { return false }
    let connection = self.connection
    if !streamRoom(connection, self.limits, piece.length) { return false }
    if piece.length == 0 || connection.quiet { return true }
    if queuedOutput(connection) == 0 { connection.deadline = self.now + self.limits.writeMilliseconds }
    append(connection, chunk(piece))
    return true
}
public function Session.finishStream(request: Request): Boolean {
    if !self.streamActive(request) { return false }
    let last = finishChunks(self.connection, self.limits, self.now)
    if last.length > 0 { append(self.connection, last) }
    return true
}
public function Session.abandon(request: Request) {
    if self.requestActive(request) || self.streamActive(request) {
        self.connection.ticket = 0
        self.drop()
    }
}
