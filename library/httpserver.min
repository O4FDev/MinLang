public function requestActive(server: Server, request: Request): Boolean {
    if server.closed || request.owner != server.handle || request.slot < 0 || request.slot >= server.connections.length { return false }
    let connection = server.connections[request.slot]
    return connection.active && connection.phase == 1 && connection.ticket == request.ticket &&
        net.monotonicMilliseconds() < connection.deadline
}
// Close the connection of an active request or stream without replying further.
// An abandoned stream is not reported by endedStreams.
public function abandon(server: Server, request: Request) {
    if requestActive(server, request) || streamActive(server, request) {
        server.connections[request.slot].ticket = 0
        drop(server, request.slot)
