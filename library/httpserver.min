// True while the stream accepts pieces: started, not finished, client present.
public function streamActive(server: Server, request: Request): Boolean {
    if server.closed || request.owner != server.handle || request.slot < 0 || request.slot >= server.connections.length { return false }
    let connection = server.connections[request.slot]
    return connection.active && connection.phase == 3 && connection.ticket == request.ticket
