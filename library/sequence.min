/// A lazy ascending Integer range. The end is excluded.
public record Range {
    first: Integer
    after: Integer
}

public record RangeCursor {
    position: Integer
    after: Integer
    started: Boolean
}

/// Keep only the bounds; no List of numbers is created.
public function range(first: Integer, after: Integer): Range {
    return Range { first: first; after: after }
}

public function Range.iterator(): RangeCursor {
    return RangeCursor { position: self.first; after: self.after; started: false }
}

public function RangeCursor.advance(): Boolean {
    if !self.started {
        self.started = true
        return self.position < self.after
    }
    if self.position >= self.after { return false }
    self.position += 1
    return self.position < self.after
}

public function RangeCursor.current(): Integer { return self.position }
