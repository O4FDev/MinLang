// UIKit owns the main loop. Minyar callbacks run synchronously on their
// creating thread; run keeps their captured state alive for the whole app.
public constant ACTION = 1
public constant CHANGE = 2
public constant SUBMIT = 6

public record Event { kind: Integer; key: Text; text: Text; checked: Boolean }
record Session { callback: (Integer) -> Nothing }

/// Start one UIKit application on the main thread. This normally never returns.
/// draw builds a fresh native snapshot; update changes the application's model.
public function run(title: Text, draw: () -> Nothing, update: (Event) -> Nothing) {
    let session = Session { callback: function(kind: Integer) {
        if kind != 0 {
            update(Event { kind: kind; key: eventKeyRaw(); text: eventTextRaw(); checked: eventCheckedRaw() })
        }
        draw()
    } }
    runRaw(title, session)
}

// Low-level renderer boundary, shared by ui-ios and custom native renderers.
// Kinds match ui: label=1, heading=2, button=3, input=4, toggle=5, row=6, column=7.
// begin/node/end copies every Text into native storage before returning.
public function begin() { native "mobileios" }
public function node(parent: Integer, kind: Integer, key: Text, text: Text, checked: Boolean, spacing: Integer, padding: Integer): Integer { native "mobileios" }
public function end() { native "mobileios" }

function runRaw(title: Text, session: Session) { native "mobileios" }
function eventKeyRaw(): Text { native "mobileios" }
function eventTextRaw(): Text { native "mobileios" }
function eventCheckedRaw(): Boolean { native "mobileios" }
