// A value, or no value. The compiler makes this core choice available by name.
/// A value, or no value. `Some` carries the value and `None` leaves it absent.
/// This core choice is available by name without an import. Match both cases
/// when absence changes what should happen.
///
/// ```minyar
/// let light: Maybe<Text> = Some("still shining")
/// print(match light { Some(words) { words } None { "silence" } })
/// ```
/// ```output
/// still shining
/// ```
public choice Maybe<Item> {
    /// A value worth keeping.
    Some(value: Item)
    /// No value this time.
    None
}
