use "errors" as errors
use "text" as text

// Base64 (RFC 4648), both alphabets.
//
// Standard Base64 uses `+` and `/` and always pads with `=`; URL-safe Base64 uses
// `-` and `_` and is written unpadded, as URLs, JWT claims and S3 checksums do.
// Decoding validates while it decodes: the wrong alphabet, misplaced or missing
// padding, and non-zero trailing bits are all invalid data, never a silently
// repaired value. Both directions allocate one result buffer.

function base64EncodeNative(data: Bytes, urlSafe: Boolean): Text { native "runtime" }
record Decoded { private data: Bytes; private code: Integer }
function base64DecodeNative(data: Bytes, urlSafe: Boolean): Decoded { native "runtime" }

/// Encode `data` as standard Base64 with `=` padding.
///
/// ```minyar
/// print(api.base64Encode(Bytes("Many hands make light work.")))
/// print(api.base64Encode(Bytes("f")))
/// print(api.base64Encode(Bytes("")).length)
/// ```
/// ```output
/// TWFueSBoYW5kcyBtYWtlIGxpZ2h0IHdvcmsu
/// Zg==
/// 0
/// ```
public function base64Encode(data: Bytes): Text { return base64EncodeNative(data, false) }

/// Encode `data` as URL-safe Base64 without padding.
///
/// ```minyar
/// print(api.base64UrlEncode(Bytes(">?")))
/// ```
/// ```output
/// Pj8
/// ```
public function base64UrlEncode(data: Bytes): Text { return base64EncodeNative(data, true) }

// A failed decode keeps its reason instead of returning empty Bytes, so an
// empty input and a rejected input stay distinguishable.
function decodeFailure(code: Integer): Result<Bytes, errors.Error> {
    if code == -75 { return Err(errors.make(errors.overflowCode(), code, "the encoded text is not a whole base64 group")) }
    return Err(errors.make(errors.invalidDataCode(), code, "invalid base64 text"))
}

/// Decode standard Base64, which must be padded to a multiple of four characters.
/// The alphabet, the padding position and the trailing bits are all checked.
///
/// ```minyar
/// match api.base64Decode("TWFueQ==") {
///     Ok(decoded) { print(decoded.length) }
///     Err(problem) { print("rejected") }
/// }
/// match api.base64Decode("Zg") {
///     Ok(decoded) { print("accepted") }
///     Err(problem) { print("rejected") }
/// }
/// ```
/// ```output
/// 4
/// rejected
/// ```
public function base64Decode(encoded: Text): Result<Bytes, errors.Error> {
    let outcome = base64DecodeNative(Bytes(encoded), false)
    if outcome.code != 0 { return decodeFailure(outcome.code) }
    return Ok(outcome.data)
}

/// Decode URL-safe Base64, with or without `=` padding.
/// The alphabet is `-`/`_`; standard `+`/`/` characters are invalid data.
///
/// ```minyar
/// match api.base64UrlDecode("Pj8") {
///     Ok(decoded) { print(decoded.length) }
///     Err(problem) { print("rejected") }
/// }
/// ```
/// ```output
/// 2
/// ```
public function base64UrlDecode(encoded: Text): Result<Bytes, errors.Error> {
    let outcome = base64DecodeNative(Bytes(encoded), true)
    if outcome.code != 0 { return decodeFailure(outcome.code) }
    return Ok(outcome.data)
}
