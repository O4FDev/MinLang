use "errors" as errors
use "text" as text

// Durable file I/O: open, append and positioned writes, positioned reads, fdatasync/fsync, atomic rename with a
// directory sync, and a background syncer for group commit.
//
// io.readBytesFile/io.writeBytesFile replace whole files and promise nothing after a crash. Programs that
// must not lose acknowledged data (write-ahead logs, checkpoints, queues) write with this package, call syncData
// before acknowledging, and publish new files with write → syncData → rename → syncDirectory.
//
// Integer results are >= 0 on success and -errno on failure (-2 ENOENT, -17 EEXIST, -28 ENOSPC ...).
// Bytes results are empty on failure; lastError() then returns the -errno. errorText(code) describes a code.
// On macOS syncData and sync use F_FULLFSYNC, which reaches stable storage; plain fsync there does not.

public constant READ = 1        // open for reading (the default when WRITE is absent)
public constant WRITE = 2       // open for reading and writing
public constant CREATE = 4      // create if missing (mode 0644)
public constant APPEND = 8      // every write goes to the end of the file
public constant TRUNCATE = 16   // truncate to zero length on open
public constant EXCLUSIVE = 32  // with CREATE: fail with -17 if the file exists

/// Open a file and return an owned descriptor, or negative errno.
/// Combine `READ`, `WRITE`, `CREATE`, `APPEND`, `TRUNCATE` and `EXCLUSIVE` flags
/// with `|`. Close every successful descriptor when its work is finished.
///
/// ```minyar
/// let file = api.open("lantern.txt", api.WRITE | api.CREATE | api.TRUNCATE)
/// if file < 0 { fail("cannot open the lantern file") }
/// let words = Bytes("The light is on.")
/// print(api.write(file, words, 0, words.length) == words.length)
/// api.close(file)
/// ```
/// ```output
/// true
/// ```
public function open(path: Text, flags: Integer): Integer { native "files" }
/// Close an owned descriptor, returning zero or negative errno.
public function close(file: Integer): Integer { native "files" }

// Writes ALL of data[offset, offset + length), retrying short writes; returns length or -errno.
/// Write all `length` bytes starting at `offset`, retrying short writes.
/// Return the requested length on success, or negative errno on failure.
public function write(file: Integer, data: Bytes, offset: Integer, length: Integer): Integer { native "files" }
// The same at an absolute file position (pwrite); the file position is unchanged. APPEND descriptors return
// -EINVAL: Linux pwrite appends on them instead of honoring an absolute position. Unrepresentable ranges return
// -EOVERFLOW before I/O; readAt also reports that error for unrepresentable ranges/allocation sizes.
/// Write bytes at an absolute file position without changing the descriptor's position.
/// Append descriptors are rejected, so the write cannot silently move to the end.
public function writeAt(file: Integer, data: Bytes, offset: Integer, length: Integer, position: Integer): Integer { native "files" }
// Unbuffered write of text to standard output, ordered with respect to other raw writes (e.g. progress records
// that a supervisor must see before a crash). print() output may still be buffered.
public function writeStandardOutput(text: Text): Integer { native "files" }

// Up to length bytes from position; shorter at end of file.
// EOF is empty with lastError() == 0. Invalid handles report -EBADF, invalid negative ranges -EINVAL.
// Allocation grows with the bytes actually read; huge requests at EOF and zero-size pseudo-files are supported.
/// Read up to `length` bytes from a file position.
/// A shorter result reaches the end of the file. Empty Bytes with `lastError()`
/// equal to zero mean EOF; a negative error reports failure.
public function readAt(file: Integer, position: Integer, length: Integer): Bytes { native "files" }
public function readAppend(file: Integer, position: Integer, buffer: Bytes, length: Integer): Integer { native "files" }
/// Read a whole file as Bytes. An empty result can be an empty file or an error; inspect `lastError()`.
public function readFile(path: Text): Bytes { native "files" }

/// Make file data durable before acknowledging a write.
/// Return zero or negative errno. On macOS this uses `F_FULLFSYNC`.
public function syncData(file: Integer): Integer { native "files" }   // fdatasync
/// Make file data and metadata durable, returning zero or negative errno. On macOS this uses `F_FULLFSYNC`.
public function sync(file: Integer): Integer { native "files" }       // fsync (data and metadata)
public function size(file: Integer): Integer { native "files" }
public function pathSize(path: Text): Integer { native "files" }      // -2 if missing
public function truncate(file: Integer, length: Integer): Integer { native "files" }
// Reserve storage for at least length bytes and extend the file when needed. Existing bytes are preserved;
// the file is never shrunk. Platform/filesystem allocation errors are returned; call syncData for durability.
// On Darwin existing prefix holes or potentially shared clone backing return -ENOTSUP; missing sharing
// metadata also fails closed. Fresh files and extensions of a private, physically backed prefix are supported.
// Linux unshares the existing prefix; unsupported unsharing is accepted only on known non-CoW ext2/3/4.
// Other filesystems return their allocation error or -ENOTSUP when reservation cannot be established. Keep the file
// contents/size exclusively owned during this operation so concurrent changes cannot invalidate coverage.
public function preallocate(file: Integer, length: Integer): Integer { native "files" }
/// Atomically rename a path within one filesystem.
/// For durable publication, sync the written file first and the containing
/// directory after the rename.
///
/// ```minyar
/// use "io" as io
/// io.writeTextFile("moon.txt", "moon")
/// print(api.rename("moon.txt", "sky.txt") == 0)
/// print(io.readTextFile("sky.txt"))
/// ```
/// ```output
/// true
/// moon
/// ```
public function rename(from: Text, to: Text): Integer { native "files" }   // atomic within a file system
public function remove(path: Text): Integer { native "files" }
public function makeDirectory(path: Text): Integer { native "files" }      // 0 if created or already a directory
/// Sync a directory after publishing or removing a name, returning zero or negative errno.
public function syncDirectory(path: Text): Integer { native "files" }      // makes renames/creations durable

public function lastError(): Integer { native "files" }
public function errorText(code: Integer): Text { native "files" }
// Codes outside the native errno range receive a defined invalid-code diagnostic.

function listNames(path: Text): Bytes { native "files" }

// Entry names in a directory, excluding . and .. (unsorted). Empty on failure; check lastError().
/// List entry names without `.` or `..`. The order is unspecified; an empty list with a negative `lastError()` reports failure.
public function list(path: Text): List<Text> {
    let raw = listNames(path)
    let names: List<Text> = []
    let start = 0
    let index = 0
    while index < raw.length {
        if raw[index] == 0 {
            names.add(Text(raw.slice(start, index)))
            start = index + 1
        }
        index += 1
    }
    return names
}

// ---- background syncer (group commit) ----
// syncerStart(file) starts one thread that fdatasyncs a duplicate of `file` whenever a larger offset is requested.
// Offsets are the caller's positions in a logical stream (e.g. a write-ahead log's LSNs): write the bytes first,
// then syncerRequest(handle, endOffset). Requests made while a sync runs are covered by the next sync.
// syncerNotifySocket(handle) is a socket that becomes readable after every completed sync: watch it with
// `eventloop`, then call syncerDrain and read syncerSynced. A failed fdatasync is sticky (syncerError) and nothing
// is reported durable after it.
// The notification socket is borrowed: never close it through files/net. Remove its event-loop watch before
// syncerStop; stopped handles are invalid even when the underlying slot is reused.
public function syncerStart(file: Integer): Integer { native "files" }
public function syncerNotifySocket(handle: Integer): Integer { native "files" }
public function syncerRequest(handle: Integer, upTo: Integer): Integer { native "files" }
public function syncerSynced(handle: Integer): Integer { native "files" }
public function syncerError(handle: Integer): Integer { native "files" }
public function syncerDrain(handle: Integer): Integer { native "files" }
// Block until syncerSynced >= upTo (or the timeout in ms, -1 = forever); returns the synced offset or -errno
// (-110 timeout). For shutdown, checkpoints and tests.
public function syncerWait(handle: Integer, upTo: Integer, timeoutMs: Integer): Integer { native "files" }
// Continue on a new file from startOffset (log segment rotation). Every byte below startOffset must already be
// written to the previous file; the syncer syncs it before switching.
// Targets are nonnegative. Rotation boundaries cannot regress or precede already requested/durable offsets;
// invalid boundaries return -EINVAL. A wait timeout is -1 (forever) or nonnegative milliseconds.
public function syncerSwitch(handle: Integer, file: Integer, startOffset: Integer): Integer { native "files" }
// Final sync of outstanding requests, then stop the thread and close its descriptors. Returns syncerError.
public function syncerStop(handle: Integer): Integer { native "files" }

// ---- background file preparation ----
// Exclusively reserve this file for the job until completion: it preallocates, sets the exact size, overwrites
// every byte with zero and durably syncs. Start duplicates the descriptor, so the caller may close its file.
// No managed values enter the worker. APPEND or read-only descriptors are rejected. A failed job can leave a
// partially prepared file; only completion with prepareError == 0 establishes a durable all-zero file.
public function prepareStart(file: Integer, length: Integer): Integer { native "files" }
// Borrowed nonblocking completion socket: watch with eventloop; remove the watch before prepareStop.
// Never close this socket yourself. Completion includes failures; call prepareError after prepareDone == 1.
public function prepareNotifySocket(handle: Integer): Integer { native "files" }
public function prepareDone(handle: Integer): Integer { native "files" }     // 0 running, 1 finished, -errno invalid
public function prepareError(handle: Integer): Integer { native "files" }    // sticky -errno, 0 otherwise
public function prepareDrain(handle: Integer): Integer { native "files" }    // number of notification bytes
// Return 1 on durable success, -errno on failure; -ETIMEDOUT on timeout (-1 milliseconds waits forever).
public function prepareWait(handle: Integer, timeoutMs: Integer): Integer { native "files" }
// Join without cancelling, close owned file/socket descriptors and invalidate this generation of the handle.
// Returns the sticky error. Remove eventloop watches first. Repeated stop and stale handles return -EBADF.
public function prepareStop(handle: Integer): Integer { native "files" }

public function removeDirectory(path: Text): Integer { native "files" }

// Typed APIs. The native declarations above remain deprecated compatibility
// interfaces with their exact Integer/lastError contracts. Capture each native
// status before another operation can replace its diagnostic.
function nativeFailure(code: Integer, operation: Text): errors.Error {
    return errors.make(errors.systemCode(), -code, errorText(code)).withContext(operation)
}
function countResult(value: Integer, operation: Text): Result<Integer, errors.Error> {
    if value < 0 { return Err(nativeFailure(value, operation)) }
    return Ok(value)
}
function statusResult(value: Integer, operation: Text): Result<Nothing, errors.Error> {
    if value < 0 { return Err(nativeFailure(value, operation)) }
    return Ok()
}
public function openFile(path: Text, flags: Integer): Result<Integer, errors.Error> { return countResult(open(path, flags), "opening " + path) }
public function closeFile(file: Integer): Result<Nothing, errors.Error> { return statusResult(close(file), "closing the file") }
public function writeBytes(file: Integer, data: Bytes, offset: Integer, length: Integer): Result<Integer, errors.Error> { return countResult(write(file, data, offset, length), "writing the file") }
public function writeBytesAt(file: Integer, data: Bytes, offset: Integer, length: Integer, position: Integer): Result<Integer, errors.Error> { return countResult(writeAt(file, data, offset, length, position), "writing the file at " + Text(position)) }
public function readBytesAt(file: Integer, position: Integer, length: Integer): Result<Bytes, errors.Error> {
    let data = readAt(file, position, length)
    let code = lastError()
    if code < 0 { return Err(nativeFailure(code, "reading the file at " + Text(position))) }
    return Ok(data)
}
public function readBytes(path: Text): Result<Bytes, errors.Error> {
    let data = readFile(path)
    let code = lastError()
    if code < 0 { return Err(nativeFailure(code, "reading " + path)) }
    return Ok(data)
}
public function appendRead(file: Integer, position: Integer, buffer: Bytes, length: Integer): Result<Integer, errors.Error> { return countResult(readAppend(file, position, buffer, length), "appending bytes from the file") }
public function fileSize(file: Integer): Result<Integer, errors.Error> { return countResult(size(file), "measuring the file") }
public function sizeOfPath(path: Text): Result<Integer, errors.Error> { return countResult(pathSize(path), "measuring " + path) }
public function resize(file: Integer, length: Integer): Result<Nothing, errors.Error> { return statusResult(truncate(file, length), "resizing the file") }
public function reserve(file: Integer, length: Integer): Result<Nothing, errors.Error> { return statusResult(preallocate(file, length), "reserving file storage") }
public function move(from: Text, to: Text): Result<Nothing, errors.Error> { return statusResult(rename(from, to), "moving " + from + " to " + to) }
public function deleteFile(path: Text): Result<Nothing, errors.Error> { return statusResult(remove(path), "removing " + path) }
public function createDirectory(path: Text): Result<Nothing, errors.Error> { return statusResult(makeDirectory(path), "creating " + path) }
public function deleteDirectory(path: Text): Result<Nothing, errors.Error> { return statusResult(removeDirectory(path), "removing directory " + path) }
public function flush(file: Integer): Result<Nothing, errors.Error> { return statusResult(sync(file), "syncing the file") }
public function flushData(file: Integer): Result<Nothing, errors.Error> { return statusResult(syncData(file), "syncing file data") }
public function flushDirectory(path: Text): Result<Nothing, errors.Error> { return statusResult(syncDirectory(path), "syncing directory " + path) }
public function writeOutput(contents: Text): Result<Integer, errors.Error> { return countResult(writeStandardOutput(contents), "writing standard output") }
public function entries(path: Text): Result<List<Text>, errors.Error> {
    let raw = listNames(path)
    let code = lastError()
    if code < 0 { return Err(nativeFailure(code, "listing " + path)) }
    let names: List<Text> = []
    let start = 0
    for index in 0..raw.length {
        if raw[index] == 0 {
            names.add(try text.decode(raw.slice(start, index)) else "decoding a directory entry")
            start = index + 1
        }
    }
    return Ok(names)
}
public function startSyncer(file: Integer): Result<Integer, errors.Error> { return countResult(syncerStart(file), "starting the file syncer") }
public function syncerSocket(handle: Integer): Result<Integer, errors.Error> { return countResult(syncerNotifySocket(handle), "opening the syncer's completion socket") }
public function requestSync(handle: Integer, upTo: Integer): Result<Nothing, errors.Error> { return statusResult(syncerRequest(handle, upTo), "requesting a file sync") }
public function syncedOffset(handle: Integer): Result<Integer, errors.Error> { return countResult(syncerSynced(handle), "reading the synced offset") }
public function drainSyncer(handle: Integer): Result<Integer, errors.Error> { return countResult(syncerDrain(handle), "draining the file syncer") }
public function waitForSync(handle: Integer, upTo: Integer, timeoutMs: Integer): Result<Integer, errors.Error> { return countResult(syncerWait(handle, upTo, timeoutMs), "waiting for the file syncer") }
public function switchSyncer(handle: Integer, file: Integer, offset: Integer): Result<Nothing, errors.Error> { return statusResult(syncerSwitch(handle, file, offset), "switching the file syncer") }
public function stopSyncer(handle: Integer): Result<Nothing, errors.Error> { return statusResult(syncerStop(handle), "stopping the file syncer") }
public function startPreparation(file: Integer, length: Integer): Result<Integer, errors.Error> { return countResult(prepareStart(file, length), "preparing file storage") }
public function preparationSocket(handle: Integer): Result<Integer, errors.Error> { return countResult(prepareNotifySocket(handle), "opening the preparation socket") }
public function preparationDone(handle: Integer): Result<Boolean, errors.Error> {
    let code = prepareDone(handle)
    if code < 0 { return Err(nativeFailure(code, "checking file preparation")) }
    return Ok(code != 0)
}
public function drainPreparation(handle: Integer): Result<Integer, errors.Error> { return countResult(prepareDrain(handle), "draining file preparation") }
public function waitForPreparation(handle: Integer, timeoutMs: Integer): Result<Nothing, errors.Error> { return statusResult(prepareWait(handle, timeoutMs), "waiting for file preparation") }
public function stopPreparation(handle: Integer): Result<Nothing, errors.Error> { return statusResult(prepareStop(handle), "stopping file preparation") }
