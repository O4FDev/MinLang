// A single-owner readiness loop for thousands of hosted sockets and timers.
// Watching enables non-blocking mode. Sockets remain owned by the caller.
// Readiness is a hint: a read/write can
// still would-block. Remove a watch before closing its socket. No callbacks
// or cross-thread managed ownership are implied by this batch interface.
// A loop supports 8388607 active registrations; watch/timer report native
// EOVERFLOW through their system error if that bound is reached.
use "errors" as errors

public record Event {
    registration: Integer
    token: Integer
    flags: Integer
    nativeCode: Integer
    kind: Integer
}
public record Batch {
    private events: List<Event>
    private error: errors.Error
}

public function readableInterest(): Integer { return 1 }
public function writableInterest(): Integer { return 2 }
public function readWriteInterest(): Integer { return 3 }
public function isReadable(event: Event): Boolean { return event.flags % 2 == 1 }
public function isWritable(event: Event): Boolean { return event.flags / 2 % 2 == 1 }
public function isClosed(event: Event): Boolean { return event.flags / 4 % 2 == 1 }
public function isError(event: Event): Boolean { return event.flags / 8 % 2 == 1 }
public function isTimer(event: Event): Boolean { return event.kind == 1 }
public function events(batch: Batch): List<Event> { return batch.events }
public function batchError(batch: Batch): errors.Error { return batch.error }

function operationError(result: Bytes, operation: Text): errors.Error {
    if result.length != 16 { fail("invalid native loop operation envelope") }
    return errors.make(errors.systemCode(), result.getUInt32(4), operation + " failed")
}
function integerResult(result: Bytes, operation: Text): errors.IntegerResult {
    if result.length != 16 { fail("invalid native loop operation envelope") }
    if result.getUInt32(0) == 0 { return errors.integer(result.getInt64(8)) }
    return errors.integerFailure(operationError(result, operation))
}
function booleanResult(result: Bytes, operation: Text): errors.BooleanResult {
    if result.length != 16 { fail("invalid native loop operation envelope") }
    if result.getUInt32(0) == 0 { return errors.boolean(result.getInt64(8) == 1) }
    return errors.booleanFailure(operationError(result, operation))
}
public function create(): errors.IntegerResult { return integerResult(loopCreate(), "loop create") }
// interest may be zero to pause normal readable/writable notifications.
public function watch(loop: Integer, socket: Integer, interest: Integer, token: Integer): errors.IntegerResult {
    return integerResult(loopWatch(loop, socket, interest, token), "loop watch")
}
public function update(loop: Integer, registration: Integer, interest: Integer, token: Integer): errors.BooleanResult {
    return booleanResult(loopUpdate(loop, registration, interest, token), "loop update")
}
public function remove(loop: Integer, registration: Integer): errors.BooleanResult {
    return booleanResult(loopRemove(loop, registration), "loop remove")
}
// period zero means one-shot. A one-shot registration expires when emitted.
// A repeating timer skips missed intervals, firing at most once per batch.
public function timer(loop: Integer, delayMs: Integer, periodMs: Integer, token: Integer): errors.IntegerResult {
    return integerResult(loopTimer(loop, delayMs, periodMs, token), "loop timer")
}
public function close(loop: Integer): errors.BooleanResult {
    return booleanResult(loopClose(loop), "loop close")
}
// timeoutMs -1 waits until readiness or a timer. A successful timeout returns
// an empty batch; an OS failure belongs to this result, not a global error.
public function wait(loop: Integer, timeoutMs: Integer, maxEvents: Integer): Batch {
    let result = loopWait(loop, timeoutMs, maxEvents)
    if result.length < 8 || (result.length - 8) % 32 != 0 {
        fail("invalid native loop event envelope")
    }
    let events: List<Event> = []
    if result.getUInt32(0) != 0 {
        return Batch { events: events; error: errors.make(errors.systemCode(), result.getUInt32(4), "loop wait failed") }
    }
    let at = 8
    while at < result.length {
        events.add(Event {
            registration: result.getInt64(at)
            token: result.getInt64(at + 8)
            flags: result.getUInt32(at + 16)
            nativeCode: result.getUInt32(at + 20)
            kind: result.getUInt32(at + 24)
        })
        at = at + 32
    }
    return Batch { events: events; error: errors.none() }
}

// ---- allocation-free calls ----
// waitInto is wait without an Event record per event, a List, a Batch or an error value: it refills `events`,
// a Bytes the caller keeps and reuses (its capacity is kept, so a steady loop allocates nothing), and returns the
// number of events, zero on a timeout, or a negative native error code (for example -9 EBADF, -22 EINVAL).
// The buffer holds an 8-byte header and then one 32-byte record per event; record i starts at byte 8 + 32 * i:
// registration Int64 at +0, token Int64 at +8, flags UInt32 at +16, native code UInt32 at +20, kind UInt32 at +24.
// eventToken, eventFlags and the other accessors read them; flags test against READABLE, WRITABLE, CLOSED and
// FAILED. Timer events have kind TIMER_KIND.
public constant READABLE = 1
public constant WRITABLE = 2
public constant CLOSED = 4
public constant FAILED = 8
public constant TIMER_KIND = 1
/// Wait into a caller-owned buffer and return the event count, or a negative native error code.
///
/// ```minyar
/// use "errors" as errors
/// let reactor = errors.integerValue(api.create())
/// let timer = errors.integerValue(api.timer(reactor, 0, 0, 7))
/// let events = Bytes()
/// let count = api.waitInto(reactor, 1000, 64, events)
/// for i in 0..count {
///     print(api.eventToken(events, i))
///     print(api.eventKind(events, i) == api.TIMER_KIND)
///     print(api.eventRegistration(events, i) == timer)
/// }
/// print(errors.booleanValue(api.close(reactor)))
/// ```
/// ```output
/// 7
/// true
/// true
/// true
/// ```
public function waitInto(loop: Integer, timeoutMs: Integer, maxEvents: Integer, events: Bytes): Integer { native "net" }
public function eventRegistration(events: Bytes, index: Integer): Integer { return events.getInt64(8 + index * 32) }
public function eventToken(events: Bytes, index: Integer): Integer { return events.getInt64(16 + index * 32) }
public function eventFlags(events: Bytes, index: Integer): Integer { return events.getUInt32(24 + index * 32) }
public function eventNativeCode(events: Bytes, index: Integer): Integer { return events.getUInt32(28 + index * 32) }
public function eventKind(events: Bytes, index: Integer): Integer { return events.getUInt32(32 + index * 32) }
// update without the result envelope: zero, or a negative native error code. Changing only the token of a
// registration (the same interest) makes no system call on Linux and macOS.
public function updateInterest(loop: Integer, registration: Integer, interest: Integer, token: Integer): Integer { native "net" }

function loopCreate(): Bytes { native "net" }
function loopWatch(loop: Integer, socket: Integer, interest: Integer, token: Integer): Bytes { native "net" }
function loopUpdate(loop: Integer, registration: Integer, interest: Integer, token: Integer): Bytes { native "net" }
function loopRemove(loop: Integer, registration: Integer): Bytes { native "net" }
function loopTimer(loop: Integer, delayMs: Integer, periodMs: Integer, token: Integer): Bytes { native "net" }
function loopClose(loop: Integer): Bytes { native "net" }
function loopWait(loop: Integer, timeoutMs: Integer, maxEvents: Integer): Bytes { native "net" }
