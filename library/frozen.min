// Shared immutable input: read Text out of a FrozenBytes without copying the
// bytes. Programs use this module only when they already share a frozen
// buffer between threads or between the branches of a join.
use "errors" as errors

// One validating pass and no copy: a Text view of a byte range of shared
// frozen storage, None when that range is not UTF-8.
function frozenText(source: FrozenBytes, start: Integer, end: Integer): Maybe<Text> { native "runtime" }

/// Turn a byte range of a `FrozenBytes` into Text without copying the bytes.
/// The frozen buffer is immutable and shared, so the returned Text is a view
/// of it that keeps it alive; every thread and every branch of a join can read
/// the same buffer this way. The range must be UTF-8 on its own (a partial
/// character is invalid) and is validated in one pass exactly like
/// `text.decode`; an invalid range returns an invalid-data error. Positions
/// outside the buffer stop, like a Text slice outside its source.
///
/// ```minyar
/// let frozen = freezeBytes(Bytes("one two"))
/// match api.decode(frozen, 4, 7) {
///     Ok(word) { print(word) }
///     Err(error) { fail("the range was not UTF-8") }
/// }
/// ```
/// ```output
/// two
/// ```
public function decode(source: FrozenBytes, start: Integer, end: Integer): Result<Text, errors.Error> {
    match frozenText(source, start, end) {
        Some(decoded) { return Ok(decoded) }
        None { return Err(errors.make(errors.invalidDataCode(), 0, "invalid UTF-8 text input")) }
    }
}
