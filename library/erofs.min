use "errors" as errors

public constant NONE = 0
public constant ZSTD = 1
public record Options { compression: Integer; level: Integer; maximumBytes: Integer }
public function defaults(): Options {
    return Options { compression: NONE; level: 3; maximumBytes: 17592186040320 }
}
function directoryStatus(source: Text, destination: Text, compression: Integer, level: Integer, maximumBytes: Integer): Bytes { native "erofs" }
function outcome(raw: Bytes): errors.Error {
    if raw.length < 8 { return errors.make(errors.systemCode(), 5, "erofs writer returned an invalid result") }
    let code = raw.getInt64(0)
    if code == 0 { return errors.none() }
    return errors.make(errors.systemCode(), code, Text(raw.slice(8, raw.length)))
}
public function writeDirectory(source: Text, destination: Text, options: Options): errors.Error {
    return outcome(directoryStatus(source, destination, options.compression, options.level, options.maximumBytes))
}
