// Direct access to a 64-bit Arm (AArch64) machine for freestanding programs.
// It has the same functions as library/machine.min, which serves x86-64; a
// build for Arm lists library/arch/arm64 before library in --library, so
// `use "machine" as machine` finds this file instead, as Linux's
// arch/arm64/include does for its generic headers.
//
// Every function is a compiler intrinsic (`native "machine_arm64"`).
// Addresses are Integers holding identity-mapped physical addresses.
// I/O ports, the x86 interrupt table and the VMware hypervisor call have no
// Arm equivalent: they exist so portable packages still compile, and stop the
// processor if a program ever reaches them.

// ----- Ordinary memory -----
// Plain loads and stores that the optimizer may combine, reorder or vectorize.
// Use them for buffers the program owns, such as pixel or packet storage.

public function load8(address: Integer): Integer { native "machine_arm64" }
public function load16(address: Integer): Integer { native "machine_arm64" }
public function load32(address: Integer): Integer { native "machine_arm64" }
public function load64(address: Integer): Integer { native "machine_arm64" }
public function store8(address: Integer, value: Integer) { native "machine_arm64" }
public function store16(address: Integer, value: Integer) { native "machine_arm64" }
public function store32(address: Integer, value: Integer) { native "machine_arm64" }
public function store64(address: Integer, value: Integer) { native "machine_arm64" }

// Set `count` bytes to the low eight bits of `value`.
public function fill8(address: Integer, count: Integer, value: Integer) { native "machine_arm64" }
// Set `count` consecutive 32-bit words, such as pixels, to `value`.
public function fill32(address: Integer, count: Integer, value: Integer) { native "machine_arm64" }
// Copy `count` bytes; the ranges may overlap.
public function copy(destination: Integer, source: Integer, count: Integer) { native "machine_arm64" }

// The address of the first byte of `bytes`. It stays valid until the Bytes
// value grows, is cleared or is released, so keep the value alive while using it.
public function address(bytes: Bytes): Integer { native "machine_arm64" }

// ----- Device memory -----
// Volatile accesses that happen exactly once, in program order, for
// memory-mapped device registers.

public function read8(address: Integer): Integer { native "machine_arm64" }
public function read16(address: Integer): Integer { native "machine_arm64" }
public function read32(address: Integer): Integer { native "machine_arm64" }
public function read64(address: Integer): Integer { native "machine_arm64" }
public function write8(address: Integer, value: Integer) { native "machine_arm64" }
public function write16(address: Integer, value: Integer) { native "machine_arm64" }
public function write32(address: Integer, value: Integer) { native "machine_arm64" }
public function write64(address: Integer, value: Integer) { native "machine_arm64" }
// Order every earlier memory access before every later one.
public function fence() { native "machine_arm64" }

// ----- I/O ports -----
// x86-64 only.

public function in8(port: Integer): Integer { native "machine_arm64" }
public function in16(port: Integer): Integer { native "machine_arm64" }
public function in32(port: Integer): Integer { native "machine_arm64" }
public function out8(port: Integer, value: Integer) { native "machine_arm64" }
public function out16(port: Integer, value: Integer) { native "machine_arm64" }
public function out32(port: Integer, value: Integer) { native "machine_arm64" }

// ----- Processor -----

// The virtual counter (CNTVCT_EL0), which counts at timerFrequency() per second.
public function timestamp(): Integer { native "machine_arm64" }
// A spin-wait hint for busy loops.
public function pause() { native "machine_arm64" }
// The counter's frequency in ticks per second (CNTFRQ_EL0).
public function timerFrequency(): Integer { native "machine_arm64" }
// Call firmware through the SMC Calling Convention over HVC, as PSCI does to
// start processors and power off: `function` in x0, arguments in x1-x3.
public function firmwareCall(function: Integer, first: Integer, second: Integer, third: Integer): Integer { native "machine_arm64" }
public function halt() { native "machine_arm64" }
public function enableInterrupts() { native "machine_arm64" }
public function disableInterrupts() { native "machine_arm64" }
// Sleep until an interrupt is pending, then enable interrupts so its handler
// runs. Interrupts stay enabled afterwards.
public function waitForInterrupt() { native "machine_arm64" }
// x86-64 only: the boot code sets the Arm vector table (VBAR_EL1) instead.
public function loadInterruptTable(address: Integer, limit: Integer) { native "machine_arm64" }
// x86-64 only.
public function interruptHandler(vector: Integer): Integer { native "machine_arm64" }
// How many times the interrupt with this GIC number has fired since boot.
public function interruptCount(vector: Integer): Integer { native "machine_arm64" }
// Call the code at `address` with `argument` as its first parameter. Used by
// boot loaders to enter a kernel; it does not return if the kernel does not.
public function jump(address: Integer, argument: Integer) { native "machine_arm64" }
// x86-64 only: the VMware/QEMU hypervisor port.
public function hypervisorCall(command: Integer, parameter: Integer, results: Integer) { native "machine_arm64" }

// ----- Multiple processors -----
// Code that runs on several processors at once must be a `parallel function`:
// it uses only Integer, Float, Boolean and Character values and calls only
// other parallel functions and these intrinsics, so it never touches the
// single-threaded runtime. `parallelEntry(name)` gives such a function's
// address.

// Atomically add `value` to the 64-bit Integer at `address`; returns the old value.
public function atomicAdd(address: Integer, value: Integer): Integer { native "machine_arm64" }
// Call the parallel function at `entry` with two Integers.
public function callEntry(entry: Integer, first: Integer, second: Integer) { native "machine_arm64" }
// An address published by the boot code's symbol table (see os/arch/arm64/head.S).
public function symbol(index: Integer): Integer { native "machine_arm64" }

// ----- Pixels -----
// Blending loops for 32-bit 0x00RRGGBB pixels, compiled so the processor can
// work on several pixels per instruction.

// Blend `count` pixels at `address` toward `color` with opacity 0 to 256.
public function blendSpan(address: Integer, count: Integer, color: Integer, opacity: Integer) { native "machine_arm64" }
// Blend `count` pixels toward `color` through the bytes at `mask`: each
// pixel's opacity is min(mask + bias, limit) × scale / 256 (scale 0-256).
public function blendMask(address: Integer, count: Integer, mask: Integer, color: Integer, scale: Integer, bias: Integer, limit: Integer) { native "machine_arm64" }
// Turn `count` float32 signed areas at `source` into coverage bytes 0-255 at
// `target`: each byte is the running sum so far, made positive, capped at 1.
public function coverage(source: Integer, target: Integer, count: Integer) { native "machine_arm64" }
