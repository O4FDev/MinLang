// A completion token must be completed or transferred on every normal path.
// Bindings and ordinary function arguments move its source-level obligation;
// reference counting continues to manage its memory independently.
// Tokens cannot enter containers, globals, callbacks, loops or native code.
// Fatal stops do not promise protocol completion or automatic rollback.

public record Completion native "protocol_completion" {}

// Allocates one empty managed record. The compiler checks each token's flow.
public function begin(): Completion { native "protocol" }

// Consumes a live token. Call after the application's commit/rollback/close has
// succeeded. This primitive has no runtime protocol flag or external provider.
public function complete(completion: Completion) { native "protocol" }
