use "random" as secureRandom
// HTTP/1.1 requests over the `net` and `tls` packages, for any platform.
// Import it with `use "http" as http`.
//
// This is the portable `http`. On macOS, ./minyar finds
// library/platform/macos/http.min first: the same Response, get, post, request
// and bounded downloads, through NSURLSession, plus streaming (start, read, ...).
// Pass `--library library` to ./minyar to use this one there too.
//
//     let response = http.post("http://127.0.0.1:8080/ask", ["Content-Type: application/json"], "{}")
//     print(response.status)
//     match text.decode(response.body) { Ok(body) { print(body) } Err(error) { print("binary body") } }
//
// http:// and https:// URLs are supported; https uses the `tls` package, which
// validates the server certificate against OS roots. It decodes chunked transfer
// framing but does not follow redirects or decode content encodings.
// Minyar OS uses
// its own client in os/kernel/net/http.min over its own TCP/IP stack.
use "net" as net
use "eventloop" as loop
use "tls" as tls
use "text" as text
use "errors" as errors
use "json" as json
use "system" as system
use "io" as io

public record Response {
    status: Integer
    reason: Text
    headers: List<Text>
    body: Bytes
    error: Text
}

// A complete response. Transport/protocol failures live in Result, and an HTTP
// error status such as 404 remains a complete, successful Reply.
public record Reply { status: Integer; reason: Text; headers: List<Text>; body: Bytes }
function typedResponse(response: Response): Result<Reply, errors.Error> {
    if response.status == 0 || response.error != "" {
        let message = response.error
        if message == "" { message = "the request did not return a complete response" }
        return Err(errors.make(errors.unavailableCode(), 0, message))
    }
    return Ok(Reply { status: response.status; reason: response.reason; headers: response.headers; body: response.body })
}
public function fetch(url: Text, headers: List<Text>): Result<Reply, errors.Error> { return typedResponse(get(url, headers)) }
public function postText(url: Text, headers: List<Text>, body: Text): Result<Reply, errors.Error> { return typedResponse(post(url, headers, body)) }
public function send(method: Text, url: Text, headers: List<Text>, body: Text): Result<Reply, errors.Error> { return typedResponse(request(method, url, headers, body)) }
public function fetchBounded(url: Text, headers: List<Text>, limit: Integer): Result<Reply, errors.Error> { return typedResponse(getBounded(url, headers, limit)) }
public function fetchWithin(url: Text, headers: List<Text>, limit: Integer, timeoutMs: Integer): Result<Reply, errors.Error> { return typedResponse(getBoundedWithin(url, headers, limit, timeoutMs)) }
public function sendBounded(method: Text, url: Text, headers: List<Text>, body: Text, limit: Integer): Result<Reply, errors.Error> { return typedResponse(requestBounded(method, url, headers, body, limit)) }
public function sendWithin(method: Text, url: Text, headers: List<Text>, body: Text, limit: Integer, timeoutMs: Integer): Result<Reply, errors.Error> { return typedResponse(requestBoundedWithin(method, url, headers, body, limit, timeoutMs)) }
// The same requests trusting only the given DER root certificates (for example tls.pemCertificates of a CA
// bundle) instead of the OS roots; an empty list uses the OS roots. limit and timeoutMs are as in fetchWithin.
public function fetchTrusting(url: Text, headers: List<Text>, limit: Integer, timeoutMs: Integer, roots: List<Bytes>): Result<Reply, errors.Error> { return typedResponse(requestTrusting("GET", url, headers, "", limit, timeoutMs, roots)) }
public function sendTrusting(method: Text, url: Text, headers: List<Text>, body: Text, limit: Integer, timeoutMs: Integer, roots: List<Bytes>): Result<Reply, errors.Error> { return typedResponse(requestTrusting(method, url, headers, body, limit, timeoutMs, roots)) }
/// The trust roots the environment names: the certificates of the PEM file in SSL_CERT_FILE, or an empty list
/// (OS roots) when it is unset or empty. Pass the result to fetchTrusting or sendTrusting.
public function environmentTrust(): Result<List<Bytes>, errors.Error> {
    let path = system.getenv("SSL_CERT_FILE")
    if path == "" { return Ok([]) }
    let bundle = try io.readBytes(path) else ("reading SSL_CERT_FILE " + path)
    let roots = try tls.pemCertificates(bundle) else ("reading SSL_CERT_FILE " + path)
    return Ok(roots)
}
public function Reply.text(): Result<Text, errors.Error> { return text.decode(self.body) }
public function Reply.json(): Result<json.Value, errors.Error> { return json.decodeBytes(self.body, 134217728) }

record Address {
    host: Text
    authority: Text
    port: Integer
    path: Text
    secure: Boolean
}

function failed(message: Text): Response {
    return Response { status: 0; reason: ""; headers: []; body: Bytes(); error: message }
}

// Keep the URI authority separate from the unbracketed connection host.
// A malformed URL is a recoverable request failure, never Integer overflow.
function invalidAddress(): Address {
    return Address { host: ""; authority: ""; port: 0; path: ""; secure: false }
}

function parse(url: Text): Address {
    let secure = false
    let scheme = "http://"
    if url.length >= 8 && url.slice(0, 8) == "https://" {
        secure = true
        scheme = "https://"
    }
    if url.length < scheme.length || url.slice(0, scheme.length) != scheme {
        return invalidAddress()
    }
    // Reject raw whitespace and controls before they can enter HTTP framing.
    for character in url {
        if Integer(character) <= 32 || Integer(character) == 127 { return invalidAddress() }
    }
    let rest = url.slice(scheme.length, url.length)
    let end = rest.length
    for position in 0..rest.length {
        if end == rest.length && (rest[position] == '/' || rest[position] == '?' || rest[position] == '#') {
            end = position
        }
    }
    let authority = rest.slice(0, end)
    if authority == "" { return invalidAddress() }
    let host = authority
    let portText = ""
    let portAt = -1
    if authority[0] == '[' {
        let closing = -1
        for position in 1..authority.length {
            if closing < 0 && authority[position] == ']' { closing = position }
        }
        if closing < 0 { return invalidAddress() }
        host = authority.slice(1, closing)
        if net.ipVersion(host) != 6 { return invalidAddress() }
        if closing + 1 < authority.length {
            if authority[closing + 1] != ':' { return invalidAddress() }
            portAt = closing + 1
        }
    } else {
        for position in 0..authority.length {
            let character = authority[position]
            if character == '[' || character == ']' || character == '@' { return invalidAddress() }
            if character == ':' {
                if portAt >= 0 { return invalidAddress() }
                portAt = position
            }
        }
        if portAt >= 0 { host = authority.slice(0, portAt) }
        if host == "" { return invalidAddress() }
    }
    let port = 80
    if secure { port = 443 }
    if portAt >= 0 {
        portText = authority.slice(portAt + 1, authority.length)
        if portText == "" {
            // An empty explicit port uses the scheme default.
            authority = authority.slice(0, portAt)
        } else {
            port = 0
            for character in portText {
                let digit = Integer(character) - 48
                if digit < 0 || digit > 9 || port > 6553 || (port == 6553 && digit > 5) {
                    return invalidAddress()
                }
                port = port * 10 + digit
            }
            if port == 0 { return invalidAddress() }
        }
    }
    let targetEnd = rest.length
    for position in end..rest.length {
        if targetEnd == rest.length && rest[position] == '#' { targetEnd = position }
    }
    let path = "/"
    if end < targetEnd {
        path = rest.slice(end, targetEnd)
        if path[0] == '?' { path = "/" + path }
    }
    return Address { host: host; authority: authority; port: port; path: path; secure: secure }
}

public function get(url: Text, headers: List<Text>): Response {
    return request("GET", url, headers, "")
}

public function post(url: Text, headers: List<Text>, body: Text): Response {
    return request("POST", url, headers, body)
}

public function request(method: Text, url: Text, headers: List<Text>, body: Text): Response {
    return requestBoundedWithin(method, url, headers, body, 134217728, 30000)
}

// Portable bounded requests: certificate verification remains enabled. Reads
// retain at most limit + 32KiB wire bytes and limit decoded chunk bytes, plus
// bounded parser/TLS buffers. This is not a bound on total OS/TLS memory.
// This backend does not follow redirects or decode content encodings.
public function getBounded(url: Text, headers: List<Text>, limit: Integer): Response {
    return getBoundedWithin(url, headers, limit, 30000)
}

public function postBounded(url: Text, headers: List<Text>, body: Text, limit: Integer): Response {
    return requestBounded("POST", url, headers, body, limit)
}

public function requestBounded(method: Text, url: Text, headers: List<Text>, body: Text, limit: Integer): Response {
    return requestBoundedWithin(method, url, headers, body, limit, 30000)
}

// One absolute I/O deadline covers upload, TLS handshake and response reads, so
// a slow peer cannot reset a timeout forever. Name resolution and the initial
// blocking connect still use platform timeouts.
public function getBoundedWithin(url: Text, headers: List<Text>, limit: Integer, timeoutMs: Integer): Response {
    return requestBoundedWithin("GET", url, headers, "", limit, timeoutMs)
}

public function postBoundedWithin(url: Text, headers: List<Text>, body: Text, limit: Integer, timeoutMs: Integer): Response {
    return requestBoundedWithin("POST", url, headers, body, limit, timeoutMs)
}

public function requestBoundedWithin(method: Text, url: Text, headers: List<Text>, body: Text, limit: Integer, timeoutMs: Integer): Response {
    if limit < 1 || limit > 134217728 { return failed("invalid download size limit") }
    if timeoutMs < 1 || timeoutMs > 300000 { return failed("invalid download timeout") }
    return exchange(method, url, headers, body, limit, timeoutMs, [])
}

function requestTrusting(method: Text, url: Text, headers: List<Text>, body: Text, limit: Integer, timeoutMs: Integer, roots: List<Bytes>): Response {
    if limit < 1 || limit > 134217728 { return failed("invalid download size limit") }
    if timeoutMs < 1 || timeoutMs > 300000 { return failed("invalid download timeout") }
    return exchange(method, url, headers, body, limit, timeoutMs, roots)
}

function ready(connection: Integer, deadline: Integer): Boolean {
    let remaining = deadline - net.monotonicMilliseconds()
    return remaining > 0 && net.ready(connection, remaining)
}

// Writes share the request's absolute deadline. Watching makes the socket
// non-blocking, so a peer that stops reading cannot hold the caller in send.
function writeWithin(connection: Integer, data: Bytes, deadline: Integer, operation: Text): Text {
    if data.length == 0 { return "" }
    if deadline <= 0 {
        if net.send(connection, data) == data.length { return "" }
        return operation + " failed: " + net.lastError()
    }
    let created = loop.create()
    if !errors.integerOk(created) { return operation + " failed: " + errors.message(errors.integerError(created)) }
    let handle = errors.integerValue(created)
    let watched = loop.watch(handle, connection, loop.writableInterest(), 0)
    if !errors.integerOk(watched) {
        loop.close(handle)
        return operation + " failed: " + errors.message(errors.integerError(watched))
    }
    let registration = errors.integerValue(watched)
    let sent = 0
    while sent < data.length {
        let remaining = deadline - net.monotonicMilliseconds()
        if remaining <= 0 {
            loop.remove(handle, registration); loop.close(handle)
            return operation + " timed out"
        }
        let count = net.writeRange(connection, data, sent, min(16777216, data.length - sent))
        if count > 0 { sent += count; continue }
        if count == 0 {
            loop.remove(handle, registration); loop.close(handle)
            return operation + " failed: the connection closed while sending"
        }
        if count != -1 {
            let detail = net.lastError()
            loop.remove(handle, registration); loop.close(handle)
            return operation + " failed: " + detail
        }
        let batch = loop.wait(handle, remaining, 1)
        if errors.isError(loop.batchError(batch)) {
            let detail = errors.message(loop.batchError(batch))
            loop.remove(handle, registration); loop.close(handle)
            return operation + " failed: " + detail
        }
        if loop.events(batch).length == 0 {
            loop.remove(handle, registration); loop.close(handle)
            return operation + " timed out"
        }
    }
    loop.remove(handle, registration); loop.close(handle)
    return ""
}

function requestFramingError(method: Text, headers: List<Text>): Text {
    if method.length < 1 { return "invalid HTTP request method" }
    for character in method { if !headerToken(character) { return "invalid HTTP request method" } }
    for header in headers {
        let colon = -1
        for position in 0..header.length {
            if header[position] == ':' { colon = position; break }
            if !headerToken(header[position]) { return "invalid HTTP request header name" }
        }
        if colon < 1 { return "invalid HTTP request header" }
        let name = lowerASCII(header.slice(0, colon))
        if name == "host" || name == "connection" || name == "content-length" || name == "transfer-encoding" {
            return "HTTP framing header is managed by the client: " + name
        }
        for position in (colon + 1)..header.length {
            let value = Integer(header[position])
            if (value < 32 && value != 9) || value == 127 { return "invalid control in HTTP request header" }
        }
    }
    return ""
}

function exchange(method: Text, url: Text, headers: List<Text>, body: Text, limit: Integer, timeoutMs: Integer, roots: List<Bytes>): Response {
    let framingError = requestFramingError(method, headers)
    if framingError != "" { return failed(framingError) }
    let address = parse(url)
    if address.host == "" {
        return failed("invalid http:// or https:// URL: " + url)
    }
    let connection = net.connect(address.host, address.port)
    if connection < 0 {
        return failed(net.lastError())
    }
    let deadline = 0
    if limit > 0 { deadline = net.monotonicMilliseconds() + timeoutMs }
    let content = Bytes(body)
    let lines: List<Text> = [method + " " + address.path + " HTTP/1.1\r\n", "Host: " + address.authority + "\r\n", "Connection: close\r\n"]
    for header in headers {
        lines.add(header + "\r\n")
    }
    if body != "" {
        lines.add("Content-Length: " + Text(content.length) + "\r\n")
    }
    lines.add("\r\n")
    let message = Bytes(joinText(lines))
    message.addBytes(content)
    if address.secure {
        return secureExchange(connection, address.host, method, message, limit, deadline, roots)
    }
    let sendError = writeWithin(connection, message, deadline, "HTTP upload")
    if sendError != "" {
        net.close(connection)
        return failed(sendError)
    }
    let received = Bytes()
    let responseState = newResponseState()
    while true {
        if limit > 0 && !ready(connection, deadline) { net.close(connection); return failed("download timed out") }
        let capacity = 65536
        if limit > 0 { capacity = min(capacity, limit + 32768 - received.length) }
        if capacity < 1 { net.close(connection); return failed("download exceeds its size limit") }
        let chunk = net.receive(connection, capacity)
        if chunk.length == 0 {
            let error = net.lastError()
            let code = net.lastErrorCode()
            net.close(connection)
            if code != 0 { return failed("HTTP receive failed: " + error) }
            return readResponse(received, method, limit, true, responseState)
        }
        received.addBytes(chunk)
        let response = readResponse(received, method, limit, false, responseState)
        if response.status >= 0 { net.close(connection); return response }
    }
}

function secureExchange(connection: Integer, host: Text, method: Text, message: Bytes, limit: Integer, deadline: Integer, roots: List<Bytes>): Response {
    let session = tls.clientWithTrust(host, secureRandom.bytes(64), roots)
    let hello = tls.takeOutgoing(session)
    let helloError = writeWithin(connection, hello, deadline, "TLS handshake send")
    if helloError != "" { net.close(connection); return failed(helloError) }
    let handshakeBytes = 0
    while session.state == tls.HELLO_SENT || session.state == tls.HANDSHAKE {
        if limit > 0 && !ready(connection, deadline) { net.close(connection); return failed("TLS handshake timed out") }
        let chunk = net.receive(connection, 65536)
        if chunk.length == 0 {
            net.close(connection)
            return failed("the server closed the connection during the TLS handshake")
        }
        handshakeBytes += chunk.length
        if limit > 0 && handshakeBytes > 1048576 { net.close(connection); return failed("TLS handshake exceeds its size limit") }
        tls.receive(session, chunk)
        let reply = tls.takeOutgoing(session)
        let replyError = writeWithin(connection, reply, deadline, "TLS handshake send")
        if replyError != "" { net.close(connection); return failed(replyError) }
    }
    if !tls.established(session) {
        net.close(connection)
        return failed("TLS failed: " + session.error)
    }
    tls.send(session, message)
    let outgoing = tls.takeOutgoing(session)
    let requestError = writeWithin(connection, outgoing, deadline, "TLS upload")
    if requestError != "" { net.close(connection); return failed(requestError) }
    let received = Bytes()
    let responseState = newResponseState()
    while session.state == tls.ESTABLISHED {
        if limit > 0 && !ready(connection, deadline) { net.close(connection); return failed("download timed out") }
        let chunk = net.receive(connection, 65536)
        if chunk.length == 0 {
            let error = net.lastError()
            let code = net.lastErrorCode()
            if code != 0 { net.close(connection); return failed("TLS receive failed: " + error) }
            tls.endInput(session)
            break
        }
        tls.receive(session, chunk)
        received.addBytes(tls.takeIncoming(session))
        if limit > 0 && received.length > limit + 32768 {
            net.close(connection); return failed("download exceeds its size limit")
        }
        if session.state == tls.FAILED { break }
        let response = readResponse(received, method, limit, false, responseState)
        if response.status >= 0 { net.close(connection); return response }
    }
    received.addBytes(tls.takeIncoming(session))
    net.close(connection)
    if session.state == tls.FAILED {
        return failed("TLS failed: " + session.error)
    }
    return readResponse(received, method, limit, true, responseState)
}

function headerEnd(data: Bytes, offset: Integer): Integer {
    let index = offset
    while index + 3 < data.length {
        if data[index] == 13 && data[index + 1] == 10 && data[index + 2] == 13 && data[index + 3] == 10 {
            return index
        }
        index += 1
    }
    return -1
}

function pending(): Response {
    return Response { status: -1; reason: ""; headers: []; body: Bytes(); error: "" }
}

function lowerASCII(value: Text): Text {
    let bytes = Bytes(value)
    for index in 0..bytes.length {
        if bytes[index] >= 65 && bytes[index] <= 90 { bytes[index] += 32 }
    }
    return text.decodeOrStop(bytes)
}

function trimSpace(value: Text): Text {
    let start = 0
    let end = value.length
    while start < end && (value[start] == ' ' || value[start] == '\t') { start += 1 }
    while end > start && (value[end - 1] == ' ' || value[end - 1] == '\t') { end -= 1 }
    return value.slice(start, end)
}

function headerToken(character: Character): Boolean {
    if character >= 'a' && character <= 'z' { return true }
    if character >= 'A' && character <= 'Z' { return true }
    if character >= '0' && character <= '9' { return true }
    for allowed in "!#$%&'*+-.^_`|~" { if character == allowed { return true } }
    return false
}

// Chunk progress belongs to one exchange. No prefix is decoded twice when a
// peer splits sizes, data, CRLF or trailers across reads. Wire bytes remain
// bounded independently; decoded bytes are published only after completion.
record ChunkReader {
    status: Integer; reason: Text; headers: List<Text>
    cursor: Integer; scan: Integer; phase: Integer; remaining: Integer
    framing: Integer; body: Bytes; error: Text
}
function chunkReader(): ChunkReader {
    return ChunkReader { status: 0; reason: ""; headers: []; cursor: 0; scan: 0; phase: 0; remaining: 0; framing: 0; body: Bytes(); error: "" }
}
function hexDigit(byte: Integer): Integer {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 65 && byte <= 70 { return byte - 55 }
    if byte >= 97 && byte <= 102 { return byte - 87 }
    return -1
}
function chunkSpace(byte: Integer): Boolean { return byte == 32 || byte == 9 }

// RFC 9112 section 7.1.1: ignore extensions only after checking their token /
// quoted-string grammar, including BWS and quoted-pair. Sizes never overflow.
function chunkSize(line: Bytes): Integer {
    let index = 0
    let size = 0
    while index < line.length {
        let digit = hexDigit(line[index])
        if digit < 0 { break }
        if size > (9223372036854775807 - digit) / 16 { return -1 }
        size = size * 16 + digit
        index += 1
    }
    if index == 0 { return -1 }
    while index < line.length {
        while index < line.length && chunkSpace(line[index]) { index += 1 }
        if index >= line.length || line[index] != 59 { return -1 }
        index += 1
        while index < line.length && chunkSpace(line[index]) { index += 1 }
        let start = index
        while index < line.length && headerToken(Character(line[index])) { index += 1 }
        if index == start { return -1 }
        let afterName = index
        while index < line.length && chunkSpace(line[index]) { index += 1 }
        if index >= line.length || line[index] != 61 { index = afterName; continue }
        index += 1
        while index < line.length && chunkSpace(line[index]) { index += 1 }
        if index >= line.length { return -1 }
        if line[index] == 34 {
            index += 1
            let closed = false
            while index < line.length {
                let byte = line[index]
                index += 1
                if byte == 34 { closed = true; break }
                if byte == 92 {
                    if index >= line.length { return -1 }
                    byte = line[index]
                    index += 1
                }
                if (byte < 32 && byte != 9) || byte == 127 { return -1 }
            }
            if !closed { return -1 }
        } else {
            let start = index
            while index < line.length && headerToken(Character(line[index])) { index += 1 }
            if index == start { return -1 }
        }
    }
    return size
}

// scan remembers the inspected prefix of this one metadata line, so even a
// one-byte drip is linear. CRLF is mandatory; metadata includes initial headers.
function chunkLine(data: Bytes, reader: ChunkReader): Integer {
    while reader.scan < data.length {
        let byte = data[reader.scan]
        if reader.framing + reader.scan - reader.cursor + 1 > 32768 {
            reader.error = "HTTP framing exceeds 32 KiB"; return -1
        }
        if byte == 10 { reader.error = "invalid chunked HTTP line ending"; return -1 }
        if byte == 13 {
            if reader.scan + 1 >= data.length { return -1 }
            if data[reader.scan + 1] != 10 { reader.error = "invalid chunked HTTP line ending"; return -1 }
            if reader.framing + reader.scan - reader.cursor + 2 > 32768 {
                reader.error = "HTTP framing exceeds 32 KiB"; return -1
            }
            return reader.scan
        }
        reader.scan += 1
    }
    return -1
}
function validTrailer(line: Bytes): Boolean {
    if !text.validUTF8(line) { return false }
    let colon = -1
    for index in 0..line.length {
        let byte = line[index]
        if colon < 0 {
            if byte == 58 { colon = index }
            else if !headerToken(Character(byte)) { return false }
        } else if (byte < 32 && byte != 9) || byte == 127 { return false }
    }
    return colon > 0
}
function readChunked(data: Bytes, limit: Integer, ended: Boolean, reader: ChunkReader): Response {
    if limit > 0 && data.length > limit + 32768 { return failed("download exceeds its size limit") }
    while true {
        if reader.phase == 4 {
            if reader.cursor != data.length { return failed("bytes follow the chunked HTTP body") }
            return Response { status: reader.status; reason: reader.reason; headers: reader.headers; body: reader.body; error: "" }
        }
        if reader.phase == 0 || reader.phase == 3 {
            let end = chunkLine(data, reader)
            if reader.error != "" { return failed(reader.error) }
            if end < 0 { break }
            let line = data.slice(reader.cursor, end)
            reader.framing += end + 2 - reader.cursor
            reader.cursor = end + 2
            reader.scan = reader.cursor
            if reader.phase == 3 {
                if line.length == 0 { reader.phase = 4; continue }
                if !validTrailer(line) { return failed("invalid chunked HTTP trailer") }
                // Discard every trailer, never merge framing/cookie/MIME fields
                // into the original response headers (RFC 9112 section 7.1.2).
            } else {
                let size = chunkSize(line)
                if size < 0 { return failed("invalid HTTP chunk size or extension") }
                if limit > 0 && size > limit - reader.body.length { return failed("download exceeds its size limit") }
                if reader.status == 205 && size > 0 { return failed("HTTP 205 responses cannot contain content") }
                reader.remaining = size
                if size == 0 { reader.phase = 3 } else { reader.phase = 1 }
            }
        } else if reader.phase == 1 {
            let count = min(reader.remaining, data.length - reader.cursor)
            if count == 0 { break }
            reader.body.addBytes(data.slice(reader.cursor, reader.cursor + count))
            reader.cursor += count
            reader.remaining -= count
            if reader.remaining == 0 { reader.phase = 2 }
        } else {
            if reader.framing + 2 > 32768 { return failed("HTTP framing exceeds 32 KiB") }
            if reader.cursor >= data.length { break }
            if data[reader.cursor] != 13 { return failed("invalid HTTP chunk data ending") }
            if reader.cursor + 1 >= data.length { break }
            if data[reader.cursor + 1] != 10 { return failed("invalid HTTP chunk data ending") }
            reader.cursor += 2
            reader.scan = reader.cursor
            reader.framing += 2
            reader.phase = 0
        }
    }
    if ended { return failed("the chunked HTTP body was incomplete") }
    return pending()
}

// A validated response head: data[offset, end) without the blank line. error is empty on success.
record ResponseHead {
    error: Text; status: Integer; reason: Text; headers: List<Text>; length: Integer
    transfer: Integer; coding: Text; http11: Boolean; close: Boolean
}
function headFailure(message: Text): ResponseHead {
    return ResponseHead { error: message; status: 0; reason: ""; headers: []; length: -1; transfer: 0; coding: ""; http11: false; close: true }
}
function parseHead(data: Bytes, offset: Integer, end: Integer): ResponseHead {
    let raw = data.slice(offset, end)
    let head = ""
    match text.decode(raw) {
        Ok(decoded) { head = decoded }
        Err(error) { return headFailure("invalid UTF-8 in HTTP headers") }
    }
    for index in 0..raw.length {
        let byte = raw[index]
        if byte == 13 && (index + 1 >= raw.length || raw[index + 1] != 10) { return headFailure("invalid HTTP header line ending") }
        if byte == 10 && (index == 0 || raw[index - 1] != 13) { return headFailure("invalid HTTP header line ending") }
        if (byte < 32 && byte != 9 && byte != 10 && byte != 13) || byte == 127 { return headFailure("invalid control in HTTP headers") }
    }
    let lines: List<Text> = []
    let start = 0
    for position in 0..head.length {
        if head[position] == '\n' {
            let stop = position
            if stop > start && head[stop - 1] == '\r' { stop -= 1 }
            lines.add(head.slice(start, stop))
            start = position + 1
        }
    }
    lines.add(head.slice(start, head.length))
    let first = lines[0]
    if first.length < 12 { return headFailure("invalid HTTP status line") }
    if first.slice(0, 9) != "HTTP/1.0 " && first.slice(0, 9) != "HTTP/1.1 " { return headFailure("invalid HTTP status line") }
    if first.length > 12 && first[12] != ' ' { return headFailure("invalid HTTP status line") }
    let status = 0
    for character in first.slice(9, 12) {
        if character < '0' || character > '9' { return headFailure("invalid HTTP status code") }
        status = status * 10 + Integer(character) - 48
    }
    if status < 100 || status > 599 { return headFailure("invalid HTTP status code") }
    let reason = first.slice(min(13, first.length), first.length)
    let headers: List<Text> = []
    let length = -1
    let transfer = 0
    let coding = ""
    let closing = false
    let keepAlive = false
    for index in 1..lines.length {
        let line = lines[index]
        let colon = -1
        for position in 0..line.length {
            if line[position] == ':' { colon = position; break }
            if !headerToken(line[position]) { return headFailure("invalid HTTP header name") }
        }
        if colon < 1 { return headFailure("invalid HTTP header") }
        let name = lowerASCII(line.slice(0, colon))
        let value = trimSpace(line.slice(colon + 1, line.length))
        if name == "content-length" {
            if value == "" { return headFailure("invalid HTTP Content-Length") }
            let count = 0
            for character in value {
                let digit = Integer(character) - 48
                if digit < 0 || digit > 9 || count > (9223372036854775807 - digit) / 10 { return headFailure("invalid HTTP Content-Length") }
                count = count * 10 + digit
            }
            if length >= 0 && length != count { return headFailure("conflicting HTTP Content-Length headers") }
            length = count
        }
        if name == "transfer-encoding" { transfer += 1; coding = lowerASCII(value) }
        if name == "connection" {
            for option in lowerASCII(value).split(",") {
                if trimSpace(option) == "close" { closing = true }
                if trimSpace(option) == "keep-alive" { keepAlive = true }
            }
        }
        headers.add(line)
    }
    let http11 = first.slice(0, 8) == "HTTP/1.1"
    return ResponseHead { error: ""; status: status; reason: reason; headers: headers; length: length; transfer: transfer; coding: coding; http11: http11; close: closing || (!http11 && !keepAlive) }
}

// One exchange's parser progress: header scan state, then chunk progress once
// a chunked response head has been accepted.
record ResponseState {
    scan: Integer; offset: Integer; informational: Integer; parsed: Boolean
    end: Integer; status: Integer; reason: Text; headers: List<Text>; length: Integer
    chunk: ChunkReader
}
function newResponseState(): ResponseState {
    return ResponseState { scan: 0; offset: 0; informational: 0; parsed: false; end: -1; status: 0; reason: ""; headers: []; length: -1;
        chunk: chunkReader() }
}

// A negative status is private parser state: more bytes are needed. Headers
// include at most 16 informational responses. A chunked response shares the
// 32 KiB framing cap across headers, sizes, extensions, CRLF and trailers.
// Scan and parsed-header state advance with appended network data so bytewise
// delivery cannot repeatedly parse the same prefix.
function readResponse(data: Bytes, method: Text, limit: Integer, ended: Boolean, state: ResponseState): Response {
    if state.chunk.status > 0 { return readChunked(data, limit, ended, state.chunk) }
    if !state.parsed {
        let end = headerEnd(data, state.scan)
        if end < 0 {
            state.scan = max(state.offset, data.length - 3)
            if data.length > 32768 { return failed("HTTP headers exceed 32 KiB") }
            if ended { return failed("the server's response was incomplete") }
            return pending()
        }
        if end + 4 > 32768 { return failed("HTTP headers exceed 32 KiB") }
        let head = parseHead(data, state.offset, end)
        if head.error != "" { return failed(head.error) }
        let status = head.status
        let reason = head.reason
        let headers = head.headers
        let length = head.length
        let transfer = head.transfer
        let coding = head.coding
        if status < 200 {
            if status == 101 { return failed("HTTP protocol upgrades are unsupported") }
            if state.informational >= 16 { return failed("too many informational HTTP responses") }
            state.informational += 1; state.offset = end + 4; state.scan = state.offset
            return readResponse(data, method, limit, ended, state)
        }
        let noBody = method == "HEAD" || status == 204 || status == 304
        if noBody { return Response { status: status; reason: reason; headers: headers; body: Bytes(); error: "" } }
        if transfer > 0 {
            if length >= 0 { return failed("HTTP Transfer-Encoding conflicts with Content-Length") }
            if transfer != 1 || coding != "chunked" { return failed("unsupported HTTP Transfer-Encoding") }
            if !head.http11 { return failed("HTTP/1.0 Transfer-Encoding is unsupported") }
            state.parsed = true; state.end = end; state.status = status; state.reason = reason; state.headers = headers
            let reader = state.chunk
            reader.status = status; reader.reason = reason; reader.headers = headers
            reader.cursor = end + 4; reader.scan = reader.cursor; reader.framing = reader.cursor
            return readChunked(data, limit, ended, reader)
        }
        state.parsed = true; state.end = end; state.status = status; state.reason = reason; state.headers = headers; state.length = length
    }
    let available = data.length - state.end - 4
    if state.status == 205 && (state.length > 0 || available > 0) { return failed("HTTP 205 responses cannot contain content") }
    if limit > 0 && (available > limit || state.length > limit) { return failed("download exceeds its size limit") }
    if state.length >= 0 {
        if available > state.length { return failed("HTTP body exceeds its Content-Length") }
        if available < state.length {
            if ended { return failed("HTTP body is shorter than its Content-Length") }
            return pending()
        }
    } else if !ended { return pending() }
    let body = data.slice(state.end + 4, data.length)
    return Response { status: state.status; reason: state.reason; headers: state.headers; body: body; error: "" }
}

test "chunked response exposes application bytes" {
    let wire = Bytes("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n")
    let response = readResponse(wire, "GET", 9, true, newResponseState())
    expect(response.status == 200)
    expect(response.error == "")
    expect(text.decodeOrStop(response.body) == "Wikipedia")
}

test "chunk metadata survives every split and one byte reads" {
    let wire = Bytes("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nTransfer-Encoding: ChUnKeD\r\nX-Original: keep\r\n\r\n4 ; foo = \"a\\\"b\"; bare\r\nWiki\r\n5;v=token\r\npedia\r\n000;last=\"\"\r\nX-Trailer: ignored\r\nSet-Cookie: ignored=1\r\nContent-Length: 999\r\n\r\n")
    for cut in 0..wire.length {
        let reader = newResponseState()
        let prefix = wire.slice(0, cut)
        let first = readResponse(prefix, "GET", 9, false, reader)
        expect(first.status == -1)
        expect(first.body.length == 0)
        let response = readResponse(wire, "GET", 9, false, reader)
        expect(response.status == 200)
        expect(text.decodeOrStop(response.body) == "Wikipedia")
        expect(response.headers.length == 2)
        expect(response.headers[1] == "X-Original: keep")
        expect(readResponse(prefix, "GET", 9, true, newResponseState()).status == 0)
    }
    let reader = newResponseState()
    for count in 1..(wire.length + 1) {
        let previous = reader.chunk.cursor
        let response = readResponse(wire.slice(0, count), "GET", 9, false, reader)
        expect(reader.chunk.cursor >= previous)
        expect(reader.chunk.body.length <= 9)
        if count == wire.length { expect(response.status == 200) }
        else { expect(response.status == -1) }
    }
}

test "chunked body preserves arbitrary bytes" {
    let wire = Bytes("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\n")
    for byte in [0, 255, 13, 10] { wire.add(byte) }
    wire.addBytes(Bytes("\r\n0\r\n\r\n"))
    let response = readResponse(wire, "GET", 4, true, newResponseState())
    expect(response.status == 200)
    expect(response.body.length == 4)
    for index in 0..4 { expect(response.body[index] == [0, 255, 13, 10][index]) }
}

test "invalid chunk framing never publishes a partial body" {
    let head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
    let bodies = ["", "\r\n", "-1\r\na\r\n0\r\n\r\n", "+1\r\na\r\n0\r\n\r\n", "0x1\r\na\r\n0\r\n\r\n",
        "g\r\n", "8000000000000000\r\n", "ffffffffffffffffffffffff\r\n", "1 \r\na\r\n0\r\n\r\n",
        "1;\r\na\r\n0\r\n\r\n", "1; x=\r\na\r\n0\r\n\r\n", "1; x=\"open\r\na\r\n0\r\n\r\n",
        "1; x=\"bad\"junk\r\na\r\n0\r\n\r\n", "1; x=\"bad\t" + Text(Character(1)) + "\"\r\na\r\n0\r\n\r\n",
        "1; bad name=yes\r\na\r\n0\r\n\r\n", "1; x=v \r\na\r\n0\r\n\r\n", "1\na\r\n0\r\n\r\n",
        "1\rx\na\r\n0\r\n\r\n", "1\r\naX\r\n0\r\n\r\n", "1\r\na\n0\r\n\r\n", "2\r\na\r\n0\r\n\r\n",
        "1\r\na\r\n", "0\r\n", "0\r\nX: y\r\n", "0\r\n bad: folded\r\n\r\n", "0\r\n: empty\r\n\r\n",
        "0\r\nMissing\r\n\r\n", "0\r\nBad Name: x\r\n\r\n", "0\r\nX: " + Text(Character(0)) + "\r\n\r\n",
        "0\r\nX: " + Text(Character(127)) + "\r\n\r\n", "0\r\nX: x\n\r\n", "0\r\n\r\nextra"]
    for body in bodies {
        let response = readResponse(Bytes(head + body), "GET", 1024, true, newResponseState())
        expect(response.status == 0)
        expect(response.error != "")
        expect(response.body.length == 0)
    }
    let wire = Bytes(head + "0\r\nX: ")
    wire.add(255); wire.addBytes(Bytes("\r\n\r\n"))
    expect(readResponse(wire, "GET", 1024, true, newResponseState()).status == 0)
}

test "ambiguous transfer framing is rejected" {
    for headers in ["Transfer-Encoding: gzip", "Transfer-Encoding: identity", "Transfer-Encoding: gzip, chunked",
        "Transfer-Encoding: chunked, gzip", "Transfer-Encoding: chunked, chunked", "Transfer-Encoding: chunked; a=b",
        "Transfer-Encoding:", "Transfer-Encoding: chunked\r\nTransfer-Encoding: chunked",
        "Transfer-Encoding: chunked\r\nContent-Length: 0", "Content-Length: 1\r\nTransfer-Encoding: chunked"] {
        let response = readResponse(Bytes("HTTP/1.1 200 OK\r\n" + headers + "\r\n\r\n0\r\n\r\n"), "GET", 1024, true, newResponseState())
        expect(response.status == 0)
        expect(response.error != "")
        expect(response.body.length == 0)
    }
    expect(readResponse(Bytes("HTTP/1.0 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"), "GET", 1024, true, newResponseState()).status == 0)
}

test "decoded and framing limits are independent" {
    let head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
    let small = Bytes(head + "4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n")
    expect(readResponse(small, "GET", 9, true, newResponseState()).status == 200)
    expect(readResponse(small, "GET", 8, true, newResponseState()).status == 0)
    expect(readResponse(Bytes(head + "7fffffffffffffff\r\n"), "GET", 9, false, newResponseState()).status == 0)
    let padding = Bytes()
    for index in 0..(32768 - head.byteLength - 10) { padding.add(120) }
    let bounded = Bytes(head + "0\r\nX: ")
    bounded.addBytes(padding); bounded.addBytes(Bytes("\r\n\r\n"))
    expect(bounded.length == 32768)
    expect(readResponse(bounded, "GET", 1, true, newResponseState()).status == 200)
    let excess = Bytes(head + "0\r\nX: x")
    excess.addBytes(padding); excess.addBytes(Bytes("\r\n\r\n"))
    expect(readResponse(excess, "GET", 1, true, newResponseState()).status == 0)
    let many = Bytes(head)
    for index in 0..2048 { many.addBytes(Bytes("1\r\nx\r\n")) }
    many.addBytes(Bytes("0\r\n\r\n"))
    let reader = newResponseState()
    for count in 1..(many.length + 1) {
        let response = readResponse(many.slice(0, count), "GET", 2048, false, reader)
        if count == many.length { expect(response.status == 200); expect(response.body.length == 2048) }
        else { expect(response.status == -1); expect(response.body.length == 0) }
    }
}

test "bodyless and reset statuses retain their framing rules" {
    for status in [204, 304] {
        let response = readResponse(Bytes("HTTP/1.1 " + Text(status) + " Empty\r\nTransfer-Encoding: chunked\r\n\r\n"), "GET", 1, false, newResponseState())
        expect(response.status == status); expect(response.body.length == 0)
    }
    let head = readResponse(Bytes("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 500\r\n\r\n"), "HEAD", 1, false, newResponseState())
    expect(head.status == 200); expect(head.body.length == 0)
    let reset = "HTTP/1.1 205 Reset\r\nTransfer-Encoding: chunked\r\n\r\n"
    expect(readResponse(Bytes(reset + "0\r\n\r\n"), "GET", 1, false, newResponseState()).status == 205)
    expect(readResponse(Bytes(reset + "1\r\nx\r\n0\r\n\r\n"), "GET", 1, true, newResponseState()).status == 0)
    expect(readResponse(Bytes("HTTP/1.1 101 Switching\r\n\r\n"), "GET", 1, true, newResponseState()).status == 0)
}

// ---- keep-alive client with streaming bodies ----
// A Client holds one HTTP/1.1 connection to one origin and reuses it for every request whose response body
// was read to its end and that neither side closed. Bodies stream: begin sends a request and returns the
// response head, then read returns the body piece by piece, so a large object never has to fit in memory.
//
//     let client = try http.connectTo("https://data.example.org", [], 30000) else "connecting"
//     let head = try client.begin("GET", "/table.parquet", ["Range: bytes=0-65535"], Bytes()) else "requesting"
//     while true {
//         match try client.read(1048576) else "reading" { Some(piece) { consume(piece) } None { break } }
//     }
//     client.close()
//
// timeoutMs bounds each begin and each read (connect, TLS handshake, upload and waiting for bytes). A request
// begun before the previous body was read to its end closes the connection and opens a new one. When a reused
// connection turns out to be closed or reset by the server before any response byte, begin reconnects and
// resends the request once for idempotent methods (GET, HEAD, OPTIONS, PUT, DELETE). Redirects are not followed and content
// encodings are not decoded, as in the other requests here.
public record Client {
    private address: Address
    private roots: List<Bytes>
    private timeoutMs: Integer
    private socket: Integer
    private session: tls.Session
    private inbound: Bytes
    private method: Text
    private streaming: Boolean
    private framing: Integer       // 0 no body left, 1 Content-Length, 2 chunked, 3 until the server closes
    private remaining: Integer     // Content-Length bytes or bytes of the current chunk still to deliver
    private phase: Integer         // chunked: 0 size line, 1 data, 2 CRLF after data, 3 trailers
    private framingBytes: Integer  // chunked metadata read so far (32 KiB cap, as for buffered requests)
    private reusable: Boolean
    private deadline: Integer
    private opened: Integer
}
public record Head { status: Integer; reason: Text; headers: List<Text> }

function clientFailure(message: Text): errors.Error { return errors.make(errors.unavailableCode(), 0, message) }

/// Prepare a keep-alive client for an http:// or https:// origin (any path in it is ignored). It connects on the
/// first request. roots replace the OS trust roots for https (empty uses them), as in fetchTrusting.
public function connectTo(origin: Text, roots: List<Bytes>, timeoutMs: Integer): Result<Client, errors.Error> {
    let address = parse(origin)
    if address.host == "" { return Err(clientFailure("invalid http:// or https:// origin: " + origin)) }
    if timeoutMs < 1 || timeoutMs > 300000 { return Err(clientFailure("invalid HTTP timeout")) }
    if roots.length > 4096 { return Err(clientFailure("too many trust roots")) }
    return Ok(Client { address: address; roots: roots; timeoutMs: timeoutMs; socket: -1; session: tls.none(); inbound: Bytes()
        method: ""; streaming: false; framing: 0; remaining: 0; phase: 0; framingBytes: 0; reusable: false; deadline: 0; opened: 0 })
}

/// The number of connections this client has opened; requests beyond it reused one.
public function Client.connections(): Integer { return self.opened }

/// Close the connection. The client stays usable: the next begin connects again.
public function Client.close() { clientDisconnect(self) }

function clientDisconnect(client: Client) {
    if client.socket >= 0 { net.close(client.socket) }
    client.socket = -1
    client.session = tls.none()
    client.inbound = Bytes()
    client.streaming = false
    client.reusable = false
}

function clientConnect(client: Client): Text {
    let connection = net.connect(client.address.host, client.address.port)
    if connection < 0 { return net.lastError() }
    client.socket = connection
    client.opened += 1
    client.inbound = Bytes()
    if !client.address.secure { return "" }
    let session = tls.clientWithTrust(client.address.host, secureRandom.bytes(64), client.roots)
    client.session = session
    let sendError = writeWithin(connection, tls.takeOutgoing(session), client.deadline, "TLS handshake send")
    if sendError != "" { return sendError }
    let handshakeBytes = 0
    while session.state == tls.HELLO_SENT || session.state == tls.HANDSHAKE {
        if !ready(connection, client.deadline) { return "TLS handshake timed out" }
        let chunk = net.receive(connection, 65536)
        if chunk.length == 0 { return "the server closed the connection during the TLS handshake" }
        handshakeBytes += chunk.length
        if handshakeBytes > 1048576 { return "TLS handshake exceeds its size limit" }
        tls.receive(session, chunk)
        let replyError = writeWithin(connection, tls.takeOutgoing(session), client.deadline, "TLS handshake send")
        if replyError != "" { return replyError }
    }
    if !tls.established(session) { return "TLS failed: " + session.error }
    client.inbound.addBytes(tls.takeIncoming(session))
    return ""
}

function clientSend(client: Client, data: Bytes): Text {
    if !client.address.secure { return writeWithin(client.socket, data, client.deadline, "HTTP upload") }
    tls.send(client.session, data)
    if client.session.state == tls.FAILED { return "TLS failed: " + client.session.error }
    return writeWithin(client.socket, tls.takeOutgoing(client.session), client.deadline, "TLS upload")
}

// Receive more response bytes into inbound: "" with new bytes or an orderly end of stream (eof), else an error.
record Fill { error: Text; eof: Boolean; reset: Boolean }
function clientFill(client: Client): Fill {
    while true {
        if !ready(client.socket, client.deadline) { return Fill { error: "download timed out"; eof: false; reset: false } }
        let chunk = net.receive(client.socket, 65536)
        if chunk.length == 0 {
            if net.lastErrorCode() != 0 { return Fill { error: "HTTP receive failed: " + net.lastError(); eof: false; reset: true } }
            if client.address.secure { tls.endInput(client.session) }
            return Fill { error: ""; eof: true; reset: false }
        }
        if !client.address.secure { client.inbound.addBytes(chunk); return Fill { error: ""; eof: false; reset: false } }
        tls.receive(client.session, chunk)
        let plain = tls.takeIncoming(client.session)
        if client.session.state == tls.FAILED { return Fill { error: "TLS failed: " + client.session.error; eof: false; reset: false } }
        // Post-handshake messages (session tickets) carry no application bytes: keep reading.
        if plain.length > 0 { client.inbound.addBytes(plain); return Fill { error: ""; eof: false; reset: false } }
        if client.session.state == tls.CLOSED { return Fill { error: ""; eof: true; reset: false } }
    }
}

function idempotent(method: Text): Boolean {
    return method == "GET" || method == "HEAD" || method == "OPTIONS" || method == "PUT" || method == "DELETE"
}

/// Send a request for `target` (a path such as "/data?x=1") and return the response head. Read the body with
/// read before the next request to keep the connection. Host, Connection, Content-Length and
/// Transfer-Encoding are managed by the client.
public function Client.begin(method: Text, target: Text, headers: List<Text>, body: Bytes): Result<Head, errors.Error> {
    let framingError = requestFramingError(method, headers)
    if framingError != "" { return Err(clientFailure(framingError)) }
    if target.length == 0 || target[0] != '/' { return Err(clientFailure("an HTTP request target starts with /")) }
    for character in target { if Integer(character) <= 32 || Integer(character) == 127 { return Err(clientFailure("invalid HTTP request target")) } }
    if self.streaming { clientDisconnect(self) }
    self.deadline = net.monotonicMilliseconds() + self.timeoutMs
    let lines: List<Text> = [method + " " + target + " HTTP/1.1\r\n", "Host: " + self.address.authority + "\r\n"]
    for header in headers { lines.add(header + "\r\n") }
    if body.length > 0 || method == "POST" || method == "PUT" || method == "PATCH" { lines.add("Content-Length: " + Text(body.length) + "\r\n") }
    lines.add("\r\n")
    let message = Bytes(joinText(lines))
    message.addBytes(body)
    let attempts = 1
    if self.socket >= 0 && idempotent(method) { attempts = 2 }
    for attempt in 0..attempts {
        let reused = self.socket >= 0
        if !reused {
            let connectError = clientConnect(self)
            if connectError != "" { clientDisconnect(self); return Err(clientFailure(connectError)) }
        }
        let sendError = clientSend(self, message)
        if sendError == "" {
            let head = clientHead(self, method)
            if head.error == "" {
                self.method = method
                return Ok(Head { status: head.status; reason: head.reason; headers: head.headers })
            }
            clientDisconnect(self)
            // A kept connection the server had already closed: nothing of the response arrived.
            if !(reused && head.status == -2 && attempt + 1 < attempts) { return Err(clientFailure(head.error)) }
        } else {
            clientDisconnect(self)
            if !(reused && attempt + 1 < attempts) { return Err(clientFailure(sendError)) }
        }
    }
    return Err(clientFailure("the HTTP connection closed"))
}

// Read and validate the response head, skipping informational responses, and set up body framing. An end of
// stream or a reset before any response byte fails with status -2, so begin may retry on a fresh connection.
function clientHead(client: Client, method: Text): ResponseHead {
    let informational = 0
    let scan = 0
    let received = false
    while true {
        let end = headerEnd(client.inbound, scan)
        if end < 0 {
            scan = max(0, client.inbound.length - 3)
            if client.inbound.length > 32768 { return headFailure("HTTP headers exceed 32 KiB") }
            let filled = clientFill(client)
            if filled.error != "" {
                let failure = headFailure(filled.error)
                // A kept connection the server closed while this request was in flight resets the stream.
                if filled.reset && !received && client.inbound.length == 0 { failure.status = -2 }
                return failure
            }
            if filled.eof {
                if !received && client.inbound.length == 0 {
                    let closed = headFailure("the server closed the connection")
                    closed.status = -2
                    return closed
                }
                return headFailure("the server's response was incomplete")
            }
            received = true
            continue
        }
        if end + 4 > 32768 { return headFailure("HTTP headers exceed 32 KiB") }
        let head = parseHead(client.inbound, 0, end)
        if head.error != "" { return head }
        client.inbound = client.inbound.slice(end + 4, client.inbound.length)
        scan = 0
        received = true
        if head.status < 200 {
            if head.status == 101 { return headFailure("HTTP protocol upgrades are unsupported") }
            informational += 1
            if informational > 16 { return headFailure("too many informational HTTP responses") }
            continue
        }
        client.reusable = !head.close
        client.framing = 0
        client.remaining = 0
        client.phase = 0
        client.framingBytes = 0
        let noBody = method == "HEAD" || head.status == 204 || head.status == 304
        if !noBody {
            if head.transfer > 0 {
                if head.length >= 0 { return headFailure("HTTP Transfer-Encoding conflicts with Content-Length") }
                if head.transfer != 1 || head.coding != "chunked" { return headFailure("unsupported HTTP Transfer-Encoding") }
                if !head.http11 { return headFailure("HTTP/1.0 Transfer-Encoding is unsupported") }
                client.framing = 2
            } else if head.length >= 0 {
                if head.status == 205 && head.length > 0 { return headFailure("HTTP 205 responses cannot contain content") }
                if head.length > 0 { client.framing = 1; client.remaining = head.length }
            } else {
                client.framing = 3
                client.reusable = false
            }
        }
        client.streaming = client.framing != 0
        if !client.streaming { clientFinished(client) }
        return head
    }
}

// The response ended: keep the connection only for a reusable response with nothing after it.
function clientFinished(client: Client) {
    client.streaming = false
    client.framing = 0
    if !client.reusable || client.inbound.length > 0 { clientDisconnect(client) }
}

// Take up to count bytes from the front of inbound.
function clientTake(client: Client, count: Integer): Bytes {
    let piece = client.inbound.slice(0, count)
    client.inbound = client.inbound.slice(count, client.inbound.length)
    return piece
}

// The next CRLF-terminated chunk metadata line without its CRLF, or "" with more = true when bytes are missing.
record ChunkMeta { line: Bytes; more: Boolean; error: Text }
function clientLine(client: Client): ChunkMeta {
    let data = client.inbound
    for index in 0..data.length {
        if data[index] == 10 { return ChunkMeta { line: Bytes(); more: false; error: "invalid chunked HTTP line ending" } }
        if data[index] == 13 {
            if index + 1 >= data.length { break }
            if data[index + 1] != 10 { return ChunkMeta { line: Bytes(); more: false; error: "invalid chunked HTTP line ending" } }
            client.framingBytes += index + 2
            if client.framingBytes > 32768 { return ChunkMeta { line: Bytes(); more: false; error: "HTTP framing exceeds 32 KiB" } }
            let line = data.slice(0, index)
            client.inbound = data.slice(index + 2, data.length)
            return ChunkMeta { line: line; more: false; error: "" }
        }
    }
    if client.framingBytes + data.length > 32768 { return ChunkMeta { line: Bytes(); more: false; error: "HTTP framing exceeds 32 KiB" } }
    return ChunkMeta { line: Bytes(); more: true; error: "" }
}

/// The next piece of the response body, at most `limit` bytes; None once the body has ended.
public function Client.read(limit: Integer): Result<Maybe<Bytes>, errors.Error> {
    if limit < 1 { return Err(clientFailure("an HTTP read limit is positive")) }
    if !self.streaming { return Ok(None) }
    self.deadline = net.monotonicMilliseconds() + self.timeoutMs
    while true {
        if self.framing == 1 {
            if self.inbound.length > 0 {
                let piece = clientTake(self, min(limit, min(self.remaining, self.inbound.length)))
                self.remaining -= piece.length
                if self.remaining == 0 { clientFinished(self) }
                return Ok(Some(piece))
            }
        } else if self.framing == 3 {
            if self.inbound.length > 0 { return Ok(Some(clientTake(self, min(limit, self.inbound.length)))) }
        } else if self.framing == 2 {
            if self.phase == 1 {
                if self.inbound.length > 0 {
                    let piece = clientTake(self, min(limit, min(self.remaining, self.inbound.length)))
                    self.remaining -= piece.length
                    if self.remaining == 0 { self.phase = 2 }
                    return Ok(Some(piece))
                }
            } else if self.phase == 2 {
                if self.inbound.length >= 2 {
                    if self.inbound[0] != 13 || self.inbound[1] != 10 { clientDisconnect(self); return Err(clientFailure("invalid HTTP chunk data ending")) }
                    self.inbound = self.inbound.slice(2, self.inbound.length)
                    self.framingBytes += 2
                    self.phase = 0
                    continue
                }
            } else {
                let meta = clientLine(self)
                if meta.error != "" { clientDisconnect(self); return Err(clientFailure(meta.error)) }
                if !meta.more {
                    if self.phase == 3 {
                        if meta.line.length == 0 { clientFinished(self); return Ok(None) }
                        if !validTrailer(meta.line) { clientDisconnect(self); return Err(clientFailure("invalid chunked HTTP trailer")) }
                        continue
                    }
                    let size = chunkSize(meta.line)
                    if size < 0 { clientDisconnect(self); return Err(clientFailure("invalid HTTP chunk size or extension")) }
                    if size == 0 { self.phase = 3 } else { self.phase = 1; self.remaining = size }
                    continue
                }
            }
        } else {
            return Ok(None)
        }
        let filled = clientFill(self)
        if filled.error != "" { clientDisconnect(self); return Err(clientFailure(filled.error)) }
        if filled.eof {
            if self.framing == 3 { clientDisconnect(self); return Ok(None) }
            clientDisconnect(self)
            if self.framing == 1 { return Err(clientFailure("HTTP body is shorter than its Content-Length")) }
            return Err(clientFailure("the chunked HTTP body was incomplete"))
        }
    }
}

/// The rest of the response body as one Bytes, failing beyond `limit` bytes.
public function Client.readAll(limit: Integer): Result<Bytes, errors.Error> {
    let body = Bytes()
    while true {
        match self.read(65536) {
            Ok(Some(piece)) {
                if piece.length > limit - body.length { clientDisconnect(self); return Err(clientFailure("download exceeds its size limit")) }
                body.addBytes(piece)
            }
            Ok(None) { return Ok(body) }
            Err(problem) { return Err(problem) }
        }
    }
}
