// Signed decimal ASCII parsing, with surrounding ASCII whitespace and full
// consumption. Invalid UTF-8, syntax and signed-64 overflow are invalidData.
use "errors" as errors

// Decode untrusted bytes without ever constructing invalid Text.
/// Turn UTF-8 bytes into Text, or return an invalid-data error.
/// The input Bytes stay unchanged. No invalid Text is constructed.
///
/// ```minyar
/// match api.decode(Bytes("Héllo, sea.")) {
///     Ok(words) { print(words) }
///     Err(error) { fail("the greeting was not UTF-8") }
/// }
/// ```
/// ```output
/// Héllo, sea.
/// ```
public function decode(source: Bytes): Result<Text, errors.Error> {
    if !validUTF8(source) {
        return Err(errors.make(errors.invalidDataCode(), 0, "invalid UTF-8 text input"))
    }
    return Ok(Text(source))
}

/// Read one signed decimal Integer, allowing surrounding ASCII whitespace.
/// The whole input must be a number within the signed 64-bit range. The result
/// keeps a recoverable invalid-data error when the text cannot be read.
///
/// ```minyar
/// use "errors" as errors
/// let reading = api.parseInteger(" +42 ")
/// if errors.integerOk(reading) { print(errors.integerValue(reading)) }
/// ```
/// ```output
/// 42
/// ```
public function parseInteger(source: Text): errors.IntegerResult {
    return parseIntegerBytes(Bytes(source))
}

// Deprecated compatibility shim. Prefer integerBytes and match/try/methods.
/// Read a signed decimal Integer directly from UTF-8 Bytes.
/// It follows `parseInteger`'s whitespace, full-input and overflow rules.
public function parseIntegerBytes(source: Bytes): errors.IntegerResult {
    match integerBytes(source) {
        Ok(value) { return errors.integer(value) }
        Err(error) { return errors.integerFailure(error) }
    }
}

public function integer(source: Text): Result<Integer, errors.Error> {
    return integerBytes(Bytes(source))
}

function invalidInteger(message: Text): Result<Integer, errors.Error> {
    return Err(errors.make(errors.invalidDataCode(), 0, message))
}
function asciiSpace(byte: Integer): Boolean {
    return byte == 32 || (byte >= 9 && byte <= 13)
}
/// Read a signed decimal Integer from UTF-8 Bytes as a Result.
/// It follows `integer`'s whitespace, full-input and overflow rules.
public function integerBytes(source: Bytes): Result<Integer, errors.Error> {
    if !validUTF8(source) { return invalidInteger("invalid UTF-8 integer input") }
    let start = 0
    let end = source.length
    while start < end && asciiSpace(source[start]) { start += 1 }
    while end > start && asciiSpace(source[end - 1]) { end -= 1 }
    let negative = start < end && source[start] == 45
    if start < end && (source[start] == 45 || source[start] == 43) { start += 1 }
    if start == end { return invalidInteger("expected a signed decimal ASCII integer") }
    // Accumulate negatively, so the minimum signed value never needs negation.
    let limit = -9223372036854775807
    if negative { limit = -9223372036854775808 }
    let value = 0
    for index in start..end {
        let byte = source[index]
        if byte < 48 || byte > 57 { return invalidInteger("expected a signed decimal ASCII integer") }
        let digit = byte - 48
        if value < limit / 10 { return invalidInteger("integer is outside the signed 64-bit range") }
        value *= 10
        if value < limit + digit { return invalidInteger("integer is outside the signed 64-bit range") }
        value -= digit
    }
    if !negative { value = -value }
    return Ok(value)
}

// Positions count Unicode scalar values, including for an empty needle.
public function find(source: Text, needle: Text): Maybe<Integer> {
    let position = source.find(needle)
    if position < 0 { return None }
    return Some(position)
}

public function characterAt(source: Text, position: Integer): Maybe<Character> {
    if position < 0 || position >= source.length { return None }
    return Some(source[position])
}

public function slice(source: Text, first: Integer, after: Integer): Maybe<Text> {
    if first < 0 || after < first || after > source.length { return None }
    return Some(source.slice(first, after))
}

// Check the original byte buffer before any Text conversion or scalar access.
/// Check whether every byte belongs to a valid UTF-8 encoding.
/// This accepts empty input and embedded zero bytes, and rejects incomplete,
/// overlong, surrogate and out-of-range sequences.
public function validUTF8(source: Bytes): Boolean {
    let position = 0
    while position < source.length {
        let first = source[position]
        if first < 128 {
            position += 1
        } else {
            let count = 0
            let lower = 128
            let upper = 191
            if first >= 194 && first <= 223 { count = 2 }
            if first >= 224 && first <= 239 {
                count = 3
                if first == 224 { lower = 160 }
                if first == 237 { upper = 159 }
            }
            if first >= 240 && first <= 244 {
                count = 4
                if first == 240 { lower = 144 }
                if first == 244 { upper = 143 }
            }
            if count == 0 || count > source.length - position { return false }
            let second = source[position + 1]
            if second < lower || second > upper { return false }
            for index in 2..count {
                let continuation = source[position + index]
                if continuation < 128 || continuation > 191 { return false }
            }
            position += count
        }
    }
    return true
}
