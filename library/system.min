// Process-level services: real time, process identity and memory, and shutdown signals as socket readiness.
//
// Minyar has no signal handlers or closures, so shutdown signals are delivered the event-loop way:
// shutdownSignalSocket() installs SIGTERM/SIGINT handlers (and ignores SIGPIPE) and returns a socket that becomes
// readable when a signal arrives. Watch it with `eventloop`, call drainShutdownSignals(), then shut down in order.

public function wallClockMicroseconds(): Integer { native "system" }   // since the Unix epoch (CLOCK_REALTIME)
public function monotonicNanoseconds(): Integer { native "system" }    // CLOCK_MONOTONIC
public function processId(): Integer { native "system" }
public function residentBytes(): Integer { native "system" }           // current RSS, or -errno

// Writes to a closed socket then return -32 (EPIPE) instead of terminating the process. Servers should call this
// at startup.
public function ignoreBrokenPipes(): Integer { native "system" }
public function shutdownSignalSocket(): Integer { native "system" }
// Its socket is process-owned and borrowed: remove watches when done; never close it through files/net.
public function drainShutdownSignals(): Integer { native "system" }   // last signal number (15, 2) or 0
// Native PID selectors are supported (0 = current process group; negative = OS group/broadcast selector).
// PID and signal Integers must fit the native types exactly, otherwise -EINVAL is returned before the syscall.
public function sendSignal(processId: Integer, signal: Integer): Integer { native "system" }
// Unbuffered write to standard error; returns the byte count or -errno.
public function writeStandardError(text: Text): Integer { native "system" }
// Raise the soft open-file (descriptor) limit to the hard limit; returns the new soft limit or -errno.
public function raiseOpenFileLimit(): Integer { native "system" }

// Copied UTF-8 values. Missing getenv returns empty Text with lastError() == -ENOENT;
// a present empty value returns empty Text with lastError() == 0. Empty names, '='
// in a name, and embedded NUL are -EINVAL. Serialize external environment mutation.
public function getenv(name: Text): Text { native "system" }
public function lastError(): Integer { native "system" } // thread-local -errno
function environmentEntries(): Bytes { native "system" }
public function environment(): List<Text> {
    let raw = environmentEntries()
    let entries: List<Text> = []
    let start = 0
    for index in 0..raw.length {
        if raw[index] == 0 {
            entries.add(Text(raw.slice(start, index)))
            start = index + 1
        }
    }
    return entries
}

// Stable package identifiers, never native RLIMIT_* numbers. Limits are bytes
// except OPEN_FILES (descriptors) and CPU_TIME (seconds). INFINITE represents
// unlimited; finite limits that do not fit Integer return -EOVERFLOW.
public constant OPEN_FILES = 0
public constant CORE_SIZE = 1
public constant CPU_TIME = 2
public constant DATA_SIZE = 3
public constant STACK_SIZE = 4
public constant ADDRESS_SPACE = 5
public constant INFINITE = 9223372036854775807
public function getSoftLimit(resource: Integer): Integer { native "system" }
public function getHardLimit(resource: Integer): Integer { native "system" }
// Set both limits, including lowering them. Raising a hard limit may require
// privilege; OS errors are returned unchanged. Negative limits / soft > hard
// are -EINVAL. An unavailable resource is -ENOTSUP; an unknown ID is -EINVAL.
public function setResourceLimit(resource: Integer, soft: Integer, hard: Integer): Integer { native "system" }

// Windows supports clocks, identity, memory, environment and raw stderr. POSIX
// signal socket/ignore/drain and resource-limit operations return -ENOTSUP.
// sendSignal(pid, 0) checks a positive PID; other Windows signals are -ENOTSUP.
