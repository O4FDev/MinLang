// Process-level services: real time, process identity and memory, and shutdown signals as socket readiness.
//
// Minyar has no signal handlers or closures, so shutdown signals are delivered the event-loop way:
// shutdownSignalSocket() installs SIGTERM/SIGINT handlers (and ignores SIGPIPE) and returns a socket that becomes
// readable when a signal arrives. Watch it with `eventloop`, call drainShutdownSignals(), then shut down in order.

public function wallClockMicroseconds(): Integer { native "system" }   // since the Unix epoch (CLOCK_REALTIME)
public function monotonicNanoseconds(): Integer { native "system" }    // CLOCK_MONOTONIC
public function processId(): Integer { native "system" }
public function residentBytes(): Integer { native "system" }           // current RSS, or -errno

// Writes to a closed socket then return -32 (EPIPE) instead of terminating the process. Servers should call this
// at startup.
public function ignoreBrokenPipes(): Integer { native "system" }
public function shutdownSignalSocket(): Integer { native "system" }
// Its socket is process-owned and borrowed: remove watches when done; never close it through files/net.
public function drainShutdownSignals(): Integer { native "system" }   // last signal number (15, 2) or 0
// Native PID selectors are supported (0 = current process group; negative = OS group/broadcast selector).
// PID and signal Integers must fit the native types exactly, otherwise -EINVAL is returned before the syscall.
public function sendSignal(processId: Integer, signal: Integer): Integer { native "system" }
// Unbuffered write to standard error; returns the byte count or -errno.
public function writeStandardError(text: Text): Integer { native "system" }
// Raise the soft open-file (descriptor) limit to the hard limit; returns the new soft limit or -errno.
public function raiseOpenFileLimit(): Integer { native "system" }

// Copied UTF-8 values. Missing getenv returns empty Text with lastError() == -ENOENT;
// a present empty value returns empty Text with lastError() == 0. Empty names, '='
// in a name, and embedded NUL are -EINVAL. Serialize external environment mutation.
public function getenv(name: Text): Text { native "system" }
public function lastError(): Integer { native "system" } // thread-local -errno
function environmentEntries(): Bytes { native "system" }
public function environment(): List<Text> {
    let raw = environmentEntries()
    let entries: List<Text> = []
    let start = 0
    for index in 0..raw.length {
        if raw[index] == 0 {
            entries.add(Text(raw.slice(start, index)))
            start = index + 1
        }
    }
    return entries
}

// Stable package identifiers, never native RLIMIT_* numbers. Limits are bytes
// except OPEN_FILES (descriptors) and CPU_TIME (seconds). INFINITE represents
// unlimited; finite limits that do not fit Integer return -EOVERFLOW.
public constant OPEN_FILES = 0
public constant CORE_SIZE = 1
public constant CPU_TIME = 2
public constant DATA_SIZE = 3
public constant STACK_SIZE = 4
public constant ADDRESS_SPACE = 5
public constant INFINITE = 9223372036854775807
public function getSoftLimit(resource: Integer): Integer { native "system" }
public function getHardLimit(resource: Integer): Integer { native "system" }
// Set both limits, including lowering them. Raising a hard limit may require
// privilege; OS errors are returned unchanged. Negative limits / soft > hard
// are -EINVAL. An unavailable resource is -ENOTSUP; an unknown ID is -EINVAL.
public function setResourceLimit(resource: Integer, soft: Integer, hard: Integer): Integer { native "system" }

// Windows supports clocks, identity, memory, environment and raw stderr. POSIX
// signal socket/ignore/drain and resource-limit operations return -ENOTSUP.
// sendSignal(pid, 0) checks a positive PID; other Windows signals are -ENOTSUP.

// Launch an executable directly, without a shell or PATH lookup. argv contains
// argv[0] and at least one element; envp is the complete NAME=value environment
// (empty means no environment). Empty cwd inherits the parent's directory; a
// relative executable is resolved in the child's cwd. Texts must contain no NUL.
// Returns an owned opaque handle > 0, or synchronous -errno for setup/exec failure.
// Parent signal dispositions/mask/cwd/credentials are preserved. The child has
// default, unblocked SIGPIPE, retaining the parent's other signal-mask bits.
// POSIX non-CLOEXEC descriptors inherit; Windows only inheritable std handles do.
// Serialize all process-handle operations; do not reap these PIDs through raw wait.
public function spawn(path: Text, argv: List<Text>, envp: List<Text>, cwd: Text): Integer {
    return spawnNative(path, encodeProcessVector(argv), encodeProcessVector(envp), cwd, -1, -1, Bytes(), false)
}
public function spawnSession(path: Text, argv: List<Text>, envp: List<Text>, cwd: Text): Integer {
    return spawnSessionNative(path, encodeProcessVector(argv), encodeProcessVector(envp), cwd)
}
// uid/gid -1 inherit; otherwise set real/effective/saved IDs. The supplementary
// groups are explicit: [] clears them. Linux uses a separate native clone-vfork
// stack; macOS 10.15+ uses dynamically discovered credential spawn SPI (requires
// root; missing SPI returns -ENOTSUP). Neither runs managed code in a child.
// Windows credentials are -ENOTSUP. Native privilege errors (e.g. -EPERM) remain
// visible. Explicit macOS groups disable external memberd group expansion.
// Linux native builds require compiler support for complete child instrumentation
// exclusion; missing attributes fail compilation rather than enabling unsafe hooks.
public function spawnWithCredentials(path: Text, argv: List<Text>, envp: List<Text>, cwd: Text,
    uid: Integer, gid: Integer, groups: List<Integer>): Integer {
    if groups.length > 65536 { return -22 }
    let encoded = Bytes(groups.length * 8)
    for index in 0..groups.length { encoded.setInt64(index * 8, groups[index]) }
    return spawnNative(path, encodeProcessVector(argv), encodeProcessVector(envp), cwd, uid, gid, encoded, true)
}
function encodeProcessVector(items: List<Text>): Bytes {
    let encoded = Bytes(8)
    encoded.setInt64(0, items.length)
    for item in items {
        let bytes = Bytes(item)
        let length = Bytes(8)
        length.setInt64(0, bytes.length)
        encoded.addBytes(length)
        encoded.addBytes(bytes)
    }
    return encoded
}
function spawnNative(path: Text, argv: Bytes, envp: Bytes, cwd: Text, uid: Integer,
    gid: Integer, groups: Bytes, credentials: Boolean): Integer { native "system" }
function spawnSessionNative(path: Text, argv: Bytes, envp: Bytes, cwd: Text): Integer { native "system" }
public function childProcessId(handle: Integer): Integer { native "system" } // -ECHILD after wait
public constant PENDING = 0
public constant EXITED = 1
public constant SIGNALED = 2
public constant WAIT_ERROR = 3
public record ProcessStatus { state: Integer; exitCode: Integer; signal: Integer; error: Integer }
// wait blocks; poll never blocks. A terminal result consumes the owned handle,
// including Windows kernel handles. Repeated/invalid waits return -ECHILD in
// error. Windows exits (including exception DWORD codes) are EXITED, never POSIX
// SIGNALED. Child exit 127 is distinct from synchronous launch failure.
public function wait(handle: Integer): ProcessStatus { return decodeProcessStatus(waitNative(handle, false)) }
public function poll(handle: Integer): ProcessStatus { return decodeProcessStatus(waitNative(handle, true)) }
function waitNative(handle: Integer, poll: Boolean): Bytes { native "system" }
function decodeProcessStatus(raw: Bytes): ProcessStatus {
    return ProcessStatus { error: raw.getInt64(0); state: raw.getInt64(8);
        exitCode: raw.getInt64(16); signal: raw.getInt64(24) }
}
// Windows argv follows C runtime quoting; argv[0] cannot contain a quote. Windows
// duplicate environment names (case-insensitive) and drive-relative C:foo paths
// are -EINVAL. Packed argv/env vectors are limited to 16 MiB / 65536 elements;
// the OS may enforce lower limits (-E2BIG). No automatic child termination on
// parent exit; wait every successful handle to avoid retained handles/zombies.

public function releaseFreeMemory(): Integer { native "system" }
