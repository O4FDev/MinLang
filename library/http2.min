    }
    if type == 5 { return connectionFailure(server, 1, "client PUSH_PROMISE prohibited") }
    if type == 1 {
        if id == 0 || id % 2 == 0 { return connectionFailure(server, 1, "invalid client HEADERS stream ID") }
        let begin = 0; let end = body.length
        if (flags & 8) != 0 { if body.length == 0 || body[0] >= body.length { return connectionFailure(server, 1, "invalid HEADERS padding") }; begin = 1; end = body.length - body[0] }
        if (flags & 32) != 0 {
            if end - begin < 5 { return connectionFailure(server, 6, "invalid HEADERS priority") }
            if (get32(body, begin) & 2147483647) == id { return connectionFailure(server, 1, "self-dependent HEADERS") }; begin = begin + 5
