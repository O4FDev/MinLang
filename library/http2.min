}
public function write(server: Server, id: Integer, bytes: Bytes): errors.BooleanResult {
    if errors.isError(server.error) { return errors.booleanFailure(server.error) }
    let at = position(server, id); if at < 0 { return failure(errors.closedCode(), "unknown HTTP/2 stream") }
    let stream = server.streams[at]; if errors.isError(stream.error) { return errors.booleanFailure(stream.error) }
    if !stream.response || stream.sendEnded || stream.ending { return failure(errors.protocolCode(), "HTTP/2 stream is not writable") }
    if bytes.length > 65545 { return failure(errors.invalidDataCode(), "HTTP/2 write exceeds bounded chunk") }
