public function closeStream(server: Server, id: Integer, trailers: List<Header>): errors.BooleanResult {
    if errors.isError(server.error) { return errors.booleanFailure(server.error) }
    let at = position(server, id); if at < 0 { return failure(errors.closedCode(), "unknown HTTP/2 stream") }
    let stream = server.streams[at]; if errors.isError(stream.error) { return errors.booleanFailure(stream.error) }
    if !stream.response || stream.sendEnded || stream.ending { return failure(errors.protocolCode(), "HTTP/2 stream already ended") }
    if !validResponse(trailers, true) || compress(trailers).length > HEADERS_LIMIT { return failure(errors.invalidDataCode(), "invalid outgoing trailers") }
