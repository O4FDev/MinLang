// Native bounded HTTP/2 server. RFC 9113 and HPACK RFC 7541; no sockets.
use "errors" as errors
public record Header { name: Text; value: Text }
record Entry { name: Bytes; value: Bytes }
record Node { zero: Integer; one: Integer; symbol: Integer }
record HPack { table: List<Entry>; size: Integer; limit: Integer; nodes: List<Node>; bad: Boolean; invalidField: Boolean }
record Cursor { bytes: Bytes; at: Integer; bad: Boolean }
record Stream {
    id: Integer; fields: List<Header>; incoming: Bytes; pending: Bytes
    recvWindow: Integer; sendWindow: Integer; recvEnded: Boolean; sendEnded: Boolean
