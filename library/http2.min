public function receive(server: Server, bytes: Bytes): errors.BooleanResult {
    if errors.isError(server.error) { return errors.booleanFailure(server.error) }
    if server.ended { return failure(errors.closedCode(), "HTTP/2 input already ended") }
    if bytes.length > LIMIT - server.input.length { return failure(errors.wouldBlockCode(), "HTTP/2 input buffer full") }
    server.input.addBytes(bytes)
    if !server.preface {
        let expected = Bytes("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")
        for i in 0..min(expected.length, server.input.length) { if server.input[i] != expected[i] { return connectionFailure(server, 1, "invalid HTTP/2 preface") } }
        if server.input.length < expected.length { return errors.boolean(true) }
        server.input = server.input.slice(expected.length, server.input.length); server.preface = true
    }
    while server.input.length >= 9 {
        let input = server.input; let size = (input[0] << 16) | (input[1] << 8) | input[2]
        if size > 16384 { return connectionFailure(server, 6, "incoming HTTP/2 frame exceeds advertised maximum") }
