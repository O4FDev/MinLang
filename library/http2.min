    let at = position(server, id); if at < 0 { return failure(errors.closedCode(), "unknown HTTP/2 stream") }
    let stream = server.streams[at]; if errors.isError(stream.error) { return errors.booleanFailure(stream.error) }
    if stream.response || stream.sendEnded { return failure(errors.protocolCode(), "HTTP/2 response already started") }
    if !validResponse(fields, false) { return failure(errors.invalidDataCode(), "invalid outgoing response headers") }
    let bytes = compress(fields); if bytes.length > HEADERS_LIMIT { return failure(errors.invalidDataCode(), "outgoing headers too large") }
