        let bytes = Bytes(field.name)
        if bytes.length == 0 { return false }
        for i in 0..bytes.length {
            let c = bytes[i]
            if !(c == 58 && i == 0) && !nameByte(c) { return false }
        }
        let value = Bytes(field.value)
        if value.length > 0 && (value[0] == 32 || value[0] == 9 || value[value.length - 1] == 32 || value[value.length - 1] == 9) { return false }
        for c in value { if c == 0 || c == 10 || c == 13 { return false } }
        if bytes[0] == 58 {
            if trailers || regular { return false }
            for old in pseudo { if old == field.name { return false } }; pseudo.add(field.name)
            if field.name == ":method" { hasMethod = field.value != "" }
            else if field.name == ":scheme" { hasScheme = field.value == "https" || field.value == "http" }
            else if field.name == ":path" { hasPath = field.value != "" }
