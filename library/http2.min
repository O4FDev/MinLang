public function bufferedInput(server: Server): Integer { return server.input.length }
public function bufferedOutput(server: Server): Integer { return server.output.length + server.pendingBytes }
// Call with a monotonic millisecond sample immediately after create.
public function tick(server: Server, nowMillis: Integer): errors.BooleanResult {
