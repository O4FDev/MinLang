    return Server { error: errors.none(); input: Bytes(); output: frame(4, 0, 0, settings); preface: false; firstSettings: false; ack: false
        hpack: HPack { table: []; size: 0; limit: 4096; nodes: trie(); bad: false; invalidField: false }; streams: []; ready: []; lastID: 0
        continuation: 0; block: Bytes(); blockEnd: false; recvWindow: 65535; sendWindow: 65535; initialSend: 65535
