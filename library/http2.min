}
function fieldValue(fields: List<Header>, name: Text): Text { for field in fields { if field.name == name { return field.value } }; return "" }
public function headerValue(fields: List<Header>, name: Text): Text { return fieldValue(fields, name) }
function nameByte(byte: Integer): Boolean {
    if (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) { return true }
    return byte == 33 || byte == 35 || byte == 36 || byte == 37 || byte == 38 || byte == 39 || byte == 42 || byte == 43 || byte == 45 || byte == 46 || byte == 94 || byte == 95 || byte == 96 || byte == 124 || byte == 126
}
function validFields(fields: List<Header>, trailers: Boolean): Boolean {
    let regular = false; let pseudo: List<Text> = []; let hasMethod = false; let hasScheme = false; let hasPath = false
