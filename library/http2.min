function staticValues(): List<Text> { return ["", "GET", "POST", "/", "/index.html", "http", "https", "200", "204", "206", "304", "400", "404", "500", "", "gzip, deflate", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""] }
function problem(code: Integer, native: Integer, message: Text): errors.Error { return errors.make(code, native, message) }
function failure(code: Integer, message: Text): errors.BooleanResult { return errors.booleanFailure(problem(code, 0, message)) }
function get32(bytes: Bytes, at: Integer): Integer { return (bytes[at] << 24) | (bytes[at + 1] << 16) | (bytes[at + 2] << 8) | bytes[at + 3] }
function add32(bytes: Bytes, value: Integer) { for i in 0..4 { bytes.add((value >> ((3 - i) * 8)) & 255) } }
function frame(type: Integer, flags: Integer, id: Integer, body: Bytes): Bytes {
