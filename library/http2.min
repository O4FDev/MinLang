        for i in 0..name.length { if !(name[i] == 58 && i == 0) && !nameByte(name[i]) { return false } }
        let value = Bytes(field.value)
        if value.length > 0 && (value[0] == 32 || value[0] == 9 || value[value.length - 1] == 32 || value[value.length - 1] == 9) { return false }
        for byte in value { if byte != 9 && (byte < 32 || byte > 126) { return false } }
