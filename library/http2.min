public function requestOk(value: RequestResult): Boolean { return !errors.isError(value.error) }
public function requestError(value: RequestResult): errors.Error { return value.error }
function requireRequest(value: RequestResult) { if !requestOk(value) { fail("cannot read rejected HTTP/2 request") } }
public function streamID(value: RequestResult): Integer { requireRequest(value); return value.id }
public function headers(value: RequestResult): List<Header> { requireRequest(value); return value.fields }
public function endStream(value: RequestResult): Boolean { requireRequest(value); return value.end }
