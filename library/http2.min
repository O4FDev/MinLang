            let size = integer(cursor, 5); if cursor.bad || size > 4096 { pack.bad = true; return [] }; pack.limit = size; trim(pack)
        } else {
            started = true; let field = Entry { name: Bytes(); value: Bytes() }; let store = false
            if (first & 128) != 0 {
                let index = integer(cursor, 7); if index < 1 || index > 61 + pack.table.length { pack.bad = true; return [] }; field = indexed(pack, index)
            }
