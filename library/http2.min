    return nodes
}
function integer(cursor: Cursor, bits: Integer): Integer {
    if cursor.at >= cursor.bytes.length { cursor.bad = true; return 0 }
    let mask = (1 << bits) - 1; let value = cursor.bytes[cursor.at] & mask; cursor.at = cursor.at + 1
    if value != mask { return value }
