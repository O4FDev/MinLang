    let at = position(server, id); if at < 0 { return errors.bytesFailure(problem(errors.closedCode(), 0, "unknown HTTP/2 stream")) }
    let stream = server.streams[at]; if errors.isError(stream.error) { return errors.bytesFailure(stream.error) }
    if stream.incoming.length == 0 { if stream.recvEnded { return errors.endOfStream() }; return errors.wouldBlock(0) }
    if 26 > LIMIT - server.output.length - server.pendingBytes { return errors.wouldBlock(0) }
    let end = min(maximum, stream.incoming.length); let bytes = stream.incoming.slice(0, end)
    stream.incoming = stream.incoming.slice(end, stream.incoming.length)
    let updated = windowUpdate(server, id, end); if !errors.booleanOk(updated) { return errors.bytesFailure(errors.booleanError(updated)) }
