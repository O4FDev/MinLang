// Connect protocol (connectrpc.com) server and client over the rpc handler API.
// No sockets: Server.handle turns one HTTP request into one HTTP response
// (Server.open and Exchange.step for answers that come later, Server.begin
// for request bodies that arrive in pieces, as over HTTP/2), and
// Client.unary sends through a caller-supplied transport, so the same code runs
// behind httpserver (library/connecthttp.min) and inside simulation tests.
// Unary calls use application/proto or application/json bodies over POST, or
// GET for NO_SIDE_EFFECTS methods. Errors are Connect JSON with details.
// Server, client and bidirectional streams use enveloped messages; over
// HTTP/1.1 a client or bidirectional stream is half-duplex.
use "rpc" as rpc
use "errors" as errors
use "json" as json
use "text" as utf8

/// An HTTP request as a transport received it. `target` is the path with
/// any query; header names are lowercase.
public record Request { method: Text; target: Text; headers: List<rpc.Header>; body: Bytes }
public record Response { status: Integer; headers: List<rpc.Header>; body: Bytes }

/// A Content-Encoding the server or client accepts, such as gzip.
/// `decompress` must refuse output longer than its limit with an
/// errors.overflowCode() error, which a server reports as RESOURCE_EXHAUSTED.
public record Compressor {
    name: Text
    compress: (Bytes) -> Result<Bytes, errors.Error>
    decompress: (Bytes, Integer) -> Result<Bytes, errors.Error>
}

/// Cross-origin access for browser clients such as connect-web. Origins are
/// exact ("https://app.example") or "*". Add application headers, such as
/// "authorization", to `allowedHeaders` and readable response headers to
/// `exposedHeaders`. `allowCredentials` applies to the origins listed by
/// name; an origin admitted only by "*" never gets credentials.
public record Cors {
    allowedOrigins: List<Text>
    allowedHeaders: List<Text>
    exposedHeaders: List<Text>
    allowCredentials: Boolean
    maxAgeSeconds: Integer
}
public function noCors(): Cors {
    return Cors { allowedOrigins: []; allowedHeaders: []; exposedHeaders: []; allowCredentials: false; maxAgeSeconds: 7200 }
}

public record Options {
    // Milliseconds on any monotonic clock; deadlines and the replay cache use it.
    clock: () -> Integer
    maxRequestBytes: Integer
    maxResponseBytes: Integer
    // Reject requests without Connect-Protocol-Version: 1 (or connect=v1 on GET).
    requireProtocolVersion: Boolean
    cors: Cors
    compressors: List<Compressor>
    // Responses at least this long are compressed when the client accepts it.
    compressMinBytes: Integer
    // Completed unary results kept for retried calls with an Idempotency-Key.
    idempotencyEntries: Integer
    idempotencyMilliseconds: Integer
    // Response bytes an open stream may queue before Responder.send says wait.
    maxStreamBufferBytes: Integer
    // Sees each request as the server starts it, before its handler: for
    // logging or for what handlers cannot see, such as the query.
    observe: (Request) -> Nothing
}
public function defaults(clock: () -> Integer): Options {
    return Options { clock: clock; maxRequestBytes: 4194304; maxResponseBytes: 16777216; requireProtocolVersion: false;
        cors: noCors(); compressors: []; compressMinBytes: 1024; idempotencyEntries: 4096; idempotencyMilliseconds: 86400000;
        maxStreamBufferBytes: 1048576; observe: function(request: Request) {} }
}

record Replay { key: Text; fingerprint: Integer; stored: Integer; response: Response }
public record Server {
    private services: rpc.Services
    private options: Options
    private replays: List<Replay>
    private replayNext: Integer
    private replayIndex: Map<Text, Integer>
    // Keys of deferred calls still running; a retry meanwhile is ABORTED.
    private running: Set<Text>
    private executed: Integer
    private replayed: Integer
}
public function server(services: rpc.Services, options: Options): Server {
    let index: Map<Text, Integer> = Map()
    let running: Set<Text> = Set()
    return Server { services: services; options: options; replays: []; replayNext: 0; replayIndex: index; running: running;
        executed: 0; replayed: 0 }
}
// Handler runs started, and responses served again for a retried key.
public function Server.executed(): Integer { return self.executed }
public function Server.replayed(): Integer { return self.replayed }

// ---- Connect error and status mapping

public function httpStatus(code: Integer): Integer {
    if code == rpc.CANCELED { return 499 }
    if code == rpc.INVALID_ARGUMENT || code == rpc.FAILED_PRECONDITION || code == rpc.OUT_OF_RANGE { return 400 }
    if code == rpc.DEADLINE_EXCEEDED { return 504 }
    if code == rpc.NOT_FOUND { return 404 }
    if code == rpc.ALREADY_EXISTS || code == rpc.ABORTED { return 409 }
    if code == rpc.PERMISSION_DENIED { return 403 }
    if code == rpc.RESOURCE_EXHAUSTED { return 429 }
    if code == rpc.UNIMPLEMENTED { return 501 }
    if code == rpc.UNAVAILABLE { return 503 }
    if code == rpc.UNAUTHENTICATED { return 401 }
    return 500
}
// The code a client infers from an HTTP status without a Connect error body.
public function codeForStatus(status: Integer): Integer {
    if status == 400 { return rpc.INTERNAL }
    if status == 401 { return rpc.UNAUTHENTICATED }
    if status == 403 { return rpc.PERMISSION_DENIED }
    if status == 404 { return rpc.UNIMPLEMENTED }
    if status == 429 || status == 502 || status == 503 || status == 504 { return rpc.UNAVAILABLE }
    return rpc.UNKNOWN
}

constant HEX = "0123456789abcdef"
function quoted(value: Text, out: Bytes) {
    out.add(34)
    for byte in Bytes(value) {
        if byte == 34 || byte == 92 { out.add(92); out.add(byte) }
        else if byte == 10 { out.addBytes(Bytes("\\n")) }
        else if byte == 13 { out.addBytes(Bytes("\\r")) }
        else if byte == 9 { out.addBytes(Bytes("\\t")) }
        else if byte < 32 || byte == 127 {
            out.addBytes(Bytes("\\u00"))
            out.add(Bytes(HEX)[byte >> 4])
            out.add(Bytes(HEX)[byte & 15])
        } else { out.add(byte) }
    }
    out.add(34)
}
/// The Connect JSON body for an error.
public function errorJson(error: rpc.Error): Bytes {
    let out = Bytes("{\"code\":")
    quoted(rpc.codeName(error.code), out)
    if error.message != "" {
        out.addBytes(Bytes(",\"message\":"))
        quoted(error.message, out)
    }
    if error.details.length > 0 {
        out.addBytes(Bytes(",\"details\":["))
        for index in 0..error.details.length {
            if index > 0 { out.add(44) }
            out.addBytes(Bytes("{\"type\":"))
            quoted(error.details[index].type, out)
            out.addBytes(Bytes(",\"value\":\""))
            out.addBytes(Bytes(base64(error.details[index].value, false).replace("=", "")))
            out.addBytes(Bytes("\"}"))
        }
        out.add(93)
    }
    out.add(125)
    return out
}
// Reads a Connect JSON error body, or None when it is not one.
public function parseErrorJson(body: Bytes): Maybe<rpc.Error> {
    match json.decodeBytes(body, body.length + 1) {
        Ok(value) { return errorValue(value) }
        Err(_) { return None }
    }
}
function errorValue(value: json.Value): Maybe<rpc.Error> {
    if value.kind != json.OBJECT { return None }
    let code = rpc.codeFromName(textMember(value, "code"))
    if code < 0 { return None }
    let error = rpc.failure(code, textMember(value, "message"))
    if value.hasMember("details") {
        let details = value.member("details")
        if details.kind == json.ARRAY {
            for item in details.items {
                if item.kind != json.OBJECT { continue }
                match unbase64(textMember(item, "value")) {
                    Some(data) { error.details.add(rpc.Detail { type: textMember(item, "type"); value: data }) }
                    None {}
                }
            }
        }
    }
    return Some(error)
}
function textMember(value: json.Value, name: Text): Text {
    if !value.hasMember(name) { return "" }
    let member = value.member(name)
    if member.kind != json.STRING { return "" }
    return member.text
}

// ---- Base64 (standard and URL alphabets; decoding accepts both, padded or not)

constant STANDARD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
constant URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
public function base64(data: Bytes, url: Boolean): Text {
    let alphabet = Bytes(STANDARD)
    if url { alphabet = Bytes(URL) }
    let out = Bytes()
    let at = 0
    while at + 3 <= data.length {
        let word = (data[at] << 16) | (data[at + 1] << 8) | data[at + 2]
        out.add(alphabet[(word >> 18) & 63]); out.add(alphabet[(word >> 12) & 63])
        out.add(alphabet[(word >> 6) & 63]); out.add(alphabet[word & 63])
        at += 3
    }
    let left = data.length - at
    if left == 1 {
        let word = data[at] << 16
        out.add(alphabet[(word >> 18) & 63]); out.add(alphabet[(word >> 12) & 63])
        if !url { out.addBytes(Bytes("==")) }
    } else if left == 2 {
        let word = (data[at] << 16) | (data[at + 1] << 8)
        out.add(alphabet[(word >> 18) & 63]); out.add(alphabet[(word >> 12) & 63]); out.add(alphabet[(word >> 6) & 63])
        if !url { out.add(61) }
    }
    return utf8.decodeOrStop(out)
}
function sextet(byte: Integer): Integer {
    if byte >= 65 && byte <= 90 { return byte - 65 }
    if byte >= 97 && byte <= 122 { return byte - 71 }
    if byte >= 48 && byte <= 57 { return byte + 4 }
    if byte == 43 || byte == 45 { return 62 }
    if byte == 47 || byte == 95 { return 63 }
    return -1
}
public function unbase64(encoded: Text): Maybe<Bytes> {
    let input = Bytes(encoded)
    let length = input.length
    while length > 0 && input[length - 1] == 61 { length -= 1 }
    if input.length - length > 2 || length % 4 == 1 { return None }
    let out = Bytes()
    let word = 0
    let bits = 0
    for index in 0..length {
        let value = sextet(input[index])
        if value < 0 { return None }
        word = ((word << 6) | value) & 16777215
        bits += 6
        if bits >= 8 {
            bits -= 8
            out.add((word >> bits) & 255)
        }
    }
    return Some(out)
}

// ---- Small text helpers

function lowerHeaders(headers: List<rpc.Header>): List<rpc.Header> {
    let lowered: List<rpc.Header> = []
    for field in headers { lowered.add(rpc.Header { name: field.name.asciiLowercased(); value: field.value }) }
    return lowered
}
function trimmed(value: Text): Text {
    let start = 0
    let end = value.length
    while start < end && (value[start] == ' ' || value[start] == '\t') { start += 1 }
    while end > start && (value[end - 1] == ' ' || value[end - 1] == '\t') { end -= 1 }
    return value.slice(start, end)
}
// Comma-separated tokens from every value of a header, lowercase and trimmed.
function tokens(headers: List<rpc.Header>, name: Text): List<Text> {
    let found: List<Text> = []
    for value in rpc.headerValues(headers, name) {
        for piece in value.split(",") {
            let token = trimmed(piece).asciiLowercased()
            if token != "" { found.add(token) }
        }
    }
    return found
}
function hexValue(byte: Integer): Integer {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 97 && byte <= 102 { return byte - 87 }
    if byte >= 65 && byte <= 70 { return byte - 55 }
    return -1
}
// Percent-decoding for query values; "+" is a space. None for a bad escape.
function unescape(value: Text): Maybe<Bytes> {
    let input = Bytes(value)
    let out = Bytes()
    let at = 0
    while at < input.length {
        let byte = input[at]
        if byte == 37 {
            if at + 2 >= input.length { return None }
            let high = hexValue(input[at + 1])
            let low = hexValue(input[at + 2])
            if high < 0 || low < 0 { return None }
            out.add(high * 16 + low)
            at += 3
        } else {
            if byte == 43 { out.add(32) } else { out.add(byte) }
            at += 1
        }
    }
    return Some(out)
}
function escapeQuery(data: Bytes): Text {
    let out = Bytes()
    for byte in data {
        let plain = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) ||
            byte == 45 || byte == 46 || byte == 95 || byte == 126
        if plain { out.add(byte) } else {
            out.add(37)
            out.add(Bytes("0123456789ABCDEF")[byte >> 4])
            out.add(Bytes("0123456789ABCDEF")[byte & 15])
        }
    }
    return utf8.decodeOrStop(out)
}
record Query { names: List<Text>; values: List<Bytes>; bad: Boolean }
function query(raw: Text): Query {
    let result = Query { names: []; values: []; bad: false }
    if raw == "" { return result }
    for pair in raw.split("&") {
        if pair == "" { continue }
        let equals = pair.find("=")
        let name = pair
        let value = ""
        if equals >= 0 {
            name = pair.slice(0, equals)
            value = pair.slice(equals + 1, pair.length)
        }
        match unescape(name) {
            Some(decodedName) {
                match unescape(value) {
                    Some(decodedValue) {
                        match utf8.decode(decodedName) {
                            Ok(text) { result.names.add(text); result.values.add(decodedValue) }
                            Err(_) { result.bad = true }
                        }
                    }
                    None { result.bad = true }
                }
            }
            None { result.bad = true }
        }
    }
    return result
}
function Query.get(name: Text): Maybe<Bytes> {
    for index in 0..self.names.length { if self.names[index] == name { return Some(self.values[index]) } }
    return None
}
function Query.text(name: Text): Text {
    match self.get(name) {
        Some(value) {
            return match utf8.decode(value) {
                Ok(text) { text }
                Err(_) { "" }
            }
        }
        None { return "" }
    }
}
// 64-bit FNV-1a, for request fingerprints and key scopes.
function fingerprint(seed: Integer, data: Bytes): Integer {
    let hash = seed
    for byte in data { hash = wrappingMultiply(hash ^ byte, 1099511628211) }
    return hash
}
constant FNV_OFFSET = -3750763034362895579

// ---- Server

function plain(status: Integer, message: Text): Response {
    return Response { status: status; headers: [rpc.Header { name: "content-type"; value: "text/plain; charset=utf-8" }]; body: Bytes(message) }
}
// An error response; metadata is the call's headers and trailer-prefixed trailers.
function errorResponse(error: rpc.Error, headers: List<rpc.Header>, trailers: List<rpc.Header>): Response {
    let out: List<rpc.Header> = [rpc.Header { name: "content-type"; value: "application/json" }]
    for field in headers { out.add(field) }
    for field in trailers { out.add(rpc.Header { name: "trailer-" + field.name; value: field.value }) }
    return Response { status: httpStatus(error.code); headers: out; body: errorJson(error) }
}
function failed(code: Integer, message: Text): Response { return errorResponse(rpc.failure(code, message), [], []) }

function Server.compressor(name: Text): Maybe<Compressor> {
    for item in self.options.compressors { if item.name == name { return Some(item) } }
    return None
}
function Server.encodings(): Text {
    let names: List<Text> = []
    for item in self.options.compressors { names.add(item.name) }
    return joinText(names, ",")
}

/// Serves one request whose answer is ready when its handler returns:
/// unary calls, CORS preflight, and deferred or streaming calls that finish
/// inside their handler. Use `open` to serve calls that finish later.
public function Server.handle(request: Request): Response {
    match self.open(request) {
        Complete(response) { return response }
        Started(exchange) {
            let head = Response { status: 0; headers: []; body: Bytes() }
            while true {
                match exchange.step() {
                    Respond(response) { return response }
                    Start(started) { head = started }
                    Write(piece) { head.body.addBytes(piece) }
                    End(piece) {
                        head.body.addBytes(piece)
                        return head
                    }
                    Waiting {
                        exchange.cancel()
                        return self.withCors(exchange.origin, failed(rpc.UNIMPLEMENTED, "this call finishes later; serve it with Server.open"))
                    }
                }
            }
        }
    }
    return failed(rpc.INTERNAL, "unreachable")
}

/// The outcome of opening a call.
public choice Opened {
    Complete(response: Response)
    // The handler returned without finishing; step the Exchange as the
    // transport polls, until it responds or ends.
    Started(exchange: Exchange)
}

/// What a transport sends next for an open call.
public choice Step {
    // Nothing yet: step again after the next poll or the call's deadline.
    Waiting
    // A complete unary answer; the call is over.
    Respond(response: Response)
    // A stream begins: send this status and these headers, then the pieces.
    Start(head: Response)
    Write(piece: Bytes)
    // The last bytes of the stream; the call is over.
    End(piece: Bytes)
}

/// A deferred unary call or a stream that outlives its handler.
public record Exchange {
    private server: Server
    private call: rpc.Call
    private responder: rpc.Responder
    private streaming: Boolean
    private kind: Integer
    private requestHeaders: List<rpc.Header>
    private compressor: Maybe<Compressor>
    private queue: Bytes
    private headSent: Boolean
    private message: Maybe<Bytes>
    private outcome: Maybe<Maybe<rpc.Error>>
    private done: Boolean
    private origin: Text
    private replayKey: Text
    private replayFingerprint: Integer
    private started: Integer
    // Client and bidirectional streams: request envelopes not yet complete.
    private receiver: Maybe<rpc.Receiver>
    private input: Bytes
    private inputCompressor: Maybe<Compressor>
    private inputClosed: Boolean
    private notified: Boolean
    // Server.begin for other calls: the request until its body is complete,
    // then the exchange that serves it or the answer to send.
    private buffering: Boolean
    private buffered: Request
    private inner: Maybe<Exchange>
    private immediate: Maybe<Response>
}
// The call's deadline on the server clock, or -1; step it then at the latest.
public function Exchange.deadline(): Integer {
    match self.inner { Some(inner) { return inner.deadline() } None {} }
    return self.call.deadline
}
public function Exchange.finished(): Boolean {
    match self.inner { Some(inner) { return inner.finished() } None {} }
    return self.done
}
// The client went away: the handler's later sends fail and nothing is stored.
public function Exchange.cancel() {
    match self.inner { Some(inner) { inner.cancel(); return } None {} }
    if self.done { return }
    self.done = true
    rpc.cancel(self.responder)
    self.notify(rpc.failure(rpc.CANCELED, "the client canceled the call"))
    if self.replayKey != "" { self.server.running.remove(self.replayKey) }
}
// True for client and bidirectional streams, whose handler takes request
// messages as they arrive.
public function Exchange.receiving(): Boolean { return self.receiver.isSome() }

/// Request body bytes for a call started with `begin`, in any pieces.
public function Exchange.receive(data: Bytes) {
    match self.inner { Some(inner) { inner.receive(data); return } None {} }
    if self.buffering {
        // Past the limit the call fails anyway; keep only enough to say so.
        let room = self.server.options.maxRequestBytes + 6 - self.buffered.body.length
        if room > 0 { self.buffered.body.addBytes(data.slice(0, min(room, data.length))) }
        return
    }
    if self.done || self.inputClosed || self.receiver.isNone() || self.outcome.isSome() { return }
    self.input.addBytes(data)
    self.messages()
}
/// The request body is complete.
public function Exchange.closeInput() {
    match self.inner { Some(inner) { inner.closeInput(); return } None {} }
    if self.buffering {
        self.buffering = false
        match self.server.dispatch(self.buffered, self.origin) {
            Complete(response) { self.immediate = Some(self.server.withCors(self.origin, response)) }
            Started(exchange) { self.inner = Some(exchange) }
        }
        return
    }
    if self.inputClosed { return }
    self.inputClosed = true
    if self.done || self.outcome.isSome() { return }
    match self.receiver {
        Some(receiver) {
            if self.input.length > 0 {
                self.fail(rpc.failure(rpc.INVALID_ARGUMENT, "incomplete request envelope"))
                return
            }
            self.notified = true
            match receiver.end(None) {
                Ok() { if !rpc.held(self.responder) { self.responder.finish(None) } }
                Err(problem) { self.responder.finish(Some(problem)) }
            }
        }
        None {}
    }
}
// Hands complete request envelopes to the receiver.
function Exchange.messages() {
    let limit = self.server.options.maxRequestBytes
    // A cursor, and one copy of the unread tail at the end: taking each
    // envelope off the front would copy the rest of the input once per message.
    let input = self.input
    let at = 0
    while input.length - at >= 5 && self.outcome.isNone() && !self.done {
        let flags = input[at]
        let length = (input[at + 1] << 24) | (input[at + 2] << 16) | (input[at + 3] << 8) | input[at + 4]
        if length > limit { self.fail(rpc.failure(rpc.RESOURCE_EXHAUSTED, "request message is larger than " + Text(limit) + " bytes")); break }
        if (flags & 254) != 0 { self.fail(rpc.failure(rpc.INVALID_ARGUMENT, "unexpected envelope flags")); break }
        if input.length - at < 5 + length { break }
        let data = input.slice(at + 5, at + 5 + length)
        at += 5 + length
        if (flags & 1) == 1 {
            match self.inputCompressor {
                Some(compressor) {
                    match compressor.decompress(data, limit) {
                        Ok(expanded) { data = expanded }
                        Err(problem) {
                            let code = rpc.INVALID_ARGUMENT
                            if errors.code(problem) == errors.overflowCode() { code = rpc.RESOURCE_EXHAUSTED }
                            self.fail(rpc.failure(code, "cannot decompress request: " + problem.message()))
                            break
                        }
                    }
                }
                None { self.fail(rpc.failure(rpc.INTERNAL, "compressed message without connect-content-encoding")); break }
            }
        }
        match self.receiver.unwrap().message(data) {
            Ok() {}
            Err(problem) { self.responder.finish(Some(problem)) }
        }
    }
    if at > 0 { self.input = input.slice(at, input.length) }
}
// Ends the call with an error the handler did not choose.
function Exchange.fail(error: rpc.Error) {
    if self.outcome.isNone() { self.outcome = Some(Some(error)) }
    rpc.cancel(self.responder)
    self.notify(error)
}
// Tells a receiving handler its call broke, once.
function Exchange.notify(error: rpc.Error) {
    if self.notified || rpc.finished(self.responder) { return }
    match self.receiver {
        Some(receiver) {
            self.notified = true
            // The call is over; what the handler returns changes nothing.
            match receiver.end(Some(error)) { Ok() {} Err(_) {} }
        }
        None {}
    }
}

/// Starts one call. Most callers use `handle`; transports that can wait use
/// this and step a Started exchange as they poll.
public function Server.open(request: Request): Opened {
    let headers = lowerHeaders(request.headers)
    let normalized = Request { method: request.method.asciiUppercased(); target: request.target; headers: headers; body: request.body }
    let origin = rpc.headerValue(headers, "origin")
    self.options.observe(normalized)
    if normalized.method == "OPTIONS" && rpc.headerValue(headers, "access-control-request-method") != "" {
        return Complete(self.preflight(origin))
    }
    match self.dispatch(normalized, origin) {
        Complete(response) { return Complete(self.withCors(origin, response)) }
        Started(exchange) {
            if exchange.receiving() {
                exchange.receive(normalized.body)
                exchange.closeInput()
            }
            return Started(exchange)
        }
    }
    return Complete(failed(rpc.INTERNAL, "unreachable"))
}

/// Starts a call whose request body arrives later, as over HTTP/2; the body
/// in `request` may be empty. Pass the rest to Exchange.receive and its end to
/// closeInput, and step the Exchange as for `open` (it may Respond at once).
/// A client or bidirectional stream starts its handler now; other calls start
/// when the body is complete.
public function Server.begin(request: Request): Exchange {
    let headers = lowerHeaders(request.headers)
    let normalized = Request { method: request.method.asciiUppercased(); target: request.target; headers: headers; body: request.body }
    let origin = rpc.headerValue(headers, "origin")
    self.options.observe(normalized)
    if normalized.method == "OPTIONS" && rpc.headerValue(headers, "access-control-request-method") != "" {
        return self.answered(origin, self.preflight(origin))
    }
    let path = normalized.target
    let question = path.find("?")
    if question >= 0 { path = path.slice(0, question) }
    // Unknown procedures are answered at once; other calls that take one
    // request message wait for the whole body.
    let kind = -1
    match self.services.lookup(path) { Some(method) { kind = method.kind() } None {} }
    if kind >= 0 && (normalized.method != "POST" || (kind != rpc.CLIENT_STREAM && kind != rpc.BIDI_STREAM)) {
        let exchange = self.answered(origin, Response { status: 0; headers: []; body: Bytes() })
        exchange.immediate = None
        exchange.done = false
        exchange.buffering = true
        exchange.buffered = normalized
        return exchange
    }
    match self.dispatch(normalized, origin) {
        Complete(response) { return self.answered(origin, self.withCors(origin, response)) }
        Started(exchange) {
            exchange.receive(normalized.body)
            return exchange
        }
    }
    return self.answered(origin, failed(rpc.INTERNAL, "unreachable"))
}
// An exchange whose only step is this response.
function Server.answered(origin: Text, response: Response): Exchange {
    let exchange = self.exchange(rpc.call("", "connect", "", [], -1, self.options.clock), rpc.UNARY, [], "", origin, "", 0, 0)
    exchange.immediate = Some(response)
    return exchange
}

record Parsed { codec: Text; body: Bytes; compression: Text; get: Boolean; problem: Maybe<Response> }
function problem(response: Response): Parsed {
    return Parsed { codec: ""; body: Bytes(); compression: ""; get: false; problem: Some(response) }
}
function codecFromContentType(contentType: Text, streaming: Boolean): Text {
    let semicolon = contentType.find(";")
    let base = contentType
    let parameters = ""
    if semicolon >= 0 {
        base = contentType.slice(0, semicolon)
        parameters = contentType.slice(semicolon + 1, contentType.length)
    }
    base = trimmed(base).asciiLowercased()
    let prefix = "application/"
    if streaming { prefix = "application/connect+" }
    if !base.startsWith(prefix) { return "" }
    let codec = base.slice(prefix.length, base.length)
    if codec != "proto" && codec != "json" { return "" }
    for parameter in parameters.split(";") {
        let item = trimmed(parameter).asciiLowercased()
        if item == "" { continue }
        if item.startsWith("charset=") {
            let charset = item.slice(8, item.length)
            if codec != "json" || (charset != "utf-8" && charset != "\"utf-8\"") { return "" }
        }
    }
    return codec
}
function unsupportedMedia(streaming: Boolean): Response {
    let accepted = "application/json, application/proto"
    if streaming { accepted = "application/connect+json, application/connect+proto" }
    return Response { status: 415; headers: [rpc.Header { name: "accept-post"; value: accepted }]; body: Bytes() }
}
// Parses a connect-timeout-ms value: 1 to 10 digits. -2 when malformed.
function timeoutMilliseconds(value: Text): Integer {
    if value == "" { return -1 }
    if value.length > 10 { return -2 }
    let total = 0
    for character in value {
        if character < '0' || character > '9' { return -2 }
        total = total * 10 + Integer(character) - 48
    }
    return total
}

function Server.parse(request: Request, method: rpc.Method, path: Text, raw: Text, streaming: Boolean): Parsed {
    let headers = request.headers
    if request.method == "GET" {
        let params = query(raw)
        if params.bad { return problem(failed(rpc.INVALID_ARGUMENT, "malformed query")) }
        let connect = params.text("connect")
        if connect != "" && connect != "v1" { return problem(failed(rpc.INVALID_ARGUMENT, "connect must be v1")) }
        if connect == "" && self.options.requireProtocolVersion { return problem(failed(rpc.INVALID_ARGUMENT, "missing connect=v1 query parameter")) }
        let codec = params.text("encoding")
        if codec != "proto" && codec != "json" { return problem(unsupportedMedia(false)) }
        let message = Bytes()
        match params.get("message") { Some(value) { message = value } None {} }
        if params.text("base64") == "1" {
            match unbase64(utf8.decodeOrStop(message)) {
                Some(decoded) { message = decoded }
                None { return problem(failed(rpc.INVALID_ARGUMENT, "message is not base64")) }
            }
        }
        return Parsed { codec: codec; body: message; compression: params.text("compression").asciiLowercased(); get: true; problem: None }
    }
    let codec = codecFromContentType(rpc.headerValue(headers, "content-type"), streaming)
    if codec == "" { return problem(unsupportedMedia(streaming)) }
    let version = rpc.headerValue(headers, "connect-protocol-version")
    if version != "" && version != "1" { return problem(failed(rpc.INVALID_ARGUMENT, "connect-protocol-version must be 1")) }
    if version == "" && self.options.requireProtocolVersion { return problem(failed(rpc.INVALID_ARGUMENT, "missing connect-protocol-version header")) }
    let encodingHeader = "content-encoding"
    if streaming { encodingHeader = "connect-content-encoding" }
    return Parsed { codec: codec; body: request.body; compression: rpc.headerValue(headers, encodingHeader).asciiLowercased(); get: false; problem: None }
}

// One Connect envelope: flags, a big-endian length, then the bytes.
public function envelope(flags: Integer, data: Bytes): Bytes {
    let out = Bytes()
    out.add(flags)
    out.add((data.length >> 24) & 255)
    out.add((data.length >> 16) & 255)
    out.add((data.length >> 8) & 255)
    out.add(data.length & 255)
    out.addBytes(data)
    return out
}
// The end-of-stream message: an optional error and the trailers.
public function endStreamJson(error: Maybe<rpc.Error>, trailers: List<rpc.Header>): Bytes {
    let out = Bytes("{")
    match error {
        Some(problem) {
            out.addBytes(Bytes("\"error\":"))
            out.addBytes(errorJson(problem))
        }
        None {}
    }
    if trailers.length > 0 {
        match error { Some(_) { out.add(44) } None {} }
        out.addBytes(Bytes("\"metadata\":{"))
        let names: List<Text> = []
        for field in trailers {
            let name = field.name.asciiLowercased()
            let seen = false
            for other in names { if other == name { seen = true } }
            if !seen { names.add(name) }
        }
        for index in 0..names.length {
            if index > 0 { out.add(44) }
            quoted(names[index], out)
            out.addBytes(Bytes(":["))
            let first = true
            for field in trailers {
                if field.name.asciiLowercased() != names[index] { continue }
                if !first { out.add(44) }
                first = false
                quoted(field.value, out)
            }
            out.add(93)
        }
        out.add(125)
    }
    out.add(125)
    return out
}
// A stream that fails before its handler runs: status 200 and an end message.
function streamFailure(codec: Text, error: rpc.Error): Response {
    return Response { status: 200; headers: [rpc.Header { name: "content-type"; value: "application/connect+" + codec }]
        body: envelope(2, endStreamJson(Some(error), [])) }
}

function Server.dispatch(request: Request, origin: Text): Opened {
    let question = request.target.find("?")
    let path = request.target
    let raw = ""
    if question >= 0 {
        path = request.target.slice(0, question)
        raw = request.target.slice(question + 1, request.target.length)
    }
    let found = self.services.lookup(path)
    if found.isNone() {
        let missing = failed(rpc.UNIMPLEMENTED, "no procedure " + path)
        return Complete(Response { status: 404; headers: missing.headers; body: missing.body })
    }
    let method = found.unwrap()
    let streaming = method.kind() != rpc.UNARY
    let allowGet = method.idempotency == rpc.NO_SIDE_EFFECTS && !streaming
    if request.method != "POST" && !(request.method == "GET" && allowGet) {
        let allow = "POST"
        if allowGet { allow = "GET, POST" }
        return Complete(Response { status: 405; headers: [rpc.Header { name: "allow"; value: allow }]; body: Bytes() })
    }
    let parsed = self.parse(request, method, path, raw, streaming)
    match parsed.problem {
        Some(response) {
            if streaming && response.status != 415 {
                return Complete(streamFailure(parsed.codec, parseErrorJson(response.body).unwrapOr(rpc.failure(rpc.INVALID_ARGUMENT, "bad request"))))
            }
            return Complete(response)
        }
        None {}
    }
    let opened = self.prepare(request, method, path, parsed, origin)
    if streaming {
        match opened {
            Complete(response) {
                if response.status == 200 { return opened }
                return Complete(streamFailure(parsed.codec, parseErrorJson(response.body).unwrapOr(rpc.failure(rpc.INTERNAL, "failed"))))
            }
            Started(_) { return opened }
        }
    }
    return opened
}

function Server.prepare(request: Request, method: rpc.Method, path: Text, parsed: Parsed, origin: Text): Opened {
    let kind = method.kind()
    let streaming = kind != rpc.UNARY
    let limit = self.options.maxRequestBytes
    let body = parsed.body
    let compressed = parsed.compression != "" && parsed.compression != "identity"
    if kind == rpc.CLIENT_STREAM || kind == rpc.BIDI_STREAM {
        // Request envelopes go to the handler's Receiver as they arrive.
        compressed = false
    } else if streaming {
        // One enveloped message; flag 1 marks it compressed.
        if body.length == 0 { return Complete(failed(rpc.UNIMPLEMENTED, "a server stream needs exactly one request message")) }
        if body.length < 5 { return Complete(failed(rpc.INVALID_ARGUMENT, "incomplete request envelope")) }
        let flags = body[0]
        let length = (body[1] << 24) | (body[2] << 16) | (body[3] << 8) | body[4]
        if length > limit { return Complete(failed(rpc.RESOURCE_EXHAUSTED, "request is larger than " + Text(limit) + " bytes")) }
        if body.length < 5 + length { return Complete(failed(rpc.INVALID_ARGUMENT, "incomplete request message")) }
        if body.length > 5 + length { return Complete(failed(rpc.UNIMPLEMENTED, "a server stream needs exactly one request message")) }
        if (flags & 254) != 0 { return Complete(failed(rpc.INVALID_ARGUMENT, "unexpected envelope flags")) }
        if (flags & 1) == 1 && !compressed { return Complete(failed(rpc.INTERNAL, "compressed message without connect-content-encoding")) }
        compressed = compressed && (flags & 1) == 1
        body = body.slice(5, body.length)
    } else if body.length > limit {
        return Complete(failed(rpc.RESOURCE_EXHAUSTED, "request is larger than " + Text(limit) + " bytes"))
    }
    if parsed.compression != "" && parsed.compression != "identity" && self.compressor(parsed.compression).isNone() {
        return Complete(failed(rpc.UNIMPLEMENTED, "unknown compression " + parsed.compression + "; supported: " + self.encodings()))
    }
    if compressed {
        match self.compressor(parsed.compression) {
            Some(compressor) {
                match compressor.decompress(body, limit) {
                    Ok(expanded) { body = expanded }
                    Err(problem) {
                        let code = rpc.INVALID_ARGUMENT
                        if errors.code(problem) == errors.overflowCode() { code = rpc.RESOURCE_EXHAUSTED }
                        return Complete(failed(code, "cannot decompress request: " + problem.message()))
                    }
                }
            }
            None {}
        }
    }
    let timeout = timeoutMilliseconds(rpc.headerValue(request.headers, "connect-timeout-ms"))
    if timeout == -2 { return Complete(failed(rpc.INVALID_ARGUMENT, "malformed connect-timeout-ms")) }
    let started = self.options.clock()
    let deadline = -1
    if timeout >= 0 { deadline = started + timeout }

    // A retried unary call with the same Idempotency-Key gets the stored result.
    let key = rpc.headerValue(request.headers, "idempotency-key")
    let replayKey = ""
    let replayFingerprint = 0
    if key != "" && !streaming {
        if key.byteLength > 255 { return Complete(failed(rpc.INVALID_ARGUMENT, "idempotency-key is longer than 255 bytes")) }
        let scope = fingerprint(FNV_OFFSET, Bytes(rpc.headerValue(request.headers, "authorization")))
        replayKey = path + "\n" + Text(scope) + "\n" + key
        replayFingerprint = fingerprint(fingerprint(FNV_OFFSET, Bytes(parsed.codec)), body)
        if self.running.contains(replayKey) { return Complete(failed(rpc.ABORTED, "a call with this idempotency-key is still running")) }
        match self.stored(replayKey, started) {
            Some(entry) {
                if entry.fingerprint != replayFingerprint {
                    return Complete(failed(rpc.INVALID_ARGUMENT, "idempotency-key was used with a different request"))
                }
                self.replayed += 1
                let copy = Response { status: entry.response.status; headers: []; body: entry.response.body }
                for field in entry.response.headers { copy.headers.add(field) }
                copy.headers.add(rpc.Header { name: "idempotent-replayed"; value: "true" })
                return Complete(copy)
            }
            None {}
        }
    }

    let call = rpc.call(path, "connect", parsed.codec, request.headers, deadline, self.options.clock)
    self.executed += 1
    match method.handler {
        Unary(handler) {
            let response = self.unaryResponse(call, handler(call, body), request.headers)
            // A retry gets what the handler did, even when this attempt ran out of time.
            if replayKey != "" && response.status != 503 { self.store(replayKey, replayFingerprint, response, started) }
            if call.expired() { return Complete(self.unaryResponse(call, Err(rpc.failure(rpc.DEADLINE_EXCEEDED, "the deadline passed")), request.headers)) }
            return Complete(response)
        }
        Deferred(handler) {
            let exchange = self.exchange(call, rpc.UNARY, request.headers, "", origin, replayKey, replayFingerprint, started)
            if replayKey != "" { self.running.add(replayKey) }
            exchange.run(handler(call, body, exchange.responder))
            return Started(exchange)
        }
        ServerStream(handler) {
            let exchange = self.exchange(call, rpc.SERVER_STREAM, request.headers, rpc.headerValue(request.headers, "connect-accept-encoding"), origin, "", 0, started)
            exchange.run(handler(call, body, exchange.responder))
            return Started(exchange)
        }
        ClientStream(handler) { return Started(self.receiving(call, rpc.CLIENT_STREAM, handler, request.headers, parsed.compression, origin, started)) }
        BidiStream(handler) { return Started(self.receiving(call, rpc.BIDI_STREAM, handler, request.headers, parsed.compression, origin, started)) }
    }
}
function Server.receiving(call: rpc.Call, kind: Integer, handler: (rpc.Call, rpc.Responder) -> Result<rpc.Receiver, rpc.Error>,
        headers: List<rpc.Header>, compression: Text, origin: Text, started: Integer): Exchange {
    let exchange = self.exchange(call, kind, headers, rpc.headerValue(headers, "connect-accept-encoding"), origin, "", 0, started)
    if compression != "" && compression != "identity" { exchange.inputCompressor = self.compressor(compression) }
    match handler(call, exchange.responder) {
        Ok(receiver) { exchange.receiver = Some(receiver) }
        Err(problem) {
            // Still receiving, so the transport reads and drops the rest of the body.
            exchange.receiver = Some(rpc.Receiver { message: function(data: Bytes): Result<Nothing, rpc.Error> { return Ok() }
                end: function(error: Maybe<rpc.Error>): Result<Nothing, rpc.Error> { return Ok() } })
            exchange.notified = true
            exchange.responder.finish(Some(problem))
        }
    }
    return exchange
}

function Server.exchange(call: rpc.Call, kind: Integer, headers: List<rpc.Header>, accepted: Text, origin: Text,
        replayKey: Text, replayFingerprint: Integer, started: Integer): Exchange {
    let compressor: Maybe<Compressor> = None
    for piece in accepted.split(",") {
        let name = trimmed(piece).asciiLowercased()
        if compressor.isNone() && name != "" { compressor = self.compressor(name) }
    }
    let exchange = Exchange { server: self; call: call; responder: rpc.responder(function(data: Bytes): Boolean { return false }, function(error: Maybe<rpc.Error>) {})
        streaming: kind != rpc.UNARY; kind: kind; requestHeaders: headers; compressor: compressor; queue: Bytes(); headSent: false; message: None
        outcome: None; done: false; origin: origin; replayKey: replayKey; replayFingerprint: replayFingerprint; started: started
        receiver: None; input: Bytes(); inputCompressor: None; inputClosed: false; notified: false
        buffering: false; buffered: Request { method: ""; target: ""; headers: []; body: Bytes() }; inner: None; immediate: None }
    exchange.responder = rpc.responder(function(data: Bytes): Boolean { return exchange.deliver(data) },
        function(error: Maybe<rpc.Error>) { exchange.end(error) })
    return exchange
}
function Exchange.deliver(data: Bytes): Boolean {
    if self.done || self.outcome.isSome() { return false }
    if !self.streaming {
        if self.message.isSome() {
            self.outcome = Some(Some(rpc.failure(rpc.INTERNAL, "a unary handler sent more than one message")))
            rpc.cancel(self.responder)
            return false
        }
        self.message = Some(data)
        return true
    }
    if self.kind == rpc.CLIENT_STREAM && self.responder.sentCount() > 0 {
        self.outcome = Some(Some(rpc.failure(rpc.INTERNAL, "a client-stream handler sent more than one message")))
        rpc.cancel(self.responder)
        return false
    }
    if self.queue.length >= self.server.options.maxStreamBufferBytes { return false }
    if data.length > self.server.options.maxResponseBytes {
        self.outcome = Some(Some(rpc.failure(rpc.RESOURCE_EXHAUSTED, "message is larger than " + Text(self.server.options.maxResponseBytes) + " bytes")))
        rpc.cancel(self.responder)
        return false
    }
    match self.compressor {
        Some(compressor) {
            if data.length >= self.server.options.compressMinBytes {
                match compressor.compress(data) {
                    Ok(packed) {
                        self.queue.addBytes(envelope(1, packed))
                        return true
                    }
                    Err(_) {}
                }
            }
        }
        None {}
    }
    self.queue.addBytes(envelope(0, data))
    return true
}
function Exchange.end(error: Maybe<rpc.Error>) {
    if self.outcome.isNone() { self.outcome = Some(error) }
}
// Applies the handler's return: Err finishes the call; Ok finishes it unless held.
function Exchange.run(result: Result<Nothing, rpc.Error>) {
    match result {
        Ok() { if !rpc.held(self.responder) { self.responder.finish(None) } }
        Err(problem) { self.responder.finish(Some(problem)) }
    }
}

/// The next thing to send. Call it after polling until it returns Waiting,
/// and again by the call's deadline.
public function Exchange.step(): Step {
    match self.inner { Some(inner) { return inner.step() } None {} }
    match self.immediate {
        Some(response) {
            self.immediate = None
            self.done = true
            return Respond(response)
        }
        None {}
    }
    if self.done || self.buffering { return Waiting }
    if self.outcome.isNone() && self.call.expired() { self.fail(rpc.failure(rpc.DEADLINE_EXCEEDED, "the deadline passed")) }
    if !self.streaming {
        match self.outcome {
            Some(error) {
                self.done = true
                let result: Result<Bytes, rpc.Error> = Err(rpc.failure(rpc.INTERNAL, "the handler finished without a message"))
                match error {
                    Some(problem) { result = Err(problem) }
                    None { match self.message { Some(data) { result = Ok(data) } None {} } }
                }
                let response = self.server.unaryResponse(self.call, result, self.requestHeaders)
                if self.replayKey != "" {
                    self.server.running.remove(self.replayKey)
                    if response.status != 503 { self.server.store(self.replayKey, self.replayFingerprint, response, self.started) }
                }
                return Respond(self.server.withCors(self.origin, response))
            }
            None { return Waiting }
        }
    }
    if self.kind == rpc.CLIENT_STREAM && self.outcome.isSome() && self.outcome.unwrap().isNone() && self.responder.sentCount() == 0 {
        self.outcome = Some(Some(rpc.failure(rpc.INTERNAL, "the handler finished without a message")))
    }
    // The head goes out once the handler has returned, so a client sees the
    // stream's headers before a slow first message. Client and bidirectional
    // handlers set headers as messages arrive, so theirs wait for a message
    // or the end.
    let waits = self.kind == rpc.CLIENT_STREAM || self.kind == rpc.BIDI_STREAM
    if waits && !self.headSent && self.queue.length == 0 && self.outcome.isNone() { return Waiting }
    if !self.headSent {
        self.headSent = true
        let headers: List<rpc.Header> = [rpc.Header { name: "content-type"; value: "application/connect+" + self.call.codec }]
        match self.compressor { Some(compressor) { headers.add(rpc.Header { name: "connect-content-encoding"; value: compressor.name }) } None {} }
        for field in self.call.responseHeaders { headers.add(rpc.Header { name: field.name.asciiLowercased(); value: field.value }) }
        return Start(self.server.withCors(self.origin, Response { status: 200; headers: headers; body: Bytes() }))
    }
    match self.outcome {
        Some(error) {
            self.done = true
            let piece = self.queue
            self.queue = Bytes()
            piece.addBytes(envelope(2, endStreamJson(error, self.call.responseTrailers)))
            return End(piece)
        }
        None {}
    }
    if self.queue.length == 0 { return Waiting }
    let piece = self.queue
    self.queue = Bytes()
    return Write(piece)
}

function Server.unaryResponse(call: rpc.Call, result: Result<Bytes, rpc.Error>, requestHeaders: List<rpc.Header>): Response {
    match result {
        Ok(message) {
            if message.length > self.options.maxResponseBytes {
                return errorResponse(rpc.failure(rpc.RESOURCE_EXHAUSTED, "response is larger than " + Text(self.options.maxResponseBytes) + " bytes"),
                    call.responseHeaders, call.responseTrailers)
            }
            let headers: List<rpc.Header> = [rpc.Header { name: "content-type"; value: "application/" + call.codec }]
            let body = message
            if message.length >= self.options.compressMinBytes {
                for name in tokens(requestHeaders, "accept-encoding") {
                    match self.compressor(name) {
                        Some(compressor) {
                            match compressor.compress(message) {
                                Ok(packed) {
                                    body = packed
                                    headers.add(rpc.Header { name: "content-encoding"; value: compressor.name })
                                }
                                Err(_) {}
                            }
                            break
                        }
                        None {}
                    }
                }
            }
            for field in call.responseHeaders { headers.add(rpc.Header { name: field.name.asciiLowercased(); value: field.value }) }
            for field in call.responseTrailers { headers.add(rpc.Header { name: "trailer-" + field.name.asciiLowercased(); value: field.value }) }
            return Response { status: 200; headers: headers; body: body }
        }
        Err(error) { return errorResponse(error, lowerHeaders(call.responseHeaders), lowerHeaders(call.responseTrailers)) }
    }
}

// ---- Idempotency replay cache: a bounded ring of completed unary results.

function Server.stored(key: Text, now: Integer): Maybe<Replay> {
    if !self.replayIndex.has(key) { return None }
    let entry = self.replays[self.replayIndex[key]]
    if now - entry.stored >= self.options.idempotencyMilliseconds {
        self.replayIndex.remove(key)
        return None
    }
    return Some(entry)
}
function Server.store(key: Text, fingerprint: Integer, response: Response, now: Integer) {
    if self.options.idempotencyEntries <= 0 { return }
    let entry = Replay { key: key; fingerprint: fingerprint; stored: now; response: response }
    if self.replays.length < self.options.idempotencyEntries {
        self.replayIndex[key] = self.replays.length
        self.replays.add(entry)
        return
    }
    let slot = self.replayNext
    let old = self.replays[slot].key
    if self.replayIndex.has(old) && self.replayIndex[old] == slot { self.replayIndex.remove(old) }
    self.replays[slot] = entry
    self.replayIndex[key] = slot
    self.replayNext = (slot + 1) % self.options.idempotencyEntries
}

// ---- CORS

constant ALLOWED_HEADERS = "content-type, connect-protocol-version, connect-timeout-ms, connect-accept-encoding, connect-content-encoding, grpc-timeout, x-grpc-web, x-user-agent, idempotency-key"
constant EXPOSED_HEADERS = "grpc-status, grpc-message, grpc-status-details-bin, idempotent-replayed"
function Server.originAllowed(origin: Text): Boolean {
    if origin == "" { return false }
    for allowed in self.options.cors.allowedOrigins { if allowed == "*" || allowed == origin { return true } }
    return false
}
function Server.allowOrigin(origin: Text, headers: List<rpc.Header>) {
    let cors = self.options.cors
    let wildcard = false
    let named = false
    for allowed in cors.allowedOrigins { if allowed == "*" { wildcard = true } else if allowed == origin { named = true } }
    // Credentials go only to an origin listed by name. Browsers refuse "*"
    // with credentials so that no arbitrary site can act as the signed-in
    // user; echoing whatever origin asked would undo exactly that, so an
    // origin admitted only by "*" is answered as public.
    if wildcard && !(cors.allowCredentials && named) {
        headers.add(rpc.Header { name: "access-control-allow-origin"; value: "*" })
        return
    }
    headers.add(rpc.Header { name: "access-control-allow-origin"; value: origin })
    headers.add(rpc.Header { name: "vary"; value: "Origin" })
    if cors.allowCredentials { headers.add(rpc.Header { name: "access-control-allow-credentials"; value: "true" }) }
}
function Server.preflight(origin: Text): Response {
    let headers: List<rpc.Header> = []
    if !self.originAllowed(origin) { return Response { status: 403; headers: headers; body: Bytes() } }
    self.allowOrigin(origin, headers)
    let allowed = ALLOWED_HEADERS
    for name in self.options.cors.allowedHeaders { allowed = allowed + ", " + name.asciiLowercased() }
    headers.add(rpc.Header { name: "access-control-allow-methods"; value: "GET, POST" })
    headers.add(rpc.Header { name: "access-control-allow-headers"; value: allowed })
    headers.add(rpc.Header { name: "access-control-max-age"; value: Text(self.options.cors.maxAgeSeconds) })
    return Response { status: 204; headers: headers; body: Bytes() }
}
// A copy with CORS headers, so a stored replay never keeps one caller's origin.
function Server.withCors(origin: Text, response: Response): Response {
    if !self.originAllowed(origin) { return response }
    let headers: List<rpc.Header> = []
    for field in response.headers { headers.add(field) }
    self.allowOrigin(origin, headers)
    let exposed = EXPOSED_HEADERS
    for name in self.options.cors.exposedHeaders { exposed = exposed + ", " + name.asciiLowercased() }
    headers.add(rpc.Header { name: "access-control-expose-headers"; value: exposed })
    return Response { status: response.status; headers: headers; body: response.body }
}

// ---- Client

/// Sends one HTTP request and returns its response; Err for a transport
/// failure, such as a reset connection or a lost response (UNAVAILABLE).
public record Client {
    // Prefix for procedure paths, such as "https://api.example" or "".
    baseUrl: Text
    codec: Text
    headers: List<rpc.Header>
    transport: (Request) -> Result<Response, rpc.Error>
    // Tries per call for UNAVAILABLE failures, including lost responses.
    attempts: Integer
    // Accepted response encodings; `sendCompression` names one for requests
    // of at least `compressMinBytes`.
    compressors: List<Compressor>
    sendCompression: Text
    compressMinBytes: Integer
    maxResponseBytes: Integer
    // "connect", or "grpc" to speak gRPC to a gRPC server; gRPC and
    // streaming calls need `opener`.
    protocol: Text
    // Opens one HTTP exchange that streams both ways, such as an HTTP/2
    // stream; the Integer is the call's timeout in milliseconds, or -1.
    opener: Maybe<(Request, Integer) -> Result<Wire, rpc.Error>>
    private keyPrefix: Text
    private serial: Integer
}
/// A client for "proto" or "json". `keyPrefix` makes Idempotency-Keys unique
/// across clients: give each process random text, such as 16 random bytes in hex.
public function client(baseUrl: Text, codec: Text, transport: (Request) -> Result<Response, rpc.Error>, keyPrefix: Text): Client {
    return Client { baseUrl: baseUrl; codec: codec; headers: []; transport: transport; attempts: 3; compressors: [];
        sendCompression: ""; compressMinBytes: 1024; maxResponseBytes: 16777216; protocol: "connect"; opener: None; keyPrefix: keyPrefix; serial: 0 }
}
/// A client whose calls of every kind travel over `opener`'s exchanges, such
/// as HTTP/2 streams from library/connecth2.min.
public function streamingClient(baseUrl: Text, codec: Text, opener: (Request, Integer) -> Result<Wire, rpc.Error>, keyPrefix: Text): Client {
    let made = client(baseUrl, codec, wireTransport(opener), keyPrefix)
    made.opener = Some(opener)
    return made
}
/// A gRPC client for "proto" or "json" over `opener`'s HTTP/2 streams. The
/// same calls, typed helpers and generated clients work as over Connect.
public function grpcClient(baseUrl: Text, codec: Text, opener: (Request, Integer) -> Result<Wire, rpc.Error>): Client {
    let made = streamingClient(baseUrl, codec, opener, "")
    made.protocol = "grpc"
    return made
}
public record CallOptions {
    headers: List<rpc.Header>
    // -1 for no deadline.
    timeoutMilliseconds: Integer
    // Send GET with the message in the query (NO_SIDE_EFFECTS methods only).
    get: Boolean
    // Retry this call on UNAVAILABLE with an Idempotency-Key, even if the
    // method has side effects. NO_SIDE_EFFECTS and IDEMPOTENT calls retry anyway.
    idempotency: Integer
    // A caller-chosen key; empty asks the client to make one per call.
    idempotencyKey: Text
}
public function callOptions(): CallOptions {
    return CallOptions { headers: []; timeoutMilliseconds: -1; get: false; idempotency: rpc.IDEMPOTENCY_UNKNOWN; idempotencyKey: "" }
}
public record Reply { message: Bytes; headers: List<rpc.Header>; trailers: List<rpc.Header> }
public record Failure { error: rpc.Error; headers: List<rpc.Header>; trailers: List<rpc.Header> }

public function Client.request(procedure: Text, message: Bytes, options: CallOptions, key: Text): Request {
    let headers: List<rpc.Header> = []
    for field in self.headers { headers.add(rpc.Header { name: field.name.asciiLowercased(); value: field.value }) }
    for field in options.headers { headers.add(rpc.Header { name: field.name.asciiLowercased(); value: field.value }) }
    if options.timeoutMilliseconds >= 0 { headers.add(rpc.Header { name: "connect-timeout-ms"; value: Text(options.timeoutMilliseconds) }) }
    if key != "" { headers.add(rpc.Header { name: "idempotency-key"; value: key }) }
    let names: List<Text> = []
    for item in self.compressors { names.add(item.name) }
    if names.length > 0 { headers.add(rpc.Header { name: "accept-encoding"; value: joinText(names, ", ") }) }
    let body = message
    let encoding = ""
    if self.sendCompression != "" && message.length >= self.compressMinBytes {
        for compressor in self.compressors {
            if compressor.name == self.sendCompression {
                match compressor.compress(message) {
                    Ok(packed) {
                        body = packed
                        encoding = compressor.name
                    }
                    Err(_) {}
                }
            }
        }
    }
    if options.get {
        let target = self.baseUrl + procedure + "?connect=v1&encoding=" + self.codec
        if encoding != "" { target = target + "&compression=" + encoding }
        if self.codec == "json" && encoding == "" { target = target + "&message=" + escapeQuery(body) }
        else { target = target + "&base64=1&message=" + base64(body, true) }
        return Request { method: "GET"; target: target; headers: headers; body: Bytes() }
    }
    headers.add(rpc.Header { name: "content-type"; value: "application/" + self.codec })
    headers.add(rpc.Header { name: "connect-protocol-version"; value: "1" })
    if encoding != "" { headers.add(rpc.Header { name: "content-encoding"; value: encoding }) }
    return Request { method: "POST"; target: self.baseUrl + procedure; headers: headers; body: body }
}

function trailersOf(headers: List<rpc.Header>): List<rpc.Header> {
    let trailers: List<rpc.Header> = []
    for field in headers {
        if field.name.startsWith("trailer-") { trailers.add(rpc.Header { name: field.name.slice(8, field.name.length); value: field.value }) }
    }
    return trailers
}
function headersOf(headers: List<rpc.Header>): List<rpc.Header> {
    let plainHeaders: List<rpc.Header> = []
    for field in headers { if !field.name.startsWith("trailer-") { plainHeaders.add(field) } }
    return plainHeaders
}

/// Reads one Connect unary HTTP response.
public function Client.reply(response: Response): Result<Reply, Failure> {
    let headers = lowerHeaders(response.headers)
    let metadata = headersOf(headers)
    let trailers = trailersOf(headers)
    let body = response.body
    let encoding = rpc.headerValue(headers, "content-encoding").asciiLowercased()
    if encoding != "" && encoding != "identity" {
        let found = false
        for compressor in self.compressors {
            if compressor.name == encoding {
                found = true
                match compressor.decompress(body, self.maxResponseBytes) {
                    Ok(expanded) { body = expanded }
                    Err(problem) {
                        return Err(Failure { error: rpc.failure(rpc.INTERNAL, "cannot decompress response: " + problem.message()); headers: metadata; trailers: trailers })
                    }
                }
            }
        }
        if !found { return Err(Failure { error: rpc.failure(rpc.INTERNAL, "unknown response compression " + encoding); headers: metadata; trailers: trailers }) }
    }
    if response.status != 200 {
        let error = rpc.failure(codeForStatus(response.status), "HTTP status " + Text(response.status))
        if codecFromContentType(rpc.headerValue(headers, "content-type"), false) == "json" {
            match parseErrorJson(body) { Some(parsed) { error = parsed } None {} }
        }
        return Err(Failure { error: error; headers: metadata; trailers: trailers })
    }
    let codec = codecFromContentType(rpc.headerValue(headers, "content-type"), false)
    if codec != self.codec {
        return Err(Failure { error: rpc.failure(rpc.INTERNAL, "unexpected response content-type " + rpc.headerValue(headers, "content-type")); headers: metadata; trailers: trailers })
    }
    if body.length > self.maxResponseBytes {
        return Err(Failure { error: rpc.failure(rpc.RESOURCE_EXHAUSTED, "response is larger than " + Text(self.maxResponseBytes) + " bytes"); headers: metadata; trailers: trailers })
    }
    return Ok(Reply { message: body; headers: metadata; trailers: trailers })
}

/// One unary call. UNAVAILABLE failures, including a response lost in
/// transit, are retried up to `attempts` times for calls that may be
/// repeated; the same Idempotency-Key lets the server answer a retry without
/// running the handler again.
public function Client.unary(procedure: Text, message: Bytes, options: CallOptions): Result<Reply, Failure> {
    if self.protocol == "grpc" { return self.grpcUnary(procedure, message, options) }
    let retryable = options.idempotency != rpc.IDEMPOTENCY_UNKNOWN || options.get
    let key = options.idempotencyKey
    if key == "" && options.idempotency != rpc.NO_SIDE_EFFECTS && !options.get && self.keyPrefix != "" {
        self.serial += 1
        key = self.keyPrefix + "-" + Text(self.serial)
        retryable = true
    }
    let request = self.request(procedure, message, options, key)
    let attempt = 0
    while true {
        attempt += 1
        let failure = Failure { error: rpc.failure(rpc.UNKNOWN, ""); headers: []; trailers: [] }
        match self.transport(request) {
            Ok(response) {
                match self.reply(response) {
                    Ok(reply) { return Ok(reply) }
                    Err(problem) { failure = problem }
                }
            }
            Err(error) { failure = Failure { error: error; headers: []; trailers: [] } }
        }
        if failure.error.code != rpc.UNAVAILABLE || !retryable || attempt >= self.attempts { return Err(failure) }
    }
    return Err(Failure { error: rpc.failure(rpc.UNKNOWN, "unreachable"); headers: []; trailers: [] })
}

/// A typed unary call for generated client code.
public function call<Request, Reply>(client: Client, procedure: Text, request: Request, requestCodecs: List<rpc.Codec<Request>>,
        replyCodecs: List<rpc.Codec<Reply>>, options: CallOptions): Result<Reply, Failure> {
    let encoded: Bytes = Bytes()
    let found = false
    for codec in requestCodecs {
        if codec.name == client.codec {
            found = true
            match codec.encode(request) {
                Ok(data) { encoded = data }
                Err(problem) { return Err(Failure { error: rpc.failure(rpc.INTERNAL, "cannot encode request: " + problem.message); headers: []; trailers: [] }) }
            }
        }
    }
    if !found { return Err(Failure { error: rpc.failure(rpc.INTERNAL, "no " + client.codec + " codec for this request"); headers: []; trailers: [] }) }
    let reply = try client.unary(procedure, encoded, options)
    for codec in replyCodecs {
        if codec.name == client.codec {
            return match codec.decode(reply.message) {
                Ok(message) { Ok(message) }
                Err(problem) { Err(Failure { error: rpc.failure(rpc.INTERNAL, "cannot decode reply: " + problem.message); headers: reply.headers; trailers: reply.trailers }) }
            }
        }
    }
    return Err(Failure { error: rpc.failure(rpc.INTERNAL, "no " + client.codec + " codec for this reply"); headers: reply.headers; trailers: reply.trailers })
}

// ---- Streaming client: Connect streams and gRPC over a Wire

/// One HTTP request and its response as they happen, from a transport that
/// streams both ways, such as an HTTP/2 stream. The opener sends the request
/// head; the body follows through `write`. A socket transport's `read`
/// waits for the next event (and ends the call when its timeout passes); a
/// transport that cannot wait, such as one a simulation drives, returns
/// Pending instead.
public record Wire {
    // Request body bytes; false when the exchange is over.
    write: (Bytes) -> Boolean
    // Ends the request body.
    close: () -> Nothing
    // Abandons the exchange, as HTTP/2 RST_STREAM CANCEL does.
    cancel: () -> Nothing
    read: () -> Arrival
}
public choice Arrival {
    Pending
    Head(status: Integer, headers: List<rpc.Header>)
    Data(data: Bytes)
    // The response is complete, with its HTTP trailers (often none).
    Ended(trailers: List<rpc.Header>)
    // The exchange failed: reset, lost connection or timeout.
    Broken(error: rpc.Error)
}

/// The next thing a streaming call has for its caller.
public choice Received<Item> {
    Message(message: Item)
    // Nothing yet, from a transport that cannot wait.
    Waiting
    // The response ended successfully; trailers are complete.
    Finished
    Failed(failure: Failure)
}

/// One streaming call from the client side, in bytes: send request messages,
/// close the sending side, receive replies. Every call kind works this way;
/// unary and client-stream calls receive exactly one message.
public record Stream {
    private client: Client
    private wire: Maybe<Wire>
    private grpc: Boolean
    // A Connect unary call: a plain body each way, not envelopes.
    private plain: Boolean
    private httpStatus: Integer
    private kind: Integer
    private sendClosed: Boolean
    private headSeen: Boolean
    private headers: List<rpc.Header>
    private trailers: List<rpc.Header>
    private input: Bytes
    private replies: List<Bytes>
    // Replies before this index were returned; the list is reset once all are.
    private replyAt: Integer
    private received: Integer
    private decompressor: Maybe<Compressor>
    // Connect: the end-of-stream message arrived.
    private endSeen: Boolean
    // gRPC: the status, once headers or trailers carried it.
    private status: Maybe<rpc.Error>
    private finished: Boolean
    private failure: Maybe<Failure>
}
// Response headers, once they arrived (empty before).
public function Stream.headers(): List<rpc.Header> { return self.headers }
// Response trailers, complete once receive says Finished or Failed.
public function Stream.trailers(): List<rpc.Header> { return self.trailers }
// True until the call finished, failed or was canceled.
public function Stream.active(): Boolean { return !self.finished && self.failure.isNone() }

/// Opens a call of `kind` (rpc.UNARY, SERVER_STREAM, CLIENT_STREAM or
/// BIDI_STREAM). A failure to open shows up on the first receive.
public function Client.stream(procedure: Text, kind: Integer, options: CallOptions): Stream {
    let stream = Stream { client: self; wire: None; grpc: self.protocol == "grpc"; plain: self.protocol != "grpc" && kind == rpc.UNARY
        httpStatus: 0; kind: kind; sendClosed: false; headSeen: false
        headers: []; trailers: []; input: Bytes(); replies: []; replyAt: 0; received: 0; decompressor: None; endSeen: false; status: None
        finished: false; failure: None }
    match self.opener {
        Some(opener) {
            match opener(self.streamRequest(procedure, kind, options), options.timeoutMilliseconds) {
                Ok(wire) { stream.wire = Some(wire) }
                Err(error) { stream.fail(error) }
            }
        }
        None { stream.fail(rpc.failure(rpc.UNIMPLEMENTED, "this client has no streaming transport; make it with streamingClient")) }
    }
    return stream
}
function Client.streamRequest(procedure: Text, kind: Integer, options: CallOptions): Request {
    let headers: List<rpc.Header> = []
    for field in self.headers { headers.add(rpc.Header { name: field.name.asciiLowercased(); value: field.value }) }
    for field in options.headers { headers.add(rpc.Header { name: field.name.asciiLowercased(); value: field.value }) }
    let names: List<Text> = []
    for item in self.compressors { names.add(item.name) }
    if self.protocol == "grpc" {
        headers.add(rpc.Header { name: "content-type"; value: "application/grpc+" + self.codec })
        headers.add(rpc.Header { name: "te"; value: "trailers" })
        if options.timeoutMilliseconds >= 0 { headers.add(rpc.Header { name: "grpc-timeout"; value: grpcTimeout(options.timeoutMilliseconds) }) }
        if self.sendCompression != "" { headers.add(rpc.Header { name: "grpc-encoding"; value: self.sendCompression }) }
        if names.length > 0 { headers.add(rpc.Header { name: "grpc-accept-encoding"; value: joinText(names, ",") }) }
    } else if kind == rpc.UNARY {
        headers.add(rpc.Header { name: "content-type"; value: "application/" + self.codec })
        headers.add(rpc.Header { name: "connect-protocol-version"; value: "1" })
        if options.timeoutMilliseconds >= 0 { headers.add(rpc.Header { name: "connect-timeout-ms"; value: Text(options.timeoutMilliseconds) }) }
        if self.sendCompression != "" { headers.add(rpc.Header { name: "content-encoding"; value: self.sendCompression }) }
        if names.length > 0 { headers.add(rpc.Header { name: "accept-encoding"; value: joinText(names, ", ") }) }
    } else {
        headers.add(rpc.Header { name: "content-type"; value: "application/connect+" + self.codec })
        headers.add(rpc.Header { name: "connect-protocol-version"; value: "1" })
        if options.timeoutMilliseconds >= 0 { headers.add(rpc.Header { name: "connect-timeout-ms"; value: Text(options.timeoutMilliseconds) }) }
        if self.sendCompression != "" { headers.add(rpc.Header { name: "connect-content-encoding"; value: self.sendCompression }) }
        if names.length > 0 { headers.add(rpc.Header { name: "connect-accept-encoding"; value: joinText(names, ",") }) }
    }
    return Request { method: "POST"; target: self.baseUrl + procedure; headers: headers; body: Bytes() }
}
// grpc-timeout: at most eight digits, in the finest unit that fits.
function grpcTimeout(milliseconds: Integer): Text {
    if milliseconds < 100000000 { return Text(milliseconds) + "m" }
    if milliseconds / 1000 < 100000000 { return Text(milliseconds / 1000) + "S" }
    if milliseconds / 60000 < 100000000 { return Text(milliseconds / 60000) + "M" }
    return Text(min(99999999, milliseconds / 3600000)) + "H"
}

/// Sends one request message. False when the call is over or its sending
/// side is closed; receive tells why.
public function Stream.send(message: Bytes): Boolean {
    if self.sendClosed || !self.active() { return false }
    let flags = 0
    let body = message
    // A unary body declared its encoding up front, so it is always compressed.
    let threshold = self.client.compressMinBytes
    if self.plain { threshold = 0 }
    if self.client.sendCompression != "" && message.length >= threshold {
        for compressor in self.client.compressors {
            if compressor.name == self.client.sendCompression {
                match compressor.compress(message) {
                    Ok(packed) {
                        body = packed
                        flags = 1
                    }
                    Err(_) {}
                }
            }
        }
    }
    match self.wire {
        Some(wire) {
            if self.plain {
                // The one request message; the body ends with it.
                let taken = wire.write(body)
                self.closeSend()
                return taken
            }
            return wire.write(envelope(flags, body))
        }
        None { return false }
    }
}
/// Ends the sending side: the server sees the end of the request stream.
public function Stream.closeSend() {
    if self.sendClosed { return }
    self.sendClosed = true
    match self.wire { Some(wire) { wire.close() } None {} }
}
/// Cancels the call: the server sees a reset, and receive returns CANCELED
/// unless the call already finished.
public function Stream.cancel() {
    if !self.active() { return }
    match self.wire { Some(wire) { wire.cancel() } None {} }
    self.replies = []; self.replyAt = 0
    self.fail(rpc.failure(rpc.CANCELED, "the call was canceled"))
}
function Stream.fail(error: rpc.Error) {
    if self.failure.isSome() || self.finished { return }
    self.failure = Some(Failure { error: error; headers: self.headers; trailers: self.trailers })
    self.sendClosed = true
}

/// The next reply, or why there are no more.
public function Stream.receive(): Received<Bytes> {
    while true {
        if self.replyAt < self.replies.length {
            let reply = self.replies[self.replyAt]
            self.replyAt += 1
            if self.replyAt == self.replies.length { self.replies = []; self.replyAt = 0 }
            return Message(reply)
        }
        match self.failure { Some(failure) { return Failed(failure) } None {} }
        if self.finished { return Finished }
        match self.wire.unwrap().read() {
            Pending { return Waiting }
            Head(status, headers) { self.head(status, lowerHeaders(headers)) }
            Data(data) {
                if !self.headSeen { self.fail(rpc.failure(rpc.INTERNAL, "response data before headers")) }
                else if self.plain {
                    if self.input.length + data.length > self.client.maxResponseBytes {
                        self.fail(rpc.failure(rpc.RESOURCE_EXHAUSTED, "response is larger than " + Text(self.client.maxResponseBytes) + " bytes"))
                    } else { self.input.addBytes(data) }
                } else if self.endSeen || self.status.isSome() { self.fail(rpc.failure(rpc.INTERNAL, "response data after the end of the stream")) }
                else {
                    self.input.addBytes(data)
                    self.messages()
                }
            }
            Ended(trailers) {
                if self.plain { self.plainEnd() } else { self.end(lowerHeaders(trailers)) }
            }
            Broken(error) { self.fail(error) }
        }
    }
    return Finished
}
function Stream.head(status: Integer, headers: List<rpc.Header>) {
    if self.headSeen { return }
    self.headSeen = true
    if self.plain {
        // Settled when the body is complete, as Client.reply does.
        self.httpStatus = status
        self.headers = headersOf(headers)
        self.trailers = trailersOf(headers)
        return
    }
    if self.grpc {
        // A trailers-only response carries its status in the headers.
        if rpc.headerValue(headers, "grpc-status") != "" {
            self.trailers = headers
            self.status = Some(grpcStatus(headers))
        } else { self.headers = headers }
    } else { self.headers = headers }
    if status != 200 {
        let code = codeForStatus(status)
        if self.grpc { code = grpcCodeForStatus(status) }
        self.fail(rpc.failure(code, "HTTP status " + Text(status)))
        return
    }
    let contentType = rpc.headerValue(headers, "content-type")
    if self.grpc {
        if contentType != "application/grpc" && !contentType.startsWith("application/grpc+") && !contentType.startsWith("application/grpc;") {
            self.fail(rpc.failure(rpc.UNKNOWN, "unexpected response content-type " + contentType))
            return
        }
    } else if codecFromContentType(contentType, true) != self.client.codec {
        self.fail(rpc.failure(rpc.INTERNAL, "unexpected response content-type " + contentType))
        return
    }
    let encodingHeader = "connect-content-encoding"
    if self.grpc { encodingHeader = "grpc-encoding" }
    let encoding = rpc.headerValue(headers, encodingHeader).asciiLowercased()
    if encoding != "" && encoding != "identity" {
        for compressor in self.client.compressors { if compressor.name == encoding { self.decompressor = Some(compressor) } }
        if self.decompressor.isNone() { self.fail(rpc.failure(rpc.INTERNAL, "unknown response compression " + encoding)) }
    }
}
// Splits complete envelopes off the input into replies or the end message.
function Stream.messages() {
    // A cursor, and one copy of the unread tail at the end: taking each
    // envelope off the front would copy the rest of the input once per message.
    let input = self.input
    let at = 0
    while input.length - at >= 5 && self.active() && !self.endSeen {
        let flags = input[at]
        let length = (input[at + 1] << 24) | (input[at + 2] << 16) | (input[at + 3] << 8) | input[at + 4]
        if length > self.client.maxResponseBytes {
            self.fail(rpc.failure(rpc.RESOURCE_EXHAUSTED, "response message is larger than " + Text(self.client.maxResponseBytes) + " bytes"))
            break
        }
        if input.length - at < 5 + length { break }
        let data = input.slice(at + 5, at + 5 + length)
        at += 5 + length
        let ending = !self.grpc && (flags & 2) == 2
        if (flags & 1) == 1 {
            match self.decompressor {
                Some(compressor) {
                    match compressor.decompress(data, self.client.maxResponseBytes) {
                        Ok(expanded) { data = expanded }
                        Err(problem) {
                            let code = rpc.INTERNAL
                            if errors.code(problem) == errors.overflowCode() { code = rpc.RESOURCE_EXHAUSTED }
                            self.fail(rpc.failure(code, "cannot decompress response: " + problem.message()))
                            break
                        }
                    }
                }
                None {
                    self.fail(rpc.failure(rpc.INTERNAL, "compressed response message without an encoding"))
                    break
                }
            }
        }
        if ending {
            self.endSeen = true
            self.input = input.slice(at, input.length)
            self.endMessage(data)
            return
        }
        if (flags & 254) != 0 {
            self.fail(rpc.failure(rpc.INTERNAL, "unexpected envelope flags " + Text(flags)))
            break
        }
        self.received += 1
        if (self.kind == rpc.UNARY || self.kind == rpc.CLIENT_STREAM) && self.received > 1 {
            self.fail(rpc.failure(rpc.UNIMPLEMENTED, "more than one response message"))
            break
        }
        self.replies.add(data)
    }
    if at > 0 { self.input = input.slice(at, input.length) }
}
// A Connect end-of-stream message: an optional error and the trailers.
function Stream.endMessage(data: Bytes) {
    match json.decodeBytes(data, data.length + 1) {
        Ok(value) {
            if value.kind != json.OBJECT {
                self.fail(rpc.failure(rpc.INTERNAL, "malformed end-of-stream message"))
                return
            }
            if value.hasMember("metadata") {
                let metadata = value.member("metadata")
                if metadata.kind == json.OBJECT {
                    for index in 0..metadata.keys.length {
                        let values = metadata.items[index]
                        if values.kind != json.ARRAY { continue }
                        for item in values.items {
                            if item.kind == json.STRING { self.trailers.add(rpc.Header { name: metadata.keys[index].asciiLowercased(); value: item.text }) }
                        }
                    }
                }
            }
            if value.hasMember("error") {
                match errorValue(value.member("error")) {
                    Some(error) { self.status = Some(error) }
                    None { self.status = Some(rpc.failure(rpc.UNKNOWN, "malformed error in the end-of-stream message")) }
                }
            }
        }
        Err(_) { self.fail(rpc.failure(rpc.INTERNAL, "malformed end-of-stream message")) }
    }
}
// A Connect unary response is complete: its body is the reply or the error.
function Stream.plainEnd() {
    if !self.active() { return }
    if !self.headSeen {
        self.fail(rpc.failure(rpc.INTERNAL, "the response ended without headers"))
        return
    }
    let headers: List<rpc.Header> = []
    for field in self.headers { headers.add(field) }
    for field in self.trailers { headers.add(rpc.Header { name: "trailer-" + field.name; value: field.value }) }
    match self.client.reply(Response { status: self.httpStatus; headers: headers; body: self.input }) {
        Ok(reply) {
            self.input = Bytes()
            self.received = 1
            self.replies.add(reply.message)
            self.finished = true
        }
        Err(failure) { self.fail(failure.error) }
    }
}
// The response ended: settle the call's outcome.
function Stream.end(trailers: List<rpc.Header>) {
    if !self.active() { return }
    if !self.headSeen {
        self.fail(rpc.failure(rpc.INTERNAL, "the response ended without headers"))
        return
    }
    if self.grpc && self.status.isNone() {
        self.trailers = trailers
        if rpc.headerValue(trailers, "grpc-status") == "" {
            self.fail(rpc.failure(rpc.INTERNAL, "the response has no grpc-status"))
            return
        }
        self.status = Some(grpcStatus(trailers))
    }
    if self.input.length > 0 {
        self.fail(rpc.failure(rpc.INTERNAL, "incomplete response message"))
        return
    }
    if !self.grpc && !self.endSeen {
        self.fail(rpc.failure(rpc.INTERNAL, "the response ended without an end-of-stream message"))
        return
    }
    match self.status {
        Some(error) {
            if error.code != rpc.OK {
                self.replies = []; self.replyAt = 0
                self.fail(error)
                return
            }
        }
        None {}
    }
    if (self.kind == rpc.UNARY || self.kind == rpc.CLIENT_STREAM) && self.received == 0 {
        self.fail(rpc.failure(rpc.UNIMPLEMENTED, "the response has no message"))
        return
    }
    self.finished = true
}

// ---- gRPC status

// The code a gRPC client infers from an HTTP status other than 200.
public function grpcCodeForStatus(status: Integer): Integer {
    if status == 400 { return rpc.INTERNAL }
    if status == 401 { return rpc.UNAUTHENTICATED }
    if status == 403 { return rpc.PERMISSION_DENIED }
    if status == 404 { return rpc.UNIMPLEMENTED }
    if status == 429 || status == 502 || status == 503 || status == 504 { return rpc.UNAVAILABLE }
    return rpc.UNKNOWN
}
// The status in gRPC trailers: grpc-status, grpc-message (percent-encoded)
// and grpc-status-details-bin (a base64 google.rpc.Status). Code 0 is OK.
function grpcStatus(trailers: List<rpc.Header>): rpc.Error {
    let text = rpc.headerValue(trailers, "grpc-status")
    let code = timeoutMilliseconds(text)
    if code < 0 || code > 16 { return rpc.failure(rpc.UNKNOWN, "invalid grpc-status " + text) }
    let message = percentDecoded(rpc.headerValue(trailers, "grpc-message"))
    let error = rpc.Error { code: code; message: message; details: [] }
    let encoded = rpc.headerValue(trailers, "grpc-status-details-bin")
    if encoded != "" {
        match unbase64(encoded) {
            Some(data) { statusDetails(data, error) }
            None {}
        }
    }
    return error
}
function percentDecoded(value: Text): Text {
    if value.find("%") < 0 { return value }
    let input = Bytes(value)
    let out = Bytes()
    let at = 0
    while at < input.length {
        if input[at] == 37 && at + 2 < input.length && hexValue(input[at + 1]) >= 0 && hexValue(input[at + 2]) >= 0 {
            out.add(hexValue(input[at + 1]) * 16 + hexValue(input[at + 2]))
            at += 3
        } else {
            out.add(input[at])
            at += 1
        }
    }
    return match utf8.decode(out) {
        Ok(text) { text }
        Err(_) { value }
    }
}
record Field { number: Integer; wire: Integer; value: Integer; data: Bytes }
// The fields of one Protobuf message: varints and length-delimited values;
// None when malformed or another wire type.
function fields(data: Bytes): Maybe<List<Field>> {
    let found: List<Field> = []
    let at = 0
    while at < data.length {
        let tag = 0
        let shift = 0
        while true {
            if at >= data.length || shift > 63 { return None }
            tag = tag | ((data[at] & 127) << shift)
            at += 1
            if (data[at - 1] & 128) == 0 { break }
            shift += 7
        }
        let wire = tag & 7
        let value = 0
        shift = 0
        if wire != 0 && wire != 2 { return None }
        while true {
            if at >= data.length || shift > 63 { return None }
            value = value | ((data[at] & 127) << shift)
            at += 1
            if (data[at - 1] & 128) == 0 { break }
            shift += 7
        }
        if wire == 0 { found.add(Field { number: tag >> 3; wire: 0; value: value; data: Bytes() }) }
        else {
            if value < 0 || value > data.length - at { return None }
            found.add(Field { number: tag >> 3; wire: 2; value: value; data: data.slice(at, at + value) })
            at += value
        }
    }
    return Some(found)
}
// google.rpc.Status { code = 1; message = 2; repeated google.protobuf.Any details = 3 }.
function statusDetails(data: Bytes, error: rpc.Error) {
    match fields(data) {
        Some(found) {
            for field in found {
                if field.number != 3 || field.wire != 2 { continue }
                let type = ""
                let value = Bytes()
                match fields(field.data) {
                    Some(any) {
                        for part in any {
                            if part.number == 1 && part.wire == 2 { type = utf8.decodeOrStop(part.data) }
                            if part.number == 2 && part.wire == 2 { value = part.data }
                        }
                    }
                    None { continue }
                }
                let slash = type.find("/")
                while slash >= 0 {
                    type = type.slice(slash + 1, type.length)
                    slash = type.find("/")
                }
                error.details.add(rpc.Detail { type: type; value: value })
            }
        }
        None {}
    }
}

// ---- Calls over a Wire

// A unary transport over an opener: the whole request, then the whole response.
function wireTransport(opener: (Request, Integer) -> Result<Wire, rpc.Error>): (Request) -> Result<Response, rpc.Error> {
    return function(request: Request): Result<Response, rpc.Error> {
        let timeout = timeoutMilliseconds(rpc.headerValue(request.headers, "connect-timeout-ms"))
        let head = Request { method: request.method; target: request.target; headers: request.headers; body: Bytes() }
        let wire = try opener(head, max(-1, timeout))
        if request.body.length > 0 && !wire.write(request.body) { return Err(rpc.failure(rpc.UNAVAILABLE, "the request could not be sent")) }
        wire.close()
        let response = Response { status: 0; headers: []; body: Bytes() }
        while true {
            match wire.read() {
                Pending { return Err(rpc.failure(rpc.UNIMPLEMENTED, "unary calls need a transport that waits")) }
                Head(status, headers) {
                    response.status = status
                    response.headers = headers
                }
                Data(data) { response.body.addBytes(data) }
                Ended(_) { return Ok(response) }
                Broken(error) { return Err(error) }
            }
        }
        return Err(rpc.failure(rpc.UNKNOWN, "unreachable"))
    }
}
// A gRPC unary call: one message each way over a stream.
function Client.grpcUnary(procedure: Text, message: Bytes, options: CallOptions): Result<Reply, Failure> {
    let retryable = options.idempotency != rpc.IDEMPOTENCY_UNKNOWN
    let attempt = 0
    while true {
        attempt += 1
        let stream = self.stream(procedure, rpc.UNARY, options)
        stream.send(message)
        stream.closeSend()
        let reply: Maybe<Bytes> = None
        let failure = Failure { error: rpc.failure(rpc.UNKNOWN, ""); headers: []; trailers: [] }
        let waiting = true
        while waiting {
            match stream.receive() {
                Message(data) { reply = Some(data) }
                Waiting {
                    stream.cancel()
                    return Err(Failure { error: rpc.failure(rpc.UNIMPLEMENTED, "unary calls need a transport that waits"); headers: []; trailers: [] })
                }
                Finished { return Ok(Reply { message: reply.unwrap(); headers: stream.headers; trailers: stream.trailers }) }
                Failed(problem) {
                    failure = problem
                    waiting = false
                }
            }
        }
        if failure.error.code != rpc.UNAVAILABLE || !retryable || attempt >= self.attempts { return Err(failure) }
    }
    return Err(Failure { error: rpc.failure(rpc.UNKNOWN, "unreachable"); headers: []; trailers: [] })
}

// ---- Typed streaming calls for generated client code

/// A streaming call with typed messages: use send, receive and reply, and the
/// Stream for closeSend, cancel, headers and trailers.
public record StreamCall<Request, Reply> {
    stream: Stream
    private requests: List<rpc.Codec<Request>>
    private replies: List<rpc.Codec<Reply>>
}
/// Opens a client-streaming or bidirectional call.
public function open<Request, Reply>(client: Client, procedure: Text, kind: Integer, requestCodecs: List<rpc.Codec<Request>>,
        replyCodecs: List<rpc.Codec<Reply>>, options: CallOptions): StreamCall<Request, Reply> {
    return StreamCall<Request, Reply> { stream: client.stream(procedure, kind, options); requests: requestCodecs; replies: replyCodecs }
}
/// Opens a server-streaming call: sends its one request and closes the sending side.
public function serverStream<Request, Reply>(client: Client, procedure: Text, request: Request, requestCodecs: List<rpc.Codec<Request>>,
        replyCodecs: List<rpc.Codec<Reply>>, options: CallOptions): StreamCall<Request, Reply> {
    let call = open(client, procedure, rpc.SERVER_STREAM, requestCodecs, replyCodecs, options)
    send(call, request)
    call.stream.closeSend()
    return call
}
/// Encodes and sends one request message; false when the call is over. An
/// encoding failure cancels the call and receive reports INTERNAL.
public function send<Request, Reply>(call: StreamCall<Request, Reply>, message: Request): Boolean {
    for codec in call.requests {
        if codec.name == call.stream.client.codec {
            match codec.encode(message) {
                Ok(data) { return call.stream.send(data) }
                Err(problem) {
                    call.stream.cancel()
                    call.stream.failure = Some(Failure { error: rpc.failure(rpc.INTERNAL, "cannot encode request: " + problem.message); headers: []; trailers: [] })
                    return false
                }
            }
        }
    }
    call.stream.cancel()
    call.stream.failure = Some(Failure { error: rpc.failure(rpc.INTERNAL, "no " + call.stream.client.codec + " codec for this request"); headers: []; trailers: [] })
    return false
}
/// The next reply, decoded.
public function receive<Request, Reply>(call: StreamCall<Request, Reply>): Received<Reply> {
    match call.stream.receive() {
        Message(data) {
            for codec in call.replies {
                if codec.name == call.stream.client.codec {
                    match codec.decode(data) {
                        Ok(message) {
                            let typed: Received<Reply> = Message(message)
                            return typed
                        }
                        Err(problem) {
                            call.stream.cancel()
                            let failure = Failure { error: rpc.failure(rpc.INTERNAL, "cannot decode reply: " + problem.message); headers: call.stream.headers; trailers: call.stream.trailers }
                            call.stream.failure = Some(failure)
                            return Failed(failure)
                        }
                    }
                }
            }
            return Failed(Failure { error: rpc.failure(rpc.INTERNAL, "no " + call.stream.client.codec + " codec for this reply"); headers: []; trailers: [] })
        }
        Waiting { return Waiting }
        Finished { return Finished }
        Failed(failure) { return Failed(failure) }
    }
    return Finished
}
/// Closes the sending side of a client-streaming call and waits for its one
/// reply. It needs a transport that waits.
public function reply<Request, Reply>(call: StreamCall<Request, Reply>): Result<Reply, Failure> {
    call.stream.closeSend()
    let answer: Maybe<Reply> = None
    while true {
        match receive(call) {
            Message(message) { answer = Some(message) }
            Waiting { return Err(Failure { error: rpc.failure(rpc.UNIMPLEMENTED, "reply needs a transport that waits; use receive"); headers: []; trailers: [] }) }
            Finished { return Ok(answer.unwrap()) }
            Failed(failure) { return Err(failure) }
        }
    }
    return Err(Failure { error: rpc.failure(rpc.UNKNOWN, "unreachable"); headers: []; trailers: [] })
}
