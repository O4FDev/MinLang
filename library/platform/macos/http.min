use "errors" as errors
use "text" as textTools
use "json" as json

// HTTP and HTTPS requests on macOS. Import it with `use "http" as http`.
//
// ./minyar puts library/platform/macos before library on macOS, so this file
// replaces the portable library/http.min there. Both provide Response, get,
// post, request and bounded downloads. Both validate TLS certificates and answer
// unsupported URLs with a failed Response. This backend also streams, follows
// redirects and decodes chunked bodies. Ordinary requests use a 60-second timeout.
//
//     let response = http.get("https://example.com/", ["Accept: text/html"])
//     print(response.status)
//     match text.decode(response.body) { Ok(body) { print(body) } Err(error) { print("binary body") } }
//
// Headers are written "Name: value" and request bodies are Text. Response bodies
// are Bytes. On macOS requests go
// through NSURLSession: TLS certificates are validated, redirects are
// followed, HTTP/2 is used where the server offers it, and cookies persist for
// the application, as in a browser. Responses are not cached: every request
// reaches the server, as with the portable client.
//
// get, post and request wait for the whole response. A desktop program can
// instead start a request and keep handling events: read returns the body as
// it arrives, which suits streamed responses, and a waiting macos.nextEvent
// returns early when a request makes progress.
//
//     let request = http.start("GET", url, [], "")
//     while !http.finished(request) { ... print(http.read(request)) ... }
//     http.close(request)

public record Response {
    status: Integer
    reason: Text
    headers: List<Text>
    body: Bytes
    // Empty unless the request failed before a complete response arrived.
    error: Text
}

public record Reply { status: Integer; reason: Text; headers: List<Text>; body: Bytes }
function typedResponse(response: Response): Result<Reply, errors.Error> {
    if response.status == 0 || response.error != "" {
        let message = response.error
        if message == "" { message = "the request did not return a complete response" }
        return Err(errors.make(errors.unavailableCode(), 0, message))
    }
    return Ok(Reply { status: response.status; reason: response.reason; headers: response.headers; body: response.body })
}
public function fetch(url: Text, headers: List<Text>): Result<Reply, errors.Error> { return typedResponse(get(url, headers)) }
public function postText(url: Text, headers: List<Text>, body: Text): Result<Reply, errors.Error> { return typedResponse(post(url, headers, body)) }
public function send(method: Text, url: Text, headers: List<Text>, body: Text): Result<Reply, errors.Error> { return typedResponse(request(method, url, headers, body)) }
public function fetchBounded(url: Text, headers: List<Text>, limit: Integer): Result<Reply, errors.Error> { return typedResponse(getBounded(url, headers, limit)) }
public function fetchWithin(url: Text, headers: List<Text>, limit: Integer, timeoutMs: Integer): Result<Reply, errors.Error> { return typedResponse(getBoundedWithin(url, headers, limit, timeoutMs)) }
public function Reply.text(): Result<Text, errors.Error> { return textTools.decode(self.body) }
public function Reply.json(): Result<json.Value, errors.Error> { return json.decodeBytes(self.body, 134217728) }

public function get(url: Text, headers: List<Text>): Response {
    return request("GET", url, headers, "")
}

public function post(url: Text, headers: List<Text>, body: Text): Response {
    return request("POST", url, headers, body)
}

public function request(method: Text, url: Text, headers: List<Text>, body: Text): Response {
    // Like the portable backend, an unsupported URL is a failed response.
    if !supported(url) {
        return Response { status: 0; reason: ""; headers: []; body: Bytes(); error: "only http:// and https:// URLs are supported: " + url }
    }
    let handle = start(method, url, headers, body)
    return collect(handle)
}

function failed(message: Text): Response {
    return Response { status: 0; reason: ""; headers: []; body: Bytes(); error: message }
}

// The same size/deadline API as the portable package. The limit counts decoded
// response bytes, preserved in Bytes without decoding. Native buffering
// checks it before appending. Headers are capped at 32 KiB; redirects share a deadline.
public function getBounded(url: Text, headers: List<Text>, limit: Integer): Response {
    return getBoundedWithin(url, headers, limit, 30000)
}

public function getBoundedWithin(url: Text, headers: List<Text>, limit: Integer, timeoutMs: Integer): Response {
    if limit < 1 || limit > 134217728 { return failed("invalid download size limit") }
    if timeoutMs < 1 || timeoutMs > 300000 { return failed("invalid download timeout") }
    if !supported(url) { return failed("only http:// and https:// URLs are supported: " + url) }
    let lines: List<Text> = []
    for header in headers { lines.add(header); lines.add("\n") }
    let handle = beginBounded(url, joinText(lines), limit, timeoutMs)
    let response = collect(handle)
    if response.error != "" { return failed(response.error) }
    return response
}

function collect(handle: Integer): Response {
    while !wait(handle, 60.0) {}
    let lines: List<Text> = []
    let all = headerText(handle)
    let begin = 0
    for position in 0..all.length {
        if all[position] == '\n' {
            lines.add(all.slice(begin, position))
            begin = position + 1
        }
    }
    if begin < all.length { lines.add(all.slice(begin, all.length)) }
    let response = Response { status: status(handle); reason: reason(handle); headers: lines; body: readBytes(handle); error: error(handle) }
    close(handle)
    return response
}

// An http:// or https:// URL with a host.
function supported(url: Text): Boolean {
    let length = 0
    if url.length > 7 && url.slice(0, 7) == "http://" { length = 7 }
    if url.length > 8 && url.slice(0, 8) == "https://" { length = 8 }
    return length > 0 && url[length] != '/'
}

// Start a request in the background and return its handle.
public function start(method: Text, url: Text, headers: List<Text>, body: Text): Integer {
    let lines: List<Text> = []
    for header in headers {
        lines.add(header)
        lines.add("\n")
    }
    return begin(method, url, joinText(lines), body)
}

// OS TLS with an opaque keychain.signingReference. Intermediates are public
// DER certificates excluding the leaf (which the identity already contains).
// The credential is scoped to this HTTPS origin and its own NSURLSession.
// An inaccessible identity becomes a completed request with error(handle).
public function startWithIdentity(method: Text, url: Text, headers: List<Text>, body: Text, signer: Bytes, intermediates: List<Bytes>): Integer {
    let lines: List<Text> = []
    for header in headers { lines.add(header); lines.add("\n") }
    let total = 4
    if intermediates.length > 16 {
        return beginWithIdentity(method, url, joinText(lines), body, Bytes(), Bytes())
    }
    for certificate in intermediates {
        if certificate.length == 0 || certificate.length > 1048576 - total - 4 {
            return beginWithIdentity(method, url, joinText(lines), body, Bytes(), Bytes())
        }
        total += certificate.length + 4
    }
    let encoded = Bytes()
    encoded.addUInt32(intermediates.length)
    for certificate in intermediates {
        encoded.addUInt32(certificate.length)
        encoded.addBytes(certificate)
    }
    return beginWithIdentity(method, url, joinText(lines), body, signer, encoded)
}

function begin(method: Text, url: Text, headers: Text, body: Text): Integer {
    native "http"
}
function beginBounded(url: Text, headers: Text, limit: Integer, timeoutMs: Integer): Integer {
    native "http"
}
function beginWithIdentity(method: Text, url: Text, headers: Text, body: Text, signer: Bytes, intermediates: Bytes): Integer {
    native "http"
}

// Wait up to `seconds` for a request to finish; true once it has.
public function wait(request: Integer, seconds: Float): Boolean {
    native "http"
}

// Whether the request has finished, successfully or not.
public function finished(request: Integer): Boolean {
    native "http"
}

// The HTTP status, or 0 until the response begins (and if it never does).
public function status(request: Integer): Integer {
    native "http"
}

public function reason(request: Integer): Text {
    native "http"
}

// A response header's value, ignoring case in its name, or "".
public function header(request: Integer, name: Text): Text {
    native "http"
}

function headerText(request: Integer): Text {
    native "http"
}

// Body text received since the last read. Characters split between network
// packets are held back until they are complete.
public function read(request: Integer): Text {
    native "http"
}

// Raw bytes received since the last read, without decoding or replacement.
public function readBytes(request: Integer): Bytes {
    native "http"
}

// Why the request failed, or "" if it has not.
public function error(request: Integer): Text {
    native "http"
}

// Stop a request; it finishes with the error "cancelled".
public function cancel(request: Integer) {
    native "http"
}

// Release a request, cancelling it if it is still running. Its handle ends.
public function close(request: Integer) {
    native "http"
}
