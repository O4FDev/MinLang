// Recoverable failures are values. Check the result before extracting its
// value; programmer errors still stop the program. These concrete result
// records need no new compiler feature. See docs/research/runtime-concurrency-errors.md.
// Private fields keep tags consistent and prevent callers forging success.

public record Error {
    private code: Integer
    private nativeCode: Integer
    private message: Text
}

public function none(): Error {
    return Error { code: 0; nativeCode: 0; message: "" }
}

// Positive unknown codes are preserved, so a newer producer can report a
// failure to an older caller. The OS code is diagnostic data, not the tag.
public function make(code: Integer, nativeCode: Integer, message: Text): Error {
    if code <= 0 { fail("an error code must be positive") }
    return Error { code: code; nativeCode: nativeCode; message: message }
}

public function code(error: Error): Integer { return error.code }
public function nativeCode(error: Error): Integer { return error.nativeCode }
public function message(error: Error): Text { return error.message }
public function isError(error: Error): Boolean { return error.code != 0 }
public function isWouldBlock(error: Error): Boolean { return error.code == 1 }

public function wouldBlockCode(): Integer { return 1 }
public function interruptedCode(): Integer { return 2 }
public function timedOutCode(): Integer { return 3 }
public function closedCode(): Integer { return 4 }
public function cancelledCode(): Integer { return 5 }
public function invalidDataCode(): Integer { return 6 }
public function systemCode(): Integer { return 7 }
public function permissionDeniedCode(): Integer { return 8 }
public function unavailableCode(): Integer { return 9 }
public function protocolCode(): Integer { return 10 }
public function certificateCode(): Integer { return 11 }
public function truncatedCode(): Integer { return 12 }

function requireError(error: Error) {
    if !isError(error) { fail("a failure result requires an error") }
}

public record IntegerResult {
    private value: Integer
    private error: Error
}

public function integer(value: Integer): IntegerResult {
    return IntegerResult { value: value; error: none() }
}
public function integerFailure(error: Error): IntegerResult {
    requireError(error)
    return IntegerResult { value: 0; error: error }
}
public function integerOk(result: IntegerResult): Boolean { return !isError(result.error) }
public function integerError(result: IntegerResult): Error { return result.error }
public function integerValue(result: IntegerResult): Integer {
    if !integerOk(result) { fail("cannot read the value of a failed IntegerResult") }
    return result.value
}

public record BooleanResult {
    private value: Boolean
    private error: Error
}

public function boolean(value: Boolean): BooleanResult {
    return BooleanResult { value: value; error: none() }
}
public function booleanFailure(error: Error): BooleanResult {
    requireError(error)
    return BooleanResult { value: false; error: error }
}
public function booleanOk(result: BooleanResult): Boolean { return !isError(result.error) }
public function booleanError(result: BooleanResult): Error { return result.error }
public function booleanValue(result: BooleanResult): Boolean {
    if !booleanOk(result) { fail("cannot read the value of a failed BooleanResult") }
    return result.value
}

// The status is independent of byte length. In particular a zero-length UDP
// datagram is SUCCESS, not END_OF_STREAM. TRUNCATED carries a readable prefix,
// but is not a complete successful read. WOULD_BLOCK is a scheduling outcome.
public function successStatus(): Integer { return 0 }
public function wouldBlockStatus(): Integer { return 1 }
public function endOfStreamStatus(): Integer { return 2 }
public function failureStatus(): Integer { return 3 }
public function truncatedStatus(): Integer { return 4 }

public record BytesResult {
    private status: Integer
    private value: Bytes
    private error: Error
}

public function bytes(value: Bytes): BytesResult {
    return BytesResult { status: 0; value: value; error: none() }
}
public function endOfStream(): BytesResult {
    return BytesResult { status: 2; value: Bytes(); error: none() }
}
public function wouldBlock(nativeCode: Integer): BytesResult {
    return BytesResult { status: 1; value: Bytes(); error: make(1, nativeCode, "operation would block") }
}
public function bytesFailure(error: Error): BytesResult {
    requireError(error)
    return BytesResult { status: 3; value: Bytes(); error: error }
}
public function truncated(value: Bytes, nativeCode: Integer): BytesResult {
    return BytesResult { status: 4; value: value; error: make(12, nativeCode, "datagram was truncated") }
}
public function bytesStatus(result: BytesResult): Integer { return result.status }
public function bytesError(result: BytesResult): Error { return result.error }
public function bytesOk(result: BytesResult): Boolean { return result.status == 0 || result.status == 2 }
public function bytesValue(result: BytesResult): Bytes {
    if result.status == 1 || result.status == 3 { fail("this BytesResult has no readable data") }
    return result.value
}
