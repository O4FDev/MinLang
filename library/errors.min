// Recoverable failures are values. Check the result before extracting its
// value; programmer errors still stop the program. ValueResult shares the
// value/error layout; the established names remain transparent aliases.
// Private fields keep tags consistent and prevent callers forging success.

/// A recoverable failure with a stable code, a native code and a message.
/// Use the public factories and methods to preserve its invariants. The native
/// code is diagnostic information; the stable code identifies the kind of failure.
public record Error {
    private code: Integer
    private nativeCode: Integer
    private message: Text
    private contextData: Text
}

/// The absence of an error: code zero, native code zero and an empty message.
public function none(): Error {
    return Error { code: 0; nativeCode: 0; message: ""; contextData: "" }
}

// Positive unknown codes are preserved, so a newer producer can report a
// failure to an older caller. The OS code is diagnostic data, not the tag.
/// Create an error from a positive stable code, native code and message.
/// Unknown positive codes are preserved so newer producers can report failures
/// to older callers.
///
/// ```minyar
/// let error = api.make(api.systemCode(), 2, "No lantern here.")
/// print(error.message())
/// ```
/// ```output
/// No lantern here.
/// ```
public function make(code: Integer, nativeCode: Integer, message: Text): Error {
    if code <= 0 { fail("an error code must be positive") }
    return Error { code: code; nativeCode: nativeCode; message: message; contextData: "" }
}

// Context is persistent: adding a layer never changes another error alias.
// Length-prefixed Text keeps Error finite and Hashable, including messages
// containing newlines, colons and zero bytes. Only this module writes it.
/// Add an outer operation to a failure without changing its code, native code or message.
/// An error-free value stays error-free; the original Error stays unchanged.
public function withContext(error: Error, context: Text): Error {
    if !isError(error) { return error }
    return Error {
        code: error.code; nativeCode: error.nativeCode; message: error.message
        contextData: Text(context.length) + ":" + context + error.contextData
    }
}

// Return a fresh List, from the outermost operation to the innermost one.
/// Return a fresh List of operation names, outermost first.
/// Changing that List cannot change the Error.
public function contexts(error: Error): List<Text> {
    let messages: List<Text> = []
    let position = 0
    let data = error.contextData
    while position < data.length {
        let length = 0
        while data[position] != ':' {
            length = length * 10 + Integer(data[position]) - 48
            position += 1
        }
        position += 1
        messages.add(data.slice(position, position + length))
        position += length
    }
    return messages
}

/// Describe the outer operations and original message, indenting each inner step by two spaces.
public function describe(error: Error): Text {
    let parts: List<Text> = []
    let indent = ""
    for context in contexts(error) {
        parts.add(indent + context + "\n")
        indent += "  "
    }
    parts.add(indent + error.message)
    return joinText(parts)
}

/// The stable error code, or zero when there is no error.
public function code(error: Error): Integer { return error.code }
/// The original platform error code, kept for diagnosis.
public function nativeCode(error: Error): Integer { return error.nativeCode }
/// The original human-readable message. `Error.message()` is the same operation in method form.
public function message(error: Error): Text { return error.message }
/// Whether a value represents a failure rather than `none()`.
public function isError(error: Error): Boolean { return error.code != 0 }
public function isWouldBlock(error: Error): Boolean { return error.code == 1 }

public function wouldBlockCode(): Integer { return 1 }
public function interruptedCode(): Integer { return 2 }
public function timedOutCode(): Integer { return 3 }
public function closedCode(): Integer { return 4 }
public function cancelledCode(): Integer { return 5 }
public function invalidDataCode(): Integer { return 6 }
public function systemCode(): Integer { return 7 }
public function permissionDeniedCode(): Integer { return 8 }
public function unavailableCode(): Integer { return 9 }
public function protocolCode(): Integer { return 10 }
public function certificateCode(): Integer { return 11 }
public function truncatedCode(): Integer { return 12 }
public function overflowCode(): Integer { return 13 }
public function callDepthCode(): Integer { return 14 }

function requireError(error: Error) {
    if !isError(error) { fail("a failure result requires an error") }
}

/// A checked value stored beside an Error. Call `ok(result)` before `value(result)`;
/// reading a failed value stops the program.
public record ValueResult<Item> {
    private value: Item
    private error: Error
}

public type IntegerResult = ValueResult<Integer>
public type BooleanResult = ValueResult<Boolean>

public function success<Item>(value: Item): ValueResult<Item> {
    return ValueResult { value: value; error: none() }
}
public function failure<Item>(fallback: Item, error: Error): ValueResult<Item> {
    requireError(error)
    return ValueResult { value: fallback; error: error }
}
public function ok<Item>(result: ValueResult<Item>): Boolean { return !isError(result.error) }
public function error<Item>(result: ValueResult<Item>): Error { return result.error }
public function value<Item>(result: ValueResult<Item>): Item {
    if !ok(result) { fail("cannot read the value of a failed ValueResult") }
    return result.value
}

public function integer(value: Integer): IntegerResult {
    return success(value)
}
public function integerFailure(error: Error): IntegerResult {
    return failure(0, error)
}
public function integerOk(result: IntegerResult): Boolean { return ok(result) }
public function integerError(result: IntegerResult): Error { return error(result) }
public function integerValue(result: IntegerResult): Integer {
    if !integerOk(result) { fail("cannot read the value of a failed IntegerResult") }
    return result.value
}

// Signed 64-bit overflow is a recoverable value for these explicit APIs.
// Ordinary +, - and * still stop on overflow; wrapping helpers still wrap.
// The compiler lowers these private scalar flags to LLVM signed overflow
// intrinsics. No native runtime library or foreign Result layout is involved.
function addOverflows(left: Integer, right: Integer): Boolean { native "integer_overflow" }
function subtractOverflows(left: Integer, right: Integer): Boolean { native "integer_overflow" }
function multiplyOverflows(left: Integer, right: Integer): Boolean { native "integer_overflow" }

/// Add two Integers without losing control on signed overflow.
/// The checked result carries `overflowCode()` when the sum cannot fit.
///
/// ```minyar
/// let sum = api.checkedAdd(20, 22)
/// if api.integerOk(sum) { print(api.integerValue(sum)) }
/// ```
/// ```output
/// 42
/// ```
public function checkedAdd(left: Integer, right: Integer): IntegerResult {
    if addOverflows(left, right) {
        return integerFailure(make(overflowCode(), 0, "Integer addition overflow"))
    }
    return integer(wrappingAdd(left, right))
}

public function checkedSubtract(left: Integer, right: Integer): IntegerResult {
    if subtractOverflows(left, right) {
        return integerFailure(make(overflowCode(), 0, "Integer subtraction overflow"))
    }
    return integer(wrappingSubtract(left, right))
}

public function checkedMultiply(left: Integer, right: Integer): IntegerResult {
    if multiplyOverflows(left, right) {
        return integerFailure(make(overflowCode(), 0, "Integer multiplication overflow"))
    }
    return integer(wrappingMultiply(left, right))
}

public function boolean(value: Boolean): BooleanResult {
    return success(value)
}
public function booleanFailure(error: Error): BooleanResult {
    return failure(false, error)
}
public function booleanOk(result: BooleanResult): Boolean { return ok(result) }
public function booleanError(result: BooleanResult): Error { return error(result) }
public function booleanValue(result: BooleanResult): Boolean {
    if !booleanOk(result) { fail("cannot read the value of a failed BooleanResult") }
    return result.value
}

// The status is independent of byte length. In particular a zero-length UDP
// datagram is SUCCESS, not END_OF_STREAM. TRUNCATED carries a readable prefix,
// but is not a complete successful read. WOULD_BLOCK is a scheduling outcome.
public function successStatus(): Integer { return 0 }
public function wouldBlockStatus(): Integer { return 1 }
public function endOfStreamStatus(): Integer { return 2 }
public function failureStatus(): Integer { return 3 }
public function truncatedStatus(): Integer { return 4 }

public record BytesResult {
    private status: Integer
    private value: Bytes
    private error: Error
}

public function bytes(value: Bytes): BytesResult {
    return BytesResult { status: 0; value: value; error: none() }
}
public function endOfStream(): BytesResult {
    return BytesResult { status: 2; value: Bytes(); error: none() }
}
public function wouldBlock(nativeCode: Integer): BytesResult {
    return BytesResult { status: 1; value: Bytes(); error: make(1, nativeCode, "operation would block") }
}
public function bytesFailure(error: Error): BytesResult {
    requireError(error)
    return BytesResult { status: 3; value: Bytes(); error: error }
}
public function truncated(value: Bytes, nativeCode: Integer): BytesResult {
    return BytesResult { status: 4; value: value; error: make(12, nativeCode, "datagram was truncated") }
}
public function bytesStatus(result: BytesResult): Integer { return result.status }
public function bytesError(result: BytesResult): Error { return result.error }
public function bytesOk(result: BytesResult): Boolean { return result.status == 0 || result.status == 2 }
public function bytesValue(result: BytesResult): Bytes {
    if result.status == 1 || result.status == 3 { fail("this BytesResult has no readable data") }
    return result.value
}

// Method aliases share the same checks and results as the original functions.
/// Whether this checked Integer result contains a readable value.
public function IntegerResult.ok(): Boolean { return integerOk(self) }
/// Read the checked Integer. A failed result stops the program; check `ok()` first.
public function IntegerResult.value(): Integer { return integerValue(self) }
/// The failure, or `none()` for a successful checked Integer.
public function IntegerResult.error(): Error { return integerError(self) }
/// Whether this checked Boolean result contains a readable value.
public function BooleanResult.ok(): Boolean { return booleanOk(self) }
/// Read the checked Boolean. A failed result stops the program; check `ok()` first.
public function BooleanResult.value(): Boolean { return booleanValue(self) }
/// The failure, or `none()` for a successful checked Boolean.
public function BooleanResult.error(): Error { return booleanError(self) }
/// The stable error kind; zero means no error.
public function Error.code(): Integer { return code(self) }
/// The platform code preserved from the original failure.
public function Error.nativeCode(): Integer { return nativeCode(self) }
/// The original message, without the surrounding operation names.
public function Error.message(): Text { return message(self) }
/// Whether this value describes a failure.
public function Error.isError(): Boolean { return isError(self) }
/// Keep the original failure and add the operation that was trying to use it.
/// The new Error shares the meaning of the old one without changing its aliases.
///
/// ```minyar
/// let missing = api.make(api.systemCode(), 2, "No lantern here.")
/// let home = missing.withContext("opening the lantern").withContext("returning home")
/// print(home.describe())
/// ```
/// ```output
/// returning home
///   opening the lantern
///     No lantern here.
/// ```
public function Error.withContext(context: Text): Error { return withContext(self, context) }
/// A fresh List of operation names, from the outermost to the innermost.
public function Error.contexts(): List<Text> { return contexts(self) }
/// Readable operation names followed by the original message. No final newline is added.
public function Error.describe(): Text { return describe(self) }
