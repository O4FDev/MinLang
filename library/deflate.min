// Maintained zlib. Complete gzip/zlib/raw DEFLATE operations, strict full input.
// gzip accepts concatenated members (including empty ones at an exact output cap).
// zlib/raw accept exactly one stream; surplus bytes are TRAILING. No auto detection.
public constant GZIP = 0
public constant ZLIB = 1
public constant RAW = 2
public constant INVALID = -1
public constant LIMIT = -2
public constant TRUNCATED = -3
public constant CORRUPT = -4
public constant DICTIONARY = -5
public constant MEMORY = -6
public constant CLOSED = -7
public constant TRAILING = -8
public constant MAX_OUTPUT = 268435456
public record Result { private code: Integer; private value: Bytes }
public function ok(result: Result): Boolean { return result.code >= 0 }
public function status(result: Result): Integer { if result.code >= 0 { return 0 }; return result.code }
public function data(result: Result): Bytes { return result.value }
function finish(code: Integer, output: Bytes): Result {
    if code < 0 { return Result { code: code; value: Bytes() } }
    output.resize(code)
    return Result { code: code; value: output }
}
// Into keeps destination.length, may write an untrusted prefix on failure, never past its end.
// Nonoverlapping buffers required. The codec is initialized and freed on every operation.
public function compressInto(input: Bytes, destination: Bytes, format: Integer, level: Integer): Integer { native "deflate" }
public function decompressInto(input: Bytes, destination: Bytes, format: Integer): Integer { native "deflate" }
public function compress(input: Bytes, format: Integer, level: Integer, maxOutput: Integer): Result {
    if maxOutput < 0 || maxOutput > MAX_OUTPUT || format < 0 || format > 2 || level < -1 || level > 9 {
        return Result { code: INVALID; value: Bytes() }
    }
    let output = Bytes(maxOutput)
    return finish(compressInto(input, output, format, level), output)
}
public function decompress(input: Bytes, format: Integer, maxOutput: Integer): Result {
    if maxOutput < 0 || maxOutput > MAX_OUTPUT || format < 0 || format > 2 {
        return Result { code: INVALID; value: Bytes() }
    }
    let output = Bytes(maxOutput)
    return finish(decompressInto(input, output, format), output)
}
public function version(): Integer { native "deflate" }
// Unsafe caller-owned memory. Range checks cannot validate mapped/live memory.
// Zero address only for zero length; signed address range, no overlap, cap <= MAX_OUTPUT.
public function rawCompress(src: Integer, srcLen: Integer, dst: Integer, dstCap: Integer, format: Integer, level: Integer): Integer { native "deflate" }
public function rawDecompress(src: Integer, srcLen: Integer, dst: Integer, dstCap: Integer, format: Integer): Integer { native "deflate" }

public record Stream { private state: List<Integer> }
public record Progress { status: Integer; consumed: Integer; written: Integer; end: Boolean }
public function createCompressor(format: Integer, level: Integer): Stream { return Stream { state: [newStream(true, format, level)] } }
public function createDecompressor(format: Integer): Stream { return Stream { state: [newStream(false, format, 0)] } }
public function isOpenStream(owner: Stream): Boolean { return owner.state[0] != 0 }
public function closeStream(owner: Stream) { if owner.state[0] != 0 { freeStream(owner.state[0]); owner.state[0] = 0 } }
public function step(owner: Stream, input: Bytes, offset: Integer, length: Integer, output: Bytes, endInput: Boolean): Progress {
    if !isOpenStream(owner) { return Progress { status: CLOSED; consumed: 0; written: 0; end: false } }
    let handle = owner.state[0]
    let code = processStream(handle, input, offset, length, output, endInput)
    return Progress { status: code; consumed: streamConsumed(handle); written: streamWritten(handle); end: streamEnded(handle) }
}
function newStream(compress: Boolean, format: Integer, level: Integer): Integer { native "deflate" }
function freeStream(handle: Integer) { native "deflate" }
function processStream(handle: Integer, input: Bytes, offset: Integer, length: Integer, output: Bytes, endInput: Boolean): Integer { native "deflate" }
function streamConsumed(handle: Integer): Integer { native "deflate" }
function streamWritten(handle: Integer): Integer { native "deflate" }
function streamEnded(handle: Integer): Boolean { native "deflate" }
