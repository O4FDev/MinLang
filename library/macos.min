// Native AppKit desktop applications. See docs/macos.md.
// All calls require the main thread. initialize must precede other calls.

public constant NONE = 0
public constant ACTION = 1
public constant CHANGE = 2
public constant CLOSED = 3
public constant RESIZED = 4
public constant QUIT = 5

// Initialize AppKit on the main thread; install application and Edit menus.
public function initialize(name: Text) {
    native "macos"
}

// Create a resizable window. Handles are checked IDs, never pointers.
public function window(title: Text, width: Integer, height: Integer): Integer {
    native "macos"
}

// Show and activate a window.
public function show(window: Integer) {
    native "macos"
}

// Close a window and enqueue CLOSED; its handles remain valid until destroy.
public function close(window: Integer) {
    native "macos"
}

// Destroy a window and invalidate all its descendant handles.
public function destroy(window: Integer) {
    native "macos"
}

// Append a vertical Auto Layout stack to a window or stack.
public function column(parent: Integer, spacing: Integer): Integer {
    native "macos"
}

// Append a horizontal Auto Layout stack.
public function row(parent: Integer, spacing: Integer): Integer {
    native "macos"
}

// Set the inset on all four edges of a stack.
public function padding(stack: Integer, points: Integer) {
    native "macos"
}

// Append a native, selectable label.
public function label(parent: Integer, text: Text): Integer {
    native "macos"
}

// Append a push button; actions enqueue ACTION.
public function button(parent: Integer, title: Text): Integer {
    native "macos"
}

// Append a single-line editor; edits enqueue CHANGE.
public function textField(parent: Integer, text: Text): Integer {
    native "macos"
}

// Append a scrolling plain-text editor; edits enqueue CHANGE.
public function textEditor(parent: Integer, text: Text): Integer {
    native "macos"
}

// Append a checkbox; actions enqueue ACTION.
public function checkbox(parent: Integer, title: Text, checked: Boolean): Integer {
    native "macos"
}

// Append a continuous slider; actions enqueue CHANGE.
public function slider(parent: Integer, minimum: Float, maximum: Float, value: Float): Integer {
    native "macos"
}

// Append a native separator.
public function separator(parent: Integer): Integer {
    native "macos"
}

// Set explicit point dimensions; zero removes that dimension constraint.
public function size(view: Integer, width: Integer, height: Integer) {
    native "macos"
}

// Read owned Unicode text from a window, label, editor, button, or menu item.
public function text(handle: Integer): Text {
    native "macos"
}

// Set text without generating a user edit event.
public function setText(handle: Integer, text: Text) {
    native "macos"
}

// Enable or disable a control or menu item.
public function enabled(control: Integer, value: Boolean) {
    native "macos"
}

// Read checkbox state.
public function checked(checkbox: Integer): Boolean {
    native "macos"
}

// Set checkbox state without generating an action.
public function setChecked(checkbox: Integer, value: Boolean) {
    native "macos"
}

// Read slider value.
public function value(slider: Integer): Float {
    native "macos"
}

// Set a slider value inside its range.
public function setValue(slider: Integer, value: Float) {
    native "macos"
}

// Read window content width in points.
public function width(window: Integer): Integer {
    native "macos"
}

// Read window content height in points.
public function height(window: Integer): Integer {
    native "macos"
}

// Create a top-level menu after initialize.
public function menu(title: Text): Integer {
    native "macos"
}

// Append an actionable item; key is a Command shortcut, or empty.
public function menuItem(menu: Integer, title: Text, key: Text): Integer {
    native "macos"
}

// Dispatch native events and select a queued event. Timeout yields NONE; false after quit.
public function nextEvent(timeout: Float): Boolean {
    native "macos"
}

// Read the current event kind.
public function eventType(): Integer {
    native "macos"
}

// Read the current event source handle (zero for application events).
public function eventSource(): Integer {
    native "macos"
}

// Read a snapshot of text at the time of CHANGE.
public function eventText(): Text {
    native "macos"
}

// Request termination; delivers QUIT once before nextEvent returns false.
public function quit() {
    native "macos"
}

// Read Unicode text from the system clipboard.
public function clipboardText(): Text {
    native "macos"
}

// Write Unicode text to the system clipboard.
public function setClipboardText(text: Text) {
    native "macos"
}

// Show a native single-file picker; empty text means cancelled.
public function openFile(title: Text): Text {
    native "macos"
}

// Show a native save picker; empty text means cancelled.
public function saveFile(title: Text, name: Text): Text {
    native "macos"
}

// Show a native OK/Cancel alert; return true for OK.
public function alert(title: Text, message: Text): Boolean {
    native "macos"
}
