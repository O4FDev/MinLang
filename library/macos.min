// Native AppKit desktop applications. See docs/macos.md.
// All calls require the main thread. initialize must precede other calls.

public constant NONE = 0
public constant ACTION = 1
public constant CHANGE = 2
public constant CLOSED = 3
public constant RESIZED = 4
public constant QUIT = 5
// Return in a text field, or in an editor that uses submitOnEnter.
public constant SUBMIT = 6

// Alignment within a row or column, and gravity areas within one.
public constant START = 1
public constant CENTER = 2
public constant END = 3

// Application appearances.
public constant SYSTEM = 0
public constant DARK = 1
public constant LIGHT = 2

// Initialize AppKit on the main thread; install application, Edit and Window menus.
public function initialize(name: Text) {
    native "macos"
}

// Create a resizable window. Handles are checked IDs, never pointers.
public function window(title: Text, width: Integer, height: Integer): Integer {
    native "macos"
}

// Show and activate a window.
public function show(window: Integer) {
    native "macos"
}

// Close a window and enqueue CLOSED; its handles remain valid until destroy.
public function close(window: Integer) {
    native "macos"
}

// Destroy a window and invalidate all its descendant handles.
public function destroy(window: Integer) {
    native "macos"
}

// Append a vertical Auto Layout stack to a window or stack.
public function column(parent: Integer, spacing: Integer): Integer {
    native "macos"
}

// Append a horizontal Auto Layout stack.
public function row(parent: Integer, spacing: Integer): Integer {
    native "macos"
}

// Set the inset on all four edges of a stack.
public function padding(stack: Integer, points: Integer) {
    native "macos"
}

// Append a native, selectable label.
public function label(parent: Integer, text: Text): Integer {
    native "macos"
}

// Append a push button; actions enqueue ACTION.
public function button(parent: Integer, title: Text): Integer {
    native "macos"
}

// Append a single-line editor; edits enqueue CHANGE and Return enqueues SUBMIT.
public function textField(parent: Integer, text: Text): Integer {
    native "macos"
}

// Append a single-line password field; behaves like textField.
public function secureField(parent: Integer): Integer {
    native "macos"
}

// Append a scrolling plain-text editor; edits enqueue CHANGE.
public function textEditor(parent: Integer, text: Text): Integer {
    native "macos"
}

// Append a checkbox; actions enqueue ACTION.
public function checkbox(parent: Integer, title: Text, checked: Boolean): Integer {
    native "macos"
}

// Append a continuous slider; actions enqueue CHANGE.
public function slider(parent: Integer, minimum: Float, maximum: Float, value: Float): Integer {
    native "macos"
}

// Append a native separator.
public function separator(parent: Integer): Integer {
    native "macos"
}

// Set explicit point dimensions; zero removes that dimension constraint.
public function size(view: Integer, width: Integer, height: Integer) {
    native "macos"
}

// Read owned Unicode text from a window, label, editor, button, or menu item.
public function text(handle: Integer): Text {
    native "macos"
}

// Set text without generating a user edit event.
public function setText(handle: Integer, text: Text) {
    native "macos"
}

// Enable or disable a control, editor, clickable row or column, or menu item.
public function enabled(control: Integer, value: Boolean) {
    native "macos"
}

// Read checkbox state.
public function checked(checkbox: Integer): Boolean {
    native "macos"
}

// Set checkbox state without generating an action.
public function setChecked(checkbox: Integer, value: Boolean) {
    native "macos"
}

// Read slider value.
public function value(slider: Integer): Float {
    native "macos"
}

// Set a slider value inside its range.
public function setValue(slider: Integer, value: Float) {
    native "macos"
}

// Read window content width in points.
public function width(window: Integer): Integer {
    native "macos"
}

// Read window content height in points.
public function height(window: Integer): Integer {
    native "macos"
}

// Create a top-level menu after initialize.
public function menu(title: Text): Integer {
    native "macos"
}

// Append an actionable item; key is a Command shortcut, or empty.
public function menuItem(menu: Integer, title: Text, key: Text): Integer {
    native "macos"
}

// Append a separator line between groups of menu items.
public function menuSeparator(menu: Integer) {
    native "macos"
}

// Dispatch native events and select a queued event. Timeout yields NONE; false after quit.
public function nextEvent(timeout: Float): Boolean {
    native "macos"
}

// Read the current event kind.
public function eventType(): Integer {
    native "macos"
}

// Read the current event source handle (zero for application events).
public function eventSource(): Integer {
    native "macos"
}

// Read a snapshot of text at the time of CHANGE.
public function eventText(): Text {
    native "macos"
}

// Request termination; delivers QUIT once before nextEvent returns false.
public function quit() {
    native "macos"
}

// Read Unicode text from the system clipboard.
public function clipboardText(): Text {
    native "macos"
}

// Write Unicode text to the system clipboard.
public function setClipboardText(text: Text) {
    native "macos"
}

// Show a native single-file picker; empty text means cancelled.
public function openFile(title: Text): Text {
    native "macos"
}

// Show a native save picker; empty text means cancelled.
public function saveFile(title: Text, name: Text): Text {
    native "macos"
}

// Show a native OK/Cancel alert; return true for OK.
public function alert(title: Text, message: Text): Boolean {
    native "macos"
}

// ----- Layout -----
// Rows, columns and scroll views arrange their children with Auto Layout.

// Append an empty view, for example a colored line or box.
public function view(parent: Integer): Integer {
    native "macos"
}

// Append a flexible space that takes up the room left in a row or column.
public function spacer(parent: Integer): Integer {
    native "macos"
}

// Append a vertically scrolling area. Add children to it as to a column; it
// is at least as tall as its view, so CENTER gravity centers short content.
public function scroll(parent: Integer): Integer {
    native "macos"
}

public function scrollToTop(scroll: Integer) {
    native "macos"
}

// Let a view take the room left along its row or column.
public function grow(view: Integer) {
    native "macos"
}

// Stretch a view across its column (or down its row), inside its insets.
public function fill(view: Integer) {
    native "macos"
}

// Minimum content size of a window, or minimum point size of a view; zero
// removes a view's bound. Text fields and editors start with their own.
public function minimumSize(handle: Integer, width: Integer, height: Integer) {
    native "macos"
}

// Maximum point size of a view; zero removes that bound.
public function maximumSize(view: Integer, width: Integer, height: Integer) {
    native "macos"
}

// Space inside the edges of a row, column, scroll view or button.
public function insets(handle: Integer, top: Integer, left: Integer, bottom: Integer, right: Integer) {
    native "macos"
}

// Cross-axis alignment of a row or column's children: START, CENTER or END.
public function align(stack: Integer, alignment: Integer) {
    native "macos"
}

// Move a view to the START, CENTER or END area of its row or column.
public function gravity(view: Integer, area: Integer) {
    native "macos"
}

// Space between a view and the next one, replacing the stack's spacing.
public function spaceAfter(view: Integer, points: Integer) {
    native "macos"
}

// Hide or show a view; hidden views take no space.
public function hidden(view: Integer, hidden: Boolean) {
    native "macos"
}

// Remove every child of a row, column or scroll view. Their handles end.
public function clear(container: Integer) {
    native "macos"
}

// Remove a view and its children. Their handles end.
public function remove(view: Integer) {
    native "macos"
}

// ----- Styling -----
// Colors are handles that pick a 0xRRGGBB value for dark and light appearances.

public function color(dark: Integer, light: Integer, opacity: Float): Integer {
    native "macos"
}

// Fill a view, button or window. Zero removes the fill.
public function background(handle: Integer, color: Integer) {
    native "macos"
}

public function border(view: Integer, width: Integer, color: Integer) {
    native "macos"
}

public function cornerRadius(view: Integer, radius: Integer) {
    native "macos"
}

// Border color while a text input inside the view has keyboard focus.
public function focusBorder(view: Integer, color: Integer) {
    native "macos"
}

// Color of text, symbols and shapes.
public function textColor(handle: Integer, color: Integer) {
    native "macos"
}

// Text and background colors while the pointer is over a button or a
// clickable row or column. Zero leaves that color unchanged.
public function hover(handle: Integer, textColor: Integer, background: Integer) {
    native "macos"
}

// A font family, such as one added with registerFont, or "" for the system
// font. Weight runs from 100 (thin) through 400 (regular) to 900 (black);
// variable fonts use it exactly.
public function font(handle: Integer, family: Text, size: Float, weight: Float) {
    native "macos"
}

// Extra space between letters, in points.
public function letterSpacing(handle: Integer, points: Float) {
    native "macos"
}

// Line height as a multiple of the font size.
public function lineHeight(handle: Integer, multiple: Float) {
    native "macos"
}

// How many lines a label shows: 0 wraps to its width, 1 truncates with "…".
public function lines(label: Integer, count: Integer) {
    native "macos"
}

// Whether a label's text can be selected and copied. Labels start selectable.
public function selectable(label: Integer, value: Boolean) {
    native "macos"
}

// The name VoiceOver reads for a view, such as an input without a visible label.
public function accessibilityLabel(view: Integer, text: Text) {
    native "macos"
}

// Horizontal text alignment in a label, input or button: START, CENTER or END.
public function textAlign(handle: Integer, alignment: Integer) {
    native "macos"
}

// Help text shown when the pointer rests on a view, also read by VoiceOver
// for buttons that only show a symbol.
public function tooltip(view: Integer, text: Text) {
    native "macos"
}

// ----- Controls -----

// Append a button without a bezel: just its title and symbol.
public function plainButton(parent: Integer, title: Text): Integer {
    native "macos"
}

// Append a plain button that opens an http or https URL in the browser.
public function link(parent: Integer, title: Text, url: Text): Integer {
    native "macos"
}

// Show an SF Symbol on a button, such as "plus" or "arrow.up".
public function symbol(button: Integer, name: Text, size: Float) {
    native "macos"
}

// Append a filled SVG path (M, L, H, V, Q, C and Z commands) drawn in the
// text color. Its view box is scaled to the view; give it a size.
public function shape(parent: Integer, path: Text, boxWidth: Float, boxHeight: Float): Integer {
    native "macos"
}

// Append a small spinning progress indicator. Hide it when work is done.
public function spinner(parent: Integer): Integer {
    native "macos"
}

// Grey text shown in an empty text field or editor.
public function placeholder(input: Integer, text: Text) {
    native "macos"
}

// Remove a text field or editor's bezel, background and focus ring, for
// inputs styled by their container.
public function plain(input: Integer) {
    native "macos"
}

// Size an editor to its text, between two heights; it scrolls beyond them.
public function autoHeight(editor: Integer, minimum: Integer, maximum: Integer) {
    native "macos"
}

// Return in an editor enqueues SUBMIT; Shift-Return adds a line instead.
public function submitOnEnter(editor: Integer) {
    native "macos"
}

// Most characters (UTF-16 units) a text field or editor accepts; 0 is no limit.
public function maxLength(input: Integer, count: Integer) {
    native "macos"
}

// Give a view keyboard focus.
public function focus(view: Integer) {
    native "macos"
}

// A row or column that enqueues ACTION when clicked, like a button.
public function clickable(stack: Integer) {
    native "macos"
}

// A row or column that moves the window when dragged, like a title bar.
public function draggable(stack: Integer) {
    native "macos"
}

// ----- Windows -----

// Extend content under a transparent title bar of this height, with the
// window buttons centered in it. Leave room for them at the top left.
public function transparentTitlebar(window: Integer, height: Integer) {
    native "macos"
}

// Remember the window's size and position under this name.
public function autosave(window: Integer, name: Text) {
    native "macos"
}

// ----- Application -----

// SYSTEM follows System Settings; DARK and LIGHT override it.
public function appearance(mode: Integer) {
    native "macos"
}

// Whether the application currently has a dark appearance.
public function isDark(): Boolean {
    native "macos"
}

// A saved preference, or "" if it was never set.
public function setting(key: Text): Text {
    native "macos"
}

public function setSetting(key: Text, value: Text) {
    native "macos"
}

// Open an http, https or mailto URL; false if it could not be opened.
public function openURL(url: Text): Boolean {
    native "macos"
}

// Seconds since the computer started, for measuring intervals.
public function seconds(): Float {
    native "macos"
}

// Path of a file in the application bundle's resources, such as
// "fonts/Text.ttf", or "" if there is no such file.
public function resource(name: Text): Text {
    native "macos"
}

// Make a font file's families available to font(); false if it failed.
public function registerFont(path: Text): Boolean {
    native "macos"
}

// Credits shown in the standard About window.
public function aboutText(text: Text) {
    native "macos"
}

// Show the standard About window, as the application menu does.
public function showAbout() {
    native "macos"
}

// Ask before a destructive action; true if the person chose `action`.
public function confirm(title: Text, message: Text, action: Text): Boolean {
    native "macos"
}

// Save a PNG image of a window, for tests and documentation.
public function capture(window: Integer, path: Text): Boolean {
    native "macos"
}
