// TCP connections for programs running on macOS, Linux or Windows.
// Import it with `use "net" as net`.
//
//     let connection = net.connect("example.com", 80)
//     net.send(connection, request)
//     let reply = net.receive(connection, 65536)
//     net.close(connection)
//
// Connections are small Integer handles. Failures return -1 (connect), a
// short count (send) or empty Bytes (receive); `lastError` explains them.
// Minyar OS has its own TCP/IP stack in os/kernel/net; this package uses the
// host's.

use "errors" as errors

// Resolve `host` and connect to `port`; the handle, or -1.
public function connect(host: Text, port: Integer): Integer { native "net" }

// Classify a numeric IP literal without DNS or socket allocation: 4 or 6;
// zero otherwise. URI brackets and zone identifiers are not accepted.
public function ipVersion(address: Text): Integer { native "net" }

// Send all of `data`; returns how many bytes were sent.
public function send(connection: Integer, data: Bytes): Integer { native "net" }

// Wait for up to `limit` bytes; empty Bytes when the other side has closed.
public function receive(connection: Integer, limit: Integer): Bytes { native "net" }

// Wait at most `milliseconds` for data to arrive; true if some has.
public function ready(connection: Integer, milliseconds: Integer): Boolean { native "net" }

public function close(connection: Integer) { native "net" }

// A description of the last failure.
public function lastError(): Text { native "net" }
// errno (Winsock code on Windows) of the last failure as a negative number, 0 after success. Lets a level-triggered
// accept loop tell EMFILE/ENFILE (-24/-23 on Linux) from an empty backlog without parsing text.
// POSIX resolver failures without an errno use -EINVAL; lastError retains the resolver diagnostic.
public function lastErrorCode(): Integer { native "net" }
// Append up to `limit` received bytes to `buffer` in place (no fresh allocation, zero-fill or copy once the buffer
// has capacity; clear() it between messages to reuse its storage). Returns the count appended (> 0), 0 at end of
// stream, -1 when the read would block, -2 on failure (lastError/lastErrorCode say why).
public function readInto(connection: Integer, buffer: Bytes, limit: Integer): Integer { native "net" }
// Send data[offset, offset + length) once, without slicing a copy. Returns the count sent (>= 0), -1 when the socket
// would block, -2 on failure.
public function writeRange(connection: Integer, data: Bytes, offset: Integer, length: Integer): Integer { native "net" }

// Bound UDP sockets and TCP listeners start non-blocking and do not inherit
// into child processes. Port zero asks the OS to choose an available port.
public function udp(host: Text, port: Integer): Integer { native "net" }
public function listen(host: Text, port: Integer, backlog: Integer): Integer { native "net" }
public function accept(listener: Integer): Integer { native "net" }
public function localPort(connection: Integer): Integer { native "net" }
public function nonBlocking(connection: Integer, enabled: Boolean): Boolean { native "net" }

// Choose whether TCP writes may wait for Nagle coalescing. Enable for
// interactive multiplexed TLS streams; errors retain the native OS code.
public function setNoDelay(connection: Integer, enabled: Boolean): errors.BooleanResult {
    let result = setNoDelayResult(connection,enabled)
    if result.getUInt32(0) == 0 { return errors.boolean(true) }
    return errors.booleanFailure(errors.make(errors.systemCode(),result.getUInt32(4),"TCP_NODELAY configuration failed"))
}
function setNoDelayResult(connection: Integer, enabled: Boolean): Bytes { native "net" }

// Begin a non-blocking TCP connection to a numeric IPv4/IPv6 address. The
// caller owns the returned socket, including while establishment is pending.
// Watch writability, then call connectFinish; close after any failed result.
// Resolve DNS outside the event-loop owner before entering this API.
public function connectStart(address: Text, port: Integer): errors.IntegerResult {
    let result = connectStartResult(address,port)
    if result.getUInt32(0) == 0 { return errors.integer(result.getInt64(8)) }
    return errors.integerFailure(errors.make(errors.systemCode(),result.getUInt32(4),"socket connect failed"))
}
public function connectFinish(connection: Integer): errors.BooleanResult {
    let result = connectFinishResult(connection)
    if result.getUInt32(0) == 0 { return errors.boolean(true) }
    let code = errors.systemCode()
    if result.getUInt32(0) == 1 { code = errors.wouldBlockCode() }
    return errors.booleanFailure(errors.make(code,result.getUInt32(4),"socket connect incomplete or failed"))
}
function connectStartResult(address: Text, port: Integer): Bytes { native "net" }
function connectFinishResult(connection: Integer): Bytes { native "net" }

// Set a default UDP destination and filter incoming datagrams to that peer.
// Name resolution occurs here, never while waiting for socket readiness.
public function udpConnect(connection: Integer, host: Text, port: Integer): Boolean { native "net" }

// One read, with operation-owned errors. Stream EOF, would-block and failure
// have separate tags; a failed network operation does not stop the program.
public function read(connection: Integer, limit: Integer): errors.BytesResult {
    return decodeRead(readResult(connection, limit, false))
}

// One whole UDP datagram. An empty datagram is successful data. TRUNCATED
// returns its prefix and an error, so a parser cannot mistake it for a packet.
public function receiveDatagram(connection: Integer, limit: Integer): errors.BytesResult {
    return decodeRead(readResult(connection, limit, true))
}

function decodeRead(result: Bytes): errors.BytesResult {
    let status = result.getUInt32(0)
    let code = result.getUInt32(4)
    if status == 0 { return errors.bytes(result.slice(8, result.length)) }
    if status == 1 { return errors.wouldBlock(code) }
    if status == 2 { return errors.endOfStream() }
    if status == 4 { return errors.truncated(result.slice(8, result.length), code) }
    return errors.bytesFailure(errors.make(errors.systemCode(), code, "socket read failed"))
}

// A single non-blocking write. TCP callers keep any unsent suffix and wait
// for writability. UDP callers get one datagram, including empty datagrams.
public function write(connection: Integer, data: Bytes): errors.IntegerResult {
    let result = writeResult(connection, data)
    let status = result.getUInt32(0)
    if status == 0 { return errors.integer(result.getInt64(8)) }
    let code = result.getUInt32(4)
    if status == 1 {
        return errors.integerFailure(errors.make(errors.wouldBlockCode(), code, "socket write would block"))
    }
    return errors.integerFailure(errors.make(errors.systemCode(), code, "socket write failed"))
}

function readResult(connection: Integer, limit: Integer, datagram: Boolean): Bytes { native "net" }
function writeResult(connection: Integer, data: Bytes): Bytes { native "net" }

// Send up to 64 packets to a connected UDP peer. A successful partial batch
// returns the number of complete packets sent; retain and retry the suffix.
public function sendDatagrams(connection: Integer, packets: List<Bytes>): errors.IntegerResult {
    if packets.length > 64 {
        return errors.integerFailure(errors.make(errors.invalidDataCode(), 0, "a UDP batch has at most 64 packets"))
    }
    let encoded = Bytes()
    encoded.addUInt32(packets.length)
    for packet in packets {
        if packet.length > 65507 {
            return errors.integerFailure(errors.make(errors.invalidDataCode(), 0, "UDP packet exceeds 65507 bytes"))
        }
        encoded.addUInt32(packet.length)
        encoded.addBytes(packet)
    }
    let result = sendBatchResult(connection, encoded)
    if result.getUInt32(0) == 0 { return errors.integer(result.getInt64(8)) }
    let category = errors.systemCode()
    if result.getUInt32(0) == 1 { category = errors.wouldBlockCode() }
    return errors.integerFailure(errors.make(category, result.getUInt32(4), "UDP batch send failed"))
}

public record Datagram {
    private data: errors.BytesResult
    private source: Text
    private port: Integer
}
public function datagramData(packet: Datagram): errors.BytesResult { return packet.data }
public function datagramSource(packet: Datagram): Text { return packet.source }
public function datagramPort(packet: Datagram): Integer { return packet.port }

public record DatagramBatch {
    private packets: List<Datagram>
    private error: errors.Error
}
public function datagramBatchOk(batch: DatagramBatch): Boolean { return !errors.isError(batch.error) }
public function datagramBatchError(batch: DatagramBatch): errors.Error { return batch.error }
public function datagrams(batch: DatagramBatch): List<Datagram> {
    if !datagramBatchOk(batch) { fail("cannot extract a failed UDP batch") }
    return batch.packets
}

// Receive at most 64 packets in one call, preserving their source addresses
// and individual truncation flags. Linux uses recvmmsg; no call waits for an
// entire batch to fill. Empty UDP packets are included in the returned List.
public function receiveDatagrams(connection: Integer, maximum: Integer, limit: Integer): DatagramBatch {
    let encoded = receiveBatchResult(connection, maximum, limit)
    let packets: List<Datagram> = []
    let status = encoded.getUInt32(0)
    if status != 0 {
        let category = errors.systemCode()
        if status == 1 { category = errors.wouldBlockCode() }
        return DatagramBatch { packets: packets; error: errors.make(category, encoded.getUInt32(4), "UDP batch receive failed") }
    }
    let position = 12
    for packet in 0..encoded.getUInt32(8) {
        let length = encoded.getUInt32(position)
        let truncated = encoded.getUInt32(position + 4) == 4
        let port = encoded.getUInt32(position + 8)
        let sourceLength = encoded.getUInt32(position + 12)
        position = position + 16
        let source = Text(encoded.slice(position, position + sourceLength))
        position = position + sourceLength
        let data = encoded.slice(position, position + length)
        position = position + length
        let result = errors.bytes(data)
        if truncated { result = errors.truncated(data, 0) }
        packets.add(Datagram { data: result; source: source; port: port })
    }
    return DatagramBatch { packets: packets; error: errors.none() }
}

function sendBatchResult(connection: Integer, packets: Bytes): Bytes { native "net" }
function receiveBatchResult(connection: Integer, maximum: Integer, limit: Integer): Bytes { native "net" }

// Reply to a datagram's numeric source address without connecting the socket
// or doing DNS on the packet path. The result counts bytes in one whole packet.
public function sendDatagramTo(connection: Integer, source: Text, port: Integer, data: Bytes): errors.IntegerResult {
    let result = sendToResult(connection, source, port, data)
    if result.getUInt32(0) == 0 { return errors.integer(result.getInt64(8)) }
    let category = errors.systemCode()
    if result.getUInt32(0) == 1 { category = errors.wouldBlockCode() }
    return errors.integerFailure(errors.make(category, result.getUInt32(4), "UDP send to peer failed"))
}
function sendToResult(connection: Integer, source: Text, port: Integer, data: Bytes): Bytes { native "net" }
// Process-independent monotonic time for transport deadlines; never wall time.
public function monotonicMilliseconds(): Integer { native "net" }

// Linux UDP_SEGMENT is explicit per message: data is split at segmentSize
// boundaries, with a possibly shorter final packet. Empty data sends one
// empty packet. Both the total payload and each packet stay <=65507 bytes;
// at most 64 packets are sent. Kernel/MTU errors remain recoverable values.
public function sendDatagramsOffload(connection: Integer, data: Bytes, segmentSize: Integer): errors.IntegerResult {
    return offloadInteger(sendOffloadResult(connection, data, segmentSize), "UDP segmentation send")
}
public function sendDatagramsOffloadTo(connection: Integer, source: Text, port: Integer, data: Bytes, segmentSize: Integer): errors.IntegerResult {
    return offloadInteger(sendOffloadToResult(connection, source, port, data, segmentSize), "UDP segmentation send to peer")
}

// A dedicated single-owner UDP_GRO socket. Its opaque ID is never an OS
// socket handle: ordinary read/receive/close APIs reject it. Numeric bind
// addresses avoid DNS. macOS/Windows return an unavailable Error.
public record DatagramOffload {
    private handle: Integer
    private error: errors.Error
}
public function datagramOffload(host: Text, port: Integer): DatagramOffload {
    let result = offloadOpenResult(host, port)
    if result.getUInt32(0) == 0 {
        return DatagramOffload { handle: result.getInt64(8); error: errors.none() }
    }
    return DatagramOffload { handle: -1; error: offloadError(result, "UDP receive offload open") }
}
public function datagramOffloadOk(receiver: DatagramOffload): Boolean { return !errors.isError(receiver.error) }
public function datagramOffloadError(receiver: DatagramOffload): errors.Error { return receiver.error }
public function datagramOffloadPort(receiver: DatagramOffload): errors.IntegerResult {
    if !datagramOffloadOk(receiver) { return errors.integerFailure(receiver.error) }
    return offloadInteger(offloadPortResult(receiver.handle), "UDP receive offload local port")
}
public function readyDatagramOffload(receiver: DatagramOffload, milliseconds: Integer): errors.BooleanResult {
    if !datagramOffloadOk(receiver) { return errors.booleanFailure(receiver.error) }
    let result = offloadReadyResult(receiver.handle, milliseconds)
    if result.getUInt32(0) == 0 { return errors.boolean(result.getInt64(8) == 1) }
    return errors.booleanFailure(offloadError(result, "UDP receive offload readiness"))
}
// Use the ordinary eventloop registration/update/remove/wait APIs. Remove
// the registration before closing this socket. After readiness, drain this
// receiver until would-block: a short maximum can leave segments buffered
// in userspace, where the kernel selector cannot signal them again.
public function watchDatagramOffload(receiver: DatagramOffload, loop: Integer, interest: Integer, token: Integer): errors.IntegerResult {
    if !datagramOffloadOk(receiver) { return errors.integerFailure(receiver.error) }
    return offloadInteger(offloadWatchResult(loop, receiver.handle, interest, token), "UDP receive offload watch")
}
public function closeDatagramOffload(receiver: DatagramOffload): errors.BooleanResult {
    if !datagramOffloadOk(receiver) { return errors.booleanFailure(receiver.error) }
    let result = offloadCloseResult(receiver.handle)
    if result.getUInt32(0) == 0 { return errors.boolean(true) }
    return errors.booleanFailure(offloadError(result, "UDP receive offload close"))
}
// Reply from the same bound GRO socket without exposing its descriptor or
// changing its peer filter. The destination must be a numeric IPv4/IPv6 address.
public function sendDatagramOffloadTo(receiver: DatagramOffload, source: Text, port: Integer, data: Bytes, segmentSize: Integer): errors.IntegerResult {
    if !datagramOffloadOk(receiver) { return errors.integerFailure(receiver.error) }
    return offloadInteger(offloadSendToResult(receiver.handle, source, port, data, segmentSize), "UDP receive offload reply")
}
// Returns individual source-addressed packets, never an opaque aggregate.
// maximum counts logical datagrams, and limit truncates each one's prefix.
// Malformed/truncated control or a later receive failure preserves previously
// decoded packets; inspect datagramBatchPrefix even when datagramBatchOk is false.
public function receiveDatagramsOffload(receiver: DatagramOffload, maximum: Integer, limit: Integer): DatagramBatch {
    let packets: List<Datagram> = []
    if !datagramOffloadOk(receiver) { return DatagramBatch { packets: packets; error: receiver.error } }
    let encoded = offloadReceiveResult(receiver.handle, maximum, limit)
    let position = 12
    for packet in 0..encoded.getUInt32(8) {
        let length = encoded.getUInt32(position)
        let truncated = encoded.getUInt32(position + 4) == 4
        let port = encoded.getUInt32(position + 8)
        let sourceLength = encoded.getUInt32(position + 12)
        position = position + 16
        let source = Text(encoded.slice(position, position + sourceLength))
        position = position + sourceLength
        let data = encoded.slice(position, position + length)
        position = position + length
        let result = errors.bytes(data)
        if truncated { result = errors.truncated(data, 0) }
        packets.add(Datagram { data: result; source: source; port: port })
    }
    let error = errors.none()
    if encoded.getUInt32(0) != 0 { error = offloadError(encoded, "UDP receive offload") }
    return DatagramBatch { packets: packets; error: error }
}
public function datagramBatchPrefix(batch: DatagramBatch): List<Datagram> { return batch.packets }

function offloadError(result: Bytes, operation: Text): errors.Error {
    let category = errors.systemCode()
    if result.getUInt32(0) == 1 { category = errors.wouldBlockCode() }
    if result.getUInt32(0) == 4 { category = errors.truncatedCode() }
    if result.getUInt32(0) == 5 { category = errors.unavailableCode() }
    return errors.make(category, result.getUInt32(4), operation + " failed")
}
function offloadInteger(result: Bytes, operation: Text): errors.IntegerResult {
    if result.getUInt32(0) == 0 { return errors.integer(result.getInt64(8)) }
    return errors.integerFailure(offloadError(result, operation))
}
function sendOffloadResult(connection: Integer, data: Bytes, segmentSize: Integer): Bytes { native "net" }
function sendOffloadToResult(connection: Integer, source: Text, port: Integer, data: Bytes, segmentSize: Integer): Bytes { native "net" }
function offloadOpenResult(host: Text, port: Integer): Bytes { native "net" }
function offloadReceiveResult(receiver: Integer, maximum: Integer, limit: Integer): Bytes { native "net" }
function offloadPortResult(receiver: Integer): Bytes { native "net" }
function offloadReadyResult(receiver: Integer, milliseconds: Integer): Bytes { native "net" }
function offloadWatchResult(loop: Integer, receiver: Integer, interest: Integer, token: Integer): Bytes { native "net" }
function offloadSendToResult(receiver: Integer, source: Text, port: Integer, data: Bytes, segmentSize: Integer): Bytes { native "net" }
function offloadCloseResult(receiver: Integer): Bytes { native "net" }

// Typed companions to the deprecated native/status-record APIs above.
// Would-block remains an error with its own code. Stream EOF is None; an
// empty UDP datagram is successful Bytes. Truncation retains its readable prefix.
public record ReadFailure { private diagnostic: errors.Error; private readablePrefix: Bytes }
public function ReadFailure.error(): errors.Error { return self.diagnostic }
public function ReadFailure.prefix(): Bytes { return self.readablePrefix }
public function ReadFailure.isWouldBlock(): Boolean { return errors.isWouldBlock(self.diagnostic) }
public function ReadFailure.withContext(context: Text): ReadFailure { return ReadFailure { diagnostic: self.diagnostic.withContext(context); readablePrefix: self.readablePrefix } }
public function ReadFailure.describe(): Text { return self.diagnostic.describe() }

function typedInteger(result: errors.IntegerResult): Result<Integer, errors.Error> {
    if errors.integerOk(result) { return Ok(errors.integerValue(result)) }
    return Err(errors.integerError(result))
}
function typedBoolean(result: errors.BooleanResult): Result<Boolean, errors.Error> {
    if errors.booleanOk(result) { return Ok(errors.booleanValue(result)) }
    return Err(errors.booleanError(result))
}
function typedStatus(result: errors.BooleanResult): Result<Nothing, errors.Error> {
    if errors.booleanOk(result) { return Ok() }
    return Err(errors.booleanError(result))
}
function socketError(operation: Text): errors.Error {
    let code = lastErrorCode()
    let message = lastError()
    let category = errors.systemCode()
    if code == -11 || code == -35 || code == -10035 { category = errors.wouldBlockCode() }
    return errors.make(category, -code, message).withContext(operation)
}
function socketHandle(value: Integer, operation: Text): Result<Integer, errors.Error> {
    if value < 0 { return Err(socketError(operation)) }
    return Ok(value)
}
function readFailure(result: errors.BytesResult): ReadFailure {
    let prefix = Bytes()
    if errors.bytesStatus(result) == errors.truncatedStatus() { prefix = errors.bytesValue(result) }
    return ReadFailure { diagnostic: errors.bytesError(result); readablePrefix: prefix }
}
function typedDatagram(result: errors.BytesResult): Result<Bytes, ReadFailure> {
    if errors.bytesStatus(result) == errors.successStatus() { return Ok(errors.bytesValue(result)) }
    if errors.bytesStatus(result) == errors.endOfStreamStatus() {
        return Err(ReadFailure { diagnostic: errors.make(errors.closedCode(), 0, "datagram input ended"); readablePrefix: Bytes() })
    }
    return Err(readFailure(result))
}
public function openConnection(host: Text, port: Integer): Result<Integer, errors.Error> { return socketHandle(connect(host, port), "connecting to " + host) }
public function beginConnection(address: Text, port: Integer): Result<Integer, errors.Error> { return typedInteger(connectStart(address, port)) }
public function finishConnection(connection: Integer): Result<Boolean, errors.Error> { return typedBoolean(connectFinish(connection)) }
public function listenOn(host: Text, port: Integer, backlog: Integer): Result<Integer, errors.Error> { return socketHandle(listen(host, port, backlog), "listening on " + host) }
public function acceptConnection(listener: Integer): Result<Integer, errors.Error> { return socketHandle(accept(listener), "accepting a connection") }
public function openDatagram(host: Text, port: Integer): Result<Integer, errors.Error> { return socketHandle(udp(host, port), "opening a datagram socket") }
public function portOf(connection: Integer): Result<Integer, errors.Error> { return socketHandle(localPort(connection), "reading the socket's port") }
public function setNonBlocking(connection: Integer, enabled: Boolean): Result<Nothing, errors.Error> {
    if !nonBlocking(connection, enabled) { return Err(socketError("configuring non-blocking I/O")) }
    return Ok()
}
public function waitReady(connection: Integer, milliseconds: Integer): Result<Boolean, errors.Error> {
    let result = ready(connection, milliseconds)
    if lastErrorCode() != 0 { return Err(socketError("waiting for socket readiness")) }
    return Ok(result)
}
public function closeConnection(connection: Integer): Result<Nothing, errors.Error> {
    close(connection)
    if lastErrorCode() != 0 { return Err(socketError("closing the socket")) }
    return Ok()
}
public function noDelay(connection: Integer, enabled: Boolean): Result<Nothing, errors.Error> { return typedStatus(setNoDelay(connection, enabled)) }
public function connectDatagram(connection: Integer, host: Text, port: Integer): Result<Nothing, errors.Error> {
    if !udpConnect(connection, host, port) { return Err(socketError("connecting a datagram socket")) }
    return Ok()
}
public function addressFamily(address: Text): Maybe<Integer> {
    let version = ipVersion(address)
    if version == 0 { return None }
    return Some(version)
}
public function readBytes(connection: Integer, limit: Integer): Result<Maybe<Bytes>, ReadFailure> {
    let result = read(connection, limit)
    let status = errors.bytesStatus(result)
    if status == errors.successStatus() { return Ok(Some(errors.bytesValue(result))) }
    if status == errors.endOfStreamStatus() { return Ok(None) }
    return Err(readFailure(result))
}
public function receiveDatagramBytes(connection: Integer, limit: Integer): Result<Bytes, ReadFailure> { return typedDatagram(receiveDatagram(connection, limit)) }
public function writeBytes(connection: Integer, data: Bytes): Result<Integer, errors.Error> { return typedInteger(write(connection, data)) }
public function writeBytesRange(connection: Integer, data: Bytes, offset: Integer, length: Integer): Result<Integer, errors.Error> { return socketHandle(writeRange(connection, data, offset, length), "writing a socket range") }
public function readBytesInto(connection: Integer, buffer: Bytes, limit: Integer): Result<Maybe<Integer>, errors.Error> {
    if limit < 1 { return Err(errors.make(errors.invalidDataCode(), 0, "socket read limit must be positive")) }
    let count = readInto(connection, buffer, limit)
    if count < 0 { return Err(socketError("reading into a byte buffer")) }
    if count == 0 { return Ok(None) }
    return Ok(Some(count))
}
public function sendPackets(connection: Integer, packets: List<Bytes>): Result<Integer, errors.Error> { return typedInteger(sendDatagrams(connection, packets)) }
public function sendPacketTo(connection: Integer, source: Text, port: Integer, data: Bytes): Result<Integer, errors.Error> { return typedInteger(sendDatagramTo(connection, source, port, data)) }
public function sendSegments(connection: Integer, data: Bytes, segmentSize: Integer): Result<Integer, errors.Error> { return typedInteger(sendDatagramsOffload(connection, data, segmentSize)) }
public function sendSegmentsTo(connection: Integer, source: Text, port: Integer, data: Bytes, segmentSize: Integer): Result<Integer, errors.Error> { return typedInteger(sendDatagramsOffloadTo(connection, source, port, data, segmentSize)) }

public record BatchFailure { private diagnostic: errors.Error; private readablePrefix: List<Datagram> }
public function BatchFailure.error(): errors.Error { return self.diagnostic }
public function BatchFailure.prefix(): List<Datagram> { return self.readablePrefix }
public function BatchFailure.withContext(context: Text): BatchFailure { return BatchFailure { diagnostic: self.diagnostic.withContext(context); readablePrefix: self.readablePrefix } }
public function BatchFailure.describe(): Text { return self.diagnostic.describe() }
public function Datagram.data(): Result<Bytes, ReadFailure> { return typedDatagram(self.data) }
public function Datagram.source(): Text { return self.source }
public function Datagram.port(): Integer { return self.port }
function typedBatch(batch: DatagramBatch): Result<List<Datagram>, BatchFailure> {
    if datagramBatchOk(batch) { return Ok(datagrams(batch)) }
    return Err(BatchFailure { diagnostic: datagramBatchError(batch); readablePrefix: datagramBatchPrefix(batch) })
}
public function receivePackets(connection: Integer, maximum: Integer, limit: Integer): Result<List<Datagram>, BatchFailure> { return typedBatch(receiveDatagrams(connection, maximum, limit)) }
public function openDatagramOffload(host: Text, port: Integer): Result<DatagramOffload, errors.Error> {
    let result = datagramOffload(host, port)
    if datagramOffloadOk(result) { return Ok(result) }
    return Err(datagramOffloadError(result))
}
public function DatagramOffload.port(): Result<Integer, errors.Error> { return typedInteger(datagramOffloadPort(self)) }
public function DatagramOffload.ready(milliseconds: Integer): Result<Boolean, errors.Error> { return typedBoolean(readyDatagramOffload(self, milliseconds)) }
public function DatagramOffload.watch(loop: Integer, interest: Integer, token: Integer): Result<Integer, errors.Error> { return typedInteger(watchDatagramOffload(self, loop, interest, token)) }
public function DatagramOffload.close(): Result<Nothing, errors.Error> { return typedStatus(closeDatagramOffload(self)) }
public function DatagramOffload.sendTo(source: Text, port: Integer, data: Bytes, segmentSize: Integer): Result<Integer, errors.Error> { return typedInteger(sendDatagramOffloadTo(self, source, port, data, segmentSize)) }
public function DatagramOffload.receive(maximum: Integer, limit: Integer): Result<List<Datagram>, BatchFailure> { return typedBatch(receiveDatagramsOffload(self, maximum, limit)) }
