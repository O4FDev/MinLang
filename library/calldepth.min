use "errors" as errors

// The callback is the first counted frame. Nonpositive limits fail without
// running it. Nested limits are capped by the parent's remaining allowance.
// Completed side effects survive failure. Native reserve can reject earlier.
public function run(limit: Integer, callback: () -> Integer): errors.IntegerResult {
    native "calldepth"
}

// Advisory logical capacity; -1 means outside a recoverable scope.
public function remaining(): Integer { native "calldepth" }

function depthSuccess(value: Integer): errors.IntegerResult { return errors.integer(value) }
function depthFailure(): errors.IntegerResult {
    return errors.integerFailure(errors.make(errors.callDepthCode(), 0, "call depth limit exceeded"))
}
