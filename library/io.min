use "errors" as errors
use "text" as text

// Portable whole-file I/O. Failures stop with a diagnostic; use files for
// recoverable descriptor operations and durable writes. Text preserves bytes.
/// Read a whole file as UTF-8 Text. Embedded zero bytes are preserved.
/// An unreadable file or invalid UTF-8 stops the program. Use `files` for
/// recoverable descriptor operations, or `readBytesFile` for arbitrary bytes.
///
/// ```minyar
/// api.writeTextFile("greeting.txt", "The light is on.")
/// print(api.readTextFile("greeting.txt"))
/// ```
/// ```output
/// The light is on.
/// ```
public function readTextFile(path: Text): Text { native "runtime" }
/// Replace a file's contents with the UTF-8 bytes of Text.
/// Failures stop the program. For durable publication, use `files` to write,
/// sync, rename and sync the containing directory.
public function writeTextFile(path: Text, contents: Text) { native "runtime" }
// Stream pieces without allocating their concatenation.
/// Write Text pieces in order without allocating their concatenation.
/// This replaces the destination file and has the same failure behavior as
/// `writeTextFile`.
///
/// ```minyar
/// api.writeTextParts("postcard.txt", ["The ", "moon ", "stays."])
/// print(api.readTextFile("postcard.txt"))
/// ```
/// ```output
/// The moon stays.
/// ```
public function writeTextParts(path: Text, contents: List<Text>) {
    let writer = openTextWriter(path)
    for part in contents { writeTextPart(writer, part) }
    closeTextWriter(writer)
}
function openTextWriter(path: Text): Integer { native "runtime" }
function writeTextPart(writer: Integer, part: Text) { native "runtime" }
function closeTextWriter(writer: Integer) { native "runtime" }
/// Read a whole file into Bytes, preserving every byte.
/// The result is independent storage; file failures stop the program.
public function readBytesFile(path: Text): Bytes { native "runtime" }
/// Replace a file's contents with Bytes, unchanged.
/// Use this for images, wire formats and other data that need not be UTF-8.
public function writeBytesFile(path: Text, contents: Bytes) { native "runtime" }
// True when the path can be opened for reading; directories/platform errors
// follow the platform's open semantics. This is not an atomic existence test.
/// Ask whether the path can be opened for reading.
/// Directory and permission behavior follows the platform's open operation;
/// this does not reserve the file or make a later operation atomic.
public function fileExists(path: Text): Boolean { native "runtime" }

// Flush an open OS descriptor: fsync on POSIX, _commit on Windows. Returns
// zero or negative errno, preserving errno; out-of-range Integers return -22.
// Safe in managed threads. Use files.sync for its stronger Darwin durability.
/// Flush an open OS descriptor, returning zero or negative errno.
/// This uses `fsync` on POSIX and `_commit` on Windows. `files.sync` provides
/// stronger durability on macOS.
public function sync(descriptor: Integer): Integer { native "runtime" }

// Typed whole-file operations. The original *File functions and
// writeTextParts remain deprecated compatibility APIs with their fatal errors.
// Native snapshots capture diagnostics before closing the file can replace them.
record ReadOutcome { private data: Bytes; private code: Integer }
record TextParts { private pieces: List<Text> }
function readBytesOutcome(path: Text, maximumBytes: Integer): ReadOutcome { native "runtime" }
function writeBytesStatus(path: Text, contents: Bytes): Integer { native "runtime" }
function writePartsStatus(path: Text, contents: TextParts): Integer { native "runtime" }

// ------------------------------------------------------------ standard input

/// The longest line `readLine` accepts, in bytes.
public constant MAXIMUM_LINE_BYTES = 1048576
// The runtime reader's private marker for a line that is too long.
constant LINE_TOO_LONG = -1000001

record LineOutcome { private data: Bytes; private code: Integer }
function readLineOutcome(): LineOutcome { native "runtime" }

/// Read one line from standard input, without its line ending.
/// Returns `Ok(None)` at end of input, `Ok(Some(line))` for a line, and an
/// error for a read failure or invalid UTF-8. A line ends at `\n`; a trailing
/// `\r` before it is dropped too, so CRLF input reads like LF input. The final
/// unterminated line before end of input is returned as a line. Input is
/// buffered, so reading is one copy per buffer fill, and lines longer than
/// `MAXIMUM_LINE_BYTES` are rejected with an `errors.overflowCode()` error
/// after the rest of that line is discarded. Only one thread may read standard
/// input: these calls are not `parallel function`s.
public function readLine(): Result<Maybe<Text>, errors.Error> {
    let outcome = readLineOutcome()
    if outcome.code == 1 { return Ok(None) }
    if outcome.code < 0 {
        if outcome.code == LINE_TOO_LONG {
            return Err(errors.make(errors.overflowCode(), LINE_TOO_LONG,
                "a line on standard input is longer than " + Text(MAXIMUM_LINE_BYTES) + " bytes"))
        }
        return Err(errors.make(errors.systemCode(), -outcome.code, "could not read standard input"))
    }
    return Ok(Some(try text.decode(outcome.data) else "standard input is not UTF-8"))
}

function ioError(code: Integer, operation: Text, path: Text): errors.Error {
    return errors.make(errors.systemCode(), code, "could not " + operation + " file: " + path)
}

public function readBytesWithin(path: Text, maximumBytes: Integer): Result<Bytes, errors.Error> {
    let outcome = readBytesOutcome(path, maximumBytes)
    if outcome.code != 0 { return Err(ioError(outcome.code, "read", path)) }
    return Ok(outcome.data)
}
public function readBytes(path: Text): Result<Bytes, errors.Error> {
    return readBytesWithin(path, 9223372036854775807)
}
public function readText(path: Text): Result<Text, errors.Error> {
    let data = try readBytes(path)
    return Ok(try text.decode(data) else ("decoding " + path))
}
public function readTextWithin(path: Text, maximumBytes: Integer): Result<Text, errors.Error> {
    let data = try readBytesWithin(path, maximumBytes)
    return Ok(try text.decode(data) else ("decoding " + path))
}
public function writeBytes(path: Text, contents: Bytes): Result<Nothing, errors.Error> {
    let code = writeBytesStatus(path, contents)
    if code < 0 { return Err(ioError(-code, "write", path)) }
    return Ok()
}
public function writeText(path: Text, contents: Text): Result<Nothing, errors.Error> {
    return writeBytes(path, Bytes(contents))
}
public function writeParts(path: Text, contents: List<Text>): Result<Nothing, errors.Error> {
    let code = writePartsStatus(path, TextParts { pieces: contents })
    if code < 0 { return Err(ioError(-code, "write", path)) }
    return Ok()
}
public function flush(descriptor: Integer): Result<Nothing, errors.Error> {
    let code = sync(descriptor)
    if code < 0 { return Err(errors.make(errors.systemCode(), -code, "could not sync the descriptor")) }
    return Ok()
}
