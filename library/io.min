// Portable whole-file I/O. Failures stop with a diagnostic; use files for
// recoverable descriptor operations and durable writes. Text preserves bytes.
/// Read a whole file as UTF-8 Text. Embedded zero bytes are preserved.
/// An unreadable file or invalid UTF-8 stops the program. Use `files` for
/// recoverable descriptor operations, or `readBytesFile` for arbitrary bytes.
///
/// ```minyar
/// api.writeTextFile("greeting.txt", "The light is on.")
/// print(api.readTextFile("greeting.txt"))
/// ```
/// ```output
/// The light is on.
/// ```
public function readTextFile(path: Text): Text { native "runtime" }
/// Replace a file's contents with the UTF-8 bytes of Text.
/// Failures stop the program. For durable publication, use `files` to write,
/// sync, rename and sync the containing directory.
public function writeTextFile(path: Text, contents: Text) { native "runtime" }
// Stream pieces without allocating their concatenation.
/// Write Text pieces in order without allocating their concatenation.
/// This replaces the destination file and has the same failure behavior as
/// `writeTextFile`.
///
/// ```minyar
/// api.writeTextParts("postcard.txt", ["The ", "moon ", "stays."])
/// print(api.readTextFile("postcard.txt"))
/// ```
/// ```output
/// The moon stays.
/// ```
public function writeTextParts(path: Text, contents: List<Text>) {
    let writer = openTextWriter(path)
    for part in contents { writeTextPart(writer, part) }
    closeTextWriter(writer)
}
function openTextWriter(path: Text): Integer { native "runtime" }
function writeTextPart(writer: Integer, part: Text) { native "runtime" }
function closeTextWriter(writer: Integer) { native "runtime" }
/// Read a whole file into Bytes, preserving every byte.
/// The result is independent storage; file failures stop the program.
public function readBytesFile(path: Text): Bytes { native "runtime" }
/// Replace a file's contents with Bytes, unchanged.
/// Use this for images, wire formats and other data that need not be UTF-8.
public function writeBytesFile(path: Text, contents: Bytes) { native "runtime" }
// True when the path can be opened for reading; directories/platform errors
// follow the platform's open semantics. This is not an atomic existence test.
/// Ask whether the path can be opened for reading.
/// Directory and permission behavior follows the platform's open operation;
/// this does not reserve the file or make a later operation atomic.
public function fileExists(path: Text): Boolean { native "runtime" }

// Flush an open OS descriptor: fsync on POSIX, _commit on Windows. Returns
// zero or negative errno, preserving errno; out-of-range Integers return -22.
// Safe in managed threads. Use files.sync for its stronger Darwin durability.
/// Flush an open OS descriptor, returning zero or negative errno.
/// This uses `fsync` on POSIX and `_commit` on Windows. `files.sync` provides
/// stronger durability on macOS.
public function sync(descriptor: Integer): Integer { native "runtime" }
