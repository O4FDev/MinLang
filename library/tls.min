// A TLS 1.3 client (RFC 8446) with X25519 and ChaCha20-Poly1305.
// Import it with `use "tls" as tls`.
//
// A Session is a state machine that never touches the network itself: give
// it the bytes that arrive with `receive`, send whatever `takeOutgoing`
// returns, and read decrypted data with `takeIncoming`. That lets the hosted
// `http` package and Minyar OS's own TCP/IP stack share it.
//
// The hosted certificate provider builds a chain to OS roots (or explicit
// anchors), checks the hostname, validity and server usage, and verifies the
// server's CertificateVerify. No insecure verification mode is provided.
// quicClient/receiveHandshake use raw handshake bytes and traffic secrets,
// without TLS records, for a future QUIC transport implementation.
use "crypto" as crypto
use "tlsverify" as trust
use "aes" as aes
use "tlstickets" as tickets

public constant STARTING = 0
public constant HELLO_SENT = 1
public constant HANDSHAKE = 2
public constant ESTABLISHED = 3
public constant CLOSED = 4
public constant FAILED = 5
public constant INITIAL_KEYS = 0
public constant HANDSHAKE_KEYS = 1
public constant APPLICATION_KEYS = 2

constant CHACHA20_POLY1305 = 0x1303
constant AES128_GCM = 0x1301
constant X25519 = 0x001d

public record Session {
    cipherSuite: Integer
    host: Text
    state: Integer
    error: Text
    privateKey: Bytes
    random: Bytes
    transcript: Bytes
    received: Bytes
    handshake: Bytes
    outgoing: Bytes
    incoming: Bytes
    handshakeSecret: Bytes
    clientSecret: Bytes
    serverSecret: Bytes
    readKey: Bytes
    readIv: Bytes
    readSequence: Integer
    writeKey: Bytes
    writeIv: Bytes
    writeSequence: Integer
    anchors: Bytes
    certificate: Bytes
    clientChain: Bytes
    identityKey: Bytes
    requestedSchemes: List<Integer>
    certificateRequested: Boolean
    authenticated: Boolean
    stage: Integer
    protocol: Text
    transportParameters: Bytes
    peerTransportParameters: Bytes
    quic: Boolean
    outgoingLevel: Integer
    incomingLevel: Integer
    clientApplication: Bytes
    serverApplication: Bytes
    earlyOffered: Boolean; earlyAccepted: Boolean; clientEarlySecret: Bytes
    resumed: Boolean
    ticket: tickets.Client
    savedTickets: List<tickets.Client>
    verifiedChain: Bytes
    resumptionMaster: Bytes
}

// ----- Encoding helpers -----

function add16(data: Bytes, value: Integer) {
    data.add((value >> 8) & 255)
    data.add(value & 255)
}

function add24(data: Bytes, value: Integer) {
    data.add((value >> 16) & 255)
    add16(data, value)
}

function get16(data: Bytes, at: Integer): Integer {
    return (data[at] << 8) | data[at + 1]
}

function get24(data: Bytes, at: Integer): Integer {
    return (data[at] << 16) | get16(data, at + 1)
}

function extension(type: Integer, body: Bytes): Bytes {
    let result = Bytes()
    add16(result, type)
    add16(result, body.length)
    result.addBytes(body)
    return result
}

function abandon(session: Session, message: Text) {
    if session.state != FAILED {
        session.state = FAILED
        session.error = message
        session.incoming = Bytes()
        session.outgoing = Bytes()
        session.received = Bytes()
        session.handshake = Bytes()
        session.privateKey = Bytes()
        session.identityKey = Bytes()
        session.transcript = Bytes()
        session.certificate = Bytes()
        session.clientChain = Bytes()
        session.anchors = Bytes()
        session.clientEarlySecret = Bytes(); session.resumptionMaster = Bytes(); session.ticket = tickets.emptyClient(); session.savedTickets = []
        session.handshakeSecret = Bytes(); session.clientSecret = Bytes(); session.serverSecret = Bytes()
        session.readKey = Bytes(); session.writeKey = Bytes(); session.clientApplication = Bytes(); session.serverApplication = Bytes()
    }
}

// ----- Starting -----

// A session that is never used, for connections without TLS.
public function none(): Session {
    return Session {
        cipherSuite: CHACHA20_POLY1305
        host: ""; state: CLOSED; error: ""; privateKey: Bytes(); random: Bytes()
        transcript: Bytes(); received: Bytes(); handshake: Bytes(); outgoing: Bytes(); incoming: Bytes()
        handshakeSecret: Bytes(); clientSecret: Bytes(); serverSecret: Bytes()
        readKey: Bytes(); readIv: Bytes(); readSequence: 0; writeKey: Bytes(); writeIv: Bytes(); writeSequence: 0
        anchors: Bytes(); certificate: Bytes(); clientChain: Bytes(); identityKey: Bytes(); requestedSchemes: []
        certificateRequested: false; authenticated: false; stage: 0; protocol: ""; transportParameters: Bytes()
        peerTransportParameters: Bytes(); quic: false; outgoingLevel: INITIAL_KEYS; incomingLevel: INITIAL_KEYS
        clientApplication: Bytes(); serverApplication: Bytes()
        earlyOffered: false; earlyAccepted: false; clientEarlySecret: Bytes()
        resumed: false; ticket: tickets.emptyClient(); savedTickets: []; verifiedChain: Bytes(); resumptionMaster: Bytes()
    }
}

// A session for `host`. `entropy` must be at least 64 unpredictable bytes,
// for example from randomBytes(64).
public function client(host: Text, entropy: Bytes): Session {
    return configured(host, entropy, [], [], Bytes(), "http/1.1", false, Bytes())
}

// An explicit, isolated set of DER trust anchors. Empty uses OS roots.
public function clientWithTrust(host: Text, entropy: Bytes, roots: List<Bytes>): Session {
    return configured(host, entropy, roots, [], Bytes(), "http/1.1", false, Bytes())
}

// The DER client chain starts with the leaf; privateKey is PKCS#8 DER.
// The client proves key possession when the server requests a certificate.
public function clientWithIdentity(host: Text, entropy: Bytes, roots: List<Bytes>, certificates: List<Bytes>, privateKey: Bytes): Session {
    return configured(host, entropy, roots, certificates, privateKey, "http/1.1", false, Bytes())
}

// QUIC supplies ordered CRYPTO stream bytes at each encryption level, handles
// packet protection itself, and consumes clientSecret/serverSecret followed
// by clientApplication/serverApplication. This is not a QUIC transport.
public function clientWithProtocol(host: Text, entropy: Bytes, protocol: Text, roots: List<Bytes>, certificates: List<Bytes>, privateKey: Bytes): Session {
    return configured(host, entropy, roots, certificates, privateKey, protocol, false, Bytes())
}
public function quicClient(host: Text, entropy: Bytes, protocol: Text, parameters: Bytes, roots: List<Bytes>, certificates: List<Bytes>, privateKey: Bytes): Session {
    return configured(host, entropy, roots, certificates, privateKey, protocol, true, parameters)
}
public function quicClientResumed(host: Text, entropy: Bytes, protocol: Text, parameters: Bytes, roots: List<Bytes>, certificates: List<Bytes>, privateKey: Bytes, ticket: tickets.Client): Session {
    let session = configured(host, entropy, roots, certificates, privateKey, protocol, true, parameters)
    offerTicket(session, ticket)
    return session
}
public function quicClientEarly(host: Text, entropy: Bytes, protocol: Text, parameters: Bytes, roots: List<Bytes>, certificates: List<Bytes>, privateKey: Bytes, ticket: tickets.Client): Session {
    let session = quicClientResumed(host, entropy, protocol, parameters, roots, certificates, privateKey, ticket)
    if session.ticket.valid && ticket.earlyLimit == 0xffffffff && tickets.profile(ticket.parameters).length == 64 {
        session.earlyOffered = true; session.outgoing = Bytes(); session.transcript = Bytes(); sendHello(session)
    }
    return session
}
public function clientResumed(host: Text, entropy: Bytes, roots: List<Bytes>, certificates: List<Bytes>, privateKey: Bytes, ticket: tickets.Client): Session {
    let session = configured(host, entropy, roots, certificates, privateKey, "http/1.1", false, Bytes())
    offerTicket(session, ticket)
    return session
}
function offerTicket(session: Session, ticket: tickets.Client) {
    let now = trust.currentTimeMilliseconds()
    if session.state == FAILED || !ticket.valid || now < ticket.issued || now >= ticket.expires || ticket.host != session.host || ticket.protocol != session.protocol ||
       ticket.psk.length != 32 || ticket.ticket.length < 1 || ticket.ticket.length > 65500 || ticket.certificateChain.length == 0 ||
       trust.chain(session.host, ticket.certificateChain, session.anchors) != "" { return }
    session.ticket = ticket; session.outgoing = Bytes(); session.transcript = Bytes(); sendHello(session)
}
public function takeTicket(session: Session): tickets.Client {
    if session.savedTickets.length == 0 { return tickets.emptyClient() }
    let result = session.savedTickets[session.savedTickets.length - 1]; session.savedTickets = []
    return result
}

function certificateEntries(certificates: List<Bytes>): Bytes {
    let result = Bytes()
    for certificate in certificates {
        add24(result, certificate.length)
        result.addBytes(certificate)
        add16(result, 0)
    }
    return result
}

function configured(host: Text, entropy: Bytes, roots: List<Bytes>, certificates: List<Bytes>, privateKey: Bytes, protocol: Text, quic: Boolean, parameters: Bytes): Session {
    let session = none()
    session.state = STARTING
    session.host = host
    session.anchors = certificateEntries(roots)
    session.clientChain = certificateEntries(certificates)
    session.identityKey = privateKey
    session.protocol = protocol
    session.quic = quic
    session.transportParameters = parameters
    if entropy.length < 64 || host.length == 0 || host.length > 253 || protocol.length == 0 || protocol.length > 255 {
        abandon(session, "invalid TLS client configuration or insufficient entropy")
        return session
    }
    if roots.length > 16 || certificates.length > 16 || session.anchors.length > 1048576 || session.clientChain.length > 1048576 || parameters.length > 65535 {
        abandon(session, "TLS client configuration exceeds its size limits")
        return session
    }
    session.privateKey = entropy.slice(0, 32)
    session.random = entropy.slice(32, 64)
    sendHello(session)
    return session
}

function sendHello(session: Session) {
    let body = Bytes()
    add16(body, 0x0303)
    body.addBytes(session.random)
    // A legacy session ID keeps middleboxes that expect TLS 1.2 happy.
    if session.quic {
        body.add(0)
    } else {
        body.add(32)
        body.addBytes(crypto.sha256(session.random))
    }
    add16(body, 4)
    add16(body, AES128_GCM)
    add16(body, CHACHA20_POLY1305)
    body.add(1)
    body.add(0)
    let extensions = Bytes()
    let name = Bytes(session.host)
    let serverName = Bytes()
    add16(serverName, name.length + 3)
    serverName.add(0)
    add16(serverName, name.length)
    serverName.addBytes(name)
    extensions.addBytes(extension(0, serverName))
    let groups = Bytes()
    add16(groups, 2)
    add16(groups, X25519)
    extensions.addBytes(extension(10, groups))
    let algorithms = Bytes()
    let schemes = [0x0403, 0x0804, 0x0503, 0x0805, 0x0603, 0x0806]
    add16(algorithms, schemes.length * 2)
    for scheme in schemes { add16(algorithms, scheme) }
    extensions.addBytes(extension(13, algorithms))
    // Certificate issuers can use PKCS#1 signatures even though TLS 1.3
    // CertificateVerify requires RSA-PSS. Advertise these separately.
    let certificateAlgorithms = Bytes()
    let certificateSchemes = [0x0403, 0x0503, 0x0603, 0x0804, 0x0805, 0x0806, 0x0401, 0x0501, 0x0601]
    add16(certificateAlgorithms, certificateSchemes.length * 2)
    for scheme in certificateSchemes { add16(certificateAlgorithms, scheme) }
    extensions.addBytes(extension(50, certificateAlgorithms))
    let protocols = Bytes()
    let http = Bytes(session.protocol)
    add16(protocols, http.length + 1)
    protocols.add(http.length)
    protocols.addBytes(http)
    extensions.addBytes(extension(16, protocols))
    let versions = Bytes()
    versions.add(2)
    add16(versions, 0x0304)
    extensions.addBytes(extension(43, versions))
    let share = Bytes()
    let publicKey = crypto.x25519Public(session.privateKey)
    add16(share, publicKey.length + 4)
    add16(share, X25519)
    add16(share, publicKey.length)
    share.addBytes(publicKey)
    extensions.addBytes(extension(51, share))
    if session.quic { extensions.addBytes(extension(57, session.transportParameters)) }
    extensions.addBytes(extension(45, crypto.fromHex("0101")))
    if session.earlyOffered { extensions.addBytes(extension(42, Bytes())) }
    if session.ticket.valid {
        let identities = Bytes(); add16(identities, session.ticket.ticket.length); identities.addBytes(session.ticket.ticket)
        let age = (max(0, trust.currentTimeMilliseconds() - session.ticket.issued) + session.ticket.ageAdd) & 0xffffffff
        for index in 0..4 { identities.add((age >> ((3 - index) * 8)) & 255) }
        let offered = Bytes(); add16(offered, identities.length); offered.addBytes(identities); add16(offered, 33); offered.add(32); offered.addBytes(Bytes(32))
        extensions.addBytes(extension(41, offered))
    }
    add16(body, extensions.length)
    body.addBytes(extensions)
    let message = Bytes()
    message.add(1)
    add24(message, body.length)
    message.addBytes(body)
    if session.ticket.valid {
        let binder = tickets.binder(session.ticket.psk, crypto.sha256(message.slice(0, message.length - 35)))
        for index in 0..32 { message[message.length - 32 + index] = binder[index] }
    }
    if session.earlyOffered {
        session.clientEarlySecret = crypto.expandLabel(crypto.hkdfExtract(Bytes(), session.ticket.psk), "c e traffic", crypto.sha256(message), 32)
    }
    session.transcript.addBytes(message)
    if session.quic {
        session.outgoing.addBytes(message)
        session.state = HELLO_SENT
        return
    }
    let hello = Bytes()
    hello.add(22)
    add16(hello, 0x0301)
    add16(hello, message.length)
    hello.addBytes(message)
    session.outgoing.addBytes(hello)
    session.state = HELLO_SENT
}

// ----- Records -----

function nonce(iv: Bytes, sequence: Integer): Bytes {
    let result = iv.slice(0, 12)
    for index in 0..8 {
        result[11 - index] = result[11 - index] ^ ((sequence >> (index * 8)) & 255)
    }
    return result
}

function keySize(session: Session): Integer {
    if session.cipherSuite == AES128_GCM { return 16 }
    return 32
}
function recordSeal(session: Session, iv: Bytes, header: Bytes, plaintext: Bytes): Bytes {
    if session.cipherSuite == AES128_GCM { return aes.encrypt(session.writeKey, iv, header, plaintext) }
    return crypto.seal(session.writeKey, iv, header, plaintext)
}
function recordOpen(session: Session, iv: Bytes, header: Bytes, ciphertext: Bytes): crypto.Opened {
    if session.cipherSuite != AES128_GCM { return crypto.open(session.readKey, iv, header, ciphertext) }
    let result = aes.decrypt(session.readKey, iv, header, ciphertext)
    if result.length == 0 { return crypto.Opened { valid: false; plaintext: Bytes() } }
    return crypto.Opened { valid: true; plaintext: result.slice(1, result.length) }
}

function encrypt(session: Session, type: Integer, content: Bytes) {
    let offset = 0
    while offset < content.length || content.length == 0 {
        let size = min(content.length - offset, 16384)
        let inner = content.slice(offset, offset + size)
        inner.add(type)
        let header = Bytes()
        header.add(23)
        add16(header, 0x0303)
        add16(header, inner.length + 16)
        let sealed = recordSeal(session, nonce(session.writeIv, session.writeSequence), header, inner)
        if sealed.length != inner.length + 16 { abandon(session, "TLS cipher provider failed"); return }
        session.writeSequence += 1
        session.outgoing.addBytes(header)
        session.outgoing.addBytes(sealed)
        offset += size
        if content.length == 0 { return }
    }
}

// Give the session bytes that arrived from the server.
public function receive(session: Session, data: Bytes) {
    if session.quic {
        abandon(session, "QUIC requires receiveHandshake rather than TLS records")
        return
    }
    if session.state == FAILED || session.state == CLOSED { return }
    if data.length > 1048576 || session.received.length + data.length > 1048576 {
        abandon(session, "TLS receive buffer exceeds its size limit")
        return
    }
    session.received.addBytes(data)
    while session.state != FAILED && session.state != CLOSED && session.received.length >= 5 {
        let length = get16(session.received, 3)
        if length > 16640 || get16(session.received, 1) != 0x0303 {
            abandon(session, "invalid TLS record version or length")
            return
        }
        if session.received.length < 5 + length { return }
        let header = session.received.slice(0, 5)
        let body = session.received.slice(5, 5 + length)
        session.received = session.received.slice(5 + length, session.received.length)
        readRecord(session, header, body)
    }
}

function readRecord(session: Session, header: Bytes, body: Bytes) {
    let type = header[0]
    if type == 20 {
        if (session.state != HELLO_SENT && session.state != HANDSHAKE) || body.length != 1 || body[0] != 1 {
            abandon(session, "invalid change-cipher-spec record")
        }
        return
    }
    if type == 21 && session.state == HELLO_SENT {
        alert(session, body)
        return
    }
    if type == 22 && session.state == HELLO_SENT {
        if body.length > 16384 {
            abandon(session, "plaintext record exceeds its size limit")
            return
        }
        session.handshake.addBytes(body)
        handshakeMessages(session)
        return
    }
    if type != 23 || session.readKey.length == 0 {
        abandon(session, "unexpected record type " + Text(type))
        return
    }
    let opened = recordOpen(session, nonce(session.readIv, session.readSequence), header, body)
    session.readSequence += 1
    if !opened.valid {
        abandon(session, "a record failed its integrity check")
        return
    }
    let plain = opened.plaintext
    let end = plain.length
    while end > 0 && plain[end - 1] == 0 { end -= 1 }
    if end == 0 {
        abandon(session, "a record had no content type")
        return
    }
    let inner = plain[end - 1]
    let content = plain.slice(0, end - 1)
    if content.length > 16384 {
        abandon(session, "decrypted TLS content exceeds its size limit")
        return
    }
    if inner == 22 {
        session.handshake.addBytes(content)
        handshakeMessages(session)
    }
    if inner == 23 {
        if session.state != ESTABLISHED {
            abandon(session, "application data arrived before authentication")
            return
        }
        session.incoming.addBytes(content)
    }
    if inner == 21 {
        alert(session, content)
    }
    if inner != 22 && inner != 23 && inner != 21 {
        abandon(session, "invalid encrypted record content type")
    }
}

function alert(session: Session, body: Bytes) {
    if body.length != 2 {
        abandon(session, "invalid TLS alert")
        return
    }
    if body[1] == 0 && session.state == ESTABLISHED {
        if session.state != FAILED { session.state = CLOSED }
        return
    }
    let code = 0
    if body.length >= 2 { code = body[1] }
    abandon(session, "the server sent alert " + Text(code))
}

// ----- Handshake -----

function handshakeMessages(session: Session) {
    while session.state != FAILED && session.handshake.length >= 4 {
        let length = get24(session.handshake, 1)
        if length > 1048576 {
            abandon(session, "TLS handshake message exceeds its size limit")
            return
        }
        if session.handshake.length < 4 + length { return }
        let message = session.handshake.slice(0, 4 + length)
        session.handshake = session.handshake.slice(4 + length, session.handshake.length)
        let type = message[0]
        if session.quic && ((type == 2 && session.incomingLevel != INITIAL_KEYS) ||
           (type == 4 && session.incomingLevel != APPLICATION_KEYS) ||
           (type != 2 && type != 4 && session.incomingLevel != HANDSHAKE_KEYS)) {
            abandon(session, "TLS handshake arrived at the wrong QUIC encryption level")
            return
        }
        if type == 2 && session.stage == 0 && session.state == HELLO_SENT {
            serverHello(session, message)
        } else if type == 8 && session.stage == 1 {
            encryptedExtensions(session, message)
        } else if type == 13 && session.stage == 2 {
            certificateRequest(session, message)
        } else if type == 11 && (session.stage == 2 || session.stage == 3) {
            serverCertificate(session, message)
        } else if type == 15 && session.stage == 4 {
            certificateVerify(session, message)
        } else if type == 20 && (session.stage == 5 || (session.resumed && (session.stage == 2 || session.stage == 3))) {
            serverFinished(session, message)
        } else if type == 4 && session.state == ESTABLISHED {
            newSessionTicket(session, message)
        } else {
            abandon(session, "unexpected or out-of-order TLS handshake message")
        }
    }
}

function newSessionTicket(session: Session, message: Bytes) {
    if message.length < 17 { abandon(session, "malformed NewSessionTicket"); return }
    let at = 13 + message[12]
    if at + 2 > message.length { abandon(session, "truncated ticket nonce"); return }
    let nonce = message.slice(13, at)
    let length = get16(message, at); at += 2
    if length == 0 || length > message.length - at - 2 { abandon(session, "truncated or empty session ticket"); return }
    let ticket = message.slice(at, at + length); at += length
    if get16(message, at) != message.length - at - 2 { abandon(session, "malformed ticket extensions"); return }; at += 2
    let seen: List<Integer> = []; let earlyLimit = 0
    while at + 4 <= message.length {
        let type = get16(message, at); let size = get16(message, at + 2); at += 4
        if size > message.length - at || contains(seen, type) || (type == 42 && size != 4) { abandon(session, "invalid ticket extension"); return }
        if type == 42 { for index in 0..4 { earlyLimit = (earlyLimit << 8) | message[at + index] } }
        seen.add(type); at += size
    }
    if at != message.length { abandon(session, "truncated ticket extension"); return }
    let lifetime = 0; let ageAdd = 0
    for index in 0..4 { lifetime = (lifetime << 8) | message[4 + index]; ageAdd = (ageAdd << 8) | message[8 + index] }
    let now = trust.currentTimeMilliseconds()
    if lifetime < 1 || lifetime > 604800 || session.resumptionMaster.length != 32 || session.verifiedChain.length == 0 || ticket.length > 65500 || now < 1 { return }
    if session.savedTickets.length >= 2 { session.savedTickets = [] }
    session.savedTickets.add(tickets.Client {
        valid: true; ticket: ticket; psk: crypto.expandLabel(session.resumptionMaster, "resumption", nonce, 32); suite: session.cipherSuite; earlyLimit: earlyLimit
        host: session.host; protocol: session.protocol; issued: now; expires: now + lifetime * 1000; ageAdd: ageAdd; certificateChain: session.verifiedChain; parameters: session.peerTransportParameters
    })
}

function serverHello(session: Session, message: Bytes) {
    if message.length < 44 || get16(message, 4) != 0x0303 {
        abandon(session, "malformed ServerHello")
        return
    }
    let at = 4 + 2
    let random = message.slice(at, at + 32)
    if crypto.hex(random) == "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c" {
        abandon(session, "the server does not support X25519 key exchange")
        return
    }
    at += 32
    let identifierLength = message[at]
    if at + 1 + identifierLength + 5 > message.length || (session.quic && identifierLength != 0) || (!session.quic && identifierLength != 32) {
        abandon(session, "invalid ServerHello session identifier")
        return
    }
    if !session.quic && !equal(message.slice(at + 1, at + 1 + identifierLength), crypto.sha256(session.random)) {
        abandon(session, "ServerHello did not echo the session identifier")
        return
    }
    at += 1 + identifierLength
    let suite = get16(message, at)
    if message[at + 2] != 0 {
        abandon(session, "unsupported ServerHello compression")
        return
    }
    at += 3
    if suite != CHACHA20_POLY1305 && suite != AES128_GCM {
        abandon(session, "the server chose an unsupported cipher suite")
        return
    }
    session.cipherSuite = suite
    let extensionsEnd = at + 2 + get16(message, at)
    if extensionsEnd != message.length {
        abandon(session, "malformed ServerHello extensions")
        return
    }
    at += 2
    let serverKey = Bytes()
    let version = 0
    let seen: List<Integer> = []
    while at + 4 <= extensionsEnd {
        let type = get16(message, at)
        let size = get16(message, at + 2)
        let data = at + 4
        if data + size > extensionsEnd || contains(seen, type) {
            abandon(session, "malformed or duplicate ServerHello extension")
            return
        }
        seen.add(type)
        if type == 51 && size == 36 && get16(message, data) == X25519 && get16(message, data + 2) == 32 {
            serverKey = message.slice(data + 4, data + 36)
        }
        if type == 43 && size == 2 {
            version = get16(message, data)
        }
        if type == 41 {
            if !session.ticket.valid || size != 2 || get16(message, data) != 0 { abandon(session, "unsolicited or invalid server PSK selection"); return }
            session.resumed = true; session.authenticated = true; session.verifiedChain = session.ticket.certificateChain
        }
        if type != 43 && type != 51 && type != 41 {
            abandon(session, "unsolicited ServerHello extension")
            return
        }
        at = data + size
    }
    if at != extensionsEnd || version != 0x0304 || serverKey.length != 32 {
        abandon(session, "the server does not speak TLS 1.3")
        return
    }
    session.transcript.addBytes(message)
    let shared = crypto.x25519(session.privateKey, serverKey)
    if equal(shared, Bytes(32)) {
        abandon(session, "invalid all-zero X25519 shared secret")
        return
    }
    let zeros = Bytes(32)
    let psk = zeros
    if session.resumed { psk = session.ticket.psk }
    let early = crypto.hkdfExtract(Bytes(), psk)
    let derived = crypto.expandLabel(early, "derived", crypto.sha256(Bytes()), 32)
    session.handshakeSecret = crypto.hkdfExtract(derived, shared)
    let hash = crypto.sha256(session.transcript)
    session.clientSecret = crypto.expandLabel(session.handshakeSecret, "c hs traffic", hash, 32)
    session.serverSecret = crypto.expandLabel(session.handshakeSecret, "s hs traffic", hash, 32)
    session.readKey = crypto.expandLabel(session.serverSecret, "key", Bytes(), keySize(session))
    session.readIv = crypto.expandLabel(session.serverSecret, "iv", Bytes(), 12)
    session.readSequence = 0
    session.writeKey = crypto.expandLabel(session.clientSecret, "key", Bytes(), keySize(session))
    session.writeIv = crypto.expandLabel(session.clientSecret, "iv", Bytes(), 12)
    session.writeSequence = 0
    session.state = HANDSHAKE
    session.stage = 1
}

function contains(values: List<Integer>, value: Integer): Boolean {
    for item in values { if item == value { return true } }
    return false
}

// Compare the complete fixed-size value without early byte exits.
function equal(left: Bytes, right: Bytes): Boolean {
    if left.length != right.length { return false }
    let difference = 0
    for index in 0..left.length { difference = difference | (left[index] ^ right[index]) }
    return difference == 0
}

function encryptedExtensions(session: Session, message: Bytes) {
    if message.length < 6 || get16(message, 4) != message.length - 6 {
        abandon(session, "malformed EncryptedExtensions")
        return
    }
    let at = 6
    let seen: List<Integer> = []
    let selectedProtocol = false
    let parameters = false
    while at + 4 <= message.length {
        let type = get16(message, at)
        let size = get16(message, at + 2)
        let data = at + 4
        if data + size > message.length || contains(seen, type) {
            abandon(session, "malformed or duplicate encrypted extension")
            return
        }
        seen.add(type)
        if type == 16 {
            if size < 3 || get16(message, data) != size - 2 || message[data + 2] != size - 3 || Text(message.slice(data + 3, data + size)) != session.protocol {
                abandon(session, "the server selected an invalid application protocol")
                return
            }
            selectedProtocol = true
        } else if type == 57 && session.quic {
            session.peerTransportParameters = message.slice(data, data + size)
            parameters = true
        } else if type == 42 {
            if size != 0 || !session.earlyOffered || !session.resumed || session.cipherSuite != session.ticket.suite { abandon(session, "unsolicited or incompatible early-data acceptance"); return }
            session.earlyAccepted = true
        } else if type != 0 && type != 10 {
            abandon(session, "unsolicited encrypted extension")
            return
        }
        if type == 0 && size != 0 {
            abandon(session, "malformed server name acknowledgement")
            return
        }
        if type == 10 && (size < 4 || size % 2 != 0 || get16(message, data) != size - 2) {
            abandon(session, "malformed supported groups extension")
            return
        }
        at = data + size
    }
    if at != message.length || (session.quic && (!selectedProtocol || !parameters)) {
        abandon(session, "incomplete encrypted extensions or missing QUIC negotiation")
        return
    }
    if session.earlyAccepted && !tickets.permitsEarly(tickets.profile(session.ticket.parameters), tickets.profile(session.peerTransportParameters)) {
        abandon(session, "server reduced remembered 0-RTT transport limits"); return
    }
    session.transcript.addBytes(message)
    session.stage = 2
}

function certificateRequest(session: Session, message: Bytes) {
    if message.length < 7 || message[4] != 0 || get16(message, 5) != message.length - 7 {
        abandon(session, "malformed initial CertificateRequest")
        return
    }
    let at = 7
    let seen: List<Integer> = []
    while at + 4 <= message.length {
        let type = get16(message, at)
        let size = get16(message, at + 2)
        let data = at + 4
        if data + size > message.length || contains(seen, type) {
            abandon(session, "malformed or duplicate CertificateRequest extension")
            return
        }
        seen.add(type)
        if type == 13 {
            if size < 4 || get16(message, data) != size - 2 || size % 2 != 0 {
                abandon(session, "invalid requested signature algorithms")
                return
            }
            let position = data + 2
            while position < data + size {
                session.requestedSchemes.add(get16(message, position))
                position += 2
            }
        }
        at = data + size
    }
    if at != message.length || session.requestedSchemes.length == 0 {
        abandon(session, "CertificateRequest omitted signature algorithms")
        return
    }
    session.certificateRequested = true
    session.transcript.addBytes(message)
    session.stage = 3
}

function serverCertificate(session: Session, message: Bytes) {
    if message.length < 8 || message[4] != 0 || get24(message, 5) != message.length - 8 {
        abandon(session, "malformed server Certificate message")
        return
    }
    let at = 8
    let count = 0
    while at < message.length {
        if at + 3 > message.length {
            abandon(session, "truncated certificate entry")
            return
        }
        let size = get24(message, at)
        at += 3
        if size == 0 || at + size + 2 > message.length || count >= 16 {
            abandon(session, "invalid certificate entry length or chain size")
            return
        }
        if count == 0 { session.certificate = message.slice(at, at + size) }
        count += 1
        at += size
        let extensions = get16(message, at)
        at += 2
        if at + extensions > message.length {
            abandon(session, "truncated certificate extensions")
            return
        }
        // No certificate extensions were offered by this client.
        if extensions != 0 {
            abandon(session, "unsolicited certificate extension")
            return
        }
        at += extensions
    }
    if count == 0 {
        abandon(session, "the server supplied no certificate")
        return
    }
    let failure = trust.chain(session.host, message.slice(8, message.length), session.anchors)
    if failure != "" {
        abandon(session, failure)
        return
    }
    if message.length - 8 <= 32768 { session.verifiedChain = message.slice(8, message.length) }
    session.transcript.addBytes(message)
    session.stage = 4
}

function signatureContent(session: Session, server: Boolean): Bytes {
    let content = Bytes()
    for index in 0..64 { content.add(32) }
    if server { content.addBytes(Bytes("TLS 1.3, server CertificateVerify")) }
    else { content.addBytes(Bytes("TLS 1.3, client CertificateVerify")) }
    content.add(0)
    content.addBytes(crypto.sha256(session.transcript))
    return content
}

function certificateVerify(session: Session, message: Bytes) {
    if message.length < 8 || get16(message, 6) != message.length - 8 {
        abandon(session, "malformed CertificateVerify")
        return
    }
    let scheme = get16(message, 4)
    if !trust.signature(session.certificate, scheme, signatureContent(session, true), message.slice(8, message.length)) {
        abandon(session, "the server's certificate signature did not verify")
        return
    }
    session.authenticated = true
    session.transcript.addBytes(message)
    session.stage = 5
}

function serverFinished(session: Session, message: Bytes) {
    if session.state != HANDSHAKE || !session.authenticated || message.length != 36 {
        abandon(session, "an unexpected Finished message arrived")
        return
    }
    let finishedKey = crypto.expandLabel(session.serverSecret, "finished", Bytes(), 32)
    let expected = crypto.hmac(finishedKey, crypto.sha256(session.transcript))
    if !equal(expected, message.slice(4, message.length)) {
        abandon(session, "the server's Finished message did not verify")
        return
    }
    session.transcript.addBytes(message)
    let derived = crypto.expandLabel(session.handshakeSecret, "derived", crypto.sha256(Bytes()), 32)
    let master = crypto.hkdfExtract(derived, Bytes(32))
    let hash = crypto.sha256(session.transcript)
    session.clientApplication = crypto.expandLabel(master, "c ap traffic", hash, 32)
    session.serverApplication = crypto.expandLabel(master, "s ap traffic", hash, 32)
    let flight = Bytes()
    if session.certificateRequested {
        let certificate = Bytes()
        certificate.add(11)
        add24(certificate, 4 + session.clientChain.length)
        certificate.add(0)
        add24(certificate, session.clientChain.length)
        certificate.addBytes(session.clientChain)
        session.transcript.addBytes(certificate)
        flight.addBytes(certificate)
        if session.clientChain.length > 0 {
            let signature = Bytes()
            let scheme = 0
            let content = signatureContent(session, false)
            for requested in session.requestedSchemes {
                if signature.length == 0 {
                    let candidate = trust.sign(session.identityKey, requested, content)
                    let leafSize = get24(session.clientChain, 0)
                    let leaf = session.clientChain.slice(3, 3 + leafSize)
                    if candidate.length > 0 && trust.signature(leaf, requested, content, candidate) {
                        signature = candidate
                        scheme = requested
                    }
                }
            }
            if signature.length == 0 {
                abandon(session, "the client identity has no supported matching signing key")
                return
            }
            let verify = Bytes()
            verify.add(15)
            add24(verify, 4 + signature.length)
            add16(verify, scheme)
            add16(verify, signature.length)
            verify.addBytes(signature)
            session.transcript.addBytes(verify)
            flight.addBytes(verify)
        }
    }
    // Our Finished, still under the handshake keys.
    let clientKey = crypto.expandLabel(session.clientSecret, "finished", Bytes(), 32)
    let verify = crypto.hmac(clientKey, crypto.sha256(session.transcript))
    let finished = Bytes()
    finished.add(20)
    add24(finished, verify.length)
    finished.addBytes(verify)
    flight.addBytes(finished)
    session.transcript.addBytes(finished)
    session.resumptionMaster = crypto.expandLabel(master, "res master", crypto.sha256(session.transcript), 32)
    // A change-cipher-spec record first, for middlebox compatibility.
    if session.quic {
        session.outgoingLevel = HANDSHAKE_KEYS
        session.outgoing.addBytes(flight)
    } else {
        session.outgoing.addBytes(crypto.fromHex("140303000101"))
        encrypt(session, 22, flight)
    }
    session.readKey = crypto.expandLabel(session.serverApplication, "key", Bytes(), keySize(session))
    session.readIv = crypto.expandLabel(session.serverApplication, "iv", Bytes(), 12)
    session.readSequence = 0
    session.writeKey = crypto.expandLabel(session.clientApplication, "key", Bytes(), keySize(session))
    session.writeIv = crypto.expandLabel(session.clientApplication, "iv", Bytes(), 12)
    session.writeSequence = 0
    session.state = ESTABLISHED
    session.stage = 6
    session.identityKey = Bytes()
    session.privateKey = Bytes()
    // Long-lived connections do not retain the certificate/transcript flight.
    session.transcript = Bytes()
    session.certificate = Bytes()
    session.clientChain = Bytes()
    session.anchors = Bytes()
    session.requestedSchemes = []
    if !session.quic {
        session.handshakeSecret = Bytes()
        session.clientSecret = Bytes()
        session.serverSecret = Bytes()
        session.clientApplication = Bytes()
        session.serverApplication = Bytes()
    }
}

// QUIC must reassemble CRYPTO offsets before calling this. A fragmented
// handshake message must stay at its original encryption level.
public function receiveHandshake(session: Session, data: Bytes, level: Integer) {
    if session.state == FAILED || session.state == CLOSED { return }
    if !session.quic || (level != INITIAL_KEYS && level != HANDSHAKE_KEYS && !(level == APPLICATION_KEYS && session.state == ESTABLISHED)) ||
       (session.handshake.length > 0 && session.incomingLevel != level) ||
       data.length > 1048576 || session.handshake.length + data.length > 1048576 {
        abandon(session, "invalid QUIC TLS input level or buffer size")
        return
    }
    session.incomingLevel = level
    session.handshake.addBytes(data)
    handshakeMessages(session)
}

// ----- Application data -----

public function send(session: Session, data: Bytes) {
    if session.quic {
        abandon(session, "QUIC protects application packets outside the TLS record layer")
        return
    }
    if session.state != ESTABLISHED {
        abandon(session, "data was sent before the handshake finished")
        return
    }
    encrypt(session, 23, data)
}

// Tell the server we are done.
public function close(session: Session) {
    if session.state == ESTABLISHED {
        if !session.quic { encrypt(session, 21, crypto.fromHex("0100")) }
        session.state = CLOSED
    }
}

// TCP EOF without the authenticated close_notify is a truncation error.
// QUIC uses its own authenticated connection close and must not call this.
public function endInput(session: Session) {
    if session.state != FAILED && session.state != CLOSED {
        abandon(session, "the transport closed without TLS close_notify")
    }
}

public function takeOutgoing(session: Session): Bytes {
    let data = session.outgoing
    session.outgoing = Bytes()
    return data
}

public function takeIncoming(session: Session): Bytes {
    let data = session.incoming
    session.incoming = Bytes()
    return data
}

public function established(session: Session): Boolean {
    return session.state == ESTABLISHED
}
