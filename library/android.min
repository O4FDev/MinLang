// Android owns the UI thread. This blocking host runs Minyar on one native
// worker; only copied descriptions and events cross the Java/native boundary.
public constant ACTION = 1
public constant CHANGE = 2
public constant SUBMIT = 6

public record Event { kind: Integer; key: Text; text: Text; checked: Boolean }
record Session { callback: (Integer) -> Nothing }

/// Keep the model alive on its creating worker until the Android host stops.
public function run(title: Text, draw: () -> Nothing, update: (Event) -> Nothing) {
    let session = Session { callback: function(kind: Integer) {
        if kind != 0 {
            update(Event { kind: kind; key: eventKeyRaw(); text: eventTextRaw(); checked: eventCheckedRaw() })
        }
        draw()
    } }
    runRaw(title, session)
}

// Kinds match ui. Each call copies Text before returning to managed code.
public function begin() { native "mobileandroid" }
public function node(parent: Integer, kind: Integer, key: Text, text: Text, checked: Boolean, spacing: Integer, padding: Integer): Integer { native "mobileandroid" }
public function end() { native "mobileandroid" }

function runRaw(title: Text, session: Session) { native "mobileandroid" }
function eventKeyRaw(): Text { native "mobileandroid" }
function eventTextRaw(): Text { native "mobileandroid" }
function eventCheckedRaw(): Boolean { native "mobileandroid" }
