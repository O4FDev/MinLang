// Serves a connect.Server behind library/httpserver.min. Only this module
// touches the network; connect.min itself turns requests into responses.
use "httpserver" as http
use "connect" as connect
use "rpc" as rpc

public function fromHttp(request: http.Request): connect.Request {
    let headers: List<rpc.Header> = []
    for field in request.headers { headers.add(rpc.Header { name: field.name; value: field.value }) }
    return connect.Request { method: request.method; target: request.target; headers: headers; body: request.body }
}
public function toHttp(response: connect.Response): http.Response {
    let headers: List<http.Header> = []
    for field in response.headers { headers.add(http.Header { name: field.name; value: field.value }) }
    return http.Response { status: response.status; headers: headers; body: response.body }
}
// Answers one polled request. A response httpserver refuses, such as a
// handler header value outside ASCII, becomes an INTERNAL error instead.
public function serve(server: http.Server, service: connect.Server, request: http.Request): Boolean {
    if http.respond(server, request, toHttp(service.handle(fromHttp(request)))) { return true }
    let fallback = connect.Response { status: 500; headers: [rpc.Header { name: "content-type"; value: "application/json" }];
        body: connect.errorJson(rpc.failure(rpc.INTERNAL, "the response could not be sent")) }
    if http.respond(server, request, toHttp(fallback)) { return true }
    http.abandon(server, request)
    return false
}
