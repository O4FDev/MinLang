public constant KEY_LEFT_CONTROL = 341
public constant KEY_LEFT_ALT = 342

public constant MOUSE_LEFT = 0
public constant MOUSE_RIGHT = 1
public constant MOUSE_MIDDLE = 2

// Whether a key is held now.
public function keyDown(key: Integer): Boolean {
    native "graphics"
}

// Whether a key went down since the previous frame.
public function keyPressed(key: Integer): Boolean {
    native "graphics"
}

public function mouseDown(button: Integer): Boolean {
    native "graphics"
}

public function mousePressed(button: Integer): Boolean {
    native "graphics"
}

// Pointer position in window points.
public function mouseX(): Float {
    native "graphics"
}

public function mouseY(): Float {
    native "graphics"
}

// Pointer movement since the previous frame, also reported while captured.
public function mouseMoveX(): Float {
    native "graphics"
}

public function mouseMoveY(): Float {
    native "graphics"
}

// Scroll wheel movement since the previous frame.
public function scroll(): Float {
    native "graphics"
}

// Hide the pointer and keep it in the window, for mouse-look cameras.
public function captureMouse(captured: Boolean) {
    native "graphics"
}

public function mouseCaptured(): Boolean {
    native "graphics"
}

// ----- 3D drawing -----

public function clear(red: Float, green: Float, blue: Float) {
    native "graphics"
}

// Place the camera. Yaw and pitch are in radians: yaw 0 looks toward -z,
// positive yaw turns toward +x, and positive pitch looks up. The field of view
// is the vertical angle in degrees.
public function setCamera(x: Float, y: Float, z: Float, yaw: Float, pitch: Float, fieldOfView: Float) {
    native "graphics"
}

// Blend surfaces toward a colour between two distances from the camera.
public function setFog(red: Float, green: Float, blue: Float, start: Float, end: Float) {
    native "graphics"
}

// Scale the brightness of meshes and lines, for example to darken the world at
// night. 1.0 is normal brightness; fog is not affected.
public function setLight(level: Float) {
    native "graphics"
}

// Use RGBA pixels, four bytes each and row by row from the top, as the texture
// for meshes and overlay images. Texture coordinates run from 0 to 1.
public function setTexture(pixels: Bytes, width: Integer, height: Integer) {
    native "graphics"
}

// A mesh is a list of triangles stored on the graphics card. Build its vertices
// with addVertex, three per triangle, counter-clockwise when seen from the front.
public function createMesh(): Integer {
    native "graphics"
}

public function updateMesh(mesh: Integer, vertices: Bytes) {
    native "graphics"
}

public function drawMesh(mesh: Integer) {
    native "graphics"
}

// Draw a mesh partly see-through, such as water or glass, with an opacity from
// 0 to 1. Draw these after all opaque meshes; both sides are visible.
public function drawTranslucentMesh(mesh: Integer, opacity: Float) {
    native "graphics"
}

public function deleteMesh(mesh: Integer) {
    native "graphics"
}

// Append one vertex: a position, a texture coordinate, and a colour that
// multiplies the texture (use 1.0, 1.0, 1.0 for the texture's own colour).
public function addVertex(vertices: Bytes, x: Float, y: Float, z: Float, u: Float, v: Float, red: Float, green: Float, blue: Float) {
    native "graphics"
}

public function drawLine(x1: Float, y1: Float, z1: Float, x2: Float, y2: Float, z2: Float, red: Float, green: Float, blue: Float) {
    native "graphics"
}

// Outline the box between two opposite corners.
public function drawBox(x1: Float, y1: Float, z1: Float, x2: Float, y2: Float, z2: Float, red: Float, green: Float, blue: Float) {
    drawLine(x1, y1, z1, x2, y1, z1, red, green, blue)
    drawLine(x2, y1, z1, x2, y1, z2, red, green, blue)
    drawLine(x2, y1, z2, x1, y1, z2, red, green, blue)
    drawLine(x1, y1, z2, x1, y1, z1, red, green, blue)
    drawLine(x1, y2, z1, x2, y2, z1, red, green, blue)
    drawLine(x2, y2, z1, x2, y2, z2, red, green, blue)
    drawLine(x2, y2, z2, x1, y2, z2, red, green, blue)
    drawLine(x1, y2, z2, x1, y2, z1, red, green, blue)
    drawLine(x1, y1, z1, x1, y2, z1, red, green, blue)
    drawLine(x2, y1, z1, x2, y2, z1, red, green, blue)
    drawLine(x2, y1, z2, x2, y2, z2, red, green, blue)
    drawLine(x1, y1, z2, x1, y2, z2, red, green, blue)
}

// ----- 2D overlay -----
// Overlay shapes are drawn over the 3D scene when the frame is shown, in the
// order they were requested. Coordinates are window points from the top left.

public function drawRectangle(x: Float, y: Float, width: Float, height: Float, red: Float, green: Float, blue: Float, alpha: Float) {
    native "graphics"
}

// Draw part of the texture, given by texture coordinates, into a rectangle.
public function drawImage(x: Float, y: Float, width: Float, height: Float, u1: Float, v1: Float, u2: Float, v2: Float) {
    native "graphics"
}

// Draw text in a built-in pixel font with a soft shadow. Each font pixel is
// `size` points square; lines are separated by "\n". Characters outside ASCII
// are shown as '?'.
public function drawText(text: Text, x: Float, y: Float, size: Float, red: Float, green: Float, blue: Float) {
    native "graphics"
}

// The width in points of the longest line of `text` at this size.
public function textWidth(text: Text, size: Float): Float {
    native "graphics"
}
