// A window with keyboard and mouse input, textured 3D meshes, lines, and a 2D
// overlay. Import it with `use "graphics" as graphics`.
//
//     graphics.openWindow(1280, 720, "Hello")
//     while graphics.nextFrame() {
//         graphics.clear(0.5, 0.7, 1.0)
//     }

// ----- Window and frames -----

// Open the program's window. The program stops with a message if it cannot.
public function openWindow(width: Integer, height: Integer, title: Text) {
    native "graphics"
}

// Show the frame drawn since the last call, read new input, and return false
// once the window has been closed. Draw each frame inside this loop.
public function nextFrame(): Boolean {
    native "graphics"
}

public function closeWindow() {
    native "graphics"
}

public function setTitle(title: Text) {
    native "graphics"
}

// Save the next shown frame as a PNG image.
public function saveScreenshot(path: Text) {
    native "graphics"
}

// Seconds since the window opened.
public function time(): Float {
    native "graphics"
}

// Seconds between the last two frames, at most 0.1.
public function frameTime(): Float {
    native "graphics"
}

// Drawable size in pixels, which can exceed the window size on high-density screens.
public function width(): Integer {
    native "graphics"
}

public function height(): Integer {
    native "graphics"
}

// Window size in points; 2D overlay coordinates use these units.
public function windowWidth(): Integer {
    native "graphics"
}

public function windowHeight(): Integer {
    native "graphics"
}

