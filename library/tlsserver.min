function issueTicket(session: Session) {
    if session.ticketStore.key.length != 16 || session.resumptionMaster.length != 32 || (session.requireClient && session.verifiedClientChain.length == 0) { return }
    let nonce = randomBytes(8)
    let psk = crypto.expandLabel(session.resumptionMaster, "resumption", nonce, 32)
    let profile = Bytes(); let earlyLimit = 0
    if session.quic { profile = tickets.profile(session.transportParameters); if profile.length == 64 { earlyLimit = session.ticketStore.earlyLimit } }
    let now=trust.currentTimeMilliseconds();let expires=session.identityExpires
    if session.requireClient { expires=min(expires,trust.currentCertificateExpiry(session.verifiedClientChain)) }
    let issued = tickets.issueProfileUntil(session.ticketStore, psk, session.cipherSuite, session.protocol, session.serverName, session.identityHash, session.verifiedClientChain, now, earlyLimit, profile, expires)
    if !issued.valid { return }
    let body = Bytes()
    let lifetime=max(0,(issued.expires-now)/1000)
    for index in 0..4 { body.add((lifetime >> ((3 - index) * 8)) & 255) }
    for index in 0..4 { body.add((issued.ageAdd >> ((3 - index) * 8)) & 255) }
    body.add(nonce.length); body.addBytes(nonce); add16(body, issued.ticket.length); body.addBytes(issued.ticket)
    let extensions = Bytes()
    if earlyLimit > 0 {
        let limit = Bytes(); for index in 0..4 { limit.add((earlyLimit >> ((3 - index) * 8)) & 255) }
        extensions = extension(42, limit)
    }
    add16(body, extensions.length); body.addBytes(extensions)
    let ticket = message(4, body)
    if session.quic { session.applicationOutgoing.addBytes(ticket) } else { encrypt(session, 22, ticket) }
}
function messages(session: Session) {
    while session.state != FAILED && session.handshake.length >= 4 {
        let length = get24(session.handshake, 1)
        if length > 1048576 { abandon(session, "TLS handshake exceeds size limit"); return }
        if session.handshake.length < length + 4 { return }
        let item = session.handshake.slice(0, length + 4); session.handshake = session.handshake.slice(length + 4, session.handshake.length)
        let type = item[0]
        if session.quic && ((type == 1 && session.incomingLevel != INITIAL_KEYS) || (type != 1 && session.incomingLevel != HANDSHAKE_KEYS)) { abandon(session, "wrong QUIC TLS encryption level"); return }
        if type == 1 && session.stage == 0 { clientHello(session, item) }
        else if type == 11 && session.stage == 1 { clientCertificate(session, item) }
        else if type == 15 && session.stage == 2 { clientVerify(session, item) }
        else if type == 20 && session.stage == 3 { clientFinished(session, item) }
        else { abandon(session, "unexpected or out-of-order client handshake message"); return }
    }
}
public function receiveHandshake(session: Session, data: Bytes, level: Integer) {
    if session.state == FAILED || session.state == CLOSED { return }
    if !session.quic || (level != INITIAL_KEYS && level != HANDSHAKE_KEYS) ||
       (session.handshake.length > 0 && session.incomingLevel != level) || data.length > 1048576 || session.handshake.length + data.length > 1048576 {
        abandon(session, "invalid QUIC TLS server input"); return
    }
    session.incomingLevel = level; session.handshake.addBytes(data); messages(session)
}
function record(session: Session, header: Bytes, body: Bytes) {
    let type = header[0]
    if type == 20 {
        if session.state != HANDSHAKE || body.length != 1 || body[0] != 1 { abandon(session, "invalid client change-cipher-spec") }
        return
    }
    if type == 22 && session.state == STARTING { session.handshake.addBytes(body); messages(session); return }
    if type != 23 || session.readKey.length == 0 { abandon(session, "unexpected client TLS record"); return }
    let iv = nonce(session.readIv, session.readSequence)
    let opened = crypto.Opened { valid: false; plaintext: Bytes() }
    if session.cipherSuite == AES128_GCM {
        let result = aes.decrypt(session.readKey, iv, header, body)
        if result.length > 0 { opened = crypto.Opened { valid: true; plaintext: result.slice(1, result.length) } }
    } else { opened = crypto.open(session.readKey, iv, header, body) }
    session.readSequence += 1
    if !opened.valid { abandon(session, "client TLS record authentication failed"); return }
    let end = opened.plaintext.length
    while end > 0 && opened.plaintext[end - 1] == 0 { end -= 1 }
    if end == 0 || end > 16385 { abandon(session, "invalid inner TLS record"); return }
    let inner = opened.plaintext[end - 1]; let content = opened.plaintext.slice(0, end - 1)
    if inner == 22 { session.handshake.addBytes(content); messages(session) }
    else if inner == 23 {
        if session.state != ESTABLISHED { abandon(session, "application data before client authentication"); return }
        if session.incoming.length + content.length > 1048576 { abandon(session, "TLS application buffer exceeds size limit"); return }
        session.incoming.addBytes(content)
    } else if inner == 21 && content.length == 2 && content[1] == 0 && session.state == ESTABLISHED { session.state = CLOSED }
    else { abandon(session, "invalid client TLS content type or alert") }
}
public function receive(session: Session, data: Bytes) {
    if session.state == FAILED || session.state == CLOSED { return }
    if session.quic || data.length > 1048576 || session.received.length + data.length > 1048576 { abandon(session, "invalid TLS server transport input"); return }
    session.received.addBytes(data)
    while session.state != FAILED && session.state != CLOSED && session.received.length >= 5 {
        let size = get16(session.received, 3); let version = get16(session.received, 1)
        if size > 16640 || (version != 0x0303 && !(session.state == STARTING && version == 0x0301)) { abandon(session, "invalid client TLS record version or size"); return }
        if session.received.length < size + 5 { return }
        let header = session.received.slice(0, 5); let body = session.received.slice(5, size + 5)
        session.received = session.received.slice(size + 5, session.received.length)
        record(session, header, body)
    }
}
public function takeOutgoing(session: Session): Bytes { let result = session.outgoing; session.outgoing = Bytes(); return result }
// TCP EOF requires close_notify. A QUIC CRYPTO stream has no TLS record EOF;
// once complete, connection closure is authenticated by the QUIC transport.
public function endInput(session: Session) {
    if session.state == CLOSED || session.state == FAILED { return }
    if session.quic && session.state == ESTABLISHED && session.handshake.length == 0 { return }
    abandon(session, "TLS server input ended before authenticated close or handshake completion")
}
public function takeInitial(session: Session): Bytes { let result = session.initialOutgoing; session.initialOutgoing = Bytes(); return result }
public function takeHandshake(session: Session): Bytes { let result = session.handshakeOutgoing; session.handshakeOutgoing = Bytes(); return result }
public function takeApplication(session: Session): Bytes { let result = session.applicationOutgoing; session.applicationOutgoing = Bytes(); return result }
public function takeIncoming(session: Session): Bytes { let result = session.incoming; session.incoming = Bytes(); return result }
public function send(session: Session, data: Bytes) {
    if session.quic || session.state != ESTABLISHED { abandon(session, "TLS application send before handshake or through QUIC"); return }
    encrypt(session, 23, data)
}
public function close(session: Session) {
    if session.state == ESTABLISHED {
        if !session.quic { encrypt(session, 21, crypto.fromHex("0100")) }
        session.state = CLOSED
    }
}
