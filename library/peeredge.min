// One-owner Hearth edge reactor. Protocol state, scheduling, certificate-to-
// registry binding and the live capacity plane are implemented in Minyar.
use "errors" as errors
use "json" as json
use "crypto" as crypto
use "net" as net
use "eventloop" as loop
use "eventcallbacks" as callbacks
use "quic" as quic
use "quicwire" as quicwire
use "quicretry" as retry
use "quicdispatch" as dispatch
use "transport" as transport
use "tlsserver" as tls
use "tlsverify" as trust
use "peerauth" as auth
use "peerwire" as wire
use "peerlive" as live
use "redis" as redis
use "resp2" as resp

record Configuration {
    valid: Boolean; host: Text; devicePort: Integer; gatewayPort: Integer
    redisHost: Text; redisPort: Integer; instance: Text; region: Text; maximum: Integer
    certificate: Text; key: Text; deviceRoots: Text; gatewayRoots: Text; registry: Text; jwks: Text
}
function numeric(value: json.Value, name: Text, maximum: Integer): Integer {
    let member = json.member(value,name)
    if member.kind != json.NUMBER || member.text.length < 1 || member.text.length > 10 { return -1 }
    let result = 0
    for c in member.text {
        if c < '0' || c > '9' { return -1 }
        result = result * 10 + Integer(c) - 48
        if result > maximum { return -1 }
    }
    return result
}
function path(value: json.Value, name: Text): Text {
    let result = json.string(value,name)
    if result.length < 1 || result.length > 4095 { return "" }
    for c in result { if Integer(c) < 32 { return "" } }
    return result
}
function configuration(data: Bytes): Configuration {
    let value = json.parseUniqueBytes(data,8192)
    let result = Configuration { valid: false; host: json.string(value,"host"); devicePort: numeric(value,"device_port",65535); gatewayPort: numeric(value,"gateway_port",65535)
        redisHost: json.string(value,"redis_host"); redisPort: numeric(value,"redis_port",65535); instance: json.string(value,"edge_instance"); region: json.string(value,"edge_region"); maximum: numeric(value,"max_connections",32768)
        certificate: path(value,"certificate"); key: path(value,"private_key"); deviceRoots: path(value,"device_roots"); gatewayRoots: path(value,"gateway_roots"); registry: path(value,"registry"); jwks: path(value,"jwks") }
    let endpoint = result.instance
    if endpoint.length > 2 && endpoint.slice(endpoint.length-2,endpoint.length) == ":0" { endpoint = endpoint.slice(0,endpoint.length-1) + "1" }
    if value.kind != json.OBJECT || result.host.length < 1 || result.host.length > 255 || result.redisHost.length < 1 || result.redisHost.length > 255 || !live.edgeEndpoint(endpoint) || !live.identifier(result.region) ||
       result.devicePort < 0 || result.gatewayPort < 0 || result.redisPort < 1 || result.maximum < 1 || result.certificate == "" || result.key == "" || result.deviceRoots == "" || result.gatewayRoots == "" || result.registry == "" || result.jwks == "" { return result }
    for name in value.keys {
        if name != "host" && name != "device_port" && name != "gateway_port" && name != "redis_host" && name != "redis_port" && name != "edge_instance" && name != "edge_region" && name != "max_connections" && name != "certificate" && name != "private_key" && name != "device_roots" && name != "gateway_roots" && name != "registry" && name != "jwks" { return result }
    }
    result.valid = true; return result
}
record RegistryEntry { device: Text; exit: Text; revoked: Boolean; paused: Boolean; quarantined: Boolean; maximum: Integer }
record Registry { valid: Boolean; entries: List<RegistryEntry>; index: dispatch.Table; exits: dispatch.Table; gateways: List<Text> }
function identityKey(text: Text): Bytes { return crypto.sha256(Bytes(text)).slice(0,20) }
function registry(data: Bytes, maximum: Integer): Registry {
    let result = Registry { valid: false; entries: []; index: dispatch.table(maximum,65536,randomBytes(16)); exits: dispatch.table(maximum,65536,randomBytes(16)); gateways: [] }
    if data.length < 1 || data.length > 16777216 { return result }
    let start = 0
    for end in 0..data.length + 1 {
        if end == data.length || data[end] == 10 {
            if end > start {
                let value = json.parseUniqueBytes(data.slice(start,end),2048)
                if value.kind != json.OBJECT { return result }
                let role = json.string(value,"role")
                if role == "gateway" {
                    if value.keys.length != 2 || json.string(value,"sha256").length != 64 { return result }
                    let fingerprint = json.string(value,"sha256")
                    for c in fingerprint { if !((c >= 'a' && c <= 'f') || (c >= '0' && c <= '9')) { return result } }
                    if result.gateways.length >= 128 { return result }; result.gateways.add(fingerprint)
                } else {
                    let entry = RegistryEntry { device: json.string(value,"device_id"); exit: json.string(value,"exit_id"); revoked: json.member(value,"revoked").truth; paused: json.member(value,"paused").truth; quarantined: json.member(value,"quarantined").truth; maximum: numeric(value,"max_concurrent",1000000) }
                    if role != "device" || !live.identifier(entry.device) || !live.identifier(entry.exit) || entry.maximum < 1 || value.keys.length != 7 ||
                       json.member(value,"revoked").kind != json.BOOLEAN || json.member(value,"paused").kind != json.BOOLEAN || json.member(value,"quarantined").kind != json.BOOLEAN || result.entries.length >= maximum { return result }
                    let key = identityKey(entry.device)
                    let exitKey = identityKey(entry.exit)
                    if dispatch.lookup(result.index,key) >= 0 || dispatch.lookup(result.exits,exitKey) >= 0 || !errors.booleanOk(dispatch.insert(result.index,key,result.entries.length)) || !errors.booleanOk(dispatch.insert(result.exits,exitKey,result.entries.length)) { return result }
                    result.entries.add(entry)
                }
            }
            start = end + 1
        }
    }
    result.valid = result.entries.length > 0 && result.gateways.length > 0; return result
}
function registryID(registry: Registry, device: Text): Integer {
    if !registry.valid { return -1 }
    let index = dispatch.lookup(registry.index,identityKey(device))
    if index >= 0 && registry.entries[index].device == device { return index }
    return -1
}
record Address { host: Text; port: Integer }
record InputStream { id: Integer; decoder: wire.Decoder }
record Peer {
    live: Boolean; queued: Boolean; flags: Integer; mode: Integer; socket: Integer; watch: Integer
    connection: transport.Connection; gateway: tls.Session; decoder: wire.Decoder; inputs: List<InputStream>
    paths: List<Address>; routed: Bytes; output: Bytes; outputAt: Integer; since: Integer
    bound: Boolean; device: Text; exit: Text; epoch: Text; health: live.Health; heartbeatAt: Integer
    control: Integer; published: Boolean; publicationPending: Boolean; redisQueued: Boolean; admitted: Integer
}
record Publication { peer: Integer; epoch: Text; operation: Integer }
record Core {
    config: Configuration; dispatcher: callbacks.Dispatcher; now: Integer; started: Integer
    identity: List<Bytes>; key: Bytes; deviceRoots: List<Bytes>; gatewayRoots: List<Bytes>; registry: Registry; keys: auth.KeySet
    udp: Integer; deviceListener: Integer; gatewayListener: Integer
    peers: List<Peer>; free: List<Integer>; freeCount: Integer; active: Integer
    retry: retry.Store; noRetry: retry.Opened; allocated: Integer; retryReplies: Integer; retryValidated: Integer
    work: List<Integer>; workAt: Integer; routing: dispatch.Table; exits: dispatch.Table; timers: dispatch.Timers
    redisSocket: Integer; redisWatch: Integer; redisClient: redis.Client; publications: List<Publication>; publicationAt: Integer
    redisReconnectAt: Integer; redisFlags: Integer; redisConnecting: Boolean; redisConnectDeadline: Integer; registryAt: Integer; keysAt: Integer
}
function mark(core: Core, id: Integer) {
    if id >= 0 && id < core.peers.length && core.peers[id].live && !core.peers[id].queued { core.peers[id].queued = true; core.work.add(id) }
}
function watchPeer(core: Core, id: Integer) {
    let peer = core.peers[id]; let socket = peer.socket
    let watched = callbacks.watch(core.dispatcher,socket,loop.readableInterest(),id,function(event: loop.Event) {
        if id < core.peers.length && core.peers[id].live && core.peers[id].socket == socket { core.peers[id].flags = core.peers[id].flags | event.flags; mark(core,id) }
    })
    if errors.integerOk(watched) { peer.watch = errors.integerValue(watched) } else { drop(core,id) }
}
function interests(core: Core, peer: Peer) {
    if peer.watch > 0 { let interest = loop.readableInterest(); if peer.outputAt < peer.output.length { interest = loop.readWriteInterest() }; callbacks.update(core.dispatcher,peer.watch,interest,0) }
}
function allocate(core: Core, mode: Integer, socket: Integer, original: Bytes, address: Address, validated: retry.Opened): Integer {
    if mode == 0 && !retry.valid(validated) { return -1 }
    if core.active >= core.config.maximum { if socket >= 0 { net.close(socket) }; return -1 }
    let connection = transport.client("inactive.invalid",Bytes(),"inactive",[],[],Bytes())
    if mode == 0 { connection = transport.serverQUICAfterRetry(randomBytes(80),"hearth-peer",validated,core.identity,core.key,core.deviceRoots,true) }
    if mode == 1 { connection = transport.serverTCP(randomBytes(80),"hearth-peer",core.identity,core.key,core.deviceRoots,true,core.now) }
    let gateway = tls.none()
    if mode == 2 { gateway = tls.server(randomBytes(64),"h2",core.identity,core.key,core.gatewayRoots,true) }
    let peer = Peer { live: true; queued: false; flags: 0; mode: mode; socket: socket; watch: 0; connection: connection; gateway: gateway; decoder: wire.create(); inputs: []
        paths: [address]; routed: original; output: Bytes(); outputAt: 0; since: core.now; bound: false; device: ""; exit: ""; epoch: ""; health: live.heartbeat(Bytes()); heartbeatAt: -1
        control: -1; published: false; publicationPending: false; redisQueued: false; admitted: 0 }
    let id = core.peers.length
    if core.freeCount > 0 { core.freeCount -= 1; id = core.free[core.freeCount] }
    if id == core.peers.length { core.peers.add(peer) } else { core.peers[id] = peer }
    core.active += 1; core.allocated += 1
    if mode == 0 {
        if !errors.booleanOk(dispatch.insert(core.routing,connection.udp.local,id)) || !errors.booleanOk(dispatch.insert(core.routing,peer.routed,id)) { drop(core,id); return -1 }
    } else { watchPeer(core,id) }
    if !peer.live { return -1 }
    mark(core,id); return id
}
function queuePublication(core: Core, id: Integer, operation: Integer): Boolean {
    if core.redisSocket < 0 || core.redisConnecting || redis.closed(core.redisClient) { return false }
    let peer = core.peers[id]; let command = live.dropCommand(peer.exit,peer.epoch)
    if operation != 3 {
        let at = registryID(core.registry,peer.device)
        if at < 0 || !live.ok(peer.health) { return false }
        let entry = core.registry.entries[at]
        let health = live.capMaximum(peer.health,entry.maximum)
        let state = live.payloadRegion(health,peer.exit,core.config.instance,core.config.region,peer.epoch,trust.currentTimeMilliseconds()/1000,peer.admitted,entry.paused,entry.quarantined,1.0)
        if !errors.bytesOk(state) { return false }
        if operation == 1 { command = live.bindCommand(peer.exit,peer.epoch,errors.bytesValue(state)) }
        else { command = live.refreshCommand(peer.exit,peer.epoch,errors.bytesValue(state)) }
    }
    if !errors.bytesOk(command) { return false }
    let parsed = resp.parse(errors.bytesValue(command)); let arguments: List<Bytes> = []
    if !resp.ok(parsed) { fail("invalid internal live-state command") }
    for item in resp.items(resp.value(parsed)) { arguments.add(resp.data(item)) }
    let queued = redis.queue(core.redisClient,arguments)
    if !errors.booleanOk(queued) { return false }
    if core.publicationAt >= 1024 && core.publicationAt * 2 >= core.publications.length {
        let retained: List<Publication> = []; for at in core.publicationAt..core.publications.length { retained.add(core.publications[at]) }; core.publications = retained; core.publicationAt = 0
    }
    core.publications.add(Publication { peer: id; epoch: peer.epoch; operation: operation })
    if operation != 3 { peer.redisQueued = true }
    callbacks.update(core.dispatcher,core.redisWatch,loop.readWriteInterest(),0); return true
}
function drop(core: Core, id: Integer) {
    let peer = core.peers[id]
    if !peer.live { return }
    if peer.bound {
        let key = identityKey(peer.exit)
        if dispatch.lookup(core.exits,key) == id { dispatch.remove(core.exits,key); queuePublication(core,id,3) }
    }
    if peer.mode == 0 { dispatch.remove(core.routing,peer.connection.udp.local); dispatch.remove(core.routing,peer.routed) }
    if peer.watch > 0 { callbacks.cancel(core.dispatcher,peer.watch) }
    if peer.socket >= 0 { net.close(peer.socket) }
    dispatch.cancel(core.timers,id); peer.live = false; peer.output = Bytes(); peer.inputs = []; peer.paths = []; peer.device = ""; peer.exit = ""; peer.epoch = ""; peer.health = live.heartbeat(Bytes()); peer.decoder = wire.create()
    peer.connection = transport.client("retired.invalid",Bytes(),"retired",[],[],Bytes()); peer.gateway = tls.none()
    core.active -= 1
    if core.freeCount == core.free.length { core.free.add(id) } else { core.free[core.freeCount] = id }; core.freeCount += 1
}
function session(peer: Peer): tls.Session { if peer.mode == 0 { return peer.connection.udp.serverTLS }; return peer.connection.serverTLS }
function controlFrame(core: Core, id: Integer, stream: Integer, frame: wire.FrameResult) {
    let peer = core.peers[id]
    if wire.kind(frame) == wire.HELLO && !peer.bound {
        let value = json.parseUniqueBytes(wire.payload(frame),16384); let device = json.string(value,"device_id"); let at = registryID(core.registry,device)
        if at < 0 { drop(core,id); return }
        let entry = core.registry.entries[at]; let binding = auth.bindDevice(session(peer),entry.device,entry.exit,entry.revoked)
        if !auth.bindingOk(binding) || !errors.booleanOk(wire.helloMatches(frame,binding)) { drop(core,id); return }
        let key = identityKey(entry.exit); let previous = dispatch.lookup(core.exits,key)
        if previous >= 0 {
            if core.peers[previous].exit != entry.exit { drop(core,id); return }
            drop(core,previous)
        }
        if !errors.booleanOk(dispatch.insert(core.exits,key,id)) { drop(core,id); return }
        peer.bound = true; peer.device = entry.device; peer.exit = entry.exit; peer.epoch = crypto.hex(randomBytes(32)); peer.control = stream; peer.heartbeatAt = core.now
    } else if wire.kind(frame) == wire.HEARTBEAT && peer.bound && peer.control == stream {
        let at = registryID(core.registry,peer.device)
        if at < 0 || core.registry.entries[at].revoked || core.registry.entries[at].exit != peer.exit { drop(core,id); return }
        let health = live.heartbeat(wire.payload(frame)); if !live.ok(health) { drop(core,id); return }
        peer.health = health; peer.heartbeatAt = core.now; peer.publicationPending = true
    } else { drop(core,id) }
}
function deviceInput(core: Core, id: Integer) {
    let peer = core.peers[id]
    for handle in transport.streamIds(peer.connection) {
        let at = -1
        for index in 0..peer.inputs.length { if peer.inputs[index].id == handle { at = index; break } }
        if at < 0 {
            if peer.inputs.length >= 128 { drop(core,id); return }
            at = peer.inputs.length; peer.inputs.add(InputStream { id: handle; decoder: wire.create() })
        }
        let input = transport.read(peer.connection,handle)
        if errors.bytesStatus(input) == errors.endOfStreamStatus() { drop(core,id); return }
        if errors.bytesOk(input) {
            let decoder = peer.inputs[at].decoder
            if !errors.booleanOk(wire.feed(decoder,errors.bytesValue(input))) { drop(core,id); return }
            let frame = wire.take(decoder); let count = 0
            while wire.frameOk(frame) && count < 256 && peer.live {
                controlFrame(core,id,handle,frame); count += 1
                if peer.live { frame = wire.take(decoder) }
            }
            if !peer.live { return }
            if count == 256 { mark(core,id) }
            else if !errors.isWouldBlock(wire.frameError(frame)) { drop(core,id); return }
        } else if !errors.isWouldBlock(errors.bytesError(input)) { drop(core,id); return }
    }
}
function publish(core: Core, id: Integer) {
    let peer = core.peers[id]
    if peer.bound && peer.publicationPending && !peer.redisQueued {
        let operation = 2; if !peer.published { operation = 1 }
        if queuePublication(core,id,operation) { peer.publicationPending = false }
    }
}
function peerTick(core: Core, id: Integer) {
    let peer = core.peers[id]; peer.queued = false
    if !peer.live { return }
    if (!peer.bound && core.now - peer.since >= 10000) || (peer.bound && core.now - peer.heartbeatAt >= 45000) { drop(core,id); return }
    if peer.mode != 2 {
        if peer.socket >= 0 && (peer.flags & 13) != 0 {
            for reads in 0..16 {
                let data = net.read(peer.socket,65536)
                if errors.bytesStatus(data) == errors.endOfStreamStatus() { transport.endTCPInput(peer.connection); break }
                else if errors.bytesOk(data) { transport.receiveTCP(peer.connection,errors.bytesValue(data),core.now) }
                else if errors.isWouldBlock(errors.bytesError(data)) { break }
                else { transport.endTCPInput(peer.connection); break }
            }
        }
        if peer.connection.state == transport.QUIC_READY || peer.connection.state == transport.TCP_READY { deviceInput(core,id) }
        if !peer.live { return }
        publish(core,id)
        if peer.mode == 0 {
            for packet in transport.pollUDP(peer.connection,core.now) {
                if packet.pathId >= 0 && packet.pathId < peer.paths.length { let address = peer.paths[packet.pathId]; net.sendDatagramTo(core.udp,address.host,address.port,packet.data) }
            }
        } else {
            let bytes = transport.pollTCP(peer.connection,core.now)
            if bytes.length > 1048576 - (peer.output.length-peer.outputAt) { drop(core,id); return }
            if peer.outputAt > 0 { peer.output = peer.output.slice(peer.outputAt,peer.output.length); peer.outputAt = 0 }
            peer.output.addBytes(bytes)
        }
        if (peer.connection.state == transport.FAILED || peer.connection.state == transport.CLOSED) && !peer.connection.udp.closing && !peer.connection.udp.draining { drop(core,id); return }
    } else {
        // Gateway HTTP/2/gRPC framing is supplied by peergrpc; its mTLS identity
        // must first match this trusted, refreshable regional registry.
        if (peer.flags & 13) != 0 {
            for reads in 0..16 {
                let data = net.read(peer.socket,65536)
                if errors.bytesStatus(data) == errors.endOfStreamStatus() { tls.endInput(peer.gateway); break }
                else if errors.bytesOk(data) { tls.receive(peer.gateway,errors.bytesValue(data)) }
                else if errors.isWouldBlock(errors.bytesError(data)) { break }
                else { tls.endInput(peer.gateway); break }
            }
        }
        if peer.gateway.state == tls.ESTABLISHED && !peer.bound {
            let fingerprint = crypto.hex(crypto.sha256(peer.gateway.peerCertificate)); let trusted = false
            for expected in core.registry.gateways { if expected == fingerprint { trusted = true } }
            if !peer.gateway.authenticated || !peer.gateway.requireClient || !trusted { drop(core,id); return }
            peer.bound = true; peer.heartbeatAt = core.now
        }
        if peer.gateway.state == tls.FAILED || peer.gateway.state == tls.CLOSED { drop(core,id); return }
        peer.output.addBytes(tls.takeOutgoing(peer.gateway))
    }
    if peer.socket >= 0 && peer.outputAt < peer.output.length {
        for writes in 0..16 {
            let data = peer.output.slice(peer.outputAt,min(peer.output.length,peer.outputAt+65536)); let written = net.write(peer.socket,data)
            if errors.integerOk(written) { let count = errors.integerValue(written); if count == 0 { drop(core,id); return }; peer.outputAt += count; if peer.outputAt == peer.output.length { peer.output = Bytes(); peer.outputAt = 0; break } }
            else if errors.isWouldBlock(errors.integerError(written)) { break }
            else { drop(core,id); return }
        }
        interests(core,peer)
    }
    peer.flags = 0
    let deadline = peer.since + 10000
    if peer.bound { deadline = peer.heartbeatAt + 45000 }
    if peer.mode != 2 { let transportDeadline = transport.nextTimer(peer.connection); if transportDeadline >= 0 { deadline = min(deadline,transportDeadline) } }
    dispatch.schedule(core.timers,id,deadline)
}
function redisOffline(core: Core) {
    if core.redisWatch > 0 { callbacks.cancel(core.dispatcher,core.redisWatch) }
    if core.redisSocket >= 0 { net.close(core.redisSocket) }
    core.redisSocket = -1; core.redisWatch = 0; core.redisFlags = 0; core.redisConnecting = false; core.redisReconnectAt = core.now + 1000
    redis.abort(core.redisClient,errors.make(errors.closedCode(),0,"Redis connection retired")); core.publications = []; core.publicationAt = 0
    for peer in core.peers { if peer.live && peer.mode != 2 { peer.published = false; peer.redisQueued = false; peer.publicationPending = peer.bound; if peer.bound { peer.epoch = crypto.hex(randomBytes(32)) } } }
}
function redisService(core: Core) {
    if core.redisSocket < 0 && core.now >= core.redisReconnectAt {
        let started = net.connectStart(core.config.redisHost,core.config.redisPort)
        if !errors.integerOk(started) { core.redisReconnectAt = core.now + 1000; return }
        let socket = errors.integerValue(started)
        core.redisSocket = socket; core.redisClient = redis.create()
        core.redisConnecting = true; core.redisConnectDeadline = core.now + 3000
        let watched = callbacks.watch(core.dispatcher,socket,loop.readWriteInterest(),0,function(event: loop.Event) { core.redisFlags = core.redisFlags | event.flags })
        if !errors.integerOk(watched) { redisOffline(core); return }
        core.redisWatch = errors.integerValue(watched)
    }
    if core.redisSocket < 0 { return }
    if core.redisConnecting {
        let finished = net.connectFinish(core.redisSocket)
        if !errors.booleanOk(finished) {
            if !errors.isWouldBlock(errors.booleanError(finished)) || core.now >= core.redisConnectDeadline { redisOffline(core) }
            return
        }
        core.redisConnecting = false
        callbacks.update(core.dispatcher,core.redisWatch,loop.readableInterest(),0)
        for index in 0..core.peers.length { if core.peers[index].live && core.peers[index].bound && core.peers[index].mode != 2 { mark(core,index) } }
    }
    if (core.redisFlags & 13) != 0 {
        for reads in 0..16 {
            let data = net.read(core.redisSocket,65536)
            if errors.bytesStatus(data) == errors.endOfStreamStatus() { redisOffline(core); return }
            else if errors.bytesOk(data) { if !errors.booleanOk(redis.feed(core.redisClient,errors.bytesValue(data))) { redisOffline(core); return } }
            else if errors.isWouldBlock(errors.bytesError(data)) { break }
            else { redisOffline(core); return }
        }
    }
    for writes in 0..16 {
        let outgoing = redis.outgoing(core.redisClient,65536); if outgoing.length == 0 { break }
        let written = net.write(core.redisSocket,outgoing)
        if errors.integerOk(written) { let count = errors.integerValue(written); if count == 0 { redisOffline(core); return }; redis.sent(core.redisClient,count) }
        else if errors.isWouldBlock(errors.integerError(written)) { break }
        else { redisOffline(core); return }
    }
    for replies in 0..4096 {
        let reply = redis.reply(core.redisClient)
        if !redis.ok(reply) { if !errors.isWouldBlock(redis.error(reply)) { redisOffline(core) }; break }
        if core.publicationAt >= core.publications.length { redisOffline(core); return }
        let operation = core.publications[core.publicationAt]; core.publicationAt += 1
        if operation.peer < core.peers.length {
            let peer = core.peers[operation.peer]; let value = redis.value(reply)
            if peer.live && peer.epoch == operation.epoch && operation.operation != 3 {
                peer.redisQueued = false
                peer.published = (operation.operation == 1 && resp.kind(value) == resp.SIMPLE && Text(resp.data(value)) == "OK") || (operation.operation == 2 && resp.kind(value) == resp.INTEGER && resp.integer(value) == 1)
                if !peer.published { drop(core,operation.peer) } else { mark(core,operation.peer) }
            }
        }
    }
    if core.redisSocket >= 0 {
        let interest = loop.readableInterest(); if redis.outgoing(core.redisClient,1).length > 0 { interest = loop.readWriteInterest() }
        callbacks.update(core.dispatcher,core.redisWatch,interest,0); core.redisFlags = 0
    }
}
function acceptPeers(core: Core, listener: Integer, mode: Integer) {
    core.now = net.monotonicMilliseconds() - core.started
    for accepted in 0..64 {
        let socket = net.accept(listener); if socket < 0 { break }
        allocate(core,mode,socket,randomBytes(8),Address { host: ""; port: 0 },core.noRetry)
    }
}
function udpInput(core: Core) {
    core.now = net.monotonicMilliseconds() - core.started
    let batch = net.receiveDatagrams(core.udp,64,1500)
    if !net.datagramBatchOk(batch) { return }
    for packet in net.datagrams(batch) {
        let received = net.datagramData(packet)
        if errors.bytesOk(received) {
            let data = errors.bytesValue(received); let cid = quicwire.destinationId(data,8)
            if errors.bytesOk(cid) {
                let destination = errors.bytesValue(cid); let id = dispatch.lookup(core.routing,destination)
                if id < 0 {
                    let header = quicwire.header(data,0,8)
                    if header.valid && header.kind == quicwire.INITIAL && data.length >= 1200 {
                        let address = Address { host: net.datagramSource(packet); port: net.datagramPort(packet) }
                        let canonical = Bytes("[" + address.host + "]:" + Text(address.port))
                        if header.token.length == 0 {
                            let response = retry.reply(core.retry,data,canonical,randomBytes(8),core.now)
                            if errors.bytesOk(response) {
                                net.sendDatagramTo(core.udp,address.host,address.port,errors.bytesValue(response))
                                core.retryReplies += 1
                            }
                        } else {
                            let validated = retry.validateInitial(core.retry,data,canonical,core.now)
                            if retry.valid(validated) {
                                id = allocate(core,0,-1,header.destination,address,validated)
                                if id >= 0 { core.retryValidated += 1 }
                            }
                        }
                    }
                }
                if id >= 0 && core.peers[id].live {
                    let peer = core.peers[id]; let path = -1
                    for index in 0..peer.paths.length { if peer.paths[index].host == net.datagramSource(packet) && peer.paths[index].port == net.datagramPort(packet) { path = index; break } }
                    let provisional = false
                    if path < 0 && peer.paths.length < 8 { path = peer.paths.length; provisional = true; peer.paths.add(Address { host: net.datagramSource(packet); port: net.datagramPort(packet) }) }
                    if path >= 0 {
                        transport.receiveUDP(peer.connection,data,path,core.now)
                        // A visible CID alone does not authenticate a source.
                        // Keep new addresses only after QUIC admitted the path.
                        if provisional {
                            let authenticated = false
                            for known in peer.connection.udp.paths { if known.id == path { authenticated = true } }
                            if !authenticated { let retained: List<Address> = []; for at in 0..path { retained.add(peer.paths[at]) }; peer.paths = retained }
                        }
                        mark(core,id)
                    }
                }
            }
        }
    }
}
function refresh(core: Core) {
    if core.now >= core.registryAt {
        core.registry = registry(readBytesFile(core.config.registry),core.config.maximum); core.registryAt = core.now + 15000
        for index in 0..core.peers.length {
            let peer = core.peers[index]
            if peer.live && peer.bound && peer.mode != 2 {
                let at = registryID(core.registry,peer.device)
                if at < 0 || core.registry.entries[at].revoked || core.registry.entries[at].exit != peer.exit { drop(core,index) }
                else { peer.publicationPending = live.ok(peer.health); mark(core,index) }
            }
        }
    }
    if core.now >= core.keysAt {
        let keys = auth.parseKeys(readBytesFile(core.config.jwks)); if auth.keysOk(keys) { core.keys = keys }; core.keysAt = core.now + 300000
    }
}
public function run(configBytes: Bytes, durationMs: Integer): errors.BooleanResult {
    let config = configuration(configBytes)
    if !config.valid || durationMs < 0 || durationMs > 86400000 { return errors.booleanFailure(errors.make(errors.invalidDataCode(),0,"invalid edge configuration")) }
    let registry = registry(readBytesFile(config.registry),config.maximum); let keys = auth.parseKeys(readBytesFile(config.jwks))
    if !registry.valid || !auth.keysOk(keys) { return errors.booleanFailure(errors.make(errors.invalidDataCode(),0,"invalid edge registry or signing keys")) }
    let created = callbacks.create(); if !callbacks.ok(created) { return errors.booleanFailure(callbacks.error(created)) }
    let udp = net.udp(config.host,config.devicePort)
    let devicePort = config.devicePort; if udp >= 0 { devicePort = net.localPort(udp) }
    let device = net.listen(config.host,devicePort,512); let gateway = net.listen(config.host,config.gatewayPort,512)
    if udp < 0 || device < 0 || gateway < 0 { if udp >= 0 { net.close(udp) }; if device >= 0 { net.close(device) }; if gateway >= 0 { net.close(gateway) }; callbacks.close(callbacks.value(created)); return errors.booleanFailure(errors.make(errors.systemCode(),0,"edge listen failed")) }
    if config.instance.length > 2 && config.instance.slice(config.instance.length-2,config.instance.length) == ":0" { config.instance = config.instance.slice(0,config.instance.length-1) + Text(net.localPort(gateway)) }
    let core = Core { config: config; dispatcher: callbacks.value(created); now: 0; started: net.monotonicMilliseconds()
        identity: [readBytesFile(config.certificate)]; key: readBytesFile(config.key); deviceRoots: [readBytesFile(config.deviceRoots)]; gatewayRoots: [readBytesFile(config.gatewayRoots)]; registry: registry; keys: keys
        udp: udp; deviceListener: device; gatewayListener: gateway; peers: []; free: []; freeCount: 0; active: 0; work: []; workAt: 0
        retry: retry.store(randomBytes(16),10000); noRetry: retry.validateInitial(retry.store(Bytes(),1),Bytes(),Bytes(),0); allocated: 0; retryReplies: 0; retryValidated: 0
        routing: dispatch.table(config.maximum*2,65536,randomBytes(16)); exits: dispatch.table(config.maximum,65536,randomBytes(16)); timers: dispatch.timers(config.maximum)
        redisSocket: -1; redisWatch: 0; redisClient: redis.create(); publications: []; publicationAt: 0; redisReconnectAt: 0; redisFlags: 0; redisConnecting: false; redisConnectDeadline: 0; registryAt: 15000; keysAt: 300000 }
    callbacks.watch(core.dispatcher,udp,loop.readableInterest(),0,function(event: loop.Event) { udpInput(core) })
    callbacks.watch(core.dispatcher,device,loop.readableInterest(),0,function(event: loop.Event) { acceptPeers(core,device,1) })
    callbacks.watch(core.dispatcher,gateway,loop.readableInterest(),0,function(event: loop.Event) { acceptPeers(core,gateway,2) })
    print("READY " + Text(net.localPort(udp)) + " " + Text(net.localPort(device)) + " " + Text(net.localPort(gateway)))
    let failure = errors.none()
    while durationMs == 0 || core.now < durationMs {
        core.now = net.monotonicMilliseconds() - core.started; refresh(core); redisService(core)
        let due = dispatch.takeDue(core.timers,core.now)
        while due >= 0 { mark(core,due); due = dispatch.takeDue(core.timers,core.now) }
        let processed = 0
        while core.workAt < core.work.length && processed < 256 {
            let id = core.work[core.workAt]; core.workAt += 1; processed += 1; peerTick(core,id)
        }
        if core.workAt == core.work.length { core.work = []; core.workAt = 0 }
        let timeout = 1000
        if core.work.length > 0 { timeout = 0 }
        let deadline = dispatch.nextDeadline(core.timers); if deadline >= 0 { timeout = min(timeout,max(0,deadline-core.now)) }
        if durationMs > 0 { timeout = min(timeout,max(0,durationMs-core.now)) }
        let dispatched = callbacks.dispatch(core.dispatcher,timeout,128)
        if !errors.integerOk(dispatched) { failure = errors.integerError(dispatched); break }
    }
    for index in 0..core.peers.length { if core.peers[index].live { drop(core,index) } }
    redisService(core)
    callbacks.close(core.dispatcher); if core.redisSocket >= 0 { net.close(core.redisSocket) }; net.close(udp); net.close(device); net.close(gateway)
    core.key = Bytes(); core.identity = []; core.deviceRoots = []; core.gatewayRoots = []
    print("EDGE_COUNTS allocated=" + Text(core.allocated) + " active=" + Text(core.active) + " peer_slots=" + Text(core.peers.length) + " retries=" + Text(core.retryReplies) + " retry_validated=" + Text(core.retryValidated))
    if errors.isError(failure) { return errors.booleanFailure(failure) }; return errors.boolean(true)
}
