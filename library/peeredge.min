// One-owner Hearth edge reactor. Protocol state, scheduling, certificate-to-
// registry binding and the live capacity plane are implemented in Minyar.
use "errors" as errors
use "json" as json
use "crypto" as crypto
use "net" as net
use "eventloop" as loop
use "eventcallbacks" as callbacks
use "quic" as quic
use "quicwire" as quicwire
use "quicretry" as retry
use "quicdispatch" as dispatch
use "transport" as transport
use "tlsserver" as tls
use "tlsverify" as trust
use "peerauth" as auth
use "peerwire" as wire
use "peergrpc" as grpc
use "peerlive" as live
use "redis" as redis
use "resp2" as resp

record Configuration {
    valid: Boolean; host: Text; devicePort: Integer; gatewayPort: Integer
    redisHost: Text; redisPort: Integer; instance: Text; region: Text; maximum: Integer
    certificate: List<Text>; key: Text; deviceRoots: List<Text>; gatewayRoots: List<Text>; registry: Text; jwks: Text
}
function numeric(value: json.Value, name: Text, maximum: Integer): Integer {
    let member = json.member(value,name)
    if member.kind != json.NUMBER || member.text.length < 1 || member.text.length > 10 { return -1 }
    let result = 0
    for c in member.text {
        if c < '0' || c > '9' { return -1 }
        result = result * 10 + Integer(c) - 48
        if result > maximum { return -1 }
    }
    return result
}
function pathValue(value: json.Value): Text {
    if value.kind != json.STRING { return "" }
    let result = value.text
    if result.length < 1 || result.length > 4095 { return "" }
    for c in result { if Integer(c) < 32 { return "" } }
    return result
}
function path(value: json.Value, name: Text): Text { return pathValue(json.member(value,name)) }
function certificatePaths(value: json.Value, name: Text): List<Text> {
    let member = json.member(value,name); let result: List<Text> = []
    if member.kind == json.STRING {
        let one = pathValue(member); if one != "" { result.add(one) }; return result
    }
    if member.kind != json.ARRAY || member.items.length < 1 || member.items.length > 16 { return result }
    for entry in member.items {
        let one = pathValue(entry); if one == "" { return [] }; result.add(one)
    }
    return result
}
function certificateFiles(paths: List<Text>): List<Bytes> {
    let result: List<Bytes> = []
    for path in paths { result.add(readBytesFile(path)) }
    return result
}
function configuration(data: Bytes): Configuration {
    let value = json.parseUniqueBytes(data,8192)
    let result = Configuration { valid: false; host: json.string(value,"host"); devicePort: numeric(value,"device_port",65535); gatewayPort: numeric(value,"gateway_port",65535)
        redisHost: json.string(value,"redis_host"); redisPort: numeric(value,"redis_port",65535); instance: json.string(value,"edge_instance"); region: json.string(value,"edge_region"); maximum: numeric(value,"max_connections",32768)
        certificate: certificatePaths(value,"certificate"); key: path(value,"private_key"); deviceRoots: certificatePaths(value,"device_roots"); gatewayRoots: certificatePaths(value,"gateway_roots"); registry: path(value,"registry"); jwks: path(value,"jwks") }
    let endpoint = result.instance
    if endpoint.length > 2 && endpoint.slice(endpoint.length-2,endpoint.length) == ":0" { endpoint = endpoint.slice(0,endpoint.length-1) + "1" }
    if value.kind != json.OBJECT || result.host.length < 1 || result.host.length > 255 || result.redisHost.length < 1 || result.redisHost.length > 255 || !live.edgeEndpoint(endpoint) || !live.identifier(result.region) ||
       result.devicePort < 0 || result.gatewayPort < 0 || result.redisPort < 1 || result.maximum < 1 || result.certificate.length < 1 || result.key == "" || result.deviceRoots.length < 1 || result.gatewayRoots.length < 1 || result.registry == "" || result.jwks == "" { return result }
    for name in value.keys {
        if name != "host" && name != "device_port" && name != "gateway_port" && name != "redis_host" && name != "redis_port" && name != "edge_instance" && name != "edge_region" && name != "max_connections" && name != "certificate" && name != "private_key" && name != "device_roots" && name != "gateway_roots" && name != "registry" && name != "jwks" { return result }
    }
    result.valid = true; return result
}
record RegistryEntry { device: Text; exit: Text; revoked: Boolean; paused: Boolean; quarantined: Boolean; maximum: Integer }
record Registry { valid: Boolean; entries: List<RegistryEntry>; index: dispatch.Table; exits: dispatch.Table; gateways: List<Text> }
function identityKey(text: Text): Bytes { return crypto.sha256(Bytes(text)).slice(0,20) }
function registry(data: Bytes, maximum: Integer): Registry {
    let result = Registry { valid: false; entries: []; index: dispatch.table(maximum,65536,randomBytes(16)); exits: dispatch.table(maximum,65536,randomBytes(16)); gateways: [] }
    if data.length < 1 || data.length > 16777216 { return result }
    let start = 0
    for end in 0..data.length + 1 {
        if end == data.length || data[end] == 10 {
            if end > start {
                let value = json.parseUniqueBytes(data.slice(start,end),2048)
                if value.kind != json.OBJECT { return result }
                let role = json.string(value,"role")
                if role == "gateway" {
                    if value.keys.length != 2 || json.string(value,"sha256").length != 64 { return result }
                    let fingerprint = json.string(value,"sha256")
                    for c in fingerprint { if !((c >= 'a' && c <= 'f') || (c >= '0' && c <= '9')) { return result } }
                    if result.gateways.length >= 128 { return result }; result.gateways.add(fingerprint)
                } else {
                    let entry = RegistryEntry { device: json.string(value,"device_id"); exit: json.string(value,"exit_id"); revoked: json.member(value,"revoked").truth; paused: json.member(value,"paused").truth; quarantined: json.member(value,"quarantined").truth; maximum: numeric(value,"max_concurrent",1000000) }
                    if role != "device" || !live.identifier(entry.device) || !live.identifier(entry.exit) || entry.maximum < 1 || value.keys.length != 7 ||
                       json.member(value,"revoked").kind != json.BOOLEAN || json.member(value,"paused").kind != json.BOOLEAN || json.member(value,"quarantined").kind != json.BOOLEAN || result.entries.length >= maximum { return result }
                    let key = identityKey(entry.device)
                    let exitKey = identityKey(entry.exit)
                    if dispatch.lookup(result.index,key) >= 0 || dispatch.lookup(result.exits,exitKey) >= 0 || !errors.booleanOk(dispatch.insert(result.index,key,result.entries.length)) || !errors.booleanOk(dispatch.insert(result.exits,exitKey,result.entries.length)) { return result }
                    result.entries.add(entry)
                }
            }
            start = end + 1
        }
    }
    result.valid = result.entries.length > 0 && result.gateways.length > 0; return result
}
function registryID(registry: Registry, device: Text): Integer {
    if !registry.valid { return -1 }
    let index = dispatch.lookup(registry.index,identityKey(device))
    if index >= 0 && registry.entries[index].device == device { return index }
    return -1
}
record Address { host: Text; port: Integer }
record InputStream { id: Integer; decoder: wire.Decoder; held: wire.FrameResult; blocked: Boolean; ended: Boolean }
record Peer {
    live: Boolean; queued: Boolean; flags: Integer; mode: Integer; socket: Integer; watch: Integer
    connection: transport.Connection; gateway: tls.Session; grpc: grpc.Server; releases: List<Integer>; finalizations: List<Finalization>; decoder: wire.Decoder; inputs: List<InputStream>
    paths: List<Address>; routed: Bytes; routedIds: List<Bytes>; routingVersion: Integer; output: Bytes; outputAt: Integer; since: Integer
    bound: Boolean; device: Text; exit: Text; epoch: Text; health: live.Health; heartbeatAt: Integer
    control: Integer; published: Boolean; publicationPending: Boolean; redisQueued: Boolean; admitted: Integer
}
record Publication { peer: Integer; epoch: Text; operation: Integer }
record Core {
    config: Configuration; dispatcher: callbacks.Dispatcher; now: Integer; started: Integer
    identity: List<Bytes>; key: Bytes; deviceRoots: List<Bytes>; gatewayRoots: List<Bytes>; registry: Registry; keys: auth.KeySet
    udp: Integer; deviceListener: Integer; gatewayListener: Integer
    peers: List<Peer>; free: List<Integer>; freeCount: Integer; active: Integer
    relays: List<Relay>; replays: List<Replay>; replayIndex: dispatch.Table; nextRelay: Integer; relaysRetired: Integer; callsOpened: Integer; callsReleased: Integer; maxRelays: Integer; replayAt: Integer
    retry: retry.Store; noRetry: retry.Opened; allocated: Integer; retryReplies: Integer; retryValidated: Integer
    work: List<Integer>; workAt: Integer; routing: dispatch.Table; exits: dispatch.Table; timers: dispatch.Timers
    redisSocket: Integer; redisWatch: Integer; redisClient: redis.Client; publications: List<Publication>; publicationAt: Integer
    redisReconnectAt: Integer; redisFlags: Integer; redisConnecting: Boolean; redisConnectDeadline: Integer; registryAt: Integer; keysAt: Integer
}
function mark(core: Core, id: Integer) {
    if id >= 0 && id < core.peers.length && core.peers[id].live && !core.peers[id].queued { core.peers[id].queued = true; core.work.add(id) }
}
function watchPeer(core: Core, id: Integer) {
    let peer = core.peers[id]; let socket = peer.socket
    let watched = callbacks.watch(core.dispatcher,socket,loop.readableInterest(),id,function(event: loop.Event) {
        if id < core.peers.length && core.peers[id].live && core.peers[id].socket == socket { core.peers[id].flags = core.peers[id].flags | event.flags; mark(core,id) }
    })
    if errors.integerOk(watched) { peer.watch = errors.integerValue(watched) } else { drop(core,id) }
}
function interests(core: Core, peer: Peer) {
    if peer.watch > 0 { let interest = loop.readableInterest(); if peer.outputAt < peer.output.length { interest = loop.readWriteInterest() }; callbacks.update(core.dispatcher,peer.watch,interest,0) }
}
function syncRouting(core: Core, id: Integer): Boolean {
    let peer = core.peers[id]; let connection = peer.connection.udp
    // Initial-only routing consumes its slot until Initial keys are discarded.
    // Delete it before installing spare CIDs, keeping at most two slots/peer.
    if peer.routed.length > 0 && connection.spaces.length > 0 && !connection.spaces[0].active {
        if !quic.ownsConnectionId(connection,peer.routed) && dispatch.lookup(core.routing,peer.routed) == id { dispatch.remove(core.routing,peer.routed) }
        peer.routed = Bytes()
    }
    if peer.routingVersion == connection.connectionIdVersion { return true }
    let retained: List<Bytes> = []
    for previous in peer.routedIds {
        if quic.ownsConnectionId(connection,previous) { retained.add(previous) }
        else if dispatch.lookup(core.routing,previous) == id { dispatch.remove(core.routing,previous) }
    }
    peer.routedIds = retained
    for known in connection.localIds {
        let present = false
        for previous in peer.routedIds { if crypto.hex(previous) == crypto.hex(known.id) { present = true } }
        if !present {
            let existing = dispatch.lookup(core.routing,known.id)
            if existing >= 0 && existing != id { return false }
            if !errors.booleanOk(dispatch.insert(core.routing,known.id,id)) { return false }
            peer.routedIds.add(known.id)
        }
    }
    peer.routingVersion = connection.connectionIdVersion; return true
}
function allocate(core: Core, mode: Integer, socket: Integer, original: Bytes, address: Address, validated: retry.Opened): Integer {
    if mode == 0 && !retry.valid(validated) { return -1 }
    if core.active >= core.config.maximum { if socket >= 0 { net.close(socket) }; return -1 }
    let connection = transport.client("inactive.invalid",Bytes(),"inactive",[],[],Bytes())
    if mode == 0 { connection = transport.serverQUICAfterRetry(randomBytes(80),"hearth-peer",validated,core.identity,core.key,core.deviceRoots,true) }
    if mode == 1 { connection = transport.serverTCP(randomBytes(80),"hearth-peer",core.identity,core.key,core.deviceRoots,true,core.now) }
    let gateway = tls.none()
    if mode == 2 { gateway = tls.server(randomBytes(64),"h2",core.identity,core.key,core.gatewayRoots,true) }
    let peer = Peer { live: true; queued: false; flags: 0; mode: mode; socket: socket; watch: 0; connection: connection; gateway: gateway; grpc: grpc.create(); releases: []; finalizations: []; decoder: wire.create(); inputs: []
        paths: [address]; routed: original; routedIds: []; routingVersion: -1; output: Bytes(); outputAt: 0; since: core.now; bound: false; device: ""; exit: ""; epoch: ""; health: live.heartbeat(Bytes()); heartbeatAt: -1
        control: -1; published: false; publicationPending: false; redisQueued: false; admitted: 0 }
    let id = core.peers.length
    if core.freeCount > 0 { core.freeCount -= 1; id = core.free[core.freeCount] }
    if id == core.peers.length { core.peers.add(peer) } else { core.peers[id] = peer }
    core.active += 1; core.allocated += 1
    if mode == 0 {
        if !errors.booleanOk(dispatch.insert(core.routing,peer.routed,id)) || !syncRouting(core,id) { drop(core,id); return -1 }
    } else { watchPeer(core,id) }
    if !peer.live { return -1 }
    mark(core,id); return id
}
function queuePublication(core: Core, id: Integer, operation: Integer): Boolean {
    if core.redisSocket < 0 || core.redisConnecting || redis.closed(core.redisClient) { return false }
    let peer = core.peers[id]; let command = live.dropCommand(peer.exit,peer.epoch)
    if operation != 3 {
        let at = registryID(core.registry,peer.device)
        if at < 0 || !live.ok(peer.health) { return false }
        let entry = core.registry.entries[at]
        let health = live.capMaximum(peer.health,entry.maximum)
        let state = live.payloadRegion(health,peer.exit,core.config.instance,core.config.region,peer.epoch,trust.currentTimeMilliseconds()/1000,peer.admitted,entry.paused,entry.quarantined,1.0)
        if !errors.bytesOk(state) { return false }
        if operation == 1 { command = live.bindCommand(peer.exit,peer.epoch,errors.bytesValue(state)) }
        else { command = live.refreshCommand(peer.exit,peer.epoch,errors.bytesValue(state)) }
    }
    if !errors.bytesOk(command) { return false }
    let parsed = resp.parse(errors.bytesValue(command)); let arguments: List<Bytes> = []
    if !resp.ok(parsed) { fail("invalid internal live-state command") }
    for item in resp.items(resp.value(parsed)) { arguments.add(resp.data(item)) }
    let queued = redis.queue(core.redisClient,arguments)
    if !errors.booleanOk(queued) { return false }
    if core.publicationAt >= 1024 && core.publicationAt * 2 >= core.publications.length {
        let retained: List<Publication> = []; for at in core.publicationAt..core.publications.length { retained.add(core.publications[at]) }; core.publications = retained; core.publicationAt = 0
    }
    core.publications.add(Publication { peer: id; epoch: peer.epoch; operation: operation })
    if operation != 3 { peer.redisQueued = true }
    callbacks.update(core.dispatcher,core.redisWatch,loop.readWriteInterest(),0); return true
}
function drop(core: Core, id: Integer) {
    let peer = core.peers[id]
    if !peer.live { return }
    for relay in core.relays {
        if relay.live && (relay.gateway == id || relay.device == id) {
            if relay.gateway != id { finalize(core,relay.gateway,relay.call,"",14,"device disconnected") }
            retireRelay(core,relay,relay.device != id)
        }
    }
    if peer.bound && peer.mode != 2 {
        let key = identityKey(peer.exit)
        if dispatch.lookup(core.exits,key) == id { dispatch.remove(core.exits,key); queuePublication(core,id,3) }
    }
    if peer.mode == 0 { for cid in peer.routedIds { if dispatch.lookup(core.routing,cid) == id { dispatch.remove(core.routing,cid) } }; peer.routedIds = []; if dispatch.lookup(core.routing,peer.routed) == id { dispatch.remove(core.routing,peer.routed) } }
    if peer.watch > 0 { callbacks.cancel(core.dispatcher,peer.watch) }
    if peer.socket >= 0 { net.close(peer.socket) }
    // Discarding a gateway releases its remaining contexts without a trailers exchange.
    if peer.mode == 2 { core.callsReleased += grpc.retainedCalls(peer.grpc) }
    dispatch.cancel(core.timers,id); peer.live = false; peer.output = Bytes(); peer.inputs = []; peer.paths = []; peer.device = ""; peer.exit = ""; peer.epoch = ""; peer.health = live.heartbeat(Bytes()); peer.decoder = wire.create()
    peer.connection = transport.client("retired.invalid",Bytes(),"retired",[],[],Bytes()); peer.gateway = tls.none(); peer.grpc = grpc.create(); peer.releases = []; peer.finalizations = []
    core.active -= 1
    if core.freeCount == core.free.length { core.free.add(id) } else { core.free[core.freeCount] = id }; core.freeCount += 1
}
function session(peer: Peer): tls.Session { if peer.mode == 0 { return peer.connection.udp.serverTLS }; return peer.connection.serverTLS }
record Relay {
    live: Boolean; gateway: Integer; call: Integer; device: Integer; stream: Integer; id: Integer
    value: wire.Relay; start: Bytes; toDevice: Bytes; toGateway: Bytes
    statusSent: Boolean; clientEnded: Boolean; finSent: Boolean; openingDue: Integer
}
record Replay { key: Bytes; until: Integer }
record Finalization { call: Integer; status: Text; code: Integer; message: Text }
function relayForDevice(core: Core, device: Integer, stream: Integer): Integer {
    for at in 0..core.relays.length {
        let relay = core.relays[at]
        if relay.live && relay.device == device && relay.stream == stream { return at }
    }
    return -1
}
function finalize(core: Core, gateway: Integer, call: Integer, status: Text, code: Integer, message: Text) {
    if gateway < 0 || gateway >= core.peers.length || !core.peers[gateway].live { return }
    let peer = core.peers[gateway]
    let result = errors.boolean(true)
    if status != "" { result = grpc.sendStatusDetail(peer.grpc,call,status,message) }
    else { result = grpc.closeStream(peer.grpc,call,code,message) }
    if !errors.booleanOk(result) && errors.isWouldBlock(errors.booleanError(result)) {
        for pending in peer.finalizations { if pending.call == call { return } }
        peer.finalizations.add(Finalization { call: call; status: status; code: code; message: message })
    }
    mark(core,gateway)
}
function retireRelay(core: Core, relay: Relay, cancel: Boolean) {
    if !relay.live { return }
    relay.live = false; relay.start = Bytes(); relay.toDevice = Bytes(); relay.toGateway = Bytes()
    core.relaysRetired += 1
    if relay.device >= 0 && relay.device < core.peers.length && core.peers[relay.device].live {
        let peer = core.peers[relay.device]
        if peer.admitted < 1 { fail("relay admission accounting underflow") }
        peer.admitted -= 1; peer.publicationPending = live.ok(peer.health)
        if cancel {
            let cancelled = transport.cancelStream(peer.connection,relay.stream)
            if !errors.booleanOk(cancelled) && !errors.isWouldBlock(errors.booleanError(cancelled)) && errors.code(errors.booleanError(cancelled)) != errors.closedCode() {
                drop(core,relay.device)
            }
        }
        mark(core,relay.device)
    }
}
function relayFailure(core: Core, relay: Relay, code: Integer, message: Text) {
    finalize(core,relay.gateway,relay.call,"",code,message); retireRelay(core,relay,true)
}
function serviceRelay(core: Core, relay: Relay) {
    if !relay.live { return }
    let device = core.peers[relay.device]; let gateway = core.peers[relay.gateway]
    if !device.live || !gateway.live { relayFailure(core,relay,14,"relay endpoint closed"); return }
    if !relay.statusSent && core.now >= relay.openingDue { relayFailure(core,relay,4,"establishment deadline exceeded"); return }
    if relay.start.length > 0 {
        let written = transport.write(device.connection,relay.stream,relay.start,false)
        if errors.integerOk(written) {
            let count = errors.integerValue(written)
            if count < 0 || count > relay.start.length { fail("invalid relay start write count") }
            relay.start = relay.start.slice(count,relay.start.length); mark(core,relay.device)
        } else if !errors.isWouldBlock(errors.integerError(written)) { relayFailure(core,relay,14,"device stream unavailable"); return }
        if relay.start.length > 0 { return }
    }
    if wire.relayReady(relay.value) && !relay.statusSent {
        let sent = grpc.sendStatus(gateway.grpc,relay.call,"ok")
        if errors.booleanOk(sent) { relay.statusSent = true; mark(core,relay.gateway) }
        else if !errors.isWouldBlock(errors.booleanError(sent)) { relayFailure(core,relay,13,"gateway admission failed"); return }
    }
    if !relay.statusSent { return }
    // Each direction has a bounded queue plus one retained partial write.
    if !wire.relayClosed(relay.value) && !relay.clientEnded && wire.outgoingBytes(relay.value) <= 1048576 - 65552 {
        for reads in 0..16 {
            if wire.outgoingBytes(relay.value) > 1048576 - 65552 { break }
            let data = grpc.read(gateway.grpc,relay.call,16384)
            if errors.bytesStatus(data) == errors.successStatus() {
                let bytes = errors.bytesValue(data)
                if bytes.length > 0 {
                    let queued = wire.enqueueRelay(relay.value,bytes)
                    if !errors.booleanOk(queued) { fail("relay queue capacity reservation failed") }
                }
            } else if errors.bytesStatus(data) == errors.endOfStreamStatus() { relay.clientEnded = true; break }
            else if errors.isWouldBlock(errors.bytesError(data)) { break }
            else { relayFailure(core,relay,13,"invalid gateway relay data"); return }
        }
    }
    for writes in 0..16 {
        if relay.toDevice.length == 0 { relay.toDevice = wire.takeOutgoing(relay.value,16384) }
        if relay.toDevice.length == 0 { break }
        let written = transport.write(device.connection,relay.stream,relay.toDevice,false)
        if errors.integerOk(written) {
            let count = errors.integerValue(written)
            if count < 0 || count > relay.toDevice.length { fail("invalid device relay write count") }
            if count == 0 { break }
            relay.toDevice = relay.toDevice.slice(count,relay.toDevice.length); mark(core,relay.device)
        } else if errors.isWouldBlock(errors.integerError(written)) { break }
        else { relayFailure(core,relay,14,"device relay closed"); return }
    }
    if relay.clientEnded && !relay.finSent && relay.toDevice.length == 0 && wire.outgoingBytes(relay.value) == 0 {
        let ended = transport.write(device.connection,relay.stream,Bytes(),true)
        if errors.integerOk(ended) { relay.finSent = true; mark(core,relay.device) }
        else if !errors.isWouldBlock(errors.integerError(ended)) { relayFailure(core,relay,14,"device request close failed"); return }
    }
    for writes in 0..16 {
        if relay.toGateway.length == 0 { relay.toGateway = wire.takeIncoming(relay.value,16384) }
        if relay.toGateway.length == 0 { break }
        let written = grpc.write(gateway.grpc,relay.call,relay.toGateway)
        if errors.booleanOk(written) { relay.toGateway = Bytes(); mark(core,relay.gateway); mark(core,relay.device) }
        else if errors.isWouldBlock(errors.booleanError(written)) { break }
        else { relayFailure(core,relay,13,"gateway response closed"); return }
    }
    if wire.relayClosed(relay.value) && relay.toGateway.length == 0 && wire.incomingBytes(relay.value) == 0 {
        if !relay.finSent {
            let ended = transport.write(device.connection,relay.stream,Bytes(),true)
            if errors.integerOk(ended) { relay.finSent = true; mark(core,relay.device) }
            else if errors.isWouldBlock(errors.integerError(ended)) { return }
        }
        finalize(core,relay.gateway,relay.call,"",0,""); retireRelay(core,relay,false)
    }
}
function acceptRelay(core: Core, gateway: Integer, opened: grpc.OpenResult) {
    let call = grpc.openStreamID(opened)
    let requested = grpc.openExitID(opened); let connection = grpc.openConnID(opened)
    let registered = dispatch.lookup(core.registry.exits,identityKey(requested))
    if registered < 0 || !core.registry.valid || core.registry.entries[registered].exit != requested {
        finalize(core,gateway,call,"exit_offline",0,"unknown exit"); return
    }
    let entry = core.registry.entries[registered]; let wall = trust.currentTimeMilliseconds()/1000
    let grant = auth.inspect(grpc.openGrantBytes(opened),core.keys,entry.exit,requested,connection,wall,grpc.openDeadlineSeconds(opened))
    if !auth.grantOk(grant) { finalize(core,gateway,call,"grant_invalid",0,"invalid signed grant"); return }
    let replayKey = identityKey(requested + ":" + connection)
    if dispatch.lookup(core.replayIndex,replayKey) >= 0 { finalize(core,gateway,call,"grant_invalid",0,"connection grant replayed"); return }
    let device = dispatch.lookup(core.exits,identityKey(requested))
    if device < 0 || !core.peers[device].live || core.peers[device].exit != requested || !core.peers[device].published || !live.ok(core.peers[device].health) {
        finalize(core,gateway,call,"exit_offline",0,"device is offline"); return
    }
    let peer = core.peers[device]
    if entry.revoked || entry.paused || entry.quarantined || live.paused(peer.health) {
        finalize(core,gateway,call,"policy_denied",0,"device policy denies open"); return
    }
    if max(peer.admitted,live.reportedInFlight(peer.health)) >= min(entry.maximum,live.maximum(peer.health)) || core.relays.length >= 4096 {
        finalize(core,gateway,call,"concurrency_full",0,"device capacity exhausted"); return
    }
