// Bounded offset reassembly for both STREAM and CRYPTO. Duplicate bytes do
// not consume more flow credit; conflicting buffered bytes fail recoverably.
public record Segment { offset: Integer; data: Bytes }
public record Acknowledged { first: Integer; last: Integer }
public record Stream {
    id: Integer; sendOffset: Integer; delivered: Integer; highest: Integer; final: Integer
    receiveLimit: Integer; sendLimit: Integer; segments: List<Segment>; incoming: Bytes
    error: Text; reset: Boolean; resetCode: Integer; consumed: Integer; sendClosed: Boolean; sendReset: Boolean; sendResetCode: Integer
    sendAcknowledged: Integer; acknowledged: List<Acknowledged>; finalAcknowledged: Boolean; resetAcknowledged: Boolean; receiveObserved: Boolean
}
public function create(id: Integer, receiveLimit: Integer, sendLimit: Integer): Stream {
    return Stream { id: id; sendOffset: 0; delivered: 0; highest: 0; final: -1; receiveLimit: receiveLimit; sendLimit: sendLimit; segments: []; incoming: Bytes(); error: ""; reset: false; resetCode: 0; consumed: 0; sendClosed: false; sendReset: false; sendResetCode: 0; sendAcknowledged: 0; acknowledged: []; finalAcknowledged: false; resetAcknowledged: false; receiveObserved: false }
}
public function acknowledgeSend(stream: Stream, first: Integer, length: Integer, fin: Boolean): Boolean {
    if fin { stream.finalAcknowledged = true }
    let last = first + length
    if last <= stream.sendAcknowledged { return true }
    first = max(first,stream.sendAcknowledged)
    let merged: List<Acknowledged> = []; let inserted = false
    for range in stream.acknowledged {
        if range.last < first { merged.add(range) }
        else if range.first > last {
            if !inserted { merged.add(Acknowledged { first: first; last: last }); inserted = true }
            merged.add(range)
        } else { first = min(first,range.first); last = max(last,range.last) }
    }
    if !inserted { merged.add(Acknowledged { first: first; last: last }) }
    let remaining: List<Acknowledged> = []
    for range in merged {
        if range.first <= stream.sendAcknowledged { stream.sendAcknowledged = max(stream.sendAcknowledged,range.last) }
        else { remaining.add(range) }
    }
    if remaining.length > 4096 { return false }
    stream.acknowledged = remaining; return true
}
function failInput(stream: Stream, error: Text): Boolean { stream.error = error; return false }
public function insert(stream: Stream, offset: Integer, data: Bytes, fin: Boolean): Boolean {
    if offset < 0 || data.length > 1048576 || offset > 0x3fffffffffffffff - data.length { return failInput(stream, "offset or buffer limit exceeded") }
    let end = offset + data.length
    if end > stream.receiveLimit { return failInput(stream, "flow control limit exceeded") }
    if (stream.final >= 0 && (end > stream.final || (fin && end != stream.final))) || (fin && end < stream.highest) { return failInput(stream, "inconsistent final stream size") }
    if fin { stream.final = end }
    stream.highest = max(stream.highest, end)
    // A stopped/reset receive half still checks final size and flow credit,
    // but never retains discarded application data or gaps.
    if stream.reset { stream.delivered = stream.highest; return true }
    if end <= stream.delivered { return true }
    let begin = max(offset, stream.delivered)
    let joined = data.slice(begin - offset, data.length)
    let remaining: List<Segment> = []
    let buffered = 0
    for segment in stream.segments {
        let last = segment.offset + segment.data.length
        if last < begin || segment.offset > end { remaining.add(segment); buffered += segment.data.length }
        else {
            for index in max(begin, segment.offset)..min(end, last) {
                if joined[index - begin] != segment.data[index - segment.offset] { return failInput(stream, "conflicting bytes at one stream offset") }
            }
            let first = min(begin, segment.offset); let limit = max(end, last)
            if limit - first > 1048576 { return failInput(stream, "reassembly buffer limit exceeded") }
            let combined = Bytes(limit - first)
            for index in 0..joined.length { combined[begin - first + index] = joined[index] }
            for index in 0..segment.data.length { combined[segment.offset - first + index] = segment.data[index] }
            begin = first; end = limit; joined = combined
        }
    }
    if buffered + joined.length + stream.incoming.length > 1048576 || remaining.length >= 512 { return failInput(stream, "reassembly memory or fragment count limit exceeded") }
    let ordered: List<Segment> = []; let added = false
    for segment in remaining {
        if !added && begin < segment.offset { ordered.add(Segment { offset: begin; data: joined }); added = true }
        ordered.add(segment)
    }
    if !added { ordered.add(Segment { offset: begin; data: joined }) }
    stream.segments = []
    for segment in ordered {
        if segment.offset == stream.delivered { stream.incoming.addBytes(segment.data); stream.delivered += segment.data.length }
        else { stream.segments.add(segment) }
    }
    return true
}
public function take(stream: Stream): Bytes { let result = stream.incoming; stream.incoming = Bytes(); return result }
public function finished(stream: Stream): Boolean { return stream.final >= 0 && stream.delivered == stream.final }
