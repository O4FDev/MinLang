use "errors" as errors

// Process arguments, excluding the executable name. Text is copied and the
// same immutable argument vector is available in every execution domain.
public function argumentCount(): Integer { native "runtime" }
public function argument(position: Integer): Text { native "runtime" }

// Pointer-free OS operations, safe in both ordinary and managed threads.
// sleepNanoseconds returns 0 or negative errno; it retries interrupted sleeps.
// Positive sleeps are unavailable (-38) in freestanding programs.
public function processId(): Integer { native "runtime" }
public function sleepNanoseconds(nanoseconds: Integer): Integer { native "runtime" }

// Absence is distinct from a present, empty argument. argument remains the
// compatibility API with its original fatal bounds diagnostic.
public function argumentAt(position: Integer): Maybe<Text> {
    if position < 0 || position >= argumentCount() { return None }
    return Some(argument(position))
}

public function sleep(nanoseconds: Integer): Result<Nothing, errors.Error> {
    let code = sleepNanoseconds(nanoseconds)
    if code < 0 { return Err(errors.make(errors.systemCode(), -code, "could not sleep")) }
    return Ok()
}
