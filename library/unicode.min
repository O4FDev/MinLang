// Explicit Unicode operations; importing text or io alone needs no property tables.

/// The Unicode data version used by grapheme segmentation, normalization and folding.
public function unicodeVersion(): Text { native "unicode" }

// One byte per scalar boundary, including both ends. Kept private so callers
// work with scalar positions rather than an implementation-specific bitmap.
function unicodeBoundaries(source: Text): Bytes { native "unicode" }

/// Count extended grapheme clusters: the pieces of text a reader sees as characters.
/// This scans once without allocating a boundary list. CRLF is one cluster.
public function graphemeCount(source: Text): Integer { native "unicode" }

/// Return every grapheme boundary as a scalar offset, including zero and the end.
/// Empty text has one boundary, zero. These positions can be passed to Text.slice.
public function graphemeBoundaries(source: Text): List<Integer> {
    let marks = unicodeBoundaries(source)
    let positions: List<Integer> = []
    for position in 0..marks.length {
        if marks[position] != 0 { positions.add(position) }
    }
    return positions
}

/// Split text into extended grapheme clusters, keeping every byte unchanged.
/// Combining marks, joined emoji and flag pairs stay with their cluster.
public function graphemes(source: Text): List<Text> {
    let positions = graphemeBoundaries(source)
    let pieces: List<Text> = []
    for index in 1..positions.length {
        pieces.add(source.slice(positions[index - 1], positions[index]))
    }
    return pieces
}

/// Return canonically composed text (NFC), preserving case and embedded zero bytes.
/// This does not apply compatibility mappings or remove accents or controls.
public function normalized(source: Text): Text { native "unicode" }

/// Compare canonical spellings, so a composed accent equals its decomposed form.
/// Ordinary Text equality continues to compare exact contents.
public function canonicallyEqual(left: Text, right: Text): Boolean {
    return normalized(left) == normalized(right)
}

/// Return a normalized, locale-independent key for canonical caseless comparison.
/// Uses full default case folding, including expansions such as sharp s to ss.
/// This is a comparison key, not a display-oriented lowercase transformation.
public function caseFold(source: Text): Text { native "unicode" }

/// Compare text without case or canonical-spelling differences.
/// Accents remain meaningful; this does not use a locale or compatibility form.
public function caselessEqual(left: Text, right: Text): Boolean {
    return caseFold(left) == caseFold(right)
}
