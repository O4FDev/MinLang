// Bounded in-memory tar through libarchive. No filesystem extraction.
// Reader/Writer copies share a private context and closed state. Exclusive use;
// next closes on EOF/error, finish closes the writer, close handles early exit.
// The source must remain unmodified until reader close. See docs/tar.md.
use "errors" as errors
use "machine" as machine
public constant REGULAR = 48
public constant HARDLINK = 49
public constant SYMLINK = 50
public constant CHARACTER = 51
public constant BLOCK = 52
public constant DIRECTORY = 53
public constant FIFO = 54
public record Attribute { key: Bytes; value: Bytes }
public record Entry {
    path: Bytes; link: Bytes; mode: Integer; uid: Integer; gid: Integer
    mtime: Integer; mtimeNanos: Integer; type: Integer; size: Integer
    deviceMajor: Integer; deviceMinor: Integer; uname: Bytes; gname: Bytes
    attributes: List<Attribute>
    private start: Integer; private header: Integer; private offset: Integer; private end: Integer
    private sourceAddress: Integer; private sourceLength: Integer; private payloadLength: Integer
}
public record NextResult { entry: Entry; end: Boolean; error: errors.Error }
public record Reader { private source: Bytes; private handle: Integer; private error: errors.Error; private ended: Boolean }
public record Writer { private handle: Integer; private error: errors.Error; private ended: Boolean; private output: Bytes }
function openReader(source: Bytes, maximumPath: Integer, maximumMetadata: Integer, maximumChain: Integer, maximumHeaders: Integer): Integer { native "tararchive" }
function readNext(handle: Integer): Bytes { native "tararchive" }
function freeReader(handle: Integer) { native "tararchive" }
function openWriter(maximumBytes: Integer): Integer { native "tararchive" }
function writeEntry(handle: Integer, info: Bytes, data: Bytes): Bytes { native "tararchive" }
function endWriter(handle: Integer): Bytes { native "tararchive" }
function freeWriter(handle: Integer) { native "tararchive" }
public function providerVersion(): Text { native "tararchive" }
function invalid(message: Text): errors.Error { return errors.make(errors.invalidDataCode(), 0, message) }
public function entry(path: Bytes, type: Integer): Entry {
    return Entry { path: path; link: Bytes(); mode: 420; uid: 0; gid: 0; mtime: 0; mtimeNanos: 0
        type: type; size: 0; deviceMajor: 0; deviceMinor: 0; uname: Bytes(); gname: Bytes(); attributes: []
        start: -1; header: -1; offset: -1; end: -1; sourceAddress: 0; sourceLength: 0; payloadLength: 0 }
}
public function reader(source: Bytes, maximumBytes: Integer, maximumPath: Integer): Reader {
    return readerWithLimits(source, maximumBytes, maximumPath, 1048576, 64, 1000000)
}
public function readerWithLimits(source: Bytes, maximumBytes: Integer, maximumPath: Integer, maximumMetadata: Integer, maximumChain: Integer, maximumHeaders: Integer): Reader {
    let result = Reader { source: source; handle: 0; error: errors.none(); ended: false }
    if maximumBytes < 0 || maximumPath < 1 || maximumMetadata < 0 || maximumChain < 1 || maximumHeaders < 1 || source.length > maximumBytes {
        result.error = invalid("tar input or limit exceeded"); return result
    }
    result.handle = openReader(source,maximumPath,maximumMetadata,maximumChain,maximumHeaders)
    if result.handle == 0 { result.error = invalid("cannot initialize tar reader") }
    return result
}
public function close(cursor: Reader) {
    if cursor.handle != 0 { freeReader(cursor.handle); cursor.handle = 0 }
    if !cursor.ended && !errors.isError(cursor.error) { cursor.error = errors.make(errors.closedCode(),0,"tar reader closed") }
}
public function closeWriter(output: Writer) {
    if output.handle != 0 { freeWriter(output.handle); output.handle = 0 }
    if !output.ended && !errors.isError(output.error) { output.error = errors.make(errors.closedCode(),0,"tar writer closed") }
}
public function memberStart(value: Entry): Integer { return value.start }
public function headerOffset(value: Entry): Integer { return value.header }
public function payloadOffset(value: Entry): Integer { return value.offset }
public function memberEnd(value: Entry): Integer { return value.end }
public function payload(cursor: Reader, value: Entry): errors.BytesResult {
    if value.sourceAddress != machine.address(cursor.source) || value.sourceLength != cursor.source.length || value.offset < 0 || value.payloadLength < 0 || value.offset > cursor.source.length - value.payloadLength {
        return errors.bytesFailure(invalid("tar entry does not belong to reader"))
    }
    return errors.bytes(cursor.source.slice(value.offset,value.offset + value.payloadLength))
}
public function memberBytes(cursor: Reader, value: Entry): errors.BytesResult {
    if value.sourceAddress != machine.address(cursor.source) || value.sourceLength != cursor.source.length || value.start < 0 || value.end < value.start || value.end > cursor.source.length {
        return errors.bytesFailure(invalid("tar entry does not belong to reader"))
    }
    return errors.bytes(cursor.source.slice(value.start,value.end))
}
function take(raw: Bytes, at: List<Integer>): Bytes {
    let length = raw.getInt64(at[0]); at[0] += 8
    let result = raw.slice(at[0],at[0] + length); at[0] += length
    return result
}
public function next(cursor: Reader): NextResult {
    let empty = entry(Bytes(),REGULAR)
    if errors.isError(cursor.error) { return NextResult { entry: empty; end: false; error: cursor.error } }
    if cursor.ended { return NextResult { entry: empty; end: true; error: errors.none() } }
    let raw = readNext(cursor.handle)
    let status = raw.getInt64(0)
    if status != 1 {
        if status == 2 { cursor.ended = true } else { cursor.error = invalid(Text(raw.slice(8,raw.length))) }
        close(cursor)
        return NextResult { entry: empty; end: cursor.ended; error: cursor.error }
    }
    let value = entry(Bytes(),raw.getInt64(8))
    value.mode = raw.getInt64(16); value.uid = raw.getInt64(24); value.gid = raw.getInt64(32)
    value.mtime = raw.getInt64(40); value.mtimeNanos = raw.getInt64(48); value.size = raw.getInt64(56)
    value.deviceMajor = raw.getInt64(64); value.deviceMinor = raw.getInt64(72)
    value.start = raw.getInt64(80); value.header = raw.getInt64(88); value.offset = raw.getInt64(96); value.end = raw.getInt64(104)
    value.payloadLength = value.size; value.sourceAddress = machine.address(cursor.source); value.sourceLength = cursor.source.length
    let at = [112]
    value.path = take(raw,at); value.link = take(raw,at); value.uname = take(raw,at); value.gname = take(raw,at)
    let count = raw.getInt64(at[0]); at[0] += 8
    for i in 0..count { let name = take(raw,at); let data = take(raw,at); value.attributes.add(Attribute { key: name; value: data }) }
    return NextResult { entry: value; end: false; error: errors.none() }
}
public function writer(maximumBytes: Integer): Writer {
    let output = Writer { handle: 0; error: errors.none(); ended: false; output: Bytes() }
    if maximumBytes < 1024 { output.error = invalid("tar writer requires footer capacity"); return output }
    output.handle = openWriter(maximumBytes)
    if output.handle == 0 { output.error = invalid("cannot initialize tar writer") }
    return output
}
function addField(raw: Bytes, data: Bytes) { let length = Bytes(8); length.setInt64(0,data.length); raw.addBytes(length); raw.addBytes(data) }
public function append(output: Writer, value: Entry, data: Bytes): errors.BooleanResult {
    if errors.isError(output.error) { return errors.booleanFailure(output.error) }
    if output.ended { return errors.booleanFailure(invalid("tar writer is finished")) }
    let metadataBytes = 0
    if value.path.length > 4096 || value.link.length > 4096 || value.uname.length > 4096 || value.gname.length > 4096 || value.attributes.length > 4096 {
        output.error = invalid("tar writer name/attribute limit exceeded"); closeWriter(output); return errors.booleanFailure(output.error)
    }
    for attr in value.attributes {
        if attr.key.length > 1048576 - metadataBytes || attr.value.length > 1048576 - metadataBytes - attr.key.length {
            output.error = invalid("tar writer metadata limit exceeded"); closeWriter(output); return errors.booleanFailure(output.error)
        }
        metadataBytes += attr.key.length + attr.value.length
    }
    let raw = Bytes(72)
    raw.setInt64(0,value.type); raw.setInt64(8,value.mode); raw.setInt64(16,value.uid); raw.setInt64(24,value.gid)
    raw.setInt64(32,value.mtime); raw.setInt64(40,value.mtimeNanos); raw.setInt64(48,data.length)
    raw.setInt64(56,value.deviceMajor); raw.setInt64(64,value.deviceMinor)
    addField(raw,value.path); addField(raw,value.link); addField(raw,value.uname); addField(raw,value.gname)
    let count = Bytes(8); count.setInt64(0,value.attributes.length); raw.addBytes(count)
    for attr in value.attributes { addField(raw,attr.key); addField(raw,attr.value) }
    let result = writeEntry(output.handle,raw,data)
    if result.getInt64(0) != 0 {
        output.error = invalid(Text(result.slice(8,result.length))); closeWriter(output)
        return errors.booleanFailure(output.error)
    }
    return errors.boolean(true)
}
public function finish(output: Writer): errors.BytesResult {
    if errors.isError(output.error) { return errors.bytesFailure(output.error) }
    if !output.ended {
        let result = endWriter(output.handle)
        if result.getInt64(0) != 0 { output.error = invalid(Text(result.slice(8,result.length))); closeWriter(output); return errors.bytesFailure(output.error) }
        output.output = result.slice(8,result.length); output.ended = true; closeWriter(output)
    }
    return errors.bytes(output.output.slice(0,output.output.length))
}

public record AttributesResult { attributes: List<Attribute>; error: errors.Error }
function starts(value: Bytes, text: Text): Boolean {
    let bytes = Bytes(text)
    if value.length < bytes.length { return false }
    for i in 0..bytes.length { if value[i] != bytes[i] { return false } }
    return true
}
function hexDigit(value: Integer): Integer {
    if value >= 48 && value <= 57 { return value - 48 }
    if value >= 65 && value <= 70 { return value - 55 }
    if value >= 97 && value <= 102 { return value - 87 }
    return -1
}
function unquote(value: Bytes): errors.BytesResult {
    let result = Bytes(); let at = 0
    while at < value.length {
        let byte = value[at]
        if byte == 37 {
            if value.length - at < 3 { return errors.bytesFailure(invalid("invalid xattr name escape")) }
            let hi = hexDigit(value[at+1]); let lo = hexDigit(value[at+2])
            if hi < 0 || lo < 0 { return errors.bytesFailure(invalid("invalid xattr name escape")) }
            byte = hi * 16 + lo; at += 2
        }
        if byte == 0 { return errors.bytesFailure(invalid("NUL xattr name")) }
        result.add(byte); at += 1
    }
    if result.length == 0 { return errors.bytesFailure(invalid("empty xattr name")) }
    return errors.bytes(result)
}
function unbase64(value: Bytes): errors.BytesResult {
    let alphabet = Bytes("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    let result = Bytes(); let accumulator = 0; let bits = 0; let padding = 0; let digits = 0
    for byte in value {
        if byte == 61 { padding += 1 } else {
            if padding > 0 { return errors.bytesFailure(invalid("invalid xattr base64 padding")) }
            let digit = -1
            for i in 0..64 { if alphabet[i] == byte { digit = i } }
            if digit < 0 { return errors.bytesFailure(invalid("invalid xattr base64")) }
            accumulator = accumulator * 64 + digit; bits += 6; digits += 1
            if bits >= 8 { bits -= 8; result.add((accumulator >> bits) & 255); accumulator = accumulator & ((1 << bits) - 1) }
        }
    }
    if digits % 4 == 1 || padding > 2 || (padding > 0 && (digits+padding)%4 != 0) || accumulator != 0 {
        return errors.bytesFailure(invalid("invalid xattr base64 tail"))
    }
    return errors.bytes(result)
}
// Decode SCHILY raw names/values and LIBARCHIVE percent-name/base64 values.
// Equivalent duplicate encodings collapse; conflicting encodings are an error.
// Raw attributes remain available even when an xattr encoding is unsupported.
public function xattrs(value: Entry): AttributesResult {
    let result: List<Attribute> = []
    for attr in value.attributes {
        let schily = starts(attr.key,"SCHILY.xattr."); let archive = starts(attr.key,"LIBARCHIVE.xattr.")
        if schily || archive {
            let prefix = 13; if archive { prefix = 17 }
            let rawName = attr.key.slice(prefix,attr.key.length)
            let name = errors.bytes(rawName)
            if archive { name = unquote(rawName) } else {
                if rawName.length == 0 { name = errors.bytesFailure(invalid("empty xattr name")) }
            }
            if !errors.bytesOk(name) { return AttributesResult { attributes: []; error: errors.bytesError(name) } }
            let data = errors.bytes(attr.value); if archive { data = unbase64(attr.value) }
            if !errors.bytesOk(data) { return AttributesResult { attributes: []; error: errors.bytesError(data) } }
            let found = false
            for existing in result {
                if byteEqual(existing.key,errors.bytesValue(name)) {
                    if !byteEqual(existing.value,errors.bytesValue(data)) { return AttributesResult { attributes: []; error: invalid("conflicting xattr encodings") } }
                    found = true
                }
            }
            if !found { result.add(Attribute { key: errors.bytesValue(name); value: errors.bytesValue(data) }) }
        }
    }
    return AttributesResult { attributes: result; error: errors.none() }
}
function byteEqual(a: Bytes, b: Bytes): Boolean {
    if a.length != b.length { return false }
    for i in 0..a.length { if a[i] != b[i] { return false } }
    return true
}
