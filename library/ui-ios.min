// The same descriptions can be rendered with ui-macos on the desktop.
use "ui" as ui
use "mobile" as mobile

function mount(parent: Integer, view: ui.View) {
    let handle = mobile.node(parent, ui.kind(view), ui.key(view), ui.text(view), ui.isChecked(view), ui.spacing(view), ui.padding(view))
    for child in ui.children(view) { mount(handle, child) }
}

/// Publish one validated description. Matching controls keep their native views,
/// keyboard focus and editing selection when only text or state changes.
public function show(view: ui.View) {
    let problem = ui.problem(view)
    if problem != "" { fail("cannot show this view: " + problem) }
    mobile.begin()
    mount(0, view)
    mobile.end()
}

/// Run a UIKit app with a Minyar model and the shared declarative view model.
public function run(title: Text, view: () -> ui.View, update: (mobile.Event) -> Nothing) {
    mobile.run(title, function() { show(view()) }, update)
}
