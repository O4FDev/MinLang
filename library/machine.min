// Direct access to an x86-64 machine for freestanding programs such as boot
// loaders and kernels. Import it with `use "machine" as machine`.
//
// Every function here is a compiler intrinsic: `native "machine"` makes the
// compiler emit the operation inline as LLVM IR instead of calling C. Addresses
// are Integers holding identity-mapped physical addresses, so these functions
// only make sense in a program built with `--freestanding`; a hosted program
// that touches arbitrary memory or I/O ports will be stopped by its OS.

// ----- Ordinary memory -----
// Plain loads and stores that the optimizer may combine, reorder or vectorize.
// Use them for buffers the program owns, such as pixel or packet storage.

public function load8(address: Integer): Integer { native "machine" }
public function load16(address: Integer): Integer { native "machine" }
public function load32(address: Integer): Integer { native "machine" }
public function load64(address: Integer): Integer { native "machine" }
public function store8(address: Integer, value: Integer) { native "machine" }
public function store16(address: Integer, value: Integer) { native "machine" }
public function store32(address: Integer, value: Integer) { native "machine" }
public function store64(address: Integer, value: Integer) { native "machine" }

// Set `count` bytes to the low eight bits of `value`.
public function fill8(address: Integer, count: Integer, value: Integer) { native "machine" }
// Set `count` consecutive 32-bit words, such as pixels, to `value`.
public function fill32(address: Integer, count: Integer, value: Integer) { native "machine" }
// Copy `count` bytes; the ranges may overlap.
public function copy(destination: Integer, source: Integer, count: Integer) { native "machine" }

// The address of the first byte of `bytes`. It stays valid until the Bytes
// value grows, is cleared or is released, so keep the value alive while using it.
public function address(bytes: Bytes): Integer { native "machine" }

// ----- Device memory -----
// Volatile accesses that happen exactly once, in program order, for
// memory-mapped device registers.

public function read8(address: Integer): Integer { native "machine" }
public function read16(address: Integer): Integer { native "machine" }
public function read32(address: Integer): Integer { native "machine" }
public function read64(address: Integer): Integer { native "machine" }
public function write8(address: Integer, value: Integer) { native "machine" }
public function write16(address: Integer, value: Integer) { native "machine" }
public function write32(address: Integer, value: Integer) { native "machine" }
public function write64(address: Integer, value: Integer) { native "machine" }
// Order every earlier memory access before every later one.
public function fence() { native "machine" }

// ----- I/O ports -----

public function in8(port: Integer): Integer { native "machine" }
public function in16(port: Integer): Integer { native "machine" }
public function in32(port: Integer): Integer { native "machine" }
public function out8(port: Integer, value: Integer) { native "machine" }
public function out16(port: Integer, value: Integer) { native "machine" }
public function out32(port: Integer, value: Integer) { native "machine" }

// ----- Processor -----

// The processor's time-stamp counter.
public function timestamp(): Integer { native "machine" }
// A spin-wait hint for busy loops.
public function pause() { native "machine" }
public function halt() { native "machine" }
public function enableInterrupts() { native "machine" }
public function disableInterrupts() { native "machine" }
// Enable interrupts and sleep until the next one arrives. Interrupts stay
// enabled afterwards; freestanding code has no red zone, so that is safe.
public function waitForInterrupt() { native "machine" }
// Load the interrupt descriptor table at `address` with the given byte limit.
public function loadInterruptTable(address: Integer, limit: Integer) { native "machine" }
// The entry point of the boot code's handler for an interrupt vector from 0 to 47.
public function interruptHandler(vector: Integer): Integer { native "machine" }
// How many times the interrupt vector has fired since boot.
public function interruptCount(vector: Integer): Integer { native "machine" }
// Call the code at `address` with `argument` as its first parameter. Used by
// boot loaders to enter a kernel; it does not return if the kernel does not.
public function jump(address: Integer, argument: Integer) { native "machine" }
// Call the VMware/QEMU hypervisor port with a command and parameter, storing
// the four result registers (eax, ebx, ecx, edx) as 64-bit values at `results`.
public function hypervisorCall(command: Integer, parameter: Integer, results: Integer) { native "machine" }

// ----- Multiple processors -----
// Code that runs on several processors at once must be a `parallel function`:
// it uses only Integer, Float, Boolean and Character values and calls only
// other parallel functions and these intrinsics, so it never touches the
// single-threaded runtime. `parallelEntry(name)` gives such a function's
// address.

// Atomically add `value` to the 64-bit Integer at `address`; returns the old value.
public function atomicAdd(address: Integer, value: Integer): Integer { native "machine" }
// Call the parallel function at `entry` with two Integers.
public function callEntry(entry: Integer, first: Integer, second: Integer) { native "machine" }
// An address published by the boot code's symbol table (see os/boot/entry.S).
public function symbol(index: Integer): Integer { native "machine" }

// ----- Pixels -----
// Blending loops for 32-bit 0x00RRGGBB pixels, compiled so the processor can
// work on several pixels per instruction.

// Blend `count` pixels at `address` toward `color` with opacity 0 to 256.
public function blendSpan(address: Integer, count: Integer, color: Integer, opacity: Integer) { native "machine" }
// Blend `count` pixels toward `color` through the bytes at `mask`: each
// pixel's opacity is min(mask + bias, limit) × scale / 256 (scale 0-256).
public function blendMask(address: Integer, count: Integer, mask: Integer, color: Integer, scale: Integer, bias: Integer, limit: Integer) { native "machine" }
// Turn `count` float32 signed areas at `source` into coverage bytes 0-255 at
// `target`: each byte is the running sum so far, made positive, capped at 1.
public function coverage(source: Integer, target: Integer, count: Integer) { native "machine" }
