use "ui" as ui
use "android" as android

function mount(parent: Integer, view: ui.View) {
    let handle = android.node(parent, ui.kind(view), ui.key(view), ui.text(view), ui.isChecked(view), ui.spacing(view), ui.padding(view))
    for child in ui.children(view) { mount(handle, child) }
}

/// Publish a validated shared view as copied native descriptors.
public function show(view: ui.View) {
    let problem = ui.problem(view)
    if problem != "" { fail("cannot show this view: " + problem) }
    android.begin()
    mount(0, view)
    android.end()
}

/// Render on Android's UI thread while callbacks stay on one native worker.
public function run(title: Text, view: () -> ui.View, update: (android.Event) -> Nothing) {
    android.run(title, function() { show(view()) }, update)
}
