use "errors" as errors
use "text" as textTools
// JSON: parsing into a tree of values, reading members, and writing text.
// Import it with `use "json" as json`.
//
// Values are built bottom-up, because a record that contains a list of its
// own kind may only be given lists that are complete when it is created.

public constant NULL = 0
public constant BOOLEAN = 1
public constant NUMBER = 2
public constant STRING = 3
public constant ARRAY = 4
public constant OBJECT = 5
public constant INVALID = 6

/// A JSON value: null, Boolean, number, string, array, object, or invalid input.
/// `kind` identifies the form. Arrays use `items`; objects pair `keys` with
/// `items`. An invalid value keeps its diagnostic in `text`.
public record Value {
    kind: Integer
    text: Text
    number: Float
    truth: Boolean
    // Array elements, or object members whose names are in `keys`.
    items: List<Value>
    keys: List<Text>
}

record Cursor {
    text: Text
    position: Integer
    error: Text
    strict: Boolean
    uniqueNames: Boolean
    remainingValues: Integer
    maximumMembers: Integer
}

function leaf(kind: Integer, text: Text, number: Float, truth: Boolean): Value {
    return Value { kind: kind; text: text; number: number; truth: truth; items: []; keys: [] }
}

/// Read JSON into a tree of values. Invalid input returns `INVALID`.
/// Object member order is preserved. Use `parseUnique` when duplicate names
/// must be rejected.
///
/// ```minyar
/// let tree = api.parse(#"{"name":"Ada","lights":[1,2]}"#)
/// print(tree.member("name").text)
/// print(tree.member("lights").items.length)
/// ```
/// ```output
/// Ada
/// 2
/// ```
public function parse(source: Text): Value {
    return parseText(source, false)
}

function parseText(source: Text, strict: Boolean): Value {
    return parseTextWithin(source, strict, false, -1, -1)
}

function parseTextWithin(source: Text, strict: Boolean, uniqueNames: Boolean, maximumValues: Integer, maximumMembers: Integer): Value {
    let cursor = Cursor { text: source; position: 0; error: ""; strict: strict; uniqueNames: uniqueNames; remainingValues: maximumValues; maximumMembers: maximumMembers }
    let value = parseValue(cursor, 0)
    skipSpace(cursor)
    if cursor.error == "" && cursor.position != source.length {
        return failure(cursor, "unexpected trailing input")
    }
    if cursor.error != "" {
        return leaf(INVALID, cursor.error, 0.0, false)
    }
    return value
}

// Validate bytes before Text conversion, so malformed network input remains
// an INVALID value. The caller supplies its protocol's maximum wire size.
public function parseBytes(source: Bytes, maximumBytes: Integer): Value {
    if maximumBytes <= 0 || source.length > maximumBytes {
        return leaf(INVALID, "JSON byte limit exceeded", 0.0, false)
    }
    if !validUTF8(source) { return leaf(INVALID, "invalid JSON UTF-8", 0.0, false) }
    return parse(Text(source))
}

function validUTF8(source: Bytes): Boolean {
    let position = 0
    while position < source.length {
        let first = source[position]
        if first < 128 {
            position += 1
        } else {
            let count = 0
            let lower = 128
            let upper = 191
            if first >= 194 && first <= 223 { count = 2 }
            if first >= 224 && first <= 239 {
                count = 3
                if first == 224 { lower = 160 }
                if first == 237 { upper = 159 }
            }
            if first >= 240 && first <= 244 {
                count = 4
                if first == 240 { lower = 144 }
                if first == 244 { upper = 143 }
            }
            if count == 0 || count > source.length - position { return false }
            let second = source[position + 1]
            if second < lower || second > upper { return false }
            for index in 2..count {
                let continuation = source[position + index]
                if continuation < 128 || continuation > 191 { return false }
            }
            position += count
        }
    }
    return true
}

// Bounded authentication metadata: duplicate decoded names are ambiguous.
// Limits are 64 Ki characters, 4096 values and 256 members per object.
// parse() keeps its ordinary JSON duplicate-name policy.
/// Read JSON while rejecting duplicate object member names, including nested objects.
public function parseUnique(source: Text): Value {
    if source.length > 65536 { return leaf(INVALID, "JSON metadata limit exceeded", 0.0, false) }
    return parseTextWithin(source, true, true, 4096, 256)
}

// Network metadata validates bytes before Text conversion, decoded names and
// Unicode surrogates. Ordinary parse() retains its existing replacement policy.
public function parseUniqueBytes(source: Bytes, maximumBytes: Integer): Value {
    if maximumBytes <= 0 || source.length > maximumBytes || source.length > 65536 {
        return leaf(INVALID, "JSON metadata byte limit exceeded", 0.0, false)
    }
    if !validUTF8(source) { return leaf(INVALID, "invalid JSON UTF-8", 0.0, false) }
    return parseUnique(Text(source))
}

// Explicit wire/value/member budgets for larger documents. Existing metadata
// entry points retain their 64 KiB / 4096-value / 256-member policy.
/// Read UTF-8 JSON with explicit byte, value and member limits.
/// Duplicate names and inputs that exceed any limit return an invalid value.
public function parseUniqueBytesWithin(source: Bytes, maximumBytes: Integer, maximumValues: Integer, maximumMembers: Integer): Value {
    if maximumBytes <= 0 || maximumValues <= 0 || maximumMembers <= 0 { return leaf(INVALID, "invalid JSON metadata limits", 0.0, false) }
    if source.length > maximumBytes { return leaf(INVALID, "JSON metadata byte limit exceeded", 0.0, false) }
    if !validUTF8(source) { return leaf(INVALID, "invalid JSON UTF-8", 0.0, false) }
    return parseTextWithin(Text(source), true, true, maximumValues, maximumMembers)
}

function skipSpace(cursor: Cursor) {
    while cursor.position < cursor.text.length {
        let c = cursor.text[cursor.position]
        if c != ' ' && c != '\n' && c != '\r' && c != '\t' { return }
        cursor.position += 1
    }
}

function failure(cursor: Cursor, message: Text): Value {
    if cursor.error == "" {
        cursor.error = message + " at character " + Text(cursor.position)
    }
    cursor.position = cursor.text.length
    return leaf(INVALID, cursor.error, 0.0, false)
}

// Policy failures keep the existing stable diagnostics without a source
// position. They stop parsing before another bounded node is allocated.
function policyFailure(cursor: Cursor, message: Text): Value {
    if cursor.error == "" { cursor.error = message }
    cursor.position = cursor.text.length
    return leaf(INVALID, cursor.error, 0.0, false)
}

function literal(cursor: Cursor, word: Text): Boolean {
    let end = cursor.position + word.length
    if end > cursor.text.length || cursor.text.slice(cursor.position, end) != word { return false }
    cursor.position = end
    return true
}

function parseValue(cursor: Cursor, depth: Integer): Value {
    if cursor.remainingValues == 0 { return policyFailure(cursor, "JSON metadata value limit exceeded") }
    if cursor.remainingValues > 0 { cursor.remainingValues -= 1 }
    skipSpace(cursor)
    if depth > 64 { return failure(cursor, "nesting too deep") }
    if cursor.position >= cursor.text.length { return failure(cursor, "unexpected end") }
    let c = cursor.text[cursor.position]
    if c == '{' { return parseObject(cursor, depth) }
    if c == '[' { return parseArray(cursor, depth) }
    if c == '"' { return leaf(STRING, parseString(cursor), 0.0, false) }
    if literal(cursor, "true") { return leaf(BOOLEAN, "true", 0.0, true) }
    if literal(cursor, "false") { return leaf(BOOLEAN, "false", 0.0, false) }
    if literal(cursor, "null") { return leaf(NULL, "null", 0.0, false) }
    return parseNumber(cursor)
}

function parsedObject(cursor: Cursor, keys: List<Text>, items: List<Value>): Value {
    if cursor.uniqueNames && keys.length > 1 {
        let ordered: List<Text> = []
        for key in keys { ordered.add(key) }
        ordered.sort()
        for index in 1..ordered.length {
            if ordered[index - 1] == ordered[index] { return policyFailure(cursor, "duplicate JSON member") }
        }
    }
    return Value { kind: OBJECT; text: ""; number: 0.0; truth: false; items: items; keys: keys }
}

function parseObject(cursor: Cursor, depth: Integer): Value {
    cursor.position += 1
    let keys: List<Text> = []
    let items: List<Value> = []
    skipSpace(cursor)
    if cursor.position < cursor.text.length && cursor.text[cursor.position] == '}' {
        cursor.position += 1
        return parsedObject(cursor, keys, items)
    }
    while cursor.error == "" {
        if cursor.maximumMembers >= 0 && keys.length >= cursor.maximumMembers { return policyFailure(cursor, "JSON metadata member limit exceeded") }
        skipSpace(cursor)
        if cursor.position >= cursor.text.length || cursor.text[cursor.position] != '"' {
            return failure(cursor, "expected a member name")
        }
        keys.add(parseString(cursor))
        skipSpace(cursor)
        if cursor.position >= cursor.text.length || cursor.text[cursor.position] != ':' {
            return failure(cursor, "expected ':'")
        }
        cursor.position += 1
        items = items.appended(parseValue(cursor, depth + 1))
        skipSpace(cursor)
        if cursor.position >= cursor.text.length { return failure(cursor, "unfinished object") }
        let c = cursor.text[cursor.position]
        cursor.position += 1
        if c == '}' {
            return parsedObject(cursor, keys, items)
        }
        if c != ',' { return failure(cursor, "expected ',' or '}'") }
    }
    return failure(cursor, "invalid object")
}

function parseArray(cursor: Cursor, depth: Integer): Value {
    cursor.position += 1
    let items: List<Value> = []
    skipSpace(cursor)
    if cursor.position < cursor.text.length && cursor.text[cursor.position] == ']' {
        cursor.position += 1
        return Value { kind: ARRAY; text: ""; number: 0.0; truth: false; items: items; keys: [] }
    }
    while cursor.error == "" {
        items = items.appended(parseValue(cursor, depth + 1))
        skipSpace(cursor)
        if cursor.position >= cursor.text.length { return failure(cursor, "unfinished array") }
        let c = cursor.text[cursor.position]
        cursor.position += 1
        if c == ']' {
            return Value { kind: ARRAY; text: ""; number: 0.0; truth: false; items: items; keys: [] }
        }
        if c != ',' { return failure(cursor, "expected ',' or ']'") }
    }
    return failure(cursor, "invalid array")
}

function hexDigit(c: Character): Integer {
    if c >= '0' && c <= '9' { return Integer(c) - 48 }
    if c >= 'a' && c <= 'f' { return Integer(c) - 87 }
    if c >= 'A' && c <= 'F' { return Integer(c) - 55 }
    return -1
}

function parseString(cursor: Cursor): Text {
    cursor.position += 1
    let start = cursor.position
    let text = cursor.text
    // Most strings have no escapes: they are one slice of the source.
    let end = start
    while end < text.length && text[end] != '"' && text[end] != '\\' {
        if Integer(text[end]) < 32 {
            failure(cursor, "unescaped string control")
            return ""
        }
        end += 1
    }
    if end < text.length && text[end] == '"' {
        cursor.position = end + 1
        return text.slice(start, end)
    }
    let parts: List<Text> = []
    while cursor.position < text.length {
        let c = text[cursor.position]
        if Integer(c) < 32 {
            failure(cursor, "unescaped string control")
            return ""
        }
        if c == '"' {
            parts.add(text.slice(start, cursor.position))
            cursor.position += 1
            return joinText(parts)
        }
        if c == '\\' {
            parts.add(text.slice(start, cursor.position))
            cursor.position += 1
            if cursor.position >= text.length { break }
            let e = text[cursor.position]
            cursor.position += 1
            if e == 'n' { parts.add("\n") }
            if e == 't' { parts.add("\t") }
            if e == 'r' { parts.add("\r") }
            if e == 'b' { parts.add(Text(Character(8))) }
            if e == 'f' { parts.add(Text(Character(12))) }
            if e == '"' || e == '\\' || e == '/' { parts.add(Text(e)) }
            if e == 'u' {
                if cursor.position + 4 > text.length {
                    failure(cursor, "unfinished Unicode escape")
                    return ""
                }
                let code = 0
                for index in 0..4 {
                    let digit = hexDigit(text[cursor.position + index])
                    if digit < 0 {
                        failure(cursor, "invalid Unicode escape")
                        return ""
                    }
                    code = code * 16 + digit
                }
                cursor.position += 4
                // Combine a surrogate pair.
                if code >= 0xD800 && code < 0xDC00 && cursor.position + 6 <= text.length && text[cursor.position] == '\\' && text[cursor.position + 1] == 'u' {
                    let low = 0
                    for index in 0..4 {
                        let digit = hexDigit(text[cursor.position + 2 + index])
                        if digit < 0 {
                            failure(cursor, "invalid Unicode escape")
                            return ""
                        }
                        low = low * 16 + digit
                    }
                    if low >= 0xDC00 && low < 0xE000 {
                        code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00)
                        cursor.position += 6
                    }
                }
                if code >= 0xD800 && code < 0xE000 {
                    if cursor.strict { failure(cursor, "unpaired Unicode surrogate"); return "" }
                    code = 0xFFFD
                }
                parts.add(Text(Character(code)))
            }
            if e != 'n' && e != 't' && e != 'r' && e != 'b' && e != 'f' && e != '"' && e != '\\' && e != '/' && e != 'u' {
                failure(cursor, "invalid string escape")
                return ""
            }
            start = cursor.position
        } else {
            cursor.position += 1
        }
    }
    failure(cursor, "unfinished string")
    return joinText(parts)
}

// Grammar stays in Minyar; the private runtime helper rounds the complete
// decimal once, without a host locale or intermediate floating-point powers.
function jsonNumber(source: Text): Float { native "runtime" }

function parseNumber(cursor: Cursor): Value {
    let text = cursor.text
    let start = cursor.position
    if cursor.position < text.length && text[cursor.position] == '-' {
        cursor.position += 1
    }
    let integerStart = cursor.position
    while cursor.position < text.length && text[cursor.position] >= '0' && text[cursor.position] <= '9' {
        cursor.position += 1
    }
    let digits = cursor.position - integerStart
    if digits == 0 || (digits > 1 && text[integerStart] == '0') {
        return failure(cursor, "invalid number integer")
    }
    if cursor.position < text.length && text[cursor.position] == '.' {
        cursor.position += 1
        let fractionStart = cursor.position
        while cursor.position < text.length && text[cursor.position] >= '0' && text[cursor.position] <= '9' {
            cursor.position += 1
        }
        if cursor.position == fractionStart { return failure(cursor, "unfinished fraction") }
    }
    if cursor.position < text.length && (text[cursor.position] == 'e' || text[cursor.position] == 'E') {
        cursor.position += 1
        if cursor.position < text.length && (text[cursor.position] == '-' || text[cursor.position] == '+') {
            cursor.position += 1
        }
        let exponentStart = cursor.position
        while cursor.position < text.length && text[cursor.position] >= '0' && text[cursor.position] <= '9' {
            cursor.position += 1
        }
        if cursor.position == exponentStart { return failure(cursor, "unfinished exponent") }
    }
    let spelling = text.slice(start, cursor.position)
    let value = jsonNumber(spelling)
    if value != value || value - value != 0.0 { return failure(cursor, "number is not finite") }
    return leaf(NUMBER, spelling, value, false)
}

// ----- Access -----

// Presence is independent of the member's kind: explicit null is present.
/// Whether an object contains a name. A member whose value is null is still present.
public function hasMember(value: Value, name: Text): Boolean {
    if value.kind != OBJECT { return false }
    for key in value.keys { if key == name { return true } }
    return false
}

// Strict lookups follow parse's INVALID-value convention. Missing names and
// non-objects are errors; an explicit null remains a successful NULL value.
// Duplicate names use the first match, as member does; parseUnique rejects them.
/// Find an object member, or return `INVALID` with a diagnostic.
/// Unlike `member`, a missing name stays distinguishable from explicit null.
public function lookup(value: Value, name: Text): Value {
    if value.kind != OBJECT { return leaf(INVALID, "expected a JSON object", 0.0, false) }
    for index in 0..value.keys.length {
        if value.keys[index] == name { return value.items[index] }
    }
    return leaf(INVALID, "missing JSON member: " + name, 0.0, false)
}

function typedMember(value: Value, name: Text, kind: Integer, expected: Text): Value {
    let found = lookup(value, name)
    if found.kind == INVALID { return found }
    if found.kind != kind { return leaf(INVALID, "JSON member '" + name + "' must be " + expected, 0.0, false) }
    return found
}

// These return a Value of exactly the requested kind, or INVALID with a
// diagnostic in text. They never coerce numbers/booleans to strings.
public function requireString(value: Value, name: Text): Value { return typedMember(value, name, STRING, "a string") }
public function requireBoolean(value: Value, name: Text): Value { return typedMember(value, name, BOOLEAN, "a boolean") }
public function requireNumber(value: Value, name: Text): Value { return typedMember(value, name, NUMBER, "a number") }

/// Find an object member, returning a null value when the name is absent or the input is not an object.
public function member(value: Value, name: Text): Value {
    if value.kind == OBJECT {
        for index in 0..value.keys.length {
            if value.keys[index] == name {
                return value.items[index]
            }
        }
    }
    return leaf(NULL, "", 0.0, false)
}

public function string(value: Value, name: Text): Text {
    let found = member(value, name)
    if found.kind == STRING { return found.text }
    if found.kind == NUMBER || found.kind == BOOLEAN { return found.text }
    return ""
}

// A JSON string literal for `text`.
/// Encode Text as one JSON string literal, escaping quotes and control characters.
///
/// ```minyar
/// print(api.quote("a\nb"))
/// ```
/// ```output
/// "a\nb"
/// ```
public function quote(text: Text): Text {
    let parts: List<Text> = ["\""]
    let hex = "0123456789abcdef"
    for c in text {
        let code = Integer(c)
        if c == '"' { parts.add("\\\"") }
        else if c == '\\' { parts.add("\\\\") }
        else if c == '\n' { parts.add("\\n") }
        else if c == '\t' { parts.add("\\t") }
        else if c == '\r' { parts.add("\\r") }
        else if code == 8 { parts.add("\\b") }
        else if code == 12 { parts.add("\\f") }
        else if code < 32 { parts.add("\\u00" + Text(hex[code / 16]) + Text(hex[code % 16])) }
        else { parts.add(Text(c)) }
    }
    parts.add("\"")
    return joinText(parts)
}

// Indented JSON text, for showing a response to people.
/// Write readable JSON with two spaces per nesting level.
/// Pass an empty `indent` for a complete document; `Value.pretty("")` is the
/// same operation in method form.
public function pretty(value: Value, indent: Text): Text {
    if value.kind == STRING { return quote(value.text) }
    if value.kind == OBJECT {
        if value.items.length == 0 { return "{}" }
        let parts: List<Text> = ["{\n"]
        for index in 0..value.items.length {
            parts.add(indent + "  " + quote(value.keys[index]) + ": " + pretty(value.items[index], indent + "  "))
            if index + 1 < value.items.length { parts.add(",") }
            parts.add("\n")
        }
        parts.add(indent + "}")
        return joinText(parts)
    }
    if value.kind == ARRAY {
        if value.items.length == 0 { return "[]" }
        let parts: List<Text> = ["[\n"]
        for index in 0..value.items.length {
            parts.add(indent + "  " + pretty(value.items[index], indent + "  "))
            if index + 1 < value.items.length { parts.add(",") }
            parts.add("\n")
        }
        parts.add(indent + "]")
        return joinText(parts)
    }
    return value.text
}

/// Whether this object contains a name, including a member whose value is null.
public function Value.hasMember(name: Text): Boolean { return hasMember(self, name) }
/// Look up a member while keeping a missing name distinguishable from explicit null.
public function Value.lookup(name: Text): Value { return lookup(self, name) }
/// Look up a member, returning a null value when the name is absent or this is not an object.
public function Value.member(name: Text): Value { return member(self, name) }
/// Require a named string member; otherwise return an invalid value with a diagnostic.
public function Value.requireString(name: Text): Value { return requireString(self, name) }
/// Require a named Boolean member; otherwise return an invalid value with a diagnostic.
public function Value.requireBoolean(name: Text): Value { return requireBoolean(self, name) }
/// Require a named number member; otherwise return an invalid value with a diagnostic.
public function Value.requireNumber(name: Text): Value { return requireNumber(self, name) }
/// Readable JSON with two-space indentation. Pass an empty `indent` for a complete document.
public function Value.pretty(indent: Text): Text { return pretty(self, indent) }

// Typed decoding and access. parse/lookup/require*/member/string retain their
// deprecated INVALID/null/empty compatibility contracts above. Both families
// share the same parser; typed decoding rejects malformed Unicode escapes.
function decoded(value: Value): Result<Value, errors.Error> {
    if value.kind == INVALID { return Err(errors.make(errors.invalidDataCode(), 0, value.text)) }
    return Ok(value)
}
public function decode(source: Text): Result<Value, errors.Error> {
    return decoded(parseText(source, true))
}
public function decodeBytes(source: Bytes, maximumBytes: Integer): Result<Value, errors.Error> {
    if maximumBytes <= 0 || source.length > maximumBytes { return Err(errors.make(errors.invalidDataCode(), 0, "JSON byte limit exceeded")) }
    return decode(try textTools.decode(source) else "decoding JSON")
}
public function decodeUnique(source: Text): Result<Value, errors.Error> { return decoded(parseUnique(source)) }
public function decodeUniqueBytes(source: Bytes, maximumBytes: Integer): Result<Value, errors.Error> { return decoded(parseUniqueBytes(source, maximumBytes)) }
public function decodeUniqueBytesWithin(source: Bytes, maximumBytes: Integer, maximumValues: Integer, maximumMembers: Integer): Result<Value, errors.Error> {
    return decoded(parseUniqueBytesWithin(source, maximumBytes, maximumValues, maximumMembers))
}
public function get(value: Value, name: Text): Result<Value, errors.Error> { return decoded(lookup(value, name)) }
public function findMember(value: Value, name: Text): Result<Maybe<Value>, errors.Error> {
    if value.kind != OBJECT { return Err(errors.make(errors.invalidDataCode(), 0, "expected a JSON object")) }
    for index in 0..value.keys.length {
        if value.keys[index] == name { return Ok(Some(value.items[index])) }
    }
    return Ok(None)
}
public function element(value: Value, position: Integer): Result<Value, errors.Error> {
    if value.kind != ARRAY { return Err(errors.make(errors.invalidDataCode(), 0, "expected a JSON array")) }
    if position < 0 || position >= value.items.length { return Err(errors.make(errors.invalidDataCode(), 0, "JSON array position is outside its bounds")) }
    return decoded(value.items[position])
}
public function asText(value: Value): Result<Text, errors.Error> {
    if value.kind != STRING { return Err(errors.make(errors.invalidDataCode(), 0, "expected a JSON string")) }
    return Ok(value.text)
}
public function asBoolean(value: Value): Result<Boolean, errors.Error> {
    if value.kind != BOOLEAN { return Err(errors.make(errors.invalidDataCode(), 0, "expected a JSON boolean")) }
    return Ok(value.truth)
}
public function asNumber(value: Value): Result<Float, errors.Error> {
    if value.kind != NUMBER { return Err(errors.make(errors.invalidDataCode(), 0, "expected a JSON number")) }
    if value.number != value.number || value.number > 1.7976931348623157e308 || value.number < -1.7976931348623157e308 {
        return Err(errors.make(errors.invalidDataCode(), 0, "JSON number is outside the finite Float range"))
    }
    return Ok(value.number)
}
// Parse the original decimal spelling, never a rounded Float. Fractional and
// exponent spellings use asNumber; integer endpoints retain every bit.
public function asInteger(value: Value): Result<Integer, errors.Error> {
    if value.kind != NUMBER { return Err(errors.make(errors.invalidDataCode(), 0, "expected a JSON integer")) }
    return textTools.integer(value.text)
}
public function asArray(value: Value): Result<List<Value>, errors.Error> {
    if value.kind != ARRAY { return Err(errors.make(errors.invalidDataCode(), 0, "expected a JSON array")) }
    return Ok(value.items)
}
public function Value.get(name: Text): Result<Value, errors.Error> { return get(self, name) }
public function Value.findMember(name: Text): Result<Maybe<Value>, errors.Error> { return findMember(self, name) }
public function Value.element(position: Integer): Result<Value, errors.Error> { return element(self, position) }
public function Value.asText(): Result<Text, errors.Error> { return asText(self) }
public function Value.asBoolean(): Result<Boolean, errors.Error> { return asBoolean(self) }
public function Value.asNumber(): Result<Float, errors.Error> { return asNumber(self) }
public function Value.asInteger(): Result<Integer, errors.Error> { return asInteger(self) }
public function Value.asArray(): Result<List<Value>, errors.Error> { return asArray(self) }
