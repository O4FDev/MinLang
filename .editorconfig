root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[*.{yml,yaml,json}]
indent_size = 2

# Location-sensitive fixtures and golden output are deliberately not trimmed.
[*.{c,h,cpp,py,sh,min}]
trim_trailing_whitespace = true

[tests/**]
trim_trailing_whitespace = false
