// G5 repro: a server must shut down cleanly on SIGTERM/SIGINT (final checkpoint, close files), the way
// Postgres does a fast shutdown. Minyar has no way to install a signal handler or to receive signals as
// events, so SIGTERM kills the process immediately with the default action.
use "eventloop" as loop
use "errors" as errors
let handle = errors.integerValue(loop.create())
// Wanted (none of these exist):
//   let signals = process.signalSource([process.SIGTERM, process.SIGINT])   // fd or loop registration
//   loop.watch(handle, signals, loop.readableInterest(), 1)                  // or loop.signal(handle, 15, token)
//   process.ignore(process.SIGPIPE)   // writes to a closed socket must return EPIPE, not kill the server
let batch = loop.wait(handle, -1, 16)   // run `kill -TERM <pid>`: the process dies here, no cleanup runs
print("unreachable after SIGTERM: final checkpoint would go here")
