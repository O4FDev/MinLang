// T3: 4 `thread function` workers drain ONE shared bounded BytesChannel (MPMC) and return Integer sums at join.
// Each entry gets one channel only, so a worker cannot also reply on a second channel; results come back via join.
thread function worker(seed: Integer, unused: FrozenBytes, jobs: BytesChannel): Integer {
    let total = 0
    let message = Bytes(0)
    while receiveBytes(jobs, message) { total += message.getInt64(0) }
    return total
}
function main() {
    let jobs = bytesChannel(1 << 16, 64)
    let none = freezeBytes(Bytes(0))
    let threads = [startThread(worker, 0, none, jobs), startThread(worker, 1, none, jobs), startThread(worker, 2, none, jobs), startThread(worker, 3, none, jobs)]
    for i in 0..100000 { let b = Bytes(0)
        b.addInt64(i)
        if !sendBytes(jobs, b) { fail("send") } }
    closeBytesChannel(jobs)
    let sum = 0
    for t in threads { sum += joinThread(t) }
    print(sum)
}
