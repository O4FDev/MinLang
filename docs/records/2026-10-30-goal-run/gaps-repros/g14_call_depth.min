// G14 repro: exceeding the maximum call depth stops the whole program; there is no recoverable error
// and no way to query the remaining depth. A server must therefore bound every recursion over client input.
function nest(n: Integer): Integer {
    if n == 0 { return 0 }
    return 1 + nest(n - 1)
}

print(nest(1000))
print(nest(1000000))    // "Minyar stopped: the program exceeded the maximum call depth."
