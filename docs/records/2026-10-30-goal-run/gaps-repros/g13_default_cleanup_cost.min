// G13 repro: allocation-heavy code spends most of its time in the default incremental cleanup.
// Build twice and compare:
//   minyar --release g13_default_cleanup_cost.min -o a            (default system profile, budget 32)
//   minyar --release --memory-profile eager g13_default_cleanup_cost.min -o b
// On the dev box the default build is ~2.5-3.7x slower; perf shows ~30% in rc_bounded_poll_work.
use "net" as net

record Node { kind: Integer; text: Text; children: List<Integer> }

let t0 = net.monotonicMilliseconds()
let total = 0
for i in 0..1000000 {
    let nodes: List<Node> = []
    for j in 0..12 { nodes.add(Node { kind: j; text: "x"; children: [j, i] }) }
    total += nodes.length
}
print(Text(net.monotonicMilliseconds() - t0) + " ms for 12M small allocations (" + Text(total) + ")")
