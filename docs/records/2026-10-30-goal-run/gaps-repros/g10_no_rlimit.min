// G10: no way to read or raise RLIMIT_NOFILE. Servers usually raise the soft descriptor limit to the hard limit
// at startup (Go does this automatically); with the default soft limit of 1024 a Minyar server cannot hold more
// than ~1000 connections unless whoever launches it runs `ulimit -n` first.
use "net" as net

let listener = net.listen("127.0.0.1", 0, 16)
let port = net.localPort(listener)
let opened = 0
while opened < 5000 {
    if net.connect("127.0.0.1", port) < 0 { break }
    opened += 1
}
print(opened)              // ~510 pairs under `ulimit -n 1024` (each loopback connection uses 2 fds here)
print(net.lastError())     // Too many open files; no setrlimit/getrlimit to raise it
