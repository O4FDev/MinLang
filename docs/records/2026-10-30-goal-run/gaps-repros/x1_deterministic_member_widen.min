record Call { value: Integer }
record Def { body: deterministic (Call) -> Nothing }
function Call.invoke(body: (Call) -> Nothing) { body(self) }
function invokeFn(c: Call, body: (Call) -> Nothing) { body(c) }
function twice(call: Call) { call.value = call.value * 2 }
let d = Def { body: twice }
let c = Call { value: 3 }
invokeFn(c, d.body)
print(c.value)
c.invoke(d.body)
print(c.value)
