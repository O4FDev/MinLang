// R2SRV-1 repro: memory freed by a Minyar program is not returned to the OS. 100k small records (like 100k connection
// records) are allocated and dropped; RSS stays at its peak because glibc only trims the top of the heap and
// Minyar has no way to call malloc_trim. Build: minyar --release --memory-profile eager r2srv_heap_not_returned.min
use "system" as system

record Conn {
    fd: Integer
    state: Integer
    name: Text
    buf: Bytes
    tags: List<Integer>
}

function rssKb(): Integer { return system.residentBytes() / 1024 }

let before = rssKb()
let conns: List<Conn> = []
let i = 0
while i < 100000 {
    conns.add(Conn { fd: i; state: 1; name: "conn" + Text(i); buf: Bytes(); tags: [] })
    i += 1
}
// a few long-lived allocations made after the burst, as a server keeps making (they pin the heap top)
let keep: List<Bytes> = []
i = 0
while i < 64 {
    keep.add(Bytes(256))
    i += 1
}
let peak = rssKb()
conns = []
let after = rssKb()
print("RSS before " + Text(before) + " kB, holding 100k records " + Text(peak) + " kB, after dropping them " +
      Text(after) + " kB (kept " + Text(keep.length) + " small buffers)")
