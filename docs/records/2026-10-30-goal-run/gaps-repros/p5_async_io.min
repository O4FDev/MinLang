// P5 async I/O: eventloop = readiness loop (kqueue/epoll) over sockets + timers, single owner, no callbacks/
// futures. completionio = io_uring file read/write/sync, Linux only. No async/await, no non-socket fds.
use "eventloop" as loop
use "completionio" as cio
use "errors" as errors
use "net" as net
let h = errors.integerValue(loop.create())
let l = net.listen("127.0.0.1", 0, 16)
errors.integerValue(loop.watch(h, l, loop.readableInterest(), 7))
errors.integerValue(loop.timer(h, 5, 0, 9))
let c = net.connect("127.0.0.1", net.localPort(l))
for round in 0..2 { for e in loop.events(loop.wait(h, 100, 16)) { print("token " + Text(e.token) + " timer " + Text(loop.isTimer(e)))
    if e.token == 7 { print("accepted " + Text(net.accept(l) >= 0)) } } }
match cio.create(8, 65536) {
    Ok(q) { print("completionio available") }
    Err(e) { print("completionio: " + e.describe()) }
}
