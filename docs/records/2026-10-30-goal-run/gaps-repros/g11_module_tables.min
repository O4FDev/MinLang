// Gap repro: no module-level constant tables. A CRC32C (or any lookup-table) module cannot hold its 256/2048-entry
// table as module data: `constant` accepts one scalar literal only, and imported modules cannot run top-level
// statements, so there is no place to build the table once. Every caller must create it and pass it around.
constant POLY = 0x82F63B78                  // fine: one literal
// constant TABLE: List<Integer> = [0x00000000, 0xF26B8303, ...]   // rejected: not a single literal
// let TABLE = makeTable()                   // rejected in an imported module: executable top-level statement
function makeTable(): List<Integer> {
    let t: List<Integer> = []
    for i in 0..256 {
        let c = i
        for bit in 0..8 {
            if c & 1 == 1 { c = (c >> 1) ^ POLY } else { c = c >> 1 }
        }
        t.add(c)
    }
    return t
}
// Workaround used in src/storage/crc32c.min: a Table record built by makeTable() and threaded through Wal/Reader.
print(makeTable()[1])
