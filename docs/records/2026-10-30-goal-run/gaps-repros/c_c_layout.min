// VMM-4 closure: C-layout records (record X native "c" { ... }), sizeOf/offsetOf, cView over Bytes
record KvmSegment native "c" { base: UInt64; limit: UInt32; selector: UInt16; kind: UInt8; present: UInt8 }
let bytes = Bytes(sizeOf(KvmSegment))
let s = cView(KvmSegment, bytes, 0)
s.selector = 8
print(Text(sizeOf(KvmSegment)) + " " + Text(offsetOf(KvmSegment, "selector")) + " " + Text(bytes.getUInt16(12)))
