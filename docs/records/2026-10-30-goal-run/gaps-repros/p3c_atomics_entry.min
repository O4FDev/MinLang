// P3c atomics: the only place atomicAdd may run is a parallel function reached through parallelEntry +
// machine.callEntry (raw Integers, intended for kernels/custom schedulers). Hosted callEntry runs on the
// calling thread, so there is no safe hosted way to share an atomic counter between threads.
use "machine" as machine
parallel function bump(counter: Integer, times: Integer) {
    for k in 0..times { machine.atomicAdd(counter, 1) }
}
let cell = Bytes(8)
let entry = parallelEntry(bump)
for w in 0..4 { machine.callEntry(entry, machine.address(cell), 1000) }
print(cell.getInt64(0))
