// G8: net.read(socket, limit) allocates a fresh `limit`-byte buffer, zero-fills it, then the wrapper copies the
// received prefix with slice(): two allocations, a memset of `limit` bytes and a copy for every read, even when
// 13 bytes arrive. There is no read-into-existing-Bytes (or append-to-Bytes) variant, and Bytes has no
// addBytes(other, start, end), so appending a sub-range also needs a slice() copy. Hot-path cost for a server.
use "net" as net
use "errors" as errors

let listener = net.listen("127.0.0.1", 0, 16)
let client = net.connect("127.0.0.1", net.localPort(listener))
let server = -1
while server < 0 { server = net.accept(listener) }
net.send(client, Bytes("Q\0\0\0\x0dSELECT 1\0"))
let r = net.read(server, 65536)     // allocates + zeroes 65536 bytes, then copies the 14 received bytes
print(errors.bytesValue(r).length)
