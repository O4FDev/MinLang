// G6: net.listen does not set SO_REUSEADDR. After the server side closes a connection first (TIME_WAIT on the
// listening port: a crash/kill -9 with clients connected, or any restart under load), listening again on the
// same port fails with EADDRINUSE for ~60 s. Postgres sets SO_REUSEADDR on its listen sockets.
use "net" as net

let port = 55999
let listener = net.listen("127.0.0.1", port, 16)
let client = net.connect("127.0.0.1", port)
let server = -1
while server < 0 { server = net.accept(listener) }
net.close(server)          // server closes first -> TIME_WAIT on 127.0.0.1:55999
net.receive(client, 16)    // client observes EOF
net.close(client)
net.close(listener)
let again = net.listen("127.0.0.1", port, 16)
print(again)               // -1
print(net.lastError())     // bind/listen: Address already in use
