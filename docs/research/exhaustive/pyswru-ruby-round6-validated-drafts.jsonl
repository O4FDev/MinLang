{"language": "ruby", "repo": "ruby/ruby", "revision": "b61936bc29156f6abff617f381d968a25b1a8e79", "path": "spec/ruby/core/string/codepoints_spec.rb", "case_id": "example-8", "lines": [8, 10], "source_sha256": "332359f78d3a78a023ea61cb95c5292d5eabe1a0d236b7c3f426662449be90a5", "adaptation": "Preserve exact abc -> numeric scalar array[97,98,99], array length3 and element order. A C runtime helper uses minyar_text_character_at to append scalar integers to a Minyar List, returns the owned List, releases input Text, observes every numeric element and releases List. This is a direct runtime ABI adaptation; it does not invent an ord source API or equate Character output with numeric codepoints. Ruby no-block eager array result becomes owned scalar List; no Enumerator/block protocol claim.", "scratch_tests": ["build/pyswru-ruby-round6/peer-ruby-round6-draft.py:PeerRubyRoundSixDraft.test_ascii_codepoints_form_complete_numeric_scalar_list"], "method_sha256": "f7e3a6e70d8449fc669112c984625b9235e8cb41efee7af3ed6102253bcb6ed4", "validation": {"native": {"report": "build/pyswru-ruby-round6/results/peer-ruby-round6-draft-xrkbi0gx.json", "sha256": "7e1b7d17c775acdcb8abe5d95de48907525db3086c863f0c4f7948179a4380f9", "configurations": ["O0", "O2", "O3", "Os"], "phases": ["execute", "link-c-runtime-probe"]}, "sanitize": {"report": "build/pyswru-ruby-round6/results/peer-ruby-round6-draft-qz9uy1kt.json", "sha256": "498f91304c78722355f64d98c41bf2df433844b3d1aa867ee8cb5a8b4a2be92e", "configurations": ["O0", "O2"], "phases": ["execute", "link-c-runtime-probe"]}, "ownership": {"report": "build/pyswru-ruby-round6/results/peer-ruby-round6-draft-ie_182w5.json", "sha256": "d28c943062c0fc312afd0d967fe801dd46dff23da56ac2dca19d40884d514f2b", "configurations": ["O0", "O2"], "phases": ["execute", "link-c-runtime-probe"]}}, "status": "validated-private-draft", "integration_required": true, "fixture": {"path": "build/pyswru-ruby-round6/codepoints-runtime.c", "sha256": "4f481bcdcf230f2b1f8a1c2f88bcdff7c