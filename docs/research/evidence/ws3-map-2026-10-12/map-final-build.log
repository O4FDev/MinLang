zsh scripts/with-limits.sh "clang-22" -std=c11 -O2 -Wall -Wextra -Werror tools/module-build.c -o build/minyar-module-build
zsh scripts/with-limits.sh ./build/minyarc build/compiler-baseline-control.min build/compiler-baseline-control.ll
zsh scripts/with-limits.sh "clang-22" -O2 -Wno-override-module -flto=thin -fuse-ld=lld-22 -Wl,--thinlto-jobs=1 -Wl,--threads=1 build/compiler-baseline-control.ll build/minyar-compiler-runtime.ll -lm -o build/minyarc-baseline
