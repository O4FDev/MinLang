python3 compiler/build-errors-compiler.py build/errors-compiler.min
zsh scripts/with-limits.sh ./build/minyarc build/errors-compiler.min build/errors-compiler-stage1.ll
zsh scripts/with-limits.sh "clang-22" -O2 -Wno-override-module -flto=thin -fuse-ld=lld-22 -Wl,--thinlto-jobs=1 -Wl,--threads=1 build/errors-compiler-stage1.ll build/minyar-compiler-runtime.ll -lm -o build/errors-compiler-stage1
zsh scripts/with-limits.sh ./build/errors-compiler-stage1 build/errors-compiler.min build/errors-compiler-stage2.ll
zsh scripts/with-limits.sh "clang-22" -O2 -Wno-override-module -flto=thin -fuse-ld=lld-22 -Wl,--thinlto-jobs=1 -Wl,--threads=1 build/errors-compiler-stage2.ll build/minyar-compiler-runtime.ll -lm -o build/minyarc-errors
