"clang-22" -isystem vendor -std=c11 -O2 -Wall -Wextra -Werror bootstrap/stage0.c -o build/stage0
zsh scripts/with-limits.sh ./build/stage0 compiler/compiler.min -o build/compiler-stage1.ll
zsh scripts/with-limits.sh "clang-22" -O2 -Wno-override-module -DMINYAR_COMPILER_ARENA -S -emit-llvm runtime/minyar_runtime.c -o build/minyar-compiler-runtime.ll.tmp
sed -E 's/"(target-cpu|target-features|tune-cpu)"="[^"]*" ?//g' build/minyar-compiler-runtime.ll.tmp > build/minyar-compiler-runtime.ll
rm -f build/minyar-compiler-runtime.ll.tmp
zsh scripts/with-limits.sh "clang-22" -O2 -Wno-override-module -flto=thin -fuse-ld=lld-22 -Wl,--thinlto-jobs=1 -Wl,--threads=1 build/compiler-stage1.ll build/minyar-compiler-runtime.ll -lm -o build/compiler-stage1
zsh scripts/with-limits.sh ./build/compiler-stage1 compiler/compiler.min build/compiler-stage2.ll
zsh scripts/with-limits.sh "clang-22" -O2 -Wno-override-module -flto=thin -fuse-ld=lld-22 -Wl,--thinlto-jobs=1 -Wl,--threads=1 build/compiler-stage2.ll build/minyar-compiler-runtime.ll -lm -o build/minyarc
