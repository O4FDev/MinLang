python3 scripts/build-closure-compiler.py build/closure-compiler.min
zsh scripts/with-limits.sh ./build/minyarc build/closure-compiler.min build/closure-compiler-stage1.ll
zsh scripts/with-limits.sh "clang-22" -O2 -Wno-override-module -flto=thin -fuse-ld=lld-22 -Wl,--thinlto-jobs=1 -Wl,--threads=1 build/closure-compiler-stage1.ll build/minyar-compiler-runtime.ll -lm -o build/closure-compiler-stage1
