use "frozen" as frozen

function viewAfterScope(): Text {
    let bytes = Bytes("alpha beta")
    let buffer = freezeBytes(bytes)
    match frozen.decode(buffer, 6, 10) {
        Ok(word) { return word }
        Err(problem) { return "" }
    }
}

function main() {
    let bytes = Bytes("one two three")
    let buffer = freezeBytes(bytes)
    // A middle range is a zero-copy view of the shared buffer.
    match frozen.decode(buffer, 4, 7) {
        Ok(word) { print(word + " " + Text(word.length)) }
        Err(problem) { print("invalid") }
    }
    // Bounds and validity behave like text.decode, without a copy.
    match frozen.decode(buffer, 1, 3) {
        Ok(word) { print("ne accepted: " + word) }
        Err(problem) { print("split rejected") }
    }
    match frozen.decode(buffer, 0, buffer.length) {
        Ok(all) { print(all) }
        Err(problem) { print("invalid") }
    }
    match frozen.decode(buffer, 0, 0) {
        Ok(empty) { print(empty.length) }
        Err(problem) { print("invalid") }
    }
    // Views slice, compare and join like any other Text.
    match frozen.decode(buffer, 8, 13) {
        Ok(word) { print(word + " " + word.slice(0, 1) + Text(word.length) + " " + Text(word == "three")) }
        Err(problem) { print("invalid") }
    }
    // Non-ASCII ranges keep character indexing exact.
    let accented = freezeBytes(Bytes("héllo wörld"))
    match frozen.decode(accented, 0, 13) {
        Ok(word) { print(word + " " + Text(word.length) + " " + Text(word[1]) + " " + word.slice(6, 9)) }
        Err(problem) { print("invalid") }
    }
    // A range that splits a character is not UTF-8 on its own.
    match frozen.decode(accented, 1, 2) {
        Ok(word) { print("split accepted: " + word) }
        Err(problem) { print("split rejected") }
    }
    match frozen.decode(accented, 1, 3) {
        Ok(word) { print("one scalar: " + word + " " + Text(word.length)) }
        Err(problem) { print("invalid") }
    }
    // The view keeps the buffer alive after the frozen handle's scope ends.
    print(viewAfterScope())
    // Bytes of a view are its own range.
    match frozen.decode(buffer, 4, 7) {
        Ok(word) { print(Bytes(word).length) }
        Err(problem) { print("invalid") }
    }
}
