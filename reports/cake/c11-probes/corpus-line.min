use "io" as io
use "process" as processInfo
use "frozen" as frozen

// Decode one whole line once, then slice each word out of that Text.
function lineShard(input: FrozenBytes, bounds: List<Integer>): Integer {
    let first = bounds[0]
    let after = bounds[1]
    let sum = 0
    let i = first
    while i < after {
        let end = i
        while end < after && input[end] != 10 { end += 1 }
        match frozen.decode(input, i, end) {
            Ok(line) {
                for word in line.split(" ") {
                    if word.length > 0 { sum += word.length }
                }
            }
            Err(problem) { return -1 }
        }
        i = end + 1
    }
    return sum
}

let bytes = io.readBytesFile(processInfo.argument(0))
let corpus = freezeBytes(bytes)
let length = corpus.length
let third = length / 4
let a, b = join(lineShard(corpus, [0, third]), lineShard(corpus, [third, third * 2]))
let c, d = join(lineShard(corpus, [third * 2, third * 3]), lineShard(corpus, [third * 3, length]))
print(a + b + c + d)
