use "io" as io
use "process" as processInfo
use "frozen" as frozen

// One view of the whole shard, then slice each word out of it.
function shardView(input: FrozenBytes, bounds: List<Integer>): Integer {
    let first = bounds[0]
    let after = bounds[1]
    let sum = 0
    match frozen.decode(input, first, after) {
        Ok(source) {
            let length = source.length
            let i = 0
            while i < length {
                while i < length && source[i] == ' ' { i += 1 }
                if i < length {
                    let start = i
                    while i < length && source[i] != ' ' { i += 1 }
                    sum += source.slice(start, i).length
                }
            }
        }
        Err(problem) { return -1 }
    }
    return sum
}

let bytes = io.readBytesFile(processInfo.argument(0))
let corpus = freezeBytes(bytes)
let length = corpus.length
let third = length / 4
let a, b = join(shardView(corpus, [0, third]), shardView(corpus, [third, third * 2]))
let c, d = join(shardView(corpus, [third * 2, third * 3]), shardView(corpus, [third * 3, length]))
print(a + b + c + d)
