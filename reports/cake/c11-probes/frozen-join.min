use "frozen" as frozen

function head(buffer: FrozenBytes, unused: Integer): Text {
    match frozen.decode(buffer, 0, 5) {
        Ok(word) { return word + "!" }
        Err(problem) { return "" }
    }
}

function tail(buffer: FrozenBytes, unused: Integer): Text {
    match frozen.decode(buffer, 6, 10) {
        Ok(word) { return word + "?" }
        Err(problem) { return "" }
    }
}

thread function entry(seed: Integer, buffer: FrozenBytes, done: BytesChannel): Integer {
    match frozen.decode(buffer, 6, 10) {
        Ok(word) { return seed + word.length }
        Err(problem) { return -1 }
    }
}

function main() {
    let buffer = freezeBytes(Bytes("alpha beta"))
    let a, b = join(head(buffer, 0), tail(buffer, 1))
    print(a + " " + b)
    let channel = bytesChannel(0, 1)
    let worker = startThread(entry, 40, buffer, channel)
    print(joinThread(worker))
}
