use "io" as io
use "process" as processInfo
use "frozen" as frozen

// Four join branches, each a zero-copy view of its shard and two splits.
function splitShard(input: FrozenBytes, bounds: List<Integer>): Integer {
    let sum = 0
    match frozen.decode(input, bounds[0], bounds[1]) {
        Ok(source) {
            for line in source.split("\n") {
                for word in line.split(" ") {
                    if word.length > 0 { sum += word.length }
                }
            }
        }
        Err(problem) { return -1 }
    }
    return sum
}

let bytes = io.readBytesFile(processInfo.argument(0))
let corpus = freezeBytes(bytes)
let length = corpus.length
let third = length / 4
let a, b = join(splitShard(corpus, [0, third]), splitShard(corpus, [third, third * 2]))
let c, d = join(splitShard(corpus, [third * 2, third * 3]), splitShard(corpus, [third * 3, length]))
print(a + b + c + d)
