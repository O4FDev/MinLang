use "io" as io
use "process" as processInfo
use "text" as text

let bytes = io.readBytesFile(processInfo.argument(0))
let corpus = freezeBytes(bytes)
let local = copyFrozenBytes(corpus)
let length = local.length
let sum = 0
let i = 0
while i < length {
    while i < length && (local[i] == 32 || local[i] == 10) { i += 1 }
    if i < length {
        let start = i
        while i < length && local[i] != 32 && local[i] != 10 { i += 1 }
        sum += text.decodeOrStop(local.slice(start, i)).length
    }
}
print(sum)
