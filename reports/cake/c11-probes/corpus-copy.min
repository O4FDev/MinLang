use "io" as io
use "process" as processInfo
use "text" as text
use "frozen" as frozen

// join branches over a shared frozen corpus: copy the whole corpus per branch
// (the shape the language forced before frozen text views) and decode words.
function copyShard(input: FrozenBytes, bounds: List<Integer>): Integer {
    let corpus = copyFrozenBytes(input)
    let first = bounds[0]
    let after = bounds[1]
    let sum = 0
    let i = first
    while i < after {
        while i < after && corpus[i] == 32 { i += 1 }
        if i < after {
            let start = i
            while i < after && corpus[i] != 32 { i += 1 }
            let word = text.decodeOrStop(corpus.slice(start, i))
            sum += word.length
        }
    }
    return sum
}

let bytes = io.readBytesFile(processInfo.argument(0))
let corpus = freezeBytes(bytes)
let length = corpus.length
let third = length / 4
let a, b = join(copyShard(corpus, [0, third]), copyShard(corpus, [third, third * 2]))
let c, d = join(copyShard(corpus, [third * 2, third * 3]), copyShard(corpus, [third * 3, length]))
print(a + b + c + d)
