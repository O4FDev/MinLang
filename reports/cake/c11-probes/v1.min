use "frozen" as frozen

function view(buffer: FrozenBytes, unused: Integer): Text {
    match frozen.decode(buffer, 0, 5) {
        Ok(word) { return word + "!" }
        Err(problem) { return "" }
    }
}

function main() {
    let buffer = freezeBytes(Bytes("alpha beta"))
    print(buffer.length)
}
