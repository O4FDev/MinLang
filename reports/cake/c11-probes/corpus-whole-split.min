use "io" as io
use "process" as processInfo
use "frozen" as frozen

// One zero-copy view of the whole shared buffer, then split it twice: no
// corpus copy per branch and no per-word decode or allocation.
let bytes = io.readBytesFile(processInfo.argument(0))
let corpus = freezeBytes(bytes)
let sum = 0
match frozen.decode(corpus, 0, corpus.length) {
    Ok(source) {
        for line in source.split("\n") {
            for word in line.split(" ") {
                if word.length > 0 { sum += word.length }
            }
        }
    }
    Err(problem) { sum = -1 }
}
print(sum)
