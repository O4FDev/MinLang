use "io" as io
use "process" as processInfo
use "frozen" as frozen

// One view per line, scanned with Text indexing and sliced per word.
function lineView(input: FrozenBytes, bounds: List<Integer>): Integer {
    let first = bounds[0]
    let after = bounds[1]
    let sum = 0
    let i = first
    while i < after {
        let end = i
        while end < after && input[end] != 10 { end += 1 }
        match frozen.decode(input, i, end) {
            Ok(line) {
                let length = line.length
                let k = 0
                while k < length {
                    while k < length && line[k] == ' ' { k += 1 }
                    if k < length {
                        let start = k
                        while k < length && line[k] != ' ' { k += 1 }
                        sum += line.slice(start, k).length
                    }
                }
            }
            Err(problem) { return -1 }
        }
        i = end + 1
    }
    return sum
}

let bytes = io.readBytesFile(processInfo.argument(0))
let corpus = freezeBytes(bytes)
let length = corpus.length
let third = length / 4
let a, b = join(lineView(corpus, [0, third]), lineView(corpus, [third, third * 2]))
let c, d = join(lineView(corpus, [third * 2, third * 3]), lineView(corpus, [third * 3, length]))
print(a + b + c + d)
