use "io" as io
use "process" as processInfo
use "frozen" as frozen

// The same scan, decoding each word straight out of the shared frozen buffer.
function viewShard(input: FrozenBytes, bounds: List<Integer>): Integer {
    let first = bounds[0]
    let after = bounds[1]
    let sum = 0
    let i = first
    while i < after {
        while i < after && input[i] == 32 { i += 1 }
        if i < after {
            let start = i
            while i < after && input[i] != 32 { i += 1 }
            match frozen.decode(input, start, i) {
                Ok(word) { sum += word.length }
                Err(problem) { return -1 }
            }
        }
    }
    return sum
}

let bytes = io.readBytesFile(processInfo.argument(0))
let corpus = freezeBytes(bytes)
let length = corpus.length
let third = length / 4
let a, b = join(viewShard(corpus, [0, third]), viewShard(corpus, [third, third * 2]))
let c, d = join(viewShard(corpus, [third * 2, third * 3]), viewShard(corpus, [third * 3, length]))
print(a + b + c + d)
