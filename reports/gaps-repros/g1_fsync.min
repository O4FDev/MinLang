// G1 repro: a write-ahead log needs append + fsync before acknowledging a commit.
// Minyar only offers whole-file writes with no durability guarantee and no rename.
use "io" as io
let record = Bytes("commit 1\n")
// Wanted (none of these exist):
//   let log = files.open("wal.log", files.append | files.create)
//   files.write(log, record)
//   files.syncData(log)              // fdatasync: required before telling the client COMMIT succeeded
//   files.rename("snap.tmp", "snap.db"); files.syncDirectory(".")
// Only available: rewrite the whole file, with no sync and no atomic replace.
io.writeBytesFile("wal.log", record)    // O(file) per commit, and not durable on power loss or kill -9 of the OS
print(io.readBytesFile("wal.log").length)
