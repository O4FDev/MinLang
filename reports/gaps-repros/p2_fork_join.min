// P2 work-stealing pool: the pool steals 128-index chunks of one flat range only. Recursive fork-join
// (split, run halves in parallel, join) is not expressible: the loop body may call only parallel
// functions, and those cannot own buffers or start a nested parallel for.
function sum(lo: Integer, hi: Integer): Integer {
    if hi - lo < 100000 { let s = 0
        for k in lo..hi { s += k }
        return s }
    let parts = [0, 0]
    let mid = (lo + hi) / 2
    parallel for half in 0..2 { parts[half] = sum(lo + half * (mid - lo), mid + half * (hi - mid)) }
    return parts[0] + parts[1]
}
print(sum(0, 1000000))
