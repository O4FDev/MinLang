// T2: `thread function` (undocumented; tests/thread-fixtures) takes exactly (Integer, FrozenBytes|NativeRegions,
// BytesChannel) and returns Integer. A thread taking a List, Text, a record or a closure is rejected.
record Job { name: Text; items: List<Integer> }
thread function work(seed: Integer, job: Job, queue: BytesChannel): Integer { return job.items.length + seed }
function main() {
    let queue = bytesChannel(4096, 4)
    let t = startThread(work, 1, Job { name: "a"; items: [1, 2] }, queue)
    print(joinThread(t))
}
