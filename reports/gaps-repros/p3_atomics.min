// P3 atomics: machine.atomicAdd (one sequentially consistent fetch-add on a raw address) and machine.fence
// are all there is. Below: 100000 increments from every worker land exactly.
use "machine" as machine
parallel function bump(counter: Integer, i: Integer): Integer { machine.atomicAdd(counter, 1)
    return i }
let cell = Bytes(8)
let base = machine.address(cell)
let sink: List<Integer> = []
for i in 0..100000 { sink.add(0) }
parallel for i in 0..sink.length { sink[i] = bump(base, i) }
print(cell.getInt64(0))
