// T6: a program that starts a `thread function` may not use `net` even on the main thread.
use "net" as net
thread function work(seed: Integer, unused: FrozenBytes, done: BytesChannel): Integer {
    let names: Map<Text, Integer> = Map()
    names["a" + Text(seed)] = seed
    return names.length
}
function main() {
    let l = net.listen("127.0.0.1", 0, 4)
    let t = startThread(work, 3, freezeBytes(Bytes(0)), bytesChannel(0, 1))
    print(joinThread(t))
    net.close(l)
}
