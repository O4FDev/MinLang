// T5: inside a `thread function`: thread-local managed values (Map, Text, List) and blocking socket I/O.
use "net" as net
thread function client(port: Integer, unused: FrozenBytes, done: BytesChannel): Integer {
    let names: Map<Text, Integer> = Map()
    names["a" + Text(port)] = 1
    let c = net.connect("127.0.0.1", port)
    let sent = net.send(c, Bytes("ping"))
    net.close(c)
    return sent + names.length
}
function main() {
    let l = net.listen("127.0.0.1", 0, 4)
    let t = startThread(client, net.localPort(l), freezeBytes(Bytes(0)), bytesChannel(0, 1))
    let s = -1
    while s < 0 { s = net.accept(l) }
    print(net.receive(s, 16).length)
    print(joinThread(t))
}
