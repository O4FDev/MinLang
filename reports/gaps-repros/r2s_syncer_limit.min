// Gap R2S-1 repro: the `files` package allows at most 16 background syncers per process (FILES_MAX_SYNCERS in
// runtime/native/files.c). neo-db needs one per open database (its WAL group-commit thread), so one process can
// keep at most ~15 tenant databases open at once.
// Expected: 100 syncers start. Actual: handles 1..16, then -24 (EMFILE) from the 17th on.
use "files" as files

let path = "/tmp/minyar-syncer-limit.tmp"
let fd = files.open(path, files.WRITE | files.CREATE)
let handles: List<Integer> = []
let failedAt = -1
for i in 0..100 {
    let h = files.syncerStart(fd)
    if h < 0 && failedAt < 0 {
        failedAt = i
        print("syncerStart #" + Text(i + 1) + " failed with " + Text(h) + " (" + files.errorText(h) + ")")
    }
    if h > 0 { handles.add(h) }
}
print("started " + Text(handles.length) + " syncers")
for h in handles { files.syncerStop(h) }
files.close(fd)
files.remove(path)
