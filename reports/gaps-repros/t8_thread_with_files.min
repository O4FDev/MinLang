use "files" as files
thread function work(seed: Integer, unused: FrozenBytes, done: BytesChannel): Integer { return seed }
function main() {
    let f = files.open("/tmp/gaps-t.tmp", files.WRITE | files.CREATE)
    print(joinThread(startThread(work, 3, freezeBytes(Bytes(0)), bytesChannel(0, 1))))
}
