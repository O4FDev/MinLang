// P1b: a long-lived thread owning managed state (the Rust std::thread::spawn shape) cannot be written.
// The closest form, a parallel-for body that touches a managed List or calls an ordinary function, is rejected.
function log(lines: List<Text>, i: Integer) { lines.add("item " + Text(i)) }
let lines: List<Text> = []
let flags = [0, 0, 0, 0]
parallel for i in 0..flags.length {
    log(lines, i)
    flags[i] = 1
}
print(lines.length)
