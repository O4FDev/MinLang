// G15 repro: there is no way to detect or recover from Integer overflow; the process stops.
function scale(digits: Integer): Integer {
    let r = 1
    for i in 0..digits { r = r * 10 }   // digits >= 19 overflows Int64
    return r
}
print(scale(18))
print(scale(19))   // "Minyar stopped: integer overflow": a SQL server would lose every session here
