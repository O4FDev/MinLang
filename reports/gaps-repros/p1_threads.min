// P1 threads: what exists is data-parallel `parallel for` over scalar slots (pthread pool) and
// process workers (tasks/workers). There is no thread spawn/join of an arbitrary closure.
use "system" as system
parallel function work(i: Integer): Integer { let s = 0
    for k in 0..1000000 { s += (k ^ i) & 7 }
    return s }
let out: List<Integer> = []
for i in 0..64 { out.add(0) }
parallel for i in 0..out.length { out[i] = work(i) }
let total = 0
for v in out { total += v }
print("workers " + Text(system.parallelWorkers()) + " total " + Text(total))
