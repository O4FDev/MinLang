// P4 channels: tasks.channel is a request/reply codec pair between a coordinator and one-shot worker
// PROCESSES (copied Bytes, re-executed program). There is no in-process channel, no bounded/unbounded
// queue between threads, no MPMC, no select.
use "tasks" as tasks
use "workers" as workers
use "errors" as errors
use "system" as system
let square = tasks.channel(tasks.integers(), tasks.integers())
if workers.isWorker() {
    tasks.serve(square, function(n: Integer): Result<Integer, errors.Error> { return Ok(n * n) }).unwrap()
} else {
    let t0 = system.monotonicNanoseconds()
    let total = tasks.together(10000, function(scope: tasks.Scope): Result<Integer, errors.Error> {
        let all: List<tasks.Task<Integer>> = []
        for i in 0..8 { all.add(try tasks.start(scope, "sq", square, i)) }
        let s = 0
        for t in all { s += try tasks.response(t) }
        return Ok(s)
    }).unwrap()
    print("sum " + Text(total) + " in " + Text((system.monotonicNanoseconds() - t0) / 1000) + " us for 8 one-shot tasks")
}
