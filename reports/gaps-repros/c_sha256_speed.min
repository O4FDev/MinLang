// IMAGE-3: SHA-256 throughput over 256 MiB
use "sha256" as sha
use "system" as system
let data = Bytes(256 * 1024 * 1024)
let t0 = system.monotonicNanoseconds()
let d = sha.digest(data)
let ns = system.monotonicNanoseconds() - t0
print(sha.hex(d).slice(0, 16) + " " + Text(256 * 1000 * 1000000 / ns) + " MB/s")
