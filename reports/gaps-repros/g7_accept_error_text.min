// G7: net.accept returns -1 for both "no pending connection" (EAGAIN) and real failures (EMFILE, ENOBUFS,
// ECONNABORTED). The only way to tell them apart is to compare the English strerror text from net.lastError(),
// which a level-triggered accept loop must do to avoid spinning when the process is out of descriptors.
use "net" as net

let listener = net.listen("127.0.0.1", 0, 16)
let fd = net.accept(listener)       // nothing pending
print(fd)                           // -1
print(net.lastError())              // "accept: Resource temporarily unavailable" -- no errno / would-block tag
