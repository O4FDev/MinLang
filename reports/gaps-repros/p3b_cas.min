// P3b atomics: no compare-and-swap, exchange, atomic load/store, acquire/release orderings or typed atomic cells.
use "machine" as machine
let cell = Bytes(8)
let base = machine.address(cell)
let old = machine.compareAndSwap(base, 0, 1)
let seen = machine.atomicLoad(base)
machine.atomicStore(base, 2)
print(old + seen)
