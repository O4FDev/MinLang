let count = 128
let sizes: List<Integer> = []
for slot in 0..count { sizes.add(0) }
parallel for index in 0..count {
    let words: List<Text> = []
    for step in 0..((index % 5) + 1) { words.add(Text(index * step)) }
    sizes[index] = words[words.length - 1].length + words.length
}
let sums = 0
for index in 0..count { sums += sizes[index] }
print(sums)
