use "process" as processInfo
// c9: the work this feature unlocks — per item Text and record building inside
// a `parallel for`, results leaving as scalars. Same source in both modes:
// MINYAR_PARALLEL_THREADS=4 runs it on the pool, =1 on the caller.
record Label { key: Text; words: Integer; width: Integer }

function main() {
    let count = 400000
    let widths: List<Integer> = []
    let totals: List<Integer> = []
    for slot in 0..count { widths.add(0); totals.add(0) }
    for index in 0..count {
        let parts: List<Text> = []
        for part in 0..((index % 7) + 1) { parts.add(Text(index * (part + 1))) }
        let key = joinText(parts, "-")
        let split: List<Text> = []
        for word in 0..parts.length { split.add(parts[word]) }
        let label = Label { key: key; words: split.length; width: key.length }
        widths[index] = label.width % 1000
        totals[index] = label.words + label.width % 97
    }
    let sum = 0
    let wide = 0
    for index in 0..count { sum += totals[index]; wide += widths[index] }
    print(sum)
    print(wide)
}
