record Pair { key: Text; value: Integer }
function main() {
    let values: List<Integer> = [3, 4, 5, 6]
    let lengths: List<Integer> = [0, 0, 0, 0]
    let keys: List<Integer> = [0, 0, 0, 0]
    parallel for index in 0..values.length {
        let label = Text(values[index]) + "!"
        let pair = Pair { key: label; value: values[index] * 2 }
        let seen: List<Integer> = []
        seen.add(pair.value)
        seen.add(pair.value + 1)
        lengths[index] = pair.key.length + seen.length
        keys[index] = seen[0]
    }
    print(lengths[0] + lengths[1] + lengths[2] + lengths[3])
    print(keys[0])
}
