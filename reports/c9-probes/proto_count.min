use "io" as io
use "process" as processInfo
function lineAfter(corpus: Bytes, first: Integer, after: Integer): Integer {
    let i = first
    while i < after {
        if corpus[i] == 10 { return i + 1 }
        i += 1
    }
    return after
}
let corpus = io.readBytesFile(processInfo.argument(0))
let i = 0
let after = corpus.length
let words = 0
while i < after {
    let lineEnd = lineAfter(corpus, i, after)
    let stop = lineEnd - 1
    let lineWords = 0
    while i < stop {
        if corpus[i] == 32 {
            i += 1
        } else {
            let start = i
            while i < stop {
                if corpus[i] == 32 { break }
                i += 1
            }
            lineWords += 1
        }
    }
    print("line words \(lineWords) stop \(stop) lineEnd \(lineEnd)")
    i = lineEnd
}
