use "io" as io
use "process" as processInfo
use "text" as text
// c9 prototype: the textindex dictionary and posting build as per-worker
// shards. Each `join` branch owns its documents, builds its own Text-keyed
// dictionary and posting runs on its own ownership domain, and returns owned
// Lists; the joining thread merges the shards once, in document order.
constant MODULUS = 1000000007
record Term { word: Text; id: Integer }
record Shard {
    words: List<Text>
    docs: List<List<Integer>>
    freqs: List<List<Integer>>
    seen: Integer
}

function lineAfter(corpus: Bytes, first: Integer, after: Integer): Integer {
    let i = first
    while i < after {
        if corpus[i] == 10 { return i + 1 }
        i += 1
    }
    return after
}

function shard(corpus: Bytes, first: Integer, after: Integer, firstDoc: Integer): Shard {
    let ids: Map<Text, Integer> = Map()
    let words: List<Text> = []
    let docs: List<List<Integer>> = []
    let freqs: List<List<Integer>> = []
    let seen = 0
    let i = first
    let d = firstDoc
    while i < after {
        let lineEnd = lineAfter(corpus, i, after)
        let stop = lineEnd - 1
        while i < stop {
            if corpus[i] == 32 {
                i += 1
            } else {
                let start = i
                while i < stop {
                    if corpus[i] == 32 { break }
                    i += 1
                }
                let word = text.decodeOrStop(corpus.slice(start, i))
                seen += 1
                let id = -1
                if ids.has(word) { id = ids[word] }
                if id < 0 {
                    id = words.length
                    ids[word] = id
                    words.add(word)
                    docs.add([])
                    freqs.add([])
                }
                let run = docs[id]
                if run.length > 0 && run[run.length - 1] == d {
                    let frun = freqs[id]
                    frun[frun.length - 1] += 1
                } else {
                    run.add(d)
                    freqs[id].add(1)
                }
            }
        }
        i = lineEnd
        d += 1
    }
    return Shard { words: words, docs: docs, freqs: freqs; seen: seen }
}

function build(corpus: Bytes, first: Integer, after: Integer, firstDoc: Integer, cutoff: Integer): List<Shard> {
    if after - first <= cutoff {
        let only = shard(corpus, first, after, firstDoc)
        return [only]
    }
    let mid = lineAfter(corpus, first + (after - first) / 2, after)
    let leftDocs = 0
    let i = first
    while i < mid {
        if corpus[i] == 10 { leftDocs += 1 }
        i += 1
    }
    let left, right = join(build(corpus, first, mid, firstDoc, cutoff), build(corpus, mid, after, firstDoc + leftDocs, cutoff))
    left.addAll(right)
    return left
}

let corpus = io.readBytesFile(processInfo.argument(0))
let documents = 0
let scan = 0
while scan < corpus.length {
    if corpus[scan] == 10 { documents += 1 }
    scan += 1
}
if corpus.length > 0 {
    if corpus[corpus.length - 1] != 10 { documents += 1 }
}
let shards = build(corpus, 0, corpus.length, 0, 65536)

let ids: Map<Text, Integer> = Map()
let wordOf: List<Text> = []
let postings: List<List<Integer>> = []
let frequencies: List<List<Integer>> = []
let tokens = 0
let seenTotal = 0
let s = 0
while s < shards.length {
    let part = shards[s]
    seenTotal += part.seen
    let term = 0
    while term < part.words.length {
        let word = part.words[term]
        let id = -1
        if ids.has(word) { id = ids[word] }
        if id < 0 {
            id = wordOf.length
            ids[word] = id
            wordOf.add(word)
            postings.add([])
            frequencies.add([])
        }
        let runs = part.docs[term]
        postings[id].addAll(runs)
        frequencies[id].addAll(part.freqs[term])
        tokens += runs.length
        term += 1
    }
    s += 1
}

let terms: List<Term> = []
let total = 0
for id in 0..wordOf.length {
    terms.add(Term { word: wordOf[id]; id: id })
    total += postings[id].length
}
terms.sortBy(function(a: Term, b: Term): Integer {
    if a.word < b.word { return -1 }
    if a.word > b.word { return 1 }
    return 0
})
let digest = 0
let best = 0
for rank in 0..terms.length {
    let id = terms[rank].id
    let docSum = 0
    let tfSum = 0
    for k in 0..postings[id].length {
        docSum += postings[id][k]
        tfSum += frequencies[id][k] * (k % 7 + 1)
    }
    digest = (digest * 31 + postings[id].length * 1000003 + docSum % 1000003 + tfSum) % MODULUS
    if postings[id].length > postings[terms[best].id].length { best = rank }
}
print("documents \(documents) tokens \(seenTotal)")
print("terms \(terms.length) postings \(total)")
print("widest \(terms[best].word) \(postings[terms[best].id].length)")
print("digest \(digest)")
