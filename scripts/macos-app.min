use "process" as processInfo
use "system" as system
use "./native-host.min" as host

record Entry { key: Text; value: Text; flag: Boolean }
record Version { parts: List<Integer>; text: Text }

function dottedIdentifier(identifier: Text): Boolean {
    let segments = host.split(identifier, 46)
    if segments.length < 2 { return false }
    for segment in segments {
        let raw = Bytes(segment)
        if raw.length == 0 { return false }
        for byte in raw {
            let allowed = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 45
            if !allowed { return false }
        }
    }
    return true
}
function version(text: Text): Version {
    let parts: List<Integer> = []
    for piece in host.split(text, 46) {
        if !host.decimalDigits(piece) { return Version { parts: []; text: "" } }
        let value = 0
        for byte in Bytes(piece) { value = value * 10 + byte - 48 }
        parts.add(value)
    }
    return Version { parts: parts; text: text }
}
function newer(left: Version, right: Version): Boolean {
    let count = min(left.parts.length, right.parts.length)
    for index in 0..count {
        if left.parts[index] != right.parts[index] { return left.parts[index] > right.parts[index] }
    }
    return left.parts.length > right.parts.length
}
public function deploymentTarget(loadCommands: Text): Text {
    let versions: List<Version> = []
    for line in host.lines(loadCommands) {
        let fields = host.words(line)
        let trimmed = host.strip(line)
        if fields.length == 2 && fields[0] == "minos" && host.starts(trimmed, "minos ") {
            let parsed = version(fields[1])
            if parsed.text != "" { versions.add(parsed) }
        }
    }
    if versions.length == 0 {
        let tokens = host.words(loadCommands)
        for index in 0..tokens.length {
            if index + 6 <= tokens.length && tokens[index] == "cmd" && tokens[index + 1] == "LC_VERSION_MIN_MACOSX" && tokens[index + 2] == "cmdsize" && host.decimalDigits(tokens[index + 3]) && tokens[index + 4] == "version" {
                let parsed = version(tokens[index + 5])
                if parsed.text != "" { versions.add(parsed) }
            }
        }
    }
    if versions.length == 0 { return "" }
    let best = versions[0]
    for candidate in versions { if newer(candidate, best) { best = candidate } }
    return best.text
}

function escape(text: Text): Text {
    let raw = Bytes(text)
    let result = Bytes()
    let index = 0
    while index < raw.length {
        let byte = raw[index]
        if byte == 13 {
            result.add(10)
            if index + 1 < raw.length && raw[index + 1] == 10 { index += 1 }
        } else if byte == 38 { result.addBytes(Bytes("&amp;")) }
        else if byte == 60 { result.addBytes(Bytes("&lt;")) }
        else if byte == 62 { result.addBytes(Bytes("&gt;")) }
        else { result.add(byte) }
        index += 1
    }
    return Text(result)
}
function controlCharacters(text: Text): Boolean {
    for byte in Bytes(text) {
        if byte < 32 && byte != 9 && byte != 10 && byte != 13 { return true }
    }
    return false
}
function propertyList(entries: List<Entry>): Text {
    let sorted: List<Entry> = []
    for entry in entries {
        sorted.add(entry)
        let index = sorted.length - 1
        while index > 0 && host.compareText(sorted[index - 1].key, entry.key) > 0 {
            sorted[index] = sorted[index - 1]
            index -= 1
        }
        sorted[index] = entry
    }
    let parts = ["<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n"]
    for entry in sorted {
        parts.add("\t<key>" + escape(entry.key) + "</key>\n")
        if entry.flag { parts.add("\t<true/>\n") } else { parts.add("\t<string>" + escape(entry.value) + "</string>\n") }
    }
    parts.add("</dict>\n</plist>\n")
    return joinText(parts)
}

public function package(binary: Text, output: Text, identifier: Text, icon: Text, resources: Text): Text {
    return packageWith(binary, output, identifier, icon, resources, [])
}
public function packageWith(binary: Text, requested: Text, identifier: Text, icon: Text, resources: Text, faults: List<host.RenameFault>): Text {
    return packageSignedWith(binary, requested, identifier, icon, resources, "-", faults)
}
public function packageSigned(binary: Text, requested: Text, identifier: Text, icon: Text, resources: Text, identity: Text): Text {
    return packageSignedWith(binary, requested, identifier, icon, resources, identity, [])
}
function packageSignedWith(binary: Text, requested: Text, identifier: Text, icon: Text, resources: Text, identity: Text, faults: List<host.RenameFault>): Text {
    if identity == "" || controlCharacters(identity) { return "signing identity must be a name, certificate hash, or - for local signing" }
    let output = host.normalize(host.absolute(requested))
    let name = host.basename(output)
    if host.suffix(name) != ".app" || host.stem(name) == "" { return "application output must have a name ending in .app" }
    if !dottedIdentifier(identifier) { return "bundle ID must be a dotted identifier using letters, digits, and hyphens" }
    let executable = host.resolve(binary, true)
    if executable.status != 0 { return executable.output }
    let iconPath = ""
    if icon != "" {
        let resolved = host.resolve(icon, true)
        if resolved.status != 0 { return resolved.output }
        iconPath = resolved.output
        if host.suffix(host.basename(iconPath)) != ".icns" || !host.isFile(iconPath) { return "the application icon must be an .icns file" }
    }
    let resourcePath = ""
    if resources != "" {
        let resolved = host.resolve(resources, true)
        if resolved.status != 0 { return resolved.output }
        resourcePath = resolved.output
        if !host.isDirectory(resourcePath) { return "application resources must be a directory" }
        if host.exists(host.child(resourcePath, ".minyar-app")) || (iconPath != "" && host.exists(host.child(resourcePath, host.basename(iconPath)))) {
            return "application resources would replace a file the packager writes"
        }
    }
    let inspect = ["otool", "-l", executable.output]
    let loadCommands = host.captureIn(inspect, system.environment(), "", "stdout")
    if loadCommands.status != 0 { return host.commandFailure(inspect, loadCommands.status) }
    let minimum = deploymentTarget(loadCommands.output)
    if minimum == "" { return "could not read the macOS deployment target from the executable" }
    let parent = host.parent(output)
    let made = host.makeDirectories(parent)
    if made != "" { return made }
    let lock = host.withName(output, name + ".minyar-lock")
    let locked = host.createExclusive(lock)
    if locked == -17 { return "app output is locked by another build: " + lock }
    if locked != 0 { return host.errorText(locked) + ": '" + lock + "'" }
    let error = install(executable.output, output, name, identifier, iconPath, resourcePath, minimum, identity, faults)
    host.removeFile(lock)
    return error
}
function install(binary: Text, output: Text, name: Text, identifier: Text, icon: Text, resources: Text, minimum: Text, identity: Text, faults: List<host.RenameFault>): Text {
    if host.isSymlink(output) || (host.exists(output) && (!host.isDirectory(output) || !host.isFile(host.child(output, "Contents/Resources/.minyar-app")))) {
        return "refusing to replace an app not generated by Minyar: " + output
    }
    let temporary = host.temporaryDirectory(host.parent(output), ".minyar-app-")
    if temporary.status != 0 { return temporary.output }
    let preserve: List<Boolean> = [false]
    let error = stageAndReplace(binary, output, name, identifier, icon, resources, minimum, identity, temporary.output, faults, preserve)
    if !preserve[0] { host.removeTree(temporary.output) }
    return error
}
function stageAndReplace(binary: Text, output: Text, name: Text, identifier: Text, icon: Text, resources: Text, minimum: Text, identity: Text, temporary: Text, faults: List<host.RenameFault>, preserve: List<Boolean>): Text {
    let stage = host.child(temporary, name)
    let contents = host.child(stage, "Contents")
    for directory in [host.child(contents, "MacOS"), host.child(contents, "Resources")] {
        let made = host.makeDirectories(directory)
        if made != "" { return made }
    }
    let executable = host.child(contents, "MacOS/application")
    let copied = host.copyFile(binary, executable)
    if copied != "" { return copied }
    let mode = host.makeExecutable(executable)
    if mode != "" { return mode }
    if resources != "" {
        let merged = host.mergeTree(resources, host.child(contents, "Resources"))
        if merged != "" { return merged }
    }
    let display = host.stem(name)
    if controlCharacters(display) || controlCharacters(identifier) { return "strings can't contain control characters; use bytes instead" }
    let entries = [
        Entry { key: "CFBundleDevelopmentRegion"; value: "en"; flag: false },
        Entry { key: "CFBundleExecutable"; value: "application"; flag: false },
        Entry { key: "CFBundleIdentifier"; value: identifier; flag: false },
        Entry { key: "CFBundleInfoDictionaryVersion"; value: "6.0"; flag: false },
        Entry { key: "CFBundleName"; value: display; flag: false },
        Entry { key: "CFBundleDisplayName"; value: display; flag: false },
        Entry { key: "CFBundlePackageType"; value: "APPL"; flag: false },
        Entry { key: "CFBundleShortVersionString"; value: "1.0"; flag: false },
        Entry { key: "CFBundleVersion"; value: "1"; flag: false },
        Entry { key: "LSMinimumSystemVersion"; value: minimum; flag: false },
        Entry { key: "NSHighResolutionCapable"; value: ""; flag: true },
        Entry { key: "NSPrincipalClass"; value: "NSApplication"; flag: false }
    ]
    if icon != "" {
        let iconName = host.basename(icon)
        let copiedIcon = host.copyFile(icon, host.child(contents, "Resources/" + iconName))
        if copiedIcon != "" { return copiedIcon }
        entries.add(Entry { key: "CFBundleIconFile"; value: iconName; flag: false })
    }
    let written = host.writeFile(host.child(contents, "Info.plist"), propertyList(entries))
    if written != "" { return written }
    let marker = host.writeFile(host.child(contents, "Resources/.minyar-app"), "Minyar generated application bundle v1\n")
    if marker != "" { return marker }
    for command in [["codesign", "--force", "--sign", identity, stage], ["codesign", "--verify", "--strict", stage]] {
        let signed = host.captureIn(command, system.environment(), "", "stderr")
        if signed.status != 0 { return host.commandFailure(command, signed.status) + "\n" + signed.output }
    }
    let backup = host.child(temporary, "previous.app")
    if host.exists(output) {
        let moved = host.rename(output, backup, faults)
        if moved != "" { return moved }
    }
    let installed = host.rename(stage, output, faults)
    if installed != "" {
        if host.exists(backup) {
            let restored = host.rename(backup, output, faults)
            if restored != "" {
                preserve[0] = true
                return "installation and rollback failed; previous app preserved at " + backup
            }
        }
        return installed
    }
    return ""
}

function usage() {
    host.standardError("usage: macos-app [-h] --binary BINARY --output OUTPUT --identifier IDENTIFIER [--icon ICON] [--resources RESOURCES] [--sign IDENTITY]\n")
}
function usageError(message: Text): Integer {
    usage()
    host.standardError("macos-app: error: " + message + "\n")
    return 2
}
function main(): Integer {
    let names = ["--binary", "--output", "--identifier", "--icon", "--resources", "--sign"]
    let values = ["", "", "", "", "", "-"]
    let given = [false, false, false, false, false, false]
    let index = 0
    while index < processInfo.argumentCount() {
        let item = processInfo.argument(index)
        if item == "-h" || item == "--help" {
            print("usage: macos-app [-h] --binary BINARY --output OUTPUT --identifier IDENTIFIER [--icon ICON] [--resources RESOURCES] [--sign IDENTITY]\n\nPackage an already linked executable as a signed macOS application. The default identity - signs locally.")
            return 0
        }
        let option = item
        let value = ""
        let inline = false
        let equals = host.find(item, "=", 0)
        if host.starts(item, "--") && equals > 0 {
            option = host.cut(item, 0, equals)
            value = host.cut(item, equals + 1, host.size(item))
            inline = true
        }
        let slot = -1
        for position in 0..names.length { if names[position] == option { slot = position } }
        if slot < 0 { return usageError("unrecognized arguments: " + item) }
        if !inline {
            if index + 1 >= processInfo.argumentCount() || (host.starts(processInfo.argument(index + 1), "-") && processInfo.argument(index + 1) != "-") { return usageError("argument " + option + ": expected one argument") }
            value = processInfo.argument(index + 1)
            index += 1
        }
        values[slot] = value
        given[slot] = true
        index += 1
    }
    let missing: List<Text> = []
    for position in 0..3 { if !given[position] { missing.add(names[position]) } }
    if missing.length > 0 {
        let joined = ""
        for position in 0..missing.length {
            if position > 0 { joined += ", " }
            joined += missing[position]
        }
        return usageError("the following arguments are required: " + joined)
    }
    let error = packageSigned(values[0], values[1], values[2], values[3], values[4], values[5])
    if error != "" {
        host.standardError("macOS app packaging failed: " + error + "\n")
        return 1
    }
    return 0
}
