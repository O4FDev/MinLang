use "../tools/testing.min" as test
use "system" as system
use "files" as files
let write = false
if argumentCount() > 0 {
    test.check(argumentCount() == 1 && argument(0) == "--write", "expected optional --write")
    write = true
}
let work = test.scratch()
let candidates = [system.getenv("CLANG_FORMAT"), "clang-format-23", "clang-format", "build/format-tools-23/bin/clang-format", "build/format-tools-23/Scripts/clang-format.exe", "/opt/homebrew/opt/llvm@23/bin/clang-format", "/opt/homebrew/opt/llvm/bin/clang-format"]
let selected = ""
for candidate in candidates {
    if candidate == "" { continue }
    let resolved = test.run(["/bin/sh", "-c", "command -v \"$1\"", "minyar", candidate], system.environment(), "", work + "/resolve", 10)
    if resolved.status != 0 { continue }
    let path = test.lines(resolved.output)[0]
    let result = test.run([path, "--version"], system.environment(), "", work + "/version", 10)
    if result.status == 0 && test.contains(result.output, "version 23.1.2") { selected = path; break }
}
test.check(selected != "", "ClangFormat 23.1.2 is required; set CLANG_FORMAT to its executable")
let command = [selected]
if write { command.add("-i") }
else { command.add("--dry-run"); command.add("--Werror") }
for file in [
    "bootstrap/stage0.c",
    "tools/module-build.c",
    "runtime/minyar_bytes.h",
    "runtime/minyar_collections.h",
    "runtime/minyar_numbers.h",
    "runtime/native/net.c",
    "runtime/native/net_datagrams.h",
    "runtime/native/net_loop.h",
    "runtime/native/net_udp_offload.h",
    "runtime/native/app_net_loop.h",
    "runtime/native/workers.c",
    "runtime/native/workers_windows.h",
    "runtime/native/tlsverify.c",
    "tests/tls-windows-signing.c",
    "runtime/native/aes.c",
    "runtime/native/quicinteropio.c",
    "runtime/native/securecrypto.c",
    "runtime/native/update.c",
    "runtime/native/update_monocypher.c",
    "runtime/native/update_ed25519.c",
    "tests/update-native.c",
    "tests/update-sign.c",
    "runtime/native/apple_identity.h",
    "runtime/native/keychain.c",
    "tests/keychain-native.c",
    "runtime/native/windows_identity.h",
    "runtime/native/wincert.c",
    "runtime/native/windows.c",
    "tests/windows-certificate.c",
    "tests/windows-desktop.c",
    "tests/windows-native.c",
    "runtime/native/net_app_windows.h",
    "tests/windows-loop.c",
    "runtime/native/schannel.c",
    "tests/schannel-native.c",
    "tests/schannel-identity.c",
    "runtime/native/desktop.c",
    "runtime/native/winnotify.c",
    "tests/windows-notifications.c",
    "tests/net-soak.c",
    "tests/net-native.c",
    "tests/net-batch.c",
    "tests/net-loop.c",
    "tests/net-udp-offload.c",
    "tests/runtime-bytes.c",
    "tests/runtime-traps.c",
    "tests/cycle-late-registration.c",
    "tests/cycle-registration-exposure.c",
    "tests/cycle-idle-invalidation.c",
    "tests/llvm_symbols.h",
    "tests/stack-limits.c",
    "experiments/memory/checked-scalars-driver.c",
    "experiments/memory/checked-scalars-cpp.cpp"
] { command.add(file) }
if fileExists("compiler/stages/c-layout.min") {
    for file in ["runtime/minyar_c_layout.h", "tests/c-layout-records.c", "tests/c-layout-storage.c"] {
        test.check(fileExists(file), "missing maintained C layout format source: " + file)
        command.add(file)
    }
}
let result = test.run(command, system.environment(), "", work + "/format", 180)
files.writeStandardOutput(result.output)
system.writeStandardError(result.errorOutput)
test.removeTree(work)
exit(result.status)
