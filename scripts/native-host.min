use "random" as secureRandom
use "system" as system
use "files" as files

public record Outcome { status: Integer; output: Text }

public function starts(source: Text, prefix: Text): Boolean {
    let raw = Bytes(source)
    let pattern = Bytes(prefix)
    if raw.length < pattern.length { return false }
    for index in 0..pattern.length { if raw[index] != pattern[index] { return false } }
    return true
}
public function ends(source: Text, suffix: Text): Boolean {
    let raw = Bytes(source)
    let pattern = Bytes(suffix)
    if raw.length < pattern.length { return false }
    for index in 0..pattern.length { if raw[raw.length - pattern.length + index] != pattern[index] { return false } }
    return true
}
public function find(source: Text, needle: Text, from: Integer): Integer {
    let raw = Bytes(source)
    let pattern = Bytes(needle)
    let start = from
    while start + pattern.length <= raw.length {
        let equal = true
        for index in 0..pattern.length {
            if raw[start + index] != pattern[index] { equal = false; break }
        }
        if equal { return start }
        start += 1
    }
    return -1
}
public function contains(source: Text, needle: Text): Boolean { return find(source, needle, 0) >= 0 }
public function lastByte(source: Text, byte: Integer): Integer {
    let raw = Bytes(source)
    let index = raw.length - 1
    while index >= 0 {
        if raw[index] == byte { return index }
        index -= 1
    }
    return -1
}
public function cut(source: Text, start: Integer, end: Integer): Text { return Text(Bytes(source).slice(start, end)) }
public function size(source: Text): Integer { return Bytes(source).length }
public function has(values: List<Text>, wanted: Text): Boolean {
    for value in values { if value == wanted { return true } }
    return false
}
public function split(source: Text, separator: Integer): List<Text> {
    let result: List<Text> = []
    let raw = Bytes(source)
    let start = 0
    for index in 0..raw.length {
        if raw[index] == separator { result.add(Text(raw.slice(start, index))); start = index + 1 }
    }
    result.add(Text(raw.slice(start, raw.length)))
    return result
}
public function lines(source: Text): List<Text> {
    let result: List<Text> = []
    let raw = Bytes(source)
    let start = 0
    for index in 0..raw.length {
        if raw[index] == 10 { result.add(Text(raw.slice(start, index))); start = index + 1 }
    }
    if start < raw.length { result.add(Text(raw.slice(start, raw.length))) }
    return result
}
public function strip(source: Text): Text {
    let raw = Bytes(source)
    let start = 0
    let end = raw.length
    while start < end && raw[start] <= 32 { start += 1 }
    while end > start && raw[end - 1] <= 32 { end -= 1 }
    return Text(raw.slice(start, end))
}
public function words(source: Text): List<Text> {
    let result: List<Text> = []
    let raw = Bytes(source)
    let start = 0
    for index in 0..(raw.length + 1) {
        let space = index == raw.length
        if index < raw.length { space = raw[index] <= 32 }
        if space {
            if start < index { result.add(Text(raw.slice(start, index))) }
            start = index + 1
        }
    }
    return result
}
public function number(source: Text): Integer {
    let value = 0
    for byte in Bytes(source) {
        if byte < 48 || byte > 57 || value > (9223372036854775807 - (byte - 48)) / 10 { return -1 }
        value = value * 10 + byte - 48
    }
    return value
}
public function decimalDigits(source: Text): Boolean {
    let raw = Bytes(source)
    if raw.length == 0 { return false }
    for byte in raw { if byte < 48 || byte > 57 { return false } }
    return true
}

public function clean(path: Text): Text {
    let rooted = starts(path, "/")
    let parts: List<Text> = []
    for part in split(path, 47) {
        if part != "" && part != "." { parts.add(part) }
    }
    let result = ""
    for index in 0..parts.length {
        if index > 0 { result += "/" }
        result += parts[index]
    }
    if rooted { return "/" + result }
    if result == "" { return "." }
    return result
}
public function normalize(path: Text): Text {
    let rooted = starts(path, "/")
    let parts: List<Text> = []
    for part in split(path, 47) {
        if part == "" || part == "." { continue }
        if part == ".." {
            if parts.length > 0 && parts[parts.length - 1] != ".." { parts.truncate(parts.length - 1); continue }
            if rooted { continue }
        }
        parts.add(part)
    }
    let result = ""
    for index in 0..parts.length {
        if index > 0 { result += "/" }
        result += parts[index]
    }
    if rooted { return "/" + result }
    if result == "" { return "." }
    return result
}
public function basename(path: Text): Text {
    let cleaned = clean(path)
    if cleaned == "/" || cleaned == "." { return "" }
    return cut(cleaned, lastByte(cleaned, 47) + 1, size(cleaned))
}
public function parent(path: Text): Text {
    let cleaned = clean(path)
    let slash = lastByte(cleaned, 47)
    if slash < 0 { return "." }
    if slash == 0 { return "/" }
    return cut(cleaned, 0, slash)
}
public function child(directory: Text, name: Text): Text {
    if ends(directory, "/") { return directory + name }
    return directory + "/" + name
}
public function withName(path: Text, name: Text): Text {
    let cleaned = clean(path)
    let slash = lastByte(cleaned, 47)
    if slash < 0 { return name }
    return cut(cleaned, 0, slash + 1) + name
}
public function suffix(name: Text): Text {
    let dot = lastByte(name, 46)
    if dot > 0 && dot < size(name) - 1 { return cut(name, dot, size(name)) }
    return ""
}
public function stem(name: Text): Text {
    let dot = lastByte(name, 46)
    if dot > 0 && dot < size(name) - 1 { return cut(name, 0, dot) }
    return name
}
public function comparePaths(left: Text, right: Text): Integer {
    let a = split(clean(left), 47)
    let b = split(clean(right), 47)
    let count = min(a.length, b.length)
    for index in 0..count {
        let order = compareText(a[index], b[index])
        if order != 0 { return order }
    }
    if a.length < b.length { return -1 }
    if a.length > b.length { return 1 }
    return 0
}
public function compareText(left: Text, right: Text): Integer {
    let a = Bytes(left)
    let b = Bytes(right)
    let count = min(a.length, b.length)
    for index in 0..count {
        if a[index] < b[index] { return -1 }
        if a[index] > b[index] { return 1 }
    }
    if a.length < b.length { return -1 }
    if a.length > b.length { return 1 }
    return 0
}

public function jsonString(source: Text): Text {
    let raw = Bytes(source)
    let result = Bytes()
    let digits = Bytes("0123456789abcdef")
    result.add(34)
    for byte in raw {
        if byte == 34 { result.addBytes(Bytes("\\\"")) }
        else if byte == 92 { result.addBytes(Bytes("\\\\")) }
        else if byte == 10 { result.addBytes(Bytes("\\n")) }
        else if byte == 13 { result.addBytes(Bytes("\\r")) }
        else if byte == 9 { result.addBytes(Bytes("\\t")) }
        else if byte == 8 { result.addBytes(Bytes("\\b")) }
        else if byte == 12 { result.addBytes(Bytes("\\f")) }
        else if byte < 32 {
            result.addBytes(Bytes("\\u00"))
            result.add(digits[byte >> 4])
            result.add(digits[byte & 15])
        } else { result.add(byte) }
    }
    result.add(34)
    return Text(result)
}
public function quoteList(command: List<Text>): Text {
    let result = "["
    for index in 0..command.length {
        if index > 0 { result += ", " }
        result += "'" + command[index] + "'"
    }
    return result + "]"
}
public function commandFailure(command: List<Text>, status: Integer): Text {
    return "Command '" + quoteList(command) + "' returned non-zero exit status " + Text(status) + "."
}

public function shellWords(source: Text): List<Text> {
    let result: List<Text> = []
    let raw = Bytes(source)
    let word = Bytes()
    let active = false
    let index = 0
    while index < raw.length {
        let byte = raw[index]
        if byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 11 || byte == 12 {
            if active { result.add(Text(word)); word = Bytes(); active = false }
            index += 1
        } else if byte == 39 {
            active = true
            index += 1
            while index < raw.length && raw[index] != 39 { word.add(raw[index]); index += 1 }
            if index >= raw.length { fail("No closing quotation") }
            index += 1
        } else if byte == 34 {
            active = true
            index += 1
            while index < raw.length && raw[index] != 34 {
                if raw[index] == 92 && index + 1 < raw.length && (raw[index + 1] == 92 || raw[index + 1] == 34 || raw[index + 1] == 36 || raw[index + 1] == 96 || raw[index + 1] == 10) {
                    if raw[index + 1] != 10 { word.add(raw[index + 1]) }
                    index += 2
                } else { word.add(raw[index]); index += 1 }
            }
            if index >= raw.length { fail("No closing quotation") }
            index += 1
        } else if byte == 92 {
            active = true
            if index + 1 >= raw.length { fail("No escaped character") }
            if raw[index + 1] != 10 { word.add(raw[index + 1]) }
            index += 2
        } else {
            active = true
            word.add(byte)
            index += 1
        }
    }
    if active { result.add(Text(word)) }
    return result
}

function statusOf(status: system.ProcessStatus): Integer {
    if status.error != 0 { return -1 }
    if status.state == system.EXITED { return status.exitCode }
    if status.state == system.SIGNALED { return 128 + status.signal }
    return -1
}
public function spawnCommand(command: List<Text>, environment: List<Text>, cwd: Text): Integer {
    if contains(command[0], "/") { return system.spawn(command[0], command, environment, cwd) }
    let argv = ["env", "--"]
    for item in command { argv.add(item) }
    return system.spawn("/usr/bin/env", argv, environment, cwd)
}
public function runIn(command: List<Text>, environment: List<Text>, cwd: Text): Integer {
    let handle = spawnCommand(command, environment, cwd)
    if handle <= 0 { return 127 }
    return statusOf(system.wait(handle))
}
public function run(command: List<Text>): Integer { return runIn(command, system.environment(), "") }
public function temporaryRoot(): Text {
    let directory = system.getenv("TMPDIR")
    if directory == "" { return "/tmp" }
    if ends(directory, "/") && size(directory) > 1 { return cut(directory, 0, size(directory) - 1) }
    return directory
}
public function hex(data: Bytes): Text {
    let digits = Bytes("0123456789abcdef")
    let result = Bytes()
    for byte in data { result.add(digits[byte >> 4]); result.add(digits[byte & 15]) }
    return Text(result)
}
function captureFile(): Text {
    while true {
        let path = temporaryRoot() + "/.minyar-capture-" + Text(system.processId()) + "-" + hex(secureRandom.bytes(8))
        let file = files.open(path, files.WRITE | files.CREATE | files.EXCLUSIVE)
        if file >= 0 {
            files.close(file)
            return path
        }
        if file != -17 { fail("cannot create a capture file in " + temporaryRoot() + ": " + files.errorText(file)) }
    }
}
public function captureIn(command: List<Text>, environment: List<Text>, cwd: Text, stream: Text): Outcome {
    let path = captureFile()
    let script = "out=$1; shift; exec \"$@\" >\"$out\""
    if stream == "stderr" { script = "out=$1; shift; exec \"$@\" >/dev/null 2>\"$out\"" }
    if stream == "both" { script = "out=$1; shift; exec \"$@\" >\"$out\" 2>&1" }
    if stream == "quiet" { script = "out=$1; shift; exec \"$@\" >\"$out\" 2>/dev/null" }
    let argv = ["sh", "-c", script, "sh", path]
    for item in command { argv.add(item) }
    let handle = system.spawn("/bin/sh", argv, environment, cwd)
    let status = 127
    if handle > 0 { status = statusOf(system.wait(handle)) }
    let output = Text(files.readFile(path))
    files.remove(path)
    return Outcome { status: status; output: output }
}
public function capture(command: List<Text>): Outcome { return captureIn(command, system.environment(), "", "stdout") }

public function probe(flag: Text, path: Text): Boolean {
    return run(["/bin/sh", "-c", "test " + flag + " \"$1\"", "sh", path]) == 0
}
public function exists(path: Text): Boolean { return probe("-e", path) }
public function isDirectory(path: Text): Boolean { return probe("-d", path) }
public function isFile(path: Text): Boolean { return probe("-f", path) }
public function isSymlink(path: Text): Boolean { return probe("-L", path) }
public function currentDirectory(): Text {
    let result = capture(["/bin/sh", "-c", "pwd -P"])
    if result.status != 0 { fail("cannot read the current directory") }
    return strip(result.output)
}
public function absolute(path: Text): Text {
    if starts(path, "/") { return clean(path) }
    return clean(currentDirectory() + "/" + path)
}
public function resolve(path: Text, strict: Boolean): Outcome {
    let mode = "loose"
    if strict { mode = "strict" }
    let script = "p=$1; if [ \"$2\" = strict ]; then exec realpath -- \"$p\"; fi; rest=; while [ ! -e \"$p\" ] && [ ! -L \"$p\" ]; do case \"$p\" in */*) ;; *) p=./$p ;; esac; rest=/${p##*/}$rest; p=${p%/*}; [ -n \"$p\" ] || p=/; done; r=$(realpath -- \"$p\") || exit 1; r=${r%/}$rest; printf '%s\\n' \"${r:-/}\""
    let result = captureIn(["/bin/sh", "-c", script, "sh", path, mode], system.environment(), "", "quiet")
    if result.status != 0 { return Outcome { status: result.status; output: "No such file or directory: '" + path + "'" } }
    return Outcome { status: 0; output: strip(result.output) }
}
public function resolved(path: Text): Text {
    let result = resolve(path, false)
    if result.status != 0 { return absolute(path) }
    return result.output
}
public function makeDirectories(path: Text): Text {
    if run(["mkdir", "-p", "--", path]) != 0 { return "cannot create directory: '" + path + "'" }
    return ""
}
public function removeTree(path: Text): Text {
    if run(["rm", "-rf", "--", path]) != 0 { return "cannot remove: '" + path + "'" }
    return ""
}
public function temporaryDirectory(directory: Text, prefix: Text): Outcome {
    let result = capture(["mktemp", "-d", child(directory, prefix + "XXXXXXXX")])
    if result.status != 0 { return Outcome { status: result.status; output: "cannot create a temporary directory in '" + directory + "'" } }
    return Outcome { status: 0; output: strip(result.output) }
}
public function temporaryFile(directory: Text, prefix: Text): Outcome {
    let result = capture(["mktemp", child(directory, prefix + "XXXXXXXX")])
    if result.status != 0 { return Outcome { status: result.status; output: "cannot create a temporary file in '" + directory + "'" } }
    return Outcome { status: 0; output: strip(result.output) }
}
public function copyFile(from: Text, to: Text): Text {
    let data = files.readFile(from)
    let code = files.lastError()
    if code != 0 { return "[Errno " + Text(-code) + "] " + files.errorText(code) + ": '" + from + "'" }
    let file = files.open(to, files.WRITE | files.CREATE | files.TRUNCATE)
    if file < 0 { return "[Errno " + Text(-file) + "] " + files.errorText(file) + ": '" + to + "'" }
    let written = files.write(file, data, 0, data.length)
    let closed = files.close(file)
    if written < 0 { return "[Errno " + Text(-written) + "] " + files.errorText(written) + ": '" + to + "'" }
    if closed < 0 { return "[Errno " + Text(-closed) + "] " + files.errorText(closed) + ": '" + to + "'" }
    return ""
}
public function copyTree(from: Text, to: Text): Text {
    if run(["cp", "-RL", "--", from, to]) != 0 { return "cannot copy '" + from + "' to '" + to + "'" }
    return ""
}
public function mergeTree(from: Text, to: Text): Text {
    if run(["cp", "-RL", "--", child(from, "."), to]) != 0 { return "cannot copy '" + from + "' into '" + to + "'" }
    return ""
}
public function makeExecutable(path: Text): Text {
    if run(["chmod", "755", path]) != 0 { return "cannot make '" + path + "' executable" }
    return ""
}
public function writeFile(path: Text, contents: Text): Text {
    let data = Bytes(contents)
    let file = files.open(path, files.WRITE | files.CREATE | files.TRUNCATE)
    if file < 0 { return "[Errno " + Text(-file) + "] " + files.errorText(file) + ": '" + path + "'" }
    let written = files.write(file, data, 0, data.length)
    let closed = files.close(file)
    if written < 0 || closed < 0 { return "cannot write '" + path + "'" }
    return ""
}
public function createExclusive(path: Text): Integer {
    let file = files.open(path, files.WRITE | files.CREATE | files.EXCLUSIVE)
    if file < 0 { return file }
    files.close(file)
    return 0
}
public function removeFile(path: Text): Integer { return files.remove(path) }
public function errorText(code: Integer): Text { return "[Errno " + Text(-code) + "] " + files.errorText(code) }

public record RenameFault { source: Text; destination: Text; message: Text }
public function rename(from: Text, to: Text, faults: List<RenameFault>): Text {
    for fault in faults {
        if (fault.source == "" || basename(from) == fault.source) && (fault.destination == "" || to == fault.destination) { return fault.message }
    }
    let code = files.rename(from, to)
    if code != 0 { return errorText(code) + ": '" + from + "' -> '" + to + "'" }
    return ""
}

public function systemName(): Text {
    let result = capture(["uname", "-s"])
    if result.status != 0 { fail("cannot identify the operating system") }
    let name = strip(result.output)
    if name == "Darwin" { return "darwin" }
    if name == "Linux" { return "linux" }
    return name
}
public function machine(): Text {
    let result = capture(["uname", "-m"])
    if result.status != 0 { fail("cannot identify the machine architecture") }
    return strip(result.output)
}
public function projectRoot(): Text {
    let configured = system.getenv("MINYAR_PROJECT_DIR")
    if configured != "" { return absolute(configured) }
    return currentDirectory()
}
public function standardError(text: Text) { system.writeStandardError(text) }
