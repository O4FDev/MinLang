// Event-driven project builds. Preserve mode publishes to an existing hot
// runtime; ordinary mode replaces the process only after a successful build.
function vector(items: List<Text>): Bytes {
    let encoded = Bytes(8)
    encoded.setInt64(0, items.length)
    for item in items {
        let bytes = Bytes(item)
        encoded.addInt64(bytes.length)
        encoded.addBytes(bytes)
    }
    return encoded
}

// roots are project/dependency directories. The root project is always watched.
// Build options include the command; arguments exclude the executable name.
// Both commands inherit the environment and run in root, without a shell.
public function run(launcher: Text, root: Text, roots: List<Text>, arguments: List<Text>, buildOptions: List<Text>, output: Text, preserve: Boolean): Integer {
    return supervise(launcher, root, vector(roots), vector(arguments), vector(buildOptions), output, preserve)
}

function supervise(launcher: Text, root: Text, roots: Bytes, arguments: Bytes, buildOptions: Bytes, output: Text, preserve: Boolean): Integer { native "livewatch" }
