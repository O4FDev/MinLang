// Project manifests and reproducible source dependency resolution.
use "./driver-support.min" as host
use "./package-git.min" as git
use "./registry.min" as registry
use "files" as files
use "system" as system

public record Manifest { root: Text; name: Text; version: Text; kind: Text; dependencies: List<Text>; paths: List<Text>; repositories: List<Text>; revisions: List<Text>; source: Text; revision: Text; commit: Text; checksum: Text }
public record Graph { packages: List<Manifest>; active: List<Text> }
record Pin { name: Text; repository: Text; revision: Text; commit: Text; checksum: Text }
record Selection { name: Text; repository: Text; revision: Text }
record Resolution { pins: List<Pin>; selections: List<Selection>; changed: Boolean; locked: Boolean; offline: Boolean; index: registry.Index; indexLoaded: Boolean }

public function manifest(root: Text, name: Text, version: Text, kind: Text): Manifest {
    return Manifest { root: root; name: name; version: version; kind: kind; dependencies: []; paths: []; repositories: []; revisions: []; source: ""; revision: ""; commit: ""; checksum: "" }
}

public function validName(name: Text): Boolean {
    let raw = Bytes(name)
    if raw.length == 0 || raw.length > 64 { return false }
    for index in 0..raw.length {
        let byte = raw[index]
        let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
        if !letter && !(index > 0 && (host.isDigit(byte) || byte == 45)) { return false }
    }
    return true
}
function versionValid(version: Text): Boolean {
    let parts = version.split(".")
    if parts.length != 3 { return false }
    for part in parts {
        if part == "" { return false }
        for byte in Bytes(part) { if !host.isDigit(byte) { return false } }
    }
    return true
}
function withoutComment(line: Text): Text {
    let quoted = false
    let escaped = false
    let raw = Bytes(line)
    for index in 0..raw.length {
        let byte = raw[index]
        if escaped { escaped = false }
        else if quoted && byte == 92 { escaped = true }
        else if byte == 34 { quoted = !quoted }
        else if !quoted && byte == 35 { return host.textSlice(line, 0, index) }
    }
    return line
}
function unquote(value: Text, location: Text): Text {
    let raw = Bytes(value)
    if raw.length < 2 || raw[0] != 34 || raw[raw.length - 1] != 34 { host.stop(location + ": expected a double-quoted string") }
    let result = Bytes()
    let index = 1
    while index < raw.length - 1 {
        let byte = raw[index]
        if byte == 92 {
            index += 1
            if index >= raw.length - 1 { host.stop(location + ": unfinished escape") }
            byte = raw[index]
            if byte != 34 && byte != 92 { host.stop(location + ": only escaped quotes and backslashes are supported") }
        } else if byte == 34 || byte < 32 { host.stop(location + ": invalid string") }
        result.add(byte)
        index += 1
    }
    return Text(result)
}
function fields(entry: Text): List<Text> {
    let result: List<Text> = []
    let quoted = false
    let escaped = false
    let start = 0
    let raw = Bytes(entry)
    for index in 0..raw.length {
        if escaped { escaped = false }
        else if quoted && raw[index] == 92 { escaped = true }
        else if raw[index] == 34 { quoted = !quoted }
        else if !quoted && raw[index] == 44 { result.add(host.strip(Text(raw.slice(start, index)))); start = index + 1 }
    }
    result.add(host.strip(Text(raw.slice(start, raw.length))))
    return result
}
public function read(root: Text): Manifest {
    let result = manifest(root, "", "", "")
    let manifest = root + "/Minyar.toml"
    let section = ""
    let sections: List<Text> = []
    let keys: List<Text> = []
    let number = 0
    for original in host.lines(host.readText(manifest)) {
        number += 1
        let location = manifest + ":" + Text(number)
        let line = host.strip(withoutComment(original))
        if line == "" { continue }
        if line.startsWith("[") {
            if line != "[package]" && line != "[dependencies]" { host.stop(location + ": unknown section " + line) }
            if host.listed(sections, line) { host.stop(location + ": duplicate section " + line) }
            sections.add(line)
            section = line
            continue
        }
        let equal = host.findText(line, "=", 0)
        if equal < 1 { host.stop(location + ": expected key = value") }
        let key = host.strip(host.textSlice(line, 0, equal))
        let value = host.strip(host.textAfter(line, host.textSlice(line, 0, equal + 1)))
        if host.listed(keys, section + key) { host.stop(location + ": duplicate key " + key) }
        keys.add(section + key)
        if section == "[package]" {
            let parsed = unquote(value, location)
            if key == "name" { result.name = parsed }
            else if key == "version" { result.version = parsed }
            else if key == "kind" {
                if parsed != "bin" && parsed != "lib" { host.stop(location + ": package.kind must be bin or lib") }
                result.kind = parsed
            }
            else { host.stop(location + ": unknown package key " + key) }
        } else if section == "[dependencies]" {
            if !validName(key) { host.stop(location + ": invalid dependency name " + key) }
            if !value.startsWith("{") || !value.endsWith("}") { host.stop(location + ": dependencies use { path = \"../package\" } or { git = \"host/owner/package\", rev = \"v1.0.0\" }") }
            let entry = host.strip(host.textSlice(value, 1, value.byteLength - 1))
            let path = ""
            let repository = ""
            let revision = ""
            let seen: List<Text> = []
            for field in fields(entry) {
                let separator = host.findText(field, "=", 0)
                if separator < 0 { host.stop(location + ": expected dependency key = value") }
                let fieldName = host.strip(host.textSlice(field, 0, separator))
                if host.listed(seen, fieldName) { host.stop(location + ": duplicate dependency key " + fieldName) }
                seen.add(fieldName)
                let parsed = unquote(host.strip(host.textSlice(field, separator + 1, field.byteLength)), location)
                if parsed == "" { host.stop(location + ": dependency " + fieldName + " is empty") }
                if fieldName == "path" { path = parsed }
                else if fieldName == "git" { repository = git.repository(parsed) }
                else if fieldName == "rev" { revision = parsed }
                else { host.stop(location + ": unknown dependency key " + fieldName) }
            }
            if (path == "" && repository == "") || (path != "" && (repository != "" || revision != "")) { host.stop(location + ": choose a local path or a Git source with rev") }
            if repository != "" && !git.validRevision(revision) { host.stop(location + ": Git dependencies need rev = \"v1.0.0\", a branch or a commit") }
            result.dependencies.add(key)
            result.paths.add(path)
            result.repositories.add(repository)
            result.revisions.add(revision)
        } else { host.stop(location + ": keys must be inside [package] or [dependencies]") }
    }
    if !validName(result.name) { host.stop(manifest + ": package.name must start with a letter or underscore and contain letters, digits, '-' or '_'") }
    if !versionValid(result.version) { host.stop(manifest + ": package.version must have three numeric components") }
    return result
}
public function find(start: Text): Text {
    let directory = host.resolveName(start)
    while true {
        if host.isFile(directory + "/Minyar.toml") { return directory }
        let parent = host.parentPath(directory)
        if parent == directory { host.stop("no Minyar.toml found in this directory or its parents; use minyar init") }
        directory = parent
    }
    return directory
}
public function at(path: Text): Text {
    let resolved = host.resolveName(path)
    if host.isDirectory(resolved) { resolved += "/Minyar.toml" }
    if host.baseName(resolved) != "Minyar.toml" || !host.isFile(resolved) { host.stop("manifest not found: " + path) }
    return host.parentPath(resolved)
}
public function library(manifest: Manifest): Text { return manifest.root + "/src/" + manifest.name + ".min" }
public function isBinary(manifest: Manifest): Boolean {
    if manifest.kind != "" { return manifest.kind == "bin" }
    return host.isFile(manifest.root + "/src/main.min")
}
public function hasLibrary(manifest: Manifest): Boolean {
    return !(manifest.name == "main" && isBinary(manifest)) && host.isFile(library(manifest))
}
public function entry(manifest: Manifest): Text {
    let source = library(manifest)
    if isBinary(manifest) { source = manifest.root + "/src/main.min" }
    if host.isFile(source) { return source }
    host.stop("package " + manifest.name + " needs " + source)
    return ""
}
function emptyPin(): Pin { return Pin { name: ""; repository: ""; revision: ""; commit: ""; checksum: "" } }
function readPins(root: Text, refresh: Text): List<Pin> {
    let result: List<Pin> = []
    let path = root + "/Minyar.lock"
    if !host.isFile(path) { return result }
    let pin = emptyPin()
    let keys: List<Text> = []
    let header = false
    for original in host.lines(host.readText(path)) {
        let line = host.strip(withoutComment(original))
        if line == "" { continue }
        if !header {
            if line != "version = 1" && line != "version = 2" { host.stop("unsupported Minyar.lock format; regenerate it with minyar build") }
            header = true
            continue
        }
        if line == "[[package]]" {
            if pin.repository != "" && pin.name != refresh { result.add(pin) }
            pin = emptyPin(); keys = []
            continue
        }
        let separator = host.findText(line, "=", 0)
        if separator < 0 { host.stop("invalid Minyar.lock entry") }
        let key = host.strip(host.textSlice(line, 0, separator))
        if host.listed(keys, key) { host.stop("duplicate Minyar.lock key: " + key) }
        keys.add(key)
        let value = unquote(host.strip(host.textSlice(line, separator + 1, line.byteLength)), path)
        if key == "name" { pin.name = value }
        else if key == "source" { pin.repository = git.repository(value) }
        else if key == "rev" { pin.revision = value }
        else if key == "commit" { pin.commit = value }
        else if key == "checksum" { pin.checksum = value }
        else if key != "version" && key != "path" && key != "manifest" { host.stop("unknown Minyar.lock key: " + key) }
    }
    if pin.repository != "" && pin.name != refresh { result.add(pin) }
    for item in result {
        if !validName(item.name) || !git.validRevision(item.revision) || !git.hexadecimal(item.commit, 40) || !git.hexadecimal(item.checksum, 64) { host.stop("incomplete Git package pin in Minyar.lock") }
    }
    return result
}
public function hasGitLock(root: Text): Boolean { return readPins(root, "").length > 0 }
function remote(name: Text, repository: Text, revision: Text, resolution: Resolution): Manifest {
    let chosen = revision
    // A compatible lock is the starting build list. New requirements may only
    // increase it; ordinary builds never float a branch or a release tag.
    for pin in resolution.pins {
        if pin.name == name && pin.repository == repository && git.compatible(pin.revision, chosen) {
            if pin.revision == chosen || (git.semver(chosen) && git.compare(pin.revision, chosen) >= 0) { chosen = pin.revision }
        }
    }
    let selected = false
    for item in resolution.selections {
        if item.name != name { continue }
        selected = true
        if item.repository != repository { host.stop("dependency name conflict: " + name + " is requested from both " + item.repository + " and " + repository) }
        if !git.compatible(item.revision, chosen) { host.stop("dependency version conflict: " + name + " needs both " + item.revision + " and " + chosen + "; use one major version or one branch throughout the graph") }
        if git.semver(chosen) && git.compare(chosen, item.revision) > 0 { item.revision = chosen; resolution.changed = true }
        chosen = item.revision
    }
    if !selected { resolution.selections.add(Selection { name: name; repository: repository; revision: chosen }) }
    let commit = ""
    let checksum = ""
    for pin in resolution.pins {
        if pin.name == name && pin.repository == repository && pin.revision == chosen { commit = pin.commit; checksum = pin.checksum }
    }
    if resolution.locked && commit == "" { host.stop("Minyar.lock is missing or out of date; run minyar build without --locked") }
    if !resolution.indexLoaded { resolution.index = registry.optional(resolution.offline); resolution.indexLoaded = true }
    let source = git.fetch(repository, chosen, commit, checksum, resolution.offline)
    registry.verify(resolution.index, source)
    let package = read(source.root)
    package.source = repository; package.revision = source.revision; package.commit = source.commit; package.checksum = source.checksum
    if git.semver(source.revision) {
        if !git.semver(package.version) || git.compare(source.revision, package.version) != 0 { host.stop("Git tag " + source.revision + " disagrees with package.version = " + package.version + " in " + repository) }
    }
    return package
}
function visit(graph: Graph, package: Manifest, resolution: Resolution) {
    let root = package.root
    if host.listed(graph.active, root) { host.stop("dependency cycle: " + host.joined(graph.active, " -> ") + " -> " + root) }
    for package in graph.packages { if package.root == root { return } }
    for previous in graph.packages {
        if previous.name == package.name {
            if previous.source != "" && previous.source == package.source { return }
            host.stop("dependency name conflict: " + package.name + " resolves to both " + previous.root + " and " + root)
        }
    }
    graph.packages.add(package)
    graph.active.add(root)
    let order = package.dependencies.sorted()
    for name in order {
        let index = 0
        while package.dependencies[index] != name { index += 1 }
        let path = package.paths[index]
        let dependency = manifest("", "", "", "")
        if package.repositories[index] != "" { dependency = remote(name, package.repositories[index], package.revisions[index], resolution) }
        else {
            if package.source != "" { host.stop("Git package " + package.name + " contains a local path dependency; publish every dependency as a Git source") }
            if !path.startsWith("/") { path = root + "/" + path }
            dependency = read(host.resolveName(path))
        }
        if dependency.name != name { host.stop("dependency " + name + " has package.name = " + host.jsonText(dependency.name)) }
        if !hasLibrary(dependency) { host.stop("dependency " + name + " needs a library export at src/" + name + ".min") }
        visit(graph, dependency, resolution)
    }
    graph.active.pop()
}
function resolvePins(package: Manifest, locked: Boolean, offline: Boolean, pins: List<Pin>): Graph {
    if locked && !host.isFile(package.root + "/Minyar.lock") { host.stop("Minyar.lock is missing or out of date; run minyar build without --locked") }
    let resolution = Resolution { pins: pins; selections: []; changed: false; locked: locked; offline: offline; index: registry.Index { entries: []; origin: "" }; indexLoaded: false }
    for round in 0..128 {
        resolution.changed = false
        let graph = Graph { packages: []; active: [] }
        visit(graph, package, resolution)
        if !resolution.changed { return graph }
    }
    host.stop("dependency selection did not converge after 128 rounds; simplify the version requirements")
    return Graph { packages: []; active: [] }
}
function resolved(package: Manifest, locked: Boolean, offline: Boolean, refresh: Text): Graph {
    return resolvePins(package, locked, offline, readPins(package.root, refresh))
}
public function resolveFetched(package: Manifest, name: Text, source: git.Source, offline: Boolean): Graph {
    let pins = readPins(package.root, name)
    pins.add(Pin { name: name; repository: source.repository; revision: source.revision; commit: source.commit; checksum: source.checksum })
    return resolvePins(package, false, offline, pins)
}
public function resolvePackage(package: Manifest): Graph { return resolved(package, false, false, "") }
public function resolveModified(package: Manifest, name: Text, offline: Boolean): Graph { return resolved(package, false, offline, name) }
public function resolve(root: Text): Graph { return resolvePackage(read(root)) }
public function resolveWith(root: Text, locked: Boolean, offline: Boolean): Graph { return resolved(read(root), locked, offline, "") }
public function relative(root: Text, path: Text): Text {
    let from = root.split("/")
    let to = path.split("/")
    let common = 0
    while common < from.length && common < to.length && from[common] == to[common] { common += 1 }
    let parts: List<Text> = []
    for index in common..from.length { parts.add("..") }
    for index in common..to.length { parts.add(to[index]) }
    if parts.length == 0 { return "." }
    return host.joined(parts, "/")
}
public function atomicWrite(path: Text, content: Text) {
    let staging = host.temporaryDirectory(host.parentPath(path), ".minyar-project-")
    let temporary = staging + "/" + host.baseName(path)
    let file = files.open(temporary, files.WRITE + files.CREATE + files.EXCLUSIVE)
    if file < 0 { host.release(staging); host.stop(host.osError(file, path)) }
    let data = Bytes(content)
    let written = files.write(file, data, 0, data.length)
    let closed = files.close(file)
    if written != data.length || closed != 0 {
        files.remove(temporary)
        host.release(staging)
        host.stop("cannot write project file: " + path)
    }
    let status = files.rename(temporary, path)
    if status != 0 { files.remove(temporary); host.release(staging); host.stop(host.osError(status, path)) }
    host.release(staging)
}
public function lock(graph: Graph, locked: Boolean) {
    let root = graph.packages[0].root
    let content = "# Generated by minyar. Local sources remain editable.\nversion = 1\n"
    for package in graph.packages { if package.source != "" { content = "# Generated by minyar. Git sources are verified with SHA-256.\nversion = 2\n"; break } }
    for package in graph.packages {
        content += "\n[[package]]\nname = " + host.jsonText(package.name) + "\nversion = " + host.jsonText(package.version) + "\n"
        if package.source == "" { content += "path = " + host.jsonText(relative(root, package.root)) + "\n" }
        else { content += "source = " + host.jsonText(package.source) + "\nrev = " + host.jsonText(package.revision) + "\ncommit = " + host.jsonText(package.commit) + "\nchecksum = " + host.jsonText(package.checksum) + "\n" }
        content += "manifest = " + host.jsonText(host.hashFile(package.root + "/Minyar.toml")) + "\n"
    }
    let path = root + "/Minyar.lock"
    if host.isFile(path) && host.readText(path) == content { return }
    if locked { host.stop("Minyar.lock is missing or out of date; run minyar build without --locked") }
    atomicWrite(path, content)
}
public function render(package: Manifest): Text {
    let result = "[package]\nname = " + host.jsonText(package.name) + "\nversion = " + host.jsonText(package.version) + "\n"
    if package.kind != "" { result += "kind = " + host.jsonText(package.kind) + "\n" }
    result += "\n[dependencies]\n"
    for index in 0..package.dependencies.length {
        result += package.dependencies[index] + " = { "
        if package.repositories[index] == "" { result += "path = " + host.jsonText(package.paths[index]) }
        else { result += "git = " + host.jsonText(package.repositories[index]) + ", rev = " + host.jsonText(package.revisions[index]) }
        result += " }\n"
    }
    return result
}
