use "./lsp-workspace.min" as workspace
use "./lsp-protocol.min" as protocol
use "./editor-index.min" as index
use "./driver-support.min" as host
use "./format.min" as format
use "json" as json

record Target {
    document: Integer
    symbol: Integer
}
function absent(): Target {
    return Target {
        document: - 1
        symbol: - 1
    }
}
function target(document: Integer, symbol: Integer): Target {
    return Target {
        document: document
        symbol: symbol
    }
}
function tokenAt(document: workspace.Document, offset: Integer): Integer {
    let tokens = document.syntax.tokens
    for position in 0..tokens.length {
        let token = tokens[position]
        if token.kind == 1 && offset >= token.start && offset < token.end {
            return position
        }
    }
    for position in 0..tokens.length {
        if tokens[position].kind == 1 && tokens[position].end == offset {
            return position
        }
    }
    return - 1
}
function namespaceTarget(state: workspace.Workspace, document: Integer, name: Text): Target {
    let found = - 1
    for position in 0..state.documents[document].syntax.symbols.length {
        let symbol = state.documents[document].syntax.symbols[position]
        if symbol.name == name && symbol.container == "" && symbol.scopeStart == 0 {
            if found >= 0 {
                return absent()
            }
            found = position
        }
    }
    return target(document, found)
}
function typeTarget(state: workspace.Workspace, document: Integer, type: Text): Target {
    let name = type
    let angle = host.findText(name, "<", 0)
    if angle >= 0 {
        name = host.textSlice(name, 0, angle)
    }
    let parts = name.split(".")
    if parts.length == 2 {
        let imported = workspace.imported(state, state.documents[document], parts[0])
        if imported >= 0 {
            return namespaceTarget(state, imported, parts[1])
        }
    }
    return namespaceTarget(state, document, name)
}
function memberTarget(state: workspace.Workspace, document: Integer, receiver: Target, name: Text): Target {
    if receiver.symbol < 0 || receiver.document < 0 {
        return absent()
    }
    let symbol = state.documents[receiver.document].syntax.symbols[receiver.symbol]
    // Inferred factory names must resolve in the binding's lexical scope.
    // A callback parameter can shadow a global factory with another result
    // type; following the global return type would navigate or rename wrongly.
    if symbol.kind == 13 || symbol.kind == 14 {
        let components = symbol.type.split(".")
        if components.length > 0 {
            let lexical = index.find(state.documents[receiver.document].syntax, components[0], symbol.start, "")
            let global = index.find(state.documents[receiver.document].syntax, components[0], 0, "")
            if lexical >= 0 && lexical != global {
                let declaration = state.documents[receiver.document].syntax.symbols[lexical]
                if declaration.kind == 13 || declaration.kind == 14 {
                    return absent()
                }
            }
        }
    }
    let owner = concreteType(state, receiver.document, symbol.type, 0)
    if owner.symbol < 0 || state.documents[owner.document].syntax.symbols[owner.symbol].kind != 23 {
        return absent()
    }
    let container = state.documents[owner.document].syntax.symbols[owner.symbol].name
    let found = index.find(state.documents[owner.document].syntax, name, 0, container)
    if found < 0 {
        return absent()
    }
    if owner.document != document && !state.documents[owner.document].syntax.symbols[found].exported {
        return absent()
    }
    return target(owner.document, found)
}
function concreteType(state: workspace.Workspace, document: Integer, type: Text, depth: Integer): Target {
    if depth > 16 {
        return target(document, - 1)
    }
    let found = typeTarget(state, document, type)
    if found.symbol >= 0 {
        let symbol = state.documents[found.document].syntax.symbols[found.symbol]
        if symbol.kind == 12 || symbol.kind == 6 || symbol.kind == 26 {
            return concreteType(state, found.document, symbol.type, depth + 1)
        }
    }
    return found
}
public function displayedType(state: workspace.Workspace, document: Integer, type: Text): Text {
    let found = typeTarget(state, document, type)
    if found.symbol >= 0 {
        let symbol = state.documents[found.document].syntax.symbols[found.symbol]
        if symbol.kind == 12 || symbol.kind == 6 {
            let prefix = ""
            let components = type.split(".")
            if components.length == 2 && !host.listed(["Integer", "Float", "Boolean", "Text", "Character", "Bytes", "Nothing"], symbol.type) && !host.hasText(symbol.type, ".") {
                prefix = components[0] + "."
            }
            return prefix + symbol.type
        }
    }
    return type
}
function importedReceiver(state: workspace.Workspace, receiver: Target): Integer {
    if receiver.symbol < 0 || receiver.document < 0 {
        return - 1
    }
    let current = state.documents[receiver.document]
    let symbol = current.syntax.symbols[receiver.symbol]
    if symbol.kind != 2 {
        return - 1
    }
    return workspace.imported(state, current, symbol.name)
}
function literalField(state: workspace.Workspace, document: Integer, token: Integer, depth: Integer): Target {
    let tokens = state.documents[document].syntax.tokens
    let cursor = token - 1
    let nested = 0
    while cursor >= 0 {
        if tokens[cursor].text == "}" {
            nested += 1
        }
        if tokens[cursor].text == "{" {
            if nested == 0 {
                if cursor == 0 || tokens[cursor - 1].kind != 1 {
                    return absent()
                }
                let owner = resolve(state, document, cursor - 1, depth + 1)
                if owner.symbol < 0 {
                    return absent()
                }
                let declaration = state.documents[owner.document].syntax.symbols[owner.symbol]
                if declaration.kind != 23 && declaration.kind != 26 {
                    return absent()
                }
                return memberTarget(state, document, owner, tokens[token].text)
            }
            nested -= 1
        }
        cursor -= 1
    }
    return absent()
}
function resolve(state: workspace.Workspace, document: Integer, token: Integer, depth: Integer): Target {
    if token < 0 || depth > 32 {
        return absent()
    }
    let current = state.documents[document]
    let tokens = current.syntax.tokens
    let name = tokens[token].text
    for position in 0..current.syntax.symbols.length {
        let symbol = current.syntax.symbols[position]
        if symbol.start == tokens[token].start && symbol.name == name {
            return target(document, position)
        }
    }
    if token >= 2 && tokens[token - 1].text == "." {
        let receiver = resolve(state, document, token - 2, depth + 1)
        let imported = importedReceiver(state, receiver)
        if imported >= 0 {
            let found = index.find(state.documents[imported].syntax, name, 0, "")
            if found >= 0 && state.documents[imported].syntax.symbols[found].exported {
                return target(imported, found)
            }
            return absent()
        }
        return memberTarget(state, document, receiver, name)
    }
    if token + 1 < tokens.length && tokens[token + 1].text == ":" {
        return literalField(state, document, token, depth)
    }
    let found = index.find(current.syntax, name, tokens[token].start, "")
    if found < 0 && name == "self" {
        found = index.find(current.syntax, name, tokens[token].start, "@self")
    }
    if found >= 0 {
        return target(document, found)
    }
    return absent()
}
function selection(document: workspace.Document, symbol: index.Symbol): Text {
    return protocol.range(document.text, symbol.start, symbol.start + symbol.name.byteLength)
}
public function hover(state: workspace.Workspace, document: Integer, offset: Integer): Text {
    let token = tokenAt(state.documents[document], offset)
    let found = resolve(state, document, token, 0)
    if found.symbol < 0 {
        return "null"
    }
    let owner = state.documents[found.document]
    let symbol = owner.syntax.symbols[found.symbol]
    let detail = symbol.detail
    if symbol.kind == 13 || symbol.kind == 14 {
        detail = host.replaceText(detail, ": " + symbol.type, ": " + displayedType(state, found.document, symbol.type))
    }
    let text = "```minyar\n" + detail + "\n```"
    if symbol.documentation != "" {
        text += "\n\n" + symbol.documentation
    }
    return "{\"contents\":{\"kind\":\"markdown\",\"value\":" + json.quote(text) + "},\"range\":" + protocol.range(state.documents[document].text, state.documents[document].syntax.tokens[token].start, state.documents[document].syntax.tokens[token].end) + "}"
}
public function definition(state: workspace.Workspace, document: Integer, offset: Integer): Text {
    let current = state.documents[document]
    let token = tokenAt(current, offset)
    let found = resolve(state, document, token, 0)
    if found.symbol < 0 {
        return "null"
    }
    let imported = importedReceiver(state, found)
    if imported >= 0 {
        return "{\"uri\":" + json.quote(state.documents[imported].uri) + ",\"range\":" + protocol.range(state.documents[imported].text, 0, 0) + "}"
    }
    let owner = state.documents[found.document]
    return "{\"uri\":" + json.quote(owner.uri) + ",\"range\":" + selection(owner, owner.syntax.symbols[found.symbol]) + "}"
}
function completionKind(kind: Integer): Integer {
    if kind == 12 {
        return 3
    }
    if kind == 6 {
        return 2
    }
    if kind == 8 {
        return 5
    }
    if kind == 23 {
        return 22
    }
    if kind == 22 {
        return 20
    }
    if kind == 2 {
        return 9
    }
    if kind == 14 {
        return 21
    }
    return 6
}
function completionItem(symbol: index.Symbol): Text {
    return "{\"label\":" + json.quote(symbol.name) + ",\"kind\":\(completionKind(symbol.kind)),\"detail\":" + json.quote(symbol.detail) + ",\"documentation\":{\"kind\":\"markdown\",\"value\":" + json.quote(symbol.documentation) + "}}"
}
public function completion(state: workspace.Workspace, document: Integer, offset: Integer): Text {
    let current = state.documents[document]
    let tokens = current.syntax.tokens
    let dot = - 1
    for token in 0..tokens.length {
        if tokens[token].text == "." && tokens[token].end <= offset {
            if token + 1 == tokens.length || tokens[token + 1].start >= offset ||(tokens[token + 1].kind == 1 && tokens[token + 1].start <= offset && tokens[token + 1].end >= offset) {
                dot = token
            }
        }
    }
    let items: List<Text> = []
    let names: List<Text> = []
    let owner = document
    let container = ""
    let module = false
    if dot > 0 {
        let receiver = resolve(state, document, dot - 1, 0)
        owner = importedReceiver(state, receiver)
        module = owner >= 0
        if owner < 0 {
            if receiver.symbol < 0 {
                return "[]"
            }
            let symbol = state.documents[receiver.document].syntax.symbols[receiver.symbol]
            let type = concreteType(state, receiver.document, symbol.type, 0)
            owner = receiver.document
            container = displayedType(state, receiver.document, symbol.type)
            if type.symbol >= 0 {
                let declaration = state.documents[type.document].syntax.symbols[type.symbol]
                owner = type.document
                container = declaration.name
            }
        }
    }
    if owner < 0 {
        return "[]"
    }
    for symbol in state.documents[owner].syntax.symbols {
        if symbol.container == "@self" {
            continue
        }
        if dot >= 0 {
            if symbol.container != container {
                continue
            }
            if module && symbol.scopeStart != 0 {
                continue
            }
            if owner != document && !symbol.exported {
                continue
            }
        } else {
            if symbol.container != "" && symbol.kind != 22 {
                continue
            }
            if !index.visible(symbol, offset) {
                continue
            }
        }
        if host.listed(names, symbol.name) {
            continue
        }
        names.add(symbol.name)
        items.add(completionItem(symbol))
    }
    if dot < 0 {
        for name in ["let", "constant", "function", "record", "choice", "match", "if", "else", "for", "while", "return", "use", "public", "try", "Integer", "Float", "Boolean", "Text", "Character", "Nothing", "List", "Map", "Set", "Result", "Maybe", "print", "joinText"] {
            if !host.listed(names, name) {
                items.add("{\"label\":" + json.quote(name) + ",\"kind\":14}")
            }
        }
    } else if !module {
        let builtins: List<Text> = []
        if container == "Text" {
            builtins = ["length", "byteLength", "slice", "trim", "find", "split", "startsWith", "endsWith"]
        }
        else if container == "Bytes" {
            builtins = ["length", "add", "slice", "resize", "clear", "addBytes", "getInt64", "setInt64", "getFloat32", "setFloat32"]
        }
        else if container == "List" || container.startsWith("List<") {
            builtins = ["length", "add", "appended", "pop", "slice", "truncate", "clear", "sort", "sorted", "sortBy", "sortedBy"]
        }
        else if container.startsWith("Map<") {
            builtins = ["length", "has", "remove", "clear"]
        }
        else if container.startsWith("Set<") {
            builtins = ["length", "add", "contains", "remove", "clear"]
        }
        for name in builtins {
            if !host.listed(names, name) {
                items.add("{\"label\":" + json.quote(name) + ",\"kind\":2}")
            }
        }
    }
    return "[" + host.joined(items, ",") + "]"
}
record Occurrence {
    document: Integer
    token: Integer
}
function sameTarget(first: Target, second: Target): Boolean {
    return first.document == second.document && first.symbol == second.symbol
}
function localTarget(state: workspace.Workspace, found: Target): Boolean {
    let symbol = state.documents[found.document].syntax.symbols[found.symbol]
    return symbol.scopeStart > 0 || symbol.kind == 2
}
function occurrences(state: workspace.Workspace, documents: List<Integer>, found: Target, includeDeclaration: Boolean): List<Occurrence> {
    let items: List<Occurrence> = []
    if found.symbol < 0 {
        return items
    }
    let symbol = state.documents[found.document].syntax.symbols[found.symbol]
    let local = localTarget(state, found)
    for document in documents {
        if local && document != found.document {
            continue
        }
        let current = state.documents[document]
        for token in 0..current.syntax.tokens.length {
            let value = current.syntax.tokens[token]
            if value.kind != 1 || value.text != symbol.name {
                continue
            }
            if !includeDeclaration && document == found.document && value.start == symbol.start {
                continue
            }
            if sameTarget(resolve(state, document, token, 0), found) {
                items.add(Occurrence { document: document; token: token })
            }
        }
    }
    return items
}
public function references(state: workspace.Workspace, document: Integer, offset: Integer, includeDeclaration: Boolean): Text {
    let documents = workspace.projectDocuments(state)
    let found = resolve(state, document, tokenAt(state.documents[document], offset), 0)
    let items: List<Text> = []
    for occurrence in occurrences(state, documents, found, includeDeclaration) {
        let current = state.documents[occurrence.document]
        let token = current.syntax.tokens[occurrence.token]
        items.add("{\"uri\":" + json.quote(current.uri) + ",\"range\":" + protocol.range(current.text, token.start, token.end) + "}")
    }
    return "[" + host.joined(items, ",") + "]"
}
function nameStart(byte: Integer): Boolean {
    return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}
function namePart(byte: Integer): Boolean {
    return nameStart(byte) || (byte >= 48 && byte <= 57)
}
function identifier(name: Text): Boolean {
    let data = Bytes(name)
    if data.length == 0 || !nameStart(data[0]) {
        return false
    }
    for byte in data {
        if !namePart(byte) {
            return false
        }
    }
    return true
}
function reserved(name: Text): Boolean {
    return host.listed(["_", "self", "true", "false", "let", "constant", "global", "function", "record", "choice", "type", "match", "if", "else", "for", "in", "while", "return", "break", "continue", "use", "as", "public", "private", "try", "native", "parallel", "thread", "reduce", "test", "expect", "where", "capability", "conform", "to", "requires", "ensures", "together", "Integer", "Float", "Boolean", "Text", "Character", "Bytes", "Nothing", "List", "Map", "Set", "Result", "Maybe", "Ok", "Err", "Some", "None", "abs", "clamp", "exit", "fail", "joinText", "max", "min", "parallelEntry", "print", "wrappingAdd", "wrappingMultiply", "wrappingSubtract"], name)
}
function containsName(text: Text, name: Text): Boolean {
    let data = Bytes(text)
    let start = 0
    while start < data.length {
        let found = host.findText(text, name, start)
        if found < 0 {
            return false
        }
        let end = found + name.byteLength
        if (found == 0 || !namePart(data[found - 1])) && (end == data.length || !namePart(data[end])) {
            return true
        }
        start = end
    }
    return false
}
function editable(state: workspace.Workspace, found: Target): Boolean {
    if found.symbol < 0 || found.document < 0 {
        return false
    }
    let symbol = state.documents[found.document].syntax.symbols[found.symbol]
    if symbol.container == "@self" || symbol.kind == 22 || reserved(symbol.name) {
        return false
    }
    // Choice cases and generic/pattern binders need a compiler-backed index.
    if symbol.kind == 23 && symbol.detail.startsWith("choice ") {
        return false
    }
    return identifier(symbol.name)
}
function unsupportedBinding(state: workspace.Workspace, document: Integer, found: Target, newName: Text): Boolean {
    let current = state.documents[document]
    let tokens = current.syntax.tokens
    let symbol = state.documents[found.document].syntax.symbols[found.symbol]
    for token in 0..tokens.length {
        let value = tokens[token]
        if value.kind == 3 && !value.text.startsWith("#") && host.hasText(value.text, "\\(") && (containsName(value.text, symbol.name) || containsName(value.text, newName)) {
            return true
        }
        if (value.text == "let" || value.text == "constant" || value.text == "global") && token + 1 < tokens.length {
            let declared = tokens[token + 1].text
            if declared == symbol.name || declared == newName {
                let cursor = token + 2
                let nesting = 0
                let initializer = false
                while cursor < tokens.length {
                    let item = tokens[cursor]
                    if nesting == 0 && (item.text == ";" || item.text == "}" || item.line > tokens[cursor - 1].line) {
                        break
                    }
                    if item.text == "=" {
                        initializer = true
                    }
                    if initializer && item.kind == 1 && item.text == declared {
                        return true
                    }
                    if item.text == "(" || item.text == "[" || item.text == "{" {
                        nesting += 1
                    }
                    if item.text == ")" || item.text == "]" || item.text == "}" {
                        nesting -= 1
                    }
                    cursor += 1
                }
            }
        }
        if value.text == "for" {
            let cursor = token + 1
            while cursor < tokens.length && tokens[cursor].text != "in" && tokens[cursor].text != "{" && tokens[cursor].line <= value.line + 1 {
                if tokens[cursor].text == symbol.name || tokens[cursor].text == newName {
                    return true
                }
                cursor += 1
            }
        }
        if value.text == "function" || value.text == "record" || value.text == "choice" {
            let cursor = token + 1
            let generic = false
            let anonymous = cursor < tokens.length && tokens[cursor].text == "("
            while cursor < tokens.length && tokens[cursor].text != "{" && tokens[cursor].text != ")" && tokens[cursor].line <= value.line + 10 {
                if tokens[cursor].text == "<" {
                    generic = true
                }
                if (anonymous || generic) && (tokens[cursor].text == symbol.name || tokens[cursor].text == newName) {
                    return true
                }
                if tokens[cursor].text == "(" && !anonymous {
                    break
                }
                if tokens[cursor].text == ">" || tokens[cursor].text == ">>" {
                    generic = false
                }
                cursor += 1
            }
        }
        if value.text == "(" && token > 0 && tokens[token - 1].kind == 1 {
            let declaration = false
            for callable in current.syntax.symbols {
                if callable.start == tokens[token - 1].start && (callable.kind == 12 || callable.kind == 6) {
                    declaration = true
                }
            }
            let cursor = token + 1
            let nested = 1
            let named = false
            while cursor < tokens.length && nested > 0 {
                if tokens[cursor].text == "(" {
                    nested += 1
                }
                if tokens[cursor].text == ")" {
                    nested -= 1
                }
                if tokens[cursor].text == symbol.name || tokens[cursor].text == newName {
                    named = true
                }
                cursor += 1
            }
            if !declaration && named && cursor < tokens.length && (tokens[cursor].text == "{" || tokens[cursor].text == "where") {
                return true
            }
        }
    }
    return false
}
function renameIssue(state: workspace.Workspace, documents: List<Integer>, found: Target, newName: Text): Text {
    if !editable(state, found) {
        return "Choose a declared name that the language server can safely rename."
    }
    if !identifier(newName) || reserved(newName) {
        return "Choose a name using ASCII letters, digits and underscores that is not a language or built-in name."
    }
    if state.graphTruncated {
        return "This workspace exceeds the source scan limit, so a complete rename cannot be guaranteed."
    }
    let symbol = state.documents[found.document].syntax.symbols[found.symbol]
    let local = localTarget(state, found)
    for document in documents {
        if local && document != found.document {
            continue
        }
        let current = state.documents[document]
        // Types, constructors and import prefixes can use a separate compiler
        // namespace from values. The lexical index cannot distinguish every
        // use when a local shadows one of those names, so never edit it partly.
        if symbol.container == "" {
            for declaration in current.syntax.symbols {
                if declaration.name != symbol.name || declaration.container != "" || declaration.scopeStart != 0 || (declaration.kind != 2 && declaration.kind != 12 && declaration.kind != 23 && declaration.kind != 26) {
                    continue
                }
                for binding in current.syntax.symbols {
                    if binding.name == symbol.name && binding.container == "" && binding.start != declaration.start && (binding.kind == 2 || binding.kind == 12 || binding.kind == 13 || binding.kind == 14 || binding.kind == 23 || binding.kind == 26) {
                        return "This name is shared across compiler namespaces; its uses need compiler-resolved metadata before renaming."
                    }
                }
            }
        }
        if current.syntax.error != "" && (document == found.document || containsName(current.text, symbol.name)) {
            return "Fix the source syntax errors before renaming this name."
        }
        if unsupportedBinding(state, document, found, newName) {
            return "This name appears in an interpolation or binding form that cannot yet be renamed safely."
        }
        if newName == symbol.name {
            continue
        }
        if document == found.document {
            for other in current.syntax.symbols {
                if other.name == newName && other.container == symbol.container && other.scopeStart <= symbol.scopeEnd && symbol.scopeStart <= other.scopeEnd {
                    return "That name already belongs to another declaration in an overlapping scope."
                }
            }
        }
        for token in 0..current.syntax.tokens.length {
            let value = current.syntax.tokens[token]
            if value.kind != 1 || (local && !index.visible(symbol, value.start)) {
                continue
            }
            if value.text == symbol.name && resolve(state, document, token, 0).symbol < 0 {
                return "Some uses of this name cannot be resolved safely."
            }
            if value.text == newName && document == found.document && symbol.container == "" && index.visible(symbol, value.start) {
                let member = token > 0 && current.syntax.tokens[token - 1].text == "."
                let label = token + 1 < current.syntax.tokens.length && current.syntax.tokens[token + 1].text == ":"
                if !member && !label {
                    return "That name would capture an existing use in this scope."
                }
            }
        }
    }
    return ""
}
public function prepareRename(state: workspace.Workspace, document: Integer, offset: Integer): Text {
    let documents = workspace.projectDocuments(state)
    let token = tokenAt(state.documents[document], offset)
    let found = resolve(state, document, token, 0)
    if !editable(state, found) {
        return "null"
    }
    let symbol = state.documents[found.document].syntax.symbols[found.symbol]
    if renameIssue(state, documents, found, symbol.name) != "" {
        return "null"
    }
    let current = state.documents[document]
    return "{\"range\":" + protocol.range(current.text, current.syntax.tokens[token].start, current.syntax.tokens[token].end) + ",\"placeholder\":" + json.quote(symbol.name) + "}"
}
public function renameError(state: workspace.Workspace, document: Integer, offset: Integer, newName: Text): Text {
    let documents = workspace.projectDocuments(state)
    let found = resolve(state, document, tokenAt(state.documents[document], offset), 0)
    return renameIssue(state, documents, found, newName)
}
public function rename(state: workspace.Workspace, document: Integer, offset: Integer, newName: Text): Text {
    let documents = workspace.projectDocuments(state)
    let found = resolve(state, document, tokenAt(state.documents[document], offset), 0)
    if renameIssue(state, documents, found, newName) != "" {
        return "null"
    }
    let changes = occurrences(state, documents, found, true)
    let changed: List<Integer> = []
    let edits: List<Text> = []
    for owner in documents {
        let items: List<Text> = []
        let current = state.documents[owner]
        for occurrence in changes {
            if occurrence.document == owner {
                let token = current.syntax.tokens[occurrence.token]
                items.add("{\"range\":" + protocol.range(current.text, token.start, token.end) + ",\"newText\":" + json.quote(newName) + "}")
            }
        }
        if items.length > 0 {
            changed.add(owner)
            edits.add("[" + host.joined(items, ",") + "]")
        }
    }
    return workspace.edits(state, changed, edits)
}
public function symbols(state: workspace.Workspace, document: Integer): Text {
    let current = state.documents[document]
    let items: List<Text> = []
    for symbol in current.syntax.symbols {
        if symbol.scopeStart != 0 || symbol.container == "@self" {
            continue
        }
        let name = symbol.name
        if symbol.container != "" {
            name = symbol.container + "." + name
        }
        items.add("{\"name\":" + json.quote(name) + ",\"detail\":" + json.quote(symbol.detail) + ",\"kind\":\(symbol.kind),\"range\":" + protocol.range(current.text, symbol.start, symbol.end) + ",\"selectionRange\":" + selection(current, symbol) + "}")
    }
    return "[" + host.joined(items, ",") + "]"
}
public function formatting(state: workspace.Workspace, document: Integer): Text {
    let current = state.documents[document]
    if current.syntax.error != "" {
        return "[]"
    }
    let formatted = format.formatted(current.text)
    if formatted == current.text {
        return "[]"
    }
    return "[{\"range\":" + protocol.range(current.text, 0, current.text.byteLength) + ",\"newText\":" + json.quote(formatted) + "}]"
}
