use "process" as processInfo
use "json" as json
use "./peer-audit.min" as audit

let root = "tests/data/peer"
let sourceRoot = ""
let requireComplete = false
let index = 0
while index < processInfo.argumentCount() {
    let value = processInfo.argument(index)
    if value == "--require-complete" {
        requireComplete = true
        index += 1
        continue
    }
    if (value == "--root" || value == "--source-root") && index + 1 < processInfo.argumentCount() {
        if value == "--root" { root = processInfo.argument(index + 1) } else { sourceRoot = processInfo.argument(index + 1) }
        index += 2
        continue
    }
    fail("usage: check-peer-audit [--root PATH] [--source-root PATH] [--require-complete]")
}
let report = audit.inspect(audit.newAudit(audit.newDomains()), root, sourceRoot)
print(json.pretty(report, ""))
if json.member(report, "errors").items.length > 0 || (requireComplete && !json.member(report, "complete").truth) { exit(1) }
