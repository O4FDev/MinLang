use "./driver-support.min" as host
use "./package-git.min" as git
use "./project.min" as project
use "./registry.min" as registry
use "files" as files
use "json" as json

function command(root: Text, arguments: List<Text>, output: Text, errors: Text): Integer {
    let executable = host.which("git")
    if executable == "" { host.stop("Git is required to prepare a package release") }
    let command = [executable, "--no-optional-locks", "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", "-C", root]
    let status = host.spawnBounded(host.extended(command, arguments), git.gitEnvironment(host.parentPath(errors)), false, output, errors, 60, 33554432, 1048576)
    if status == host.ERROR_LIMIT { host.stop("cannot prepare this release: Git error output exceeds 1 MiB") }
    if status == host.OUTPUT_LIMIT { host.stop("cannot prepare this release: Git output exceeds 32 MiB") }
    return status
}
function text(root: Text, arguments: List<Text>, scratch: Text): Text {
    if command(root, arguments, scratch + "/out", scratch + "/err") != 0 { host.stop("cannot prepare this release: " + host.strip(host.readText(scratch + "/err")) + "; commit the package and tag its version first") }
    return host.readText(scratch + "/out")
}
function cleanStatus(root: Text, scratch: Text): Text {
    let status = command(root, ["config", "--includes", "--null", "--name-only", "--get-regexp", "^filter\\..*\\.(clean|smudge|process|required)$"], scratch + "/out", scratch + "/err")
    if status != 0 && status != 1 { host.stop("cannot read this repository's Git filter settings; review its configuration before minyar publish") }
    let arguments: List<Text> = []
    for key in host.readText(scratch + "/out").split(Text(Character(0))) {
        if key == "" { continue }
        arguments.add("-c")
        let value = ""
        if key.endsWith(".required") { value = "false" }
        arguments.add(key + "=" + value)
    }
    return text(root, host.extended(arguments, ["status", "--porcelain", "--untracked-files=normal"]), scratch)
}
// The public repository a release is recorded under: named on the command line, or read from the
// origin remote when it is an HTTPS or SSH URL of a Git host (git@host:owner/repo, ssh://, https://).
public function origin(root: Text, scratch: Text): Text {
    if command(root, ["remote", "get-url", "origin"], scratch + "/out", scratch + "/err") != 0 { return "" }
    let url = host.strip(host.readText(scratch + "/out"))
    if url.startsWith("https://") { url = host.textAfter(url, "https://") }
    else if url.startsWith("ssh://") {
        url = host.textAfter(url, "ssh://")
        let at = host.findText(url, "@", 0)
        let slash = host.findText(url, "/", 0)
        if at >= 0 && (slash < 0 || at < slash) { url = host.textSlice(url, at + 1, url.byteLength) }
        let colon = host.findText(url, ":", 0)
        slash = host.findText(url, "/", 0)
        if colon >= 0 && colon < slash { url = host.textSlice(url, 0, colon) + host.textSlice(url, slash, url.byteLength) }
    } else if host.hasText(url, "@") && host.hasText(url, ":") && !host.hasText(url, "://") {
        url = host.textSlice(url, host.findText(url, "@", 0) + 1, url.byteLength)
        let colon = host.findText(url, ":", 0)
        url = host.textSlice(url, 0, colon) + "/" + host.textSlice(url, colon + 1, url.byteLength)
    } else { return "" }
    if host.hasText(url, "@") { return "" }
    return url
}
public function prepare(package: project.Manifest, repository: Text, description: Text): registry.Entry {
    if !project.hasLibrary(package) { host.stop("publish requires a source library at src/" + package.name + ".min") }
    // Consumers cannot follow a path outside the published repository, so refuse before recording it.
    for index in 0..package.dependencies.length {
        if package.repositories[index] == "" { host.stop(package.dependencies[index] + " is a local path dependency, which consumers of " + package.name + " cannot fetch; publish it too and depend on it with minyar add HOST/OWNER/" + package.dependencies[index]) }
    }
    let temporary = host.temporaryDirectory("", "minyar-publish-")
    let scratch = host.resolveName(temporary)
    if host.strip(text(package.root, ["rev-parse", "--show-toplevel"], scratch)) != package.root { host.stop("publish requires the package manifest at the Git repository root") }
    let named = repository
    if named == "" { named = origin(package.root, scratch) }
    if named == "" { host.stop("cannot tell where consumers fetch this package: its origin remote is not an HTTPS or SSH Git URL; name it: minyar publish HOST/OWNER/" + package.name) }
    let source = git.repository(named)
    if cleanStatus(package.root, scratch) != "" { host.stop("package has uncommitted files; commit the release before minyar publish") }
    let commit = host.strip(text(package.root, ["rev-parse", "--verify", "HEAD^{commit}"], scratch))
    let tag = "v" + package.version
    if command(package.root, ["rev-parse", "--verify", "--quiet", "refs/tags/" + tag + "^{commit}"], scratch + "/out", scratch + "/err") != 0 { host.stop("package.version is " + package.version + " but there is no tag " + tag + "; tag the reviewed release commit: git tag " + tag) }
    if host.strip(host.readText(scratch + "/out")) != commit { host.stop(tag + " does not point to HEAD; check out the tagged commit, or set a new package.version for this commit and tag it") }
    let directory = host.strip(text(package.root, ["rev-parse", "--absolute-git-dir"], scratch))
    let exported = git.exportTree(directory, commit, scratch)
    let checksum = git.treeHash(exported)
    let summary = description
    if summary == "" { summary = package.description }
    if summary == "" { summary = "Minyar source library." }
    let result = registry.Entry { name: package.name; repository: source; version: package.version; description: summary; commit: commit; checksum: checksum }
    host.release(temporary)
    return registry.entry(json.parseUnique(registry.renderEntry(result)))
}
// Fetch the release the way a consumer will, and require the host to serve exactly the prepared commit and
// source tree. An index never records a release that consumers cannot download or that differs from review.
public function confirmHosted(entry: registry.Entry) {
    let tag = "v" + entry.version
    let served = false
    for release in git.releases(entry.repository) { if release.tag == tag { served = true } }
    if !served { host.stop(entry.repository + " does not serve the tag " + tag + " yet; push it (git push origin " + tag + ") before minyar publish") }
    let hosted = git.fetch(entry.repository, tag, "", "", false)
    if hosted.commit != entry.commit || hosted.checksum != entry.checksum { host.stop(entry.repository + " serves v" + entry.version + " at commit " + hosted.commit + ", not the local release " + entry.commit + "; push the reviewed tag (git push origin v" + entry.version + ") before minyar publish") }
}
