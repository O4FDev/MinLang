// Opt-in live code images. The ordinary compiler and its bootstrap stay unchanged.
use "./editor-source.min" as editor
use "./driver-support.min" as host

// digests: each function's body fingerprint; exports: each function's wrapper in
// this image (only meaningful for the original executable).
public record Image { llvm: Text; names: List<Text>; symbols: List<Text>; signature: Text; digests: Text; exports: Text; error: Text }
record Symbol { token: Text; raw: Text; end: Integer; error: Text }
record Function { name: Text; raw: Text; wrapper: Text; body: Text; language: Boolean; result: Text; returned: Text; parameters: Text; arguments: Text; signature: Text; error: Text }
record Rewritten { text: Text; error: Text }

function field(parts: List<Text>, value: Text) { parts.add(Text(value.byteLength) + ":" + value + "\n") }
function surfaceError(message: Text): Text { return "live-surface-error: " + message }

// Success is recognisable so malformed edits can leave the running image alone.
public function surface(text: Text): Text {
    let source = editor.scan(text)
    if source.error != "" { return surfaceError(source.error) }
    let tokens: List<editor.Token> = []
    for token in source.tokens { if token.kind != 5 { tokens.add(token) } }
    let delimiters: List<Text> = []
    for token in tokens {
        if token.kind == 3 { continue }
        let value = token.text
        if value == "(" || value == "[" || value == "{" { delimiters.add(value) }
        if value == ")" || value == "]" || value == "}" {
            if delimiters.length == 0 { return surfaceError("unexpected closing delimiter") }
            let opening = delimiters[delimiters.length - 1]
            if (value == ")" && opening != "(") || (value == "]" && opening != "[") || (value == "}" && opening != "{") { return surfaceError("mismatched closing delimiter") }
            delimiters.pop()
        }
    }
    if delimiters.length != 0 { return surfaceError("declaration or expression is missing its closing delimiter") }
    let parts: List<Text> = ["live-surface-v1\n"]
    let index = 0
    let depth = 0
    while index < tokens.length {
        let token = tokens[index]
        // Named top-level functions only; closures and capability bodies stay exact.
        if depth == 0 && token.kind == 1 && token.text == "function" && index + 1 < tokens.length && tokens[index + 1].kind == 1 {
            let name = tokens[index + 1].text
            let body = index + 2
            let round = 0
            let square = 0
            while body < tokens.length {
                let value = tokens[body].text
                if tokens[body].kind != 3 {
                    if value == "(" { round += 1 }
                    if value == ")" { round -= 1 }
                    if value == "[" { square += 1 }
                    if value == "]" { square -= 1 }
                    if value == "{" && round == 0 && square == 0 { break }
                    if value == ";" || value == "}" { return surfaceError("a named function needs a body") }
                }
                body += 1
            }
            if body == tokens.length { return surfaceError("a named function needs a body") }
            let end = body + 1
            let nesting = 1
            while end < tokens.length && nesting > 0 {
                if tokens[end].kind != 3 {
                    if tokens[end].text == "{" { nesting += 1 }
                    if tokens[end].text == "}" { nesting -= 1 }
                }
                end += 1
            }
            if nesting != 0 { return surfaceError("a named function needs its closing brace") }
            let native = false
            for statement in (body + 1)..end {
                if tokens[statement].kind == 1 && tokens[statement].text == "native" {
                    let value = statement + 1
                    while value < end && tokens[value].kind == 6 { value += 1 }
                    if value < end && tokens[value].kind == 3 { native = true }
                }
            }
            let main = name == "main" && index + 2 < tokens.length && tokens[index + 2].text != "."
            if !main && !native {
                for header in index..(body + 1) { field(parts, tokens[header].text) }
                field(parts, "<live function body>")
                field(parts, "}")
                index = end
                continue
            }
        }
        field(parts, token.text)
        if token.kind != 3 {
            if token.text == "{" { depth += 1 }
            if token.text == "}" { depth -= 1 }
        }
        index += 1
    }
    return joinText(parts)
}

function hex(byte: Integer): Integer {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 65 && byte <= 70 { return byte - 55 }
    if byte >= 97 && byte <= 102 { return byte - 87 }
    return -1
}
function identifier(byte: Integer): Boolean {
    return editor.word(byte) || editor.digit(byte) || byte == 36 || byte == 46 || byte == 45
}
function symbol(data: Bytes, start: Integer): Symbol {
    let result = Symbol { token: ""; raw: ""; end: start; error: "" }
    if start >= data.length { result.error = "generated LLVM has an incomplete symbol"; return result }
    let index = start
    let decoded = Bytes()
    if data[index] == 34 {
        index += 1
        let closed = false
        while index < data.length {
            let byte = data[index]
            if byte == 34 { index += 1; closed = true; break }
            if byte == 92 {
                if index + 2 >= data.length { result.error = "generated LLVM has an incomplete symbol escape"; return result }
                let high = hex(data[index + 1])
                let low = hex(data[index + 2])
                if high < 0 || low < 0 { result.error = "generated LLVM has an invalid symbol escape"; return result }
                byte = high * 16 + low
                index += 2
            }
            if byte == 0 || byte == 10 || byte == 13 { result.error = "live function names cannot contain zero bytes or newlines"; return result }
            decoded.add(byte)
            index += 1
        }
        if !closed { result.error = "generated LLVM has an unterminated symbol"; return result }
    } else {
        while index < data.length && identifier(data[index]) { decoded.add(data[index]); index += 1 }
    }
    if decoded.length == 0 { result.error = "generated LLVM has an empty symbol"; return result }
    result.token = Text(data.slice(start, index))
    result.raw = Text(decoded)
    result.end = index
    return result
}
function escaped(value: Text): Text {
    let parts: List<Text> = []
    let digits = "0123456789ABCDEF"
    for byte in Bytes(value) {
        if byte >= 32 && byte <= 126 && byte != 34 && byte != 92 { parts.add(Text(Character(byte))) }
        else { parts.add("\\" + Text(digits[byte / 16]) + Text(digits[byte % 16])) }
    }
    return joinText(parts)
}
function failed(message: Text): Image { return Image { llvm: ""; names: []; symbols: []; signature: ""; digests: ""; exports: ""; error: message } }
function scalar(value: Text): Boolean { return host.listed(["void", "i64", "i32", "i1", "double", "ptr"], value) }
function definition(line: Text, generation: Integer, index: Integer, initial: Boolean): Function {
    let found = Function { name: ""; raw: ""; wrapper: ""; body: ""; language: false; result: ""; returned: ""; parameters: ""; arguments: ""; signature: ""; error: "" }
    let at = host.findText(line, "@", 0)
    if at < 0 { found.error = "generated LLVM function is missing its symbol"; return found }
    let parsed = symbol(Bytes(line), at + 1)
    if parsed.error != "" { found.error = parsed.error; return found }
    found.name = parsed.token
    found.raw = parsed.raw
    found.wrapper = "minyar.live." + Text(generation) + ".function." + Text(index)
    found.body = "minyar.live." + Text(generation) + ".body." + Text(index)
    if initial && parsed.raw == "main" { found.wrapper = "main" }
    found.language = parsed.raw.startsWith(".minyar.fn.")
    if !found.language { return found }
    let leading = host.words(host.textSlice(line, 7, at))
    if leading.length == 0 { found.error = "generated LLVM function is missing its return type"; return found }
    found.returned = leading[leading.length - 1]
    if !scalar(found.returned) { found.error = "live functions require a supported scalar or managed return ABI"; return found }
    found.result = found.returned
    for item in leading {
        if !host.listed(["internal", "private", "dso_local", "hidden", "default", "zeroext", "signext", found.returned], item) { found.error = "unsupported live function return attribute: " + item; return found }
        if item == "zeroext" || item == "signext" { found.result = item + " " + found.returned }
    }
    let begin = parsed.end
    let data = Bytes(line)
    while begin < data.length && host.isSpace(data[begin]) { begin += 1 }
    if begin >= data.length || data[begin] != 40 { found.error = "generated LLVM function is missing its parameter list"; return found }
    let end = host.findText(line, ")", begin + 1)
    if end < 0 || !host.strip(line).endsWith("{") { found.error = "live functions require a complete single-line LLVM header"; return found }
    let parameters = host.strip(host.textSlice(line, begin + 1, end))
    let declarations: List<Text> = []
    let arguments: List<Text> = []
    let signature: List<Text> = []
    field(signature, found.raw)
    field(signature, found.result)
    if parameters != "" {
        for parameter in parameters.split(",") {
            let words = host.words(parameter)
            if words.length != 2 { found.error = "unsupported live function parameter attributes"; return found }
            if !scalar(words[0]) || words[0] == "void" || !words[1].startsWith("%") { found.error = "unsupported live function parameter ABI"; return found }
            declarations.add(words[0] + " " + words[1])
            arguments.add(words[0] + " " + words[1])
            field(signature, words[0])
        }
    }
    found.parameters = host.joined(declarations, ", ")
    found.arguments = host.joined(arguments, ", ")
    found.signature = joinText(signature)
    return found
}

// Replace symbol references, never strings/inline assembly/comments or prefixes.
function renamed(text: Text, names: Map<Text, Text>): Rewritten {
    let data = Bytes(text)
    let parts: List<Text> = []
    let start = 0
    let index = 0
    while index < data.length {
        if data[index] == 59 { while index < data.length && data[index] != 10 { index += 1 }; continue }
        if data[index] == 34 {
            index += 1
            let closed = false
            while index < data.length {
                if data[index] == 92 { index += 2 }
                else if data[index] == 34 { index += 1; closed = true; break }
                else { index += 1 }
            }
            if !closed { return Rewritten { text: ""; error: "generated LLVM has an unterminated string" } }
            continue
        }
        if data[index] == 64 {
            let parsed = symbol(data, index + 1)
            if parsed.error != "" { return Rewritten { text: ""; error: parsed.error } }
            if names.has(parsed.raw) {
                parts.add(Text(data.slice(start, index + 1)))
                parts.add(names[parsed.raw])
                start = parsed.end
            }
            index = parsed.end
        } else { index += 1 }
    }
    parts.add(Text(data.slice(start, data.length)))
    return Rewritten { text: joinText(parts); error: "" }
}
// Symbols referenced outside strings and comments, in order of appearance.
function references(text: Text): List<Text> {
    let data = Bytes(text)
    let found: List<Text> = []
    let index = 0
    while index < data.length {
        if data[index] == 59 { while index < data.length && data[index] != 10 { index += 1 }; continue }
        if data[index] == 34 {
            index += 1
            while index < data.length && data[index] != 34 { if data[index] == 92 { index += 1 }; index += 1 }
            index += 1
            continue
        }
        if data[index] == 64 {
            let parsed = symbol(data, index + 1)
            if parsed.error != "" { return found }
            found.add(parsed.raw)
            index = parsed.end
        } else { index += 1 }
    }
    return found
}
// A body's fingerprint covers its LLVM text and every global value it reaches,
// so editing a literal changes the functions that use it. Calls are by name.
function digest(body: Text, globals: Map<Text, Text>): Text {
    let parts: List<Text> = [body]
    let seen = Map<Text, Boolean>()
    let pending = references(body)
    let index = 0
    while index < pending.length {
        let name = pending[index]
        index += 1
        if seen.has(name) || !globals.has(name) { continue }
        seen[name] = true
        let definition = globals[name]
        parts.add(definition)
        for next in references(definition) { pending.add(next) }
    }
    return host.hashBytes(Bytes(joinText(parts)))
}
public function encodePairs(keys: List<Text>, values: List<Text>): Text {
    let parts: List<Text> = ["live-pairs-v1\n"]
    for index in 0..keys.length { field(parts, keys[index]); field(parts, values[index]) }
    return joinText(parts)
}
public function decodePairs(text: Text): Map<Text, Text> {
    let result = Map<Text, Text>()
    let data = Bytes(text)
    let header = Bytes("live-pairs-v1\n")
    if data.length < header.length || Text(data.slice(0, header.length)) != "live-pairs-v1\n" { return result }
    let index = header.length
    let values: List<Text> = []
    while index < data.length {
        let colon = index
        let length = 0
        while colon < data.length && data[colon] >= 48 && data[colon] <= 57 { length = length * 10 + data[colon] - 48; colon += 1 }
        if colon >= data.length || data[colon] != 58 || colon + 1 + length >= data.length || data[colon + 1 + length] != 10 { return Map<Text, Text>() }
        values.add(Text(data.slice(colon + 1, colon + 1 + length)))
        index = colon + 2 + length
    }
    if values.length % 2 != 0 { return Map<Text, Text>() }
    let pair = 0
    while pair < values.length { result[values[pair]] = values[pair + 1]; pair += 2 }
    return result
}

function rootCell(line: Text, initial: Boolean): Rewritten {
    if !line.startsWith("@") { return Rewritten { text: line; error: "" } }
    let parsed = symbol(Bytes(line), 1)
    if parsed.error != "" { return Rewritten { text: ""; error: parsed.error } }
    if !parsed.raw.startsWith("minyar.constant|") || !(parsed.raw.endsWith("|value") || parsed.raw.endsWith("|state")) { return Rewritten { text: line; error: "" } }
    let tail = host.strip(host.textSlice(line, parsed.end, line.byteLength))
    if !tail.startsWith("= internal global ") { return Rewritten { text: ""; error: "unsupported module state cell linkage" } }
    let words = host.words(host.textAfter(tail, "= internal global "))
    if words.length != 2 || !(scalar(words[0]) || words[0] == "i8") { return Rewritten { text: ""; error: "unsupported module state cell layout" } }
    if initial { return Rewritten { text: "@" + parsed.token + " = global " + words[0] + " " + words[1]; error: "" } }
    return Rewritten { text: "@" + parsed.token + " = external global " + words[0]; error: "" }
}
function wrapper(function: Function, index: Integer, generation: Integer): Text {
    let key = "minyar.live." + Text(generation) + ".key." + Text(index)
    let output: List<Text> = ["@" + key + " = private unnamed_addr constant [" + Text(function.raw.byteLength + 1) + " x i8] c\"" + escaped(function.raw) + "\\00\"\n"]
    // Each wrapper keeps its current target in a slot. The runtime fills it on
    // the first call and retargets it when a publication's epoch is first
    // seen, so an ordinary call costs a few loads and an indirect branch.
    let slot = "minyar.live." + Text(generation) + ".slot." + Text(index)
    output.add("@" + slot + " = internal global ptr null, align 8\n")
    output.add("define " + function.result + " @" + function.wrapper + "(" + function.parameters + ") noinline uwtable {\nentry:\n")
    output.add("  %live.page = load ptr, ptr @minyar_live_epoch, align 8\n")
    output.add("  %live.epoch = load atomic i64, ptr %live.page acquire, align 8\n")
    output.add("  %live.seen = load i64, ptr @minyar_live_epoch_seen, align 8\n")
    output.add("  %live.cached = load ptr, ptr @" + slot + ", align 8\n")
    output.add("  %live.current = icmp eq i64 %live.epoch, %live.seen\n  %live.bound = icmp ne ptr %live.cached, null\n")
    output.add("  %live.ready = and i1 %live.current, %live.bound\n  br i1 %live.ready, label %live.call, label %live.bind\nlive.bind:\n")
    output.add("  %live.resolved = call ptr @minyar_live_bind(ptr @" + key + ", ptr @" + function.body + ", ptr @" + slot + ")\n  br label %live.call\nlive.call:\n")
    output.add("  %live.target = phi ptr [ %live.cached, %entry ], [ %live.resolved, %live.bind ]\n")
    if function.returned == "void" {
        output.add("  call void %live.target(" + function.arguments + ")\n  ret void\n}\n")
    } else {
        output.add("  %live.result = call " + function.result + " %live.target(" + function.arguments + ")\n  ret " + function.returned + " %live.result\n}\n")
    }
    return joinText(output)
}

record Parsed { functions: List<Function>; starts: List<Integer>; ends: List<Integer>; lines: List<Text>; globals: Map<Text, Text>; error: Text }
function parse(llvm: Text, generation: Integer, initial: Boolean): Parsed {
    let result = Parsed { functions: []; starts: []; ends: []; lines: host.lines(llvm); globals: Map<Text, Text>(); error: "" }
    if generation < 0 { result.error = "live generation must be nonnegative"; return result }
    if host.hasText(llvm, "; minyar-thread-runtime: 1") || host.hasText(llvm, "; minyar-data-parallel-runtime: 1") { result.error = "live reload currently requires a single-threaded program"; return result }
    let seen = Map<Text, Boolean>()
    let inFunction = false
    for position in 0..result.lines.length {
        let line = result.lines[position]
        if line.startsWith("define ") {
            if inFunction { result.error = "generated LLVM contains a nested function definition"; return result }
            let function = definition(line, generation, result.functions.length, initial)
            if function.error != "" { result.error = function.error; return result }
            if seen.has(function.raw) { result.error = "generated LLVM repeats a function definition"; return result }
            seen[function.raw] = true
            result.functions.add(function)
            result.starts.add(position)
            inFunction = true
        } else if line == "}" {
            if !inFunction { result.error = "generated LLVM has an unexpected function closing brace"; return result }
            result.ends.add(position)
            // Closures and other generated helpers are not language functions:
            // their code counts toward every fingerprint that reaches them.
            let closing = result.functions.length - 1
            if !result.functions[closing].language { result.globals[result.functions[closing].raw] = bodyText(result, closing) }
            inFunction = false
        } else if !inFunction && line.startsWith("@") {
            let global = symbol(Bytes(line), 1)
            if global.error == "" { result.globals[global.raw] = line }
        }
    }
    if inFunction { result.error = "generated LLVM is missing a function closing brace"; return result }
    if result.functions.length == 0 { result.error = "generated LLVM contains no functions"; return result }
    return result
}
function bodyText(parsed: Parsed, index: Integer): Text {
    let parts: List<Text> = []
    for position in parsed.starts[index]..(parsed.ends[index] + 1) { parts.add(parsed.lines[position]); parts.add("\n") }
    return joinText(parts)
}
function signatureLine(signatures: List<Text>, line: Text) {
    if line.startsWith("%") && host.hasText(line, " = type ") { field(signatures, line) }
    if line.startsWith("; minyar-c-layout: ") || line.startsWith("; minyar-c-value: ") { field(signatures, line) }
    if line.startsWith("; minyar-native-library: ") || line == "; minyar-cycle-runtime: 1" || line == "; minyar-callback-runtime: 1" || line == "; minyar-sort-callback-runtime: 1" { field(signatures, line) }
}
function publicDefinition(line: Text, from: Text, to: Text): Text {
    let result = host.replaceText(line, "@" + from + "(", "@" + to + "(")
    result = host.replaceText(result, "define internal ", "define ")
    result = host.replaceText(result, "define private ", "define ")
    return host.replaceText(result, "define hidden ", "define ")
}

public function transform(llvm: Text, generation: Integer, initial: Boolean): Image {
    let parsed = parse(llvm, generation, initial)
    if parsed.error != "" { return failed(parsed.error) }
    let functions = parsed.functions
    let namesBySymbol = Map<Text, Text>()
    for function in functions { namesBySymbol[function.raw] = function.wrapper }
    let output: List<Text> = []
    let names: List<Text> = []
    let symbols: List<Text> = []
    let signatures: List<Text> = ["live-image-v1\n"]
    let digestKeys: List<Text> = []
    let digestValues: List<Text> = []
    let exportValues: List<Text> = []
    let current = 0
    for line in parsed.lines {
        let state = rootCell(line, initial)
        if state.error != "" { return failed(state.error) }
        let replaced = renamed(state.text, namesBySymbol)
        if replaced.error != "" { return failed(replaced.error) }
        let result = replaced.text
        if line.startsWith("define ") {
            let function = functions[current]
            if function.language {
                result = publicDefinition(result, function.wrapper, function.body)
                names.add(function.raw)
                symbols.add(function.body)
                field(signatures, function.signature)
                digestKeys.add(function.raw)
                digestValues.add(digest(bodyText(parsed, current), parsed.globals))
                exportValues.add(function.wrapper)
            }
            current += 1
        }
        signatureLine(signatures, line)
        output.add(result + "\n")
    }
    output.add("declare ptr @minyar_live_bind(ptr, ptr, ptr)\n@minyar_live_epoch = external global ptr\n@minyar_live_epoch_seen = external global i64\n")
    for index in 0..functions.length { if functions[index].language { output.add(wrapper(functions[index], index, generation)) } }
    return Image { llvm: joinText(output); names: names; symbols: symbols; signature: joinText(signatures);
        digests: encodePairs(digestKeys, digestValues); exports: encodePairs(digestKeys, exportValues); error: "" }
}

// An update image holds the functions whose fingerprint differs from the
// original executable's (`published`), so each table is complete on its own:
// a function it omits runs its original body. Every call goes through the
// original executable's wrappers (`exports`).
public function transformUpdate(llvm: Text, generation: Integer, published: Map<Text, Text>, exports: Map<Text, Text>): Image {
    let parsed = parse(llvm, generation, false)
    if parsed.error != "" { return failed(parsed.error) }
    let functions = parsed.functions
    let namesBySymbol = Map<Text, Text>()
    let changed: List<Boolean> = []
    let digestKeys: List<Text> = []
    let digestValues: List<Text> = []
    for index in 0..functions.length {
        let function = functions[index]
        if !function.language { namesBySymbol[function.raw] = function.wrapper; changed.add(true); continue }
        if !exports.has(function.raw) { return failed("hot reload changed a compiled function signature; stop and run again") }
        namesBySymbol[function.raw] = exports[function.raw]
        let fingerprint = digest(bodyText(parsed, index), parsed.globals)
        digestKeys.add(function.raw)
        digestValues.add(fingerprint)
        changed.add(!published.has(function.raw) || published[function.raw] != fingerprint)
    }
    let output: List<Text> = []
    let names: List<Text> = []
    let symbols: List<Text> = []
    let signatures: List<Text> = ["live-image-v1\n"]
    let current = -1
    let skipping = false
    for position in 0..parsed.lines.length {
        let line = parsed.lines[position]
        if line.startsWith("define ") {
            current += 1
            skipping = functions[current].language && !changed[current]
            if functions[current].language { field(signatures, functions[current].signature) }
        }
        signatureLine(signatures, line)
        if skipping {
            if position == parsed.ends[current] { skipping = false }
            continue
        }
        let state = rootCell(line, false)
        if state.error != "" { return failed(state.error) }
        let replaced = renamed(state.text, namesBySymbol)
        if replaced.error != "" { return failed(replaced.error) }
        let result = replaced.text
        if line.startsWith("define ") && functions[current].language {
            let function = functions[current]
            result = publicDefinition(result, exports[function.raw], function.body)
            names.add(function.raw)
            symbols.add(function.body)
        }
        output.add(result + "\n")
    }
    for function in functions {
        if !function.language { continue }
        let types: List<Text> = []
        if function.parameters != "" { for parameter in function.parameters.split(", ") { types.add(host.words(parameter)[0]) } }
        output.add("declare " + function.result + " @" + exports[function.raw] + "(" + host.joined(types, ", ") + ")\n")
    }
    return Image { llvm: joinText(output); names: names; symbols: symbols; signature: joinText(signatures);
        digests: encodePairs(digestKeys, digestValues); exports: ""; error: "" }
}
