// Opt-in live code images. The ordinary compiler and its bootstrap stay unchanged.
use "./editor-source.min" as editor
use "./driver-support.min" as host
use "text" as textCodec

// digests: each function's body fingerprint; exports: each function's wrapper in
// this image; cells: each module state cell's LLVM type; shapes: each generic
// instance's code apart from its own name (all only meaningful for the original
// executable). Function names do not depend on import order: whole programs tag
// each module by its path (compiler/stages/modules.min, wholeProgramModuleTag).
// added: functions an update introduces.
public record Image { llvm: Text; names: List<Text>; symbols: List<Text>; signature: Text; digests: Text; exports: Text; cells: Text; shapes: Text; added: List<Text>; error: Text }
// What an update is compared with: the original executable's session files.
public record Session { digests: Map<Text, Text>; exports: Map<Text, Text>; cells: Map<Text, Text>; shapes: Map<Text, Text> }
public function session(digests: Text, exports: Text, cells: Text, shapes: Text): Session {
    return Session { digests: decodePairs(digests); exports: decodePairs(exports); cells: decodePairs(cells); shapes: decodePairs(shapes) }
}
public function sessionOf(image: Image): Session { return session(image.digests, image.exports, image.cells, image.shapes) }
public record Symbol { token: Text; raw: Text; end: Integer; error: Text }
record Function { name: Text; raw: Text; wrapper: Text; body: Text; language: Boolean; result: Text; returned: Text; parameters: Text; arguments: Text; signature: Text; error: Text }
record Rewritten { text: Text; error: Text }

function field(parts: List<Text>, value: Text) { parts.add(Text(value.byteLength) + ":" + value + "\n") }
function surfaceError(message: Text): Text { return "live-surface-error: " + message }

// Success is recognisable so malformed edits can leave the running image alone.
public function surface(text: Text): Text {
    let found = surfaceItems(text)
    if found.error != "" { return surfaceError(found.error) }
    let parts: List<Text> = ["live-surface-v1\n"]
    for item in found.items { parts.add(host.textSlice(item, 1, item.byteLength)) }
    return joinText(parts)
}
// The surface as top-level items, each a kind letter and its tokens' fields:
// F a named function (modifiers and header; the body is hidden), U an import,
// R a record, N a line break, T any other single token. Additive updates may
// insert F, U and R items and insert or drop N items; everything else must
// stay exactly as it was.
public record Items { items: List<Text>; error: Text }
public function surfaceItems(text: Text): Items {
    let result = Items { items: []; error: "" }
    let source = editor.scan(text)
    if source.error != "" { result.error = source.error; return result }
    let tokens: List<editor.Token> = []
    for token in source.tokens { if token.kind != 5 { tokens.add(token) } }
    let delimiters: List<Text> = []
    for token in tokens {
        if token.kind == 3 { continue }
        let value = token.text
        if value == "(" || value == "[" || value == "{" { delimiters.add(value) }
        if value == ")" || value == "]" || value == "}" {
            if delimiters.length == 0 { result.error = "unexpected closing delimiter"; return result }
            let opening = delimiters[delimiters.length - 1]
            if (value == ")" && opening != "(") || (value == "]" && opening != "[") || (value == "}" && opening != "{") { result.error = "mismatched closing delimiter"; return result }
            delimiters.pop()
        }
    }
    if delimiters.length != 0 { result.error = "declaration or expression is missing its closing delimiter"; return result }
    let items = result.items
    let index = 0
    let depth = 0
    while index < tokens.length {
        let token = tokens[index]
        // Named top-level functions only; closures and capability bodies stay exact.
        if depth == 0 && token.kind == 1 && token.text == "function" && index + 1 < tokens.length && tokens[index + 1].kind == 1 {
            let name = tokens[index + 1].text
            let body = index + 2
            let round = 0
            let square = 0
            while body < tokens.length {
                let value = tokens[body].text
                if tokens[body].kind != 3 {
                    if value == "(" { round += 1 }
                    if value == ")" { round -= 1 }
                    if value == "[" { square += 1 }
                    if value == "]" { square -= 1 }
                    if value == "{" && round == 0 && square == 0 { break }
                    if value == ";" || value == "}" { result.error = "a named function needs a body"; return result }
                }
                body += 1
            }
            if body == tokens.length { result.error = "a named function needs a body"; return result }
            let end = body + 1
            let nesting = 1
            while end < tokens.length && nesting > 0 {
                if tokens[end].kind != 3 {
                    if tokens[end].text == "{" { nesting += 1 }
                    if tokens[end].text == "}" { nesting -= 1 }
                }
                end += 1
            }
            if nesting != 0 { result.error = "a named function needs its closing brace"; return result }
            let native = false
            for statement in (body + 1)..end {
                if tokens[statement].kind == 1 && tokens[statement].text == "native" {
                    let value = statement + 1
                    while value < end && tokens[value].kind == 6 { value += 1 }
                    if value < end && tokens[value].kind == 3 { native = true }
                }
            }
            let main = name == "main" && index + 2 < tokens.length && tokens[index + 2].text != "."
            if !main && !native {
                let parts: List<Text> = ["F", modifiers(items)]
                for header in index..(body + 1) { field(parts, tokens[header].text) }
                field(parts, "<live function body>")
                field(parts, "}")
                items.add(joinText(parts))
                index = end
                continue
            }
        }
        if depth == 0 && token.kind == 1 && token.text == "use" && index + 3 < tokens.length && tokens[index + 1].kind == 3 && tokens[index + 2].text == "as" {
            let parts: List<Text> = ["U"]
            for position in index..(index + 4) { field(parts, tokens[position].text) }
            items.add(joinText(parts))
            index += 4
            continue
        }
        if depth == 0 && token.kind == 1 && token.text == "record" && index + 1 < tokens.length && tokens[index + 1].kind == 1 {
            let open = index + 2
            while open < tokens.length && (tokens[open].kind == 3 || tokens[open].text != "{") { open += 1 }
            let end = open + 1
            let nesting = 1
            while end < tokens.length && nesting > 0 {
                if tokens[end].kind != 3 {
                    if tokens[end].text == "{" { nesting += 1 }
                    if tokens[end].text == "}" { nesting -= 1 }
                }
                end += 1
            }
            if open < tokens.length && nesting == 0 {
                let parts: List<Text> = ["R", modifiers(items)]
                for position in index..end { field(parts, tokens[position].text) }
                items.add(joinText(parts))
                index = end
                continue
            }
        }
        let parts: List<Text> = ["T"]
        if token.kind == 6 { parts[0] = "N" }
        field(parts, token.text)
        items.add(joinText(parts))
        if token.kind != 3 {
            if token.text == "{" { depth += 1 }
            if token.text == "}" { depth -= 1 }
        }
        index += 1
    }
    return result
}
// Declaration modifiers just before a function or record belong to it.
function modifiers(items: List<Text>): Text {
    let taken = ""
    while items.length > 0 {
        let last = items[items.length - 1]
        if last != "T6:public\n" && last != "T13:deterministic\n" && last != "T8:parallel\n" { break }
        taken = host.textSlice(last, 1, last.byteLength) + taken
        items.pop()
    }
    return taken
}
// "" when `after` keeps every item of `before` in order and only inserts
// functions, records and imports.
public function additions(before: List<Text>, after: List<Text>): Text {
    let old = 0
    let new = 0
    while new < after.length {
        if old < before.length && before[old] == after[new] { old += 1; new += 1; continue }
        // Line breaks between declarations carry no meaning of their own.
        if old < before.length && before[old].startsWith("N") { old += 1; continue }
        if !after[new].startsWith("F") && !after[new].startsWith("U") && !after[new].startsWith("R") && !after[new].startsWith("N") { return "changed" }
        new += 1
    }
    while old < before.length && before[old].startsWith("N") { old += 1 }
    if old < before.length { return "changed" }
    return ""
}
public function encodeList(items: List<Text>): Text {
    let parts: List<Text> = ["live-list-v1\n"]
    for item in items { field(parts, item) }
    return joinText(parts)
}
public function decodeList(text: Text): List<Text> { return fields(text, "live-list-v1\n").values }

function hex(byte: Integer): Integer {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 65 && byte <= 70 { return byte - 55 }
    if byte >= 97 && byte <= 102 { return byte - 87 }
    return -1
}
function identifier(byte: Integer): Boolean {
    return editor.word(byte) || editor.digit(byte) || byte == 36 || byte == 46 || byte == 45
}
public function symbol(data: Bytes, start: Integer): Symbol {
    let result = Symbol { token: ""; raw: ""; end: start; error: "" }
    if start >= data.length { result.error = "generated LLVM has an incomplete symbol"; return result }
    let index = start
    let decoded = Bytes()
    if data[index] == 34 {
        index += 1
        let closed = false
        while index < data.length {
            let byte = data[index]
            if byte == 34 { index += 1; closed = true; break }
            if byte == 92 {
                if index + 2 >= data.length { result.error = "generated LLVM has an incomplete symbol escape"; return result }
                let high = hex(data[index + 1])
                let low = hex(data[index + 2])
                if high < 0 || low < 0 { result.error = "generated LLVM has an invalid symbol escape"; return result }
                byte = high * 16 + low
                index += 2
            }
            if byte == 0 || byte == 10 || byte == 13 { result.error = "live function names cannot contain zero bytes or newlines"; return result }
            decoded.add(byte)
            index += 1
        }
        if !closed { result.error = "generated LLVM has an unterminated symbol"; return result }
    } else {
        while index < data.length && identifier(data[index]) { decoded.add(data[index]); index += 1 }
    }
    if decoded.length == 0 { result.error = "generated LLVM has an empty symbol"; return result }
    result.token = textCodec.decodeOrStop(data.slice(start, index))
    result.raw = textCodec.decodeOrStop(decoded)
    result.end = index
    return result
}
function escaped(value: Text): Text {
    let parts: List<Text> = []
    let digits = "0123456789ABCDEF"
    for byte in Bytes(value) {
        if byte >= 32 && byte <= 126 && byte != 34 && byte != 92 { parts.add(Text(Character(byte))) }
        else { parts.add("\\" + Text(digits[byte / 16]) + Text(digits[byte % 16])) }
    }
    return joinText(parts)
}
function failed(message: Text): Image { return Image { llvm: ""; names: []; symbols: []; signature: ""; digests: ""; exports: ""; cells: ""; shapes: ""; added: []; error: message } }
function scalar(value: Text): Boolean { return host.listed(["void", "i64", "i32", "i1", "double", "ptr"], value) }
function definition(line: Text, generation: Integer, index: Integer, initial: Boolean): Function {
    let found = Function { name: ""; raw: ""; wrapper: ""; body: ""; language: false; result: ""; returned: ""; parameters: ""; arguments: ""; signature: ""; error: "" }
    let at = host.findText(line, "@", 0)
    if at < 0 { found.error = "generated LLVM function is missing its symbol"; return found }
    let parsed = symbol(Bytes(line), at + 1)
    if parsed.error != "" { found.error = parsed.error; return found }
    found.name = parsed.token
    found.raw = parsed.raw
    found.wrapper = "minyar.live." + Text(generation) + ".function." + Text(index)
    found.body = "minyar.live." + Text(generation) + ".body." + Text(index)
    if initial && parsed.raw == "main" { found.wrapper = "main" }
    found.language = parsed.raw.startsWith(".minyar.fn.")
    if !found.language { return found }
    let leading = host.words(host.textSlice(line, 7, at))
    if leading.length == 0 { found.error = "generated LLVM function is missing its return type"; return found }
    found.returned = leading[leading.length - 1]
    if !scalar(found.returned) { found.error = "live functions require a supported scalar or managed return ABI"; return found }
    found.result = found.returned
    for item in leading {
        if !host.listed(["internal", "private", "dso_local", "hidden", "default", "zeroext", "signext", found.returned], item) { found.error = "unsupported live function return attribute: " + item; return found }
        if item == "zeroext" || item == "signext" { found.result = item + " " + found.returned }
    }
    let begin = parsed.end
    let data = Bytes(line)
    while begin < data.length && host.isSpace(data[begin]) { begin += 1 }
    if begin >= data.length || data[begin] != 40 { found.error = "generated LLVM function is missing its parameter list"; return found }
    let end = host.findText(line, ")", begin + 1)
    if end < 0 || !host.strip(line).endsWith("{") { found.error = "live functions require a complete single-line LLVM header"; return found }
    let parameters = host.strip(host.textSlice(line, begin + 1, end))
    let declarations: List<Text> = []
    let arguments: List<Text> = []
    let signature: List<Text> = []
    field(signature, found.raw)
    field(signature, found.result)
    if parameters != "" {
        for parameter in parameters.split(",") {
            let words = host.words(parameter)
            if words.length != 2 { found.error = "unsupported live function parameter attributes"; return found }
            if !scalar(words[0]) || words[0] == "void" || !words[1].startsWith("%") { found.error = "unsupported live function parameter ABI"; return found }
            declarations.add(words[0] + " " + words[1])
            arguments.add(words[0] + " " + words[1])
            field(signature, words[0])
        }
    }
    found.parameters = host.joined(declarations, ", ")
    found.arguments = host.joined(arguments, ", ")
    found.signature = joinText(signature)
    return found
}

// Replace symbol references, never strings/inline assembly/comments or prefixes.
function renamed(text: Text, names: Map<Text, Text>): Rewritten {
    let data = Bytes(text)
    let parts: List<Text> = []
    let start = 0
    let index = 0
    while index < data.length {
        if data[index] == 59 { while index < data.length && data[index] != 10 { index += 1 }; continue }
        if data[index] == 34 {
            index += 1
            let closed = false
            while index < data.length {
                if data[index] == 92 { index += 2 }
                else if data[index] == 34 { index += 1; closed = true; break }
                else { index += 1 }
            }
            if !closed { return Rewritten { text: ""; error: "generated LLVM has an unterminated string" } }
            continue
        }
        if data[index] == 64 {
            let parsed = symbol(data, index + 1)
            if parsed.error != "" { return Rewritten { text: ""; error: parsed.error } }
            if names.has(parsed.raw) {
                parts.add(textCodec.decodeOrStop(data.slice(start, index + 1)))
                parts.add(names[parsed.raw])
                start = parsed.end
            }
            index = parsed.end
        } else { index += 1 }
    }
    parts.add(textCodec.decodeOrStop(data.slice(start, data.length)))
    return Rewritten { text: joinText(parts); error: "" }
}
// Symbols referenced outside strings and comments, in order of appearance.
public function references(text: Text): List<Text> {
    let data = Bytes(text)
    let found: List<Text> = []
    let index = 0
    while index < data.length {
        if data[index] == 59 { while index < data.length && data[index] != 10 { index += 1 }; continue }
        if data[index] == 34 {
            index += 1
            while index < data.length && data[index] != 34 { if data[index] == 92 { index += 1 }; index += 1 }
            index += 1
            continue
        }
        if data[index] == 64 {
            let parsed = symbol(data, index + 1)
            if parsed.error != "" { return found }
            found.add(parsed.raw)
            index = parsed.end
        } else { index += 1 }
    }
    return found
}
// A body's fingerprint covers its LLVM text and every global value it reaches,
// so editing a literal changes the functions that use it. Calls are by name.
function digest(body: Text, globals: Map<Text, Text>): Text {
    let parts: List<Text> = []
    field(parts, body)
    let seen = Map<Text, Boolean>()
    let pending = references(body)
    let index = 0
    while index < pending.length {
        let name = pending[index]
        index += 1
        if seen.has(name) || !globals.has(name) { continue }
        seen[name] = true
        let definition = globals[name]
        field(parts, name)
        field(parts, definition)
        for next in references(definition) { pending.add(next) }
    }
    return host.hashBytes(Bytes(joinText(parts)))
}
public function encodePairs(keys: List<Text>, values: List<Text>): Text {
    let parts: List<Text> = ["live-pairs-v1\n"]
    for index in 0..keys.length { field(parts, keys[index]); field(parts, values[index]) }
    return joinText(parts)
}
record Fields { values: List<Text>; ok: Boolean }
// Length-prefixed fields after `header`; not ok unless the whole text is well formed.
function fields(text: Text, header: Text): Fields {
    let result = Fields { values: []; ok: false }
    let data = Bytes(text)
    let start = Bytes(header)
    if data.length < start.length || textCodec.decodeOrStop(data.slice(0, start.length)) != header { return result }
    let index = start.length
    while index < data.length {
        let colon = index
        let length = 0
        while colon < data.length && data[colon] >= 48 && data[colon] <= 57 && length < data.length { length = length * 10 + data[colon] - 48; colon += 1 }
        if colon >= data.length || data[colon] != 58 || colon + 1 + length >= data.length || data[colon + 1 + length] != 10 { result.values = []; return result }
        result.values.add(textCodec.decodeOrStop(data.slice(colon + 1, colon + 1 + length)))
        index = colon + 2 + length
    }
    result.ok = true
    return result
}
// Keys and values in order; empty unless the whole text is well formed.
public function decodeFields(text: Text): List<Text> {
    let found = fields(text, "live-pairs-v1\n")
    if !found.ok || found.values.length % 2 != 0 { return [] }
    return found.values
}
public function decodePairs(text: Text): Map<Text, Text> {
    let result = Map<Text, Text>()
    let values = decodeFields(text)
    let pair = 0
    while pair < values.length { result[values[pair]] = values[pair + 1]; pair += 2 }
    return result
}
// Whether a session file is complete; an empty map is valid.
public function wellFormed(text: Text): Boolean {
    let found = fields(text, "live-pairs-v1\n")
    return found.ok && found.values.length % 2 == 0
}

record Cell { raw: Text; token: Text; type: Text; value: Text; error: Text }
// Module state (global values and their initialization flags) lives in the
// original executable; every image refers to it there.
function cellOf(line: Text): Cell {
    let result = Cell { raw: ""; token: ""; type: ""; value: ""; error: "" }
    if !line.startsWith("@") { return result }
    let parsed = symbol(Bytes(line), 1)
    if parsed.error != "" { result.error = parsed.error; return result }
    if !parsed.raw.startsWith("minyar.constant|") || !(parsed.raw.endsWith("|value") || parsed.raw.endsWith("|state")) { return result }
    let tail = host.strip(host.textSlice(line, parsed.end, line.byteLength))
    if !tail.startsWith("= internal global ") { result.error = "unsupported module state cell linkage"; return result }
    let words = host.words(host.textAfter(tail, "= internal global "))
    if words.length != 2 || !(scalar(words[0]) || words[0] == "i8") { result.error = "unsupported module state cell layout"; return result }
    result.raw = parsed.raw; result.token = parsed.token; result.type = words[0]; result.value = words[1]
    return result
}
function rootCell(line: Text, initial: Boolean, cells: Map<Text, Text>): Rewritten {
    let cell = cellOf(line)
    if cell.error != "" { return Rewritten { text: ""; error: cell.error } }
    if cell.raw == "" { return Rewritten { text: line; error: "" } }
    if initial { return Rewritten { text: "@" + cell.token + " = global " + cell.type + " " + cell.value; error: "" } }
    // A new global needs its initializer to run, which only a fresh start does.
    if !cells.has(cell.raw) { return Rewritten { text: ""; error: "hot reload cannot add module state (" + readableCell(cell.raw) + "); stop and run again" } }
    if cells[cell.raw] != cell.type { return Rewritten { text: ""; error: "hot reload changed the type of module state (" + readableCell(cell.raw) + "); stop and run again" } }
    return Rewritten { text: "@" + cell.token + " = external global " + cell.type; error: "" }
}
function readableCell(raw: Text): Text {
    let parts = raw.split("|")
    if parts.length >= 2 { return parts[1] }
    return raw
}
// A source-level name for messages: module prefixes dropped.
public function readable(name: Text): Text {
    let result = name
    if result.startsWith(".minyar.fn.") { result = host.textAfter(result, ".minyar.fn.") }
    if result.startsWith("minyar.module|") {
        let parts = result.split("|")
        if parts.length >= 2 { result = parts[1] }
    }
    if result.startsWith("minyar_module_") {
        let rest = host.textAfter(result, "minyar_module_")
        let separator = host.findText(rest, "_", 0)
        if separator >= 0 { result = host.textSlice(rest, separator + 1, rest.byteLength) }
    }
    return result
}
function wrapper(function: Function, index: Integer, generation: Integer): Text {
    let key = "minyar.live." + Text(generation) + ".key." + Text(index)
    let output: List<Text> = ["@" + key + " = private unnamed_addr constant [" + Text(function.raw.byteLength + 1) + " x i8] c\"" + escaped(function.raw) + "\\00\"\n"]
    // Each wrapper keeps its current target in a slot. The runtime fills it on
    // the first call and retargets it when a publication's epoch is first
    // seen, so an ordinary call costs a few loads and an indirect branch.
    let slot = "minyar.live." + Text(generation) + ".slot." + Text(index)
    output.add("@" + slot + " = internal global ptr null, align 8\n")
    output.add("define " + function.result + " @" + function.wrapper + "(" + function.parameters + ") noinline uwtable {\nentry:\n")
    // The page pointer is set once, possibly while a parallel loop's workers
    // already call wrappers; the seen epoch is stored after the slots it covers.
    output.add("  %live.page = load atomic ptr, ptr @minyar_live_epoch unordered, align 8\n")
    output.add("  %live.epoch = load atomic i64, ptr %live.page acquire, align 8\n")
    output.add("  %live.seen = load atomic i64, ptr @minyar_live_epoch_seen acquire, align 8\n")
    output.add("  %live.cached = load atomic ptr, ptr @" + slot + " acquire, align 8\n")
    output.add("  %live.current = icmp eq i64 %live.epoch, %live.seen\n  %live.bound = icmp ne ptr %live.cached, null\n")
    output.add("  %live.ready = and i1 %live.current, %live.bound\n  br i1 %live.ready, label %live.call, label %live.bind\nlive.bind:\n")
    output.add("  %live.resolved = call ptr @minyar_live_bind(ptr @" + key + ", ptr @" + function.body + ", ptr @" + slot + ")\n  br label %live.call\nlive.call:\n")
    output.add("  %live.target = phi ptr [ %live.cached, %entry ], [ %live.resolved, %live.bind ]\n")
    if function.returned == "void" {
        output.add("  call void %live.target(" + function.arguments + ")\n  ret void\n}\n")
    } else {
        output.add("  %live.result = call " + function.result + " %live.target(" + function.arguments + ")\n  ret " + function.returned + " %live.result\n}\n")
    }
    return joinText(output)
}

record Parsed { functions: List<Function>; starts: List<Integer>; ends: List<Integer>; lines: List<Text>; globals: Map<Text, Text>; variables: List<Text>; error: Text }
function parse(llvm: Text, generation: Integer, initial: Boolean): Parsed {
    let result = Parsed { functions: []; starts: []; ends: []; lines: host.lines(llvm); globals: Map<Text, Text>(); variables: []; error: "" }
    if generation < 0 { result.error = "live generation must be nonnegative"; return result }
    // Managed threads and parallel loop workers may call wrappers concurrently.
    let seen = Map<Text, Boolean>()
    let inFunction = false
    let continuing = ""
    for position in 0..result.lines.length {
        let line = result.lines[position]
        if line.startsWith("define ") {
            if inFunction { result.error = "generated LLVM contains a nested function definition"; return result }
            let function = definition(line, generation, result.functions.length, initial)
            if function.error != "" { result.error = function.error; return result }
            if seen.has(function.raw) { result.error = "generated LLVM repeats a function definition"; return result }
            seen[function.raw] = true
            result.functions.add(function)
            result.starts.add(position)
            inFunction = true
        } else if line == "}" {
            if !inFunction { result.error = "generated LLVM has an unexpected function closing brace"; return result }
            result.ends.add(position)
            // Closures and other generated helpers are not language functions:
            // their code counts toward every fingerprint that reaches them.
            let closing = result.functions.length - 1
            if !result.functions[closing].language { result.globals[result.functions[closing].raw] = bodyText(result, closing) }
            inFunction = false
        } else if !inFunction && line.startsWith("@") {
            let global = symbol(Bytes(line), 1)
            continuing = ""
            if global.error == "" { result.globals[global.raw] = line; result.variables.add(global.raw); continuing = global.raw }
        } else if !inFunction && continuing != "" && line != "" && !line.startsWith("declare ") && !line.startsWith("%") &&
                !line.startsWith(";") && !line.startsWith("!") && !line.startsWith("attributes ") {
            // A table initializer can span lines (say, an integer dispatch table):
            // its later lines belong to the same global's fingerprint.
            result.globals[continuing] = result.globals[continuing] + "\n" + line
        } else if !inFunction { continuing = "" }
    }
    if inFunction { result.error = "generated LLVM is missing a function closing brace"; return result }
    if result.functions.length == 0 { result.error = "generated LLVM contains no functions"; return result }
    return result
}
function bodyText(parsed: Parsed, index: Integer): Text {
    let parts: List<Text> = []
    for position in parsed.starts[index]..(parsed.ends[index] + 1) { parts.add(parsed.lines[position]); parts.add("\n") }
    return joinText(parts)
}
// What every image must agree on, one entry per language function and per
// type definition, native layout, native library or runtime requirement.
function signatureLine(keys: List<Text>, line: Text) {
    if (line.startsWith("%") && host.hasText(line, " = type ")) ||
            line.startsWith("; minyar-c-layout: ") || line.startsWith("; minyar-c-value: ") ||
            line.startsWith("; minyar-native-library: ") || line == "; minyar-cycle-runtime: 1" ||
            line == "; minyar-callback-runtime: 1" || line == "; minyar-sort-callback-runtime: 1" {
        keys.add("line:" + line)
    }
}
// The ABI signature covers every language function, reachable or not, so a
// body edit that starts or stops calling one is still a body edit.
function imageSignature(parsed: Parsed): Text {
    let keys: List<Text> = []
    let values: List<Text> = []
    let current = 0
    for line in parsed.lines {
        if line.startsWith("define ") {
            if parsed.functions[current].language { keys.add("function:" + parsed.functions[current].raw); values.add(parsed.functions[current].signature) }
            current += 1
        }
        let before = keys.length
        signatureLine(keys, line)
        if keys.length != before { values.add("") }
    }
    return "live-image-v2\n" + encodePairs(keys, values)
}
// "" when an update with signature `after` can run in the executable built with
// `before`: every original function keeps its signature, every original type
// and runtime requirement stays, and anything new is a function or a type.
public function compatibility(before: Text, after: Text): Text {
    if !before.startsWith("live-image-v2\n") || !after.startsWith("live-image-v2\n") { return "the live session's signature is from another toolchain; stop and run again" }
    let old = decodeFields(host.textAfter(before, "live-image-v2\n"))
    let new = decodePairs(host.textAfter(after, "live-image-v2\n"))
    if old.length == 0 || new.length == 0 { return "the live session's signature is malformed; stop and run again" }
    let known = Map<Text, Boolean>()
    let index = 0
    while index < old.length {
        let key = old[index]
        known[key] = true
        if key.startsWith("function:") {
            let name = readable(host.textAfter(key, "function:"))
            if !new.has(key) { return "hot reload cannot remove or rename " + name + ", which the running program contains; stop and run again" }
            if new[key] != old[index + 1] { return "hot reload changed a compiled function signature (" + name + "); stop and run again" }
        } else if !new.has(key) {
            if key.startsWith("line:%") { return "hot reload changed a record or type layout; stop and run again" }
            return "hot reload changed a native library or runtime requirement; stop and run again"
        }
        index += 2
    }
    let added = decodeFields(host.textAfter(after, "live-image-v2\n"))
    index = 0
    while index < added.length {
        let key = added[index]
        if !known.has(key) && !key.startsWith("function:") && !key.startsWith("line:%") {
            return "hot reload cannot add native code or a runtime requirement (" + host.textAfter(key, "line:") + "); stop and run again"
        }
        index += 2
    }
    return ""
}
function imageDigests(parsed: Parsed): Text {
    let keys: List<Text> = []
    let values: List<Text> = []
    for index in 0..parsed.functions.length {
        if parsed.functions[index].language {
            keys.add(parsed.functions[index].raw)
            values.add(digest(bodyText(parsed, index), parsed.globals))
        }
    }
    return encodePairs(keys, values)
}
function publicDefinition(line: Text, from: Text, to: Text): Text {
    let result = host.replaceText(line, "@" + from + "(", "@" + to + "(")
    result = host.replaceText(result, "define internal ", "define ")
    result = host.replaceText(result, "define private ", "define ")
    return host.replaceText(result, "define hidden ", "define ")
}

// Internal functions no root reaches, the same ones an ordinary LTO build drops.
// Roots are functions with external linkage and everything a global refers to.
function reachable(parsed: Parsed): List<Boolean> {
    let index = Map<Text, Integer>()
    let kept: List<Boolean> = []
    let pending: List<Text> = []
    for position in 0..parsed.functions.length {
        index[parsed.functions[position].raw] = position
        kept.add(false)
        let header = parsed.lines[parsed.starts[position]]
        if !header.startsWith("define internal ") && !header.startsWith("define private ") { pending.add(parsed.functions[position].raw) }
    }
    for name in parsed.variables { for target in references(parsed.globals[name]) { pending.add(target) } }
    let next = 0
    while next < pending.length {
        let name = pending[next]
        next += 1
        if !index.has(name) || kept[index[name]] { continue }
        let position = index[name]
        kept[position] = true
        for target in references(bodyText(parsed, position)) { pending.add(target) }
    }
    return kept
}

// Live builds drop unreachable functions, so code an ordinary build would not
// link (say, OS-only machine helpers in a hosted program) is not wrapped either.
public function transformProgram(llvm: Text, generation: Integer, initial: Boolean): Image {
    return transformWith(llvm, generation, initial, true)
}
public function transform(llvm: Text, generation: Integer, initial: Boolean): Image {
    return transformWith(llvm, generation, initial, false)
}
function runtimeDeclarations(): Text {
    return "declare ptr @minyar_live_bind(ptr, ptr, ptr)\n@minyar_live_epoch = external global ptr\n@minyar_live_epoch_seen = external global i64\n"
}
function transformWith(llvm: Text, generation: Integer, initial: Boolean, prune: Boolean): Image {
    let parsed = parse(llvm, generation, initial)
    if parsed.error != "" { return failed(parsed.error) }
    let functions = parsed.functions
    let kept: List<Boolean> = []
    if prune { kept = reachable(parsed) } else { for function in functions { kept.add(true) } }
    let namesBySymbol = Map<Text, Text>()
    for function in functions { namesBySymbol[function.raw] = function.wrapper }
    let output: List<Text> = []
    let names: List<Text> = []
    let symbols: List<Text> = []
    let digestKeys: List<Text> = []
    let exportValues: List<Text> = []
    let cellNames: List<Text> = []
    let cellTypes: List<Text> = []
    let current = 0
    let skipping = false
    for position in 0..parsed.lines.length {
        let line = parsed.lines[position]
        if line.startsWith("define ") && !kept[current] {
            skipping = true
            current += 1
        }
        if skipping {
            if position == parsed.ends[current - 1] { skipping = false }
            continue
        }
        let cell = cellOf(line)
        if cell.raw != "" { cellNames.add(cell.raw); cellTypes.add(cell.type) }
        let state = rootCell(line, true, Map<Text, Text>())
        if state.error != "" { return failed(state.error) }
        if !initial && cell.raw != "" { state.text = "@" + cell.token + " = external global " + cell.type }
        let replaced = renamed(state.text, namesBySymbol)
        if replaced.error != "" { return failed(replaced.error) }
        let result = replaced.text
        if line.startsWith("define ") {
            let function = functions[current]
            if function.language {
                result = publicDefinition(result, function.wrapper, function.body)
                names.add(function.raw)
                symbols.add(function.body)
                digestKeys.add(function.raw)
                exportValues.add(function.wrapper)
            }
            current += 1
        }
        output.add(result + "\n")
    }
    output.add(runtimeDeclarations())
    for index in 0..functions.length { if functions[index].language && kept[index] { output.add(wrapper(functions[index], index, generation)) } }
    return Image { llvm: joinText(output); names: names; symbols: symbols; signature: imageSignature(parsed);
        digests: imageDigests(parsed); exports: encodePairs(digestKeys, exportValues); cells: encodePairs(cellNames, cellTypes);
        shapes: genericShapes(parsed); added: []; error: "" }
}

// An update image holds the functions whose fingerprint differs from the
// original executable's (`published`), so each table is complete on its own:
// a function it omits runs its original body. Calls to original functions go
// through the original executable's wrappers (`exports`).
//
// Functions the executable does not contain are added: an ordinary function
// gets a wrapper and slot of its own in this image, listed in the table like
// any replaced function, so a later update (which carries it again) retargets
// every copy, including function values already handed out. A machine
// intrinsic is inlined, so its body is simply emitted for this image.
public function transformUpdate(llvm: Text, generation: Integer, original: Session): Image {
    let parsed = parse(llvm, generation, false)
    if parsed.error != "" { return failed(parsed.error) }
    let instances = genericChange(parsed, original.shapes)
    if instances != "" { return failed(instances) }
    let published = original.digests
    let exports = original.exports
    let cells = original.cells
    let functions = parsed.functions
    let kept = reachable(parsed)
    let namesBySymbol = Map<Text, Text>()
    let changed: List<Boolean> = []
    let fresh: List<Boolean> = []
    let wrapped = false
    let added: List<Text> = []
    for index in 0..functions.length {
        let function = functions[index]
        fresh.add(false)
        if !kept[index] { changed.add(false); continue }
        if !function.language { namesBySymbol[function.raw] = function.wrapper; changed.add(true); continue }
        if !exports.has(function.raw) {
            fresh[index] = true
            changed.add(true)
            let header = parsed.lines[parsed.starts[index]]
            if header.startsWith("define internal ") || header.startsWith("define private ") { namesBySymbol[function.raw] = function.body }
            else { namesBySymbol[function.raw] = function.wrapper; wrapped = true; added.add(function.raw) }
            continue
        }
        namesBySymbol[function.raw] = exports[function.raw]
        let fingerprint = digest(bodyText(parsed, index), parsed.globals)
        changed.add(!published.has(function.raw) || published[function.raw] != fingerprint)
    }
    let output: List<Text> = []
    let names: List<Text> = []
    let symbols: List<Text> = []
    let current = -1
    let skipping = false
    for position in 0..parsed.lines.length {
        let line = parsed.lines[position]
        if line.startsWith("define ") {
            current += 1
            skipping = !kept[current] || (functions[current].language && !changed[current])
        }
        if skipping {
            if position == parsed.ends[current] { skipping = false }
            continue
        }
        let state = rootCell(line, false, cells)
        if state.error != "" { return failed(state.error) }
        let replaced = renamed(state.text, namesBySymbol)
        if replaced.error != "" { return failed(replaced.error) }
        let result = replaced.text
        if line.startsWith("define ") && functions[current].language {
            let function = functions[current]
            if !fresh[current] {
                result = publicDefinition(result, exports[function.raw], function.body)
                names.add(function.raw)
                symbols.add(function.body)
            } else if namesBySymbol[function.raw] == function.wrapper {
                result = publicDefinition(result, function.wrapper, function.body)
                names.add(function.raw)
                symbols.add(function.body)
            }
        }
        output.add(result + "\n")
    }
    for index in 0..functions.length {
        let function = functions[index]
        if !function.language || !kept[index] || fresh[index] { continue }
        let types: List<Text> = []
        if function.parameters != "" { for parameter in function.parameters.split(", ") { types.add(host.words(parameter)[0]) } }
        output.add("declare " + function.result + " @" + exports[function.raw] + "(" + host.joined(types, ", ") + ")\n")
    }
    if wrapped {
        output.add(runtimeDeclarations())
        for index in 0..functions.length { if fresh[index] && namesBySymbol[functions[index].raw] == functions[index].wrapper { output.add(wrapper(functions[index], index, generation)) } }
    }
    return Image { llvm: joinText(output); names: names; symbols: symbols; signature: imageSignature(parsed);
        digests: imageDigests(parsed); exports: ""; cells: ""; shapes: ""; added: added; error: "" }
}

// Generic instances are numbered by first use (minyar_generic_function_<N>_),
// so an edit can give an existing name to another instantiation. Their code
// apart from their own name tells instances apart.
function genericInstance(raw: Text): Boolean { return host.hasText(raw, "minyar_generic_function_") }
function shapeOf(parsed: Parsed, index: Integer): Text {
    let body = bodyText(parsed, index)
    return host.hashBytes(Bytes(host.replaceText(body, parsed.functions[index].name, "<self>")))
}
function genericShapes(parsed: Parsed): Text {
    let keys: List<Text> = []
    let values: List<Text> = []
    for index in 0..parsed.functions.length {
        if parsed.functions[index].language && genericInstance(parsed.functions[index].raw) { keys.add(parsed.functions[index].raw); values.add(shapeOf(parsed, index)) }
    }
    return encodePairs(keys, values)
}
// "" unless existing generic instance names may now name other instantiations:
// instances were added or removed while an existing one's code changed, or an
// existing instance now has exactly the code another one had.
function genericChange(parsed: Parsed, shapes: Map<Text, Text>): Text {
    let restart = "hot reload cannot tell generic instantiations apart after this edit (it adds, removes or reorders uses of generic functions while an existing instantiation changed); stop and run again"
    let now = Map<Text, Text>()
    let names: List<Text> = []
    for index in 0..parsed.functions.length {
        if parsed.functions[index].language && genericInstance(parsed.functions[index].raw) {
            now[parsed.functions[index].raw] = shapeOf(parsed, index)
            names.add(parsed.functions[index].raw)
        }
    }
    let sameSet = true
    for name in names { if !shapes.has(name) { sameSet = false } }
    let before = Map<Text, Text>()
    for name in shapes {
        if !now.has(name) { sameSet = false }
        before[shapes[name]] = name
    }
    for name in names {
        if !shapes.has(name) || shapes[name] == now[name] { continue }
        if !sameSet { return restart }
        if before.has(now[name]) && before[now[name]] != name { return restart }
    }
    return ""
}
