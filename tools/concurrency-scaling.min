use "./concurrency-scaling-model.min" as scaling
use "./testing.min" as test

function option(options: Map<Text, Text>, name: Text, fallback: Text): Text { if options.has(name) { return options[name] }; return fallback }
function value(index: Integer, option: Text): Text { if index >= argumentCount() { fail("argument " + option + ": expected one argument") }; return argument(index) }
test.check(argumentCount() > 0, "the following arguments are required: command")
let command = argument(0)
let positional: List<Text> = []
let options = Map<Text, Text>()
let index = 1
while index < argumentCount() {
    let option = argument(index)
    if option.startsWith("--") {
        let raw = Bytes(option)
        let equals = -1
        for position in 0..raw.length { if equals < 0 && raw[position] == 61 { equals = position } }
        if equals > 0 { options[Text(raw.slice(0, equals))] = Text(raw.slice(equals + 1, raw.length)) }
        else { index += 1; options[option] = value(index, option) }
    } else { positional.add(option) }
    index += 1
}
if command == "register" {
    test.check(positional.length == 2, "register requires executable and protocol")
    for name in options { test.check(name == "--lowered-llvm" || name == "--candidate-sha" || name == "--compiler-sha" || name == "--runtime-sha" || name == "--build-flags" || name == "--memory-profile" || name == "--clang" || name == "--control-executable" || name == "--control-sha", "unrecognized arguments: " + name) }
    for name in ["--lowered-llvm", "--candidate-sha", "--compiler-sha", "--runtime-sha", "--build-flags", "--memory-profile"] { test.check(options.has(name), "the following arguments are required: " + name) }
    let memory = options["--memory-profile"]
    test.check(memory == "system" || memory == "eager", "argument --memory-profile: invalid choice: '" + memory + "' (choose from 'system', 'eager')")
    let control = option(options, "--control-executable", "")
    test.check(control == "" || option(options, "--control-sha", "") != "", "--control-sha is required with --control-executable")
    let host = scaling.realHost()
    scaling.register(host, positional[0], positional[1], options["--lowered-llvm"], options["--candidate-sha"], options["--compiler-sha"], options["--runtime-sha"], options["--build-flags"], memory, option(options, "--clang", "clang"), control, option(options, "--control-sha", ""))
    test.removeTree(host.directory)
} else if command == "run" {
    test.check(positional.length == 2, "run requires protocol and results")
    let item = -1
    for name in options { test.check(name == "--item", "unrecognized arguments: " + name) }
    if options.has("--item") {
        item = Integer(options["--item"])
        test.check(item >= 0 && item < scaling.WARMUPS + scaling.ROUNDS, "argument --item: invalid choice: " + options["--item"])
    }
    let host = scaling.realHost()
    let result = scaling.run(host, positional[0], positional[1], item)
    test.removeTree(host.directory)
    if result.error != "" { fail(result.error) }
} else { fail("argument command: invalid choice: '" + command + "' (choose from 'register', 'run')") }
