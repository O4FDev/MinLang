#!/bin/bash
# The `make` a shard's check runner finds first on PATH. The tree's own tools/check-in-parallel launches every check
# and shared build of the full gate as a top-level `make` in the tree with MINYAR_CHECK_LABEL set; the ones packed onto
# other shards (listed in FAST_GATE_SKIP) finish here at once and count only on their own shard. Every other make,
# including every make a check runs, is the real one. The start of each check or build this shard runs is appended to
# FAST_GATE_TIMELINE (the runner records how long each took).
if [[ -z ${MAKELEVEL:-} && -n ${MINYAR_CHECK_LABEL:-} && -n ${FAST_GATE_SKIP:-} && $(pwd -P) == "${FAST_GATE_ROOT:-}" ]]; then
  if grep -qxF -- "$MINYAR_CHECK_LABEL" "$FAST_GATE_SKIP"; then
    echo "fast-gate: $MINYAR_CHECK_LABEL runs on another shard"
    exit 0
  fi
  [[ -n ${FAST_GATE_TIMELINE:-} ]] && echo "$(date +%s.%N) $MINYAR_CHECK_LABEL" >> "$FAST_GATE_TIMELINE"
fi
exec /usr/bin/make "$@"
