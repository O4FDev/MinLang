use "files" as files
use "system" as system
use "./generator.min" as generator
use "./google/protobuf/compiler/plugin.min" as plugin
// protoc-gen-minyar: a protoc and Buf plugin that generates Minyar code.
// protoc writes a CodeGeneratorRequest to standard input and reads a
// CodeGeneratorResponse from standard output.

function readInput(): Bytes {
    let input = Bytes()
    while true {
        let count = system.readTerminal(0, input, 65536)
        if count == 0 { return input }
        if count < 0 {
            system.writeStandardError("protoc-gen-minyar: cannot read standard input\n")
            exit(1)
        }
    }
}

function writeOutput(data: Bytes) {
    let offset = 0
    while offset < data.length {
        let count = files.write(1, data, offset, data.length - offset)
        if count <= 0 {
            system.writeStandardError("protoc-gen-minyar: cannot write standard output\n")
            exit(1)
        }
        offset += count
    }
}

match plugin.decodeCodeGeneratorRequest(readInput()) {
    Ok(request) { writeOutput(generator.generate(request).encode()) }
    Err(problem) {
        system.writeStandardError("protoc-gen-minyar: " + problem.message() + "\n")
        exit(1)
    }
}
