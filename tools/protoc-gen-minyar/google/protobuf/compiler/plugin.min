// Hand-written bootstrap for google/protobuf/compiler/plugin.proto: the plugin
// reads CodeGeneratorRequest and writes CodeGeneratorResponse, in the form the
// generator emits. Other fields are kept as unknown fields.
use "errors" as errors
use "protobuf" as protobuf
use "protobuf-descriptor" as google_protobuf_descriptor

/// `google.protobuf.compiler.CodeGeneratorRequest`
public record CodeGeneratorRequest {
    fileToGenerate: List<Text>
    parameter: Maybe<Text>
    protoFile: List<google_protobuf_descriptor.FileDescriptorProto>
    unknownFields: Bytes
}

public function newCodeGeneratorRequest(): CodeGeneratorRequest {
    return CodeGeneratorRequest { fileToGenerate: []; parameter: None; protoFile: []; unknownFields: Bytes() }
}

public function CodeGeneratorRequest.parameter(): Text {
    if self.parameter is Some(value) { return value }
    return ""
}

public function decodeCodeGeneratorRequest(data: Bytes): Result<CodeGeneratorRequest, errors.Error> {
    let reader = protobuf.reader(data)
    let message = newCodeGeneratorRequest()
    readCodeGeneratorRequest(reader, message)
    if reader.failed() { return Err(reader.failure()) }
    return Ok(message)
}

public function readCodeGeneratorRequest(reader: protobuf.Reader, message: CodeGeneratorRequest) {
    while reader.more() {
        let tag = reader.readTag()
        match tag {
            10 { message.fileToGenerate.add(reader.readText()) }
            18 { message.parameter = Some(reader.readText()) }
            122 {
                let outer = reader.enter()
                if outer >= 0 {
                    let created = google_protobuf_descriptor.newFileDescriptorProto()
                    google_protobuf_descriptor.readFileDescriptorProto(reader, created)
                    message.protoFile.add(created)
                    reader.leave(outer)
                }
            }
            _ { reader.keep(tag, message.unknownFields) }
        }
    }
}

/// `google.protobuf.compiler.CodeGeneratorResponse`
public record CodeGeneratorResponse {
    error: Maybe<Text>
    supportedFeatures: Maybe<Integer>
    file: List<CodeGeneratorResponse_File>
    unknownFields: Bytes
}

public function newCodeGeneratorResponse(): CodeGeneratorResponse {
    return CodeGeneratorResponse { error: None; supportedFeatures: None; file: []; unknownFields: Bytes() }
}

public function CodeGeneratorResponse.encode(): Bytes {
    let out = Bytes()
    writeCodeGeneratorResponse(out, self)
    return out
}

public function writeCodeGeneratorResponse(out: Bytes, message: CodeGeneratorResponse) {
    if message.error is Some(value) {
        protobuf.writeVarint(out, 10)
        protobuf.writeText(out, value)
    }
    if message.supportedFeatures is Some(value) {
        protobuf.writeVarint(out, 16)
        protobuf.writeVarint(out, value)
    }
    for value in message.file {
        protobuf.writeVarint(out, 122)
        let inner = Bytes()
        writeCodeGeneratorResponse_File(inner, value)
        protobuf.writeDelimited(out, inner)
    }
    out.addBytes(message.unknownFields)
}

/// `google.protobuf.compiler.CodeGeneratorResponse.File`
public record CodeGeneratorResponse_File {
    name: Maybe<Text>
    content: Maybe<Text>
    unknownFields: Bytes
}

public function newCodeGeneratorResponse_File(): CodeGeneratorResponse_File {
    return CodeGeneratorResponse_File { name: None; content: None; unknownFields: Bytes() }
}

public function writeCodeGeneratorResponse_File(out: Bytes, message: CodeGeneratorResponse_File) {
    if message.name is Some(value) {
        protobuf.writeVarint(out, 10)
        protobuf.writeText(out, value)
    }
    if message.content is Some(value) {
        protobuf.writeVarint(out, 122)
        protobuf.writeText(out, value)
    }
    out.addBytes(message.unknownFields)
}
