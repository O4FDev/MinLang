use "protobuf-descriptor" as descriptor
use "./google/protobuf/compiler/plugin.min" as plugin
// protoc-gen-minyar's code generator: one Minyar module per .proto file, with
// records for messages, choices for enums and oneofs, and their encodings.

// Field kinds are google.protobuf.FieldDescriptorProto.Type numbers.
constant DOUBLE = 1
constant FLOAT = 2
constant INT64 = 3
constant UINT64 = 4
constant INT32 = 5
constant FIXED64 = 6
constant FIXED32 = 7
constant BOOL = 8
constant STRING = 9
constant GROUP = 10
constant MESSAGE = 11
constant BYTES = 12
constant UINT32 = 13
constant ENUM = 14
constant SFIXED32 = 15
constant SFIXED64 = 16
constant SINT32 = 17
constant SINT64 = 18

// CodeGeneratorResponse.Feature: FEATURE_PROTO3_OPTIONAL.
constant SUPPORTED_FEATURES = 1

// The well-known types are bundled with the standard library as flat
// packages: google/protobuf/timestamp.proto is `use "protobuf-timestamp"`.
global BUNDLED: List<Text> = ["any", "api", "descriptor", "duration", "empty", "field_mask", "source_context", "struct", "timestamp", "type", "wrappers"]

// Type names that would hide a built-in type.
global RESERVED_TYPES: List<Text> = ["Integer", "Float", "Boolean", "Text", "Bytes", "Character", "Nothing", "List", "Map", "Set", "Maybe", "Result", "Self", "Some", "None", "Ok", "Err", "Iterable", "Iterator", "Equatable", "Ordered", "Hashable"]

/// One message or enum, anywhere in the request.
record TypeInfo {
    // The full proto name without a leading dot, such as `pkg.Outer.Inner`.
    fullName: Text
    file: Text
    // The Minyar type name inside its own module, such as `Outer_Inner`.
    local: Text
    isEnum: Boolean
    proto3: Boolean
    message: descriptor.DescriptorProto
    enumeration: descriptor.EnumDescriptorProto
    // Minyar case names for enums, parallel to enumeration.value; aliases get "".
    cases: List<Text>
}

/// Everything the generator knows about one field of a message.
record Field {
    name: Text
    protoName: Text
    jsonName: Text
    number: Integer
    kind: Integer
    repeated: Boolean
    packed: Boolean
    // Explicit presence: the field is a Maybe.
    presence: Boolean
    // The full name of a message or enum type, or "".
    typeName: Text
    defaultValue: Text
    hasDefault: Boolean
    // Index into the message's oneofs, or -1.
    oneof: Integer
    // The oneof choice's case name for a oneof member.
    caseName: Text
    // A map field's key and value, as fields 1 and 2 of its entry.
    entry: List<Field>
    // A map whose values could reach its own message is a List of entry records.
    entryList: Boolean
    entryType: Text
}

record Oneof {
    name: Text
    protoName: Text
    typeName: Text
    fields: List<Field>
}

record Message {
    info: TypeInfo
    fields: List<Field>
    oneofs: List<Oneof>
}

record Generator {
    types: List<TypeInfo>
    index: Map<Text, Integer>
    files: Map<Text, Integer>
    request: plugin.CodeGeneratorRequest
}

record Module {
    generator: Generator
    file: descriptor.FileDescriptorProto
    lines: List<Text>
    // Imported proto files and their aliases, in first-use order.
    imports: List<Text>
    aliases: List<Text>
    // Files with services import the rpc and connect modules.
    usesRpc: Boolean
    usesConnect: Boolean
    // Local type names, so oneof choices avoid them.
    names: Set<Text>
}

// ----- Names -----

function isUpper(c: Character): Boolean { return c >= 'A' && c <= 'Z' }
function isLower(c: Character): Boolean { return c >= 'a' && c <= 'z' }
function isDigit(c: Character): Boolean { return c >= '0' && c <= '9' }
function upperOf(c: Character): Character {
    if isLower(c) { return Character(Integer(c) - 32) }
    return c
}
function lowerOf(c: Character): Character {
    if isUpper(c) { return Character(Integer(c) + 32) }
    return c
}

/// protoc's lowerCamelCase: underscores are removed and the letter after one
/// is capitalized.
function camel(name: Text): Text {
    let parts: List<Text> = []
    let upperNext = false
    for c in name {
        if c == '_' {
            upperNext = true
        } else if upperNext {
            parts.add(Text(upperOf(c)))
            upperNext = false
        } else {
            parts.add(Text(c))
        }
    }
    return joinText(parts)
}

function capitalized(name: Text): Text {
    if name.length == 0 { return name }
    return Text(upperOf(name[0])) + name.slice(1, name.length)
}

function decapitalized(name: Text): Text {
    if name.length == 0 { return name }
    return Text(lowerOf(name[0])) + name.slice(1, name.length)
}

function identifierOnly(name: Text): Text {
    let parts: List<Text> = []
    for c in name {
        if isUpper(c) || isLower(c) || isDigit(c) || c == '_' { parts.add(Text(c)) } else { parts.add("_") }
    }
    return joinText(parts)
}

function typeName(name: Text): Text {
    let result = capitalized(identifierOnly(name))
    if result.length == 0 || !isUpper(result[0]) { result = "M" + result }
    for reserved in RESERVED_TYPES { if result == reserved { return result + "_" } }
    return result
}

function fieldName(protoName: Text): Text {
    let result = decapitalized(camel(identifierOnly(protoName)))
    if result.length == 0 || isDigit(result[0]) { result = "field" + result }
    return result
}

function caseName(name: Text): Text {
    let result = capitalized(identifierOnly(name))
    if result.length == 0 || !isUpper(result[0]) { result = "V" + result }
    if result == "Some" || result == "None" || result == "Ok" || result == "Err" || result == "Unrecognized" { result = result + "_" }
    return result
}

function unique(name: Text, taken: Set<Text>): Text {
    let result = name
    let counter = 2
    while taken.contains(result) {
        result = name + "_" + Text(counter)
        counter += 1
    }
    taken.add(result)
    return result
}

function quoted(value: Text): Text {
    let parts: List<Text> = ["\""]
    for c in value {
        if c == '"' { parts.add("\\\"") }
        else if c == '\\' { parts.add("\\\\") }
        else if c == '\n' { parts.add("\\n") }
        else if c == '\r' { parts.add("\\r") }
        else if c == '\t' { parts.add("\\t") }
        else if Integer(c) < 32 { parts.add("\" + Text(Character(" + Text(Integer(c)) + ")) + \"") }
        else { parts.add(Text(c)) }
    }
    parts.add("\"")
    return joinText(parts)
}

function withoutDot(name: Text): Text {
    if name.length > 0 && name[0] == '.' { return name.slice(1, name.length) }
    return name
}

// ----- Indexing the request -----

function newGenerator(request: plugin.CodeGeneratorRequest): Generator {
    let generator = Generator { types: []; index: Map(); files: Map(); request: request }
    for position in 0..request.protoFile.length {
        let file = request.protoFile[position]
        generator.files[file.name()] = position
        let prefix = file.package()
        let proto3 = file.syntax() == "proto3"
        let taken: Set<Text> = Set()
        for message in file.messageType { indexMessage(generator, file.name(), prefix, "", message, proto3, taken) }
        for enumeration in file.enumType { indexEnum(generator, file.name(), prefix, "", enumeration, proto3, taken) }
    }
    return generator
}

function joinedName(prefix: Text, name: Text): Text {
    if prefix == "" { return name }
    return prefix + "." + name
}

function joinedLocal(outer: Text, name: Text): Text {
    if outer == "" { return typeName(name) }
    return outer + "_" + capitalized(identifierOnly(name))
}

function indexMessage(generator: Generator, file: Text, scope: Text, outer: Text, message: descriptor.DescriptorProto, proto3: Boolean, taken: Set<Text>) {
    let fullName = joinedName(scope, message.name())
    let local = unique(joinedLocal(outer, message.name()), taken)
    generator.index[fullName] = generator.types.length
    generator.types.add(TypeInfo { fullName: fullName; file: file; local: local; isEnum: false; proto3: proto3; message: message; enumeration: descriptor.newEnumDescriptorProto(); cases: [] })
    for nested in message.nestedType { indexMessage(generator, file, fullName, local, nested, proto3, taken) }
    for enumeration in message.enumType { indexEnum(generator, file, fullName, local, enumeration, proto3, taken) }
}

function indexEnum(generator: Generator, file: Text, scope: Text, outer: Text, enumeration: descriptor.EnumDescriptorProto, proto3: Boolean, taken: Set<Text>) {
    let fullName = joinedName(scope, enumeration.name())
    let local = unique(joinedLocal(outer, enumeration.name()), taken)
    let cases: List<Text> = []
    let seen: Set<Integer> = Set()
    let caseNames: Set<Text> = Set()
    for value in enumeration.value {
        if seen.contains(value.number()) {
            cases.add("")
        } else {
            seen.add(value.number())
            cases.add(unique(caseName(value.name()), caseNames))
        }
    }
    generator.index[fullName] = generator.types.length
    generator.types.add(TypeInfo { fullName: fullName; file: file; local: local; isEnum: true; proto3: proto3; message: descriptor.newDescriptorProto(); enumeration: enumeration; cases: cases })
}

function Generator.type(fullName: Text): TypeInfo {
    let name = withoutDot(fullName)
    if !self.index.has(name) { fail("protoc-gen-minyar: unknown type " + name) }
    return self.types[self.index[name]]
}

function isMapEntry(info: TypeInfo): Boolean {
    if info.isEnum { return false }
    if info.message.options is Some(options) { return options.mapEntry() }
    return false
}

/// Whether a value of `from` can contain a value of `target`, through message
/// fields, lists and maps.
function reaches(generator: Generator, from: Text, target: Text, visited: Set<Text>): Boolean {
    if from == target { return true }
    if visited.contains(from) { return false }
    visited.add(from)
    let info = generator.type(from)
    if info.isEnum { return false }
    for field in info.message.field {
        if field.type().number() == MESSAGE || field.type().number() == GROUP {
            if reaches(generator, withoutDot(field.typeName()), target, visited) { return true }
        }
    }
    return false
}

// ----- Fields -----

function fieldOf(generator: Generator, owner: TypeInfo, proto: descriptor.FieldDescriptorProto, taken: Set<Text>): Field {
    let kind = proto.type().number()
    let repeated = proto.label().number() == 3
    let name = fieldName(proto.name())
    if name == "unknownFields" { name = name + "_" }
    let presence = false
    if !repeated {
        if kind == MESSAGE || kind == GROUP { presence = true }
        else if !owner.proto3 { presence = true }
        else if proto.proto3Optional() { presence = true }
        if presence && kind != MESSAGE && kind != GROUP && (name == "encode" || name == "toJson") { name = name + "_" }
    }
    let packed = false
    if repeated && kind != STRING && kind != BYTES && kind != MESSAGE && kind != GROUP {
        packed = owner.proto3
        if proto.options is Some(options) {
            if options.packed is Some(value) { packed = value }
        }
    }
    let oneof = -1
    if proto.oneofIndex is Some(position) {
        if !proto.proto3Optional() {
            oneof = position
            presence = false
        }
    }
    let jsonName = proto.jsonName()
    if jsonName == "" { jsonName = camel(proto.name()) }
    let field = Field {
        name: unique(name, taken)
        protoName: proto.name()
        jsonName: jsonName
        number: proto.number()
        kind: kind
        repeated: repeated
        packed: packed
        presence: presence
        typeName: withoutDot(proto.typeName())
        defaultValue: proto.defaultValue()
        hasDefault: proto.defaultValue.isSome()
        oneof: oneof
        caseName: ""
        entry: []
        entryList: false
        entryType: ""
    }
    if kind == MESSAGE && repeated {
        let entry = generator.type(field.typeName)
        if isMapEntry(entry) {
            let entryTaken: Set<Text> = Set()
            for part in entry.message.field { field.entry.add(fieldOf(generator, entry, part, entryTaken)) }
            if field.entry[0].number != 1 { field.entry = [field.entry[1], field.entry[0]] }
            field.entry[0].presence = false
            field.entry[1].presence = false
            let value = field.entry[1]
            if value.kind == MESSAGE && reaches(generator, value.typeName, owner.fullName, Set()) {
                field.entryList = true
                field.entryType = entry.local
            }
        }
    }
    return field
}

function messageOf(generator: Generator, info: TypeInfo, taken: Set<Text>): Message {
    let message = Message { info: info; fields: []; oneofs: [] }
    let fieldNames: Set<Text> = Set()
    fieldNames.add("unknownFields")
    for proto in info.message.field { message.fields.add(fieldOf(generator, info, proto, fieldNames)) }
    for position in 0..info.message.oneofDecl.length {
        let declaration = info.message.oneofDecl[position]
        let oneof = Oneof { name: ""; protoName: declaration.name(); typeName: ""; fields: [] }
        let caseNames: Set<Text> = Set()
        for field in message.fields {
            if field.oneof == position {
                field.caseName = unique(caseName(camel(field.protoName)), caseNames)
                oneof.fields.add(field)
            }
        }
        if oneof.fields.length > 0 {
            oneof.name = unique(fieldName(declaration.name()), fieldNames)
            let candidate = info.local + "_" + capitalized(identifierOnly(camel(declaration.name())))
            if taken.contains(candidate) { candidate = candidate + "Oneof" }
            oneof.typeName = unique(candidate, taken)
        }
        message.oneofs.add(oneof)
    }
    return message
}

// ----- Output -----

function Module.line(indent: Integer, text: Text) {
    if text == "" { self.lines.add("\n"); return }
    self.lines.add("    ".repeat(indent) + text + "\n")
}

function relativePath(from: Text, to: Text): Text {
    let fromParts = from.split("/")
    let toParts = to.split("/")
    let common = 0
    while common < fromParts.length - 1 && common < toParts.length - 1 && fromParts[common] == toParts[common] { common += 1 }
    let parts: List<Text> = []
    for index in common..(fromParts.length - 1) { parts.add("..") }
    if parts.length == 0 { parts.add(".") }
    for index in common..toParts.length { parts.add(toParts[index]) }
    return joinText(parts, "/")
}

function withoutProto(path: Text): Text {
    if path.length > 6 && path.slice(path.length - 6, path.length) == ".proto" { return path.slice(0, path.length - 6) }
    return path
}

function bundledName(path: Text): Text {
    let prefix = "google/protobuf/"
    if path.length <= prefix.length || path.slice(0, prefix.length) != prefix { return "" }
    let base = withoutProto(path.slice(prefix.length, path.length))
    for name in BUNDLED { if name == base { return "protobuf-" + name } }
    return ""
}

function importPath(from: Text, to: Text): Text {
    let bundled = bundledName(to)
    if bundled != "" { return bundled }
    return relativePath(from, withoutProto(to) + ".min")
}

/// The alias that qualifies names from another file's module, or "" for this one.
function Module.qualifier(file: Text): Text {
    if file == self.file.name() { return "" }
    for position in 0..self.imports.length {
        if self.imports[position] == file { return self.aliases[position] + "." }
    }
    let alias = identifierOnly(withoutProto(file))
    // The runtime modules' aliases stay free for a file such as json.proto.
    if alias == "errors" || alias == "json" || alias == "protobuf" || alias == "rpc" || alias == "connect" { alias = "proto_" + alias }
    self.imports.add(file)
    self.aliases.add(alias)
    return alias + "."
}

/// A type or function name from the module that declares `fullName`.
function Module.name(fullName: Text, prefix: Text): Text {
    let info = self.generator.type(fullName)
    let local = info.local
    if prefix != "" { local = prefix + local }
    return self.qualifier(info.file) + local
}

function Module.typeOf(fullName: Text): Text { return self.name(fullName, "") }

function Module.scalarType(field: Field): Text {
    let kind = field.kind
    if kind == DOUBLE || kind == FLOAT { return "Float" }
    if kind == BOOL { return "Boolean" }
    if kind == STRING { return "Text" }
    if kind == BYTES { return "Bytes" }
    if kind == MESSAGE || kind == GROUP || kind == ENUM { return self.typeOf(field.typeName) }
    return "Integer"
}

function Module.fieldType(field: Field): Text {
    if field.entry.length == 2 {
        if field.entryList { return "List<" + field.entryType + ">" }
        return "Map<" + self.scalarType(field.entry[0]) + ", " + self.scalarType(field.entry[1]) + ">"
    }
    let single = self.scalarType(field)
    if field.repeated { return "List<" + single + ">" }
    if field.presence { return "Maybe<" + single + ">" }
    return single
}

function enumCase(info: TypeInfo, number: Integer): Text {
    for position in 0..info.enumeration.value.length {
        if info.enumeration.value[position].number() == number && info.cases[position] != "" { return info.cases[position] }
    }
    return ""
}

function enumCaseNamed(info: TypeInfo, name: Text): Text {
    for position in 0..info.enumeration.value.length {
        if info.enumeration.value[position].name() == name {
            return enumCase(info, info.enumeration.value[position].number())
        }
    }
    return ""
}

function floatLiteral(text: Text): Text {
    if text == "inf" { return "(1.0 / 0.0)" }
    if text == "-inf" { return "(-1.0 / 0.0)" }
    if text == "nan" { return "(0.0 / 0.0)" }
    let mantissa = text
    let exponent = ""
    let marker = text.find("e")
    if marker < 0 { marker = text.find("E") }
    if marker >= 0 {
        mantissa = text.slice(0, marker)
        exponent = "e" + text.slice(marker + 1, text.length)
    }
    if !mantissa.contains(".") { mantissa = mantissa + ".0" }
    if mantissa.length > 0 && mantissa[0] == '.' { mantissa = "0" + mantissa }
    if mantissa.length > 1 && mantissa[0] == '-' && mantissa[1] == '.' { mantissa = "-0" + mantissa.slice(1, mantissa.length) }
    if mantissa[mantissa.length - 1] == '.' { mantissa = mantissa + "0" }
    return mantissa + exponent
}

/// Integer literal for a decimal default, wrapping uint64 values above 2^63-1.
function integerLiteral(text: Text): Text {
    if text.length > 0 && text[0] == '-' { return text }
    let value = 0
    for c in text { value = wrappingAdd(wrappingMultiply(value, 10), Integer(c) - 48) }
    return Text(value)
}

/// The value a field has when absent: its proto2 default, or the zero value.
function Module.defaultValue(field: Field): Text {
    let kind = field.kind
    if kind == ENUM {
        let info = self.generator.type(field.typeName)
        let name = enumCase(info, 0)
        if !info.proto3 && info.enumeration.value.length > 0 { name = info.cases[0] }
        if field.hasDefault { name = enumCaseNamed(info, field.defaultValue) }
        if name == "" { return self.typeOf(field.typeName) + ".Unrecognized(0)" }
        return self.typeOf(field.typeName) + "." + name
    }
    if field.hasDefault {
        if kind == DOUBLE || kind == FLOAT { return floatLiteral(field.defaultValue) }
        if kind == BOOL { return field.defaultValue }
        if kind == STRING { return quoted(field.defaultValue) }
        if kind == BYTES { return "Bytes(" + quoted(field.defaultValue) + ")" }
        return integerLiteral(field.defaultValue)
    }
    if kind == DOUBLE || kind == FLOAT { return "0.0" }
    if kind == BOOL { return "false" }
    if kind == STRING { return "\"\"" }
    if kind == BYTES { return "Bytes()" }
    if kind == MESSAGE || kind == GROUP { return self.name(field.typeName, "new") + "()" }
    return "0"
}

function Module.initialValue(field: Field): Text {
    if field.entry.length == 2 {
        if field.entryList { return "[]" }
        return "Map()"
    }
    if field.repeated { return "[]" }
    if field.presence { return "None" }
    return self.defaultValue(field)
}

// ----- Binary encoding -----

function wireType(kind: Integer): Integer {
    if kind == DOUBLE || kind == FIXED64 || kind == SFIXED64 { return 1 }
    if kind == FLOAT || kind == FIXED32 || kind == SFIXED32 { return 5 }
    if kind == STRING || kind == BYTES || kind == MESSAGE { return 2 }
    if kind == GROUP { return 3 }
    return 0
}

function tagOf(number: Integer, wire: Integer): Text { return Text((number << 3) | wire) }

/// Statements appending one value (without its key) to `out`.
function Module.writeValue(indent: Integer, field: Field, out: Text, value: Text) {
    let kind = field.kind
    if kind == DOUBLE { self.line(indent, "protobuf.writeDouble(" + out + ", " + value + ")") }
    else if kind == FLOAT { self.line(indent, "protobuf.writeFloat(" + out + ", " + value + ")") }
    else if kind == FIXED64 || kind == SFIXED64 { self.line(indent, "protobuf.writeFixed64(" + out + ", " + value + ")") }
    else if kind == FIXED32 || kind == SFIXED32 { self.line(indent, "protobuf.writeFixed32(" + out + ", " + value + ")") }
    else if kind == BOOL { self.line(indent, "protobuf.writeBoolean(" + out + ", " + value + ")") }
    else if kind == STRING { self.line(indent, "protobuf.writeText(" + out + ", " + value + ")") }
    else if kind == BYTES { self.line(indent, "protobuf.writeDelimited(" + out + ", " + value + ")") }
    else if kind == SINT32 || kind == SINT64 { self.line(indent, "protobuf.writeSigned(" + out + ", " + value + ")") }
    else if kind == ENUM { self.line(indent, "protobuf.writeVarint(" + out + ", " + value + ".number())") }
    else if kind == MESSAGE {
        self.line(indent, "let inner = Bytes()")
        self.line(indent, self.name(field.typeName, "write") + "(inner, " + value + ")")
        self.line(indent, "protobuf.writeDelimited(" + out + ", inner)")
    } else if kind == GROUP {
        self.line(indent, self.name(field.typeName, "write") + "(" + out + ", " + value + ")")
        self.line(indent, "protobuf.writeVarint(" + out + ", " + tagOf(field.number, 4) + ")")
    } else { self.line(indent, "protobuf.writeVarint(" + out + ", " + value + ")") }
}

/// Statements appending one field (key and value) to `out`.
function Module.writeKeyed(indent: Integer, field: Field, out: Text, value: Text) {
    self.line(indent, "protobuf.writeVarint(" + out + ", " + tagOf(field.number, wireType(field.kind)) + ")")
    self.writeValue(indent, field, out, value)
}

/// The condition under which an implicit-presence value is encoded.
function Module.notDefault(field: Field, value: Text): Text {
    let kind = field.kind
    if kind == DOUBLE || kind == FLOAT { return value + " != 0.0 || 1.0 / " + value + " < 0.0" }
    if kind == BOOL { return value }
    if kind == STRING || kind == BYTES { return value + ".length > 0" }
    if kind == ENUM { return value + ".number() != 0" }
    return value + " != 0"
}

function Module.writeField(field: Field) {
    let access = "message." + field.name
    if field.entry.length == 2 {
        let key = field.entry[0]
        let value = field.entry[1]
        if field.entryList {
            self.line(1, "for entry in " + access + " {")
            self.line(2, "let pair = Bytes()")
            self.writeKeyed(2, key, "pair", "entry.key")
            self.writeKeyed(2, value, "pair", "entry.value")
        } else {
            self.line(1, "for key in " + access + " {")
            self.line(2, "let pair = Bytes()")
            self.writeKeyed(2, key, "pair", "key")
            self.writeKeyed(2, value, "pair", access + "[key]")
        }
        self.line(2, "protobuf.writeVarint(out, " + tagOf(field.number, 2) + ")")
        self.line(2, "protobuf.writeDelimited(out, pair)")
        self.line(1, "}")
    } else if field.packed {
        self.line(1, "if " + access + ".length > 0 {")
        self.line(2, "let packed = Bytes()")
        self.line(2, "for value in " + access + " {")
        self.writeValue(3, field, "packed", "value")
        self.line(2, "}")
        self.line(2, "protobuf.writeVarint(out, " + tagOf(field.number, 2) + ")")
        self.line(2, "protobuf.writeDelimited(out, packed)")
        self.line(1, "}")
    } else if field.repeated {
        self.line(1, "for value in " + access + " {")
        self.writeKeyed(2, field, "out", "value")
        self.line(1, "}")
    } else if field.presence {
        self.line(1, "if " + access + " is Some(value) {")
        self.writeKeyed(2, field, "out", "value")
        self.line(1, "}")
    } else {
        self.line(1, "if " + self.notDefault(field, access) + " {")
        self.writeKeyed(2, field, "out", access)
        self.line(1, "}")
    }
}

function Module.writeOneof(oneof: Oneof) {
    self.line(1, "if message." + oneof.name + " is Some(choice) {")
    self.line(2, "match choice {")
    for field in oneof.fields {
        self.line(3, field.caseName + "(value) {")
        self.writeKeyed(4, field, "out", "value")
        self.line(3, "}")
    }
    self.line(2, "}")
    self.line(1, "}")
}

/// Fields in number order; a oneof is written where its first member falls.
function encodingOrder(message: Message): List<Field> {
    let ordered = message.fields.sortedBy(function(a: Field, b: Field): Integer {
        if a.number < b.number { return -1 }
        if a.number > b.number { return 1 }
        return 0
    })
    return ordered
}

// ----- Binary decoding -----

/// An expression reading one value of a scalar or enum field.
function Module.readExpression(field: Field): Text {
    let kind = field.kind
    if kind == DOUBLE { return "reader.readDouble()" }
    if kind == FLOAT { return "reader.readFloat()" }
    if kind == INT64 || kind == UINT64 { return "reader.readVarint()" }
    if kind == INT32 { return "reader.readInt32()" }
    if kind == FIXED64 || kind == SFIXED64 { return "reader.readFixed64()" }
    if kind == FIXED32 { return "reader.readFixed32()" }
    if kind == SFIXED32 { return "reader.readSfixed32()" }
    if kind == BOOL { return "reader.readBoolean()" }
    if kind == STRING { return "reader.readText()" }
    if kind == BYTES { return "reader.readBytes()" }
    if kind == UINT32 { return "reader.readUint32()" }
    if kind == SINT32 { return "reader.readSint32()" }
    if kind == SINT64 { return "reader.readSint64()" }
    if kind == ENUM { return self.name(field.typeName, "enum") + "(reader.readInt32())" }
    fail("protoc-gen-minyar: no scalar reader for kind " + Text(kind))
}

function Module.closedEnum(field: Field): Boolean {
    return field.kind == ENUM && !self.generator.type(field.typeName).proto3
}

/// Statements reading one scalar or enum value and passing it to `store`, a
/// statement prefix completed by the value and ")". Closed enums keep
/// unrecognized numbers as unknown fields.
function Module.readStore(indent: Integer, field: Field, store: Text, close: Text) {
    if self.closedEnum(field) {
        self.line(indent, "let number = reader.readInt32()")
        self.line(indent, "let value = " + self.name(field.typeName, "enum") + "(number)")
        self.line(indent, "if value is Unrecognized(_) {")
        self.line(indent + 1, "protobuf.keepVarint(message.unknownFields, " + Text(field.number) + ", number)")
        self.line(indent, "} else {")
        self.line(indent + 1, store + "value" + close)
        self.line(indent, "}")
    } else {
        self.line(indent, store + self.readExpression(field) + close)
    }
}

/// Statements reading a nested message into a fresh `created`.
function Module.readMessage(indent: Integer, field: Field, existing: Text, store: Text) {
    if field.kind == GROUP {
        self.line(indent, "let created = " + self.name(field.typeName, "new") + "()")
        if existing != "" { self.line(indent, "if " + existing + " is Some(previous) { created = previous }") }
        self.line(indent, "let group = reader.startGroup(tag)")
        self.line(indent, self.name(field.typeName, "read") + "(reader, created)")
        self.line(indent, "reader.endGroup(group)")
        self.line(indent, store)
        return
    }
    self.line(indent, "let outer = reader.enter()")
    self.line(indent, "if outer >= 0 {")
    self.line(indent + 1, "let created = " + self.name(field.typeName, "new") + "()")
    if existing != "" { self.line(indent + 1, "if " + existing + " is Some(previous) { created = previous }") }
    self.line(indent + 1, self.name(field.typeName, "read") + "(reader, created)")
    self.line(indent + 1, store)
    self.line(indent + 1, "reader.leave(outer)")
    self.line(indent, "}")
}

function Module.readMapEntry(field: Field) {
    let key = field.entry[0]
    let value = field.entry[1]
    self.line(3, tagOf(field.number, 2) + " {")
    self.line(4, "let outer = reader.enter()")
    self.line(4, "if outer >= 0 {")
    self.line(5, "let key = " + self.defaultValue(key))
    self.line(5, "let value = " + self.defaultValue(value))
    self.line(5, "while reader.more() {")
    self.line(6, "let tag = reader.readTag()")
    self.line(6, "match tag {")
    self.line(7, tagOf(1, wireType(key.kind)) + " { key = " + self.readExpression(key) + " }")
    if value.kind == MESSAGE {
        self.line(7, tagOf(2, 2) + " {")
        self.line(8, "let inner = reader.enter()")
        self.line(8, "if inner >= 0 {")
        self.line(9, self.name(value.typeName, "read") + "(reader, value)")
        self.line(9, "reader.leave(inner)")
        self.line(8, "}")
        self.line(7, "}")
    } else {
        self.line(7, tagOf(2, wireType(value.kind)) + " { value = " + self.readExpression(value) + " }")
    }
    self.line(7, "_ { reader.skip(tag) }")
    self.line(6, "}")
    self.line(5, "}")
    self.line(5, "reader.leave(outer)")
    if field.entryList {
        self.line(5, "message." + field.name + ".add(" + field.entryType + " { key: key; value: value })")
    } else {
        self.line(5, "message." + field.name + "[key] = value")
    }
    self.line(4, "}")
    self.line(3, "}")
}

function Module.readField(field: Field, message: Message) {
    let access = "message." + field.name
    if field.entry.length == 2 {
        self.readMapEntry(field)
        return
    }
    let wire = wireType(field.kind)
    if field.oneof >= 0 {
        let oneof = message.oneofs[field.oneof]
        let make = "Some(" + oneof.typeName + "." + field.caseName + "("
        self.line(3, tagOf(field.number, wire) + " {")
        if field.kind == MESSAGE || field.kind == GROUP {
            self.line(4, "let current: Maybe<" + self.scalarType(field) + "> = None")
            self.line(4, "if message." + oneof.name + " is Some(" + field.caseName + "(previous)) { current = Some(previous) }")
            self.readMessage(4, field, "current", "message." + oneof.name + " = " + make + "created))")
        } else {
            self.readStore(4, field, "message." + oneof.name + " = " + make, "))")
        }
        self.line(3, "}")
        return
    }
    if field.repeated {
        if field.kind == MESSAGE || field.kind == GROUP {
            self.line(3, tagOf(field.number, wire) + " {")
            self.readMessage(4, field, "", access + ".add(created)")
            self.line(3, "}")
            return
        }
        self.line(3, tagOf(field.number, wire) + " {")
        self.readStore(4, field, access + ".add(", ")")
        self.line(3, "}")
        if wire != 2 {
            self.line(3, tagOf(field.number, 2) + " {")
            self.line(4, "let outer = reader.enter()")
            self.line(4, "while reader.more() {")
            self.readStore(5, field, access + ".add(", ")")
            self.line(4, "}")
            self.line(4, "reader.leave(outer)")
            self.line(3, "}")
        }
        return
    }
    self.line(3, tagOf(field.number, wire) + " {")
    if field.kind == MESSAGE || field.kind == GROUP {
        self.readMessage(4, field, access, access + " = Some(created)")
    } else if field.presence {
        self.readStore(4, field, access + " = Some(", ")")
    } else {
        self.readStore(4, field, access + " = ", "")
    }
    self.line(3, "}")
}

function Module.dedupeEntries(field: Field) {
    let access = "message." + field.name
    self.line(1, "if " + access + ".length > 1 {")
    self.line(2, "let last: Map<" + self.scalarType(field.entry[0]) + ", Integer> = Map()")
    self.line(2, "for position in 0.." + access + ".length { last[" + access + "[position].key] = position }")
    self.line(2, "if last.length < " + access + ".length {")
    self.line(3, "let kept: List<" + field.entryType + "> = []")
    self.line(3, "for position in 0.." + access + ".length {")
    self.line(4, "if last[" + access + "[position].key] == position { kept.add(" + access + "[position]) }")
    self.line(3, "}")
    self.line(3, access + " = kept")
    self.line(2, "}")
    self.line(1, "}")
}

// ----- JSON -----

// Well-known types whose JSON is not an object of fields.
global WRAPPERS: List<Text> = ["google.protobuf.DoubleValue", "google.protobuf.FloatValue", "google.protobuf.Int64Value", "google.protobuf.UInt64Value", "google.protobuf.Int32Value", "google.protobuf.UInt32Value", "google.protobuf.BoolValue", "google.protobuf.StringValue", "google.protobuf.BytesValue"]
global SPECIAL: List<Text> = ["google.protobuf.Any", "google.protobuf.Timestamp", "google.protobuf.Duration", "google.protobuf.FieldMask", "google.protobuf.Struct", "google.protobuf.Value", "google.protobuf.ListValue"]

function listed(names: List<Text>, name: Text): Boolean {
    for candidate in names { if candidate == name { return true } }
    return false
}

function specialJson(fullName: Text): Boolean { return listed(SPECIAL, fullName) || listed(WRAPPERS, fullName) }

/// Whether JSON null is a value of this field's type rather than "absent".
function nullIsValue(field: Field): Boolean {
    return (field.kind == MESSAGE && field.typeName == "google.protobuf.Value") || (field.kind == ENUM && field.typeName == "google.protobuf.NullValue")
}

/// An expression for the JSON text of one scalar value.
function Module.jsonScalar(field: Field, value: Text): Text {
    let kind = field.kind
    if kind == INT64 || kind == SINT64 || kind == SFIXED64 { return "protobuf.jsonSigned64(" + value + ")" }
    if kind == UINT64 || kind == FIXED64 { return "protobuf.jsonUnsigned64(" + value + ")" }
    if kind == FLOAT || kind == DOUBLE { return "protobuf.jsonFloat(" + value + ")" }
    if kind == BOOL { return "protobuf.jsonBoolean(" + value + ")" }
    if kind == STRING { return "protobuf.jsonText(" + value + ")" }
    if kind == BYTES { return "protobuf.jsonBytes(" + value + ")" }
    if kind == ENUM {
        if field.typeName == "google.protobuf.NullValue" { return "\"null\"" }
        return "protobuf.jsonEnum(" + value + ".name(), " + value + ".number())"
    }
    return "Text(" + value + ")"
}

/// Statements appending the JSON of one value.
function Module.jsonWriteValue(indent: Integer, field: Field, value: Text) {
    if field.kind == MESSAGE || field.kind == GROUP {
        self.line(indent, "try " + self.name(field.typeName, "writeJson") + "(parts, " + value + ", options)")
    } else {
        self.line(indent, "parts.add(" + self.jsonScalar(field, value) + ")")
    }
}

function Module.jsonKeyText(key: Field, value: Text): Text {
    if key.kind == STRING { return "protobuf.jsonKey(" + value + ")" }
    if key.kind == BOOL { return "protobuf.jsonKey(protobuf.jsonBoolean(" + value + "))" }
    if key.kind == UINT64 || key.kind == FIXED64 { return "protobuf.jsonUnsigned64(" + value + ")" }
    return "protobuf.jsonKey(Text(" + value + "))"
}

function Module.jsonWriteField(field: Field) {
    let access = "message." + field.name
    let member = "protobuf.jsonMember(parts, start, " + quoted(field.jsonName) + ")"
    if field.entry.length == 2 {
        let key = field.entry[0]
        let value = field.entry[1]
        self.line(1, "if " + access + ".length > 0 {")
        self.line(2, member)
        self.line(2, "let map = parts.length")
        self.line(2, "parts.add(\"{\")")
        if field.entryList {
            self.line(2, "for entry in " + access + " {")
            self.line(3, "protobuf.jsonComma(parts, map)")
            self.line(3, "parts.add(" + self.jsonKeyText(key, "entry.key") + ")")
            self.line(3, "parts.add(\":\")")
            self.jsonWriteValue(3, value, "entry.value")
        } else {
            self.line(2, "for key in " + access + " {")
            self.line(3, "protobuf.jsonComma(parts, map)")
            self.line(3, "parts.add(" + self.jsonKeyText(key, "key") + ")")
            self.line(3, "parts.add(\":\")")
            self.jsonWriteValue(3, value, access + "[key]")
        }
        self.line(2, "}")
        self.line(2, "parts.add(\"}\")")
        self.line(1, "}")
    } else if field.repeated {
        self.line(1, "if " + access + ".length > 0 {")
        self.line(2, member)
        self.line(2, "let list = parts.length")
        self.line(2, "parts.add(\"[\")")
        self.line(2, "for value in " + access + " {")
        self.line(3, "protobuf.jsonComma(parts, list)")
        self.jsonWriteValue(3, field, "value")
        self.line(2, "}")
        self.line(2, "parts.add(\"]\")")
        self.line(1, "}")
    } else if field.presence {
        self.line(1, "if " + access + " is Some(value) {")
        self.line(2, member)
        self.jsonWriteValue(2, field, "value")
        self.line(1, "}")
    } else {
        self.line(1, "if " + self.notDefault(field, access) + " {")
        self.line(2, member)
        self.jsonWriteValue(2, field, access)
        self.line(1, "}")
    }
}

function Module.jsonWriteOneof(oneof: Oneof) {
    self.line(1, "if message." + oneof.name + " is Some(choice) {")
    self.line(2, "match choice {")
    for field in oneof.fields {
        self.line(3, field.caseName + "(value) {")
        self.line(4, "protobuf.jsonMember(parts, start, " + quoted(field.jsonName) + ")")
        self.jsonWriteValue(4, field, "value")
        self.line(3, "}")
    }
    self.line(2, "}")
    self.line(1, "}")
}

/// An expression reading one scalar from the json.Value `item`, as a Result.
function jsonReader(kind: Integer): Text {
    if kind == INT32 || kind == SINT32 || kind == SFIXED32 { return "protobuf.jsonInt32" }
    if kind == UINT32 || kind == FIXED32 { return "protobuf.jsonUint32" }
    if kind == INT64 || kind == SINT64 || kind == SFIXED64 { return "protobuf.jsonInt64" }
    if kind == UINT64 || kind == FIXED64 { return "protobuf.jsonUint64" }
    if kind == FLOAT { return "protobuf.jsonFloat32" }
    if kind == DOUBLE { return "protobuf.jsonDouble" }
    if kind == BOOL { return "protobuf.jsonBool" }
    if kind == STRING { return "protobuf.jsonString" }
    return "protobuf.jsonBytesValue"
}

/// Statements reading one value from `item` and completing `store` with it.
function Module.jsonReadValue(indent: Integer, field: Field, item: Text, store: Text, close: Text) {
    if field.kind == MESSAGE || field.kind == GROUP {
        self.line(indent, "let created = " + self.name(field.typeName, "new") + "()")
        self.line(indent, "try " + self.name(field.typeName, "readJson") + "(" + item + ", created, options)")
        self.line(indent, store + "created" + close)
    } else if field.kind == ENUM {
        self.line(indent, "let found = try " + self.name(field.typeName, "enumFromJson") + "(" + item + ", options)")
        self.line(indent, "if found is Some(choice) { " + store + "choice" + close + " }")
    } else {
        self.line(indent, store + "try " + jsonReader(field.kind) + "(" + item + ")" + close)
    }
}

function Module.jsonReadKey(indent: Integer, key: Field, raw: Text) {
    if key.kind == STRING { self.line(indent, "let mapKey = " + raw) }
    else if key.kind == BOOL { self.line(indent, "let mapKey = try protobuf.jsonBoolKey(" + raw + ")") }
    else { self.line(indent, "let mapKey = try " + jsonReader(key.kind) + "(protobuf.jsonMapKey(" + raw + "))") }
}

function Module.jsonReadField(field: Field, message: Message, first: Boolean) {
    let access = "message." + field.name
    let condition = "key == " + quoted(field.jsonName)
    if field.protoName != field.jsonName { condition = condition + " || key == " + quoted(field.protoName) }
    if first { self.line(2, "if " + condition + " {") } else { self.line(2, "} else if " + condition + " {") }
    let indent = 3
    if !nullIsValue(field) {
        self.line(3, "if item.kind != json.NULL {")
        indent = 4
    }
    if field.oneof >= 0 {
        let oneof = message.oneofs[field.oneof]
        self.line(indent, "if seen" + Text(field.oneof) + " { return Err(protobuf.jsonDuplicateOneof(" + quoted(oneof.protoName) + ")) }")
        self.line(indent, "seen" + Text(field.oneof) + " = true")
        self.jsonReadValue(indent, field, "item", "message." + oneof.name + " = Some(" + oneof.typeName + "." + field.caseName + "(", "))")
    } else if field.entry.length == 2 {
        self.line(indent, "try protobuf.jsonObject(item, " + quoted(field.protoName) + ")")
        self.line(indent, "for position in 0..item.keys.length {")
        self.jsonReadKey(indent + 1, field.entry[0], "item.keys[position]")
        if field.entryList {
            self.jsonReadValue(indent + 1, field.entry[1], "item.items[position]", access + ".add(" + field.entryType + " { key: mapKey; value: ", " })")
        } else {
            self.jsonReadValue(indent + 1, field.entry[1], "item.items[position]", access + "[mapKey] = ", "")
        }
        self.line(indent, "}")
    } else if field.repeated {
        self.line(indent, "try protobuf.jsonArray(item)")
        self.line(indent, "for element in item.items {")
        self.jsonReadValue(indent + 1, field, "element", access + ".add(", ")")
        self.line(indent, "}")
    } else if field.presence {
        self.jsonReadValue(indent, field, "item", access + " = Some(", ")")
    } else {
        self.jsonReadValue(indent, field, "item", access + " = ", "")
    }
    if !nullIsValue(field) { self.line(3, "}") }
}

function Module.jsonFunctions(message: Message) {
    let name = message.info.local
    let fullName = message.info.fullName
    self.line(0, "public function " + name + ".toJson(options: protobuf.JsonOptions): Result<Text, errors.Error> {")
    self.line(1, "let parts: List<Text> = []")
    self.line(1, "try writeJson" + name + "(parts, self, options)")
    self.line(1, "return Ok(joinText(parts))")
    self.line(0, "}")
    self.line(0, "")
    self.line(0, "public function decodeJson" + name + "(source: Text, options: protobuf.JsonOptions): Result<" + name + ", errors.Error> {")
    self.line(1, "let value = try protobuf.parseJson(source)")
    self.line(1, "let message = new" + name + "()")
    self.line(1, "try readJson" + name + "(value, message, options)")
    self.line(1, "return Ok(message)")
    self.line(0, "}")
    self.line(0, "")
    if specialJson(fullName) {
        self.specialJsonFunctions(message)
        return
    }
    self.line(0, "public function writeJson" + name + "(parts: List<Text>, message: " + name + ", options: protobuf.JsonOptions): Result<Nothing, errors.Error> {")
    self.line(1, "let start = parts.length")
    self.line(1, "parts.add(\"{\")")
    let written: Set<Integer> = Set()
    for field in message.fields {
        if field.oneof >= 0 {
            if !written.contains(field.oneof) {
                written.add(field.oneof)
                self.jsonWriteOneof(message.oneofs[field.oneof])
            }
        } else {
            self.jsonWriteField(field)
        }
    }
    self.line(1, "parts.add(\"}\")")
    self.line(1, "return Ok()")
    self.line(0, "}")
    self.line(0, "")
    self.line(0, "public function readJson" + name + "(value: json.Value, message: " + name + ", options: protobuf.JsonOptions): Result<Nothing, errors.Error> {")
    self.line(1, "try protobuf.jsonObject(value, " + quoted(fullName) + ")")
    for position in 0..message.oneofs.length {
        if message.oneofs[position].fields.length > 0 { self.line(1, "let seen" + Text(position) + " = false") }
    }
    self.line(1, "for index in 0..value.keys.length {")
    self.line(2, "let key = value.keys[index]")
    self.line(2, "let item = value.items[index]")
    let first = true
    for field in message.fields {
        self.jsonReadField(field, message, first)
        first = false
    }
    if first {
        self.line(2, "if !options.ignoreUnknownFields { return Err(protobuf.jsonUnknownField(key, " + quoted(fullName) + ")) }")
    } else {
        self.line(2, "} else if !options.ignoreUnknownFields {")
        self.line(3, "return Err(protobuf.jsonUnknownField(key, " + quoted(fullName) + "))")
        self.line(2, "}")
    }
    self.line(1, "}")
    self.line(1, "return Ok()")
    self.line(0, "}")
    self.line(0, "")
}

function Module.specialHeader(name: Text) {
    self.line(0, "public function writeJson" + name + "(parts: List<Text>, message: " + name + ", options: protobuf.JsonOptions): Result<Nothing, errors.Error> {")
}

function Module.specialReader(name: Text) {
    self.line(0, "public function readJson" + name + "(value: json.Value, message: " + name + ", options: protobuf.JsonOptions): Result<Nothing, errors.Error> {")
}

function Module.specialEnd() {
    self.line(1, "return Ok()")
    self.line(0, "}")
    self.line(0, "")
}

/// The JSON forms of the well-known types, in the modules generated for them.
function Module.specialJsonFunctions(message: Message) {
    let name = message.info.local
    let fullName = message.info.fullName
    if listed(WRAPPERS, fullName) {
        let field = message.fields[0]
        self.specialHeader(name)
        self.jsonWriteValue(1, field, "message.value")
        self.specialEnd()
        self.specialReader(name)
        self.line(1, "message.value = try " + jsonReader(field.kind) + "(value)")
        self.specialEnd()
    } else if fullName == "google.protobuf.Timestamp" || fullName == "google.protobuf.Duration" {
        self.specialHeader(name)
        self.line(1, "parts.add(try protobuf.format" + name + "(message.seconds, message.nanos))")
        self.specialEnd()
        self.specialReader(name)
        self.line(1, "let instant = try protobuf.parse" + name + "(value)")
        self.line(1, "message.seconds = instant.seconds")
        self.line(1, "message.nanos = instant.nanos")
        self.specialEnd()
    } else if fullName == "google.protobuf.FieldMask" {
        self.specialHeader(name)
        self.line(1, "parts.add(try protobuf.formatFieldMask(message.paths))")
        self.specialEnd()
        self.specialReader(name)
        self.line(1, "message.paths = try protobuf.parseFieldMask(value)")
        self.specialEnd()
    } else if fullName == "google.protobuf.Any" {
        self.specialHeader(name)
        self.line(1, "parts.add(try protobuf.formatAny(message.typeUrl, message.value, options))")
        self.specialEnd()
        self.specialReader(name)
        self.line(1, "let any = try protobuf.parseAny(value, options)")
        self.line(1, "message.typeUrl = any.typeUrl")
        self.line(1, "message.value = any.value")
        self.specialEnd()
    } else if fullName == "google.protobuf.Struct" {
        self.specialHeader(name)
        self.line(1, "let start = parts.length")
        self.line(1, "parts.add(\"{\")")
        self.line(1, "for entry in message.fields {")
        self.line(2, "protobuf.jsonComma(parts, start)")
        self.line(2, "parts.add(protobuf.jsonKey(entry.key))")
        self.line(2, "parts.add(\":\")")
        self.line(2, "try writeJsonValue(parts, entry.value, options)")
        self.line(1, "}")
        self.line(1, "parts.add(\"}\")")
        self.specialEnd()
        self.specialReader(name)
        self.line(1, "try protobuf.jsonObject(value, \"google.protobuf.Struct\")")
        self.line(1, "for index in 0..value.keys.length {")
        self.line(2, "let created = newValue()")
        self.line(2, "try readJsonValue(value.items[index], created, options)")
        self.line(2, "message.fields.add(Struct_FieldsEntry { key: value.keys[index]; value: created })")
        self.line(1, "}")
        self.specialEnd()
    } else if fullName == "google.protobuf.ListValue" {
        self.specialHeader(name)
        self.line(1, "let start = parts.length")
        self.line(1, "parts.add(\"[\")")
        self.line(1, "for element in message.values {")
        self.line(2, "protobuf.jsonComma(parts, start)")
        self.line(2, "try writeJsonValue(parts, element, options)")
        self.line(1, "}")
        self.line(1, "parts.add(\"]\")")
        self.specialEnd()
        self.specialReader(name)
        self.line(1, "try protobuf.jsonArray(value)")
        self.line(1, "for element in value.items {")
        self.line(2, "let created = newValue()")
        self.line(2, "try readJsonValue(element, created, options)")
        self.line(2, "message.values.add(created)")
        self.line(1, "}")
        self.specialEnd()
    } else if fullName == "google.protobuf.Value" {
        self.specialHeader(name)
        self.line(1, "match message.kind {")
        self.line(2, "Some(NullValue(_)) { parts.add(\"null\") }")
        self.line(2, "Some(NumberValue(number)) {")
        self.line(3, "if number != number || number - number != 0.0 { return Err(protobuf.jsonError(\"a Value number must be finite\")) }")
        self.line(3, "parts.add(protobuf.jsonFloat(number))")
        self.line(2, "}")
        self.line(2, "Some(StringValue(text)) { parts.add(protobuf.jsonText(text)) }")
        self.line(2, "Some(BoolValue(truth)) { parts.add(protobuf.jsonBoolean(truth)) }")
        self.line(2, "Some(StructValue(inner)) { try writeJsonStruct(parts, inner, options) }")
        self.line(2, "Some(ListValue(inner)) { try writeJsonListValue(parts, inner, options) }")
        self.line(2, "None { return Err(protobuf.jsonError(\"a Value has no kind\")) }")
        self.line(1, "}")
        self.specialEnd()
        self.specialReader(name)
        self.line(1, "if value.kind == json.NULL { message.kind = Some(Value_Kind.NullValue(NullValue.NULL_VALUE)) }")
        self.line(1, "else if value.kind == json.NUMBER { message.kind = Some(Value_Kind.NumberValue(value.number)) }")
        self.line(1, "else if value.kind == json.STRING { message.kind = Some(Value_Kind.StringValue(value.text)) }")
        self.line(1, "else if value.kind == json.BOOLEAN { message.kind = Some(Value_Kind.BoolValue(value.truth)) }")
        self.line(1, "else if value.kind == json.OBJECT {")
        self.line(2, "let created = newStruct()")
        self.line(2, "try readJsonStruct(value, created, options)")
        self.line(2, "message.kind = Some(Value_Kind.StructValue(created))")
        self.line(1, "} else if value.kind == json.ARRAY {")
        self.line(2, "let created = newListValue()")
        self.line(2, "try readJsonListValue(value, created, options)")
        self.line(2, "message.kind = Some(Value_Kind.ListValue(created))")
        self.line(1, "} else { return Err(protobuf.jsonError(\"invalid Value\")) }")
        self.specialEnd()
    }
}

function Module.enumJson(info: TypeInfo) {
    let name = info.local
    self.line(0, "/// The value's name in its .proto file, or \"\" for an unrecognized number.")
    self.line(0, "public function " + name + ".name(): Text {")
    self.line(1, "match self {")
    for position in 0..info.cases.length {
        if info.cases[position] != "" { self.line(2, info.cases[position] + " { return " + quoted(info.enumeration.value[position].name()) + " }") }
    }
    self.line(2, "Unrecognized(_) { return \"\" }")
    self.line(1, "}")
    self.line(0, "}")
    self.line(0, "")
    self.line(0, "/// A JSON enum value: a name, including aliases, or a number. An unknown name is")
    self.line(0, "/// an error, or None when the options ignore unknown fields.")
    self.line(0, "public function enumFromJson" + name + "(value: json.Value, options: protobuf.JsonOptions): Result<Maybe<" + name + ">, errors.Error> {")
    if info.fullName == "google.protobuf.NullValue" {
        self.line(1, "if value.kind == json.NULL { return Ok(Some(" + name + ".NULL_VALUE)) }")
    }
    self.line(1, "if value.kind == json.STRING {")
    self.line(2, "match value.text {")
    for position in 0..info.enumeration.value.length {
        let item = info.enumeration.value[position]
        self.line(3, quoted(item.name()) + " { return Ok(Some(" + name + "." + enumCase(info, item.number()) + ")) }")
    }
    self.line(3, "_ {}")
    self.line(2, "}")
    self.line(2, "if options.ignoreUnknownFields { return Ok(None) }")
    self.line(2, "return Err(protobuf.jsonError(\"unknown " + info.fullName + " value \\\"\" + value.text + \"\\\"\"))")
    self.line(1, "}")
    self.line(1, "return Ok(Some(enum" + name + "(try protobuf.jsonEnumNumber(value))))")
    self.line(0, "}")
    self.line(0, "")
}

/// `register` adds this file's message types to a registry for Any, and those of
/// the files whose types it uses.
function Module.registerFunction() {
    let messages: List<TypeInfo> = []
    for info in self.generator.types {
        if info.file == self.file.name() && !info.isEnum && !isMapEntry(info) { messages.add(info) }
    }
    for info in messages {
        let name = info.local
        self.line(0, "function anyJson" + name + "(data: Bytes, options: protobuf.JsonOptions): Result<Text, errors.Error> {")
        self.line(1, "let message = try decode" + name + "(data)")
        self.line(1, "return message.toJson(options)")
        self.line(0, "}")
        self.line(0, "")
        self.line(0, "function anyBinary" + name + "(value: json.Value, options: protobuf.JsonOptions): Result<Bytes, errors.Error> {")
        self.line(1, "let message = new" + name + "()")
        self.line(1, "try readJson" + name + "(value, message, options)")
        self.line(1, "return Ok(message.encode())")
        self.line(0, "}")
        self.line(0, "")
    }
    let imported: List<Text> = []
    for alias in self.aliases { imported.add(alias) }
    imported.sort()
    self.line(0, "/// Add this file's message types, and those of the files it uses, to a registry for")
    self.line(0, "/// converting `google.protobuf.Any` values to and from JSON.")
    self.line(0, "public function register(registry: protobuf.Registry) {")
    if messages.length > 0 { self.line(1, "if registry.has(" + quoted(messages[0].fullName) + ") { return }") }
    for info in messages {
        let wrapped = "false"
        if specialJson(info.fullName) { wrapped = "true" }
        self.line(1, "registry.add(protobuf.TypeEntry { fullName: " + quoted(info.fullName) + "; toJson: anyJson" + info.local + "; fromJson: anyBinary" + info.local + "; wrapped: " + wrapped + " })")
    }
    for alias in imported { self.line(1, alias + ".register(registry)") }
    self.line(0, "}")
}

// ----- Services -----

/// The proto and JSON codecs for one message type used by a method, named
/// `codec<Name>` and `jsonCodec<Name>`.
function Module.codecs(fullName: Text, codecName: Text) {
    let type = self.typeOf(fullName)
    let decode = self.name(fullName, "decode")
    let readJson = self.name(fullName, "readJson")
    let create = self.name(fullName, "new")
    self.line(0, "function protoDecode" + codecName + "(data: Bytes): Result<" + type + ", rpc.Error> {")
    self.line(1, "match " + decode + "(data) {")
    self.line(2, "Ok(message) { return Ok(message) }")
    self.line(2, "Err(problem) { return Err(rpc.fromError(rpc.INVALID_ARGUMENT, problem)) }")
    self.line(1, "}")
    self.line(0, "}")
    self.line(0, "")
    self.line(0, "function protoEncode" + codecName + "(message: " + type + "): Result<Bytes, rpc.Error> { return Ok(message.encode()) }")
    self.line(0, "")
    self.line(0, "/// The binary codec for `" + fullName + "`.")
    self.line(0, "public function codec" + codecName + "(): rpc.Codec<" + type + "> {")
    self.line(1, "return rpc.Codec<" + type + "> { name: \"proto\"; decode: protoDecode" + codecName + "; encode: protoEncode" + codecName + " }")
    self.line(0, "}")
    self.line(0, "")
    self.line(0, "/// The JSON codec for `" + fullName + "`; `registry` resolves Any values. Like")
    self.line(0, "/// other Connect implementations, it ignores unknown fields in requests.")
    self.line(0, "public function jsonCodec" + codecName + "(registry: protobuf.Registry): rpc.Codec<" + type + "> {")
    self.line(1, "let options = protobuf.jsonOptions(registry)")
    self.line(1, "options.ignoreUnknownFields = true")
    self.line(1, "return rpc.Codec<" + type + "> {")
    self.line(2, "name: \"json\"")
    self.line(2, "decode: function(data: Bytes): Result<" + type + ", rpc.Error> {")
    self.line(3, "let message = " + create + "()")
    self.line(3, "match protobuf.parseJsonBytes(data) {")
    self.line(4, "Ok(value) {")
    self.line(5, "match " + readJson + "(value, message, options) {")
    self.line(6, "Ok() { return Ok(message) }")
    self.line(6, "Err(problem) { return Err(rpc.fromError(rpc.INVALID_ARGUMENT, problem)) }")
    self.line(5, "}")
    self.line(4, "}")
    self.line(4, "Err(problem) { return Err(rpc.fromError(rpc.INVALID_ARGUMENT, problem)) }")
    self.line(3, "}")
    self.line(2, "}")
    self.line(2, "encode: function(message: " + type + "): Result<Bytes, rpc.Error> {")
    self.line(3, "match message.toJson(options) {")
    self.line(4, "Ok(text) { return Ok(Bytes(text)) }")
    self.line(4, "Err(problem) { return Err(rpc.fromError(rpc.INTERNAL, problem)) }")
    self.line(3, "}")
    self.line(2, "}")
    self.line(1, "}")
    self.line(0, "}")
    self.line(0, "")
}

function idempotency(method: descriptor.MethodDescriptorProto): Text {
    if method.options is Some(options) {
        let level = options.idempotencyLevel().number()
        if level == 1 { return "rpc.NO_SIDE_EFFECTS" }
        if level == 2 { return "rpc.IDEMPOTENT" }
    }
    return "rpc.IDEMPOTENCY_UNKNOWN"
}

/// Server code for each service: codecs, a record of handlers and a function
/// that adds the methods to an `rpc.Services`.
function Module.services(taken: Set<Text>) {
    if self.file.service.length == 0 { return }
    self.usesRpc = true
    let codecNames: Map<Text, Text> = Map()
    let codecTaken: Set<Text> = Set()
    let ordered: List<Text> = []
    for service in self.file.service {
        for method in service.method {
            for typeName in [withoutDot(method.inputType()), withoutDot(method.outputType())] {
                if !codecNames.has(typeName) {
                    codecNames[typeName] = unique(self.generator.type(typeName).local, codecTaken)
                    ordered.add(typeName)
                }
            }
        }
    }
    for typeName in ordered { self.codecs(typeName, codecNames[typeName]) }
    let prefix = self.file.package()
    for service in self.file.service {
        let local = typeName(service.name())
        let handlers = unique(local + "Handlers", taken)
        let fullName = joinedName(prefix, service.name())
        let methodNames: Set<Text> = Set()
        let fields: List<Text> = []
        self.line(0, "/// Handlers for the methods of `" + fullName + "`.")
        self.line(0, "public record " + handlers + " {")
        for method in service.method {
            let field = unique(fieldName(method.name()), methodNames)
            fields.add(field)
            let request = self.typeOf(withoutDot(method.inputType()))
            let reply = self.typeOf(withoutDot(method.outputType()))
            if method.clientStreaming() {
                self.line(1, field + ": (rpc.Call, rpc.Sender<" + reply + ">) -> Result<rpc.Listener<" + request + ">, rpc.Error>")
            } else if method.serverStreaming() {
                self.line(1, field + ": (rpc.Call, " + request + ", rpc.Sender<" + reply + ">) -> Result<Nothing, rpc.Error>")
            } else {
                self.line(1, field + ": (rpc.Call, " + request + ") -> Result<" + reply + ", rpc.Error>")
            }
        }
        self.line(0, "}")
        self.line(0, "")
        self.line(0, "/// Add the methods of `" + fullName + "` to `services`; `registry` resolves Any values in JSON.")
        self.line(0, "public function register" + local + "(services: rpc.Services, handlers: " + handlers + ", registry: protobuf.Registry) {")
        for position in 0..service.method.length {
            let method = service.method[position]
            let input = withoutDot(method.inputType())
            let output = withoutDot(method.outputType())
            let procedure = quoted("/" + fullName + "/" + method.name())
            let requests = "[codec" + codecNames[input] + "(), jsonCodec" + codecNames[input] + "(registry)]"
            let replies = "[codec" + codecNames[output] + "(), jsonCodec" + codecNames[output] + "(registry)]"
            let types = "<" + self.typeOf(input) + ", " + self.typeOf(output) + ">"
            if method.clientStreaming() && method.serverStreaming() {
                self.line(1, "services.add(rpc.bidiStream" + types + "(" + procedure + ", " + requests + ", " + replies + ", handlers." + fields[position] + "))")
            } else if method.clientStreaming() {
                self.line(1, "services.add(rpc.clientStream" + types + "(" + procedure + ", " + requests + ", " + replies + ", handlers." + fields[position] + "))")
            } else if method.serverStreaming() {
                self.line(1, "services.add(rpc.serverStream" + types + "(" + procedure + ", " + requests + ", " + replies + ", handlers." + fields[position] + "))")
            } else {
                self.line(1, "services.add(rpc.unary" + types + "(" + procedure + ", " + idempotency(method) + ", " + requests + ", " + replies + ", handlers." + fields[position] + "))")
            }
        }
        self.line(0, "}")
        self.line(0, "")
        self.client(service, local, fullName, fields, codecNames, taken)
    }
}

/// A client for one service, a method per RPC: unary methods over
/// `connect.call`, streaming methods returning a `connect.StreamCall`. The
/// connect.Client chooses the protocol, Connect or gRPC.
function Module.client(service: descriptor.ServiceDescriptorProto, local: Text, fullName: Text, fields: List<Text>, codecNames: Map<Text, Text>, taken: Set<Text>) {
    self.usesConnect = true
    let name = unique(local + "Client", taken)
    let unary: List<Integer> = []
    let all: List<Integer> = []
    for position in 0..service.method.length {
        let method = service.method[position]
        if !method.clientStreaming() && !method.serverStreaming() { unary.add(position) }
        all.add(position)
    }
    self.line(0, "/// A client for `" + fullName + "`, with one method per RPC.")
    self.line(0, "public record " + name + " {")
    self.line(1, "connection: connect.Client")
    for position in all {
        let method = service.method[position]
        self.line(1, "private " + fields[position] + "Requests: List<rpc.Codec<" + self.typeOf(withoutDot(method.inputType())) + ">>")
        self.line(1, "private " + fields[position] + "Replies: List<rpc.Codec<" + self.typeOf(withoutDot(method.outputType())) + ">>")
    }
    self.line(0, "}")
    self.line(0, "")
    self.line(0, "/// Call `" + fullName + "` through `connection`; `registry` resolves Any values in JSON.")
    self.line(0, "public function " + decapitalized(name) + "(connection: connect.Client, registry: protobuf.Registry): " + name + " {")
    self.line(1, "return " + name + " {")
    self.line(2, "connection: connection")
    for position in all {
        let method = service.method[position]
        let input = codecNames[withoutDot(method.inputType())]
        let output = codecNames[withoutDot(method.outputType())]
        self.line(2, fields[position] + "Requests: [codec" + input + "(), jsonCodec" + input + "(registry)]")
        self.line(2, fields[position] + "Replies: [codec" + output + "(), jsonCodec" + output + "(registry)]")
    }
    self.line(1, "}")
    self.line(0, "}")
    self.line(0, "")
    for position in unary {
        let method = service.method[position]
        let request = self.typeOf(withoutDot(method.inputType()))
        let reply = self.typeOf(withoutDot(method.outputType()))
        let level = idempotency(method)
        self.line(0, "/// Call `" + fullName + "/" + method.name() + "`. Unless `options` says otherwise, the call")
        self.line(0, "/// carries the method's idempotency level, which decides whether it is retried.")
        self.line(0, "public function " + name + "." + fields[position] + "(request: " + request + ", options: connect.CallOptions): Result<" + reply + ", connect.Failure> {")
        let chosen = "options"
        if level != "rpc.IDEMPOTENCY_UNKNOWN" {
            self.line(1, "let chosen = options")
            self.line(1, "if options.idempotency == rpc.IDEMPOTENCY_UNKNOWN {")
            self.line(2, "chosen = connect.CallOptions { headers: options.headers; timeoutMilliseconds: options.timeoutMilliseconds; get: options.get; idempotency: " + level + "; idempotencyKey: options.idempotencyKey }")
            self.line(1, "}")
            chosen = "chosen"
        }
        self.line(1, "return connect.call<" + request + ", " + reply + ">(self.connection, " + quoted("/" + fullName + "/" + method.name()) + ", request, self." + fields[position] + "Requests, self." + fields[position] + "Replies, " + chosen + ")")
        self.line(0, "}")
        self.line(0, "")
    }
    for position in all {
        let method = service.method[position]
        if !method.clientStreaming() && !method.serverStreaming() { continue }
        let request = self.typeOf(withoutDot(method.inputType()))
        let reply = self.typeOf(withoutDot(method.outputType()))
        let types = "<" + request + ", " + reply + ">"
        let procedure = quoted("/" + fullName + "/" + method.name())
        let codecs = "self." + fields[position] + "Requests, self." + fields[position] + "Replies, options"
        let result = "connect.StreamCall" + types
        if !method.clientStreaming() {
            self.line(0, "/// Call `" + fullName + "/" + method.name() + "`: receive its replies from the returned call.")
            self.line(0, "public function " + name + "." + fields[position] + "(request: " + request + ", options: connect.CallOptions): " + result + " {")
            self.line(1, "return connect.serverStream" + types + "(self.connection, " + procedure + ", request, " + codecs + ")")
        } else {
            let kind = "rpc.CLIENT_STREAM"
            let use = "send requests, then take the one reply with connect.reply."
            if method.serverStreaming() {
                kind = "rpc.BIDI_STREAM"
                use = "send requests and receive replies, in any order."
            }
            self.line(0, "/// Open `" + fullName + "/" + method.name() + "`: " + use)
            self.line(0, "public function " + name + "." + fields[position] + "(options: connect.CallOptions): " + result + " {")
            self.line(1, "return connect.open" + types + "(self.connection, " + procedure + ", " + kind + ", " + codecs + ")")
        }
        self.line(0, "}")
        self.line(0, "")
    }
}

// ----- Declarations -----

function Module.enumeration(info: TypeInfo) {
    let name = info.local
    self.line(0, "/// `" + info.fullName + "`")
    self.line(0, "public choice " + name + " {")
    for position in 0..info.cases.length {
        if info.cases[position] != "" { self.line(1, info.cases[position]) }
    }
    self.line(1, "Unrecognized(value: Integer)")
    self.line(0, "}")
    self.line(0, "")
    self.line(0, "public function " + name + ".number(): Integer {")
    self.line(1, "match self {")
    for position in 0..info.cases.length {
        if info.cases[position] != "" { self.line(2, info.cases[position] + " { return " + Text(info.enumeration.value[position].number()) + " }") }
    }
    self.line(2, "Unrecognized(value) { return value }")
    self.line(1, "}")
    self.line(0, "}")
    self.line(0, "")
    self.line(0, "public function enum" + name + "(number: Integer): " + name + " {")
    self.line(1, "match number {")
    for position in 0..info.cases.length {
        if info.cases[position] != "" { self.line(2, Text(info.enumeration.value[position].number()) + " { return " + name + "." + info.cases[position] + " }") }
    }
    self.line(2, "_ { return " + name + ".Unrecognized(number) }")
    self.line(1, "}")
    self.line(0, "}")
    self.line(0, "")
    self.enumJson(info)
}

function Module.record(message: Message) {
    let name = message.info.local
    for field in message.fields {
        if field.entryList {
            self.line(0, "/// An entry of `" + message.info.fullName + "." + field.protoName + "`.")
            self.line(0, "public record " + field.entryType + " {")
            self.line(1, "key: " + self.scalarType(field.entry[0]))
            self.line(1, "value: " + self.scalarType(field.entry[1]))
            self.line(0, "}")
            self.line(0, "")
        }
    }
    for oneof in message.oneofs {
        if oneof.fields.length == 0 { continue }
        self.line(0, "/// The `" + oneof.protoName + "` oneof of `" + message.info.fullName + "`.")
        self.line(0, "public choice " + oneof.typeName + " {")
        for field in oneof.fields { self.line(1, field.caseName + "(value: " + self.scalarType(field) + ")") }
        self.line(0, "}")
        self.line(0, "")
    }
    self.line(0, "/// `" + message.info.fullName + "`")
    self.line(0, "public record " + name + " {")
    let oneofsDone: Set<Integer> = Set()
    for field in message.fields {
        if field.oneof >= 0 {
            if !oneofsDone.contains(field.oneof) {
                oneofsDone.add(field.oneof)
                let oneof = message.oneofs[field.oneof]
                self.line(1, oneof.name + ": Maybe<" + oneof.typeName + ">")
            }
        } else {
            self.line(1, field.name + ": " + self.fieldType(field))
        }
    }
    self.line(1, "unknownFields: Bytes")
    self.line(0, "}")
    self.line(0, "")
    self.line(0, "public function new" + name + "(): " + name + " {")
    self.line(1, "return " + name + " {")
    let initialized: Set<Integer> = Set()
    for field in message.fields {
        if field.oneof >= 0 {
            if !initialized.contains(field.oneof) {
                initialized.add(field.oneof)
                self.line(2, message.oneofs[field.oneof].name + ": None")
            }
        } else {
            self.line(2, field.name + ": " + self.initialValue(field))
        }
    }
    self.line(2, "unknownFields: Bytes()")
    self.line(1, "}")
    self.line(0, "}")
    self.line(0, "")
    for field in message.fields {
        if field.presence && field.oneof < 0 && field.kind != MESSAGE && field.kind != GROUP {
            self.line(0, "public function " + name + "." + field.name + "(): " + self.scalarType(field) + " {")
            self.line(1, "if self." + field.name + " is Some(value) { return value }")
            self.line(1, "return " + self.defaultValue(field))
            self.line(0, "}")
            self.line(0, "")
        }
    }
    self.line(0, "public function " + name + ".encode(): Bytes {")
    self.line(1, "let out = Bytes()")
    self.line(1, "write" + name + "(out, self)")
    self.line(1, "return out")
    self.line(0, "}")
    self.line(0, "")
    self.line(0, "public function decode" + name + "(data: Bytes): Result<" + name + ", errors.Error> {")
    self.line(1, "let reader = protobuf.reader(data)")
    self.line(1, "let message = new" + name + "()")
    self.line(1, "read" + name + "(reader, message)")
    self.line(1, "if reader.failed() { return Err(reader.failure()) }")
    self.line(1, "return Ok(message)")
    self.line(0, "}")
    self.line(0, "")
    self.jsonFunctions(message)
    self.line(0, "public function write" + name + "(out: Bytes, message: " + name + ") {")
    let written: Set<Integer> = Set()
    for field in encodingOrder(message) {
        if field.oneof >= 0 {
            if !written.contains(field.oneof) {
                written.add(field.oneof)
                self.writeOneof(message.oneofs[field.oneof])
            }
        } else {
            self.writeField(field)
        }
    }
    self.line(1, "out.addBytes(message.unknownFields)")
    self.line(0, "}")
    self.line(0, "")
    self.line(0, "public function read" + name + "(reader: protobuf.Reader, message: " + name + ") {")
    self.line(1, "while reader.more() {")
    self.line(2, "let tag = reader.readTag()")
    if message.fields.length > 0 {
        self.line(2, "match tag {")
        for field in message.fields { self.readField(field, message) }
        self.line(3, "_ { reader.keep(tag, message.unknownFields) }")
        self.line(2, "}")
    } else {
        self.line(2, "reader.keep(tag, message.unknownFields)")
    }
    self.line(1, "}")
    for field in message.fields {
        if field.entryList { self.dedupeEntries(field) }
    }
    self.line(0, "}")
    self.line(0, "")
}

function Module.declarations(info: TypeInfo, taken: Set<Text>) {
    if info.isEnum {
        self.enumeration(info)
        return
    }
    if isMapEntry(info) { return }
    self.record(messageOf(self.generator, info, taken))
}

function outputName(path: Text): Text { return withoutProto(path) + ".min" }

function Generator.file(position: Integer): plugin.CodeGeneratorResponse_File {
    let file = self.request.protoFile[position]
    let module = Module { generator: self; file: file; lines: []; imports: []; aliases: []; usesRpc: false; usesConnect: false; names: Set() }
    let taken: Set<Text> = Set()
    for info in self.types { if info.file == file.name() { taken.add(info.local) } }
    for info in self.types {
        if info.file == file.name() { module.declarations(info, taken) }
    }
    module.services(taken)
    module.registerFunction()
    let header: List<Text> = []
    header.add("// Code generated by protoc-gen-minyar. DO NOT EDIT.\n")
    header.add("// source: " + file.name() + "\n")
    header.add("use \"errors\" as errors\n")
    header.add("use \"json\" as json\n")
    header.add("use \"protobuf\" as protobuf\n")
    if module.usesConnect { header.add("use \"connect\" as connect\n") }
    if module.usesRpc { header.add("use \"rpc\" as rpc\n") }
    let order: List<Integer> = []
    for position in 0..module.imports.length { order.add(position) }
    let sorted = order.sortedBy(function(a: Integer, b: Integer): Integer {
        if module.aliases[a] < module.aliases[b] { return -1 }
        if module.aliases[a] > module.aliases[b] { return 1 }
        return 0
    })
    for index in sorted {
        header.add("use " + quoted(importPath(file.name(), module.imports[index])) + " as " + module.aliases[index] + "\n")
    }
    header.add("\n")
    let lines = module.lines
    while lines.length > 0 && lines[lines.length - 1] == "\n" { lines.pop() }
    let output = plugin.newCodeGeneratorResponse_File()
    output.name = Some(outputName(file.name()))
    output.content = Some(joinText(header) + joinText(lines))
    return output
}

/// Generate one module for each file the request names.
// Names reach the generated file's header and comments as they arrive. protoc
// passes only identifier characters and real paths, but a request can be made
// by hand and a path can hold a line break; the text after the break would be
// compiled as code. Such a request is refused whole.
function plainName(name: Text): Boolean {
    for c in name {
        let code = Integer(c)
        if code < 32 || code == 127 || code == 0x85 || code == 0x2028 || code == 0x2029 { return false }
    }
    return true
}
function plainEnum(enumeration: descriptor.EnumDescriptorProto): Boolean {
    if !plainName(enumeration.name()) { return false }
    for value in enumeration.value { if !plainName(value.name()) { return false } }
    return true
}
function plainMessage(message: descriptor.DescriptorProto): Boolean {
    if !plainName(message.name()) { return false }
    for field in message.field { if !plainName(field.name()) || !plainName(field.typeName()) { return false } }
    for declaration in message.oneofDecl { if !plainName(declaration.name()) { return false } }
    for enumeration in message.enumType { if !plainEnum(enumeration) { return false } }
    for nested in message.nestedType { if !plainMessage(nested) { return false } }
    return true
}
function plainFile(file: descriptor.FileDescriptorProto): Boolean {
    if !plainName(file.name()) || !plainName(file.package()) { return false }
    for message in file.messageType { if !plainMessage(message) { return false } }
    for enumeration in file.enumType { if !plainEnum(enumeration) { return false } }
    for service in file.service {
        if !plainName(service.name()) { return false }
        for method in service.method { if !plainName(method.name()) || !plainName(method.inputType()) || !plainName(method.outputType()) { return false } }
    }
    return true
}

public function generate(request: plugin.CodeGeneratorRequest): plugin.CodeGeneratorResponse {
    let response = plugin.newCodeGeneratorResponse()
    response.supportedFeatures = Some(SUPPORTED_FEATURES)
    for file in request.protoFile {
        if !plainFile(file) {
            response.error = Some("protoc-gen-minyar: a file, package, type, field or method name in the request contains a control character")
            return response
        }
    }
    let generator = newGenerator(request)
    for name in request.fileToGenerate {
        if !generator.files.has(name) {
            response.error = Some("protoc-gen-minyar: " + name + " is not among the request's files")
            return response
        }
        response.file.add(generator.file(generator.files[name]))
    }
    return response
}
