use "process" as processInfo
use "./testing.min" as test
use "./check-runner.min" as runner
use "system" as system
let executable = system.getenv("MINYAR_RUSTC_CACHE_TOOL")
test.check(executable != "", "missing inherited Rust cache executable")
let arguments = [executable]
for index in 0..processInfo.argumentCount() { arguments.add(processInfo.argument(index)) }
let environment = runner.environment(system.environment(), "TMPDIR", "/tmp")
let handle = system.spawn(executable, arguments, environment, "")
test.check(handle > 0, "cannot launch inherited Rust cache")
let status = system.wait(handle)
if status.state == system.SIGNALED { exit(128 + status.signal) }
test.check(status.error == 0 && status.state == system.EXITED, "cannot wait for inherited Rust cache")
exit(status.exitCode)
