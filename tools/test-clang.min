use "./testing.min" as test
use "system" as system
let cacheTool = argument(0)
let cache = argument(1)
let real = argument(2)
let linker = argument(3)
let arguments: List<Text> = []
let linking = true
for index in 4..argumentCount() {
    let item = argument(index)
    arguments.add(item)
    for mode in ["-c", "-S", "-E", "-fsyntax-only", "--version", "-v"] { if item == mode { linking = false } }
}
let label = system.getenv("MINYAR_CHECK_LABEL")
let measured = system.getenv("MINYAR_DISABLE_COMPILER_CACHE") == "1" || test.contains(label, "budget") || test.contains(label, "performance") || test.contains(label, "timing") || test.contains(label, "measurement")
let command = [cacheTool, cacheTool, cache, real]
if linking {
    command.add("--ld-path=" + linker)
    if !measured { command.add("-Wl,--threads=1") }
}
for item in arguments { command.add(item) }
if linking { command.add("-lm") }
let argv = ["env", "--"]
for item in command { argv.add(item) }
let handle = system.spawn("/usr/bin/env", argv, system.environment(), "")
test.check(handle > 0, "cannot launch selected Clang")
let status = system.wait(handle)
if status.state == system.SIGNALED { exit(128 + status.signal) }
test.check(status.error == 0 && status.state == system.EXITED, "cannot wait for selected Clang")
exit(status.exitCode)
