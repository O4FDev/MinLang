use "./project.min" as project
use "./driver-support.min" as host
use "./module-tests.min" as moduleTests
use "system" as system
use "files" as files
use "io" as io

// `minyar sim` runs the universes in a project's sim/*.min files. Each file
// declares `public function universe(world: simulation.World): Text` returning
// "" when the run is correct or a description of what went wrong. The
// generated driver calls it through a deterministic function, so the compiler
// proves that a universe depends only on its World's decisions: a seed or a
// saved decision list reproduces any reported run.

record Batch { first: Integer; count: Integer; result: Text; script: Text; handle: Integer }
record Summary { runs: Integer; failures: Integer; firstSeed: Integer; forks: Integer; moments: List<Text>; message: Text; script: Text }

function scenarios(root: Text, filter: Text): List<Text> {
    let result: List<Text> = []
    if !host.isDirectory(root + "/sim") { return result }
    let names = files.list(root + "/sim")
    if files.lastError() != 0 { host.stop("cannot list sim/") }
    names.sort()
    for name in names {
        if !name.endsWith(".min") || !host.isFile(root + "/sim/" + name) { continue }
        if filter != "" && !host.hasText(host.stemOf(name), filter) { continue }
        result.add(name)
    }
    return result
}

// The driver records the first failing run's decisions, so explored runs
// (forked from a recorded moment) reproduce exactly like seeded ones.
function driverSource(name: Text): Text {
    return "use \"../../../sim/" + name + "\" as scenario\n" + """
        use "simulation" as simulation
        use "process" as process
        use "io" as io

        // Generated by minyar sim. The wrapper is deterministic, so the compiler
        // proves that a universe depends only on its World's decisions.
        deterministic function attempt(world: simulation.World): Text { return scenario.universe(world) }

        // New moments join the explorer's corpus as the decision prefix that reached them.
        function remember(world: simulation.World, labels: List<Text>, corpus: List<List<simulation.Decision>>, explore: Boolean) {
            let recorded: List<simulation.Decision> = []
            for moment in simulation.moments(world) {
                let known = false
                for label in labels { if label == moment.label { known = true } }
                if !known {
                    labels.add(moment.label)
                    if explore {
                        if recorded.length == 0 { recorded = simulation.choices(world) }
                        let prefix: List<simulation.Decision> = []
                        for index in 0..moment.decisions { prefix.add(recorded[index]) }
                        corpus.add(prefix)
                    }
                }
            }
        }

        function script(world: simulation.World): Text {
            let lines: List<Text> = []
            for decision in simulation.choices(world) { lines.add(Text(decision.options) + " " + Text(decision.selected) + Text(Character(10))) }
            return joinText(lines)
        }

        function decisions(text: Text): List<simulation.Decision> {
            let numbers: List<Integer> = []
            let current = 0
            let inside = false
            for character in text {
                if character >= '0' && character <= '9' {
                    current = current * 10 + Integer(character) - 48
                    inside = true
                } else if inside {
                    numbers.add(current)
                    current = 0
                    inside = false
                }
            }
            if inside { numbers.add(current) }
            if numbers.length % 2 != 0 { fail("minyar sim: a decision file holds pairs of numbers") }
            let result: List<simulation.Decision> = []
            let index = 0
            while index < numbers.length {
                result.add(simulation.Decision { options: numbers[index]; selected: numbers[index + 1] })
                index += 2
            }
            return result
        }

        let mode = process.argument(0)
        if mode == "replay" {
            let world = simulation.replay(0, decisions(io.readTextFile(process.argument(1))))
            let outcome = attempt(world)
            io.writeTextFile(process.argument(2), outcome)
        } else {
            let first = Integer(process.argument(1))
            let count = Integer(process.argument(2))
            let explore = mode == "explore"
            let labels: List<Text> = []
            let corpus: List<List<simulation.Decision>> = []
            let chooser = simulation.create(first * 7919 + 17)
            let runs = 0
            let failures = 0
            let firstSeed = -1
            let forks = 0
            let message = ""
            for run in 0..count {
                let seed = first + run
                let world = simulation.create(seed)
                if explore && corpus.length > 0 && simulation.choose(chooser, 2) == 1 {
                    world = simulation.fork(seed, corpus[simulation.choose(chooser, corpus.length)])
                    forks += 1
                }
                let outcome = attempt(world)
                runs += 1
                remember(world, labels, corpus, explore)
                if outcome != "" {
                    if failures == 0 {
                        firstSeed = seed
                        message = outcome
                        io.writeTextFile(process.argument(4), script(world))
                    }
                    failures += 1
                    if explore { break }
                }
            }
            let parts = [Text(runs) + " " + Text(failures) + " " + Text(firstSeed) + " " + Text(forks) + Text(Character(10))]
            for index in 0..labels.length {
                if index > 0 { parts.add(Text(Character(9))) }
                parts.add(labels[index])
            }
            parts.add(Text(Character(10)))
            parts.add(message)
            io.writeTextFile(process.argument(3), joinText(parts))
        }
        """
}

function start(executable: Text, root: Text, mode: Text, first: Integer, count: Integer, result: Text, script: Text): Batch {
    let arguments = [executable, mode, Text(first), Text(count), result, script]
    let handle = system.spawn(executable, arguments, system.environment(), root)
    if handle < 0 { host.stop(host.osError(handle, executable)) }
    return Batch { first: first; count: count; result: result; script: script; handle: handle }
}

function waitFor(handle: Integer, what: Text) {
    let status = system.wait(handle)
    if status.state != system.EXITED || status.exitCode != 0 { host.stop("a universe stopped instead of returning; " + what) }
}

function finish(batch: Batch): Summary {
    waitFor(batch.handle, "run minyar sim --seeds 1 --first " + Text(batch.first) + " to see it")
    let text = io.readTextFile(batch.result)
    let first = text.find("\n")
    if first < 0 { host.stop("unreadable simulation result: " + batch.result) }
    let rest = text.slice(first + 1, text.length)
    let second = rest.find("\n")
    if second < 0 { host.stop("unreadable simulation result: " + batch.result) }
    let fields = host.words(text.slice(0, first))
    if fields.length != 4 { host.stop("unreadable simulation result: " + batch.result) }
    let moments: List<Text> = []
    let labels = rest.slice(0, second)
    let start = 0
    for index in 0..labels.length + 1 {
        if index == labels.length || labels[index] == '\t' {
            if index > start { moments.add(labels.slice(start, index)) }
            start = index + 1
        }
    }
    return Summary { runs: Integer(fields[0]); failures: Integer(fields[1]); firstSeed: Integer(fields[2]); forks: Integer(fields[3]); moments: moments; message: rest.slice(second + 1, rest.length); script: batch.script }
}

function replayOutcome(executable: Text, root: Text, script: Text, result: Text): Text {
    let handle = system.spawn(executable, [executable, "replay", script, result], system.environment(), root)
    if handle < 0 { host.stop(host.osError(handle, executable)) }
    waitFor(handle, "replay " + script + " to see it")
    return io.readTextFile(result)
}

function compileScenario(graph: project.Graph, compiler: Text, root: Text, directory: Text, name: Text, errorFormat: Text): Text {
    let stem = host.stemOf(name)
    let source = directory + "/" + stem + ".min"
    io.writeTextFile(source, driverSource(name))
    let executable = directory + "/" + stem
    // Compiler diagnostics stay on standard error; the build summary is dropped.
    let shell = host.which("sh")
    if shell == "" { host.stop("sh is required to run simulations") }
    let arguments = [shell, "-c", "exec \"$@\" >/dev/null", "minyar-sim"]
    for item in moduleTests.compilerArguments(graph, compiler) { arguments.add(item) }
    arguments.add("--release")
    if errorFormat != "" { arguments.add("--error-format"); arguments.add(errorFormat) }
    for item in [source, "-o", executable] { arguments.add(item) }
    let compiled = system.spawn(shell, arguments, system.environment(), root)
    if compiled < 0 { host.stop(host.osError(compiled, arguments[0])) }
    let status = system.wait(compiled)
    if status.state != system.EXITED || status.exitCode != 0 { exit(1) }
    return executable
}

// Run every matching scenario; false when any universe failed.
public function run(graph: project.Graph, filters: List<Text>, first: Integer, seeds: Integer, jobs: Integer, seed: Integer, explore: Boolean, replay: Text, compiler: Text, directory: Text, errorFormat: Text): Boolean {
    let root = graph.packages[0].root
    let filter = ""
    if filters.length > 0 { filter = filters[0] }
    let names = scenarios(root, filter)
    if names.length == 0 {
        if filter != "" { host.stop("no simulation in sim/ matched " + filter) }
        host.stop("no simulations: add sim/NAME.min declaring public function universe(world: simulation.World): Text")
    }
    if replay != "" && names.length != 1 { host.stop("--replay needs one scenario name") }
    let passed = true
    for name in names {
        let stem = host.stemOf(name)
        let executable = compileScenario(graph, compiler, root, directory, name, errorFormat)
        if replay != "" {
            let outcome = replayOutcome(executable, root, host.resolveName(replay), directory + "/" + stem + "-replay.result")
            if outcome == "" { print("sim " + stem + ": the recorded run passed") } else {
                print("sim " + stem + ": the recorded run failed: " + outcome)
                passed = false
            }
            continue
        }
        if seed >= 0 {
            let single = finish(start(executable, root, "batch", seed, 1, directory + "/" + stem + "-seed.result", directory + "/" + stem + "-seed.decisions"))
            if single.failures == 0 { print("sim " + stem + ": seed " + Text(seed) + " passed") } else {
                print("sim " + stem + ": seed " + Text(seed) + " failed: " + single.message)
                passed = false
            }
            continue
        }
        let mode = "batch"
        if explore { mode = "explore" }
        let started = system.monotonicNanoseconds()
        let batches: List<Batch> = []
        let share = seeds / jobs
        let extra = seeds % jobs
        let next = first
        for job in 0..jobs {
            let count = share
            if job < extra { count += 1 }
            if count > 0 {
                let base = directory + "/" + stem + "-" + Text(job)
                batches.add(start(executable, root, mode, next, count, base + ".result", base + ".decisions"))
                next += count
            }
        }
        let total = Summary { runs: 0; failures: 0; firstSeed: -1; forks: 0; moments: []; message: ""; script: "" }
        for batch in batches {
            let summary = finish(batch)
            total.runs += summary.runs
            total.failures += summary.failures
            total.forks += summary.forks
            for label in summary.moments { if !host.listed(total.moments, label) { total.moments.add(label) } }
            if summary.failures > 0 && total.firstSeed < 0 { total.firstSeed = summary.firstSeed; total.message = summary.message; total.script = summary.script }
        }
        let milliseconds = (system.monotonicNanoseconds() - started) / 1000000
        let range = "seeds " + Text(first) + ".." + Text(first + seeds - 1) + ", " + Text(batches.length) + " jobs, " + Text(milliseconds) + " ms"
        let verb = "ran"
        if explore { verb = "explored" }
        let detail = ""
        if explore { detail = ", " + Text(total.forks) + " forked from recorded moments" }
        if total.failures == 0 {
            print("sim " + stem + ": " + verb + " " + Text(total.runs) + " universes, no failures (" + range + detail + ")")
        } else {
            passed = false
            if explore {
                print("sim " + stem + ": " + verb + " " + Text(total.runs) + " universes; one failed (" + range + detail + ")")
            } else {
                print("sim " + stem + ": " + Text(total.failures) + " of " + Text(total.runs) + " universes failed (" + range + ")")
            }
            print("  first: seed " + Text(total.firstSeed) + ": " + total.message)
            let again = replayOutcome(executable, root, total.script, directory + "/" + stem + "-again.result")
            let third = replayOutcome(executable, root, total.script, directory + "/" + stem + "-third.result")
            if again == total.message && third == total.message { print("  replayed its decisions twice: same result") } else {
                print("  replaying its decisions gave a different result: " + again)
            }
            if !explore { print("  reproduce: minyar sim " + stem + " --seed " + Text(total.firstSeed)) }
            print("  decisions: " + total.script)
            print("  replay: minyar sim " + stem + " --replay " + total.script)
        }
        if total.moments.length > 0 { print("  moments reached: " + host.joined(total.moments, ", ")) }
    }
    return passed
}
