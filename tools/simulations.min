use "./project.min" as project
use "./driver-support.min" as host
use "./module-tests.min" as moduleTests
use "system" as system
use "files" as files
use "io" as io

// `minyar sim` runs the universes in a project's sim/*.min files. Each file
// declares `public function universe(seed: Integer): Text` returning "" when the
// run is correct or a description of what went wrong. The generated driver
// calls it through a deterministic function, so the compiler proves that every
// universe depends only on its seed, and any reported seed reproduces.

record Batch { first: Integer; count: Integer; result: Text; handle: Integer }
record Summary { count: Integer; failures: Integer; firstSeed: Integer; message: Text }

function scenarios(root: Text, filter: Text): List<Text> {
    let result: List<Text> = []
    if !host.isDirectory(root + "/sim") { return result }
    let names = files.list(root + "/sim")
    if files.lastError() != 0 { host.stop("cannot list sim/") }
    names.sort()
    for name in names {
        if !name.endsWith(".min") || !host.isFile(root + "/sim/" + name) { continue }
        if filter != "" && !host.hasText(host.stemOf(name), filter) { continue }
        result.add(name)
    }
    return result
}

function driverSource(name: Text): Text {
    return "use \"../../../sim/" + name + "\" as scenario\n" + """
        use "process" as process
        use "io" as io

        // Generated by minyar sim. The wrapper is deterministic, so the compiler
        // proves that the scenario's universe depends only on its seed.
        deterministic function attempt(seed: Integer): Text { return scenario.universe(seed) }

        let first = Integer(process.argument(0))
        let count = Integer(process.argument(1))
        let failures = 0
        let firstSeed = -1
        let message = ""
        for seed in first..first + count {
            let outcome = attempt(seed)
            if outcome != "" {
                if failures == 0 { firstSeed = seed; message = outcome }
                failures += 1
            }
        }
        io.writeTextFile(process.argument(2), Text(count) + " " + Text(failures) + " " + Text(firstSeed) + "|" + message)
        """
}

function start(executable: Text, root: Text, first: Integer, count: Integer, result: Text): Batch {
    let arguments = [executable, Text(first), Text(count), result]
    let handle = system.spawn(executable, arguments, system.environment(), root)
    if handle < 0 { host.stop(host.osError(handle, executable)) }
    return Batch { first: first; count: count; result: result; handle: handle }
}

function finish(batch: Batch): Summary {
    let status = system.wait(batch.handle)
    if status.state != system.EXITED || status.exitCode != 0 {
        host.stop("a universe stopped instead of returning; run minyar sim --seeds 1 --first " + Text(batch.first) + " to see it")
    }
    let text = io.readTextFile(batch.result)
    let line = text.find("|")
    if line < 0 { host.stop("unreadable simulation result: " + batch.result) }
    let fields = host.words(text.slice(0, line))
    if fields.length != 3 { host.stop("unreadable simulation result: " + batch.result) }
    return Summary { count: Integer(fields[0]); failures: Integer(fields[1]); firstSeed: Integer(fields[2]); message: text.slice(line + 1, text.length) }
}

function once(executable: Text, root: Text, directory: Text, seed: Integer): Summary {
    return finish(start(executable, root, seed, 1, directory + "/seed-" + Text(seed) + ".result"))
}

// Run every matching scenario; false when any universe failed.
public function run(graph: project.Graph, filters: List<Text>, first: Integer, seeds: Integer, jobs: Integer, seed: Integer, compiler: Text, directory: Text, errorFormat: Text): Boolean {
    let root = graph.packages[0].root
    let filter = ""
    if filters.length > 0 { filter = filters[0] }
    let names = scenarios(root, filter)
    if names.length == 0 {
        if filter != "" { host.stop("no simulation in sim/ matched " + filter) }
        host.stop("no simulations: add sim/NAME.min declaring public function universe(seed: Integer): Text")
    }
    let passed = true
    for name in names {
        let stem = host.stemOf(name)
        let source = directory + "/" + stem + ".min"
        io.writeTextFile(source, driverSource(name))
        let executable = directory + "/" + stem
        // Compiler diagnostics stay on standard error; the build summary is dropped.
        let shell = host.which("sh")
        if shell == "" { host.stop("sh is required to run simulations") }
        let arguments = [shell, "-c", "exec \"$@\" >/dev/null", "minyar-sim"]
        for item in moduleTests.compilerArguments(graph, compiler) { arguments.add(item) }
        arguments.add("--release")
        if errorFormat != "" { arguments.add("--error-format"); arguments.add(errorFormat) }
        for item in [source, "-o", executable] { arguments.add(item) }
        let compiled = system.spawn(shell, arguments, system.environment(), root)
        if compiled < 0 { host.stop(host.osError(compiled, arguments[0])) }
        let status = system.wait(compiled)
        if status.state != system.EXITED || status.exitCode != 0 { exit(1) }
        if seed >= 0 {
            let single = once(executable, root, directory, seed)
            if single.failures == 0 { print("sim " + stem + ": seed " + Text(seed) + " passed") } else {
                print("sim " + stem + ": seed " + Text(seed) + " failed: " + single.message)
                passed = false
            }
            continue
        }
        let started = system.monotonicNanoseconds()
        let batches: List<Batch> = []
        let share = seeds / jobs
        let extra = seeds % jobs
        let next = first
        for job in 0..jobs {
            let count = share
            if job < extra { count += 1 }
            if count > 0 {
                batches.add(start(executable, root, next, count, directory + "/" + stem + "-" + Text(job) + ".result"))
                next += count
            }
        }
        let total = Summary { count: 0; failures: 0; firstSeed: -1; message: "" }
        for batch in batches {
            let summary = finish(batch)
            total.count += summary.count
            total.failures += summary.failures
            if summary.failures > 0 && total.firstSeed < 0 { total.firstSeed = summary.firstSeed; total.message = summary.message }
        }
        let milliseconds = (system.monotonicNanoseconds() - started) / 1000000
        let range = "seeds " + Text(first) + ".." + Text(first + seeds - 1) + ", " + Text(batches.length) + " jobs, " + Text(milliseconds) + " ms"
        if total.failures == 0 {
            print("sim " + stem + ": " + Text(total.count) + " universes passed (" + range + ")")
            continue
        }
        passed = false
        print("sim " + stem + ": " + Text(total.failures) + " of " + Text(total.count) + " universes failed (" + range + ")")
        print("  first: seed " + Text(total.firstSeed) + ": " + total.message)
        let again = once(executable, root, directory, total.firstSeed)
        let third = once(executable, root, directory, total.firstSeed)
        if again.message == total.message && third.message == total.message { print("  replayed seed " + Text(total.firstSeed) + " twice: same result") } else {
            print("  replaying seed " + Text(total.firstSeed) + " gave a different result: " + again.message)
        }
        print("  reproduce: minyar sim " + stem + " --seed " + Text(total.firstSeed))
    }
    return passed
}
