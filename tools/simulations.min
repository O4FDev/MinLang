use "./project.min" as project
use "./driver-support.min" as host
use "./module-tests.min" as moduleTests
use "system" as system
use "files" as files
use "io" as io

// `minyar sim` runs the universes in a project's sim/*.min files. Each file
// declares `public function universe(world: simulation.World): Text` returning
// "" when the run is correct or a description of what went wrong. The
// generated driver calls it through a deterministic function, so the compiler
// proves that a universe depends only on its World's decisions: a seed or a
// saved decision list reproduces any reported run.

record Batch { first: Integer; count: Integer; result: Text; script: Text; handle: Integer }
record Summary { runs: Integer; failures: Integer; firstSeed: Integer; forks: Integer; mutated: Integer; lastPrint: Integer; moments: List<Text>; message: Text; script: Text }

function scenarios(root: Text, filter: Text): List<Text> {
    let result: List<Text> = []
    if !host.isDirectory(root + "/sim") { return result }
    let names = files.list(root + "/sim")
    if files.lastError() != 0 { host.stop("cannot list sim/") }
    names.sort()
    for name in names {
        if !name.endsWith(".min") || !host.isFile(root + "/sim/" + name) { continue }
        if filter != "" && !host.hasText(host.stemOf(name), filter) { continue }
        result.add(name)
    }
    return result
}

// The driver records the first failing run's decisions, so explored runs
// (forked from a recorded moment) reproduce exactly like seeded ones.
function driverSource(name: Text): Text {
    return "use \"../../../sim/" + name + "\" as scenario\n" + """
        use "simulation" as simulation
        use "process" as process
        use "io" as io

        // Generated by minyar sim. The wrapper is deterministic, so the compiler
        // proves that a universe depends only on its World's decisions.
        deterministic function attempt(world: simulation.World): Text { return scenario.universe(world) }

        // New moments join the explorer's corpus as the decision prefix that reached them.
        function remember(world: simulation.World, labels: List<Text>, corpus: List<List<simulation.Decision>>, explore: Boolean) {
            let recorded: List<simulation.Decision> = []
            for moment in simulation.moments(world) {
                let known = false
                for label in labels { if label == moment.label { known = true } }
                if !known {
                    labels.add(moment.label)
                    if explore {
                        if recorded.length == 0 { recorded = simulation.choices(world) }
                        let prefix: List<simulation.Decision> = []
                        for index in 0..moment.decisions { prefix.add(recorded[index]) }
                        corpus.add(prefix)
                    }
                }
            }
        }

        // A run kept for its fault windows: the decisions before them, the
        // windows, the random state that continued after them, and its moments.
        record Entry { stream: Integer; prefix: List<simulation.Decision>; windows: List<simulation.Window>; limits: simulation.WindowLimits; labels: List<Text> }

        // Runs that reached rare moments are picked more often: each label adds
        // 1 / (runs that reached it), and every entry keeps a small weight.
        function pick(entries: List<Entry>, counts: Map<Text, Integer>, chooser: simulation.World): Entry {
            let weights: List<Float> = []
            let total = 0.0
            for entry in entries {
                let weight = 0.001
                for label in entry.labels { weight += 1.0 / Float(counts[label]) }
                weights.add(weight)
                total += weight
            }
            let point = Float(simulation.choose(chooser, 1000000000)) / 1000000000.0 * total
            for index in 0..entries.length {
                if point < weights[index] { return entries[index] }
                point -= weights[index]
            }
            return entries[entries.length - 1]
        }

        function sameLimits(left: simulation.WindowLimits, right: simulation.WindowLimits): Boolean {
            return left.most == right.most && left.kinds == right.kinds && left.nodes == right.nodes && left.horizon == right.horizon && left.shortest == right.shortest && left.longest == right.longest
        }

        function within(value: Integer, low: Integer, high: Integer): Integer { return min(high, max(low, value)) }

        function otherNode(limits: simulation.WindowLimits, node: Integer, chooser: simulation.World): Integer {
            if limits.nodes < 2 { return node }
            return (node + 1 + simulation.choose(chooser, limits.nodes - 1)) % limits.nodes
        }

        // One to three semantic changes to a kept run's windows, as the 10-20
        // guided explorer made: shift, resize or retarget a window, change its
        // kind, add a short window near another, remove one, splice one from
        // another kept run, or continue from a new random state. Every change
        // stays within the scenario's declared limits.
        function mutate(parent: Entry, entries: List<Entry>, counts: Map<Text, Integer>, chooser: simulation.World): Entry {
            let limits = parent.limits
            let windows: List<simulation.Window> = []
            for item in parent.windows { windows.add(simulation.Window { kind: item.kind; node: item.node; other: item.other; at: item.at; length: item.length }) }
            let stream = parent.stream
            for step in 0..1 + simulation.choose(chooser, 3) {
                let choice = simulation.choose(chooser, 8)
                if choice == 0 || windows.length == 0 && (choice == 1 || choice == 2 || choice == 3 || choice == 4 || choice == 6) {
                    stream = 1 + simulation.choose(chooser, 2147483646)
                } else if choice == 1 {
                    let item = windows[simulation.choose(chooser, windows.length)]
                    let reach = max(1, limits.horizon / 20)
                    item.at = within(item.at + simulation.choose(chooser, 2 * reach + 1) - reach, 0, limits.horizon - 1)
                } else if choice == 2 {
                    let item = windows[simulation.choose(chooser, windows.length)]
                    item.length = within(item.length * (10 + simulation.choose(chooser, 141)) / 100, limits.shortest, limits.longest)
                } else if choice == 3 {
                    let item = windows[simulation.choose(chooser, windows.length)]
                    item.node = simulation.choose(chooser, limits.nodes)
                    item.other = otherNode(limits, item.node, chooser)
                } else if choice == 4 {
                    let item = windows[simulation.choose(chooser, windows.length)]
                    if limits.kinds > 1 { item.kind = (item.kind + 1 + simulation.choose(chooser, limits.kinds - 1)) % limits.kinds }
                } else if choice == 5 {
                    if windows.length < limits.most {
                        let near = simulation.choose(chooser, limits.horizon)
                        if windows.length > 0 { near = windows[simulation.choose(chooser, windows.length)].at }
                        let reach = max(1, limits.horizon / 30)
                        let node = simulation.choose(chooser, limits.nodes)
                        windows.add(simulation.Window {
                            kind: simulation.choose(chooser, limits.kinds); node: node; other: otherNode(limits, node, chooser)
                            at: within(near + simulation.choose(chooser, 2 * reach + 1) - reach, 0, limits.horizon - 1)
                            length: limits.shortest + simulation.choose(chooser, (limits.longest - limits.shortest) / 5 + 1)
                        })
                    }
                } else if choice == 6 {
                    let kept: List<simulation.Window> = []
                    let removed = simulation.choose(chooser, windows.length)
                    for index in 0..windows.length { if index != removed { kept.add(windows[index]) } }
                    windows = kept
                } else {
                    let donor = pick(entries, counts, chooser)
                    if windows.length < limits.most && donor.windows.length > 0 && sameLimits(donor.limits, limits) {
                        let item = donor.windows[simulation.choose(chooser, donor.windows.length)]
                        windows.add(simulation.Window { kind: item.kind; node: item.node; other: item.other; at: item.at; length: item.length })
                    }
                }
            }
            return Entry { stream: stream; prefix: parent.prefix; windows: windows; limits: limits; labels: [] }
        }

        // Count the run's moments; keep a run with windows when it reached a
        // moment no earlier run did, and one in a hundred others.
        function keep(world: simulation.World, entries: List<Entry>, counts: Map<Text, Integer>, chooser: simulation.World) {
            let labels: List<Text> = []
            let fresh = false
            for moment in simulation.moments(world) {
                labels.add(moment.label)
                if !counts.has(moment.label) { counts[moment.label] = 0; fresh = true }
                counts[moment.label] = counts[moment.label] + 1
            }
            let drawn = simulation.schedule(world)
            if drawn.start < 0 || !fresh && simulation.choose(chooser, 100) != 0 { return }
            let recorded = simulation.choices(world)
            let prefix: List<simulation.Decision> = []
            for index in 0..drawn.start { prefix.add(recorded[index]) }
            entries.add(Entry { stream: drawn.stream; prefix: prefix; windows: drawn.windows; limits: drawn.limits; labels: labels })
        }

        function script(world: simulation.World): Text {
            let lines: List<Text> = []
            for decision in simulation.choices(world) { lines.add(Text(decision.options) + " " + Text(decision.selected) + Text(Character(10))) }
            return joinText(lines)
        }

        function decisions(text: Text): List<simulation.Decision> {
            let numbers: List<Integer> = []
            let current = 0
            let inside = false
            for character in text {
                if character >= '0' && character <= '9' {
                    current = current * 10 + Integer(character) - 48
                    inside = true
                } else if inside {
                    numbers.add(current)
                    current = 0
                    inside = false
                }
            }
            if inside { numbers.add(current) }
            if numbers.length % 2 != 0 { fail("minyar sim: a decision file holds pairs of numbers") }
            let result: List<simulation.Decision> = []
            let index = 0
            while index < numbers.length {
                result.add(simulation.Decision { options: numbers[index]; selected: numbers[index + 1] })
                index += 2
            }
            return result
        }

        // Simpler means fewer decisions, then smaller selections.
        function simpler(left: List<simulation.Decision>, right: List<simulation.Decision>): Boolean {
            if left.length != right.length { return left.length < right.length }
            let leftSum = 0
            let rightSum = 0
            for decision in left { leftSum += decision.selected }
            for decision in right { rightSum += decision.selected }
            return leftSum < rightSum
        }

        // Follow `candidate` where it fits; keep the run's actual decisions when it
        // still fails and is simpler than the best so far.
        function tryCandidate(candidate: List<simulation.Decision>, best: List<List<simulation.Decision>>): Boolean {
            let world = simulation.guide(0, candidate)
            if attempt(world) == "" { return false }
            let actual = simulation.choices(world)
            if !simpler(actual, best[0]) { return false }
            best[0] = actual
            return true
        }

        function without(source: List<simulation.Decision>, start: Integer, count: Integer): List<simulation.Decision> {
            let result: List<simulation.Decision> = []
            for index in 0..source.length { if index < start || index >= start + count { result.add(source[index]) } }
            return result
        }

        // Shorten, delete and lower decisions of a failing run within `budget` replays.
        function shrink(start: List<simulation.Decision>, budget: Integer): List<Integer> {
            let best: List<List<simulation.Decision>> = [start]
            let tries = 0
            let improved = true
            while improved && tries < budget {
                improved = false
                let keep = best[0].length / 2
                while keep > 0 && tries < budget {
                    tries += 1
                    if tryCandidate(without(best[0], keep, best[0].length - keep), best) { improved = true; keep = best[0].length / 2 } else { keep = keep / 2 }
                }
                for size in [16, 4, 1] {
                    let position = 0
                    while position + size <= best[0].length && tries < budget {
                        tries += 1
                        if tryCandidate(without(best[0], position, size), best) { improved = true } else { position += size }
                    }
                }
                let index = 0
                while index < best[0].length && tries < budget {
                    if best[0][index].selected > 0 {
                        let lowered: List<simulation.Decision> = []
                        for decision in best[0] { lowered.add(simulation.Decision { options: decision.options; selected: decision.selected }) }
                        lowered[index].selected = 0
                        tries += 1
                        if tryCandidate(lowered, best) { improved = true } else if best[0][index].selected > 1 {
                            lowered[index].selected = best[0][index].selected / 2
                            tries += 1
                            if tryCandidate(lowered, best) { improved = true }
                        }
                    }
                    index += 1
                }
            }
            let shrunk = best[0]
            let world = simulation.replay(0, shrunk)
            let outcome = attempt(world)
            io.writeTextFile(process.argument(2), script(world))
            let lines: List<Text> = []
            for line in simulation.transcript(world) { lines.add(line + Text(Character(10))) }
            io.writeTextFile(process.argument(4), joinText(lines))
            io.writeTextFile(process.argument(3), Text(start.length) + " " + Text(shrunk.length) + " " + Text(tries) + "|" + outcome)
            return [shrunk.length, tries]
        }

        // Decisions made and the outcome, as one number, to compare two runs of a seed.
        function fingerprint(world: simulation.World, outcome: Text): Integer {
            let hash = simulation.choices(world).length
            for byte in Bytes(outcome) { hash = (hash * 31 + byte) % 2147483647 }
            return hash
        }

        let mode = process.argument(0)
        if mode == "shrink" {
            shrink(decisions(io.readTextFile(process.argument(1))), 2000)
        } else if mode == "replay" {
            let world = simulation.replay(0, decisions(io.readTextFile(process.argument(1))))
            let outcome = attempt(world)
            io.writeTextFile(process.argument(2), outcome)
        } else {
            let first = Integer(process.argument(1))
            let count = Integer(process.argument(2))
            let explore = mode == "explore"
            let labels: List<Text> = []
            let corpus: List<List<simulation.Decision>> = []
            let entries: List<Entry> = []
            let counts: Map<Text, Integer> = Map()
            let chooser = simulation.create(first * 7919 + 17)
            let runs = 0
            let failures = 0
            let firstSeed = -1
            let forks = 0
            let mutated = 0
            let message = ""
            let lastPrint = 0
            // A scenario that declares fault windows is explored by mutating
            // them, after plain seeds have built a corpus; others fork from moments.
            let windowed = false
            let warmup = min(1000, count / 10)
            for run in 0..count {
                let seed = first + run
                let world = simulation.create(seed)
                if explore && windowed {
                    if run >= warmup && entries.length > 0 && simulation.choose(chooser, 2) == 1 {
                        let child = mutate(pick(entries, counts, chooser), entries, counts, chooser)
                        world = simulation.plan(child.stream, child.prefix, child.windows)
                        mutated += 1
                    }
                } else if explore && corpus.length > 0 && simulation.choose(chooser, 2) == 1 {
                    world = simulation.fork(seed, corpus[simulation.choose(chooser, corpus.length)])
                    forks += 1
                }
                let outcome = attempt(world)
                if run == count - 1 { lastPrint = fingerprint(world, outcome) }
                runs += 1
                if simulation.schedule(world).start >= 0 { windowed = true }
                if explore && windowed { keep(world, entries, counts, chooser) }
                remember(world, labels, corpus, explore && !windowed)
                if outcome != "" {
                    if failures == 0 {
                        firstSeed = seed
                        message = outcome
                        io.writeTextFile(process.argument(4), script(world))
                    }
                    failures += 1
                    if explore { break }
                }
            }
            let parts = [Text(runs) + " " + Text(failures) + " " + Text(firstSeed) + " " + Text(forks) + " " + Text(mutated) + " " + Text(lastPrint) + Text(Character(10))]
            for index in 0..labels.length {
                if index > 0 { parts.add(Text(Character(9))) }
                parts.add(labels[index])
            }
            parts.add(Text(Character(10)))
            parts.add(message)
            io.writeTextFile(process.argument(3), joinText(parts))
        }
        """
}

// Universes run safe parallel ranges on one thread: results never depend on the thread count, and with one
// thread the failure reported is always the lowest failing iteration's.
function universeEnvironment(): List<Text> {
    let result: List<Text> = []
    for entry in system.environment() {
        if !entry.startsWith("MINYAR_PARALLEL_THREADS=") { result.add(entry) }
    }
    result.add("MINYAR_PARALLEL_THREADS=1")
    return result
}

function start(executable: Text, root: Text, mode: Text, first: Integer, count: Integer, result: Text, script: Text): Batch {
    let arguments = [executable, mode, Text(first), Text(count), result, script]
    let handle = system.spawn(executable, arguments, universeEnvironment(), root)
    if handle < 0 { host.stop(host.osError(handle, executable)) }
    return Batch { first: first; count: count; result: result; script: script; handle: handle }
}

function waitFor(handle: Integer, what: Text) {
    let status = system.wait(handle)
    if status.state != system.EXITED || status.exitCode != 0 { host.stop("a universe stopped instead of returning; " + what) }
}

function finish(batch: Batch): Summary {
    waitFor(batch.handle, "run minyar sim --seeds 1 --first " + Text(batch.first) + " to see it")
    let text = io.readTextFile(batch.result)
    let first = text.find("\n")
    if first < 0 { host.stop("unreadable simulation result: " + batch.result) }
    let rest = text.slice(first + 1, text.length)
    let second = rest.find("\n")
    if second < 0 { host.stop("unreadable simulation result: " + batch.result) }
    let fields = host.words(text.slice(0, first))
    if fields.length != 6 { host.stop("unreadable simulation result: " + batch.result) }
    let moments: List<Text> = []
    let labels = rest.slice(0, second)
    let start = 0
    for index in 0..labels.length + 1 {
        if index == labels.length || labels[index] == '\t' {
            if index > start { moments.add(labels.slice(start, index)) }
            start = index + 1
        }
    }
    return Summary { runs: Integer(fields[0]); failures: Integer(fields[1]); firstSeed: Integer(fields[2]); forks: Integer(fields[3]); mutated: Integer(fields[4]); lastPrint: Integer(fields[5]); moments: moments; message: rest.slice(second + 1, rest.length); script: batch.script }
}

function replayOutcome(executable: Text, root: Text, script: Text, result: Text): Text {
    let handle = system.spawn(executable, [executable, "replay", script, result], universeEnvironment(), root)
    if handle < 0 { host.stop(host.osError(handle, executable)) }
    waitFor(handle, "replay " + script + " to see it")
    return io.readTextFile(result)
}

// Shrink a failing run's decisions; "" or the report lines.
function shrinkReport(executable: Text, root: Text, stem: Text, script: Text, directory: Text): Text {
    let shrunk = directory + "/" + stem + "-shrunk.decisions"
    let result = directory + "/" + stem + "-shrunk.result"
    let transcript = directory + "/" + stem + "-shrunk.transcript"
    let handle = system.spawn(executable, [executable, "shrink", script, shrunk, result, transcript], universeEnvironment(), root)
    if handle < 0 { host.stop(host.osError(handle, executable)) }
    waitFor(handle, "replay " + script + " to see it")
    let text = io.readTextFile(result)
    let bar = text.find("|")
    if bar < 0 { host.stop("unreadable shrink result: " + result) }
    let fields = host.words(text.slice(0, bar))
    let message = text.slice(bar + 1, text.length)
    if message == "" { return "  shrinking lost the failure; keep the original decisions\n" }
    return "  shrunk from " + fields[0] + " to " + fields[1] + " decisions in " + fields[2] + " replays: " + message + "\n  shrunk decisions: " + shrunk + "\n  transcript: " + transcript + "\n"
}

function compileScenario(graph: project.Graph, compiler: Text, root: Text, directory: Text, name: Text, errorFormat: Text): Text {
    let stem = host.stemOf(name)
    let source = directory + "/" + stem + ".min"
    io.writeTextFile(source, driverSource(name))
    let executable = directory + "/" + stem
    // Compiler diagnostics stay on standard error; the build summary is dropped.
    let shell = host.which("sh")
    if shell == "" { host.stop("sh is required to run simulations") }
    let arguments = [shell, "-c", "exec \"$@\" >/dev/null", "minyar-sim"]
    for item in moduleTests.compilerArguments(graph, compiler) { arguments.add(item) }
    arguments.add("--release")
    // A binary package's `memory` setting applies to its universes too.
    let memory = graph.packages[0].memory
    if memory != "" { arguments.add("--memory-profile"); arguments.add(memory) }
    if errorFormat != "" { arguments.add("--error-format"); arguments.add(errorFormat) }
    for item in [source, "-o", executable] { arguments.add(item) }
    let compiled = system.spawn(shell, arguments, system.environment(), root)
    if compiled < 0 { host.stop(host.osError(compiled, arguments[0])) }
    let status = system.wait(compiled)
    if status.state != system.EXITED || status.exitCode != 0 { exit(1) }
    return executable
}

// Run every matching scenario; false when any universe failed.
public function run(graph: project.Graph, filters: List<Text>, first: Integer, seeds: Integer, jobs: Integer, seed: Integer, explore: Boolean, replay: Text, compiler: Text, directory: Text, errorFormat: Text): Boolean {
    let root = graph.packages[0].root
    let filter = ""
    if filters.length > 0 { filter = filters[0] }
    let names = scenarios(root, filter)
    if names.length == 0 {
        if filter != "" { host.stop("no simulation in sim/ matched " + filter) }
        host.stop("no simulations: add sim/NAME.min declaring public function universe(world: simulation.World): Text")
    }
    if replay != "" && names.length != 1 { host.stop("--replay needs one scenario name") }
    let passed = true
    for name in names {
        let stem = host.stemOf(name)
        let executable = compileScenario(graph, compiler, root, directory, name, errorFormat)
        if replay != "" {
            let outcome = replayOutcome(executable, root, host.resolveName(replay), directory + "/" + stem + "-replay.result")
            if outcome == "" { print("sim " + stem + ": the recorded run passed") } else {
                print("sim " + stem + ": the recorded run failed: " + outcome)
                passed = false
            }
            continue
        }
        if seed >= 0 {
            let single = finish(start(executable, root, "batch", seed, 1, directory + "/" + stem + "-seed.result", directory + "/" + stem + "-seed.decisions"))
            if single.failures == 0 { print("sim " + stem + ": seed " + Text(seed) + " passed") } else {
                print("sim " + stem + ": seed " + Text(seed) + " failed: " + single.message)
                passed = false
            }
            continue
        }
        let mode = "batch"
        if explore { mode = "explore" }
        let started = system.monotonicNanoseconds()
        let batches: List<Batch> = []
        let share = seeds / jobs
        let extra = seeds % jobs
        let next = first
        for job in 0..jobs {
            let count = share
            if job < extra { count += 1 }
            if count > 0 {
                let base = directory + "/" + stem + "-" + Text(job)
                batches.add(start(executable, root, mode, next, count, base + ".result", base + ".decisions"))
                next += count
            }
        }
        let total = Summary { runs: 0; failures: 0; firstSeed: -1; forks: 0; mutated: 0; lastPrint: 0; moments: []; message: ""; script: "" }
        let firstPrint = 0
        for batch in batches {
            let summary = finish(batch)
            if batch.first == first { firstPrint = summary.lastPrint }
            total.runs += summary.runs
            total.failures += summary.failures
            total.forks += summary.forks
            total.mutated += summary.mutated
            for label in summary.moments { if !host.listed(total.moments, label) { total.moments.add(label) } }
            if summary.failures > 0 && total.firstSeed < 0 { total.firstSeed = summary.firstSeed; total.message = summary.message; total.script = summary.script }
        }
        let milliseconds = (system.monotonicNanoseconds() - started) / 1000000
        let range = "seeds " + Text(first) + ".." + Text(first + seeds - 1) + ", " + Text(batches.length) + " jobs, " + Text(milliseconds) + " ms"
        let verb = "ran"
        if explore { verb = "explored" }
        let detail = ""
        if explore && total.mutated > 0 { detail = ", " + Text(total.mutated) + " from mutated fault windows" } else if explore { detail = ", " + Text(total.forks) + " forked from recorded moments" }
        // The static proof does not cover state that universes share through
        // module globals: the first batch's last seed must run the same alone.
        if !explore && batches[0].count > 1 {
            let lastSeed = first + batches[0].count - 1
            let alone = finish(start(executable, root, "batch", lastSeed, 1, directory + "/" + stem + "-alone.result", directory + "/" + stem + "-alone.decisions"))
            if alone.lastPrint != firstPrint {
                passed = false
                print("sim " + stem + ": seed " + Text(lastSeed) + " ran differently alone than after " + Text(batches[0].count - 1) + " earlier universes in one process; the universes share state through a module global, so reset it in universe or pass it in")
            }
        }
        if total.failures == 0 {
            print("sim " + stem + ": " + verb + " " + Text(total.runs) + " universes, no failures (" + range + detail + ")")
        } else {
            passed = false
            if explore {
                print("sim " + stem + ": " + verb + " " + Text(total.runs) + " universes; one failed (" + range + detail + ")")
            } else {
                print("sim " + stem + ": " + Text(total.failures) + " of " + Text(total.runs) + " universes failed (" + range + ")")
            }
            print("  first: seed " + Text(total.firstSeed) + ": " + total.message)
            let again = replayOutcome(executable, root, total.script, directory + "/" + stem + "-again.result")
            let third = replayOutcome(executable, root, total.script, directory + "/" + stem + "-third.result")
            if again == total.message && third == total.message { print("  replayed its decisions twice: same result") } else {
                print("  replaying its decisions gave a different result: " + again)
            }
            if !explore { print("  reproduce: minyar sim " + stem + " --seed " + Text(total.firstSeed)) }
            print("  decisions: " + total.script)
            print("  replay: minyar sim " + stem + " --replay " + total.script)
            files.writeStandardOutput(shrinkReport(executable, root, stem, total.script, directory))
        }
        if total.moments.length > 0 { print("  moments reached: " + host.joined(total.moments, ", ")) }
    }
    return passed
}
