#!/bin/sh
# dev-check coverage make shim: profiles of each `make -j1 check-x` go to that check's directory.
data=${DEVCHECK_COV_DATA:?}
last=
for a in "$@"; do last=$a; done
case " $* " in
    *" -j1 "*) if [ -n "$last" ] && [ -d "$data/$last" ] && [ -z "${DEVCHECK_COV_CHECK:-}" ]; then
        DEVCHECK_COV_CHECK=$last; LLVM_PROFILE_FILE="$data/$last/%p.profraw"
        export DEVCHECK_COV_CHECK LLVM_PROFILE_FILE
    fi ;;
esac
exec /usr/bin/make "$@"
