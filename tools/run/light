#!/bin/sh
# light CMD...: for commands that finish in under 90 s on one core (one compile, `minyar --check`, one small
# program or one narrow check). Its own queue of MINYAR_LIGHT_SLOTS (default 3), first come first served; the
# command is killed after 120 s. Use heavy for builds and multi-check runs.
HEAVY_SLOTS=${MINYAR_LIGHT_SLOTS:-3} HEAVY_KIND=light exec "$(dirname "$0")/heavy" \
    /usr/bin/perl -e 'alarm 120; exec @ARGV or die "light: cannot run $ARGV[0]\n"' "$@"
