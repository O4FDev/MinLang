use "./driver-support.min" as host

// Source positions are expected to move. Literal symbol IDs are token indexes
// and also move when a brace acquires a newline. List literal IDs do too.
// Canonicalize ONLY those source-position and symbol-identity differences;
// representational differences; all executable instructions/data remain exact.
public function canonicalLLVM(text: Text): Text {
    let names: List<Text> = []
    let lists: List<Text> = []
    let pieces: List<Text> = []
    for line in host.lines(text) {
        if line.startsWith("; minyar-debug-line:") || line.startsWith("; minyar-debug-function:") { continue }
        if line.startsWith("@.text.data.") {
            let raw = Bytes(line)
            let end = 12
            while end < raw.length && host.isDigit(raw[end]) { end += 1 }
            names.add(host.textSlice(line, 12, end))
        } else if line.startsWith("@.list.") {
            let raw = Bytes(line)
            let end = 7
            while end < raw.length && host.isDigit(raw[end]) { end += 1 }
            lists.add(host.textSlice(line, 7, end))
        }
        pieces.add(line); pieces.add("\n")
    }
    let raw = Bytes(joinText(pieces))
    let result: List<Text> = []
    let start = 0
    let position = 0
    while position < raw.length {
        if raw[position] == 34 {
            position += 1
            while position < raw.length && raw[position] != 34 {
                if raw[position] == 92 { position += 1 }
                position += 1
            }
            if position < raw.length { position += 1 }
        } else if raw[position] == 64 {
            let end = position
            while end < raw.length && raw[end] != 32 && raw[end] != 44 && raw[end] != 41 && raw[end] != 10 { end += 1 }
            let name = Text(raw.slice(position, end))
            let prefix = ""
            if name.startsWith("@.text.data.") { prefix = "@.text.data." }
            else if name.startsWith("@.text.") { prefix = "@.text." }
            else if name.startsWith("@.list.") { prefix = "@.list." }
            if prefix != "" {
                let id = host.textSlice(name, prefix.byteLength, name.byteLength)
                let labels = names
                if prefix == "@.list." { labels = lists }
                for index in 0..labels.length {
                    if labels[index] == id {
                        result.add(Text(raw.slice(start, position)))
                        result.add(prefix + "literal\(index)")
                        start = end
                        break
                    }
                }
            }
            position = end
        } else { position += 1 }
    }
    result.add(Text(raw.slice(start, raw.length)))
    return joinText(result)
}
