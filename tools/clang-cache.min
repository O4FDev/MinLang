use "./testing.min" as test
use "system" as system
use "files" as files
use "sha256" as sha
function begins(source: Text, prefix: Text): Boolean {
    let raw = Bytes(source)
    let pattern = Bytes(prefix)
    if raw.length < pattern.length { return false }
    for index in 0..pattern.length { if raw[index] != pattern[index] { return false } }
    return true
}
function hex(bytes: Bytes): Text {
    let digits = "0123456789abcdef"
    let parts: List<Text> = []
    for byte in bytes { parts.add(Text(digits[byte / 16])); parts.add(Text(digits[byte % 16])) }
    return joinText(parts)
}
function hashFile(path: Text): Text {
    let contents = files.readFile(path)
    test.check(files.lastError() == 0, "cannot hash compiler input: " + path)
    return hex(sha.digest(contents))
}
function suffix(value: Text, ending: Text): Boolean {
    let bytes = Bytes(value)
    let tail = Bytes(ending)
    if bytes.length < tail.length { return false }
    return Text(bytes.slice(bytes.length - tail.length, bytes.length)) == ending
}
function execute(command: List<Text>): Integer {
    let argv = ["env", "--"]
    for item in command { argv.add(item) }
    let handle = system.spawn("/usr/bin/env", argv, system.environment(), "")
    if handle <= 0 { system.writeStandardError("compiler spawn failed: " + Text(handle) + "\n"); return 127 }
    let status = system.wait(handle)
    if status.error != 0 { return 127 }
    if status.state == system.SIGNALED { return 128 + status.signal }
    return status.exitCode
}
function safeFlag(arg: Text): Boolean {
    for flag in ["-O0", "-O1", "-O2", "-O3", "-Os", "-Oz", "-lm", "-pthread", "-ldl", "-flto", "-flto=thin", "-flto=full", "-fno-omit-frame-pointer", "-no-pie", "-pie", "-Wl,--threads=1", "-c", "-g", "-g0", "-Wall", "-Wextra", "-Werror", "-std=c11", "-std=gnu11", "-disable-llvm-passes"] {
        if arg == flag { return true }
    }
    return begins(arg, "-Wno-") || begins(arg, "-fsanitize=") || begins(arg, "-fno-sanitize=") || begins(arg, "-fuse-ld=") || begins(arg, "--ld-path=") || begins(arg, "-D") || begins(arg, "-U") || begins(arg, "-I")
}
function cFingerprint(args: List<Text>, source: Text, sanitizer: Boolean): Text {
    let work = test.scratch()
    let command = [args[0]]
    let index = 1
    while index < args.length {
        let arg = args[index]
        if arg == "-o" { index += 2; continue }
        if arg != "-c" && arg != "-lm" && arg != "-ldl" && !begins(arg, "-Wl,") && !begins(arg, "-fuse-ld=") && !begins(arg, "--ld-path=") && !suffix(arg, ".ll") && !suffix(arg, ".o") && !suffix(arg, ".bc") && !suffix(arg, ".a") && (!suffix(arg, ".c") || arg == source) { command.add(arg) }
        index += 1
    }
    for arg in ["-E", "-Wno-unused-command-line-argument", "-Werror=date-time", "-o", work + "/fixture.i"] { command.add(arg) }
    let preprocessed = test.run(command, system.environment(), "", work + "/preprocess", 30)
    let fingerprint = ""
    if preprocessed.status == 0 && preprocessed.output == "" && preprocessed.errorOutput == "" {
        fingerprint = "C_SOURCE:" + source + ":" + hashFile(source) + "\nPREPROCESSED:" + hashFile(work + "/fixture.i") + "\n"
        let dependencies: List<Text> = []
        for line in test.lines(readTextFile(work + "/fixture.i")) {
            if begins(line, "# ") {
                let bytes = Bytes(line)
                let opening = -1
                let closing = -1
                for position in 0..bytes.length {
                    if bytes[position] == 34 {
                        if opening < 0 { opening = position }
                        else { closing = position; break }
                    }
                }
                if opening < 0 || closing < 0 { fingerprint = ""; break }
                let path = Text(bytes.slice(opening + 1, closing))
                if path == "<built-in>" || path == "<command line>" { continue }
                if test.contains(path, "\\") || files.pathSize(path) < 0 { fingerprint = ""; break }
                let seen = false
                for dependency in dependencies { if dependency == path { seen = true } }
                if !seen { dependencies.add(path) }
            }
        }
        if fingerprint != "" {
            for path in dependencies { fingerprint += "HEADER:" + path + ":" + hashFile(path) + "\n" }
            let cwd = test.run(["/bin/pwd", "-P"], system.environment(), "", work + "/cwd", 10)
            if cwd.status != 0 { fingerprint = "" }
            else { fingerprint += "CWD:" + cwd.output }
        }
        if fingerprint != "" && sanitizer {
            let resource = test.run([args[0], "-print-runtime-dir"], system.environment(), "", work + "/resource", 10)
            if resource.status != 0 || resource.errorOutput != "" || test.lines(resource.output).length != 1 { fingerprint = "" }
            else {
                let directory = test.lines(resource.output)[0]
                let names = files.list(directory)
                if files.lastError() != 0 { fingerprint = "" }
                else {
                    names.sort()
                    let providers = 0
                    for name in names {
                        if (begins(name, "libclang_rt.asan") || begins(name, "libclang_rt.ubsan")) && (suffix(name, ".a") || suffix(name, ".so")) {
                            fingerprint += "SANITIZER:" + directory + "/" + name + ":" + hashFile(directory + "/" + name) + "\n"
                            providers += 1
                        }
                    }
                    if providers == 0 { fingerprint = "" }
                }
            }
        }
    }
    test.removeTree(work)
    return fingerprint
}
if argumentCount() == 6 && argument(0) == "--toolchain-key" {
    let parts = ["minyar-test-toolchain-v1\n"]
    for index in 1..argumentCount() { parts.add(argument(index) + ":" + hashFile(argument(index)) + "\n") }
    print(hex(sha.digest(Bytes(joinText(parts)))))
    exit(0)
}
test.check(argumentCount() >= 4, "expected SELF CACHE REAL [--locked] CLANG_ARGUMENTS")
let self = argument(0)
let cache = argument(1)
let real = argument(2)
let locked = argument(3) == "--locked"
let start = 3
if locked { start += 1 }
let args = [real]
let key = ["minyar-clang-cache-v2\n"]
let output = ""
let eligible = true
let inputs = 0
let cSources: List<Text> = []
let sanitizer = false
let explicitLinker = false
let selectedLinker = false
let linkerPaths: List<Text> = []
let index = start
while index < argumentCount() {
    let arg = argument(index)
    args.add(arg)
    if begins(arg, "-fsanitize=") {
        if arg == "-fsanitize=address" || arg == "-fsanitize=undefined" || arg == "-fsanitize=address,undefined" || arg == "-fsanitize=undefined,address" { sanitizer = true }
        else { eligible = false }
    }
    if begins(arg, "-fuse-ld=") { selectedLinker = true }
    if begins(arg, "--ld-path=") {
        let path = Text(Bytes(arg).slice(10, Bytes(arg).length))
        if files.pathSize(path) < 0 { eligible = false }
        else { linkerPaths.add(path); explicitLinker = true }
    }
    if arg == "-o" {
        test.check(index + 1 < argumentCount(), "missing compiler output")
        index += 1
        output = argument(index)
        args.add(output)
        key.add("OUTPUT\n")
    } else {
        if suffix(arg, ".c") {
            cSources.add(arg)
            inputs += 1
            key.add("C_INPUT:" + arg + "\n")
        } else if suffix(arg, ".ll") || suffix(arg, ".o") || suffix(arg, ".bc") || suffix(arg, ".a") {
            if files.pathSize(arg) < 0 { eligible = false; key.add(arg + "\n") }
            else {
                let kind = "object"
                if suffix(arg, ".ll") { kind = "llvm" }
                if suffix(arg, ".bc") { kind = "bitcode" }
                if suffix(arg, ".a") { kind = "archive:" + arg }
                key.add("INPUT:" + kind + ":" + hashFile(arg) + "\n")
                inputs += 1
            }
        } else {
            key.add(Text(Bytes(arg).length) + ":" + arg + "\n")
            if arg == "-I" || arg == "-iquote" || arg == "-isystem" || arg == "-D" || arg == "-U" || arg == "-Xclang" {
                test.check(index + 1 < argumentCount(), "missing compiler flag value")
                index += 1
                let value = argument(index)
                args.add(value)
                key.add(Text(Bytes(value).length) + ":" + value + "\n")
                if arg == "-Xclang" && value != "-disable-llvm-passes" { eligible = false }
            } else if !safeFlag(arg) { eligible = false }
        }
    }
    index += 1
}
for name in ["PATH", "LIBRARY_PATH", "LD_LIBRARY_PATH", "CPATH", "C_INCLUDE_PATH", "CPLUS_INCLUDE_PATH", "LANG", "LC_ALL", "LC_CTYPE", "SOURCE_DATE_EPOCH", "ASAN_OPTIONS", "UBSAN_OPTIONS", "CCC_OVERRIDE_OPTIONS"] {
    let value = system.getenv(name)
    key.add(name + ":" + Text(system.lastError()) + ":" + Text(Bytes(value).length) + ":" + value + "\n")
}
if selectedLinker && !explicitLinker { eligible = false }
let label = system.getenv("MINYAR_CHECK_LABEL")
if system.getenv("MINYAR_DISABLE_COMPILER_CACHE") == "1" || test.contains(label, "budget") || test.contains(label, "performance") || test.contains(label, "timing") || test.contains(label, "measurement") { eligible = false }
if output != "" {
    files.list(output)
    if files.lastError() == 0 { eligible = false }
}
if !eligible || output == "" || inputs == 0 { exit(execute(args)) }
if cSources.length == 0 {
    for arg in args {
        if arg == "-g" || arg == "-g0" || arg == "-c" || arg == "-Wall" || arg == "-Wextra" || arg == "-Werror" || begins(arg, "-D") || begins(arg, "-U") || begins(arg, "-I") || arg == "-iquote" || arg == "-isystem" || arg == "-Xclang" || arg == "-disable-llvm-passes" || begins(arg, "-std=") { exit(execute(args)) }
    }
}
for source in cSources {
    let fingerprint = cFingerprint(args, source, sanitizer)
    if fingerprint == "" { exit(execute(args)) }
    key.add(fingerprint)
}
key.add("SELF:" + hashFile(self) + "\nCOMPILER:" + hashFile(real) + "\n")
if files.pathSize("/usr/bin/ld") >= 0 { key.add("DEFAULT_LINKER:" + hashFile("/usr/bin/ld") + "\n") }
for path in linkerPaths { key.add("LINKER:" + hashFile(path) + "\n") }
test.check(files.makeDirectory(cache) == 0, "cannot create compiler cache")
let entry = cache + "/" + hex(sha.digest(Bytes(joinText(key))))
if !locked {
    let command = ["/usr/bin/flock", "-F", entry + ".lock", self, self, cache, real, "--locked"]
    for index in start..argumentCount() { command.add(argument(index)) }
    exit(execute(command))
}
if files.pathSize(entry) >= 0 { exit(execute(["/bin/cp", "-p", "--", entry, output])) }
let scratch = test.scratch()
let stdout = scratch + "/stdout"
let stderr = scratch + "/stderr"
let command = ["/bin/sh", "-c", "out=$1; err=$2; shift 2; exec \"$@\" >\"$out\" 2>\"$err\"", "minyar", stdout, stderr]
for arg in args { command.add(arg) }
let status = execute(command)
let out = files.readFile(stdout)
let err = files.readFile(stderr)
files.writeStandardOutput(Text(out))
system.writeStandardError(Text(err))
if status == 0 && out.length == 0 && err.length == 0 && files.pathSize(output) > 0 {
    let temporary = entry + ".tmp-" + Text(system.processId())
    if execute(["/bin/cp", "-p", "--", output, temporary]) == 0 {
        test.check(files.rename(temporary, entry) == 0, "cannot publish compiler cache entry")
    }
}
test.removeTree(scratch)
exit(status)
