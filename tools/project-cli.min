use "process" as processInfo
use "./project.min" as project
use "./package-git.min" as git
use "./registry.min" as registry
use "./registry-publish.min" as publish
use "./module-tests.min" as moduleTests
use "./benchmarks.min" as benchmarks
use "./simulations.min" as simulations
use "./documentation.min" as documentation
use "./live-project.min" as live
use "./driver-support.min" as host
use "system" as system
use "files" as files

record Options { command: Text; manifest: Text; path: Text; name: Text; extension: Text; root: Text; registry: Text; description: Text; errorFormat: Text; release: Boolean; library: Boolean; locked: Boolean; offline: Boolean; force: Boolean; incremental: Boolean; watch: Boolean; hot: Boolean; undo: Boolean; dryRun: Boolean; seeds: Integer; first: Integer; jobs: Integer; seed: Integer; explore: Boolean; replay: Text; positionals: List<Text>; arguments: List<Text> }

function help() {
    print("""
    Minyar project CLI

    Usage: minyar COMMAND [OPTIONS]

    Projects
      new PATH                    Create a project (--lib for a library)
      init [PATH]                 Initialize a project without overwriting files
      build                       Build the current project
      app                         Build and sign a macOS app (minyar app --help)
      run                         Build and run; pass arguments after --
      patch                       Update running copies of a build --hot binary
                                  (--undo restores the previous patch;
                                  --dry-run lists what it would change)
      check                       Check source and tests without linking
      test                        Run module, documentation and integration tests
      bench                       Measure module benchmarks in the release profile
      sim [NAME]                  Run the deterministic universes in sim/*.min
      doc                         Build the API reference and verify examples
      clean                       Remove generated files from target

    Packages
      add HOST/OWNER/REPO[@REV]   Add a verified Git source package
      add NAME[@VERSION]          Add a package from the package index by name
      add NAME --path PATH        Add an editable local library
      remove NAME                 Remove a dependency
      tree                        Show the resolved dependency graph
      metadata                    Print project and dependency metadata as JSON
      search [QUERY]              Search a configured package index
      info NAME                   Show releases, commits and checksums
      update [NAME]               Move Git dependencies to their newest compatible release
      publish [REPO]              Record a tagged release in a local package index
                                  (--dry-run prints the record instead)
      registry build|serve        Build or serve a local package index
      install                     Build and install this project's binary
      uninstall NAME              Remove a binary installed by Minyar

    Toolchains
      self update                 Install the latest signed toolchain
      toolchain install VERSION   Install a version alongside existing versions
      toolchain list|current      Show installed or selected versions
      toolchain default VERSION   Choose the default version

    Options
      --manifest-path PATH        Use a Minyar.toml or project directory
      --release                   Use the release profile (default: debug)
      --error-format FORMAT       Compiler errors as text or JSON lines
      --locked                    Require an up-to-date Minyar.lock
      --offline                   Use cached sources; never download
      --no-incremental            Disable module compilation caching
      --watch                     Rebuild and run after source edits (run only)
      --hot                       Preserve state on function edits (run --watch);
                                  with build, make a binary that minyar patch updates
      --name NAME                 Set the project name for new/init
      --lib                       Create a library with new/init
      --extension HOST            Create an extension for the project at HOST with new,
                                  from HOST's extension-template directory
      --root DIR                  Install in $MINYAR_HOME or ~/.minyar by default
      --force                     Replace a binary during install
      --registry URL              Use a package index URL or local directory
      --dry-run                   Print the release record without writing an index
      --description TEXT          Describe a release on one line
      --seeds COUNT               Universes per scenario for sim (default 10000)
      --first SEED                First seed for sim (default 0)
      --jobs COUNT                Processes sharing the seeds for sim (default 1)
      --seed SEED                 Run and explain one seed with sim
      --explore                   Fork new sim runs from recorded moments
      --replay FILE               Rerun a saved sim decision file
      -h, --help                  Show this help

    Single files: minyar [--debug|--release] FILE.min [-o PROGRAM]
    Diagnostics: minyar --doctor; minyar --version
    """)
}
function parse(): Options {
    let options = Options { command: processInfo.argument(0); manifest: ""; path: ""; name: ""; extension: ""; root: ""; registry: ""; description: ""; errorFormat: ""; release: false; library: false; locked: false; offline: false; force: false; incremental: true; watch: false; hot: false; undo: false; dryRun: false; seeds: 10000; first: 0; jobs: 1; seed: -1; explore: false; replay: ""; positionals: []; arguments: [] }
    let seen: List<Text> = []
    let index = 1
    while index < processInfo.argumentCount() {
        let item = processInfo.argument(index)
        if item == "--" {
            if options.command != "run" && options.command != "test" && options.command != "bench" { host.stop("-- arguments are supported only for run, test and bench") }
            index += 1
            while index < processInfo.argumentCount() { options.arguments.add(processInfo.argument(index)); index += 1 }
            break
        }
        if item == "--help" || item == "-h" { help(); exit(0) }
        if item.startsWith("-") {
            if host.listed(seen, item) { host.stop("duplicate option: " + item) }
            seen.add(item)
            if item == "--release" { options.release = true }
            else if item == "--lib" { options.library = true }
            else if item == "--locked" { options.locked = true }
            else if item == "--offline" { options.offline = true }
            else if item == "--force" { options.force = true }
            else if item == "--no-incremental" { options.incremental = false }
            else if item == "--watch" { options.watch = true }
            else if item == "--hot" { options.hot = true }
            else if item == "--undo" { options.undo = true }
            else if item == "--dry-run" { options.dryRun = true }
            else if item == "--explore" { options.explore = true }
            else if item == "--replay" {
                index += 1
                if index >= processInfo.argumentCount() || processInfo.argument(index) == "" { host.stop("--replay requires a decision file") }
                options.replay = processInfo.argument(index)
            }
            else if item == "--seeds" || item == "--first" || item == "--jobs" || item == "--seed" {
                index += 1
                if index >= processInfo.argumentCount() { host.stop(item + " requires a nonnegative integer") }
                let value = naturalOption(item, processInfo.argument(index))
                if item == "--seeds" { options.seeds = value }
                else if item == "--first" { options.first = value }
                else if item == "--jobs" { options.jobs = value }
                else { options.seed = value }
            }
            else if item == "--manifest-path" || item == "--path" || item == "--name" || item == "--extension" || item == "--root" || item == "--registry" || item == "--description" || item == "--error-format" {
                index += 1
                if index >= processInfo.argumentCount() || processInfo.argument(index) == "" || processInfo.argument(index).startsWith("--") { host.stop(item + " requires a value") }
                let value = processInfo.argument(index)
                if item == "--manifest-path" { options.manifest = value }
                else if item == "--path" { options.path = value }
                else if item == "--name" { options.name = value }
                else if item == "--extension" { options.extension = value }
                else if item == "--registry" { options.registry = value }
                else if item == "--description" { options.description = value }
                else if item == "--error-format" {
                    if value != "text" && value != "json" { host.stop("--error-format must be text or json") }
                    options.errorFormat = value
                }
                else { options.root = value }
            } else { host.stop("unknown option: " + item) }
        } else { options.positionals.add(item) }
        index += 1
    }
    for option in seen {
        let allowed = false
        if option == "--name" || option == "--lib" { allowed = options.command == "new" || options.command == "init" }
        else if option == "--extension" { allowed = options.command == "new" }
        else if option == "--path" { allowed = options.command == "add" || options.command == "install" || options.command == "doc" }
        else if option == "--root" { allowed = options.command == "install" || options.command == "uninstall" }
        else if option == "--force" { allowed = options.command == "install" }
        else if option == "--dry-run" { allowed = options.command == "publish" || options.command == "patch" }
        else if option == "--description" { allowed = options.command == "publish" }
        else if option == "--registry" { allowed = host.listed(["search", "info", "add", "publish"], options.command) }
        else if option == "--watch" { allowed = options.command == "run" }
        else if option == "--hot" { allowed = options.command == "run" || options.command == "build" }
        else if option == "--undo" { allowed = options.command == "patch" }
        else if option == "--seeds" || option == "--first" || option == "--jobs" || option == "--seed" || option == "--explore" || option == "--replay" { allowed = options.command == "sim" }
        else if option == "--manifest-path" { allowed = options.command != "new" && options.command != "init" && options.command != "uninstall" && options.command != "search" && options.command != "info" }
        else if option == "--locked" { allowed = host.listed(["build", "run", "patch", "check", "test", "bench", "sim", "doc", "tree", "metadata", "install"], options.command) }
        else if option == "--offline" { allowed = host.listed(["build", "run", "patch", "check", "test", "bench", "sim", "doc", "tree", "metadata", "install", "add", "remove", "search", "info"], options.command) }
        else { allowed = host.listed(["build", "run", "patch", "check", "test", "bench", "doc", "install"], options.command) }
        if !allowed { host.stop(option + " is not supported by " + options.command) }
    }
    if options.hot && options.command == "run" && !options.watch { host.stop("--hot requires run --watch") }
    if options.command == "sim" && (options.seeds == 0 || options.jobs == 0) { host.stop("--seeds and --jobs must be at least 1") }
    if options.command == "sim" && (options.seed >= 0 || options.replay != "") && (options.explore || (options.seed >= 0 && options.replay != "")) { host.stop("--seed, --replay and --explore are separate ways to run sim") }
    return options
}
function naturalOption(name: Text, value: Text): Integer {
    let bytes = Bytes(value)
    if bytes.length == 0 || bytes.length > 12 { host.stop(name + " requires a nonnegative integer") }
    for byte in bytes { if !host.isDigit(byte) { host.stop(name + " requires a nonnegative integer") } }
    return Integer(value)
}
function execute(arguments: List<Text>, directory: Text, environment: List<Text>): Integer {
    let handle = system.spawn(arguments[0], arguments, environment, directory)
    if handle < 0 { host.stop(host.osError(handle, arguments[0])) }
    let status = system.wait(handle)
    if status.state == system.SIGNALED { return 128 + status.signal }
    if status.state != system.EXITED { host.stop("cannot wait for " + arguments[0]) }
    return status.exitCode
}
function require(arguments: List<Text>, directory: Text) {
    let status = execute(arguments, directory, system.environment())
    if status != 0 { host.leave(status) }
}
function exclusive(path: Text, content: Text) {
    let file = files.open(path, files.WRITE + files.CREATE + files.EXCLUSIVE)
    if file < 0 { host.stop(host.osError(file, path)) }
    let data = Bytes(content)
    let written = files.write(file, data, 0, data.length)
    let closed = files.close(file)
    if written < 0 || closed < 0 { host.stop("cannot write " + path) }
}
function create(options: Options) {
    if options.positionals.length > 1 || (options.command == "new" && options.positionals.length != 1) { host.stop("usage: minyar " + options.command + " PATH [--name NAME] [--lib | --extension HOST]") }
    let path = "."
    if options.positionals.length == 1 { path = options.positionals[0] }
    let root = host.resolveName(path)
    if options.command == "new" && host.exists(root) { host.stop("destination already exists: " + root + "; use init for an existing directory") }
    if host.exists(root + "/Minyar.toml") { host.stop("refusing to overwrite " + root + "/Minyar.toml") }
    let name = options.name
    if name == "" { name = host.baseName(root) }
    if !project.validName(name) { host.stop("invalid package name; use --name with letters, digits, '-' or '_', starting with a letter or underscore") }
    if options.extension != "" {
        if options.library { host.stop("--extension creates a library already; leave out --lib") }
        createExtension(options.extension, root, name)
        return
    }
    let source = root + "/src/main.min"
    if options.library { source = root + "/src/" + name + ".min" }
    if host.exists(source) { host.stop("refusing to overwrite " + source) }
    host.makeDirectories(root + "/src")
    host.makeDirectories(root + "/tests")
    let kind = "bin"
    if options.library { kind = "lib" }
    let manifest = project.manifest(root, name, "0.1.0", kind)
    exclusive(root + "/Minyar.toml", project.render(manifest))
    if options.library {
        exclusive(source, "public function answer(): Integer { return 42 }\n")
        if !host.exists(root + "/tests/smoke.min") { exclusive(root + "/tests/smoke.min", "use \"" + name + "\" as package\nif package.answer() != 42 { fail(\"expected 42\") }\nprint(\"test passed\")\n") }
    } else {
        exclusive(source, "print(\"Hello, world!\")\n")
        if !host.exists(root + "/tests/smoke.min") { exclusive(root + "/tests/smoke.min", "if 1 + 1 != 2 { fail(\"arithmetic failed\") }\nprint(\"test passed\")\n") }
    }
    if !host.exists(root + "/.gitignore") { exclusive(root + "/.gitignore", "/target/\n") }
    print("Created " + name + " at " + root)
}
// minyar new PATH --extension HOST: a library package made from HOST's extension-template directory. The host
// owns its template (its SDK dependency, a starting extension, tests); "{{name}}" in file names and contents
// becomes the new package's name, and the template's path dependencies are rewritten for the new location.
function createExtension(hostPath: Text, root: Text, name: Text) {
    let hostRoot = host.resolveName(hostPath)
    if !host.isFile(hostRoot + "/Minyar.toml") { host.stop("--extension needs a project directory with a Minyar.toml: " + hostPath) }
    let hostPackage = project.read(hostRoot)
    let template = hostRoot + "/extension-template"
    if !host.isFile(template + "/Minyar.toml") {
        host.stop(hostPackage.name + " has no extension template; a project supports extensions by providing extension-template/, a library package whose files may say {{name}}")
    }
    host.makeDirectories(root)
    copyTemplate(template, root, name)
    host.makeDirectories(root + "/tests")
    let manifest = project.read(root)
    if manifest.name != name || !project.hasLibrary(manifest) { host.stop(hostPackage.name + "'s extension template must be a library named {{name}} with src/{{name}}.min") }
    for index in 0..manifest.dependencies.length {
        if manifest.repositories[index] == "" {
            let dependency = host.resolveName(template + "/" + manifest.paths[index])
            if !host.isFile(dependency + "/Minyar.toml") { host.stop("extension template dependency not found: " + manifest.paths[index]) }
            manifest.paths[index] = project.relative(root, dependency)
        }
    }
    project.atomicWrite(root + "/Minyar.toml", project.render(manifest))
    if !host.exists(root + "/.gitignore") { exclusive(root + "/.gitignore", "/target/\n") }
    print("Created " + name + " at " + root + ", an extension for " + hostPackage.name)
}
function named(text: Text, name: Text): Text { return host.joined(text.split("{{name}}"), name) }
function copyTemplate(from: Text, to: Text, name: Text) {
    for entry in files.list(from) {
        if entry != "target" && entry != ".git" {
            let source = from + "/" + entry
            let destination = to + "/" + named(entry, name)
            if host.isDirectory(source) {
                host.makeDirectories(destination)
                copyTemplate(source, destination, name)
            } else if host.isFile(source) {
                exclusive(destination, named(host.readText(source), name))
            }
        }
    }
}
function target(root: Text, create: Boolean): Text {
    let path = root + "/target"
    // Never follow a target-directory symlink for output or recursive deletion.
    if host.resolveName(path) != path { host.stop("target must be a real directory inside the package: " + path) }
    let marker = path + "/.minyar-target"
    if host.exists(path) {
        if !host.isDirectory(path) || !host.isFile(marker) || host.readText(marker) != "minyar-target-v1\n" { host.stop("refusing to use an unowned target directory: " + path) }
    } else if create {
        host.makeDirectories(path)
        exclusive(marker, "minyar-target-v1\n")
    }
    return path
}
function outputDirectory(root: Text, relative: Text): Text {
    let directory = target(root, true) + "/" + relative
    if host.resolveName(directory) != directory { host.stop("output directories must remain inside target: " + directory) }
    host.makeDirectories(directory)
    return directory
}
function profile(options: Options): Text {
    if options.release { return "release" }
    return "debug"
}
function compiler(): Text {
    let root = system.getenv("MINYAR_PROJECT_DIR")
    if root == "" { root = host.parentPath(host.parentPath(host.parentPath(host.parentPath(host.selfPath())))) }
    let launcher = root + "/minyar"
    if !host.isFile(launcher) { host.stop("cannot locate the Minyar toolchain; set MINYAR_PROJECT_DIR") }
    return launcher
}
function compile(graph: project.Graph, options: Options, source: Text, output: Text, check: Boolean) {
    let arguments = [compiler()]
    if check { arguments.add("--check") }
    else if options.release { arguments.add("--release") }
    else { arguments.add("--debug") }
    if options.incremental { arguments.add("--incremental") }
    // The root package chooses the reclamation profile for every program it builds, tests included.
    let memory = graph.packages[0].memory
    if memory != "" && !check { arguments.add("--memory-profile"); arguments.add(memory) }
    if options.errorFormat != "" { arguments.add("--error-format"); arguments.add(options.errorFormat) }
    // A declared main library must win over unrelated binary entry files in
    // mixed packages' source directories.
    for package in graph.packages {
        if package.name == "main" && project.hasLibrary(package) { arguments.add("--library"); arguments.add(package.root + "/src") }
    }
    for package in graph.packages {
        if package.name != "main" && project.hasLibrary(package) { arguments.add("--library"); arguments.add(package.root + "/src") }
    }
    arguments.add(source)
    if !check { arguments.add("-o"); arguments.add(output) }
    let environment: List<Text> = []
    for entry in system.environment() { if !entry.startsWith("MINYAR_MODULE_CACHE=") { environment.add(entry) } }
    environment.add("MINYAR_MODULE_CACHE=" + graph.packages[0].root + "/target/" + profile(options) + "/.cache")
    // A watch session's rebuilds reuse the toolchain its first build prepared.
    if system.getenv("MINYAR_WATCH_PREPARED") == "1" { environment.add("MINYAR_PREPARED_TOOLCHAIN=1") }
    // Watch rebuilds link cached partitions, recompiling only what changed.
    if system.getenv("MINYAR_WATCH_ROOTS") != "" { environment.add("MINYAR_INCREMENTAL_LINK=1") }
    // The root package may choose the x86-64 level its programs are compiled for (package.cpu).
    if graph.packages[0].cpu != "" { environment.add("MINYAR_TARGET_CPU=" + graph.packages[0].cpu) }
    let status = execute(arguments, graph.packages[0].root, environment)
    if status != 0 { exit(status) }
}
function tests(root: Text): List<Text> {
    let result: List<Text> = []
    if !host.isDirectory(root + "/tests") { return result }
    let names = files.list(root + "/tests")
    if files.lastError() != 0 { host.stop("cannot list integration tests") }
    names.sort()
    for name in names { if name.endsWith(".min") && host.isFile(root + "/tests/" + name) { result.add(name) } }
    return result
}
function liveFlags(options: Options): List<Text> {
    let flags: List<Text> = []
    if options.release { flags.add("--release") }
    if options.locked { flags.add("--locked") }
    if options.offline { flags.add("--offline") }
    if !options.incremental { flags.add("--no-incremental") }
    if options.errorFormat != "" { flags.add("--error-format"); flags.add(options.errorFormat) }
    return flags
}
function build(graph: project.Graph, options: Options): Text {
    let package = graph.packages[0]
    let directory = outputDirectory(package.root, profile(options))
    let source = project.entry(package)
    let output = directory + "/" + package.name
    if options.hot {
        if !project.isBinary(package) { host.stop("build --hot requires src/main.min in a binary package") }
        let status = live.buildPatchable(graph, compiler(), output, liveFlags(options))
        if status != 0 { host.leave(status) }
        live.publishRoots(graph)
        print("Finished " + profile(options) + " " + package.name + " (update running copies with minyar patch)")
        return output
    }
    if project.isBinary(package) && project.hasLibrary(package) { compile(graph, options, project.library(package), "", true) }
    compile(graph, options, source, output, !project.isBinary(package))
    if project.isBinary(package) { live.forgetSession(output) }
    live.publishRoots(graph)
    print("Finished " + profile(options) + " " + package.name)
    return output
}
function installation(options: Options): Text {
    let root = options.root
    if root == "" { root = system.getenv("MINYAR_HOME") }
    if root == "" {
        let home = system.getenv("HOME")
        if home == "" { host.stop("set HOME, MINYAR_HOME, or --root for installation") }
        root = home + "/.minyar"
    }
    return host.resolveName(root) + "/bin"
}
constant INSTALL_BINARY = "minyar-installed-v1\n"
constant INSTALL_SYMBOLS = "minyar-installed-v2\nsymbols = true\n"
function installationEntry(path: Text): Boolean {
    let names = files.list(host.parentPath(path))
    if files.lastError() != 0 { host.stop("cannot list installation directory: " + host.parentPath(path)) }
    return host.listed(names, host.baseName(path))
}
function installationMarker(path: Text): Text {
    if !installationEntry(path) || !host.isFile(path) || host.resolveName(path) != path { return "" }
    let content = host.readText(path)
    if content == INSTALL_BINARY || content == INSTALL_SYMBOLS { return content }
    return ""
}
function protectToolchainLauncher(path: Text, name: Text) {
    if name != "minyar" || !host.isFile(path) || host.resolveName(path) != path { return }
    let file = files.open(path, files.READ)
    if file < 0 { host.stop("cannot inspect the installed command: " + path) }
    let data = files.readAt(file, 0, 96)
    let error = files.lastError()
    let closed = files.close(file)
    if error != 0 || closed != 0 { host.stop("cannot inspect the installed command: " + path) }
    for marker in ["#!/bin/sh\n# Managed by Minyar toolchains (v1)\n", "#!/bin/sh\n# Installed by Minyar; self-contained toolchain\n"] {
        let prefix = Bytes(marker)
        let matches = data.length >= prefix.length
        if matches { for index in 0..prefix.length { if data[index] != prefix[index] { matches = false; break } } }
        if matches { host.stop("this is Minyar's toolchain launcher: " + path + "; use minyar self update, or choose another --root for this package") }
    }
}
function checkInstalledSymbols(path: Text) {
    if !host.isDirectory(path) || host.resolveName(path) != path { host.stop("refusing to use unrelated or symlinked debug symbols: " + path) }
}
function installationFailure(status: Integer, path: Text, staging: Text) {
    // Keep staged previous artifacts available even if a rollback itself fails.
    host.stop(host.osError(status, path) + "; retained installation staging: " + staging)
}
function restoreSymbols(staging: Text, destination: Text, published: Boolean, previous: Boolean) {
    if published { files.rename(destination, staging + "/symbols") }
    if previous { files.rename(staging + "/previous.dSYM", destination) }
}
function finishInstallation(staging: Text) {
    require([host.which("rm"), "-rf", "--", staging], "")
}
function uninstall(directory: Text, name: Text) {
    let marker = directory + "/.minyar-installed-" + name
    if !host.isDirectory(directory) { host.stop("binary was not installed by Minyar: " + name) }
    let ownership = installationMarker(marker)
    if ownership == "" { host.stop("binary was not installed by Minyar: " + name) }
    let destination = directory + "/" + name
    protectToolchainLauncher(destination, name)
    let symbols = destination + ".dSYM"
    let removeSymbols = ownership == INSTALL_SYMBOLS && installationEntry(symbols)
    if removeSymbols { checkInstalledSymbols(symbols) }
    let staging = host.keptDirectory(directory, ".minyar-uninstall-")
    if removeSymbols {
        let status = files.rename(symbols, staging + "/previous.dSYM")
        if status != 0 { installationFailure(status, symbols, staging) }
    }
    let status = files.rename(destination, staging + "/binary")
    if status != 0 {
        restoreSymbols(staging, symbols, false, removeSymbols)
        installationFailure(status, destination, staging)
    }
    status = files.rename(marker, staging + "/marker")
    if status != 0 {
        files.rename(staging + "/binary", destination)
        restoreSymbols(staging, symbols, false, removeSymbols)
        installationFailure(status, marker, staging)
    }
    finishInstallation(staging)
    print("Uninstalled " + name)
}
function install(graph: project.Graph, options: Options) {
    let package = graph.packages[0]
    if !project.isBinary(package) { host.stop("install requires a binary package with src/main.min") }
    let directory = installation(options)
    host.makeDirectories(directory)
    let destination = directory + "/" + package.name
    let hadBinary = installationEntry(destination)
    if hadBinary && (!host.isFile(destination) || host.resolveName(destination) != destination) { host.stop("refusing to replace an unrelated or symlinked binary: " + destination) }
    if hadBinary { protectToolchainLauncher(destination, package.name) }
    if hadBinary && !options.force { host.stop(destination + " already exists; use --force to replace it") }
    let marker = directory + "/.minyar-installed-" + package.name
    let ownership = installationMarker(marker)
    if installationEntry(marker) && ownership == "" { host.stop("refusing to replace an unrelated installation marker: " + marker) }
    let symbols = destination + ".dSYM"
    let hadSymbols = installationEntry(symbols)
    if hadSymbols {
        if ownership != INSTALL_SYMBOLS { host.stop("refusing to replace unowned debug symbols: " + symbols) }
        checkInstalledSymbols(symbols)
    }
    let binary = build(graph, options)
    let hasSymbols = !options.release && host.isDirectory(binary + ".dSYM")
    let staging = host.keptDirectory(directory, ".minyar-install-")
    let staged = staging + "/binary"
    host.copyFile(binary, staged)
    let chmod = host.which("chmod")
    if chmod == "" { host.stop("chmod is required for installation") }
    require([chmod, "755", staged], "")
    let newMarker = INSTALL_BINARY
    if hasSymbols {
        require([host.which("cp"), "-RP", binary + ".dSYM", staging + "/symbols"], "")
        newMarker = INSTALL_SYMBOLS
    }
    host.writeBytes(staging + "/marker", Bytes(newMarker))
    if hadSymbols {
        let status = files.rename(symbols, staging + "/previous.dSYM")
        if status != 0 { installationFailure(status, symbols, staging) }
    }
    if hasSymbols {
        let status = files.rename(staging + "/symbols", symbols)
        if status != 0 {
            restoreSymbols(staging, symbols, false, hadSymbols)
            installationFailure(status, symbols, staging)
        }
    }
    if hadBinary {
        let status = files.rename(destination, staging + "/previous")
        if status != 0 {
            restoreSymbols(staging, symbols, hasSymbols, hadSymbols)
            installationFailure(status, destination, staging)
        }
    }
    let status = files.rename(staged, destination)
    if status == 0 { status = files.rename(staging + "/marker", marker) }
    if status != 0 {
        if hadBinary { files.rename(staging + "/previous", destination) }
        else { files.remove(destination) }
        restoreSymbols(staging, symbols, hasSymbols, hadSymbols)
        installationFailure(status, destination, staging)
    }
    finishInstallation(staging)
    print("Installed " + destination + "\nAdd " + directory + " to PATH.")
}
function modify(package: project.Manifest, options: Options) {
    if options.positionals.length != 1 { host.stop("usage: minyar " + options.command + " NAME" ) }
    let name = options.positionals[0]
    let repository = ""
    let revision = ""
    let remoteRoot = ""
    let fetched = git.Source { repository: ""; revision: ""; commit: ""; checksum: ""; root: "" }
    if options.command == "add" && options.path == "" {
        let pieces = name.split("@")
        if pieces.length > 2 { host.stop("usage: minyar add HOST/OWNER/PACKAGE[@revision], NAME[@version] or NAME --path DIR") }
        revision = "latest"
        if pieces.length == 2 { revision = pieces[1] }
        if !git.validRevision(revision) { host.stop("invalid Git revision: " + revision) }
        let index = registry.Index { entries: []; origin: "" }
        if !host.hasText(pieces[0], "/") {
            // A bare name comes from the package index; the manifest and lock still record its Git source.
            let location = options.registry
            if location == "" { location = system.getenv("MINYAR_REGISTRY") }
            if location == "" { host.stop(pieces[0] + " is not a Git package path; use minyar add HOST/OWNER/" + pieces[0] + ", minyar add " + pieces[0] + " --path DIR for a local library, or set MINYAR_REGISTRY to a package index to add packages by name") }
            index = registry.loadWith(location, options.offline)
            let version = ""
            if pieces.length == 2 { version = revision }
            let release = registry.lookup(index, pieces[0], version)
            repository = release.repository
            revision = "v" + release.version
        } else { repository = git.repository(pieces[0]) }
        fetched = git.fetch(repository, revision, "", "", options.offline)
        registry.verify(index, fetched)
        let source = fetched
        let dependency = project.read(source.root)
        name = dependency.name
        if !project.hasLibrary(dependency) { host.stop("dependency needs a library export at src/" + name + ".min") }
        revision = source.revision
        remoteRoot = source.root
    }
    if !project.validName(name) { host.stop("invalid dependency name: " + name) }
    let dependencies: List<Text> = []
    let paths: List<Text> = []
    let repositories: List<Text> = []
    let revisions: List<Text> = []
    let found = false
    for index in 0..package.dependencies.length {
        if package.dependencies[index] == name { found = true }
        else { dependencies.add(package.dependencies[index]); paths.add(package.paths[index]); repositories.add(package.repositories[index]); revisions.add(package.revisions[index]) }
    }
    if options.command == "add" {
        let path = remoteRoot
        if repository == "" { path = host.resolveName(options.path) }
        let dependency = project.read(path)
        if name != dependency.name || !project.hasLibrary(dependency) { host.stop("dependency must be a library named " + name) }
        if path == package.root { host.stop("a package cannot depend on itself") }
        dependencies.add(name)
        // Resolve from the invoking cwd, then keep the manifest relocatable.
        if repository == "" { paths.add(project.relative(package.root, path)) }
        else { paths.add("") }
        repositories.add(repository)
        revisions.add(revision)
    } else if !found { host.stop("dependency not found: " + name) }
    package.dependencies = dependencies
    package.paths = paths
    package.repositories = repositories
    package.revisions = revisions
    let graph = project.Graph { packages: []; active: [] }
    if repository != "" { graph = project.resolveFetched(package, name, fetched, options.offline) }
    else { graph = project.resolveModified(package, name, options.offline) }
    let updateLock = project.hasGitLock(package.root)
    for dependency in graph.packages { if dependency.source != "" { updateLock = true } }
    project.save(package)
    if updateLock { project.lock(graph, false) }
    let action = "     Added  "
    if options.command == "remove" { action = "   Removed  " }
    let message = action + name
    if repository != "" { message += " " + revision + " from " + repository }
    if updateLock {
        let count = graph.packages.length - 1
        message += "\n    Locked  " + Text(count) + " source package"
        if count != 1 { message += "s" }
    }
    print(message)
}
// minyar update [NAME]: move Git dependencies to the newest release with the same major version (a branch
// to its current commit), rewrite the manifest's minimums and the lock. Crossing a major version stays an
// explicit `minyar add`, which update names when one is available. Exact commit pins never move.
function update(package: project.Manifest, options: Options) {
    if options.positionals.length > 1 { host.stop("usage: minyar update [NAME]") }
    let only = ""
    if options.positionals.length == 1 { only = options.positionals[0] }
    if only != "" && !host.listed(package.dependencies, only) { host.stop("dependency not found: " + only) }
    let names: List<Text> = []
    let sources: List<git.Source> = []
    let report: List<Text> = []
    let notes: List<Text> = []
    for index in 0..package.dependencies.length {
        let name = package.dependencies[index]
        let repository = package.repositories[index]
        if only != "" && name != only { continue }
        if repository == "" {
            if only != "" { host.stop(name + " is a local path dependency; its source is used as it is") }
            continue
        }
        let current = package.revisions[index]
        let chosen = current
        if git.semver(current) {
            let newest = current
            for release in git.releases(repository) {
                if git.compare(release.tag, newest) > 0 { newest = release.tag }
                if git.compatible(release.tag, current) && git.compare(release.tag, chosen) > 0 { chosen = release.tag }
            }
            if git.compare(newest, chosen) > 0 { notes.add("      Note  " + name + " " + newest + " is a new major version and may break this project: minyar add " + repository + "@" + newest) }
        } else if git.hexadecimal(current, 40) {
            if only != "" { host.stop(name + " is pinned to commit " + current + "; choose a release or branch with minyar add " + repository + "@REVISION") }
            continue
        }
        let source = git.fetch(repository, chosen, "", "", false)
        package.revisions[index] = source.revision
        names.add(name)
        sources.add(source)
        if source.revision != current { report.add("   Updated  " + name + " " + current + " -> " + source.revision) }
        else { report.add("   Current  " + name + " " + current) }
    }
    if names.length == 0 { print("No Git dependencies to update"); return }
    let graph = project.resolveUpdated(package, sources, names)
    project.save(package)
    project.lock(graph, false)
    for line in report { print(line) }
    let count = graph.packages.length - 1
    let plural = "s"
    if count == 1 { plural = "" }
    print("    Locked  " + Text(count) + " source package" + plural)
    for line in notes { print(line) }
}
function metadata(graph: project.Graph) {
    let packages: List<Text> = []
    for package in graph.packages {
        packages.add("{\"name\":" + host.jsonText(package.name) + ",\"version\":" + host.jsonText(package.version) + ",\"manifest_path\":" + host.jsonText(package.root + "/Minyar.toml") + ",\"source\":" + host.jsonText(package.source) + ",\"commit\":" + host.jsonText(package.commit) + ",\"checksum\":" + host.jsonText(package.checksum) + ",\"dependencies\":" + host.jsonList(package.dependencies) + "}")
    }
    print("{\"version\":1,\"target_directory\":" + host.jsonText(graph.packages[0].root + "/target") + ",\"packages\":[" + host.joined(packages, ",") + "]}")
}
function dispatch() {
    if processInfo.argumentCount() == 0 { help(); return }
    if processInfo.argument(0) == "help" { help(); return }
    let options = parse()
    if !host.listed(["new", "init", "build", "run", "patch", "check", "test", "bench", "sim", "doc", "clean", "add", "remove", "update", "tree", "metadata", "install", "uninstall", "search", "info", "publish"], options.command) { host.stop("unknown command: " + options.command) }
    if options.command == "search" || options.command == "info" {
        let location = options.registry
        if location == "" { location = system.getenv("MINYAR_REGISTRY") }
        let index = registry.loadWith(location, options.offline)
        if options.command == "search" {
            if options.positionals.length > 1 { host.stop("usage: minyar search [QUERY] [--registry URL]") }
            let query = ""
            if options.positionals.length == 1 { query = options.positionals[0] }
            registry.search(index, query)
        } else {
            if options.positionals.length != 1 { host.stop("usage: minyar info NAME [--registry URL]") }
            registry.info(index, options.positionals[0])
        }
        return
    }
    if options.command == "new" || options.command == "init" { create(options); return }
    if options.command == "doc" && options.path != "" {
        if options.positionals.length != 0 || options.manifest != "" || options.locked { host.stop("usage: minyar doc --path DIRECTORY [--release] [--offline]") }
        documentation.fromDirectory(compiler(), options.path, outputDirectory(host.resolveName("."), "doc"), options.release)
        return
    }
    if options.command == "uninstall" {
        if options.positionals.length != 1 || !project.validName(options.positionals[0]) { host.stop("usage: minyar uninstall NAME [--root DIR]") }
        let directory = installation(options)
        let name = options.positionals[0]
        uninstall(directory, name)
        return
    }
    let root = ""
    if options.manifest != "" { root = project.at(options.manifest) }
    else if options.command == "install" && options.path != "" { root = project.at(options.path) }
    else { root = project.find(".") }
    let package = project.read(root)
    if options.command == "publish" {
        if options.positionals.length > 1 { host.stop("usage: minyar publish [HOST/OWNER/PACKAGE] [--registry DIRECTORY] [--dry-run] [--description TEXT]") }
        let repository = ""
        if options.positionals.length == 1 { repository = options.positionals[0] }
        let location = options.registry
        if location == "" { location = system.getenv("MINYAR_REGISTRY") }
        let localIndex = location != "" && !host.hasText(location, "://")
        let entry = publish.prepare(package, repository, options.description)
        if options.dryRun || !localIndex {
            print(registry.renderEntry(entry))
            let next = "Add it to a local package index with minyar publish --registry DIRECTORY, or save this record for minyar registry build."
            if location != "" && !localIndex { next = "This toolchain cannot write to the hosted index " + location + "; give this record to its operator for minyar registry build." }
            system.writeStandardError("   Dry run  " + entry.name + " v" + entry.version + " · " + entry.checksum + "\nNothing was published. " + next + "\n")
            return
        }
        publish.confirmHosted(entry)
        let directory = host.resolveName(location)
        let added = registry.publish(directory, [entry])
        let verb = " Published"
        if added == 0 { verb = " Unchanged" }
        print(verb + "  " + entry.name + " v" + entry.version + " from " + entry.repository + "\n     Index  " + directory + "/index.json\n  Checksum  sha256:" + entry.checksum)
        return
    }
    if options.command == "add" || options.command == "remove" { modify(package, options); return }
    if options.command == "update" { update(package, options); return }
    if options.command != "test" && options.command != "bench" && options.command != "sim" && options.positionals.length != 0 { host.stop("unexpected positional argument for " + options.command) }
    if (options.command == "test" || options.command == "bench" || options.command == "sim") && options.positionals.length > 1 { host.stop(options.command + " accepts at most one filename filter") }
    if options.command == "clean" {
        let directory = target(root, false)
        if host.exists(directory) {
            let rm = host.which("rm")
            if rm == "" { host.stop("rm is required for clean") }
            require([rm, "-rf", "--", directory], "")
        }
        print("Cleaned " + package.name)
        return
    }
    let graph = project.resolveWith(root, options.locked, options.offline)
    project.lock(graph, options.locked)
    if options.command == "metadata" { metadata(graph); return }
    if options.command == "tree" {
        for entry in graph.packages {
            print(entry.name + " v" + entry.version + " (" + entry.root + ")")
            for name in entry.dependencies { print("  -> " + name) }
        }
        return
    }
    if options.command == "install" { install(graph, options); return }
    if options.command == "build" { build(graph, options); return }
    if options.command == "patch" {
        if !project.isBinary(package) { host.stop("patch requires src/main.min in a binary package") }
        let flags = liveFlags(options)
        if options.undo { flags.add("--undo") }
        if options.dryRun { flags.add("--dry-run") }
        exit(live.patch(graph, compiler(), outputDirectory(root, profile(options)) + "/" + package.name, flags))
    }
    if options.command == "bench" {
        let filter = ""
        if options.positionals.length > 0 { filter = options.positionals[0] }
        let report = benchmarks.run(graph, compiler(), outputDirectory(root, "release/benchmarks"), filter, options.arguments, options.errorFormat)
        if report.failures != 0 { exit(1) }
        if filter != "" && report.count == 0 { host.stop("no benchmarks matched the filter") }
        return
    }
    if options.command == "sim" {
        options.release = true
        if !simulations.run(graph, options.positionals, options.first, options.seeds, options.jobs, options.seed, options.explore, options.replay, compiler(), outputDirectory(root, "release/sim"), options.errorFormat) { exit(1) }
        return
    }
    if options.command == "doc" {
        let directory = outputDirectory(root, "doc")
        compile(graph, options, project.entry(package), "", true)
        if project.isBinary(package) && project.hasLibrary(package) { compile(graph, options, project.library(package), "", true) }
        documentation.build(graph, compiler(), directory, options.release, moduleTests.sources(graph))
        return
    }
    if options.command == "run" {
        if !project.isBinary(package) { host.stop("run requires src/main.min in a binary package") }
        if options.watch {
            let output = outputDirectory(root, profile(options)) + "/" + package.name
            exit(live.run(graph, compiler(), output, options.arguments, liveFlags(options), options.hot))
        }
        let output = build(graph, options)
        let arguments = [output]
        for item in options.arguments { arguments.add(item) }
        exit(execute(arguments, root, system.environment()))
    }
    let directory = outputDirectory(root, profile(options) + "/tests")
    compile(graph, options, project.entry(package), "", true)
    if project.isBinary(package) && project.hasLibrary(package) { compile(graph, options, project.library(package), "", true) }
    let count = 0
    let failures = 0
    if options.command == "test" {
        let filter = ""
        if options.positionals.length > 0 { filter = options.positionals[0] }
        let report = moduleTests.runWithFormat(graph, compiler(), directory, options.release, filter, options.arguments, options.errorFormat)
        count += report.count
        failures += report.failures
        let examples = documentation.testExamplesWithFormat(graph, compiler(), directory, options.release, filter, options.errorFormat)
        count += examples.count
        failures += examples.failures
    }
    for name in tests(root) {
        if options.positionals.length > 0 && !host.hasText(name, options.positionals[0]) { continue }
        count += 1
        let output = directory + "/" + host.stemOf(name)
        compile(graph, options, root + "/tests/" + name, output, options.command == "check")
        if options.command == "test" {
            let arguments = [output]
            for item in options.arguments { arguments.add(item) }
            let status = execute(arguments, root, system.environment())
            if status != 0 { failures += 1; system.writeStandardError("FAILED " + name + " (exit " + Text(status) + ")\n") }
            else { print("ok " + name) }
        }
    }
    if options.command == "test" {
        print(Text(count - failures) + " passed; " + Text(failures) + " failed")
        if options.positionals.length > 0 && count == 0 { host.stop("no tests matched the filter") }
        if failures != 0 { exit(1) }
    } else { print("Checked " + package.name + " and " + Text(count) + " integration tests") }
}
dispatch()
