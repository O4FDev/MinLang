use "./testing.min" as test
public function patched(source: Text): Text {
    test.check(!test.contains(source, "MINYAR_CI_SOFTWARE_GLFW"), "GLFW source already patched")
    let guard = "    NSOpenGLPixelFormatAttribute attribs[40];\n    int index = 0;\n\n    ADD_ATTRIB(NSOpenGLPFAAccelerated);"
    test.check(test.contains(source, guard), "GLFW hardware attribute layout changed")
    let before = "    window->context.nsgl.pixelFormat =\n        [[NSOpenGLPixelFormat alloc] initWithAttributes:attribs];\n"
    let after = before + "    if (window->context.nsgl.pixelFormat == nil)\n    {\n        assert(attribs[0] == NSOpenGLPFAAccelerated);\n        window->context.nsgl.pixelFormat =\n            [[NSOpenGLPixelFormat alloc] initWithAttributes:(attribs + 1)];\n    }\n"
    let result = test.replace(source, before, after)
    test.check(result != source && Bytes(result).length == Bytes(source).length + Bytes(after).length - Bytes(before).length, "GLFW pixel format creation must occur exactly once")
    return "#define MINYAR_CI_SOFTWARE_GLFW 1\n" + result
}
test.check(argumentCount() == 2, "expected INPUT OUTPUT")
writeTextFile(argument(1), patched(readTextFile(argument(0))))
