use "./testing.min" as test
public function cycleSource(source: Text): Text {
    let ordinary = ["minyar_rc.h", "minyar_collections.h"]
    let traced = ["minyar_cycle_rc.h", "minyar_cycle_collections.h"]
    for index in 0..ordinary.length {
        let before = "#include \"" + ordinary[index] + "\""
        let after = "#include \"" + traced[index] + "\""
        let substituted = test.replace(source, before, after)
        test.check(substituted != source && !test.contains(substituted, before), "cycle runtime include must occur once")
        test.check(Bytes(source).length + Bytes(after).length - Bytes(before).length == Bytes(substituted).length, "duplicate cycle runtime include")
        source = substituted
    }
    return "#define MINYAR_SORT_GRAPH 1\n#define MINYAR_MAP_CYCLE_RUNTIME 1\n#if defined(__GNUC__) || defined(__clang__)\n#define MINYAR_NOINLINE __attribute__((noinline))\n#else\n#define MINYAR_NOINLINE\n#endif\n" + source + "\n#include \"minyar_callbacks.h\"\n"
}
