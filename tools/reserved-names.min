use "./testing.min" as test
public function names(source: Text): List<Text> {
    let result: List<Text> = []
    let selected = false
    let functions = 0
    for line in test.lines(source) {
        if test.contains(line, "function isBuiltinName(") || test.contains(line, "function isNumericBuiltin(") || test.contains(line, "function isFloatFunction(") {
            selected = true
            functions += 1
        }
        if selected {
            let raw = Bytes(line)
            let marker = Bytes("name == \"")
            let index = 0
            while index + marker.length <= raw.length {
                let matches = true
                for offset in 0..marker.length {
                    if raw[index + offset] != marker[offset] { matches = false; break }
                }
                if matches {
                    let start = index + marker.length
                    let end = start
                    while end < raw.length && raw[end] != 34 { end += 1 }
                    test.check(end < raw.length, "unterminated reserved name")
                    let name = Text(raw.slice(start, end))
                    let found = false
                    for existing in result { if existing == name { found = true } }
                    if !found { result.add(name) }
                    index = end
                }
                index += 1
            }
            if line == "}" { selected = false }
        }
    }
    test.check(functions == 3 && result.length > 0, "missing built-in predicates")
    result.sort()
    return result
}
public function render(reserved: List<Text>): Text {
    let output = "## Reserved function names\n\nThese names belong to the language's built-in functions and constructors.\nA user function cannot declare one of them, including inside an imported\nmodule. Choose a different function name, such as `joinTextLocal` or `joinWith`.\nRecord fields and methods use their receiver's namespace; this list reserves\nfunction declarations, not field names or arbitrary prefixes.\n\nNames are case-sensitive. Standard-library functions belong to their module\nalias and do not reserve every module's function namespace.\n\n| Reserved function name |\n| --- |\n"
    for name in reserved { output += "| `" + name + "` |\n" }
    return output + "\nGenerated from the compiler by `python3 tools/reserved-names.py`.\nRun `python3 tools/reserved-names.py --check` after changing built-in names.\n"
}
public function documentMatches(document: Text, reserved: List<Text>): Boolean {
    let begin = "<!-- reserved-names: generated by tools/reserved-names.py -->\n"
    let end = "<!-- reserved-names: end -->\n"
    return test.contains(document, begin + render(reserved) + end)
}
