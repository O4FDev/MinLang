// The editor's only native boundary: framed stdio, bounded source reads and safe file replacement.
public function kind(path: Text): Text { native "editorhost" }
public function replace(path: Text, original: Bytes, replacement: Bytes): Integer { native "editorhost" }
public function readSource(path: Text): Bytes { native "editorhost" }
public function sourceError(): Integer { native "editorhost" }
public function readFrame(): Bytes { native "editorhost" }
public function frameError(): Integer { native "editorhost" }
