use "process" as processInfo
// Install a self-contained toolchain; the launcher never points at the checkout.
use "./driver-support.min" as host
use "files" as files
use "system" as system

function run(arguments: List<Text>) { host.run(arguments) }
function copy(source: Text, destination: Text) {
    host.makeDirectories(host.parentPath(destination))
    run([host.which("cp"), "-Rp", source, destination])
}
let source = ""
let prefix = ""
let index = 0
while index < processInfo.argumentCount() {
    let option = processInfo.argument(index)
    if index + 1 >= processInfo.argumentCount() { host.stop(option + " requires a value") }
    let value = processInfo.argument(index + 1)
    if option == "--source" && source == "" { source = host.resolveName(value) }
    else if option == "--prefix" && prefix == "" { prefix = host.resolveName(value) }
    else { host.stop("usage: install-cli --source TOOLCHAIN --prefix PREFIX") }
    index += 2
}
if source == "" || prefix == "" { host.stop("usage: install-cli --source TOOLCHAIN --prefix PREFIX") }
let destination = prefix + "/bin/minyar"
constant MARKER = "# Installed by Minyar; self-contained toolchain\n"
if host.exists(destination) {
    if !host.isFile(destination) || !host.hasText(host.readText(destination), MARKER) { host.stop("refusing to replace an unrelated command: " + destination) }
}
let required = ["build/minyarc", "build/minyar-module-build", "build/minyar-default-runtime.o", "build/minyar-default-runtime-release.ll", "build/tooling/tools/project-cli", "build/tooling/tools/registry-cli", "build/tooling/tools/clang-driver", "build/tooling/tools/install-cli"]
let frontends = files.list(source + "/tools")
if files.lastError() != 0 { host.stop("missing toolchain command sources: " + source + "/tools") }
frontends.sort()
let commands: List<Text> = []
for name in frontends {
    if name.endsWith("-cli.min") && host.isFile(source + "/tools/" + name) {
        let command = "tooling/tools/" + host.textSlice(name, 0, name.byteLength - 4)
        commands.add(command)
        required.add("build/" + command)
    }
}
for path in required { if !host.isFile(source + "/" + path) { host.stop("missing " + path + "; run make install from the checkout") } }
if !host.isDirectory(source + "/library") { host.stop("missing standard library: " + source) }
// A distinct directory keeps an upgrade from changing a running compiler.
let versions = prefix + "/lib/minyar/versions"
host.makeDirectories(versions)
let installed = host.temporaryDirectory(versions, "toolchain-")
for name in ["compiler", "runtime", "library", "tools", "scripts", "bootstrap", "vendor", "build-support", "install"] {
    copy(source + "/" + name, installed + "/" + name)
}
for name in ["Makefile", "minyar", "LICENSE"] { copy(source + "/" + name, installed + "/" + name) }
for name in [".minyar-distribution", "distribution.platform", "distribution.libc", "distribution.arch", "distribution.version", "distribution.json", "toolchain", "docs"] {
    if host.exists(source + "/" + name) { copy(source + "/" + name, installed + "/" + name) }
}
// Preserve timestamps so first use can reuse the compiled toolchain. Sources
// remain available for runtime configuration, native packages and later rebuilds.
for name in [".toolchain.json", "compiler.min", "stage0", "compiler-stage1.ll", "compiler-stage1", "compiler-stage2.ll", "minyar-compiler-runtime.ll", "minyarc", "minyarc-modules", "minyar-module-build", "minyar-runtime.o", "minyar-default-runtime.o", "minyar-default-runtime-release.ll", "minyar-runtime-eager.o", "minyar-runtime-eager-release.ll", "tooling/scripts/macos-app", "tooling/tools/clang-driver.ll", "tooling/tools/clang-driver"] {
    let path = source + "/build/" + name
    if host.isFile(path) { copy(path, installed + "/build/" + name) }
}
for command in commands {
    copy(source + "/build/" + command, installed + "/build/" + command)
    if host.isFile(source + "/build/" + command + ".ll") { copy(source + "/build/" + command + ".ll", installed + "/build/" + command + ".ll") }
}
host.makeDirectories(prefix + "/bin")
let wrapper = "#!/bin/sh\n" + MARKER + "exec " + host.shellQuote(installed + "/minyar") + " \"$@\"\n"
let staged = destination + ".tmp-" + Text(system.processId())
host.writeBytes(staged, Bytes(wrapper))
run([host.which("chmod"), "755", staged])
let status = files.rename(staged, destination)
if status != 0 { files.remove(staged); host.stop(host.osError(status, destination)) }
// This is now a permanent installation, not a temporary directory.
// Do not release it: release() removes its directory.
print("Installed " + destination + "\nToolchain: " + installed)
let found = host.which("minyar")
if found == "" || host.resolveName(found) != host.resolveName(destination) { print("Add " + prefix + "/bin to PATH to use minyar.") }
