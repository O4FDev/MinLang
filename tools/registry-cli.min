use "./driver-support.min" as host
use "./registry.min" as registry
use "./package-git.min" as git
use "json" as json
use "process" as process
use "files" as files
use "system" as system
use "httpserver" as http
use "errors" as errors

function build(records: Text, destination: Text) {
    let names = files.list(records)
    if files.lastError() != 0 { host.stop("cannot read release record directory: " + records) }
    names.sort()
    let entries: List<registry.Entry> = []
    for name in names {
        if !name.endsWith(".json") || !host.isFile(records + "/" + name) { continue }
        let value = json.parseUniqueBytes(host.readBytes(records + "/" + name), 4194304)
        if value.kind == json.INVALID { host.stop("invalid release record " + name + ": " + value.text) }
        entries.add(registry.entry(value))
    }
    let added = registry.publish(destination, entries)
    print("     Added  " + Text(added) + " release records\n     Index  " + destination + "/index.json\n Checksums  " + host.hashBytes(host.readBytes(destination + "/checksums.txt")))
}
function serve(root: Text, port: Integer) {
    if !host.isFile(root + "/index.json") { host.stop("index.json is missing; run minyar registry build RECORDS PUBLIC first") }
    registry.load(root)
    let limits = http.defaults(); limits.maxConnections = 32; limits.maxBodyBytes = 0
    let server = http.listen("127.0.0.1", port, limits)
    if !http.ok(server) { host.stop(errors.message(http.serverError(server))) }
    files.writeStandardOutput("Registry listening at http://127.0.0.1:" + Text(http.port(server)) + "\n")
    while http.ok(server) {
        let batch = http.poll(server, -1)
        if errors.isError(http.batchError(batch)) { break }
        for request in http.requests(batch) {
            let status = 404; let body = Bytes("not found\n"); let contentType = "text/plain; charset=utf-8"
            if request.method != "GET" && request.method != "HEAD" { status = 405; body = Bytes("this registry is read-only\n") }
            else {
                let target = request.target.split("?")[0]
                if target.startsWith("/") { target = host.textAfter(target, "/") }
                let allowed = target == "index.json" || target == "checksums.txt" || target == "install" || target == "latest" || target == "latest.sig" || target.startsWith("releases/")
                if allowed && git.safePath(target) {
                    let path = root + "/" + target
                    if host.resolveName(path).startsWith(root + "/") && host.isFile(path) && files.pathSize(path) <= 16777216 {
                        status = 200; body = host.readBytes(path)
                        if target.endsWith(".json") { contentType = "application/json" }
                        else if target.endsWith(".gz") || target.endsWith(".sig") { contentType = "application/octet-stream" }
                    }
                }
            }
            let response = http.response(status, contentType, body)
            response.headers.add(http.Header { name: "x-content-type-options"; value: "nosniff" })
            response.headers.add(http.Header { name: "cache-control"; value: "no-cache" })
            http.respond(server, request, response)
        }
    }
    http.close(server)
}
if process.argumentCount() < 1 { host.stop("usage: minyar registry build RECORDS PUBLIC | serve PUBLIC [PORT]") }
let command = process.argument(0)
if command == "build" && process.argumentCount() == 3 { build(host.resolveName(process.argument(1)), host.resolveName(process.argument(2))) }
else if command == "serve" && (process.argumentCount() == 2 || process.argumentCount() == 3) {
    let port = 8080
    if process.argumentCount() == 3 {
        let value = process.argument(2)
        if value == "" || value.byteLength > 5 { host.stop("registry port must be 0..65535") }
        for byte in Bytes(value) { if !host.isDigit(byte) { host.stop("registry port must be 0..65535") } }
        port = Integer(value)
        if port > 65535 { host.stop("registry port must be 0..65535") }
    }
    serve(host.resolveName(process.argument(1)), port)
} else { host.stop("usage: minyar registry build RECORDS PUBLIC | serve PUBLIC [PORT]") }
