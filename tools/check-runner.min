use "io" as io
use "./testing.min" as test
use "system" as system
use "files" as files
use "text" as text
use "errors" as errors

public record Rule { name: Text; prerequisites: List<Text>; phony: Boolean; recipe: Boolean; target: Boolean; stale: Boolean }
public function begins(source: Text, prefix: Text): Boolean {
    let raw = Bytes(source)
    let pattern = Bytes(prefix)
    if raw.length < pattern.length { return false }
    for index in 0..pattern.length { if raw[index] != pattern[index] { return false } }
    return true
}
public function findRule(rules: List<Rule>, name: Text): Integer {
    for index in 0..rules.length { if rules[index].name == name { return index } }
    return -1
}
public function database(source: Text): List<Rule> {
    let rules: List<Rule> = []
    let phony: List<Text> = []
    let active = false
    let target = true
    let current = -1
    for line in test.lines(source) {
        if line == "# Files" { active = true; continue }
        if begins(line, "# files hash-table stats") { break }
        if !active { continue }
        if line == "" { target = true; current = -1; continue }
        if line == "# Not a target:" { target = false; continue }
        if begins(line, "\t") {
            if current >= 0 { rules[current].recipe = true }
            continue
        }
        if begins(line, "#") {
            if current >= 0 && begins(line, "#  Phony target") { rules[current].phony = true }
            if current >= 0 && begins(line, "#  Needs to be updated") { rules[current].stale = true }
            continue
        }
        let raw = Bytes(line)
        let colon = -1
        for index in 0..raw.length { if raw[index] == 58 { colon = index; break } }
        if colon <= 0 || test.contains(line, "=") { continue }
        let name = Text(raw.slice(0, colon))
        if test.words(name).length != 1 { continue }
        let start = colon + 1
        if start < raw.length && raw[start] == 58 { start += 1 }
        let prerequisites: List<Text> = []
        for item in test.words(Text(raw.slice(start, raw.length))) { if item != "|" { prerequisites.add(item) } }
        if name == ".PHONY" { for item in prerequisites { phony.add(item) }; continue }
        current = findRule(rules, name)
        if current < 0 {
            rules.add(Rule { name: name; prerequisites: prerequisites; phony: false; recipe: false; target: target; stale: false })
            current = rules.length - 1
        } else {
            for item in prerequisites { rules[current].prerequisites.add(item) }
        }
    }
    test.check(active, "make printed no file database")
    for name in phony {
        let index = findRule(rules, name)
        if index >= 0 { rules[index].phony = true }
    }
    return rules
}
public record Variant { name: Text; cwd: Text; environment: List<Text>; make: List<Text>; rules: List<Rule>; builder: Boolean; built: Map<Text, Boolean> }
public record Goal { name: Text; variant: Integer; state: Integer; weight: Integer; handle: Integer; log: Text; started: Integer; members: Map<Text, Boolean> }
public record Check { label: Text; target: Text; arguments: List<Text>; variant: Integer; children: List<Integer>; goals: List<Integer>;
    state: Integer; resource: Text; exclusive: Boolean; weight: Integer; handle: Integer; log: Text; started: Integer; retry: Integer; builder: Boolean; wall: Integer; cpu: Integer; cost: Integer }
public record Plan { variants: List<Variant>; checks: List<Check>; goals: List<Goal>; scratch: Text; jobs: Integer; timeout: Integer; retries: Integer; interrupted: Boolean;
    elastic: Boolean; limit: Integer; busy: Integer; total: Integer; sampled: Integer; attempts: Integer }
public function plan(jobs: Integer, timeout: Integer, retries: Integer): Plan {
    test.check(jobs >= 1 && jobs <= 16 && timeout > 0 && retries >= 0, "invalid runner limits")
    let scratch = test.scratch()
    test.check(files.makeDirectory(scratch + "/logs") == 0, "cannot create process log directory")
    return Plan { variants: []; checks: []; goals: []; scratch: scratch; jobs: jobs; timeout: timeout; retries: retries; interrupted: false;
        elastic: false; limit: jobs; busy: 0; total: 0; sampled: 0; attempts: 0 }
}
public function environment(base: List<Text>, key: Text, value: Text): List<Text> {
    let result: List<Text> = []
    for entry in base { if !begins(entry, key + "=") { result.add(entry) } }
    result.add(key + "=" + value)
    return result
}
public function addVariant(plan: Plan, name: Text, cwd: Text, env: List<Text>, make: List<Text>): Integer {
    test.check(files.makeDirectory(cwd + "/build") == 0, "cannot create variant build directory")
    let log = plan.scratch + "/database-" + Text(plan.variants.length)
    let command: List<Text> = []
    for item in make { command.add(item) }
    for item in ["-pq", "FORCE"] { command.add(item) }
    let result = test.run(command, env, cwd, log, plan.timeout)
    test.check(result.status <= 1, "make database failed\n" + result.errorOutput)
    plan.variants.add(Variant { name: name; cwd: cwd; environment: env; make: make; rules: database(result.output); builder: false; built: Map<Text, Boolean>() })
    return plan.variants.length - 1
}
function resource(target: Text, variant: Integer): Text {
    if target == "check-modules" || target == "check-sanitize-core" || target == "check-sanitize-modules" { return Text(variant) + ":build/module-tests" }
    if begins(target, "check-peer-edge") || begins(target, "check-peer-live-redis") { return "reused-ports" }
    return ""
}
function exclusive(target: Text): Boolean {
    return target == "check-net-udp-offload" || target == "check-net-udp-offload-sanitize" || target == "check-peer-edge-cids" || target == "check-peer-edge-cids-sanitize"
}
function weight(target: Text): Integer {
    if test.contains(target, "peer-") { return 250 }
    if test.contains(target, "mutation") { return 240 }
    if test.contains(target, "ownership") { return 220 }
    if test.contains(target, "quic") || test.contains(target, "maps") { return 200 }
    if test.contains(target, "sanitize") { return 100 }
    return 10
}
public function addGoal(plan: Plan, variant: Integer, name: Text, weight: Integer): Integer {
    for index in 0..plan.goals.length {
        if plan.goals[index].variant == variant && plan.goals[index].name == name {
            plan.goals[index].weight += weight
            return index
        }
    }
    plan.goals.add(Goal { name: name; variant: variant; state: 0; weight: weight; handle: 0; log: ""; started: 0; members: Map<Text, Boolean>() })
    return plan.goals.length - 1
}
public function addCheck(plan: Plan, variant: Integer, target: Text): Integer {
    let where = plan.variants[variant]
    let label = target
    if where.name != "" { label = where.name + ":" + target }
    for index in 0..plan.checks.length { if plan.checks[index].label == label { return index } }
    let ruleIndex = findRule(where.rules, target)
    test.check(ruleIndex >= 0, "missing check target: " + target)
    let rule = where.rules[ruleIndex]
    test.check(rule.phony, "not a phony check target: " + target)
    let index = plan.checks.length
    plan.checks.add(Check { label: label; target: target; arguments: []; variant: variant; children: []; goals: []; state: 0;
        resource: resource(target, variant); exclusive: exclusive(target); weight: weight(target);
        handle: 0; log: ""; started: 0; retry: 0; builder: false; wall: 0; cpu: 0; cost: 0 })
    for prerequisite in rule.prerequisites {
        let child = findRule(where.rules, prerequisite)
        if child >= 0 {
            if where.rules[child].phony {
                plan.checks[index].children.add(addCheck(plan, variant, prerequisite))
            } else {
                if where.rules[child].target { plan.checks[index].goals.add(addGoal(plan, variant, prerequisite, plan.checks[index].weight)) }
            }
        }
    }
    return index
}
public function addCommand(plan: Plan, variant: Integer, label: Text, arguments: List<Text>, goals: List<Text>): Integer {
    let prefix = plan.variants[variant].name
    if prefix != "" { label = prefix + ":" + label }
    for index in 0..plan.checks.length { if plan.checks[index].label == label { return index } }
    let dependencies: List<Integer> = []
    for goal in goals { dependencies.add(addGoal(plan, variant, goal, weight(label))) }
    plan.checks.add(Check { label: label; target: ""; arguments: arguments; variant: variant; children: []; goals: dependencies; state: 0;
        resource: resource(label, variant); exclusive: exclusive(label); weight: weight(label);
        handle: 0; log: ""; started: 0; retry: 0; builder: false; wall: 0; cpu: 0; cost: 0 })
    return plan.checks.length - 1
}
function durations(history: Text, field: Integer): Map<Text, Integer> {
    let result = Map<Text, Integer>()
    if files.pathSize(history) <= 0 { return result }
    for line in test.lines(io.readTextFile(history)) {
        let fields = test.words(line)
        if fields.length <= field { continue }
        let parsed = text.parseInteger(fields[field])
        if errors.integerOk(parsed) { result[fields[0]] = errors.integerValue(parsed) }
    }
    return result
}
function milliseconds(value: Text): Integer {
    let raw = Bytes(value)
    let whole = 0
    let fraction = 0
    let digits = -1
    for byte in raw {
        if byte == 46 { digits = 0; continue }
        if byte < 48 || byte > 57 { return -1 }
        if digits < 0 { whole = whole * 10 + byte - 48 }
        else if digits < 3 { fraction = fraction * 10 + byte - 48; digits += 1 }
    }
    while digits >= 0 && digits < 3 { fraction *= 10; digits += 1 }
    return whole * 1000 + fraction
}
function cpuUsage(log: Text): Integer {
    let lines = test.lines(Text(files.readFile(log + ".cpu")))
    if lines.length == 0 { return 0 }
    let fields = test.words(lines[lines.length - 1])
    if fields.length != 3 { return 0 }
    let user = milliseconds(fields[0])
    let kernel = milliseconds(fields[1])
    if user < 0 || kernel < 0 { return 0 }
    return user + kernel
}
public function prioritize(plan: Plan, history: Text) {
    let known = durations(history, 1)
    let used = durations(history, 2)
    let base: List<Integer> = []
    let priority: List<Integer> = []
    for check in plan.checks {
        let estimate = check.weight * 1000
        if known.has(check.label) { estimate = known[check.label] }
        check.cost = slots(check.label, plan.jobs)
        if known.has(check.label) && used.has(check.label) && known[check.label] > 0 {
            check.cost = max(1, min(check.cost, (used[check.label] + known[check.label] - 1) / known[check.label]))
        }
        base.add(estimate)
        priority.add(estimate)
    }
    let changed = true
    while changed {
        changed = false
        for index in 0..plan.checks.length {
            for child in plan.checks[index].children {
                if base[child] + priority[index] > priority[child] { priority[child] = base[child] + priority[index]; changed = true }
            }
        }
    }
    for index in 0..plan.checks.length { plan.checks[index].weight = priority[index] }
}
public function remember(plan: Plan, history: Text) {
    let known = durations(history, 1)
    let used = durations(history, 2)
    for check in plan.checks { if check.wall > 0 { known[check.label] = check.wall; used[check.label] = check.cpu } }
    let rows: List<Text> = []
    for label in known {
        let row = label + " " + Text(known[label])
        if used.has(label) { row += " " + Text(used[label]) }
        rows.add(row + "\n")
    }
    rows.sort()
    let name = Bytes(history)
    let separator = -1
    for index in 0..name.length { if name[index] == 47 { separator = index } }
    let parent = "."
    if separator == 0 { parent = "/" }
    else if separator > 0 { parent = Text(name.slice(0, separator)) }
    let staging = test.scratchIn(parent)
    let temporary = staging + "/durations"
    let data = Bytes(joinText(rows))
    let output = files.open(temporary, files.WRITE | files.CREATE | files.EXCLUSIVE)
    test.check(output >= 0, "cannot create private check-duration file")
    let written = files.write(output, data, 0, data.length)
    let closed = files.close(output)
    test.check(written == data.length && closed == 0, "cannot write check durations")
    test.check(files.rename(temporary, history) == 0, "cannot record check durations")
    test.removeScratch(staging)
}
function closure(rules: List<Rule>, positions: Map<Text, Integer>, name: Text, members: Map<Text, Boolean>) {
    if members.has(name) || !positions.has(name) { return }
    let rule = rules[positions[name]]
    if rule.phony || !rule.stale { return }
    members[name] = rule.recipe
    for item in rule.prerequisites { closure(rules, positions, item, members) }
}
function prepare(plan: Plan) {
    for variant in 0..plan.variants.length {
        let names: List<Text> = []
        for goal in plan.goals { if goal.variant == variant && goal.state == 0 { names.add(goal.name) } }
        for check in plan.checks { if check.variant == variant && check.target != "" { names.add(check.target) } }
        if names.length == 0 { continue }
        let where = plan.variants[variant]
        let command: List<Text> = []
        for item in where.make { command.add(item) }
        command.add("-pqk")
        for name in names { command.add(name) }
        let result = test.run(command, where.environment, where.cwd, plan.scratch + "/question-" + Text(variant), plan.timeout)
        if !test.contains(result.output, "\n# Files\n") {
            for goal in plan.goals { if goal.variant == variant { goal.members["*"] = true } }
            continue
        }
        let rules = database(result.output)
        let positions = Map<Text, Integer>()
        for index in 0..rules.length { positions[rules[index].name] = index }
        for check in plan.checks {
            if check.variant != variant || check.target == "" || !positions.has(check.target) { continue }
            for item in rules[positions[check.target]].prerequisites {
                if !positions.has(item) { continue }
                let rule = rules[positions[item]]
                if !rule.phony && rule.stale && rule.recipe { check.goals.add(addGoal(plan, variant, item, check.weight)) }
            }
        }
        for goal in plan.goals { if goal.variant == variant { closure(rules, positions, goal.name, goal.members) } }
    }
}
function conflicts(plan: Plan, index: Integer): Boolean {
    let goal = plan.goals[index]
    let built = plan.variants[goal.variant].built
    for other in plan.goals {
        if other.state != 1 || other.variant != goal.variant { continue }
        for name in goal.members {
            if goal.members[name] && !built.has(name) && other.members.has(name) && other.members[name] { return true }
        }
    }
    return false
}
function ready(plan: Plan, check: Check): Boolean {
    for goal in plan.goals {
        if goal.variant == check.variant && (goal.state == 0 || goal.state == 1) { return false }
    }
    for child in check.children { if plan.checks[child].state != 2 { return false } }
    for goal in check.goals { if plan.goals[goal].state == 0 || plan.goals[goal].state == 1 { return false } }
    return true
}
function failedGoal(plan: Plan, check: Check): Boolean {
    for goal in check.goals { if plan.goals[goal].state == 3 { return true } }
    return false
}
function resourceAvailable(plan: Plan, check: Check): Boolean {
    if check.resource == "" { return true }
    let count = 0
    for running in plan.checks { if running.state == 1 && running.resource == check.resource { count += 1 } }
    let limit = 1
    if check.resource == "reused-ports" { limit = 3 }
    return count < limit
}
function command(plan: Plan, check: Check): List<Text> {
    if check.arguments.length > 0 { return check.arguments }
    let args: List<Text> = []
    for item in plan.variants[check.variant].make { args.add(item) }
    for child in check.children { args.add("-o"); args.add(plan.checks[child].target) }
    args.add(check.target)
    return args
}
function admission(plan: Plan, check: Check): Integer {
    if check.cost > 0 { return min(check.cost, plan.jobs) }
    return slots(check.label, plan.jobs)
}
function slots(label: Text, jobs: Integer): Integer {
    for parallel in ["check-mutation-score", "check-coverage", "check-quic-native-O0", "check-quic-native-O2", "check-quic-native-sanitize", "check-maps", "check-maps-sanitize", "check-cycle-additive", "check-cycle-additive-sanitize"] {
        if label == parallel { return min(4, jobs) }
    }
    for gate in ["check-peer-regressions-", "check-peer-optimizations-", "check-peer-sanitize-"] {
        for suite in ["regressions", "cpp-java-js", "rust-go-zig", "python-swift-ruby-lua"] {
            if label == gate + suite { return min(4, jobs) }
        }
    }
    return 1
}
function monitored(plan: Plan, variant: Integer, args: List<Text>, log: Text, tmp: Text, label: Text): Integer {
    let scratch = test.scratchIn(test.setting("MINYAR_TEST_SCRATCH", "/tmp"))
    test.require(test.run(["/bin/ln", "-s", scratch, tmp], system.environment(), "", log + ".scratch-link", 10), "link private scratch into the run")
    io.writeTextFile(log + ".scratch-alias", scratch)
    io.writeTextFile(log + ".scratch-home", tmp)
    let env = environment(plan.variants[variant].environment, "TMPDIR", scratch)
    env = environment(env, "MINYAR_CHECK_LABEL", label)
    if slots(label, plan.jobs) > 1 || label == "check-mutation-score" { env = environment(env, "MINYAR_TEST_JOBS", Text(slots(label, plan.jobs))) }
    return test.monitoredStart(args, env, plan.variants[variant].cwd, log, plan.timeout)
}
function settle(log: Text, passed: Boolean) {
    let scratch = io.readTextFile(log + ".scratch-alias")
    let home = io.readTextFile(log + ".scratch-home")
    test.check(test.contains(scratch, "/minyar-tests-") && files.remove(home) == 0, "unlink private scratch")
    if passed { test.removeTree(scratch) }
    else { test.require(test.run(["/bin/mv", "--", scratch, home], system.environment(), "", log + ".scratch-retain", 600), "retain failed check scratch") }
}
function showResult(label: Text, log: Text, status: system.ProcessStatus, started: Integer): Boolean {
    let passed = status.error == 0 && status.state == system.EXITED && status.exitCode == 0
    settle(log, passed)
    let elapsed = (system.monotonicNanoseconds() - started) / 1000000
    let outcome = "FAILED"
    if passed { outcome = "passed" }
    let usage = Text(files.readFile(log + ".cpu"))
    let timedOut = status.exitCode == 124 || status.exitCode == 137
    files.writeStandardOutput(label + ": " + outcome + " wall_ms=" + Text(elapsed) + " status=" + Text(status.exitCode) + " timeout=" + Text(timedOut) + " cpu_user/system/rss_kib=" + usage + "\n")
    if !passed { files.writeStandardOutput(Text(files.readFile(log)) + Text(files.readFile(log + ".err"))) }
    return passed
}
function counter(value: Text): Integer {
    let parsed = text.parseInteger(value)
    if errors.integerOk(parsed) { return errors.integerValue(parsed) }
    return -1
}
function sample(plan: Plan) {
    if !plan.elastic || plan.jobs <= 1 { plan.limit = plan.jobs; return }
    let now = system.monotonicNanoseconds()
    if plan.sampled != 0 && now - plan.sampled < 1000000000 { return }
    plan.sampled = now
    let result = test.run(["/bin/cat", "/proc/stat"], system.environment(), "", plan.scratch + "/load", 10)
    let lines = test.lines(result.output)
    if result.status != 0 || lines.length == 0 { plan.limit = plan.jobs; return }
    let fields = test.words(lines[0])
    if fields.length < 9 || fields[0] != "cpu" { plan.limit = plan.jobs; return }
    let busy = 0
    let total = 0
    for index in 1..9 {
        let value = counter(fields[index])
        if value < 0 { plan.limit = plan.jobs; return }
        total += value
        if index != 4 && index != 5 { busy += value }
    }
    let processors = 0
    let running = 0
    for line in lines {
        if begins(line, "cpu") && !begins(line, "cpu ") { processors += 1 }
        let words = test.words(line)
        if words.length == 2 && words[0] == "procs_running" { running = max(0, counter(words[1])) }
    }
    if plan.total > 0 && total > plan.total && processors > 0 {
        let cores = (busy - plan.busy) * processors / (total - plan.total)
        if running > processors { plan.limit = max(max(1, plan.jobs / 2), min(plan.limit, plan.jobs) - (running - processors)) }
        else { plan.limit = max(plan.jobs, min(2 * plan.jobs, 2 * plan.jobs - cores)) }
    }
    plan.busy = busy
    plan.total = total
}
function pause() {
    let handle = system.spawn("/bin/sleep", ["sleep", "0.05"], system.environment(), "")
    test.check(handle > 0 && system.wait(handle).exitCode == 0, "scheduler sleep failed")
}
function execute(plan: Plan): Boolean {
    let signalSocket = system.shutdownSignalSocket()
    test.check(signalSocket >= 0, "cannot install runner shutdown handling")
    let remaining = 0
    for check in plan.checks { if check.state < 2 { remaining += 1 } }
    for goal in plan.goals { if goal.state < 2 { remaining += 1 } }
    let epoch = Text(system.monotonicNanoseconds())
    let interrupted = false
    while remaining > 0 {
        if system.drainShutdownSignals() != 0 { interrupted = true; break }
        let active = 0
        let quiet = false
        let ordinary = false
        for goal in plan.goals {
            if goal.state == 1 {
                let status = system.poll(goal.handle)
                if status.state != system.PENDING {
                    let ok = showResult("prerequisite " + goal.name, goal.log, status, goal.started)
                    goal.state = 3
                    if ok {
                        goal.state = 2
                        for name in goal.members { if name != "*" { plan.variants[goal.variant].built[name] = true } }
                    }
                    remaining -= 1
                } else { active += 1; ordinary = true }
            }
        }
        for check in plan.checks {
            if check.state == 1 {
                let status = system.poll(check.handle)
                if status.state != system.PENDING {
                    check.wall = (system.monotonicNanoseconds() - check.started) / 1000000
                    check.cpu = cpuUsage(check.log)
                    let ok = showResult(check.label, check.log, status, check.started)
                    check.state = 3
                    if ok { check.state = 2 }
                    if check.builder { plan.variants[check.variant].builder = false }
                    remaining -= 1
                } else {
                    active += admission(plan, check)
                    if check.exclusive { quiet = true } else { ordinary = true }
                }
            }
        }
        for check in plan.checks {
            if check.state == 0 {
                for child in check.children {
                    if plan.checks[child].state == 3 {
                        check.state = 3; remaining -= 1
                        files.writeStandardOutput(check.label + ": FAILED prerequisite " + plan.checks[child].label + "\n")
                        break
                    }
                }
            }
        }
        let launched = false
        sample(plan)
        while active < plan.limit {
            let chosenGoal = -1
            let chosenCheck = -1
            let best = -1
            let waiting = -1
            if !quiet {
                for index in 0..plan.goals.length {
                    let goal = plan.goals[index]
                    if goal.state == 0 && !plan.variants[goal.variant].builder && goal.weight > best && !conflicts(plan, index) {
                        chosenGoal = index; best = goal.weight
                    }
                }
            }
            for index in 0..plan.checks.length {
                let check = plan.checks[index]
                if check.state != 0 || !ready(plan, check) || !resourceAvailable(plan, check) { continue }
                if check.exclusive {
                    if ordinary || active >= max(1, plan.jobs / 4) { continue }
                } else { if quiet { continue } }
                if failedGoal(plan, check) && active > 0 { continue }
                let blockedByBuilder = false
                for running in plan.checks { if running.state == 1 && running.builder { blockedByBuilder = true } }
                if blockedByBuilder { continue }
                if active + admission(plan, check) > plan.limit {
                    if check.weight > waiting { waiting = check.weight }
                    continue
                }
                if check.weight > best { chosenGoal = -1; chosenCheck = index; best = check.weight }
            }
            if chosenGoal < 0 && chosenCheck < 0 { break }
            if waiting > best { break }
            plan.attempts += 1
            let attempt = plan.attempts
            let log = plan.scratch + "/logs/process-" + epoch + "-" + Text(attempt)
            let tmp = plan.scratch + "/tmp-" + Text(attempt)
            if chosenGoal >= 0 {
                let goal = plan.goals[chosenGoal]
                let where = plan.variants[goal.variant]
                let args = ["/usr/bin/flock", "-s", "-F", "build/bootstrap.lock"]
                if files.pathSize("/usr/bin/flock") < 0 { args = ["/usr/bin/lockf", "-k", "build/bootstrap.lock"] }
                for item in where.make { args.add(item) }
                args.add(goal.name)
                goal.handle = monitored(plan, goal.variant, args, log, tmp, goal.name)
                test.check(goal.handle > 0, "cannot launch builder")
                goal.state = 1; goal.log = log; goal.started = system.monotonicNanoseconds()
                ordinary = true
            } else {
                let check = plan.checks[chosenCheck]
                check.builder = failedGoal(plan, check)
                if check.builder { plan.variants[check.variant].builder = true }
                check.handle = monitored(plan, check.variant, command(plan, check), log, tmp, check.label)
                test.check(check.handle > 0, "cannot launch check")
                check.state = 1; check.log = log; check.started = system.monotonicNanoseconds()
                if check.exclusive { quiet = true } else { ordinary = true }
            }
            let cost = 1
            if chosenCheck >= 0 { cost = admission(plan, plan.checks[chosenCheck]) }
            active += cost; launched = true
        }
        if active == 0 && !launched && remaining > 0 {
            for check in plan.checks {
                if check.state == 0 { check.state = 3; remaining -= 1; files.writeStandardOutput(check.label + ": FAILED dependency cycle\n") }
            }
            test.check(remaining == 0, "stalled builder plan")
        }
        if active > 0 { pause() }
    }
    if interrupted {
        plan.interrupted = true
        for check in plan.checks { if check.state == 1 { system.sendSignal(system.childProcessId(check.handle), 15); system.wait(check.handle); settle(check.log, false) } }
        for goal in plan.goals { if goal.state == 1 { system.sendSignal(system.childProcessId(goal.handle), 15); system.wait(goal.handle); settle(goal.log, false) } }
        return false
    }
    let passed = true
    for check in plan.checks { if check.state != 2 { passed = false } }
    return passed
}

public function run(plan: Plan): Boolean {
    prepare(plan)
    let passed = execute(plan)
    let jobs = plan.jobs
    for attempt in 0..plan.retries {
        if passed || plan.interrupted { break }
        plan.jobs = 1
        for check in plan.checks {
            if check.state == 3 {
                check.state = 0; check.retry += 1
                files.writeStandardOutput(check.label + ": isolated retry " + Text(check.retry) + "\n")
            }
        }
        for goal in plan.goals { if goal.state == 3 { goal.state = 0 } }
        passed = execute(plan)
    }
    plan.jobs = jobs
    return passed
}
