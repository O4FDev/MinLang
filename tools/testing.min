use "io" as io
use "system" as system
use "files" as files
use "text" as text
use "errors" as errors

public function resolvePath(path: Text): Text { native "testinghost" }
public function selfPath(): Text { native "testinghost" }

public function check(condition: Boolean, message: Text) {
    if !condition { fail(message) }
}
public function contains(source: Text, needle: Text): Boolean {
    let haystack = Bytes(source)
    let pattern = Bytes(needle)
    if pattern.length > haystack.length { return false }
    for start in 0..(haystack.length - pattern.length + 1) {
        let equal = true
        for index in 0..pattern.length {
            if haystack[start + index] != pattern[index] { equal = false; break }
        }
        if equal { return true }
    }
    return false
}
// Semantic suites keep their independent message/position oracles. Presentation
// is locked separately by the complete diagnostic goldens. This projection
// preserves every old field, and refuses unrelated stderr or multiple errors.
public function diagnosticSummary(output: Text, includeFile: Boolean): Text {
    if !output.startsWith("error: ") { return output }
    let marker = output.find("\n  --> ")
    if marker < 0 { return output }
    let rest = output.slice(marker + 7, output.length)
    let end = rest.find("\n")
    if end < 0 { return output }
    let location = rest.slice(0, end)
    let last = -1
    let before = -1
    for position in 0..location.length {
        if location[position] == ':' { before = last; last = position }
    }
    if before <= 0 || last <= before + 1 || last + 1 >= location.length { return output }
    for row in lines(rest.slice(end + 1, rest.length)) {
        let index = 0
        while index < row.length && row[index] == ' ' { index += 1 }
        if index < row.length {
            if row[index] != '|' && row[index] != '=' && !(row[index] >= '0' && row[index] <= '9' && row.find(" | ") >= 0) { return output }
        }
    }
    let prefix = "line "
    if includeFile { prefix = location.slice(0, before + 1) }
    return "Minyar stopped: " + prefix + location.slice(before + 1, last) + ", column " + location.slice(last + 1, location.length) + ": " + output.slice(7, marker) + "\n"
}
public function sameDiagnostic(actual: Text, expected: Text): Boolean {
    return actual == expected || diagnosticSummary(actual, false) == expected || diagnosticSummary(actual, true) == expected
}
public function containsDiagnostic(actual: Text, expected: Text): Boolean {
    return contains(actual, expected) || contains(diagnosticSummary(actual, false), expected) || contains(diagnosticSummary(actual, true), expected)
}
public function lines(source: Text): List<Text> {
    let result: List<Text> = []
    let raw = Bytes(source)
    let start = 0
    for index in 0..raw.length {
        if raw[index] == 10 {
            result.add(Text(raw.slice(start, index)))
            start = index + 1
        }
    }
    if start < raw.length { result.add(Text(raw.slice(start, raw.length))) }
    return result
}
public function words(source: Text): List<Text> {
    let result: List<Text> = []
    let raw = Bytes(source)
    let start = 0
    for index in 0..(raw.length + 1) {
        let space = index == raw.length
        if index < raw.length { space = raw[index] <= 32 }
        if space {
            if start < index { result.add(Text(raw.slice(start, index))) }
            start = index + 1
        }
    }
    return result
}
public function setting(name: Text, fallback: Text): Text {
    let value = system.getenv(name)
    if value == "" { return fallback }
    return value
}
// MINYAR_TEST_TIMEOUT_SCALE (1-20, default 1) multiplies every process limit for heavily loaded machines.
public function scaledSeconds(seconds: Integer): Integer {
    let configured = setting("MINYAR_TEST_TIMEOUT_SCALE", "1")
    let parsed = text.parseInteger(configured)
    check(errors.integerOk(parsed), "MINYAR_TEST_TIMEOUT_SCALE must be an integer from 1 to 20")
    let scale = errors.integerValue(parsed)
    check(scale >= 1 && scale <= 20, "MINYAR_TEST_TIMEOUT_SCALE must be an integer from 1 to 20")
    return seconds * scale
}
public record Result { status: Integer; output: Text; errorOutput: Text }
function portableScript(): Text {
    return "log=$1; limit=$2; shift 2; exec 2>\"$log.err\"; monitor=$$; set -m; /usr/bin/env -- \"$@\" >\"$log\" & child=$!; (exec 2>/dev/null; set +m; /bin/sleep \"$limit\" & sleeper=$!; while kill -0 \"$sleeper\" 2>/dev/null && kill -0 \"$monitor\" 2>/dev/null; do /bin/sleep 0.1; done; kill -TERM \"$sleeper\" 2>/dev/null || :; wait \"$sleeper\" 2>/dev/null; printf 'timeout\\n' >\"$log.timeout\"; kill -TERM -- -\"$child\" 2>/dev/null || :; /bin/sleep 2; kill -KILL -- -\"$child\" 2>/dev/null || :) & timer=$!; set +m; exec 2>/dev/null; trap 'kill -TERM -- -\"$child\" -\"$timer\" 2>/dev/null || :; /bin/sleep 2; kill -KILL -- -\"$child\" 2>/dev/null || :; wait \"$child\" 2>/dev/null; child_status=$?; wait \"$timer\" 2>/dev/null; if [ \"$child_status\" -eq 0 ]; then exit 0; fi; exit 143' TERM INT; wait \"$child\"; status=$?; if [ -f \"$log.timeout\" ]; then wait \"$timer\" 2>/dev/null; status=124; else kill -TERM -- -\"$timer\" 2>/dev/null || :; wait \"$timer\" 2>/dev/null; fi; trap - TERM INT; exit \"$status\""
}
public function portableStart(command: List<Text>, environment: List<Text>, cwd: Text, log: Text, seconds: Integer): Integer {
    check(command.length > 0 && seconds > 0, "invalid process request")
    if files.pathSize(log + ".timeout") >= 0 { check(files.remove(log + ".timeout") == 0, "cannot clear private timeout marker") }
    let script = portableScript()
    let argv = ["bash", "-c", script, "minyar", log, Text(scaledSeconds(seconds))]
    for item in command { argv.add(item) }
    return system.spawn("/bin/bash", argv, environment, cwd)
}
public function start(command: List<Text>, environment: List<Text>, cwd: Text, log: Text, seconds: Integer): Integer {
    check(command.length > 0 && seconds > 0, "invalid process request")
    if files.pathSize("/usr/bin/timeout") < 0 { return portableStart(command, environment, cwd, log, seconds) }
    let argv = ["sh", "-c", "log=$1; shift; exec \"$@\" >\"$log\" 2>\"$log.err\"", "minyar", log,
        "/usr/bin/timeout", "--kill-after=2", Text(scaledSeconds(seconds)), "/usr/bin/env", "--"]
    for item in command { argv.add(item) }
    return system.spawn("/bin/sh", argv, environment, cwd)
}
public function finish(handle: Integer, log: Text): Result {
    check(handle > 0, "process launch failed: " + Text(handle))
    let status = system.wait(handle)
    check(status.error == 0 && (status.state == system.EXITED || status.state == system.SIGNALED), "process wait failed")
    let output = Text(files.readFile(log))
    check(files.lastError() == 0, "cannot read process output")
    let errorOutput = Text(files.readFile(log + ".err"))
    check(files.lastError() == 0, "cannot read process diagnostics")
    let code = status.exitCode
    if status.state == system.SIGNALED { code = 128 + status.signal }
    return Result { status: code; output: output; errorOutput: errorOutput }
}
public function run(command: List<Text>, environment: List<Text>, cwd: Text, log: Text, seconds: Integer): Result {
    return finish(start(command, environment, cwd, log, seconds), log)
}
public function require(result: Result, phase: Text) {
    check(result.status == 0, phase + " failed (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
}
public function scratch(): Text {
    let parent = resolvePath(setting("TMPDIR", "/tmp"))
    check(parent != "", "cannot resolve test scratch parent")
    let path = parent + "/minyar-tests-" + Text(system.processId()) + "-" + Text(system.monotonicNanoseconds())
    check(files.makeDirectory(path) == 0, "cannot create test scratch")
    return path
}
public function removeScratch(path: Text) {
    removeTree(path)
}
public function addressEnabled(flags: List<Text>): Boolean {
    let enabled = false
    for flag in flags {
        if contains(flag, "-fsanitize=") && contains(flag, "address") { enabled = true }
        if contains(flag, "-fno-sanitize=") && (contains(flag, "address") || contains(flag, "all")) { enabled = false }
    }
    return enabled
}
function unquoted(source: Text): Bytes {
    let raw = Bytes(source)
    let masked = raw.slice(0, raw.length)
    let quoted = false
    let escaped = false
    for index in 0..raw.length {
        let byte = raw[index]
        if quoted {
            masked[index] = 32
            if escaped { escaped = false }
            else if byte == 92 { escaped = true }
            else if byte == 34 { quoted = false }
        } else if byte == 34 { masked[index] = 32; quoted = true }
    }
    check(!quoted, "unterminated LLVM header token")
    return masked
}
record AttributeGroup { name: Text; source: Text }
function enabled(attributes: Text): Boolean {
    for token in words(attributes) { if token == "sanitize_address" { return true } }
    return false
}
public function instrument(source: Text): Text {
    let groups: List<AttributeGroup> = []
    let headers = lines(source)
    for line in headers {
        let tokens = words(line)
        if tokens.length >= 5 && tokens[0] == "attributes" && tokens[2] == "=" && tokens[3] == "{" {
            groups.add(AttributeGroup { name: tokens[1]; source: Text(unquoted(line)) })
        }
    }
    let result: List<Text> = []
    let count = 0
    for line in headers {
        let tokens = words(line)
        if tokens.length > 0 && tokens[0] == "define" {
            let raw = Bytes(line)
            let masked = unquoted(line)
            let brace = raw.length - 1
            while brace >= 0 && raw[brace] <= 32 { brace -= 1 }
            check(brace >= 0 && masked[brace] == 123, "unsupported LLVM function header")
            let global = -1
            for index in 0..brace { if masked[index] == 64 { global = index; break } }
            check(global >= 0, "missing LLVM function name")
            let opening = -1
            for index in (global + 1)..brace { if masked[index] == 40 { opening = index; break } }
            check(opening >= 0, "missing LLVM function parameters")
            let depth = 0
            let closing = -1
            for index in opening..brace {
                if masked[index] == 40 { depth += 1 }
                if masked[index] == 41 { depth -= 1; if depth == 0 { closing = index; break } }
            }
            check(closing >= 0, "unterminated LLVM parameter list")
            let attributes = Text(masked.slice(closing + 1, brace))
            check(!contains(attributes, "{") && !contains(attributes, "}"), "unsupported LLVM function attributes")
            let annotated = enabled(attributes)
            let index = closing + 1
            while index < brace {
                if masked[index] == 35 {
                    let end = index + 1
                    while end < brace && masked[end] >= 48 && masked[end] <= 57 { end += 1 }
                    let name = Text(masked.slice(index, end))
                    let found = false
                    for group in groups {
                        if group.name == name { found = true; if enabled(group.source) { annotated = true } }
                    }
                    check(found, "missing LLVM attribute group " + name)
                    index = end - 1
                }
                index += 1
            }
            if !annotated { line = Text(raw.slice(0, brace)) + "sanitize_address " + Text(raw.slice(brace, raw.length)) }
            count += 1
        }
        result.add(line + "\n")
    }
    check(count > 0, "LLVM contains no functions")
    return joinText(result)
}
public record Compiler { directory: Text; serial: Integer; executable: Text; runtime: Text; clang: Text; flags: List<Text>; compileTimeout: Integer; linkTimeout: Integer; runTimeout: Integer }
public function compiler(): Compiler {
    let flags = words(setting("MINYAR_TEST_LINK_FLAGS", ""))
    let compileTimeout = 10
    let linkTimeout = 30
    let runTimeout = 10
    if flags.length > 0 { compileTimeout = 30; linkTimeout = 120; runTimeout = 30 }
    return Compiler { directory: scratch(); serial: 0;
        executable: setting("MINYAR_TEST_COMPILER", "./build/minyarc");
        runtime: setting("MINYAR_TEST_RUNTIME", "build/minyar-runtime.o");
        clang: setting("MINYAR_TEST_CLANG", "clang"); flags: flags; compileTimeout: compileTimeout; linkTimeout: linkTimeout; runTimeout: runTimeout }
}
public function stableInput(source: Text, input: Text, root: Text): Text {
    if root != "" && !contains(source, "use") {
        let hash = 0
        for byte in Bytes(source) { hash = (hash * 31 + byte) % 1000000007 }
        let directory = root + "/" + Text(Bytes(source).length) + "-" + Text(hash)
        check(files.makeDirectory(directory) == 0, "cannot create stable source input directory")
        let publish = "set -e; source=$1; directory=$2; index=0; while [ -e \"$directory/$index.min\" ]; do if cmp -s -- \"$source\" \"$directory/$index.min\"; then printf '%s\\n' \"$directory/$index.min\"; exit 0; fi; index=$((index+1)); done; cp -- \"$source\" \"$directory/$index.min.tmp\"; mv -- \"$directory/$index.min.tmp\" \"$directory/$index.min\"; printf '%s\\n' \"$directory/$index.min\""
        let published = run(["flock", "-F", directory + "/lock", "/bin/sh", "-c", publish, "minyar", input, directory], system.environment(), "", input + ".publish", 10)
        require(published, "immutable shared source input")
        return lines(published.output)[0]
    }
    return input
}
public function sourceModules(source: Text): Text {
    let result = source
    for item in [["io", "io"], ["process", "processInfo"], ["random", "secureRandom"], ["math", "math"], ["pixels", "pixelOps"]] {
        if contains(source, item[1] + ".") && !contains(source, " as " + item[1]) {
            result += "\nuse \"" + item[0] + "\" as " + item[1] + "\n"
        }
    }
    return result
}
public function compile(test: Compiler, source: Text): Result {
    source = sourceModules(source)
    test.serial += 1
    let path = test.directory + "/case" + Text(test.serial)
    io.writeTextFile(path + ".min", source)
    let input = stableInput(source, path + ".min", system.getenv("MINYAR_TEST_INPUT_ROOT"))
    let result = run([test.executable, input, path + ".ll", "--library", "library"], system.environment(), "", path + ".compile", test.compileTimeout)
    if result.status == 0 && addressEnabled(test.flags) {
        io.writeTextFile(path + ".ll", instrument(io.readTextFile(path + ".ll")))
    }
    return result
}
public function rejects(test: Compiler, source: Text, diagnostic: Text) {
    let result = compile(test, source)
    check(result.status != 0 && result.status != 124 && result.status != 137, "expected compiler rejection\n" + result.output + result.errorOutput)
    check(containsDiagnostic(result.errorOutput, diagnostic), "missing diagnostic: " + diagnostic + "\n" + result.output + result.errorOutput)
    check(files.pathSize(test.directory + "/case" + Text(test.serial) + ".ll") < 0, "rejected source emitted LLVM")
}
public function executes(test: Compiler, source: Text, expected: Text) {
    require(compile(test, source), "compile")
    let path = test.directory + "/case" + Text(test.serial)
    for optimization in ["-O0", "-O2"] {
        let command = [test.clang, optimization, "-Wno-override-module"]
        for flag in test.flags { command.add(flag) }
        for item in [path + ".ll", test.runtime, "-lm", "-o", path + ".exe"] { command.add(item) }
        require(run(command, system.environment(), "", path + ".link", test.linkTimeout), "link")
        let result = run([path + ".exe"], system.environment(), "", path + ".run", test.runTimeout)
        require(result, "execution")
        check(result.errorOutput == "", "unexpected execution diagnostics\n" + result.errorOutput)
        check(result.output == expected, "unexpected output at " + optimization + "\n" + result.output + "expected\n" + expected)
    }
}
function portableMonitoredStart(command: List<Text>, environment: List<Text>, cwd: Text, log: Text, seconds: Integer): Integer {
    check(command.length > 0 && seconds > 0, "invalid process request")
    if files.pathSize(log + ".timeout") >= 0 { check(files.remove(log + ".timeout") == 0, "cannot clear private timeout marker") }
    let usage = "usage() { /usr/bin/awk '$2 == \"real\" && $4 == \"user\" && $6 == \"sys\" { user = $3; kernel = $5 } /maximum resident set size/ { rss = int($1 / 1024) } END { if (user != \"\") printf \"%s %s %d\\n\", user, kernel, rss }' \"$log.time\" >\"$log.cpu\" 2>/dev/null || :; }"
    let script = "inner=$1; log=$2; shift; " + usage + "; trap 'if [ -s \"$log.pid\" ]; then kill -TERM \"$(cat \"$log.pid\")\" 2>/dev/null || :; fi; wait \"$waiter\"; usage; exit 143' TERM INT; /usr/bin/time -l -o \"$log.time\" /bin/bash -c \"$inner\" minyar \"$@\" & waiter=$!; wait \"$waiter\"; status=$?; trap - TERM INT; usage; exit \"$status\""
    let argv = ["sh", "-c", script, "minyar", "echo \"$$\" >\"$1.pid\"; " + portableScript(), log, Text(seconds)]
    for item in command { argv.add(item) }
    return system.spawn("/bin/sh", argv, environment, cwd)
}
public function monitoredStart(command: List<Text>, environment: List<Text>, cwd: Text, log: Text, seconds: Integer): Integer {
    if files.pathSize("/usr/bin/timeout") < 0 { return portableMonitoredStart(command, environment, cwd, log, seconds) }
    let script = "log=$1; limit=$2; shift 2; trap 'if [ -s \"$log.pid\" ]; then group=$(cat \"$log.pid\"); /bin/kill -TERM -- -\"$group\" 2>/dev/null || :; fi; wait \"$waiter\"; exit 143' TERM INT; /usr/bin/time -o \"$log.cpu\" -f '%U %S %M' /usr/bin/timeout --kill-after=2 \"$limit\" /bin/sh -c 'echo \"$PPID\" > \"$1.pid\"; shift; exec \"$@\"' minyar \"$log\" /usr/bin/env -- \"$@\" >\"$log\" 2>\"$log.err\" & waiter=$!; wait \"$waiter\"; status=$?; trap - TERM INT; exit \"$status\""
    let argv = ["sh", "-c", script, "minyar", log, Text(seconds)]
    for item in command { argv.add(item) }
    return system.spawn("/bin/sh", argv, environment, cwd)
}
public function removeTree(path: Text) {
    check(contains(path, "/minyar-tests-"), "invalid private scratch path")
    let handle = system.spawn("/bin/rm", ["rm", "-rf", "--", path], system.environment(), "")
    check(handle > 0 && system.wait(handle).exitCode == 0, "cannot remove private scratch")
}
public function replace(source: Text, needle: Text, replacement: Text): Text {
    let raw = Bytes(source)
    let pattern = Bytes(needle)
    check(pattern.length > 0, "empty replacement pattern")
    let parts: List<Text> = []
    let start = 0
    let index = 0
    while index + pattern.length <= raw.length {
        let equal = true
        for offset in 0..pattern.length { if raw[index + offset] != pattern[offset] { equal = false; break } }
        if equal {
            parts.add(Text(raw.slice(start, index))); parts.add(replacement)
            index += pattern.length; start = index
        } else { index += 1 }
    }
    parts.add(Text(raw.slice(start, raw.length)))
    return joinText(parts)
}
