public function styles(): Text {
    return #"""
    :root{color-scheme:light dark;--paper:#f7f6f2;--surface:#fffefa;--ink:#202a35;--muted:#66717a;--line:#dce0dd;--blue:#215e79;--wash:#eaf0ef;--gold:#9a6331;--code:#eff1ed;--serif:Georgia,'Times New Roman',serif;--sans:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;--mono:'SFMono-Regular',Consolas,'Liberation Mono',monospace}
    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:32px}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.65;-webkit-font-smoothing:antialiased}a{color:var(--blue);text-decoration:none}a:hover{text-decoration:underline}button,input{font:inherit}[hidden]{display:none!important}.skip{position:absolute;top:-100px;left:20px;background:var(--ink);color:var(--paper);padding:12px 20px;z-index:10}.skip:focus{top:12px}.shell{display:grid;grid-template-columns:252px minmax(0,1fr);max-width:1440px;margin:auto;min-height:100vh}
    .rail{position:sticky;top:0;height:100vh;border-right:1px solid var(--line);padding:38px 24px 24px 32px;display:flex;flex-direction:column;gap:24px}.brand{display:flex;align-items:center;gap:11px;color:var(--ink);font-size:20px;font-weight:650;letter-spacing:-.7px}.brand svg{color:var(--blue);width:29px;height:29px}.brand small{font-size:10px;text-transform:uppercase;letter-spacing:1.4px;color:var(--muted);border-left:1px solid var(--line);padding-left:11px;margin-left:2px;font-weight:500}.package{font-size:12px;color:var(--muted);line-height:1.5;overflow-wrap:anywhere}.package strong{display:block;color:var(--ink);font-size:14px;font-weight:600}.search{position:relative}.search svg{position:absolute;width:16px;height:16px;left:12px;top:13px;color:var(--muted)}.search input{width:100%;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:7px;padding:10px 28px 10px 36px;outline:none;font-size:12px;min-height:42px}.search input:focus{border-color:var(--blue);box-shadow:0 0 0 3px color-mix(in srgb,var(--blue) 12%,transparent)}.search kbd{position:absolute;right:12px;top:10px;color:var(--muted);font:12px var(--mono)}.nav-title{font-size:10px;font-weight:650;text-transform:uppercase;letter-spacing:1.8px;color:var(--muted);margin:0 0 9px}nav{overflow:auto;flex:1}nav ul{list-style:none;padding:0;margin:0}nav a{display:block;border-radius:5px;padding:6px 10px;margin:1px -10px;color:var(--muted);font-size:13px;overflow-wrap:anywhere}nav a:hover,nav a[aria-current]{background:var(--wash);color:var(--blue);text-decoration:none}nav .dot{display:inline-block;width:5px;height:5px;background:var(--blue);border-radius:50%;margin-right:9px;vertical-align:2px;opacity:.55}.rail-foot{font-size:11px;color:var(--muted);line-height:1.6;border-top:1px solid var(--line);padding-top:17px}.rail-foot span{display:block;font-family:var(--serif);font-style:italic;font-size:15px;margin-bottom:4px;color:var(--ink)}
    main{min-width:0;padding:56px clamp(28px,5.2vw,80px) 64px}.eyebrow{display:flex;align-items:center;gap:10px;font-size:10px;font-weight:650;letter-spacing:2px;text-transform:uppercase;color:var(--blue);margin:0 0 18px}.eyebrow:before{content:'';display:inline-block;width:24px;height:1px;background:currentColor}.hero{padding-bottom:42px;border-bottom:1px solid var(--line);margin-bottom:46px;position:relative}h1{font-family:var(--serif);font-weight:400;font-size:clamp(44px,5.2vw,72px);line-height:1.07;letter-spacing:-2.8px;margin:0 0 23px;max-width:900px;overflow-wrap:anywhere}.lede{font-size:16px;line-height:1.8;color:var(--muted);max-width:580px;margin:0 0 25px}.stats{display:flex;gap:22px;flex-wrap:wrap;font-size:11px;color:var(--muted)}.stats strong{font:16px var(--serif);color:var(--ink);margin-right:5px}.verified{display:inline-flex;align-items:center;gap:6px;color:var(--blue)}.verified svg{width:13px;height:13px}.search-status{color:var(--muted);font-size:13px;margin:-22px 0 30px}.module{margin-bottom:66px;scroll-margin-top:30px}.module-head{display:flex;align-items:baseline;gap:16px;margin-bottom:24px;flex-wrap:wrap}.module h2{font-family:var(--serif);font-size:32px;line-height:1.2;letter-spacing:-.7px;font-weight:400;margin:0;overflow-wrap:anywhere}.module-head .path{font:10px var(--mono);color:var(--muted);overflow-wrap:anywhere}.module-head .count{margin-left:auto;font-size:10px;color:var(--muted);white-space:nowrap}.api{padding:28px 0 31px;border-top:1px solid var(--line);scroll-margin-top:25px}.api:first-of-type{border-top:0;padding-top:0}.api-heading{display:flex;align-items:center;gap:10px;margin-bottom:13px;min-width:0}.kind{font:9px var(--mono);letter-spacing:1px;text-transform:uppercase;color:var(--blue);background:var(--wash);border-radius:3px;padding:3px 7px;flex:none}.kind.record,.kind.choice,.kind.type{color:var(--gold);background:color-mix(in srgb,var(--gold) 9%,transparent)}h3{font-size:17px;line-height:1.4;font-weight:600;letter-spacing:-.35px;margin:0;overflow-wrap:anywhere}.permalink{color:var(--muted);opacity:.45;font-weight:400}.api-heading .location{margin-left:auto;color:var(--muted);font:10px var(--mono);flex:none}.signature{background:var(--code);border:1px solid color-mix(in srgb,var(--line) 65%,transparent);border-radius:6px;padding:15px 18px;overflow:auto;margin:0 0 17px;font:12px/1.8 var(--mono);tab-size:4;white-space:pre-wrap;overflow-wrap:anywhere}.signature .keyword,.example .keyword{color:var(--blue);font-weight:600}.signature .type,.example .type{color:var(--gold)}.prose{max-width:720px;font-size:14px;line-height:1.85}.prose p{margin:0 0 13px}.prose p:last-child{margin-bottom:0}.prose code,.member-title code{font:11px var(--mono);background:var(--code);padding:2px 5px;border-radius:3px;color:var(--blue)}.prose h4{font-size:15px;margin:24px 0 9px;font-weight:600}.prose ul{padding-left:22px;margin:10px 0 15px}.undocumented{font-size:13px;color:var(--muted);font-style:italic}.members{border-left:2px solid var(--line);padding-left:20px;margin:24px 0 0}.member{margin:0 0 20px}.member:last-child{margin:0}.member-title{font:12px/1.7 var(--mono);margin:0 0 5px;color:var(--ink);overflow-wrap:anywhere}.member .prose{font-size:13px;color:var(--muted)}.example{margin:23px 0;border:1px solid var(--line);background:var(--surface);border-radius:7px;overflow:hidden}.example-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 16px;border-bottom:1px solid var(--line);font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1.3px}.example-head .verified{font-size:9px;letter-spacing:.8px}.example pre{padding:17px 19px;margin:0;font:12px/1.9 var(--mono);overflow:auto;tab-size:4}.example code{font:inherit;background:none;padding:0;color:inherit}.example .output{border-top:1px solid var(--line);background:var(--code);position:relative;padding-top:12px}.output-label{font:9px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:1px;display:block;margin-bottom:7px}.empty{font-style:italic;color:var(--muted)}.page-foot{border-top:1px solid var(--line);padding-top:24px;font-size:11px;color:var(--muted);display:flex;justify-content:space-between;gap:20px}.page-foot em{font-family:var(--serif);font-size:14px;font-style:italic;color:var(--ink)}.no-results{padding:30px 0;color:var(--muted);font-family:var(--serif);font-size:22px}.mobile-label{display:none}
    @media(min-width:1500px){.shell{border-left:1px solid var(--line);border-right:1px solid var(--line)}}
    @media(max-width:900px){.shell{grid-template-columns:205px minmax(0,1fr)}.rail{padding:28px 18px;gap:20px}.brand{font-size:18px}.brand small{display:none}main{padding:38px 28px 45px}h1{font-size:50px;letter-spacing:-2px}.api-heading .location{display:none}.hero{padding-bottom:30px;margin-bottom:35px}}
    @media(max-width:620px){html{scroll-padding-top:15px}.shell{display:block}.rail{position:relative;height:auto;padding:21px 22px 18px;border-right:0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:14px}.brand{font-size:20px}.brand small{display:inline}.package{text-align:right;font-size:10px}.package strong{font-size:12px}.search{grid-column:1/-1}nav{grid-column:1/-1;max-height:130px}nav ul{display:flex;gap:7px;flex-wrap:wrap}nav a{font-size:11px;margin:0;padding:3px 8px;border:1px solid var(--line);border-radius:4px}nav .dot{display:none}.nav-title,.rail-foot{display:none}main{padding:34px 22px 40px}.eyebrow{font-size:9px;margin-bottom:16px;letter-spacing:1.7px}h1{font-size:43px;letter-spacing:-1.8px;margin-bottom:18px}.lede{font-size:14px;line-height:1.75}.stats{gap:16px;font-size:10px}.stats strong{font-size:15px}.module h2{font-size:29px}.module-head{gap:9px;margin-bottom:20px}.module-head .count{font-size:9px}.module-head .path{font-size:9px;flex-basis:100%}.signature{padding:12px 13px;font-size:11px}.api{padding:23px 0 26px}.api-heading{gap:8px}h3{font-size:16px}.kind{font-size:8px;padding:3px 5px}.prose{font-size:13px}.example pre{font-size:11px;padding:13px}.example-head{padding:9px 13px}.page-foot{display:block}.page-foot em{display:block;margin-top:8px}.members{padding-left:14px}}
    @media(prefers-color-scheme:dark){:root{--paper:#151d24;--surface:#19242d;--ink:#e1e8e6;--muted:#96a5aa;--line:#303e47;--blue:#85c7d3;--wash:#233942;--gold:#d6ae7b;--code:#1c2b34}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    """#
}

public function script(): Text {
    return #"""
    (()=>{const input=document.querySelector('#search');const entries=[...document.querySelectorAll('.api')];for(const entry of entries)entry.dataset.search=entry.dataset.search.toLowerCase();const modules=[...document.querySelectorAll('.module')];const status=document.querySelector('#search-status');const empty=document.querySelector('#no-results');function search(){const terms=input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);let count=0;for(const entry of entries){entry.hidden=!terms.every(term=>entry.dataset.search.includes(term));if(!entry.hidden)count++}for(const module of modules){module.hidden=![...module.querySelectorAll('.api')].some(entry=>!entry.hidden);const link=document.querySelector('nav a[href="#'+module.id+'"]');if(link)link.hidden=module.hidden}status.hidden=!terms.length;status.textContent=count+' public '+(count===1?'declaration':'declarations')+' found';empty.hidden=!!count}input.addEventListener('input',search);document.addEventListener('keydown',event=>{if(event.key==='/'&&event.target.tagName!=='INPUT'&&event.target.tagName!=='TEXTAREA'){event.preventDefault();input.focus()}if(event.key==='Escape'&&event.target===input){input.value='';search();input.blur()}});function active(){for(const link of document.querySelectorAll('nav a')){if(link.hash===location.hash)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current')}}window.addEventListener('hashchange',active);active()})();
    """#
}
