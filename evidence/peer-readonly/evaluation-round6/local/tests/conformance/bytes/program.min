record Chunk { blocks: Bytes; name: Text }
let b = Bytes(4)
b[0] = 255
b[3] += 7
print(b.length)
print(b[0] + b[3])
b.add(9)
b.addFloat32(1.5)
b.addInt32(-2)
b.addUInt16(65535)
print(b.length)
print(b.getFloat32(5))
print(b.getInt32(9))
print(b.getUInt16(13))
b.setFloat64(0, 0.1)
print(b.getFloat64(0))
let tail = b.slice(4, 5)
print(tail[0])
let sum = 0
for value in b { sum += value }
print(sum)
let chunk = Chunk { blocks: Bytes(16 * 16 * 16); name: "c" }
chunk.blocks[100] = 3
print(chunk.blocks[100])
let chunks: List<Chunk> = [chunk]
chunks[0].blocks[5] = 2
print(chunk.blocks[5])
writeBytesFile("build/conformance-bytes.bin", b)
let loaded = readBytesFile("build/conformance-bytes.bin")
print(loaded.length)
print(loaded.getUInt16(13))
b.clear()
print(b.length)
b.resize(3)
print(b[2])
let empty = Bytes()
empty.addBytes(loaded)
print(empty.length)
