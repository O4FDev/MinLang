record Node { value: Integer; children: List<Node> }
let leaf = Node { value: 1; children: [] }
let root = Node { value: 2; children: [leaf, leaf] }
let alias = root.children[1]
root = Node { value: 3; children: [] }
print(alias.value)
let children: List<Node> = []
children = children.appended(leaf)
children = children.appended(alias)
let built = Node { value: 4; children: children }
print(built.children.length)
print(built.children[1].value)
