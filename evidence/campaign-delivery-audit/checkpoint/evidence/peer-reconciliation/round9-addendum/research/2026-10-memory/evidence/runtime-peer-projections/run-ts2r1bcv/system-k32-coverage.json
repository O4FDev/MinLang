      "source": "record Limits { low: Integer; high: Integer }\nfunction limits(values: List<Integer>): Limits {\nreturn Limits { low: min(values[0], values[1]); high: max(values[0], values[1]) }\n}\nfunction inspect(first: Integer, second: Integer) {\nlet values = [first, second]\nlet alias = values\nlet saved = limits(values)\nalias[0] = 111\nalias[1] = 222\nprint(values[0])\nprint(values[1])\nvalues = []\nalias = []\nprint(saved.low)\nprint(saved.high)\n}\ninspect(0, 0)\ninspect(-7, -7)\ninspect(0, 1)\ninspect(1, 0)\ninspect(-9223372036854775808, 9223372036854775807)\ninspect(9223372036854775807, -9223372036854775808)\ninspect(-9223372036854775808, -9223372036854775808)\ninspect(9223372036854775807, 9223372036854775807)\n",
