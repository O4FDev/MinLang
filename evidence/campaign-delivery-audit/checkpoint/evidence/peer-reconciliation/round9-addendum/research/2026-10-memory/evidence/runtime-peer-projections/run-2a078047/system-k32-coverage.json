      "test": "__main__.PeerProjections.test_euclidean_remainder_composes_at_signed_boundaries",
      "source": "function euclid(left: Integer, right: Integer): Integer {\nlet a = abs(left)\nlet b = abs(right)\nwhile b != 0 {\nlet next = a % b\na = b\nb = next\n}\nreturn a\n}\nprint(euclid(0, 0))\nprint(euclid(0, -19))\nprint(euclid(-19, 0))\nprint(euclid(27, 36))\nprint(euclid(-27, 36))\nprint(euclid(27, -36))\nprint(euclid(-27, -36))\nprint(euclid(9223372036854775807, 9223372036854775806))\nprint(euclid(-9223372036854775806, 4611686018427387903))\nprint(euclid(-2147483648, 1234))\nprint(euclid(1234, -2147483648))\nprint(euclid(7540113804746346429, 4660046610375530309))\n",
