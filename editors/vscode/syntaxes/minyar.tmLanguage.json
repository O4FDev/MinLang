{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Minyar",
  "scopeName": "source.minyar",
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" }, { "include": "#strings" },
        { "name": "storage.type.function.minyar", "match": "\\bfunction\\b" },
        { "name": "entity.name.function.minyar", "match": "(?<=function)\\s+([A-Za-z_][A-Za-z_0-9]*(?:\\.[A-Za-z_][A-Za-z_0-9]*)?)", "captures": { "1": { "name": "entity.name.function.minyar" } } },
        { "match": "\\b(record|choice)\\s+([A-Za-z_][A-Za-z_0-9]*)(?=\\s*(?:<|\\{|native\\b))", "captures": { "1": { "name": "storage.type.minyar" }, "2": { "name": "entity.name.type.minyar" } } },
        { "match": "\\b(type)\\s+([A-Za-z_][A-Za-z_0-9]*)(?=\\s*=)", "captures": { "1": { "name": "storage.type.minyar" }, "2": { "name": "entity.name.type.minyar" } } },
        { "name": "keyword.control.test.minyar", "match": "\\btest\\b(?=\\s*\")" },
        { "name": "keyword.control.parallel.minyar", "match": "\\bparallel\\b(?=\\s+(?:public\\s+)?(?:function|for)\\b)" },
        { "name": "keyword.control.minyar", "match": "\\b(?:if|else|for|in|while|return|break|continue|match|try|use|as)\\b" },
        { "name": "storage.modifier.minyar", "match": "\\b(?:public|private|native|thread)\\b" },
        { "name": "storage.type.binding.minyar", "match": "\\b(?:let|constant|global)\\b" },
        { "name": "constant.language.minyar", "match": "\\b(?:true|false)\\b" },
        { "name": "support.type.minyar", "match": "\\b(?:Integer|Float|Boolean|Character|Text|Bytes|Nothing|List|Map|Set|Result|Maybe|Equatable|Ordered|Hashable)\\b" },
        { "name": "entity.name.type.minyar", "match": "\\b[A-Z][A-Za-z_0-9]*\\b" },
        { "name": "support.function.minyar", "match": "\\b(?:print|fail|exit|abs|min|max|clamp|joinText|expect|wrappingAdd|wrappingSubtract|wrappingMultiply)\\b(?=\\s*\\()" },
        { "name": "constant.numeric.minyar", "match": "\\b(?:0x[0-9A-Fa-f]+|0o[0-7]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\\b" },
        { "name": "keyword.operator.minyar", "match": "(?:->|\\.\\.|[+*/%=&|^!~<>-])" }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.minyar", "begin": "///", "end": "$" },
        { "name": "comment.line.double-slash.minyar", "begin": "//", "end": "$" },
        { "name": "comment.block.minyar", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.triple.raw.minyar", "begin": "#\"\"\"", "end": "\"\"\"#" },
        { "name": "string.quoted.double.raw.minyar", "begin": "#\"", "end": "\"#" },
        { "name": "string.quoted.triple.minyar", "begin": "\"\"\"", "end": "\"\"\"", "patterns": [{ "include": "#interpolation" }, { "include": "#escape" }] },
        { "name": "string.quoted.double.minyar", "begin": "\"", "end": "\"", "patterns": [{ "include": "#interpolation" }, { "include": "#escape" }] },
        { "name": "string.quoted.single.minyar", "begin": "'", "end": "'", "patterns": [{ "include": "#escape" }] }
      ]
    },
    "escape": { "name": "constant.character.escape.minyar", "match": "\\\\[\\s\\S]" },
    "interpolation": {
      "name": "meta.interpolation.minyar",
      "begin": "\\\\\\(", "end": "\\)",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.minyar" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.minyar" } },
      "patterns": [{ "include": "#parentheses" }, { "include": "#code" }]
    },
    "parentheses": { "begin": "\\(", "end": "\\)", "patterns": [{ "include": "#parentheses" }, { "include": "#code" }] }
  }
}
