{
  "name": "minyar",
  "displayName": "Minyar",
  "description": "Minyar source highlighting, formatting and language tools.",
  "version": "0.1.1",
  "publisher": "minyar-lang",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/O4FDev/MinLang.git", "directory": "editors/vscode" },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Programming Languages", "Formatters"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:minyar"],
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "contributes": {
    "languages": [{ "id": "minyar", "aliases": ["Minyar", "minyar"], "extensions": [".min"], "configuration": "./language-configuration.json" }],
    "grammars": [{ "language": "minyar", "scopeName": "source.minyar", "path": "./syntaxes/minyar.tmLanguage.json" }],
    "commands": [{ "command": "minyar.restartServer", "title": "Minyar: Restart Language Server" }],
    "configuration": {
      "title": "Minyar",
      "properties": {
        "minyar.executablePath": { "type": "string", "default": "minyar", "description": "Path to the Minyar command." },
        "minyar.libraryPaths": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Additional package source directories, relative to the workspace or absolute." }
      }
    }
  },
  "scripts": { "test": "node ./test/grammar.js && node ./test/client.js" },
  "dependencies": { "vscode-languageclient": "^10.1.2" },
  "devDependencies": { "vscode-textmate": "^9.3.2", "vscode-oniguruma": "^2.0.1" }
}
