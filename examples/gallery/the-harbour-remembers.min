use "simulation" as sea

// A lighthouse keeps what reached stable storage, even when the power fails.
let night = sea.create(20261020)
let lantern = sea.openFile(night, "/harbour/lantern", true)
sea.write(night, lantern, 0, Bytes("There is a light on the shore."))
sea.syncFile(night, lantern)
sea.syncDirectory(night, "/harbour")

let cloud = sea.submitWrite(night, lantern, 0, Bytes("Darkness"), 1)
let bell = sea.submitTimer(night, 100, 2)
sea.next(night)
sea.crash(night)

let remembered = sea.openFile(night, "/harbour/lantern", false)
print(Text(sea.read(night, remembered, 0, sea.size(night, remembered))))
print("The unfinished bell is quiet.")
