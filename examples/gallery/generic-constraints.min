// The same small tools work with measurements and with words.
function largest<Item: Ordered>(values: List<Item>, fallback: Item): Item {
    if values.length == 0 { return fallback }
    let ordered = values.sorted()
    return ordered[ordered.length - 1]
}

function counts<Item: Hashable>(values: List<Item>): Map<Item, Integer> {
    let counted: Map<Item, Integer> = Map()
    for value in values {
        if counted.has(value) { counted[value] += 1 }
        else { counted[value] = 1 }
    }
    return counted
}

print("highest tide: " + Text(largest([1.2, 2.7, 1.4], 0.0)) + " m")
let words = counts(["sea", "sky", "sea", "sky", "sea"])
print("sea: " + Text(words["sea"]))
print("sky: " + Text(words["sky"]))
