// A few clear names, one type for each value, and a light in every window.
record Window {
    place: Text
    lights: Integer
}

function Window.welcome(): Text {
    return "\(self.place): \(self.lights) small lights against the dark."
}

function evening(windows: List<Window>) {
    for window in windows { print(window.welcome()) }
}

evening([
    Window { place: "The harbour", lights: 3 },
    Window { place: "The hill", lights: 4 }
])
