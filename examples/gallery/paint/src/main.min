use "paint" as paint

let art = paint.canvas(640, 480)
paint.clear(art, paint.rgb(0x152c37))
paint.fillGradient(art, paint.circle(320.0, 240.0, 144.0),
    paint.linear(180.0, 100.0, 460.0, 380.0,
        paint.rgb(0xffdf9a), paint.rgb(0xc98970)))
paint.writePng(art, "first-light.png")
paint.writeSvg(art, "first-light.svg")
print("first light · paint v0.1.0 · 640 × 480")
