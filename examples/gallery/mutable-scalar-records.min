// A little care, repeated every morning.
record Seedling {
    day: Integer
    leaves: Integer
    flower: Boolean
}

function byTheWindow() {
    constant plant = Seedling { day: 0; leaves: 0; flower: false }
    while plant.day < 3 {
        plant.day += 1
        plant.leaves += 2
        print("Day \(plant.day): \(plant.leaves) leaves.")
    }
    plant.flower = true
    if plant.flower {
        print("One small flower, facing the sun.")
    }
}

byTheWindow()
