// After sunset, the coast answers one window at a time.
record Harbour {
    name: Text
    windows: List<Boolean>
}

function Harbour.welcome(): Text {
    let lights = 0
    for window in self.windows {
        if window { lights += 1 }
    }
    let reasons = "small reasons"
    if lights == 1 { reasons = "small reason" }
    return "\(self.name): \(lights) \(reasons) to keep coming."
}

function afterSunset(): List<Harbour> {
    return [
        Harbour { name: "The old harbour"; windows: [true, false, true] },
        Harbour { name: "The lighthouse"; windows: [true] },
        Harbour { name: "The village"; windows: [true, true, false, true] },
    ]
}

for harbour in afterSunset() {
    print(harbour.welcome())
}
print("Every lit window says: there is room for you here.")
