// A walk is made of small beginnings.
record Journey {
    steps: Integer
    shells: Integer
}

function alongTheShore(): Journey {
    let journey = Journey { steps: 0; shells: 0 }
    for morning in 0..4 {
        journey = Journey { shells: journey.shells + 1; steps: journey.steps + 3 }
    }
    return journey
}

function oneMore(journey: Journey): Journey {
    journey = Journey { steps: journey.steps + 3; shells: journey.shells + 1 }
    return journey
}

function remember(journey: Journey) {
    print("\(journey.steps) steps, \(journey.shells) small treasures.")
}

let firstWalk = alongTheShore()
let nextWalk = oneMore(firstWalk)
remember(firstWalk)
remember(nextWalk)
print("The sea keeps the rest.")
