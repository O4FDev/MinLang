// The wire format lives in read-only static storage, ready before main.
constant IPV4_VERSION = 4
constant IPV4_WORDS = 5
constant UDP_PROTOCOL = 17
constant HEADER = [(IPV4_VERSION << 4) | IPV4_WORDS, 0, 0, 28, 0, 0, 0, 0, 64, UDP_PROTOCOL, 0, 0]
constant ADDRESS = [192, 0, 2, 1]
constant PREFIX_BYTES = HEADER.length + ADDRESS.length * 2

record PacketPrefix native "c_packed" {
    data: Bytes[PREFIX_BYTES]
}

print("IPv4 version and header: " + Text(HEADER[0]))
print("Protocol: " + Text(HEADER[9]))
print("Prefix bytes: " + Text(sizeOf(PacketPrefix)))
print("Documentation address: " + Text(ADDRESS[0]) + "." + Text(ADDRESS[1]) + "." + Text(ADDRESS[2]) + "." + Text(ADDRESS[3]))
