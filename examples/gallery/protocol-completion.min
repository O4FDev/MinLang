use "protocol" as protocol

record Account { owner: Text; balance: Integer }

function commit(account: Account, completion: protocol.Completion, amount: Integer) {
    account.balance += amount
    protocol.complete(completion)
    print(account.owner + ": committed " + Text(amount))
}

function rollback(account: Account, completion: protocol.Completion) {
    protocol.complete(completion)
    print(account.owner + ": rolled back")
}

function deposit(account: Account, amount: Integer, approved: Boolean) {
    let completion = protocol.begin()
    if approved {
        commit(account, completion, amount)
    } else {
        rollback(account, completion)
    }
}

let account = Account { owner: "Ada"; balance: 100 }
deposit(account, 25, true)
deposit(account, 40, false)
print("Balance: " + Text(account.balance))
