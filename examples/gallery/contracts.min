record Lighthouse {
    name: Text
    light: Integer
}

function Lighthouse.share(windows: Integer): Integer
    requires(windows > 0)
    requires(windows <= self.light)
    invariant(self.light >= 0)
    ensures(result == windows) {
    self.light -= windows
    return windows
}

let lighthouse = Lighthouse { name: "North Star"; light: 10 }
print(lighthouse.name + " lends " + Text(lighthouse.share(3)) + " lights to the harbour.")
print(lighthouse.name + " lends " + Text(lighthouse.share(2)) + " lights to the village.")
print(Text(lighthouse.light) + " lights remain for the way home.")
