record Star {
    name: Text
    depth: Integer
}

function trace(star: Star, width: Integer): Text {
    let line = star.name
    for step in 0..width {
        if step < star.depth {
            line += " ·"
        } else {
            line += " ✦"
        }
    }
    return line
}

let stars = [
    Star { name: "Sirius"; depth: 1 },
    Star { name: "Vega"; depth: 3 },
    Star { name: "Polaris"; depth: 4 },
]

let position = 0
while position < stars.length {
    print(trace(stars[position], 4))
    position += 1
}
