let hour = "midnight"
let lanterns = ["amber", "silver", "blue"]

print("""
    At \(hour), the little harbour keeps its light.
    Each window borrows a colour from the sea:
    """)
for index in 0..lanterns.length {
    print("  \(index + 1). One \(lanterns[index]) lantern, a window in the night.")
}
print("""
    \(lanterns.length) small promises:
        someone will come home.
    """)
