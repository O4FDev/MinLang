// Leave room for what the tide brings.
record Treasure { words: Text }

function gather() {
    let basket: List<Treasure> = []
    let shell = Treasure { words: "A shell for the windowsill." }
    basket.add(shell)

    let feather = Treasure { words: "A feather for the book." }
    basket.add(feather)

    let light = Treasure { words: "A little light to carry home." }
    basket.add(light)
    for treasure in basket { print(treasure.words) }
}

gather()
