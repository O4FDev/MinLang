// A little world with its own memory. In a project, run --watch --hot and edit
// the words in greeting(): later calls change while the lanterns keep counting.
record Lantern { name: Text; evenings: Integer }
global LANTERNS: List<Lantern> = [
    Lantern { name: "Ada"; evenings: 0 },
    Lantern { name: "Lin"; evenings: 0 }
]
function greeting(lantern: Lantern): Text {
    return lantern.name + " keeps a light for evening " + Text(lantern.evenings)
}
function evening() {
    for lantern in LANTERNS {
        lantern.evenings += 1
        print(greeting(lantern))
    }
}
evening()
evening()
