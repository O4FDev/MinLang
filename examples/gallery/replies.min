use "http" as http
use "errors" as errors

function weather(reply: http.Reply): Result<Text, errors.Error> {
    let letter = try reply.json() else "opening the weather station's letter"
    let harbour = try letter.get("harbour").andThen(function(value) { return value.asText() })
    let temperature = try letter.get("temperature").andThen(function(value) { return value.asInteger() }) else "reading the temperature"
    return Ok("At \(harbour), the air is \(temperature) degrees.")
}

for temperature in ["14", "\"warm\""] {
    let reply = http.Reply {
        status: 200
        reason: "OK"
        headers: []
        body: Bytes("{\"harbour\":\"St Ives\",\"temperature\":\(temperature)}")
    }
    print(weather(reply).unwrapOrElse(function(error) { return error.describe() }))
}
