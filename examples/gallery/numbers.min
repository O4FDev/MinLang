use "json" as json

// A number keeps its meaning, however quietly it arrives.
record Reading { name: Text; spelling: Text }
let readings = [
    Reading { name: "a tide"; spelling: "0.29" },
    Reading { name: "a spark"; spelling: "5e-324" },
    Reading { name: "a silence"; spelling: "-0e9999" }
]
for reading in readings {
    let number = json.decode(reading.spelling).unwrap().asNumber().unwrap()
    print(reading.name + ": " + Text(number))
}
