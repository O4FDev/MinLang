use "paint" as paint
use "math" as math
use "process" as processInfo

choice Atmosphere {
    Dawn
    Dusk
    Night
}

record Palette { paper: paint.Color; inks: List<paint.Color> }

function choose<Item>(items: List<Item>, index: Integer): Item {
    return items[index % items.length]
}

function Palette.ink(index: Integer): paint.Color {
    return choose(self.inks, index)
}

function palette(atmosphere: Atmosphere): Palette {
    match atmosphere {
        Dawn { return Palette { paper: paint.rgb(0xeadfcd); inks: [paint.rgb(0x334e5a), paint.rgb(0xc78469), paint.rgb(0xa7b7a2), paint.rgb(0x50696c)] } }
        Dusk { return Palette { paper: paint.rgb(0x303c4a); inks: [paint.rgb(0xe7bd92), paint.rgb(0xb18c9c), paint.rgb(0x88a4a5), paint.rgb(0xece0c9)] } }
        Night { return Palette { paper: paint.rgb(0x152f3b); inks: [paint.rgb(0xf0cf99), paint.rgb(0xc78b7b), paint.rgb(0x8fb4b4), paint.rgb(0xece3cd)] } }
    }
}

function orbit(x: Float, y: Float, width: Float, height: Float, turn: Float, start: Float, end: Float): paint.Path {
    let path = paint.path()
    let cosine = math.cos(turn)
    let sine = math.sin(turn)
    for step in 0..121 {
        let angle = start + (end - start) * Float(step) / 120.0
        let horizontal = width * math.cos(angle)
        let vertical = height * math.sin(angle)
        let px = x + horizontal * cosine - vertical * sine
        let py = y + horizontal * sine + vertical * cosine
        if step == 0 { paint.moveTo(path, px, py) }
        else { paint.lineTo(path, px, py) }
    }
    return path
}

if processInfo.argumentCount() != 1 { fail("Choose a TrueType font: minyar run -- '/path/to/font.ttf'") }
let font = paint.loadFont(processInfo.argument(0))
let ink = palette(Atmosphere.Night)
let art = paint.canvas(960, 720)
paint.clear(art, paint.rgb(0xf0e9da))
paint.fill(art, paint.rectangle(28.0, 28.0, 904.0, 664.0), ink.paper)

paint.text(art, font, "A small observatory", 82.0, 126.0, 72.0, ink.ink(0))
paint.text(art, font, "a field guide to the quiet work of light", 86.0, 161.0, 23.0, paint.opacity(ink.ink(3), 0.66))

for index in 0..62 {
    let x = 80.0 + Float((index * 173 + 43) % 800)
    let y = 196.0 + Float((index * 97 + 53) % 360)
    let size = 0.7
    if index % 13 == 0 { size = 1.8 }
    paint.fill(art, paint.circle(x, y, size), paint.opacity(ink.ink(3), 0.28 + Float(index % 5) * 0.1))
}

let fullTurn = 6.283185307179586
for ring in 0..5 {
    let width = 130.0 + Float(ring) * 52.0
    let height = 42.0 + Float(ring) * 18.0
    paint.stroke(art, orbit(560.0, 392.0, width, height, -0.26, 0.0, fullTurn), 0.8, paint.opacity(ink.ink(ring), 0.40))
}

paint.fill(art, paint.circle(560.0, 392.0, 121.0), paint.opacity(ink.ink(2), 0.09))
paint.fillGradient(art, paint.circle(560.0, 392.0, 103.0),
    paint.linear(485.0, 300.0, 636.0, 490.0, ink.ink(0), ink.ink(1)))

for ring in 0..5 {
    let width = 130.0 + Float(ring) * 52.0
    let height = 42.0 + Float(ring) * 18.0
    paint.stroke(art, orbit(560.0, 392.0, width, height, -0.26, 0.0, fullTurn / 2.0), 1.05, paint.opacity(ink.ink(ring), 0.76))
}

paint.fillGradient(art, paint.circle(806.0, 366.0, 14.0),
    paint.linear(793.0, 352.0, 819.0, 379.0, ink.ink(3), ink.ink(2)))
paint.fillGradient(art, paint.circle(278.0, 444.0, 24.0),
    paint.linear(260.0, 424.0, 299.0, 466.0, ink.ink(1), ink.ink(0)))

let constellation = paint.path()
let starXs = [123.0, 177.0, 205.0, 150.0]
let starYs = [290.0, 264.0, 332.0, 378.0]
for index in 0..starXs.length {
    if index == 0 { paint.moveTo(constellation, starXs[index], starYs[index]) }
    else { paint.lineTo(constellation, starXs[index], starYs[index]) }
}
paint.stroke(art, constellation, 0.7, paint.opacity(ink.ink(2), 0.50))
for index in 0..starXs.length {
    paint.fill(art, paint.circle(starXs[index], starYs[index], 2.4), ink.ink(0))
}

for wave in 0..4 {
    let level = 566.0 + Float(wave) * 11.0
    let path = paint.path()
    paint.moveTo(path, 82.0, level)
    paint.cubicTo(path, 240.0, level - 32.0, 348.0, level + 36.0, 510.0, level + 8.0)
    paint.cubicTo(path, 665.0, level - 20.0, 770.0, level + 18.0, 878.0, level - 10.0)
    paint.stroke(art, path, 0.8, paint.opacity(ink.ink(2), 0.24 + Float(wave) * 0.06))
}

paint.text(art, font, "LIGHT IS A KIND OF LANGUAGE", 85.0, 653.0, 15.0, paint.opacity(ink.ink(3), 0.78))
paint.text(art, font, "MINYAR / PAINT     001", 674.0, 653.0, 15.0, paint.opacity(ink.ink(0), 0.78))
paint.writePng(art, "observatory.png")
paint.writeSvg(art, "observatory.svg")
print("observatory · paint v0.1.0 · \(art.width) × \(art.height)")
