// A sentence is a tree. Read its leaves from left to right.
choice Poem {
    Word(text: Text)
    Beside(left: Poem, right: Poem)
    Silence
}

function read(poem: Poem): Text {
    return match poem {
        Word(text) { text }
        Beside(left, right) { read(left) + read(right) }
        Silence { "" }
    }
}

let night = Beside(
    Word("the moon "),
    Beside(Word("keeps "), Word("a little light"))
)
let light: Maybe<Poem> = Some(night)
print(match light { Some(poem) { read(poem) } None { "silence" } })
