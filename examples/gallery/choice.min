// A sentence is a tree. Read its leaves from left to right.
choice Poem {
    Word(text: Text)
    Beside(left: Poem, right: Poem)
    Silence
}

function read(poem: Poem): Text {
    match poem {
        Word(text) { return text }
        Beside(left, right) { return read(left) + read(right) }
        Silence { return "" }
    }
}

let night = Beside(
    Word("the moon "),
    Beside(Word("keeps "), Word("a little light"))
)
print(read(night))
