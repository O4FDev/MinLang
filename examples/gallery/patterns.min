// Every window has a story. Listen for the light inside it.
choice Light {
    Flame(colour: Text, strength: Integer)
    Ember
    Dark
}

function listen(window: Result<Maybe<Light>, Text>): Text {
    return match window {
        Ok(Some(Flame("amber", strength))) where strength > 0 {
            "the harbour keeps an amber light"
        }
        Ok(Some(Flame(colour, strength))) where strength > 0 {
            "a " + colour + " light answers the sea"
        }
        Ok(Some(Flame(_, _))) { "a wick is waiting for a spark" }
        Ok(Some(Ember)) { "a little warmth remembers the fire" }
        Ok(Some(Dark)) { "the stars can take their turn" }
        Ok(None) { "an empty window, open to the moon" }
        Err(reason) { "we will try again at dawn: " + reason }
    }
}

let windows: List<Result<Maybe<Light>, Text>> = [
    Ok(Some(Flame("amber", 3))),
    Ok(Some(Flame("blue", 1))),
    Ok(Some(Flame("amber", 0))),
    Ok(Some(Ember)),
    Ok(Some(Dark)),
    Ok(None),
    Err("the tide has taken the path")
]
for window in windows { print(listen(window)) }
