// A good proofreader leaves a light on, and a way home.
record Window {
    place: Text
    light: Boolean
}

function portrait(window: Window): Text {
    if window.light {
        return "\(window.place): a light to come home to."
    }
    return "\(window.place): the stars have the night to themselves."
}

let coast = [
    Window { place: "The harbour"; light: true },
    Window { place: "The lighthouse"; light: false },
]
for window in coast {
    print(portrait(window))
}
