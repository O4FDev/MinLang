// Two colours of one evening, woven together.
function weave<Item>(first: List<Item>, second: List<Item>): List<Item> {
    let woven: List<Item> = []
    let position = 0
    while position < first.length || position < second.length {
        if position < first.length { woven.add(first[position]) }
        if position < second.length { woven.add(second[position]) }
        position += 1
    }
    return woven
}

let sky = ["sky: pale blue", "sky: turning rose"]
let sea = ["sea: silver", "sea: quiet gold"]
for colour in weave(sky, sea) { print(colour) }
