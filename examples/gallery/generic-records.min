// A small tide table, pairing each moment with the water's height.
record Pair<First, Second> {
    first: First
    second: Second
}

function zip<First, Second>(first: List<First>, second: List<Second>): List<Pair<First, Second>> {
    let pairs: List<Pair<First, Second>> = []
    let position = 0
    while position < first.length && position < second.length {
        pairs.add(Pair { first: first[position]; second: second[position] })
        position += 1
    }
    return pairs
}

let moments = ["dawn", "noon", "dusk"]
let heights = [1.2, 2.7, 1.4]
for reading in zip(moments, heights) {
    print(reading.first + ": " + Text(reading.second) + " m")
}
