// A lantern remembers the way through the sleeping town.
choice Direction { North; East; South; West }
choice Sign {
    Turn(direction: Direction)
    Lantern(window: Text)
    Home
}

function road(direction: Direction): Text {
    return match direction {
        North { "the hill" }
        East { "the river" }
        South { "the orchard" }
        West { "the sea" }
    }
}

let walk = [Turn(East), Lantern("the baker"), Turn(North), Lantern("the poet"), Home]
for sign in walk {
    match sign {
        Turn(direction) { print("follow " + road(direction)) }
        Lantern(window) { print("a little light for " + window) }
        Home { print("leave the last light on for home") }
    }
}
