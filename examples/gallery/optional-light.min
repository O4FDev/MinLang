function welcome(name: Maybe<Text>): Text {
    let known = name.filter(function(value) { return value.length > 0 })
    let greeting = known.map(function(value) { return "Welcome home, \(value)." })
    return greeting.unwrapOr("There is a light for every traveller.")
}

let familiar: Maybe<Text> = Some("Ada")
let stranger: Maybe<Text> = None
print(welcome(familiar))
print(welcome(stranger))

let harbour: Result<Text, Text> = Err("the harbour is sleeping")
let lighthouse = harbour.orElse(function(reason): Result<Text, Text> {
    return Ok("The lighthouse is awake.")
})
print(lighthouse.unwrapOr("Follow the stars."))
