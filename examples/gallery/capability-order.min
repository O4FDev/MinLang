// The windows have names. The evening has its own order.
record Lantern {
    window: Text
    hour: Integer
}

function Lantern.compare(other: Lantern): Integer {
    if self.hour < other.hour { return -1 }
    if self.hour > other.hour { return 1 }
    return 0
}

conform Lantern to Ordered

let windows = [
    Lantern { window: "harbour"; hour: 3 },
    Lantern { window: "garden"; hour: 1 },
    Lantern { window: "hill"; hour: 2 }
]

print("When the evening comes:")
for lantern in windows.sorted() {
    print("the " + lantern.window + " window")
}
print("Each light has its own time.")
