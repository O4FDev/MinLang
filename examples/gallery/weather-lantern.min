choice Weather {
    Clear
    Rain(drops: Integer)
}

record Lantern { place: Text }

function Lantern.welcome(weather: Weather): Text {
    match weather {
        Clear { return "\(self.place): the stars have room to shine." }
        Rain(drops) { return "\(self.place): \(drops) drops, and one warm window." }
    }
}

let lantern = Lantern { place: "The harbour" }
print(lantern.welcome(Weather.Clear))
print(lantern.welcome(Weather.Rain(3)))
