// A shared welcome, with room for each voice.
capability Welcoming {
    function name(): Text

    function welcome(): Text {
        return "There is a place for " + self.name() + "."
    }
}

record Traveller { name: Text }
record Lighthouse { name: Text }

function Traveller.name(): Text { return self.name }
function Lighthouse.name(): Text { return self.name }

function Lighthouse.welcome(): Text {
    return "The lantern is lit for " + self.name() + "."
}

conform Traveller to Welcoming
conform Lighthouse to Welcoming

function welcome<Guest: Welcoming>(guest: Guest) {
    print(guest.welcome())
}

print("At the edge of the evening")
welcome(Traveller { name: "the traveller" })
welcome(Lighthouse { name: "the last boat" })
