use "json" as json
use "errors" as errors

function welcome(source: Text): Result<Text, errors.Error> {
    let document = try json.decode(source) else "reading the harbour's configuration"
    let name = try document.get("name").andThen(function(value) {
        return value.asText()
    }) else "reading the harbour's name"
    let port = try document.get("port").andThen(function(value) {
        return value.asInteger()
    }) else "reading the harbour's port"
    return Ok("\(name) is listening on \(port).")
}

for source in [
    #"{"name":"Starlight","port":8080}"#,
    #"{"name":"Starlight","port":"the moon"}"#,
    #"{"port":8080}"#
] {
    print(welcome(source).unwrapOrElse(function(error) {
        return error.withContext("Opening the harbour").describe()
    }))
}
