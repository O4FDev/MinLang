// Familiar names for concrete shapes, with the same types underneath.
record Seed<Item> {
    name: Text
    value: Item
}

type SeedPacket = Seed<Integer>
type Garden = List<SeedPacket>

function planting(garden: Garden) {
    print("a little garden")
    for packet in garden {
        print(packet.name + ": " + Text(packet.value) + " seeds")
    }
}

let garden: Garden = [
    SeedPacket { name: "marigold"; value: 12 },
    SeedPacket { name: "cornflower"; value: 8 },
    SeedPacket { name: "sweet pea"; value: 6 }
]
planting(garden)
