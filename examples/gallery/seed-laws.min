use "property" as seeds
use "text" as text

function total(values: List<Integer>): Integer {
    let sum = 0
    for value in values { sum += value }
    return sum
}

test "every seed has a place on the shelf" {
    property "sorting keeps the harvest" for harvest in seeds.lists(seeds.integers(-1000, 1000), 40) {
        let shelf = harvest.sorted()
        expect(shelf.length == harvest.length)
        expect(total(shelf) == total(harvest))
        let again = shelf.sorted()
        for index in 0..shelf.length { expect(again[index] == shelf[index]) }
        for index in 1..shelf.length { expect(shelf[index - 1] <= shelf[index]) }
    }
    property "a number remembers its name" for seed in seeds.integers(-9223372036854775807 - 1, 9223372036854775807) {
        match text.integer(Text(seed)) {
            Ok(read) { expect(read == seed) }
            Err(error) { expect(false) }
        }
    }
    property "letters survive the journey" for name in seeds.texts(40) {
        expect(text.validUTF8(Bytes(name)))
        expect(Text(Bytes(name)) == name)
    }
}

bench "sorting a small harvest" {
    let harvest = [17, -3, 42, 0, 8, 5, -9, 21]
    let shelf = harvest.sorted()
    if shelf.length != 8 || shelf[0] != -9 || shelf[7] != 42 { fail("the harvest was lost") }
}

print("Every seed has a place; every name finds its way home.")
