record Account {
    owner: Text
    balance: Integer
}

function open(owner: Text): Account {
    return Account { owner: owner; balance: 0 }
}

function Account.deposit(amount: Integer) {
    self.balance += amount
}

function Account.give(amount: Integer, friend: Account) {
    self.balance -= amount
    friend.deposit(amount)
}

function Account.tell() {
    print(self.owner + " has " + Text(self.balance) + " seeds.")
}

let ada = open("Ada")
let grace = open("Grace")
ada.deposit(12)
ada.give(5, grace)
ada.tell()
grace.tell()
let gardeners: Set<Text> = Set()
gardeners.add(ada.owner)
gardeners.add(grace.owner)
print(Text(gardeners.length) + " gardeners, one shared garden.")
print("A garden grows when we share.")
