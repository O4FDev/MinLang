use "errors" as errors

record Tide {
    moment: Text
    height: Float
}

function reading(moment: Text, height: Float): errors.ValueResult<Tide> {
    let tide = Tide { moment: moment; height: height }
    if height < 0.0 {
        return errors.failure(tide, errors.make(errors.invalidDataCode(), 0, "the tide gauge needs a gentle reset"))
    }
    return errors.success(tide)
}

for result in [reading("dawn", 1.2), reading("noon", -1.0), reading("dusk", 1.4)] {
    if errors.ok(result) {
        let tide = errors.value(result)
        print(tide.moment + ": " + Text(tide.height) + " m")
    } else {
        print(errors.message(errors.error(result)))
    }
}
