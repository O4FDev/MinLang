// A letter can carry a whole morning in two lines.
record Letter { to: Text; words: List<Text> }
choice Post { Sealed(letter: Letter) }
record Mailbox { letters: List<Post>; next: Integer }

function receive(mailbox: Mailbox): Maybe<Post> {
    if mailbox.next >= mailbox.letters.length { return None }
    let letter = mailbox.letters[mailbox.next]
    mailbox.next += 1
    return Some(letter)
}

let letters = [
    Sealed(Letter { to: "the harbour"; words: ["keep one light for the boats", "and one for those still dreaming"] }),
    Sealed(Letter { to: "the morning"; words: ["bring the sea its silver", "and leave the windows open"] })
]
let Sealed(Letter(first, _)) = letters[0]
print("the first letter is for " + first)
let mailbox = Mailbox { letters: letters; next: 0 }
while receive(mailbox) is Some(Sealed(Letter(to, words))) {
    print("to " + to + ",")
    for line in words { print(line) }
}
if receive(mailbox) is None { print("the rest is a little silence") }
