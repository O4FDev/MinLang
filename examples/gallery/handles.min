use "handles" as handles

record Window { title: Text }
let windows: handles.Pool<Window> = handles.create<Window>()
let morning = handles.insert(windows, Window { title: "Morning light" })
let delayedClick = morning
handles.remove(windows, morning)
let evening = handles.insert(windows, Window { title: "Evening stars" })

match handles.get(windows, delayedClick) {
    Some(window) { print(window.title) }
    None { print("The old window has closed.") }
}
match handles.get(windows, evening) {
    Some(window) { print(window.title) }
    None { print("The sky is quiet.") }
}
