use "sequence" as sequence

function lantern(number: Integer): Text {
    return "a light in window " + Text(number)
}

function stillAwake(number: Integer): Boolean {
    return number % 2 == 1
}

let evening = sequence.range(1, 8).filter(stillAwake).map(lantern)
print("The town settles into evening.")
for light in evening {
    print("There is " + light + ".")
}
