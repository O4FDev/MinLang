record Star { name: Text; brightness: Float }
record Branch { name: Text; children: List<Branch> }
record Reading { degrees: Float; count: Integer; lit: Boolean; marker: Character }
choice Sky {
    Clear
    Clouded(cover: Float)
}

function watch() {
    let message = "A quiet sky 🌙"
    let star = Star { name: "Sirius"; brightness: 1.5 }
    let stars = [star]
    let windows = [10, 20, 30]
    let lights = [true, false, true]
    let letters = ['λ', '星']
    let readings = [1.25, 2.5]
    let visitors = Map<Text, Integer>()
    visitors["Ada"] = 42
    let sky = Clouded(0.25)
    let branch = Branch { name: "north"; children: [] }
    let bytes = Bytes("sky")
    let reading = Reading { degrees: 2.5; count: 7; lit: true; marker: 'λ' }
    print(message) // debugger pause: every value is initialized and still used
    print(stars[0].name)
    print(windows[2])
    print(lights[1])
    print(letters[1])
    print(readings[1])
    print(visitors["Ada"])
    match sky {
        Clear { print("Clear") }
        Clouded(cover) { print(cover) }
    }
    print(branch.name)
    print(bytes.length)
    print(reading.degrees)
    print(reading.count)
    print(reading.lit)
    print(reading.marker)
}

watch()
