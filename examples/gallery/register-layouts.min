// A named hardware layout emits scalar operations without descriptor objects.
constant DISTANCE_FIRST = 12
record Control native "register32" {
    enabled: Integer at(1, 1)
    threshold: Integer at(4, 8)
    distance: Integer at(DISTANCE_FIRST, 10)
}

let control = encodeField(Control, "enabled", 1) |
    encodeField(Control, "threshold", 15) |
    encodeField(Control, "distance", 64)
print("transmitter enabled: " + Text(extractField(Control, "enabled", control) == 1))
print("collision threshold: " + Text(extractField(Control, "threshold", control)))
print("collision distance: " + Text(extractField(Control, "distance", control)))
