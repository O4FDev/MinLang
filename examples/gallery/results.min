use "errors" as errors
use "text" as text

function port(source: Text): Result<Integer, errors.Error> {
    let value = try text.integer(source)
    if value < 1 || value > 65535 {
        return Err(errors.make(errors.invalidDataCode(), 0, "choose a port from 1 to 65535"))
    }
    return Ok(value)
}

function lantern(source: Text): Result<Text, errors.Error> {
    let number = try port(source) else "reading the lantern's port"
    return Ok("The lantern is listening on \(number).")
}

for source in ["8080", "starlight", "70000"] {
    print(lantern(source).unwrapOrElse(function(error) {
        return error.withContext("Lighting the harbour").describe()
    }))
}
