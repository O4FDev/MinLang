/// A C header lends us a small light for the journey home.
use "../../build/c-import/gallery.min" as harbour

let shore = harbour.LanternPoint { east: 3; north: 4 }
let light = harbour.lantern_measure(shore, 42.0)
let window = harbour.lantern_echo(light)

print("The harbour leaves a light for you.")
print("\(light.place.east) steps east, \(light.place.north) steps north.")
print("One warm window: \(window.glow).")
print("The shore keeps its own light: \(light.glow).")
