// The same little model lives behind the native iPhone application.
use "../mobile-hello/model.min" as garden

let window = garden.create()
print(garden.greeting(window))
garden.update(window, "light", "", false)
garden.update(window, "light", "", false)
print(garden.lights(window))
garden.update(window, "name", "Zoë 🌕", false)
print(garden.greeting(window))
garden.update(window, "welcome", "", false)
print(garden.greeting(window))
garden.update(window, "welcome", "", true)
print(garden.greeting(window))
