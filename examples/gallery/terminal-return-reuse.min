// A letter needs only a few good lines.
function heading(place: Text): Text {
    let words = "A letter " + "from "
    return words + place
}

function byTheWindow(): List<Text> {
    let lines = [
        "The boats are sleeping.",
        "The kettle is warm.",
    ]
    return lines.appended("There is a chair by the window.")
}

function signed(lines: List<Text>): List<Text> {
    let letter = lines
    return letter.appended("Come home when you are ready.")
}

print(heading("the coast"))
let pages = byTheWindow()
let letter = signed(pages)
for line in letter {
    print(line)
}
