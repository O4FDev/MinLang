// A network controller speaks in fields. Give each one a place and a width.
use "device" as device

let enabled = device.field32(1, 1)
let collisionThreshold = device.field32(4, 8)
let collisionDistance = device.field32(12, 10)
let control = device.encode32(enabled, 1) |
    device.encode32(collisionThreshold, 15) |
    device.encode32(collisionDistance, 64)

print("transmitter enabled: " + Text(device.extract32(enabled, control) == 1))
print("collision threshold: " + Text(device.extract32(collisionThreshold, control)))
print("collision distance: " + Text(device.extract32(collisionDistance, control)))
