use "./engine.min" as trail
use "./input.min" as input
use "io" as io
use "process" as process
use "system" as system

function usage() {
    print("Usage: lantern-trail [--help | --replay FILE]")
    print("With no arguments, play using one command per input line.")
    print("Replay files contain the same commands; at most 65536 bytes.")
    print(trail.controls())
}

function problem(message: Text): Integer {
    system.writeStandardError("lantern-trail: \(message)\n")
    return 2
}

function welcome(game: trail.Game) {
    print("Lantern Trail")
    print("Bring both lanterns to the gate before your energy runs out.")
    print(trail.controls())
    print(game.board())
    print(game.status())
}

function play(game: trail.Game, line: Text): trail.Game {
    let turn = game.act(trail.command(line))
    print(turn.message)
    if turn.draw { print(turn.game.board()) }
    print(turn.game.status())
    return turn.game
}

function replay(path: Text): Integer {
    let contents = Bytes()
    match io.readBytesWithin(path, 65536) {
        Ok(bytes) { contents = bytes }
        Err(error) { return problem("cannot read replay file (limit 65536 bytes).") }
    }
    let game = trail.start()
    welcome(game)
    let first = 0
    for index in 0..contents.length {
        if contents[index] == 10 {
            let line = input.commandText(contents.slice(first, index))
            print("> \(line)")
            game = play(game, line)
            first = index + 1
            if game.left() { break }
        }
    }
    if !game.left() && first < contents.length {
        let line = input.commandText(contents.slice(first, contents.length))
        print("> \(line)")
        game = play(game, line)
    }
    if game.exploring() { return problem("replay ended before rescue; add commands or quit.") }
    return game.exitStatus()
}

function interactive(): Integer {
    let game = trail.start()
    welcome(game)
    while !game.left() {
        match input.readLine() {
            Ready(line) { game = play(game, line) }
            End { print("End of input. Goodbye."); return game.exitStatus() }
            Unreadable { return problem("could not read standard input.") }
        }
    }
    return game.exitStatus()
}

function main(): Integer {
    let count = process.argumentCount()
    if count == 0 { return interactive() }
    if count == 1 && process.argument(0) == "--help" { usage(); return 0 }
    if count == 2 && process.argument(0) == "--replay" {
        if process.argument(1) == "" { return problem("--replay needs a file path.") }
        return replay(process.argument(1))
    }
    return problem("expected --help or --replay FILE. Use --help for controls.")
}
