public choice Line {
    Ready(value: Text)
    End
    Unreadable
}

function nextByte(): Integer { native "trailinput" }
function prompt() { native "trailinput" }

// Only command words are accepted. Invalid UTF-8/control bytes never reach a
// fatal Text conversion, and an overlong line is drained before the next read.
public function commandText(bytes: Bytes): Text {
    let after = bytes.length
    if after > 0 && bytes[after - 1] == 13 { after -= 1 }
    if after > 128 { return "[command exceeds 128 bytes]" }
    for index in 0..after {
        let byte = bytes[index]
        if byte != 9 && (byte < 32 || byte > 126) {
            return "[command must be ASCII text]"
        }
    }
    return Text(bytes.slice(0, after))
}

public function readLine(): Line {
    prompt()
    let bytes = Bytes()
    let overlong = false
    while true {
        let byte = nextByte()
        if byte == -2 { return Unreadable }
        if byte == -1 {
            if bytes.length == 0 && !overlong { return End }
            break
        }
        if byte == 10 { break }
        if bytes.length < 129 { bytes.add(byte) } else { overlong = true }
    }
    if overlong { return Ready("[command exceeds 128 bytes]") }
    return Ready(commandText(bytes))
}
