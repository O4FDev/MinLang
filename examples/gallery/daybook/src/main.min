use "./ledger.min" as daybook
use "errors" as errors
use "io" as io
use "process" as processInfo
use "system" as system

choice Command {
    Help
    Summarize(paths: List<Text>, asJson: Boolean)
}

function arguments(): Result<Command, errors.Error> {
    let paths: List<Text> = []
    let asJson = false
    let options = true
    for index in 0..processInfo.argumentCount() {
        let argument = processInfo.argument(index)
        if options && (argument == "--help" || argument == "-h") { return Ok(Command.Help) }
        if options && argument == "--json" { asJson = true }
        else if options && argument == "--" { options = false }
        else if options && argument.length > 0 && argument[0] == '-' {
            return Err(errors.make(errors.invalidDataCode(), 0, "unknown option: " + argument))
        } else { paths.add(argument) }
    }
    if paths.length == 0 { return Err(errors.make(errors.invalidDataCode(), 0, "choose at least one .tsv file; use --help for an example")) }
    if paths.length > 64 { return Err(errors.make(errors.invalidDataCode(), 0, "choose at most 64 files")) }
    return Ok(Command.Summarize(paths, asJson))
}

function summarize(paths: List<Text>, asJson: Boolean): Result<Text, errors.Error> {
    let book = daybook.ledger()
    for path in paths {
        let source = try io.readTextWithin(path, 4194304) else ("opening " + path + " (at most 4 MiB)")
        try book.read(source) else ("reading " + path)
    }
    if asJson { return Ok(book.asJson()) }
    return Ok(book.table())
}

function help() {
    print("""
        Daybook — see where the day went.

        usage: daybook [--json] [--] FILE.tsv [FILE.tsv ...]

        Each row contains a project, a tab, and whole minutes:
        Garden	45
        Writing	30
        Garden	15

        Blank lines and # comments are ignored. Names are case sensitive.
        Files are UTF-8, at most 4 MiB each. No partial report is printed.
        --json  Print sorted, machine-readable totals.
        --help  Show this guide.
        """)
}

function main(): Integer {
    match arguments() {
        Ok(command) {
            match command {
                Help { help(); return 0 }
                Summarize(paths, asJson) {
                    match summarize(paths, asJson) {
                        Ok(report) { print(report); return 0 }
                        Err(error) { system.writeStandardError("daybook: " + error.describe() + "\n"); return 1 }
                    }
                }
            }
        }
        Err(error) { system.writeStandardError("daybook: " + error.describe() + "\n"); return 2 }
    }
}
