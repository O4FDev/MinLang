record Seed {
    flower: Text
    season: Integer
}

let spring = Seed { flower: "Aster"; season: 1 }
let summer = Seed { flower: "Aster"; season: 2 }
let rose = Seed { flower: "Rose"; season: 1 }
let basket = [rose, summer, spring]

print("A place for every flower:")
for seed in basket.sorted() {
    print(seed.flower + ", season " + Text(seed.season))
}

let anotherSpring = Seed { flower: "Aster"; season: 1 }
if spring == anotherSpring {
    print("Different packets, the same promise.")
}
