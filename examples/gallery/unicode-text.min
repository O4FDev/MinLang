use "unicode" as text

print("Names on the same door:")
for name in ["Café", "👩🏽‍🚀", "🇬🇧"] {
    let count = text.graphemeCount(name)
    let unit = "characters"
    if count == 1 { unit = "character" }
    print("  \(text.normalized(name)) · \(count) \(unit)")
}

let family = "👩‍👩‍👧‍👦"
print("A family stays together: \(text.graphemes(family)[0])")
print("Two ways to write Café, one welcome: \(text.canonicallyEqual("Café", "Café"))")
print("Straße and STRASSE meet here: \(text.caselessEqual("Straße", "STRASSE"))")
