record Seed {
    flower: Text
    season: Integer
}

let shared: Set<Seed> = Set()
let asters = Seed { flower: "Aster"; season: 1 }
shared.add(asters)
shared.add(Seed { flower: "Aster"; season: 1 })
shared.add(Seed { flower: "Rose"; season: 2 })

let shelves: Map<Seed, Text> = Map()
shelves[asters] = "the sunny windowsill"
print("Our seed library has " + Text(shared.length) + " promises.")
for seed in shared {
    if shelves.has(seed) {
        print(seed.flower + " waits on " + shelves[seed] + ".")
    }
}
print("Take a seed. Bring a story.")
