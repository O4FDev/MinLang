/// A light with a place in the world.
record Lantern {
    name: Text
    light: Integer
}

/// Give the light a name we can read from shore.
function describe(lantern: Lantern): Text {
    return lantern.name + ": " + Text(lantern.light)
}

let harbor = Lantern { name: "Harbor"; light: 40 }
let moon = 2
harbor.light += moon
print(describe(harbor))
