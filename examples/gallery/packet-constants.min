// Every value is worked out by the compiler, including the wire buffer size.
constant ETHERNET_PAYLOAD = 1500
constant IPV4_HEADER = 5 * 4
constant UDP_HEADER = 8
constant IPV4_PAYLOAD = ETHERNET_PAYLOAD - IPV4_HEADER
constant UDP_PAYLOAD = IPV4_PAYLOAD - UDP_HEADER
constant PAGE = 1 << 12
constant PAGE_MASK = PAGE - 1

record Datagram native "c_packed" {
    source: UInt16
    destination: UInt16
    length: UInt16
    checksum: UInt16
    payload: Bytes[UDP_PAYLOAD]
}

print("Ethernet payload: " + Text(ETHERNET_PAYLOAD))
print("IPv4 payload: " + Text(IPV4_PAYLOAD))
print("UDP payload: " + Text(UDP_PAYLOAD))
print("Page mask: " + Text(PAGE_MASK))
