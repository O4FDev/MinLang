// Two private heaps, one shared moment of arrival.
use "tasks" as tasks
use "workers" as workers
use "errors" as errors

let letters = tasks.channel(tasks.text(), tasks.text())

if workers.isWorker() {
    tasks.serve(letters, function(place: Text): Result<Text, errors.Error> {
        return Ok("A light is on in " + place + ".")
    }).unwrap()
} else {
    tasks.together(5000, function(scope: tasks.Scope): Result<Nothing, errors.Error> {
        let harbour = try tasks.start(scope, "letter", letters, "the harbour")
        let hills = try tasks.start(scope, "letter", letters, "the hills")
        print(try tasks.response(harbour))
        print(try tasks.response(hills))
        return Ok()
    }).unwrap()
    print("Everyone is home.")
}
