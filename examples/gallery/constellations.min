// Names meet before their declarations do.
global SKY: List<Star> = [
    Star { name: "Sirius"; light: 25 },
    Star { name: "Vega"; light: 40 },
    Star { name: "Polaris"; light: 90 },
]

for star in SKY {
    print(describe(star))
}

function describe(star: Star): Text {
    let sky = ""
    for ray in 0..(star.light / STEP) {
        sky += "✦ "
    }
    return star.name + ": " + sky.trim()
}

constant STEP = 10

record Star {
    name: Text
    light: Integer
}
