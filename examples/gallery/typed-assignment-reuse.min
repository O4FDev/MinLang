// Some things are worth returning to.
function tide(): List<Text> {
    let lines = ["The tide comes in.", "The tide goes out."]
    lines = ((lines).appended(lines[0]))
    return lines
}

function light(): Text {
    let words = "A little " + "light"
    words = ((words) + " can travel far.")
    return words
}

for line in tide() {
    print(line)
}
print(light())
