record Lanterns {
    places: List<Text>
}

record LanternWalk {
    places: List<Text>
    position: Integer
}

function Lanterns.iterator(): LanternWalk {
    return LanternWalk { places: self.places; position: -1 }
}

function LanternWalk.advance(): Boolean {
    self.position += 1
    return self.position < self.places.length
}

function LanternWalk.current(): Text {
    return self.places[self.position]
}

let harbour = Lanterns { places: ["the quay", "the bridge", "the last boat home"] }
for place in harbour {
    print("Leave a light for " + place + ".")
}
print("Every journey begins with one small light.")
