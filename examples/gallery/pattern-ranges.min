// The same window tells a different story as the day goes by.
record Lantern { name: Text; hour: Integer }

function listen(lantern: Lantern): Text {
    return match lantern {
        Lantern("harbour", 0..6) { "the harbour borrows a little light" }
        Lantern(_, 6..12) { "morning opens every window" }
        Lantern(_, 12..18) { "the sea holds the colour of the sky" }
        Lantern(_, 18..24) { "one by one, the lanterns answer" }
        _ { "the clock is dreaming" }
    }
}

for lantern in [
    Lantern { name: "harbour"; hour: 3 },
    Lantern { name: "town"; hour: 8 },
    Lantern { name: "town"; hour: 14 },
    Lantern { name: "harbour"; hour: 21 },
    Lantern { name: "town"; hour: 24 }
] {
    print(listen(lantern))
}
