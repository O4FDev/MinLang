public function html(): Text {
    return #"""
        <!doctype html>
        <html lang="en">
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Tideboard · a little room for today</title>
        <style>
        :root{color-scheme:light;--ink:#123b43;--muted:#547174;--paper:#f8f6ec;--line:#cedcd4;--sea:#126963}
        *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:18px/1.5 system-ui,sans-serif}
        main{max-width:760px;margin:7vh auto;padding:24px}header{border-bottom:1px solid var(--line);padding-bottom:28px}
        .eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.19em;color:var(--sea);font-weight:700}
        h1{font:clamp(50px,10vw,78px)/1.05 Georgia,serif;margin:16px 0}p{color:var(--muted)}
        .intro{max-width:480px;margin-bottom:0}form{display:flex;gap:10px;margin:30px 0 10px}
        input{min-width:0;flex:1;border:1px solid var(--line);background:white;border-radius:8px;padding:13px;font:inherit;color:var(--ink)}
        button{border:0;border-radius:8px;background:var(--sea);color:white;padding:11px 18px;font:inherit;cursor:pointer}
        button:disabled{opacity:.55;cursor:wait}button:focus-visible,input:focus-visible{outline:3px solid #c18b32;outline-offset:3px}
        #status{min-height:27px;font-size:14px;margin:8px 0 20px}ul{padding:0;list-style:none}li{display:flex;align-items:center;gap:16px;border-top:1px solid var(--line);padding:17px 0}
        .title{flex:1;white-space:pre-wrap;overflow-wrap:anywhere}.done .title{text-decoration:line-through;color:var(--muted)}
        li button{background:transparent;border:1px solid var(--line);color:var(--sea);padding:6px 12px;font-size:14px}
        .badge{color:var(--sea);font-size:14px}.empty{padding:36px 0;color:var(--muted);font:26px Georgia,serif}
        footer{border-top:1px solid var(--line);margin-top:32px;padding-top:18px;font-size:13px;color:var(--muted)}
        .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
        @media(max-width:480px){main{margin:20px auto}form{flex-direction:column}li{gap:10px}}
        </style>
        <main>
          <header><div class="eyebrow">A Minyar gallery program</div><h1>Tideboard</h1>
          <p class="intro">A little room for today. Write something worth doing, then let it find its way to done.</p></header>
          <form id="add"><label class="sr-only" for="title">New task</label><input id="title" name="title" placeholder="What will you make time for?" autocomplete="off" required maxlength="512"><button id="submit" type="submit">Add a task</button></form>
          <p id="status" role="status" aria-live="polite">Opening the board…</p>
          <ul id="tasks" aria-label="Tasks"></ul>
          <footer>One process. Up to 128 tasks. Everything leaves when the server stops.<br>Built with Minyar choices, methods, Results, and the portable HTTP server.</footer>
        </main>
        <script>
        const form=document.querySelector('#add'), input=document.querySelector('#title'), submit=document.querySelector('#submit'), list=document.querySelector('#tasks'), status=document.querySelector('#status');
        let pending=false;
        async function request(path,options){
          const response=await fetch(path,options);
          const body=await response.json();
          if(!response.ok)throw new Error(body.error||`Request failed (${response.status})`);
          return body;
        }
        async function refresh(){
          const board=await request('/tasks');
          list.replaceChildren();
          if(!board.tasks.length){const item=document.createElement('li');item.className='empty';item.textContent='A clear horizon. Start with one small thing.';list.append(item);}
          for(const task of board.tasks){
            const item=document.createElement('li'), title=document.createElement('span');
            title.className='title';title.textContent=task.title;item.append(title);
            if(task.completed){item.className='done';const badge=document.createElement('span');badge.className='badge';badge.textContent='Done ✓';item.append(badge);}
            else{const button=document.createElement('button');button.type='button';button.textContent='Complete';button.setAttribute('aria-label',`Complete ${task.title}`);button.addEventListener('click',async()=>{button.disabled=true;try{await request(`/tasks/${task.id}/complete`,{method:'POST'});await refresh();}catch(error){status.textContent=error.message;button.disabled=false;}});item.append(button);}
            list.append(item);
          }
          const done=board.tasks.filter(task=>task.completed).length;
          status.textContent=`${board.tasks.length} of ${board.capacity} spaces · ${done} done`;
        }
        form.addEventListener('submit',async event=>{
          event.preventDefault();if(pending)return;
          if(new TextEncoder().encode(input.value).length>512){status.textContent='Keep the title within 512 UTF-8 bytes.';return;}
          pending=true;submit.disabled=true;
          try{await request('/tasks',{method:'POST',headers:{'Content-Type':'text/plain; charset=utf-8'},body:input.value});input.value='';await refresh();input.focus();}
          catch(error){status.textContent=error.message;}
          finally{pending=false;submit.disabled=false;}
        });
        refresh().catch(error=>{status.textContent=error.message;});
        </script>
        </html>
        """#
}
