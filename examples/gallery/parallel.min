// A tide of small lights, each drawn into its own place.
parallel function light(column: Integer, row: Integer): Boolean {
    let x = column - 28
    let y = (row - 7) * 2
    let radius = x * x + y * y
    return radius < 600 && (radius / 28 + column / 3) % 3 == 0
}
let width = 57
let height = 15
let sky = Bytes(width * height)
parallel for index in 0..(width * height) {
    let column = index % width
    let row = index / width
    sky[index] = 32
    if light(column, row) { sky[index] = 42 }
}
print("                 a tide of small lights")
for row in 0..height {
    let line = ""
    for column in 0..width {
        if sky[row * width + column] == 42 { line += "✦" }
        else { line += " " }
    }
    print(line)
}
