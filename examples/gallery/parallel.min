// A Julia garden: every orbit has its own place, every place keeps its owner.
// Run without arguments for a woven preview, or pass a path for a 1200×800 PNG.
use "math" as math
use "process" as processInfo
use "io" as io
use "pixels" as pixels
use "./parallel-image.min" as image

parallel function orbit(column: Integer, row: Integer, width: Integer, height: Integer): Integer {
    let x = (Float(column) + 0.5) / Float(width) * 3.3 - 1.65
    let y = (Float(row) + 0.5) / Float(height) * 2.2 - 1.1
    let age = 0
    while x * x + y * y < 256.0 && age < 320 {
        let next = x * x - y * y - 0.74543
        y = 2.0 * x * y + 0.11301
        x = next
        age += 1
    }
    return age
}

let width = 96
let height = 32
if processInfo.argumentCount() > 0 { width = 1200; height = 800 }
let ages: List<Integer> = []
for index in 0..(width * height) { ages.add(0) }
parallel for index in 0..ages.length {
    ages[index] = orbit(index % width, index / width, width, height)
}

if processInfo.argumentCount() == 0 {
    let threads = [" ", "·", "░", "▒", "▓", "█"]
    print("                               a garden between numbers")
    let rim = ""
    for column in 0..width { rim += "─" }
    print("╭" + rim + "╮")
    for row in 0..height {
        let line = "│"
        for column in 0..width { line += threads[min(ages[row * width + column] / 12, 5)] }
        print(line + "│")
    }
    print("╰" + rim + "╯")
} else {
    let palette: List<Integer> = []
    for age in 0..321 {
        let phase = Float(age) * 0.16
        let red = Integer((0.5 + 0.5 * math.cos(phase + 0.4)) * 255.0)
        let green = Integer((0.5 + 0.5 * math.cos(phase + 2.1)) * 255.0)
        let blue = Integer((0.55 + 0.45 * math.cos(phase + 3.5)) * 255.0)
        palette.add((red << 16) | (green << 8) | blue)
    }
    palette[320] = 0x071323
    let garden = Bytes(width * height * 4)
    parallel for index in 0..garden.length {
        let color = palette[ages[index / 4]]
        garden[index] = (color >> (index % 4 * 8)) & 255
    }
    // A little midnight ink brings the woven bands together.
    pixels.blendBytes(garden, 0x071323, 24)
    let path = processInfo.argument(0)
    io.writeBytesFile(path, image.png(garden, width, height))
    print("saved \(path) · \(width) × \(height)")
}
