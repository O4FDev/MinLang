/// A lantern keeps a small circle of warmth in the dark.
public record Lantern {
    /// The place someone will look for.
    name: Text
    /// The light we have to give.
    light: Integer
}

/// Share the light equally; the original lantern stays bright.
///
/// ```minyar
/// let harbour = api.Lantern { name: "Home"; light: 84 }
/// print(harbour.share(2))
/// ```
/// ```output
/// 42
/// ```
public function Lantern.share(friends: Integer): Integer {
    return self.light / friends
}

/// A postcard carries something, or leaves a little room for silence.
///
/// ```minyar
/// let card = api.Postcard<Text>.Written("The moon stays.")
/// print(match card { Written(words) { words } Blank { "silence" } })
/// ```
/// ```output
/// The moon stays.
/// ```
public choice Postcard<Item> {
    /// Something worth sending home.
    Written(value: Item)
    /// A pause is a message too.
    Blank
}

/// The postcard we send with words. An alias keeps the same choice underneath.
///
/// ```minyar
/// let letter: api.Letter = Written("There is light in the harbour.")
/// print(match letter { Written(words) { words } Blank { "silence" } })
/// ```
/// ```output
/// There is light in the harbour.
/// ```
public type Letter = Postcard<Text>

/// Keep the first thing, or offer something when the list is empty.
///
/// ```minyar
/// print(api.firstOr(["moon", "sea"], "silence"))
/// ```
/// ```output
/// moon
/// ```
public function firstOr<Item>(values: List<Item>, fallback: Item): Item {
    if values.length == 0 { return fallback }
    return values[0]
}

test "a little light travels a long way" {
    let lantern = Lantern { name: "The harbour"; light: 84 }
    expect(lantern.share(2) == 42)
    expect(lantern.light == 84)
    expect(lantern.name == "The harbour")
}

test "equal lanterns carry equal promises" {
    let first = Lantern { name: "Home"; light: 42 }
    let second = Lantern { name: "Home"; light: 42 }
    expect(first == second)
}

test "even a blank postcard keeps its promise" {
    let letter: Letter = Blank
    expect(match letter { Written(words) { words } Blank { "silence" } } == "silence")
    expect(firstOr<Text>([], "come home") == "come home")
}

function main() {
    let harbour = Lantern { name: "The harbour"; light: 84 }
    print("\(harbour.name): \(harbour.share(2)) lights for you, 42 for me.")
}
