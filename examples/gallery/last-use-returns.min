// Bring a little of the journey home.
record Lantern {
    harbour: Text
    notes: List<Text>
}

function littleLight(place: Text): Text {
    let words = "A little light from " + place + "."
    return words
}

function alongTheShore(): List<Text> {
    let lights = [
        littleLight("the sleeping harbour"),
        littleLight("the last boat"),
        littleLight("a window left open"),
    ]
    return lights
}

function bringHome(): Lantern {
    let lantern = Lantern { harbour: "Home"; notes: alongTheShore() }
    return lantern
}

let lantern = bringHome()
let shared = lantern.notes
shared.add("Enough to find each other.")

print(lantern.harbour)
for note in lantern.notes {
    print(note)
}
