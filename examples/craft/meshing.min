// Turn chunks of blocks into triangles. Only faces that border a see-through
// block are emitted, each shaded by direction so the shape reads clearly.

use "graphics" as graphics
use "./blocks.min" as blocks
use "./terrain.min" as terrain

constant TILE_SIZE = 0.0625
constant INSET = 0.0005

function showFace(block: Integer, neighbour: Integer): Boolean {
    if blocks.isOpaque(neighbour) {
        return false
    }
    // Water and glass hide the faces between two blocks of the same kind.
    if neighbour == block && (block == blocks.WATER || block == blocks.GLASS) {
        return false
    }
    return true
}

function corner(vertices: Bytes, x: Float, y: Float, z: Float, u: Float, v: Float, shade: Float, tint: Float) {
    graphics.addVertex(vertices, x, y, z, u, v, shade * tint, shade, shade * tint)
}

// Emit two triangles for the quad a, b, c, d, given counter-clockwise from the front.
function quad(vertices: Bytes, ax: Float, ay: Float, az: Float, au: Float, av: Float, bx: Float, by: Float, bz: Float, bu: Float, bv: Float, cx: Float, cy: Float, cz: Float, cu: Float, cv: Float, dx: Float, dy: Float, dz: Float, du: Float, dv: Float, shade: Float) {
    corner(vertices, ax, ay, az, au, av, shade, 1.0)
    corner(vertices, bx, by, bz, bu, bv, shade, 1.0)
    corner(vertices, cx, cy, cz, cu, cv, shade, 1.0)
    corner(vertices, ax, ay, az, au, av, shade, 1.0)
    corner(vertices, cx, cy, cz, cu, cv, shade, 1.0)
    corner(vertices, dx, dy, dz, du, dv, shade, 1.0)
}

// direction: 0 up, 1 down, 2 east (+x), 3 west (-x), 4 south (+z), 5 north (-z)
function face(vertices: Bytes, bx: Integer, by: Integer, bz: Integer, direction: Integer, tile: Integer, top: Float) {
    let x = Float(bx)
    let y = Float(by)
    let z = Float(bz)
    let u0 = Float(tile % 16) * TILE_SIZE + INSET
    let v0 = Float(tile / 16) * TILE_SIZE + INSET
    let u1 = u0 + TILE_SIZE - 2.0 * INSET
    let v1 = v0 + TILE_SIZE - 2.0 * INSET
    let x1 = x + 1.0
    let y1 = y + top
    let z1 = z + 1.0
    if direction == 0 {
        quad(vertices, x, y1, z, u0, v0, x, y1, z1, u0, v1, x1, y1, z1, u1, v1, x1, y1, z, u1, v0, 1.0)
    } else if direction == 1 {
        quad(vertices, x, y, z, u0, v0, x1, y, z, u1, v0, x1, y, z1, u1, v1, x, y, z1, u0, v1, 0.5)
    } else if direction == 2 {
        quad(vertices, x1, y, z, u1, v1, x1, y1, z, u1, v0, x1, y1, z1, u0, v0, x1, y, z1, u0, v1, 0.8)
    } else if direction == 3 {
        quad(vertices, x, y, z, u0, v1, x, y, z1, u1, v1, x, y1, z1, u1, v0, x, y1, z, u0, v0, 0.8)
    } else if direction == 4 {
        quad(vertices, x, y, z1, u0, v1, x1, y, z1, u1, v1, x1, y1, z1, u1, v0, x, y1, z1, u0, v0, 0.65)
    } else {
        quad(vertices, x, y, z, u1, v1, x, y1, z, u1, v0, x1, y1, z, u0, v0, x1, y, z, u0, v1, 0.65)
    }
}

// Rebuild the vertices of one chunk into `vertices`, replacing its contents.
public function buildChunk(world: terrain.World, chunkX: Integer, chunkZ: Integer, vertices: Bytes) {
    vertices.clear()
    let startX = chunkX * terrain.CHUNK_SIZE
    let startZ = chunkZ * terrain.CHUNK_SIZE
    for y in 0..world.height {
        for z in startZ..startZ + terrain.CHUNK_SIZE {
            for x in startX..startX + terrain.CHUNK_SIZE {
                let block = world.blocks[(y * world.sizeZ + z) * world.sizeX + x]
                if block != blocks.AIR {
                    let side = blocks.tile(block, blocks.FACE_SIDE)
                    // Water surfaces sit a little below the block top.
                    let top = 1.0
                    if block == blocks.WATER && terrain.get(world, x, y + 1, z) != blocks.WATER {
                        top = 0.875
                    }
                    if showFace(block, terrain.get(world, x, y + 1, z)) {
                        face(vertices, x, y, z, 0, blocks.tile(block, blocks.FACE_TOP), top)
                    }
                    if y > 0 && showFace(block, terrain.get(world, x, y - 1, z)) {
                        face(vertices, x, y, z, 1, blocks.tile(block, blocks.FACE_BOTTOM), top)
                    }
                    if showFace(block, terrain.get(world, x + 1, y, z)) {
                        face(vertices, x, y, z, 2, side, top)
                    }
                    if showFace(block, terrain.get(world, x - 1, y, z)) {
                        face(vertices, x, y, z, 3, side, top)
                    }
                    if showFace(block, terrain.get(world, x, y, z + 1)) {
                        face(vertices, x, y, z, 4, side, top)
                    }
                    if showFace(block, terrain.get(world, x, y, z - 1)) {
                        face(vertices, x, y, z, 5, side, top)
                    }
                }
            }
        }
    }
}
