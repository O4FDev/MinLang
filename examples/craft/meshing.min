// Turn chunks of blocks into triangles. Only faces that border a see-through
// block are emitted, each shaded by direction so the shape reads clearly.

use "graphics" as graphics
use "./blocks.min" as blocks
use "./terrain.min" as terrain

constant TILE_SIZE = 0.0625
constant INSET = 0.0005

function showFace(block: Integer, neighbour: Integer): Boolean {
    if blocks.isOpaque(neighbour) {
        return false
    }
    // Water and glass hide the faces between two blocks of the same kind.
    if neighbour == block && (block == blocks.WATER || block == blocks.GLASS) {
        return false
    }
    return true
}

function occludes(world: terrain.World, x: Integer, y: Integer, z: Integer): Integer {
    if blocks.isOpaque(terrain.get(world, x, y, z)) {
        return 1
    }
    return 0
}

// Ambient occlusion for one corner of a face: the cell in front of the face is
// (x, y, z), and a and b point along the face toward the corner. Corners boxed
// in by neighbouring blocks receive less light.
function ambient(world: terrain.World, x: Integer, y: Integer, z: Integer, ax: Integer, ay: Integer, az: Integer, bx: Integer, by: Integer, bz: Integer): Float {
    let first = occludes(world, x + ax, y + ay, z + az)
    let second = occludes(world, x + bx, y + by, z + bz)
    if first == 1 && second == 1 {
        return 0.42
    }
    let open = 3 - first - second - occludes(world, x + ax + bx, y + ay + by, z + az + bz)
    if open == 3 {
        return 1.0
    } else if open == 2 {
        return 0.78
    }
    return 0.6
}

// Emit two triangles for the quad a, b, c, d, given counter-clockwise from the
// front, each corner with its own brightness. The split runs along the brighter
// diagonal so occlusion shading interpolates evenly.
function quad(vertices: Bytes, ax: Float, ay: Float, az: Float, au: Float, av: Float, bx: Float, by: Float, bz: Float, bu: Float, bv: Float, cx: Float, cy: Float, cz: Float, cu: Float, cv: Float, dx: Float, dy: Float, dz: Float, du: Float, dv: Float, sa: Float, sb: Float, sc: Float, sd: Float, sky: Float, glow: Float) {
    if sa + sc >= sb + sd {
        graphics.addLitVertex(vertices, ax, ay, az, au, av, sa, sa, sa, sky, glow)
        graphics.addLitVertex(vertices, bx, by, bz, bu, bv, sb, sb, sb, sky, glow)
        graphics.addLitVertex(vertices, cx, cy, cz, cu, cv, sc, sc, sc, sky, glow)
        graphics.addLitVertex(vertices, ax, ay, az, au, av, sa, sa, sa, sky, glow)
        graphics.addLitVertex(vertices, cx, cy, cz, cu, cv, sc, sc, sc, sky, glow)
        graphics.addLitVertex(vertices, dx, dy, dz, du, dv, sd, sd, sd, sky, glow)
    } else {
        graphics.addLitVertex(vertices, bx, by, bz, bu, bv, sb, sb, sb, sky, glow)
        graphics.addLitVertex(vertices, cx, cy, cz, cu, cv, sc, sc, sc, sky, glow)
        graphics.addLitVertex(vertices, dx, dy, dz, du, dv, sd, sd, sd, sky, glow)
        graphics.addLitVertex(vertices, bx, by, bz, bu, bv, sb, sb, sb, sky, glow)
        graphics.addLitVertex(vertices, dx, dy, dz, du, dv, sd, sd, sd, sky, glow)
        graphics.addLitVertex(vertices, ax, ay, az, au, av, sa, sa, sa, sky, glow)
    }
}

// Torchlight at a cell from the torches near this chunk, fading with distance.
function glowAt(world: terrain.World, torches: List<Integer>, x: Integer, y: Integer, z: Integer): Float {
    let glow = 0.0
    let layer = world.sizeX * world.sizeZ
    for torch in torches {
        let ty = torch / layer
        let tz = (torch % layer) / world.sizeX
        let tx = torch % world.sizeX
        let dx = Float(tx - x)
        let dy = Float(ty - y)
        let dz = Float(tz - z)
        let distance = sqrt(dx * dx + dy * dy + dz * dz)
        glow = max(glow, 1.0 - distance / Float(terrain.TORCH_REACH + 1))
    }
    return glow
}

// direction: 0 up, 1 down, 2 east (+x), 3 west (-x), 4 south (+z), 5 north (-z)
function face(world: terrain.World, torches: List<Integer>, vertices: Bytes, bx: Integer, by: Integer, bz: Integer, direction: Integer, tile: Integer, top: Float) {
    let frontX = bx
    let frontY = by
    let frontZ = bz
    if direction == 0 { frontY += 1 }
    if direction == 1 { frontY -= 1 }
    if direction == 2 { frontX += 1 }
    if direction == 3 { frontX -= 1 }
    if direction == 4 { frontZ += 1 }
    if direction == 5 { frontZ -= 1 }
    let sky = terrain.skyLight(world, frontX, frontY, frontZ)
    let glow = 0.0
    if torches.length > 0 {
        glow = glowAt(world, torches, frontX, frontY, frontZ)
    }
    let x = Float(bx)
    let y = Float(by)
    let z = Float(bz)
    let u0 = Float(tile % 16) * TILE_SIZE + INSET
    let v0 = Float(tile / 16) * TILE_SIZE + INSET
    let u1 = u0 + TILE_SIZE - 2.0 * INSET
    let v1 = v0 + TILE_SIZE - 2.0 * INSET
    let x1 = x + 1.0
    let y1 = y + top
    let z1 = z + 1.0
    if direction == 0 {
        let py = by + 1
        let sa = ambient(world, bx, py, bz, -1, 0, 0, 0, 0, -1)
        let sb = ambient(world, bx, py, bz, -1, 0, 0, 0, 0, 1)
        let sc = ambient(world, bx, py, bz, 1, 0, 0, 0, 0, 1)
        let sd = ambient(world, bx, py, bz, 1, 0, 0, 0, 0, -1)
        quad(vertices, x, y1, z, u0, v0, x, y1, z1, u0, v1, x1, y1, z1, u1, v1, x1, y1, z, u1, v0, sa, sb, sc, sd, sky, glow)
    } else if direction == 1 {
        let py = by - 1
        let shade = 0.5
        let sa = shade * ambient(world, bx, py, bz, -1, 0, 0, 0, 0, -1)
        let sb = shade * ambient(world, bx, py, bz, 1, 0, 0, 0, 0, -1)
        let sc = shade * ambient(world, bx, py, bz, 1, 0, 0, 0, 0, 1)
        let sd = shade * ambient(world, bx, py, bz, -1, 0, 0, 0, 0, 1)
        quad(vertices, x, y, z, u0, v0, x1, y, z, u1, v0, x1, y, z1, u1, v1, x, y, z1, u0, v1, sa, sb, sc, sd, sky, glow)
    } else if direction == 2 {
        let px = bx + 1
        let shade = 0.8
        let sa = shade * ambient(world, px, by, bz, 0, -1, 0, 0, 0, -1)
        let sb = shade * ambient(world, px, by, bz, 0, 1, 0, 0, 0, -1)
        let sc = shade * ambient(world, px, by, bz, 0, 1, 0, 0, 0, 1)
        let sd = shade * ambient(world, px, by, bz, 0, -1, 0, 0, 0, 1)
        quad(vertices, x1, y, z, u1, v1, x1, y1, z, u1, v0, x1, y1, z1, u0, v0, x1, y, z1, u0, v1, sa, sb, sc, sd, sky, glow)
    } else if direction == 3 {
        let px = bx - 1
        let shade = 0.8
        let sa = shade * ambient(world, px, by, bz, 0, -1, 0, 0, 0, -1)
        let sb = shade * ambient(world, px, by, bz, 0, -1, 0, 0, 0, 1)
        let sc = shade * ambient(world, px, by, bz, 0, 1, 0, 0, 0, 1)
        let sd = shade * ambient(world, px, by, bz, 0, 1, 0, 0, 0, -1)
        quad(vertices, x, y, z, u0, v1, x, y, z1, u1, v1, x, y1, z1, u1, v0, x, y1, z, u0, v0, sa, sb, sc, sd, sky, glow)
    } else if direction == 4 {
        let pz = bz + 1
        let shade = 0.65
        let sa = shade * ambient(world, bx, by, pz, -1, 0, 0, 0, -1, 0)
        let sb = shade * ambient(world, bx, by, pz, 1, 0, 0, 0, -1, 0)
        let sc = shade * ambient(world, bx, by, pz, 1, 0, 0, 0, 1, 0)
        let sd = shade * ambient(world, bx, by, pz, -1, 0, 0, 0, 1, 0)
        quad(vertices, x, y, z1, u0, v1, x1, y, z1, u1, v1, x1, y1, z1, u1, v0, x, y1, z1, u0, v0, sa, sb, sc, sd, sky, glow)
    } else {
        let pz = bz - 1
        let shade = 0.65
        let sa = shade * ambient(world, bx, by, pz, -1, 0, 0, 0, -1, 0)
        let sb = shade * ambient(world, bx, by, pz, -1, 0, 0, 0, 1, 0)
        let sc = shade * ambient(world, bx, by, pz, 1, 0, 0, 0, 1, 0)
        let sd = shade * ambient(world, bx, by, pz, 1, 0, 0, 0, -1, 0)
        quad(vertices, x, y, z, u1, v1, x, y1, z, u1, v0, x1, y1, z, u0, v0, x1, y, z, u0, v1, sa, sb, sc, sd, sky, glow)
    }
}

// Two crossed squares through the block, each visible from both sides.
function plant(world: terrain.World, torches: List<Integer>, vertices: Bytes, bx: Integer, by: Integer, bz: Integer, tile: Integer, block: Integer) {
    let sky = terrain.skyLight(world, bx, by, bz)
    let glow = 1.0
    if block != blocks.TORCH {
        glow = 0.0
        if torches.length > 0 {
            glow = glowAt(world, torches, bx, by, bz)
        }
    }
    let x = Float(bx)
    let y = Float(by)
    let z = Float(bz)
    let u0 = Float(tile % 16) * TILE_SIZE + INSET
    let v0 = Float(tile / 16) * TILE_SIZE + INSET
    let u1 = u0 + TILE_SIZE - 2.0 * INSET
    let v1 = v0 + TILE_SIZE - 2.0 * INSET
    let a = 0.15
    let b = 0.85
    quad(vertices, x + a, y, z + a, u0, v1, x + b, y, z + b, u1, v1, x + b, y + 1.0, z + b, u1, v0, x + a, y + 1.0, z + a, u0, v0, 0.9, 0.9, 0.9, 0.9, sky, glow)
    quad(vertices, x + b, y, z + b, u0, v1, x + a, y, z + a, u1, v1, x + a, y + 1.0, z + a, u1, v0, x + b, y + 1.0, z + b, u0, v0, 0.9, 0.9, 0.9, 0.9, sky, glow)
    quad(vertices, x + a, y, z + b, u0, v1, x + b, y, z + a, u1, v1, x + b, y + 1.0, z + a, u1, v0, x + a, y + 1.0, z + b, u0, v0, 0.9, 0.9, 0.9, 0.9, sky, glow)
    quad(vertices, x + b, y, z + a, u0, v1, x + a, y, z + b, u1, v1, x + a, y + 1.0, z + b, u1, v0, x + b, y + 1.0, z + a, u0, v0, 0.9, 0.9, 0.9, 0.9, sky, glow)
}

// Rebuild one chunk: water goes to `water`, drawn see-through after
// everything else, and all other blocks to `solid`. Both are replaced.
public function buildChunk(world: terrain.World, chunkX: Integer, chunkZ: Integer, solid: Bytes, water: Bytes) {
    solid.clear()
    water.clear()
    let startX = chunkX * terrain.CHUNK_SIZE
    let startZ = chunkZ * terrain.CHUNK_SIZE
    // Only torches within reach of this chunk can light it.
    let torches: List<Integer> = []
    let layer = world.sizeX * world.sizeZ
    for torch in world.torches {
        let tz = (torch % layer) / world.sizeX
        let tx = torch % world.sizeX
        let reach = terrain.TORCH_REACH + 1
        if tx >= startX - reach && tx < startX + terrain.CHUNK_SIZE + reach && tz >= startZ - reach && tz < startZ + terrain.CHUNK_SIZE + reach {
            torches.add(torch)
        }
    }
    for y in 0..world.height {
        for z in startZ..startZ + terrain.CHUNK_SIZE {
            for x in startX..startX + terrain.CHUNK_SIZE {
                let block = world.blocks[(y * world.sizeZ + z) * world.sizeX + x]
                if blocks.isPlant(block) {
                    plant(world, torches, solid, x, y, z, blocks.tile(block, blocks.FACE_SIDE), block)
                } else if block != blocks.AIR {
                    let vertices = solid
                    if block == blocks.WATER {
                        vertices = water
                    }
                    let side = blocks.tile(block, blocks.FACE_SIDE)
                    // Water surfaces sit a little below the block top.
                    let top = 1.0
                    if block == blocks.WATER && terrain.get(world, x, y + 1, z) != blocks.WATER {
                        top = 0.875
                    }
                    if showFace(block, terrain.get(world, x, y + 1, z)) {
                        face(world, torches, vertices, x, y, z, 0, blocks.tile(block, blocks.FACE_TOP), top)
                    }
                    if y > 0 && showFace(block, terrain.get(world, x, y - 1, z)) {
                        face(world, torches, vertices, x, y, z, 1, blocks.tile(block, blocks.FACE_BOTTOM), top)
                    }
                    if showFace(block, terrain.get(world, x + 1, y, z)) {
                        face(world, torches, vertices, x, y, z, 2, side, top)
                    }
                    if showFace(block, terrain.get(world, x - 1, y, z)) {
                        face(world, torches, vertices, x, y, z, 3, side, top)
                    }
                    if showFace(block, terrain.get(world, x, y, z + 1)) {
                        face(world, torches, vertices, x, y, z, 4, side, top)
                    }
                    if showFace(block, terrain.get(world, x, y, z - 1)) {
                        face(world, torches, vertices, x, y, z, 5, side, top)
                    }
                }
            }
        }
    }
}
