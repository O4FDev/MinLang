// A 256 by 256 texture atlas of 16 by 16 pixel tiles, drawn with code.

use "./blocks.min" as blocks
use "./noise.min" as noise

public constant ATLAS_SIZE = 256

function put(pixels: Bytes, tile: Integer, px: Integer, py: Integer, red: Integer, green: Integer, blue: Integer, alpha: Integer) {
    let x = (tile % 16) * 16 + px
    let y = (tile / 16) * 16 + py
    let index = (y * ATLAS_SIZE + x) * 4
    pixels[index] = clamp(red, 0, 255)
    pixels[index + 1] = clamp(green, 0, 255)
    pixels[index + 2] = clamp(blue, 0, 255)
    pixels[index + 3] = alpha
}

// A per-pixel random amount from -range to range.
function jitter(tile: Integer, px: Integer, py: Integer, range: Integer): Integer {
    return noise.hash(tile * 16 + px, py, 4242) % (range * 2 + 1) - range
}

// Base colour varied per pixel, as most natural blocks are.
function speckle(pixels: Bytes, tile: Integer, px: Integer, py: Integer, red: Integer, green: Integer, blue: Integer, range: Integer) {
    let j = jitter(tile, px, py, range)
    put(pixels, tile, px, py, red + j, green + j, blue + j, 255)
}

function drawTile(pixels: Bytes, tile: Integer, px: Integer, py: Integer) {
    let j = jitter(tile, px, py, 12)
    if tile == blocks.TILE_GRASS_TOP {
        speckle(pixels, tile, px, py, 96, 158, 58, 16)
    } else if tile == blocks.TILE_GRASS_SIDE || tile == blocks.TILE_SNOW_SIDE {
        let edge = 3 + noise.hash(px, tile, 17) % 3
        if py < edge {
            if tile == blocks.TILE_GRASS_SIDE {
                speckle(pixels, tile, px, py, 96, 158, 58, 16)
            } else {
                speckle(pixels, tile, px, py, 236, 244, 250, 6)
            }
        } else {
            speckle(pixels, tile, px, py, 134, 96, 67, 14)
        }
    } else if tile == blocks.TILE_DIRT {
        speckle(pixels, tile, px, py, 134, 96, 67, 14)
    } else if tile == blocks.TILE_STONE {
        let spot = noise.hash(px / 3, py / 2, tile + 31) % 5 == 0
        if spot {
            speckle(pixels, tile, px, py, 104, 104, 104, 8)
        } else {
            speckle(pixels, tile, px, py, 128, 128, 128, 10)
        }
    } else if tile == blocks.TILE_SAND {
        speckle(pixels, tile, px, py, 220, 208, 160, 10)
    } else if tile == blocks.TILE_LOG_SIDE {
        let stripe = (px + noise.hash(py / 4, tile, 3) % 2) % 4 == 0
        if stripe {
            speckle(pixels, tile, px, py, 76, 58, 34, 6)
        } else {
            speckle(pixels, tile, px, py, 104, 82, 50, 8)
        }
    } else if tile == blocks.TILE_LOG_TOP {
        let dx = px * 2 - 15
        let dy = py * 2 - 15
        let ring = Integer(sqrt(Float(dx * dx + dy * dy))) / 3
        if px == 0 || py == 0 || px == 15 || py == 15 {
            speckle(pixels, tile, px, py, 104, 82, 50, 8)
        } else if ring % 2 == 0 {
            speckle(pixels, tile, px, py, 176, 144, 92, 6)
        } else {
            speckle(pixels, tile, px, py, 146, 116, 70, 6)
        }
    } else if tile == blocks.TILE_LEAVES {
        if noise.hash(px, py, 911) % 5 == 0 {
            put(pixels, tile, px, py, 0, 0, 0, 0)
        } else {
            speckle(pixels, tile, px, py, 58, 118, 42, 22)
        }
    } else if tile == blocks.TILE_WATER {
        let wave = (px + py * 2 + noise.hash(py, 0, 5) % 3) % 8 < 2
        if wave {
            put(pixels, tile, px, py, 70 + j, 120 + j, 220, 255)
        } else {
            put(pixels, tile, px, py, 44 + j, 88 + j, 200, 255)
        }
    } else if tile == blocks.TILE_PLANKS {
        let seam = py % 4 == 3 || (px == (py / 4) * 5 % 16 && py % 4 != 3)
        if seam {
            speckle(pixels, tile, px, py, 118, 90, 52, 4)
        } else {
            speckle(pixels, tile, px, py, 168, 134, 82, 8)
        }
    } else if tile == blocks.TILE_COBBLESTONE {
        let cell = noise.hash(px / 4 + (py / 4) * 7, py / 4, 55) % 4
        let edge = px % 4 == 0 || py % 4 == 0
        if edge {
            speckle(pixels, tile, px, py, 84, 84, 84, 6)
        } else {
            let base = 112 + cell * 10
            speckle(pixels, tile, px, py, base, base, base, 8)
        }
    } else if tile == blocks.TILE_GLASS {
        let border = px == 0 || py == 0 || px == 15 || py == 15
        let glint = (px == py + 3 && px > 4 && px < 9) || (px == py + 4 && px > 5 && px < 10)
        if border || glint {
            put(pixels, tile, px, py, 210, 232, 240, 255)
        } else {
            put(pixels, tile, px, py, 0, 0, 0, 0)
        }
    } else if tile == blocks.TILE_BEDROCK {
        if noise.hash(px, py, 77) % 3 == 0 {
            speckle(pixels, tile, px, py, 40, 40, 40, 10)
        } else {
            speckle(pixels, tile, px, py, 84, 84, 84, 16)
        }
    } else if tile == blocks.TILE_BRICK {
        let row = py / 4
        let mortar = py % 4 == 3 || (px + (row % 2) * 4) % 8 == 7
        if mortar {
            speckle(pixels, tile, px, py, 196, 190, 178, 6)
        } else {
            speckle(pixels, tile, px, py, 150, 64, 48, 12)
        }
    } else if tile == blocks.TILE_SNOW {
        speckle(pixels, tile, px, py, 236, 244, 250, 6)
    } else if tile == blocks.TILE_SUN {
        let edge = px < 2 || py < 2 || px > 13 || py > 13
        if edge {
            put(pixels, tile, px, py, 255, 236, 140, 255)
        } else {
            put(pixels, tile, px, py, 255, 252, 214, 255)
        }
    } else if tile == blocks.TILE_MOON {
        let crater = noise.hash(px / 3, py / 3, 12) % 4 == 0
        if crater {
            put(pixels, tile, px, py, 176, 180, 196, 255)
        } else {
            put(pixels, tile, px, py, 222, 226, 238, 255)
        }
    } else if tile == blocks.TILE_CLOUD {
        put(pixels, tile, px, py, 255, 255, 255, 255)
    } else {
        put(pixels, tile, px, py, 255, 0, 255, 255)
    }
}

public function build(): Bytes {
    let pixels = Bytes(ATLAS_SIZE * ATLAS_SIZE * 4)
    for tile in 0..blocks.TILE_COUNT {
        for py in 0..16 {
            for px in 0..16 {
                drawTile(pixels, tile, px, py)
            }
        }
    }
    return pixels
}

// Atlas coordinates of a tile, for drawing block icons.
public function tileU(tile: Integer): Float {
    return Float(tile % 16) / 16.0
}

public function tileV(tile: Integer): Float {
    return Float(tile / 16) / 16.0
}
