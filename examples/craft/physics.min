// The player's body: walking, jumping, flying, collisions, and aiming at blocks.

use "./blocks.min" as blocks
use "./terrain.min" as terrain

constant HALF_WIDTH = 0.3
constant BODY_HEIGHT = 1.8
public constant EYE_HEIGHT = 1.62
constant GRAVITY = 28.0
constant JUMP_SPEED = 8.6
constant WALK_SPEED = 4.3
constant SPRINT_SPEED = 6.4
constant FLY_SPEED = 12.0
constant SKIN = 0.001

public record Player {
    x: Float
    y: Float
    z: Float
    velocityX: Float
    velocityY: Float
    velocityZ: Float
    yaw: Float
    pitch: Float
    onGround: Boolean
    flying: Boolean
    inWater: Boolean
}

public function spawn(world: terrain.World): Player {
    let x = world.sizeX / 2
    let z = world.sizeZ / 2
    let ground = terrain.surface(world, x, z)
    return Player {
        x: Float(x) + 0.5
        y: Float(ground + 1)
        z: Float(z) + 0.5
        velocityX: 0.0
        velocityY: 0.0
        velocityZ: 0.0
        yaw: 0.0
        pitch: -0.2
        onGround: false
        flying: false
        inWater: false
    }
}

function cell(value: Float): Integer {
    return Integer(floor(value))
}

// Whether the player's box would overlap a solid block at this position.
public function collides(world: terrain.World, x: Float, y: Float, z: Float): Boolean {
    for bx in cell(x - HALF_WIDTH)..cell(x + HALF_WIDTH) + 1 {
        for by in cell(y)..cell(y + BODY_HEIGHT) + 1 {
            for bz in cell(z - HALF_WIDTH)..cell(z + HALF_WIDTH) + 1 {
                if blocks.isSolid(terrain.get(world, bx, by, bz)) {
                    return true
                }
            }
        }
    }
    return false
}

// Whether a block cell overlaps the player's box, so placing there is refused.
public function occupies(player: Player, bx: Integer, by: Integer, bz: Integer): Boolean {
    let x = Float(bx)
    let y = Float(by)
    let z = Float(bz)
    return player.x + HALF_WIDTH > x && player.x - HALF_WIDTH < x + 1.0 && player.y + BODY_HEIGHT > y && player.y < y + 1.0 && player.z + HALF_WIDTH > z && player.z - HALF_WIDTH < z + 1.0
}

// Move along one axis (0 x, 1 y, 2 z), stopping flush against solid blocks.
function moveAxis(world: terrain.World, player: Player, axis: Integer, distance: Float) {
    if distance == 0.0 {
        return
    }
    let x = player.x
    let y = player.y
    let z = player.z
    if axis == 0 { x += distance }
    if axis == 1 { y += distance }
    if axis == 2 { z += distance }
    if !collides(world, x, y, z) {
        player.x = x
        player.y = y
        player.z = z
        return
    }
    if axis == 0 {
        if distance > 0.0 {
            player.x = floor(x + HALF_WIDTH) - HALF_WIDTH - SKIN
        } else {
            player.x = floor(x - HALF_WIDTH) + 1.0 + HALF_WIDTH + SKIN
        }
        player.velocityX = 0.0
    } else if axis == 1 {
        if distance > 0.0 {
            player.y = floor(y + BODY_HEIGHT) - BODY_HEIGHT - SKIN
        } else {
            player.y = floor(y) + 1.0
            player.onGround = true
        }
        player.velocityY = 0.0
    } else {
        if distance > 0.0 {
            player.z = floor(z + HALF_WIDTH) - HALF_WIDTH - SKIN
        } else {
            player.z = floor(z - HALF_WIDTH) + 1.0 + HALF_WIDTH + SKIN
        }
        player.velocityZ = 0.0
    }
}

// Advance the player by `seconds` with the given movement intent: forward and
// strafe from -1 to 1, and whether jump, descend, and sprint are held.
public function update(world: terrain.World, player: Player, seconds: Float, forward: Float, strafe: Float, jump: Boolean, descend: Boolean, sprint: Boolean) {
    let dirX = sin(player.yaw) * forward + cos(player.yaw) * strafe
    let dirZ = -cos(player.yaw) * forward + sin(player.yaw) * strafe
    let length = sqrt(dirX * dirX + dirZ * dirZ)
    if length > 1.0 {
        dirX /= length
        dirZ /= length
    }
    let feet = terrain.get(world, cell(player.x), cell(player.y + 0.1), cell(player.z))
    let chest = terrain.get(world, cell(player.x), cell(player.y + 1.0), cell(player.z))
    player.inWater = feet == blocks.WATER || chest == blocks.WATER
    let speed = WALK_SPEED
    if sprint { speed = SPRINT_SPEED }
    if player.flying { speed = FLY_SPEED }
    if player.inWater && !player.flying { speed *= 0.6 }
    player.velocityX = dirX * speed
    player.velocityZ = dirZ * speed
    if player.flying {
        player.velocityY = 0.0
        if jump { player.velocityY = FLY_SPEED }
        if descend { player.velocityY = -FLY_SPEED }
    } else if player.inWater {
        player.velocityY = max(player.velocityY - GRAVITY * 0.25 * seconds, -3.0)
        if jump { player.velocityY = 3.5 }
    } else {
        player.velocityY = max(player.velocityY - GRAVITY * seconds, -50.0)
        if jump && player.onGround {
            player.velocityY = JUMP_SPEED
        }
    }
    // Small steps keep fast movement from passing through thin walls.
    let steps = 1 + Integer(max(abs(player.velocityX), max(abs(player.velocityY), abs(player.velocityZ))) * seconds / 0.4)
    let step = seconds / Float(steps)
    player.onGround = false
    for i in 0..steps {
        moveAxis(world, player, 0, player.velocityX * step)
        moveAxis(world, player, 2, player.velocityZ * step)
        moveAxis(world, player, 1, player.velocityY * step)
    }
    if player.y < -20.0 {
        player.y = Float(world.height)
        player.velocityY = 0.0
    }
}

// The block the player is looking at, found by walking the grid along the view ray.
public record Hit {
    found: Boolean
    x: Integer
    y: Integer
    z: Integer
    normalX: Integer
    normalY: Integer
    normalZ: Integer
}

function firstBoundary(origin: Float, direction: Float): Float {
    if direction > 0.0 {
        return (floor(origin) + 1.0 - origin) / direction
    } else if direction < 0.0 {
        return (origin - floor(origin)) / -direction
    }
    return 1000000.0
}

function crossing(direction: Float): Float {
    if direction == 0.0 {
        return 1000000.0
    }
    return abs(1.0 / direction)
}

function sign(direction: Float): Integer {
    if direction > 0.0 { return 1 }
    if direction < 0.0 { return -1 }
    return 0
}

public function aim(world: terrain.World, player: Player, reach: Float): Hit {
    let ox = player.x
    let oy = player.y + EYE_HEIGHT
    let oz = player.z
    let dx = sin(player.yaw) * cos(player.pitch)
    let dy = sin(player.pitch)
    let dz = -cos(player.yaw) * cos(player.pitch)
    let x = cell(ox)
    let y = cell(oy)
    let z = cell(oz)
    let stepX = sign(dx)
    let stepY = sign(dy)
    let stepZ = sign(dz)
    let nextX = firstBoundary(ox, dx)
    let nextY = firstBoundary(oy, dy)
    let nextZ = firstBoundary(oz, dz)
    let deltaX = crossing(dx)
    let deltaY = crossing(dy)
    let deltaZ = crossing(dz)
    let hit = Hit { found: false; x: 0; y: 0; z: 0; normalX: 0; normalY: 0; normalZ: 0 }
    let travelled = 0.0
    while travelled <= reach {
        let block = terrain.get(world, x, y, z)
        if block != blocks.AIR && block != blocks.WATER {
            hit.found = true
            hit.x = x
            hit.y = y
            hit.z = z
            return hit
        }
        if nextX < nextY && nextX < nextZ {
            x += stepX
            travelled = nextX
            nextX += deltaX
            hit.normalX = -stepX
            hit.normalY = 0
            hit.normalZ = 0
        } else if nextY < nextZ {
            y += stepY
            travelled = nextY
            nextY += deltaY
            hit.normalX = 0
            hit.normalY = -stepY
            hit.normalZ = 0
        } else {
            z += stepZ
            travelled = nextZ
            nextZ += deltaZ
            hit.normalX = 0
            hit.normalY = 0
            hit.normalZ = -stepZ
        }
    }
    return hit
}
