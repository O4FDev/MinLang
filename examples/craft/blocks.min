// Block kinds and how they look and behave.

public constant AIR = 0
public constant GRASS = 1
public constant DIRT = 2
public constant STONE = 3
public constant SAND = 4
public constant LOG = 5
public constant LEAVES = 6
public constant WATER = 7
public constant PLANKS = 8
public constant COBBLESTONE = 9
public constant GLASS = 10
public constant BEDROCK = 11
public constant BRICK = 12
public constant SNOW = 13
public constant TALL_GRASS = 14
public constant RED_FLOWER = 15
public constant YELLOW_FLOWER = 16
public constant COAL_ORE = 17
public constant IRON_ORE = 18
public constant GOLD_ORE = 19
public constant DIAMOND_ORE = 20
public constant TORCH = 21
public constant BLOCK_COUNT = 22

// Tiles in the 16 by 16 texture atlas.
public constant TILE_GRASS_TOP = 0
public constant TILE_GRASS_SIDE = 1
public constant TILE_DIRT = 2
public constant TILE_STONE = 3
public constant TILE_SAND = 4
public constant TILE_LOG_SIDE = 5
public constant TILE_LOG_TOP = 6
public constant TILE_LEAVES = 7
public constant TILE_WATER = 8
public constant TILE_PLANKS = 9
public constant TILE_COBBLESTONE = 10
public constant TILE_GLASS = 11
public constant TILE_BEDROCK = 12
public constant TILE_BRICK = 13
public constant TILE_SNOW = 14
public constant TILE_SNOW_SIDE = 15
public constant TILE_SUN = 16
public constant TILE_MOON = 17
public constant TILE_CLOUD = 18
public constant TILE_TALL_GRASS = 19
public constant TILE_RED_FLOWER = 20
public constant TILE_YELLOW_FLOWER = 21
public constant TILE_COAL_ORE = 22
public constant TILE_IRON_ORE = 23
public constant TILE_GOLD_ORE = 24
public constant TILE_DIAMOND_ORE = 25
public constant TILE_TORCH = 26
public constant TILE_COUNT = 27

// Faces, used for texturing and meshing.
public constant FACE_TOP = 0
public constant FACE_BOTTOM = 1
public constant FACE_SIDE = 2

// Plants, and torches, are drawn as two crossed pictures rather than a cube.
public function isPlant(block: Integer): Boolean {
    return block == TALL_GRASS || block == RED_FLOWER || block == YELLOW_FLOWER || block == TORCH
}

// Solid blocks stop the player.
public function isSolid(block: Integer): Boolean {
    return block != AIR && block != WATER && !isPlant(block)
}

// Opaque blocks hide the faces of their neighbours.
public function isOpaque(block: Integer): Boolean {
    return block != AIR && block != WATER && block != LEAVES && block != GLASS && !isPlant(block)
}

// Whether the player can break the block.
public function isBreakable(block: Integer): Boolean {
    return block != AIR && block != WATER && block != BEDROCK
}

public function tile(block: Integer, face: Integer): Integer {
    if block == GRASS {
        if face == FACE_TOP {
            return TILE_GRASS_TOP
        } else if face == FACE_BOTTOM {
            return TILE_DIRT
        }
        return TILE_GRASS_SIDE
    } else if block == SNOW {
        if face == FACE_TOP {
            return TILE_SNOW
        } else if face == FACE_BOTTOM {
            return TILE_DIRT
        }
        return TILE_SNOW_SIDE
    } else if block == LOG {
        if face == FACE_SIDE {
            return TILE_LOG_SIDE
        }
        return TILE_LOG_TOP
    } else if block == DIRT {
        return TILE_DIRT
    } else if block == STONE {
        return TILE_STONE
    } else if block == SAND {
        return TILE_SAND
    } else if block == LEAVES {
        return TILE_LEAVES
    } else if block == WATER {
        return TILE_WATER
    } else if block == PLANKS {
        return TILE_PLANKS
    } else if block == COBBLESTONE {
        return TILE_COBBLESTONE
    } else if block == GLASS {
        return TILE_GLASS
    } else if block == BEDROCK {
        return TILE_BEDROCK
    } else if block == BRICK {
        return TILE_BRICK
    } else if block == TALL_GRASS {
        return TILE_TALL_GRASS
    } else if block == RED_FLOWER {
        return TILE_RED_FLOWER
    } else if block == YELLOW_FLOWER {
        return TILE_YELLOW_FLOWER
    } else if block == COAL_ORE {
        return TILE_COAL_ORE
    } else if block == IRON_ORE {
        return TILE_IRON_ORE
    } else if block == GOLD_ORE {
        return TILE_GOLD_ORE
    } else if block == DIAMOND_ORE {
        return TILE_DIAMOND_ORE
    } else if block == TORCH {
        return TILE_TORCH
    }
    return TILE_STONE
}

public function name(block: Integer): Text {
    if block == GRASS { return "Grass" }
    if block == DIRT { return "Dirt" }
    if block == STONE { return "Stone" }
    if block == SAND { return "Sand" }
    if block == LOG { return "Log" }
    if block == LEAVES { return "Leaves" }
    if block == WATER { return "Water" }
    if block == PLANKS { return "Planks" }
    if block == COBBLESTONE { return "Cobblestone" }
    if block == GLASS { return "Glass" }
    if block == BEDROCK { return "Bedrock" }
    if block == BRICK { return "Brick" }
    if block == SNOW { return "Snow" }
    if block == TALL_GRASS { return "Tall Grass" }
    if block == RED_FLOWER { return "Poppy" }
    if block == YELLOW_FLOWER { return "Dandelion" }
    if block == COAL_ORE { return "Coal Ore" }
    if block == IRON_ORE { return "Iron Ore" }
    if block == GOLD_ORE { return "Gold Ore" }
    if block == DIAMOND_ORE { return "Diamond Ore" }
    if block == TORCH { return "Torch" }
    return "Air"
}
