// Block kinds and how they look and behave.

public constant AIR = 0
public constant GRASS = 1
public constant DIRT = 2
public constant STONE = 3
public constant SAND = 4
public constant LOG = 5
public constant LEAVES = 6
public constant WATER = 7
public constant PLANKS = 8
public constant COBBLESTONE = 9
public constant GLASS = 10
public constant BEDROCK = 11
public constant BRICK = 12
public constant SNOW = 13
public constant BLOCK_COUNT = 14

// Tiles in the 16 by 16 texture atlas.
public constant TILE_GRASS_TOP = 0
public constant TILE_GRASS_SIDE = 1
public constant TILE_DIRT = 2
public constant TILE_STONE = 3
public constant TILE_SAND = 4
public constant TILE_LOG_SIDE = 5
public constant TILE_LOG_TOP = 6
public constant TILE_LEAVES = 7
public constant TILE_WATER = 8
public constant TILE_PLANKS = 9
public constant TILE_COBBLESTONE = 10
public constant TILE_GLASS = 11
public constant TILE_BEDROCK = 12
public constant TILE_BRICK = 13
public constant TILE_SNOW = 14
public constant TILE_SNOW_SIDE = 15
public constant TILE_COUNT = 16

// Faces, used for texturing and meshing.
public constant FACE_TOP = 0
public constant FACE_BOTTOM = 1
public constant FACE_SIDE = 2

// Solid blocks stop the player.
public function isSolid(block: Integer): Boolean {
    return block != AIR && block != WATER
}

// Opaque blocks hide the faces of their neighbours.
public function isOpaque(block: Integer): Boolean {
    return block != AIR && block != WATER && block != LEAVES && block != GLASS
}

// Whether the player can break the block.
public function isBreakable(block: Integer): Boolean {
    return block != AIR && block != WATER && block != BEDROCK
}

public function tile(block: Integer, face: Integer): Integer {
    if block == GRASS {
        if face == FACE_TOP {
            return TILE_GRASS_TOP
        } else if face == FACE_BOTTOM {
            return TILE_DIRT
        }
        return TILE_GRASS_SIDE
    } else if block == SNOW {
        if face == FACE_TOP {
            return TILE_SNOW
        } else if face == FACE_BOTTOM {
            return TILE_DIRT
        }
        return TILE_SNOW_SIDE
    } else if block == LOG {
        if face == FACE_SIDE {
            return TILE_LOG_SIDE
        }
        return TILE_LOG_TOP
    } else if block == DIRT {
        return TILE_DIRT
    } else if block == STONE {
        return TILE_STONE
    } else if block == SAND {
        return TILE_SAND
    } else if block == LEAVES {
        return TILE_LEAVES
    } else if block == WATER {
        return TILE_WATER
    } else if block == PLANKS {
        return TILE_PLANKS
    } else if block == COBBLESTONE {
        return TILE_COBBLESTONE
    } else if block == GLASS {
        return TILE_GLASS
    } else if block == BEDROCK {
        return TILE_BEDROCK
    } else if block == BRICK {
        return TILE_BRICK
    }
    return TILE_STONE
}

public function name(block: Integer): Text {
    if block == GRASS { return "Grass" }
    if block == DIRT { return "Dirt" }
    if block == STONE { return "Stone" }
    if block == SAND { return "Sand" }
    if block == LOG { return "Log" }
    if block == LEAVES { return "Leaves" }
    if block == WATER { return "Water" }
    if block == PLANKS { return "Planks" }
    if block == COBBLESTONE { return "Cobblestone" }
    if block == GLASS { return "Glass" }
    if block == BEDROCK { return "Bedrock" }
    if block == BRICK { return "Brick" }
    if block == SNOW { return "Snow" }
    return "Air"
}
