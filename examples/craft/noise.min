// Deterministic hashing and smooth value noise for terrain and textures.

// Mix two coordinates and a seed into a non-negative 31-bit Integer.
public function hash(x: Integer, z: Integer, seed: Integer): Integer {
    let h = wrappingAdd(wrappingMultiply(x, 374761393), wrappingMultiply(z, 668265263))
    h = wrappingAdd(h, wrappingMultiply(seed, 1442695041))
    h = wrappingMultiply(h ^ (h >> 13), 1274126177)
    h = h ^ (h >> 16)
    return h & 0x7FFFFFFF
}

// A random Float from 0 up to 1 for a grid point.
public function random(x: Integer, z: Integer, seed: Integer): Float {
    return Float(hash(x, z, seed) & 0xFFFFFF) / 16777216.0
}

function fade(t: Float): Float {
    return t * t * (3.0 - 2.0 * t)
}

// Smoothly interpolated random values between grid points, from 0 up to 1.
public function valueNoise(x: Float, z: Float, seed: Integer): Float {
    let x0 = floor(x)
    let z0 = floor(z)
    let ix = Integer(x0)
    let iz = Integer(z0)
    let fx = fade(x - x0)
    let fz = fade(z - z0)
    let a = random(ix, iz, seed)
    let b = random(ix + 1, iz, seed)
    let c = random(ix, iz + 1, seed)
    let d = random(ix + 1, iz + 1, seed)
    let near = a + (b - a) * fx
    let far = c + (d - c) * fx
    return near + (far - near) * fz
}

// Several octaves of value noise, each twice as detailed and half as strong.
public function fractalNoise(x: Float, z: Float, seed: Integer, octaves: Integer): Float {
    let total = 0.0
    let amplitude = 1.0
    let frequency = 1.0
    let range = 0.0
    for octave in 0..octaves {
        total += valueNoise(x * frequency, z * frequency, seed + octave * 7919) * amplitude
        range += amplitude
        amplitude *= 0.5
        frequency *= 2.0
    }
    return total / range
}
