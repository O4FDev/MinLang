// Minyarcraft: a small block-building game written in Minyar.
//
//   ./minyar --release examples/craft/main.min -o craft && ./craft
//
// Mouse to look, WASD to move, Space to jump, Shift to sprint (or descend
// while flying), F to fly, left click to break, right click to place, 1-9 or
// the scroll wheel to choose a block, middle click to pick the aimed block,
// T to speed up time, Escape to free the mouse. The game saves every minute and on quitting; --new starts afresh.

use "graphics" as graphics
use "./blocks.min" as blocks
use "./terrain.min" as terrain
use "./meshing.min" as meshing
use "./physics.min" as physics
use "./textures.min" as textures
use "./atmosphere.min" as atmosphere
use "./save.min" as save

constant REACH = 6.0
constant MOUSE_SENSITIVITY = 0.0025
constant CHUNKS_PER_FRAME = 4
constant AUTOSAVE_SECONDS = 60.0
constant DRAW_DISTANCE = 150.0

function axis(positive: Integer, negative: Integer): Float {
    let value = 0.0
    if graphics.keyDown(positive) { value += 1.0 }
    if graphics.keyDown(negative) { value -= 1.0 }
    return value
}

// Remesh up to `limit` chunks that changed, returning how many were rebuilt.
function remesh(world: terrain.World, meshes: List<Integer>, waterMeshes: List<Integer>, vertices: Bytes, water: Bytes, limit: Integer): Integer {
    let rebuilt = 0
    for chunk in 0..world.dirty.length {
        if rebuilt < limit && world.dirty[chunk] {
            meshing.buildChunk(world, chunk % terrain.CHUNKS_X, chunk / terrain.CHUNKS_X, vertices, water)
            graphics.updateMesh(meshes[chunk], vertices)
            graphics.updateMesh(waterMeshes[chunk], water)
            world.dirty[chunk] = false
            rebuilt += 1
        }
    }
    return rebuilt
}

function drawHotbar(hotbar: List<Integer>, selected: Integer) {
    let slot = 44.0
    let width = slot * Float(hotbar.length)
    let left = (Float(graphics.windowWidth()) - width) / 2.0
    let top = Float(graphics.windowHeight()) - slot - 12.0
    graphics.drawRectangle(left - 4.0, top - 4.0, width + 8.0, slot + 8.0, 0.0, 0.0, 0.0, 0.45)
    for index in 0..hotbar.length {
        let x = left + Float(index) * slot
        if index == selected {
            graphics.drawRectangle(x, top, slot, slot, 1.0, 1.0, 1.0, 0.9)
            graphics.drawRectangle(x + 3.0, top + 3.0, slot - 6.0, slot - 6.0, 0.15, 0.15, 0.15, 1.0)
        }
        let tile = blocks.tile(hotbar[index], blocks.FACE_SIDE)
        let u = textures.tileU(tile)
        let v = textures.tileV(tile)
        graphics.drawImage(x + 7.0, top + 7.0, slot - 14.0, slot - 14.0, u, v, u + 0.0625, v + 0.0625)
    }
}

function twoDigits(value: Integer): Text {
    if value < 10 {
        return "0" + Text(value)
    }
    return Text(value)
}

// 0 is sunrise at 6:00 and 0.25 is noon.
function clockText(time: Float): Text {
    let minutes = Integer(time * 1440.0 + 360.0) % 1440
    return twoDigits(minutes / 60) + ":" + twoDigits(minutes % 60)
}

function facing(yaw: Float): Text {
    let turn = Integer(floor((yaw / 6.283185307179586) * 4.0 + 0.5)) % 4
    if turn < 0 {
        turn += 4
    }
    if turn == 0 { return "north" }
    if turn == 1 { return "east" }
    if turn == 2 { return "south" }
    return "west"
}

function drawHud(player: physics.Player, sky: atmosphere.Sky, fps: Integer, blockName: Text, nameSeconds: Float, captured: Boolean) {
    let status = "Minyarcraft  " + Text(fps) + " fps\n"
    status += "Position " + Text(Integer(floor(player.x))) + " " + Text(Integer(floor(player.y))) + " " + Text(Integer(floor(player.z))) + "  facing " + facing(player.yaw) + "\n"
    status += "Time " + clockText(sky.time)
    if player.flying {
        status += "  flying"
    }
    graphics.drawText(status, 10.0, 10.0, 2.0, 1.0, 1.0, 1.0)
    let width = Float(graphics.windowWidth())
    let height = Float(graphics.windowHeight())
    if nameSeconds > 0.0 {
        let size = 2.0
        let nameWidth = graphics.textWidth(blockName, size)
        graphics.drawText(blockName, (width - nameWidth) / 2.0, height - 90.0, size, 1.0, 1.0, 1.0)
    }
    if !captured {
        graphics.drawRectangle(0.0, 0.0, width, height, 0.0, 0.0, 0.0, 0.45)
        let title = "Paused"
        graphics.drawText(title, (width - graphics.textWidth(title, 5.0)) / 2.0, height / 2.0 - 60.0, 5.0, 1.0, 1.0, 1.0)
        let hint = "Click to play\n\nWASD move   Space jump   Shift sprint   F fly\nLeft click break   Right click place   Middle click pick block\n1-9 or scroll choose   T speed up time   Escape pause"
        graphics.drawText(hint, (width - graphics.textWidth(hint, 2.0)) / 2.0, height / 2.0 + 10.0, 2.0, 0.9, 0.9, 0.9)
    }
}

function drawCrosshair() {
    let cx = Float(graphics.windowWidth()) / 2.0
    let cy = Float(graphics.windowHeight()) / 2.0
    graphics.drawRectangle(cx - 9.0, cy - 1.0, 18.0, 2.0, 1.0, 1.0, 1.0, 0.85)
    graphics.drawRectangle(cx - 1.0, cy - 9.0, 2.0, 18.0, 1.0, 1.0, 1.0, 0.85)
}

// ./craft --screenshot image.png [sunrise|noon|sunset|night] saves one early
// frame of a fresh world and exits.
let screenshot = ""
let startTime = 0.08
let fresh = false
if argumentCount() >= 2 && argument(0) == "--screenshot" {
    screenshot = argument(1)
    fresh = true
    if argumentCount() == 3 {
        if argument(2) == "sunrise" { startTime = 0.0 }
        if argument(2) == "noon" { startTime = 0.25 }
        if argument(2) == "sunset" { startTime = 0.49 }
        if argument(2) == "night" { startTime = 0.7 }
    }
}
if argumentCount() == 1 && argument(0) == "--new" {
    fresh = true
}

graphics.openWindow(1280, 760, "Minyarcraft")
graphics.setTexture(textures.build(), textures.ATLAS_SIZE, textures.ATLAS_SIZE)
// Show a loading screen while the world is prepared. The first call to
// nextFrame starts a frame; the second presents it.
for step in 0..2 {
    graphics.nextFrame()
    graphics.clear(0.1, 0.12, 0.16)
    let message = "Building the world..."
    let size = 3.0
    graphics.drawText(message, (Float(graphics.windowWidth()) - graphics.textWidth(message, size)) / 2.0, Float(graphics.windowHeight()) / 2.0 - 10.0, size, 1.0, 1.0, 1.0)
}
graphics.nextFrame()

let world = terrain.create(20260923)
let loaded = !fresh && save.loadWorld(world)
if !loaded {
    terrain.generate(world)
}
let meshes: List<Integer> = []
let waterMeshes: List<Integer> = []
for chunk in 0..world.dirty.length {
    meshes.add(graphics.createMesh())
    waterMeshes.add(graphics.createMesh())
}
let vertices = Bytes()
let water = Bytes()
remesh(world, meshes, waterMeshes, vertices, water, world.dirty.length)

let sky = atmosphere.create(startTime)
let player = physics.spawn(world)
if loaded {
    save.loadPlayer(player, sky)
}
let hotbar = [blocks.GRASS, blocks.DIRT, blocks.STONE, blocks.COBBLESTONE, blocks.PLANKS, blocks.LOG, blocks.LEAVES, blocks.GLASS, blocks.BRICK]
let selected = 0
let numberKeys = [graphics.KEY_1, graphics.KEY_2, graphics.KEY_3, graphics.KEY_4, graphics.KEY_5, graphics.KEY_6, graphics.KEY_7, graphics.KEY_8, graphics.KEY_9]
let frames = 0
let fps = 0
let nameSeconds = 2.0
let clock = 0.0
let frameNumber = 0
let sinceSave = 0.0
if screenshot == "" {
    graphics.captureMouse(true)
}

while graphics.nextFrame() {
    let seconds = graphics.frameTime()
    frames += 1
    frameNumber += 1
    if screenshot != "" {
        if frameNumber == 30 {
            graphics.saveScreenshot(screenshot)
        } else if frameNumber > 31 {
            graphics.closeWindow()
        }
    }
    clock += seconds
    if clock >= 1.0 {
        fps = frames
        frames = 0
        clock -= 1.0
    }
    nameSeconds -= seconds
    sinceSave += seconds
    if screenshot == "" && sinceSave >= AUTOSAVE_SECONDS {
        save.store(world, player, sky)
        sinceSave = 0.0
    }

    // Input
    let captured = graphics.mouseCaptured()
    if graphics.keyPressed(graphics.KEY_ESCAPE) {
        graphics.captureMouse(false)
        captured = false
    } else if !captured && graphics.mousePressed(graphics.MOUSE_LEFT) {
        graphics.captureMouse(true)
    }
    if captured {
        player.yaw += graphics.mouseMoveX() * MOUSE_SENSITIVITY
        player.pitch = clamp(player.pitch - graphics.mouseMoveY() * MOUSE_SENSITIVITY, -1.55, 1.55)
    }
    let previous = selected
    for index in 0..numberKeys.length {
        if graphics.keyPressed(numberKeys[index]) {
            selected = index
        }
    }
    let scrolled = graphics.scroll()
    if scrolled < 0.0 {
        selected = (selected + 1) % hotbar.length
    } else if scrolled > 0.0 {
        selected = (selected + hotbar.length - 1) % hotbar.length
    }
    if selected != previous {
        nameSeconds = 2.0
    }
    if graphics.keyPressed(graphics.KEY_F) {
        player.flying = !player.flying
        player.velocityY = 0.0
    }
    let timeSpeed = 1.0
    if graphics.keyDown(graphics.KEY_T) {
        timeSpeed = 40.0
    }
    atmosphere.advance(sky, seconds, timeSpeed)

    let forward = axis(graphics.KEY_W, graphics.KEY_S)
    let strafe = axis(graphics.KEY_D, graphics.KEY_A)
    let jump = graphics.keyDown(graphics.KEY_SPACE)
    let shift = graphics.keyDown(graphics.KEY_LEFT_SHIFT)
    physics.update(world, player, seconds, forward, strafe, jump, shift && player.flying, shift && !player.flying)

    // Breaking and placing blocks
    let hit = physics.aim(world, player, REACH)
    if captured && hit.found {
        let aimed = terrain.get(world, hit.x, hit.y, hit.z)
        if graphics.mousePressed(graphics.MOUSE_MIDDLE) && aimed != blocks.BEDROCK {
            // Pick block: put the aimed-at block in the selected hotbar slot.
            hotbar[selected] = aimed
            nameSeconds = 2.0
        }
        if graphics.mousePressed(graphics.MOUSE_LEFT) && blocks.isBreakable(aimed) {
            terrain.set(world, hit.x, hit.y, hit.z, blocks.AIR)
        } else if graphics.mousePressed(graphics.MOUSE_RIGHT) {
            let px = hit.x + hit.normalX
            let py = hit.y + hit.normalY
            let pz = hit.z + hit.normalZ
            let target = terrain.get(world, px, py, pz)
            let placeable = target == blocks.AIR || target == blocks.WATER || blocks.isPlant(target)
            let blocksPlayer = !blocks.isPlant(hotbar[selected]) && physics.occupies(player, px, py, pz)
            if terrain.inside(world, px, py, pz) && placeable && !blocksPlayer {
                terrain.set(world, px, py, pz, hotbar[selected])
            }
        }
    }
    remesh(world, meshes, waterMeshes, vertices, water, CHUNKS_PER_FRAME)

    // Drawing
    let eyeX = player.x
    let eyeY = player.y + physics.EYE_HEIGHT
    let eyeZ = player.z
    let underwater = terrain.get(world, Integer(floor(eyeX)), Integer(floor(eyeY)), Integer(floor(eyeZ))) == blocks.WATER
    graphics.clear(sky.red, sky.green, sky.blue)
    graphics.setCamera(eyeX, eyeY, eyeZ, player.yaw, player.pitch, 75.0)
    atmosphere.draw(sky, eyeX, eyeY, eyeZ)
    if underwater {
        graphics.setFog(0.1 * sky.light, 0.25 * sky.light, 0.6 * sky.light, 1.0, 14.0)
    } else {
        graphics.setFog(sky.red, sky.green, sky.blue, 70.0, 130.0)
    }
    graphics.setLight(sky.light)
    // Chunks entirely beyond the fog are skipped.
    let visible: List<Boolean> = []
    for chunk in 0..meshes.length {
        let centerX = Float((chunk % terrain.CHUNKS_X) * terrain.CHUNK_SIZE) + 8.0
        let centerZ = Float((chunk / terrain.CHUNKS_X) * terrain.CHUNK_SIZE) + 8.0
        let dx = centerX - eyeX
        let dz = centerZ - eyeZ
        let near = dx * dx + dz * dz < DRAW_DISTANCE * DRAW_DISTANCE
        visible.add(near)
        if near {
            graphics.drawMesh(meshes[chunk])
        }
    }
    for chunk in 0..waterMeshes.length {
        if visible[chunk] {
            graphics.drawTranslucentMesh(waterMeshes[chunk], 0.72)
        }
    }
    if hit.found {
        let x = Float(hit.x)
        let y = Float(hit.y)
        let z = Float(hit.z)
        graphics.drawBox(x - 0.002, y - 0.002, z - 0.002, x + 1.002, y + 1.002, z + 1.002, 0.05, 0.05, 0.05)
    }
    if captured || screenshot != "" {
        drawCrosshair()
    }
    drawHotbar(hotbar, selected)
    drawHud(player, sky, fps, blocks.name(hotbar[selected]), nameSeconds, captured || screenshot != "")
}

if screenshot == "" {
    save.store(world, player, sky)
}
