use "io" as io
use "files" as files
use "system" as system
// Keep the world and the player between games, in the user's data directory:
// $XDG_DATA_HOME/minyarcraft, or ~/.local/share/minyarcraft. Without HOME the
// saves go to the working directory.

use "./terrain.min" as terrain
use "./physics.min" as physics
use "./atmosphere.min" as atmosphere

function saveDirectory(): Text {
    let data = system.getenv("XDG_DATA_HOME")
    if data == "" {
        let home = system.getenv("HOME")
        if home == "" {
            return "."
        }
        files.makeDirectory(home + "/.local")
        data = home + "/.local/share"
    }
    files.makeDirectory(data)
    let directory = data + "/minyarcraft"
    if files.makeDirectory(directory) != 0 {
        return "."
    }
    return directory
}

function worldFile(): Text { return saveDirectory() + "/minyarcraft-world.bin" }
function playerFile(): Text { return saveDirectory() + "/minyarcraft-player.bin" }

// Replace a new world's blocks with the saved ones, if a save exists.
public function loadWorld(world: terrain.World): Boolean {
    let path = worldFile()
    if !io.fileExists(path) {
        return false
    }
    let blocks = io.readBytesFile(path)
    if blocks.length != world.blocks.length {
        return false
    }
    world.blocks = blocks
    return true
}

public function loadPlayer(player: physics.Player, sky: atmosphere.Sky) {
    let path = playerFile()
    if io.fileExists(path) {
        let state = io.readBytesFile(path)
        if state.length == 49 {
            player.x = state.getFloat64(0)
            player.y = state.getFloat64(8)
            player.z = state.getFloat64(16)
            player.yaw = state.getFloat64(24)
            player.pitch = state.getFloat64(32)
            sky.time = state.getFloat64(40)
            player.flying = state[48] == 1
        }
    }
}

public function store(world: terrain.World, player: physics.Player, sky: atmosphere.Sky) {
    io.writeBytesFile(worldFile(), world.blocks)
    let state = Bytes()
    state.addFloat64(player.x)
    state.addFloat64(player.y)
    state.addFloat64(player.z)
    state.addFloat64(player.yaw)
    state.addFloat64(player.pitch)
    state.addFloat64(sky.time)
    if player.flying {
        state.add(1)
    } else {
        state.add(0)
    }
    io.writeBytesFile(playerFile(), state)
}
