public constant HALT = 0
public constant PUSH = 1      // followed by an Int64 operand
public constant POP = 2
public constant ADD = 3
public constant SUB = 4
public constant MUL = 5
public constant DIV = 6
public constant DUP = 7
public constant SWAP = 8
public constant JMP = 9       // Int32 target
public constant JZ = 10       // Int32 target
public constant CALL = 11     // Int32 target
public constant RET = 12
public constant LOAD = 13     // UInt8 slot
public constant STORE = 14    // UInt8 slot
public constant PRINT = 15
public constant LT = 16
public constant EQ = 17

public function operandBytes(op: Integer): Integer {
    if op == PUSH { return 8 }
    if op == JMP || op == JZ || op == CALL { return 4 }
    if op == LOAD || op == STORE { return 1 }
    return 0
}
