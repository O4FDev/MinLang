// A tiny stack bytecode VM with a two-pass assembler.
use "process" as process
use "io" as io
use "./asm.min" as asm
use "./machine.min" as machine

function main(): Integer {
    if process.argumentCount() < 1 {
        print("usage: bytecode-vm FILE.asm")
        return 2
    }
    let path = process.argument(0)
    let read = io.readText(path)
    if read is Err(problem) {
        print(problem.describe())
        return 1
    }
    let assembled = asm.assemble(read.unwrap())
    if assembled is Err(problem) {
        print("assembly failed: \(problem)")
        return 1
    }
    let program = assembled.unwrap()
    match machine.run(program, 1000000) {
        Ok(state) { print("halted after \(state.steps) steps") }
        Err(fault) {
            print("vm fault: \(fault)")
            return 3
        }
    }
    return 0
}
