use "ui" as ui
use "ui-macos" as app
use "macos" as mac
use "process" as process

record Harbour { keeper: Text; lights: Integer; shining: Boolean }

function view(harbour: Harbour): ui.View {
    let greeting = "Welcome home, " + harbour.keeper + "."
    let weather = "The harbour is resting."
    if harbour.shining { weather = Text(harbour.lights) + " lights are guiding the boats home." }
    return ui.padded(ui.column([
        ui.heading("A little light in the harbour"),
        ui.label("A native Mac app, described in Minyar."),
        ui.input("keeper", harbour.keeper),
        ui.label(greeting),
        ui.toggle("shining", "Keep the harbour shining", harbour.shining),
        ui.label(weather),
        ui.row([
            ui.button("light", "Light another lantern"),
            ui.button("rest", "Start again"),
        ]),
    ]), 24)
}

public function run() {
    app.initialize("Harbour")
    let harbour = Harbour { keeper: "Ada"; lights: 1; shining: true }
    let window = app.open("Harbour", 540, 360, view(harbour))
    mac.accessibilityLabel(app.handle(window, "keeper"), "Lighthouse keeper")
    mac.autosave(app.windowHandle(window), "Harbour")
    let smoke = process.argumentCount() == 1 && process.argument(0) == "--smoke"
    if smoke {
        let original = app.handle(window, "keeper")
        harbour.lights = 42
        harbour.keeper = "Minyar → AppKit 🙂"
        app.update(window, view(harbour))
        if original != app.handle(window, "keeper") { fail("a value update replaced the native editor") }
        print(app.text(window, "keeper"))
        print("42 lights; native editor retained")
        app.dispose(window)
        return
    }
    while app.nextEvent(window, 0.25) {
        let key = app.eventKey(window)
        let kind = app.eventKind(window)
        if kind == app.ACTION {
            if key == "light" { harbour.lights += 1 }
            if key == "rest" { harbour.lights = 1 }
            if key == "shining" { harbour.shining = app.isChecked(window, key) }
        }
        if kind == app.CHANGE && key == "keeper" {
            harbour.keeper = app.eventText(window)
        }
        // An idle dispatch also asks for a fresh description, so a future hot
        // replacement of this pure view function can keep the running state.
        app.update(window, view(harbour))
    }
    app.dispose(window)
}
