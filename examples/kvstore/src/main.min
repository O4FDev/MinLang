// kvstore DIRECTORY put KEY VALUE | get KEY | delete KEY | list | compact
use "process" as process
use "disk" as disk
use "errors" as errors
use "./store.min" as store

function main(): Integer {
    if process.argumentCount() < 2 {
        print("usage: kvstore DIRECTORY (put KEY VALUE | get KEY | delete KEY | list | compact)")
        return 2
    }
    let opened = store.open(disk.host(), process.argument(0))
    if opened is Err(problem) {
        print(problem.describe())
        return 1
    }
    let db = opened.unwrap()
    if db.recoveredTail > 0 { print("recovered: cut \(db.recoveredTail) torn bytes from the log") }
    let command = process.argument(1)
    let count = process.argumentCount()
    let outcome: Result<Nothing, errors.Error> = Ok()
    if command == "put" && count == 4 {
        outcome = store.put(db, process.argument(2), process.argument(3))
    } else if command == "get" && count == 3 {
        match store.get(db, process.argument(2)) {
            Some(value) { print(value) }
            None { return 1 }
        }
    } else if command == "delete" && count == 3 {
        let deleted = store.delete(db, process.argument(2))
        if deleted is Err(problem) { outcome = Err(problem) } else { print(deleted.unwrap()) }
    } else if command == "list" {
        for key in store.keys(db) { print("\(key)=\(store.get(db, key).unwrap())") }
    } else if command == "compact" {
        outcome = store.compact(db)
    } else {
        print("unknown command: \(command)")
        return 2
    }
    if outcome is Err(problem) {
        print(problem.describe())
        return 1
    }
    return 0
}
