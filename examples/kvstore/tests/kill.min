// Kill a writer process mid-stream (Worker.close sends SIGKILL), then recover
// with the real file system: every acknowledged write must be there, in order.
use "workers" as workers
use "random" as random
use "files" as files
use "text" as text
use "disk" as disk
use "../src/store.min" as store

constant DIRECTORY = "target/kill-test-store"

function ensure(condition: Boolean, message: Text) {
    if !condition { fail(message) }
}

function valueFor(index: Integer): Text { return "value-\(index)-" + "x".repeat(index % 97) }

function writer() {
    let db = store.open(disk.host(), DIRECTORY).unwrap()
    let first = store.keys(db).length
    let index = first
    while true {
        store.put(db, "key\(index)", valueFor(index)).unwrap()
        workers.replyMessage(Bytes(Text(index))).unwrap()
        index += 1
    }
}

function round(number: Integer) {
    let worker = workers.startSelf("writer").unwrap()
    let acknowledged = -1
    let target = 20 + random.bytes(1)[0]
    while acknowledged < target {
        match worker.receive(-1).unwrap() {
            Some(message) {
                acknowledged = text.integer(text.decodeOrStop(message)).unwrap()
            }
            None { fail("the writer exited early") }
        }
    }
    worker.close().unwrap()
    let db = store.open(disk.host(), DIRECTORY).unwrap()
    let count = store.keys(db).length
    ensure(count >= acknowledged + 1, "fewer keys than acknowledged writes")
    for index in 0..count {
        ensure(store.get(db, "key\(index)") == Some(valueFor(index)), "key\(index) is missing or damaged")
    }
    print("round \(number): \(acknowledged + 1) acknowledged, \(count) recovered, \(db.recoveredTail) torn bytes cut")
    store.close(db).unwrap()
}

match workers.currentMode() {
    Some(mode) { writer() }
    None {
        let _ = files.deleteFile(store.logPath(DIRECTORY))
        let _ = files.deleteFile(store.snapshotPath(DIRECTORY))
        for number in 0..3 { round(number) }
        print("kill test passed")
    }
}
