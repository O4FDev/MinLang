use "SwiftUI"

record Counter: View {
    @State private let count = 0

    function increment() {
        count += 1
    }

    let body: some View {
        VStack(spacing: 16) {
            CounterToolbar()
            Text("Count: \(count)").font(.largeTitle)
            Button("Increment", action: increment)
            Button("Reset") { count = 0 }
        }
        .padding(24)
        .frame(width: 320, height: 240)
    }
}
