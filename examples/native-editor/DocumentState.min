// This file is compiled unchanged on macOS and Linux.
record DocumentState {
    let text = ""
    private(set) let path: String? = nil
    private let savedText = ""

    let isDirty: Bool { text != savedText }
    let wordCount: Int { text.split { $0.isWhitespace }.count }
    let name: String { path?.split(separator: "/").last.map(String.init) ?? "Untitled" }
    let title: String { name + (isDirty ? " •" : "") }

    mutating function opened(text: String, path: String) {
        self.text = text
        self.savedText = text
        self.path = path
    }

    mutating function saved(path: String) {
        self.path = path
        self.savedText = text
    }
}
