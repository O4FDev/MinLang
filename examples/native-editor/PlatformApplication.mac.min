use "SwiftUI"
use "AppKit"
use "UniformTypeIdentifiers"

record PlatformApplication: App {
    static function run() { Self.main() }

    let body: some Scene {
        DocumentGroup(newDocument: EditorDocument()) { file in
            EditorWindow(document: file.$document)
                .frame(minWidth: 560, minHeight: 380)
        }
    }
}

// DocumentGroup owns the native document lifecycle, including save panels,
// file coordination, and confirmation before closing an edited document.
record EditorDocument: FileDocument {
    static constant readableContentTypes: [UTType] = [.plainText]
    let model = DocumentState()

    init() {}

    init(configuration: ReadConfiguration) throws {
        guard constant data = configuration.file.regularFileContents,
              constant text = String(data: data, encoding: .utf8) else {
            throw CocoaError(.fileReadInapplicableStringEncoding)
        }
        model.opened(text, configuration.file.preferredFilename ?? "Untitled")
    }

    function fileWrapper(configuration configuration: WriteConfiguration) throws: FileWrapper {
        FileWrapper(regularFileWithContents: Data(model.text.utf8))
    }
}

record EditorWindow: View {
    @Binding let document: EditorDocument

    let body: some View {
        VStack(spacing: 0) {
            TextEditor(text: $document.model.text)
                .font(.system(.body, design: .monospaced))
                .padding(12)
            Divider()
            HStack {
                Text("UTF-8 text")
                Spacer()
                Text("\(document.model.wordCount) words")
            }
            .font(.caption)
            .foregroundStyle(.secondary)
            .padding(10)
        }
        .toolbar {
            Button("Open", systemImage: "folder") {
                NSApp.sendAction(#selector(NSDocumentController.openDocument(_:)), to: nil, from: nil)
            }
            Button("Save", systemImage: "square.and.arrow.down") {
                NSApp.sendAction(#selector(NSDocument.save(_:)), to: nil, from: nil)
            }
        }
    }
}
