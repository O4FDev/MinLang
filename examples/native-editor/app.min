@main
@MainActor
record EditorApp {
    static function main() {
        if CommandLine.arguments.contains("--model-test") {
            let document = DocumentState()
            precondition(!document.isDirty)
            document.text = "Hello from Minyar 🌍"
            precondition(document.isDirty && document.wordCount == 4)
            document.saved("/tmp/example.txt")
            precondition(!document.isDirty && document.name == "example.txt")
            document.text += "\nNative on both platforms."
            precondition(document.isDirty && document.wordCount == 8)
            document.opened("Loaded document", "/tmp/loaded.txt")
            precondition(!document.isDirty && document.wordCount == 2)
            print("shared document model passed")
            return
        }
        PlatformApplication.run()
    }
}
