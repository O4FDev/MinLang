use "httpserver" as http
use "errors" as errors

let server = http.listen("127.0.0.1", 8080, http.defaults())
if !http.ok(server) { fail(errors.message(http.serverError(server))) }
print("HTTP server listening on 127.0.0.1:8080")
let running = true
while running {
    let batch = http.poll(server, -1)
    if errors.isError(http.batchError(batch)) { running = false }
    for request in http.requests(batch) {
        http.respond(server, request, http.response(200, "text/plain", Bytes("hello\n")))
    }
}
http.close(server)
