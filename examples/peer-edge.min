use "peeredge" as edge
use "errors" as errors
function number(text: Text): Integer {
    let value = 0
    if text.length < 1 || text.length > 9 { return -1 }
    for c in text { if c < '0' || c > '9' { return -1 }; value = value * 10 + Integer(c) - 48 }
    return value
}
function main(): Integer {
    if argumentCount() < 1 || argumentCount() > 2 { print("usage: peer-edge configuration.json [duration-ms]"); return 2 }
    let duration = 0
    if argumentCount() == 2 { duration = number(argument(1)); if duration < 1 { print("invalid duration"); return 2 } }
    let result = edge.run(readBytesFile(argument(0)),duration)
    if !errors.booleanOk(result) { print(errors.message(errors.booleanError(result))); return 2 }
    return 0
}
