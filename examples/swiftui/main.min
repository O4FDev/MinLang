// Experimental native target: see docs/swiftui.md for its language boundary.
use "SwiftUI"
use "Observation"
use "AppKit"

@Observable @MainActor
final class Notebook {
    let title = "Native Minyar"
    let note = "A concrete SwiftUI view, authored with Minyar syntax."
    let count = 0
    let showDetails = true

    function increment() {
        count += 1
    }
}

// This remains generic through type checking and SIL specialization.
record Card<Content: View>: View {
    @ViewBuilder constant content: Content

    let body: some View {
        content
            .padding(20)
            .frame(maxWidth: .infinity, alignment: .leading)
            .background(.quaternary, in: RoundedRectangle(cornerRadius: 12))
    }
}

record NotebookView: View {
    @Bindable let notebook: Notebook
    @State private let selection = 0

    let body: some View {
        NavigationSplitView {
            List(selection: $selection) {
                Label("Notebook", systemImage: "note.text").tag(0)
                Label("About", systemImage: "info.circle").tag(1)
            }
            .navigationSplitViewColumnWidth(min: 160, ideal: 180)
        } detail: {
            ScrollView {
                VStack(alignment: .leading, spacing: 20) {
                    if selection == 0 {
                        Text(notebook.title).font(.largeTitle.bold())
                        Card {
                            TextField("Notebook title", text: $notebook.title)
                                .textFieldStyle(.roundedBorder)
                            TextEditor(text: $notebook.note).frame(minHeight: 150)
                            Toggle("Show details", isOn: $notebook.showDetails)
                        }
                        Card {
                            HStack {
                                Image(systemName: "sparkles").foregroundStyle(.tint)
                                Text("Native actions: \(notebook.count)")
                                Spacer()
                                Button("Increment") {
                                    withAnimation { notebook.increment() }
                                }
                                .keyboardShortcut("i", modifiers: [.command])
                            }
                            if notebook.showDetails {
                                Text("State, bindings, observation, generic views, menus and animation use the native compiler and frameworks.")
                                    .font(.callout).foregroundStyle(.secondary)
                            }
                        }
                    } else {
                        Text("Minyar + SwiftUI").font(.largeTitle.bold())
                        Text("Experimental native compiler target. No Minyar UI runtime or AnyView renderer.")
                        Text("Language and tooling support remain experimental.")
                            .foregroundStyle(.secondary)
                    }
                }
                .padding(24)
            }
        }
        .frame(minWidth: 720, minHeight: 480)
    }
}

@main
record NativeNotebookApp: App {
    @State private let notebook = Notebook()

    let body: some Scene {
        WindowGroup("Minyar Notebook") {
            NotebookView(notebook: notebook)
                .task {
                    if CommandLine.arguments.contains("--smoke") {
                        // This task runs only after SwiftUI mounts the scene.
                        precondition(!NSApplication.shared.windows.isEmpty)
                        notebook.increment()
                        notebook.title = "Minyar → SwiftUI 🙂"
                        notebook.note = "Native observation and binding"
                        notebook.showDetails = false
                        try? await Task.sleep(for: .milliseconds(100))
                        precondition(notebook.count == 1)
                        precondition(notebook.title == "Minyar → SwiftUI 🙂")
                        print("swiftui scene mounted; native state updated")
                        NSApplication.shared.terminate(nil)
                    }
                }
        }
        .commands {
            CommandMenu("Notebook") {
                Button("Increment") { notebook.increment() }
                    .keyboardShortcut("i", modifiers: [.command])
                Toggle("Show Details", isOn: $notebook.showDetails)
            }
        }
        Settings {
            @Bindable let settings = notebook
            Form {
                TextField("Default title", text: $settings.title)
                Toggle("Show details", isOn: $settings.showDetails)
            }.padding(24).frame(width: 360)
        }
    }
}
