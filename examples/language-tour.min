function double(value: Integer): Integer {
    return value * 2
}

function shouldNotRun(): Boolean {
    print("short-circuiting failed")
    return true
}

function main() {
    let answer = double(21)
    let correct: Boolean = answer == 42
    let textMatches = "Minyar" == "Minyar"
    let skipped = false && shouldNotRun()

    if correct && textMatches && !skipped {
        print("The answer is")
        print(answer)
    } else {
        print("Something went wrong")
    }

    let countdown = 3
    while countdown > 0 {
        print(countdown)
        countdown = countdown - 1
    }
}
