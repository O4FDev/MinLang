// Graph edges are identifiers into a list, so logical cycles need no
// recursive record shapes or memory-management annotations.
record Node {
    label: Text
    neighbours: List<Integer>
}

let nodes: List<Node> = []
let firstEdges: List<Integer> = []
let secondEdges: List<Integer> = []
nodes.add(Node { label: "first"; neighbours: firstEdges })
nodes.add(Node { label: "second"; neighbours: secondEdges })
firstEdges.add(1)
secondEdges.add(0)

let next = nodes[0].neighbours[0]
print(nodes[next].label)
let back = nodes[next].neighbours[0]
print(nodes[back].label)
