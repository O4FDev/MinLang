// Ask Atacama a question from the command line.
//
//     ./minyar examples/atacama/main.min -o build/ask
//     ATACAMA_API_KEY=... build/ask "Where is the Atacama desert?"
//
// The server's address defaults to the local server Minyar OS uses.
use "http" as http
use "json" as json

function main(): Integer {
    if argumentCount() < 1 {
        print("usage: ask QUESTION [URL] [KEY]")
        return 2
    }
    let question = argument(0)
    let url = "http://127.0.0.1:8080"
    if argumentCount() > 1 { url = argument(1) }
    let key = "minyar-local"
    if argumentCount() > 2 { key = argument(2) }
    let health = http.get(url + "/health", [])
    if health.error != "" {
        print("Atacama is not reachable at " + url + ": " + health.error)
        return 1
    }
    let model = json.parse(health.body)
    print("Atacama " + json.string(model, "checkpoint") + ", " + json.string(model, "parameters") + " parameters")
    let response = http.post(url + "/ask", ["Content-Type: application/json", "Authorization: Bearer " + key], "{\"question\": " + json.quote(question) + "}")
    if response.status != 200 {
        print("Atacama answered " + Text(response.status) + " " + response.reason + ": " + response.body + response.error)
        return 1
    }
    let answer = json.parse(response.body)
    print(json.string(answer, "answer"))
    let sources = json.member(answer, "sources")
    for source in sources.items {
        print("  " + json.string(source, "title") + " " + json.string(source, "url"))
    }
    return 0
}
