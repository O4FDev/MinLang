record Person {
    name: Text
    age: Integer
}

record Team {
    name: Text
    leader: Person
    members: List<Person>
}

function describe(person: Person): Text {
    return person.name + " is " + Text(person.age)
}

function main() {
    let ada = Person {
        name: "Ada"
        age: 36
    }
    let grace = Person {
        age: 85
        name: "Grace"
    }

    let people: List<Person> = []
    people.add(ada)
    people.add(grace)

    let languageTeam = Team {
        name: "Minyar"
        leader: ada
        members: people
    }

    print(languageTeam.name)
    print(describe(languageTeam.leader))
    print(languageTeam.members[1].name)
}
