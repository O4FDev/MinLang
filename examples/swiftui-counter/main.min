use "SwiftUI"

record CounterView: View {
    @State private let count = 0

    let body: some View {
        VStack(spacing: 16) {
            Text("Count: \(count)")
                .font(.largeTitle)

            Button("Increment") {
                count += 1
            }

            Button("Reset") {
                count = 0
            }
        }
        .padding(24)
        .frame(width: 320, height: 220)
    }
}

@main
record CounterApp: App {
    let body: some Scene {
        WindowGroup("Minyar Counter") {
            CounterView()
        }
    }
}
