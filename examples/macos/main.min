// A native macOS notes app: all UI construction and behavior is Minyar.
use "macos" as mac

mac.initialize("Minyar Notes")
let window = mac.window("Minyar Notes", 640, 460)
let layout = mac.column(window, 12)
mac.padding(layout, 20)
let title = mac.label(layout, "A native Mac app, written in Minyar")
let editor = mac.textEditor(layout, "Hello from Minyar!\n\nEdit this note, then save it with Command-S.")
mac.size(editor, 600, 280)
let buttons = mac.row(layout, 8)
let open = mac.button(buttons, "Open…")
let save = mac.button(buttons, "Save…")
let clear = mac.button(buttons, "Clear")
let status = mac.label(layout, "Ready")
let file = mac.menu("File")
let openItem = mac.menuItem(file, "Open…", "o")
let saveItem = mac.menuItem(file, "Save…", "s")
mac.show(window)

// A bounded launch path for automated tests; ordinary launches stay interactive.
let smoke = false
if argumentCount() > 0 {
    smoke = argument(0) == "--smoke"
}
if smoke {
    mac.setText(editor, "Minyar → AppKit 🙂")
    print(mac.text(editor))
    mac.quit()
}
while mac.nextEvent(0.1) {
    let kind = mac.eventType()
    let source = mac.eventSource()
    if kind == mac.ACTION {
        if source == open || source == openItem {
            let path = mac.openFile("Open a note")
            if path != "" {
                mac.setText(editor, readTextFile(path))
                mac.setText(status, "Opened " + path)
            }
        }
        if source == save || source == saveItem {
            let path = mac.saveFile("Save your note", "Note.txt")
            if path != "" {
                writeTextFile(path, mac.text(editor))
                mac.setText(status, "Saved " + path)
            }
        }
        if source == clear {
            mac.setText(editor, "")
            mac.setText(status, "Cleared")
        }
    }
    if kind == mac.CHANGE && source == editor {
        mac.setText(status, Text(mac.eventText().length) + " characters — unsaved")
    }
    if kind == mac.CLOSED && source == window {
        mac.quit()
    }
}
mac.destroy(window)
