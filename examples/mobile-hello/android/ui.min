use "ui" as ui
use "ui-android" as app
use "android" as android
use "../model.min" as garden

function main() {
    let model = garden.create()
    app.run("Minyar", function(): ui.View {
        return ui.padded(ui.spaced(ui.column([
            ui.heading("Hello from Minyar"),
            ui.label("A native app. A few ordinary words."),
            ui.input("name", model.name),
            ui.toggle("welcome", "Say hello", model.welcome),
            ui.label(garden.greeting(model)),
            ui.label(garden.lights(model)),
            ui.button("light", "Send a little light")
        ]), 20), 24)
    }, function(event: android.Event) {
        garden.update(model, event.key, event.text, event.checked)
    })
}
