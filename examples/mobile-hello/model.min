public record Model { visits: Integer; name: Text; welcome: Boolean }

public function create(): Model {
    return Model { visits: 0; name: "Ada"; welcome: true }
}
public function greeting(model: Model): Text {
    if !model.welcome { return "A little quiet, a little light." }
    return "Hello, \(model.name)!"
}
public function lights(model: Model): Text {
    return "You have sent \(model.visits) little lights."
}
public function update(model: Model, key: Text, text: Text, checked: Boolean) {
    if key == "light" { model.visits += 1 }
    else if key == "name" { model.name = text }
    else if key == "welcome" { model.welcome = checked }
}
