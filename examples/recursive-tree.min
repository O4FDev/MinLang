// Recursive types need no ownership annotations. Build structural Lists with
// literals; mutations that could create reference cycles are rejected.
record Node {
    value: Integer
    children: List<Node>
}

function tree(depth: Integer): Node {
    if depth == 0 {
        return Node { value: 1; children: [] }
    }
    // The same subtree can safely appear twice: both references keep it alive.
    let child = tree(depth - 1)
    return Node { value: 1; children: [child, child] }
}

function total(node: Node): Integer {
    let result = node.value
    let position = 0
    while position < node.children.length {
        result = result + total(node.children[position])
        position = position + 1
    }
    return result
}

let root = tree(5)
print(total(root)) // 63
let saved = root.children[0]
root = Node { value: 7; children: [] }
print(total(root))  // 7
print(total(saved)) // 31: the saved subtree survives replacing the root.
