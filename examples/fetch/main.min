use "process" as processInfo
// Fetch a URL over HTTP or HTTPS and print the response.
//
//     ./minyar examples/fetch/main.min -o build/fetch
//     build/fetch https://en.wikipedia.org/api/rest_v1/page/summary/Atacama_Desert
use "http" as http
use "text" as text
use "errors" as errors

function main(): Integer {
    if processInfo.argumentCount() < 1 {
        print("usage: fetch URL")
        return 2
    }
    let response = http.get(processInfo.argument(0), ["User-Agent: Minyar/1.0 (https://github.com/minyar)", "Accept: */*"])
    if response.error != "" {
        print("failed: " + response.error)
        return 1
    }
    print(Text(response.status) + " " + response.reason)
    for header in response.headers { print(header) }
    print("")
    match text.decode(response.body) {
        Ok(body) { print(body) }
        Err(error) {
            print(Text(response.body.length) + " binary bytes: " + errors.message(error))
        }
    }
    return 0
}
