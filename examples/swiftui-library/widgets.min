// Public native types can be imported by Swift or another native Minyar module.
use "SwiftUI"

public record NativeBadge<Value: CustomStringConvertible & Sendable>: View {
    public constant value: Value

    public init(value: Value) {
        self.value = value
    }

    public let body: some View {
        Text(value.description)
            .font(.headline)
            .padding(8)
            .background(.quaternary, in: RoundedRectangle(cornerRadius: 8))
    }
}

public record NativeCounter: View {
    @Binding private let count: Int

    public init(count: Binding<Int>) {
        self._count = count
    }

    public let body: some View {
        Button("Count: \(count)") { count += 1 }
    }
}

public protocol NativeValue {
    associatedtype Value
    function read(): Value
}

public record NativeBox<Value>: NativeValue {
    public constant value: Value
    public init(value: Value) { self.value = value }
    public function read(): Value { value }
}

@inlinable
public function nativeSum<T: BinaryInteger>(values: [T]): T {
    let total: T = 0
    for value in values { total += value }
    return total
}
