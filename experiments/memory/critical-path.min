// Storage is prepared by the test harness before either critical path starts.
// Prices are integer ticks; this is a runtime fixture, not a trading strategy.
record CriticalPair {
    x: Integer
    y: Integer
}

function criticalArithmetic(count: Integer, seed: Integer): Integer {
    let state = seed
    let total = 0
    let position = 0
    while position < count {
        state = (state * 17 + 23) % 1000003
        total = (total + state) % 1000003
        position = position + 1
    }
    return total
}

function criticalBook(values: List<Integer>, count: Integer, seed: Integer): Integer {
    let state = seed
    let total = 0
    let position = 0
    while position < count {
        state = (state * 17 + 23) % 1000003
        let index = state % values.length
        values[index] = state
        total = (total + values[index]) % 1000003
        position = position + 1
    }
    return total
}

// These immutable records do not escape an iteration. The benchmark reveals
// whether the compiler can eliminate their allocation; it does not assume so.
function criticalRecords(count: Integer, seed: Integer): Integer {
    let state = seed
    let total = 0
    let position = 0
    while position < count {
        state = (state * 17 + 23) % 1000003
        let pair = CriticalPair { x: state, y: total }
        total = (pair.x + pair.y) % 1000003
        position = position + 1
    }
    return total
}
