// Native setup selects the language and workload outside the measured function.
// The four paths expose checked shifts, Unicode conversion, finite projection,
// and amplitude clamping. They retain ordinary arithmetic/bounds diagnostics.
function checkedScalarShift(count: Integer, seed: Integer): Integer {
    let state = seed
    let total = 0
    let position = 0
    while position < count {
        let amount = state & 31
        state = ((state << amount) ^ (state >> (31 - amount))) & 2147483647
        state = wrappingAdd(state, 17) & 2147483647
        total = wrappingAdd(total, state)
        position = position + 1
    }
    return total
}
function checkedScalarCharacter(count: Integer, seed: Integer): Integer {
    let state = seed
    let total = 0
    let position = 0
    while position < count {
        state = (state * 17 + 23) % 1000003
        let character = Character(state % 55296)
        total = (total + Integer(character)) % 1000003
        position = position + 1
    }
    return total
}
function checkedScalarFloat(count: Integer, seed: Integer): Integer {
    let state = seed
    let total = 0
    let position = 0
    while position < count {
        state = (state * 17 + 23) % 1000003
        let coordinate = (Float(state) - 500001.0) * 0.25
        total = wrappingAdd(total, Integer(coordinate))
        position = position + 1
    }
    return total
}
function checkedScalarAbsClamp(count: Integer, seed: Integer): Integer {
    let state = seed
    let total = 0
    let position = 0
    while position < count {
        state = (state * 17 + 23) % 1000003
        let amplitude = clamp(abs(state - 500001), 0, 250000)
        total = wrappingAdd(total, amplitude)
        position = position + 1
    }
    return total
}

// Keep the compiler's normal entry point and call the native driver through
// the supported package ABI; the harness never rewrites generated LLVM.
function runScalarStudy(): Integer { native "checked_scalars" }
exit(runScalarStudy())
