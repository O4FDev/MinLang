use "process" as processInfo

function shifted(value: Integer): Integer { return value * 3 + 1 }
function selected(value: Integer): Boolean { return value % 2 == 0 }
function combined(total: Integer, value: Integer): Integer { return total + value }

function immediate(values: List<Integer>): Integer {
    let total = 0
    for value in values.map(shifted).filter(selected) {
        total = combined(total, value)
    }
    return total
}

function handwritten(values: List<Integer>): Integer {
    let total = 0
    for item in values {
        let value = shifted(item)
        if selected(value) { total = combined(total, value) }
    }
    return total
}

function number(text: Text): Integer {
    if text.length == 0 { return -1 }
    let value = 0
    for digit in text {
        if digit < '0' || digit > '9' || value > 10000000 { return -1 }
        value = value * 10 + Integer(digit) - 48
    }
    return value
}

// One selected variant per process. Bounds also keep checked arithmetic safe.
function main(): Integer {
    if processInfo.argumentCount() != 4 {
        print("usage: scalar i|h count repeats seed")
        return 2
    }
    let variant = processInfo.argument(0)
    let count = number(processInfo.argument(1))
    let repeats = number(processInfo.argument(2))
    let seed = number(processInfo.argument(3))
    if variant != "i" && variant != "h" { return 2 }
    if count < 16 || count > 16384 || repeats < 1 || repeats > 65536 || seed < 0 || seed > 1048575 { return 2 }
    if count * repeats > 67108864 { return 2 }
    let values: List<Integer> = []
    for position in 0..count { values.add((seed + position * 17) % 1024) }
    let checksum = 0
    if variant == "i" {
        for round in 0..repeats {
            let slot = round % count
            values[slot] = (values[slot] + 1) % 1024
            checksum = checksum + immediate(values)
        }
    } else {
        for round in 0..repeats {
            let slot = round % count
            values[slot] = (values[slot] + 1) % 1024
            checksum = checksum + handwritten(values)
        }
    }
    print(checksum)
    return 0
}
