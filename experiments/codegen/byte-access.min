// Storage and repetitions belong to the native harness, outside these kernels.
// The second argument gives every kernel the same direct-call signature.
function codegenByteSum(source: Bytes, ignored: Bytes): Integer {
    let total = 0
    let index = 0
    while index < source.length {
        total += source[index]
        index += 1
    }
    return total
}

function codegenByteCopy(source: Bytes, target: Bytes): Integer {
    if source.length != target.length { fail("byte copy lengths differ") }
    let index = 0
    while index < source.length {
        target[index] = source[index]
        index += 1
    }
    return target.length
}

function codegenIntegerListSum(source: List<Integer>, ignored: List<Integer>): Integer {
    let total = 0
    let index = 0
    while index < source.length {
        total += source[index]
        index += 1
    }
    return total
}
