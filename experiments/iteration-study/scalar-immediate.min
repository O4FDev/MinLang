use "process" as processInfo

function shifted(value: Integer): Integer { return value * 3 + 1 }
function selected(value: Integer): Boolean { return value % 2 == 0 }
function combined(total: Integer, value: Integer): Integer { return total + value }

function fused(values: List<Integer>): Integer {
    let total = 0
    for value in values.map(shifted).filter(selected) {
        total = combined(total, value)
    }
    return total
}

function handwritten(values: List<Integer>): Integer {
    let total = 0
    for item in values {
        let mapped = shifted(item)
        if selected(mapped) { total = combined(total, mapped) }
    }
    return total
}

let values: List<Integer> = []
for position in 0..64 + processInfo.argumentCount() { values.add(position) }
print(fused(values))
print(handwritten(values))
