use "json" as json
use "process" as processInfo

// Runtime input keeps the benchmark's work observable. Each
// body verifies its result; setup and the application entry are not measured.
global displacement: Integer = processInfo.argumentCount()
global values: List<Integer> = [81 + displacement, 3 + displacement, 17 + displacement, 2 + displacement, 34 + displacement, 5 + displacement, 55 + displacement, 8 + displacement, 21 + displacement, 13 + displacement, 1 + displacement]

function source(): Text {
    if processInfo.argumentCount() > 0 { return processInfo.argument(0) }
    return "harbour"
}

bench "List.sorted preserves the input" {
    let ordered = values.sorted()
    if ordered[0] != 1 + displacement || ordered[ordered.length - 1] != 81 + displacement || values[0] != 81 + displacement { fail("sorting changed its input or order") }
}

bench "Text search across Unicode" {
    let sentence = source() + ": café under the moon 🌙"
    if sentence.find("café") < 0 || sentence.find("🌙") < 0 { fail("Text search missed Unicode content") }
}

bench "JSON parse and inspect" {
    let document = json.parse("{\"harbour\":\"" + source() + "\",\"lights\":[3,5,8,13]}")
    let lights = json.member(document, "lights")
    if document.kind != json.OBJECT || lights.items.length != 4 || lights.items[3].number != 13.0 { fail("JSON parser changed the harbour") }
}
