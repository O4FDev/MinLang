use "process" as processInfo
// A small HTTP JSON service loop: parse request lines, look up a user record
// in a Map and format a JSON response with interpolation.
record User { id: Integer; name: Text; email: Text; age: Integer; score: Integer }
let users: Map<Integer, User> = Map()
for id in 0..10000 {
    users[id * 7] = User { id: id * 7; name: "user\(id)"; email: "user\(id)@example.com"; age: 18 + id % 60; score: (id * 7919) % 100000 }
}
let bytes = 0
let found = 0
let seed = 42
let requests = Integer(processInfo.argument(0))
for request in 0..requests {
    seed = (seed * 1103515245 + 12345) % 2147483648
    let line = "GET /users/\(seed % 80000) HTTP/1.1"
    let parts = line.split(" ")
    let path = parts[1]
    if !path.startsWith("/users/") { continue }
    let id = Integer(path.slice(7, path.length))
    let response = "{\"error\":\"not found\",\"id\":\(id)}"
    if users.has(id) {
        let user = users[id]
        response = "{\"id\":\(user.id),\"name\":\"\(user.name)\",\"email\":\"\(user.email)\",\"age\":\(user.age),\"score\":\(user.score)}"
        found += 1
    }
    bytes += response.byteLength
}
print(found)
print(bytes)
