use "process" as processInfo
// Mandelbrot escape counts over a grid, computed by a parallel loop, then
// summarised sequentially: total iterations, points inside, a row checksum and
// a histogram of escape times.
constant LIMIT = 256

parallel function escapeTime(index: Integer, width: Integer, height: Integer): Integer {
    let x = Float(index % width) / Float(width) * 3.0 - 2.2
    let y = Float(index / width) / Float(height) * 2.4 - 1.2
    let real = 0.0
    let imaginary = 0.0
    let iterations = 0
    while real * real + imaginary * imaginary <= 4.0 && iterations < LIMIT {
        let next = real * real - imaginary * imaginary + x
        imaginary = 2.0 * real * imaginary + y
        real = next
        iterations += 1
    }
    return iterations
}

let width = Integer(processInfo.argument(0))
let height = width * 2 / 3
let counts: List<Integer> = []
for index in 0..(width * height) { counts.add(0) }
parallel for index in 0..counts.length {
    counts[index] = escapeTime(index, width, height)
}

let total = 0
let inside = 0
let rows = 0
let histogram: List<Integer> = []
for bucket in 0..8 { histogram.add(0) }
for y in 0..height {
    let row = 0
    for x in 0..width {
        let count = counts[y * width + x]
        row += count
        if count == LIMIT { inside += 1 } else { histogram[count * 8 / LIMIT] += 1 }
    }
    total += row
    rows = (rows * 31 + row) % 1000000007
}
print("total \(total)")
print("inside \(inside)")
print("rows \(rows)")
for bucket in 0..8 { print("escape \(bucket) \(histogram[bucket])") }
