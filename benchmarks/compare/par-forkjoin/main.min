use "process" as processInfo
// Recursive fork-join with `join`: Fibonacci with a serial cutoff, then a
// divide-and-conquer sum over a read-only List, both on the work-stealing pool.
constant CUTOFF = 25
constant LEAF = 4096

parallel function fibSerial(n: Integer): Integer {
    if n < 2 { return n }
    return fibSerial(n - 1) + fibSerial(n - 2)
}

parallel function fib(n: Integer): Integer {
    if n < CUTOFF { return fibSerial(n) }
    let left, right = join(fib(n - 1), fib(n - 2))
    return left + right
}

parallel function mix(seed: Integer): Integer {
    let value = seed
    for round in 0..4 {
        value = value ^ (value >> 31)
        value = wrappingMultiply(value, 0x2545F4914F6CDD1D)
        value = value ^ (value >> 29)
        value = wrappingAdd(value, round)
    }
    return value
}

parallel function total(values: List<Integer>, first: Integer, after: Integer): Integer {
    if after - first <= LEAF {
        let sum = 0
        for index in first..after { sum += values[index] }
        return sum
    }
    let middle = first + (after - first) / 2
    let low, high = join(total(values, first, middle), total(values, middle, after))
    return low + high
}

let n = Integer(processInfo.argument(0))
print("fib \(n) \(fib(n))")
let count = n * 262144
let values: List<Integer> = []
for index in 0..count { values.add((mix(index) >> 40) & 65535) }
print("sum \(count) \(total(values, 0, count))")
