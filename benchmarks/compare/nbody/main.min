use "math" as math
// N-body simulation: Float fields of records held in a List.
record Body { x: Float; y: Float; z: Float; vx: Float; vy: Float; vz: Float; mass: Float }
let pi = 3.141592653589793
let solarMass = 4.0 * pi * pi
let daysPerYear = 365.24
let bodies = [
    Body { x: 0.0; y: 0.0; z: 0.0; vx: 0.0; vy: 0.0; vz: 0.0; mass: solarMass },
    Body { x: 4.84143144246472090e+00; y: -1.16032004402742839e+00; z: -1.03622044471123109e-01; vx: 1.66007664274403694e-03 * daysPerYear; vy: 7.69901118419740425e-03 * daysPerYear; vz: -6.90460016972063023e-05 * daysPerYear; mass: 9.54791938424326609e-04 * solarMass },
    Body { x: 8.34336671824457987e+00; y: 4.12479856412430479e+00; z: -4.03523417114321381e-01; vx: -2.76742510726862411e-03 * daysPerYear; vy: 4.99852801234917238e-03 * daysPerYear; vz: 2.30417297573763929e-05 * daysPerYear; mass: 2.85885980666130812e-04 * solarMass },
    Body { x: 1.28943695621391310e+01; y: -1.51111514016986312e+01; z: -2.23307578892655734e-01; vx: 2.96460137564761618e-03 * daysPerYear; vy: 2.37847173959480950e-03 * daysPerYear; vz: -2.96589568540237556e-05 * daysPerYear; mass: 4.36624404335156298e-05 * solarMass },
    Body { x: 1.53796971148509165e+01; y: -2.59193146099879641e+01; z: 1.79258772950371181e-01; vx: 2.68067772490389322e-03 * daysPerYear; vy: 1.62824170038242295e-03 * daysPerYear; vz: -9.51592254519715870e-05 * daysPerYear; mass: 5.15138902046611451e-05 * solarMass }
]
function energy(bodies: List<Body>): Float {
    let e = 0.0
    for i in 0..bodies.length {
        let b = bodies[i]
        e = e + 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        for j in (i + 1)..bodies.length {
            let o = bodies[j]
            let dx = b.x - o.x
            let dy = b.y - o.y
            let dz = b.z - o.z
            e = e - b.mass * o.mass / math.sqrt(dx * dx + dy * dy + dz * dz)
        }
    }
    return e
}
function advance(bodies: List<Body>, dt: Float) {
    for i in 0..bodies.length {
        let b = bodies[i]
        for j in (i + 1)..bodies.length {
            let o = bodies[j]
            let dx = b.x - o.x
            let dy = b.y - o.y
            let dz = b.z - o.z
            let d2 = dx * dx + dy * dy + dz * dz
            let magnitude = dt / (d2 * math.sqrt(d2))
            b.vx = b.vx - dx * o.mass * magnitude
            b.vy = b.vy - dy * o.mass * magnitude
            b.vz = b.vz - dz * o.mass * magnitude
            o.vx = o.vx + dx * b.mass * magnitude
            o.vy = o.vy + dy * b.mass * magnitude
            o.vz = o.vz + dz * b.mass * magnitude
        }
    }
    for b in bodies {
        b.x = b.x + dt * b.vx
        b.y = b.y + dt * b.vy
        b.z = b.z + dt * b.vz
    }
}
let px = 0.0
let py = 0.0
let pz = 0.0
for b in bodies { px = px + b.vx * b.mass; py = py + b.vy * b.mass; pz = pz + b.vz * b.mass }
bodies[0].vx = 0.0 - px / solarMass
bodies[0].vy = 0.0 - py / solarMass
bodies[0].vz = 0.0 - pz / solarMass
print(Integer(energy(bodies) * 1000000000.0))
for step in 0..5000000 { advance(bodies, 0.01) }
print(Integer(energy(bodies) * 1000000000.0))
