use "process" as processInfo
// Nested List<List<Integer>> grid: Game of Life generations, then breadth-first
// shortest paths and connected components over the cells left open.
record Search { reached: Integer; total: Integer; target: Integer }
record Components { count: Integer; largest: Integer }

function makeGrid(side: Integer, fill: Integer): List<List<Integer>> {
    let grid: List<List<Integer>> = []
    for y in 0..side {
        let row: List<Integer> = []
        for x in 0..side { row.add(fill) }
        grid.add(row)
    }
    return grid
}

function liveNeighbours(cells: List<List<Integer>>, y: Integer, x: Integer): Integer {
    let side = cells.length
    let count = 0
    for ny in (y - 1)..(y + 2) {
        if ny < 0 || ny >= side { continue }
        for nx in (x - 1)..(x + 2) {
            if nx < 0 || nx >= side || (ny == y && nx == x) { continue }
            count += cells[ny][nx]
        }
    }
    return count
}

function step(cells: List<List<Integer>>): List<List<Integer>> {
    let side = cells.length
    let next: List<List<Integer>> = []
    for y in 0..side {
        let row: List<Integer> = []
        for x in 0..side {
            let around = liveNeighbours(cells, y, x)
            if around == 3 || (around == 2 && cells[y][x] == 1) { row.add(1) } else { row.add(0) }
        }
        next.add(row)
    }
    return next
}

function countAlive(cells: List<List<Integer>>): Integer {
    let alive = 0
    for row in cells { for cell in row { alive += cell } }
    return alive
}

constant STEP_Y = [0, 1, 0, -1]
constant STEP_X = [1, 0, -1, 0]

function shortestPaths(walls: List<List<Integer>>): Search {
    let side = walls.length
    let distance = makeGrid(side, -1)
    let queue: List<Integer> = [0]
    distance[0][0] = 0
    let head = 0
    let total = 0
    while head < queue.length {
        let at = queue[head]
        head += 1
        let y = at / side
        let x = at % side
        let here = distance[y][x]
        total += here
        for k in 0..4 {
            let ny = y + STEP_Y[k]
            let nx = x + STEP_X[k]
            if ny >= 0 && ny < side && nx >= 0 && nx < side && walls[ny][nx] == 0 && distance[ny][nx] < 0 {
                distance[ny][nx] = here + 1
                queue.add(ny * side + nx)
            }
        }
    }
    return Search { reached: queue.length; total: total; target: distance[side - 1][side - 1] }
}

function components(walls: List<List<Integer>>): Components {
    let side = walls.length
    let label = makeGrid(side, 0)
    let count = 0
    let largest = 0
    let queue: List<Integer> = []
    for startY in 0..side {
        for startX in 0..side {
            if walls[startY][startX] == 1 || label[startY][startX] != 0 { continue }
            count += 1
            label[startY][startX] = count
            queue.truncate(0)
            queue.add(startY * side + startX)
            let head = 0
            while head < queue.length {
                let at = queue[head]
                head += 1
                let y = at / side
                let x = at % side
                for k in 0..4 {
                    let ny = y + STEP_Y[k]
                    let nx = x + STEP_X[k]
                    if ny >= 0 && ny < side && nx >= 0 && nx < side && walls[ny][nx] == 0 && label[ny][nx] == 0 {
                        label[ny][nx] = count
                        queue.add(ny * side + nx)
                    }
                }
            }
            if queue.length > largest { largest = queue.length }
        }
    }
    return Components { count: count; largest: largest }
}

let side = Integer(processInfo.argument(0))
let seed = 2024
let cells: List<List<Integer>> = []
for y in 0..side {
    let row: List<Integer> = []
    for x in 0..side {
        seed = (seed * 1103515245 + 12345) % 2147483648
        if (seed / 65536) % 3 == 0 { row.add(1) } else { row.add(0) }
    }
    cells.add(row)
}
let checksum = 0
for generation in 0..12 {
    cells = step(cells)
    checksum = (checksum * 31 + countAlive(cells)) % 1000000007
}
print(checksum)
print(countAlive(cells))
cells[0][0] = 0
cells[side - 1][side - 1] = 0
let search = shortestPaths(cells)
print("\(search.reached) \(search.total) \(search.target)")
let parts = components(cells)
print("\(parts.count) \(parts.largest)")
