use "io" as io
use "process" as processInfo
// Lexer for a small C-like language: turn source text into a List of tokens,
// then report counts per kind, the most frequent identifiers and a checksum.

choice TokenKind { Identifier Keyword Number Str Operator Comment }

record Token { kind: TokenKind; text: Text; line: Integer; width: Integer }
record Frequency { name: Text; count: Integer }

function isLetter(c: Character): Boolean {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

function isDigit(c: Character): Boolean { return c >= '0' && c <= '9' }

function kindIndex(kind: TokenKind): Integer {
    return match kind {
        Identifier { 0 }
        Keyword { 1 }
        Number { 2 }
        Str { 3 }
        Operator { 4 }
        Comment { 5 }
    }
}

function tokenize(source: Text, keywords: Set<Text>): List<Token> {
    let twoCharacterOperators: Set<Text> = Set()
    for op in ["==", "!=", "<=", ">=", "&&", "||", "->"] { twoCharacterOperators.add(op) }
    let tokens: List<Token> = []
    let line = 1
    let i = 0
    let length = source.length
    while i < length {
        let c = source[i]
        if c == '\n' {
            line += 1
            i += 1
        } else if c == ' ' || c == '\t' || c == '\r' {
            i += 1
        } else if isLetter(c) {
            let start = i
            while i < length && (isLetter(source[i]) || isDigit(source[i])) { i += 1 }
            let word = source.slice(start, i)
            let kind = TokenKind.Identifier
            if keywords.contains(word) { kind = TokenKind.Keyword }
            tokens.add(Token { kind: kind; text: word; line: line; width: i - start })
        } else if isDigit(c) {
            let start = i
            while i < length && isDigit(source[i]) { i += 1 }
            tokens.add(Token { kind: TokenKind.Number; text: source.slice(start, i); line: line; width: i - start })
        } else if c == '"' {
            let start = i
            i += 1
            let value = ""
            while i < length && source[i] != '"' {
                if source[i] == '\\' && i + 1 < length {
                    let escaped = source[i + 1]
                    if escaped == 'n' { value = value + "\n" } else { value = value + Text(escaped) }
                    i += 2
                } else {
                    value = value + Text(source[i])
                    i += 1
                }
            }
            i += 1
            tokens.add(Token { kind: TokenKind.Str; text: value; line: line; width: i - start })
        } else if c == '/' && i + 1 < length && source[i + 1] == '/' {
            let start = i
            while i < length && source[i] != '\n' { i += 1 }
            tokens.add(Token { kind: TokenKind.Comment; text: source.slice(start, i); line: line; width: i - start })
        } else {
            let width = 1
            if i + 1 < length && twoCharacterOperators.contains(source.slice(i, i + 2)) { width = 2 }
            tokens.add(Token { kind: TokenKind.Operator; text: source.slice(i, i + width); line: line; width: width })
            i += width
        }
    }
    return tokens
}

let source = io.readTextFile(processInfo.argument(0))
let keywords: Set<Text> = Set()
for word in ["let", "if", "else", "while", "return", "function", "for", "in"] { keywords.add(word) }
let tokens = tokenize(source, keywords)

let counts = [0, 0, 0, 0, 0, 0]
let identifiers: Map<Text, Integer> = Map()
let numberSum = 0
let stringBytes = 0
let checksum = 0
for token in tokens {
    let kind = kindIndex(token.kind)
    counts[kind] += 1
    match token.kind {
        Identifier {
            if identifiers.has(token.text) { identifiers[token.text] += 1 } else { identifiers[token.text] = 1 }
        }
        Number { numberSum = (numberSum + Integer(token.text)) % 1000000007 }
        Str { stringBytes += token.text.byteLength }
        else { }
    }
    checksum = (checksum * 31 + kind * 1000 + token.width + token.line) % 1000000007
}

let frequencies: List<Frequency> = []
for name in identifiers { frequencies.add(Frequency { name: name; count: identifiers[name] }) }
frequencies.sortBy(function(a: Frequency, b: Frequency): Integer {
    if a.count != b.count { return b.count - a.count }
    if a.name < b.name { return -1 }
    if a.name > b.name { return 1 }
    return 0
})

print("tokens \(tokens.length)")
let names = ["identifier", "keyword", "number", "string", "operator", "comment"]
for k in 0..6 { print("\(names[k]) \(counts[k])") }
print("number sum \(numberSum)")
print("string bytes \(stringBytes)")
print("distinct identifiers \(frequencies.length)")
for i in 0..min(10, frequencies.length) { print("\(frequencies[i].name) \(frequencies[i].count)") }
print("checksum \(checksum)")
