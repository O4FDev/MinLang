use "process" as processInfo
// Integer-keyed Maps and Sets: an edge stream builds node degrees and an
// adjacency Map of Lists, with removals; then a breadth-first search over the
// adjacency and a first-in-first-out cache simulation.
record Random { state: Integer }

function Random.next(): Integer {
    self.state = (self.state * 1103515245 + 12345) % 2147483648
    return self.state / 16
}

function nodeKey(index: Integer): Integer { return index * 7919 + 13 }

function increment(counts: Map<Integer, Integer>, key: Integer) {
    if counts.has(key) { counts[key] += 1 } else { counts[key] = 1 }
}

let edges = Integer(processInfo.argument(0))
let nodes = edges / 4 + 1
let random = Random { state: 99 }
let degrees: Map<Integer, Integer> = Map()
let adjacency: Map<Integer, List<Integer>> = Map()
let removed = 0
let start = 0
for i in 0..edges {
    let a = nodeKey(random.next() % nodes)
    let b = nodeKey(random.next() % nodes)
    if i == 0 { start = a }
    increment(degrees, a)
    increment(degrees, b)
    if !adjacency.has(a) { adjacency[a] = [] }
    if !adjacency.has(b) { adjacency[b] = [] }
    adjacency[a].add(b)
    adjacency[b].add(a)
    if i % 7 == 0 && degrees.remove(nodeKey(random.next() % nodes)) { removed += 1 }
}

let keys: List<Integer> = []
for key in degrees { keys.add(key) }
keys.sort()
let checksum = 0
let busiest = 0
for key in keys {
    let degree = degrees[key]
    checksum = (checksum * 31 + key + degree) % 1000000007
    if degree > busiest { busiest = degree }
}
print("\(degrees.length) \(adjacency.length) \(removed)")
print("\(checksum) \(busiest)")

let visited: Set<Integer> = Set()
visited.add(start)
let frontier = [start]
let depth = 0
let depthSum = 0
while frontier.length > 0 {
    let next: List<Integer> = []
    for node in frontier {
        depthSum += depth
        for neighbour in adjacency[node] {
            if !visited.contains(neighbour) {
                visited.add(neighbour)
                next.add(neighbour)
            }
        }
    }
    frontier = next
    depth += 1
}
print("\(visited.length) \(depthSum) \(depth)")

let capacity = nodes / 8 + 1
let cache: Map<Integer, Integer> = Map()
let arrivals: List<Integer> = []
let oldest = 0
let hits = 0
let misses = 0
let valueSum = 0
for request in 0..edges {
    let key = nodeKey(min(random.next() % nodes, random.next() % nodes))
    if cache.has(key) {
        hits += 1
        valueSum += cache[key]
    } else {
        misses += 1
        let value = key * 3 % 1000
        cache[key] = value
        valueSum += value
        arrivals.add(key)
        if cache.length > capacity {
            cache.remove(arrivals[oldest])
            oldest += 1
        }
    }
}
print("\(hits) \(misses) \(valueSum) \(cache.length)")
