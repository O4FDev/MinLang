use "process" as processInfo
// A small stack-based bytecode VM: an assembler builds three functions with
// locals, loops, calls and conditional jumps, then the interpreter runs
// main(N) and reports its result and the number of instructions executed.
choice Op {
    Push
    Load
    Store
    Add
    Subtract
    Multiply
    Remainder
    Less
    NotEqual
    Jump
    JumpIfFalse
    Call
    Return
    Halt
}

record Instruction { op: Op; argument: Integer }
record Function { entry: Integer; parameters: Integer; locals: Integer }

record Assembler { code: List<Instruction>; functions: List<Function> }

function Assembler.emit(op: Op, argument: Integer): Integer {
    self.code.add(Instruction { op: op; argument: argument })
    return self.code.length - 1
}

function Assembler.op(op: Op) { self.emit(op, 0) }

function Assembler.here(): Integer { return self.code.length }

function Assembler.patch(at: Integer, target: Integer) { self.code[at].argument = target }

function Assembler.begin(parameters: Integer, locals: Integer): Integer {
    self.functions.add(Function { entry: self.here(); parameters: parameters; locals: locals })
    return self.functions.length - 1
}

constant MAIN = 0
constant SUM_SQUARES = 1
constant GCD = 2

// main(n): total = 0; i = 0; while i < n { total = (total + sumSquares(i % 64) + gcd(i, 360)) % 1000000007; i += 1 }
function assembleMain(asm: Assembler) {
    asm.begin(1, 3)
    asm.emit(Op.Push, 0)
    asm.emit(Op.Store, 1)
    asm.emit(Op.Push, 0)
    asm.emit(Op.Store, 2)
    let top = asm.here()
    asm.emit(Op.Load, 2)
    asm.emit(Op.Load, 0)
    asm.op(Op.Less)
    let exit = asm.emit(Op.JumpIfFalse, 0)
    asm.emit(Op.Load, 1)
    asm.emit(Op.Load, 2)
    asm.emit(Op.Push, 64)
    asm.op(Op.Remainder)
    asm.emit(Op.Call, SUM_SQUARES)
    asm.op(Op.Add)
    asm.emit(Op.Load, 2)
    asm.emit(Op.Push, 360)
    asm.emit(Op.Call, GCD)
    asm.op(Op.Add)
    asm.emit(Op.Push, 1000000007)
    asm.op(Op.Remainder)
    asm.emit(Op.Store, 1)
    asm.emit(Op.Load, 2)
    asm.emit(Op.Push, 1)
    asm.op(Op.Add)
    asm.emit(Op.Store, 2)
    asm.emit(Op.Jump, top)
    asm.patch(exit, asm.here())
    asm.emit(Op.Load, 1)
    asm.op(Op.Return)
}

// sumSquares(n): s = 0; i = 0; while i < n { s = s + i * i % 7; i += 1 }; return s
function assembleSumSquares(asm: Assembler) {
    asm.begin(1, 3)
    asm.emit(Op.Push, 0)
    asm.emit(Op.Store, 1)
    asm.emit(Op.Push, 0)
    asm.emit(Op.Store, 2)
    let top = asm.here()
    asm.emit(Op.Load, 2)
    asm.emit(Op.Load, 0)
    asm.op(Op.Less)
    let exit = asm.emit(Op.JumpIfFalse, 0)
    asm.emit(Op.Load, 1)
    asm.emit(Op.Load, 2)
    asm.emit(Op.Load, 2)
    asm.op(Op.Multiply)
    asm.emit(Op.Push, 7)
    asm.op(Op.Remainder)
    asm.op(Op.Add)
    asm.emit(Op.Store, 1)
    asm.emit(Op.Load, 2)
    asm.emit(Op.Push, 1)
    asm.op(Op.Add)
    asm.emit(Op.Store, 2)
    asm.emit(Op.Jump, top)
    asm.patch(exit, asm.here())
    asm.emit(Op.Load, 1)
    asm.op(Op.Return)
}

// gcd(a, b): while b != 0 { t = a % b; a = b; b = t }; return a
function assembleGcd(asm: Assembler) {
    asm.begin(2, 3)
    let top = asm.here()
    asm.emit(Op.Load, 1)
    asm.emit(Op.Push, 0)
    asm.op(Op.NotEqual)
    let exit = asm.emit(Op.JumpIfFalse, 0)
    asm.emit(Op.Load, 0)
    asm.emit(Op.Load, 1)
    asm.op(Op.Remainder)
    asm.emit(Op.Store, 2)
    asm.emit(Op.Load, 1)
    asm.emit(Op.Store, 0)
    asm.emit(Op.Load, 2)
    asm.emit(Op.Store, 1)
    asm.emit(Op.Jump, top)
    asm.patch(exit, asm.here())
    asm.emit(Op.Load, 0)
    asm.op(Op.Return)
}

record Machine {
    code: List<Instruction>
    functions: List<Function>
    stack: List<Integer>
    returnTo: List<Integer>
    bases: List<Integer>
    executed: Integer
}

function Machine.run(entry: Integer): Integer {
    let pc = entry
    let sp = -1
    let base = 0
    let depth = 0
    while true {
        let instruction = self.code[pc]
        pc += 1
        self.executed += 1
        match instruction.op {
            Push {
                sp += 1
                self.stack[sp] = instruction.argument
            }
            Load {
                sp += 1
                self.stack[sp] = self.stack[base + instruction.argument]
            }
            Store {
                self.stack[base + instruction.argument] = self.stack[sp]
                sp -= 1
            }
            Add {
                sp -= 1
                self.stack[sp] = self.stack[sp] + self.stack[sp + 1]
            }
            Subtract {
                sp -= 1
                self.stack[sp] = self.stack[sp] - self.stack[sp + 1]
            }
            Multiply {
                sp -= 1
                self.stack[sp] = self.stack[sp] * self.stack[sp + 1]
            }
            Remainder {
                sp -= 1
                self.stack[sp] = self.stack[sp] % self.stack[sp + 1]
            }
            Less {
                sp -= 1
                if self.stack[sp] < self.stack[sp + 1] { self.stack[sp] = 1 } else { self.stack[sp] = 0 }
            }
            NotEqual {
                sp -= 1
                if self.stack[sp] != self.stack[sp + 1] { self.stack[sp] = 1 } else { self.stack[sp] = 0 }
            }
            Jump { pc = instruction.argument }
            JumpIfFalse {
                if self.stack[sp] == 0 { pc = instruction.argument }
                sp -= 1
            }
            Call {
                let function = self.functions[instruction.argument]
                self.returnTo[depth] = pc
                self.bases[depth] = base
                depth += 1
                base = sp - function.parameters + 1
                for slot in function.parameters..function.locals { self.stack[base + slot] = 0 }
                sp = base + function.locals - 1
                pc = function.entry
            }
            Return {
                let value = self.stack[sp]
                sp = base
                self.stack[sp] = value
                depth -= 1
                pc = self.returnTo[depth]
                base = self.bases[depth]
            }
            Halt { return self.stack[sp] }
        }
    }
    return 0
}

function zeros(count: Integer): List<Integer> {
    let values: List<Integer> = []
    for index in 0..count { values.add(0) }
    return values
}

let n = Integer(processInfo.argument(0))
let asm = Assembler { code: []; functions: [] }
assembleMain(asm)
assembleSumSquares(asm)
assembleGcd(asm)
// Entry stub: push n, call main, halt.
let entry = asm.emit(Op.Push, n)
asm.emit(Op.Call, MAIN)
asm.op(Op.Halt)
let machine = Machine {
    code: asm.code
    functions: asm.functions
    stack: zeros(1024)
    returnTo: zeros(64)
    bases: zeros(64)
    executed: 0
}
let result = machine.run(entry)
print("result \(result)")
print("executed \(machine.executed)")
