use "process" as processInfo
// Sort records with a comparator callback: by score descending, then name, then id.
record Row { id: Integer; score: Integer; name: Text }
let rows: List<Row> = []
let seed = 7
let names = ["ada", "bob", "cy", "dee", "eve", "fay", "gus", "hal"]
let count = Integer(processInfo.argument(0))
for i in 0..count {
    seed = (seed * 1103515245 + 12345) % 2147483648
    rows.add(Row { id: i; score: (seed / 1024) % 1000; name: names[(seed / 16) % 8] })
}
for round in 0..3 {
    rows.sortBy(function(a: Row, b: Row): Integer {
        if a.score != b.score { return b.score - a.score }
        if a.name < b.name { return -1 }
        if a.name > b.name { return 1 }
        return a.id - b.id
    })
    rows.sortBy(function(a: Row, b: Row): Integer { return a.id - b.id })
}
let checksum = 0
for i in 0..rows.length { checksum = (checksum * 31 + rows[i].score) % 1000000007 }
rows.sortBy(function(a: Row, b: Row): Integer {
    if a.score != b.score { return b.score - a.score }
    if a.name < b.name { return -1 }
    if a.name > b.name { return 1 }
    return a.id - b.id
})
for i in 0..100 { checksum = (checksum * 31 + rows[i].id) % 1000000007 }
print(checksum)
