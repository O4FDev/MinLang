use "process" as processInfo
// Nested List<List<Float>> matrix multiply with checked indexing.
let n = Integer(processInfo.argument(0))
let a: List<List<Float>> = []
let b: List<List<Float>> = []
for i in 0..n {
    let ra: List<Float> = []
    let rb: List<Float> = []
    for j in 0..n { ra.add(Float((i * j) % 7 + 1)); rb.add(Float((i + j) % 5 + 1)) }
    a.add(ra)
    b.add(rb)
}
let c: List<List<Float>> = []
for i in 0..n {
    let row: List<Float> = []
    for j in 0..n { row.add(0.0) }
    c.add(row)
}
for round in 0..4 {
    for i in 0..n {
        for k in 0..n {
            let aik = a[i][k]
            for j in 0..n { c[i][j] = c[i][j] + aik * b[k][j] }
        }
    }
}
let sum = 0.0
for i in 0..n { for j in 0..n { sum = sum + c[i][j] } }
print(Integer(sum))
