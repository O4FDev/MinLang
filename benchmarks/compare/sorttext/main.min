use "io" as io
use "process" as processInfo
// Natural sorting of Text and Integer Lists, and a record sort by a Text key.
record Item { key: Text; value: Integer }

function checksum(values: List<Integer>): Integer {
    let total = 0
    for value in values { total = (total * 31 + value) % 1000000007 }
    return total
}

let text = io.readTextFile(processInfo.argument(0))
let words: List<Text> = []
let numbers: List<Integer> = []
let items: List<Item> = []
for line in text.split("\n") {
    if line.length == 0 { continue }
    let parts = line.split(" ")
    let value = Integer(parts[1])
    words.add(parts[0])
    numbers.add(value)
    items.add(Item { key: parts[0]; value: value })
}

let sortedWords = words.sorted()
let distinct = 0
let lengths: List<Integer> = []
for i in 0..sortedWords.length {
    if i == 0 || sortedWords[i] != sortedWords[i - 1] { distinct += 1 }
    lengths.add(sortedWords[i].byteLength)
}
print("words \(sortedWords.length) distinct \(distinct) checksum \(checksum(lengths))")
for i in 0..3 { print(sortedWords[i]) }
for i in sortedWords.length - 3..sortedWords.length { print(sortedWords[i]) }

numbers.sort()
print("numbers min \(numbers[0]) median \(numbers[numbers.length / 2]) max \(numbers[numbers.length - 1]) checksum \(checksum(numbers))")

items.sortBy(function(a: Item, b: Item): Integer {
    if a.key < b.key { return -1 }
    if a.key > b.key { return 1 }
    if a.value > b.value { return -1 }
    if a.value < b.value { return 1 }
    return 0
})
let values: List<Integer> = []
for item in items { values.add(item.value) }
print("items checksum \(checksum(values))")
for i in 0..3 { print("\(items[i].key) \(items[i].value)") }
