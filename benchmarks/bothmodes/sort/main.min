use "process" as processInfo
// Sort N 40-bit keys: 64 runs are sorted in place (quicksort with insertion
// sort below 16 keys), then merged pairwise in rounds. Every round splits the
// output into 64 equal parts; each part finds where it starts in its two
// input runs with a merge-path binary search and merges exactly its share.
// N must be a multiple of 64.
constant RUNS = 64

parallel function mix(seed: Integer): Integer {
    let value = seed
    for round in 0..3 {
        value = value ^ (value >> 31)
        value = wrappingMultiply(value, 0x2545F4914F6CDD1D)
        value = value ^ (value >> 29)
        value = wrappingAdd(value, round)
    }
    return value & 0x7FFFFFFFFFFFFFFF
}

parallel function insertion(keys: List<Integer>, low: Integer, high: Integer) {
    for i in low + 1..high {
        let key = keys[i]
        let j = i - 1
        while j >= low && keys[j] > key {
            keys[j + 1] = keys[j]
            j -= 1
        }
        keys[j + 1] = key
    }
}

parallel function quicksort(keys: List<Integer>, low: Integer, high: Integer) {
    let first = low
    let after = high
    while after - first > 16 {
        let middle = first + (after - first) / 2
        let a = keys[first]
        let b = keys[middle]
        let c = keys[after - 1]
        let pivot = max(min(a, b), min(max(a, b), c))
        let i = first
        let j = after - 1
        while i <= j {
            while keys[i] < pivot { i += 1 }
            while keys[j] > pivot { j -= 1 }
            if i <= j {
                let swap = keys[i]
                keys[i] = keys[j]
                keys[j] = swap
                i += 1
                j -= 1
            }
        }
        // recurse into the smaller side, loop on the larger
        if j + 1 - first < after - i {
            quicksort(keys, first, j + 1)
            first = i
        } else {
            quicksort(keys, i, after)
            after = j + 1
        }
    }
    insertion(keys, first, after)
}

parallel function sortRun(keys: List<Integer>) { quicksort(keys, 0, keys.length) }

// Writes output positions [start, start + out.length) of the merge of the two
// sorted runs of `length` keys that contain them.
parallel function mergePart(source: List<Integer>, out: List<Integer>, start: Integer, length: Integer) {
    let block = start / (2 * length) * (2 * length)
    let a = block
    let lengthA = length
    let b = block + length
    let lengthB = length
    let diagonal = start - block
    let low = max(0, diagonal - lengthB)
    let high = min(diagonal, lengthA)
    while low < high {
        let middle = (low + high) / 2
        if source[a + middle] <= source[b + diagonal - middle - 1] { low = middle + 1 } else { high = middle }
    }
    let i = low
    let j = diagonal - low
    for k in 0..out.length {
        if j >= lengthB || (i < lengthA && source[a + i] <= source[b + j]) {
            out[k] = source[a + i]
            i += 1
        } else {
            out[k] = source[b + j]
            j += 1
        }
    }
}

let count = Integer(processInfo.argument(0))
let width = count / RUNS
let keys: List<Integer> = []
let spare: List<Integer> = []
for i in 0..count {
    keys.add(mix(i) & 0xFFFFFFFFFF)
    spare.add(0)
}
parallel for run in 0..RUNS { sortRun(keys.window(run, width)) }
let source = keys
let target = spare
let length = width
while length < count {
    parallel for part in 0..RUNS { mergePart(source, target.window(part, width), part * width, length) }
    let swap = source
    source = target
    target = swap
    length *= 2
}
let checksum = 0
let disorder = 0
for i in 0..count {
    checksum = wrappingAdd(checksum, wrappingMultiply(source[i], i + 1))
    if i > 0 && source[i - 1] > source[i] { disorder += 1 }
}
print("count \(count) disorder \(disorder)")
print("first \(source[0]) middle \(source[count / 2]) last \(source[count - 1])")
print("checksum \(checksum)")
