// A read-only table shared by worker threads without copying it.
thread function worker(table: List<Integer>, from: Integer): Integer {
    let sum = 0
    for i in from..table.length { sum += table[i] }
    return sum
}
let table: List<Integer> = []
for i in 0..100 { table.add(i) }
let t = startThread(worker, table, 50)
print(joinThread(t))
