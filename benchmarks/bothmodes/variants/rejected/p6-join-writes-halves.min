parallel function fill(keys: List<Integer>, first: Integer, after: Integer): Integer {
    for i in first..after { keys[i] = i }
    return after - first
}
parallel function both(keys: List<Integer>, n: Integer): Integer {
    let a, b = join(fill(keys, 0, n / 2), fill(keys, n / 2, n))
    return a + b
}
let keys = [0, 0, 0, 0]
print(both(keys, 4))
