use "process" as processInfo
// Variant: the serial idiom for the forkjoin program: the expression tree as a
// recursive choice (what parallel functions and join cannot take), same output.
constant MODULUS = 2147483647
constant PASSES = 8

choice Expr {
    Leaf(id: Integer)
    Node(id: Integer, left: Expr, right: Expr)
}
record Counter { nodes: Integer; splits: Integer }

function mix(seed: Integer): Integer {
    let value = seed
    for round in 0..3 {
        value = value ^ (value >> 31)
        value = wrappingMultiply(value, 0x2545F4914F6CDD1D)
        value = value ^ (value >> 29)
        value = wrappingAdd(value, round)
    }
    return value & 0x7FFFFFFFFFFFFFFF
}

function build(counter: Counter, leaves: Integer): Expr {
    let id = counter.nodes
    counter.nodes += 1
    if leaves == 1 { return Leaf(id) }
    let split = 1 + mix(counter.splits) % (leaves - 1)
    counter.splits += 1
    let left = build(counter, split)
    let right = build(counter, leaves - split)
    return Node(id, left, right)
}

function combine(node: Integer, a: Integer, b: Integer): Integer {
    let op = mix(node) % 4
    let value = 0
    if op == 0 { value = (a + b) % MODULUS }
    else if op == 1 { value = a * b % MODULUS }
    else if op == 2 { value = (a ^ b) % MODULUS }
    else { value = max(a, b) }
    return (value + mix(value + node) % 1024) % MODULUS
}

function evaluate(expr: Expr, pass: Integer): Integer {
    match expr {
        Leaf(id) { return mix(id + pass * 1000003) % MODULUS }
        Node(id, left, right) { return combine(id, evaluate(left, pass), evaluate(right, pass)) }
    }
}

let leaves = Integer(processInfo.argument(0))
let counter = Counter { nodes: 0; splits: 0 }
let root = build(counter, leaves)
print("nodes \(counter.nodes)")
let digest = 0
for pass in 0..PASSES {
    let value = evaluate(root, pass)
    print("pass \(pass) \(value)")
    digest = (digest * 31 + value) % MODULUS
}
print("digest \(digest)")
