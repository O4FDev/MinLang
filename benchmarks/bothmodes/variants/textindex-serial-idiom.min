use "io" as io
use "process" as processInfo
// Variant: the serial idiom for the textindex program: split the Text into
// lines and words, Map<Text, Integer> term ids, posting Lists, same output.
constant MODULUS = 1000000007
record Term { word: Text; id: Integer }

let corpus = io.readTextFile(processInfo.argument(0))
let ids: Map<Text, Integer> = Map()
let words: List<Text> = []
let postings: List<List<Integer>> = []
let frequencies: List<List<Integer>> = []
let tokens = 0
let documents = 0
for line in corpus.split("\n") {
    if line.length == 0 { continue }
    for word in line.split(" ") {
        if word.length == 0 { continue }
        let id = -1
        if ids.has(word) { id = ids[word] } else {
            id = words.length
            ids[word] = id
            words.add(word)
            postings.add([])
            frequencies.add([])
        }
        let list = postings[id]
        if list.length > 0 && list[list.length - 1] == documents {
            frequencies[id][list.length - 1] += 1
        } else {
            list.add(documents)
            frequencies[id].add(1)
        }
        tokens += 1
    }
    documents += 1
}
let terms: List<Term> = []
let total = 0
for id in 0..words.length {
    terms.add(Term { word: words[id]; id: id })
    total += postings[id].length
}
terms.sortBy(function(a: Term, b: Term): Integer {
    if a.word < b.word { return -1 }
    if a.word > b.word { return 1 }
    return 0
})
let digest = 0
let best = 0
for rank in 0..terms.length {
    let id = terms[rank].id
    let docSum = 0
    let tfSum = 0
    for k in 0..postings[id].length {
        docSum += postings[id][k]
        tfSum += frequencies[id][k] * (k % 7 + 1)
    }
    digest = (digest * 31 + postings[id].length * 1000003 + docSum % 1000003 + tfSum) % MODULUS
    if postings[id].length > postings[terms[best].id].length { best = rank }
}
print("documents \(documents) tokens \(tokens)")
print("terms \(terms.length) postings \(total)")
print("widest \(terms[best].word) \(postings[terms[best].id].length)")
print("digest \(digest)")
