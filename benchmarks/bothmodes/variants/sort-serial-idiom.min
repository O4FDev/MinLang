use "process" as processInfo
// Variant: the serial idiom keys.sort() with the same input and output.
// Sort N 40-bit keys: 64 runs are sorted in place (quicksort with insertion
// sort below 16 keys), then merged pairwise in rounds. Every round splits the
// output into 64 equal parts; each part finds where it starts in its two
// input runs with a merge-path binary search and merges exactly its share.
// N must be a multiple of 64.
constant RUNS = 64

parallel function mix(seed: Integer): Integer {
    let value = seed
    for round in 0..3 {
        value = value ^ (value >> 31)
        value = wrappingMultiply(value, 0x2545F4914F6CDD1D)
        value = value ^ (value >> 29)
        value = wrappingAdd(value, round)
    }
    return value & 0x7FFFFFFFFFFFFFFF
}

let count = Integer(processInfo.argument(0))
let keys: List<Integer> = []
for i in 0..count {
    keys.add(mix(i) & 0xFFFFFFFFFF)
}
keys.sort()
let source = keys
let checksum = 0
let disorder = 0
for i in 0..count {
    checksum = wrappingAdd(checksum, wrappingMultiply(source[i], i + 1))
    if i > 0 && source[i - 1] > source[i] { disorder += 1 }
}
print("count \(count) disorder \(disorder)")
print("first \(source[0]) middle \(source[count / 2]) last \(source[count - 1])")
print("checksum \(checksum)")
