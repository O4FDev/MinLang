use "process" as processInfo
use "system" as system
// Micro-measure of one parallel for dispatch: R loops of 64 tiny iterations
// (as when every query or event-loop pass dispatches its own small loop).
// Prints the result and the mean nanoseconds per loop.
let rounds = Integer(processInfo.argument(0))
let out: List<Integer> = []
for i in 0..64 { out.add(0) }
let start = system.monotonicNanoseconds()
let total = 0
for round in 0..rounds {
    parallel for i in 0..64 { out[i] = (i * round) % 7 }
    total += out[round % 64]
}
let elapsed = system.monotonicNanoseconds() - start
print("total \(total)")
print("ns per loop \(elapsed / rounds)")
