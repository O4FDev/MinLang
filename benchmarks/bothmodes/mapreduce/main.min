use "process" as processInfo
// Map-reduce over records: build N sales, then run six passes of three
// grouped aggregations (revenue by region and month, units by product, a
// count of large sales). The sales are built by halves with join, each half
// growing its own List, joined in order. Each chunk of sales fills its own
// window of bucket counters; the chunks are combined in order afterwards.
record Sale { customer: Integer; product: Integer; region: Integer; month: Integer; quantity: Integer; price: Integer; discount: Integer }

constant CHUNK = 8192
constant PASSES = 6
constant MODULUS = 1000000007

parallel function mix(seed: Integer): Integer {
    let value = seed
    for round in 0..3 {
        value = value ^ (value >> 31)
        value = wrappingMultiply(value, 0x2545F4914F6CDD1D)
        value = value ^ (value >> 29)
        value = wrappingAdd(value, round)
    }
    return value & 0x7FFFFFFFFFFFFFFF
}

function sale(i: Integer): Sale {
    let a = mix(i * 2)
    let b = mix(i * 2 + 1)
    return Sale {
        customer: a % 100000
        product: (a >> 20) % 512
        region: (a >> 32) % 16
        month: (a >> 40) % 12
        quantity: 1 + b % 9
        price: 100 + (b >> 8) % 20000
        discount: (b >> 30) % 30
    }
}

function build(first: Integer, after: Integer): List<Sale> {
    let part: List<Sale> = []
    for i in first..after { part.add(sale(i)) }
    return part
}

function buildRange(first: Integer, after: Integer): List<Sale> {
    if after - first <= CHUNK * 32 { return build(first, after) }
    let middle = first + (after - first) / 2
    let left, right = join(buildRange(first, middle), buildRange(middle, after))
    left.addAll(right)
    return left
}

let count = Integer(processInfo.argument(0))
let sales = buildRange(0, count)

let chunks = (count + CHUNK - 1) / CHUNK
let revenueWidth = 16 * 12
let unitsWidth = 512
let revenue: List<Integer> = []
for slot in 0..chunks * revenueWidth { revenue.add(0) }
let units: List<Integer> = []
for slot in 0..chunks * unitsWidth { units.add(0) }

let digest = 0
for pass in 0..PASSES {
    let minimum = 1 + pass % 3
    let skipMonth = pass % 12
    let threshold = 100000 + pass * 10000
    let large = 0
    parallel for chunk in 0..chunks reduce large {
        let rev = revenue.window(chunk, revenueWidth)
        let uni = units.window(chunk, unitsWidth)
        for slot in 0..revenueWidth { rev[slot] = 0 }
        for slot in 0..unitsWidth { uni[slot] = 0 }
        for i in chunk * CHUNK..min(chunk * CHUNK + CHUNK, count) {
            let net = sales[i].price * sales[i].quantity * (100 - sales[i].discount) / 100
            if sales[i].quantity >= minimum { rev[sales[i].region * 12 + sales[i].month] += net }
            if sales[i].month != skipMonth { uni[sales[i].product] += sales[i].quantity }
            if net > threshold { large += 1 }
        }
    }
    for slot in 0..revenueWidth {
        let sum = 0
        for chunk in 0..chunks { sum += revenue[chunk * revenueWidth + slot] }
        digest = (digest * 31 + sum) % MODULUS
    }
    for slot in 0..unitsWidth {
        let sum = 0
        for chunk in 0..chunks { sum += units[chunk * unitsWidth + slot] }
        digest = (digest * 31 + sum) % MODULUS
    }
    digest = (digest * 31 + large) % MODULUS
    print("pass \(pass) large \(large)")
}
print("digest \(digest)")
