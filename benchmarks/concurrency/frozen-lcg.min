use "process" as processInfo
// Fixed total work: 131072 blocks, 4096 dependent steps per block.
// Every worker reads one shared FrozenBytes backing through the checked API.
constant BLOCKS = 131072
constant STEPS = 4096
constant MODULUS = 2147483647

thread function compute(seed: Integer, input: FrozenBytes, queue: BytesChannel): Integer {
    let width = seed / BLOCKS
    let begin = seed % BLOCKS
    let end = begin + BLOCKS / width
    let total = 0
    for block in begin..end {
        let value = input.getInt64(block * 8)
        for step in 0..STEPS {
            value = value * 48271 % MODULUS
        }
        total = total + value
    }
    return total
}

function main() {
    if processInfo.argumentCount() != 1 { fail("one thread count is required") }
    let argumentText = processInfo.argument(0)
    if argumentText.length != 1 { fail("thread count must have one digit") }
    let width = Integer(argumentText[0]) - Integer('0')
    if width != 1 && width != 2 && width != 4 && width != 8 {
        fail("thread count must be 1, 2, 4 or 8")
    }
    let bytes = Bytes(0)
    for block in 0..BLOCKS {
        bytes.addInt64((block * 104729 + 20261012) % MODULUS)
    }
    let shared = freezeBytesTake(bytes)
    if bytes.length != 0 { fail("publication did not detach its source") }
    let queue = bytesChannel(0, 1)
    let threads: List<Thread> = []
    for index in 0..width {
        threads.add(startThread(compute, width * BLOCKS + index * (BLOCKS / width), shared, queue))
    }
    let total = 0
    for index in 0..threads.length { total = total + joinThread(threads[index]) }
    closeBytesChannel(queue)
    print(total)
}
