// A small stateful HTTP service for the live-patch experiment. `reply` is the
// function the experiment edits while the server runs under `minyar run --watch --hot`.
use "httpserver" as http
use "errors" as errors
use "system" as system
use "text" as text

record Store { served: Integer; keys: List<Integer> }
global STORE: Store = Store { served: 0; keys: [] }

function remember(target: Text) {
    STORE.served += 1
    if STORE.keys.length < 4096 { STORE.keys.add(target.length) }
}

function reply(target: Text): Bytes {
    remember(target)
    return Bytes("version=1 served=" + Text(STORE.served) + "\n")
}

function port(): Integer {
    let raw = system.getenv("LIVEPATCH_PORT")
    if raw == "" { return 0 }
    return text.integer(raw).unwrapOr(0)
}

let server = http.listen("127.0.0.1", port(), http.defaults())
if !http.ok(server) { fail(errors.message(http.serverError(server))) }
print("LISTENING " + Text(http.port(server)))
let running = true
while running {
    let batch = http.poll(server, 20)
    if errors.isError(http.batchError(batch)) { running = false }
    for request in http.requests(batch) {
        http.respond(server, request, http.response(200, "text/plain", reply(request.target)))
    }
}
http.close(server)
