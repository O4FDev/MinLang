// The runner instantiates KEY_TYPE, KEY_EXPR and COUNT before compilation.
// Key construction is outside the four measured dictionary phases.
function tick(): Integer { native "mapbench" }
let n = COUNT
let keys: List<KEY_TYPE> = []
let queries: List<KEY_TYPE> = []
let i = 0
while i < n { keys.add(KEY_EXPR); queries.add(KEY_EXPR); i = i + 1 }
let m = Map<KEY_TYPE, Integer>()
let start = tick()
i = 0
while i < n { m[keys[i]] = i * 3 + 1; i = i + 1 }
let inserted = tick() - start
start = tick()
i = 0
let sum = 0
while i < n { let k = (i * 104729) % n; sum = sum + m[queries[k]]; i = i + 1 }
let looked = tick() - start
start = tick()
i = 0
while i < n {
let k = (i * 104729) % n
if i % 2 == 0 { m[keys[k]] = m[queries[k]] + 5 } else {
if !m.remove(queries[k]) { fail("mixed remove failed") }
m[keys[k]] = k * 3 + 2
}
i = i + 1
}
let mixed = tick() - start
start = tick()
i = 0
while i < n { let k = (i * 104729) % n; if !m.remove(queries[k]) { fail("remove failed") }; i = i + 1 }
let removed = tick() - start
print(inserted)
print(looked)
print(mixed)
print(removed)
print(sum)
print(m.length)
