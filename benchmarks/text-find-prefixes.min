// Repeated prefixes force a naive substring scan into quadratic work.
// Expected checksum: -64. Text and pattern validation is also exercised.
let source = "a"
for doubling in 0..20 { source = source + source }
let needle = "a"
for doubling in 0..12 { needle = needle + needle }
needle = needle + "b"
let checksum = 0
for iteration in 0..64 { checksum += source.find(needle) }
print(checksum)
