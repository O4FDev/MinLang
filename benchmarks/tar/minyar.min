use "io" as io
use "process" as processInfo
use "tar" as tar
use "errors" as errors
let source = io.readBytesFile(processInfo.argument(1))
let repeat = 0
for digit in processInfo.argument(2) { repeat = repeat * 10 + Integer(digit) - 48 }
let writing = processInfo.argument(0) == "roundtrip"
let sum = 0
for iteration in 0..repeat {
    let cursor = tar.reader(source,source.length,4096)
    let outputLimit = 0
    if writing { outputLimit = source.length * 2 + 1048576 }
    let output = tar.writer(outputLimit)
    let done = false
    while !done {
        let result = tar.next(cursor)
        if errors.isError(result.error) { fail(errors.message(result.error)) }
        if result.end { done = true } else {
            let e = result.entry
            let data = errors.bytesValue(tar.payload(cursor,e))
            sum += e.path.length + e.link.length + e.mode + e.uid + e.gid + e.mtime + e.mtimeNanos + e.type + e.size + e.deviceMajor + e.deviceMinor + e.uname.length + e.gname.length
            for attr in e.attributes { sum += attr.key.length + attr.value.length }
            if data.length > 0 { sum += data[0] + data[data.length - 1] }
            if writing {
                if tar.appendStatus(output,e,data) != 0 { fail(errors.message(tar.writerError(output))) }
            }
        }
    }
    if writing { sum += errors.bytesValue(tar.finishOwned(output)).length } else { tar.closeWriter(output) }
}
print(sum)
