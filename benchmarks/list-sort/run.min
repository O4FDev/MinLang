use "../../tools/testing.min" as test
use "../../tests/benchmark-phases.min" as phase
use "../../tests/tar-benchmark-support.min" as benchmark
use "../../tests/tar-test-support.min" as text
use "../../tests/cpython-random.min" as random
use "../../tests/sha256test.min" as oracle
use "../../tests/text-basics-oracles.min" as hex
use "system" as system
use "files" as files
use "machine" as machine
use "json" as json

function lock(path: Text): Integer { native "sortbench" }
function parentPid(): Integer { native "sortbench" }
function readLink(path: Text): Bytes { native "sortbench" }
function pinCPU(): Integer { native "mapsbaseline" }
record Context { root: Text; directory: Text; serial: List<Integer>; commands: List<Text> }
function run(context: Context, command: List<Text>): Text {
    context.serial[0] += 1
    let start = system.monotonicNanoseconds()
    let result = test.run(command, system.environment(), context.root, context.directory + "/command-" + Text(context.serial[0]), 180)
    let wall = Float(system.monotonicNanoseconds() - start) / 1000000000.0
    context.commands.add("{\"command\":" + benchmark.strings(command) + ",\"returncode\":" + Text(result.status) + ",\"stdout\":" + benchmark.quote(result.output) + ",\"stderr\":" + benchmark.quote(result.errorOutput) + ",\"wall_seconds\":" + Text(wall) + "}")
    writeTextFile(context.directory + "/commands.json", "[" + text.joined(context.commands, ",") + "]\n")
    test.require(result, "stable-sort peer command")
    return result.output
}
function graphSource(root: Text): Text {
    let engine = readTextFile(root + "/runtime/minyar_runtime.c")
    for header in ["minyar_rc.h", "minyar_collections.h"] {
        let replacement = "minyar_cycle_rc.h"
        if header == "minyar_collections.h" { replacement = "minyar_cycle_collections.h" }
        let directive = "#include \"" + header + "\""
        test.check(engine.byteLength - test.replace(engine, directive, "").byteLength == directive.byteLength, "cycle runtime requires exactly one " + directive)
        engine = test.replace(engine, directive, "#include \"" + replacement + "\"")
    }
    return "#define MINYAR_SORT_GRAPH 1\n#define MINYAR_MAP_CYCLE_RUNTIME 1\n#if defined(__GNUC__) || defined(__clang__)\n#define MINYAR_NOINLINE __attribute__((noinline))\n#else\n#define MINYAR_NOINLINE\n#endif\n" + engine + "\n#include \"minyar_callbacks.h\"\n"
}
function ends(source: Text, suffix: Text): Boolean {
    let raw = Bytes(source)
    let tail = Bytes(suffix)
    return raw.length >= tail.length && Text(raw.slice(raw.length - tail.length, raw.length)) == suffix
}
function starts(source: Text, prefix: Text): Boolean {
    let raw = Bytes(source)
    let first = Bytes(prefix)
    return raw.length >= first.length && Text(raw.slice(0, first.length)) == prefix
}
function hashText(source: Text): Text {
    let bytes = Bytes(source)
    return hex.hex(oracle.oracle(machine.address(bytes), bytes.length))
}
function generateHashes(path: Text, count: Integer) {
    let file = files.open(path, files.WRITE | files.CREATE | files.TRUNCATE)
    test.check(file >= 0, "cannot create stable-sort hash fixture")
    let buffer = Bytes()
    for index in 0..count {
        buffer.addBytes(Bytes(hashText(Text((index * 1103515245 + 12345) % 1000000)) + "\n"))
        if buffer.length >= 65536 {
            test.check(files.write(file, buffer, 0, buffer.length) == buffer.length, "cannot write stable-sort hash fixture")
            buffer = Bytes()
        }
    }
    if buffer.length > 0 { test.check(files.write(file, buffer, 0, buffer.length) == buffer.length, "cannot finish stable-sort hash fixture") }
    test.check(files.close(file) == 0, "cannot close stable-sort hash fixture")
}
function preparation(context: Context, compiler: Text, callbacks: Text, clang: Text, swift: Text, count: Integer, hashes: Integer, repeats: Integer) {
    test.check(starts(clang, "/"), "stable-sort preparation requires literal LLVM23 clang")
    let clangVersion = run(context, [clang, "--version"])
    test.check(test.contains(clangVersion, "clang version 23."), "stable-sort preparation requires exactly LLVM23")
    let versions = "{\"clang\":" + benchmark.quote(clangVersion) + ",\"rust\":" + benchmark.quote(run(context, ["rustc", "--version"])) + ",\"swift\":" + benchmark.quote(run(context, [swift, "--version"])) + ",\"minyar-model\":" + benchmark.quote("native Minyar independent stable merge sort; compiler sha256 " + benchmark.digest(compiler)) + "}"
    let sourceHashes: List<Text> = []
    let sources: List<Text> = []
    for name in files.list(context.root + "/benchmarks/list-sort") {
        if !ends(name, ".py") && files.pathSize(context.root + "/benchmarks/list-sort/" + name) >= 0 {
            let relative = "benchmarks/list-sort/" + name
            let path = context.root + "/" + relative
            sourceHashes.add(benchmark.quote(relative) + ":" + benchmark.quote(benchmark.digest(path)))
            sources.add(path)
        }
    }
    for engine in ["ordinary", "graph"] {
        let source = readTextFile(context.root + "/runtime/minyar_runtime.c")
        if engine == "graph" { source = graphSource(context.root) }
        let path = context.directory + "/" + engine + ".c"
        writeTextFile(path, source)
        run(context, [clang, "-O2", "-DMINYAR_SYSTEM_HEAP=1", "-iquote", context.root + "/runtime", "-c", path, "-o", context.directory + "/" + engine + ".o"])
        sources.add(path)
        sources.add(context.directory + "/" + engine + ".o")
    }
    run(context, ["rustc", "-C", "opt-level=3", context.root + "/benchmarks/list-sort/peer.rs", "-o", context.directory + "/rust"])
    run(context, [swift, "-O", context.root + "/benchmarks/list-sort/peer.swift", "-o", context.directory + "/swift"])
    let fixture = context.directory + "/hashes.txt"
    generateHashes(fixture, hashes)
    for kind in ["integers", "records", "hashes"] {
        let selectedCount = count
        let originalCount = 262144
        if kind == "hashes" { selectedCount = hashes; originalCount = 2000000 }
        let template = readTextFile(context.root + "/benchmarks/list-sort/" + kind + ".min")
        test.check(test.contains(template, "let count = " + Text(originalCount)), "stable-sort fixture count declaration changed")
        let source = context.directory + "/" + kind + ".min"
        writeTextFile(source, test.replace(template, "let count = " + Text(originalCount), "let count = " + Text(selectedCount)))
        let selectedCompiler = compiler
        let engine = "ordinary"
        if kind == "records" { selectedCompiler = callbacks; engine = "graph" }
        let llvm = context.directory + "/" + kind + ".ll"
        run(context, [selectedCompiler, source, llvm, "--library", context.root + "/library"])
        run(context, [clang, "-O2", "-Wno-override-module", llvm, context.directory + "/" + engine + ".o", context.root + "/runtime/native/system.c", "-lm", "-o", context.directory + "/" + kind])
        for path in [source, llvm, context.directory + "/" + kind] { sources.add(path) }
    }
    let model = context.root + "/benchmarks/list-sort/peer.min"
    let modelIR = context.directory + "/minyar-model.ll"
    run(context, [compiler, model, modelIR, "--library", context.root + "/library"])
    run(context, [clang, "-O2", "-Wno-override-module", modelIR, context.directory + "/ordinary.o", context.root + "/runtime/native/system.c", context.root + "/runtime/native/files.c", "-pthread", "-lm", "-o", context.directory + "/minyar-model"])
    for path in [compiler, callbacks, fixture, modelIR, context.directory + "/minyar-model", context.directory + "/rust", context.directory + "/swift"] { sources.add(path) }
    for name in files.list(context.root + "/runtime") { if ends(name, ".h") { sources.add(context.root + "/runtime/" + name) } }
    for name in ["runtime/minyar_runtime.c", "runtime/native/system.c", "runtime/native/files.c", "runtime/native/sha256.c", "library/system.min", "library/files.min", "library/sha256.min", "tools/testing.min", "tests/cpython-random.min", "tests/benchmark-phases.min", "tests/tar-benchmark-support.min", "tests/tar-test-support.min", "tests/text-basics-oracles.min", "tests/sha256test.min", "tests/sha256-test-native.c", "tests/maps-baseline-runtime.c"] { sources.add(context.root + "/" + name) }
    let unique: List<Text> = []
    let seen = Map<Text, Boolean>()
    for path in sources { if !seen.has(path) { seen[path] = true; unique.add(path) } }
    let metadata = "{\"versions\":" + versions + ",\"source_hashes\":{" + text.joined(sourceHashes, ",") + "},\"fixture_sha256\":" + benchmark.quote(benchmark.digest(fixture)) + ",\"count\":" + Text(count) + ",\"hash_count\":" + Text(hashes) + ",\"repeats\":" + Text(repeats) + ",\"compiler\":" + benchmark.quote(compiler) + ",\"callback_compiler\":" + benchmark.quote(callbacks) + ",\"clang\":" + benchmark.quote(clang) + ",\"swiftc\":" + benchmark.quote(swift) + ",\"driver_binary_sha256\":" + benchmark.quote(benchmark.digest("/proc/self/exe")) + ",\"commands\":[" + text.joined(context.commands, ",") + "],\"hashes\":" + benchmark.hashes(unique) + ",\"peer_dispositions\":{\"minyar-model\":\"Native independent stable merge sort replaces peer.py; these timings are Minyar timings and do not claim Python timing equivalence.\"}}"
    writeTextFile(context.directory + "/prepared.json", metadata + "\n")
    print("stable-sort peers: prepared (no workload timings)")
}
function parentFromStat(source: Text): Integer {
    let bytes = Bytes(source)
    let start = -1
    for index in 0..bytes.length { if bytes[index] == 41 && index + 1 < bytes.length && bytes[index + 1] == 32 { start = index + 2 } }
    if start < 0 { return 0 }
    let fields = test.words(Text(bytes.slice(start, bytes.length)))
    if fields.length < 2 { return 0 }
    return Integer(fields[1])
}
function numeric(source: Text): Boolean {
    if source == "" { return false }
    for byte in Bytes(source) { if byte < 48 || byte > 57 { return false } }
    return true
}
function otherJobs(root: Text): Text {
    let ancestors = Map<Integer, Boolean>()
    ancestors[system.processId()] = true
    let parent = parentPid()
    while parent > 0 {
        test.check(!ancestors.has(parent), "cyclic stable-sort process ancestry")
        ancestors[parent] = true
        let stat = files.readFile("/proc/" + Text(parent) + "/stat")
        if files.lastError() != 0 { break }
        parent = parentFromStat(Text(stat))
    }
    let active: List<Text> = []
    for name in files.list("/proc") {
        if !numeric(name) { continue }
        let pid = Integer(name)
        if ancestors.has(pid) { continue }
        let cwdBytes = readLink("/proc/" + name + "/cwd")
        if cwdBytes.length == 0 { continue }
        let cwd = Text(cwdBytes)
        let commandBytes = files.readFile("/proc/" + name + "/cmdline")
        if files.lastError() != 0 || commandBytes.length == 0 { continue }
        let end = 0
        while end < commandBytes.length && commandBytes[end] != 0 { end += 1 }
        let executable = Text(commandBytes.slice(0, end))
        let start = 0
        let executableBytes = Bytes(executable)
        for index in 0..executableBytes.length { if executableBytes[index] == 47 { start = index + 1 } }
        executable = Text(executableBytes.slice(start, executableBytes.length))
        let selected = false
        for prefix in ["clang", "ld.lld", "rustc", "swift", "minyarc", "python"] { if starts(executable, prefix) { selected = true } }
        if selected && (starts(cwd, "/home/user/ws3/") || cwd == root || starts(cwd, root + "/")) {
            let command = Bytes()
            for byte in commandBytes { if byte == 0 { command.add(32) } else { command.add(byte) } }
            active.add("{\"pid\":" + Text(pid) + ",\"cwd\":" + benchmark.quote(cwd) + ",\"command\":" + benchmark.quote(Text(command)) + "}")
        }
    }
    return "[" + text.joined(active, ",") + "]"
}
function verifyLock(path: Text) {
    test.check(lock(path) == 9, "--lock must identify the inherited parent benchmark lock on fd9")
    let info = readTextFile("/proc/self/fdinfo/9")
    let exclusive = false
    for line in test.lines(info) {
        let fields = test.words(line)
        if fields.length >= 5 && fields[0] == "lock:" {
            for index in 0..(fields.length - 2) {
                if fields[index] == "FLOCK" && fields[index + 1] == "ADVISORY" && fields[index + 2] == "WRITE" { exclusive = true }
            }
        }
    }
    test.check(exclusive, "inherited parent benchmark lock must already be exclusive")
}
record Observation { kind: Text; peer: Text; count: Integer; iteration: Integer; nanoseconds: Integer; checksum: Integer }
function median(values: List<Integer>): Text {
    test.check(values.length > 0, "stable-sort medians require measured repetitions")
    let samples = values.slice(0, values.length)
    for index in 1..samples.length {
        let position = index
        while position > 0 && samples[position] < samples[position - 1] { let previous = samples[position - 1]; samples[position - 1] = samples[position]; samples[position] = previous; position -= 1 }
    }
    let middle = samples.length / 2
    if samples.length % 2 == 1 { return Text(samples[middle]) }
    return Text((Float(samples[middle - 1]) + Float(samples[middle])) / 2.0)
}
function peerCommand(context: Context, kind: Text, peer: Text, count: Integer): List<Text> {
    if peer == "minyar" {
        let command = [context.directory + "/" + kind]
        if kind == "hashes" { command.add(context.directory + "/hashes.txt") }
        return command
    }
    return [context.directory + "/" + peer, kind, Text(count), context.directory + "/hashes.txt"]
}
function measurement(context: Context, manifest: json.Value, lockPath: Text, count: Integer, hashes: Integer, repeats: Integer) {
    verifyLock(lockPath)
    let cpu = pinCPU()
    test.check(cpu >= 0, "cannot pin stable-sort peers to minimum allowed CPU")
    let active = otherJobs(context.root)
    test.check(active == "[]", "Other benchmark jobs active: " + active)
    let identities = json.member(manifest, "hashes")
    test.check(identities.kind == json.OBJECT, "missing stable-sort prepared identities")
    for path in identities.keys { phase.verify(path, json.string(identities, path)) }
    phase.verify("/proc/self/exe", phase.string(manifest, "driver_binary_sha256"))
    test.check(count == phase.integer(manifest, "count") && hashes == phase.integer(manifest, "hash_count"), "stable-sort prepared fixture counts changed")
    let history = json.member(manifest, "commands")
    test.check(history.kind == json.ARRAY, "missing stable-sort preparation command records")
    for invocation in history.items { context.commands.add(benchmark.serialize(invocation)) }
    let observations: List<Observation> = []
    let rows: List<Text> = []
    let rng = random.seeded("51398")
    let peers = ["minyar", "rust", "swift", "minyar-model"]
    for kind in ["integers", "records", "hashes"] {
        let selectedCount = count
        if kind == "hashes" { selectedCount = hashes }
        let expectedLines = test.lines(run(context, peerCommand(context, kind, "minyar-model", selectedCount)))
        test.check(expectedLines.length == 2, "independent stable-sort model requires two integer rows")
        let expected = Integer(expectedLines[1])
        for iteration in 0..(repeats + 1) {
            let order = peers.slice(0, peers.length)
            let index = order.length - 1
            while index > 0 {
                let selected = random.below(rng, index + 1)
                let previous = order[index]
                order[index] = order[selected]
                order[selected] = previous
                index -= 1
            }
            for peer in order {
                let lines = test.lines(run(context, peerCommand(context, kind, peer, selectedCount)))
                test.check(lines.length == 2, "stable-sort peer requires two integer rows")
                let nanos = Integer(lines[0])
                let checksum = Integer(lines[1])
                test.check(checksum == expected, kind + " " + peer + " checksum differs from independent stable-sort model")
                observations.add(Observation { kind: kind; peer: peer; count: selectedCount; iteration: iteration; nanoseconds: nanos; checksum: checksum })
                rows.add("{\"kind\":" + benchmark.quote(kind) + ",\"peer\":" + benchmark.quote(peer) + ",\"count\":" + Text(selectedCount) + ",\"iteration\":" + Text(iteration) + ",\"warmup\":" + Text(iteration == 0) + ",\"nanoseconds\":" + Text(nanos) + ",\"checksum\":" + Text(checksum) + "}")
                files.writeStandardOutput(kind + " " + peer + " " + Text(selectedCount) + " " + Text(iteration) + " " + Text(nanos) + " " + Text(checksum) + "\n")
            }
        }
    }
    let medians: List<Text> = []
    for kind in ["integers", "records", "hashes"] {
        let values: List<Text> = []
        for peer in peers {
            let timings: List<Integer> = []
            for observed in observations { if observed.kind == kind && observed.peer == peer && observed.iteration > 0 { timings.add(observed.nanoseconds) } }
            values.add(benchmark.quote(peer) + ":" + median(timings))
        }
        medians.add(benchmark.quote(kind) + ":{" + text.joined(values, ",") + "}")
    }
    let medianJSON = "{" + text.joined(medians, ",") + "}"
    let receipt = "{\"successful\":true,\"cpu\":" + Text(cpu) + ",\"lock\":" + benchmark.quote(lockPath) + ",\"other_ws3_jobs_at_start\":" + active + ",\"versions\":" + benchmark.serialize(json.member(manifest, "versions")) + ",\"source_hashes\":" + benchmark.serialize(json.member(manifest, "source_hashes")) + ",\"fixture_sha256\":" + benchmark.quote(phase.string(manifest, "fixture_sha256")) + ",\"observations\":[" + text.joined(rows, ",") + "],\"median_nanoseconds\":" + medianJSON + ",\"scope\":\"Descriptive new API peers. Different object layouts; no pre-sort Minyar API baseline exists. Existing whole-program 1% gates remain separate.\",\"peer_dispositions\":" + benchmark.serialize(json.member(manifest, "peer_dispositions")) + "}"
    writeTextFile(context.directory + "/results.json", receipt + "\n")
    files.writeStandardOutput(medianJSON + "\n")
}

let prepareOnly = false
let runPrepared = false
let lockPath = ""
let directory = "build/sort-peer"
let clang = test.setting("MINYAR_TEST_CLANG", "/usr/lib/llvm-23/bin/clang")
let swift = test.setting("MINYAR_SORT_SWIFTC", "/home/user/.local/share/swiftly/bin/swiftc")
let compiler = test.setting("MINYAR_TEST_COMPILER", "./build/minyarc")
let callbacks = test.setting("MINYAR_TEST_CALLBACK_COMPILER", "./build/minyarc-callbacks")
let repeats = 5
let count = 262144
let hashes = 2000000
let countGiven = false
let hashesGiven = false
let optionIndex = 0
while optionIndex < argumentCount() {
    let option = argument(optionIndex)
    if option == "--prepare-only" { prepareOnly = true }
    else if option == "--run-prepared" { runPrepared = true }
    else {
        test.check(optionIndex + 1 < argumentCount(), "missing stable-sort benchmark option value")
        optionIndex += 1
        let value = argument(optionIndex)
        if option == "--lock" { lockPath = value }
        else if option == "--swiftc" { swift = value }
        else if option == "--clang" { clang = value }
        else if option == "--repeats" { repeats = Integer(value) }
        else if option == "--count" { count = Integer(value); countGiven = true }
        else if option == "--hash-count" { hashes = Integer(value); hashesGiven = true }
        else if option == "--artifacts" || option == "--work" { directory = value }
        else if option == "--compiler" { compiler = value }
        else if option == "--callback-compiler" { callbacks = value }
        else { fail("unknown stable-sort benchmark option: " + option) }
    }
    optionIndex += 1
}
test.check(lockPath != "" && prepareOnly != runPrepared, "stable-sort benchmark requires --lock and exactly one --prepare-only/--run-prepared phase")
test.check(repeats > 0 && count >= 0 && hashes >= 0, "invalid stable-sort repetition or fixture count")
let scratch = test.scratch()
if prepareOnly { test.require(test.run(["mkdir", "-p", "--", directory], system.environment(), "", scratch + "/mkdir", 10), "stable-sort artifact directory") }
else { test.check(files.pathSize(directory) >= 0, "stable-sort measurement requires an existing prepared artifact directory") }
directory = phase.absolute(directory, scratch)
let rootResult = test.run(["pwd", "-P"], system.environment(), "", scratch + "/root", 10)
test.require(rootResult, "stable-sort project directory")
let context = Context { root: test.lines(rootResult.output)[0]; directory: directory; serial: [0]; commands: [] }
if prepareOnly { preparation(context, compiler, callbacks, clang, swift, count, hashes, repeats) }
else {
    let manifest = phase.read(directory + "/prepared.json")
    if !countGiven { count = phase.integer(manifest, "count") }
    if !hashesGiven { hashes = phase.integer(manifest, "hash_count") }
    test.check(count >= 0 && hashes >= 0, "invalid prepared stable-sort fixture count")
    measurement(context, manifest, lockPath, count, hashes, repeats)
}
test.removeTree(scratch)
