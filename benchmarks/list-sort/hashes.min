// Realistic 2M content-addressed image/brief-crawl manifest fixture: 64-byte
// SHA256 hexadecimal hashes, including duplicate contents. Fixture is generated
// independently by the runner; parsing and checksum are outside sort timing.
use "system" as system
let count = 2000000
let input = readTextFile(argument(0))
let hashes: List<Text> = []
let i = 0
while i < count { hashes.add(input.slice(i * 65, i * 65 + 64)); i = i + 1 }
let start = system.monotonicNanoseconds()
hashes.sort()
print(system.monotonicNanoseconds() - start)
let checksum = 0
i = 0
while i < count {
    let hash = hashes[i]
    let j = 0
    while j < 8 { checksum = (checksum * 131 + Integer(hash[j])) % 1000000007; j = j + 1 }
    i = i + 1
}
print(checksum)
