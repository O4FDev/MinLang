use "system" as system
record Row { key: Integer; id: Integer }
let count = 262144
let rows: List<Row> = []
let i = 0
while i < count { rows.add(Row { key: ((i * 1103515245 + 12345) % 2147483647) % 1024; id: i }); i = i + 1 }
let compare = function(a: Row, b: Row): Integer { return a.key - b.key }
let start = system.monotonicNanoseconds()
rows.sortBy(compare)
print(system.monotonicNanoseconds() - start)
let checksum = 0
i = 0
while i < count { checksum = (checksum * 131 + rows[i].id) % 1000000007; i = i + 1 }
print(checksum)
