use "system" as system
let count = 262144
let values: List<Integer> = []
let i = 0
while i < count { values.add((i * 1103515245 + 12345) % 2147483647); i = i + 1 }
let start = system.monotonicNanoseconds()
values.sort()
print(system.monotonicNanoseconds() - start)
let checksum = 0
i = 0
while i < count { checksum = (checksum * 131 + values[i]) % 1000000007; i = i + 1 }
print(checksum)
