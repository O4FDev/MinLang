// Parses an Atacama history response the way the app does: json.parse, then
// each run's fields with json.member and json.string.
//   ./minyar --release benchmarks/json/history-parse.min -o build/history-parse
//   python3 benchmarks/json/history.py 500 > build/history.json
//   build/history-parse build/history.json 20
use "json" as json

let source = readTextFile(argument(0))
let rounds = 1
if argumentCount() > 1 {
    let digits = argument(1)
    rounds = 0
    let position = 0
    while position < digits.length {
        rounds = rounds * 10 + Integer(digits[position]) - Integer('0')
        position = position + 1
    }
}
let characters = 0
let runs = 0
let round = 0
while round < rounds {
    let history = json.parse(source)
    let items = json.member(history, "runs").items
    let index = 0
    while index < items.length {
        let item = items[index]
        let response = json.member(item, "response")
        characters = characters + json.string(item, "id").length + json.string(item, "prompt").length
        characters = characters + json.string(response, "text").length + json.member(response, "sources").items.length
        runs = runs + 1
        index = index + 1
    }
    round = round + 1
}
print(runs)
print(characters)
