use "process" as processInfo
use "files" as files

let words = ["the", "atacama", "desert", "is", "a", "plateau", "in", "south", "america", "covering", "a", "strip", "of", "land", "on", "the", "pacific", "coast"]
let sentence: List<Text> = []
for index in 0..words.length {
    if index > 0 { sentence.add(" ") }
    sentence.add(words[index])
}
let text = joinText(sentence)
let runs = 500
if processInfo.argumentCount() > 0 { runs = Integer(processInfo.argument(0)) }
let pieces = ["{\"runs\": ["]
for index in 0..runs {
    if index > 0 { pieces.add(", ") }
    pieces.add("{\"id\": \"run-" + Text(index) + "\", \"mode\": \"ask\", \"created_at\": \"2026-10-09T12:00:00Z\", \"prompt\": \"Question " + Text(index) + ": where is the " + words[index % words.length] + " and why is it so dry?\", \"response\": {\"text\": \"Answer " + Text(index) + ". " + text + "\", \"sources\": []}}")
}
pieces.add("], \"hasMore\": false}")
files.writeStandardOutput(joinText(pieces))
