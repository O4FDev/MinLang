use "io" as io
use "process" as processInfo
// CSV/log parser: split lines and fields, parse Integers, aggregate per service.
record Stats { count: Integer; total: Integer; slowest: Integer; errors: Integer }
let text = io.readTextFile(processInfo.argument(0))
let services: Map<Text, Stats> = Map()
let warnings = 0
for line in text.split("\n") {
    if line.length == 0 { continue }
    let fields = line.split(",")
    let latency = Integer(fields[3])
    let status = Integer(fields[4])
    if fields[1] == "WARN" { warnings += 1 }
    if !services.has(fields[2]) { services[fields[2]] = Stats { count: 0; total: 0; slowest: 0; errors: 0 } }
    let stats = services[fields[2]]
    stats.count += 1
    stats.total += latency
    if latency > stats.slowest { stats.slowest = latency }
    if status >= 500 { stats.errors += 1 }
}
let names: List<Text> = []
for name in services { names.add(name) }
names.sort()
print(warnings)
for name in names {
    let stats = services[name]
    print("\(name) \(stats.count) \(stats.total / stats.count) \(stats.slowest) \(stats.errors)")
}
