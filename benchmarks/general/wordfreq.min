use "io" as io
use "process" as processInfo
// Word frequency over a large text file: split lines and words, count in a
// Map<Text, Integer>, then print the 10 most frequent words.
record Entry { word: Text; count: Integer }
let text = io.readTextFile(processInfo.argument(0))
let counts: Map<Text, Integer> = Map()
let total = 0
for line in text.split("\n") {
    for word in line.split(" ") {
        if word.length == 0 { continue }
        total += 1
        if counts.has(word) { counts[word] += 1 } else { counts[word] = 1 }
    }
}
let entries: List<Entry> = []
for word in counts { entries.add(Entry { word: word; count: counts[word] }) }
entries.sortBy(function(a: Entry, b: Entry): Integer {
    if a.count != b.count { return b.count - a.count }
    if a.word < b.word { return -1 }
    if a.word > b.word { return 1 }
    return 0
})
print(total)
print(entries.length)
for i in 0..10 { print("\(entries[i].word) \(entries[i].count)") }
