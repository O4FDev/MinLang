// Records in a List: build orders, then filter, derive, group and rank them.
record Order { id: Integer; customer: Integer; region: Integer; price: Integer; quantity: Integer; discount: Integer }
record Ranked { id: Integer; total: Integer }
let count = 1000000
let seed = 12345
let orders: List<Order> = []
for i in 0..count {
    seed = (seed * 1103515245 + 12345) % 2147483648
    let price = 100 + (seed / 64) % 9900
    seed = (seed * 1103515245 + 12345) % 2147483648
    orders.add(Order { id: i; customer: (seed / 16) % 50000; region: (seed / 8) % 16; price: price; quantity: 1 + (seed / 256) % 7; discount: (seed / 7) % 500 })
}
let checksum = 0
for pass in 0..20 {
    let regions: List<Integer> = []
    for r in 0..16 { regions.add(0) }
    let large = 0
    for order in orders {
        let total = order.price * order.quantity - order.discount
        if total > 5000 + pass * 100 {
            regions[order.region] += total
            large += 1
        }
    }
    for r in 0..16 { checksum = (checksum * 31 + regions[r]) % 1000000007 }
    checksum = (checksum + large) % 1000000007
}
let ranked: List<Ranked> = []
for order in orders {
    if order.customer % 10 == 0 { ranked.add(Ranked { id: order.id; total: order.price * order.quantity - order.discount }) }
}
ranked.sortBy(function(a: Ranked, b: Ranked): Integer {
    if a.total != b.total { return b.total - a.total }
    return a.id - b.id
})
for i in 0..100 { checksum = (checksum * 31 + ranked[i].id) % 1000000007 }
print(ranked.length)
print(checksum)
