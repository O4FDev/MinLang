// Rebuild a history list the way the Atacama desktop app does: one stack of
// labels and a button per entry, rebuilt whole when the entries or the search
// change. Prints the median milliseconds per rebuild, including layout.
//
//     ./minyar --release benchmarks/desktop/history-rows.min -o build/history-rows
//     build/history-rows 500
use "macos" as mac

function entry(list: Integer, index: Integer) {
    let row = mac.row(list, 15)
    mac.fill(row)
    mac.insets(row, 18, 0, 18, 0)
    let open = mac.column(row, 6)
    mac.clickable(open)
    mac.grow(open)
    mac.fill(open)
    let date = mac.label(open, "10 Oct 2026")
    mac.font(date, "", 11.0, 400.0)
    mac.selectable(date, false)
    let prompt = mac.label(open, "Question number " + Text(index) + ": where is the Atacama Desert, and why is it so dry?")
    mac.font(prompt, "", 14.0, 450.0)
    mac.lineHeight(prompt, 1.6)
    mac.lines(prompt, 0)
    mac.selectable(prompt, false)
    mac.fill(prompt)
    let preview = mac.label(open, "The Atacama Desert is a plateau in South America covering a 1,600 km strip of land.")
    mac.font(preview, "", 12.0, 400.0)
    mac.lines(preview, 1)
    mac.selectable(preview, false)
    mac.fill(preview)
    let delete = mac.plainButton(row, "")
    mac.symbol(delete, "trash", 15.0)
    mac.size(delete, 34, 34)
    mac.tooltip(delete, "Delete")
    let rule = mac.view(list)
    mac.fill(rule)
    mac.size(rule, 0, 1)
}

function settle() {
    for pass in 0..3 { mac.nextEvent(0.0) }
}

function number(text: Text): Integer {
    let value = 0
    for character in text { value = value * 10 + (Integer(character) - Integer('0')) }
    return value
}

// The middle of seven timings, by counting how many are smaller.
function median(times: List<Float>): Float {
    for candidate in times {
        let below = 0
        for other in times { if other < candidate { below += 1 } }
        if below == times.length / 2 { return candidate }
    }
    return times[0]
}

function main(): Integer {
    let count = 200
    if argumentCount() > 0 { count = number(argument(0)) }
    mac.initialize("History rows")
    let window = mac.window("History rows", 900, 700)
    let scroll = mac.scroll(window)
    let list = mac.column(scroll, 0)
    mac.fill(list)
    mac.show(window)
    settle()
    let times: List<Float> = []
    for repeat in 0..7 {
        let start = mac.seconds()
        mac.clear(list)
        for index in 0..count { entry(list, index) }
        settle()
        times.add((mac.seconds() - start) * 1000.0)
    }
    print("rows " + Text(count) + " median_ms " + Text(median(times)))
    return 0
}
