// The history-rows benchmark with macos.list instead of a stack per row: the
// same three lines and trailing button, rebuilt whole each time.
//
//     ./minyar --release benchmarks/desktop/history-list.min -o build/history-list
//     build/history-list 500
use "macos" as mac

function settle() {
    for pass in 0..3 { mac.nextEvent(0.0) }
}

function number(text: Text): Integer {
    let value = 0
    for character in text { value = value * 10 + (Integer(character) - Integer('0')) }
    return value
}

// The middle of seven timings, by counting how many are smaller.
function median(times: List<Float>): Float {
    for candidate in times {
        let below = 0
        for other in times { if other < candidate { below += 1 } }
        if below == times.length / 2 { return candidate }
    }
    return times[0]
}

function main(): Integer {
    let count = 200
    if argumentCount() > 0 { count = number(argument(0)) }
    mac.initialize("History list")
    let window = mac.window("History list", 900, 700)
    let root = mac.column(window, 0)
    let list = mac.list(root)
    mac.fill(list)
    mac.grow(list)
    mac.listLine(list, 0, "", 11.0, 400.0, 0, 1)
    mac.listLine(list, 1, "", 14.0, 450.0, 0, 0)
    mac.listLine(list, 2, "", 12.0, 400.0, 0, 1)
    mac.rowButton(list, "trash", "Delete", 0)
    mac.show(window)
    settle()
    let times: List<Float> = []
    for repeat in 0..7 {
        let start = mac.seconds()
        mac.clear(list)
        for index in 0..count {
            mac.addRow(list, "10 Oct 2026", "Question number " + Text(index) + ": where is the Atacama Desert, and why is it so dry?",
                "The Atacama Desert is a plateau in South America covering a 1,600 km strip of land.")
        }
        settle()
        times.add((mac.seconds() - start) * 1000.0)
    }
    if mac.rowCount(list) != count { return 1 }
    print("rows " + Text(count) + " median_ms " + Text(median(times)))
    return 0
}
