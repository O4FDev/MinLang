// Deterministic workload for the Text APIs, managed split, parsing and reuse.
// Expected checksum: 11200000. Time on an exclusive, affinity-pinned Boat.
let source = " \tpostgres:x:70:70:PostgreSQL:/var/lib/postgresql:/bin/sh　"
let unicode = "é🍊é零"
let reusable: List<Integer> = []
let checksum = 0
for iteration in 0..100000 {
    let line = source.trim()
    let fields = line.split(":")
    checksum += Integer(fields[2]) + fields.length + line.find("PostgreSQL")
    checksum += unicode.find("零") + unicode.split("").length
    if line.startsWith("postgres:") { checksum += 1 }
    if line.endsWith("/bin/sh") { checksum += 1 }
    for value in 0..32 { reusable.add(value) }
    reusable.clear()
    checksum += reusable.length
    reusable.add(7)
    checksum += reusable[0]
    reusable.clear()
}
print(checksum)
