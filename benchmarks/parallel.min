// The same checked program runs with 1, 2, 4, 8 or 10 threads. Every sample
// prints the same checksum; allocation and final summation are included.
parallel function orbit(index: Integer, width: Integer, height: Integer): Integer {
    let x = Float(index % width) / Float(width) * 3.2 - 2.2
    let y = Float(index / width) / Float(height) * 2.4 - 1.2
    let real = 0.0
    let imaginary = 0.0
    let iterations = 0
    while real * real + imaginary * imaginary <= 4.0 && iterations < 1536 {
        let next = real * real - imaginary * imaginary + x
        imaginary = 2.0 * real * imaginary + y
        real = next
        iterations += 1
    }
    return iterations
}
let width = 1536
let height = 1024
let output: List<Integer> = []
for index in 0..(width * height) { output.add(0) }
for pass in 0..3 {
    parallel for index in 0..output.length {
        output[index] = orbit(index, width, height)
    }
}
let checksum = 0
for iterations in output { checksum += iterations }
print(checksum)
