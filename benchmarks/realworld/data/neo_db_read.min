// Fixed read-only workload over a prepared neo-db directory: prepared `select 1`
// and primary-key lookups, interleaved with an LCG, exactly like a warm OLTP
// read path. Prints the row count and a checksum so the suite can prove the work.
// usage: read DIR [ITERATIONS]
use "process" as process
use "../../src/embed.min" as embed

function main(): Integer {
    let dir = process.argument(0)
    let n = 8000
    if process.argumentCount() > 1 { n = Integer(process.argument(1)) }
    let db = embed.open(dir)
    let counted = embed.run(db, "select count(*) from accounts").unwrap()
    let count = embed.integer(counted, 0, 0)
    let select1 = embed.prepare(db, "select 1").unwrap()
    let pk = embed.prepare(db, "select abalance from accounts where aid = $1").unwrap()
    let checksum = 0
    let seed = 12345
    for i in 0..n {
        let one = embed.query(db, select1, []).unwrap()
        checksum = wrappingAdd(checksum, embed.integer(one, 0, 0))
        seed = wrappingAdd(wrappingMultiply(seed, 6364136223846793005), 1442695040888963407)
        let aid = ((seed >> 20) & 1048575) % count + 1
        let row = embed.query(db, pk, [Text(aid)]).unwrap()
        checksum = wrappingAdd(checksum, embed.integer(row, 0, 0))
    }
    embed.close(db)
    print("rows " + Text(count) + " checksum " + Text(checksum))
    return 0
}
