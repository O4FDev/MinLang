+/*
+ * A surface for the next frame that the window server is not showing, sized
+ * for the framebuffer. NULL if all of them are still in use.
+ */
+- (IOSurfaceRef) freeSurfaceWidth:(int)w height:(int)h
+{
+    for (int i = 0; i < ARRAY_SIZE(surfaces); i++) {
+        IOSurfaceRef surface = surfaces[i];
+        if (surface && (IOSurfaceGetWidth(surface) != w ||
+                        IOSurfaceGetHeight(surface) != h)) {
+            if (surface == shownSurface) {
+                shownSurface = NULL;
+            }
+            CFRelease(surface);
+            surface = surfaces[i] = NULL;
         }
-        CGImageRelease (imageRef);
-        CGDataProviderRelease(dataProviderRef);
+        if (!surface) {
+            NSDictionary *properties = @{
+                (id)kIOSurfaceWidth: @(w),
+                (id)kIOSurfaceHeight: @(h),
+                (id)kIOSurfaceBytesPerElement: @4,
+                (id)kIOSurfacePixelFormat: @(kCVPixelFormatType_32BGRA),
+            };
+            surface = surfaces[i] = IOSurfaceCreate((CFDictionaryRef)properties);
+            if (!surface) {
+                continue;
+            }
+            CFPropertyListRef space = CGColorSpaceCopyPropertyList(colorspace);
+            IOSurfaceSetValue(surface, kIOSurfaceColorSpace, space);
+            CFRelease(space);
+        }
+        if (surface != shownSurface && !IOSurfaceIsInUse(surface)) {
+            return surface;
+        }
+    }
+    return NULL;
+}
+
+/*
+ * Hand the framebuffer to Core Animation as the layer's contents instead of
+ * drawing it with Core Graphics. drawRect: made the CPU convert every dirty
+ * pixel into the window's backing store, which is half-float on wide-gamut
+ * displays: a full 1080p frame took tens of milliseconds of the main thread,
+ * stalling input and later frames. An IOSurface goes to the window server,
+ * which composites and colour matches it on the GPU and keeps it while the
+ * window is hidden, so nothing has to be redrawn when it is shown again.
+ * Each frame is copied to a surface the window server is not reading, so the
+ * guest writing its framebuffer never tears what is on screen.
+ */
+- (void) updateLayer
+{
+    COCOA_DEBUG("QemuCocoaView: updateLayer\n");
+
+    if (!pixman_image ||
+        PIXMAN_FORMAT_BPP(pixman_image_get_format(pixman_image)) != 32) {
+        // No guest framebuffer yet: show the layer's black background
+        [[self layer] setContents:nil];
+        shownSurface = NULL;
+        return;
+    }
+
+    int w = pixman_image_get_width(pixman_image);
+    int h = pixman_image_get_height(pixman_image);
+    IOSurfaceRef surface = [self freeSurfaceWidth:w height:h];
+    if (!surface) {
+        // Every surface is on screen: draw into the shown one in place
+        surface = shownSurface;
+        if (!surface) {
+            return;
+        }
+    }
+
+    const uint8_t *source = (const uint8_t *)pixman_image_get_data(pixman_image);
+    int sourceStride = pixman_image_get_stride(pixman_image);
+    IOSurfaceLock(surface, 0, NULL);
+    uint8_t *target = IOSurfaceGetBaseAddress(surface);
+    size_t targetStride = IOSurfaceGetBytesPerRow(surface);
+    for (int y = 0; y < h; y++) {
+        const uint32_t *from = (const uint32_t *)(source + (size_t)y * sourceStride);
+        uint32_t *to = (uint32_t *)(target + y * targetStride);
+        // The framebuffer's top byte is padding; the surface's is alpha
+        for (int x = 0; x < w; x++) {
+            to[x] = from[x] | 0xff000000;
+        }
+    }
+    IOSurfaceUnlock(surface, 0, NULL);
+
+    if (surface == shownSurface) {
+        [[self layer] setContentsChanged];
+    } else {
+        [[self layer] setContents:(id)surface];
+        shownSurface = surface;
     }
 }
 
