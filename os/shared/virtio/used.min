// Validation for DMA-written virtio split-ring metadata. Kept independent of
// the hardware driver so hostile values can be regression-tested on the host.

function distance(later: Integer, earlier: Integer): Integer {
    return (later - earlier) & 0xFFFF
}

// The driver may only add another head while fewer than `size` chains are
// outstanding, and every head names a descriptor in this queue.
public function validOffer(size: Integer, offered: Integer, collected: Integer, head: Integer, headOutstanding: Boolean): Boolean {
    if size <= 0 || head < 0 || head >= size || headOutstanding { return false }
    return distance(offered, collected) < size
}

// A device may complete only a chain the driver has made available. The used
// index is 16-bit and may wrap, so compare modular distances. The per-head bit
// rejects replay of an in-range descriptor while another head stays orphaned.
public function validCompletion(size: Integer, offered: Integer, collected: Integer, usedIndex: Integer, head: Integer, headOutstanding: Boolean): Boolean {
    if size <= 0 || head < 0 || head >= size || !headOutstanding { return false }
    let completed = distance(usedIndex, collected)
    let outstanding = distance(offered, collected)
    return completed > 0 && outstanding <= size && completed <= outstanding
}

// A caller may only consume bytes the device says it wrote, and a device
// cannot have written beyond the writable capacity of the offered chain.
public function validLength(length: Integer, required: Integer, capacity: Integer): Boolean {
    return required >= 0 && required <= capacity && length >= required && length <= capacity
}
