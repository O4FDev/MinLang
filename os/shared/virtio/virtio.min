// Virtio over PCI (the "modern" interface of virtio 1.x), the way QEMU and
// other virtual machines present disks, input devices and entropy sources.
// Drivers for those build on this: os/shared/virtio/block.min, input.min and
// entropy.min.
//
// A virtio device is a PCI function with vendor 0x1AF4 and device 0x1040 plus
// its type. Its registers are found through vendor capabilities in PCI
// configuration space: a common configuration block (features, status,
// queues), a notification area and the device's own configuration. Requests
// travel through virtqueues in ordinary memory: a table of buffer
// descriptors, an "available" ring of chains the driver offers, and a "used"
// ring of chains the device has finished. Interrupts are not used; drivers
// poll the used ring.
use "machine" as machine
use "device" as device
use "dma" as dma
use "../pci.min" as pci
use "./used.min" as used

public constant BLOCK = 2
public constant ENTROPY = 4
public constant INPUT = 18

// Descriptor flags: another descriptor follows; the device writes this buffer.
public constant NEXT = 1
public constant WRITE = 2

constant ACKNOWLEDGE = 1
constant DRIVER = 2
constant DRIVER_OK = 4
constant FEATURES_OK = 8

public record Device {
    private common: device.Registers
    private notifyBase: Integer
    private notifyMultiplier: Integer
    private configuration: device.Registers
}

public record Queue {
    // How many descriptors the queue has.
    size: Integer
    private index: Integer
    private notifyAddress: device.Register16
    private descriptors: device.Memory
    private available: device.Memory
    private used: device.Memory
    private offered: Integer
    private collected: Integer
    private outstanding: List<Boolean>
    // The length the device reported for the last chain `collect` returned.
    length: Integer
}

// Every virtio device of `type` among the PCI devices.
public function find(devices: List<pci.Device>, type: Integer): List<pci.Device> {
    let found: List<pci.Device> = []
    for card in devices {
        if card.vendor == 0x1AF4 && card.device == 0x1040 + type {
            found.add(card)
        }
    }
    return found
}

// The registers a virtio capability locates: `length` bytes at an offset into one of the BARs.
function capabilityWindow(card: pci.Device, at: Integer): device.Registers {
    let bar = pci.read8(card, at + 4)
    let offset = pci.read32(card, at + 8)
    let length = pci.read32(card, at + 12)
    return device.registers(pci.memoryBar(card, bar) + offset, max(length, 4))
}

// Reset the device and agree on the virtio 1 feature set; then set up its
// queues with `openQueue` and call `ready`.
public function open(card: pci.Device): Device {
    pci.enable(card)
    if (pci.read16(card, 0x06) & 0x10) == 0 {
        fail("virtio device " + Text(card.device) + " has no capabilities")
    }
    let common = device.registers(4096, 4096)
    let configuration = device.registers(4096, 4096)
    let notifyBase = 0
    let notifyMultiplier = 0
    let found = 0
    let at = pci.read8(card, 0x34) & 0xFC
    let guard = 0
    while at != 0 && guard < 48 {
        if pci.read8(card, at) == 0x09 {
            let kind = pci.read8(card, at + 3)
            if kind == 1 {
                common = capabilityWindow(card, at)
                found = found | 1
            } else if kind == 2 {
                notifyBase = pci.memoryBar(card, pci.read8(card, at + 4)) + pci.read32(card, at + 8)
                notifyMultiplier = pci.read32(card, at + 16)
                found = found | 2
            } else if kind == 4 {
                configuration = capabilityWindow(card, at)
            }
        }
        at = pci.read8(card, at + 1) & 0xFC
        guard += 1
    }
    if (found & 3) != 3 {
        fail("virtio device " + Text(card.device) + " lacks its common or notification registers")
    }
    let opened = Device { common: common; notifyBase: notifyBase; notifyMultiplier: notifyMultiplier; configuration: configuration }
    device.writeAt8(common, 0x14, 0)
    let spins = 0
    while device.readAt8(common, 0x14) != 0 && spins < 1000000 {
        spins += 1
    }
    if device.readAt8(common, 0x14) != 0 { fail("virtio device did not finish resetting") }
    device.writeAt8(common, 0x14, ACKNOWLEDGE | DRIVER)
    // Feature bit 32, VERSION_1, is the only one used.
    device.writeAt32(common, 0x00, 1)
    if (device.readAt32(common, 0x04) & 1) == 0 {
        fail("virtio device " + Text(card.device) + " does not offer virtio 1")
    }
    device.writeAt32(common, 0x08, 0)
    device.writeAt32(common, 0x0C, 0)
    device.writeAt32(common, 0x08, 1)
    device.writeAt32(common, 0x0C, 1)
    device.writeAt8(common, 0x14, ACKNOWLEDGE | DRIVER | FEATURES_OK)
    if (device.readAt8(common, 0x14) & FEATURES_OK) == 0 {
        fail("virtio device " + Text(card.device) + " refused the virtio 1 features")
    }
    return opened
}

// The device's own configuration block, such as a disk's capacity.
public function configuration(opened: Device): device.Registers {
    return opened.configuration
}

function writeAddress(common: device.Registers, offset: Integer, address: device.DeviceAddress) {
    device.writeAt32(common, offset, device.addressLow(address))
    device.writeAt32(common, offset + 4, device.addressHigh(address))
}

// Set up queue `index` with at most `size` descriptors (a power of two).
public function openQueue(opened: Device, index: Integer, size: Integer): Queue {
    let common = opened.common
    device.writeAt16(common, 0x16, index)
    let count = min(device.readAt16(common, 0x18), size)
    if count == 0 {
        fail("virtio queue " + Text(index) + " does not exist")
    }
    device.writeAt16(common, 0x18, count)
    let descriptors = device.allocate(count * 16, 16)
    let available = device.allocate(6 + count * 2, 2)
    let used = device.allocate(6 + count * 8, 4)
    let outstanding: List<Boolean> = []
    for slot in 0..count { outstanding.add(false) }
    writeAddress(common, 0x20, device.deviceAddress(descriptors, 0))
    writeAddress(common, 0x28, device.deviceAddress(available, 0))
    writeAddress(common, 0x30, device.deviceAddress(used, 0))
    let notifyAddress = opened.notifyBase + device.readAt16(common, 0x1E) * opened.notifyMultiplier
    device.writeAt16(common, 0x1C, 1)
    return Queue {
        size: count; index: index; notifyAddress: device.register16(device.registers(notifyAddress, 2), 0)
        descriptors: descriptors; available: available; used: used; offered: 0; collected: 0
        outstanding: outstanding; length: 0
    }
}

// Tell the device the driver is ready, once every queue is set up.
public function ready(opened: Device) {
    device.writeAt8(opened.common, 0x14, ACKNOWLEDGE | DRIVER | FEATURES_OK | DRIVER_OK)
}

// Fill descriptor `slot`: a buffer at a physical address, with NEXT and WRITE
// flags and the following descriptor when NEXT is set.
// `address` is a DMA address from device.deviceAddress, never a CPU pointer.
public function describe(queue: Queue, slot: Integer, address: device.DeviceAddress, length: Integer, flags: Integer, next: Integer) {
    let at = slot * 16
    device.storeAddress(queue.descriptors, at, address)
    device.store32(queue.descriptors, at + 8, length)
    device.store16(queue.descriptors, at + 12, flags)
    device.store16(queue.descriptors, at + 14, next)
}

// Offer the chain starting at descriptor `head` to the device, without telling it yet.
public function offer(queue: Queue, head: Integer) {
    let headOutstanding = false
    if head >= 0 && head < queue.size {
        headOutstanding = queue.outstanding[head]
    }
    if !used.validOffer(queue.size, queue.offered, queue.collected, head, headOutstanding) {
        fail("virtio queue is full or has an invalid descriptor head")
    }
    queue.outstanding[head] = true
    device.store16(queue.available, 4 + (queue.offered % queue.size) * 2, head)
    machine.fence()
    queue.offered = (queue.offered + 1) & 0xFFFF
    device.store16(queue.available, 2, queue.offered)
}

// Tell the device that chains have been offered.
public function notify(queue: Queue) {
    machine.fence()
    device.write16(queue.notifyAddress, queue.index)
}

// The head of the next chain the device has finished, or -1 if none is
// waiting; its length is then in queue.length.
public function collect(queue: Queue): Integer {
    let usedIndex = device.load16(queue.used, 2)
    if usedIndex == queue.collected {
        return -1
    }
    // The device publishes used entries before its index. Acquire after
    // observing that changed index, before reading the entry or DMA data.
    machine.fence()
    let at = 4 + (queue.collected % queue.size) * 8
    let head = device.load32(queue.used, at)
    let headOutstanding = false
    if head >= 0 && head < queue.size {
        headOutstanding = queue.outstanding[head]
    }
    // A head that is not outstanding is a stale, duplicated or forged
    // completion; name it the way complete names a chain it did not offer.
    if !headOutstanding {
        fail("virtio device completed chain " + Text(head) + ", which the driver has not offered")
    }
    // More used entries than outstanding chains means one of them is a
    // duplicate; name it the way complete names an unrequested completion.
    if ((usedIndex - queue.collected) & 0xFFFF) > ((queue.offered - queue.collected) & 0xFFFF) {
        fail("virtio device published a completion for no offered chain")
    }
    if !used.validCompletion(queue.size, queue.offered, queue.collected, usedIndex, head, headOutstanding) {
        fail("virtio device reported an invalid used-ring completion")
    }
    queue.length = device.load32(queue.used, at + 4)
    queue.outstanding[head] = false
    queue.collected = (queue.collected + 1) & 0xFFFF
    return head
}

// Offer one chain, notify, and wait for the device to finish it.
// The device must hand back the chain that was offered: a used entry for any
// other descriptor (stale, duplicated or forged) would let the caller read a
// buffer the device has not filled, so it stops instead.
public function complete(queue: Queue, head: Integer) {
    // Nothing is outstanding yet, so the device owes no completion: an extra
    // used entry now is stale or duplicated and would be taken for this one.
    if device.load16(queue.used, 2) != queue.collected {
        fail("virtio device published a completion for no offered chain")
    }
    offer(queue, head)
    notify(queue)
    let spins = 0
    let finished = collect(queue)
    while finished < 0 {
        machine.pause()
        spins += 1
        if spins > 100000000 {
            fail("a virtio device did not answer")
        }
        finished = collect(queue)
    }
    if finished != head {
        fail("virtio device completed chain " + Text(finished) + " instead of the offered chain " + Text(head))
    }
}
record EntropyDmaState { attempted: Boolean }
global entropyDmaState: EntropyDmaState = EntropyDmaState { attempted: false }

// Private trusted bridge: exact rule20 signature/provider, ordinary actual
// Queue owner. Do not publish this Integer-address factory in library/dma.min.
function unsafeVirtioQueue(owner: Queue, descriptors: Integer, available: Integer,
                          used: Integer, notify: Integer, size: Integer,
                          index: Integer): dma.Queue { native "dma" }

function entropyDmaQueue(card: pci.Device, slots: Integer): dma.Queue {
    let state = entropyDmaState
    if state.attempted { fail("checked virtio-rng is one-shot for this VM; reset/retry is unsupported") }
    state.attempted = true
    if card.vendor != 0x1AF4 || card.device != 0x1044 {
        fail("checked entropy DMA needs a modern virtio-rng PCI device")
    }
    let opened = open(card)
    let status = device.readAt8(opened.common, 0x14)
    if (status & 15) != 11 || (status & 0xC0) != 0 {
        fail("virtio-rng features were not accepted in the fresh initialization epoch")
    }
    device.writeAt16(opened.common, 0x16, 0)
    if device.readAt16(opened.common, 0x1C) != 0 {
        fail("virtio-rng queue zero is already enabled")
    }
    let requests = openQueue(opened, 0, slots)
    if requests.size != slots || device.readAt16(opened.common, 0x1C) != 1 {
        fail("virtio-rng could not enable its one-shot queue")
    }
    // openQueue selected this exact queue. Recompute its exact notify register
    // from the private transport state instead of exposing Register16.address.
    let notify = opened.notifyBase + device.readAt16(opened.common, 0x1E) * opened.notifyMultiplier
    let checked = unsafeVirtioQueue(requests,
        device.addressOf(requests.descriptors, 0), device.addressOf(requests.available, 0),
        device.addressOf(requests.used, 0), notify, requests.size, requests.index)
    // Runtime already retains requests and its real ring owners. No head has
    // been offered. Finish queue setup before the device can process requests.
    machine.fence()
    ready(opened)
    status = device.readAt8(opened.common, 0x14)
    if (status & 15) != 15 || (status & 0xC0) != 0 {
        fail("virtio-rng did not enter DRIVER_OK")
    }
    return checked
}

// One real device-written byte. The poison makes the deterministic guest proof
// distinguish unchanged CPU storage from actual device writes. It is overwritten
// by the device; it is never substituted for entropy or used as a fallback.
public function readOneEntropyByte(devices: List<pci.Device>): Integer {
    let cards = find(devices, ENTROPY)
    if cards.length == 0 { fail("the one-shot entropy read needs virtio-rng PCI") }
    let queue = entropyDmaQueue(cards[0], 1)
    let cpu = dma.allocate(1, 64)
    dma.store8(cpu, 0, 0xA5)
    let pending = dma.submit(queue, cpu, 1)
    let completed = dma.reclaim(pending, 1000000)
    let value = dma.load8(completed, 0)
    dma.dispose(completed)
    return value
}

// Three poisoned 4-byte buffers in flight at once on a 4-slot checked queue,
// reclaimed in order; returns the sum of every device-written byte.
function entropyRound(queue: dma.Queue): Integer {
    let a = dma.allocate(4, 64)
    let b = dma.allocate(4, 64)
    let c = dma.allocate(4, 64)
    dma.store8(a, 0, 0xA5); dma.store8(a, 3, 0xA5)
    dma.store8(b, 0, 0xA5); dma.store8(b, 3, 0xA5)
    dma.store8(c, 0, 0xA5); dma.store8(c, 3, 0xA5)
    let pa = dma.submit(queue, a, 4)
    let pb = dma.submit(queue, b, 4)
    let pc = dma.submit(queue, c, 4)
    let ca = dma.reclaim(pa, 1000000)
    let cb = dma.reclaim(pb, 1000000)
    let cc = dma.reclaim(pc, 1000000)
    let total = dma.load8(ca, 0) + dma.load8(ca, 3) + dma.load8(cb, 0) + dma.load8(cb, 3) + dma.load8(cc, 0) + dma.load8(cc, 3)
    dma.dispose(ca)
    dma.dispose(cb)
    dma.dispose(cc)
    return total
}

// `rounds` rounds of entropyRound on one 4-slot queue, so every slot is reused
// with a new generation. Returns the sum of the device-written bytes checked.
public function readEntropyRounds(devices: List<pci.Device>, rounds: Integer): Integer {
    let cards = find(devices, ENTROPY)
    if cards.length == 0 { fail("checked entropy rounds need virtio-rng PCI") }
    let queue = entropyDmaQueue(cards[0], 4)
    let total = 0
    for round in 0..rounds { total += entropyRound(queue) }
    return total
}
