// The desktop's edge glow, rendered into owned BGR0 pixels. Device-backed
// canvases use their existing raw-memory adapter at the presentation boundary.
use "pixels" as pixels

public function draw(buffer: Bytes, width: Integer, height: Integer, stride: Integer, left: Integer, top: Integer, right: Integer, bottom: Integer, table: Bytes, color: Integer, strength: Integer) {
    if width <= 0 || height <= 0 { return }
    if stride < width * 4 || stride % 4 != 0 || buffer.length < stride * height { fail("the glow buffer does not cover its pixel rows") }
    let reach = table.length / 2
    if reach == 0 || left >= right || top >= bottom { return }
    let first = clamp(left, 0, width)
    let last = clamp(right, first, width)
    let start = clamp(top, 0, height)
    let after = clamp(bottom, start, height)
    if first == last || start == after { return }
    let level = clamp(strength, 0, 256)
    parallel for index in (start * stride + first * 4)..((after - 1) * stride + last * 4) {
        let row = index / stride
        let column = index % stride / 4
        if column >= first && column < last {
            let distance = min(row, height - 1 - row)
            let vertical = 0
            if distance < reach { vertical = table[distance] }
            let value = buffer[index]
            if column < reach {
                let alpha = min(table[column] + vertical, 236) * level >> 8
                value = pixels.blendedByte(value, color, alpha + (alpha >> 7), index % 4)
            }
            if column >= reach && column < width - reach && vertical > 0 {
                let alpha = min(vertical, 236) * level >> 8
                value = pixels.blendedByte(value, color, alpha + (alpha >> 7), index % 4)
            }
            if column >= width - reach {
                let offset = reach + column - (width - reach)
                let alpha = min(table[offset] + vertical, 236) * level >> 8
                value = pixels.blendedByte(value, color, alpha + (alpha >> 7), index % 4)
            }
            buffer[index] = value
        }
    }
}
