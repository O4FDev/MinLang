// The "ghost" wordmark, drawn as vector strokes.
use "./raster.min" as raster


function sample(points: List<Float>, x0: Float, y0: Float, x1: Float, y1: Float, x2: Float, y2: Float, x3: Float, y3: Float) {
    for step in 1..13 {
        let t = Float(step) / 12.0
        let u = 1.0 - t
        points.add(u * u * u * x0 + 3.0 * u * u * t * x1 + 3.0 * u * t * t * x2 + t * t * t * x3)
        points.add(u * u * u * y0 + 3.0 * u * u * t * y1 + 3.0 * u * t * t * y2 + t * t * t * y3)
    }
}

function ring(path: raster.Path, x: Float, y: Float, radius: Float, width: Float) {
    let points: List<Float> = []
    for step in 0..40 {
        let angle = 6.283185307179586 * Float(step) / 40.0
        points.add(x + radius * cos(angle))
        points.add(y + radius * sin(angle))
    }
    raster.stroke(path, points, width, true)
}

// "ghost" in the geometric monoline letters of the reference, traced in the
// sidebar's coordinates (x-height 76-90, ascenders from 69, stroke 3.6) and
// rendered at `scale` with the mark's box at the origin. The mask is
// width(scale) × height(scale) bytes.
public function width(scale: Float): Integer {
    return Integer(ceil(84.0 * scale))
}

public function height(scale: Float): Integer {
    return Integer(ceil(34.0 * scale))
}

public function render(scale: Float): Bytes {
    let path = raster.newPath()
    let w = 3.6
    // g: a round bowl, a stem on its right, and a detached bar below.
    ring(path, 25.0, 83.0, 5.45, w)
    raster.stroke(path, [30.45, 77.0, 30.45, 90.3], w, false)
    raster.roundedRectangle(path, 23.4, 92.6, 10.4, 2.8, 1.3)
    // h
    raster.stroke(path, [36.7, 68.9, 36.7, 90.3], w, false)
    let arch: List<Float> = [36.7, 84.5]
    sample(arch, 36.7, 84.5, 36.7, 75.6, 46.1, 75.6, 46.1, 82.5)
    arch.add(46.1)
    arch.add(90.3)
    raster.stroke(path, arch, w, false)
    // o
    ring(path, 56.6, 83.05, 5.45, w)
    // s
    let s: List<Float> = [73.0, 78.9]
    sample(s, 73.0, 78.9, 71.7, 77.2, 66.6, 76.9, 66.8, 80.2)
    sample(s, 66.8, 80.2, 67.0, 83.1, 73.4, 82.6, 73.4, 86.0)
    sample(s, 73.4, 86.0, 73.4, 89.7, 67.6, 89.9, 66.5, 87.9)
    raster.stroke(path, s, w, false)
    // t
    let t: List<Float> = [82.3, 70.6, 82.3, 85.8]
    sample(t, 82.3, 85.8, 82.3, 88.6, 84.5, 88.6, 90.6, 88.6)
    raster.stroke(path, t, w, false)
    raster.stroke(path, [78.6, 77.6, 89.4, 77.6], w, false)
    // Map the traced coordinates into the mask.
    let lines = path.lines
    let index = 0
    while index < lines.length {
        lines[index] = (lines[index] - 14.0) * scale
        lines[index + 1] = (lines[index + 1] - 64.0) * scale
        index += 2
    }
    return raster.rasterize(path, 0.0, 0.0, width(scale), height(scale))
}
