// Interrupts and time, for code shared by the loader and the kernel.
//
// The architecture (os/arch/*/arch.min) sets up its interrupt controllers and
// a timer that interrupts arch.TIMER_HZ times a second. The boot code's
// handlers count every hardware interrupt; programs read the counts with
// machine.interruptCount and sleep between them with machine.waitForInterrupt.
// Wall-clock time comes from the processor's counter once it is calibrated.
use "machine" as machine
use "arch" as arch

public function start(): arch.Interrupts {
    return arch.startInterrupts()
}

// Calibrate the processor's counter and start the wall clock from the timer's
// count so far. Symbol 2 is three zero-initialized words: counter ticks per
// millisecond, the counter at calibration, and milliseconds at calibration.
public function calibrateClock(): Integer {
    let ticks = arch.measureClock()
    let clock = machine.symbol(2)
    machine.store64(clock + 16, machine.interruptCount(arch.TIMER) * 1000 / arch.TIMER_HZ)
    machine.store64(clock + 8, machine.timestamp())
    machine.store64(clock, ticks)
    return ticks
}

// Monotonic milliseconds; timer interrupts are counted only before calibration.
public function milliseconds(): Integer {
    let clock = machine.symbol(2)
    let frequency = machine.load64(clock)
    if frequency > 0 {
        return machine.load64(clock + 16) + (machine.timestamp() - machine.load64(clock + 8)) / frequency
    }
    return machine.interruptCount(arch.TIMER) * 1000 / arch.TIMER_HZ
}

public function seconds(): Float {
    return Float(milliseconds()) / 1000.0
}

// Sleep until the next interrupt of any kind.
public function idle() {
    machine.waitForInterrupt()
}

public function sleep(milliseconds: Integer) {
    // Round up: a 2 ms delay must still wait a tick at 250 Hz.
    let end = machine.interruptCount(arch.TIMER) + (milliseconds * arch.TIMER_HZ + 999) / 1000
    while machine.interruptCount(arch.TIMER) < end {
        machine.waitForInterrupt()
    }
}
