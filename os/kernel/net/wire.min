// Pure validation for the small freestanding network stack. Keeping wire
// parsing independent of devices and interrupts makes hostile inputs testable
// with the hosted runtime as well as safe for the kernel to consume.

public constant MAX_ARP_ENTRIES = 64
public constant MAX_CONNECTION_INCOMING = 1114112
public constant TERMINAL_CONNECTION_RETENTION = 30000
public constant MAX_DNS_QUERIES = 64
public constant DNS_QUERY_TIMEOUT = 5000
public constant DNS_RESULT_RETENTION = 30000

constant ETHERNET_IPV4 = 0x0800
constant ETHERNET_ARP = 0x0806

function get16(data: Bytes, offset: Integer): Integer {
    return (data[offset] << 8) | data[offset + 1]
}

function get32(data: Bytes, offset: Integer): Integer {
    return (get16(data, offset) << 16) | get16(data, offset + 2)
}

public record Udp {
    valid: Boolean
    sourcePort: Integer
    destinationPort: Integer
    payload: Bytes
}

public function udp(packet: Bytes): Udp {
    if packet.length < 8 {
        return Udp { valid: false; sourcePort: 0; destinationPort: 0; payload: Bytes() }
    }
    let length = get16(packet, 4)
    if length < 8 || length > packet.length {
        return Udp { valid: false; sourcePort: 0; destinationPort: 0; payload: Bytes() }
    }
    return Udp {
        valid: true
        sourcePort: get16(packet, 0)
        destinationPort: get16(packet, 2)
        payload: packet.slice(8, length)
    }
}

public record Dhcp {
    valid: Boolean
    offered: Integer
    kind: Integer
    mask: Integer
    router: Integer
    dns: Integer
    server: Integer
}

function invalidDhcp(): Dhcp {
    return Dhcp { valid: false; offered: 0; kind: 0; mask: 0; router: 0; dns: 0; server: 0 }
}

public function dhcp(message: Bytes, transaction: Integer, hardware: Bytes): Dhcp {
    if hardware.length != 6 || message.length < 241 || message[0] != 2 || message[1] != 1 || message[2] != 6 ||
       get32(message, 4) != transaction || get32(message, 236) != 0x63825363 {
        return invalidDhcp()
    }
    for index in 0..6 { if message[28 + index] != hardware[index] { return invalidDhcp() } }
    let result = Dhcp {
        valid: false; offered: get32(message, 16); kind: 0; mask: 0xFFFFFF00
        router: 0; dns: 0; server: 0
    }
    let kindSeen = false
    let serverSeen = false
    let at = 240
    while at < message.length {
        let option = message[at]
        if option == 255 {
            result.valid = kindSeen && serverSeen && (result.kind == 2 || result.kind == 5)
            return result
        }
        if option == 0 {
            at += 1
        } else {
            if at + 1 >= message.length { return invalidDhcp() }
            let length = message[at + 1]
            let value = at + 2
            if length > message.length - value { return invalidDhcp() }
            if option == 53 {
                if length != 1 || kindSeen { return invalidDhcp() }
                kindSeen = true
                result.kind = message[value]
            }
            if option == 1 { if length != 4 { return invalidDhcp() }; result.mask = get32(message, value) }
            if option == 3 { if length < 4 || length % 4 != 0 { return invalidDhcp() }; result.router = get32(message, value) }
            if option == 6 { if length < 4 || length % 4 != 0 { return invalidDhcp() }; result.dns = get32(message, value) }
            if option == 54 {
                if length != 4 || serverSeen { return invalidDhcp() }
                serverSeen = true
                result.server = get32(message, value)
            }
            at = value + length
        }
    }
    return invalidDhcp()
}

public function dhcpReplyAccepted(reply: Dhcp, state: Integer, source: Integer, sourcePort: Integer,
                                  destinationPort: Integer, selectedServer: Integer,
                                  selectedOffer: Integer, selectedSource: Integer): Boolean {
    if !reply.valid || sourcePort != 67 || destinationPort != 68 || source == 0 { return false }
    if state == 1 {
        return reply.kind == 2 && reply.offered != 0 && reply.server != 0
    }
    return state == 2 && reply.kind == 5 && selectedServer != 0 && selectedOffer != 0 &&
           selectedSource != 0 && (source == selectedSource || source == selectedServer) &&
           reply.server == selectedServer && reply.offered == selectedOffer
}

record DnsName {
    valid: Boolean
    end: Integer
    value: Bytes
}

record DnsRecord {
    owner: Bytes
    kind: Integer
    class: Integer
    value: Integer
    length: Integer
}

function lowerAscii(byte: Integer): Integer {
    if byte >= 65 && byte <= 90 { return byte + 32 }
    return byte
}

function canonicalDnsName(name: Text): Bytes {
    let raw = Bytes(name)
    let limit = raw.length
    if limit > 0 && raw[limit - 1] == 46 { limit -= 1 }
    if limit < 1 || limit > 253 { return Bytes() }
    let result = Bytes()
    let label = 0
    for index in 0..limit {
        let byte = raw[index]
        if byte == 46 {
            if label < 1 || label > 63 { return Bytes() }
            result.add(46)
            label = 0
        } else {
            if byte <= 32 || byte >= 127 { return Bytes() }
            result.add(lowerAscii(byte))
            label += 1
            if label > 63 { return Bytes() }
        }
    }
    if label < 1 || label > 63 { return Bytes() }
    return result
}

function invalidDnsName(): DnsName { return DnsName { valid: false; end: -1; value: Bytes() } }

function dnsName(message: Bytes, start: Integer): DnsName {
    if start < 0 || start >= message.length { return invalidDnsName() }
    let at = start
    let end = -1
    let hops = 0
    let result = Bytes()
    let labels = 0
    while true {
        if at >= message.length { return invalidDnsName() }
        let length = message[at]
        if length == 0 {
            if end < 0 { end = at + 1 }
            return DnsName { valid: labels > 0; end: end; value: result }
        }
        if (length & 0xC0) == 0xC0 {
            if at + 1 >= message.length { return invalidDnsName() }
            let pointer = ((length & 0x3F) << 8) | message[at + 1]
            if pointer >= at || pointer >= message.length || hops >= 32 { return invalidDnsName() }
            if end < 0 { end = at + 2 }
            at = pointer
            hops += 1
        } else {
            if (length & 0xC0) != 0 || length < 1 || length > 63 || length > message.length - at - 1 {
                return invalidDnsName()
            }
            if labels > 0 { result.add(46) }
            if result.length + length > 253 { return invalidDnsName() }
            for index in 0..length { result.add(lowerAscii(message[at + 1 + index])) }
            labels += 1
            at += length + 1
        }
    }
}

function equalBytes(left: Bytes, right: Bytes): Boolean {
    if left.length != right.length { return false }
    for index in 0..left.length { if left[index] != right[index] { return false } }
    return true
}

function containsName(names: List<Bytes>, wanted: Bytes): Boolean {
    for name in names { if equalBytes(name, wanted) { return true } }
    return false
}

public function dnsQuery(name: Text, id: Integer): Bytes {
    let canonical = canonicalDnsName(name)
    if canonical.length == 0 || id < 0 || id > 65535 { return Bytes() }
    let result = Bytes(12)
    result[0] = (id >> 8) & 255; result[1] = id & 255
    result[2] = 1
    result[5] = 1
    let start = 0
    for index in 0..canonical.length {
        if canonical[index] == 46 {
            result.add(index - start)
            result.addBytes(canonical.slice(start, index))
            start = index + 1
        }
    }
    result.add(canonical.length - start)
    result.addBytes(canonical.slice(start, canonical.length))
    result.add(0); result.add(0); result.add(1); result.add(0); result.add(1)
    return result
}

public function dnsTupleAccepted(source: Integer, sourcePort: Integer, destinationPort: Integer,
                                 resolver: Integer, queryPort: Integer): Boolean {
    return resolver != 0 && source == resolver && sourcePort == 53 && destinationPort == queryPort &&
           queryPort >= 1024 && queryPort <= 65535
}

public function dnsTimedOut(answer: Integer, sent: Integer, now: Integer): Boolean {
    return answer < 0 && sent >= 0 && now >= sent && now - sent >= DNS_QUERY_TIMEOUT
}

public function retainDnsQuery(answer: Integer, sent: Integer, completed: Integer, now: Integer): Boolean {
    if answer < 0 { return sent >= 0 && now >= sent && now - sent < DNS_QUERY_TIMEOUT }
    return completed >= 0 && now >= completed && now - completed < DNS_RESULT_RETENTION
}

public record Dns {
    valid: Boolean
    id: Integer
    address: Integer
}

function invalidDns(): Dns {
    return Dns { valid: false; id: 0; address: 0 }
}

public function dns(message: Bytes, expectedId: Integer, expectedName: Text): Dns {
    let canonical = canonicalDnsName(expectedName)
    if canonical.length == 0 || message.length < 12 || expectedId < 0 || expectedId > 65535 ||
       get16(message, 0) != expectedId || get16(message, 4) != 1 || get16(message, 6) > 64 ||
       (get16(message, 2) & 0xFA4F) != 0x8000 {
        return invalidDns()
    }
    let question = dnsName(message, 12)
    if !question.valid || !equalBytes(question.value, canonical) || question.end > message.length - 4 ||
       get16(message, question.end) != 1 || get16(message, question.end + 2) != 1 { return invalidDns() }
    let at = question.end + 4
    let records: List<DnsRecord> = []
    let answers = get16(message, 6)
    for answer in 0..answers {
        let owner = dnsName(message, at)
        if !owner.valid || owner.end > message.length - 10 { return invalidDns() }
        let kind = get16(message, owner.end)
        let class = get16(message, owner.end + 2)
        let length = get16(message, owner.end + 8)
        let value = owner.end + 10
        if length > message.length - value { return invalidDns() }
        records.add(DnsRecord { owner: owner.value; kind: kind; class: class; value: value; length: length })
        at = value + length
    }
    let names = [canonical]
    for pass in 0..16 {
        let changed = false
        for record in records {
            if record.kind == 5 && record.class == 1 && containsName(names, record.owner) {
                let target = dnsName(message, record.value)
                if !target.valid || target.end != record.value + record.length { return invalidDns() }
                if !containsName(names, target.value) {
                    if names.length >= 16 { return invalidDns() }
                    names.add(target.value); changed = true
                }
            }
        }
        if !changed { break }
    }
    for record in records {
        if record.kind == 1 && record.class == 1 && record.length == 4 && containsName(names, record.owner) {
            return Dns { valid: true; id: expectedId; address: get32(message, record.value) }
        }
    }
    return Dns { valid: true; id: expectedId; address: 0 }
}

public record Arp {
    valid: Boolean
    operation: Integer
    senderMac: Bytes
    senderIp: Integer
    targetIp: Integer
}

function invalidArp(): Arp {
    return Arp { valid: false; operation: 0; senderMac: Bytes(); senderIp: 0; targetIp: 0 }
}

public function arp(frame: Bytes, localIp: Integer, configured: Boolean): Arp {
    if !configured || frame.length < 42 || get16(frame, 12) != ETHERNET_ARP || get16(frame, 14) != 1 ||
       get16(frame, 16) != ETHERNET_IPV4 || frame[18] != 6 || frame[19] != 4 {
        return invalidArp()
    }
    let operation = get16(frame, 20)
    let senderIp = get32(frame, 28)
    let targetIp = get32(frame, 38)
    if (operation != 1 && operation != 2) || senderIp == 0 || targetIp != localIp {
        return invalidArp()
    }
    return Arp {
        valid: true; operation: operation; senderMac: frame.slice(22, 28)
        senderIp: senderIp; targetIp: targetIp
    }
}

public function rememberArp(addresses: List<Integer>, macs: List<Bytes>, address: Integer, mac: Bytes, maximum: Integer): Boolean {
    if maximum <= 0 || addresses.length != macs.length || mac.length != 6 { return false }
    for index in 0..addresses.length {
        if addresses[index] == address {
            macs[index] = mac
            return true
        }
    }
    if addresses.length < maximum {
        addresses.add(address)
        macs.add(mac)
        return true
    }
    for index in 1..addresses.length {
        addresses[index - 1] = addresses[index]
        macs[index - 1] = macs[index]
    }
    addresses[addresses.length - 1] = address
    macs[macs.length - 1] = mac
    return true
}

public function incomingFits(current: Integer, added: Integer): Boolean {
    return current >= 0 && added >= 0 && current <= MAX_CONNECTION_INCOMING && added <= MAX_CONNECTION_INCOMING - current
}

public function retainConnection(terminal: Boolean, opened: Integer, now: Integer): Boolean {
    return !terminal || now - opened < TERMINAL_CONNECTION_RETENTION
}

// Pure TCP acceptance checks shared by the hardware-bound receiver and hosted
// regressions. Sequence arithmetic is modulo 2^32; live sends are bounded well
// below half that space, so a wrapped distance outside the send range is stale.
public function tcpAcknowledgesSyn(sendUnacked: Integer, acknowledgment: Integer, hasAcknowledgment: Boolean): Boolean {
    return hasAcknowledgment && acknowledgment == ((sendUnacked + 1) & 0xFFFFFFFF)
}

public function tcpSequenceAccepted(receiveNext: Integer, sequence: Integer): Boolean {
    return sequence == receiveNext
}

public function tcpAcknowledgmentAccepted(receiveNext: Integer, sequence: Integer, sendUnacked: Integer,
                                          sent: Integer, finSent: Boolean, acknowledgment: Integer): Boolean {
    if !tcpSequenceAccepted(receiveNext, sequence) { return false }
    let advanced = (acknowledgment - sendUnacked) & 0xFFFFFFFF
    let finExtra = 0
    if finSent { finExtra = 1 }
    return advanced > 0 && advanced <= sent + finExtra
}
