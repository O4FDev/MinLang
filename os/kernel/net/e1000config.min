// Intel 8254x TIPG and TCTL fields, in least-significant-bit order.
// Pure configuration builders: host tests can exercise them without a device.
// Intel legacy DMA descriptors: exactly 16 bytes; status is byte 12.
// These types describe storage, not MMIO. device performs volatile DMA accesses.
public record ReceiveDescriptor native "c_packed" {
    address: UInt64
    length: UInt16
    checksum: UInt16
    status: UInt8
    errors: UInt8
    special: UInt16
}

public record TransmitDescriptor native "c_packed" {
    address: UInt64
    length: UInt16
    checksumOffset: UInt8
    command: UInt8
    status: UInt8
    checksumStart: UInt8
    special: UInt16
}

public record TransmitGap native "register32" {
    packet: Integer at(0, 10)
    first: Integer at(10, 10)
    second: Integer at(20, 10)
}

public record TransmitControl native "register32" {
    enabled: Integer at(1, 1)
    padShort: Integer at(3, 1)
    threshold: Integer at(4, 8)
    distance: Integer at(12, 10)
}

public function transmitGap(packet: Integer, first: Integer, second: Integer): Integer {
    return encodeField(TransmitGap, "packet", packet) |
        encodeField(TransmitGap, "first", first) |
        encodeField(TransmitGap, "second", second)
}

public function transmitControl(threshold: Integer, distance: Integer): Integer {
    // Transmit enable and pad short packets, then collision threshold/distance.
    return encodeField(TransmitControl, "enabled", 1) |
        encodeField(TransmitControl, "padShort", 1) |
        encodeField(TransmitControl, "threshold", threshold) |
        encodeField(TransmitControl, "distance", distance)
}
