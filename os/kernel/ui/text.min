// Text layout helpers on top of the font module: word wrapping, gradient
// ("shimmer") drawing, strikethrough and truncation.
use "../../shared/graphics/canvas.min" as canvas
use "../../shared/graphics/font.min" as font

// Split `text` into lines no wider than `width`, breaking at spaces and at
// explicit newlines. A word wider than the line is kept whole.
public function wrap(face: font.Face, text: Text, width: Float): List<Text> {
    let lines: List<Text> = []
    let space = font.measure(face, " ") + face.tracking
    // The current line runs from `lineStart` to `lineEnd` in `text`; it is
    // empty while `lineEnd` is negative.
    let lineStart = 0
    let lineEnd = -1
    let lineWidth = 0.0
    let wordStart = 0
    let length = text.length
    let index = 0
    while index <= length {
        let atEnd = index == length
        let character = ' '
        if !atEnd { character = text[index] }
        if atEnd || character == ' ' || character == '\n' {
            let pieceWidth = font.measureRange(face, text, wordStart, index)
            if lineEnd >= 0 && lineWidth + space + pieceWidth > width {
                lines.add(text.slice(lineStart, lineEnd))
                lineStart = wordStart
                lineEnd = -1
                lineWidth = 0.0
            }
            if lineEnd >= 0 { lineWidth += space }
            lineEnd = index
            lineWidth += pieceWidth
            if character == '\n' && !atEnd {
                lines.add(text.slice(lineStart, lineEnd))
                lineStart = index + 1
                lineEnd = -1
                lineWidth = 0.0
            }
            wordStart = index + 1
        }
        index += 1
    }
    if lineEnd >= 0 || lines.length == 0 {
        lines.add(text.slice(lineStart, max(lineEnd, lineStart)))
    }
    return lines
}

// Draw text whose color runs from `left` to `right` around x = `split`, over
// `softness` pixels: the in-progress shimmer of task status lines.
public function drawSplit(target: canvas.Canvas, face: font.Face, text: Text, x: Float, baseline: Float, left: Integer, right: Integer, split: Float, softness: Float, alpha: Integer): Float {
    return font.drawGradient(target, face, text, x, baseline, left, right, split, softness, alpha)
}

// Draw the first `count` characters of `text`.
public function drawPrefix(target: canvas.Canvas, face: font.Face, text: Text, count: Integer, x: Float, baseline: Float, color: Integer, alpha: Integer): Float {
    if count <= 0 { return x }
    if count >= text.length {
        return font.draw(target, face, text, x, baseline, color, alpha)
    }
    return font.draw(target, face, text.slice(0, count), x, baseline, color, alpha)
}

public function strike(target: canvas.Canvas, face: font.Face, text: Text, x: Float, baseline: Float, color: Integer, alpha: Integer) {
    let width = font.measure(face, text)
    let y = Integer(baseline - face.size * 0.3)
    canvas.blend(target, Integer(x), y, Integer(width + 0.5), 1, color, alpha)
}

// `text` cut with an ellipsis to fit `width`.
public function fit(face: font.Face, text: Text, width: Float): Text {
    if font.measure(face, text) <= width { return text }
    let count = text.length
    while count > 0 && font.measure(face, text.slice(0, count) + "…") > width {
        count -= 1
    }
    return text.slice(0, count) + "…"
}
