// The typefaces of the interface: Archivo at the sizes fitted to the reference
// recording (18.2, 15.9 and 13.6 pixels), all tracked at -0.02 em.
use "../../shared/graphics/font.min" as font

public record Type {
    regular: font.Font
    medium: font.Font
    semibold: font.Font
    body: font.Face
    bodyMedium: font.Face
    title: font.Face
    status: font.Face
    step: font.Face
    row: font.Face
    rowMedium: font.Face
    small: font.Face
    caption: font.Face
    label: font.Face
    wordmark: font.Face
    large: font.Face
    page: font.Face
    pageSmall: font.Face
    pageMedium: font.Face
    pageBold: font.Face
    pageHeading: font.Face
    pageLogo: font.Face
    sheet: font.Face
    sheetBold: font.Face
}

public function create(regular: font.Font, medium: font.Font, semibold: font.Font): Type {
    // Styles with the same font, size and tracking share one face, so each
    // glyph is rendered and cached once.
    let body = font.face(regular, 18.2, -0.364)
    let step = font.face(regular, 15.9, -0.318)
    return Type {
        regular: regular
        medium: medium
        semibold: semibold
        body: body
        bodyMedium: font.face(medium, 18.2, -0.364)
        title: body
        status: body
        step: step
        row: step
        rowMedium: font.face(medium, 16.1, -0.322)
        small: font.face(regular, 13.6, -0.272)
        caption: font.face(regular, 12.0, 0.0)
        label: font.face(regular, 15.8, -0.1)
        wordmark: font.face(semibold, 30.0, -1.0)
        large: font.face(regular, 28.0, -0.8)
        page: font.face(regular, 9.5, 0.0)
        pageSmall: font.face(regular, 7.5, 0.0)
        pageMedium: font.face(medium, 9.5, 0.0)
        pageBold: font.face(semibold, 10.5, 0.0)
        pageHeading: font.face(semibold, 19.0, -0.3)
        pageLogo: font.face(semibold, 25.0, -1.0)
        sheet: font.face(regular, 7.0, 0.0)
        sheetBold: font.face(semibold, 7.0, 0.0)
    }
}

// The faces whose glyph caches are filled ahead of time, most used first.
public function warmable(type: Type): List<font.Face> {
    return [type.body, type.step, type.small, type.rowMedium, type.label, type.caption, type.bodyMedium, type.large, type.page, type.pageMedium, type.pageBold, type.pageSmall, type.pageHeading, type.sheet, type.sheetBold, type.pageLogo]
}
