// Line icons drawn as vector paths, rasterized once into coverage masks and
// then blended in any color.
use "../../shared/graphics/canvas.min" as canvas
use "../../shared/graphics/raster.min" as raster

public constant CHAT = 0
public constant TASKS = 1
public constant LIBRARY = 2
public constant NOTES = 3
public constant SEARCH = 4
public constant CHEVRON_RIGHT = 5
public constant CHEVRON_UP = 6
public constant CHEVRON_DOWN = 7
public constant LAPTOP = 8
public constant MONITOR = 9
public constant EXPAND = 10
public constant PAUSE = 11
public constant TABLE = 12
public constant LINK = 13
public constant PLUS = 14
public constant MICROPHONE = 15
public constant SEND = 16
public constant PHONE = 17
public constant HANG_UP = 18
public constant COPY = 19
public constant HELP = 20
public constant POINTER = 21
public constant POINTER_OUTLINE = 22
public constant TEXT_CURSOR = 23
public constant TEXT_CURSOR_OUTLINE = 24
public constant CHECK = 25
public constant HAND = 26
public constant HAND_OUTLINE = 27
public constant PLAY = 28
public constant CLOSE = 29
constant COUNT = 30

// Masks are rendered with a margin so strokes on the box edge are not cut.
constant MARGIN = 2

public record Icons {
    masks: List<Bytes>
    widths: List<Integer>
    heights: List<Integer>
}

function points(values: List<Float>): List<Float> {
    return values
}

function line(path: raster.Path, x0: Float, y0: Float, x1: Float, y1: Float, width: Float) {
    raster.stroke(path, [x0, y0, x1, y1], width, false)
}

function box(path: raster.Path, x: Float, y: Float, w: Float, h: Float, width: Float) {
    raster.stroke(path, [x, y, x + w, y, x + w, y + h, x, y + h], width, true)
}

function arc(path: raster.Path, centerX: Float, centerY: Float, radius: Float, from: Float, to: Float, width: Float) {
    let values: List<Float> = []
    let steps = 24
    for step in 0..(steps + 1) {
        let angle = from + (to - from) * Float(step) / Float(steps)
        values.add(centerX + radius * cos(angle))
        values.add(centerY + radius * sin(angle))
    }
    raster.stroke(path, values, width, false)
}

// Build the outline of one icon in its own box, in logical pixels.
function shape(id: Integer): raster.Path {
    let path = raster.newPath()
    let w = 1.25
    if id == CHAT {
        raster.stroke(path, [1.5, 1.5, 18.5, 1.5, 18.5, 13.5, 8.0, 13.5, 4.5, 16.8, 4.5, 13.5, 1.5, 13.5], 1.5, true)
        line(path, 5.5, 5.6, 14.5, 5.6, 1.5)
        line(path, 5.5, 9.2, 11.5, 9.2, 1.5)
    }
    // Traced from the reference at six times magnification.
    if id == TASKS {
        box(path, 0.7, 0.7, 7.6, 7.2, w)
        raster.stroke(path, [12.7, 4.0, 20.0, 4.0, 20.0, 19.4, 4.0, 19.4, 4.0, 12.0, 12.7, 12.0], w, true)
        line(path, 12.7, 12.0, 20.0, 12.0, w)
        line(path, 12.7, 12.0, 12.7, 19.4, w)
    }
    if id == LIBRARY {
        box(path, 6.8, 0.7, 11.4, 15.1, w)
        raster.stroke(path, [6.8, 0.7, 2.8, 2.3, 2.8, 17.6, 3.7, 19.2, 18.2, 19.2, 18.2, 17.4], w, false)
    }
    if id == NOTES {
        raster.stroke(path, [2.4, 2.2, 12.7, 2.2, 12.7, 19.6, 9.5, 19.0, 6.0, 19.6, 2.4, 20.4], w, true)
        raster.stroke(path, [2.4, 2.2, 6.8, 0.0, 17.2, 0.0, 12.7, 2.2], w, false)
        raster.stroke(path, [17.2, 0.0, 17.2, 18.3, 12.7, 19.6], w, false)
    }
    if id == SEARCH {
        arc(path, 9.0, 9.0, 7.5, 0.0, 6.2832, w)
        line(path, 14.6, 14.6, 17.2, 17.2, w)
    }
    if id == CHEVRON_RIGHT {
        raster.stroke(path, [1.0, 1.0, 7.0, 7.0, 1.0, 13.0], 1.4, false)
    }
    if id == CHEVRON_UP {
        raster.stroke(path, [1.0, 6.0, 6.0, 1.0, 11.0, 6.0], 1.1, false)
    }
    if id == CHEVRON_DOWN {
        raster.stroke(path, [1.0, 1.0, 6.0, 6.0, 11.0, 1.0], 1.1, false)
    }
    if id == LAPTOP {
        box(path, 2.5, 1.0, 12.0, 9.5, 1.2)
        line(path, 0.5, 13.0, 16.5, 13.0, 1.4)
    }
    if id == MONITOR {
        box(path, 0.8, 0.8, 15.4, 10.6, 1.25)
        line(path, 8.5, 11.4, 8.5, 14.0, 1.25)
        line(path, 5.0, 14.4, 12.0, 14.4, 1.25)
    }
    if id == EXPAND {
        raster.stroke(path, [6.5, 1.0, 11.0, 1.0, 11.0, 5.5], 1.4, false)
        raster.stroke(path, [1.0, 6.5, 1.0, 11.0, 5.5, 11.0], 1.4, false)
    }
    if id == PAUSE {
        box(path, 0.6, 0.6, 4.6, 13.0, 1.2)
        box(path, 8.6, 0.6, 4.6, 13.0, 1.2)
    }
    if id == TABLE {
        box(path, 0.7, 0.7, 18.0, 15.6, 1.4)
        line(path, 0.7, 5.0, 18.7, 5.0, 1.4)
        line(path, 0.7, 8.7, 18.7, 8.7, 1.2)
        line(path, 0.7, 12.4, 18.7, 12.4, 1.2)
        line(path, 6.5, 5.0, 6.5, 16.3, 1.2)
    }
    if id == LINK {
        line(path, 1.0, 11.0, 10.5, 1.5, 1.3)
        raster.stroke(path, [3.5, 1.5, 10.5, 1.5, 10.5, 8.5], 1.3, false)
    }
    if id == PLUS {
        line(path, 0.5, 6.5, 12.5, 6.5, 1.2)
        line(path, 6.5, 0.5, 6.5, 12.5, 1.2)
    }
    if id == MICROPHONE {
        raster.stroke(path, raster.roundedRectanglePoints(4.0, 1.0, 5.0, 10.0, 2.5), 1.15, true)
        arc(path, 6.5, 8.0, 5.5, 0.0, 3.1416, 1.15)
        line(path, 6.5, 13.5, 6.5, 16.5, 1.15)
        line(path, 3.5, 16.6, 9.5, 16.6, 1.15)
    }
    if id == SEND {
        line(path, 8.0, 1.5, 8.0, 17.0, 1.3)
        raster.stroke(path, [1.5, 8.0, 8.0, 1.5, 14.5, 8.0], 1.3, false)
    }
    if id == PHONE {
        raster.stroke(path, [3.4, 1.0, 6.2, 1.0, 7.8, 5.0, 6.2, 6.6, 9.4, 9.8, 11.0, 8.2, 15.0, 9.8, 15.0, 12.6, 13.2, 14.4, 9.0, 13.4, 5.2, 11.0, 2.6, 7.4, 1.4, 3.2], 1.25, true)
    }
    if id == HANG_UP {
        raster.stroke(path, [3.0, 9.6, 5.4, 6.6, 9.0, 5.2, 13.0, 5.2, 16.6, 6.6, 19.0, 9.6], 2.0, false)
        raster.roundedRectangle(path, 1.4, 8.6, 5.0, 3.2, 1.2)
        raster.roundedRectangle(path, 15.6, 8.6, 5.0, 3.2, 1.2)
    }
    if id == COPY {
        box(path, 4.6, 0.8, 10.6, 11.6, 1.25)
        raster.stroke(path, [3.0, 4.6, 0.8, 4.6, 0.8, 15.2, 11.4, 15.2, 11.4, 13.4], 1.25, false)
    }
    if id == HELP {
        raster.stroke(path, raster.roundedRectanglePoints(0.7, 0.7, 17.6, 17.6, 4.0), 1.35, true)
        // The question mark: an arc, a stem and a dot.
        arc(path, 9.5, 7.2, 2.9, 3.4, 6.9, 1.4)
        raster.stroke(path, [11.2, 9.4, 9.5, 10.8, 9.5, 12.0], 1.4, false)
        raster.ellipse(path, 9.5, 14.6, 1.0, 1.0)
    }
    if id == POINTER || id == POINTER_OUTLINE {
        let outline = [0.0, 0.0, 0.0, 16.8, 4.2, 12.8, 6.9, 19.2, 9.4, 18.2, 6.8, 12.0, 12.4, 12.0]
        if id == POINTER {
            raster.moveTo(path, outline[0], outline[1])
            let index = 2
            while index < outline.length {
                raster.lineTo(path, outline[index], outline[index + 1])
                index += 2
            }
            raster.close(path)
        } else {
            raster.stroke(path, outline, 2.6, true)
        }
    }
    if id == TEXT_CURSOR || id == TEXT_CURSOR_OUTLINE {
        let width = 1.4
        if id == TEXT_CURSOR_OUTLINE { width = 3.6 }
        line(path, 4.0, 0.8, 4.0, 18.2, width)
        raster.stroke(path, [1.0, 0.8, 2.6, 0.8, 4.0, 2.0, 5.4, 0.8, 7.0, 0.8], width, false)
        raster.stroke(path, [1.0, 18.2, 2.6, 18.2, 4.0, 17.0, 5.4, 18.2, 7.0, 18.2], width, false)
    }
    if id == CHECK {
        raster.stroke(path, [1.0, 6.0, 4.5, 9.5, 11.0, 1.5], 1.6, false)
    }
    if id == HAND || id == HAND_OUTLINE {
        let outline = [5.0, 9.0, 5.0, 2.0, 6.0, 1.0, 7.0, 2.0, 7.0, 7.5, 7.5, 6.6, 9.0, 6.6, 9.5, 7.6, 10.0, 7.0, 11.5, 7.0, 12.0, 8.0, 12.5, 7.6, 14.0, 7.8, 14.5, 9.0, 14.5, 13.5, 12.8, 17.5, 6.8, 17.5, 2.0, 12.0, 2.0, 10.6, 3.2, 10.0]
        if id == HAND {
            raster.moveTo(path, outline[0], outline[1])
            let index = 2
            while index < outline.length {
                raster.lineTo(path, outline[index], outline[index + 1])
                index += 2
            }
            raster.close(path)
        } else {
            raster.stroke(path, outline, 2.6, true)
        }
    }
    if id == CLOSE {
        line(path, 1.0, 1.0, 11.0, 11.0, 1.4)
        line(path, 11.0, 1.0, 1.0, 11.0, 1.4)
    }
    if id == PLAY {
        raster.moveTo(path, 1.0, 0.5)
        raster.lineTo(path, 11.0, 7.0)
        raster.lineTo(path, 1.0, 13.5)
        raster.close(path)
    }
    return path
}

function render(id: Integer): Bytes {
    let path = shape(id)
    return raster.rasterize(path, -Float(MARGIN), -Float(MARGIN), 26 + MARGIN * 2, 26 + MARGIN * 2)
}

public function create(): Icons {
    let icons = Icons { masks: []; widths: []; heights: [] }
    for id in 0..COUNT {
        icons.masks.add(render(id))
        icons.widths.add(26 + MARGIN * 2)
        icons.heights.add(26 + MARGIN * 2)
    }
    return icons
}

// Draw icon `id` with its box's top-left corner at (x, y).
public function draw(target: canvas.Canvas, icons: Icons, id: Integer, x: Integer, y: Integer, color: Integer, alpha: Integer) {
    canvas.mask(target, x - MARGIN, y - MARGIN, icons.widths[id], icons.heights[id], icons.masks[id], color, alpha)
}
