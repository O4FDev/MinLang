// The state of the desktop, shared by every part of the interface.
use "../../shared/graphics/canvas.min" as canvas
use "../input/devices.min" as devices
use "./type.min" as type
use "./icons.min" as icons
use "../system/processors.min" as processors

// Block kinds in the conversation.
public constant USER = 1
public constant REPLY = 2
public constant STEPS = 3
public constant TASK = 4
public constant SHEET = 5
public constant CALL = 6
public constant RESULTS = 7
public constant NOTE = 8
public constant SUMMARY = 9
public constant SOURCES = 10

// Sidebar destinations.
public constant VIEW_CHAT = 0
public constant VIEW_TASKS = 1
public constant VIEW_LIBRARY = 2
public constant VIEW_NOTES = 3
public constant VIEW_SEARCH = 4

// Pointer shapes.
public constant POINTER_ARROW = 0
public constant POINTER_TEXT = 1
public constant POINTER_HAND = 2

// Browser pages the task window can show.
public constant PAGE_BLANK = 0
public constant PAGE_ARTICLE = 1
public constant PAGE_PURE = 2
public constant PAGE_JAYS = 3
public constant PAGE_SHANNON = 4
public constant PAGE_NORTHSTAR = 5
public constant PAGE_SHEET = 6
public constant PAGE_ATACAMA = 7
public constant PAGE_BIGMAN = 8
public constant PAGE_ARTICLE_LIVE = 9
public constant PAGE_SEARCH = 10

public record Tween {
    from: Float
    to: Float
    start: Float
    duration: Float
}

public record Damage {
    lefts: List<Integer>
    tops: List<Integer>
    rights: List<Integer>
    bottoms: List<Integer>
}

public record Block {
    kind: Integer
    text: Text
    detail: Text
    // Steps, table rows, sources: a label per item, a value per item, and
    // flags (1 = emphasised value, 2 = in progress).
    items: List<Text>
    values: List<Text>
    flags: List<Integer>
    // Wrapped lines of `text`, for the width they were wrapped at.
    lines: List<Text>
    wrapped: Integer
    // Layout in conversation coordinates.
    top: Integer
    height: Integer
    // When the block appeared and, for streamed text, how fast it reveals.
    born: Float
    rate: Float
    done: Boolean
    expanded: Boolean
    // A task's progress text start time, for the shimmer.
    since: Float
    progress: Float
    index: Integer
    count: Integer
    // Where the block is drawn while it glides to `top` after a layout change.
    shownTop: Float
    // A control in the block is being hovered (its number) or none (-1).
    hover: Integer
    // The block's static parts, rendered once and blitted; rebuilt when
    // `version` changes. Animated parts are drawn live over it.
    version: Integer
    cache: canvas.Canvas
    cachedKey: Integer
}

public record Composer {
    text: Text
    caret: Integer
    scroll: Float
    edited: Float
    focused: Boolean
}

public record Panel {
    visible: Boolean
    shown: Tween
    title: Text
    status: Text
    since: Float
    done: Boolean
    paused: Boolean
    page: Integer
    pageSince: Float
    pageScroll: Float
    maximized: Tween
    cache: canvas.Canvas
    cachedPage: Integer
    cachedVersion: Integer
    version: Integer
    // Pages rendered at the docked size, by page number: static pages once,
    // the spreadsheet's grid once (rows are drawn over a copy of it).
    pageCaches: List<canvas.Canvas>
    // The same at the maximized size.
    bigCaches: List<canvas.Canvas>
    // The page at the maximized size, painted a strip at a time: how many
    // rows are done, for which page and version; what a strip has cost
    // lately, in timestamp ticks; and frames since a strip last fitted.
    bigCache: canvas.Canvas
    bigPage: Integer
    bigVersion: Integer
    bigRows: Integer
    stripTicks: Integer
    stripWait: Integer
    // Spreadsheet contents shown on PAGE_SHEET: one row per mover.
    sheetNames: List<Text>
    sheetPhones: List<Text>
    sheetOutcomes: List<Text>
    sheetQuotes: List<Text>
    sheetDetails: List<Text>
    sheetRows: Integer
    // The Atacama page: request and response text.
    request: Text
    response: Text
    // A real page the agent fetched: where from, and what it says.
    articleHost: Text
    articleTitle: Text
    articleDescription: Text
    articleText: Text
    searchResults: List<Text>
}

public record Toast {
    text: Text
    born: Float
    x: Integer
    y: Integer
}

public record App {
    back: canvas.Canvas
    screen: canvas.Canvas
    type: type.Type
    icons: icons.Icons
    input: devices.Input
    damage: Damage
    now: Float
    // The time of the previous frame: an animation that was still running
    // then needs one more frame to draw its final state.
    previous: Float
    frames: Integer
    view: Integer
    hoverView: Integer
    hover: Integer
    pressed: Integer
    // The conversation column's left edge, docked or centered.
    column: Tween
    blocks: List<Block>
    scroll: Float
    scrollTarget: Float
    contentHeight: Integer
    composer: Composer
    panel: Panel
    glow: Tween
    // The glow is redrawn in 24 steps of strength, not every frame.
    glowStep: Integer
    toast: Toast
    menu: Integer
    menuShown: Tween
    pointerX: Integer
    pointerY: Integer
    pointerShape: Integer
    drawnPointerX: Integer
    drawnPointerY: Integer
    drawnPointerShape: Integer
    device: canvas.Canvas
    wordmark: Bytes
    clipboard: Text
    // Lines for the library view and the system window.
    library: List<Text>
    system: List<Text>
    // Time-stamp counter ticks spent in each part of drawing, for profiling.
    timings: List<Integer>
    // The other processors, and the argument block for the parallel glow.
    processors: processors.Processors
    glowArguments: Bytes
    // Time-stamp counter ticks per millisecond, for budgeting work.
    ticksPerMillisecond: Integer
    // The account badge's disc, rendered once.
    avatar: Bytes
    // Glyph-cache warming: which face, and where in it.
    warmFace: Integer
    warmCursor: Integer
    // Which parts of the conversation to draw: 0 everything, 1 the static
    // parts (into a block's cache), 2 the animated parts.
    layer: Integer
}

public function tween(value: Float): Tween {
    return Tween { from: value; to: value; start: 0.0; duration: 0.0 }
}

public function ease(t: Float): Float {
    let c = clamp(t, 0.0, 1.0)
    // Ease-out cubic.
    return 1.0 - (1.0 - c) * (1.0 - c) * (1.0 - c)
}

public function easeInOut(t: Float): Float {
    let c = clamp(t, 0.0, 1.0)
    if c < 0.5 { return 4.0 * c * c * c }
    let f = -2.0 * c + 2.0
    return 1.0 - f * f * f / 2.0
}

public function value(tween: Tween, now: Float): Float {
    if tween.duration <= 0.0 { return tween.to }
    let t = easeInOut((now - tween.start) / tween.duration)
    return tween.from + (tween.to - tween.from) * t
}

public function animating(tween: Tween, now: Float): Boolean {
    return tween.duration > 0.0 && now < tween.start + tween.duration
}

public function retarget(tween: Tween, target: Float, now: Float, duration: Float) {
    if tween.to == target { return }
    tween.from = value(tween, now)
    tween.to = target
    tween.start = now
    tween.duration = duration
}

// ----- Damage -----

public function newDamage(): Damage {
    return Damage { lefts: []; tops: []; rights: []; bottoms: [] }
}

// Mark a screen rectangle for redrawing, merging it with any it touches.
public function invalidate(app: App, x: Integer, y: Integer, width: Integer, height: Integer) {
    let left = max(x, 0)
    let top = max(y, 0)
    let right = min(x + width, app.back.width)
    let bottom = min(y + height, app.back.height)
    if right <= left || bottom <= top { return }
    let damage = app.damage
    let merging = true
    while merging {
        merging = false
        let index = 0
        while index < damage.lefts.length {
            if left <= damage.rights[index] + 8 && damage.lefts[index] <= right + 8 && top <= damage.bottoms[index] + 8 && damage.tops[index] <= bottom + 8 {
                left = min(left, damage.lefts[index])
                top = min(top, damage.tops[index])
                right = max(right, damage.rights[index])
                bottom = max(bottom, damage.bottoms[index])
                removeDamage(damage, index)
                merging = true
            } else {
                index += 1
            }
        }
    }
    damage.lefts.add(left)
    damage.tops.add(top)
    damage.rights.add(right)
    damage.bottoms.add(bottom)
}

function removeDamage(damage: Damage, index: Integer) {
    let lefts: List<Integer> = []
    let tops: List<Integer> = []
    let rights: List<Integer> = []
    let bottoms: List<Integer> = []
    for other in 0..damage.lefts.length {
        if other != index {
            lefts.add(damage.lefts[other])
            tops.add(damage.tops[other])
            rights.add(damage.rights[other])
            bottoms.add(damage.bottoms[other])
        }
    }
    damage.lefts = lefts
    damage.tops = tops
    damage.rights = rights
    damage.bottoms = bottoms
}

public function invalidateAll(app: App) {
    invalidate(app, 0, 0, app.back.width, app.back.height)
}

// Whether a rectangle intersects the area currently being redrawn.
public function visible(app: App, x: Integer, y: Integer, width: Integer, height: Integer): Boolean {
    let c = app.back
    return x < c.clipRight && x + width > c.clipLeft && y < c.clipBottom && y + height > c.clipTop
}

public function inside(x: Integer, y: Integer, left: Integer, top: Integer, width: Integer, height: Integer): Boolean {
    return x >= left && x < left + width && y >= top && y < top + height
}

// The block's contents changed; its cached rendering is out of date.
public function touch(block: Block) {
    block.version += 1
}

public function drawStatic(app: App): Boolean {
    return app.layer != 2
}

public function drawLive(app: App): Boolean {
    return app.layer != 1
}

public function newBlock(kind: Integer, text: Text, now: Float): Block {
    return Block {
        kind: kind; text: text; detail: ""; items: []; values: []; flags: []; lines: []; wrapped: -1
        top: 0; height: 0; born: now; rate: 0.0; done: false; expanded: true; since: now; progress: 0.0
        index: 0; count: 0; shownTop: -1.0; hover: -1
        version: 0; cache: canvas.create(1, 1); cachedKey: -1
    }
}
