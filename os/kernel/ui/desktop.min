// The parts of the screen around the conversation: the sidebar, the help
// button, the account badge, the device in the corner, the working glow and
// the mouse pointer.
use "machine" as machine
use "../../shared/graphics/canvas.min" as canvas
use "../../shared/graphics/font.min" as font
use "../../shared/graphics/raster.min" as raster
use "./state.min" as state
use "./theme.min" as theme
use "./icons.min" as icons
use "../system/processors.min" as processors

public constant NAV_TOP = 123
public constant NAV_SPACING = 59
public constant NAV_HEIGHT = 32
public constant HELP_X = 1679
public constant HELP_Y = 15
public constant AVATAR_X = 34
public constant AVATAR_Y = 1046
public constant DEVICE_X = 1630
public constant DEVICE_Y = 906
public constant DEVICE_WIDTH = 80
public constant DEVICE_HEIGHT = 154

constant GLOW = 0x4691F7
// Beyond 176 pixels the glow's opacity rounds to zero.
constant GLOW_REACH = 176

public function navLabel(view: Integer): Text {
    if view == state.VIEW_TASKS { return "TASKS" }
    if view == state.VIEW_LIBRARY { return "LIBRARY" }
    if view == state.VIEW_NOTES { return "NOTES" }
    if view == state.VIEW_SEARCH { return "SEARCH" }
    return "CHAT"
}

function navIcon(view: Integer): Integer {
    if view == state.VIEW_TASKS { return icons.TASKS }
    if view == state.VIEW_LIBRARY { return icons.LIBRARY }
    if view == state.VIEW_NOTES { return icons.NOTES }
    if view == state.VIEW_SEARCH { return icons.SEARCH }
    return icons.CHAT
}

public function navWidth(app: state.App, view: Integer): Integer {
    return 37 + Integer(font.measure(app.type.label, navLabel(view))) + 6
}

// The navigation item under a point, or -1.
public function navAt(app: state.App, x: Integer, y: Integer): Integer {
    for view in 0..5 {
        let top = NAV_TOP + view * NAV_SPACING
        let width = 34
        if view == app.view { width = navWidth(app, view) }
        if state.inside(x, y, 18, top, width, NAV_HEIGHT) {
            return view
        }
    }
    return -1
}

public function invalidateSidebar(app: state.App) {
    state.invalidate(app, 0, NAV_TOP - 4, 220, NAV_SPACING * 5 + 8)
}

public function drawSidebar(app: state.App) {
    let back = app.back
    if state.visible(app, 0, 60, 120, 40) {
        canvas.mask(back, 14, 64, 84, 34, app.wordmark, theme.WORDMARK, 255)
    }
    for view in 0..5 {
        let top = NAV_TOP + view * NAV_SPACING
        if state.visible(app, 0, top, 240, NAV_HEIGHT) {
            let iconColor = theme.ICON
            if view == app.view {
                canvas.fill(back, 0, top, 9, NAV_HEIGHT, theme.ACCENT_BAR)
                canvas.fill(back, 18, top, navWidth(app, view), NAV_HEIGHT, theme.SIDEBAR_PILL)
                font.draw(back, app.type.label, navLabel(view), 55.0, Float(top) + 21.5, 0x333333, 255)
                iconColor = 0x222222
            } else {
                if view == app.hoverView {
                    canvas.fill(back, 18, top, 34, NAV_HEIGHT, 0xE6E6E6)
                    iconColor = 0x444444
                }
            }
            icons.draw(back, app.icons, navIcon(view), 24, top + 6, iconColor, 255)
        }
    }
    if state.visible(app, AVATAR_X - 14, AVATAR_Y - 14, 28, 28) {
        canvas.mask(back, AVATAR_X - 14, AVATAR_Y - 14, 28, 28, app.avatar, theme.AVATAR, 255)
        let width = font.measure(app.type.caption, "E")
        font.draw(back, app.type.caption, "E", Float(AVATAR_X) - width / 2.0, Float(AVATAR_Y) + 4.5, 0xEEEEEE, 255)
    }
    if state.visible(app, HELP_X, HELP_Y, 20, 20) {
        icons.draw(back, app.icons, icons.HELP, HELP_X, HELP_Y, 0x2A2A2A, 255)
    }
    if state.visible(app, DEVICE_X, DEVICE_Y, DEVICE_WIDTH, DEVICE_HEIGHT) {
        canvas.blit(back, app.device, 0, 0, DEVICE_WIDTH, DEVICE_HEIGHT, DEVICE_X, DEVICE_Y)
    }
}

public function renderAvatar(): Bytes {
    let path = raster.newPath()
    raster.ellipse(path, 14.0, 14.0, 11.5, 11.5)
    return raster.rasterize(path, 0.0, 0.0, 28, 28)
}

// ----- The device in the corner -----

function polygonMask(xs: List<Float>, ys: List<Float>, width: Integer, height: Integer): Bytes {
    let path = raster.newPath()
    raster.moveTo(path, xs[0], ys[0])
    for index in 1..xs.length {
        raster.lineTo(path, xs[index], ys[index])
    }
    raster.close(path)
    return raster.rasterize(path, 0.0, 0.0, width, height)
}

// A brushed-metal slab with a white side, rendered once at start-up over the
// desktop background.
public function renderDevice(): canvas.Canvas {
    let sprite = canvas.create(DEVICE_WIDTH, DEVICE_HEIGHT)
    canvas.fill(sprite, 0, 0, DEVICE_WIDTH, DEVICE_HEIGHT, theme.BACKGROUND)
    // Coordinates relative to (DEVICE_X, DEVICE_Y); the slab spans x 13..68.
    let front = polygonMask([13.0, 50.5, 50.5, 13.0], [19.0, 11.0, 141.0, 133.0], DEVICE_WIDTH, DEVICE_HEIGHT)
    let side = polygonMask([50.5, 64.0, 68.0, 68.0, 50.5], [11.0, 9.0, 13.0, 137.0, 141.0], DEVICE_WIDTH, DEVICE_HEIGHT)
    let shadow = polygonMask([15.0, 52.0, 72.0, 72.0, 52.0, 15.0], [24.0, 14.0, 16.0, 142.0, 148.0, 140.0], DEVICE_WIDTH, DEVICE_HEIGHT)
    // A soft contact shadow first.
    for row in 0..DEVICE_HEIGHT {
        for column in 0..DEVICE_WIDTH {
            let a = shadow[row * DEVICE_WIDTH + column]
            if a > 0 {
                let address = sprite.address + (row * DEVICE_WIDTH + column) * 4
                let value = 242 - a * 26 / 255
                machine.store32(address, canvas.rgb(value, value, value))
            }
        }
    }
    for row in 0..DEVICE_HEIGHT {
        let v = Float(row - 10) / 132.0
        for column in 0..DEVICE_WIDTH {
            let index = row * DEVICE_WIDTH + column
            let address = sprite.address + index * 4
            let a = front[index]
            if a > 0 {
                let u = Float(column - 13) / 37.0
                // Brushed steel: bright at the top, darkening downwards, with a
                // soft reflected band and lighter towards the side edge.
                let base = 178.0 - 120.0 * clamp(v * 1.35, 0.0, 1.0) + 18.0 * u
                let band = 70.0 * exp(-((v - 0.22 - u * 0.05) * (v - 0.22 - u * 0.05)) / 0.004)
                let streak = 22.0 * exp(-((v - 0.62) * (v - 0.62)) / 0.0015)
                let tone = clamp(base + band + streak, 30.0, 236.0)
                let value = Integer(tone)
                let blue = min(value + 6, 255)
                blendPixel(address, canvas.rgb(value, value + 2, blue), a)
            }
            let s = side[index]
            if s > 0 {
                let edge = 255 - Integer(clamp(Float(column - 64) * 9.0, 0.0, 40.0))
                blendPixel(address, canvas.rgb(edge, edge, edge), s)
            }
        }
    }
    return sprite
}

function blendPixel(address: Integer, color: Integer, alpha: Integer) {
    let pixel = machine.load32(address)
    let keep = 255 - alpha
    let r = (((pixel >> 16) & 255) * keep + ((color >> 16) & 255) * alpha + 128) * 257 >> 16
    let g = (((pixel >> 8) & 255) * keep + ((color >> 8) & 255) * alpha + 128) * 257 >> 16
    let b = ((pixel & 255) * keep + (color & 255) * alpha + 128) * 257 >> 16
    machine.store32(address, (r << 16) | (g << 8) | b)
}

// ----- The working glow -----

// Opacity (0-255) of the glow at a distance from an edge, from the recording:
// about 0.42 at the edge, falling off like a Gaussian over ~75 pixels. The
// table holds the left band (distance = column) followed by the right band
// (distance counted from the right edge), one byte per column.
public function glowTable(): Bytes {
    let table = Bytes(GLOW_REACH * 2)
    for distance in 0..GLOW_REACH {
        let d = Float(distance) / 75.0
        let opacity = Integer(0.42 * 255.0 * exp(-d * d))
        table[distance] = opacity
        table[GLOW_REACH * 2 - 1 - distance] = opacity
    }
    return table
}

constant GLOW_BAND = 16

// One band of GLOW_BAND rows of the glow. `arguments` holds, as 64-bit
// Integers: pixels, stride, width, height, the clip's left, top, right and
// bottom, the strength (0-256) and the opacity table.
parallel function glowRows(item: Integer, arguments: Integer) {
    let pixels = machine.load64(arguments)
    let stride = machine.load64(arguments + 8)
    let width = machine.load64(arguments + 16)
    let height = machine.load64(arguments + 24)
    let first = machine.load64(arguments + 32)
    let last = machine.load64(arguments + 48)
    let top = machine.load64(arguments + 40) + item * GLOW_BAND
    let bottom = min(top + GLOW_BAND, machine.load64(arguments + 56))
    let level = machine.load64(arguments + 64)
    let table = machine.load64(arguments + 72)
    let leftEnd = min(last, GLOW_REACH)
    let rightStart = max(first, width - GLOW_REACH)
    for row in top..bottom {
        let dy = min(row, height - 1 - row)
        let ay = 0
        if dy < GLOW_REACH { ay = machine.load8(table + dy) }
        let address = pixels + row * stride
        // The left band: opacity from the table plus the row's own.
        if first < leftEnd {
            machine.blendMask(address + first * 4, leftEnd - first, table + first, GLOW, level, ay, 236)
        }
        // Between the bands only the top and bottom rows glow, evenly.
        let middleStart = max(first, GLOW_REACH)
        let middleEnd = min(last, width - GLOW_REACH)
        if ay > 0 && middleEnd > middleStart {
            let opacity = min(ay, 236) * level >> 8
            machine.blendSpan(address + middleStart * 4, middleEnd - middleStart, GLOW, opacity + (opacity >> 7))
        }
        if rightStart < last {
            let offset = rightStart - (width - GLOW_REACH)
            machine.blendMask(address + rightStart * 4, last - rightStart, table + GLOW_REACH + offset, GLOW, level, ay, 236)
        }
    }
}

// Blend the glow over the area being redrawn, at `strength` from 0 to 1,
// in bands of rows spread over every processor.
public function drawGlow(app: state.App, table: Bytes, strength: Float) {
    if strength <= 0.001 { return }
    let back = app.back
    let rows = back.clipBottom - back.clipTop
    if rows <= 0 || back.clipRight <= back.clipLeft { return }
    // Most cursor/conversation damage is wholly inside the clear center.
    // No glow pixels live there, so avoid waking every CPU for an empty job.
    if back.clipLeft >= GLOW_REACH && back.clipRight <= back.width - GLOW_REACH && back.clipTop >= GLOW_REACH && back.clipBottom <= back.height - GLOW_REACH { return }
    let arguments = app.glowArguments
    let base = machine.address(arguments)
    machine.store64(base, back.address)
    machine.store64(base + 8, back.stride)
    machine.store64(base + 16, back.width)
    machine.store64(base + 24, back.height)
    machine.store64(base + 32, back.clipLeft)
    machine.store64(base + 40, back.clipTop)
    machine.store64(base + 48, back.clipRight)
    machine.store64(base + 56, back.clipBottom)
    machine.store64(base + 64, Integer(strength * 256.0))
    machine.store64(base + 72, machine.address(table))
    let bands = (rows + GLOW_BAND - 1) / GLOW_BAND
    if rows * (back.clipRight - back.clipLeft) < 60000 {
        for band in 0..bands { machine.callEntry(parallelEntry(glowRows), band, base) }
    } else {
        processors.parallelFor(app.processors, parallelEntry(glowRows), bands, base)
    }
    canvas.markDirty(back, back.clipLeft, back.clipTop, back.clipRight, back.clipBottom)
}

public function invalidateGlow(app: state.App) {
    let w = app.back.width
    let h = app.back.height
    state.invalidate(app, 0, 0, w, GLOW_REACH)
    state.invalidate(app, 0, h - GLOW_REACH, w, GLOW_REACH)
    state.invalidate(app, 0, 0, GLOW_REACH, h)
    state.invalidate(app, w - GLOW_REACH, 0, GLOW_REACH, h)
}

// ----- Pointer -----

public function pointerBox(x: Integer, y: Integer): List<Integer> {
    return [x - 8, y - 12, 30, 34]
}

public function drawPointer(app: state.App, x: Integer, y: Integer, shape: Integer) {
    if !state.visible(app, x - 8, y - 12, 30, 34) { return }
    let back = app.back
    if shape == state.POINTER_TEXT {
        icons.draw(back, app.icons, icons.TEXT_CURSOR_OUTLINE, x - 4, y - 9, 0xFFFFFF, 255)
        icons.draw(back, app.icons, icons.TEXT_CURSOR, x - 4, y - 9, 0x111111, 255)
    } else {
        if shape == state.POINTER_HAND {
            icons.draw(back, app.icons, icons.HAND_OUTLINE, x - 6, y - 1, 0xFFFFFF, 255)
            icons.draw(back, app.icons, icons.HAND, x - 6, y - 1, 0x111111, 255)
        } else {
            icons.draw(back, app.icons, icons.POINTER_OUTLINE, x, y, 0xFFFFFF, 255)
            icons.draw(back, app.icons, icons.POINTER, x, y, 0x111111, 255)
        }
    }
}
