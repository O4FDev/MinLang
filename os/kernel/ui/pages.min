// The web pages shown in the task window, drawn from shapes and text so the
// agent's browser has something faithful to show without a web engine.
use "../../shared/graphics/canvas.min" as canvas
use "../../shared/graphics/font.min" as font
use "../../shared/graphics/raster.min" as raster
use "./state.min" as state
use "./icons.min" as icons
use "./text.min" as text

function label(target: canvas.Canvas, face: font.Face, value: Text, x: Integer, baseline: Integer, color: Integer): Integer {
    return Integer(font.draw(target, face, value, Float(x), Float(baseline), color, 255))
}

function rightLabel(target: canvas.Canvas, face: font.Face, value: Text, right: Integer, baseline: Integer, color: Integer) {
    let width = font.measure(face, value)
    font.draw(target, face, value, Float(right) - width, Float(baseline), color, 255)
}

function centered(target: canvas.Canvas, face: font.Face, value: Text, center: Integer, baseline: Integer, color: Integer) {
    let width = font.measure(face, value)
    font.draw(target, face, value, Float(center) - width / 2.0, Float(baseline), color, 255)
}

// Fill a path, rasterizing only the rectangle it covers.
function shape(target: canvas.Canvas, path: raster.Path, color: Integer, alpha: Integer) {
    raster.close(path)
    let bounds = raster.bounds(path)
    let left = max(Integer(floor(bounds[0])), target.clipLeft)
    let top = max(Integer(floor(bounds[1])), target.clipTop)
    let right = min(Integer(ceil(bounds[2])) + 1, target.clipRight)
    let bottom = min(Integer(ceil(bounds[3])) + 1, target.clipBottom)
    if right <= left || bottom <= top { return }
    let coverage = raster.rasterize(path, Float(left), Float(top), right - left, bottom - top)
    canvas.mask(target, left, top, right - left, bottom - top, coverage, color, alpha)
}

function pill(target: canvas.Canvas, x: Integer, y: Integer, width: Integer, height: Integer, radius: Float, color: Integer) {
    let path = raster.newPath()
    raster.roundedRectangle(path, Float(x), Float(y), Float(width), Float(height), radius)
    let coverage = raster.rasterize(path, Float(x), Float(y), width, height)
    canvas.mask(target, x, y, width, height, coverage, color, 255)
}

function paragraph(target: canvas.Canvas, face: font.Face, value: Text, x: Integer, top: Integer, width: Integer, leading: Integer, color: Integer): Integer {
    let lines = text.wrap(face, value, Float(width))
    let y = top
    for line in lines {
        font.draw(target, face, line, Float(x), Float(y), color, 255)
        y += leading
    }
    return y
}

public function draw(app: state.App, target: canvas.Canvas, page: Integer) {
    canvas.resetClip(target)
    drawClipped(app, target, page)
}

// Draw only the part of the page inside the target's clip, for painting a
// large page a strip at a time.
public function drawClipped(app: state.App, target: canvas.Canvas, page: Integer) {
    canvas.fill(target, 0, 0, target.width, target.height, 0xFFFFFF)
    if page == state.PAGE_ARTICLE { article(app, target) }
    if page == state.PAGE_PURE { pure(app, target) }
    if page == state.PAGE_JAYS { jays(app, target) }
    if page == state.PAGE_SHANNON { shannon(app, target) }
    if page == state.PAGE_NORTHSTAR { northstar(app, target) }
    if page == state.PAGE_BIGMAN { bigman(app, target) }
    if page == state.PAGE_SHEET { sheet(app, target) }
    if page == state.PAGE_ATACAMA { atacama(app, target) }
    if page == state.PAGE_ARTICLE_LIVE { wikipedia(app, target) }
    if page == state.PAGE_SEARCH { search(app, target) }
    canvas.clearDirty(target)
}

// ----- sfgate.com: a ranked list with a map -----

function article(app: state.App, target: canvas.Canvas) {
    let type = app.type
    let w = target.width
    canvas.fill(target, 14, 21, 9, 1, 0x666666)
    canvas.fill(target, 14, 24, 9, 1, 0x666666)
    canvas.fill(target, 14, 27, 9, 1, 0x666666)
    label(target, type.pageLogo, "SFGATE", 34, 34, 0xE0262B)
    pill(target, w - 77, 14, 58, 18, 9.0, 0xD91C5C)
    centered(target, type.pageMedium, "Newsletters", w - 48, 26, 0xFFFFFF)
    canvas.fill(target, 0, 46, w, 1, 0xEEEEEE)
    let mapLeft = w * 52 / 100
    let x = 6
    let after = label(target, type.page, "By ", x, 66, 0x333333)
    let name = label(target, type.pageMedium, "Bianca Baymon", after, 66, 0x111111)
    canvas.fill(target, after, 68, name - after, 1, 0x111111)
    label(target, type.page, "July 11, 2026", name + 6, 66, 0x444444)
    let body = "From making space for a new baby to international relocation, Bay Area moving companies craft their services to help make your moves as stress-free as possible. Not all movers are created equal, and when it comes to protecting your furniture, new home and precious belongings, having the best movers on the job is critical. This list includes all the best moving companies in the Bay, based on this year's Best of Bay Area readers' poll results."
    let y = paragraph(target, type.page, body, x, 95, mapLeft - 20, 17, 0x333333)
    let ranks = ["1. NorthStar Moving Company", "2. Pure Moving Company", "3. Shannon Moving & Storage", "4. Jay's Small Moves", "5. One Big Man & One Big Truck"]
    y += 14
    for rank in ranks {
        label(target, type.pageBold, rank, x, y, 0x111111)
        y = paragraph(target, type.page, "Readers praised careful packing, on-time crews and clear, upfront pricing for apartment moves around the city.", x, y + 16, mapLeft - 20, 15, 0x555555) + 10
    }
    map(app, target, mapLeft, 50, w - mapLeft, target.height / 2 - 50)
}

function map(app: state.App, target: canvas.Canvas, x: Integer, y: Integer, width: Integer, height: Integer) {
    let saved = canvas.saveClip(target)
    canvas.intersectClip(target, x, y, width, height)
    if target.clipLeft >= target.clipRight || target.clipTop >= target.clipBottom {
        canvas.restoreClip(target, saved)
        return
    }
    canvas.fill(target, x, y, width, height, 0xE9ECE6)
    let fx = Float(x)
    let fy = Float(y)
    let fw = Float(width)
    let fh = Float(height)
    // The bay and the ocean.
    let water = raster.newPath()
    raster.moveTo(water, fx, fy + fh * 0.55)
    raster.lineTo(water, fx + fw * 0.28, fy + fh * 0.62)
    raster.lineTo(water, fx + fw * 0.30, fy + fh)
    raster.lineTo(water, fx, fy + fh)
    raster.close(water)
    raster.moveTo(water, fx + fw * 0.45, fy + fh * 0.30)
    raster.cubicTo(water, fx + fw * 0.62, fy + fh * 0.38, fx + fw * 0.58, fy + fh * 0.62, fx + fw * 0.70, fy + fh * 0.82)
    raster.lineTo(water, fx + fw * 0.80, fy + fh * 0.95)
    raster.cubicTo(water, fx + fw * 0.66, fy + fh * 0.90, fx + fw * 0.52, fy + fh * 0.66, fx + fw * 0.50, fy + fh * 0.50)
    raster.close(water)
    shape(target, water, 0xAAD3DF, 255)
    // Parks.
    let parks = raster.newPath()
    raster.ellipse(parks, fx + fw * 0.18, fy + fh * 0.18, fw * 0.10, fh * 0.07)
    raster.ellipse(parks, fx + fw * 0.80, fy + fh * 0.22, fw * 0.09, fh * 0.10)
    raster.ellipse(parks, fx + fw * 0.30, fy + fh * 0.88, fw * 0.08, fh * 0.05)
    shape(target, parks, 0xCFE5C6, 255)
    // Highways.
    let roads = raster.newPath()
    raster.stroke(roads, [fx + fw * 0.05, fy + fh * 0.10, fx + fw * 0.30, fy + fh * 0.35, fx + fw * 0.40, fy + fh * 0.65, fx + fw * 0.38, fy + fh], 1.6, false)
    raster.stroke(roads, [fx + fw * 0.55, fy, fx + fw * 0.66, fy + fh * 0.30, fx + fw * 0.90, fy + fh * 0.55, fx + fw, fy + fh * 0.70], 1.6, false)
    raster.stroke(roads, [fx + fw * 0.66, fy + fh * 0.30, fx + fw * 0.95, fy + fh * 0.12], 1.4, false)
    shape(target, roads, 0xF4C67A, 255)
    let small = raster.newPath()
    raster.stroke(small, [fx + fw * 0.30, fy + fh * 0.35, fx + fw * 0.62, fy + fh * 0.20, fx + fw * 0.95, fy + fh * 0.30], 1.0, false)
    raster.stroke(small, [fx + fw * 0.10, fy + fh * 0.45, fx + fw * 0.45, fy + fh * 0.48], 1.0, false)
    shape(target, small, 0xFFFFFF, 255)
    let names = ["Rohnert Park", "Sonoma", "Napa", "Fairfield", "Novato", "Vallejo", "San Rafael", "Concord", "Berkeley", "Oakland", "San Ramon", "Daly City", "Pacifica", "Fremont", "San Mateo"]
    let px = [0.30, 0.38, 0.62, 0.80, 0.30, 0.62, 0.40, 0.78, 0.62, 0.70, 0.84, 0.48, 0.42, 0.82, 0.62]
    let py = [0.06, 0.14, 0.13, 0.22, 0.36, 0.33, 0.46, 0.45, 0.58, 0.64, 0.72, 0.84, 0.92, 0.97, 0.94]
    for index in 0..names.length {
        label(target, app.type.pageSmall, names[index], x + Integer(fw * px[index]), y + Integer(fh * py[index]), 0x666666)
    }
    label(target, app.type.pageMedium, "San Francisco", x + Integer(fw * 0.34), y + Integer(fh * 0.71), 0x333333)
    // Moving companies on the map.
    let pins = raster.newPath()
    let pinX = [0.38, 0.50, 0.70, 0.60, 0.48]
    let pinY = [0.42, 0.50, 0.40, 0.68, 0.62]
    for index in 0..5 {
        raster.ellipse(pins, fx + fw * pinX[index], fy + fh * pinY[index], 5.0, 5.0)
    }
    shape(target, pins, 0xF0A33A, 220)
    canvas.restoreClip(target, saved)
}

// ----- Pure Moving -----

function pure(app: state.App, target: canvas.Canvas) {
    let type = app.type
    let w = target.width
    label(target, type.pageHeading, "PURE MOVING", 14, 28, 0x16C23B)
    label(target, type.pageSmall, "Licensed & Insured", 46, 38, 0x333333)
    let items = ["SERVICES", "RATES", "LOCATIONS", "RESOURCES", "COMPANY"]
    let x = 140
    for item in items {
        x = label(target, type.pageMedium, item, x, 28, 0x222222) + 12
    }
    pill(target, w - 92, 14, 82, 20, 10.0, 0xFFFFFF)
    canvas.frame(target, w - 92, 14, 82, 20, 1, 0xDDDDDD, 255)
    label(target, type.pageMedium, "415-919-6497", w - 82, 28, 0x111111)
    label(target, type.pageSmall, "7 days a week 8AM-6PM", w - 86, 44, 0x666666)
    // The hero: a green slab with moving boxes on the left.
    let hero = raster.newPath()
    raster.moveTo(hero, 0.0, 50.0)
    raster.lineTo(hero, Float(w) * 0.52, 50.0)
    raster.lineTo(hero, Float(w) * 0.44, 150.0)
    raster.lineTo(hero, 0.0, 150.0)
    raster.close(hero)
    shape(target, hero, 0x2BE04E, 255)
    canvas.fill(target, 40, 82, 70, 56, 0xC79A5B)
    canvas.fill(target, 40, 82, 70, 4, 0xB0844A)
    canvas.fill(target, 118, 98, 56, 40, 0xD3A867)
    canvas.fill(target, 118, 98, 56, 4, 0xB98F52)
    canvas.fill(target, 180, 70, 22, 68, 0xF2D3B5)
    canvas.fill(target, 206, 76, 20, 62, 0x3F6FB5)
    let text = Integer(Float(w) * 0.56)
    label(target, type.pageHeading, "Affordable moving & storage", text, 82, 0x111111)
    label(target, type.pageHeading, "services", text, 104, 0x111111)
    label(target, type.pageBold, "Get a free quote", text, 128, 0x111111)
    canvas.frame(target, text, 138, 64, 18, 1, 0xDDDDDD, 255)
    label(target, type.pageSmall, "Enter Pick up Z", text + 5, 150, 0x999999)
    canvas.frame(target, text + 70, 138, 64, 18, 1, 0xDDDDDD, 255)
    label(target, type.pageSmall, "Enter Drop off", text + 75, 150, 0x999999)
    pill(target, text + 142, 134, 64, 26, 13.0, 0x2BE04E)
    centered(target, type.pageMedium, "GET A QUOTE", text + 174, 151, 0x111111)
    label(target, type.pageBold, "THE HIGHEST-RATED", 16, 178, 0x111111)
    label(target, type.pageBold, "MOVERS ACROSS ALL", 16, 191, 0x111111)
    label(target, type.pageBold, "PLATFORMS", 16, 204, 0x111111)
    pill(target, 150, 170, 108, 34, 6.0, 0xF7F7F7)
    label(target, type.pageBold, "Google", 160, 192, 0x4285F4)
    label(target, type.pageBold, "4.9/5", 206, 188, 0x111111)
    label(target, type.pageSmall, "1,408+ reviews", 206, 198, 0x555555)
    // The privacy notice every site seems to have.
    let noticeX = Integer(Float(w) * 0.53)
    canvas.fill(target, noticeX, 166, w - noticeX - 18, 86, 0xFFFFFF)
    canvas.frame(target, noticeX, 166, w - noticeX - 18, 86, 1, 0xE4E4E4, 255)
    label(target, type.pageBold, "We value your privacy", noticeX + 10, 182, 0x111111)
    paragraph(target, type.pageSmall, "This website or its third-party tools process personal data. You can opt out of the sale of your personal information by clicking on the \"Do Not Sell or Share My Personal Information\" link.", noticeX + 10, 196, w - noticeX - 40, 10, 0x444444)
    label(target, type.pageSmall, "Do Not Sell or Share My Personal Information", noticeX + 10, 244, 0x1A5DC8)
}

// ----- Jay's Small Moves -----

function jays(app: state.App, target: canvas.Canvas) {
    let type = app.type
    let w = target.width
    pill(target, w - 172, 2, 86, 20, 3.0, 0xE02424)
    label(target, type.pageMedium, "(510) 501-5800", w - 160, 16, 0xFFFFFF)
    pill(target, w - 80, 2, 66, 20, 3.0, 0xE02424)
    label(target, type.pageMedium, "Get Quote", w - 66, 16, 0xFFFFFF)
    canvas.fill(target, 54, 0, 98, 14, 0x8E1B1B)
    canvas.fill(target, 54, 66, 2, 66, 0x2F80ED)
    label(target, type.page, "Get In Touch With Jay's Small Moves", 62, 77, 0x2F80ED)
    label(target, type.pageHeading, "Contact Jay's", 62, 102, 0x111111)
    label(target, type.pageHeading, "Small Moves", 62, 126, 0x111111)
    paragraph(target, type.page, "Whether you need a quick estimate or a general question, Jay's Small Moves is here to help. Feel free to reach out to us anytime.", 54, 156, 215, 14, 0x333333)
    label(target, type.pageBold, "Contact Us:", 54, 220, 0x111111)
    let after = label(target, type.pageBold, "Phone: ", 64, 240, 0x111111)
    label(target, type.page, "(510) 501-5800", after, 240, 0x222222)
    after = label(target, type.pageBold, "Hours: ", 64, 256, 0x111111)
    label(target, type.page, "Mon to Sun, 7am - 7pm", after, 256, 0x222222)
    // The quote form.
    let formX = w * 53 / 100
    canvas.fill(target, formX, 66, w - formX - 20, 210, 0x1E2A3A)
    label(target, type.pageHeading, "Free Quote", formX + 10, 94, 0xFFFFFF)
    label(target, type.pageSmall, "\" \" indicates required fields", formX + 10, 116, 0xC8CED6)
    let fieldWidth = (w - formX - 50) / 2
    label(target, type.pageMedium, "Name", formX + 10, 134, 0xFFFFFF)
    label(target, type.pageMedium, "Phone", formX + 20 + fieldWidth, 134, 0xFFFFFF)
    canvas.fill(target, formX + 10, 140, fieldWidth, 22, 0xFFFFFF)
    canvas.fill(target, formX + 20 + fieldWidth, 140, fieldWidth, 22, 0xFFFFFF)
    label(target, type.page, "(999) 999-9999", formX + 26 + fieldWidth, 155, 0xAAAAAA)
    label(target, type.pageMedium, "Email", formX + 10, 184, 0xFFFFFF)
    canvas.fill(target, formX + 10, 190, w - formX - 40, 22, 0xFFFFFF)
    label(target, type.pageMedium, "Move Type", formX + 10, 234, 0xFFFFFF)
    label(target, type.pageMedium, "Move Size", formX + 70, 234, 0xFFFFFF)
    label(target, type.pageMedium, "Date", formX + 130, 234, 0xFFFFFF)
    canvas.fill(target, formX + 10, 240, 54, 18, 0xFFFFFF)
    canvas.fill(target, formX + 70, 240, 54, 18, 0xFFFFFF)
    canvas.fill(target, formX + 130, 240, 54, 18, 0xFFFFFF)
    label(target, type.pageSmall, "Residential", formX + 13, 252, 0x555555)
    label(target, type.pageSmall, "Studio Apt", formX + 73, 252, 0x555555)
    label(target, type.pageSmall, "mm/dd/yyyy", formX + 133, 252, 0xAAAAAA)
}

// ----- Shannon Moving & Storage -----

function shannon(app: state.App, target: canvas.Canvas) {
    let type = app.type
    let w = target.width
    canvas.fill(target, 0, 0, w, 30, 0x0F3D2E)
    label(target, type.pageSmall, "Call us", 22, 18, 0xFFFFFF)
    label(target, type.pageSmall, "415-866-4424 | 650-444-7913", 52, 18, 0xF4C430)
    label(target, type.pageSmall, "Services: Bay Area", 250, 18, 0xFFFFFF)
    pill(target, w - 74, 4, 62, 22, 3.0, 0xE3B53B)
    centered(target, type.pageSmall, "FREE QUOTE", w - 43, 18, 0x222222)
    canvas.fill(target, 0, 30, w, 76, 0x157A4A)
    canvas.fill(target, 48, 36, 52, 54, 0xFFFFFF)
    label(target, type.pageHeading, "S", 64, 70, 0x157A4A)
    label(target, type.pageSmall, "Shannon Moving & Storage", 30, 101, 0xFFFFFF)
    let items = ["Home", "Moving", "Storage", "Packing", "Office And Commercial", "Other Services", "FAQ"]
    let x = 138
    for index in 0..items.length {
        let color = 0xFFFFFF
        if index == 0 { color = 0xF4C430 }
        x = label(target, type.pageMedium, items[index], x, 72, color) + 9
    }
    label(target, type.pageHeading, "Moving & storage, since 1984", 24, 146, 0x111111)
    paragraph(target, type.page, "Shannon Moving & Storage is a family owned San Francisco mover with crews in the city and on the Peninsula. Two movers and a truck start at $495 for a studio or one-bedroom apartment, with no hidden fees.", 24, 170, w - 48, 15, 0x333333)
    pill(target, 24, 214, 120, 26, 4.0, 0x157A4A)
    centered(target, type.pageMedium, "Get a free estimate", 84, 231, 0xFFFFFF)
}

// ----- NorthStar Moving Company -----

function northstar(app: state.App, target: canvas.Canvas) {
    let type = app.type
    let w = target.width
    let mark = raster.newPath()
    raster.moveTo(mark, 18.0, 52.0)
    raster.lineTo(mark, 30.0, 18.0)
    raster.lineTo(mark, 40.0, 40.0)
    raster.lineTo(mark, 50.0, 14.0)
    raster.lineTo(mark, 54.0, 52.0)
    raster.lineTo(mark, 46.0, 52.0)
    raster.lineTo(mark, 44.0, 34.0)
    raster.lineTo(mark, 38.0, 52.0)
    raster.lineTo(mark, 30.0, 34.0)
    raster.lineTo(mark, 26.0, 52.0)
    raster.close(mark)
    shape(target, mark, 0xD31F2B, 255)
    label(target, type.pageLogo, "NorthStar", 58, 42, 0xD31F2B)
    label(target, type.pageMedium, "Moving Company", 60, 55, 0xD31F2B)
    rightLabel(target, type.pageSmall, "(800) 275-7767   Schedule a Video Chat Estimate", w - 92, 30, 0xC0505A)
    pill(target, w - 86, 18, 72, 18, 2.0, 0xD31F2B)
    centered(target, type.pageSmall, "Get a Free Quote", w - 50, 30, 0xFFFFFF)
    let items = ["Moving", "Storage", "Other Services", "Client Reviews", "Awards", "Moving Tips", "About"]
    let x = 18
    for item in items {
        x = label(target, type.page, item, x, 82, 0x333333) + 16
    }
    centered(target, type.pageSmall, "Help us feed hungry kids", w / 2, 112, 0x4A7FC1)
    // San Francisco at dusk.
    let top = 122
    let height = target.height / 2 - top
    canvas.gradient(target, 0, top, w, height, 0xD9D4CC, 255, 0xF2E3C6, 255)
    let buildings = [0.02, 0.10, 0.08, 0.13, 0.30, 0.22, 0.40, 0.18, 0.48, 0.30, 0.60, 0.25, 0.70, 0.12, 0.84, 0.20]
    let index = 0
    while index < buildings.length {
        let bx = Integer(Float(w) * buildings[index])
        let bh = Integer(Float(height) * buildings[index + 1] * 1.8)
        canvas.fill(target, bx, top + height - bh, 44, bh, 0x6D6A66)
        canvas.fill(target, bx + 4, top + height - bh + 6, 36, 2, 0x8B8781)
        index += 2
    }
    let pyramid = raster.newPath()
    let center = Float(w) * 0.66
    raster.moveTo(pyramid, center, Float(top + 4))
    raster.lineTo(pyramid, center + 22.0, Float(top + height))
    raster.lineTo(pyramid, center - 22.0, Float(top + height))
    raster.close(pyramid)
    shape(target, pyramid, 0xE8E2D8, 255)
}

