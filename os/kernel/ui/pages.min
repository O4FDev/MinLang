}

// ----- Google Sheets -----

function sheet(app: state.App, target: canvas.Canvas) {
    sheetGrid(app, target)
    sheetRows(app, target)
}

constant SHEET_GUTTER = 18
constant SHEET_ROW = 11
constant SHEET_GRID_TOP = 76

function sheetColumns(width: Integer): List<Integer> {
    return [SHEET_GUTTER, SHEET_GUTTER + 112, SHEET_GUTTER + 186, SHEET_GUTTER + 260, SHEET_GUTTER + 334, width]
}

// The spreadsheet without the movers' rows.
public function sheetGrid(app: state.App, target: canvas.Canvas) {
    canvas.fill(target, 0, 0, target.width, target.height, 0xFFFFFF)
    let type = app.type
    let w = target.width
    // Title bar.
    canvas.fill(target, 6, 8, 16, 18, 0x0F9D58)
    canvas.fill(target, 9, 13, 10, 1, 0xFFFFFF)
    canvas.fill(target, 9, 17, 10, 1, 0xFFFFFF)
    canvas.fill(target, 9, 21, 10, 1, 0xFFFFFF)
    let titleEnd = label(target, type.pageMedium, "Friday move — company shortlist", 28, 16, 0x202124)
    label(target, type.pageSmall, "Saved to Drive", titleEnd + 16, 15, 0x5F6368)
    let menus = ["File", "Edit", "View", "Insert", "Format", "Data", "Tools", "Extensions", "Help"]
    let x = 28
    for menu in menus {
        x = label(target, type.pageSmall, menu, x, 28, 0x3C4043) + 9
    }
    pill(target, w - 46, 8, 40, 18, 9.0, 0x0B57D0)
    centered(target, type.pageSmall, "Sign in", w - 26, 20, 0xFFFFFF)
    pill(target, w - 100, 8, 48, 18, 9.0, 0xF1F3F4)
    centered(target, type.pageSmall, "Share", w - 76, 20, 0x3C4043)
    // Toolbar and formula bar.
    canvas.fill(target, 4, 36, w - 8, 18, 0xF1F3F4)
    let tools = ["100%", "$", "%", ".0", "123", "Defaul...", "10", "B", "I", "S", "A"]
    x = 14
    for tool in tools {
        x = label(target, type.pageSmall, tool, x, 48, 0x444746) + 12
    }
    canvas.fill(target, 0, 60, w, 1, 0xE0E0E0)
    label(target, type.pageSmall, "A1", 8, 70, 0x444746)
    label(target, type.pageSmall, "fx   Friday move — San Francisco", 40, 70, 0x444746)
    canvas.fill(target, 0, 75, w, 1, 0xE0E0E0)
    // The grid.
    let gridTop = 76
    let rowHeight = 11
    let header = 11
    let gutter = 18
    let columns = [gutter, gutter + 112, gutter + 186, gutter + 260, gutter + 334, w]
    let headers = ["A", "B", "C", "D", "E"]
    canvas.fill(target, 0, gridTop, w, header, 0xF8F9FA)
    for index in 0..5 {
        centered(target, type.sheet, headers[index], (columns[index] + columns[index + 1]) / 2, gridTop + 8, 0x5F6368)
    }
    for row in 0..30 {
        let y = gridTop + header + row * rowHeight
        canvas.fill(target, 0, y, gutter, rowHeight, 0xF8F9FA)
        centered(target, type.sheet, Text(row + 1), gutter / 2, y + 8, 0x5F6368)
        canvas.fill(target, 0, y + rowHeight - 1, w, 1, 0xE2E3E3)
    }
    for column in columns {
        canvas.fill(target, column, gridTop, 1, header + 30 * rowHeight, 0xE2E3E3)
    }
    let cellY = gridTop + header + 8
    label(target, type.sheet, "Friday move — San Francisco", gutter + 3, cellY, 0x202124)
    canvas.frame(target, gutter, gridTop + header, columns[1] - gutter + 1, rowHeight, 1, 0x1A73E8, 255)
    label(target, type.sheet, "Company contacts, Friday availability, and quotes.", gutter + 3, cellY + rowHeight, 0x202124)
    let heads = ["Company", "Phone", "Call outcome", "Quote (USD)", "Details"]
    for index in 0..5 {
        label(target, type.sheetBold, heads[index], columns[index] + 3, cellY + rowHeight * 2, 0x202124)
    }
}

// The movers' rows, drawn over the grid.
// The part of the spreadsheet that sheetRows writes into: top and height.
public function sheetRowsBand(): List<Integer> {
    let cellY = SHEET_GRID_TOP + SHEET_ROW + 8
    return [cellY + SHEET_ROW * 2, SHEET_ROW * 28]
}

public function sheetRows(app: state.App, target: canvas.Canvas) {
    let type = app.type
    let panel = app.panel
    let columns = sheetColumns(target.width)
    let rowHeight = SHEET_ROW
    let cellY = SHEET_GRID_TOP + SHEET_ROW + 8
    for index in 0..panel.sheetRows {
        let y = cellY + rowHeight * (3 + index)
        label(target, type.sheet, panel.sheetNames[index], columns[0] + 3, y, 0x202124)
        label(target, type.sheet, panel.sheetPhones[index], columns[1] + 3, y, 0x202124)
        label(target, type.sheet, panel.sheetOutcomes[index], columns[2] + 3, y, 0x202124)
        let quote = panel.sheetQuotes[index]
        if quote != "" {
            rightLabel(target, type.sheet, quote, columns[4] - 3, y, 0x202124)
        }
        label(target, type.sheet, panel.sheetDetails[index], columns[4] + 3, y, 0x202124)
    }
}

// ----- The Atacama request, as the agent sees it -----

function atacama(app: state.App, target: canvas.Canvas) {
    let type = app.type
    let panel = app.panel
    let w = target.width
    canvas.fill(target, 0, 0, w, 30, 0xF4F1EA)
    label(target, type.pageBold, "atacama", 12, 20, 0x8A5A2B)
    label(target, type.page, "an AI lab · 30M language model", 64, 20, 0x8A7A66)
    canvas.fill(target, 0, 30, w, 1, 0xE5DED2)
    let y = 50
    label(target, type.pageBold, "Request", 12, y, 0x111111)
    y += 16
    for line in text.wrap(type.page, panel.request, Float(w - 30)) {
        label(target, type.page, line, 16, y, 0x333333)
        y += 13
    }
    y += 10
    label(target, type.pageBold, "Response", 12, y, 0x111111)
    y += 16
    if panel.response == "" {
        label(target, type.page, "Waiting for the model…", 16, y, 0x999999)
    } else {
        for line in text.wrap(type.page, panel.response, Float(w - 30)) {
            label(target, type.page, line, 16, y, 0x333333)
            y += 13
        }
    }
}

// ----- Wikipedia, as fetched over HTTPS -----

function wikipediaHeader(app: state.App, target: canvas.Canvas) {
    let type = app.type
    let w = target.width
    canvas.fill(target, 0, 0, w, 34, 0xF8F9FA)
    canvas.fill(target, 0, 34, w, 1, 0xEAECF0)
    canvas.fill(target, 12, 9, 16, 16, 0xFFFFFF)
    canvas.frame(target, 12, 9, 16, 16, 1, 0xA2A9B1, 255)
    label(target, type.pageBold, "W", 15, 22, 0x202122)
    label(target, type.pageBold, "WIKIPEDIA", 36, 18, 0x202122)
    label(target, type.pageSmall, "The Free Encyclopedia", 36, 28, 0x54595D)
    canvas.frame(target, w - 190, 9, 176, 18, 1, 0xA2A9B1, 255)
    label(target, type.pageSmall, "Search Wikipedia", w - 182, 21, 0x72777D)
}

function wikipedia(app: state.App, target: canvas.Canvas) {
    let type = app.type
    let panel = app.panel
    let w = target.width
    wikipediaHeader(app, target)
    label(target, type.pageHeading, panel.articleTitle, 16, 64, 0x202122)
    canvas.fill(target, 16, 72, w - 32, 1, 0xA2A9B1)
    label(target, type.pageSmall, "From Wikipedia, the free encyclopedia · " + panel.articleHost, 16, 86, 0x54595D)
    let y = 104
    if panel.articleDescription != "" {
        label(target, type.pageMedium, panel.articleDescription, 16, y, 0x54595D)
        y += 18
    }
    paragraph(target, type.page, panel.articleText, 16, y, w - 32, 14, 0x202122)
}

function search(app: state.App, target: canvas.Canvas) {
    let type = app.type
    let panel = app.panel
    let w = target.width
    wikipediaHeader(app, target)
    label(target, type.pageHeading, "Search results", 16, 64, 0x202122)
    canvas.fill(target, 16, 72, w - 32, 1, 0xA2A9B1)
    let y = 96
    if panel.searchResults.length == 0 {
        label(target, type.page, "Searching " + panel.articleHost + "…", 16, y, 0x72777D)
    }
    let index = 0
    while index + 1 < panel.searchResults.length {
        label(target, type.pageBold, panel.searchResults[index], 16, y, 0x3366CC)
        y = paragraph(target, type.page, panel.searchResults[index + 1], 16, y + 15, w - 32, 13, 0x202122) + 10
        index += 2
    }
}
