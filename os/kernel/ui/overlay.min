// Windows over the desktop (help, account, system), short-lived toasts, and
// the sidebar destinations other than the conversation.
use "../../shared/graphics/canvas.min" as canvas
use "../../shared/graphics/font.min" as font
use "./state.min" as state
use "./theme.min" as theme
use "./icons.min" as icons
use "./text.min" as text

public constant NONE = 0
public constant HELP = 1
public constant ACCOUNT = 2
public constant SYSTEM = 3

constant CARD_WIDTH = 560
constant TOAST_SECONDS = 2.4

public function isOpen(app: state.App): Boolean {
    return app.menu != NONE
}

public function open(app: state.App, menu: Integer) {
    app.menu = menu
    app.menuShown = state.Tween { from: 0.0; to: 1.0; start: app.now; duration: 0.22 }
    state.invalidateAll(app)
}

public function close(app: state.App) {
    app.menu = NONE
    state.invalidateAll(app)
}

function lines(app: state.App): List<Text> {
    if app.menu == HELP {
        return [
            "Type a request and press Enter or the send button.",
            "Ask about moving apartments to watch the agent find movers,",
            "browse their sites, build a spreadsheet and call them.",
            "Anything else goes to Atacama, a 30M model, over the network.",
            "",
            "Mouse wheel, Page Up and Page Down scroll the conversation.",
            "Click the step summary to show or hide the agent's steps.",
            "The task window's corner button maximizes it; its pause",
            "button pauses the agent. Hang up ends the current call.",
            "F1 opens this help. Escape closes windows and clears the composer."
        ]
    }
    if app.menu == ACCOUNT {
        return [
            "Signed in on this machine as E.",
            "",
            "Minyar OS keeps everything in memory: conversations",
            "last until the machine restarts.",
            "",
            "Everything on screen — boot loader, kernel, drivers, the",
            "TrueType renderer and TCP/IP — is written in Minyar."
        ]
    }
    return app.system
}

function title(app: state.App): Text {
    if app.menu == HELP { return "Help" }
    if app.menu == ACCOUNT { return "Account" }
    return "Minyar OS"
}

function cardHeight(app: state.App): Integer {
    return 40 + 30 + lines(app).length * 24 + 24
}

function cardLeft(app: state.App): Integer {
    return (app.back.width - CARD_WIDTH) / 2
}

function cardTop(app: state.App): Integer {
    return (app.back.height - cardHeight(app)) / 2 - 40
}

public function hit(app: state.App, x: Integer, y: Integer): Integer {
    if state.inside(x, y, cardLeft(app) + CARD_WIDTH - 34, cardTop(app) + 4, 30, 32) { return 101 }
    return 0
}

public function click(app: state.App, x: Integer, y: Integer) {
    let inside = state.inside(x, y, cardLeft(app), cardTop(app), CARD_WIDTH, cardHeight(app))
    if !inside || hit(app, x, y) == 101 {
        close(app)
    }
}

public function animate(app: state.App) {
    if app.menu != NONE && (state.animating(app.menuShown, app.now) || state.animating(app.menuShown, app.previous)) {
        state.invalidateAll(app)
    }
    let age = app.now - app.toast.born
    if age < TOAST_SECONDS + 0.1 && age > 0.0 {
        // Fade in and out at the ends.
        if age < 0.25 || age > TOAST_SECONDS - 0.4 {
            invalidateToast(app)
        }
    }
}

public function invalidateToast(app: state.App) {
    let toast = app.toast
    if toast.text == "" { return }
    let width = Integer(font.measure(app.type.small, toast.text)) + 28
    state.invalidate(app, toast.x - width / 2 - 4, toast.y - 4, width + 8, 40)
}

public function draw(app: state.App) {
    let back = app.back
    // The toast.
    let toast = app.toast
    let age = app.now - toast.born
    if toast.text != "" && age >= 0.0 && age < TOAST_SECONDS {
        let alpha = 255
        if age < 0.25 { alpha = Integer(age / 0.25 * 255.0) }
        if age > TOAST_SECONDS - 0.4 { alpha = Integer((TOAST_SECONDS - age) / 0.4 * 255.0) }
        let width = Integer(font.measure(app.type.small, toast.text)) + 28
        let x = clamp(toast.x - width / 2, 8, back.width - width - 8)
        canvas.blend(back, x, toast.y, width, 32, 0x1E1E1E, alpha * 235 / 255)
        font.draw(back, app.type.small, toast.text, Float(x + 14), Float(toast.y + 21), 0xF2F2F2, alpha)
    }
    if app.menu == NONE { return }
    let shown = state.value(app.menuShown, app.now)
    canvas.blend(back, 0, 0, back.width, back.height, 0x101010, Integer(shown * 46.0))
    let left = cardLeft(app)
    let top = cardTop(app) + Integer((1.0 - shown) * 12.0)
    let height = cardHeight(app)
    canvas.fill(back, left, top, CARD_WIDTH, height, 0xF7F7F7)
    canvas.frame(back, left, top, CARD_WIDTH, height, 1, 0xDADADA, 255)
    canvas.fill(back, left, top, CARD_WIDTH, 40, theme.ACCENT)
    font.draw(back, app.type.title, title(app), Float(left + 10), Float(top + 26), theme.WHITE, 255)
    icons.draw(back, app.icons, icons.CLOSE, left + CARD_WIDTH - 25, top + 14, theme.WHITE, 255)
    let y = top + 40 + 36
    for line in lines(app) {
        font.draw(back, app.type.row, line, Float(left + 22), Float(y), theme.TEXT, 255)
        y += 24
    }
    if shown < 1.0 {
        canvas.blend(back, left - 1, top - 1, CARD_WIDTH + 2, height + 2, theme.BACKGROUND, Integer((1.0 - shown) * 255.0))
    }
}

// ----- Other sidebar destinations -----

public function drawView(app: state.App) {
    let back = app.back
    let left = theme.COLUMN_CENTERED_LEFT
    let face = app.type.body
    if app.view == state.VIEW_TASKS {
        heading(app, "Tasks", "Everything the agent has worked on since this machine started.")
        let y = 170
        let count = 0
        for block in app.blocks {
            if block.kind == state.TASK {
                let color = theme.ACCENT
                let status = block.detail
                if block.done {
                    color = theme.SUCCESS
                    status = "Done"
                }
                canvas.fill(back, left, y, theme.CARD_WIDTH, 40, color)
                font.draw(back, app.type.title, block.text, Float(left + 10), Float(y + 26), theme.WHITE, 255)
                canvas.fill(back, left, y + 40, theme.CARD_WIDTH, 47, theme.CARD)
                canvas.frame(back, left, y + 40, theme.CARD_WIDTH, 47, 1, theme.CARD_BORDER, 255)
                font.draw(back, app.type.status, status, Float(left + 12), Float(y + 70), theme.INK, 255)
                y += 110
                count += 1
            }
        }
        if count == 0 {
            font.draw(back, face, "No tasks yet. Ask for something in Chat.", Float(left), 190.0, theme.MUTED, 255)
        }
    }
    if app.view == state.VIEW_LIBRARY {
        heading(app, "Library", "Files on this machine's disk, read by the Minyar ATA driver.")
        let y = 196
        for line in app.library {
            font.draw(back, app.type.row, line, Float(left), Float(y), theme.TEXT, 255)
            canvas.fill(back, left, y + 16, theme.TABLE_WIDTH, 1, theme.RULE)
            y += 42
        }
    }
    if app.view == state.VIEW_NOTES {
        heading(app, "Notes", "Replies worth keeping.")
        let y = 196
        for block in app.blocks {
            if block.kind == state.REPLY && block.detail == "copy" {
                for line in text.wrap(app.type.row, block.text, Float(theme.TABLE_WIDTH)) {
                    font.draw(back, app.type.row, line, Float(left), Float(y), theme.TEXT, 255)
                    y += 25
                }
                y += 20
            }
        }
        if y == 196 {
            font.draw(back, face, "Finished answers appear here.", Float(left), 196.0, theme.MUTED, 255)
        }
    }
    if app.view == state.VIEW_SEARCH {
        heading(app, "Search", "Type in the composer to search the conversation.")
        let query = app.composer.text
        let y = 196
        if query != "" {
            for block in app.blocks {
                if (block.kind == state.REPLY || block.kind == state.USER) && contains(block.text, query) {
                    font.draw(back, app.type.row, text.fit(app.type.row, block.text, Float(theme.TABLE_WIDTH)), Float(left), Float(y), theme.TEXT, 255)
                    canvas.fill(back, left, y + 16, theme.TABLE_WIDTH, 1, theme.RULE)
                    y += 42
                }
            }
        }
    }
}

function heading(app: state.App, title: Text, subtitle: Text) {
    let left = Float(theme.COLUMN_CENTERED_LEFT)
    font.draw(app.back, app.type.large, title, left, 110.0, theme.INK, 255)
    font.draw(app.back, app.type.step, subtitle, left, 140.0, theme.MUTED, 255)
}

function lower(character: Character): Character {
    if character >= 'A' && character <= 'Z' {
        return Character(Integer(character) + 32)
    }
    return character
}

public function contains(haystack: Text, needle: Text): Boolean {
    if needle.length == 0 { return true }
    let last = haystack.length - needle.length
    for start in 0..(last + 1) {
        let matches = true
        let index = 0
        while matches && index < needle.length {
            if lower(haystack[start + index]) != lower(needle[index]) {
                matches = false
            }
            index += 1
        }
        if matches { return true }
    }
    return false
}
