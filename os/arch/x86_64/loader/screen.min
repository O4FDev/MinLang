// The boot screen: the wordmark, a hairline progress bar and a status line,
// drawn in the same palette as the desktop it leads into.
use "../../../shared/graphics/canvas.min" as canvas
use "../../../shared/graphics/font.min" as font
use "../../../shared/graphics/wordmark.min" as wordmark
use "../../../shared/interrupts.min" as interrupts

constant BACKGROUND = 0xF2F2F2
constant ACCENT = 0x378EF7
constant TRACK = 0xE0E0E0
constant WORDMARK = 0xC9C9C9
constant STATUS = 0x9A9A9A
constant BAR_WIDTH = 240
constant MARK_SCALE = 2.2

public record Screen {
    back: canvas.Canvas
    mark: Bytes
    caption: font.Face
    centerX: Integer
    centerY: Integer
    shown: Float
    status: Text
}

public function create(back: canvas.Canvas, typeface: font.Font): Screen {
    return Screen {
        back: back
        mark: wordmark.render(MARK_SCALE)
        caption: font.face(typeface, 13.0, 0.0)
        centerX: back.width / 2
        centerY: back.height / 2 - 20
        shown: 0.0
        status: ""
    }
}

function draw(screen: Screen, opacity: Float, progress: Float) {
    let back = screen.back
    let top = screen.centerY - 80
    canvas.fill(back, screen.centerX - 300, top, 600, 200, BACKGROUND)
    let alpha = Integer(opacity * 255.0)
    let markWidth = wordmark.width(MARK_SCALE)
    let markHeight = wordmark.height(MARK_SCALE)
    // Rise a few pixels as it fades in.
    let lift = Integer((1.0 - opacity) * 8.0)
    canvas.mask(back, screen.centerX - markWidth / 2, screen.centerY - markHeight + 12 + lift, markWidth, markHeight, screen.mark, WORDMARK, alpha)
    let barX = screen.centerX - BAR_WIDTH / 2
    let barY = screen.centerY + 44
    canvas.blend(back, barX, barY, BAR_WIDTH, 2, TRACK, alpha)
    canvas.blend(back, barX, barY, Integer(Float(BAR_WIDTH) * progress), 2, ACCENT, alpha)
    if screen.status != "" {
        let statusWidth = font.measure(screen.caption, screen.status)
        font.draw(back, screen.caption, screen.status, Float(screen.centerX) - statusWidth / 2.0, Float(barY + 28), STATUS, alpha)
    }
}

function ease(t: Float): Float {
    let clamped = clamp(t, 0.0, 1.0)
    return 1.0 - (1.0 - clamped) * (1.0 - clamped) * (1.0 - clamped)
}

public function animateIn(screen: Screen, target: canvas.Canvas) {
    let start = interrupts.milliseconds()
    let t = 0.0
    while t < 1.0 {
        t = Float(interrupts.milliseconds() - start) / 450.0
        draw(screen, ease(t), 0.0)
        canvas.present(screen.back, target)
        interrupts.idle()
    }
    screen.shown = 1.0
}

public function progress(screen: Screen, target: canvas.Canvas, amount: Float, status: Text) {
    screen.status = status
    draw(screen, 1.0, amount)
    canvas.present(screen.back, target)
}

public function finish(screen: Screen, target: canvas.Canvas) {
    interrupts.sleep(250)
    let start = interrupts.milliseconds()
    let t = 0.0
    while t < 1.0 {
        t = Float(interrupts.milliseconds() - start) / 300.0
        draw(screen, 1.0 - ease(t), 1.0)
        canvas.present(screen.back, target)
        interrupts.idle()
    }
}
