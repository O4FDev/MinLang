// Read the PC's CMOS calendar on the boot CPU before SMP. The caller must
// exclusively own ports 0x70/0x71, including against interrupt/NMI handlers.
// Every selection has bit 7 clear: NMI is enabled, not saved and restored.
// Only the index port is written; calendar, modes and interrupt flags are not.
// Port records, the captured callback and shared reader Results may allocate;
// this adapter is not a no-heap or interrupt-context API.
use "device" as device
use "../../shared/rtc.min" as calendar

public function read(attempts: Integer): Result<calendar.Calendar, Text> {
    let selector = device.port8(0x70)
    let data = device.port8(0x71)
    let readRegister = function(index: Integer): Integer {
        device.out8(selector, index)
        return device.in8(data)
    }
    return calendar.read(readRegister, attempts)
}
