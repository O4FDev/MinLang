// Freestanding Minyar OS has no provisioned trust anchors, clock-backed X.509
// validator, or asymmetric certificate signer. HTTPS must fail closed until
// those providers exist; encryption alone cannot authenticate a server.
public function chain(host: Text, certificates: Bytes, anchors: Bytes): Text {
    return "certificate trust validation is unavailable on this freestanding target"
}
public function signature(certificate: Bytes, scheme: Integer, content: Bytes, signature: Bytes): Boolean { return false }
public function sign(privateKey: Bytes, scheme: Integer, content: Bytes): Bytes { return Bytes() }
public function currentTimeMilliseconds(): Integer { return 0 }
// No current certificate or asymmetric provider exists on this target.
public function currentCertificateExpiry(certificates: Bytes): Integer { return 0 }
public function p256Key(): Bytes { return Bytes() }
public function p256Public(privateKey: Bytes): Bytes { return Bytes() }
public function p256(privateKey: Bytes, publicKey: Bytes): Bytes { return Bytes() }

public function clientChain(certificates: Bytes, anchors: Bytes): Text { return "certificate trust validation is unavailable on this freestanding target" }
