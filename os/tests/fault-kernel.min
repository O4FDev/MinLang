// Expected-failure fixture for serial fault capture and ELF symbolization.
// Both OS boot mappings leave this address unmapped. The access must fault.
use "machine" as machine

function faultingRead(): Integer {
    return machine.read64(4294967296)
}

function main(): Integer {
    print("OSDEV EXPECTED FAULT")
    print(faultingRead())
    fail("the expected unmapped access did not fault")
    return 1
}
