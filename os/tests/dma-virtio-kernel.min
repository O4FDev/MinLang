// A real one-shot PCI device writes over the poisoned CPU allocation. The host
// supplies QEMU rng-random backed by /dev/zero; no modeled completion is used.
use "../shared/pci.min" as pci
use "../shared/virtio/virtio.min" as virtio

function main(): Integer {
    print("OSDEV AFFINE VIRTIO RNG START")
    let devices = pci.scan()
    pci.assignAddresses(devices)
    let value = virtio.readOneEntropyByte(devices)
    if value != 0 { fail("the actual virtio-rng byte differs from the /dev/zero oracle") }
    print("OSDEV AFFINE VIRTIO RNG PASS")
    return 0
}
