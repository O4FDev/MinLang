// Read a genuinely new device through real x86 port I/O. The host oracle
// compares the printed calendar with QEMU's explicit virtual-clock RTC base.
// Run before SMP or any other CMOS user; selector writes enable NMI.
use "../arch/x86_64/rtc.min" as rtc

function main(): Integer {
    print("OSDEV RTC START")
    match rtc.read(128) {
        Ok(calendar) {
            print("OSDEV RTC " + Text(calendar.year) + " " + Text(calendar.month) + " " + Text(calendar.day) + " " + Text(calendar.hour) + " " + Text(calendar.minute) + " " + Text(calendar.second))
        }
        Err(error) { fail(error) }
    }
    print("OSDEV RTC PASS")
    return 0
}
