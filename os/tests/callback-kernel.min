// Exercise the real selected graph runtime on a single boot CPU. The bounded
// service loop checks cleanup debt quiescence, not a maximum heap/stack bound.
function service(): Boolean { native "callbackruntime" }

record Node { value: Integer; callbacks: List<Callback<Integer, Integer>> }

function makeCycle(): Integer {
    let node = Node { value: 40; callbacks: [] }
    let callback = function(delta: Integer): Integer { return node.value + delta }
    node.callbacks.add(callback)
    let stored = node.callbacks[0]
    return stored(2)
}

function main(): Integer {
    print("OSDEV CALLBACK START")
    let round = 0
    while round < 32 {
        if makeCycle() != 42 { fail("callback capture returned the wrong value") }
        let batches = 0
        while service() {
            batches += 1
            if batches > 100000 { fail("callback cleanup debt did not quiesce") }
        }
        round += 1
    }
    print("OSDEV CALLBACK PASS")
    return 0
}
