// Three checked DMA buffers in flight at once on QEMU's real virtio-rng, backed
// by /dev/zero, over eight rounds that reuse every ring slot. Each poisoned
// byte must come back as a device-written zero through its own Pending.
use "../shared/pci.min" as pci
use "../shared/virtio/virtio.min" as virtio

function main(): Integer {
    print("OSDEV DMA RING START")
    let devices = pci.scan()
    pci.assignAddresses(devices)
    let total = virtio.readEntropyRounds(devices, 8)
    if total != 0 { fail("device-written bytes differ from the /dev/zero oracle: " + Text(total)) }
    print("OSDEV DMA RING PASS")
    return 0
}
