// Writes one serial line through inline assembly instead of the device
// library, so the host test sees the instructions' effect directly.
function writeSerial(text: Text) {
    let bytes = Bytes(text)
    for index in 0..bytes.length {
        let character = bytes[index]
        assembly for x86_64 "outb %al, %dx" inputs(character in al, 0x3F8 in dx) changes(nothing)
    }
}

function main(): Integer {
    print("OSDEV ASM START")
    assembly for x86_64 "pause" changes(nothing)
    writeSerial("OSDEV ASM WROTE THIS\n")
    print("OSDEV ASM PASS")
    return 0
}
