// Fail a few calls deep so the serial log carries a real call chain for
// tools/osdev.py to symbolize. The step is not a simple accumulation, so
// link-time optimization cannot turn the recursion into a loop.
function descend(depth: Integer): Integer {
    if depth == 0 { fail("OSDEV PANIC EXPECTED") }
    return descend(depth - 1) * 3 - depth
}

function main(): Integer {
    print("OSDEV PANIC START")
    let value = descend(3)
    print("OSDEV PANIC UNREACHABLE " + Text(value))
    return 0
}
