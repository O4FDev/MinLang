#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$project_dir/.minyar-distribution" ]; then
    distribution_platform=macos
    if [ -f "$project_dir/distribution.platform" ]; then distribution_platform=$(cat "$project_dir/distribution.platform"); fi
    case "$distribution_platform" in
        macos)
            sh "$project_dir/tools/macos-platform.sh" "$project_dir"
            distribution_cache=Library/Caches ;;
        linux)
            sh "$project_dir/tools/linux-platform.sh" "$project_dir"
            distribution_cache=.cache ;;
        *) printf 'minyar: unknown distribution platform: %s\n' "$distribution_platform" >&2; exit 1 ;;
    esac
    MINYAR_PREBUILT=1
    MINYAR_BUNDLED_CLANG=$project_dir/toolchain/bin/clang
    MINYAR_CACHE_DIR=${MINYAR_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:?HOME must be set}/$distribution_cache}/minyar}
    PATH="$project_dir/toolchain/bin:${PATH:-/usr/bin:/bin}:/usr/bin:/bin:/usr/sbin:/sbin"
    export MINYAR_PREBUILT MINYAR_BUNDLED_CLANG MINYAR_CACHE_DIR PATH
fi
if [ "${SDKROOT+x}" != x ]; then
    discovered_sdk=$(sh "$project_dir/tools/toolchain.sh" sdkroot)
    if [ -n "$discovered_sdk" ]; then SDKROOT=$discovered_sdk; export SDKROOT; fi
fi
# Keep shell code limited to bootstrapping; project behavior lives in Minyar.
case "${1-}" in
    explain)
        shift
        MINYAR_INTERACTIVE_BOOTSTRAP=1 sh "$project_dir/tools/toolchain.sh" bootstrap "$project_dir" build/minyarc >&2
        exec "$project_dir/build/minyarc" --explain "$@" ;;
    fmt)
        shift
        MINYAR_INTERACTIVE_BOOTSTRAP=1 sh "$project_dir/tools/toolchain.sh" bootstrap "$project_dir" build/tooling/tools/format-cli >&2
        exec "$project_dir/build/tooling/tools/format-cli" "$@" ;;
    lsp)
        shift
        MINYAR_INTERACTIVE_BOOTSTRAP=1 sh "$project_dir/tools/toolchain.sh" bootstrap "$project_dir" build/tooling/tools/lsp-cli >&2
        MINYAR_PROJECT_DIR=$project_dir
        export MINYAR_PROJECT_DIR
        exec "$project_dir/build/tooling/tools/lsp-cli" "$@" ;;
    self|toolchain)
        exec sh "$project_dir/install/manager.sh" "$@" ;;
    registry)
        shift
        MINYAR_INTERACTIVE_BOOTSTRAP=1 sh "$project_dir/tools/toolchain.sh" bootstrap "$project_dir" build/tooling/tools/registry-cli
        exec "$project_dir/build/tooling/tools/registry-cli" "$@" ;;
    new|init|build|run|check|test|doc|clean|add|remove|tree|metadata|install|uninstall|search|info|publish|help)
        MINYAR_INTERACTIVE_BOOTSTRAP=1 sh "$project_dir/tools/toolchain.sh" bootstrap "$project_dir" build/tooling/tools/project-cli
        MINYAR_PROJECT_DIR=$project_dir
        export MINYAR_PROJECT_DIR
        exec "$project_dir/build/tooling/tools/project-cli" "$@" ;;
esac
if [ "${1-}" = land ]; then
    shift
    make -C "$project_dir" build/tooling/tools/land
    cd "$project_dir"
    exec "$project_dir/build/tooling/tools/land" "$@"
fi
# Swift interoperability experiments are a separate dialect, not a backend
# selection for Minyar. The LLVM compiler defines Minyar's language contract.
case "${1-}" in
    --experimental-swift|--experimental-swift-source)
        native_tool=native-frontend
        [ "$1" != --experimental-swift-source ] || native_tool=native-swift
        shift
        make -s -C "$project_dir" "build/tooling/scripts/$native_tool" >&2
        MINYAR_PROJECT_DIR=$project_dir
        export MINYAR_PROJECT_DIR
        exec "$project_dir/build/tooling/scripts/$native_tool" "$@" ;;
esac
if [ "${1-}" = --backend ]; then
    [ "$#" -ge 2 ] || { echo '--backend requires llvm' >&2; exit 2; }
    case "$2" in
        swift) echo 'The Swift source dialect is experimental; use --experimental-swift-source.' >&2; exit 2 ;;
        native) echo 'The Swift frontend dialect is experimental; use --experimental-swift.' >&2; exit 2 ;;
        llvm) shift 2 ;;
        *) echo "unknown backend: $2" >&2; exit 2 ;;
    esac
fi
usage() {
    echo "usage: ./minyar [--backend llvm] [--app] [--bundle-id ID] [--icon FILE.icns] [--resources DIR] [--check | --debug | --release] [--incremental] [--library DIR] [--error-format text|json] [--memory-profile eager|fixed|lazy|system] [--cleanup-budget 1..1024] [--heap-bytes BYTES] FILE.min [-o PROGRAM]" >&2
    echo "Swift dialect experiment: ./minyar --experimental-swift --help" >&2
    exit 2
}
case "${1-}" in
    --help|-h)
        cat <<'HELP'
usage: ./minyar [--backend llvm] [--check | --debug | --release] [--incremental] [OPTIONS] FILE.min [-o PROGRAM]

Project commands (implemented in Minyar):
  new, init, build, run, check, test, doc, clean, add, remove, tree, metadata,
  install, uninstall, search, info, publish, registry. Use ./minyar help for project options.

Toolchain commands: self update; toolchain install VERSION, list, current, default VERSION.
Source formatting: minyar fmt [--check | --stdout] [FILE.min | DIRECTORY ...].
Editor integration: minyar lsp --stdio.
Error explanations: minyar explain CODE; minyar explain --list.

Build a native program; the compiler and runtime build on first use.
  --backend llvm           Compile the Minyar language (default)
  --experimental-swift     Separate experimental Swift dialect and native ABI
  --experimental-swift-source  Older Swift source translation experiment
  --app                    Package a macOS application bundle
  --bundle-id ID           Bundle identifier for --app
  --icon FILE.icns         Application icon for --app
  --resources DIR          Copy DIR's contents into the --app bundle's Resources
  --check                  Check language and modules without native linking
  --doc-json               Print public source documentation as JSON
  --debug                  Disable optimization (-O0) and emit source line symbols
  --release                Optimize across the program and runtime with LTO
  --incremental            Reuse unchanged local module compilation
  --library DIR            Search DIR for packages before the standard ones
  --error-format FORMAT    Compiler diagnostics as text (default) or JSON lines
  --native-source NAME=FILE Compile a package's C or Objective-C source
  --native-object NAME=FILE Link a package's object file or static archive
  --memory-profile PROFILE system (default), eager, fixed, or lazy
  --cleanup-budget N       Reclamation work budget, 1..1024 (default: 32)
  --heap-bytes N           Power-of-two capacity for fixed/lazy heaps
  --doctor                 Check Clang, C headers, 64-bit target, opaque IR, and LTO
  --version                Show the development source/compiler identity
  --help                   Show this help

Programs are optimized with -O2 by default. MINYAR_CLANG selects Clang;
LLVM_CC also selects the Make toolchain. MINYAR_CLANG_FLAGS,
MINYAR_RUNTIME_FLAGS, and MINYAR_NATIVE_FLAGS accept quoted literal arguments.
HELP
        exit 0 ;;
    --version) exec sh "$project_dir/tools/toolchain.sh" version "$project_dir" ;;
    --doctor) exec sh "$project_dir/tools/toolchain.sh" doctor ;;
esac
positive_decimal() {
    case "$1" in ''|*[!0123456789]*) return 1 ;; esac
    normalized_decimal=$1
    normalized_decimal=${normalized_decimal#"${normalized_decimal%%[!0]*}"}
    [ -n "$normalized_decimal" ]
}
terminal_text() {
    printf '%s' "$1" | LC_ALL=C od -An -v -t u1 | LC_ALL=C awk '
function continuation(byte) { return byte >= 128 && byte <= 191 }
function unsafe(code) {
    return code < 32 || (code >= 127 && code <= 159) || code == 1564 || code == 8206 || code == 8207 || code == 8232 || code == 8233 || (code >= 8234 && code <= 8238) || (code >= 8294 && code <= 8297)
}
{
    for (field = 1; field <= NF; field += 1) { count += 1; bytes[count] = $field }
}
END {
    position = 1
    while (position <= count) {
        first = bytes[position] + 0
        width = 0
        code = -1
        if (first < 128) { width = 1; code = first }
        else if (first >= 194 && first <= 223 && position + 1 <= count && continuation(bytes[position + 1] + 0)) {
            width = 2
            code = (first - 192) * 64 + (bytes[position + 1] + 0) - 128
        } else if (first >= 224 && first <= 239 && position + 2 <= count && continuation(bytes[position + 1] + 0) && continuation(bytes[position + 2] + 0)) {
            second = bytes[position + 1] + 0
            if ((first != 224 || second >= 160) && (first != 237 || second <= 159)) {
                width = 3
                code = (first - 224) * 4096 + (second - 128) * 64 + (bytes[position + 2] + 0) - 128
            }
        } else if (first >= 240 && first <= 244 && position + 3 <= count && continuation(bytes[position + 1] + 0) && continuation(bytes[position + 2] + 0) && continuation(bytes[position + 3] + 0)) {
            second = bytes[position + 1] + 0
            if ((first != 240 || second >= 144) && (first != 244 || second <= 143)) {
                width = 4
                code = (first - 240) * 262144 + (second - 128) * 4096 + ((bytes[position + 2] + 0) - 128) * 64 + (bytes[position + 3] + 0) - 128
            }
        }
        if (code < 0) { printf "\\x%02x", first; position += 1 }
        else {
            if (unsafe(code)) { printf "\\u{%04x}", code }
            else { for (offset = 0; offset < width; offset += 1) { printf "%c", bytes[position + offset] + 0 } }
            position += width
        }
    }
}'
}

release=0
debug=0
check_only=0
optimization_requested=0
incremental=0
test_mode=0
list_tests=0
error_format=
doc_json=0
app=0
bundle_id=org.minyar.application
bundle_id_requested=0
icon_file=
resources_dir=
memory_profile=system
profile_requested=0
cleanup_budget=32
budget_requested=0
heap_bytes=
# Package directories from --library, searched before the standard ones.
libraries=
native_inputs=
while :; do
    case "${1-}" in
        --release) [ "$optimization_requested" -eq 0 ] && [ "$check_only" -eq 0 ] || usage; release=1; optimization_requested=1; shift ;;
        --debug) [ "$optimization_requested" -eq 0 ] && [ "$check_only" -eq 0 ] || usage; debug=1; optimization_requested=1; shift ;;
        --check) [ "$optimization_requested" -eq 0 ] && [ "$check_only" -eq 0 ] || usage; check_only=1; shift ;;
        --app) app=1; shift ;;
        --bundle-id)
            [ "$#" -ge 2 ] && [ "$bundle_id_requested" -eq 0 ] || usage
            bundle_id=$2; bundle_id_requested=1; shift 2 ;;
        --icon)
            [ "$#" -ge 2 ] && [ -z "$icon_file" ] && [ -n "$2" ] || usage
            icon_file=$2; shift 2 ;;
        --resources)
            [ "$#" -ge 2 ] && [ -z "$resources_dir" ] && [ -n "$2" ] || usage
            resources_dir=$2; shift 2 ;;
        --incremental) incremental=1; shift ;;
        --test-mode) test_mode=1; shift ;;
        --list-tests) list_tests=1; check_only=1; shift ;;
        --error-format)
            [ "$#" -ge 2 ] || usage
            case "$2" in text|json) error_format=$2 ;; *) usage ;; esac
            shift 2 ;;
        --doc-json) doc_json=1; check_only=1; shift ;;
        --library)
            [ "$#" -ge 2 ] && [ -d "$2" ] || usage
            libraries="$libraries
$2"; shift 2 ;;
        --native-source|--native-object)
            [ "$#" -ge 2 ] || usage
            case "$2" in *=*) ;; *) usage ;; esac
            native_name=${2%%=*}
            native_file=${2#*=}
            case "$native_name" in ''|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*) usage ;; esac
            [ -f "$native_file" ] && [ -r "$native_file" ] || {
                printf 'minyar: cannot read native input: ' >&2
                terminal_text "$native_file" >&2
                printf '\n' >&2
                exit 1
            }
            native_inputs="$native_inputs
$1
$2"; shift 2 ;;
        --memory-profile)
            [ "$#" -ge 2 ] && [ "$profile_requested" -eq 0 ] || usage
            case "$2" in eager|fixed|lazy|system) memory_profile=$2 ;; *) usage ;; esac
            profile_requested=1; shift 2 ;;
        --cleanup-budget)
            [ "$#" -ge 2 ] && [ "$budget_requested" -eq 0 ] || usage
            positive_decimal "$2" || usage
            [ "${#normalized_decimal}" -le 4 ] && [ "$normalized_decimal" -le 1024 ] || usage
            cleanup_budget=$normalized_decimal; budget_requested=1; shift 2 ;;
        --heap-bytes)
            [ "$#" -ge 2 ] && [ -z "$heap_bytes" ] || usage
            positive_decimal "$2" || usage
            # Supported 64-bit runtime: the largest power of two below
            # SIZE_MAX/2 is 2^62. Range-check before shell arithmetic.
            [ "${#normalized_decimal}" -le 19 ] || usage
            [ "$normalized_decimal" -ge 4096 ] 2>/dev/null &&
                [ "$normalized_decimal" -le 4611686018427387904 ] 2>/dev/null || usage
            [ "$((normalized_decimal & (normalized_decimal - 1)))" -eq 0 ] || usage
            heap_bytes=$normalized_decimal; shift 2 ;;
        *) break ;;
    esac
done
if [ "$check_only" -eq 1 ] && [ -n "$native_inputs" ]; then usage; fi
if [ "$memory_profile" = eager ] && [ "$budget_requested" -ne 0 ]; then usage; fi
if [ -n "$heap_bytes" ]; then
    case "$memory_profile" in fixed|lazy) ;; *) usage ;; esac
fi
[ "$#" -ge 1 ] && [ "$#" -le 3 ] || usage
case "$1" in --*) usage ;; esac
source_file=$1
shift
output_file=$(basename -- "${source_file%.min}")
if [ "$#" -gt 0 ]; then
    [ "$check_only" -eq 0 ] && [ "$#" -eq 2 ] && [ "$1" = -o ] || usage
    output_file=$2
fi
[ -f "$source_file" ] && [ -r "$source_file" ] || {
    printf 'minyar: cannot read source file: ' >&2
    terminal_text "$source_file" >&2
    printf '\n' >&2
    exit 1
}
if [ "$check_only" -eq 0 ] && [ "$source_file" -ef "$output_file" ]; then
    printf 'minyar: refusing to replace the source file; choose a different -o path: ' >&2
    terminal_text "$output_file" >&2
    printf '\n' >&2
    exit 1
fi

if [ "$app" -eq 1 ]; then
    [ "$check_only" -eq 0 ] || usage
    [ "$(uname -s)" = Darwin ] || { echo "macOS app bundles require macOS" >&2; exit 1; }
    case "$output_file" in *.app) ;; *) output_file="$output_file.app" ;; esac
elif [ "$bundle_id_requested" -eq 1 ] || [ -n "$icon_file" ] || [ -n "$resources_dir" ]; then
    usage
fi

if [ "$test_mode" -eq 1 ] || [ "$list_tests" -eq 1 ] || [ "$doc_json" -eq 1 ]; then incremental=0; fi
if [ "$incremental" -eq 1 ]; then
    case "$(uname -s)" in
        MSYS*|MINGW*|CYGWIN*)
            echo "incremental module caching currently needs macOS or Linux; omit --incremental on Windows" >&2
            exit 1 ;;
    esac
    set -- build/minyarc-modules build/minyar-module-build
else
    set -- build/minyarc
fi
configured_runtime=1
if [ "$check_only" -eq 1 ]; then
    configured_runtime=0
elif [ "$memory_profile" = eager ]; then
    configured_runtime=0
    if [ "$release" -eq 1 ]; then runtime_file=build/minyar-runtime-eager-release.ll
    else runtime_file=build/minyar-runtime-eager.o; fi
    set -- "$@" "$runtime_file"
    runtime_file="$project_dir/$runtime_file"
elif [ "$memory_profile" = system ] && [ "$cleanup_budget" -eq 32 ] &&
     [ "${MINYAR_CLANG+x}" != x ] && [ "${MINYAR_RUNTIME_FLAGS+x}" != x ]; then
    configured_runtime=0
    if [ "$release" -eq 1 ]; then runtime_file=build/minyar-default-runtime-release.ll
    else runtime_file=build/minyar-default-runtime.o; fi
    set -- "$@" "$runtime_file"
    runtime_file="$project_dir/$runtime_file"
else
    for header in minyar_runtime.c minyar_rc.h minyar_heap.h minyar_pool.h minyar_bounded_rc.h; do
        [ -f "$project_dir/runtime/$header" ] || { echo "missing runtime source: $header" >&2; exit 1; }
    done
    if [ "$cleanup_budget" -gt 1 ]; then
        [ -f "$project_dir/runtime/minyar_stack_frames.h" ] || { echo "missing stack ownership runtime" >&2; exit 1; }
    fi
fi
driver="$project_dir/build/tooling/tools/clang-driver"
if [ "$check_only" -eq 0 ]; then set -- "$@" build/tooling/tools/clang-driver; fi
# Interactive first-use builds keep resource caps and low CPU priority, while
# avoiding the macOS background scheduling class used by bulk development.
if [ "$list_tests" -eq 1 ] || [ "$doc_json" -eq 1 ]; then
    MINYAR_INTERACTIVE_BOOTSTRAP=1 sh "$project_dir/tools/toolchain.sh" bootstrap "$project_dir" "$@" >&2
else
    MINYAR_INTERACTIVE_BOOTSTRAP=1 sh "$project_dir/tools/toolchain.sh" bootstrap "$project_dir" "$@"
fi
cache_dir=${MINYAR_CACHE_DIR:-$project_dir/build}
mkdir -p "$cache_dir/programs"
llvm_dir=$(mktemp -d "$cache_dir/programs/invocation.XXXXXXXX")
trap 'rm -rf -- "$llvm_dir"' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
llvm_file="$llvm_dir/program.ll"
set --
if [ "$test_mode" -eq 1 ]; then set -- "$@" --test-mode; fi
if [ "$list_tests" -eq 1 ]; then set -- "$@" --list-tests; fi
if [ "$doc_json" -eq 1 ]; then set -- "$@" --doc-json; fi
if [ "$memory_profile" != eager ]; then set -- "$@" --bounded-owners "$cleanup_budget"; fi
# The first directory holding a package wins: --library directories, then on
# macOS the platform packages (such as the NSURLSession http), then the rest.
old_ifs=$IFS
IFS='
'
set -f
for library in $libraries; do set -- "$@" --library "$library"; done
set +f
IFS=$old_ifs
if [ "$(uname -s)" = Darwin ]; then set -- "$@" --library "$project_dir/library/platform/macos"; fi
set -- "$@" --library "$project_dir/library"
if [ -n "$error_format" ]; then set -- "$@" --error-format "$error_format"; fi
compiler_status=0
primary_stderr="$llvm_dir/primary.stderr"
if [ "$incremental" -eq 1 ]; then
    "$project_dir/build/minyar-module-build" "$project_dir/build/minyarc-modules" \
        "$source_file" "$llvm_file" "${MINYAR_MODULE_CACHE:-$cache_dir/module-cache}" "$@" 2>"$primary_stderr" || compiler_status=$?
else
    "$project_dir/build/minyarc" "$source_file" "$llvm_file" "$@" 2>"$primary_stderr" || compiler_status=$?
fi
cat "$primary_stderr" >&2
if [ "$compiler_status" -ne 0 ]; then exit "$compiler_status"; fi
if [ "$list_tests" -eq 1 ] || [ "$doc_json" -eq 1 ]; then cat "$llvm_file"; exit 0; fi
if [ "$check_only" -eq 1 ]; then
    printf 'checked '
    terminal_text "$source_file"
    printf '\n'
    exit 0
fi

if [ "$configured_runtime" -eq 1 ]; then
    runtime_source="$llvm_dir/runtime.c"
    # Configuration follows command-line preprocessing, so -D/-U options in
    # custom runtime flags cannot change the selected memory policy silently.
    cat > "$runtime_source" <<'CONFIG'
#undef MINYAR_COMPILER_ARENA
#undef MINYAR_SYSTEM_HEAP
#undef MINYAR_BOUNDED_HEAP
#undef MINYAR_LAZY_HEAP
#undef MINYAR_BOUNDED_RC
#undef MINYAR_RC_POLL_BUDGET
#undef MINYAR_BOUNDED_HEAP_BYTES
_Static_assert(sizeof(void *) == 8, "configured memory profiles require a 64-bit target");
CONFIG
    case "$memory_profile" in
        fixed) printf '#define MINYAR_BOUNDED_HEAP 1\n' >> "$runtime_source" ;;
        lazy) printf '#define MINYAR_BOUNDED_HEAP 1\n#define MINYAR_LAZY_HEAP 1\n' >> "$runtime_source" ;;
        system) printf '#define MINYAR_SYSTEM_HEAP 1\n' >> "$runtime_source" ;;
    esac
    printf '#define MINYAR_RC_POLL_BUDGET %s\n' "$cleanup_budget" >> "$runtime_source"
    if [ -n "$heap_bytes" ]; then
        printf '#define MINYAR_BOUNDED_HEAP_BYTES %sULL\n' "$heap_bytes" >> "$runtime_source"
    fi
    printf '#include "minyar_runtime.c"\n' >> "$runtime_source"
    if [ "$cleanup_budget" -gt 1 ]; then
        printf '#include "minyar_stack_frames.h"\n' >> "$runtime_source"
    fi
    if [ "$release" -eq 1 ] && [ "$("$driver" runtime-format)" = llvm ]; then
        runtime_file="$llvm_dir/runtime.ll"
        "$driver" compile -iquote "$project_dir/runtime" \
            -S -emit-llvm "$runtime_source" -o "$llvm_dir/runtime.raw.ll"
        sed -E 's/"(target-cpu|target-features|tune-cpu)"="[^"]*" ?//g' "$llvm_dir/runtime.raw.ll" > "$runtime_file"
    else
        runtime_file="$llvm_dir/runtime.o"
        "$driver" compile -iquote "$project_dir/runtime" \
            -c "$runtime_source" -o "$runtime_file"
    fi
fi
binary_file=$output_file
if [ "$app" -eq 1 ]; then binary_file="$llvm_dir/application"; fi
set -- link "$project_dir" "$llvm_file" "$runtime_file" "$binary_file" "$release" "$debug" "$source_file"
old_ifs=$IFS
IFS='
'
set -f
for native_input in $native_inputs; do set -- "$@" "$native_input"; done
set +f
IFS=$old_ifs
"$driver" "$@"
if [ "$app" -eq 1 ]; then
    set -- --binary "$binary_file" --output "$output_file" --identifier "$bundle_id"
    if [ -n "$icon_file" ]; then set -- "$@" --icon "$icon_file"; fi
    if [ -n "$resources_dir" ]; then set -- "$@" --resources "$resources_dir"; fi
    sh "$project_dir/tools/toolchain.sh" bootstrap "$project_dir" build/tooling/scripts/macos-app
    "$project_dir/build/tooling/scripts/macos-app" "$@"
fi
printf 'built '
terminal_text "$output_file"
printf '\n'
