#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# The experimental native target has a separate type system and compiler
# driver. Dispatch before building or linking the portable Minyar runtime.
if [ "${1-}" = --backend ]; then
    [ "$#" -ge 2 ] || { echo '--backend requires llvm, swift or native' >&2; exit 2; }
    case "$2" in
        swift) shift 2; exec "${MINYAR_PYTHON:-/usr/bin/python3}" "$project_dir/scripts/native-swift.py" "$@" ;;
        native) shift 2; exec "${MINYAR_PYTHON:-/usr/bin/python3}" "$project_dir/scripts/native-frontend.py" "$@" ;;
        llvm) shift 2 ;;
        *) echo "unknown backend: $2" >&2; exit 2 ;;
    esac
fi
usage() {
    echo "usage: ./minyar [--backend llvm|swift|native] [--app] [--bundle-id ID] [--icon FILE.icns] [--resources DIR] [--check | --debug | --release] [--incremental] [--library DIR] [--memory-profile eager|fixed|lazy|system] [--cleanup-budget 1..1024] [--heap-bytes BYTES] FILE.min [-o PROGRAM]" >&2
    echo "native SwiftUI options: ./minyar --backend swift --help" >&2
    exit 2
}
case "${1-}" in
    --help|-h)
        cat <<'HELP'
usage: ./minyar [--backend llvm|swift|native] [--check | --debug | --release] [--incremental] [OPTIONS] FILE.min [-o PROGRAM]

Build a native program; the compiler and runtime build on first use.
  --backend BACKEND        llvm (default), swift, or experimental native frontend
  --app                    Package a macOS application bundle
  --bundle-id ID           Bundle identifier for --app
  --icon FILE.icns         Application icon for --app
  --resources DIR          Copy DIR's contents into the --app bundle's Resources
  --check                  Check language and modules without native linking
  --debug                  Disable program optimization (-O0)
  --release                Optimize across the program and runtime with LTO
  --incremental            Reuse unchanged local module compilation
  --library DIR            Search DIR for packages before the standard ones
  --memory-profile PROFILE system (default), eager, fixed, or lazy
  --cleanup-budget N       Reclamation work budget, 1..1024 (default: 32)
  --heap-bytes N           Power-of-two capacity for fixed/lazy heaps
  --doctor                 Check Clang, C headers, 64-bit target, opaque IR, and LTO
  --version                Show the development source/compiler identity
  --help                   Show this help

Programs are optimized with -O2 by default. MINYAR_CLANG selects Clang;
LLVM_CC also selects the Make toolchain. MINYAR_CLANG_FLAGS,
MINYAR_RUNTIME_FLAGS, and MINYAR_NATIVE_FLAGS accept quoted literal arguments.
HELP
        exit 0 ;;
    --version) exec python3 "$project_dir/tools/clang-driver.py" version "$project_dir" ;;
    --doctor) exec python3 "$project_dir/tools/clang-driver.py" doctor ;;
esac
positive_decimal() {
    case "$1" in ''|*[!0123456789]*) return 1 ;; esac
    normalized_decimal=$1
    normalized_decimal=${normalized_decimal#"${normalized_decimal%%[!0]*}"}
    [ -n "$normalized_decimal" ]
}

release=0
debug=0
check_only=0
optimization_requested=0
incremental=0
app=0
bundle_id=org.minyar.application
bundle_id_requested=0
icon_file=
resources_dir=
memory_profile=system
profile_requested=0
cleanup_budget=32
budget_requested=0
heap_bytes=
# Package directories from --library, searched before the standard ones.
libraries=
while :; do
    case "${1-}" in
        --release) [ "$optimization_requested" -eq 0 ] && [ "$check_only" -eq 0 ] || usage; release=1; optimization_requested=1; shift ;;
        --debug) [ "$optimization_requested" -eq 0 ] && [ "$check_only" -eq 0 ] || usage; debug=1; optimization_requested=1; shift ;;
        --check) [ "$optimization_requested" -eq 0 ] && [ "$check_only" -eq 0 ] || usage; check_only=1; shift ;;
        --app) app=1; shift ;;
        --bundle-id)
            [ "$#" -ge 2 ] && [ "$bundle_id_requested" -eq 0 ] || usage
            bundle_id=$2; bundle_id_requested=1; shift 2 ;;
        --icon)
            [ "$#" -ge 2 ] && [ -z "$icon_file" ] && [ -n "$2" ] || usage
            icon_file=$2; shift 2 ;;
        --resources)
            [ "$#" -ge 2 ] && [ -z "$resources_dir" ] && [ -n "$2" ] || usage
            resources_dir=$2; shift 2 ;;
        --incremental) incremental=1; shift ;;
        --library)
            [ "$#" -ge 2 ] && [ -d "$2" ] || usage
            libraries="$libraries
$2"; shift 2 ;;
        --memory-profile)
            [ "$#" -ge 2 ] && [ "$profile_requested" -eq 0 ] || usage
            case "$2" in eager|fixed|lazy|system) memory_profile=$2 ;; *) usage ;; esac
            profile_requested=1; shift 2 ;;
        --cleanup-budget)
            [ "$#" -ge 2 ] && [ "$budget_requested" -eq 0 ] || usage
            positive_decimal "$2" || usage
            [ "${#normalized_decimal}" -le 4 ] && [ "$normalized_decimal" -le 1024 ] || usage
            cleanup_budget=$normalized_decimal; budget_requested=1; shift 2 ;;
        --heap-bytes)
            [ "$#" -ge 2 ] && [ -z "$heap_bytes" ] || usage
            positive_decimal "$2" || usage
            # Supported 64-bit runtime: the largest power of two below
            # SIZE_MAX/2 is 2^62. Range-check before shell arithmetic.
            [ "${#normalized_decimal}" -le 19 ] || usage
            [ "$normalized_decimal" -ge 4096 ] 2>/dev/null &&
                [ "$normalized_decimal" -le 4611686018427387904 ] 2>/dev/null || usage
            [ "$((normalized_decimal & (normalized_decimal - 1)))" -eq 0 ] || usage
            heap_bytes=$normalized_decimal; shift 2 ;;
        *) break ;;
    esac
done
if [ "$memory_profile" = eager ] && [ "$budget_requested" -ne 0 ]; then usage; fi
if [ -n "$heap_bytes" ]; then
    case "$memory_profile" in fixed|lazy) ;; *) usage ;; esac
fi
[ "$#" -ge 1 ] && [ "$#" -le 3 ] || usage
case "$1" in --*) usage ;; esac
source_file=$1
shift
output_file=$(basename -- "${source_file%.min}")
if [ "$#" -gt 0 ]; then
    [ "$check_only" -eq 0 ] && [ "$#" -eq 2 ] && [ "$1" = -o ] || usage
    output_file=$2
fi
[ -f "$source_file" ] && [ -r "$source_file" ] || {
    echo "minyar: cannot read source file: $source_file" >&2
    exit 1
}
if [ "$check_only" -eq 0 ] && [ "$source_file" -ef "$output_file" ]; then
    echo "minyar: refusing to replace the source file; choose a different -o path: $output_file" >&2
    exit 1
fi

if [ "$app" -eq 1 ]; then
    [ "$check_only" -eq 0 ] || usage
    [ "$(uname -s)" = Darwin ] || { echo "macOS app bundles require macOS" >&2; exit 1; }
    case "$output_file" in *.app) ;; *) output_file="$output_file.app" ;; esac
elif [ "$bundle_id_requested" -eq 1 ] || [ -n "$icon_file" ] || [ -n "$resources_dir" ]; then
    usage
fi

if [ "$incremental" -eq 1 ]; then
    case "$(uname -s)" in
        MSYS*|MINGW*|CYGWIN*)
            echo "incremental module caching currently needs macOS or Linux; omit --incremental on Windows" >&2
            exit 1 ;;
    esac
    set -- build/minyarc-modules build/minyar-module-build
else
    set -- build/minyarc
fi
configured_runtime=1
if [ "$check_only" -eq 1 ]; then
    configured_runtime=0
elif [ "$memory_profile" = eager ]; then
    configured_runtime=0
    if [ "$release" -eq 1 ]; then runtime_file=build/minyar-runtime-eager-release.ll
    else runtime_file=build/minyar-runtime-eager.o; fi
    set -- "$@" "$runtime_file"
    runtime_file="$project_dir/$runtime_file"
elif [ "$memory_profile" = system ] && [ "$cleanup_budget" -eq 32 ] &&
     [ "${MINYAR_CLANG+x}" != x ] && [ "${MINYAR_RUNTIME_FLAGS+x}" != x ]; then
    configured_runtime=0
    if [ "$release" -eq 1 ]; then runtime_file=build/minyar-default-runtime-release.ll
    else runtime_file=build/minyar-default-runtime.o; fi
    set -- "$@" "$runtime_file"
    runtime_file="$project_dir/$runtime_file"
else
    for header in minyar_runtime.c minyar_rc.h minyar_heap.h minyar_pool.h minyar_bounded_rc.h; do
        [ -f "$project_dir/runtime/$header" ] || { echo "missing runtime source: $header" >&2; exit 1; }
    done
    if [ "$cleanup_budget" -gt 1 ]; then
        [ -f "$project_dir/runtime/minyar_stack_frames.h" ] || { echo "missing stack ownership runtime" >&2; exit 1; }
    fi
fi
command -v python3 >/dev/null 2>&1 || { echo "minyar needs Python 3 for portable toolchain arguments" >&2; exit 1; }
# Interactive first-use builds keep resource caps and low CPU priority, while
# avoiding the macOS background scheduling class used by bulk development.
MINYAR_INTERACTIVE_BOOTSTRAP=1 python3 "$project_dir/tools/clang-driver.py" build "$project_dir" "$@"
mkdir -p "$project_dir/build/programs"
llvm_dir=$(mktemp -d "$project_dir/build/programs/invocation.XXXXXXXX")
trap 'rm -rf -- "$llvm_dir"' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
llvm_file="$llvm_dir/program.ll"
set --
if [ "$memory_profile" != eager ]; then set -- --bounded-owners "$cleanup_budget"; fi
# The first directory holding a package wins: --library directories, then on
# macOS the platform packages (such as the NSURLSession http), then the rest.
old_ifs=$IFS
IFS='
'
set -f
for library in $libraries; do set -- "$@" --library "$library"; done
set +f
IFS=$old_ifs
if [ "$(uname -s)" = Darwin ]; then set -- "$@" --library "$project_dir/library/platform/macos"; fi
set -- "$@" --library "$project_dir/library"
compiler_status=0
if [ "$incremental" -eq 1 ]; then
    "$project_dir/build/minyar-module-build" "$project_dir/build/minyarc-modules" \
        "$source_file" "$llvm_file" "${MINYAR_MODULE_CACHE:-$project_dir/build/module-cache}" "$@" || compiler_status=$?
else
    "$project_dir/build/minyarc" "$source_file" "$llvm_file" "$@" || compiler_status=$?
fi
if [ "$compiler_status" -eq 86 ]; then
    # The parser requests this extension only after recognizing valid callable
    # syntax. Its generated source reuses the current core parser and emitter.
    MINYAR_INTERACTIVE_BOOTSTRAP=1 python3 "$project_dir/tools/clang-driver.py" build "$project_dir" build/minyarc-callbacks
    "$project_dir/build/minyarc-callbacks" "$source_file" "$llvm_file" "$@"
elif [ "$compiler_status" -ne 0 ]; then
    exit "$compiler_status"
fi
if [ "$check_only" -eq 1 ]; then
    echo "checked $source_file"
    exit 0
fi

if [ "$configured_runtime" -eq 1 ]; then
    runtime_source="$llvm_dir/runtime.c"
    # Configuration follows command-line preprocessing, so -D/-U options in
    # custom runtime flags cannot change the selected memory policy silently.
    cat > "$runtime_source" <<'CONFIG'
#undef MINYAR_COMPILER_ARENA
#undef MINYAR_SYSTEM_HEAP
#undef MINYAR_BOUNDED_HEAP
#undef MINYAR_LAZY_HEAP
#undef MINYAR_BOUNDED_RC
#undef MINYAR_RC_POLL_BUDGET
#undef MINYAR_BOUNDED_HEAP_BYTES
_Static_assert(sizeof(void *) == 8, "configured memory profiles require a 64-bit target");
CONFIG
    case "$memory_profile" in
        fixed) printf '#define MINYAR_BOUNDED_HEAP 1\n' >> "$runtime_source" ;;
        lazy) printf '#define MINYAR_BOUNDED_HEAP 1\n#define MINYAR_LAZY_HEAP 1\n' >> "$runtime_source" ;;
        system) printf '#define MINYAR_SYSTEM_HEAP 1\n' >> "$runtime_source" ;;
    esac
    printf '#define MINYAR_RC_POLL_BUDGET %s\n' "$cleanup_budget" >> "$runtime_source"
    if [ -n "$heap_bytes" ]; then
        printf '#define MINYAR_BOUNDED_HEAP_BYTES %sULL\n' "$heap_bytes" >> "$runtime_source"
    fi
    printf '#include "minyar_runtime.c"\n' >> "$runtime_source"
    if [ "$cleanup_budget" -gt 1 ]; then
        printf '#include "minyar_stack_frames.h"\n' >> "$runtime_source"
    fi
    if [ "$release" -eq 1 ]; then
        runtime_file="$llvm_dir/runtime.ll"
        python3 "$project_dir/tools/clang-driver.py" compile -iquote "$project_dir/runtime" \
            -S -emit-llvm "$runtime_source" -o "$llvm_dir/runtime.raw.ll"
        sed -E 's/"(target-cpu|target-features|tune-cpu)"="[^"]*" ?//g' "$llvm_dir/runtime.raw.ll" > "$runtime_file"
    else
        runtime_file="$llvm_dir/runtime.o"
        python3 "$project_dir/tools/clang-driver.py" compile -iquote "$project_dir/runtime" \
            -c "$runtime_source" -o "$runtime_file"
    fi
fi
binary_file=$output_file
if [ "$app" -eq 1 ]; then binary_file="$llvm_dir/application"; fi
python3 "$project_dir/tools/clang-driver.py" link "$project_dir" "$llvm_file" "$runtime_file" "$binary_file" "$release" "$debug" "$source_file"
if [ "$app" -eq 1 ]; then
    set -- --binary "$binary_file" --output "$output_file" --identifier "$bundle_id"
    if [ -n "$icon_file" ]; then set -- "$@" --icon "$icon_file"; fi
    if [ -n "$resources_dir" ]; then set -- "$@" --resources "$resources_dir"; fi
    "${MINYAR_PYTHON:-/usr/bin/python3}" "$project_dir/scripts/macos-app.py" "$@"
fi
echo "built $output_file"
