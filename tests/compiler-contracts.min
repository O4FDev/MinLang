use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "system" as system
function selected(name: Text): Boolean {
    if processInfo.argumentCount() == 0 { return true }
    for index in 0..processInfo.argumentCount() { if processInfo.argument(index) == name || processInfo.argument(index) == "CompilerContracts." + name { return true } }
    return false
}
function prefix(source: Text): Text {
    let raw = Bytes(source)
    let marker = Bytes("\nfunction main(")
    for start in 0..(raw.length - marker.length + 1) {
        let equal = true
        for index in 0..marker.length { if raw[start + index] != marker[index] { equal = false; break } }
        if equal { return Text(raw.slice(0, start)) }
    }
    return source
}
let work = test.scratch()
let compiler = test.setting("MINYAR_TEST_COMPILER", "./build/minyarc")
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let original = io.readTextFile(test.setting("MINYAR_TEST_SOURCE", test.setting("MINYAR_TEST_COMPILER_SOURCE", "build/compiler.min")))
let probe = "\nfunction main() {\n    let mode = processInfo.argument(0)\n    if mode == \"nested-reference\" {\n        let cases: List<Text> = [\"(\\n value\\n)\", \"[\\n value\\n]\", \"{\\n value\\n}\", \"other\\nvalue\", \"(\\n other\\n)\\nvalue\", \"[\\n other\\n]\\nvalue\", \"[other] + value\", \"{other} + value\", \"{other\\nvalue}\"]\n        let index = 0\n        while index < cases.length {\n            let kinds: List<Integer> = []\n            let texts: List<Text> = []\n            let locations = newSourceMap()\n            tokenize(cases[index], kinds, texts, locations)\n            print(nameInStatement(kinds, texts, 0, \"value\"))\n            index = index + 1\n        }\n    } else if mode == \"module-type\" {\n        let fields: List<Text> = [\"9223372036854775807\"]\n        let cursor: List<Integer> = [0]\n        print(takeModuleType(fields, cursor))\n        print(cursor[0])\n    } else if mode == \"module-overflow\" {\n        let fields: List<Text> = [\"9223372036854775808\"]\n        let cursor: List<Integer> = [0]\n        print(takeModuleType(fields, cursor))\n    } else if mode == \"result-limit\" {\n        let successes: List<Text> = []\n        let errors: List<Text> = []\n        let index = 0\n        while index < 4095 {\n            successes.add(\"shape\" + Text(index))\n            errors.add(\"Integer\")\n            index = index + 1\n        }\n        print(internResultType(\"last\", \"Integer\", successes, errors))\n        print(internResultType(\"shape0\", \"Integer\", successes, errors))\n        print(successes.length)\n        print(internResultType(\"overflow\", \"Integer\", successes, errors))\n    }\n}\n"
let source = work + "/contracts.min"
let llvm = work + "/contracts.ll"
let binary = work + "/contracts"
io.writeTextFile(source, test.sourceModules(prefix(original) + probe))
test.require(test.run([compiler, source, llvm, "--library", "library"], system.environment(), "", work + "/compile", 30), "compile internal compiler contracts")
test.require(test.run([clang, "-O1", "-Wno-override-module", llvm, test.setting("MINYAR_COMPILER_RUNTIME_LL", "build/minyar-compiler-runtime.ll"), "-lm", "-o", binary], system.environment(), "", work + "/link", 30), "link internal compiler contracts")
let allowed = ["test_nested_reference_scan_crosses_only_nested_line_breaks", "test_module_integer_codec_accepts_maximum_and_rejects_overflow", "test_result_interning_reuses_existing_types_at_limit"]
for index in 0..processInfo.argumentCount() {
    let valid = false
    for name in allowed { if processInfo.argument(index) == name || processInfo.argument(index) == "CompilerContracts." + name { valid = true } }
    test.check(valid, "unknown compiler contract case " + processInfo.argument(index))
}
if selected("test_nested_reference_scan_crosses_only_nested_line_breaks") {
    let result = test.run([binary, "nested-reference"], system.environment(), "", work + "/run", 10)
    test.check(result.status == 0 && result.output == "true\ntrue\ntrue\nfalse\nfalse\nfalse\ntrue\ntrue\ntrue\n" && result.errorOutput == "", "nested reference statement boundary contract")
}
if selected("test_module_integer_codec_accepts_maximum_and_rejects_overflow") {
    let result = test.run([binary, "module-type"], system.environment(), "", work + "/run", 10)
    test.check(result.status == 0 && result.output == "9223372036854775807\n1\n" && result.errorOutput == "", "module integer maximum contract")
    result = test.run([binary, "module-overflow"], system.environment(), "", work + "/run", 10)
    test.check(result.status == 1 && result.output == "" && test.sameDiagnostic(result.errorOutput, "Minyar stopped: invalid compiled module type table\n"), "module integer overflow contract")
}
if selected("test_result_interning_reuses_existing_types_at_limit") {
    let result = test.run([binary, "result-limit"], system.environment(), "", work + "/run", 10)
    test.check(result.status == 1 && result.output == "minyar_result_type_4095\nminyar_result_type_0\n4096\n" && test.sameDiagnostic(result.errorOutput, "Minyar stopped: too many Result instantiations\n"), "Result type interning hard limit contract")
}
test.removeTree(work)
print("Compiler internal contracts: passed")
