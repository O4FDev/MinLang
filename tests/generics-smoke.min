use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let identity = "function identity<Item>(value: Item): Item { return value }\n"
fixtures.executes(frontend, identity + "print(identity(42))\nprint(identity(\"harbour\"))\nprint(identity<Integer>(7))\nif identity(\"{\") == \"{\" { print(identity(\"true\")) }\n", "42\nharbour\n7\ntrue\n", ["-O0", "-O2"], 0, "", false)
let llvm = io.readTextFile(frontend.compiler.directory + "/case" + Text(frontend.compiler.serial) + ".ll")
test.check(test.contains(llvm, "define i64 @.minyar.fn.minyar_generic_function_"), "generic Integer uses a native signature")
test.check(test.contains(llvm, "define ptr @.minyar.fn.minyar_generic_function_"), "generic Text uses a native signature")
fixtures.rejects(frontend, "function choose<Item>(left: Item, right: Item): Item { return left }\nprint(choose(1, \"two\"))\n", "type argument 'Item' is used inconsistently", true)
fixtures.executes(frontend, "record Pair<First, Second> { first: First; second: Second }\nlet pairs: List<Pair<Text, Integer>> = [Pair { first: \"tide\"; second: 42 }]\nprint(pairs[0].first)\nprint(pairs[0].second)\n", "tide\n42\n", ["-O0", "-O2"], 0, "", false)
test.removeTree(frontend.compiler.directory)
print("Generic smoke: passed")
