use "quic" as quic
use "tlstickets" as tickets
use "errors" as errors
use "quiccrypto" as protection
use "quicwire" as wire

function drive(c: quic.Connection, s: quic.Connection, now: Integer) {
    for packet in quic.poll(c, now) { quic.receive(s, packet, now) }
    for packet in quic.poll(s, now) { quic.receive(c, packet, now) }
}
function finishedOrdering(root: Bytes, identity: Bytes, key: Bytes, client: Bytes, clientKey: Bytes): Integer {
    for mode in 0..6 {
        let current = tickets.store(randomBytes(16), 3600); tickets.allowEarlyData(current, 0xffffffff)
        let initial = quic.client("localhost", randomBytes(80), "minyar-test", [root], [client], clientKey)
        let issuer = quic.serverWithTickets(randomBytes(80), "minyar-test", initial.originalDestination, [identity], key, [root], true, current)
        for tick in 0..100 { drive(initial, issuer, tick * 10) }
        let ticket = quic.takeTicket(initial)
        if !ticket.valid { return 20 }
        let early = quic.clientEarly("localhost", randomBytes(80), "minyar-test", [root], [client], clientKey, ticket)
        let peer = quic.serverWithTickets(randomBytes(80), "minyar-test", early.originalDestination, [identity], key, [root], true, current)
        for request in 0..4 {
            let id = errors.integerValue(quic.openEarlyStream(early, false))
            if !errors.integerOk(quic.writeEarlyStream(early, id, Bytes("x"), true)) { return 20 }
        }
        // Send ClientHello while retaining the real early-request queue.
        let queued = early.pending; early.pending = []
        for pending in queued { if pending.level == 0 { early.pending.add(pending) } }
        for packet in quic.poll(early, 0) { quic.receive(peer, packet, 0) }
        for pending in queued { if pending.level == 3 { early.pending.add(pending) } }
        for packet in quic.poll(peer, 1) { quic.receive(early, packet, 1) }
        if early.state != quic.ESTABLISHED || peer.state != quic.STARTING || !early.clientTLS.earlyAccepted || early.earlyPackets != 0 { print("Finished ordering setup"); return 21 }
        let handshakes = 0; let requests = 0; let first = -1
        for at in 0..early.pending.length {
            let pending = early.pending[at]
            if pending.level == 1 { handshakes += 1 }
            if pending.level == 3 { requests += 1; if first < 0 { first = at } }
        }
        if handshakes == 0 || requests != 4 || first < 0 { return 21 }
        early.paceAt = 2; early.paceCredit = Float(early.congestion.window)
        if mode == 1 {
            // Enough credit for one small request, but not client Finished.
            early.paceCredit = Float(early.remote.length + 21 + early.pending[first].payload.length)
        }
        if mode == 5 { early.congestion.window = early.remote.length + 21 + early.pending[first].payload.length + early.flight }
        if mode == 2 { early.spaces[1].write = protection.traffic(1, 0, Bytes()) }
        if mode == 3 { early.spaces[1].active = false }
        if mode == 4 { for pending in early.pending { if pending.level == 1 { pending.path = 999 } } }
        let firstPacket = early.spaces[2].next
        let packets = quic.poll(early, 2); let application = 0; let handshakeSeen = false
        for packet in packets {
            if (packet[0] & 128) == 0 {
                if mode == 0 && !handshakeSeen { print("application preceded client Finished"); return 22 }
                if mode == 1 || mode == 5 { print("application consumed blocked Finished credit"); return 23 }
            } else if ((packet[0] >> 4) & 3) == 2 { handshakeSeen = true }
            if mode == 0 { quic.receive(peer, packet, 2) }
        }
        for sent in early.spaces[2].sent {
            if sent.number >= firstPacket {
                for frame in wire.frames(sent.payload).frames {
                    if frame.type >= 8 && frame.type <= 15 && frame.stream < 16 { application += 1 }
                }
            }
        }
        if mode == 0 {
            if !handshakeSeen || application != 4 || peer.state != quic.ESTABLISHED { return 24 }
            for id in 0..4 {
                if Text(errors.bytesValue(quic.readStream(peer, id * 4))) != "x" { return 24 }
            }
        }
        if mode == 1 || mode == 5 {
            let retainedHandshake = false; let retainedRequests = 0
            for pending in early.pending {
                if pending.level == 1 { retainedHandshake = true }
                if pending.level == 2 || pending.level == 3 {
                    for frame in wire.frames(pending.payload).frames {
                        if frame.type >= 8 && frame.type <= 15 && frame.stream < 16 { retainedRequests += 1 }
                    }
                }
            }
            if !retainedHandshake || retainedRequests != 4 { return 25 }
            early.congestion.window = 12000
            early.paceCredit = Float(early.congestion.window); early.paceAt = 3
            let resumed = quic.poll(early, 3); handshakeSeen = false
            for packet in resumed {
                if (packet[0] & 128) == 0 && !handshakeSeen { return 22 }
                if (packet[0] & 128) != 0 && ((packet[0] >> 4) & 3) == 2 { handshakeSeen = true }
                quic.receive(peer, packet, 3)
            }
            if peer.state != quic.ESTABLISHED { return 25 }
            for id in 0..4 {
                if Text(errors.bytesValue(quic.readStream(peer, id * 4))) != "x" { return 25 }
            }
        }
        // Inactive keys/spaces and invalid paths cannot starve another queue.
        if mode >= 2 && mode < 5 && application != 4 { print("unusable handshake blocked application"); return 26 }
    }
    return 0
}
function finishedProbe(root: Bytes, identity: Bytes, key: Bytes, client: Bytes, clientKey: Bytes): Integer {
    let store = tickets.store(randomBytes(16), 3600); tickets.allowEarlyData(store, 0xffffffff)
    let initial = quic.client("localhost", randomBytes(80), "minyar-test", [root], [client], clientKey)
    let issuer = quic.serverWithTickets(randomBytes(80), "minyar-test", initial.originalDestination, [identity], key, [root], true, store)
    for tick in 0..100 { drive(initial, issuer, tick * 10) }
    let ticket = quic.takeTicket(initial); if !ticket.valid { return 27 }
    let early = quic.clientEarly("localhost", randomBytes(80), "minyar-test", [root], [client], clientKey, ticket)
    let peer = quic.serverWithTickets(randomBytes(80), "minyar-test", early.originalDestination, [identity], key, [root], true, store)
    for request in 0..16 {
        let id = errors.integerValue(quic.openEarlyStream(early, false))
        quic.writeEarlyStream(early, id, Bytes(257), true)
    }
    // Retain a real early-data flight, losing its packets and every ACK.
    for packet in quic.poll(early, 0) {
        let header = wire.header(packet, 0, peer.local.length)
        if header.kind == 0 { quic.receive(peer, packet, 0) }
    }
    for packet in quic.poll(peer, 1) {
        let header = wire.header(packet, 0, early.local.length)
        if header.kind == 0 {
            let opened = protection.unprotect(early.spaces[0].read, packet.slice(0, header.end), header.numberOffset, early.spaces[0].largest)
            if !opened.valid { return 27 }
            let crypto = false
            for frame in wire.frames(opened.payload).frames { if frame.type == 6 { crypto = true } }
            if crypto { quic.receive(early, packet, 1) }
        } else if header.kind == 2 { quic.receive(early, packet, 1) }
    }
    if early.state != quic.ESTABLISHED || peer.state != quic.STARTING || early.earlyPackets < 8 || early.spaces[1].sent.length != 0 { print("Finished PTO setup"); return 27 }
    // Keep the application flight congestion-blocked after a Handshake ACK
    // discards Initial flight. No Finished has yet armed a Handshake PTO.
    let initialFlight = 0
    for sent in early.spaces[0].sent { initialFlight += sent.bytes }
    early.congestion.window = max(2400, early.flight - initialFlight)
    quic.poll(early, 2)
    if early.spaces[1].sent.length != 0 { return 27 }
    let deadline = quic.nextTimer(early)
    if deadline < 3 { return 27 }
    let handshake = false
    for packet in quic.poll(early, deadline) {
        let header = wire.header(packet, 0, peer.local.length)
        if header.kind == 2 { handshake = true }
        quic.receive(peer, packet, deadline)
    }
    if !handshake || peer.state != quic.ESTABLISHED { print("due probe left unsent Finished blocked"); return 28 }
    return 0
}
function main(): Integer {
    let root = readBytesFile(argument(0)); let identity = readBytesFile(argument(1)); let key = readBytesFile(argument(2))
    let client = readBytesFile(argument(3)); let clientKey = readBytesFile(argument(4))
    let store = tickets.store(randomBytes(16), 3600)
    if !tickets.allowEarlyData(store, 0xffffffff) { return 1 }
    let c = quic.client("localhost", randomBytes(80), "minyar-test", [root], [client], clientKey)
    if errors.integerOk(quic.openEarlyStream(c, false)) { return 2 }
    let s = quic.serverWithTickets(randomBytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true, store)
    for count in 0..100 { drive(c, s, count * 10) }
    let ticket = quic.takeTicket(c)
    if !ticket.valid || ticket.earlyLimit != 0xffffffff { return 3 }
    for attempt in 0..3 {
        let early = quic.clientEarly("localhost", randomBytes(80), "minyar-test", [root], [client], clientKey, ticket)
        let current = store
        if attempt == 2 { current = tickets.store(store.key, 3600); tickets.allowEarlyData(current, 0xffffffff) }
        let accepted = quic.serverWithTickets(randomBytes(80), "minyar-test", early.originalDestination, [identity], key, [root], true, current)
        let id = errors.integerValue(quic.openEarlyStream(early, false))
        if !errors.integerOk(quic.writeEarlyStream(early, id, Bytes("replay-safe heartbeat"), true)) { return 4 }
        for packet in quic.poll(early, 0) { quic.receive(accepted, packet, 0) }
        if attempt == 0 {
            if accepted.state != quic.STARTING || !accepted.serverTLS.earlyAccepted || Text(errors.bytesValue(quic.readStream(accepted, id))) != "replay-safe heartbeat" { return 5 }
        } else {
            if accepted.serverTLS.earlyAccepted || accepted.streams.length != 0 { return 6 }
        }
        for count in 0..100 { drive(early, accepted, count * 10) }
        if early.state != quic.ESTABLISHED || accepted.state != quic.ESTABLISHED || !accepted.serverTLS.authenticated { print(early.error); print(accepted.error); return 7 }
        if attempt == 0 {
            if early.earlyRejected || !early.clientTLS.earlyAccepted { return 8 }
        } else {
            if !early.earlyRejected || errors.code(errors.bytesError(quic.readStream(early, id))) != quic.earlyRejectedCode() { return 9 }
            if errors.integerOk(quic.writeStream(early, id, Bytes("must not silently replay"), false)) { return 10 }
            let retry = errors.integerValue(quic.openStream(early, false))
            quic.writeStream(early, retry, Bytes("explicit retry"), true)
            for count in 100..120 { drive(early, accepted, count * 10) }
            if Text(errors.bytesValue(quic.readStream(accepted, retry))) != "explicit retry" { return 11 }
        }
    }
    if store.seen.length != 1 { return 12 }
    let ordering = finishedOrdering(root, identity, key, client, clientKey)
    if ordering != 0 { return ordering }
    let probe = finishedProbe(root, identity, key, client, clientKey)
    if probe != 0 { return probe }
    print("QUIC 0-RTT: explicit replay-safe API, PSK mTLS identity, early delivery, single-use/restart replay rejection and explicit retry passed")
    return 0
}
