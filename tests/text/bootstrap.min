function echo(value: Text): Text { return value }
function main(): Integer {
print("values: \(42) \(-7) \(true) \(false) \('x') \("é🙂")")
let name = "Ada"
print("""
    Hello, \(name)!
      a little extra

    Good night.
    """)
print("""
    two \
    lines
    """)
print(#"C:\new "quoted" \(name)"#)
print(#"""
    "raw" \n \(name)
      indented
    """#)
print("nested raw: \(#"\path"#)")
print("""
    nested: \(echo("""
        inner \(name)
        """))
    """)
print("""
    """)
print("""
    escaped\nnewline
    """)
print(#"""
    literal """ stays
    """#)
print("""
    trailing \
    """)
print("""
    start \
    \(name)
    """)

return 0
}
