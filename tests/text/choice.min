choice Lantern {
    Lit(colour: Text)
    Dark
}
function describe(lantern: Lantern): Text {
    match lantern {
        Lit(colour) { return "the \(colour) light" }
        Dark { return "unlit" }
    }
}
print("Harbour: \(describe(Lantern.Lit("amber"))), \(describe(Lantern.Dark)).")
let literal = #"Lantern.Lit("amber")"#
print("literal: \(literal)")
let choice = Lantern.Lit("amber")
print("selected: \(describe(choice))")
