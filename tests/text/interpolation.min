function echo(value: Text): Text { return value }
function observe(value: Integer): Integer { print(value); return value }
record Box { text: Text }
function change(box: Box): Text { box.text = "new"; return "changed" }

let name = "Ada"
print("Hello, \(name)! You have \(20 + 22) messages.")
print("\(-9223372036854775808) \(3.5) \(true) \(false) \('🙂')")
print("nested: \(echo("a ) quote: \" and \(echo("inner"))"))!")
print("\(observe(1)):\(observe(2)):\(observe(3))")
print("escaped: \\(name)\n\t\"\\")
print("unicode: é\(name)🙂")
print("\(1 /* ) \" */ + 2)")
print("\(
    20 + 22
)")
let callback: (Integer) -> Integer = function(n) { return n + 1 }
print("callback: \(callback(41))")
print("inline: \((function(n: Integer): Integer {
    let answer = n + 1
    return answer
})(41))")
let values = ["first", "second"]
print("list: \(values[1]) \(Box { text: "field" }.text)")
let box = Box { text: "old" }
print("\(box.text):\(change(box)):\(box.text)")
for index in 0..3 {
    let text = "value \(index): \(echo("owned" + Text(index)))"
    print(text)
}
let joinText: (List<Text>) -> Text = function(parts) { return "shadow" }
let Text: (Integer) -> Text = function(n) { return "shadow" }
print("builtins: \(42)")

function number(good: Boolean): Result<Integer, Text> {
    if good { return Ok(42) }
    return Err("missing")
}
function message(good: Boolean): Result<Text, Text> {
    let prefix = "owned" + Text(1)
    return Ok("\(prefix): \(try number(good))")
}
match message(true) { Ok(text) { print(text) } Err(error) { print(error) } }
match message(false) { Ok(text) { print(text) } Err(error) { print(error) } }
function pieces(good: Boolean): Result<List<Text>, Text> {
    return Ok(["held" + Text(1), Text(try number(good))])
}
function nested(good: Boolean): Result<List<List<Integer>>, Text> {
    return Ok([[try number(good)]])
}
match pieces(true) { Ok(parts) { print(parts[0]); print(parts[1]) } Err(error) { print(error) } }
match pieces(false) { Ok(parts) { print(parts[0]) } Err(error) { print(error) } }
match nested(true) { Ok(parts) { print(parts[0][0]) } Err(error) { print(error) } }
match nested(false) { Ok(parts) { print(parts[0][0]) } Err(error) { print(error) } }
