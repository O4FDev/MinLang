record Lantern { colour: Text }
function Lantern.label(): Text { return "\(self.colour) light" }

let lantern = Lantern { colour: "amber" }
let colours: Set<Text> = Set()
colours.add("amber")
print("method: \(lantern.label())")
print("known: \(colours.contains("amber")); equal: \(lantern == Lantern { colour: "amber" })")
