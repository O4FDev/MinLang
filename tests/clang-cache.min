use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "system" as system
use "files" as files
let work = test.scratch()
let compiler = processInfo.argument(0)
let cacheTool = processInfo.argument(1)
let cache = work + "/cache"
let real = work + "/clang"
io.writeTextFile(real, "#!/bin/sh\nrecord=1\nfor argument in \"$@\"; do case \"$argument\" in -E|-print-runtime-dir) record=0;; esac; done\nif [ \"$record\" = 1 ]; then printf 'compile\\n' >> '" + work + "/calls'; fi\nexec '" + compiler + "' \"$@\"\n")
test.require(test.run(["/bin/chmod", "+x", real], system.environment(), "", work + "/chmod", 10), "fixture permission")
io.writeTextFile(work + "/one.ll", "define i32 @main() {\n  ret i32 0\n}\n")
io.writeTextFile(work + "/other.ll", io.readTextFile(work + "/one.ll"))
function compile(tool: Text, real: Text, cache: Text, source: Text, output: Text, optimization: Text, log: Text): test.Result {
    return test.run([tool, tool, cache, real, optimization, "-Wno-override-module", source, "-o", output], system.environment(), "", log, 30)
}
function cacheEntry(directory: Text): Text {
    for name in files.list(directory) { if Bytes(name).length == 64 { return directory + "/" + name } }
    test.check(false, "expected a compiler cache entry")
    return ""
}
test.require(compile(cacheTool, real, cache, work + "/one.ll", work + "/one", "-O0", work + "/first"), "first real compiler invocation")
let restoreVictim = work + "/restore-victim"
let restoreOutput = work + "/restore-output"
let restoreWrapper = work + "/restore-wrapper"
io.writeTextFile(restoreVictim, "SAFE restore\n")
io.writeTextFile(restoreWrapper, "#!/bin/sh\nshift\n/bin/ln -s '" + restoreVictim + "' '" + restoreOutput + ".cache-'$$ || exit 91\nexec '" + cacheTool + "' '" + cacheTool + "' \"$@\"\n")
test.require(test.run(["/bin/chmod", "+x", restoreWrapper], system.environment(), "", work + "/restore-wrapper-mode", 10), "restore attack wrapper permission")
test.require(compile(restoreWrapper, real, cache, work + "/other.ll", restoreOutput, "-O0", work + "/restore-regression"), "cache restore through preplanted legacy symlink")
test.check(io.readTextFile(restoreVictim) == "SAFE restore\n", "cache restore uses private unpredictable staging")
let publishCache = work + "/publish-cache"
test.require(compile(cacheTool, real, publishCache, work + "/one.ll", work + "/publish-seed", "-O0", work + "/publish-seed-log"), "seed cache publication regression")
let publishEntry = cacheEntry(publishCache)
test.check(files.remove(publishEntry) == 0, "remove seeded compiler cache entry")
let publishVictim = work + "/publish-victim"
let publishWrapper = work + "/publish-wrapper"
io.writeTextFile(publishVictim, "SAFE publish\n")
io.writeTextFile(publishWrapper, "#!/bin/sh\nshift\n/bin/ln -s '" + publishVictim + "' '" + publishEntry + ".tmp-'$$ || exit 91\nexec '" + cacheTool + "' '" + cacheTool + "' \"$@\"\n")
test.require(test.run(["/bin/chmod", "+x", publishWrapper], system.environment(), "", work + "/publish-wrapper-mode", 10), "publish attack wrapper permission")
test.require(compile(publishWrapper, real, publishCache, work + "/one.ll", work + "/publish-output", "-O0", work + "/publish-regression"), "cache entry publication through preplanted legacy symlink")
test.check(io.readTextFile(publishVictim) == "SAFE publish\n" && files.pathSize(publishEntry) > 0, "cache entry publication uses private unpredictable staging")
let linkedCache = work + "/linked-cache"
test.require(compile(cacheTool, real, linkedCache, work + "/one.ll", work + "/linked-seed", "-O0", work + "/linked-seed-log"), "seed symlinked cache entry regression")
let linkedEntry = cacheEntry(linkedCache)
test.check(files.remove(linkedEntry) == 0, "remove cache entry before symlink fixture")
test.require(test.run(["/bin/ln", "-s", work + "/one", linkedEntry], system.environment(), "", work + "/linked-entry-fixture", 10), "symlinked cache entry fixture")
let linkedResult = compile(cacheTool, real, linkedCache, work + "/one.ll", work + "/linked-output", "-O0", work + "/linked-entry-log")
test.check(linkedResult.status != 0 && files.pathSize(work + "/linked-output") < 0, "shared cache symlink entries are rejected without copying their targets")
io.writeTextFile(work + "/calls", "compile\n")
test.require(compile(cacheTool, real, cache, work + "/other.ll", work + "/two", "-O0", work + "/second"), "equivalent source cache hit")
test.check(io.readTextFile(work + "/calls") == "compile\n", "equivalent LLVM links compile once")
test.require(test.run([work + "/two"], system.environment(), "", work + "/run", 10), "cached executable executes")
test.require(compile(cacheTool, real, cache, work + "/one.ll", work + "/optimized", "-O2", work + "/flags"), "changed flags compile")
test.check(test.lines(io.readTextFile(work + "/calls")).length == 2, "optimization flags invalidate cache")
io.writeTextFile(work + "/one.ll", "define i32 @main() {\n  ret i32 7\n}\n")
test.require(compile(cacheTool, real, cache, work + "/one.ll", work + "/changed", "-O0", work + "/contents"), "changed LLVM compiles")
test.check(test.run([work + "/changed"], system.environment(), "", work + "/changed-run", 10).status == 7, "changed input affects executable")
test.check(test.lines(io.readTextFile(work + "/calls")).length == 3, "content changes invalidate cache")
io.writeTextFile(work + "/bad.ll", "invalid LLVM\n")
for attempt in 0..2 {
    let result = compile(cacheTool, real, cache, work + "/bad.ll", work + "/bad", "-O0", work + "/error" + Text(attempt))
    test.check(result.status != 0 && result.errorOutput != "", "compiler failure preserves diagnostics")
}
test.check(test.lines(io.readTextFile(work + "/calls")).length == 5, "failed compiles never cached")
io.writeTextFile(real, io.readTextFile(real) + "\n")
test.require(compile(cacheTool, real, cache, work + "/other.ll", work + "/identity", "-O0", work + "/identity-log"), "compiler identity control")
test.check(test.lines(io.readTextFile(work + "/calls")).length == 6, "compiler changes invalidate cache")
function compileC(tool: Text, real: Text, cache: Text, source: Text, output: Text, flags: List<Text>, environment: List<Text>, log: Text): test.Result {
    let command = [tool, tool, cache, real]
    for flag in flags { command.add(flag) }
    for item in [source, "-o", output] { command.add(item) }
    return test.run(command, environment, "", log, 30)
}
let fixture = work + "/fixture.c"
let header = work + "/private.h"
let headerSource = "#define EXPECTED 2\nstatic int hidden;\nstatic _Thread_local int per_thread;\nstatic inline int step(void) { hidden++; per_thread++; return hidden + per_thread; }\n"
io.writeTextFile(header, headerSource)
io.writeTextFile(fixture, "#include \"private.h\"\n#include <stdio.h>\nint main(void) { int (*pointer)(void) = step; if (pointer != step || hidden != 0 || per_thread != 0 || pointer() != 2 || hidden != 1 || per_thread != 1) return 9; printf(\"%d\\n\", EXPECTED + VALUE); return 0; }\n")
let nativeFlags = ["-O0", "-std=c11", "-DVALUE=0"]
test.require(compileC(cacheTool, real, cache, fixture, work + "/c-one", nativeFlags, system.environment(), work + "/c-first"), "original complete C translation unit")
test.require(compileC(cacheTool, real, cache, fixture, work + "/c-two", nativeFlags, system.environment(), work + "/c-hit"), "exact complete C translation unit cache hit")
test.check(test.lines(io.readTextFile(work + "/calls")).length == 7, "identical configured C fixtures compile once")
test.require(test.run(["/usr/bin/cmp", "-s", work + "/c-one", work + "/c-two"], system.environment(), "", work + "/c-identical", 10), "exact C artifact bytes are reused")
let cRun = test.run([work + "/c-two"], system.environment(), "", work + "/c-run", 10)
test.check(cRun.status == 0 && cRun.output == "2\n" && cRun.errorOutput == "", "cached fixture retains private static/TLS state, inline calls and pointer identity")
io.writeTextFile(header, test.replace(headerSource, "EXPECTED 2", "EXPECTED 3"))
test.require(compileC(cacheTool, real, cache, fixture, work + "/c-header", nativeFlags, system.environment(), work + "/c-header-log"), "changed included header")
test.check(test.run([work + "/c-header"], system.environment(), "", work + "/c-header-run", 10).output == "3\n", "header changes reach executable")
test.check(test.lines(io.readTextFile(work + "/calls")).length == 8, "included header bytes invalidate cache")
test.require(compileC(cacheTool, real, cache, fixture, work + "/c-macro", ["-O0", "-std=c11", "-DVALUE=7"], system.environment(), work + "/c-macro-log"), "changed private fixture macro")
test.check(test.run([work + "/c-macro"], system.environment(), "", work + "/c-macro-run", 10).output == "10\n", "fixture macro changes reach executable")
test.check(test.lines(io.readTextFile(work + "/calls")).length == 9, "macro configuration invalidates cache")
let sanFlags = ["-O1", "-g", "-std=c11", "-DVALUE=0", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
test.require(compileC(cacheTool, real, cache, fixture, work + "/c-san-one", sanFlags, system.environment(), work + "/c-san-first"), "original instrumented fixture pipeline")
test.require(compileC(cacheTool, real, cache, fixture, work + "/c-san-two", sanFlags, system.environment(), work + "/c-san-hit"), "exact instrumented fixture cache hit")
test.check(test.lines(io.readTextFile(work + "/calls")).length == 10, "instrumented fixture has its own exact artifact")
let sanRun = test.run([work + "/c-san-two"], system.environment(), "", work + "/c-san-run", 10)
test.check(sanRun.status == 0 && sanRun.output == "3\n" && sanRun.errorOutput == "", "cached instrumentation retains private fixture assertions")
let negative = work + "/negative.c"
io.writeTextFile(negative, "#include <stdlib.h>\nint main(void) { volatile int *pointer = malloc(sizeof(int)); *pointer = 42; free((void *)pointer); return *pointer; }\n")
for suffix in ["one", "two"] {
    test.require(compileC(cacheTool, real, cache, negative, work + "/negative-" + suffix, ["-O1", "-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"], system.environment(), work + "/negative-link-" + suffix), "instrumented negative link")
    let result = test.run([work + "/negative-" + suffix], system.environment(), "", work + "/negative-run-" + suffix, 10)
    test.check(result.status != 0 && test.contains(result.errorOutput, "heap-use-after-free"), "cache miss and hit retain the ASan negative oracle")
}
test.check(test.lines(io.readTextFile(work + "/calls")).length == 11, "negative fixture reuses only its identical instrumented artifact")
let budget: List<Text> = []
for entry in system.environment() { if !test.contains(entry, "MINYAR_CHECK_LABEL=") { budget.add(entry) } }
budget.add("MINYAR_CHECK_LABEL=budget-control")
for suffix in ["one", "two"] { test.require(compileC(cacheTool, real, cache, fixture, work + "/budget-" + suffix, nativeFlags, budget, work + "/budget-link-" + suffix), "budget fixture bypass") }
test.check(test.lines(io.readTextFile(work + "/calls")).length == 13, "budget measurements never reuse compiler work")
io.writeTextFile(fixture, "#include <stdio.h>\nint main(void) { puts(__TIME__); return 0; }\n")
for suffix in ["one", "two"] { test.require(compileC(cacheTool, real, cache, fixture, work + "/volatile-" + suffix, ["-O0"], system.environment(), work + "/volatile-link-" + suffix), "volatile preprocessor input bypass") }
test.check(test.lines(io.readTextFile(work + "/calls")).length == 15, "volatile time macros cannot publish an artifact cache hit")
let multiMain = work + "/multi-main.c"
let left = work + "/left.c"
let right = work + "/right.c"
let privateHeader = work + "/multi-private.h"
io.writeTextFile(privateHeader, "#define VALUE 2\nstatic int hidden;\nstatic _Thread_local int local;\nstatic int step(void) { hidden++; local++; return hidden + local; }\n")
for name in ["left", "right"] {
    io.writeTextFile(work + "/" + name + ".c", "#include \"multi-private.h\"\nint (*" + name + "_callback(void))(void) { return step; }\nint " + name + "_value(void) { return VALUE; }\n")
}
io.writeTextFile(multiMain, "#include <stdio.h>\nextern int (*left_callback(void))(void), (*right_callback(void))(void);\nextern int left_value(void), right_value(void);\nint main(void) { int (*a)(void) = left_callback(), (*b)(void) = right_callback(); if (a == b || a != left_callback() || b != right_callback() || a() != 2 || b() != 2 || a() != 4 || b() != 4) return 9; printf(\"%d %d\\n\", left_value(), right_value()); return 0; }\n")
function compileMany(tool: Text, real: Text, cache: Text, sources: List<Text>, flags: List<Text>, output: Text, log: Text): test.Result {
    let command = [tool, tool, cache, real]
    for flag in flags { command.add(flag) }
    for source in sources { command.add(source) }
    for item in ["-o", output] { command.add(item) }
    return test.run(command, system.environment(), "", log, 30)
}
let multiSources = [multiMain, left, right]
let before = test.lines(io.readTextFile(work + "/calls")).length
for name in ["one", "two"] {
    test.require(compileMany(cacheTool, real, cache, multiSources, ["-O0", "-std=c11"], work + "/multi-" + name, work + "/multi-link-" + name), "unchanged original multi-TU compiler command")
    let result = test.run([work + "/multi-" + name], system.environment(), "", work + "/multi-run-" + name, 10)
    test.check(result.status == 0 && result.output == "2 2\n" && result.errorOutput == "", "separate TUs retain independent private static/TLS state and callback identities")
}
test.check(test.lines(io.readTextFile(work + "/calls")).length == before + 1, "complete multi-TU invocation compiles once")
test.require(test.run(["/usr/bin/cmp", "-s", work + "/multi-one", work + "/multi-two"], system.environment(), "", work + "/multi-identical", 10), "whole multi-TU artifact is reused byte for byte")
io.writeTextFile(privateHeader, test.replace(io.readTextFile(privateHeader), "VALUE 2", "VALUE 3"))
test.require(compileMany(cacheTool, real, cache, multiSources, ["-O0", "-std=c11"], work + "/multi-header", work + "/multi-header-link"), "multi-TU included-header invalidation")
test.check(test.lines(io.readTextFile(work + "/calls")).length == before + 2, "headers in each original TU participate in the key")
test.check(test.run([work + "/multi-header"], system.environment(), "", work + "/multi-header-run", 10).output == "3 3\n", "changed multi-TU header reaches the original compiler command")
io.writeTextFile(right, test.replace(io.readTextFile(right), "return VALUE;", "return VALUE + 1;"))
test.require(compileMany(cacheTool, real, cache, multiSources, ["-O0", "-std=c11"], work + "/multi-source", work + "/multi-source-link"), "non-first TU input invalidation")
test.check(test.lines(io.readTextFile(work + "/calls")).length == before + 3, "every original TU input participates in the key")
test.check(test.run([work + "/multi-source"], system.environment(), "", work + "/multi-source-run", 10).output == "3 4\n", "non-first TU change reaches the original compiler command")
let manySanFlags = ["-O1", "-g", "-std=c11", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
for name in ["one", "two"] {
    test.require(compileMany(cacheTool, real, cache, multiSources, manySanFlags, work + "/multi-san-" + name, work + "/multi-san-link-" + name), "original multi-TU sanitizer compile/link command")
    let result = test.run([work + "/multi-san-" + name], system.environment(), "", work + "/multi-san-run-" + name, 10)
    test.check(result.status == 0 && result.output == "3 4\n" && result.errorOutput == "", "multi-TU SAN cache preserves private identities and assertions")
}
test.check(test.lines(io.readTextFile(work + "/calls")).length == before + 4, "multi-TU sanitizer configuration has its own exact cached artifact")
let negativeHelper = work + "/negative-helper.c"
let negativeMain = work + "/negative-main.c"
io.writeTextFile(negativeHelper, "#include <stdlib.h>\nint broken(void) { volatile int *pointer = malloc(sizeof(int)); *pointer = 42; free((void *)pointer); return *pointer; }\n")
io.writeTextFile(negativeMain, "extern int broken(void); int main(void) { return broken(); }\n")
for name in ["one", "two"] {
    test.require(compileMany(cacheTool, real, cache, [negativeMain, negativeHelper], manySanFlags, work + "/multi-negative-" + name, work + "/multi-negative-link-" + name), "original multi-TU instrumented negative link")
    let result = test.run([work + "/multi-negative-" + name], system.environment(), "", work + "/multi-negative-run-" + name, 10)
    test.check(result.status != 0 && test.contains(result.errorOutput, "heap-use-after-free"), "multi-TU cache miss and hit retain genuine ASan instrumentation")
}
test.check(test.lines(io.readTextFile(work + "/calls")).length == before + 5, "multi-TU negative cache reuses only the identical instrumented artifact")
let archiveSource = work + "/archive.c"
let archiveObject = work + "/archive.o"
let archive = work + "/provider.a"
io.writeTextFile(archiveSource, "int archive_value(void) { return 7; }\n")
function makeArchive(compiler: Text, source: Text, object: Text, archive: Text, log: Text) {
    test.require(test.run([compiler, "-O0", "-c", source, "-o", object], system.environment(), "", log + ".compile", 30), "build explicit fixture archive input")
    test.require(test.run(["/usr/bin/ar", "rcs", archive, object], system.environment(), "", log + ".archive", 10), "construct explicit fixture archive input")
}
makeArchive(compiler, archiveSource, archiveObject, archive, work + "/archive-first")
let archiveMain = work + "/archive-main.c"
io.writeTextFile(archiveMain, "extern int archive_value(void); int main(void) { return archive_value(); }\n")
for name in ["one", "two"] {
    test.require(compileMany(cacheTool, real, cache, [archiveMain, archive], ["-O0"], work + "/archive-" + name, work + "/archive-link-" + name), "original explicit-archive compiler link")
    test.check(test.run([work + "/archive-" + name], system.environment(), "", work + "/archive-run-" + name, 10).status == 7, "explicit archive executable semantics")
}
test.check(test.lines(io.readTextFile(work + "/calls")).length == before + 6, "explicit archive links reuse only the identical whole artifact")
io.writeTextFile(archiveSource, "int archive_value(void) { return 8; }\n")
makeArchive(compiler, archiveSource, archiveObject, archive, work + "/archive-changed")
test.require(compileMany(cacheTool, real, cache, [archiveMain, archive], ["-O0"], work + "/archive-changed", work + "/archive-changed-link"), "explicit archive content invalidation")
test.check(test.lines(io.readTextFile(work + "/calls")).length == before + 7, "changed archive bytes invalidate the whole-artifact key")
test.check(test.run([work + "/archive-changed"], system.environment(), "", work + "/archive-changed-run", 10).status == 8, "changed archive content reaches the original link")
test.removeTree(work)
print("Minyar compiler cache: passed")
