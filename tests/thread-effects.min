use "io" as io
use "../tools/testing.min" as test
use "./thread-port-support.min" as support
use "system" as system

let original = io.readTextFile("build/thread-compiler.min")
let cut = support.find(original, "\nfunction main(", 0)
test.check(cut >= 0, "thread compiler main is missing")
let source = Text(Bytes(original).slice(0, cut)) + "\nfunction main() {\n    let output: List<Text> = []\n    let globals: List<Text> = [\"; minyar-thread-runtime: 1\\n\", \"; minyar-thread-entry: worker\\n\"]\n    let probe = processInfo.argument(0)\n    let getter = \"\\\"minyar.constant|minyar_module_2_data|load\\\"\"\n    if probe == \"managed\" || probe == \"managed-helper\" || probe == \"main-managed\" {\n        globals.add(\"; minyar-module-constant: minyar_module_2_data|managed\\n\")\n    } else if probe != \"unknown\" {\n        globals.add(\"; minyar-module-constant: minyar_module_2_data|scalar\\n\")\n    }\n    let caller = \"worker\"\n    if probe == \"main-managed\" || probe == \"initializer\" { caller = \"main\" }\n    if probe == \"managed-helper\" {\n        threadNote(output, \"worker\", \"call\", \"helper\", \"2()\")\n        caller = \"helper\"\n    }\n    threadNote(output, caller, \"runtime\", getter, \"2()\")\n    if probe == \"initializer\" {\n        threadNote(output, \"constant minyar_module_2_data\", \"call\", \"unsafeHelper\", \"1()\")\n        threadNote(output, \"unsafeHelper\", \"native\", \"minyar_machine_address\", \"1(8)\")\n    }\n    if probe == \"indirect\" { threadNote(output, \"worker\", \"indirect\", \"callback\", \"1(1)\") }\n    threadCheckGraph(output, globals)\n    print(\"checked graph\")\n}\n"
let work = test.scratch()
io.writeTextFile(work + "/probe.min", test.sourceModules(source))
let compiled = test.run(["build/minyarc", work + "/probe.min", work + "/probe.ll", "--library", "library"], system.environment(), "", work + "/compile", 60)
test.check(compiled.status == 0, compiled.output + compiled.errorOutput)
let command = test.words(test.setting("LLVM_CC", "clang"))
for item in ["-O2", "-Wno-override-module", work + "/probe.ll", "build/minyar-compiler-runtime.ll", "-lm", "-o", work + "/probe"] { command.add(item) }
test.require(test.run(command, system.environment(), "", work + "/link", 120), "link thread effect probe")
for probe in ["managed", "managed-helper", "main-managed", "scalar", "unknown", "initializer", "indirect"] {
    let result = test.run([work + "/probe", probe], system.environment(), "", work + "/" + probe, 10)
    let allowed = probe == "main-managed" || probe == "scalar"
    if allowed {
        test.check(result.status == 0 && result.output == "checked graph\n" && result.errorOutput == "", probe + "\n" + result.output + result.errorOutput)
        print(probe + ": accepted")
    } else {
        test.check(result.status != 0, probe + " was accepted")
        let diagnostic = "unsafe thread effect"
        if probe == "unknown" { diagnostic = "unreviewed module constant getter" }
        test.check(test.contains(result.errorOutput + result.output, diagnostic), probe + "\n" + result.output + result.errorOutput)
        print(probe + ": rejected")
    }
}
test.removeTree(work)
