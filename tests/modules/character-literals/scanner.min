// Character literals that spell punctuation must not change how the module
// rewriter tracks declarations: a '{' here once hid every later private type.
record Cursor {
    text: Text
    position: Integer
}

function opens(character: Character): Boolean {
    return character == '{' || character == '<' || character == ':'
}

function closes(character: Character): Boolean {
    return character == '}' || character == '>' || character == '='
}

function depth(cursor: Cursor): Integer {
    let level = 0
    let deepest = 0
    while cursor.position < cursor.text.length {
        let character = cursor.text[cursor.position]
        if opens(character) { level += 1 }
        if closes(character) { level -= 1 }
        deepest = max(deepest, level)
        cursor.position += 1
    }
    return deepest
}

public function deepest(text: Text): Integer {
    return depth(Cursor { text: text; position: 0 })
}
