// Private fields are read, assigned and initialized only in this module.
public record Vault {
    private secret: Integer
    label: Text
    private: Boolean
}

public function create(label: Text): Vault {
    return Vault { secret: 42; label: label; private: true }
}

public function reveal(vault: Vault): Integer {
    return vault.secret
}

public function bump(vault: Vault) {
    vault.secret += 1
}
