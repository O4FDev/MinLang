use "json" as json

// The framing is harness-owned, rather than another JSON parser. Each frame
// carries an independent accept/reject oracle (2 = implementation-defined).
let data = readBytesFile(argument(0))
let position = 0
let count = 0
while position < data.length {
    if data.length - position < 5 { fail("broken JSON test framing") }
    let expected = data[position]
    let length = data[position + 1] * 16777216 + data[position + 2] * 65536 + data[position + 3] * 256 + data[position + 4]
    position += 5
    if length > data.length - position { fail("broken JSON test length") }
    let payload = data.slice(position, position + length)
    let value = json.parseBytes(payload, 1048576)
    let accepted = value.kind != json.INVALID
    if expected == 1 && !accepted { fail("rejected JSON corpus case " + Text(count)) }
    if expected == 0 && accepted { fail("accepted JSON corpus case " + Text(count)) }
    position += length
    count += 1
}
print(count)
