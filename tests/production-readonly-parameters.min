use "../tools/testing.min" as test
function selected(name: Text): Boolean {
    if argumentCount() == 0 { return true }
    for index in 0..argumentCount() {
        if argument(index) == name || argument(index) == "ProductionReadonlyParameters." + name { return true }
    }
    return false
}
let allowed = ["test_same_type_arguments_keep_distinct_header_operand_identities", "test_indexed_target_survives_mutation_of_its_last_external_owner", "test_exactly_sixty_four_parameters_keep_their_distinct_values"]
for index in 0..argumentCount() {
    let valid = false
    for name in allowed { if argument(index) == name || argument(index) == "ProductionReadonlyParameters." + name { valid = true } }
    test.check(valid, "unknown production readonly case " + argument(index))
}
let compiler = test.compiler()
if selected("test_same_type_arguments_keep_distinct_header_operand_identities") {
    test.executes(compiler, "function combine(first: Integer, second: Integer, third: Integer): Integer {\nreturn first * 100 + second * 10 + third\n}\nfunction decorate(first: Text, second: Text): Text { return second + first }\nfunction flags(first: Boolean, second: Boolean): Integer {\nif first { return 1 }\nif second { return 2 }\nreturn 3\n}\nprint(combine(2, 5, 9))\nprint(combine(7, 1, 4))\nprint(decorate(\"left\", \"right\"))\nprint(flags(false, true))\n", "259\n714\nrightleft\n2\n")
}
if selected("test_indexed_target_survives_mutation_of_its_last_external_owner") {
    test.executes(compiler, "function replace(holder: List<List<Integer>>): Integer {\nholder[0] = [99]\nreturn 0\n}\nfunction update(target: List<Integer>, holder: List<List<Integer>>): List<Integer> {\ntarget[replace(holder)] = target[0] + 1\nreturn target\n}\nlet holder = [[41]]\nlet saved = update(holder[0], holder)\nprint(saved[0])\nprint(holder[0][0])\n", "42\n99\n")
}
if selected("test_exactly_sixty_four_parameters_keep_their_distinct_values") {
    let parameters: List<Text> = []
    let arguments: List<Text> = []
    for index in 0..64 {
        if index > 0 { parameters.add(", "); arguments.add(", ") }
        parameters.add("a" + Text(index) + ": Integer")
        arguments.add(Text(index))
    }
    let source = "function boundary(" + joinText(parameters) + "): Integer { return a0 + a31 * 100 + a63 * 10000 }\nprint(boundary(" + joinText(arguments) + "))\n"
    test.require(test.compile(compiler, source), "compile readonly parameter boundary")
    let ir = readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
    let found = false
    let complete = false
    let body: List<Text> = []
    for line in test.lines(ir) {
        if !found && test.contains(line, "define") && test.contains(line, "@.minyar.fn.boundary(") { found = true }
        else if found {
            if line == "}" { complete = true; break }
            body.add(line + "\n")
        }
    }
    test.check(found && complete, "missing readonly boundary function")
    test.check(!test.contains(joinText(body), "%local."), "64 readonly parameters gained local slots")
    test.executes(compiler, source, "633100\n")
}
test.removeTree(compiler.directory)
print("Production readonly parameters: passed")
