use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "./quic-test-support.min" as quic
use "system" as system
use "json" as json
use "files" as files

let sanitize = false
for index in 0..processInfo.argumentCount() {
    test.check(processInfo.argument(index) == "--sanitize", "unknown QUIC dispatch option: " + processInfo.argument(index))
    sanitize = true
}
let work = test.scratch()
let binary = quic.program("tests/quic-dispatch.min", work + "/dispatch", sanitize)
let fixture = json.parse(io.readTextFile("tests/fixtures/siphash-vectors.json"))
let vectors = Bytes()
for item in json.member(fixture, "vectors").items { vectors.addBytes(quic.fromHex(item.text)) }
test.check(vectors.length > 0, "missing SipHash vectors")
io.writeBytesFile(work + "/vectors", vectors)
let result = test.run([binary, work + "/vectors"], system.environment(), "", work + "/dispatch.log", 120)
test.check(result.status == 0, "dispatch failed (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
files.writeStandardOutput(result.output)
let routes = quic.program("tests/peer-routing.min", work + "/routes", sanitize)
let routed = test.run([routes], system.environment(), "", work + "/routes.log", 120)
test.check(routed.status == 0 && routed.errorOutput == "", "routing failed (" + Text(routed.status) + ")\n" + routed.output + routed.errorOutput)
test.check(routed.output == "bounded edge routing: 32768 peers, 294912 retained IDs, cross-partition collisions, full pools, removal and reuse passed\n", routed.output)
files.writeStandardOutput(routed.output)
test.removeTree(work)
