let immediateExecutions = 0
let immediateRejections = 0
frontend.helpers = ""
frontend.sources = []

// I01: compare whole-body immediate elimination with stored and grouped
// controls. Parameter source avoids attributing source allocation to recipes.
fixtures.executes(frontend, #"""
    function double(value: Integer): Integer { return value * 2 }
    function even(value: Integer): Boolean { return value % 2 == 0 }
    public function immediateConsumer(values: List<Integer>): Integer {
        let total = 0
        for value in values.map(double).filter(even) { total += value }
        return total
    }
    public function storedConsumer(values: List<Integer>): Integer {
        let recipe = values.map(double).filter(even)
        let total = 0
        for value in recipe { total += value }
        return total
    }
    public function groupedConsumer(values: List<Integer>): Integer {
        let total = 0
        for value in (values.map(double).filter(even)) { total += value }
        return total
    }
    print(immediateConsumer([])); print(immediateConsumer([1])); print(immediateConsumer([1, 2, 3, 4]))
    print(storedConsumer([])); print(storedConsumer([1])); print(storedConsumer([1, 2, 3, 4]))
    print(groupedConsumer([])); print(groupedConsumer([1])); print(groupedConsumer([1, 2, 3, 4]))
    """#, "0\n2\n20\n0\n2\n20\n0\n2\n20\n", levels, 0, "", true)
immediateExecutions += 1
let immediatePath = frontend.compiler.directory + "/case" + Text(frontend.compiler.serial)
let immediateLLVM = io.readTextFile(immediatePath + ".ll")
let immediateBody = functionBody(immediateLLVM, functionSymbol(immediateLLVM, "immediateConsumer"))
let storedBody = functionBody(immediateLLVM, functionSymbol(immediateLLVM, "storedConsumer"))
let groupedBody = functionBody(immediateLLVM, functionSymbol(immediateLLVM, "groupedConsumer"))
test.check(immediateSetupCalls(immediateBody) == 0, "whole immediate consumer must not call recipe factories")
test.check(noMaterialization(immediateBody), "whole immediate consumer including preheader must not allocate recipes or materialize intermediate collections")
test.check(occurrences(immediateBody, "\nfor.condition.") == 1, "immediate chain must have one traversal")
test.check(test.contains(immediateBody, "call i64 " + functionSymbol(immediateLLVM, "double") + "("), "immediate map must call original scalar transform")
test.check(test.contains(immediateBody, "call zeroext i1 " + functionSymbol(immediateLLVM, "even") + "("), "immediate filter must call original Boolean predicate")
test.check(!test.contains(immediateBody, "_apply") && !test.contains(immediateBody, "@minyar_callback_") && !test.contains(immediateBody, "call i64 %") && !test.contains(immediateBody, "call zeroext i1 %") && !test.contains(immediateBody, "call ptr %"), "immediate traversal must retain direct named dispatch")
test.check(immediateSetupCalls(storedBody) == 2, "stored control must retain both fixed recipe constructions")
test.check(immediateSetupCalls(groupedBody) == 2, "grouped source must preserve ordinary fallback in this slice")
test.check(occurrences(storedBody, "\nfor.condition.") == 1 && occurrences(groupedBody, "\nfor.condition.") == 1, "controls must remain fused single traversals")
test.check(immediateSetupCalls("  call ptr @.minyar.fn.minyar_sequence_map_77_make(ptr %source)\n") == 1, "setup-call oracle must reject a retained factory")
test.check(!noMaterialization("  call ptr @minyar_record_new(i64 1)\n"), "whole-body oracle must reject a recipe record allocation")
test.require(test.run([optimizer(frontend), "-passes=verify", "-disable-output", immediatePath + ".ll"], frontend.environment, "", immediatePath + ".immediate-verify", 30), "verify whole-body immediate sequence LLVM")

// I02: source once, order, break, empty and all-rejected inputs.
fixtures.executes(frontend, #"""
    global CALLS: List<Integer> = [0, 0, 0]
    global TRACE: List<Text> = [""]
    function source(): List<Integer> { CALLS[0] += 1; TRACE[0] += "S"; return [1, 2, 3, 4] }
    function double(value: Integer): Integer { CALLS[1] += 1; TRACE[0] += "M" + Text(value); return value * 2 }
    function aboveFour(value: Integer): Boolean { CALLS[2] += 1; TRACE[0] += "K" + Text(value); return value > 4 }
    function never(value: Integer): Boolean { CALLS[2] += 1; return false }
    for value in source().map(double).filter(aboveFour) { print(value); break }
    print(TRACE[0]); print(CALLS[0]); print(CALLS[1]); print(CALLS[2])
    let empty: List<Integer> = []
    for value in empty.map(double).filter(aboveFour) { fail("empty immediate source produced an item") }
    for value in [1, 2].map(double).filter(never) { fail("all-rejected immediate source produced an item") }
    print(CALLS[1]); print(CALLS[2])
    """#, "6\nSM1K2M2K4M3K6\n1\n3\n3\n5\n5\n", levels, 0, "", true)
immediateExecutions += 1

// I03: managed type change, mixed acceptance, and rejected owner reset before
// a later local assignment, repeated enough to expose stale temporary owners.
fixtures.executes(frontend, #"""
    record Label { text: Text; bytes: Bytes }
    function render(value: Integer): Text { return "word" + Text(value) }
    function label(word: Text): Label { return Label { text: word; bytes: Bytes(word) } }
    function pair(label: Label): List<Label> { return [label, label] }
    function keep(values: List<Label>): Boolean { return values[0].text != "word2" }
    function never(word: Text): Boolean { return false }
    let kept: List<List<Label>> = []
    for repetition in 0..100 {
        for word in [1, 2, 3].map(render).filter(never) { fail("rejected immediate reference escaped") }
        let afterReject = [Bytes(128), Bytes(64)]
        for values in [1, 2, 3].map(render).map(label).map(pair).filter(keep) {
            let scratch = Bytes(64)
            kept.add(values)
            if values[0].text == "word1" { continue }
        }
    }
    for index in 0..100 { let scratch = [Bytes(256), Bytes(128)] }
    print(kept.length); print(kept[0][0].text); print(Text(kept[kept.length - 1][1].bytes))
    """#, "200\nword1\nword3\n", levels, 0, "", true)
immediateExecutions += 1

// I04: replacing the source slot inside a transform must not invalidate its
// reference input or the returned Text; accepted and rejected paths both run.
fixtures.executes(frontend, #"""
    record Box { text: Text }
    global VALUES: List<List<Box>> = [[]]
    function replace(box: Box): Text {
        VALUES[0][0] = Box { text: "replacement" }
        let churn = [Bytes(128), Bytes(64)]
        return box.text
    }
    function keep(word: Text): Boolean { return word == "old!" }
    let kept: List<Text> = []
    for repetition in 0..100 {
        VALUES[0] = [Box { text: "reject" + "!" }]
        for word in VALUES[0].map(replace).filter(keep) { fail("wrong replaced item accepted") }
        let afterReject = Bytes(128)
        VALUES[0] = [Box { text: "old" + "!" }]
        for word in VALUES[0].map(replace).filter(keep) { kept.add(word) }
    }
    print(kept.length); print(kept[0]); print(kept[kept.length - 1]); print(VALUES[0][0].text)
    """#, "100\nold!\nold!\nreplacement\n", levels, 0, "", true)
immediateExecutions += 1

// I05: root the original source when its user binding is rebound. A fresh
// unbound managed source exercises exact parser-owner transfer separately.
fixtures.executes(frontend, #"""
    function source(): List<Text> { return ["first" + "!", "second" + "!"] }
    function same(word: Text): Text { return word }
