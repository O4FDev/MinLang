fixtures.executes(frontend, #"""
    function infer<Item>(value: Item): Item { return value }
    function reflexive<Item: Equatable>(value: Item): Boolean { return value == value }
    public function genericFused(values: List<Integer>): Integer {
        let total = 0
        for value in values.map(infer).filter(reflexive) { total += value }
        return total
    }
    print(genericFused([])); print(genericFused([1, 2, 3]))
    """#, "0\n6\n", levels, 0, "", true)
let genericPath = frontend.compiler.directory + "/case" + Text(frontend.compiler.serial)
let genericLLVM = io.readTextFile(genericPath + ".ll")
let genericBody = functionBody(genericLLVM, functionSymbol(genericLLVM, "genericFused"))
test.check(occurrences(genericBody, "\nfor.condition.") == 1, "generic named transforms must fuse into one source loop")
let genericLoop = genericBody.slice(genericBody.find("\nfor.condition."), genericBody.length)
test.check(noMaterialization(genericLoop), "generic scalar traversal must not allocate recipe/callback/collection objects per item")
let genericTargets: List<Text> = []
for definition in test.lines(genericLLVM) {
    if definition.startsWith("define ") && test.contains(definition, "minyar_generic_function_") {
        let begin = definition.find("@")
        let end = definition.find("(")
        let symbol = definition.slice(begin, end)
        if symbol.endsWith("_infer") || symbol.endsWith("_reflexive") { genericTargets.add(symbol) }
    }
}
test.check(genericTargets.length == 2, "expected one concrete scalar map and predicate specialization")
for symbol in genericTargets {
    test.check(test.contains(genericLoop, " " + symbol + "("), "the fused loop must call each original specialization directly")
    test.check(noMaterialization(functionBody(genericLLVM, symbol)), "selected generic scalar transforms must not allocate")
}
test.check(!test.contains(genericBody, "@minyar_callback_") && !test.contains(genericBody, "call i64 %") && !test.contains(genericBody, "call zeroext i1 %") && !test.contains(genericBody, "call ptr %") && !test.contains(genericBody, "_apply"), "generic recipes must retain static direct dispatch without apply wrappers")
test.require(test.run([optimizer(frontend), "-passes=verify", "-disable-output", genericPath + ".ll"], frontend.environment, "", genericPath + ".verify", 30), "verify generic fused sequence LLVM")
io.writeTextFile("build/sequences-generic-evidence.ll", genericLLVM)
io.writeTextFile("build/sequences-generic-loop.ll", genericBody)

