use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io
use "files" as immediateFiles

function functionSymbol(llvm: Text, name: Text): Text {
    let found = ""
    for line in test.lines(llvm) {
        if line.startsWith("define ") {
            let at = line.find("@")
            let end = line.find("(")
            if at >= 0 && end > at {
                let symbol = line.slice(at, end)
                if symbol == "@.minyar.fn." + name || symbol == "@.minyar.fn.minyar_module_0_" + name || symbol.startsWith("@\".minyar.fn.minyar.module|" + name + "|") {
                    test.check(found == "", "sequence LLVM has duplicate functions named " + name)
                    found = symbol
                }
            }
        }
    }
    test.check(found != "", "sequence LLVM has no function named " + name)
    return found
}

function functionBody(llvm: Text, symbol: Text): Text {
    let body: List<Text> = []
    let taking = false
    for line in test.lines(llvm) {
        if line.startsWith("define ") && test.contains(line, " " + symbol + "(") { taking = true }
        if taking {
            body.add(line + "\n")
            if line == "}" { return joinText(body) }
        }
    }
    fail("sequence LLVM function is missing or incomplete: " + symbol)
}

function occurrences(source: Text, needle: Text): Integer {
    let count = 0
    let at = source.find(needle)
    while at >= 0 {
        count += 1
        source = source.slice(at + needle.length, source.length)
        at = source.find(needle)
    }
    return count
}

function noMaterialization(body: Text): Boolean {
    return !test.contains(body, "@minyar_list_new") && !test.contains(body, "@minyar_list_add") && !test.contains(body, "@minyar_record_new") && !test.contains(body, "@minyar_bytes_new") && !test.contains(body, "@minyar_callback_check")
}

function optimizer(frontend: fixtures.Frontend): Text {
    let directory = test.setting("MINYAR_LLVM_BIN", "")
    let candidates: List<Text> = []
    if directory != "" { candidates.add(directory + "/opt") }
    else {
        let clang = frontend.compiler.clang
        let last = -1
        for index in 0..clang.length { if clang[index] == '/' { last = index } }
        if last >= 0 { candidates.add(clang.slice(0, last + 1) + "opt") }
        candidates.add("/usr/lib/llvm-23/bin/opt")
        candidates.add("opt-23")
        candidates.add("opt")
    }
    let command = ["/bin/sh", "-c", "for tool do if command -v \"$tool\"; then exit 0; fi; done; exit 1", "minyar"]
    for candidate in candidates { command.add(candidate) }
    let found = test.run(command, frontend.environment, "", frontend.compiler.directory + "/optimizer-tool", 10)
    test.check(found.status == 0 && found.output != "", "Required LLVM optimizer unavailable; set MINYAR_LLVM_BIN")
    return test.lines(found.output)[0]
}

function immediateSetupCalls(body: Text): Integer {
    let count = 0
    for line in test.lines(body) {
        if test.contains(line, "call ") && test.contains(line, "minyar_sequence_") && test.contains(line, "_make") { count += 1 }
    }
    return count
}

// Discover the real identifier from a witness module, rather than guessing
// factory slot 0. Only compiler-internal regression fixtures use this name.
function immediateWitnessFactory(llvm: Text): Text {
    let found = ""
    let prefix = "minyar_sequence_map_"
    for line in test.lines(llvm) {
        if line.startsWith("define ") {
            let start = line.find(prefix)
            if start >= 0 {
                let end = start + prefix.length
                let first = end
                while end < line.length && test.contains("0123456789", line.slice(end, end + 1)) { end += 1 }
                if end > first && end + 5 <= line.length && line.slice(end, end + 5) == "_make" {
                    let name = line.slice(start, end + 5)
                    test.check(found == "", "immediate witness must define exactly one map factory")
                    found = name
                }
            }
        }
    }
    test.check(found != "", "immediate witness did not expose its real map factory")
    // Also validate the actual declaration through the module-aware matcher.
    test.check(functionSymbol(llvm, found) != "", "immediate witness factory definition unavailable")
    return found
}

// Alternating passing filters/maps keep the item type Integer while testing
// composition and the combined 64-stage cap. Every stage counts both items.
function immediateBoundarySource(stored: Integer, immediate: Integer): Text {
    let source: List<Text> = [#"""
        global CALLS: List<Integer> = [0]
        function same(value: Integer): Integer { CALLS[0] += 1; return value }
        function keep(value: Integer): Boolean { CALLS[0] += 1; return true }
        public function boundary(): Integer {
            let stage0 = [1, 2]
        """# + "\n"]
    for stage in 0..stored {
        let method = ".map(same)"
        if stage % 2 == 1 { method = ".filter(keep)" }
        source.add("let stage" + Text(stage + 1) + " = stage" + Text(stage) + method + "\n")
    }
    let chain = "stage" + Text(stored)
    for stage in stored..(stored + immediate) {
        if stage % 2 == 1 { chain += ".filter(keep)" }
        else { chain += ".map(same)" }
    }
    source.add("let total = 0\nfor value in " + chain + " { total += value }\nreturn total\n}\nprint(boundary()); print(CALLS[0])\n")
    return joinText(source)
}

