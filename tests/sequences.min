fixtures.executes(frontend, arithmetic + #"""
    public function fused(values: List<Integer>): Integer {
        let total = 0
        for value in values.map(double).filter(even) { total += value }
        return total
    }
    print(fused([])); print(fused([1])); print(fused([1, 2, 3, 4]))
    """#, "0\n2\n20\n", levels, 0, "", true)
let path = frontend.compiler.directory + "/case" + Text(frontend.compiler.serial)
let llvm = io.readTextFile(path + ".ll")
let fused = functionBody(llvm, functionSymbol(llvm, "fused"))
test.check(occurrences(fused, "\nfor.condition.") == 1, "a map/filter chain must have one traversal loop")
let loop = fused.find("\nfor.condition.")
let scalarLoop = fused.slice(loop, fused.length)
test.check(noMaterialization(scalarLoop), "a scalar fused loop must not allocate transform objects or intermediate Lists")
test.check(!noMaterialization("call ptr @minyar_list_new()"), "sequence no-materialization check must reject a List allocation")
test.check(!noMaterialization("call ptr @minyar_record_new(i64 1)"), "sequence no-materialization check must reject a record allocation")
let doubleSymbol = functionSymbol(llvm, "double")
let evenSymbol = functionSymbol(llvm, "even")
test.check(test.contains(scalarLoop, "call i64 " + doubleSymbol + "("), "scalar mapping must call the user's concrete transform directly with an unboxed Integer")
test.check(test.contains(scalarLoop, "call zeroext i1 " + evenSymbol + "("), "scalar filtering must call the user's concrete predicate directly with a Boolean result")
for line in test.lines(fused) {
    if test.contains(line, "call ") && test.contains(line, "minyar_sequence_") {
        test.check(!test.contains(line, "_apply"), "fused sequence traversal must not call a per-item apply wrapper")
    }
}
let doubleBody = functionBody(llvm, doubleSymbol)
let evenBody = functionBody(llvm, evenSymbol)
test.check(noMaterialization(doubleBody) && noMaterialization(evenBody), "the user's scalar transform and predicate must not allocate")
for body in [fused, doubleBody, evenBody] {
    test.check(!test.contains(body, "@minyar_callback_") && !test.contains(body, "call i64 %") && !test.contains(body, "call zeroext i1 %") && !test.contains(body, "call ptr %"), "sequence transforms must not use callback lookup or indirect dispatch")
}
test.require(test.run([optimizer(frontend), "-passes=verify", "-disable-output", path + ".ll"], frontend.environment, "", path + ".verify", 30), "verify fused sequence LLVM")
io.writeTextFile("build/sequences-evidence.ll", llvm)
io.writeTextFile("build/sequences-loop.ll", fused)

io.writeTextFile(frontend.compiler.directory + "/sequence-transforms.min", test.sourceModules(#"""
    public function double(value: Integer): Integer { return value * 2 }
    public function even(value: Integer): Boolean { return value % 2 == 0 }
    public function add(total: Integer, value: Integer): Integer { return total + value }
    function secret(value: Integer): Integer { return value + 1 }
    """#))
let importedExpected = "43\n24\n"
fixtures.executes(frontend, #"""
    use "./sequence-transforms.min" as transforms
    function seed(left: Integer, right: Integer): Integer { return left + right }
    print([1, 2, 3].map(transforms.double).filter(transforms.even).fold((seed(10, (20 + 1))), transforms.add))
    let recipe = [1, 2, 3].map(transforms.double).filter(transforms.even)
    print(recipe.fold(
        (((seed((1 + 2), (4 + 5))))),
        transforms.add
    ))
    """#, importedExpected, levels, 0, "", true)
let importedPath = frontend.compiler.directory + "/case" + Text(frontend.compiler.serial)
let importedLLVM = io.readTextFile(importedPath + ".ll")
let prior = importedPath + ".empty.state"
io.writeTextFile(prior, "")
let moduleStats: List<Text> = []
for pass in ["cold", "warm"] {
    let base = importedPath + "." + pass
    test.require(test.run([frontend.compiler.executable, importedPath + ".min", base + ".ll", "--module-state", prior, base + ".state", base + ".stats", "--library", "library"], frontend.environment, "", base + ".compile", 30), "compile imported sequence callbacks through " + pass + " module state")
    let stats = io.readTextFile(base + ".stats")
    moduleStats.add(pass + ": " + stats)
    io.writeTextFile("build/sequences-module-stats.txt", joinText(moduleStats))
    test.check(stats == "0 2 2 0 0 0 false\n", "sequence " + pass + " module state must report feature fallback, not cached body reuse\n" + stats)
    test.check(io.readTextFile(base + ".state") == "", "sequence feature fallback must not publish unsupported cache interfaces")
    let moduleLLVM = io.readTextFile(base + ".ll")
    if test.addressEnabled(frontend.compiler.flags) { moduleLLVM = test.instrument(moduleLLVM) }
    test.check(moduleLLVM == importedLLVM, "sequence " + pass + " module-state LLVM differs from ordinary compilation")
    io.writeTextFile(base + ".ll", moduleLLVM)
    for level in levels {
        let command = [frontend.compiler.clang, level, "-Wno-override-module"]
        for flag in frontend.compiler.flags { command.add(flag) }
        for argument in [base + ".ll", importedPath + "-runtime.o", "-lm", "-o", base + ".exe"] { command.add(argument) }
        test.require(test.run(command, frontend.environment, "", base + ".link", 30), "link imported sequence callbacks through " + pass + " module state " + level)
        let result = test.run([base + ".exe"], frontend.environment, "", base + ".run", 30)
        test.check(result.status == 0 && result.output == importedExpected && result.errorOutput == "", "imported sequence callbacks changed under " + pass + " module state " + level + "\n" + result.output + result.errorOutput)
    }
    prior = base + ".state"
}
fixtures.rejects(frontend, "use \"./sequence-transforms.min\" as transforms\nlet recipe = [1].map(transforms.secret)\n", "'transforms.secret' is private to its module", true)

// Store each stage separately so this checks recipe depth rather than parser
// expression depth. The base collection does not consume a recipe stage.
function stageBoundary(stages: Integer, filters: Boolean): Text {
    let source: List<Text> = ["function keep(value: Integer): Boolean { return true }\nfunction same(value: Integer): Integer { return value }\nlet stage0 = [1, 2]\n"]
    for stage in 0..stages {
        let method = "map(same)"
        if filters { method = "filter(keep)" }
        source.add("let stage" + Text(stage + 1) + " = stage" + Text(stage) + "." + method + "\n")
    }
    source.add("let total = 0\nfor value in stage" + Text(stages) + " { total += value }\nprint(total)\n")
    return joinText(source)
}

fixtures.executes(frontend, stageBoundary(64, true), "3\n", levels, 0, "", true)
