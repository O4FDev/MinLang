use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

function functionSymbol(llvm: Text, name: Text): Text {
    let found = ""
    for line in test.lines(llvm) {
        if line.startsWith("define ") {
            let at = line.find("@")
            let end = line.find("(")
            if at >= 0 && end > at {
                let symbol = line.slice(at, end)
                if symbol == "@.minyar.fn." + name || symbol == "@.minyar.fn.minyar_module_0_" + name || symbol.startsWith("@\".minyar.fn.minyar.module|" + name + "|") {
                    test.check(found == "", "sequence LLVM has duplicate functions named " + name)
                    found = symbol
                }
            }
        }
    }
    test.check(found != "", "sequence LLVM has no function named " + name)
    return found
}

function functionBody(llvm: Text, symbol: Text): Text {
    let body: List<Text> = []
    let taking = false
    for line in test.lines(llvm) {
        if line.startsWith("define ") && test.contains(line, " " + symbol + "(") { taking = true }
        if taking {
            body.add(line + "\n")
            if line == "}" { return joinText(body) }
        }
    }
    fail("sequence LLVM function is missing or incomplete: " + symbol)
}

function occurrences(source: Text, needle: Text): Integer {
    let count = 0
    let at = source.find(needle)
    while at >= 0 {
        count += 1
        source = source.slice(at + needle.length, source.length)
        at = source.find(needle)
    }
    return count
}

function noMaterialization(body: Text): Boolean {
    return !test.contains(body, "@minyar_list_new") && !test.contains(body, "@minyar_list_add") && !test.contains(body, "@minyar_record_new") && !test.contains(body, "@minyar_bytes_new") && !test.contains(body, "@minyar_callback_check")
}

function optimizer(frontend: fixtures.Frontend): Text {
    let directory = test.setting("MINYAR_LLVM_BIN", "")
    let candidates: List<Text> = []
    if directory != "" { candidates.add(directory + "/opt") }
    else {
        let clang = frontend.compiler.clang
        let last = -1
        for index in 0..clang.length { if clang[index] == '/' { last = index } }
        if last >= 0 { candidates.add(clang.slice(0, last + 1) + "opt") }
        candidates.add("/usr/lib/llvm-23/bin/opt")
        candidates.add("opt-23")
        candidates.add("opt")
    }
    let command = ["/bin/sh", "-c", "for tool do if command -v \"$tool\"; then exit 0; fi; done; exit 1", "minyar"]
    for candidate in candidates { command.add(candidate) }
    let found = test.run(command, frontend.environment, "", frontend.compiler.directory + "/optimizer-tool", 10)
    test.check(found.status == 0 && found.output != "", "Required LLVM optimizer unavailable; set MINYAR_LLVM_BIN")
    return test.lines(found.output)[0]
}

