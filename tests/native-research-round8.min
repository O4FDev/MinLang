// Actual atlas and atmosphere modules. Graphics calls go to a strict CPU capture.
use "../examples/craft/textures.min" as textures
use "../examples/craft/atmosphere.min" as atmosphere
use "graphics" as graphics

function periodic(px: Integer, py: Integer, cx: Integer, cy: Integer, seed: Integer): Float { native "round8" }
function finish() { native "round8" }

function state(out: Bytes, sky: atmosphere.Sky) {
    out.addFloat64(sky.time)
    out.addFloat64(sky.red)
    out.addFloat64(sky.green)
    out.addFloat64(sky.blue)
    out.addFloat64(sky.light)
    out.addFloat64(sky.cloudDrift)
    out.addFloat64(sky.cloudTimer)
}

if argument(0) == "unexpected" {
    graphics.width()
    fail("unexpected graphics call returned")
}
let atlas = textures.build()
writeBytesFile("atlas.bin", atlas)
let coordinates = Bytes()
for block in 1..22 {
    coordinates.addFloat64(textures.iconU(block))
    coordinates.addFloat64(textures.iconV(block))
}
writeBytesFile("icons.bin", coordinates)
let probes = Bytes()
let points = [-17, -1, 0, 7, 15, 16, 31]
let cells = [1, 3, 4, 16, 2, 8, 8, 8, 4, 4]
for pair in 0..5 {
    for px in points { for py in points {
        probes.addFloat64(periodic(px, py, cells[pair * 2], cells[pair * 2 + 1], 37))
        probes.addFloat64(periodic(px + 16, py, cells[pair * 2], cells[pair * 2 + 1], 37))
        probes.addFloat64(periodic(px, py - 16, cells[pair * 2], cells[pair * 2 + 1], 37))
    } }
}
writeBytesFile("periodic.bin", probes)
let sky = atmosphere.create(0.0)
let states = Bytes()
state(states, sky)
// Quarter-day controls use zero seconds, avoiding cloud updates.
for phase in [0.25, 0.5, 0.75, 1.0] {
    sky.time = phase
    atmosphere.advance(sky, 0.0, 1.0)
    state(states, sky)
}
// A strict timer boundary and an exact day rollover in binary arithmetic.
sky.time = 0.999
sky.cloudTimer = 0.0
sky.cloudDrift = 0.0
atmosphere.advance(sky, 0.25, 2.4)
state(states, sky)
atmosphere.advance(sky, 0.000001, 0.0)
state(states, sky)
// Two uploads straddling one whole-cell drift; all production constants stay intact.
sky.cloudDrift = 11.6989988
sky.cloudTimer = 0.0
atmosphere.advance(sky, 0.250001, 0.0)
state(states, sky)
sky.cloudDrift = 11.7009988
sky.cloudTimer = 0.0
atmosphere.advance(sky, 0.250001, 0.0)
state(states, sky)
// Body/halo mesh at sunrise, noon and midnight, translated with the camera.
for phase in [0.0, 0.25, 0.75] {
    sky.time = phase
    atmosphere.advance(sky, 0.0, 1.0)
    atmosphere.draw(sky, 10.0, -3.0, 7.0)
}
atmosphere.drawClouds(sky)
writeBytesFile("states.bin", states)
finish()
