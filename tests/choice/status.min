use "peerwire" as wire
use "errors" as errors
function frame(raw: Bytes): wire.FrameResult {
    let decoder = wire.create()
    let fed = wire.feed(decoder, raw)
    if !errors.booleanOk(fed) { fail("fixture feed failed") }
    return wire.take(decoder)
}
let encoded = wire.makeStatus(1, "ok")
let accepted = wire.parseStatus(frame(errors.bytesValue(encoded)))
print(wire.statusOk(accepted))
print(wire.statusValue(accepted))
print(errors.code(wire.statusError(accepted)))
match accepted { AcceptedStatus(text) { print(text) } RejectedStatus(_) { print("bad") } }
let wrong = wire.encode(wire.DATA, 1, Bytes("bad"))
let rejected = wire.parseStatus(frame(errors.bytesValue(wrong)))
print(wire.statusOk(rejected))
print(errors.code(wire.statusError(rejected)))
match rejected { AcceptedStatus(_) { print("bad") } RejectedStatus(error) { print(errors.code(error)) } }
let saved = wire.statusValue(accepted)
accepted = wire.StatusResult.RejectedStatus(errors.make(10, 0, "replaced"))
print(saved)
