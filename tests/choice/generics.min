choice Branch<Item> {
    Leaf(value: Item)
    Fork(children: List<Branch<Item>>)
    Empty
}
function identity<Item>(value: Item): Item { return value }
function first<Item>(node: Branch<Item>, fallback: Item): Item {
    return match node {
        Leaf(value) { identity(value) }
        Fork(children) { first(children[0], fallback) }
        Empty { fallback }
    }
}
let number = Branch<Integer>.Leaf(42)
print(first(number, 0))
let words: Branch<Text> = Fork([Leaf("held"), Empty])
print(first(words, "missing"))
let empty: Branch<Text> = Empty
print(first(empty, "quiet"))
choice Pair<First, Second> { Both(first: First, second: Second); Neither }
let pair = Both(7, "days")
print(match pair { Both(n, word) { Text(n) + " " + word } Neither { "none" } })
let values: List<Branch<Integer>> = [Leaf(1), Empty, Branch<Integer>.Leaf(2)]
for value in values { print(first(value, 0)) }
let optional = identity(Some<Integer>(9))
print(match optional { Some(n) { identity(n) } None { 0 } })
let inferred = Some("inferred")
print(match inferred { Some(text) { text } None { "none" } })
let children: List<Branch<Integer>> = []
let cycle: Branch<Integer> = Fork(children)
children.add(cycle)
match cycle { Fork(values) { print(values.length) } else { print(0) } }
choice Action<Value> { Run(work: () -> Value); Idle }
let action: Action<Text> = Run(function() { return "action" })
print(match action { Run(work) { work() } Idle { "idle" } })
