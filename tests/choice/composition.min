choice Parcel {
    Words(values: List<Text>)
    Task(run: () -> Text)
    Response(value: Result<Text, Text>)
    Data(bytes: Bytes)
    Labels(values: Map<Text, Text>)
}
function read(parcel: Parcel): Text {
    match parcel {
        Words(values) { return joinText(values) }
        Task(run) { return run() }
        Response(value) { match value { Ok(text) { return text } Err(error) { return error } } }
        Data(bytes) { return Text(bytes) }
        Labels(values) { return values["name"] }
    }
}
let captured = ["task"]
let parcels: List<Parcel> = [Words(["words"]), Task(function() { return captured[0] }), Response(Ok("ok")), Data(Bytes("bytes")), Labels({"name": "map"})]
for parcel in parcels { print(read(parcel)) }
record Counter { value: Integer }
function next(counter: Counter): Integer { counter.value += 1; return counter.value }
choice Pair { Both(left: Integer, right: Integer) }
let counter = Counter { value: 0 }
match Both(next(counter), next(counter)) { Both(left, right) { print(left); print(right) } }
print(counter.value)
