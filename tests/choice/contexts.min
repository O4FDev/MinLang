let inferred = Some("inferred")
print(match inferred { Some(value) { value } None { "none" } })
let values: List<Maybe<Integer>> = []
values.add(None)
values.add(Some(42))
for value in values { print(match value { Some(n) { n } None { 0 } }) }
let extended = values.appended(None)
print(extended.length)
record Holder { value: Maybe<Text> }
function Holder.set(value: Maybe<Text>) { self.value = value }
function Holder.label(): Text { return "label" }
let holder = Holder { value: Some("old") }
holder.set(None)
print(match holder.value { Some(text) { text } None { "cleared" } })
let label = Some(holder.label())
print(match label { Some(text) { text } None { "none" } })
record Handler { apply: (Maybe<Integer>) -> Integer }
let handler = Handler { apply: function(value) { return match value { Some(n) { n } None { 7 } } } }
print(handler.apply(None))
function factory(): (Maybe<Integer>) -> Integer { return function(value) { return match value { Some(n) { n } None { 8 } } } }
print(factory()(None))
print(match Some(false) { Some(value) { value } None { true } })
print(match Some(0) { Some(value) { value } None { 1 } })
let words = Some("hello \(42)")
print(match words { Some(value) { value } None { "none" } })
let keyword = Some("match")
print(match keyword { Some(value) { value } None { "none" } })
let punctuation: List<Text> = []
punctuation.add(")")
print(punctuation[0])
