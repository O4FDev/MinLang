choice Color { Clear; Ink(name: Text) }
print(Color.Clear == Color.Clear)
print(Color.Clear < Color.Ink("a"))
let colors = [Color.Ink("z"), Color.Clear, Color.Ink("a")]
colors.sort()
for color in colors { print(match color { Clear { "clear" } Ink(name) { name } }) }
let entries: Map<Maybe<Text>, Integer> = Map()
entries[None] = 7
entries[Some("a")] = 42
print(entries[None])
print(entries[Some("a")])
print(entries.has(None))
let seen: Set<Maybe<Text>> = Set()
seen.add(None)
seen.add(Some("a"))
print(seen.contains(None))
print(seen.remove(None))
print(seen.length)
