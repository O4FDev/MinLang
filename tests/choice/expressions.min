function first(values: List<Text>): Maybe<Text> {
    if values.length == 0 { return None }
    return Some(values[0])
}
let present = first(["moon"])
let absent: Maybe<Text> = None
match present { Some(value) { print(value) } None { print("bad") } }
print(match present { Some(value) { value + "light" } None { "dark" } })
print(match absent { Some(value) { value } None { "quiet" } })
let numbers: List<Integer> = match None<Integer>() { Some(n) { [n] } None { [] } }
print(numbers.length)
print(match Some<Integer>(42) { Some(n) { n } else { 0 } })
let nested: Maybe<Maybe<Text>> = Some(Some("inside"))
print(match nested { Some(inner) { match inner { Some(text) { text } None { "none" } } } None { "outside" } })
let result: Result<Text, Text> = Ok("ok")
print(match result { Ok(text) { text } Err(error) { error } })
function save(): Result<Nothing, Text> { return Ok() }
print(match save() { Ok() { "saved" } else { "no" } })
let read: () -> Text = match present { Some(text) { function() { return text } } None { function() { return "empty" } } }
print(read())
record Counter { count: Integer }
function next(counter: Counter): Maybe<Integer> { counter.count += 1; return Some(counter.count) }
let counter = Counter { count: 0 }
print(40 + match next(counter) { Some(n) { n } None { 0 } } + 1)
print(counter.count)
record Holder { value: Maybe<Text> }
function replace(holder: Holder): Text { holder.value = None; return "kept " }
let holder = Holder { value: Some("alive") }
let text = match holder.value { Some(value) { replace(holder) + value } None { "lost" } }
print(text)
print(match holder.value { Some(_) { "wrong" } None { "empty" } })
function propagate(good: Boolean): Result<Integer, Text> {
    let input: Maybe<Result<Integer, Text>> = Some(Err("stopped"))
    if good { input = Some(Ok(42)) }
    return Ok(match input { Some(result) { try result } None { 0 } })
}
print(match propagate(true) { Ok(n) { Text(n) } Err(e) { e } })
print(match propagate(false) { Ok(n) { Text(n) } Err(e) { e } })
choice Measure { Point; Line(length: Integer) }
function Measure.length(): Integer { return match self { Point { 0 } Line(length) { length } } }
print(Measure.Line(42).length())
