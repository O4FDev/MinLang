choice Shape {
    Circle(radius: Float)
    Rectangle(width: Float, height: Float)
    Empty
}
function area(shape: Shape): Float {
    match shape {
        Circle(radius) { return 3.0 * radius * radius }
        Rectangle(width, height) { return width * height }
        Empty { return 0.0 }
    }
}
let shapes: List<Shape> = [Shape.Circle(2.0), Rectangle(3.0, 4.0), Empty]
for shape in shapes { print(area(shape)) }
match shapes[0] { Rectangle(_, _) { print("rectangle") } else { print("round") } }
choice Light { Dawn; Day; Dusk }
function name(light: Light): Text {
    match light { Dawn { return "dawn" } Day() { return "day" } Dusk { return "dusk" } }
}
print(name(Light.Dawn))
print(name(Day()))
print(name(Dusk))
