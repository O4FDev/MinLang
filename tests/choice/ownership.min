choice Tree { Leaf(text: Text); Branch(children: List<Tree>); Quiet }
function words(tree: Tree): Text {
    match tree {
        Leaf(text) { return text }
        Branch(children) {
            let result = ""
            for child in children { result += words(child) }
            return result
        }
        Quiet { return "" }
    }
}
function make(): Tree { return Branch([Leaf("hello"), Quiet, Tree.Leaf(" world")]) }
let tree = make()
let alias = tree
print(words(alias))
let read: () -> Text = function() { return words(tree) }
print(read())
let children: List<Tree> = []
let cycle = Branch(children)
children.add(cycle)
match cycle { Branch(values) { print(values.length) } else { print(0) } }
let saved = Leaf("before")
match saved {
    Leaf(text) { saved = Leaf("after"); print(text) }
    else { print("bad") }
}
print(words(saved))
let i = 0
while i < 3 {
    i += 1
    match make() { Leaf(_) { break } Branch(_) { continue } Quiet { break } }
}
print(i)
