choice Signal { Bright(value: Integer); Quiet }
record Schedule { choices: List<Integer>; choice: Integer }
function total(schedule: Schedule): Integer {
    let sum = 0
    for choice in schedule.choices { sum += choice }
    return sum
}
function choice(value: Integer): Integer { return value + 1 }
function increment(): Integer { let choice = 41; choice += 1; return choice }
function echo(choice: Integer): Integer { return choice }
let schedule = Schedule { choices: [20, 22]; choice: 7 }
print(total(schedule))
print(choice(41))
print(increment())
print(echo(schedule.choice))
for choice in schedule.choices { print(choice) }
match Bright(42) { Bright(choice) { print(choice) } Quiet { print(0) } }
