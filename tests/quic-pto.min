use "quic" as quic
use "quiccrypto" as protection
use "quicwire" as wire
use "quicrecovery" as recovery
use "quicretry" as retry
use "tlstickets" as tickets
use "errors" as errors
record Pair { client: quic.Connection; server: quic.Connection; acknowledgement: Bytes; valid: Boolean }
function drive(c: quic.Connection, s: quic.Connection, now: Integer) {
    for packet in quic.poll(c, now) { quic.receive(s, packet, now) }
    for packet in quic.poll(s, now) { quic.receive(c, packet, now) }
}
// Use genuine peer-generated Initial ACKs. Deliver ServerHello only when
// requested, and withhold every Handshake CRYPTO packet from the client.
function bootstrap(root: Bytes, identity: Bytes, key: Bytes, certificate: Bytes, clientKey: Bytes, keys: Boolean): Pair {
    let c = quic.client("localhost", randomBytes(80), "minyar-test", [root], [certificate], clientKey)
    let s = quic.server(randomBytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true)
    for packet in quic.poll(c, 0) { quic.receive(s, packet, 0) }
    let acknowledgement = Bytes(); let valid = true
    for packet in quic.poll(s, 100) {
        let header = wire.header(packet, 0, c.local.length)
        if header.kind == wire.INITIAL {
            let opened = protection.unprotect(c.spaces[0].read, packet.slice(0, header.end), header.numberOffset, c.spaces[0].largest)
            if !opened.valid { valid = false }
            else {
                let crypto = false; let ack = false
                for frame in wire.frames(opened.payload).frames {
                    if frame.type == 6 { crypto = true }
                    if frame.type == 2 || frame.type == 3 { ack = true }
                }
                if ack && !crypto { acknowledgement = packet; quic.receive(c, packet, 100) }
                else if keys && crypto { quic.receive(c, packet, 100) }
            }
        }
    }
    return Pair { client: c; server: s; acknowledgement: acknowledgement; valid: valid }
}
function noFlight(root: Bytes, identity: Bytes, key: Bytes, certificate: Bytes, clientKey: Bytes, keys: Boolean, acknowledge: Boolean): Integer {
    let pair = bootstrap(root, identity, key, certificate, clientKey, keys)
    let c = pair.client; let s = pair.server
    if !pair.valid || pair.acknowledgement.length == 0 || c.flight != 0 || c.spaces[0].sent.length != 0 || c.spaces[1].sent.length != 0 || c.state != quic.STARTING { return 40 }
    if (c.spaces[1].write.key.length > 0) != keys { return 40 }
    for packet in quic.poll(c, 100) { quic.receive(s, packet, 100) }
    let deadline = quic.nextTimer(c)
    if deadline <= 100 || deadline > 100 + recovery.pto(c.congestion, false) { print("no-flight client has no handshake alarm"); return 41 }
    // Both idle polling and duplicate authenticated Initial ACKs must leave
    // this absolute alarm fixed, even though the connection clock advances.
    for tick in 101..110 {
        if quic.nextTimer(c) != deadline { return 42 }
        quic.receive(c, pair.acknowledgement, tick)
        for packet in quic.poll(c, tick) { quic.receive(s, packet, tick) }
        if quic.nextTimer(c) != deadline { print("duplicate ACK or idle poll postponed handshake alarm"); return 42 }
    }
    let found = 0
    for packet in quic.poll(c, deadline) {
        let header = wire.header(packet, 0, s.local.length)
        let expected = wire.INITIAL; if keys { expected = wire.HANDSHAKE }
        if header.kind != expected { return 43 }
        if !keys && packet.length < 1200 { return 43 }
        let space = s.spaces[0]; if keys { space = s.spaces[1] }
        let opened = protection.unprotect(space.read, packet.slice(0, header.end), header.numberOffset, space.largest)
        if !opened.valid { return 43 }
        let eliciting = false
        for frame in wire.frames(opened.payload).frames {
            if frame.type != 0 && frame.type != 2 && frame.type != 3 && frame.type != 28 && frame.type != 29 { eliciting = true }
        }
        if eliciting { found += 1 }
        quic.receive(s, packet, deadline)
    }
    if found == 0 { print("no-flight handshake alarm did not send a probe"); return 43 }
    if !keys {
        let before = c.congestion.probes; let accepted = 0
        for packet in quic.poll(s, deadline + 1) {
            let header = wire.header(packet, 0, c.local.length)
            if header.kind == wire.INITIAL {
                let opened = protection.unprotect(c.spaces[0].read, packet.slice(0, header.end), header.numberOffset, c.spaces[0].largest)
                if !opened.valid { return 47 }
                let crypto = false; let ack = false
                for frame in wire.frames(opened.payload).frames { if frame.type == 6 { crypto = true }; if frame.type == 2 || frame.type == 3 { ack = true } }
                if ack && !crypto { quic.receive(c, packet, deadline + 1); accepted += 1 }
            }
        }
        if accepted == 0 || c.spaces[0].sent.length != 0 || c.handshakeAcknowledged { return 47 }
        if c.congestion.probes != before { print("Initial ACK reset client backoff before peer validation"); return 47 }
        return 0
    }
    if c.spaces[0].active { print("Handshake probe retained Initial space"); return 44 }
    if c.congestion.probes != 0 { print("Initial key discard retained handshake backoff"); return 48 }
    if !acknowledge {
        let next = quic.nextTimer(c)
        if next <= deadline { return 44 }
        quic.receive(c, pair.acknowledgement, deadline + 1)
        if quic.nextTimer(c) != next { return 44 }
        let probes = 0
        for packet in quic.poll(c, next) {
            let header = wire.header(packet, 0, s.local.length)
            if header.kind != wire.HANDSHAKE { return 44 }
            probes += 1
        }
        if probes == 0 { return 44 }
        return 0
    }
    let received = 0; let duplicate = Bytes()
    for packet in quic.poll(s, deadline + 1) {
        let header = wire.header(packet, 0, c.local.length)
        if header.kind == wire.HANDSHAKE {
            let opened = protection.unprotect(c.spaces[1].read, packet.slice(0, header.end), header.numberOffset, c.spaces[1].largest)
            if !opened.valid { return 45 }
            let crypto = false; let ack = false
            for frame in wire.frames(opened.payload).frames {
                if frame.type == 6 { crypto = true }
                if frame.type == 2 || frame.type == 3 { ack = true }
            }
            if ack && !crypto { quic.receive(c, packet, deadline + 1); duplicate = packet; received += 1 }
        }
    }
    if received == 0 || c.spaces[1].sent.length != 0 || c.flight != 0 || c.confirmed || c.spaces[1].largestAck < 0 { return 45 }
    if quic.nextTimer(c) != c.lastActivity + c.idleTimeout { print("valid Handshake ACK left a no-flight alarm"); return 46 }
    quic.receive(c, duplicate, deadline + 2); quic.poll(c, deadline + 2)
    if quic.nextTimer(c) != c.lastActivity + c.idleTimeout { return 46 }
    return 0
}
function application(root: Bytes, identity: Bytes, key: Bytes, certificate: Bytes, clientKey: Bytes): Integer {
    let store = tickets.store(randomBytes(16), 3600); tickets.allowEarlyData(store, 0xffffffff)
    let initial = quic.client("localhost", randomBytes(80), "minyar-test", [root], [certificate], clientKey)
    let issuer = quic.serverWithTickets(randomBytes(80), "minyar-test", initial.originalDestination, [identity], key, [root], true, store)
    for tick in 0..100 { drive(initial, issuer, tick * 10) }
    let ticket = quic.takeTicket(initial); if !ticket.valid { return 50 }
    let c = quic.clientEarly("localhost", randomBytes(80), "minyar-test", [root], [certificate], clientKey, ticket)
    let s = quic.serverWithTickets(randomBytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true, store)
    for request in 0..16 {
        let id = errors.integerValue(quic.openEarlyStream(c, false))
        quic.writeEarlyStream(c, id, Bytes(257), true)
    }
    for packet in quic.poll(c, 0) {
        let header = wire.header(packet, 0, s.local.length)
        if header.kind == wire.INITIAL { quic.receive(s, packet, 0) }
    }
    if c.earlyPackets < 8 || c.confirmed || c.spaces[1].write.key.length != 0 { return 50 }
    let next = c.spaces[2].next; let deadline = c.spaces[0].probe
    if deadline <= 0 { return 50 }
    let initialProbe = 0
    for packet in quic.poll(c, deadline) {
        let header = wire.header(packet, 0, s.local.length)
        if header.kind == wire.ZERO_RTT || header.kind == wire.ONE_RTT { print("application PTO fired before confirmation"); return 51 }
        if header.kind == wire.INITIAL && packet.length >= 1200 { initialProbe += 1 }
    }
    if initialProbe == 0 || c.spaces[2].next != next || c.congestion.probes != 1 { return 52 }
    let fixed = quic.nextTimer(c)
    for packet in quic.poll(c, deadline) {
        let kind = wire.header(packet, 0, s.local.length).kind
        if kind == wire.ZERO_RTT || kind == wire.ONE_RTT { return 51 }
    }
    if c.spaces[2].next != next || quic.nextTimer(c) != fixed || c.congestion.probes != 1 { return 52 }
    // A shared backoff can postpone an incorrectly armed application timer
    // past the first poll. Its next actual expiry must also stay in Initial.
    for packet in quic.poll(c, fixed) {
        let kind = wire.header(packet, 0, s.local.length).kind
        if kind == wire.ZERO_RTT || kind == wire.ONE_RTT { return 51 }
    }
    if c.spaces[2].next != next || c.congestion.probes != 2 { return 52 }
    return 0
}
function acknowledgeApplication(sender: quic.Connection, receiver: quic.Connection, number: Integer, now: Integer) {
    let frame = Bytes(); frame.add(2)
    frame.addBytes(errors.bytesValue(wire.encode(number))); frame.add(0); frame.add(0); frame.add(0)
    let space = sender.spaces[2]; let header = Bytes(); header.add(0x43); header.addBytes(sender.remote)
    for byte in 0..4 { header.add((space.next >> ((3-byte)*8)) & 255) }
    let packet = errors.bytesValue(protection.protect(space.write, header, header.length-4, space.next, frame)); space.next += 1
    quic.receive(receiver, packet, now)
}
// Accept early data with actual TLS keys, but block the queued client
// Finished with the bounded admission state used below. Authenticated
// application ACKs do not prove the peer has validated the client's address.
function applicationAck(root: Bytes, identity: Bytes, key: Bytes, certificate: Bytes, clientKey: Bytes): Integer {
    let store = tickets.store(randomBytes(16), 3600); tickets.allowEarlyData(store, 0xffffffff)
    let initial = quic.client("localhost", randomBytes(80), "minyar-test", [root], [certificate], clientKey)
    let issuer = quic.serverWithTickets(randomBytes(80), "minyar-test", initial.originalDestination, [identity], key, [root], true, store)
    for tick in 0..100 { drive(initial, issuer, tick * 10) }
    let ticket = quic.takeTicket(initial); if !ticket.valid { return 55 }
    let c = quic.clientEarly("localhost", randomBytes(80), "minyar-test", [root], [certificate], clientKey, ticket)
    let s = quic.serverWithTickets(randomBytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true, store)
    for request in 0..16 { let id = errors.integerValue(quic.openEarlyStream(c, false)); quic.writeEarlyStream(c, id, Bytes(257), true) }
    for packet in quic.poll(c, 0) { quic.receive(s, packet, 0) }
    for attempt in 0..3 {
        let due = quic.nextTimer(c)
        for packet in quic.poll(c, due) {
            if wire.header(packet, 0, s.local.length).kind != wire.INITIAL { return 55 }
            quic.receive(s, packet, due)
        }
    }
    if c.spaces[2].sent.length < 3 || c.congestion.probes != 3 { return 55 }
    let responseAt = c.now + 100
    let actual = c.spaces[2].sent[c.spaces[2].sent.length-1]
    for packet in quic.poll(s, responseAt) { quic.receive(c, packet, responseAt) }
    if c.state != quic.ESTABLISHED || c.confirmed || c.handshakeAcknowledged || c.spaces[1].write.key.length == 0 { return 55 }
    c.history = [actual]
    while c.history.length < 8192 { c.history.add(actual) }
    quic.poll(c, responseAt)
    if c.spaces[0].active || c.spaces[1].sent.length != 0 || c.handshakeProbe <= responseAt { return 55 }
    if c.congestion.probes != 0 || c.handshakeProbe != responseAt + recovery.pto(c.congestion, false) {
        print("Initial key discard retained a backed-off no-flight deadline"); return 58
    }
    for attempt in 0..3 { quic.poll(c, quic.nextTimer(c)) }
    if c.congestion.probes != 3 || c.spaces[1].sent.length != 0 { return 55 }
    let alarmAt = c.now; let deadline = c.handshakeProbe
    for index in 0..3 {
        let number = c.spaces[2].sent[0].number
        acknowledgeApplication(s, c, number, alarmAt + 10 + index)
        if c.handshakeProbe != deadline { print("application ACK postponed independent handshake alarm"); return 53 }
        if c.congestion.probes != 3 { print("application ACK reset unvalidated client backoff"); return 54 }
        quic.poll(c, alarmAt + 10 + index)
        if c.handshakeProbe != deadline { return 53 }
    }
    // Independently control one existing flight timer, as the retained-history
    // loss-classifier fixture does. An unrelated ACK must not reactivate it.
    c.history = [actual]; quic.poll(c, alarmAt + 14)
    if c.spaces[1].sent.length == 0 || c.handshakeAcknowledged { return 57 }
    c.spaces[1].probe = -1
    acknowledgeApplication(s, c, c.spaces[2].sent[0].number, alarmAt + 15)
    if c.spaces[1].probe != -1 { print("application ACK rearmed a disabled Handshake flight timer"); return 56 }
    return 0
}
function confirmed(root: Bytes, identity: Bytes, key: Bytes, certificate: Bytes, clientKey: Bytes): Integer {
    let c = quic.client("localhost", randomBytes(80), "minyar-test", [root], [certificate], clientKey)
    let s = quic.server(randomBytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true)
    for tick in 0..100 { drive(c, s, tick * 10) }
    if !c.confirmed || c.spaces[0].active || c.spaces[1].active || c.spaces[2].sent.length != 0 { return 60 }
    quic.ping(c); quic.poll(c, 1200)
    let deadline = quic.nextTimer(c); let next = c.spaces[2].next
    if deadline != c.spaces[2].probe || deadline <= 1200 { return 60 }
    quic.poll(c, deadline - 1)
    if c.spaces[2].next != next { return 61 }
    let probes = 0
    for packet in quic.poll(c, deadline) { if wire.header(packet, 0, s.local.length).kind == wire.ONE_RTT { probes += 1 } }
    if probes == 0 || c.spaces[2].next == next { return 61 }
    return 0
}
// Deliver three genuine Initial datagrams before server output, giving
// sufficient amplification credit without changing address validation.
function sharedBackoff(root: Bytes, identity: Bytes, key: Bytes, certificate: Bytes, clientKey: Bytes, late: Boolean): Integer {
    let c = quic.client("localhost", randomBytes(80), "minyar-test", [root], [certificate], clientKey)
    let s = quic.server(randomBytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true)
    for packet in quic.poll(c, 0) { quic.receive(s, packet, 0) }
    for attempt in 0..2 {
        let due = quic.nextTimer(c)
        for packet in quic.poll(c, due) { quic.receive(s, packet, due) }
    }
    let sentAt = c.now + 1; quic.poll(s, sentAt)
    if s.addressValidated || s.spaces[0].sent.length == 0 || s.spaces[1].sent.length == 0 ||
       s.spaces[0].probe != s.spaces[1].probe || s.congestion.probes != 0 { return 65 }
    let due = quic.nextTimer(s); if late { due += 5000 }
    let before = s.spaces[0].next + s.spaces[1].next
    let packets = quic.poll(s, due)
    if packets.length == 0 || s.spaces[0].next + s.spaces[1].next <= before || s.congestion.probes != 1 { return 65 }
    let next = quic.nextTimer(s); let numbers = s.spaces[0].next + s.spaces[1].next
    if next <= due { print("unselected space retained expired shared PTO"); return 66 }
    quic.poll(s, due)
    if s.congestion.probes != 1 || quic.nextTimer(s) != next || s.spaces[0].next + s.spaces[1].next != numbers {
        print("shared PTO backoff advanced twice at one clock"); return 66
    }
    return 0
}
function closing(root: Bytes, identity: Bytes, key: Bytes, certificate: Bytes, clientKey: Bytes, drain: Boolean): Integer {
    let pair = bootstrap(root, identity, key, certificate, clientKey, true)
    let c = pair.client; let s = pair.server
    if !pair.valid || c.spaces[1].write.key.length == 0 { return 70 }
    if drain {
        quic.close(s, 0, Bytes("finished"))
        for packet in quic.poll(s, 101) { quic.receive(c, packet, 101) }
        if !c.draining { return 70 }
    } else {
        quic.close(c, 0, Bytes("finished")); quic.poll(c, 101)
        if !c.closing { return 70 }
    }
    let deadline = quic.nextTimer(c)
    if deadline != c.closeUntil { return 71 }
    let before = c.spaces[1].next
    if quic.poll(c, deadline).length != 0 || c.spaces[1].next != before || quic.nextTimer(c) != -1 || !quic.release(c) || quic.nextTimer(c) != -1 { return 71 }
    return 0
}
function retried(root: Bytes, identity: Bytes, key: Bytes, certificate: Bytes, clientKey: Bytes): Integer {
    let c = quic.client("localhost", randomBytes(80), "minyar-test", [root], [certificate], clientKey)
    let store = retry.store(randomBytes(16), 30000); let address = Bytes("127.0.0.1:50001")
    let first = quic.poll(c, 0); if first.length == 0 { return 80 }
    let old = quic.nextTimer(c)
    let response = retry.reply(store, first[0], address, randomBytes(8), 100)
    if !errors.bytesOk(response) { return 80 }
    c.congestion.probes = 3
    quic.receive(c, errors.bytesValue(response), 100)
    if !c.retryAccepted || c.congestion.probes != 0 { return 80 }
    quic.poll(c, 100)
    let deadline = quic.nextTimer(c)
    if deadline != c.spaces[0].probe || deadline <= old { print("Retry retained the old handshake deadline"); return 81 }
    if quic.poll(c, old).length != 0 || quic.nextTimer(c) != deadline { return 81 }
    let probes = quic.poll(c, deadline)
    if probes.length == 0 { return 81 }
    for packet in probes { if wire.header(packet, 0, c.local.length).kind != wire.INITIAL || packet.length < 1200 { return 81 } }
    return 0
}
// Fill the existing history admission budget with retained actual-send
// references, independently of packet flight. This is a bounded admission
// state adversary, not a claim of 8192 distinct peer packets.
function blockedProbe(root: Bytes, identity: Bytes, key: Bytes, certificate: Bytes, clientKey: Bytes): Integer {
    let c = quic.client("localhost", randomBytes(80), "minyar-test", [root], [certificate], clientKey)
    let s = quic.server(randomBytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true)
    for packet in quic.poll(c, 0) { quic.receive(s, packet, 0) }
    for packet in quic.poll(s, 100) {
        let header = wire.header(packet, 0, c.local.length)
        if header.kind == wire.INITIAL {
            let opened = protection.unprotect(c.spaces[0].read, packet.slice(0, header.end), header.numberOffset, c.spaces[0].largest)
            if !opened.valid { return 82 }
            let crypto = false
            for frame in wire.frames(opened.payload).frames { if frame.type == 6 { crypto = true } }
            if crypto { quic.receive(c, packet, 100) }
        }
    }
    if c.spaces[0].sent.length == 0 || c.spaces[1].write.key.length == 0 || c.spaces[1].sent.length != 0 { return 82 }
    let actual = c.spaces[0].sent[0]
    while c.history.length < 8192 { c.history.add(actual) }
    quic.poll(c, 100)
    let deadline = quic.nextTimer(c)
    if deadline <= 100 { return 82 }
    quic.poll(c, deadline)
    let next = quic.nextTimer(c); let queued = c.pending.length; let probes = c.congestion.probes
    if next <= deadline || queued == 0 || probes != 1 { print("blocked probe retained an expired timer"); return 83 }
    quic.poll(c, deadline)
    if quic.nextTimer(c) != next || c.pending.length != queued || c.congestion.probes != probes { return 83 }
    // Releasing the admission obstruction sends the already queued probe.
    c.history = [actual]
    let handshake = 0
    for packet in quic.poll(c, deadline + 1) {
        if wire.header(packet, 0, s.local.length).kind == wire.HANDSHAKE { handshake += 1 }
        quic.receive(s, packet, deadline + 1)
    }
    if handshake == 0 || !s.addressValidated { return 84 }
    return 0
}
function idle(root: Bytes, identity: Bytes, key: Bytes, certificate: Bytes, clientKey: Bytes, slow: Boolean): Integer {
    let c = quic.client("localhost", randomBytes(80), "minyar-test", [root], [certificate], clientKey)
    let s = quic.server(randomBytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true)
    for tick in 0..100 { drive(c, s, tick * 10) }
    if !c.confirmed || c.spaces[2].sent.length != 0 || c.pending.length != 0 { return 100 }
    c.congestion.measured = true; c.congestion.smoothed = 2000; c.congestion.variance = 1000; c.congestion.probes = 0
    if slow {
        c.idleTimeout = 1000
        let deadline = c.lastActivity + 3 * recovery.pto(c.congestion, true)
        if quic.nextTimer(c) != deadline { return 101 }
        if quic.poll(c, deadline - 1).length != 0 || c.state != quic.ESTABLISHED { return 102 }
        if quic.poll(c, deadline).length != 0 || c.state != quic.CLOSED || quic.nextTimer(c) != -1 { return 103 }
        return 0
    }
    quic.ping(s)
    for packet in quic.poll(s, 1100) { quic.receive(c, packet, 1100) }
    if c.lastActivity != 1100 { return 104 }
    let acknowledgements = quic.poll(c, 1130)
    if acknowledgements.length == 0 || c.lastActivity != 1100 || c.spaces[2].sent.length != 0 { return 104 }
    for packet in acknowledgements { quic.receive(s, packet, 1130) }
    quic.ping(c)
    let first = quic.poll(c, 1200)
    if first.length == 0 || c.lastActivity != 1200 { return 105 }
    quic.ping(c)
    if quic.poll(c, 1300).length == 0 || c.lastActivity != 1200 { return 106 }
    for packet in first { quic.receive(s, packet, 1400) }
    for packet in quic.poll(s, 1430) { quic.receive(c, packet, 1430) }
    if c.lastActivity != 1430 { return 107 }
    c.congestion.window = 0
    quic.ping(c)
    if quic.poll(c, 1500).length != 0 || c.lastActivity != 1430 { return 108 }
    c.congestion.window = 12000
    if quic.poll(c, 1600).length == 0 || c.lastActivity != 1600 { return 109 }
    return 0
}
function initialBurst(root: Bytes,identity: Bytes,key: Bytes,certificate: Bytes,clientKey: Bytes): Integer {
    let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[certificate],clientKey)
    let s=quic.server(randomBytes(80),"minyar-test",c.originalDestination,[identity],key,[root],true)
    let first=quic.poll(c,0);if first.length!=1 { return 110 }
    let header=wire.header(first[0],0,s.local.length)
    let original=protection.unprotect(s.spaces[0].read,first[0],header.numberOffset,-1)
    let expected=Bytes()
    for frame in wire.frames(original.payload).frames { if frame.type==6 { expected=frame.data } }
    let deadline=quic.nextTimer(c);let outgoing=quic.poll(c,deadline)
    if outgoing.length!=2 || c.congestion.probes!=1 || c.spaces[0].sent.length!=3 || c.flight!=3600 { return 110 }
    let number=0
    for data in outgoing {
        let h=wire.header(data,0,s.local.length)
        let opened=protection.unprotect(s.spaces[0].read,data,h.numberOffset,-1)
        if !h.valid || h.kind!=wire.INITIAL || data.length!=1200 || !opened.valid || opened.number<=number { return 111 }
        number=opened.number;let count=0
        for frame in wire.frames(opened.payload).frames { if frame.type==6 {
            count+=1;if frame.offset!=0 || frame.data.length!=expected.length { return 111 }
            for at in 0..expected.length { if frame.data[at]!=expected[at] { return 111 } }
        } }
        if count!=1 { return 111 }
    }
    if c.spaces[0].probe!=deadline+recovery.pto(c.congestion,false) { return 111 }
    return 0
}
function serverCredit(root: Bytes,identity: Bytes,key: Bytes,certificate: Bytes,clientKey: Bytes): Integer {
    let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[certificate],clientKey)
    let chain=[identity];for count in 0..9 { chain.add(root) }
    let s=quic.server(randomBytes(80),"minyar-test",c.originalDestination,chain,key,[root],true)
    for data in quic.poll(c,0) { quic.receive(s,data,0) }
    for data in quic.poll(s,1) { quic.receive(c,data,1) }
    quic.poll(c,1)
    let before=s.sentBytes;let credit=3*s.receivedBytes-before
    if s.addressValidated || s.spaces[1].sendCrypto<7500 || credit<64 || credit>=1200 || c.spaces[1].read.key.length==0 { return 112 }
    let deadline=quic.nextTimer(s);let outgoing=quic.poll(s,deadline);let bytes=0;let pings=0
    for data in outgoing {
        bytes+=data.length;let h=wire.header(data,0,c.local.length)
        if !h.valid || h.kind!=wire.HANDSHAKE { return 113 }
        let opened=protection.unprotect(c.spaces[1].read,data,h.numberOffset,c.spaces[1].largest)
        if !opened.valid { return 113 }
        for frame in wire.frames(opened.payload).frames {
            if frame.type==1 { pings+=1 } else if frame.type!=0 { return 113 }
        }
        quic.receive(c,data,deadline)
    }
    if pings!=1 || bytes>credit || s.sentBytes!=before+bytes || s.paths[0].sent!=s.sentBytes { return 113 }
    for data in quic.poll(c,deadline) { quic.receive(s,data,deadline) }
    if !s.addressValidated { return 114 }
    for data in quic.poll(s,deadline+1) { quic.receive(c,data,deadline+1) }
    if c.state!=quic.ESTABLISHED { print("small probe did not unblock the certificate flight");return 114 }
    return 0
}
function serverPaired(root: Bytes,identity: Bytes,key: Bytes,certificate: Bytes,clientKey: Bytes): Integer {
    let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[certificate],clientKey)
    let s=quic.server(randomBytes(80),"minyar-test",c.originalDestination,[identity],key,[root],true)
    for data in quic.poll(c,0) { quic.receive(s,data,0) }
    let expected=[Bytes(),Bytes()]
    for data in quic.poll(s,1) {
        let h=wire.header(data,0,c.local.length);let level=0;if h.kind==wire.HANDSHAKE { level=1 }
        if !h.valid || (h.kind!=wire.INITIAL && h.kind!=wire.HANDSHAKE) { return 115 }
        let opened=protection.unprotect(s.spaces[level].write,data.slice(0,h.end),h.numberOffset,-1)
        if !opened.valid { return 115 }
        let crypto=false
        for frame in wire.frames(opened.payload).frames { if frame.type==6 {
            crypto=true;if frame.offset==0 && expected[level].length==0 { expected[level]=frame.data }
        } }
        if level==1 || !crypto { quic.receive(c,data,1) }
    }
    if expected[0].length==0 || expected[1].length==0 || s.spaces[0].sent.length==0 || s.spaces[1].sent.length==0 || c.spaces[1].read.key.length!=0 { return 115 }
    let now=1
    for round in 0..4 {
        let due=s.spaces[0].probe
        if due<=now || due>=60000 || s.spaces[1].probe!=due { return 116 }
        for data in quic.poll(c,due) { quic.receive(s,data,due) }
        let before=s.congestion.probes;let counts=[0,0]
        for data in quic.poll(s,due) {
            let h=wire.header(data,0,c.local.length);let level=0;if h.kind==wire.HANDSHAKE { level=1 }
            if !h.valid || (h.kind!=wire.INITIAL && h.kind!=wire.HANDSHAKE) { return 117 }
            let opened=protection.unprotect(s.spaces[level].write,data.slice(0,h.end),h.numberOffset,-1)
            if !opened.valid { return 117 }
            let crypto=false
            for frame in wire.frames(opened.payload).frames { if frame.type==6 {
                crypto=true;counts[level]+=1
                if frame.offset!=0 || frame.data.length!=expected[level].length { return 117 }
                for at in 0..frame.data.length { if frame.data[at]!=expected[level][at] { return 117 } }
            } }
            if level==0 && crypto && data.length!=1200 { return 117 }
            if round==3 || level==1 || !crypto { quic.receive(c,data,due) }
        }
        if counts[0]!=1 || counts[1]!=1 || s.congestion.probes!=before+1 { return 116 }
        if s.sentBytes>3*s.receivedBytes || s.paths[0].sent>3*s.paths[0].received { return 118 }
        let next=due+recovery.pto(s.congestion,false)
        if s.spaces[0].probe!=next || s.spaces[1].probe!=next { return 116 }
        if round<3 && c.spaces[1].read.key.length!=0 { return 118 }
        now=due
    }
    for tick in 1..201 { drive(c,s,now+tick*10) }
    if c.state!=quic.ESTABLISHED || s.state!=quic.ESTABLISHED || !c.confirmed || !s.confirmed || !s.addressValidated || s.spaces[0].active || s.spaces[1].active { return 119 }
    return 0
}
function main(): Integer {
    let root = readBytesFile(argument(0)); let identity = readBytesFile(argument(1)); let key = readBytesFile(argument(2))
    let certificate = readBytesFile(argument(3)); let clientKey = readBytesFile(argument(4)); let mode = argument(5)
    let result = 90
    if mode == "initial" { result = noFlight(root, identity, key, certificate, clientKey, false, false) }
    else if mode == "handshake" { result = noFlight(root, identity, key, certificate, clientKey, true, false) }
    else if mode == "handshake-ack" { result = noFlight(root, identity, key, certificate, clientKey, true, true) }
    else if mode == "application" { result = application(root, identity, key, certificate, clientKey) }
    else if mode == "application-ack" { result = applicationAck(root, identity, key, certificate, clientKey) }
    else if mode == "confirmed" { result = confirmed(root, identity, key, certificate, clientKey) }
    else if mode == "shared" { result = sharedBackoff(root, identity, key, certificate, clientKey, false) }
    else if mode == "shared-late" { result = sharedBackoff(root, identity, key, certificate, clientKey, true) }
    else if mode == "close" { result = closing(root, identity, key, certificate, clientKey, false) }
    else if mode == "drain" { result = closing(root, identity, key, certificate, clientKey, true) }
    else if mode == "retry" { result = retried(root, identity, key, certificate, clientKey) }
    else if mode == "blocked-probe" { result = blockedProbe(root, identity, key, certificate, clientKey) }
    else if mode == "idle-send" { result = idle(root, identity, key, certificate, clientKey, false) }
    else if mode == "idle-pto" { result = idle(root, identity, key, certificate, clientKey, true) }
    else if mode == "initial-burst" { result = initialBurst(root, identity, key, certificate, clientKey) }
    else if mode == "server-credit" { result = serverCredit(root, identity, key, certificate, clientKey) }
    else if mode == "server-paired" { result = serverPaired(root, identity, key, certificate, clientKey) }
    if result == 0 { print("QUIC PTO " + mode + " passed") }
    return result
}
