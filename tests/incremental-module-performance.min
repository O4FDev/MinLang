use "../tools/testing.min" as test
use "./performance-support.min" as metrics
use "./incremental-performance-support.min" as driver
function main(): Integer {
    if argumentCount() == 1 && (argument(0) == "--help" || argument(0) == "-h") {
        print("incremental-module-performance [--sizes N ...] [--shapes chain wide shared] [--repeats N] [--compiler PATH] [--clang PATH] [--output PATH] [--link] [--enforce] [--prepare-only | --run-prepared MANIFEST | --functional]")
        return 0
    }
    let work = test.scratch()
    let rootResult = metrics.capture(["/bin/pwd", "-P"], work + "/root"); test.require(rootResult, "incremental performance root")
    let root = test.lines(rootResult.output)[0]; let options = driver.options(root, metrics.darwin(work + "/platform"))
    test.removeTree(work)
    if options.prepare { driver.prepare(options, root); return 0 }
    let context = driver.context(options, root)
    driver.run(context)
    if options.prepared == "" { test.removeTree(context.work) }
    return 0
}
