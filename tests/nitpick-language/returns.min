function one(): Integer { if true { return 1 } }
function two(): Integer { if false {} else { return 2 } }
function three(): Integer { if true { return 3 } else { print("unreachable") } }
function four(): Integer { if false { print("unreachable") } else if true { return 4 } }
function five(): Integer { while true { if false { break }; return 5 } }
function six(): Integer { while true { while false { break }; break }; return 6 }
function seven(): Integer { if true { if false {} else { return 7 } } }
function spin(): Integer { while true { if false { break } } }
function spinElse(): Integer { while true { if true {} else { break } } }
function spinNested(): Integer { while true { while false { if true { break } } } }
print(one())
print(two())
print(three())
print(four())
print(five())
print(six())
print(seven())
