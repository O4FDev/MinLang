use "./callbacks-values.min" as values
record Handler { callback: Callback<Integer, Integer> }
global NEXT: Callback<Integer, Integer> = function(value: Integer): Integer { return value + 1 }
function factory(): Callback<Integer, Integer> {
    return function(value: Integer): Integer { return value + 1 }
}
function textFactory(): Callback<Text, Text> {
    let prefix = "kept"
    return function(suffix: Text): Text { return prefix + suffix }
}
let handler = Handler { callback: factory() }
let callbacks = [factory()]
let table: Map<Integer, Callback<Integer, Integer>> = { 1: factory() }
print(handler.callback(41))
print(callbacks[0](42))
print(factory()(43))
print((handler.callback)(44))
print((function(value: Integer): Integer { return value + 1 })(45))
print(NEXT(46))
print(values.NEXT(47))
print(table[1](48))
print(textFactory()("!"))
