record Payload { text: Text }
record Holder { callback: Callback<Integer, Text>; callbacks: List<Callback<Integer, Text>>; events: Text }
function make(text: Text): Callback<Integer, Text> {
    let payload = Payload { text: text }
    return function(value: Integer): Text { return payload.text + ":" + Text(value) }
}
function select(holder: Holder): Holder { holder.events += "S"; return holder }
function replace(holder: Holder): Integer {
    holder.events += "A"
    holder.callback = make("new")
    for n in 0..100 { let discarded = Bytes(100) }
    return 7
}
function position(holder: Holder): Integer { holder.events += "I"; return 0 }
function clear(holder: Holder): Integer {
    holder.events += "B"
    holder.callbacks.clear()
    for n in 0..100 { let discarded = Bytes(100) }
    return 9
}
let holder = Holder { callback: make("old"); callbacks: [make("list")]; events: "" }
print(select(holder).callback(replace(holder)))
print(holder.events)
holder.events = ""
print(holder.callbacks[position(holder)](clear(holder)))
print(holder.events)
print(holder.callback(1))
holder.callbacks = [make("index")]
let mutate = function(): Integer {
    holder.callbacks = [make("replacement")]
    return 0
}
print(holder.callbacks[(mutate)()](2))
print(holder.callbacks[0](3))
