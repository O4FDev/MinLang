use "../tools/testing.min" as test
function find(source: Text, needle: Text, start: Integer): Integer {
    let raw = Bytes(source)
    let pattern = Bytes(needle)
    if raw.length < pattern.length { return -1 }
    for position in start..(raw.length - pattern.length + 1) {
        let equal = true
        for index in 0..pattern.length { if raw[position + index] != pattern[index] { equal = false; break } }
        if equal { return position }
    }
    return -1
}
public function withoutFusion(source: Text): Text {
    let anchor = find(source, "/* With one unvisited unary record", 0)
    test.check(anchor >= 0, "missing unary fusion reference anchor")
    let begin = find(source, "                            for (;;) {", anchor)
    test.check(begin >= 0, "missing unary fusion continuation")
    let ending = find(source, "\n                            continue;", begin)
    test.check(ending > begin, "missing unary fusion continuation boundary")
    let raw = Bytes(source)
    let body = Text(raw.slice(begin, ending))
    let occurrences = 0
    let position = 0
    while true {
        let matched = find(body, "work += 2;", position)
        if matched < 0 { break }
        occurrences += 1
        position = matched + Bytes("work += 2;").length
    }
    test.check(occurrences == 2, "unary fusion reference must contain two work increments")
    let canonical = "                            rc_bounded_recent_turn ^= 1;\n                            if (map[0] & 1) rc_drop((void *)(uintptr_t)record->values[0]);\n                            rc_bounded_recent_turn ^= 1;\n                            rc_bounded_finish_object(single, RC_RECORD);\n                            rc_pending_count--;\n                            rc_bounded_active = NULL;\n                            work += 2;"
    return Text(raw.slice(0, begin)) + canonical + Text(raw.slice(ending, raw.length))
}
