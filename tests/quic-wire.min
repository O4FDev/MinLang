use "quicwire" as wire
use "crypto" as crypto
use "errors" as errors

function main(): Integer {
    let corpus = readBytesFile(argument(1))
    let at = 0
    while at + 4 <= corpus.length {
        let size = (corpus[at] << 24) | (corpus[at + 1] << 16) | (corpus[at + 2] << 8) | corpus[at + 3]
        at += 4
        if size > corpus.length - at { return 1 }
        let data = corpus.slice(at, at + size); at += size
        if argument(0) == "varint" {
            let result = wire.varint(data, 0)
            if !result.valid { print("rejected") }
            else { print(Text(result.value) + " " + Text(result.end)) }
        } else if argument(0) == "frames" {
            let result = wire.frames(data)
            if !result.valid { print("rejected") }
            else {
                let parts: List<Text> = []
                for frame in result.frames {
                    parts.add(Text(frame.type) + ":" + Text(frame.stream) + ":" + Text(frame.offset) + ":" + Text(frame.fin) + ":" + Text(frame.value) + ":" + crypto.hex(frame.data) + ";")
                }
                print("ok " + joinText(parts))
            }
        } else if argument(0) == "header" {
            let result = wire.header(data, 0, 8)
            if !result.valid { print("rejected") }
            else { print(Text(result.kind) + " " + Text(result.end) + " " + Text(result.numberOffset)) }
        } else if argument(0) == "destination" {
            let result = wire.destinationId(data, 8)
            if !errors.bytesOk(result) { print("rejected") } else { print(crypto.hex(errors.bytesValue(result))) }
        } else if argument(0) == "negotiate" {
            let result = wire.negotiateVersion(data)
            if !errors.bytesOk(result) { print("rejected") } else { let data = errors.bytesValue(result); print(crypto.hex(data.slice(1, data.length))) }
        } else if argument(0) == "parameters" {
            let result = wire.parameters(data, false)
            if !result.valid { print("rejected") }
            else { print("ok " + Text(result.parameters.length)) }
        }
    }
    if at != corpus.length { return 2 }
    return 0
}
