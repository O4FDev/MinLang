record Leaf { label: Text; values: List<Integer> }
record Branch { left: Leaf; right: Leaf }

function makeLeaf(label: Text, value: Integer): Leaf {
    let values: List<Integer> = []
    values.add(value)
    values.add(value + 1)
    return Leaf { label: label; values: values }
}

let branch = Branch {
    left: makeLeaf("left", 20);
    right: makeLeaf("right", 21)
}
let pieces: List<Text> = []
pieces.add(branch.left.label.slice(0, 2))
pieces.add(branch.right.label.slice(2, 5))
print(joinText(pieces))
print(branch.left.values[0] + branch.right.values[1])
