use "io" as io
use "../tools/testing.min" as test
use "../tools/reserved-names.min" as reserved
let compiler = test.compiler()
test.rejects(compiler, "function joinText(parts: List<Text>, separator: Text): Text { return \"\" }\n",
    "function 'joinText' uses a reserved built-in name; rename this function (for example, 'joinTextLocal'); see Reserved function names in docs/language.md")
let names = reserved.names(io.readTextFile("compiler/stages/calls.min"))
test.check(reserved.documentMatches(io.readTextFile("docs/language.md"), names), "reserved-name list is stale")
for name in names {
    test.rejects(compiler, "function " + name + "() {}\n", "function '" + name + "' uses a reserved built-in name")
}
test.executes(compiler, "record Helpers { joinText: Integer; Map: Integer }\nfunction joinTextLocal(): Integer { return 7 }\nlet helpers = Helpers { joinText: 3; Map: 4 }\nprint(helpers.joinText)\nprint(joinTextLocal())\nprint(helpers.Map)\n", "3\n7\n4\n")
test.removeScratch(compiler.directory)
print("reserved names: passed")
