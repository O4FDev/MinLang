function moduleDeclarationIndexCheck(index: ModuleDeclarationIndex, owners: List<Integer>, names: List<Text>, kinds: List<Integer>, owner: Integer, name: Text, kind: Integer) {
    let actual = findIndexedModuleDeclaration(index, owner, name, kind)
    let expected = findModuleDeclaration(owners, names, kinds, owner, name, kind)
    if actual != expected { fail("module declaration index disagrees with linear lookup") }
}

function main() {
    if processInfo.argumentCount() > 0 {
        let mode = processInfo.argument(0)
        if mode == "overflow-owner" { buildModuleDeclarationIndex([9223372036854775807], ["example"], [1]); fail("overflowing module owner accepted") }
        let kind = 0
        if mode == "wide-kind" { kind = 5 }
        let malformed = writeModuleTable([], [], [], [], [], [], [], [0], ["example"], [kind], [0], ["example"])
        readModuleTable(malformed, [], [], [], [], [], [], [], [], [], [], [], [])
        fail("invalid cached declaration kind accepted")
    }
    let owners: List<Integer> = []
    let names: List<Text> = []
    let kinds: List<Integer> = []
    let empty = buildModuleDeclarationIndex(owners, names, kinds)
    if findIndexedModuleDeclaration(empty, 0, "main", 1) != -1 { fail("empty module declaration index") }
    owners = [2, 0, 1, 2, 0, 1, 0, 3, 2, 0, 3, 0]
    names = ["shared", "shared", "shared", "shared", "shared", "shared", "shared", "main", "main", "main", "main", "main"]
    kinds = [1, 1, 1, 2, 2, 3, 1, 1, 3, 2, 3, 1]
    for owner in [0, 1, 2, 3, 18] {
        for name in ["", "é", "é", "界", "🙂", "space λ \"quote\" | suffix"] {
            for kind in [1, 2, 3] {
                owners.add(owner)
                names.add(name)
                kinds.add(kind)
            }
        }
    }
    let position = 0
    while position < 700 {
        owners.add(position * 37 % 19)
        names.add("shared_prefix_" + Text(position))
        kinds.add(1 + position % 3)
        position = position + 1
    }
    let index = buildModuleDeclarationIndex(owners, names, kinds)
    if findIndexedModuleDeclaration(index, 0, "shared", 5) != -1 { fail("invalid declaration kind must not alias another owner") }
    if findIndexedModuleDeclaration(index, -1, "shared", 1) != -1 { fail("negative module owner") }
    if findIndexedModuleDeclaration(index, 9223372036854775807, "shared", 1) != -1 { fail("overflowing module owner") }
    let collisions = 0
    position = 0
    while position < names.length {
        let bucket = declarationHash(names[position], owners[position] * 4 + kinds[position]) % (index.slots.length - 1)
        if index.slots[1 + bucket] != position { collisions = collisions + 1 }
        for kind in [1, 2, 3] {
            moduleDeclarationIndexCheck(index, owners, names, kinds, owners[position], names[position], kind)
        }
        for owner in [0, 1, 2, 3, 18, 19, 127] {
            moduleDeclarationIndexCheck(index, owners, names, kinds, owner, names[position], kinds[position])
        }
        moduleDeclarationIndexCheck(index, owners, names, kinds, owners[position], "missing_" + Text(position), kinds[position])
        position = position + 1
    }
    if collisions < 20 { fail("module declaration collision coverage disappeared") }
    if findIndexedModuleDeclaration(index, 0, "shared", 1) != 1 { fail("first duplicate module declaration must win") }
    if findIndexedModuleDeclaration(index, 2, "shared", 1) != 0 { fail("module owner is part of declaration identity") }
    if findIndexedModuleDeclaration(index, 0, "shared", 2) != 4 { fail("declaration kind is part of module identity") }
    if findIndexedModuleDeclaration(index, 0, "main", 1) != 11 { fail("entry main declaration ID") }
    if findIndexedModuleDeclaration(index, 3, "main", 1) != 7 { fail("imported main declaration ID") }
    if findIndexedModuleDeclaration(index, 0, "é", 1) == findIndexedModuleDeclaration(index, 0, "é", 1) { fail("Unicode spellings must stay distinct") }

    let public: List<Integer> = []
    let qualified: List<Text> = []
    position = 0
    while position < names.length {
        public.add(position % 2)
        qualified.add(qualifiedDeclarationName(owners[position], names[position], []))
        position = position + 1
    }
    let table = writeModuleTable(["example"], [1], [1], [0, 0], [], [], [], owners, names, kinds, public, qualified)
    let decodedNames: List<Text> = []
    let decodedKinds: List<Integer> = []
    let decodedReturns: List<Integer> = []
    let decodedCounts: List<Integer> = []
    let decodedParameters: List<Text> = []
    let decodedTypes: List<Integer> = []
    let decodedSymbols: List<Integer> = []
    let decodedOwners: List<Integer> = []
    let decodedDeclarations: List<Text> = []
    let decodedDeclarationKinds: List<Integer> = []
    let decodedPublic: List<Integer> = []
    let decodedQualified: List<Text> = []
    let decoded = readModuleTable(table, decodedNames, decodedKinds, decodedReturns, decodedCounts, decodedParameters, decodedTypes, decodedSymbols, decodedOwners, decodedDeclarations, decodedDeclarationKinds, decodedPublic, decodedQualified)
    position = 0
    while position < names.length {
        moduleDeclarationIndexCheck(decoded, owners, names, kinds, owners[position], names[position], kinds[position])
        position = position + 1
    }
    let rewritten = writeModuleTable(decodedNames, decodedKinds, decodedReturns, decodedCounts, decodedParameters, decodedTypes, decodedSymbols, decodedOwners, decodedDeclarations, decodedDeclarationKinds, decodedPublic, decodedQualified)
    if rewritten != table { fail("module declaration table encoding changed on reload") }
    print("module declaration index verified")
}
