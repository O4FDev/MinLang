let checksum = 0
for round in 0..20 {
    let values = Map<Text, Integer>()
    for i in 0..10000 { values[Text(i)] = i }
    for i in 0..10000 { checksum += values[Text(i)] }
    for i in 0..10000 { if !values.remove(Text(i)) { fail("remove failed") } }
    if values.length != 0 { fail("map not empty") }
}
print(checksum)
