use "../tools/testing.min" as test
use "system" as system
use "files" as files
use "io" as io
use "json" as json
use "./frontend-fixtures.min" as fixtures
let work = test.scratch()
let compiler = test.setting("MINYAR_TEST_COMPILER", "./build/minyarc")
let sources = ["tests/errors", "tests/fuzz-regressions", "tests/diagnostics/cases"]
let goldens = ["tests/diagnostics/expected/errors", "tests/diagnostics/expected/fuzz-regressions", "tests/diagnostics/expected/cases"]
let sample = "error: unknown value\n  --> harbour.min:2:8\n   |\n 2 | print(stars)\n   |        ^^^^^\n"
test.check(test.sameDiagnostic(sample, "Minyar stopped: line 2, column 8: unknown value\n"), "semantic diagnostic projection")
test.check(test.sameDiagnostic(sample, "Minyar stopped: harbour.min:2, column 8: unknown value\n"), "semantic diagnostic file projection")
test.check(!test.sameDiagnostic(sample, "Minyar stopped: line 2, column 9: unknown value\n"), "projection must preserve exact columns")
test.check(!test.sameDiagnostic(sample, "Minyar stopped: line 2, column 8: another value\n"), "projection must preserve exact messages")
test.check(!test.sameDiagnostic(sample + "unexpected stderr\n", "Minyar stopped: line 2, column 8: unknown value\n"), "projection must reject extra stderr")
test.check(!test.sameDiagnostic(sample + sample, "Minyar stopped: line 2, column 8: unknown value\n"), "projection must reject extra diagnostics")
test.check(test.sameDiagnostic(sample, "Minyar stopped: unknown value\n"), "message-only legacy expectations retain their full message")
test.check(!test.sameDiagnostic(sample, "Minyar stopped: another value\n"), "message-only projection rejects changed messages")
test.check(!test.sameDiagnostic(sample + "unexpected stderr\n", "Minyar stopped: unknown value\n"), "message-only projection rejects extra stderr")
test.check(test.validCompilerDiagnostics(sample) && test.validCompilerDiagnostics(sample + sample), "prefix-only corpora accept complete single and multiple error blocks")
test.check(!test.validCompilerDiagnostics(sample + "unexpected stderr\n") && !test.validCompilerDiagnostics("error: no origin\n"), "prefix-only checks still validate every complete block")
test.check(test.containsDiagnostic(sample + sample, "Minyar stopped: line 2, column 8: unknown value\n"), "a contains oracle finds the same exact located error within valid multiple blocks")
test.check(!test.containsDiagnostic(sample + sample, "Minyar stopped: line 2, column 9: unknown value\n"), "multiple-block projection preserves exact columns")
let checked = 0
for suite in 0..sources.length {
    let names = files.list(sources[suite])
    test.check(files.lastError() == 0, "cannot read diagnostic suite")
    names.sort()
    for name in names {
        let raw = Bytes(name)
        if raw.length >= 4 && Text(raw.slice(raw.length - 4, raw.length)) == ".min" {
            let source = sources[suite] + "/" + name
            let expectedPath = goldens[suite] + "/" + Text(raw.slice(0, raw.length - 4)) + ".stderr"
            let expected = Text(files.readFile(expectedPath))
            test.check(files.lastError() == 0, "missing diagnostic golden: " + expectedPath)
            test.check(test.contains(expected, "  --> " + source + ":"), "golden must assert the source file and exact position")
            test.check(test.contains(expected, " | ") && test.contains(expected, "^"), "golden must retain the source excerpt and underline")
            let rows = test.lines(expected)
            test.check(rows[3].find(" | ") + 1 == rows[4].find("| "), "source and underline gutters must align")
            let output = work + "/case" + Text(checked) + ".ll"
            let result = test.run([compiler, source, output, "--library", "library"], system.environment(), "", work + "/result", 10)
            test.check(result.status == 1, source + ": expected compiler status 1\n" + result.errorOutput)
            test.check(result.output == "", source + ": unexpected compiler stdout")
            test.check(result.errorOutput == expected, source + ": diagnostic drift\nexpected\n" + expected + "actual\n" + result.errorOutput)
            test.check(files.pathSize(output) < 0, source + ": rejected input left LLVM")
            let machine = test.run([compiler, source, output, "--error-format", "json", "--library", "library"], system.environment(), "", work + "/json", 10)
            test.check(machine.status == 1 && machine.output == "", source + ": JSON rejection status/stdout")
            test.check(test.lines(machine.errorOutput).length == 1, source + ": one JSON object per error")
            let diagnostic = json.parse(machine.errorOutput)
            test.check(diagnostic.kind == json.OBJECT && diagnostic.keys.length == 12, source + ": complete stable schema")
            for key in ["version", "severity", "code", "message", "file", "line", "column", "endLine", "endColumn", "sourceLine", "label", "help"] { test.check(json.member(diagnostic, key).kind != json.INVALID, source + ": missing JSON field " + key) }
            let code = json.member(diagnostic, "code").text
            test.check(code != "E0001" && test.contains(expected, "= explain: minyar explain " + code + "\n"), source + ": recorded errors have a specific code with text/JSON parity")
            let origin = rows[1].slice(7 + source.length, rows[1].length)
            let separator = origin.find(":")
            let line = Integer(origin.slice(0, separator))
            let column = Integer(origin.slice(separator + 1, origin.length))
            test.check(json.member(diagnostic, "version").number == 1.0 && json.member(diagnostic, "severity").text == "error", source + ": schema version and severity")
            test.check(json.member(diagnostic, "message").text == rows[0].slice(7, rows[0].length), source + ": JSON/text message parity")
            test.check(json.member(diagnostic, "file").text == source && json.member(diagnostic, "line").number == Float(line) && json.member(diagnostic, "column").number == Float(column), source + ": JSON/text exact origin parity")
            test.check(json.member(diagnostic, "endLine").number == Float(line) && json.member(diagnostic, "endColumn").number >= Float(column), source + ": half-open JSON range")
            let sourceLines = test.lines(io.readTextFile(source))
            let sourceLine = ""
            if line <= sourceLines.length { sourceLine = sourceLines[line - 1] }
            test.check(json.member(diagnostic, "sourceLine").text == sourceLine, source + ": unmodified source line")
            let after = rows[4].find("^")
            while after < rows[4].length && rows[4][after] == '^' { after += 1 }
            let label = ""
            if after < rows[4].length { label = rows[4].slice(after + 1, rows[4].length) }
            test.check(json.member(diagnostic, "label").text == label, source + ": JSON/text label parity")
            let notes = json.member(diagnostic, "help")
            let help = ""
            if rows.length > 5 { let start = rows[5].find("= help: "); if start >= 0 { help = rows[5].slice(start + 8, rows[5].length) } }
            test.check(notes.kind == json.ARRAY && help != "", source + ": every recorded error has a repair note")
            if help == "" { test.check(notes.items.length == 0, source + ": empty help array") }
            else { test.check(notes.items.length == 1 && notes.items[0].text == help, source + ": JSON/text help parity") }
            test.check(files.pathSize(output) < 0, source + ": JSON rejection left LLVM")
            checked += 1
        }
    }
}
test.check(checked >= 100, "at least one hundred complete compiler error goldens are required")
let recoveryCases = json.parse(io.readTextFile("tests/diagnostics/recovery.json"))
for item in recoveryCases.items {
    let name = json.member(item, "name").text
    let source = "tests/diagnostics/recovery/" + name + ".min"
    let output = work + "/recovery-" + name + ".ll"
    let expected = io.readTextFile("tests/diagnostics/expected/recovery/" + name + ".stderr")
    let human = test.run([compiler, source, output, "--library", "library"], system.environment(), "", work + "/recovery-text", 10)
    test.check(human.status == 1 && human.output == "" && human.errorOutput == expected, "complete multi-error golden " + name + "\n" + human.errorOutput)
    let machine = test.run([compiler, source, output, "--error-format", "json", "--library", "library"], system.environment(), "", work + "/recovery-json", 10)
    let rows = test.lines(machine.errorOutput)
    let expectedLines = json.member(item, "lines").items
    let expectedColumns = json.member(item, "columns").items
    let messages = json.member(item, "messages").items
    test.check(machine.status == 1 && machine.output == "" && rows.length == expectedLines.length, "safe recovery count and cap " + name)
    for index in 0..rows.length {
        let diagnostic = json.parse(rows[index])
        test.check(diagnostic.kind == json.OBJECT && diagnostic.keys.length == 12 && json.member(diagnostic, "version").number == 1.0, "one complete JSON object per recovered error")
        test.check(json.member(diagnostic, "code").text != "E0001" && json.member(diagnostic, "help").items.length == 1, "recovered errors retain specific codes and repair notes")
        test.check(json.member(diagnostic, "file").text == source && json.member(diagnostic, "line").number == expectedLines[index].number && json.member(diagnostic, "column").number == expectedColumns[index].number, "independent recovery token oracle " + name)
        test.check(json.member(diagnostic, "message").text == messages[index].text, "independent recovery messages without cascades " + name)
    }
    test.check(files.pathSize(output) < 0, "recovery never emits partial LLVM")
}
// These scalar ranges and terminal cell counts are independent of the
// formatter and complete goldens, including joined and combining characters.
for item in json.parse(io.readTextFile("tests/diagnostics/display.json")).items {
    let name = json.member(item, "name").text
    let source = "tests/diagnostics/cases/" + name + ".min"
    let result = test.run([compiler, source, work + "/display.ll", "--error-format", "json"], system.environment(), "", work + "/display", 10)
    let diagnostic = json.parse(result.errorOutput)
    test.check(result.status == 1 && json.member(diagnostic, "line").number == json.member(item, "line").number && json.member(diagnostic, "column").number == json.member(item, "column").number && json.member(diagnostic, "endColumn").number == json.member(item, "endColumn").number, "independent Unicode/token scalar range " + name)
    let rows = test.lines(io.readTextFile("tests/diagnostics/expected/cases/" + name + ".stderr"))
    test.check(Float(rows[4].find("^")) == json.member(item, "terminalCellsBefore").number + 5.0, "independent terminal-cell underline " + name)
}
// Foreign-byte and filesystem failures still use the same stable schema.
let invalidSource = work + "/invalid-utf8.min"
let invalidBytes = Bytes("// é🙂\nprint(")
invalidBytes.add(255)
io.writeBytesFile(invalidSource, invalidBytes)
for mode in ["", "--doc-json", "--list-tests"] {
    for input in [invalidSource, work + "/missing.min", work] {
        let command = [compiler, input, work + "/io.ll", "--error-format", "json"]
        if mode != "" { command.add(mode) }
        let result = test.run(command, system.environment(), "", work + "/io-failure", 10)
        let rows = test.lines(result.errorOutput)
        test.check(result.status == 1 && result.output == "" && rows.length == 1, "one structured source-read failure")
        let diagnostic = json.parse(rows[0])
        test.check(diagnostic.kind == json.OBJECT && diagnostic.keys.length == 12 && json.member(diagnostic, "file").text == input, "source-read failure keeps original path and schema")
        if input == invalidSource {
            test.check(json.member(diagnostic, "message").text == "Text contained invalid UTF-8." && json.member(diagnostic, "line").number == 2.0 && json.member(diagnostic, "column").number == 7.0, "first invalid UTF-8 byte has a Unicode scalar source location")
        }
        test.check(files.pathSize(work + "/io.ll") < 0, "source-read failure emits no LLVM")
    }
}
let special = work + "/é\"🙂.min"
io.writeTextFile(special, "print(missing)\n")
let escaped = test.run([compiler, special, work + "/escaped.ll", "--error-format", "json"], system.environment(), "", work + "/escaped", 10)
let escapedValue = json.parse(escaped.errorOutput)
test.check(escaped.status == 1 && escaped.output == "" && json.member(escapedValue, "file").text == special, "JSON filename escaping and Unicode")
test.check(json.member(escapedValue, "column").number == 7.0 && json.member(escapedValue, "endColumn").number == 14.0, "JSON token range counts Unicode scalars with an exclusive end")
let terminalControls = "A" + Text(Character(1)) + "B" + Text(Character(27)) + "C" + Text(Character(133)) + "D" + Text(Character(8238)) + "E"
let visibleControls = "A\\u{0001}B\\u{001b}C\\u{0085}D\\u{202e}E"
let replacedControls = "A�B�C�D�E"
let sourceControls = "A" + Text(Character(1)) + "B" + Text(Character(27)) + "C" + Text(Character(133)) + "D"
let visibleSourceControls = "A\\u{0001}B\\u{001b}C\\u{0085}D"
let replacedSourceControls = "A�B�C�D"
let controlMessageSource = work + "/control-message.min"
io.writeTextFile(controlMessageSource, "use \"" + sourceControls + "\" as unsafe\n")
let controlMessage = test.run([compiler, controlMessageSource, work + "/control-message.ll", "--library", "library"], system.environment(), "", work + "/control-message", 10)
let expectedControlMessage = "error: package names use letters, digits, '-', and '_'; found '" + visibleSourceControls + "'\n  --> " + controlMessageSource + ":1:1\n   |\n 1 | use \"" + replacedSourceControls + "\" as unsafe\n   | ^^^\n   = help: use ASCII letters, digits, and '_' in this name; keep other characters inside Text\n   = explain: minyar explain E0103\n"
test.check(controlMessage.status == 1 && controlMessage.output == "" && controlMessage.errorOutput == expectedControlMessage, "text diagnostic message and excerpt escape C0, ESC, and C1 controls byte-for-byte")
let controlJSON = test.run([compiler, controlMessageSource, work + "/control-message-json.ll", "--error-format", "json", "--library", "library"], system.environment(), "", work + "/control-message-json", 10)
let controlJSONValue = json.parse(controlJSON.errorOutput)
test.check(controlJSON.status == 1 && json.member(controlJSONValue, "message").text == "package names use letters, digits, '-', and '_'; found '" + sourceControls + "'" && json.member(controlJSONValue, "sourceLine").text == "use \"" + sourceControls + "\" as unsafe", "JSON diagnostics preserve structured control-bearing field values")
// Source text cannot carry bidirectional controls at all, so a bidi control reaches a diagnostic
// only as the rejected excerpt, which must still be escaped byte-for-byte.
let bidiSource = work + "/bidi-message.min"
io.writeTextFile(bidiSource, "use \"" + terminalControls + "\" as unsafe\n")
let bidiMessage = test.run([compiler, bidiSource, work + "/bidi-message.ll", "--library", "library"], system.environment(), "", work + "/bidi-message", 10)
let bidiDiagnostic = "bidirectional formatting controls are not allowed in source; construct the value with Character(codePoint)"
let expectedBidiMessage = "error: " + bidiDiagnostic + "\n  --> " + bidiSource + ":1:13\n   |\n 1 | use \"" + replacedControls + "\" as unsafe\n   |             ^\n"
test.check(bidiMessage.status == 1 && bidiMessage.output == "" && bidiMessage.errorOutput == expectedBidiMessage && files.pathSize(work + "/bidi-message.ll") < 0, "bidi source rejection excerpt escapes C0, ESC, C1, and bidi controls byte-for-byte")
let bidiJSON = test.run([compiler, bidiSource, work + "/bidi-message-json.ll", "--error-format", "json", "--library", "library"], system.environment(), "", work + "/bidi-message-json", 10)
let bidiJSONValue = json.parse(bidiJSON.errorOutput)
test.check(bidiJSON.status == 1 && json.member(bidiJSONValue, "message").text == bidiDiagnostic && json.member(bidiJSONValue, "column").number == 13.0 && json.member(bidiJSONValue, "sourceLine").text == "use \"" + terminalControls + "\" as unsafe", "JSON bidi rejection preserves the structured control-bearing source line")
let controlPath = work + "/path-" + terminalControls + ".min"
io.writeTextFile(controlPath, "print(missing)\n")
let controlPathResult = test.run([compiler, controlPath, work + "/control-path.ll"], system.environment(), "", work + "/control-path", 10)
let expectedControlPath = "error: I can't find a value named 'missing'\n  --> " + work + "/path-" + visibleControls + ".min:1:7\n   |\n 1 | print(missing)\n   |       ^^^^^^^\n   = help: check the spelling, or declare this value before using it in the current scope\n   = explain: minyar explain E0301\n"
test.check(controlPathResult.status == 1 && controlPathResult.output == "" && controlPathResult.errorOutput == expectedControlPath, "text diagnostic path escapes C0, ESC, C1, and bidi controls byte-for-byte")
let success = test.run([compiler, "examples/gallery/weather-lantern.min", work + "/success.ll", "--error-format", "json", "--library", "library"], system.environment(), "", work + "/success", 10)
test.check(success.status == 0 && success.output == "" && success.errorOutput == "", "JSON success emits no diagnostics")
let textMode = test.run([compiler, "tests/diagnostics/cases/suggest-type.min", work + "/text.ll", "--error-format", "text"], system.environment(), "", work + "/text", 10)
test.check(textMode.status == 1 && textMode.errorOutput == io.readTextFile("tests/diagnostics/expected/cases/suggest-type.stderr"), "explicit text format retains exact diagnostics")
let driver = test.setting("MINYAR_TEST_MODULE_DRIVER", "./build/minyar-module-build")
let entry = work + "/entry.min"
let module = work + "/harbour.min"
io.writeTextFile(entry, "use \"./harbour.min\" as harbour\nprint(harbour.light())\n")
io.writeTextFile(module, "public function light(): Integer { return 1 }\n")
let cacheCommand = [driver, compiler, entry, work + "/module.ll", work + "/cache", "--error-format", "json", "--library", "library"]
let seeded = test.run(cacheCommand, system.environment(), "", work + "/seed", 20)
test.check(seeded.status == 0 && seeded.output == "" && seeded.errorOutput == "", "JSON incremental success and cache seed")
let broken = "public function light(): Integer { return \"warm\" }\n"
io.writeTextFile(module, broken)
let invalidated = test.run(cacheCommand, system.environment(), "", work + "/invalidate", 20)
let imported = json.parse(invalidated.errorOutput)
test.check(invalidated.status == 1 && invalidated.output == "", "JSON incremental warm-cache rejection")
test.check(json.member(imported, "file").text == module && json.member(imported, "line").number == 1.0 && json.member(imported, "column").number == Float(broken.find("\"") + 1), "JSON incremental original imported token")
test.check(json.member(imported, "message").text == "a returned value has the wrong type; expected Integer, found Text", "JSON incremental same original message")
test.check(test.lines(invalidated.errorOutput).length == 1, "cache retry emits one diagnostic")
test.removeScratch(work)
let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
fixtures.executes(frontend, io.readTextFile("examples/gallery/diagnostics.min"), "The harbour: a light to come home to.\nThe lighthouse: the stars have the night to themselves.\n", ["-O0", "-O2"], 0, "", true)
fixtures.executes(frontend, io.readTextFile("examples/gallery/weather-lantern.min"), "The harbour: the stars have room to shine.\nThe harbour: 3 drops, and one warm window.\n", ["-O0", "-O2"], 0, "", true)
fixtures.executes(frontend, io.readTextFile("examples/gallery/first-light.min"), "The harbour: 3 small lights against the dark.\nThe hill: 4 small lights against the dark.\n", ["-O0", "-O2"], 0, "", true)
test.removeTree(frontend.compiler.directory)
print(Text(checked) + " complete compiler diagnostics match byte-for-byte golden files")
