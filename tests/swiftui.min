use "../tools/testing.min" as test
use "../scripts/native-host.min" as host
use "../scripts/native-swift.min" as frontend
use "system" as system
use "files" as files

record Context { root: Text; serial: Integer }

function lowers(source: Text, expected: Text) {
    let lowered = frontend.lower(source)
    test.check(lowered.error == "", "lowering failed for " + source + ": " + lowered.error)
    test.check(lowered.text == expected, "lowered\n" + source + "\nto\n" + lowered.text + "\nexpected\n" + expected)
}
function rejected(source: Text) {
    let lowered = frontend.lower(source)
    test.check(lowered.error != "", "lowering accepted invalid input: " + source)
}
function run(context: Context, command: List<Text>, ok: Boolean, seconds: Integer): test.Result {
    context.serial += 1
    let log = context.root + "/build/swiftui-test-" + Text(system.processId()) + "-" + Text(context.serial)
    let result = test.run(command, system.environment(), context.root, log, seconds)
    files.remove(log)
    files.remove(log + ".err")
    if ok { test.check(result.status == 0, spaced(command) + "\n" + result.output + "\n" + result.errorOutput) }
    else { test.check(result.status != 0, "expected failure: " + spaced(command)) }
    return result
}
function spaced(command: List<Text>): Text {
    let result = ""
    for index in 0..command.length {
        if index > 0 { result += " " }
        result += command[index]
    }
    return result
}
function swiftBackend(context: Context, arguments: List<Text>, ok: Boolean): test.Result {
    let command = [context.root + "/minyar", "--backend", "swift"]
    for item in arguments { command.add(item) }
    return run(context, command, ok, 180)
}
function bytes(path: Text): Bytes {
    let data = files.readFile(path)
    test.check(files.lastError() == 0, "read " + path)
    return data
}
function sameBytes(left: Bytes, right: Bytes): Boolean {
    if left.length != right.length { return false }
    for index in 0..left.length { if left[index] != right[index] { return false } }
    return true
}
function plist(context: Context, path: Text, key: Text): Text {
    return host.strip(run(context, ["plutil", "-extract", key, "raw", "-o", "-", path], true, 30).output)
}
function normalize(ir: Text): Text {
    let kept: List<Text> = []
    for line in host.lines(ir) {
        if !host.starts(line, "; ModuleID = ") && !host.starts(line, "source_filename = ") { kept.add(line + "\n") }
    }
    return joinText(kept)
}
function fresh(prefix: Text): Text {
    let path = host.clean(test.scratch())
    test.check(host.makeDirectories(path) == "", "create " + prefix)
    return path
}

lowers("function map<T, U>(xs: [T], f: (T, T) -> U): [U] { let n = 0; constant x = n }",
    "func map<T, U>(_ xs: [T], _ f: (T, T) -> U)-> [U] { var n = 0; let x = n }")
print("test_syntax_and_generic_closure_parameters ... ok")

lowers("function f(_ x: Int, to y: Int) async throws: Int { x + y }", "func f(_ x: Int, to y: Int) async throws-> Int { x + y }")
lowers("record Box<T>: P { constant x: T }", "struct Box<T>: P { let x: T }")
print("test_explicit_labels_and_native_declarations ... ok")

for literal in ["\"function let record constant\"", "#\"function \\#(String(\"let\"))\"#", "\"outer \\(String(\"inner \\(2)\"))!\"",
        "\"\"\"\nlet record \\(2)\n\"\"\"", "/* let /* function */ record */", "// function\n", "`let`", "#/let|constant|record/#"] {
    lowers(literal, literal)
}
lowers("\"\\({ constant x = 2; return x }())\"", "\"\\({ let x = 2; return x }())\"")
print("test_literals_comments_interpolation ... ok")

for source in ["\"unfinished", "/* unfinished", "`unfinished", "use \"./local.min\"", "use \"SwiftUI\" as ui", "function missing", "constant r = /let/"] {
    rejected(source)
}
lowers("use \"SwiftUI\"\nuse \"Observation\"", "import SwiftUI\nimport Observation")
print("test_invalid_input_and_imports ... ok")

function setUpLibrary(): Text {
    let path = fresh("library install")
    let source = path + "/products"
    test.check(host.makeDirectories(source) == "", "create products")
    writeTextFile(source + "/library", "old binary")
    writeTextFile(source + "/module", "old metadata")
    test.check(frontend.installLibrary(source, path + "/installed") == "", "install the first library")
    return path
}
function temporaries(path: Text): List<Text> {
    let found: List<Text> = []
    for name in files.list(path) { if host.starts(name, ".minyar-library-") { found.add(name) } }
    return found
}

let path = setUpLibrary()
let source = path + "/products"
let output = path + "/installed"
writeTextFile(source + "/library", "new binary")
writeTextFile(source + "/module", "new metadata")
test.check(frontend.installLibrary(source, output) == "", "replace an installed library")
test.check(readTextFile(output + "/module") == "new metadata", "replaced library metadata")
let unrelated = path + "/unrelated"
test.check(host.makeDirectories(unrelated) == "", "create unrelated directory")
writeTextFile(unrelated + "/precious", "retain")
test.check(test.contains(frontend.installLibrary(source, unrelated), "refusing to replace"), "an unrelated directory was replaced")
test.check(readTextFile(unrelated + "/precious") == "retain", "unrelated directory content changed")
let link = path + "/link"
test.check(host.run(["ln", "-s", output, link]) == 0, "create library symlink")
test.check(test.contains(frontend.installLibrary(source, link), "refusing to replace"), "a symbolic link was replaced")
test.removeTree(path)
print("test_replacement_and_unrelated_directory ... ok")

path = setUpLibrary()
source = path + "/products"
output = path + "/installed"
let lock = path + "/installed.minyar-lock"
writeTextFile(lock, "active owner")
let contended = frontend.installLibrary(source, output)
test.check(test.contains(contended, "File exists"), "a held lock did not stop installation: " + contended)
test.check(readTextFile(lock) == "active owner", "the losing writer removed the lock")
test.removeTree(path)
print("test_lock_is_not_removed_by_losing_writer ... ok")

path = setUpLibrary()
source = path + "/products"
output = path + "/installed"
let installFailure = frontend.installLibraryWith(source, output, [host.RenameFault { source: "next"; destination: ""; message: "injected installation failure" }])
test.check(test.contains(installFailure, "injected"), "installation failure was not propagated: " + installFailure)
test.check(readTextFile(output + "/library") == "old binary", "rollback lost the previous binary")
test.check(readTextFile(output + "/module") == "old metadata", "rollback lost the previous metadata")
test.check(temporaries(path).length == 0, "installation left temporary directories")
test.check(files.pathSize(path + "/installed.minyar-lock") < 0, "installation left its lock")
test.removeTree(path)
print("test_rollback_retains_matching_binary_and_metadata ... ok")

path = setUpLibrary()
source = path + "/products"
output = path + "/installed"
let rollbackFailure = frontend.installLibraryWith(source, output, [
    host.RenameFault { source: "next"; destination: ""; message: "injected rename failure" },
    host.RenameFault { source: "previous"; destination: ""; message: "injected rename failure" }])
test.check(test.contains(rollbackFailure, "previous library preserved"), "rollback failure was not reported: " + rollbackFailure)
let backups: List<Text> = []
for name in temporaries(path) {
    if host.isDirectory(path + "/" + name + "/previous") { backups.add(path + "/" + name + "/previous") }
}
test.check(backups.length == 1, "expected one preserved library backup")
test.check(readTextFile(backups[0] + "/library") == "old binary", "preserved backup binary")
test.check(readTextFile(backups[0] + "/module") == "old metadata", "preserved backup metadata")
test.removeTree(path)
print("test_failed_rollback_preserves_backup ... ok")

let uname = host.capture(["uname", "-s"])
if host.strip(uname.output) != "Darwin" {
    print("native SwiftUI tests skipped: requires macOS/Xcode and a GUI session")
    exit(0)
}
let rootResult = host.capture(["/bin/sh", "-c", "pwd -P"])
let context = Context { root: host.strip(rootResult.output); serial: 0 }
test.check(host.makeDirectories(context.root + "/build") == "", "create build directory")
let root = context.root

let work = fresh("swiftui")
let ours = work + "/minyar.ll"
let reference = work + "/swift.ll"
let binary = work + "/program"
let sil = work + "/program.sil"
swiftBackend(context, ["--release", "--module-name", "ParityProbe", "--emit-ir", ours, "--emit-sil", sil, root + "/tests/swiftui-equivalent.min", "-o", binary], true)
let flags = ["xcrun", "swiftc", "-swift-version", "6", "-module-name", "ParityProbe", "-whole-module-optimization", "-O", "-parse-as-library"]
let referenceSource = work + "/reference.swift"
writeTextFile(referenceSource, "#sourceLocation(file: " + host.jsonString(root + "/tests/swiftui-equivalent.min") + ", line: 1)\n" + readTextFile(root + "/tests/swiftui-equivalent.swift"))
let emit: List<Text> = []
for item in flags { emit.add(item) }
for item in ["-emit-ir", referenceSource, "-o", reference] { emit.add(item) }
run(context, emit, true, 180)
test.check(normalize(readTextFile(ours)) == normalize(readTextFile(reference)), "optimized IR differs from the Swift reference")
let linkCommand: List<Text> = []
for item in flags { linkCommand.add(item) }
for item in [referenceSource, "-o", work + "/reference"] { linkCommand.add(item) }
run(context, linkCommand, true, 180)
let ourOutput = run(context, [binary], true, 60).output
test.check(ourOutput == run(context, [work + "/reference"], true, 60).output, "program output differs from the Swift reference")
test.check(host.starts(run(context, [binary], true, 60).output, "10\n"), "program output does not start with 10")
let ir = readTextFile(ours)
test.check(test.contains(ir, "CounterViewV4body"), "IR lacks CounterView.body")
test.check(test.contains(ir, "NSHostingView"), "IR lacks NSHostingView")
test.check(!test.contains(ir, "minyar_"), "IR references the Minyar runtime")
let silText = readTextFile(sil)
test.check(!test.contains(silText, "AnyView"), "SIL erased views with AnyView")
test.check(test.contains(silText, "CounterView"), "SIL lacks CounterView")
test.removeTree(work)
print("test_exact_optimized_ir_equivalence ... ok")

work = fresh("swiftui")
for release in [false, true] {
    let name = "debug"
    let arguments: List<Text> = []
    if release { name = "release"; arguments.add("--release") }
    for item in [root + "/tests/swiftui-features.min", "-o", work + "/" + name] { arguments.add(item) }
    swiftBackend(context, arguments, true)
    test.check(run(context, [work + "/" + name], true, 60).output == "native generics, typed errors, ARC, closures and actors passed\n", "native features at " + name)
}
test.removeTree(work)
print("test_native_ownership_generics_errors_concurrency ... ok")

work = fresh("swiftui")
let library = work + "/MinyarWidgets"
swiftBackend(context, ["--library", "--release", "--module-name", "MinyarWidgets", root + "/examples/swiftui-library/widgets.min", "-o", library], true)
let interfacePath = library + "/MinyarWidgets.swiftinterface"
let interfaceText = readTextFile(interfacePath)
test.check(test.contains(interfaceText, "some SwiftUI.View") || test.contains(interfaceText, "some SwiftUICore.View"), "interface lacks an opaque SwiftUI view")
test.check(test.contains(interfaceText, "public struct NativeBadge"), "interface lacks NativeBadge")
let dylib = library + "/libMinyarWidgets.dylib"
test.check(test.contains(run(context, ["otool", "-D", dylib], true, 30).output, "@rpath/libMinyarWidgets.dylib"), "library install name")
test.check(!test.contains(run(context, ["nm", dylib], true, 30).output, "_minyar_"), "library references the Minyar runtime")
let interfaceOnly = work + "/interfaces"
test.check(host.makeDirectories(interfaceOnly) == "", "create interface-only directory")
test.check(host.copyFile(interfacePath, interfaceOnly + "/MinyarWidgets.swiftinterface") == "", "copy the interface")
for headers in [library, interfaceOnly] {
    let client = work + "/client-" + host.basename(headers)
    run(context, ["xcrun", "swiftc", "-swift-version", "6", "-parse-as-library", "-O", "-module-cache-path", work + "/cache-" + host.basename(headers),
        "-I", headers, "-L", library, "-lMinyarWidgets", "-Xlinker", "-rpath", "-Xlinker", library,
        root + "/tests/swiftui-library-client.swift", "-o", client], true, 180)
    test.check(run(context, [client], true, 60).output == "Swift imported native Minyar generics, conformances, views and bindings\n", "Swift client of " + headers)
}
let clientSource = work + "/client.min"
writeTextFile(clientSource, "use \"MinyarWidgets\"\nprint(nativeSum([1, 2, 3]))\n")
swiftBackend(context, ["--swift-flag=-I", "--swift-flag=" + library, "--swift-flag=-L", "--swift-flag=" + library, "--swift-flag=-lMinyarWidgets", "--swift-flag=-Xlinker",
    "--swift-flag=-rpath", "--swift-flag=-Xlinker", "--swift-flag=" + library, clientSource, "-o", work + "/minyar-client"], true)
test.check(run(context, [work + "/minyar-client"], true, 60).output == "6\n", "Minyar client of the native library")
let before = bytes(dylib)
swiftBackend(context, ["--library", "--app", clientSource, "-o", library], false)
swiftBackend(context, ["--library", root + "/examples/swiftui/main.min", "-o", library], false)
swiftBackend(context, ["--library", "--emit-sil", library + "/inside.sil", clientSource, "-o", library], false)
writeTextFile(clientSource, "not valid Minyar\n")
swiftBackend(context, ["--library", clientSource, "-o", library], false)
test.check(sameBytes(bytes(dylib), before), "rejected configurations changed the installed library")
test.removeTree(work)
print("test_native_library_imports_binary_and_resilient_interface ... ok")

work = fresh("swiftui")
let mainSource = work + "/main.min"
let helper = work + "/helper.min"
binary = work + "/program"
writeTextFile(mainSource, "print(twice(21))\n")
writeTextFile(helper, "function twice(value: Int): Int { value * 2 }\n")
swiftBackend(context, [mainSource, helper, "-o", binary], true)
test.check(run(context, [binary], true, 60).output == "42\n", "multiple files")
let previous = bytes(binary)
writeTextFile(mainSource, "// diagnostic should refer to this file\nlet x: Int = \"wrong\"\n")
let failure = swiftBackend(context, [mainSource, "-o", binary], false)
test.check(test.contains(failure.errorOutput, mainSource + ":2:"), "diagnostic does not refer to the original file\n" + failure.errorOutput)
test.check(sameBytes(bytes(binary), previous), "a failed build replaced the previous executable")
swiftBackend(context, ["--memory-profile", "lazy", mainSource, "-o", binary], false)
swiftBackend(context, [mainSource, "-o", mainSource], false)
test.removeTree(work)
print("test_multiple_files_diagnostics_and_failed_build_preservation ... ok")

work = fresh("swiftui")
let application = work + "/Minyar Native é.app"
let lowered = work + "/lowered"
swiftBackend(context, ["--release", "--app", "--bundle-id", "org.minyar.swiftui-test", "--emit-swift", lowered, root + "/examples/swiftui/main.min", "-o", application], true)
test.check(plist(context, application + "/Contents/Info.plist", "CFBundleIdentifier") == "org.minyar.swiftui-test", "bundle identifier")
run(context, ["codesign", "--verify", "--strict", application], true, 60)
let executable = application + "/Contents/MacOS/application"
test.check(run(context, [executable, "--smoke"], true, 30).output == "swiftui scene mounted; native state updated\n", "SwiftUI scene smoke run")
let dependencies = run(context, ["otool", "-L", executable], true, 30).output
test.check(test.contains(dependencies, "SwiftUI.framework"), "application does not link SwiftUI")
test.check(test.contains(dependencies, "libswiftCore"), "application does not link the Swift runtime")
test.check(!test.contains(run(context, ["nm", "-u", executable], true, 30).output, "_minyar_"), "application references the Minyar runtime")
test.check(!test.contains(readTextFile(lowered + "/main.swift"), "AnyView("), "lowered source erased views with AnyView")
test.removeTree(work)
print("test_native_app_scene_and_bundle ... ok")
