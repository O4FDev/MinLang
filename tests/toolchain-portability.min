    io.writeTextFile(source, "print(42)\n")
    let destination = f.work + "/input"
    writeClang(f, fixedVersion() + tf.outputArgument() + tf.flagged("object", "-c|-emit-llvm") +
        "if [ \"$object\" = 0 ]; then target=\"$target.exe\"; fi\nprintf '%s' 'compiled output' > \"$target\"\n")
    let result = run(f, minyar(f, [source, "-o", destination]), f.env, 10)
    test.check(result.status == 1, "an implicit .exe must not replace the source, saw " + Text(result.status) + "\n" + result.errorOutput)
    test.check(test.contains(result.errorOutput, "replace the source file"), "implicit .exe diagnostic\n" + result.errorOutput)
    test.check(io.readTextFile(source) == "print(42)\n", "the .exe source must be unchanged")
    test.check(staging(f).length == 0, "implicit .exe staging must be removed")
}
function successfulLinkPublishes(f: Fixture) {
    io.writeTextFile(f.output, "previous executable")
    let ready = f.work + "/link ready"
    let proceed = f.work + "/link continue"
    writeClang(f, fixedVersion() + tf.outputArgument() + tf.flagged("object", "-c|-emit-llvm") +
        "if [ \"$object\" = 1 ]; then printf '%s' runtime > \"$target\"; exit 0; fi\n" +
        "printf '%s' 'incomplete executable' > \"$target\"\n: > \"$TEST_LINK_READY\"\ncount=0\n" +
        "while [ ! -e \"$TEST_LINK_CONTINUE\" ]; do\n    count=$((count + 1))\n    if [ \"$count\" -gt 1500 ]; then echo 'link publication barrier timed out' >&2; exit 1; fi\n    sleep 0.01\ndone\n" +
        "printf '%s' 'complete executable' > \"$target\"\n")
    let log = tf.next(f.logs)
    let handle = test.start(minyar(f, [f.source, "-o", f.output]), support.merge(f.env, ["TEST_LINK_READY=" + ready, "TEST_LINK_CONTINUE=" + proceed]), f.work, log, 40)
    test.check(handle > 0, "cannot launch the publication probe")
    let job = Job { handle: handle; log: log; finished: false; status: system.ProcessStatus { state: system.PENDING; exitCode: 0; signal: 0; error: 0 } }
    let deadline = system.monotonicNanoseconds() + 15000000000
    while !support.exists(ready) && alive(job) && system.monotonicNanoseconds() < deadline { tf.pause(10) }
    let reached = support.exists(ready)
    let before = io.readTextFile(f.output)
    io.writeTextFile(proceed, "")
    let result = settle(job)
    test.check(reached, "linker must reach its publication barrier\n" + result.errorOutput)
    test.check(before == "previous executable", "an incomplete link must not replace the previous executable: " + before)
    test.check(result.status == 0, "publication launch failed (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
    test.check(io.readTextFile(f.output) == "complete executable", "only the complete executable may be published")
    test.check(staging(f).length == 0, "successful link staging must be removed")
}
function doctorMissingClang(f: Fixture) {
