function outputAliases(f: Fixture) {
    let aliases = [f.source]
    let identity = tf.identity(f.source)
    for name in ["source symlink", "source hardlink"] {
        let alias = f.work + "/" + name
        let command = ["ln", f.source, alias]
        if name == "source symlink" { command = ["ln", "-s", f.source, alias] }
        if run(f, command, system.environment(), 10).status != 0 { continue }
        if identity != "" && tf.identity(alias) == identity { aliases.add(alias) }
    }
    let original = io.readBytesFile(f.source)
    for alias in aliases {
        let result = run(f, minyar(f, [f.source, "-o", alias]), f.env, 10)
        test.check(result.status == 1, alias + ": aliased output must fail with status 1, saw " + Text(result.status) + "\n" + result.errorOutput)
        test.check(test.contains(result.errorOutput, "replace the source file"), alias + ": alias diagnostic\n" + result.errorOutput)
        test.check(support.same(io.readBytesFile(f.source), original), alias + ": the source must be unchanged")
        test.check(!support.exists(f.log), "source/output collision must be rejected before Clang")
    }
}
function failedLinkPreserves(f: Fixture) {
