    let args = last(launch(f, ["MINYAR_CLANG_FLAGS=" + flags]))
    for expected in ["-DNAME=two words", "expansion-*", "$(touch injected)"] {
        test.check(support.has(args, expected), "literal flag " + expected + " missing: " + tf.show(args))
    }
    test.check(!support.exists(f.work + "/injected"), "flags must not be shell-expanded")
}
function graphicsPaths(f: Fixture) {
