function assumeOldKeepsCompiler(f: Fixture) {
    let compiler = f.project + "/build/compiler-stage2.ll"
    let runtime = f.project + "/build/runtime.o"
    let header = f.project + "/current-runtime.h"
    io.writeTextFile(compiler, "verified compiler bytes\n")
    io.writeTextFile(f.project + "/current.min", test.sourceModules("newer prerequisite\n"))
    tf.setModified(compiler, 1000000000)
    io.writeTextFile(f.project + "/Makefile", ".PHONY: check\ncheck: build/compiler-stage2.ll build/runtime.o\nbuild/compiler-stage2.ll: current.min\n\tfalse\nbuild/runtime.o: current-runtime.h\n\tcp $< $@\n")
    for value in ["first current runtime\n", "second current runtime\n"] {
        io.writeTextFile(header, value)
        if support.exists(runtime) { tf.setModified(runtime, 1000000000) }
        let result = run(f, ["sh", f.project + "/tools/toolchain.sh", "bootstrap", f.project, "check"],
            support.merge(f.env, ["MINYAR_MAKE_FLAGS=-j4 -o build/compiler-stage2.ll"]), 30)
        test.check(result.status == 0, "assume-old bootstrap failed (" + Text(result.status) + ")\n" + result.errorOutput)
        test.check(io.readTextFile(compiler) == "verified compiler bytes\n", "assume-old must keep the verified compiler")
        test.check(io.readTextFile(runtime) == value, "the current runtime must be rebuilt")
    }
}
function windowsReleaseDiscoversLinker(f: Fixture) {
    let linker = f.work + "/ld.lld.exe"
    tf.executable(linker, ":\n", f.logs)
    let llvm = f.work + "/release.ll"
    io.writeTextFile(llvm, "; no native package\n")
    let resolved = support.resolve(linker, tf.next(f.logs))
    let flagCases = ["", "-fuse-ld=/chosen/linker", "--ld-path=/chosen/linker"]
    let expectations: List<List<Text>> = [["-flto=thin", "-fuse-ld=lld", "--ld-path=" + resolved], ["-flto=thin"], ["-flto=thin"]]
    for host in ["Windows", "MSYS_NT-10.0", "MINGW64_NT-10.0"] {
        for index in 0..flagCases.length {
            let flags = flagCases[index]
            let expected = expectations[index]
            let label = host + " flags=" + flags
            io.writeTextFile(f.log, "")
            let environment = ["MINYAR_TEST_HOST_SYSTEM=" + host]
            if flags != "" { environment.add("MINYAR_CLANG_FLAGS=" + flags) }
            let result = driverLink(f, llvm, f.work + "/runtime.o", environment, "1", f.clang)
            test.check(result.status == 0, label + ": release link failed\n" + result.errorOutput)
            let link = last(tf.calls(f.log))
            let selected = ["-O2", "-Wno-override-module"]
            if flags != "" { selected = [flags] }
            test.check(tf.equal(part(link, 0, selected.length), selected), label + ": link flags " + tf.show(link))
            test.check(tf.equal(part(link, selected.length, selected.length + expected.length), expected), label + ": LTO linker options " + tf.show(link) + " expected " + tf.show(expected))
            test.check(!support.has(part(link, selected.length + expected.length, link.length), "-flto=thin"), label + ": duplicate -flto=thin " + tf.show(link))
        }
    }
}
function bootstrapPreservesExplicitLimits(f: Fixture) {
    tf.executable(f.work + "/ld.lld", "printf '%s\\n' 'LLD 23.1.2'\n", f.logs)
    let configured = "-flto=thin " + support.shellQuote("-fuse-ld=/linker path/ld.lld") + " -Wl,--threads=3"
    let call = succeeded(bootstrapEnvironment(f, ["COMPILER_LTO_FLAGS=" + configured, "MINYAR_MAX_MEMORY_MIB=384", "MINYAR_MAX_CPU_SECONDS=90"], "Linux"))
    test.check(tf.lookup(call.env, "COMPILER_LTO_FLAGS") == configured, "explicit COMPILER_LTO_FLAGS must be kept: " + tf.lookup(call.env, "COMPILER_LTO_FLAGS"))
    test.check(tf.present(call.env, "MINYAR_MAX_MEMORY_MIB") && tf.lookup(call.env, "MINYAR_MAX_MEMORY_MIB") == "384", "explicit memory limit must be kept")
    test.check(tf.present(call.env, "MINYAR_MAX_CPU_SECONDS") && tf.lookup(call.env, "MINYAR_MAX_CPU_SECONDS") == "90", "explicit CPU limit must be kept")
    call = succeeded(bootstrapEnvironment(f, ["LLVM_FLAGS=-O2 -fuse-ld=lld -Wl,--threads=2"], "Linux"))
    let flags = support.shellWords(tf.lookup(call.env, "COMPILER_LTO_FLAGS"))
    test.check(tf.equal(flags, ["-flto=thin"]), "an explicit LLVM_FLAGS linker keeps only -flto=thin: " + tf.show(flags))
    test.check(tf.lookup(call.env, "LLVM_FLAGS") == "-O2 -fuse-ld=lld -Wl,--threads=2", "explicit LLVM_FLAGS must be kept")
}
function elfThreadsStayOut(f: Fixture) {
