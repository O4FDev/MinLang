function executeOnlyClang(f: Fixture) {
    let requested = "clang"
    if tf.present(system.environment(), "MINYAR_TEST_CLANG") { requested = system.getenv("MINYAR_TEST_CLANG") }
    let selected = ""
    if requested != "" { selected = support.which(requested, tf.next(f.logs)) }
    if selected == "" { selected = support.which("clang-23", tf.next(f.logs)) }
    if selected == "" { selected = support.which("cc", tf.next(f.logs)) }
    test.check(selected != "", "a C compiler is required for the execute-only Clang fixture")
    let source = f.work + "/execute-only-clang.c"
    io.writeTextFile(source, "#include <stdio.h>\n#include <string.h>\nint main(int count, char **arguments) {\n    for (int index = 1; index < count; index++) {\n" +
        "        if (!strcmp(arguments[index], \"--version\")) { puts(\"clang version 23.1.2\"); return 0; }\n    }\n" +
        "    for (int index = 1; index + 1 < count; index++) {\n        if (!strcmp(arguments[index], \"-o\")) {\n" +
        "            FILE *output = fopen(arguments[index + 1], \"w\");\n            if (!output) return 1;\n            fputs(\"; output\\n\", output);\n" +
        "            return fclose(output) != 0;\n        }\n    }\n    return 2;\n}\n")
    let compiler = f.work + "/execute only clang"
    let built = run(f, [selected, source, "-o", compiler], system.environment(), 60)
    test.check(built.status == 0, "execute-only Clang fixture failed to build\n" + built.errorOutput)
    test.require(run(f, ["chmod", "111", compiler], system.environment(), 10), "execute-only mode")
    let llvm = f.work + "/graphics.ll"
    io.writeTextFile(llvm, "; minyar-native-library: graphics\n")
    let result = driverLink(f, llvm, f.work + "/runtime.o", ["MINYAR_TEST_HOST_SYSTEM=Linux"], "0", compiler)
    test.require(run(f, ["chmod", "755", compiler], system.environment(), 10), "restore readable fixture mode")
    test.check(result.status == 0, "execute-only Clang link failed\n" + result.errorOutput)
    let objects = 0
    for name in tf.listing(f.project + "/build/native") { if support.starts(name, "graphics-") && support.ends(name, ".o") { objects += 1 } }
    test.check(objects == 1, "expected one graphics object, saw " + Text(objects))
}
function compilerReplacementPreservedMtime(f: Fixture) {
    let base = ["TEST_GRAPHICS=1"]
    launch(f, base)
    let accessTime = tf.atime(f.clang)
    let modifyTime = tf.mtime(f.clang)
    let size = files.pathSize(f.clang)
    io.writeTextFile(f.clang, test.replace(io.readTextFile(f.clang), "output", "result"))
    tf.stamp(f.clang, accessTime, modifyTime)
    test.check(files.pathSize(f.clang) == size, "the replacement compiler must keep its size")
    test.check(nativeCalls(launch(f, base)).length == 1, "a replaced compiler with a preserved mtime must recompile graphics")
}
function selectBlocks(workflow: Text): List<Text> {
    let rows = support.split(workflow, "\n")
    let blocks: List<Text> = []
    let index = 0
    while index + 2 < rows.length {
        if support.ends(rows[index], "- name: Select pinned LLVM 23.1.2") && rows[index + 1] == "        run: |" {
            let body: List<Text> = []
            let next = index + 2
            while next + 1 < rows.length && support.starts(rows[next], "          ") {
                body.add(rows[next] + "\n")
                next += 1
            }
            if body.length > 0 {
                blocks.add(joinText(body))
                index = next
                continue
            }
        }
        index += 1
    }
    return blocks
}
function macosCiRelease(f: Fixture) {
    let workflow = io.readTextFile(f.root + "/.github/workflows/ci.yml")
    let blocks = selectBlocks(workflow)
    test.check(blocks.length == 7, "expected seven pinned LLVM selection steps, saw " + Text(blocks.length))
    for block in blocks { test.check(block == blocks[0], "pinned LLVM selection steps must be identical") }
    let published = "d7c26fc6177e42842e2d1ffaad31aec057c56a924392b1a23d830abe2c5d53b1"
    test.check(test.contains(blocks[0], published), "the pinned LLVM archive digest is published")
    test.check(test.contains(blocks[0], "https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.2/LLVM-23.1.2-macOS-ARM64.tar.xz"), "the pinned LLVM archive URL is published")
    test.check(!test.contains(workflow, "brew pin llvm"), "CI must not pin Homebrew LLVM")
    test.check(!test.contains(workflow, "brew --prefix llvm"), "CI must not select Homebrew LLVM")
    let stage = f.work + "/fixture stage"
    tf.directories(stage + "/LLVM-23.1.2-macOS-ARM64/bin", f.logs)
    tf.executable(stage + "/LLVM-23.1.2-macOS-ARM64/bin/clang", "printf \"%s\\n\" \"clang version 23.1.2\"\n", f.logs)
    let archive = f.work + "/fixture.tar.xz"
    test.require(run(f, ["tar", "-cJf", archive, "-C", stage, "LLVM-23.1.2-macOS-ARM64/bin/clang"], system.environment(), 60), "create the LLVM archive fixture")
    let archived = io.readBytesFile(archive)
    let digest = sha256.hex(sha256.digest(archived))
    let script: List<Text> = []
    for line in test.lines(blocks[0]) { script.add(Text(Bytes(line).slice(10, Bytes(line).length)) + "\n") }
    let program = test.replace(joinText(script), published, digest)
    tf.executable(f.bin + "/uname", "printf \"%s\\n\" \"${TEST_ARCH:-arm64}\"\n", f.logs)
    tf.executable(f.bin + "/xcrun", "printf \"%s\\n\" \"$RUNNER_TEMP/sdk\"\n", f.logs)
    tf.executable(f.bin + "/curl", "while [ \"$1\" != -o ]; do shift; done; cp \"$MINYAR_ASSET_FIXTURE\" \"$2\"\n", f.logs)
    for mode in ["valid", "corrupt", "wrong-architecture"] {
        let directory = f.work + "/" + mode
        tf.directory(directory)
        let fixture = directory + "/download.tar.xz"
        let data = Bytes()
        data.addBytes(archived)
        if mode == "corrupt" { data.addBytes(Bytes("changed")) }
        io.writeBytesFile(fixture, data)
        let architecture = "arm64"
        if mode == "wrong-architecture" { architecture = "x86_64" }
        let environment = support.merge(system.environment(), ["PATH=" + f.bin + ":" + system.getenv("PATH"), "RUNNER_TEMP=" + directory,
            "GITHUB_ENV=" + directory + "/env", "GITHUB_PATH=" + directory + "/path", "MINYAR_ASSET_FIXTURE=" + fixture, "TEST_ARCH=" + architecture])
        let result = tf.run(f.logs, ["bash", "-eu", "-c", program], environment, f.root, 10)
        let selected = directory + "/minyar-llvm-23.1.2/bin/clang"
        if mode == "valid" {
            test.check(result.status == 0, "valid LLVM installation failed (" + Text(result.status) + ")\n" + result.errorOutput)
            let printed = test.lines(result.output)
            test.check(printed.length > 0 && printed[printed.length - 1] == selected, "installation must print the selected Clang\n" + result.output)
            test.check(io.readTextFile(directory + "/path") == directory + "/minyar-llvm-23.1.2/bin\n", "GITHUB_PATH must hold the private LLVM bin directory")
            let expected: List<Text> = []
            for name in ["CC", "LLVM_CC", "MINYAR_CLANG", "MINYAR_TEST_CLANG"] { expected.add(name + "=" + selected) }
            expected.add("SDKROOT=" + directory + "/sdk")
            let exported = test.lines(io.readTextFile(directory + "/env"))
            test.check(tf.equal(exported, expected), "GITHUB_ENV " + tf.show(exported) + " expected " + tf.show(expected))
        } else {
            test.check(result.status != 0, mode + ": installation must fail")
            test.check(!support.exists(selected), mode + ": a rejected installation must not expose Clang")
        }
    }
}

function relativePathEntriesIgnored(f: Fixture) {
    let marker = f.work + "/relative-path-tool-ran"
    tf.executable(f.work + "/dirname", "printf executed > " + support.shellQuote(marker) + "\nexit 91\n", f.logs)
    let launcherEnvironment = support.merge(f.env, ["PATH=.:relative:/usr/bin:/bin"])
    let launcher = run(f, minyar(f, ["--help"]), launcherEnvironment, 10)
    test.check(launcher.status == 0 && !support.exists(marker), "the public launcher executed dirname from a relative PATH entry\n" + launcher.output + launcher.errorOutput)
    tf.executable(f.work + "/clang-23", "printf executed > " + support.shellQuote(marker) + "\nfor argument in \"$@\"; do\n    if [ \"$argument\" = --version ]; then printf '%s\\n' 'clang version 23.1.2'; exit 0; fi\ndone\nexit 1\n", f.logs)
    let environment = tf.without(f.env, ["MINYAR_CLANG", "LLVM_CC"])
    environment = support.merge(environment, ["PATH=.:relative:", "HOME=" + f.work + "/empty-home"])
    let implicit = run(f, ["/bin/sh", f.project + "/tools/toolchain.sh", "toolchain"], environment, 10)
    test.check(!support.exists(marker), "implicit tool lookup executed clang-23 from a relative PATH entry\n" + implicit.output + implicit.errorOutput)
    let explicit = run(f, ["/bin/sh", f.project + "/tools/toolchain.sh", "toolchain"], support.merge(environment, ["MINYAR_CLANG=./clang-23"]), 10)
    test.check(explicit.status == 0 && support.exists(marker), "an explicit relative compiler selection must remain available\n" + explicit.output + explicit.errorOutput)
}

function driverCaptureBounded(f: Fixture) {
    let noisy = f.work + "/noisy clang"
    tf.executable(noisy, "for argument in \"$@\"; do\n    if [ \"$argument\" = --version ]; then\n        printf '%s\\n' 'clang version 23.1.2'\n        dd if=/dev/zero bs=1048576 count=17 2>/dev/null\n        exit 0\n    fi\ndone\n", f.logs)
    let environment = support.merge(f.env, ["MINYAR_CLANG=" + noisy])
    let result = run(f, [f.root + "/build/tooling/tools/clang-driver", "toolchain"], environment, 10)
    test.check(result.status != 0, "driver capture must reject compiler output above its bound")
    test.check(test.contains(result.errorOutput, "unsupported compiler"), "bounded compiler output must report a normal rejection\n" + result.errorOutput)
}

let names = ["test_xcode_sdk_discovery_preserves_explicit_overrides", "test_cached_llvm_discovery_preserves_overrides_and_version_checks", "test_concurrent_cold_launches_share_a_complete_bootstrap", "test_selected_clang_bootstraps_both_c_and_llvm",
    "test_linux_bootstrap_bounds_matching_lld_threads_with_literal_paths", "test_linux_bootstrap_rejects_old_or_missing_matching_linker",
    "test_compiler_lto_cache_defaults_overrides_and_make_bootstrap_parity",
    "test_bootstrap_make_options_are_literal_and_default_argv_is_unchanged", "test_bootstrap_rejects_malformed_make_options_before_make",
    "test_bootstrap_assume_old_keeps_compiler_and_rebuilds_current_runtime", "test_windows_release_discovers_native_lld_exe_without_changing_explicit_linker",
    "test_bootstrap_preserves_explicit_limits_lto_and_linker_threads", "test_elf_thread_option_stays_out_of_apple_and_windows_bootstrap",
    "test_incremental_windows_reports_supported_alternative", "test_help_and_version_are_available_without_building",
    "test_missing_source_is_rejected_before_bootstrap", "test_output_cannot_replace_source_through_path_aliases",
    "test_failed_link_preserves_previous_executable", "test_windows_implicit_exe_cannot_replace_source",
    "test_successful_link_publishes_only_the_complete_executable", "test_doctor_reports_missing_clang_actionably",
    "test_optimization_defaults_and_debug_option", "test_check_mode_does_not_link_or_replace_a_program",
    "test_check_mode_rejects_options_that_require_a_native_output", "test_unix_links_math_even_without_graphics",
    "test_appkit_managed_cleanup_selection_and_native_cache", "test_quoted_flags_and_globs_are_literal_arguments",
    "test_graphics_preserves_project_and_dependency_paths", "test_graphics_cache_tracks_flags_and_compiler_version",
    "test_graphics_cache_tracks_header_contents_even_with_old_timestamp", "test_graphics_cache_does_not_read_entire_compiler",
    "test_driver_capture_bounds_selected_tool_output", "test_relative_path_entries_do_not_select_project_tools",
    "test_graphics_cache_tracks_compiler_replacement_with_preserved_mtime", "test_macos_ci_release_installation_is_private_verified_and_strict"]
for index in 0..processInfo.argumentCount() {
    let valid = processInfo.argument(index) == "ToolchainPortability"
    for name in names { if processInfo.argument(index) == name || processInfo.argument(index) == "ToolchainPortability." + name { valid = true } }
    test.check(valid, "unknown toolchain portability case " + processInfo.argument(index))
}
let scratch = test.scratch()
let logs = tf.logs(scratch + "/logs")
let root = test.lines(support.output(["pwd", "-P"], tf.next(logs)))[0]
let cases = 0
for name in names {
    if !chosen(name) { continue }
    let f = setUp(root, scratch, cases + 1, logs)
    if name == "test_xcode_sdk_discovery_preserves_explicit_overrides" { sdkDiscovery(f) }
    else if name == "test_cached_llvm_discovery_preserves_overrides_and_version_checks" { cachedClangDiscovery(f) }
    else if name == "test_concurrent_cold_launches_share_a_complete_bootstrap" { concurrentColdLaunches(f) }
    else if name == "test_selected_clang_bootstraps_both_c_and_llvm" { selectedClangBootstrapsBoth(f) }
    else if name == "test_linux_bootstrap_bounds_matching_lld_threads_with_literal_paths" { linuxBootstrapBoundsThreads(f) }
    else if name == "test_linux_bootstrap_rejects_old_or_missing_matching_linker" { linuxBootstrapRejectsLinker(f) }
    else if name == "test_compiler_lto_cache_defaults_overrides_and_make_bootstrap_parity" { compilerLtoCache(f) }
    else if name == "test_bootstrap_make_options_are_literal_and_default_argv_is_unchanged" { makeOptionsLiteral(f) }
    else if name == "test_bootstrap_rejects_malformed_make_options_before_make" { malformedMakeOptions(f) }
    else if name == "test_bootstrap_assume_old_keeps_compiler_and_rebuilds_current_runtime" { assumeOldKeepsCompiler(f) }
    else if name == "test_windows_release_discovers_native_lld_exe_without_changing_explicit_linker" { windowsReleaseDiscoversLinker(f) }
    else if name == "test_bootstrap_preserves_explicit_limits_lto_and_linker_threads" { bootstrapPreservesExplicitLimits(f) }
    else if name == "test_elf_thread_option_stays_out_of_apple_and_windows_bootstrap" { elfThreadsStayOut(f) }
    else if name == "test_incremental_windows_reports_supported_alternative" { incrementalWindows(f) }
    else if name == "test_help_and_version_are_available_without_building" { helpAndVersion(f) }
    else if name == "test_missing_source_is_rejected_before_bootstrap" { missingSource(f) }
    else if name == "test_output_cannot_replace_source_through_path_aliases" { outputAliases(f) }
    else if name == "test_failed_link_preserves_previous_executable" { failedLinkPreserves(f) }
    else if name == "test_windows_implicit_exe_cannot_replace_source" { implicitExe(f) }
    else if name == "test_successful_link_publishes_only_the_complete_executable" { successfulLinkPublishes(f) }
    else if name == "test_doctor_reports_missing_clang_actionably" { doctorMissingClang(f) }
    else if name == "test_optimization_defaults_and_debug_option" { optimizationDefaults(f) }
    else if name == "test_check_mode_does_not_link_or_replace_a_program" { checkModeDoesNotLink(f) }
    else if name == "test_check_mode_rejects_options_that_require_a_native_output" { checkModeRejectsOptions(f) }
    else if name == "test_unix_links_math_even_without_graphics" { unixLinksMath(f) }
    else if name == "test_appkit_managed_cleanup_selection_and_native_cache" { appkitCleanup(f) }
    else if name == "test_quoted_flags_and_globs_are_literal_arguments" { quotedFlagsLiteral(f) }
    else if name == "test_graphics_preserves_project_and_dependency_paths" { graphicsPaths(f) }
    else if name == "test_graphics_cache_tracks_flags_and_compiler_version" { graphicsFlagsAndVersion(f) }
    else if name == "test_graphics_cache_tracks_header_contents_even_with_old_timestamp" { graphicsHeaderContents(f) }
    else if name == "test_graphics_cache_does_not_read_entire_compiler" { executeOnlyClang(f) }
    else if name == "test_driver_capture_bounds_selected_tool_output" { driverCaptureBounded(f) }
    else if name == "test_relative_path_entries_do_not_select_project_tools" { relativePathEntriesIgnored(f) }
    else if name == "test_graphics_cache_tracks_compiler_replacement_with_preserved_mtime" { compilerReplacementPreservedMtime(f) }
    else if name == "test_macos_ci_release_installation_is_private_verified_and_strict" { macosCiRelease(f) }
    cases += 1
}
test.removeTree(scratch)
print("Toolchain portability: " + Text(cases) + " cases passed")
