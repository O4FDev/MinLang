use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "./release-support.min" as support
use "./toolchain-files.min" as tf
use "system" as system
use "files" as files
use "sha256" as sha256

record Fixture { root: Text; work: Text; project: Text; bin: Text; log: Text; clang: Text; include: Text; source: Text; output: Text; env: List<Text>; logs: tf.Logs }
record Call { failed: Boolean; errorOutput: Text; argv: List<Text>; env: List<Text> }
record Job { handle: Integer; log: Text; finished: Boolean; status: system.ProcessStatus }
record AppCase { label: Text; libraries: List<Text>; marker: Text; managed: Boolean }

function chosen(name: Text): Boolean {
    if processInfo.argumentCount() == 0 { return true }
    for index in 0..processInfo.argumentCount() {
        if processInfo.argument(index) == name || processInfo.argument(index) == "ToolchainPortability." + name || processInfo.argument(index) == "ToolchainPortability" { return true }
    }
    return false
}
function copyFile(source: Text, target: Text, logs: tf.Logs) {
    test.require(tf.run(logs, ["cp", "-p", source, target], system.environment(), "", 30), "copy " + source)
}
function copyTree(source: Text, target: Text, logs: tf.Logs) {
    test.require(tf.run(logs, ["cp", "-RLp", source, target], system.environment(), "", 120), "copy tree " + source)
}
function prefix(f: Fixture): Text {
    return "for argument in \"$@\"; do\n    if [ \"$argument\" = -print-prog-name=ld.lld ]; then printf '%s\\n' " + support.shellQuote(f.work + "/ld.lld") + "; exit 0; fi\ndone\n"
}
function fixedVersion(): Text {
    return "for argument in \"$@\"; do\n    if [ \"$argument\" = --version ]; then printf '%s\\n' 'clang version 23.1.2'; exit 0; fi\ndone\n"
}
function writeClang(f: Fixture, body: Text) {
    tf.executable(f.clang, prefix(f) + body, f.logs)
}
function defaultClang(): Text {
    return "for argument in \"$@\"; do\n    if [ \"$argument\" = --version ]; then printf '%s\\n' \"${TEST_CLANG_VERSION-clang version 23.1.2}\"; exit 0; fi\ndone\n" +
        tf.argumentLogger("TEST_CLANG_LOG") + "for argument in \"$@\"; do\n    if [ \"$argument\" = -dM ]; then printf '#define MINYAR_SYSTEM_HEAP 1\\n'; exit 0; fi\ndone\n" + tf.outputArgument() + "printf '; output\\n' > \"$target\"\n"
}
function pkgConfig(): Text {
    return "exists=0\ncflags=0\nlibs=0\nfor argument in \"$@\"; do\n    case $argument in --exists) exists=1 ;; --cflags) cflags=1 ;; --libs) libs=1 ;; esac\ndone\n" +
        "if [ \"$exists\" = 1 ]; then exit 0; fi\n" +
        "if [ \"$cflags\" = 1 ]; then\n    value=\"-I$TEST_GLFW_INCLUDE\"\n    case $value in\n" +
        "        ''|*[!A-Za-z0-9_@%+=:,./-]*) printf \"'%s'\\n\" \"$(printf '%s' \"$value\" | sed \"s/'/'\\\"'\\\"'/g\")\" ;;\n" +
        "        *) printf '%s\\n' \"$value\" ;;\n    esac\nfi\n" +
        "if [ \"$libs\" = 1 ]; then printf '%s\\n' -lglfw; fi\n"
}
function setUp(root: Text, scratch: Text, serial: Integer, logs: tf.Logs): Fixture {
    let work = scratch + "/minyar toolchain " + Text(serial)
    tf.directory(work)
    let project = work + "/project with spaces"
    let build = project + "/build"
    tf.directories(build, logs)
    copyFile(root + "/minyar", project + "/minyar", logs)
    copyTree(root + "/runtime", project + "/runtime", logs)
    copyTree(root + "/tools", project + "/tools", logs)
    io.writeTextFile(project + "/Makefile", ".PHONY: build/minyarc build/tooling/tools/clang-driver\nbuild/minyarc build/tooling/tools/clang-driver:\n\t@:\n")
    tf.directories(build + "/tooling/tools", logs)
    copyFile(root + "/build/tooling/tools/clang-driver", build + "/tooling/tools/clang-driver", logs)
    tf.executable(build + "/minyarc", "if [ -n \"${TEST_GRAPHICS-}\" ]; then printf '; minyar-native-library: graphics\\n' > \"$2\"; else printf '; test IR\\n' > \"$2\"; fi\n", logs)
    let bin = work + "/bin"
    tf.directory(bin)
    let log = work + "/clang calls.log"
    let clang = work + "/clang with spaces"
    let include = work + "/GLFW prefix with spaces/include"
    tf.directories(include, logs)
    tf.executable(bin + "/pkg-config", pkgConfig(), logs)
    let environment = support.merge(system.environment(), ["PATH=" + bin + ":" + system.getenv("PATH"), "MINYAR_CLANG=" + clang,
        "TEST_CLANG_LOG=" + log, "TEST_GLFW_INCLUDE=" + include, "LIMITED=", "SANITIZER_LIMITED="])
    environment = tf.without(environment, ["MINYAR_CLANG_FLAGS", "MINYAR_RUNTIME_FLAGS", "MINYAR_MAKE_FLAGS", "MAKEFLAGS", "MFLAGS",
        "MINYAR_NATIVE_FLAGS", "MINYAR_LINK_ARTIFACTS", "MINYAR_TEST_HOST_SYSTEM", "COMPILER_LTO_CACHE_DIR", "COMPILER_LTO_CACHE_POLICY"])
    let f = Fixture { root: root; work: work; project: project; bin: bin; log: log; clang: clang; include: include;
        source: work + "/source file.min"; output: work + "/output program"; env: environment; logs: logs }
    writeClang(f, defaultClang())
    tf.executable(work + "/ld.lld", "printf '%s\\n' 'LLD 23.1.2'\n", logs)
    io.writeTextFile(f.source, "print(42)\n")
    return f
}
function run(f: Fixture, command: List<Text>, environment: List<Text>, seconds: Integer): test.Result {
    return tf.run(f.logs, command, environment, f.work, seconds)
}
function minyar(f: Fixture, arguments: List<Text>): List<Text> {
    let command = [f.project + "/minyar"]
    for item in arguments { command.add(item) }
    return command
}
function launch(f: Fixture, extras: List<Text>): List<List<Text>> {
    io.writeTextFile(f.log, "")
    let result = run(f, minyar(f, [f.source, "-o", f.output]), support.merge(f.env, extras), 30)
    test.check(result.status == 0, "launch failed (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
    return tf.calls(f.log)
}
function last(calls: List<List<Text>>): List<Text> {
    test.check(calls.length > 0, "expected at least one Clang call")
    return calls[calls.length - 1]
}
function endsWithAny(args: List<Text>, suffix: Text): Boolean {
    for arg in args { if support.ends(arg, suffix) { return true } }
    return false
}
function containsAny(args: List<Text>, needle: Text): Boolean {
    for arg in args { if test.contains(arg, needle) { return true } }
    return false
}
function nativeCalls(calls: List<List<Text>>): List<List<Text>> {
    let result: List<List<Text>> = []
    for args in calls { if endsWithAny(args, "/native/graphics.c") { result.add(args) } }
    return result
}
function occurrences(values: List<Text>, expected: Text): Integer {
    let count = 0
    for value in values { if value == expected { count += 1 } }
    return count
}
function part(values: List<Text>, start: Integer, end: Integer): List<Text> {
    let result: List<Text> = []
    let index = start
    while index < end && index < values.length {
        result.add(values[index])
        index += 1
    }
    return result
}
function staging(f: Fixture): List<Text> {
    let result: List<Text> = []
    for name in tf.listing(f.work) { if support.starts(name, ".minyar-link-") { result.add(name) } }
    return result
}
function driverLink(f: Fixture, llvm: Text, runtime: Text, environment: List<Text>, release: Text, clang: Text): test.Result {
    let base = support.merge(f.env, ["MINYAR_CLANG=" + clang])
    return run(f, [f.project + "/build/tooling/tools/clang-driver", "link", f.project, llvm, runtime, f.output, release],
        support.merge(base, environment), 60)
}
function makeCall(): Text {
    return "{\n    printf '%s\\037' \"$@\"\n    printf '\\n'\n" +
        "    for name in CC LLVM_CC COMPILER_LTO_FLAGS LLVM_FLAGS LIMITED SANITIZER_LIMITED MINYAR_MAX_MEMORY_MIB MINYAR_MAX_CPU_SECONDS MINYAR_TEST_HOST_SYSTEM; do\n" +
        "        eval \"present=\\${$name+x}\"\n        if [ \"$present\" = x ]; then eval \"value=\\$$name\"; printf '%s=%s\\036' \"$name\" \"$value\"; fi\n    done\n} > \"$TEST_MAKE_CALL\"\n"
}
function bootstrap(f: Fixture, environment: List<Text>, targets: List<Text>): Call {
    let log = f.work + "/make call.log"
    if support.exists(log) { tf.remove(log) }
    tf.executable(f.bin + "/make", makeCall(), f.logs)
    let command = ["sh", f.project + "/tools/toolchain.sh", "bootstrap", f.project]
    for target in targets { command.add(target) }
    let result = run(f, command, support.merge(environment, ["TEST_MAKE_CALL=" + log]), 30)
    tf.remove(f.bin + "/make")
    if result.status != 0 {
        test.check(!support.exists(log), "rejected bootstrap configuration must not run make")
        return Call { failed: true; errorOutput: result.errorOutput; argv: []; env: [] }
    }
    let raw = io.readBytesFile(log)
    let argv: List<Text> = []
    let entries: List<Text> = []
    let start = 0
    let index = 0
    while index < raw.length && raw[index] != 10 {
        if raw[index] == 31 { argv.add(Text(raw.slice(start, index))); start = index + 1 }
        index += 1
    }
    test.check(index < raw.length, "make call log is incomplete")
    start = index + 1
    for position in (index + 1)..raw.length {
        if raw[position] == 30 { entries.add(Text(raw.slice(start, position))); start = position + 1 }
    }
    return Call { failed: false; errorOutput: result.errorOutput; argv: argv; env: entries }
}
function succeeded(call: Call): Call {
    test.check(!call.failed, "bootstrap failed\n" + call.errorOutput)
    return call
}
function bootstrapEnvironment(f: Fixture, extras: List<Text>, host: Text): Call {
    let overrides = support.copy(extras)
    overrides.add("MINYAR_TEST_HOST_SYSTEM=" + host)
    let environment = support.merge(f.env, overrides)
    if !tf.present(extras, "COMPILER_LTO_FLAGS") { environment = tf.without(environment, ["COMPILER_LTO_FLAGS"]) }
    if !tf.present(extras, "LLVM_FLAGS") { environment = tf.without(environment, ["LLVM_FLAGS"]) }
    return bootstrap(f, environment, ["build/minyarc-modules"])
}
function expectRejected(call: Call, diagnostic: Text) {
    test.check(call.failed, "bootstrap must be rejected with " + diagnostic)
    test.check(test.contains(call.errorOutput, diagnostic), "missing bootstrap diagnostic " + diagnostic + "\n" + call.errorOutput)
}
function alive(job: Job): Boolean {
    if job.finished { return false }
    let status = system.poll(job.handle)
    if status.error == 0 && status.state == system.PENDING { return true }
    job.finished = true
    job.status = status
    return false
}
function settle(job: Job): test.Result {
    if !job.finished {
        job.status = system.wait(job.handle)
        job.finished = true
    }
    test.check(job.status.error == 0 && (job.status.state == system.EXITED || job.status.state == system.SIGNALED), "process wait failed")
    let code = job.status.exitCode
    if job.status.state == system.SIGNALED { code = 128 + job.status.signal }
    return test.Result { status: code; output: Text(files.readFile(job.log)); errorOutput: Text(files.readFile(job.log + ".err")) }
}

function concurrentColdLaunches(f: Fixture) {
    let compiler = f.project + "/build/minyarc"
    let template = f.work + "/compiler-template"
    copyFile(compiler, template, f.logs)
    tf.remove(compiler)
    tf.executable(f.bin + "/make", "project=\nnext=0\nfor argument in \"$@\"; do\n    if [ \"$next\" = 1 ]; then project=$argument; break; fi\n    if [ \"$argument\" = -C ]; then next=1; fi\ndone\n" +
        "busy=\"$project/bootstrap-in-progress\"\nif ! mkdir \"$busy\" 2>/dev/null; then\n    if [ -d \"$busy\" ]; then echo 'overlapping cold bootstraps wrote shared artifacts' >&2; fi\n    exit 1\nfi\n" +
        "status=0\n{ sleep 0.15 && cp -p \"$TEST_COMPILER_TEMPLATE\" \"$project/build/minyarc\" && sleep 0.15; } || status=$?\nrmdir \"$busy\"\nexit \"$status\"\n", f.logs)
    let environment = support.merge(f.env, ["TEST_COMPILER_TEMPLATE=" + template])
    let handles: List<Integer> = []
    let logs: List<Text> = []
    for identity in ["first", "second"] {
        let log = tf.next(f.logs)
        logs.add(log)
        handles.add(test.start(minyar(f, [f.source, "-o", f.work + "/" + identity + " output"]), environment, f.work, log, 30))
    }
    for index in 0..handles.length {
        let result = test.finish(handles[index], logs[index])
        test.check(result.status == 0, "concurrent cold launch failed (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
    }
}
function cachedClangDiscovery(f: Fixture) {
    let home = f.work + "/home with spaces"
    let cached = home + "/.cache/minyar/toolchains/llvm-23.1.2/bin/clang"
    tf.directories(home + "/.cache/minyar/toolchains/llvm-23.1.2/bin", f.logs)
    tf.executable(cached, fixedVersion(), f.logs)
    let environment = support.merge(tf.without(f.env, ["CC", "LLVM_CC", "MINYAR_CLANG"]), ["HOME=" + home])
    let commands = [["sh", f.root + "/tools/toolchain.sh", "toolchain"], [f.root + "/build/tooling/tools/clang-driver", "toolchain"]]
    for command in commands {
        let found = tf.run(f.logs, command, environment, f.root, 10)
        test.require(found, "cached LLVM discovery")
        test.check(support.resolve(test.lines(found.output)[0], tf.next(f.logs)) == support.resolve(cached, tf.next(f.logs)), "cached LLVM path with spaces")
        for key in ["LLVM_CC", "MINYAR_CLANG"] {
            let explicit = tf.run(f.logs, command, support.merge(environment, [key + "=" + f.clang]), f.root, 10)
            test.require(explicit, "explicit compiler overrides cache")
            test.check(support.resolve(test.lines(explicit.output)[0], tf.next(f.logs)) == support.resolve(f.clang, tf.next(f.logs)), "explicit " + key + " takes precedence")
        }
        let missing = tf.run(f.logs, command, support.merge(environment, ["MINYAR_CLANG=" + home + "/missing"]), f.root, 10)
        test.check(missing.status != 0, "invalid explicit compiler must not fall back to cache")
    }
    let probe = f.work + "/discovery.mk"
    io.writeTextFile(probe, "print-minyar-clang:\n\t@printf '%s\\n' '$(LLVM_CC)'\n")
    let make = tf.run(f.logs, ["make", "-s", "--no-print-directory", "-f", "Makefile", "-f", probe, "print-minyar-clang"], environment, f.root, 10)
    test.require(make, "Make discovers cached LLVM")
    test.check(test.lines(make.output)[0] == cached, "Make uses the same cached compiler")
    for platform in ["Darwin", "Linux"] {
        let name = "clang-23"
        if platform == "Darwin" { name = "clang" }
        let fallback = f.bin + "/" + name
        tf.executable(fallback, fixedVersion(), f.logs)
        let withoutCache = support.merge(environment, ["HOME=" + home + "/empty", "MINYAR_TEST_HOST_SYSTEM=" + platform])
        for command in commands {
            let result = tf.run(f.logs, command, withoutCache, f.root, 10)
            test.require(result, "uncached platform fallback")
            test.check(support.resolve(test.lines(result.output)[0], tf.next(f.logs)) == support.resolve(fallback, tf.next(f.logs)), "uncached " + platform + " fallback is preserved")
        }
    }
    tf.executable(cached, "printf '%s\\n' 'clang version 22.1.5'\n", f.logs)
    for command in commands {
        let rejected = tf.run(f.logs, command, environment, f.root, 10)
        test.check(rejected.status != 0 && test.contains(rejected.errorOutput, "unsupported compiler"), "cached compiler still requires the pinned version")
    }
}
function sdkDiscovery(f: Fixture) {
    let sdk = f.work + "/Xcode SDK with spaces"
    tf.executable(f.bin + "/xcrun", "printf '%s\\n' " + support.shellQuote(sdk) + "\n", f.logs)
    let environment = support.merge(tf.without(f.env, ["SDKROOT"]), ["MINYAR_TEST_HOST_SYSTEM=Darwin"])
    let found = tf.run(f.logs, ["sh", f.root + "/tools/toolchain.sh", "sdkroot"], environment, f.root, 10)
    test.require(found, "Xcode SDK discovery")
    test.check(test.lines(found.output)[0] == sdk, "SDK path retains spaces")
    let explicit = tf.run(f.logs, ["sh", f.root + "/tools/toolchain.sh", "sdkroot"], support.merge(environment, ["SDKROOT=explicit SDK"]), f.root, 10)
    test.require(explicit, "explicit SDK")
    test.check(test.lines(explicit.output)[0] == "explicit SDK", "explicit SDKROOT takes precedence")
    let empty = tf.run(f.logs, ["sh", f.root + "/tools/toolchain.sh", "sdkroot"], support.merge(environment, ["SDKROOT="]), f.root, 10)
    test.check(empty.status == 0 && empty.output == "\n", "explicit empty SDKROOT is preserved")
    let log = f.work + "/sdk-environment"
    tf.executable(f.bin + "/make", "printf '%s\\n' \"$SDKROOT\" > " + support.shellQuote(log) + "\n", f.logs)
    let bootstrap = tf.run(f.logs, ["sh", f.root + "/tools/toolchain.sh", "bootstrap", f.project, "build/minyarc"], environment, f.root, 10)
    test.require(bootstrap, "bootstrap exports Xcode SDK")
    test.check(io.readTextFile(log) == sdk + "\n", "SDK reaches bootstrap children")
}
function selectedClangBootstrapsBoth(f: Fixture) {
    f.env = tf.without(f.env, ["CC"])
    tf.executable(f.bin + "/make", "{ for name in CC LLVM_CC; do eval \"present=\\${$name+x}\"; if [ \"$present\" = x ]; then eval \"value=\\$$name\"; printf '%s=%s\\n' \"$name\" \"$value\"; else printf '%s\\n' \"$name\"; fi; done; } > \"$TEST_MAKE_LOG\"\n", f.logs)
    let log = f.work + "/make environment.log"
    launch(f, ["TEST_MAKE_LOG=" + log])
    let selected = test.lines(io.readTextFile(log))
    test.check(tf.equal(selected, ["CC=" + f.clang, "LLVM_CC=" + f.clang]), "bootstrap must select Clang for CC and LLVM_CC: " + tf.show(selected))
}
function linuxBootstrapBoundsThreads(f: Fixture) {
    let linker = f.work + "/ld.lld"
    tf.executable(linker, "printf '%s\\n' 'LLD 23.1.2'\n", f.logs)
    let call = succeeded(bootstrapEnvironment(f, [], "Linux"))
    let flags = support.shellWords(tf.lookup(call.env, "COMPILER_LTO_FLAGS"))
    let expected = ["-flto=thin", "-fuse-ld=" + support.resolve(linker, tf.next(f.logs)), "-Wl,--threads=1"]
    for option in ["-Xlinker", "--thinlto-cache-dir=build/thinlto-cache", "-Xlinker",
        "--thinlto-cache-policy=cache_size=10%:cache_size_bytes=1g:cache_size_files=10000:prune_after=168h:prune_interval=0s"] { expected.add(option) }
    test.check(tf.equal(flags, expected), "Linux bootstrap LTO flags " + tf.show(flags) + " expected " + tf.show(expected))
    test.check(tf.present(call.env, "LIMITED") && tf.lookup(call.env, "LIMITED") == tf.lookup(f.env, "LIMITED"), "bootstrap must keep LIMITED")
}
function compilerLtoCache(f: Fixture) {
    copyFile(f.root + "/Makefile", f.project + "/Makefile", f.logs)
    let probe = f.project + "/probe.mk"
    io.writeTextFile(probe, "print-lto:\n\t@printf '%s\\n' $(call TOOLCHAIN_QUOTE,$(COMPILER_LTO_FLAGS))\n")
    let cache = f.work + "/user's LTO cache, objects"
    let policy = "cache_size=0%:cache_size_bytes=16m:cache_size_files=12:prune_after=1h:prune_interval=0s"
    let scenarios: List<List<Text>> = [[], ["COMPILER_LTO_CACHE_DIR="],
        ["COMPILER_LTO_CACHE_DIR=" + cache, "COMPILER_LTO_CACHE_POLICY=" + policy],
        ["COMPILER_LTO_FLAGS="], ["COMPILER_LTO_FLAGS=  -flto=thin  '-fuse-ld=/custom path/ld.lld'  "],
        ["LLVM_FLAGS=-O2 -fuse-ld=gold"], ["LLVM_FLAGS=-O2 -fuse-ld=lld --ld-path=/custom/linker"],
        ["LLVM_FLAGS=-O2 -fuse-ld=lld -Wl,--threads=3"]]
    for index in 0..scenarios.length {
        let extras = scenarios[index]
        let call = succeeded(bootstrapEnvironment(f, extras, "Linux"))
        let actual = tf.lookup(call.env, "COMPILER_LTO_FLAGS")
        let flags = support.shellWords(actual)
        let environment = tf.without(f.env, ["COMPILER_LTO_FLAGS", "LLVM_FLAGS"])
        environment = support.merge(environment, extras)
        environment = support.merge(environment, ["LLVM_CC=" + f.clang, "MINYAR_TEST_HOST_SYSTEM=Linux"])
        let made = run(f, ["make", "-s", "-C", f.project, "-f", "Makefile", "-f", probe, "print-lto"], environment, 10)
        test.check(made.status == 0 && made.output == actual + "\n", "Make and bootstrap flags differ for case " + Text(index) + "\n" + made.output + made.errorOutput + "\n" + actual)
        if index == 0 { test.check(support.has(flags, "--thinlto-cache-dir=build/thinlto-cache"), "default compiler cache is enabled") }
        if index == 1 || index >= 3 { test.check(!containsAny(flags, "--thinlto-cache"), "disabled or custom compiler links must not gain cache flags") }
        if index == 2 {
            test.check(support.has(flags, "--thinlto-cache-dir=" + cache), "cache path is one literal argument, including apostrophe, comma and spaces")
            test.check(support.has(flags, "--thinlto-cache-policy=" + policy), "explicit cache policy reaches lld unchanged")
        }
        if index == 3 || index == 4 { test.check(actual == tf.lookup(extras, "COMPILER_LTO_FLAGS"), "explicit LTO flags remain byte-for-byte unchanged") }
        if index == 5 || index == 6 || index == 7 { test.check(tf.equal(flags, ["-flto=thin"]), "custom linker options stay under user control") }
    }
    tf.directory(f.project + "/build-support")
    copyFile(f.root + "/build-support/compiler.mk", f.project + "/build-support/compiler.mk", f.logs)
    let automatic = tf.without(f.env, ["COMPILER_LTO_FLAGS", "LLVM_FLAGS"])
    automatic = support.merge(automatic, ["CC=" + f.clang, "LLVM_CC=" + f.clang, "MINYAR_TEST_HOST_SYSTEM=Linux"])
    let stampCommand = ["make", "-s", "-C", f.project, "build/.toolchain.json"]
    test.require(run(f, stampCommand, automatic, 10), "stamp automatic compiler LTO flags")
    let stamped = io.readBytesFile(f.project + "/build/.toolchain.json")
    let linker = f.work + "/ld.lld"
    tf.executable(linker, "printf '%s\\n' 'LLD 18.1.3'\n", f.logs)
    for missing in [false, true] {
        if missing { tf.remove(linker) }
        let rejected = run(f, stampCommand, automatic, 10)
        test.check(rejected.status != 0 && test.contains(rejected.errorOutput, "requires LLVM 23.1.2"), "failed default LLD selection must reject the build rather than disable LTO\n" + rejected.output + rejected.errorOutput)
        test.check(support.same(io.readBytesFile(f.project + "/build/.toolchain.json"), stamped), "rejected default LLD keeps the last valid toolchain stamp")
    }
    test.require(run(f, ["make", "-s", "-C", f.project, "clean"], automatic, 10), "make clean must work without a valid LLVM installation")
    for host in ["Darwin", "Windows"] {
        tf.executable(f.bin + "/uname", "printf '%s\\n' " + support.shellQuote(host) + "\n", f.logs)
        let environment = tf.without(f.env, ["COMPILER_LTO_FLAGS", "LLVM_FLAGS"])
        environment = support.merge(environment, ["LLVM_CC=/unused/clang", "SDKROOT=explicit SDK"])
        let made = run(f, ["make", "-s", "-C", f.project, "-f", "Makefile", "-f", probe, "print-lto"], environment, 10)
        test.check(made.status == 0 && made.output == "-flto=thin\n", host + " Make defaults must remain unchanged\n" + made.output + made.errorOutput)
    }
}
function linuxBootstrapRejectsLinker(f: Fixture) {
    let linker = f.work + "/ld.lld"
    tf.executable(linker, "printf '%s\\n' 'LLD 18.1.3'\n", f.logs)
    expectRejected(bootstrapEnvironment(f, [], "Linux"), "requires LLVM 23.1.2; unsupported linker")
    tf.remove(linker)
    expectRejected(bootstrapEnvironment(f, [], "Linux"), "requires LLVM 23.1.2; LLD executable not found")
}
function makeOptionsLiteral(f: Fixture) {
