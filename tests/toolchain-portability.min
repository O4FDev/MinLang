function variant(labels: List<Text>, values: List<Text>, label: Text): Text {
    for index in 0..labels.length { if labels[index] == label { return values[index] } }
    test.check(false, "missing AppKit variant " + label)
    return ""
}
function appkitCleanup(f: Fixture) {
    let llvm = f.work + "/app.ll"
    let runtime = f.project + "/build/minyar-default-runtime.o"
    let macro = "-DMINYAR_APP_MANAGED_CLEANUP=1"
    let labels: List<Text> = []
    let variants: List<Text> = []
    let cases = [
        AppCase { label: "ordinary"; libraries: ["macos", "net"]; marker: ""; managed: false },
        AppCase { label: "cycle"; libraries: ["macos", "net"]; marker: "; minyar-cycle-runtime: 1\n"; managed: true },
        AppCase { label: "callback"; libraries: ["macos", "net"]; marker: "; minyar-callback-runtime: 1\n"; managed: true },
        AppCase { label: "callback-library"; libraries: ["macos", "net", "callbackruntime"]; marker: ""; managed: true },
        AppCase { label: "ordinary-warm"; libraries: ["macos", "net"]; marker: ""; managed: false },
        AppCase { label: "cycle-without-appkit"; libraries: ["net"]; marker: "; minyar-cycle-runtime: 1\n"; managed: false },
        AppCase { label: "plain"; libraries: []; marker: ""; managed: false },
    ]
    let environment = ["MINYAR_CLANG_FLAGS=-O0", "MINYAR_NATIVE_FLAGS=-O1 -DCONTROL=1", "MINYAR_TEST_HOST_SYSTEM=Darwin"]
    for item in cases {
        let content = [item.marker]
        for name in item.libraries { content.add("; minyar-native-library: " + name + "\n") }
        io.writeTextFile(llvm, joinText(content))
        io.writeTextFile(f.log, "")
        let result = driverLink(f, llvm, runtime, environment, "0", f.clang)
        test.check(result.status == 0, item.label + ": AppKit link failed\n" + result.errorOutput)
        let calls = tf.calls(f.log)
        let link = last(calls)
        test.check(!support.has(link, macro), item.label + ": cleanup hooks belong only in native objects")
        test.check(containsAny(link, "/native/cycle-runtime-") == (item.marker != "" || support.has(item.libraries, "callbackruntime")), item.label + ": cycle runtime selection " + tf.show(link))
        let appObjects: List<Text> = []
        for arg in link { if test.contains(arg, "/native/macos-") { appObjects.add(arg) } }
        if support.has(item.libraries, "macos") {
            test.check(appObjects.length == 1, item.label + ": expected one AppKit object " + tf.show(link))
            labels.add(item.label)
            variants.add(appObjects[0])
            let appCompiles: List<List<Text>> = []
            for args in calls { if endsWithAny(args, "/native/macos.m") { appCompiles.add(args) } }
            if appCompiles.length > 0 {
                let expected = 0
                if item.managed { expected = 1 }
                test.check(occurrences(appCompiles[0], macro) == expected, item.label + ": managed cleanup macro " + tf.show(appCompiles[0]))
                test.check(support.has(appCompiles[0], "-DCONTROL=1"), item.label + ": native flags reach AppKit")
                test.check(support.has(appCompiles[0], "-DMINYAR_APP_EVENT_LOOP=1"), item.label + ": AppKit event loop macro")
            } else {
                test.check(item.label == "callback" || item.label == "callback-library" || item.label == "ordinary-warm", item.label + ": AppKit object must be compiled")
            }
        } else {
            test.check(appObjects.length == 0, item.label + ": no AppKit object expected " + tf.show(link))
            for args in calls { test.check(!support.has(args, macro), item.label + ": managed cleanup macro without AppKit") }
        }
    }
    test.check(variant(labels, variants, "ordinary") != variant(labels, variants, "cycle"), "managed cleanup selects a distinct AppKit object")
    test.check(variant(labels, variants, "cycle") == variant(labels, variants, "callback"), "callback runtime shares the managed AppKit object")
    test.check(variant(labels, variants, "cycle") == variant(labels, variants, "callback-library"), "callback library shares the managed AppKit object")
    test.check(variant(labels, variants, "ordinary") == variant(labels, variants, "ordinary-warm"), "ordinary AppKit object is reused")
}
function quotedFlagsLiteral(f: Fixture) {
