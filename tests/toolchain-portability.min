function graphicsFlagsAndVersion(f: Fixture) {
    let base = ["TEST_GRAPHICS=1"]
    test.check(nativeCalls(launch(f, base)).length == 1, "a cold graphics cache compiles once")
    test.check(nativeCalls(launch(f, base)).length == 0, "a warm graphics cache is reused")
    let changed = ["TEST_GRAPHICS=1", "MINYAR_NATIVE_FLAGS=-O0 -DPORTABILITY=1"]
    test.check(nativeCalls(launch(f, changed)).length == 1, "changed native flags recompile graphics")
    test.check(nativeCalls(launch(f, changed)).length == 0, "unchanged native flags reuse graphics")
    let provider = support.copy(changed)
    provider.add("TEST_CLANG_VERSION=clang version 23.1.2 retained-provider")
    test.check(nativeCalls(launch(f, provider)).length == 1, "a changed compiler identity recompiles graphics")
    for version in ["18.1.8", "22.1.8", "23.1.3", "24.0.0"] {
        let result = run(f, minyar(f, [f.source, "-o", f.output]), support.merge(f.env, ["TEST_CLANG_VERSION=clang version " + version]), 10)
        test.check(result.status == 1, version + ": unsupported Clang must fail with status 1, saw " + Text(result.status))
        test.check(test.contains(result.errorOutput, "Minyar requires LLVM 23.1.2"), version + ": version diagnostic\n" + result.errorOutput)
    }
}
function graphicsHeaderContents(f: Fixture) {
