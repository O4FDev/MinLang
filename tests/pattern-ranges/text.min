// The suite replaces this visible marker inside literals with one zero byte.
function classify(value: Text): Text {
    return match value {
        "" { "empty" }
        "moon" { "dynamic" }
        "0..10" { "range text" }
        #"a\b"# { "raw slash" }
        "a\"b" { "quote" }
        "a\nb" { "newline" }
        "left__PATTERN_NUL__right" { "zero byte" }
        "left__PATTERN_NUL__" { "zero tail" }
        "é" { "composed" }
        "é" { "decomposed" }
        _ { "other" }
    }
}
let zero = Text(Character(0))
for value in ["", "mo" + "on", "0." + ".10", "a" + Text('\\') + "b", "a" + Text('"') + "b", "a" + Text('\n') + "b", "left" + zero + "right", "left" + zero, "left" + zero + "wrong", "left", "é", "e" + Text(Character(769)), "other"] {
    print(classify(value))
}

function nested(value: Maybe<Result<Text, Text>>): Text {
    return match value {
        Some(Ok(#"a\b"#)) { "nested raw" }
        Some(Ok("left__PATTERN_NUL__right")) { "nested zero" }
        Some(Ok(text)) { text }
        Some(Err("a\"b")) { "nested quote" }
        Some(Err(error)) { error }
        None { "none" }
    }
}
print(nested(Some(Ok("a" + Text('\\') + "b"))))
print(nested(Some(Ok("left" + zero + "right"))))
print(nested(Some(Err("a" + Text('"') + "b"))))
print(nested(None))
