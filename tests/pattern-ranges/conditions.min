record Reading { number: Integer; label: Text }
record Counter { calls: Integer }
function next(counter: Counter): Maybe<Reading> {
    counter.calls += 1
    if counter.calls >= 4 { return None }
    return Some(Reading { number: counter.calls - 1; label: Text(counter.calls) })
}

if Reading { number: 7; label: "record" } is Reading(0..10, label) { print(label) }
let value = Some(15)
if value is Some(0..10) { fail("matched the wrong range") }
else if value is Some(10..20) { print("teens") }
else { fail("lost the else-if range") }

let counter = Counter { calls: 0 }
while next(counter) is Some(Reading(0..3, label)) { print(label) }
print(counter.calls)

let stopped = Counter { calls: 0 }
while next(stopped) is Some(Reading(0..2, label)) { print(label) }
print(stopped.calls)

let exits = Counter { calls: 0 }
while next(exits) is Some(Reading(0..10, label)) {
    if label == "1" { continue }
    print(label)
    if label == "3" { break }
}
print(exits.calls)

function first(counter: Counter): Text {
    while next(counter) is Some(Reading(0..10, label)) { return label }
    return "empty"
}
print(first(Counter { calls: 0 }))
