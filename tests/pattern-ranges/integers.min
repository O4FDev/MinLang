function classify(value: Integer): Text {
    return match value {
        -10..0 { "below" }
        0..10 { "single digit" }
        10..20 { "teens" }
        _ { "outside" }
    }
}
for value in [-11, -10, -1, 0, 9, 10, 19, 20] { print(classify(value)) }

function overlap(value: Integer): Text {
    return match value { 0..10 { "first" } 5..15 { "second" } _ { "other" } }
}
for value in [4, 5, 9, 10, 14, 15] { print(overlap(value)) }

function radix(value: Integer): Boolean { return match value { 0x0..0o10 { true } _ { false } } }
for value in [0, 7, 8] { print(radix(value)) }
print(match -16 { -0x10..-0o10 { "negative radix" } _ { "wrong" } })
print(match -8 { -0x10..-0o10 { "wrong" } _ { "exclusive upper" } })
match 7 { 0..8 { print("statement") } _ { fail("lost the statement range") } }
