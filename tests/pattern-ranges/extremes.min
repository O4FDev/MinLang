function domain(value: Integer): Text {
    return match value {
        -9223372036854775808..-1 { "negative" }
        -1..1 { "near zero" }
        1..9223372036854775807 { "positive" }
        9223372036854775807 { "maximum" }
    }
}
for value in [-9223372036854775808, -9223372036854775807, -2, -1, 0, 1, 9223372036854775806, 9223372036854775807] { print(domain(value)) }

print(match -9223372036854775808 {
    -9223372036854775808..-9223372036854775807 { "floor" }
    _ { "wrong" }
})
print(match 9223372036854775806 {
    9223372036854775806..9223372036854775807 { "ceiling neighbour" }
    _ { "wrong" }
})
print(match -9223372036854775808 { -0x8000000000000000..0 { "hex floor" } _ { "wrong" } })
print(match 9223372036854775806 { 0x7ffffffffffffffe..0x7fffffffffffffff { "hex ceiling" } _ { "wrong" } })

function bounded(value: Integer): Integer {
    match value {
        -9223372036854775808..9223372036854775807 { return 1 }
        9223372036854775807 { return 2 }
    }
}
print(bounded(-9223372036854775808))
print(bounded(9223372036854775807))

function optional(value: Maybe<Integer>): Text {
    return match value {
        Some(-9223372036854775808..9223372036854775807) { "some" }
        Some(9223372036854775807) { "last" }
        None { "none" }
    }
}
print(optional(Some(0)))
print(optional(Some(9223372036854775807)))
print(optional(None))
