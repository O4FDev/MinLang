record Reading { number: Integer; label: Text }
record Holder { value: Maybe<Reading> }
function clear(holder: Holder, accepted: Boolean): Boolean { holder.value = None; return accepted }

let holder = Holder { value: Some(Reading { number: 7; label: "kept" }) }
print(match holder.value {
    Some(Reading(0..10, label)) where clear(holder, false) { "wrong" }
    Some(Reading(_, label)) { label }
    _ { "lost" }
})

record TextHolder { value: Maybe<Text> }
function forget(holder: TextHolder): Boolean { holder.value = None; return false }
let textHolder = TextHolder { value: Some("text " + "kept") }
print(match textHolder.value {
    Some("text kept") where forget(textHolder) { "wrong" }
    Some(text) { text }
    _ { "lost" }
})

function reader(input: Maybe<Result<Text, Text>>): () -> Text {
    match input {
        Some(Ok("moon")) { return function() { return "literal" } }
        Some(Ok(text)) { return function() { return text } }
        _ { return function() { return "lost" } }
    }
}
print(reader(Some(Ok("dy" + "namic")))())
print(reader(Some(Ok("mo" + "on")))())

record Stream { index: Integer }
function next(stream: Stream): Maybe<Reading> {
    stream.index += 1
    if stream.index > 3 { return None }
    return Some(Reading { number: stream.index; label: Text(stream.index) })
}
function firstReader(): () -> Text {
    let stream = Stream { index: 0 }
    while next(stream) is Some(Reading(0..2, label)) { return function() { return label } }
    return function() { return "lost" }
}
print(firstReader()())

for index in 0..100 {
    let temporary = Holder { value: Some(Reading { number: 7; label: "loop" }) }
    if temporary.value is Some(Reading(0..10, label)) {
        temporary.value = None
        if label != "loop" { fail("lost a range condition binding") }
    }
}
print("clean")
