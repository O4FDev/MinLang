choice Pair { Both(number: Integer, flag: Boolean); Empty }
function quadrant(value: Pair): Integer {
    return match value {
        Both(-9223372036854775808..0, false) { 0 }
        Both(-9223372036854775808..0, true) { 1 }
        Both(0..9223372036854775807, false) { 2 }
        Both(0..9223372036854775807, true) { 3 }
        Both(9223372036854775807, false) { 4 }
        Both(9223372036854775807, true) { 5 }
        Empty { 6 }
    }
}
for value in [Both(-9223372036854775808, false), Both(-1, true), Both(0, false), Both(42, true), Both(9223372036854775807, false), Both(9223372036854775807, true), Empty] { print(quadrant(value)) }

function uneven(value: Pair): Integer {
    return match value {
        Both(-9223372036854775808..10, false) { 10 }
        Both(10..9223372036854775807, false) { 11 }
        Both(9223372036854775807, false) { 12 }
        Both(-9223372036854775808..0, true) { 13 }
        Both(0..9223372036854775807, true) { 14 }
        Both(9223372036854775807, true) { 15 }
        Empty { 16 }
    }
}
for value in [Both(-1, false), Both(5, false), Both(10, false), Both(9223372036854775807, false), Both(-1, true), Both(0, true), Both(9223372036854775807, true), Empty] { print(uneven(value)) }

function nested(value: Result<Maybe<Pair>, Text>): Text {
    return match value {
        Ok(Some(Both(0..10, true))) { "small lit" }
        Ok(Some(Both(0..10, false))) { "small dark" }
        Ok(Some(Both(_, _))) { "larger" }
        Ok(Some(Empty)) { "empty pair" }
        Ok(None) { "absent" }
        Err(error) { error }
    }
}
print(nested(Ok(Some(Both(7, true)))))
print(nested(Ok(Some(Both(7, false)))))
print(nested(Ok(Some(Both(10, true)))))
print(nested(Ok(None)))

function guarded(value: Pair): Text {
    return match value {
        Both(0..10, flag) where flag { "lit" }
        Both(0..10, _) { "quiet" }
        _ { "outside" }
    }
}
print(guarded(Both(7, true)))
print(guarded(Both(7, false)))
