use "../tools/testing.min" as test
use "system" as system
use "files" as files
let compiler = test.compiler()
function rejection(compiler: test.Compiler, source: Text, diagnostic: Text) {
    test.rejects(compiler, source, diagnostic)
}
rejection(compiler, "print(0.", "expected a field or method name after '.'")
rejection(compiler, "for 1 in 0..1 {}\n", "I can't find a value named 'for'")
test.executes(compiler, "function main() { print(42) }\n", "42\n")
test.executes(compiler, "record Signed native \"c\" { value: Int32 }\nlet value = Signed { value: -2147483648 }\nprint(sizeOf(Signed)); print(alignOf(Signed)); print(value.value)\nvalue.value = 2147483647\nprint(value.value)\n", "4\n4\n-2147483648\n2147483647\n")
test.executes(compiler, "record Packet native \"c\" { bytes: Bytes[3] }\nprint(sizeOf(Packet)); print(alignOf(Packet))\n", "3\n1\n")
rejection(compiler, "record Packet native \"c\" { bytes: Bytes[length] }\n", "a C-layout byte array needs a constant positive length")
rejection(compiler, "record OrdinaryComparisonValue { value: Integer }\nlet values: List<Integer> = [2, 1]\nlet comparator = OrdinaryComparisonValue { value: 1 }\nlet ordered = values.sortedBy(comparator)\n", "sortBy and sortedBy require Callback<T, T, Integer>")
rejection(compiler, "record OrdinaryComparisonValue { value: Integer }\nlet callback = function(value: Integer): Integer { return value }\nlet comparator = OrdinaryComparisonValue { value: 1 }\ncomparator(1, 2)\n", "I can't find a function named 'comparator'")
let work = compiler.directory
writeTextFile(work + "/machine.min", "use \"machine\" as machine\nthread function worker(seed: Integer, input: FrozenBytes, channel: BytesChannel): Integer { return seed }\nfunction main() { nativeThreadSetup(); machine.copy(0, 0, 0); machine.fill8(0, 0, 0); machine.fill32(0, 0, 0) }\n")
test.require(test.run([compiler.executable, work + "/machine.min", work + "/machine.ll", "--library", "library"], system.environment(), "", work + "/machine.compile", 30), "reviewed main machine buffer signatures compile")
let machine = readTextFile(work + "/machine.ll")
for name in ["copy", "fill8", "fill32"] { test.check(test.contains(machine, "minyar_machine_" + name + "8:5(1,1,1)"), "reviewed machine signature is emitted: " + name) }
writeTextFile(work + "/empty-state", "")
writeTextFile(work + "/main-only.min", "function main() { print(42) }\n")
for mode in ["cold", "warm"] {
    let input = work + "/empty-state"
    if mode == "warm" { input = work + "/main-cold.state" }
    let prefix = work + "/main-" + mode
    test.require(test.run([compiler.executable, work + "/main-only.min", prefix + ".ll", "--module-state", input, prefix + ".state", prefix + ".stats"], system.environment(), "", prefix + ".compile", 30), "main-only cached module compilation")
    if test.addressEnabled(compiler.flags) { writeTextFile(prefix + ".ll", test.instrument(readTextFile(prefix + ".ll"))) }
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization, "-Wno-override-module"]
        for flag in compiler.flags { command.add(flag) }
        for item in [prefix + ".ll", compiler.runtime, "-lm", "-o", prefix] { command.add(item) }
        test.require(test.run(command, system.environment(), "", prefix + ".link", compiler.linkTimeout), "main-only cached module link")
        let result = test.run([prefix], system.environment(), "", prefix + ".run", compiler.runTimeout)
        test.check(result.status == 0 && result.output == "42\n" && result.errorOutput == "", "main-only cached module preserves entry behavior")
    }
}
writeTextFile(work + "/entry.min", "public thread function worker(seed: Integer, input: FrozenBytes, channel: BytesChannel): Integer { return seed }\n")
writeTextFile(work + "/shadow.min", "use \"./entry.min\" as entry\nfunction main() {\nlet worker = 7\nlet bytes = Bytes(1)\nlet frozen = freezeBytes(bytes)\nlet channel = bytesChannel(4096, 8)\nlet handle = startThread(entry.worker, 0, frozen, channel)\nprint(joinThread(handle))\n}\n")
let shadow = test.run([compiler.executable, work + "/shadow.min", work + "/shadow.ll", "--library", "library"], system.environment(), "", work + "/shadow-result", 30)
test.check(shadow.status == 1 && shadow.output == "" && test.contains(shadow.errorOutput, "startThread requires a named thread entry") && files.pathSize(work + "/shadow.ll") < 0, "a readable local binding cannot shadow a qualified thread entry\n" + shadow.output + shadow.errorOutput)
writeTextFile(work + "/boundary.min", "function echo(value: Text): Text { value = value + \"!\"; return value }\nprint(echo(\"alive\"))\n")
for budget in [1, 2] {
    let path = work + "/boundary-" + Text(budget)
    test.require(test.run([compiler.executable, work + "/boundary.min", path + ".ll", "--bounded-owners", Text(budget)], system.environment(), "", path + ".compile", 30), "ownership boundary compilation")
    let llvm = readTextFile(path + ".ll")
    let stacked = test.contains(llvm, "call void @minyar_rc_enter_stack_v1(ptr %rc.stack.header, ptr %rc.stack.owners, i64 1)")
    test.check(stacked == (budget == 2), "one owner is admitted exactly below the cleanup budget")
    test.check(test.contains(llvm, "define ptr @.minyar.fn.echo(ptr %argument.0) noinline {") == (budget == 2), "stack ownership retains the noinline frame lifetime boundary")
    for mode in ["cold", "warm"] {
        let input = work + "/empty-state"
        if mode == "warm" { input = path + "-cold.state" }
        let prefix = path + "-" + mode
        test.require(test.run([compiler.executable, work + "/boundary.min", prefix + ".ll", "--module-state", input, prefix + ".state", prefix + ".stats", "--bounded-owners", Text(budget)], system.environment(), "", prefix + ".compile", 30), "cached module ownership boundary compilation")
        let module = readTextFile(prefix + ".ll")
        test.check(test.contains(module, "call void @minyar_rc_enter_stack_v1(ptr %rc.stack.header, ptr %rc.stack.owners, i64 1)") == (budget == 2), "cached module admits one owner exactly below the cleanup budget")
        let header = ""
        let protectedFrame = false
        for line in test.lines(module) {
            if test.contains(line, "define ") { header = line }
            if test.contains(line, "call void @minyar_rc_enter_stack_v1(ptr %rc.stack.header, ptr %rc.stack.owners, i64 1)") {
                test.check(test.contains(header, "echo") && test.contains(header, " noinline {"), "cached module stack frame is protected from inlining")
                protectedFrame = true
            }
        }
        test.check(protectedFrame == (budget == 2), "cached module preserves the noinline frame lifetime boundary")
    }
    writeTextFile(path + ".c", "#include \"minyar_runtime.c\"\n#include \"minyar_stack_frames.h\"\n")
    let runtimeCommand = [compiler.clang, "-O1", "-DMINYAR_SYSTEM_HEAP=1", "-DMINYAR_RC_POLL_BUDGET=" + Text(budget), "-iquote", "runtime"]
    for flag in compiler.flags { runtimeCommand.add(flag) }
    for item in ["-c", path + ".c", "-o", path + ".o"] { runtimeCommand.add(item) }
    test.require(test.run(runtimeCommand, system.environment(), "", path + ".runtime", compiler.linkTimeout), "actual bounded ownership runtime")
    if test.addressEnabled(compiler.flags) { writeTextFile(path + ".ll", test.instrument(llvm)) }
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization, "-Wno-override-module"]
        for flag in compiler.flags { command.add(flag) }
        for item in [path + ".ll", path + ".o", "-lm", "-o", path] { command.add(item) }
        test.require(test.run(command, system.environment(), "", path + ".link", compiler.linkTimeout), "ownership boundary link")
        let result = test.run([path], system.environment(), "", path + ".run", compiler.runTimeout)
        test.check(result.status == 0 && result.output == "alive!\n" && result.errorOutput == "", "ownership boundary preserves reference lifetime at " + optimization)
    }
}
test.removeTree(work)
print("mutation boundary coverage: passed")
