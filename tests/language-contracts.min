use "../tools/testing.min" as test
use "../tools/test-runtime.min" as runtime
use "./frontend-fixtures.min" as fixtures
use "io" as io
use "files" as files
use "system" as system

function compileWith(compiler: test.Compiler, source: Text, options: List<Text>): test.Result {
    compiler.serial += 1
    let path = compiler.directory + "/case" + Text(compiler.serial)
    io.writeTextFile(path + ".min", test.sourceModules(source))
    let command = [compiler.executable, path + ".min", path + ".ll", "--library", "library"]
    for option in options { command.add(option) }
    let result = test.run(command, system.environment(), "", path + ".compile", 30)
    if result.status == 0 && test.addressEnabled(compiler.flags) {
        io.writeTextFile(path + ".ll", test.instrument(io.readTextFile(path + ".ll")))
    }
    return result
}

function runCompiled(compiler: test.Compiler, level: Text): test.Result {
    let path = compiler.directory + "/case" + Text(compiler.serial)
    let command = [compiler.clang, level, "-Wno-override-module"]
    for flag in compiler.flags { command.add(flag) }
    for item in [path + ".ll", compiler.runtime, "-pthread", "-lm", "-o", path + ".exe"] { command.add(item) }
    test.require(test.run(command, system.environment(), "", path + ".link", 60), "link contracts " + level)
    return test.run([path + ".exe"], system.environment(), "", path + ".run", 30)
}

function executes(compiler: test.Compiler, source: Text, expected: Text, options: List<Text>) {
    test.require(compileWith(compiler, source, options), "compile contracts")
    for level in ["-O0", "-O2"] {
        let result = runCompiled(compiler, level)
        test.require(result, "execute contracts " + level)
        test.check(result.output == expected, "contracts output " + level + "\n" + result.output)
        test.check(result.errorOutput == "", "contracts stderr " + level + "\n" + result.errorOutput)
    }
}

function fails(compiler: test.Compiler, source: Text, kind: Text, line: Integer, expected: Text, options: List<Text>) {
    test.require(compileWith(compiler, source, options), "compile failing " + kind)
    let path = compiler.directory + "/case" + Text(compiler.serial)
    for level in ["-O0", "-O2"] {
        let result = runCompiled(compiler, level)
        test.check(result.status == 1 && result.output == expected, "failing " + kind + " status/output " + level + "\n" + result.output + result.errorOutput)
        test.check(test.contains(result.errorOutput, kind + " contract failed"), "failing contract names its clause\n" + result.errorOutput)
        test.check(test.contains(result.errorOutput, path + ".min:" + Text(line) + ":"), "failing contract keeps its original source line\n" + result.errorOutput)
    }
}

function definitions(ir: Text): Integer {
    let count = 0
    for line in test.lines(ir) { if line.startsWith("define ") { count += 1 } }
    return count
}

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let compiler = frontend.compiler
fixtures.validate("LanguageContracts", ["boundaries", "nothing", "ownership", "names", "failures", "rejections", "release", "parallel", "incremental", "discovery", "gallery"])

// Every successful execution uses the exact ownership/debt oracle, including
// release builds. Explicit contract failures use its exit-status exception.
let engine = runtime.cycleSource(io.readTextFile("runtime/minyar_runtime.c"))
let contract = test.replace(io.readTextFile("tests/memory-contracts-runtime.c"), "#include \"../runtime/minyar_runtime.c\"", engine)
io.writeTextFile(compiler.directory + "/runtime.c", contract)
compiler.runtime = compiler.directory + "/runtime.o"
let runtimeBuild = [compiler.clang, "-O1", "-DMINYAR_SYSTEM_HEAP=1", "-iquote", "runtime", "-c", compiler.directory + "/runtime.c", "-o", compiler.runtime]
for flag in compiler.flags { runtimeBuild.add(flag) }
test.require(test.run(runtimeBuild, system.environment(), "", compiler.directory + "/runtime-build", 60), "build exact contracts ownership runtime")

if fixtures.selected("LanguageContracts", "boundaries") {
    executes(compiler, #"""
        global events: List<Text> = []
        function note(label: Text): Boolean { events.add(label); return true }
        function argument(): Integer { events.add("argument"); return 8 }
        function half(value: Integer): Integer
            requires(note("requires first"))
            requires(value >= 0 && note("requires second"))
            ensures(result == value / 2 && note("ensures first"))
            ensures(note("ensures second")) {
            events.add("body")
            if value == 8 { return value / 2 }
            return 0
        }
        print(half(argument()))
        for event in events { print(event) }
        """#, "4\nargument\nrequires first\nrequires second\nbody\nensures first\nensures second\n", [])

    executes(compiler, #"""
        global events: List<Text> = []
        function note(): Boolean { events.add("invariant"); return true }
        function finish(early: Boolean) invariant(note()) {
            events.add("body")
            if early { return }
            events.add("end")
        }
        finish(true)
        finish(false)
        for event in events { print(event) }
        """#, "invariant\nbody\ninvariant\ninvariant\nbody\nend\ninvariant\n", [])

    executes(compiler, #"""
        function reset(value: Integer): Integer requires(value == 42) ensures(value == 42 && result == 0) {
            value = 0
            return value
        }
        function welcome(names: List<Text>) requires(names.length == 0) ensures(names.length == 1) {
            names.add("Ada")
        }
        let names: List<Text> = []
        welcome(names)
        print(reset(42))
        print(names[0])
        """#, "0\nAda\n", [])

    executes(compiler, #"""
        function first<Item>(values: List<Item>): Item requires(values.length > 0) ensures(true) { return values[0] }
        record Lantern { light: Integer }
        function Lantern.share(count: Integer): Integer
            requires(count > 0 && count <= self.light)
            invariant(self.light >= 0)
            ensures(result == count) {
            self.light -= count
            return count
        }
        let lantern = Lantern { light: 10 }
        print(first([42, 7]))
        print(first<Text>(["harbour", "home"]))
        print(lantern.share(3))
        print(lantern.light)
        """#, "42\nharbour\n3\n7\n", [])
}

if fixtures.selected("LanguageContracts", "nothing") {
    executes(compiler, #"""
        type Done = Nothing
        type Finished = Done
        global events: List<Text> = []
        function note(label: Text): Boolean { events.add(label); return true }
        function finish(names: List<Text>, early: Boolean): Finished
            requires(note("requires"))
            ensures(names.length == 1 && note("ensures"))
            invariant(note("invariant")) {
            let owned = [Bytes(64)]
            names.add("Ada")
            if early { return }
            print(owned.length)
        }
        for early in [true, false] {
            let names: List<Text> = []
            finish(names, early)
            print(names[0])
        }
        for event in events { print(event) }
        """#, "Ada\n1\nAda\nrequires\ninvariant\nensures\ninvariant\nrequires\ninvariant\nensures\ninvariant\n", [])

    io.writeTextFile(compiler.directory + "/nothing-types.min", "public type Done = Nothing\npublic type Finished = Done\n")
    io.writeTextFile(compiler.directory + "/nothing-worker.min", "use \"./nothing-types.min\" as types\npublic function remember(names: List<Text>): types.Finished requires(names.length == 0) ensures(names.length == 1) { names.add(\"home\") }\n")
    let imported = #"""
        use "./nothing-types.min" as types
        use "./nothing-worker.min" as worker
        function visit(names: List<Text>): types.Done ensures(names.length == 2) {
            worker.remember(names)
            names.add("harbour")
        }
        let names: List<Text> = []
        visit(names)
        for name in names { print(name) }
        """#
    executes(compiler, imported, "home\nharbour\n", [])
    executes(compiler, imported, "home\nharbour\n", ["--release"])

    executes(compiler, #"""
        type Done = Nothing
        function same<Item>(value: Item): Item { return value }
        function check(result: Integer): Done ensures(same(result) == 42) {}
        function remember<Item>(values: List<Item>, value: Item): Done
            requires(values.length == 0)
            ensures(values.length == 1) {
            let owned = [Bytes(64)]
            values.add(value)
        }
        function completed<Item>(): Item ensures(true) { return }
        let numbers: List<Integer> = []
        let names: List<Text> = []
        remember(numbers, 42)
        remember<Text>(names, "home")
        check(42)
        completed<Nothing>()
        print(numbers[0])
        print(names[0])
        """#, "42\nhome\n", [])

    fails(compiler, "type Done = Nothing\nfunction finish(): Done\n    ensures(false) {}\nfinish()\n", "ensures", 3, "", [])
    fixtures.rejects(frontend, "type Done = Nothing\nfunction wrong(): Done ensures(result == 0) {}\nwrong()\n", "result", true)
    for source in [
        "function finish() {}\nlet value = finish()\n",
        "function finish() {}\nlet result = finish()\n",
        "type Done = Nothing\nfunction finish(): Done {}\nlet value = finish()\n",
        "type Done = Nothing\nfunction finish(): Done ensures(true) {}\nlet value = finish()\n"
    ] {
        fixtures.rejects(frontend, source, "Nothing cannot be stored in a binding", true)
    }
}

if fixtures.selected("LanguageContracts", "ownership") {
    executes(compiler, #"""
        function greet(name: Text): Text requires(name.length > 0) ensures(result.length > name.length) {
            let pieces = ["Hello", name]
            if name == "Ada" { return pieces[0] + ", " + pieces[1] }
            return "Welcome, " + name
        }
        function pair(values: List<Text>): List<Text>
            requires(values.length == 1)
            ensures(result.length == 2 && result[1] == values[0]) {
            let names = ["North"]
            names.add(values[0])
            return names
        }
        record Letter { message: Text }
        function letter(name: Text): Letter ensures(result.message.length > name.length) {
            let owned = [Bytes(64)]
            return Letter { message: greet(name) + "!" }
        }
        print(letter("A" + "da").message)
        let names = pair(["Star"])
        print(names[0] + " " + names[1])
        print(greet("Grace"))
        """#, "Hello, Ada!\nNorth Star\nWelcome, Grace\n", [])

    executes(compiler, #"""
        global checked: List<Integer> = [0]
        function postcondition(): Boolean { checked[0] += 1; return true }
        function read(good: Boolean): Result<Integer, Text> { if good { return Ok(42) }; return Err("closed") }
        function open(good: Boolean): Result<Integer, Text> ensures(postcondition()) {
            let owned = [Bytes(64)]
            let answer = try read(good)
            return Ok(answer + owned.length - 1)
        }
        match open(true) { Ok(value) { print(value) } Err(error) { print(error) } }
        match open(false) { Ok(value) { print(value) } Err(error) { print(error) } }
        print(checked[0])
        """#, "42\nclosed\n2\n", [])
}

if fixtures.selected("LanguageContracts", "names") {
    executes(compiler, #"""
        function requires(value: Integer): Integer { return value + 1 }
        function ensures(value: Integer): Integer { return value + 1 }
        function invariant(value: Integer): Integer { return value + 1 }
        function result(value: Integer): Integer { return value + 1 }
        record Names { requires: Integer; ensures: Integer; invariant: Integer; result: Integer }
        function scoped(): Integer {
            let requires = 10
            let ensures = 20
            let invariant: (Integer) -> Integer = function(result) { return result + 12 }
            return invariant(requires + ensures)
        }
        let names = Names { requires: 1; ensures: 2; invariant: 3; result: 4 }
        print(result(invariant(ensures(requires(38)))))
        print(scoped())
        print(names.requires + names.ensures + names.invariant + names.result)
        """#, "42\n42\n10\n", [])

    executes(compiler, #"""
        record Box { result: Integer }
        function accepts(value: Integer, predicate: (Integer) -> Boolean): Boolean { return predicate(value) }
        function shadow(result: Integer, box: Box): Integer
            requires(result == 40)
            invariant(result == 40)
            ensures(result == 42)
            ensures(box.result == 7)
            ensures(accepts(7, function(result: Integer): Boolean { return result == box.result })) {
            return result + 2
        }
        print(shadow(40, Box { result: 7 }))
        """#, "42\n", [])

    // The first function's name is token 1. Source identifiers matching both
    // initial helper candidates must keep their ordinary function meaning.
    executes(compiler, "function answer(): Integer ensures(result == 42) { return 42 }\nfunction minyar_contract_body_1(): Integer { return 7 }\nfunction minyar_contract_body_1_(): Integer { return 8 }\nprint(answer())\nprint(minyar_contract_body_1())\nprint(minyar_contract_body_1_())\n", "42\n7\n8\n", [])
}

if fixtures.selected("LanguageContracts", "failures") {
    fails(compiler, "function half(value: Integer): Integer\n    requires(value >= 0) { print(\"body ran\"); return value / 2 }\nprint(half(-1))\n", "requires", 2, "", [])
    fails(compiler, "function half(value: Integer): Integer\n    ensures(result >= 0) { print(\"body ran\"); if value < 0 { return value }; return value / 2 }\nprint(half(-1))\n", "ensures", 2, "body ran\n", [])
    fails(compiler, "record Lantern { light: Integer }\nfunction Lantern.dark()\n    invariant(self.light >= 0) { print(\"body ran\"); self.light = -1 }\nlet lantern = Lantern { light: -1 }\nlantern.dark()\n", "invariant", 3, "", [])
    fails(compiler, "record Lantern { light: Integer }\nfunction Lantern.dark()\n    invariant(self.light >= 0) { print(\"body ran\"); self.light = -1 }\nlet lantern = Lantern { light: 1 }\nlantern.dark()\n", "invariant", 3, "body ran\n", [])

    let imported = compiler.directory + "/promises.min"
    io.writeTextFile(imported, "public function half(value: Integer): Integer\n    requires(value >= 0)\n    ensures(result >= 0) { return value / 2 }\n")
    executes(compiler, "use \"./promises.min\" as promises\nprint(promises.half(8))\n", "4\n", [])
    test.require(compileWith(compiler, "use \"./promises.min\" as promises\nprint(promises.half(-1))\n", []), "compile imported contract failure")
    for level in ["-O0", "-O2"] {
        let result = runCompiled(compiler, level)
        test.check(result.status == 1 && result.output == "", "imported contract status/output " + level)
        test.check(test.contains(result.errorOutput, "requires contract failed") && test.contains(result.errorOutput, imported + ":2:"), "imported contract keeps the declaring module's source line\n" + result.errorOutput)
    }
}

if fixtures.selected("LanguageContracts", "rejections") {
    for kind in ["requires", "ensures", "invariant"] {
        let rejected = compileWith(compiler, "function wrong(): Integer " + kind + "(42) { return 0 }\nprint(wrong())\n", [])
        let path = compiler.directory + "/case" + Text(compiler.serial)
        test.check(rejected.status == 1 && rejected.output == "", "non-Boolean " + kind + " must reject")
        test.check(test.contains(rejected.errorOutput, kind) && test.contains(rejected.errorOutput, "Boolean"), "non-Boolean " + kind + " diagnostic\n" + rejected.errorOutput)
        test.check(test.contains(rejected.errorOutput, path + ".min:1:"), "non-Boolean contract keeps its location\n" + rejected.errorOutput)
        test.check(files.pathSize(path + ".ll") < 0, "non-Boolean contract published LLVM")
    }
    fixtures.rejects(frontend, "function wrong(): Integer requires(result >= 0) { return 0 }\nprint(wrong())\n", "result", true)
    fixtures.rejects(frontend, "function wrong(): Integer invariant(result >= 0) { return 0 }\nprint(wrong())\n", "result", true)
    fixtures.rejects(frontend, "function wrong(): Integer { return result }\nprint(wrong())\n", "result", true)

    for item in [
        ["function clock(): Integer requires(true) { native \"system\" }\nprint(clock())\n", "contracts on native functions need an ordinary wrapper"],
        ["function main(): Integer requires(true) { return 0 }\n", "put entry contracts on a function called by main"]
    ] {
        for release in [false, true] {
            let options: List<Text> = []
            if release { options.add("--release") }
            let rejected = compileWith(compiler, item[0], options)
            let path = compiler.directory + "/case" + Text(compiler.serial)
            test.check(rejected.status == 1 && rejected.output == "", "unsupported contract boundary must reject")
            test.check(test.contains(rejected.errorOutput, item[1]), "unsupported contract boundary diagnostic\n" + rejected.errorOutput)
            test.check(test.contains(rejected.errorOutput, path + ".min:1:"), "unsupported contract boundary keeps its location\n" + rejected.errorOutput)
            test.check(files.pathSize(path + ".ll") < 0, "unsupported contract boundary published LLVM")
        }
    }
}

if fixtures.selected("LanguageContracts", "release") {
    // These names exist only in omitted predicates. Removing a contract removes
    // its name resolution, literals, calls, and synthetic implementation too.
    let source = "function answer(value: Integer): Integer\n    requires(removedRequires(\"requires-only-literal\"))\n    requires(startThread(neverDeclaredThread, 0) == 0)\n    ensures(removedEnsures(\"ensures-only-literal\", result))\n    invariant(removedInvariant(\"invariant-only-literal\")) { return value + 1 }\nprint(answer(41))\n"
    executes(compiler, source, "42\n", ["--release"])
    let release = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
    for forbidden in ["removedRequires", "removedEnsures", "removedInvariant", "requires-only-literal", "ensures-only-literal", "invariant-only-literal", "contract failed", "startThread", "neverDeclaredThread", "minyar-thread-runtime", "minyar_thread_"] {
        test.check(!test.contains(release, forbidden), "release retained omitted contract code/literal: " + forbidden)
    }
    executes(compiler, "function answer(value: Integer): Integer { return value + 1 }\nprint(answer(41))\n", "42\n", ["--release"])
    let plain = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
    test.check(definitions(release) == definitions(plain), "release retained a synthetic contract wrapper")

    for kind in ["requires", "ensures", "invariant"] {
        let checked = "function answer(): Integer\n    " + kind + "(false) { return 42 }\ntest \"contracts survive release test mode\" { print(answer()) }\nprint(answer())\n"
        executes(compiler, checked, "42\n", ["--release"])
        fails(compiler, checked, kind, 2, "", ["--release", "--test-mode"])
        fails(compiler, checked, kind, 2, "", ["--test-mode", "--release"])
    }

    executes(compiler, "test \"excluded contracts need no checking\" {\n    function main() requires() { native \"not_a_library\" }\n}\nfunction answer(): Integer ensures(result == 42) { return 42 }\nprint(answer())\n", "42\n", [])

    // Literal input/output names and paired library values are not options.
    let literals = [
        ["--release", "out.ll", "", "", "checked"],
        ["main.min", "--test-mode", "--release", "", "erased"],
        ["main.min", "out.ll", "", "--release", "checked"],
        ["main.min", "out.ll", "--release", "--test-mode", "erased"]
    ]
    let executable = test.resolvePath(compiler.executable)
    for index in 0..literals.length {
        let item = literals[index]
        let directory = compiler.directory + "/literal-options-" + Text(index)
        test.check(files.makeDirectory(directory) == 0, "literal option workspace")
        io.writeTextFile(directory + "/" + item[0], "function answer(): Integer requires(false) { return 42 }\nprint(answer())\n")
        let command = [executable, item[0], item[1]]
        if item[2] != "" { command.add(item[2]) }
        if item[3] != "" {
            test.check(files.makeDirectory(directory + "/" + item[3]) == 0, "literal library directory")
            command.add("--library"); command.add(item[3])
        }
        compiler.serial += 1
        let path = compiler.directory + "/case" + Text(compiler.serial)
        test.require(test.run(command, system.environment(), directory, path + ".compile", 30), "compile literal profile arguments")
        let llvm = io.readTextFile(directory + "/" + item[1])
        let enabled = item[4] == "checked"
        test.check(test.contains(llvm, "contract failed") == enabled, "literal path changed contract profile")
        if test.addressEnabled(compiler.flags) { llvm = test.instrument(llvm) }
        io.writeTextFile(path + ".ll", llvm)
        for level in ["-O0", "-O2"] {
            let observed = runCompiled(compiler, level)
            if enabled {
                test.check(observed.status == 1 && observed.output == "" && test.contains(observed.errorOutput, "requires contract failed"), "literal path erased checked contracts\n" + observed.errorOutput)
            } else {
                test.require(observed, "literal path release execution")
                test.check(observed.output == "42\n" && observed.errorOutput == "", "literal path enabled release contracts")
            }
        }
    }
}

if fixtures.selected("LanguageContracts", "parallel") {
    io.writeTextFile(compiler.directory + "/parallel-left.min", "public parallel function next(value: Integer): Integer requires(value >= 0) ensures(result == value + 1) { return value + 1 }\n")
    io.writeTextFile(compiler.directory + "/parallel-right.min", "parallel public function double(value: Integer): Integer invariant(value >= 0) ensures(result == value * 2) { return value * 2 }\n")
    let source = #"""
        use "./parallel-left.min" as left
        use "./parallel-right.min" as right
        parallel function nonnegative(value: Integer): Boolean { return value >= 0 }
        parallel function answer(value: Integer): Integer
            requires(nonnegative(value))
            ensures(result == (value + 1) * 2) { return right.double(left.next(value)) }
        let values: List<Integer> = []
        for index in 0..4096 { values.add(0) }
        parallel for index in 0..values.length { values[index] = answer(index) }
        print(values[4095])
        """#
    executes(compiler, source, "8192\n", [])
    let ir = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
    let scalar = false
    let scalarFunctions = 0
    for line in test.lines(ir) {
        if line.startsWith("define ") && test.contains(line, "@.minyar.fn.") { scalar = true; scalarFunctions += 1 }
        if scalar {
            test.check(!test.contains(line, "@minyar_rc_") && !test.contains(line, "@minyar_stack_"), "parallel contract wrapper/helper uses owner-thread machinery")
        }
        if line == "}" { scalar = false }
    }
    test.check(scalarFunctions >= 7, "parallel contract helper proof did not inspect imported bodies")
    executes(compiler, source, "8192\n", ["--release"])
    let erased = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
    for omitted in ["contract failed", "contract.failure|", "minyar_contract_body_"] {
        test.check(!test.contains(erased, omitted), "parallel release retains contract implementation " + omitted)
    }

    for kind in ["requires", "ensures", "invariant"] {
        let failing = "parallel function answer(): Integer\n    " + kind + "(false) { return 42 }\ntest \"parallel contracts survive release test mode\" { print(answer()) }\nprint(answer())\n"
        fails(compiler, failing, kind, 2, "", [])
        executes(compiler, failing, "42\n", ["--release"])
        fails(compiler, failing, kind, 2, "", ["--release", "--test-mode"])
        fails(compiler, failing, kind, 2, "", ["--test-mode", "--release"])
    }
    fixtures.rejects(frontend, "function predicate(value: Integer): Boolean { print(value); return true }\nparallel function answer(value: Integer): Integer requires(predicate(value)) { return value }\nprint(answer(42))\n", "can only call parallel functions", true)
    fixtures.rejects(frontend, "parallel function answer(value: Integer): Integer requires(true) { let owned = Bytes(1); return value }\nprint(answer(42))\n", "may use only Integer, Float, Boolean and Character values", true)
    fixtures.rejects(frontend, "parallel function answer(value: Integer): Integer requires(\"managed predicate\".length > 0) { return value }\nprint(answer(42))\n", "cannot use the runtime ('minyar_text_length')", true)
    fixtures.rejects(frontend, "use \"machine\" as machine\nparallel function predicate(value: Integer): Boolean { return machine.load64(value) == 0 }\nparallel function answer(value: Integer): Integer requires(predicate(value)) { return value }\nlet values = [0]\nparallel for index in 0..1 { values[index] = answer(index) }\n", "must be a pure parallel function", true)
    for options in [["--release"], []] {
        let native = compileWith(compiler, "parallel function clock(): Integer requires(true) { native \"system\" }\nprint(clock())\n", options)
        test.check(native.status == 1 && test.contains(native.errorOutput, "contracts on native functions need an ordinary wrapper"), "parallel native contract bypassed wrapper rejection\n" + native.errorOutput)
        test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "rejected parallel native contract published LLVM")
    }

    if system.getenv("OS") != "Windows_NT" {
        // Each cached module has its own globals list. Their first diagnostics
        // must still name distinct literal and static-failure symbols.
        io.writeTextFile(compiler.directory + "/literal-left.min", "public function answer(value: Integer): Integer requires(value >= 0) { return value + 1 }\n")
        io.writeTextFile(compiler.directory + "/literal-right.min", "public function answer(value: Integer): Integer ensures(result >= value) { return value + 1 }\n")
        let entry = compiler.directory + "/literal-entry.min"
        io.writeTextFile(entry, "use \"./literal-left.min\" as left\nuse \"./literal-right.min\" as right\nprint(left.answer(20) + right.answer(20))\n")
        let driver = test.setting("MINYAR_TEST_MODULE_DRIVER", "./build/minyar-module-build")
        for phase in 0..4 {
            compiler.serial += 1
            let path = compiler.directory + "/case" + Text(compiler.serial)
            let command = [driver, compiler.executable, entry, path + ".ll", compiler.directory + "/literal-cache", path + ".stats", "--library", "library"]
            if phase >= 2 { command.add("--release") }
            test.require(test.run(command, system.environment(), "", path + ".compile", 60), "cached independent contract literals")
            let counters = test.words(io.readTextFile(path + ".stats"))
            test.check(counters.length == 7, "cached literal counters")
            if phase == 0 || phase == 2 { test.check(counters[0] == "0" && counters[1] == "3", "literal profile must compile cold") }
            else { test.check(counters[0] == "3" && counters[1] == "0", "literal profile must reuse all three modules") }
            let llvm = io.readTextFile(path + ".ll")
            if phase >= 2 { test.check(!test.contains(llvm, "contract.failure|") && !test.contains(llvm, "contract failed"), "cached release retains static contract failure") }
            if test.addressEnabled(compiler.flags) { io.writeTextFile(path + ".ll", test.instrument(llvm)) }
            for level in ["-O0", "-O2"] {
                let observed = runCompiled(compiler, level)
                test.require(observed, "run independent cached contract literals")
                test.check(observed.output == "42\n" && observed.errorOutput == "", "cached contract literal output\n" + observed.output + observed.errorOutput)
            }
        }
    }
}

if fixtures.selected("LanguageContracts", "gallery") {
    let gallery = io.readTextFile("examples/gallery/contracts.min")
    let expected = "North Star lends 3 lights to the harbour.\nNorth Star lends 2 lights to the village.\n5 lights remain for the way home.\n"
    executes(compiler, gallery, expected, [])
    executes(compiler, gallery, expected, ["--release"])
}

if fixtures.selected("LanguageContracts", "incremental") && system.getenv("OS") != "Windows_NT" {
    let driver = test.setting("MINYAR_TEST_MODULE_DRIVER", "./build/minyar-module-build")
    let entry = compiler.directory + "/cached-entry.min"
    let imported = compiler.directory + "/cached-promises.min"
    let cache = compiler.directory + "/contract-cache"
    io.writeTextFile(entry, "use \"./cached-promises.min\" as promises\nprint(promises.positive(-1))\n")
    io.writeTextFile(imported, "public function positive(value: Integer): Integer\n    requires(value >= 0 && \"cached-contract-only-literal\".length > 0)\n    ensures(result >= 0) { return value }\n")
    let debugDefinitions = 0
    // Cold/warm debug, cold/warm release, and warm debug again share exactly
    // the same sources and cache directory. Profile switches must not reuse
    // the other profile's code; warm counters also forbid silent fallback.
    for phase in 0..5 {
        compiler.serial += 1
        let path = compiler.directory + "/case" + Text(compiler.serial)
        let release = phase == 2 || phase == 3
        let command = [driver, compiler.executable, entry, path + ".ll", cache, path + ".stats"]
        if phase == 2 { command.add("--release") }
        for option in ["--library", "library"] { command.add(option) }
        if phase == 3 { command.add("--release") }
        test.require(test.run(command, system.environment(), "", path + ".compile", 60), "compile cached contracts phase " + Text(phase))
        let counters = test.words(io.readTextFile(path + ".stats"))
        test.check(counters.length == 7, "cached contracts need complete build counters")
        if phase == 0 || phase == 2 {
            test.check(counters[0] == "0" && counters[1] == "2", "contract profile needs a cold two-module build")
        } else {
            test.check(counters[0] == "2" && counters[1] == "0", "contract profile needs a warm two-module cache hit")
        }
        let ir = io.readTextFile(path + ".ll")
        if phase == 0 { debugDefinitions = definitions(ir) }
        if release {
            test.check(!test.contains(ir, "cached-contract-only-literal") && !test.contains(ir, "contract failed"), "cached release retained contract literals")
            test.check(definitions(ir) < debugDefinitions, "cached release retained the contract implementation wrapper")
        }
        if test.addressEnabled(compiler.flags) { io.writeTextFile(path + ".ll", test.instrument(ir)) }
        for level in ["-O0", "-O2"] {
            let result = runCompiled(compiler, level)
            if release {
                test.check(result.status == 0 && result.output == "-1\n" && result.errorOutput == "", "cached release contracts output " + level + "\n" + result.output + result.errorOutput)
            } else {
                test.check(result.status == 1 && result.output == "", "cached debug contracts status/output " + level)
                test.check(test.contains(result.errorOutput, "requires contract failed") && test.contains(result.errorOutput, imported + ":2:"), "cached debug contract keeps imported source coordinates\n" + result.errorOutput)
            }
        }
    }

    // The frontend's raw state protocol must also reject code cached under the
    // opposite profile, even when no module driver chooses a cache namespace.
    let prior = compiler.directory + "/direct-empty.state"
    io.writeTextFile(prior, "")
    for phase in 0..3 {
        compiler.serial += 1
        let path = compiler.directory + "/case" + Text(compiler.serial)
        let release = phase == 1
        let command = [compiler.executable, entry, path + ".ll", "--module-state", prior, path + ".state", path + ".stats", "--library", "library"]
        if release { command.add("--release") }
        test.require(test.run(command, system.environment(), "", path + ".compile", 60), "compile mixed-profile raw module state phase " + Text(phase))
        prior = path + ".state"
        let counters = test.words(io.readTextFile(path + ".stats"))
        test.check(counters.length == 7 && counters[0] == "0" && counters[1] == "2", "raw module state reused code from another contract profile")
        let ir = io.readTextFile(path + ".ll")
        if release { test.check(!test.contains(ir, "cached-contract-only-literal") && !test.contains(ir, "contract failed"), "raw module state release retained contract literals") }
        if test.addressEnabled(compiler.flags) { io.writeTextFile(path + ".ll", test.instrument(ir)) }
        for level in ["-O0", "-O2"] {
            let result = runCompiled(compiler, level)
            if release {
                test.check(result.status == 0 && result.output == "-1\n" && result.errorOutput == "", "raw module state release output " + level + "\n" + result.output + result.errorOutput)
            } else {
                test.check(result.status == 1 && result.output == "", "raw module state debug status/output " + level)
                test.check(test.contains(result.errorOutput, "requires contract failed") && test.contains(result.errorOutput, imported + ":2:"), "raw module state debug lost the imported contract\n" + result.errorOutput)
            }
        }
    }
}

if fixtures.selected("LanguageContracts", "discovery") {
    let source = #"""
        function yes(predicate: () -> Boolean): Boolean { return predicate() }
        public function answer(): Integer requires(yes(function(): Boolean { return true })) { return 42 }
        test "must run after callback contracts" { print(answer()) }
        public function later(): Integer { return 7 }
        """#
    let input = compiler.directory + "/discovery.min"
    let listing = compiler.directory + "/discovery.list"
    let metadata = compiler.directory + "/discovery.json"
    io.writeTextFile(input, source)
    test.require(test.run([compiler.executable, input, listing, "--list-tests"], system.environment(), "", listing + ".run", 30), "discover tests after callback contracts")
    test.check(io.readTextFile(listing) == "0\t\"must run after callback contracts\"\n", "a callback contract swallowed the following test")
    test.require(test.run([compiler.executable, input, metadata, "--doc-json"], system.environment(), "", metadata + ".run", 30), "document callback contracts")
    let documented = io.readTextFile(metadata)
    test.check(test.contains(documented, "\"signature\":\"public function answer(): Integer requires(yes(function(): Boolean { return true }))\""), "a callback contract truncated its documented signature\n" + documented)
    test.check(test.contains(documented, "\"name\":\"later\"") && test.contains(documented, "\"name\":\"must run after callback contracts\""), "a callback contract swallowed following documentation")
    executes(compiler, source, "42\n", ["--test-mode"])
}

test.removeTree(compiler.directory)
print("Language contracts: passed")
