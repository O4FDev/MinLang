use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "./unary-fusion-fixture.min" as fusion
use "system" as system
use "files" as files
function starts(source: Text, prefix: Text): Boolean {
    let raw = Bytes(source)
    let pattern = Bytes(prefix)
    if raw.length < pattern.length { return false }
    for index in 0..pattern.length { if raw[index] != pattern[index] { return false } }
    return true
}
function parent(path: Text): Text {
    let raw = Bytes(path)
    let ending = -1
    for index in 0..raw.length { if raw[index] == 47 { ending = index } }
    if ending < 0 { return "." }
    if ending == 0 { return "/" }
    return Text(raw.slice(0, ending))
}
function optionValue(option: Text, name: Text): Text {
    let raw = Bytes(option)
    return Text(raw.slice(Bytes(name).length + 1, raw.length))
}
function compile(clang: Text, source: Text, executable: Text, flags: List<Text>, budget: Integer, environment: List<Text>) {
    let command = [clang, "-O2"]
    for flag in flags { command.add(flag) }
    command.add("-DMINYAR_RC_POLL_BUDGET=" + Text(budget))
    command.add(source)
    command.add("-o")
    command.add(executable)
    command.add("-lm")
    test.require(test.run(command, environment, "", executable + ".compile", 120), "unary fusion viable fixture compile " + executable)
}
let runtime = test.setting("MINYAR_FUSED_RUNTIME_SOURCE", "runtime/minyar_runtime.c")
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let outputDirectory = ""
let index = 0
while index < processInfo.argumentCount() {
    let option = processInfo.argument(index)
    if option == "--help" || option == "-h" {
        print("fused-unary-regressions [--runtime-source PATH] [--clang CLANG] [--output-dir PATH]")
        exit(0)
    }
    if option == "--runtime-source" || option == "--clang" || option == "--output-dir" {
        index += 1
        test.check(index < processInfo.argumentCount(), "missing value for " + option)
        if option == "--runtime-source" { runtime = processInfo.argument(index) }
        else if option == "--clang" { clang = processInfo.argument(index) }
        else { outputDirectory = processInfo.argument(index) }
    } else if starts(option, "--runtime-source=") { runtime = optionValue(option, "--runtime-source") }
    else if starts(option, "--clang=") { clang = optionValue(option, "--clang") }
    else if starts(option, "--output-dir=") { outputDirectory = optionValue(option, "--output-dir") }
    else { fail("unknown unary fusion argument " + option) }
    index += 1
}
test.check(runtime != "" && clang != "", "unary fusion runtime/clang must be set")
let environment: List<Text> = []
for entry in system.environment() {
    if !starts(entry, "ASAN_OPTIONS=") && !starts(entry, "UBSAN_OPTIONS=") { environment.add(entry) }
}
environment.add("ASAN_OPTIONS=detect_leaks=0:abort_on_error=1")
environment.add("UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1")
let work = ""
if outputDirectory == "" { work = test.scratch() }
else {
    let log = test.scratch()
    test.require(test.run(["mkdir", "-p", "--", outputDirectory], system.environment(), "", log + "/mkdir", 120), "create unary fusion output directory")
    test.removeTree(log)
    work = outputDirectory + "/minyar-tests-unary-" + Text(system.processId()) + "-" + Text(system.monotonicNanoseconds())
    test.check(files.makeDirectory(work) == 0, "create unary fusion selected scratch")
}
print(work)
for version in ["candidate", "reference"] {
    let directory = work + "/" + version
    test.check(files.makeDirectory(directory) == 0 && files.makeDirectory(directory + "/tests") == 0, "create unary fusion runtime fixture directories")
    test.require(test.run(["cp", "-RL", "--", parent(runtime), directory + "/runtime"], system.environment(), "", directory + "/copy-runtime", 120), "copy unary fusion selected runtime")
    for name in ["unary-order.c", "pair-transcript.c"] {
        test.require(test.run(["cp", "--", "tests/" + name, directory + "/tests/" + name], system.environment(), "", directory + "/copy-fixture", 120), "copy exact unary fusion fixture " + name)
    }
}
let reference = work + "/reference/runtime/minyar_bounded_rc.h"
io.writeTextFile(reference, fusion.withoutFusion(io.readTextFile(reference)))
let checks = 0
let comparisons = 0
for mode in ["native", "sanitize"] {
    let flags: List<Text> = []
    if mode == "sanitize" {
        flags.add("-fsanitize=address,undefined")
        flags.add("-fno-omit-frame-pointer")
    }
    for budget in [1, 32, 1024] {
        let outputs: List<Text> = []
        for version in ["reference", "candidate"] {
            let label = mode + "-k" + Text(budget) + "-" + version
            let executable = work + "/" + label
            compile(clang, work + "/" + version + "/tests/pair-transcript.c", executable, flags, budget, environment)
            let result = test.run([executable], environment, "", executable + ".run", 120)
            test.require(result, label + " exact scheduler transcript runtime")
            outputs.add(result.output)
            checks += 1
        }
        test.check(outputs.length == 2 && outputs[0] == outputs[1], mode + " K" + Text(budget) + " scheduler transcript mismatch")
        comparisons += 1
        let executable = work + "/" + mode + "-k" + Text(budget) + "-free-order"
        compile(clang, work + "/candidate/tests/unary-order.c", executable, flags, budget, environment)
        test.require(test.run([executable], environment, "", executable + ".run", 120), mode + " K" + Text(budget) + " allocation-reverse free order/aliases/exact 2N units")
        checks += 1
        print(mode + " " + Text(budget) + " exact transcript/free order/2N units passed")
    }
}
test.check(checks == 18 && comparisons == 6, "complete unary fusion native/SAN K1/K32/K1024 matrix")
if outputDirectory == "" { test.removeTree(work) }
print("Fused unary regressions: passed")
