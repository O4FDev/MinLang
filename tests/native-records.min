use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "system" as system
use "files" as files
function selected(name: Text): Boolean {
    if processInfo.argumentCount() == 0 { return true }
    for index in 0..processInfo.argumentCount() { if processInfo.argument(index) == name || processInfo.argument(index) == "NativeRecords." + name { return true } }
    return false
}
function rejects(compiler: test.Compiler, source: Text, diagnostic: Text) {
    let result = test.compile(compiler, source)
    test.check(result.status == 1, "native List ABI rejection status")
    test.check(result.output == "", "native List ABI rejection stdout")
    test.check(test.contains(result.errorOutput, diagnostic), "native List ABI diagnostic\n" + result.errorOutput)
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "rejected native List ABI emitted LLVM")
    test.check(!test.contains(result.errorOutput, "List position"), "native List ABI internal List diagnostic")
}
let allowed = ["test_owned_returns_and_borrowed_arguments_preserve_aliases", "test_results_remain_outside_the_native_abi", "test_lists_remain_outside_the_native_abi"]
for index in 0..processInfo.argumentCount() {
    let valid = false
    for name in allowed { if processInfo.argument(index) == name || processInfo.argument(index) == "NativeRecords." + name { valid = true } }
    test.check(valid, "unknown native records case " + processInfo.argument(index))
}
let compiler = test.compiler()
if selected("test_owned_returns_and_borrowed_arguments_preserve_aliases") {
    let rootResult = test.run(["pwd", "-P"], system.environment(), "", compiler.directory + "/root", 10)
    test.require(rootResult, "resolve native record fixture runtime")
    let root = test.lines(rootResult.output)[0]
    let source = compiler.directory + "/runtime.c"
    let contract = test.replace(io.readTextFile("tests/memory-contracts-runtime.c"), "../runtime/minyar_runtime.c", root + "/runtime/minyar_runtime.c")
    io.writeTextFile(source, contract + "\nvoid *minyar_record_abi_make(void) {\n    MinyarRecord *record = minyar_record_new(2);\n    minyar_record_set_take(record, 0, (long long)(intptr_t)minyar_integer_text(42));\n    minyar_record_set(record, 1, 42);\n    return record;\n}\nlong long minyar_record_abi_read(MinyarRecord *record) {\n    return minyar_record_get(record, 1);\n}\nvoid *minyar_record_abi_echo(MinyarRecord *record) {\n    minyar_rc_retain(record);\n    return record;\n}\n")
    let runtime = compiler.directory + "/runtime.o"
    test.require(test.run([compiler.clang, "-O2", "-DMINYAR_SYSTEM_HEAP=1", "-c", source, "-o", runtime], system.environment(), "", compiler.directory + "/runtime-build", 60), "build exact native record ownership runtime")
    test.require(test.compile(compiler, "record Box { label: Text; value: Integer }\nfunction make(): Box { native \"record_abi\" }\nfunction read(box: Box): Integer { native \"record_abi\" }\nfunction echo(box: Box): Box { native \"record_abi\" }\nlet original = make()\nlet values: List<Box> = [original, echo(original)]\nlet index = 0\nwhile index < 1000 { let held = echo(values[0]); index = index + 1 }\nprint(read(values[1]))\nprint(original.label)\nprint(\"declare \")\nprint(\"  ; minyar-native: pretend|declare i64 @pretend()\")\n"), "compile native record ABI")
    let llvm = compiler.directory + "/case" + Text(compiler.serial) + ".ll"
    for optimization in ["-O0", "-O2"] {
        let executable = compiler.directory + "/records"
        test.require(test.run([compiler.clang, optimization, "-Wno-override-module", llvm, runtime, "-lm", "-o", executable], system.environment(), "", compiler.directory + "/link", 60), "link native record ABI " + optimization)
        let result = test.run([executable], system.environment(), "", compiler.directory + "/run", 30)
        test.check(result.status == 0 && result.output == "42\n42\ndeclare \n  ; minyar-native: pretend|declare i64 @pretend()\n" && result.errorOutput == "", "native record ownership and metadata text " + optimization + "\n" + result.output + result.errorOutput)
    }
}
if selected("test_results_remain_outside_the_native_abi") {
    let frontend = test.setting("MINYAR_ERRORS_COMPILER", "./build/minyarc-errors")
    let source = compiler.directory + "/result.min"
    let llvm = compiler.directory + "/result.ll"
    if files.pathSize(llvm) >= 0 { test.check(files.remove(llvm) == 0, "clear native Result LLVM") }
    io.writeTextFile(source, test.sourceModules("function read(value: Result<Integer, Text>): Integer { native \"record_abi\" }\n"))
    let result = test.run([frontend, source, llvm], system.environment(), "", compiler.directory + "/result-compile", 30)
    test.check(result.status == 1, "native Result ABI rejection status")
    test.check(test.contains(result.errorOutput, "native functions accept"), "native Result ABI diagnostic")
    test.check(files.pathSize(llvm) < 0, "native Result ABI rejection emitted LLVM")
    if files.pathSize(llvm) >= 0 { test.check(files.remove(llvm) == 0, "clear native Result LLVM") }
    io.writeTextFile(source, test.sourceModules("function make(): Result<Integer, Text> { native \"record_abi\" }\n"))
    result = test.run([frontend, source, llvm], system.environment(), "", compiler.directory + "/result-compile", 30)
    test.check(result.status == 1, "native Result ABI rejection status")
    test.check(test.contains(result.errorOutput, "native functions return"), "native Result ABI diagnostic")
    test.check(files.pathSize(llvm) < 0, "native Result ABI rejection emitted LLVM")
}
if selected("test_lists_remain_outside_the_native_abi") {
    rejects(compiler, "function read(values: List<Integer>): Integer { native \"record_abi\" }\n", "not List")
    rejects(compiler, "function make(): List<Integer> { native \"record_abi\" }\n", "native functions return")
}
test.removeTree(compiler.directory)
print("Native record ABI ownership and boundaries: passed")
