use "../benchmarks/httpserver/cache.min" as cache

function main() {
    let c = cache.newCache(3, 1024)
    cache.insert(c, "a", Bytes("a"))
    cache.insert(c, "b", Bytes("b"))
    cache.insert(c, "c", Bytes("c"))
    if cache.lookup(c, "a") < 0 { fail("touch") }
    cache.insert(c, "d", Bytes("d"))
    if cache.lookup(c, "b") >= 0 { fail("LRU did not evict b") }
    if c.count != 3 || c.bytes != 6 || c.evictions != 1 { fail("entry accounting") }
    let tiny = cache.newCache(3, 5)
    cache.insert(tiny, "a", Bytes("a"))
    cache.insert(tiny, "b", Bytes("b"))
    cache.lookup(tiny, "a")
    cache.insert(tiny, "c", Bytes("c"))
    if cache.lookup(tiny, "b") >= 0 || tiny.bytes != 4 { fail("byte bound LRU") }
    cache.insert(tiny, "oversize", Bytes("ignored"))
    if tiny.count != 2 || tiny.evictions != 1 { fail("oversize changed cache") }
    cache.insert(tiny, "a", Bytes("z"))
    if tiny.count != 2 || tiny.bytes != 4 || tiny.evictions != 2 { fail("replacement accounting") }
    let raw = Bytes(cache.key("/api/search?k=10&q=a%20b&q=ignored"))
    if raw.length != 8 || raw[0] != 49 || raw[1] != 48 || raw[2] != 0 || Text(raw.slice(3, 8)) != "a%20b" {
        fail("raw first parameter key must contain one NUL byte")
    }
    if cache.key("/api/search?q=a+b&k=10") == cache.key("/api/search?q=a%20b&k=10") { fail("percent encoding collapsed") }
    print("cache fixture exact LRU verified")
}
