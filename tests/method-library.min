use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, "use \"errors\" as errors\nlet result = errors.checkedAdd(20, 22)\nprint(result.ok())\nprint(result.value())\nprint(errors.integerValue(result))\nprint(result.error().isError())\nlet failed = errors.checkedMultiply(9223372036854775807, 2)\nprint(failed.ok())\nprint(failed.error().code())\nprint(failed.error().nativeCode())\nprint(failed.error().message())\nlet truth = errors.boolean(true)\nprint(truth.ok())\nprint(truth.value())\n", "true\n42\n42\nfalse\nfalse\n13\n0\nInteger multiplication overflow\ntrue\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "use \"json\" as json\nlet garden = json.parse(\"{\\\"name\\\":\\\"Ada\\\",\\\"ready\\\":true,\\\"seeds\\\":42}\")\nprint(garden.hasMember(\"name\"))\nprint(garden.requireString(\"name\").text)\nprint(garden.requireBoolean(\"ready\").truth)\nprint(garden.requireNumber(\"seeds\").number)\nprint(garden.lookup(\"name\").text)\nprint(json.member(garden, \"name\").text)\nprint(garden.member(\"name\").pretty(\"  \"))\n", "true\nAda\ntrue\n42.0\nAda\nAda\n\"Ada\"\n", levels, 0, "", true)
fixtures.executes(frontend, "record Counter { value: Integer }\nfunction Counter.value(): Integer { return self.value + 1 }\nfunction Counter.watch(): () -> Integer { return function() { return self.value } }\nlet counter = Counter { value: 41 }\nprint(counter.value)\nprint(counter.value())\nlet watch = counter.watch()\ncounter.value = 42\nprint(watch())\nrecord Handler { apply: (Integer) -> Integer }\nfunction Handler.apply(n: Integer): Integer { let original = self.apply; return original(n) + 1 }\nlet handler = Handler { apply: function(n) { return n } }\nlet original = handler.apply\nprint(original(40))\nprint(handler.apply(40))\n", "41\n42\n42\n40\n41\n", levels, 0, "", true)
fixtures.rejects(frontend, "use \"errors\" as errors\nprint(errors.integer(42).value)\n", "is private to its module", true)
fixtures.rejects(frontend, "use \"errors\" as errors\nprint(errors.integer(42).value(1))\n", "method 'value' received too many arguments", true)
fixtures.executes(frontend, "use \"errors\" as errors\nprint(errors.integerFailure(errors.make(7, 0, \"rain\")).value())\n", "", levels, 1, "Minyar stopped: cannot read the value of a failed IntegerResult\n", false)
fixtures.executes(frontend, "record Counter { value: Integer }\nfunction Counter.watch(): () -> Integer { return function() { return self.value } }\nlet watch = Counter { value: 42 }.watch()\nprint(watch())\n", "42\n", levels, 0, "", true)
io.writeTextFile(frontend.compiler.directory + "/box.min", "public record Box { value: Integer }\nfunction Box.base(): Integer { return self.value }\npublic function Box.value(): Integer { return self.base() + 1 }\npublic function Box.read(): Integer { return self.base() + 1 }\n")
let cachedEntry = frontend.compiler.directory + "/cached.min"
io.writeTextFile(cachedEntry, "use \"./box.min\" as boxes\nlet box = boxes.Box { value: 41 }\nprint(box.value())\nprint(box.read())\n")
let prior = frontend.compiler.directory + "/empty.state"
io.writeTextFile(prior, "")
for pass in ["cold", "warm"] {
    let base = frontend.compiler.directory + "/" + pass
    test.require(test.run([frontend.compiler.executable, cachedEntry, base + ".ll", "--module-state", prior, base + ".state", base + ".stats", "--library", "library"], frontend.environment, "", base + ".compile", 30), "compile public and private methods in cached modules")
    if pass == "warm" {
        let stats = io.readTextFile(base + ".stats").trim().split(" ")
        test.check(stats[0] == "2" && stats[1] == "0" && stats[6] == "true", "method modules did not reuse their cached bodies")
    }
    if test.addressEnabled(frontend.compiler.flags) { io.writeTextFile(base + ".ll", test.instrument(io.readTextFile(base + ".ll"))) }
    for level in levels {
        let command = [frontend.compiler.clang, level, "-Wno-override-module", base + ".ll", frontend.compiler.runtime, "-lm", "-o", base + ".exe"]
        for flag in frontend.compiler.flags { command.add(flag) }
        test.require(test.run(command, frontend.environment, "", base + ".link", 30), "link methods in cached modules")
        let result = test.run([base + ".exe"], frontend.environment, "", base + ".run", 30)
        test.require(result, "execute methods in cached modules")
        test.check(result.output == "42\n42\n" && result.errorOutput == "", "cached method output changed")
    }
    prior = base + ".state"
}
io.writeTextFile(cachedEntry, "use \"./box.min\" as boxes\nprint(boxes.Box { value: 41 }.base())\n")
let rejected = test.run([frontend.compiler.executable, cachedEntry, frontend.compiler.directory + "/private.ll", "--module-state", frontend.compiler.directory + "/cold.state", frontend.compiler.directory + "/private.state", frontend.compiler.directory + "/private.stats", "--library", "library"], frontend.environment, "", frontend.compiler.directory + "/private.compile", 30)
test.check(rejected.status == 1 && test.contains(rejected.errorOutput, "method 'base' is private to its module") && !io.fileExists(frontend.compiler.directory + "/private.ll"), "cached module exposed a private method")
fixtures.executes(frontend, "record Counter { value: Integer }\nfunction Counter.increment() { self.value += 1 }\nfunction Counter.read(): Integer { return self.value }\nlet counter = Counter { value: 41 }\ncounter.increment()\nprint(counter.read())\nprint(counter.value)\n", "42\n42\n", levels, 0, "", true)
test.removeTree(frontend.compiler.directory)
print("Standard library methods: passed")
