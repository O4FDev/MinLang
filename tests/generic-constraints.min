use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
let largest = "function largest<Item: Ordered>(values: List<Item>, fallback: Item): Item { if values.length == 0 { return fallback }; let ordered = values.sorted(); return ordered[ordered.length - 1] }\n"
let contains = "function contains<Item: Equatable>(values: List<Item>, wanted: Item): Boolean { for value in values { if value == wanted { return true } }; return false }\n"
let counts = "function counts<Item: Hashable>(values: List<Item>): Map<Item, Integer> { let result: Map<Item, Integer> = Map(); for value in values { if result.has(value) { result[value] += 1 } else { result[value] = 1 } }; return result }\n"

fixtures.executes(frontend, largest + "print(largest([2, 42, 7], 0))\nprint(largest([\"sea\", \"sky\", \"shore\"], \"\"))\nprint(largest(['b', 'é', 'a'], 'x'))\nprint(largest([false, true], false))\nprint(largest([1.25, 2.5], 0.0))\nprint(largest<Text>([], \"home\"))\n", "42\nsky\né\ntrue\n2.5\nhome\n", levels, 0, "", true)
fixtures.executes(frontend, contains + "print(contains([1, 2], 2))\nprint(contains([\"sea\", \"sky\"], \"shore\"))\nprint(contains([true], true))\nprint(contains(['é'], 'é'))\nprint(contains([1.25], 1.25))\n", "true\nfalse\ntrue\ntrue\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, counts + "let words = counts([\"sea\", \"sky\", \"sea\"])\nprint(words[\"sea\"])\nprint(words[\"sky\"])\nlet numbers = counts<Integer>([1, 2, 1])\nprint(numbers[1])\n", "2\n1\n2\n", levels, 0, "", true)
fixtures.executes(frontend, "record Badge<Item: Equatable> { value: Item }\nlet badge = Badge { value: 42 }\nprint(badge.value)\nlet named = Badge<Text> { value: \"harbour\" }\nprint(named.value)\n", "42\nharbour\n", levels, 0, "", true)
fixtures.executes(frontend, io.readTextFile("examples/gallery/generic-constraints.min"), "highest tide: 2.7 m\nsea: 3\nsky: 2\n", levels, 0, "", true)

fixtures.rejects(frontend, largest + "let value = largest([Bytes(\"sea\")], Bytes())\n", "does not satisfy Ordered for type argument 'Item'", true)
fixtures.rejects(frontend, contains + "print(contains([[1]], [1]))\n", "does not satisfy Equatable for type argument 'Item'", true)
fixtures.rejects(frontend, counts + "let result = counts([Bytes(\"sea\")])\n", "does not satisfy Hashable for type argument 'Item'", true)
fixtures.rejects(frontend, "record Badge<Item: Equatable> { value: Item }\nlet badge = Badge { value: Bytes() }\n", "does not satisfy Equatable for type argument 'Item'", true)
fixtures.rejects(frontend, "function missing<Item: Magical>(value: Item): Item { return value }\n", "unknown capability 'Magical'", true)
fixtures.rejects(frontend, contains + "print(contains([1], true))\n", "type argument 'Item' is used inconsistently", true)
fixtures.executes(frontend, "record Tide { height: Float; name: Text }\nfunction largest<Item: Ordered>(values: List<Item>): Item { return values.sorted()[values.length - 1] }\nlet tide = largest([Tide { height: 1.2; name: \"dawn\" }, Tide { height: 2.7; name: \"noon\" }])\nprint(tide.name)\n", "noon\n", levels, 0, "", true)
fixtures.executes(frontend, "record Shell<Item> { name: Text; value: Item }\nfunction equal<Item: Equatable>(left: Item, right: Item): Boolean { return left == right }\nfunction stable<Item: Hashable>(value: Item): Item { return value }\nlet first = Shell { name: \"pearl\"; value: 42 }\nprint(equal(first, Shell { name: \"pearl\"; value: 42 }))\nprint(equal(first, Shell { name: \"pearl\"; value: 7 }))\nprint(stable(first).value)\n", "true\nfalse\n42\n", levels, 0, "", true)
fixtures.rejects(frontend, "record Recursive { children: List<Recursive> }\nfunction keep<Item: Ordered>(value: Item): Item { return value }\nlet item = keep(Recursive { children: [] })\n", "does not satisfy", true)
fixtures.rejects(frontend, "record Reader { read: () -> Integer }\nfunction keep<Item: Equatable>(value: Item): Item { return value }\nlet item = keep(Reader { read: function() { return 42 } })\n", "does not satisfy", true)
fixtures.rejects(frontend, "record Header native \"c\" { value: UInt8 }\nfunction keep<Item: Hashable>(value: Item): Item { return value }\nlet item = keep(Header { value: 42 })\n", "does not satisfy", true)
fixtures.rejects(frontend, "function keep<Item: \"Ordered\">(value: Item): Item { return value }\n", "expected a capability name after", true)
fixtures.executes(frontend, counts + "record Key { label: Text; rank: Integer }\nlet key = Key { label: \"pearl\"; rank: 1 }\nlet table = counts([key, key, Key { label: \"shell\"; rank: 2 }])\nkey.label = \"changed\"\nprint(table[Key { label: \"pearl\"; rank: 1 }])\nprint(table.length)\n", "2\n2\n", levels, 0, "", true)
fixtures.executes(frontend, "function distinct<Item: Hashable>(values: List<Item>): Set<Item> { let result: Set<Item> = Set(); for value in values { result.add(value) }; return result }\nrecord Key { label: Text; rank: Integer }\nlet keys = distinct([Key { label: \"pearl\"; rank: 1 }, Key { label: \"pearl\"; rank: 1 }])\nprint(keys.length)\nprint(keys.contains(Key { label: \"pearl\"; rank: 1 }))\nprint(distinct([1.25, 1.25]).length)\nprint(distinct(['a', 'é']).length)\nprint(distinct([true, true, false]).length)\n", "1\ntrue\n1\n2\n2\n", levels, 0, "", true)
fixtures.executes(frontend, "function same<Item: Equatable>(left: Item, right: Item): Boolean { return left == right }\nrecord Ledger { entries: Map<Text, Integer> }\nrecord Colours { values: Set<Text> }\nlet entries: Map<Text, Integer> = { \"tide\": 42 }\nlet other: Map<Text, Integer> = { \"tide\": 42 }\nprint(same(Ledger { entries: entries }, Ledger { entries: other }))\nprint(same(entries, other))\nlet first: Set<Text> = Set(); first.add(\"blue\")\nlet second: Set<Text> = Set(); second.add(\"blue\")\nprint(same(Colours { values: first }, Colours { values: second }))\nprint(same(first, second))\n", "true\ntrue\ntrue\ntrue\n", levels, 0, "", true)
fixtures.rejects(frontend, "record Ledger { entries: Map<Text, Integer> }\nfunction keep<Item: Ordered>(value: Item): Item { return value }\nlet entries: Map<Text, Integer> = Map()\nlet value = keep(Ledger { entries: entries })\n", "does not satisfy Ordered", true)
fixtures.rejects(frontend, "record Ledger { entries: Map<Text, Integer> }\nfunction keep<Item: Hashable>(value: Item): Item { return value }\nlet entries: Map<Text, Integer> = Map()\nlet value = keep(Ledger { entries: entries })\n", "does not satisfy Hashable", true)
test.removeTree(frontend.compiler.directory)
print("Generic constraints: passed")
