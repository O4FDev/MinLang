use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, io.readTextFile("examples/gallery/ordered-garden.min"), "A place for every flower:\nAster, season 1\nAster, season 2\nRose, season 1\nDifferent packets, the same promise.\n", levels, 0, "", true)
fixtures.executes(frontend, "record Empty {}\nrecord Leaf { text: Text; integer: Integer; float: Float; truth: Boolean; letter: Character; empty: Empty }\nrecord Tree { leaf: Leaf }\nfunction make(n: Integer): Tree { return Tree { leaf: Leaf { text: \"hé\" + Text(n); integer: n; float: -0.0; truth: true; letter: '🙂'; empty: Empty {} } } }\nlet a = make(2)\nlet b = make(2)\nprint(a == b)\nprint(a != b)\nlet alias = a\nalias.leaf.integer = 3\nprint(a == b)\nprint(a != b)\nprint(Empty {} == Empty {})\n", "true\nfalse\nfalse\ntrue\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "record Value { number: Float }\nlet nan = Value { number: 0.0 / 0.0 }\nprint(nan == nan)\nprint(nan != nan)\nprint(Value { number: 0.0 } == Value { number: -0.0 })\n", "false\ntrue\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "record Box { text: Text }\nrecord Holder { box: Box }\nfunction replace(holder: Holder): Box { holder.box = Box { text: \"new\" }; return Box { text: \"old\" } }\nlet holder = Holder { box: Box { text: \"old\" } }\nprint(holder.box == replace(holder))\nprint(holder.box.text)\n", "true\nnew\n", levels, 0, "", true)
fixtures.executes(frontend, "record Rank { first: Integer; second: Text }\nrecord Entry { rank: Rank }\nlet a = Entry { rank: Rank { first: -9223372036854775808; second: \"z\" } }\nlet b = Entry { rank: Rank { first: 9223372036854775807; second: \"a\" } }\nlet entries = [b, a]\nlet alias = entries\nlet copy = entries.sorted()\nprint(copy[0] == a)\nprint(entries[0] == b)\nentries.sort()\nprint(alias[0] == a)\nprint(a < b)\nprint(a <= a)\nprint(b > a)\nprint(b >= b)\n", "true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "record Rank { value: Integer }\nlet first = Rank { value: 1 }\nlet second = Rank { value: 1 }\nlet entries = [second, first]\nentries.sort()\nentries[0].value = 2\nprint(second.value)\nprint(first.value)\nrecord Score { value: Float }\nlet scores = [Score { value: 0.0 / 0.0 }, Score { value: 2.0 }, Score { value: -1.0 }]\nscores.sort()\nprint(scores[0].value)\nprint(scores[1].value)\nprint(scores[2].value != scores[2].value)\n", "2\n1\n-1.0\n2.0\ntrue\n", levels, 0, "", true)
for field in ["List<Integer>", "Bytes", "() -> Integer"] {
    fixtures.rejects(frontend, "record Box { value: " + field + " }\nfunction equal(a: Box, b: Box): Boolean { return a == b }\n", "is not Equatable", true)
    fixtures.rejects(frontend, "record Box { value: " + field + " }\nfunction order(values: List<Box>) { values.sort() }\n", "is not Ordered", true)
}
fixtures.rejects(frontend, "record Node { children: List<Node> }\nlet node = Node { children: [] }\nnode.children.add(node)\nprint(node == node)\n", "is not Equatable", true)
fixtures.rejects(frontend, "record Node { next: Node }\nfunction equal(a: Node, b: Node): Boolean { return a == b }\n", "is not Equatable", true)
fixtures.rejects(frontend, "record Point native \"c\" { x: Integer }\nfunction equal(a: Point, b: Point): Boolean { return a == b }\n", "is not Equatable", true)
fixtures.rejects(frontend, "record Point native \"c\" { x: Integer }\nrecord Box { point: Point }\nfunction equal(a: Box, b: Box): Boolean { return a == b }\n", "is not Equatable", true)
io.writeTextFile(frontend.compiler.directory + "/secret.min", "public record Secret { private value: Text }\npublic function make(value: Text): Secret { return Secret { value: value } }\n")
fixtures.executes(frontend, "use \"./secret.min\" as secret\nprint(secret.make(\"Ada\") == secret.make(\"A\" + \"da\"))\nprint(secret.make(\"Ada\") < secret.make(\"Grace\"))\n", "true\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "record Wrapped { result: Result<Text, Text> }\nfunction good(): Wrapped { return Wrapped { result: Ok(\"Ada\") } }\nfunction bad(): Wrapped { return Wrapped { result: Err(\"rain\") } }\nprint(good() == good())\nprint(bad() == bad())\nprint(good() == bad())\nlet values = [bad(), good()]\nvalues.sort()\nmatch values[0].result { Ok(value) { print(value) } Err(error) { print(error) } }\n", "true\ntrue\nfalse\nAda\n", levels, 0, "", true)
fixtures.rejects(frontend, "record First { value: Integer }\nrecord Second { value: Integer }\nprint(First { value: 1 } == Second { value: 1 })\n", "different types", true)
io.writeTextFile(frontend.compiler.directory + "/equality.min", "public record Box { value: Integer }\npublic function same(a: Box, b: Box): Boolean { return a == b }\npublic function ordered(values: List<Box>): List<Box> { return values.sorted() }\n")
let cachedEntry = frontend.compiler.directory + "/cached.min"
io.writeTextFile(cachedEntry, "use \"./equality.min\" as boxes\nlet a = boxes.Box { value: 2 }\nlet b = boxes.Box { value: 1 }\nprint(boxes.same(a, b))\nprint(a == b)\nprint(boxes.ordered([a, b])[0].value)\nlet values = [a, b]\nvalues.sort()\nprint(values[0].value)\n")
let prior = frontend.compiler.directory + "/empty.state"
io.writeTextFile(prior, "")
for pass in ["cold", "warm"] {
    let base = frontend.compiler.directory + "/" + pass
    test.require(test.run([frontend.compiler.executable, cachedEntry, base + ".ll", "--module-state", prior, base + ".state", base + ".stats", "--library", "library"], frontend.environment, "", base + ".compile", 30), "compile derived helpers in cached modules")
    if pass == "warm" {
        let stats = io.readTextFile(base + ".stats").trim().split(" ")
        test.check(stats[0] == "2" && stats[1] == "0" && stats[6] == "true", "derived modules did not reuse their cached bodies")
    }
    if test.addressEnabled(frontend.compiler.flags) { io.writeTextFile(base + ".ll", test.instrument(io.readTextFile(base + ".ll"))) }
    for level in levels {
        let command = [frontend.compiler.clang, level, "-Wno-override-module", base + ".ll", frontend.compiler.runtime, "-lm", "-o", base + ".exe"]
        for flag in frontend.compiler.flags { command.add(flag) }
        test.require(test.run(command, frontend.environment, "", base + ".link", 30), "link derived helpers in cached modules")
        let result = test.run([base + ".exe"], frontend.environment, "", base + ".run", 30)
        test.require(result, "execute derived helpers in cached modules")
        test.check(result.output == "false\nfalse\n1\n1\n" && result.errorOutput == "", "cached derived helper output changed")
    }
    prior = base + ".state"
}
fixtures.executes(frontend, "record Group { numbers: Map<Text, Integer>; names: Set<Text> }\nlet leftNames = Set<Text>(); leftNames.add(\"Ada\"); leftNames.add(\"Grace\")\nlet rightNames = Set<Text>(); rightNames.add(\"Grace\"); rightNames.add(\"Ada\")\nlet left = Group { numbers: {\"Ada\": 42}; names: leftNames }\nlet right = Group { numbers: {\"Ada\": 42}; names: rightNames }\nprint(left == right)\nprint(left != right)\nleft.numbers[\"Ada\"] = 43\nprint(left == right)\nrecord Wrapped { result: Result<Map<Integer, Integer>, Text> }\nfunction good(): Wrapped { return Wrapped { result: Ok({1: 42}) } }\nfunction bad(): Wrapped { return Wrapped { result: Err(\"rain\") } }\nprint(good() == good()); print(bad() == bad()); print(good() == bad())\n", "true\nfalse\nfalse\ntrue\ntrue\nfalse\n", levels, 0, "", true)
fixtures.executes(frontend, "record Stored { values: Map<Integer, Set<Text>> }\nlet first = Set<Text>(); first.add(\"Ada\")\nlet second = Set<Text>(); second.add(\"Ada\")\nlet left = Stored { values: {1: first} }\nlet right = Stored { values: {1: second} }\nprint(left == right)\nfirst.remove(\"Ada\")\nprint(left == right)\nrecord Floating { values: Map<Integer, Float> }\nlet floating = Floating { values: {1: 0.0 / 0.0} }\nprint(floating == floating)\n", "true\nfalse\nfalse\n", levels, 0, "", true)
fixtures.rejects(frontend, "record Group { values: Map<Integer, Integer> }\nfunction order(values: List<Group>) { values.sort() }\n", "is not Ordered", true)
fixtures.rejects(frontend, "record Group { values: Map<Integer, Integer> }\nlet values: Map<Group, Integer> = Map()\n", "is not Hashable", true)
fixtures.executes(frontend, "for a in [false, true] { for b in [false, true] {\nif (a < b) != (!a && b) { fail(\"bad Boolean less\") }\nif (a <= b) != (!a || b) { fail(\"bad Boolean less or equal\") }\nif (a > b) != (a && !b) { fail(\"bad Boolean greater\") }\nif (a >= b) != (a || !b) { fail(\"bad Boolean greater or equal\") }\n} }\nprint(\"Booleans ordered\")\nlet words = [\"\", \"a\", \"a\" + Text(Character(0)), \"aa\", \"ab\", \"b\", \"z\", \"é\", \"🙂\"]\nfor i in 0..words.length { for j in 0..words.length {\nif (words[i] < words[j]) != (i < j) { fail(\"bad Text less\") }\nif (words[i] <= words[j]) != (i <= j) { fail(\"bad Text less or equal\") }\nif (words[i] > words[j]) != (i > j) { fail(\"bad Text greater\") }\nif (words[i] >= words[j]) != (i >= j) { fail(\"bad Text greater or equal\") }\n} }\nprint(\"Texts ordered\")\nrecord Box { word: Text }\nfunction replace(box: Box): Text { box.word = \"new\"; return \"old\" + \"!\" }\nlet box = Box { word: \"old\" + \"!\" }\nprint(box.word <= replace(box))\nprint(box.word)\n", "Booleans ordered\nTexts ordered\ntrue\nnew\n", levels, 0, "", true)
test.removeTree(frontend.compiler.directory)
print("Record capabilities: passed")
