use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, io.readTextFile("examples/gallery/ordered-garden.min"), "A place for every flower:\nAster, season 1\nAster, season 2\nRose, season 1\nDifferent packets, the same promise.\n", levels, 0, "", true)
fixtures.executes(frontend, "record Empty {}\nrecord Leaf { text: Text; integer: Integer; float: Float; truth: Boolean; letter: Character; empty: Empty }\nrecord Tree { leaf: Leaf }\nfunction make(n: Integer): Tree { return Tree { leaf: Leaf { text: \"hé\" + Text(n); integer: n; float: -0.0; truth: true; letter: '🙂'; empty: Empty {} } } }\nlet a = make(2)\nlet b = make(2)\nprint(a == b)\nprint(a != b)\nlet alias = a\nalias.leaf.integer = 3\nprint(a == b)\nprint(a != b)\nprint(Empty {} == Empty {})\n", "true\nfalse\nfalse\ntrue\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "record Value { number: Float }\nlet nan = Value { number: 0.0 / 0.0 }\nprint(nan == nan)\nprint(nan != nan)\nprint(Value { number: 0.0 } == Value { number: -0.0 })\n", "false\ntrue\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "record Box { text: Text }\nrecord Holder { box: Box }\nfunction replace(holder: Holder): Box { holder.box = Box { text: \"new\" }; return Box { text: \"old\" } }\nlet holder = Holder { box: Box { text: \"old\" } }\nprint(holder.box == replace(holder))\nprint(holder.box.text)\n", "true\nnew\n", levels, 0, "", true)
fixtures.executes(frontend, "record Rank { first: Integer; second: Text }\nrecord Entry { rank: Rank }\nlet a = Entry { rank: Rank { first: -9223372036854775808; second: \"z\" } }\nlet b = Entry { rank: Rank { first: 9223372036854775807; second: \"a\" } }\nlet entries = [b, a]\nlet alias = entries\nlet copy = entries.sorted()\nprint(copy[0] == a)\nprint(entries[0] == b)\nentries.sort()\nprint(alias[0] == a)\nprint(a < b)\nprint(a <= a)\nprint(b > a)\nprint(b >= b)\n", "true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "record Rank { value: Integer }\nlet first = Rank { value: 1 }\nlet second = Rank { value: 1 }\nlet entries = [second, first]\nentries.sort()\nentries[0].value = 2\nprint(second.value)\nprint(first.value)\nrecord Score { value: Float }\nlet scores = [Score { value: 0.0 / 0.0 }, Score { value: 2.0 }, Score { value: -1.0 }]\nscores.sort()\nprint(scores[0].value)\nprint(scores[1].value)\nprint(scores[2].value != scores[2].value)\n", "2\n1\n-1.0\n2.0\ntrue\n", levels, 0, "", true)
for field in ["List<Integer>", "Bytes", "() -> Integer"] {
    fixtures.rejects(frontend, "record Box { value: " + field + " }\nfunction equal(a: Box, b: Box): Boolean { return a == b }\n", "is not Equatable", true)
    fixtures.rejects(frontend, "record Box { value: " + field + " }\nfunction order(values: List<Box>) { values.sort() }\n", "is not Ordered", true)
}
fixtures.rejects(frontend, "record Node { children: List<Node> }\nlet node = Node { children: [] }\nnode.children.add(node)\nprint(node == node)\n", "is not Equatable", true)
fixtures.rejects(frontend, "record Node { next: Node }\nfunction equal(a: Node, b: Node): Boolean { return a == b }\n", "is not Equatable", true)
fixtures.rejects(frontend, "record Point native \"c\" { x: Integer }\nfunction equal(a: Point, b: Point): Boolean { return a == b }\n", "is not Equatable", true)
fixtures.rejects(frontend, "record Point native \"c\" { x: Integer }\nrecord Box { point: Point }\nfunction equal(a: Box, b: Box): Boolean { return a == b }\n", "is not Equatable", true)
io.writeTextFile(frontend.compiler.directory + "/secret.min", "public record Secret { private value: Text }\npublic function make(value: Text): Secret { return Secret { value: value } }\n")
fixtures.executes(frontend, "use \"./secret.min\" as secret\nprint(secret.make(\"Ada\") == secret.make(\"A\" + \"da\"))\nprint(secret.make(\"Ada\") < secret.make(\"Grace\"))\n", "true\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "record Wrapped { result: Result<Text, Text> }\nfunction good(): Wrapped { return Wrapped { result: Ok(\"Ada\") } }\nfunction bad(): Wrapped { return Wrapped { result: Err(\"rain\") } }\nprint(good() == good())\nprint(bad() == bad())\nprint(good() == bad())\nlet values = [bad(), good()]\nvalues.sort()\nmatch values[0].result { Ok(value) { print(value) } Err(error) { print(error) } }\n", "true\ntrue\nfalse\nAda\n", levels, 0, "", true)
fixtures.rejects(frontend, "record First { value: Integer }\nrecord Second { value: Integer }\nprint(First { value: 1 } == Second { value: 1 })\n", "different types", true)
test.removeTree(frontend.compiler.directory)
print("Record capabilities: passed")
