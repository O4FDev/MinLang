use "http2" as h2
use "errors" as errors
let server = h2.create()
if !errors.booleanOk(h2.receive(server, readBytesFile(argument(0)))) { fail("independent initial request rejected") }
let request = h2.requests(server)
if !h2.requestOk(request) { fail("initial request missing") }
let id = h2.streamID(request)
h2.respond(server, id, [h2.Header { name: ":status"; value: "200" }], false)
let data = Bytes(); for i in 0..40000 { data.add(i % 256) }
h2.write(server, id, data)
h2.closeStream(server, id, [h2.Header { name: "grpc-status"; value: "0" }])
let prefix = Bytes()
if argument(2) == "partial" { prefix = h2.takeOutgoing(server, 64) }
else if argument(2) == "late" { prefix = h2.takeOutgoing(server, 1048576) }
let received = h2.receive(server, readBytesFile(argument(1)))
if !errors.booleanOk(received) { print("ERROR " + Text(errors.nativeCode(errors.booleanError(received)))) }
else { print("OK") }
let next = h2.requests(server)
if h2.requestOk(next) {
    print("REOPEN " + h2.headerValue(h2.headers(next), "x-late"))
    if argument(2) == "credit" {
        h2.respond(server, h2.streamID(next), [h2.Header { name: ":status"; value: "200" }], false)
        h2.write(server, h2.streamID(next), data)
    }
}
prefix.addBytes(h2.takeOutgoing(server, 1048576)); writeBytesFile(argument(3), prefix)
