use "winnotify" as notices
use "errors" as errors
let invalid = notices.initialize("bad/app")
if errors.integerOk(invalid) || errors.code(errors.integerError(invalid)) != errors.invalidDataCode() { fail("invalid app identity accepted") }
let next = notices.nextAction()
if notices.activationOk(next) || errors.code(notices.activationError(next)) != errors.unavailableCode() { fail("unregistered notification action accepted") }
let actions: List<notices.Action> = []
for n in 0..6 { actions.add(notices.action("open","Open")) }
let result = notices.notify("title","body",actions)
if errors.integerOk(result) || errors.code(errors.integerError(result)) != errors.invalidDataCode() { fail("over-five action list accepted") }
if notices.tokenOk(notices.token(0)) { fail("stale notification token accepted") }
let cancel = notices.cancelToken("../foreign")
if errors.integerOk(cancel) || errors.code(errors.integerError(cancel)) != errors.invalidDataCode() { fail("foreign cancellation token accepted") }
print("Windows persistent notification Minyar contracts verified")
