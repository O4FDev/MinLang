use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
let frontend = fixtures.fixture("MINYAR_ERRORS_COMPILER", "./build/minyarc-errors")
frontend.runtimeFlags = test.words(test.setting("MINYAR_ERRORS_RUNTIME_FLAGS", ""))
let selectedCompiler = frontend.compiler.executable
fixtures.validate("ErrorsLanguage", ["test_generic_variants_and_zero_false_success", "test_malformed_packet_is_recoverable", "test_try_changes_success_type_preserves_exact_error_type", "test_nested_results_and_lists_have_typed_owned_payloads", "test_match_payload_survives_scrutinee_replacement_and_aliasing", "test_nested_early_return_and_error_cleanup", "test_result_returning_callback_and_captured_result", "test_exhaustiveness_duplicate_and_unknown_arms_are_errors", "test_match_requires_result_and_payload_is_scoped", "test_constructors_and_bindings_are_type_checked", "test_result_representation_is_not_public", "test_try_requires_result_function_and_identical_error", "test_match_both_returns_is_exhaustive_function_return", "test_errors_in_a_module_have_generic_type_identity", "test_result_callback_cycles_in_both_payload_slots_are_collected", "test_propagation_short_circuits_following_callbacks", "test_discarded_result_expression_is_rejected", "test_programmer_failures_are_fatal_inside_result_functions", "test_ordinary_programs_preserve_behavior_in_both_frontends", "test_network_adapter_preserves_data_eof_blocked_failure_and_prefix", "test_actual_failed_network_read_remains_owned_and_recoverable", "test_repeated_success_error_nested_return_and_callback_cleanup", "test_match_binding_can_escape_in_a_callback", "test_all_scalar_payload_encodings_are_typed", "test_malformed_generic_headers_and_quoted_arms_are_rejected", "test_result_record_literal_cannot_forge_a_tag"])
if fixtures.selected("ErrorsLanguage", "test_generic_variants_and_zero_false_success") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "let number = Ok<Integer, Text>(0)\nmatch number { Ok(value) { print(value) } Err(error) { print(error) } }\nlet flag = Ok<Boolean, Integer>(false)\nmatch flag { Err(code) { print(code) } Ok(value) { print(value) } }\nlet failed = Err<Bytes, Text>(\"bad\" + \" packet\")\nmatch failed { Ok(data) { print(data.length) } Err(error) { print(error) } }\nprint(\"alive\")\n", "0\nfalse\nbad packet\nalive\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_malformed_packet_is_recoverable") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "function parse(packet: Bytes): Result<Integer, Text> {\n    if packet.length < 2 { return Err<Integer, Text>(\"short\" + \" packet\") }\n    return Ok<Integer, Text>(packet[0] * 256 + packet[1])\n}\nlet valid = Bytes(2); valid[0] = 1; valid[1] = 2\nfor packet in [Bytes(1), valid] {\n    match parse(packet) { Ok(value) { print(value) } Err(error) { print(error) } }\n}\nprint(\"recovered\")\n", "short packet\n258\nrecovered\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_try_changes_success_type_preserves_exact_error_type") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "function read(good: Boolean): Result<Bytes, Text> {\n    if !good { return Err<Bytes, Text>(\"read\" + \" failed\") }\n    return Ok<Bytes, Text>(Bytes(\"abc\"))\n}\nfunction count(good: Boolean): Result<Integer, Text> {\n    let guard = [\"owned\" + \" local\"]\n    let data = try read(good)\n    return Ok<Integer, Text>(data.length + guard.length)\n}\nmatch count(true) { Ok(n) { print(n) } Err(e) { print(e) } }\nmatch count(false) { Ok(n) { print(n) } Err(e) { print(e) } }\nprint(\"after\")\n", "4\nread failed\nafter\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_nested_results_and_lists_have_typed_owned_payloads") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "let nested = Ok<Result<List<Text>, Bytes>, Text>(\n    Err<List<Text>, Bytes>(Bytes(\"binary\")))\nmatch nested {\n    Ok(inner) { match inner {\n        Ok(words) { print(words.length) }\n        Err(data) { print(Text(data)) }\n    } }\n    Err(error) { print(error) }\n}\nlet values: List<Result<Text, Integer>> = []\nvalues.add(Ok<Text, Integer>(\"first\" + \"!\"))\nvalues.add(Err<Text, Integer>(9))\nfor result in values { match result {\n    Ok(text) { print(text) } Err(code) { print(code) }\n} }\n", "binary\nfirst!\n9\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_match_payload_survives_scrutinee_replacement_and_aliasing") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "record Box { results: List<Result<Text, Text>> }\nlet box = Box { results: [Ok<Text, Text>(\"old\" + \"!\")] }\nlet saved = box.results[0]\nmatch box.results[0] {\n    Ok(value) {\n        box.results[0] = Err<Text, Text>(\"new\" + \"!\")\n        print(value)\n    }\n    Err(error) { print(error) }\n}\nmatch saved { Ok(value) { print(value) } Err(error) { print(error) } }\nmatch box.results[0] { Ok(value) { print(value) } Err(error) { print(error) } }\n", "old!\nold!\nnew!\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_nested_early_return_and_error_cleanup") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "function leaf(n: Integer): Result<Text, Text> {\n    let local = Bytes(\"owned\")\n    if n == 2 { return Err<Text, Text>(\"error\" + Text(n)) }\n    return Ok<Text, Text>(\"value\" + Text(n) + Text(local.length))\n}\nfunction outer(n: Integer): Result<Text, Text> {\n    let locals = [Bytes(\"a\"), Bytes(\"b\")]\n    for i in 0..4 {\n        if i == n {\n            let value = try leaf(n)\n            if value.length > 0 { return Ok<Text, Text>(value + Text(locals.length)) }\n        }\n    }\n    return Err<Text, Text>(\"missing\" + \"!\")\n}\nfor n in 0..5 {\n    match outer(n) { Ok(value) { print(value) } Err(error) { print(error) } }\n}\n", "value052\nvalue152\nerror2\nvalue352\nmissing!\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_result_returning_callback_and_captured_result") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "function maker(seed: Result<Text, Text>): Callback<Boolean, Result<Text, Text>> {\n    return function(good: Boolean): Result<Text, Text> {\n        let owned = Bytes(\"callback\")\n        let value = try seed\n        if !good { return Err<Text, Text>(value + Text(owned.length)) }\n        return Ok<Text, Text>(value + \"!\")\n    }\n}\nlet callback = maker(Ok<Text, Text>(\"captured\" + \"!\"))\nmatch callback(true) { Ok(v) { print(v) } Err(e) { print(e) } }\nmatch callback(false) { Ok(v) { print(v) } Err(e) { print(e) } }\nlet failed = maker(Err<Text, Text>(\"failure\" + \"!\"))\nmatch failed(true) { Ok(v) { print(v) } Err(e) { print(e) } }\n", "captured!!\ncaptured!8\nfailure!\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_exhaustiveness_duplicate_and_unknown_arms_are_errors") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.rejects(frontend, "let r = Ok<Integer, Text>(1)\nmatch r { Ok(v) { print(v) } }\n", "match must handle both Ok and Err", true)
    fixtures.rejects(frontend, "let r = Ok<Integer, Text>(1)\nmatch r { Err(e) { print(e) } }\n", "match must handle both Ok and Err", true)
    fixtures.rejects(frontend, "let r = Ok<Integer, Text>(1)\nmatch r { Ok(v) {} Ok(w) {} Err(e) {} }\n", "duplicate result arm", true)
    fixtures.rejects(frontend, "let r = Ok<Integer, Text>(1)\nmatch r { Ok(v) {} Err(e) {} Other(x) {} }\n", "expected Ok or Err", true)
    fixtures.rejects(frontend, "let r = Ok<Integer, Text>(1)\nmatch r { _ {} }\n", "expected Ok or Err", true)
}
if fixtures.selected("ErrorsLanguage", "test_match_requires_result_and_payload_is_scoped") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.rejects(frontend, "match 42 { Ok(v) {} Err(e) {} }\n", "match needs a Result", true)
    fixtures.rejects(frontend, "let r = Ok<Integer, Text>(1)\nmatch r { Ok(v) {} Err(e) {} }\nprint(v)\n", "find a value named 'v'", true)
}
if fixtures.selected("ErrorsLanguage", "test_constructors_and_bindings_are_type_checked") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.rejects(frontend, "let r = Ok<Integer, Text>(\"wrong\")\n", "result payload has the wrong type", true)
    fixtures.rejects(frontend, "let r = Err<Integer, Text>(42)\n", "result payload has the wrong type", true)
    fixtures.rejects(frontend, "let r: Result<Integer, Text> = Ok<Boolean, Text>(false)\n", "does not match its declared type", true)
    fixtures.rejects(frontend, "let r: Result<Nothing, Text> = Err<Nothing, Text>(\"bad\")\n", "Nothing cannot be used as a value type", true)
}
if fixtures.selected("ErrorsLanguage", "test_result_representation_is_not_public") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    for field in ["ok", "value", "error"] { fixtures.rejects(frontend, "let r = Ok<Integer, Text>(1)\nprint(r." + field + ")\n", "Result payloads are only accessible through match or try", true) }
    fixtures.rejects(frontend, "record minyar_result_0 { forged: Integer }\n", "reserved result compiler name", true)
}
if fixtures.selected("ErrorsLanguage", "test_try_requires_result_function_and_identical_error") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.rejects(frontend, "let value = try Ok<Integer, Text>(1)\n", "try requires a Result-returning function", true)
    fixtures.rejects(frontend, "function f(): Result<Integer, Integer> { let v = try Err<Integer, Text>(\"bad\"); return Ok<Integer, Integer>(v) }\n", "try error type must match the enclosing Result error type", true)
    fixtures.rejects(frontend, "function f(): Result<Integer, Text> { let v = try 42; return Ok<Integer, Text>(v) }\n", "try needs a Result", true)
    fixtures.rejects(frontend, "function f(): Result<Integer, Text> { return try Ok<Integer, Text>(1) }\n", "try is only supported as a binding initializer", true)
}
if fixtures.selected("ErrorsLanguage", "test_match_both_returns_is_exhaustive_function_return") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "function choose(r: Result<Text, Text>): Text {\n    match r { Ok(v) { return v } Err(e) { return e } }\n}\nprint(choose(Ok<Text, Text>(\"ok\" + \"!\")))\nprint(choose(Err<Text, Text>(\"error\" + \"!\")))\n", "ok!\nerror!\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_errors_in_a_module_have_generic_type_identity") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    writeTextFile(frontend.compiler.directory + "/packet.min", "public record Failure { message: Text }\npublic function parse(packet: Bytes): Result<Integer, Failure> {\n    if packet.length == 0 { return Err<Integer, Failure>(Failure { message: \"empty\" + \"!\" }) }\n    return Ok<Integer, Failure>(packet[0])\n}\n")
    fixtures.executes(frontend, "use \"./packet.min\" as packet\nfunction wrapper(): Result<Text, packet.Failure> {\n    let n = try packet.parse(Bytes())\n    return Ok<Text, packet.Failure>(Text(n))\n}\nmatch wrapper() { Ok(v) { print(v) } Err(e) { print(e.message) } }\n", "empty!\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_result_callback_cycles_in_both_payload_slots_are_collected") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "record Node {\n    good: List<Result<Callback<Integer, Integer>, Text>>\n    bad: List<Result<Text, Callback<Integer, Integer>>>\n}\nlet node = Node { good: []; bad: [] }\nlet callback = function(n: Integer): Integer { return n + node.good.length + node.bad.length }\nnode.good.add(Ok<Callback<Integer, Integer>, Text>(callback))\nnode.bad.add(Err<Text, Callback<Integer, Integer>>(callback))\nmatch node.good[0] { Ok(f) { print(f(40)) } Err(e) { print(e) } }\nmatch node.bad[0] { Ok(v) { print(v) } Err(f) { print(f(39)) } }\n", "42\n41\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_propagation_short_circuits_following_callbacks") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "record Counter { calls: Integer }\nfunction step(counter: Counter, good: Boolean): Result<Integer, Text> {\n    counter.calls = counter.calls + 1\n    if !good { return Err<Integer, Text>(\"stopped\" + \"!\") }\n    return Ok<Integer, Text>(counter.calls)\n}\nfunction chain(counter: Counter, good: Boolean): Result<Integer, Text> {\n    let first = try step(counter, good)\n    let second = try step(counter, true)\n    return Ok<Integer, Text>(first + second)\n}\nlet counter = Counter { calls: 0 }\nmatch chain(counter, false) { Ok(v) { print(v) } Err(e) { print(e) } }\nprint(counter.calls)\nmatch chain(counter, true) { Ok(v) { print(v) } Err(e) { print(e) } }\nprint(counter.calls)\n", "stopped!\n1\n5\n3\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_discarded_result_expression_is_rejected") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.rejects(frontend, "Ok<Integer, Text>(1)\n", "a Result expression must be handled or bound", true)
}
if fixtures.selected("ErrorsLanguage", "test_programmer_failures_are_fatal_inside_result_functions") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "function bug(): Result<Integer, Text> {\n    let data = Bytes(1)\n    return Ok<Integer, Text>(data[1])\n}\nmatch bug() { Ok(v) { print(v) } Err(e) { print(\"recovered\") } }\n", "", ["-O0", "-O2"], 1, "Minyar stopped: Bytes position 1 is outside its length of 1.\n", false)
}
if fixtures.selected("ErrorsLanguage", "test_ordinary_programs_preserve_behavior_in_both_frontends") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    let core = test.setting("MINYAR_TEST_COMPILER", "./build/minyarc")
    let squares: List<Text> = []
    for number in 0..10 { squares.add(Text(number * number) + "\n") }
    for compiler in [selectedCompiler, core] {
        frontend.compiler.executable = compiler
        fixtures.executes(frontend, "print(\"try\"); print(\"minyar_result_type_0\"); print(42)\n", "try\nminyar_result_type_0\n42\n", ["-O0", "-O2"], 0, "", true)
        fixtures.executes(frontend, "record Box { words: List<Text> }\nlet b = Box { words: [\"a\" + \"b\"] }\nprint(b.words[0])\n", "ab\n", ["-O0", "-O2"], 0, "", true)
        fixtures.executes(frontend, "function square(n: Integer): Integer { return n * n }\nfor n in 0..10 { print(square(n)) }\n", joinText(squares), ["-O0", "-O2"], 0, "", true)
    }
}
if fixtures.selected("ErrorsLanguage", "test_network_adapter_preserves_data_eof_blocked_failure_and_prefix") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    frontend.sources = ["runtime/native/net.c"]
    fixtures.executes(frontend, "use \"results\" as results\nuse \"errors\" as errors\nlet reads = [errors.bytes(Bytes()), errors.endOfStream(), errors.wouldBlock(11),\n             errors.bytesFailure(errors.make(7, 9, \"bad\" + \"!\")),\n             errors.truncated(Bytes(\"prefix\"), 90)]\nfor read in reads { match results.bytes(read) {\n    Ok(value) { print(results.ended(value)); print(results.data(value).length) }\n    Err(failure) {\n        print(errors.code(results.error(failure)))\n        print(errors.nativeCode(results.error(failure)))\n        print(Text(results.prefix(failure)))\n    }\n} }\nmatch results.integer(errors.integer(0)) { Ok(v) { print(v) } Err(e) { print(errors.code(e)) } }\nmatch results.boolean(errors.boolean(false)) { Ok(v) { print(v) } Err(e) { print(errors.code(e)) } }\n", "false\n0\ntrue\n0\n1\n11\n\n7\n9\n\n12\n90\nprefix\n0\nfalse\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_actual_failed_network_read_remains_owned_and_recoverable") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    frontend.sources = ["runtime/native/net.c"]
    fixtures.executes(frontend, "use \"results\" as results\nuse \"errors\" as errors\nlet first = results.read(-1, 16)\nlet second = results.read(-1, 16)\nmatch first {\n    Ok(value) { print(\"unexpected\") }\n    Err(failure) { print(errors.code(results.error(failure))); print(errors.message(results.error(failure))) }\n}\nmatch second {\n    Ok(value) { print(\"unexpected\") }\n    Err(failure) { print(errors.code(results.error(failure))) }\n}\nprint(\"still alive\")\n", "7\nsocket read failed\n7\nstill alive\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_repeated_success_error_nested_return_and_callback_cleanup") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "function parse(n: Integer): Result<Text, Text> {\n    let data = Bytes(\"temporary\")\n    if n % 2 == 0 { return Err<Text, Text>(\"bad\" + Text(n)) }\n    return Ok<Text, Text>(\"good\" + Text(n) + Text(data.length))\n}\nfunction run(n: Integer): Result<Integer, Text> {\n    let locals = [Bytes(\"one\"), Bytes(\"two\")]\n    let value = try parse(n)\n    return Ok<Integer, Text>(value.length + locals.length)\n}\nlet successes = 0\nlet failures = 0\nlet callback: Callback<Integer, Result<Integer, Text>> = function(n: Integer): Result<Integer, Text> {\n    let owned = [\"callback\" + Text(n)]\n    let value = try run(n)\n    return Ok<Integer, Text>(value + owned.length)\n}\nfor n in 0..1500 {\n    match callback(n) {\n        Ok(value) { successes = successes + 1 }\n        Err(error) { failures = failures + 1 }\n    }\n}\nprint(successes); print(failures)\n", "750\n750\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_match_binding_can_escape_in_a_callback") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "function pick(result: Result<Text, Text>): Callback<Text> {\n    match result {\n        Ok(payload) { return function(): Text { return payload + \"!\" } }\n        Err(error) { return function(): Text { return error + \"!\" } }\n    }\n}\nlet good = pick(Ok<Text, Text>(\"good\" + \" value\"))\nlet bad = pick(Err<Text, Text>(\"bad\" + \" value\"))\nprint(good()); print(bad())\n", "good value!\nbad value!\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_all_scalar_payload_encodings_are_typed") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.executes(frontend, "match Ok<Float, Character>(1.5) { Ok(v) { print(v) } Err(e) { print(e) } }\nmatch Err<Float, Character>('界') { Ok(v) { print(v) } Err(e) { print(e) } }\nmatch Ok<Character, Float>('🙂') { Ok(v) { print(v) } Err(e) { print(e) } }\nmatch Err<Character, Float>(2.5) { Ok(v) { print(v) } Err(e) { print(e) } }\n", "1.5\n界\n🙂\n2.5\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("ErrorsLanguage", "test_malformed_generic_headers_and_quoted_arms_are_rejected") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.rejects(frontend, "let x: Result<Integer> = 0\n", "expected ','", true)
    fixtures.rejects(frontend, "let x: Result<Integer, Text, Bytes> = 0\n", "expected '>'", true)
    fixtures.rejects(frontend, "let x = Ok<Integer, Text>(1)\nmatch x { \"Ok\"(v) {} Err(e) {} }\n", "expected Ok or Err", true)
}
if fixtures.selected("ErrorsLanguage", "test_result_record_literal_cannot_forge_a_tag") {
    frontend.helpers = ""; frontend.sources = []; frontend.compiler.executable = selectedCompiler
    fixtures.rejects(frontend, "let r = Result<Integer, Text> { ok: true; value: 1; error: \"inactive\" }\n", "Result values require Ok or Err constructors", true)
    fixtures.rejects(frontend, "let r = Ok<Integer, Text>(1)\nr.ok = false\n", "Result payloads are only accessible through match or try", true)
}
test.removeTree(frontend.compiler.directory)
print("Generic Result language, propagation and ownership: passed")
