use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
fixtures.executes(frontend, "function identity<Item>(value: Item): Item { return value }\nfunction ending<Item>(value: Item): Text { return \"}\" }\n\"record\"\n\"if\"\nlet words = [\")\", \"]\", \"}\", \"true\", \"false\", \"try\", \"function\", \"Map\", \"if\", \"match\", \"{\"]\nfor word in words { print(identity(word)) }\nlet punctuation: Map<Text, Text> = { \"}\": \")\" }\nprint(identity(punctuation)[\"}\"])\nprint(identity('('))\nprint(identity('}'))\nif identity(\"{\") == \"{\" { print(\"kept\") }\nprint(ending(42))\n", ")\n]\n}\ntrue\nfalse\ntry\nfunction\nMap\nif\nmatch\n{\n)\n(\n}\nkept\n}\n", ["-O0", "-O2"], 0, "", true)
fixtures.executes(frontend, "function identity<Item>(value: Item): Item { return value }\nfunction quiet<Item>(): Item { return true }\nfunction read(): Integer {\n    let global = 0\n    for index in 0..3 { if index == 2 { global = index; break } }\n    return global\n}\nlet ready: Boolean = quiet()\nprint(ready)\nprint(identity(\"true\"))\nprint(identity(\"false\"))\nprint(identity(\"try\"))\nprint(identity('['))\nprint(read())\nif identity(2) + 1 == 3 && quiet() { print(\"balanced\") }\nif quiet() && identity(\"sea\") == \"sea\" { print(\"composed\") }\n", "true\ntrue\nfalse\ntry\n[\n2\nbalanced\ncomposed\n", ["-O0", "-O2"], 0, "", true)
test.removeTree(frontend.compiler.directory)
print("Generic literal tokens: passed")
