use "process" as processInfo
// Exercised by tests/http-package-test.min against a local server given as argument 0.
use "http" as http

function main(): Integer {
    let base = processInfo.argument(0)
    let plain = http.get(base + "/plain", ["Accept: text/plain"])
    print(Text(plain.status) + " " + plain.reason + " " + Text(plain.body) + " [" + plain.error + "]")
    let found = false
    for header in plain.headers {
        if header == "X-Minyar: yes" { found = true }
    }
    print(found)
    let echo = http.post(base + "/echo", ["Content-Type: application/json", "X-Test: é"], "{\"a\": \"ü\"}")
    print(Text(echo.status) + " " + Text(echo.body))
    let missing = http.request("DELETE", base + "/missing", [], "")
    print(Text(missing.status) + " " + missing.reason)
    let lines = Text(Character(13)) + Text(Character(10))
    let badMethod = http.request("GET" + lines + "X-Injected: yes", base + "/plain", [], "")
    let badHeader = http.request("GET", base + "/plain", ["X-Test: safe" + lines + "X-Injected: yes"], "")
    let framing = http.request("GET", base + "/plain", ["Host: attacker.invalid"], "")
    print(Text(badMethod.status) + " " + Text(badMethod.error != "") + " " + Text(badHeader.status) + " " + Text(badHeader.error != "") + " " + Text(framing.status) + " " + Text(framing.error != ""))
    let extension = http.request("M-SEARCH", base + "/plain", ["X-Test: a:b é"], "")
    print(Text(extension.status) + " " + Text(extension.body))
    let boundedPost = http.requestBoundedWithin("POST", base + "/echo", ["Content-Type: application/json", "X-Test: é"], "{\"a\": \"ü\"}", 1024, 1000)
    print(Text(boundedPost.status) + " " + Text(boundedPost.body))
    let tooLarge = http.getBoundedWithin(base + "/plain", [], 4, 1000)
    print(Text(tooLarge.status) + " " + Text(tooLarge.error != ""))
    let invalidStream = http.start("GET", base + "/plain", ["X-Test: safe" + lines + "X-Injected: yes"], "")
    print(Text(http.finished(invalidStream)) + " " + Text(http.status(invalidStream)) + " " + Text(http.error(invalidStream) != ""))
    http.close(invalidStream)
    let invalidIdentityStream = http.startWithIdentity("GET", base + "/plain", ["X-Test: safe" + lines + "X-Injected: yes"], "", Bytes(), [])
    print(Text(http.finished(invalidIdentityStream)) + " " + Text(http.status(invalidIdentityStream)) + " " + Text(http.error(invalidIdentityStream) != ""))
    http.close(invalidIdentityStream)
    // Streamed in pieces, with "é" split between two packets.
    let stream = http.start("GET", base + "/stream", [], "")
    let pieces: List<Text> = []
    while !http.finished(stream) {
        http.wait(stream, 0.05)
        let piece = http.read(stream)
        if piece.length > 0 { pieces.add(piece) }
    }
    pieces.add(http.read(stream))
    print(Text(http.status(stream)) + " " + http.header(stream, "content-type") + " " + joinText(pieces) + " " + Text(pieces.length > 2))
    http.close(stream)
    let slow = http.start("GET", base + "/slow", [], "")
    http.cancel(slow)
    print(Text(http.finished(slow)) + " " + http.error(slow))
    http.close(slow)
    let refused = http.get(processInfo.argument(1), [])
    print(Text(refused.status) + " " + Text(refused.error != ""))
    // Like the portable backend, a URL without http:// or https:// fails
    // with a response rather than stopping the program.
    let unsupported = http.get("localhost:8080/health", [])
    print(Text(unsupported.status) + " " + unsupported.error)
    // Nothing is kept in a local cache: a response the server allows caching
    // is fetched again, as with the portable backend.
    let first = http.get(base + "/counted", [])
    let second = http.get(base + "/counted", [])
    print(Text(first.body) + " " + Text(second.body))
    return 0
}
