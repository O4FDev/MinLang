use "erofs" as erofs
use "errors" as errors

function number(value: Text): Integer {
    let result = 0
    for digit in value { result = result * 10 + Integer(digit) - 48 }
    return result
}
let options = erofs.defaults()
if argumentCount() > 2 { options.maximumBytes = number(argument(2)) }
if argumentCount() > 3 && argument(3) == "lz4" { options.compression = erofs.LZ4 }
if argumentCount() > 3 && argument(3) == "zstd" { options.compression = erofs.ZSTD }
let error = erofs.writeDirectory(argument(0), argument(1), options)
if errors.isError(error) { fail("erofs: " + Text(errors.nativeCode(error)) + " " + errors.message(error)) }
print("erofs image written")
