use "process" as processInfo
use "erofs" as erofs
use "errors" as errors

function number(value: Text): Integer {
    let result = 0
    for digit in value { result = result * 10 + Integer(digit) - 48 }
    return result
}
let options = erofs.defaults()
if processInfo.argumentCount() > 2 { options.maximumBytes = number(processInfo.argument(2)) }
if processInfo.argumentCount() > 3 && processInfo.argument(3) == "lz4" { options.compression = erofs.LZ4 }
if processInfo.argumentCount() > 3 && processInfo.argument(3) == "zstd" { options.compression = erofs.ZSTD }
let error = erofs.writeDirectory(processInfo.argument(0), processInfo.argument(1), options)
if processInfo.argumentCount() > 4 {
    if !errors.isError(error) { fail("erofs limit was not enforced") }
    if errors.nativeCode(error) != number(processInfo.argument(4)) { fail("unexpected erofs error: " + Text(errors.nativeCode(error))) }
    print("erofs input rejected")
} else {
    if errors.isError(error) { fail("erofs: " + Text(errors.nativeCode(error)) + " " + errors.message(error)) }
    print("erofs image written")
}
