use "update" as update
use "crypto" as crypto
use "errors" as errors

function number(text: Text): Integer {
    let result = 0
    for c in text { result = result * 10 + Integer(c) - 48 }
    return result
}

let key = crypto.fromHex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
let metadata = readBytesFile(argument(0))
let signature = readBytesFile(argument(1))
if argument(2) == "inspect" {
    let decision = update.inspect(metadata, signature, key, "org.tolum.peer", update.hostTarget(), "stable",
        "https://updates.example", 1800000000, argument(3), "1.0.0", number(argument(4)), argument(5), argument(6))
    print(update.accepted(decision))
    print(update.eligible(decision))
    print(errors.code(update.error(decision)))
} else {
    let result = update.install(argument(2), metadata, signature, key, readBytesFile(argument(3)),
        "org.tolum.peer", update.hostTarget(), "stable", "https://updates.example", number(argument(4)),
        "test-device", "1.0.0")
    print(errors.booleanOk(result))
    if errors.booleanOk(result) { print(errors.booleanValue(result)) } else { print(errors.code(errors.booleanError(result))) }
}
