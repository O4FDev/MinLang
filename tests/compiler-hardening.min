use "../tools/testing.min" as test
use "system" as system
use "files" as files
record Context { compiler: test.Compiler; arguments: List<Text>; bootstrap: Boolean; root: Text }
function selected(className: Text, name: Text): Boolean {
    if argumentCount() == 0 { return true }
    for index in 0..argumentCount() { if argument(index) == name || argument(index) == className + "." + name || argument(index) == className { return true } }
    return false
}
function context(bootstrap: Boolean): Context {
    let compiler = test.compiler()
    if bootstrap { compiler.executable = test.setting("MINYAR_TEST_BOOTSTRAP", "./build/stage0"); compiler.compileTimeout = 10 }
    return Context { compiler: compiler; arguments: []; bootstrap: bootstrap; root: compiler.directory }
}
function compile(context: Context, source: Text): test.Result {
    let compiler = context.compiler
    compiler.serial += 1
    let path = compiler.directory + "/case" + Text(compiler.serial)
    writeTextFile(path + ".min", source)
    let command = [compiler.executable, path + ".min"]
    if context.bootstrap { command.add("-o") }
    command.add(path + ".ll")
    if !context.bootstrap { for argument in context.arguments { command.add(argument) } }
    let result = test.run(command, system.environment(), "", path + ".compile", compiler.compileTimeout)
    if result.status == 0 && test.addressEnabled(compiler.flags) { writeTextFile(path + ".ll", test.instrument(readTextFile(path + ".ll"))) }
    return result
}
function generated(context: Context, source: Text): Text {
    test.require(compile(context, source), "compile hardening source")
    return readTextFile(context.compiler.directory + "/case" + Text(context.compiler.serial) + ".ll")
}
function executes(context: Context, source: Text, expected: Text): Text {
    let ir = generated(context, source)
    let compiler = context.compiler
    let path = compiler.directory + "/case" + Text(compiler.serial)
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization]
        for flag in compiler.flags { command.add(flag) }
        for item in ["-Wno-override-module", path + ".ll", compiler.runtime, "-lm", "-o", path + ".exe"] { command.add(item) }
        test.require(test.run(command, system.environment(), "", path + ".link", compiler.linkTimeout), "link hardening source " + optimization)
        let result = test.run([path + ".exe"], system.environment(), "", path + ".run", compiler.runTimeout)
        test.check(result.status == 0 && result.output == expected && result.errorOutput == "", "hardening execution " + optimization + "\n" + result.output + result.errorOutput)
    }
    return ir
}
function rejects(context: Context, source: Text, diagnostic: Text) {
    let result = compile(context, source)
    test.check(result.status == 1 && result.output == "", "hardening rejection status/stdout")
    test.check(test.contains(result.errorOutput, diagnostic), "hardening rejection diagnostic\n" + result.errorOutput)
    test.check(files.pathSize(context.compiler.directory + "/case" + Text(context.compiler.serial) + ".ll") < 0, "hardening rejection emitted LLVM")
    test.check(!test.contains(result.errorOutput, "List position"), "hardening rejection internal List fault")
}
function body(ir: Text, name: Text): Text {
    let found = false
    let complete = false
    let pieces: List<Text> = []
    for line in test.lines(ir) {
        if !found && test.contains(line, "define ") && test.contains(line, "@.minyar.fn." + name + "(") { found = true; pieces.add(line + "\n") }
        else if found {
            pieces.add(line + "\n")
            if line == "}" { complete = true; break }
        }
    }
    test.check(found && complete, "missing hardening function " + name)
    return joinText(pieces)
}
let allowed = ["CompilerHardening.test_public_parallel_declarations_preserve_scalar_and_managed_contracts", "CompilerHardening.test_depth_analysis_uses_resolved_boolean_and_recursive_calls", "CompilerHardening.test_typed_bytes_methods_require_both_known_verb_and_width", "CompilerHardening.test_print_and_text_builtin_names_cannot_be_redeclared", "CompilerHardening.test_octal_literals_accept_every_octal_digit", "CompilerHardening.test_closure_dependent_list_signatures_and_comparators_compile_in_the_primary_frontend", "CompilerHardening.test_reassignable_record_parameters_are_not_scalar_records", "CompilerHardening.test_only_bounded_ownership_declares_the_stack_owner_runtime", "CompilerHardening.test_executable_entry_is_not_an_ordinary_callable_function", "CompilerHardening.test_imported_main_uses_the_language_calling_convention", "CompilerHardening.test_runtime_names_have_distinct_language_symbols", "CompilerHardening.test_imported_runtime_named_functions_are_safe", "CompilerHardening.test_package_names_keep_hyphens_and_underscores", "CompilerHardening.test_module_declarations_may_precede_imports", "CompilerHardening.test_parent_imports_remain_relative_when_a_library_is_selected", "CompilerHardening.test_character_literals_emit_scalar_constants", "CompilerHardening.test_hex_integer_boundaries_match_decimal_literals", "CompilerHardening.test_hex_literals_cannot_enter_the_decimal_float_parser", "CompilerHardening.test_float_normalization_matches_independent_decimal_conversion", "CompilerHardening.test_large_float_mantissas_keep_their_exponent", "CompilerHardening.test_float_literals_reject_the_exact_overflow_boundary", "CompilerHardening.test_wrapped_calls_and_lists_need_no_trailing_comma", "CompilerHardening.test_else_if_can_follow_a_newline", "CompilerHardening.test_unused_constants_validate_their_literals", "CompilerHardening.test_native_library_names_cannot_inject_llvm", "CompilerHardening.test_native_must_be_the_entire_function_body", "CompilerHardening.test_valid_native_signature", "CompilerHardening.test_native_bindings_cannot_redeclare_any_emitted_runtime_symbol", "CompilerHardening.test_imported_runtime_native_bindings_fail_direct_and_module_fallback", "CompilerHardening.test_conflicting_native_signatures_are_rejected_before_llvm", "CompilerHardening.test_native_symbols_are_distinct_from_language_names", "CompilerHardening.test_module_constant_shadowing_matches_single_module", "CompilerHardening.test_compound_assignment_captures_targets_before_side_effects", "CompilerHardening.test_constant_boundaries_and_else_if", "BootstrapHardening.test_bootstrap_wrapping_and_else_if_match_the_language", "BootstrapHardening.test_bootstrap_entry_is_not_an_ordinary_callable_function", "BootstrapHardening.test_bootstrap_checked_character_conversion", "BootstrapHardening.test_bootstrap_integer_accepts_character_code_points"]
for index in 0..argumentCount() {
    let valid = argument(index) == "CompilerHardening" || argument(index) == "BootstrapHardening"
    for name in allowed {
        let parts = test.words(test.replace(name, ".", " "))
        if argument(index) == name || argument(index) == parts[1] { valid = true }
    }
    test.check(valid, "unknown compiler hardening case " + argument(index))
}
if selected("CompilerHardening", "test_public_parallel_declarations_preserve_scalar_and_managed_contracts") {
    let ctx = context(false)
    executes(ctx, "public parallel function square(value: Integer): Integer { return value * value }\nprint(square(6))\n", "36\n")
    rejects(ctx, "public parallel function bad(value: Text): Integer { return 1 }\n", "parallel function 'bad' may use only Integer, Float, Boolean and Character values")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_depth_analysis_uses_resolved_boolean_and_recursive_calls") {
    let ctx = context(false)
    let source = "function leaf(): Boolean { return true }\nfunction middle(): Boolean { return leaf() }\nfunction upper(): Integer { if middle() { return 42 } else { return 0 } }\nfunction recursive(n: Integer): Integer { if n == 0 { return upper() } else { return recursive(n - 1) } }\nprint(recursive(8))\n"
    let ir = generated(ctx, source)
    for name in ["leaf", "middle", "upper", "recursive"] { test.check(test.contains(body(ir, name), "call void @minyar_stack_enter()") == (name == "recursive"), "resolved depth/recursion stack guard " + name) }
    executes(ctx, source, "42\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_typed_bytes_methods_require_both_known_verb_and_width") {
    let ctx = context(false)
    executes(ctx, "let values = Bytes(0)\nvalues.addInt32(7)\nprint(values.getInt32(0))\nvalues.setInt32(0, 9)\nprint(values.getInt32(0))\n", "7\n9\n")
    rejects(ctx, "let values = Bytes(8)\nvalues.popInt32()\n", "Bytes has no method named 'popInt32'")
    rejects(ctx, "let values = Bytes(8)\nvalues.popFloat64()\n", "Bytes has no method named 'popFloat64'")
    rejects(ctx, "let values = Bytes(8)\nvalues.getBogus(0)\n", "Bytes has no method named 'getBogus'")
    rejects(ctx, "let values = Bytes(8)\nvalues.addBogus(7)\n", "Bytes has no method named 'addBogus'")
    rejects(ctx, "let values = Bytes(8)\nvalues.setBogus(0, 7)\n", "Bytes has no method named 'setBogus'")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_print_and_text_builtin_names_cannot_be_redeclared") {
    let ctx = context(false)
    rejects(ctx, "function print(): Integer { return 7 }\n", "function 'print' uses a reserved built-in name")
    rejects(ctx, "function Text(): Integer { return 7 }\n", "function 'Text' uses a reserved built-in name")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_octal_literals_accept_every_octal_digit") {
    let ctx = context(false)
    executes(ctx, "print(0o7)\nprint(0o17)\nprint(0o777)\nprint(0o755)\nprint(0o777777777777777777777)\n", "7\n15\n511\n493\n9223372036854775807\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_closure_dependent_list_signatures_and_comparators_compile_in_the_primary_frontend") {
    let ctx = context(false)
    let result = compile(ctx, "function make(): Callback<List<Integer>> { fail(\"unused\") }\n")
    test.check(result.status == 0 && result.output == "" && result.errorOutput == "", "closure-dependent primary frontend compilation")
    test.check(files.pathSize(ctx.compiler.directory + "/case" + Text(ctx.compiler.serial) + ".ll") >= 0, "closure-dependent source did not emit LLVM")
    result = compile(ctx, "function make(): Callback<Integer, List<Text>> { fail(\"unused\") }\n")
    test.check(result.status == 0 && result.output == "" && result.errorOutput == "", "closure-dependent primary frontend compilation")
    test.check(files.pathSize(ctx.compiler.directory + "/case" + Text(ctx.compiler.serial) + ".ll") >= 0, "closure-dependent source did not emit LLVM")
    result = compile(ctx, "let values = [3, 1, 2]\nvalues.sortBy(function(a: Integer, b: Integer): Integer { return a - b })\n")
    test.check(result.status == 0 && result.output == "" && result.errorOutput == "", "closure-dependent primary frontend compilation")
    test.check(files.pathSize(ctx.compiler.directory + "/case" + Text(ctx.compiler.serial) + ".ll") >= 0, "closure-dependent source did not emit LLVM")
    result = compile(ctx, "let values = [3, 1, 2]\nlet sorted = values.sortedBy(function(a: Integer, b: Integer): Integer { return a - b })\n")
    test.check(result.status == 0 && result.output == "" && result.errorOutput == "", "closure-dependent primary frontend compilation")
    test.check(files.pathSize(ctx.compiler.directory + "/case" + Text(ctx.compiler.serial) + ".ll") >= 0, "closure-dependent source did not emit LLVM")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_reassignable_record_parameters_are_not_scalar_records") {
    let ctx = context(false)
    executes(ctx, "record Point { x: Integer; y: Integer }\nfunction sum(point: Point): Integer {\nlet total = point.x + point.y\npoint = Point { x: 0, y: 0 }\nreturn total + point.x\n}\nprint(sum(Point { x: 3, y: 4 }))\n", "7\n")
    executes(ctx, "record Point { x: Integer; y: Integer }\nfunction first(): Integer {\nlet p = Point { x: 10, y: 20 }\nreturn p.x + p.y\n}\nfunction second(q: Point): Integer {\nlet product = q.x * q.y\nq = Point { x: 1, y: 1 }\nreturn product + q.x\n}\nprint(first())\nprint(second(Point { x: 3, y: 4 }))\n", "30\n13\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_only_bounded_ownership_declares_the_stack_owner_runtime") {
    let ctx = context(false)
    let source = "function label(value: Integer): Text { let text = Text(value); return text }\nprint(label(7))\n"
    let ir = generated(ctx, source)
    for name in ["@minyar_rc_enter_stack_v1", "@minyar_rc_leave_stack_v1"] { test.check(!test.contains(ir, name), "unbounded compiler emitted stack ownership ABI") }
    ctx.arguments = ["--bounded-owners", "2048"]
    ir = generated(ctx, source)
    for name in ["@minyar_rc_enter_stack_v1", "@minyar_rc_leave_stack_v1"] { test.check(test.contains(ir, "declare void " + name + "("), "bounded ownership missing stack ABI") }
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_executable_entry_is_not_an_ordinary_callable_function") {
    let ctx = context(false)
    rejects(ctx, "function main(): Integer { return main() }\n", "the executable entry main cannot be called")
    rejects(ctx, "function main(): Integer { return 0 }\nfunction invoke(): Integer { return main() }\n", "the executable entry main cannot be called")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_imported_main_uses_the_language_calling_convention") {
    let ctx = context(false)
    writeTextFile(ctx.compiler.directory + "/entry-name.min", "public function main(): Integer { return 42 }\n")
    executes(ctx, "use \"./entry-name.min\" as lib\nprint(lib.main())\n", "42\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_runtime_names_have_distinct_language_symbols") {
    let ctx = context(false)
    let names = ["minyar_fail_integer_overflow", "minyar_fail_integer_division", "minyar_print_integer", "minyar_list_get", "minyar_stack_enter", "minyar_rc_enter_stack_v1", "minyar_future_helper", "minyar_"]
    let pieces: List<Text> = []
    for name in names { pieces.add("function " + name + "(): Integer { return 42 }\n") }
    for name in names { pieces.add("print(" + name + "())\n") }
    let source = joinText(pieces)
    let ir = generated(ctx, source)
    for name in names { test.check(test.contains(ir, "define i64 @.minyar.fn." + name + "(") && !test.contains(ir, "define i64 @" + name + "("), "distinct runtime-named language symbol " + name) }
    executes(ctx, source, "42\n42\n42\n42\n42\n42\n42\n42\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_imported_runtime_named_functions_are_safe") {
    let ctx = context(false)
    writeTextFile(ctx.compiler.directory + "/reserved.min", "public function minyar_fail_integer_overflow(): Integer { return 42 }\n")
    executes(ctx, "use \"./reserved.min\" as lib\nprint(lib.minyar_fail_integer_overflow())\n", "42\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_package_names_keep_hyphens_and_underscores") {
    let ctx = context(false)
    let library = ctx.compiler.directory + "/library with spaces"
    test.check(files.makeDirectory(library) == 0, "private package search directory")
    ctx.arguments = ["--library", library]
    for name in ["valid-name", "under_score", "a1"] {
        writeTextFile(library + "/" + name + ".min", "public function answer(): Integer { return 42 }\n")
        executes(ctx, "use \"" + name + "\" as package\nprint(package.answer())\n", "42\n")
    }
    for name in ["bad.name", "bad/name", "bad name"] { rejects(ctx, "use \"" + name + "\" as package\n", "package names use letters, digits, '-', and '_'") }
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_module_declarations_may_precede_imports") {
    let ctx = context(false)
    writeTextFile(ctx.compiler.directory + "/empty.min", "public function value(): Integer { return 1 }\n")
    let declaration = "function answer(): Integer { return 42 }\n"
    let imported = "use \"./empty.min\" as empty\n"
    for source in [declaration + imported, imported + declaration] { executes(ctx, source + "print(answer() + empty.value())\n", "43\n") }
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_parent_imports_remain_relative_when_a_library_is_selected") {
    let ctx = context(false)
    let project = ctx.compiler.directory + "/project with spaces"
    let nested = project + "/nested"
    let library = ctx.compiler.directory + "/library with spaces"
    for directory in [project, nested, library] { test.check(files.makeDirectory(directory) == 0, "nested relative import directory") }
    writeTextFile(project + "/shared.min", "public function value(): Integer { return 42 }\n")
    writeTextFile(nested + "/local.min", "public function value(): Integer { return 7 }\n")
    writeTextFile(library + "/shared.min", "public function value(): Integer { return 13 }\n")
    ctx.compiler.directory = nested
    ctx.arguments = ["--library", library]
    executes(ctx, "use \"../shared.min\" as parent\nuse \"./local.min\" as local\nuse \"shared\" as package\nprint(parent.value())\nprint(local.value())\nprint(package.value())\n", "42\n7\n13\n")
    rejects(ctx, "use \".shared\" as invalid\n", "package names use letters, digits, '-', and '_'")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_character_literals_emit_scalar_constants") {
    let ctx = context(false)
    let ir = executes(ctx, "constant LETTER = 'é'\nprint(Integer('a'))\nprint(Integer(LETTER))\nprint(Integer('中'))\nprint(Integer('🙂'))\nprint(Integer('\\n'))\nprint(Integer('\\t'))\nprint(Integer('\\\\'))\n", "97\n233\n20013\n128578\n10\n9\n92\n")
    test.check(!test.contains(ir, "call i32 @minyar_text_character_at"), "validated Character literals still perform runtime Text reads")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_hex_integer_boundaries_match_decimal_literals") {
    let ctx = context(false)
    executes(ctx, "constant LOW = -0x000000008000000000000000\nprint(0x7FFFFFFFFFFFFFFF)\nprint(-0x7FFFFFFFFFFFFFFF)\nprint(-0x8000000000000000)\nprint(LOW)\n", "9223372036854775807\n-9223372036854775807\n-9223372036854775808\n-9223372036854775808\n")
    rejects(ctx, "print(0x8000000000000000)\n", "Integer literal is outside the supported range")
    rejects(ctx, "print(-0x8000000000000001)\n", "Integer literal is outside the supported range")
    rejects(ctx, "print(-0xFFFFFFFFFFFFFFFF)\n", "Integer literal is outside the supported range")
    rejects(ctx, "print(-0x80000000000000000)\n", "Integer literal is outside the supported range")
    rejects(ctx, "print(1 - 0x8000000000000000)\n", "Integer literal is outside the supported range")
    rejects(ctx, "constant UNUSED = 0x8000000000000000\n", "Integer literal is outside the supported range")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_hex_literals_cannot_enter_the_decimal_float_parser") {
    let ctx = context(false)
    rejects(ctx, "print(0x1.5)\n", "hexadecimal literals are Integers and cannot have a decimal point")
    test.removeTree(ctx.root)
}
