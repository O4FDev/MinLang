        "print(0255958679.396574e-127 == 2.55958679396573992e-119)\n",
        "print(000000873267887698483131860.09891824e-246 == 8.73267887698483091e-226)\n",
        "print(7100792.350620e-249 == 7.10079235062000006e-243)\n",
        "print(00050121.92277167664000000e-246 == 5.01219227716766368e-242)\n",
        "print(00000035414.1600e262 == 3.54141599999999997e+266)\n",
        "print(0088162405409428.5580000000e149 == 8.81624054094285622e+162)\n",
        "print(0000000026.000e-278 == 2.60000000000000025e-277)\n"
    ]
    test.check(lines.length == 64, "float normalization exact seed domain")
    executes(ctx, joinText(lines), "true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\n")
    executes(ctx, "print(-0.0)\nprint(0.0e999999999999999999999)\n", "-0.0\n0.0\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_large_float_mantissas_keep_their_exponent") {
    let ctx = context(false)
    let zeros: List<Text> = []
    for index in 0..100010 { zeros.add("0") }
    executes(ctx, "print(0." + joinText(zeros) + "1e100011)\n", "1.0\n")
    rejects(ctx, "print(0." + joinText(zeros) + "1e100400)\n", "Float literal is larger than the largest Float")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_float_literals_reject_the_exact_overflow_boundary") {
    let ctx = context(false)
    rejects(ctx, "print(1.8e308)\n", "Float literal is larger than the largest Float")
    rejects(ctx, "print(-1.8e308)\n", "Float literal is larger than the largest Float")
    rejects(ctx, "print(1.7976931348623159e308)\n", "Float literal is larger than the largest Float")
    rejects(ctx, "print(.0)\n", "Float literal is larger than the largest Float")
    executes(ctx, "print(1.7976931348623158e308 == 1.7976931348623157e308)\n", "true\n")
    executes(ctx, "print(.0 == 1.7976931348623157e308)\n", "true\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_wrapped_calls_and_lists_need_no_trailing_comma") {
    let ctx = context(false)
    executes(ctx, "function add(\nleft: Integer,\nright: Integer\n): Integer { return left + right }\nlet values = [\nadd(\n20,\n22\n),\n(\n3 +\n4\n)\n]\nprint(values[\n0\n])\nprint(values[1])\n", "42\n7\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_else_if_can_follow_a_newline") {
    let ctx = context(false)
    executes(ctx, "function category(value: Integer): Integer {\nif value < 0 { return 1 }\n// A branch may continue after whitespace and comments.\nelse if value == 0 { return 2 }\nelse { return 3 }\n}\nif false { print(0) }\nprint(category(-1))\nprint(category(0))\nprint(category(1))\n", "1\n2\n3\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_unused_constants_validate_their_literals") {
    let ctx = context(false)
    rejects(ctx, "constant UNUSED = 9223372036854775808\nprint(42)\n", "Integer literal is outside the supported range")
    rejects(ctx, "constant UNUSED = -9223372036854775809\nprint(42)\n", "Integer literal is outside the supported range")
    rejects(ctx, "constant UNUSED = 1.0e309\nprint(42)\n", "Float literal is larger than the largest Float")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_native_library_names_cannot_inject_llvm") {
    let ctx = context(false)
    rejects(ctx, "function draw() { native \"\" }\n", "native library names must use ASCII letters, digits, and")
    rejects(ctx, "function draw() { native \"../graphics\" }\n", "native library names must use ASCII letters, digits, and")
    rejects(ctx, "function draw() { native \"bad-name\" }\n", "native library names must use ASCII letters, digits, and")
    rejects(ctx, "function draw() { native \"bad|name\" }\n", "native library names must use ASCII letters, digits, and")
    rejects(ctx, "function draw() { native \"bad\\nname\" }\n", "native library names must use ASCII letters, digits, and")
    rejects(ctx, ("function draw() { native \"bad" + Text(Character(0)) + "name\" }\n"), "native library names must use ASCII letters, digits, and")
    rejects(ctx, "function draw() { native \"é\" }\n", "native library names must use ASCII letters, digits, and")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_native_must_be_the_entire_function_body") {
    let ctx = context(false)
    rejects(ctx, "function draw() { print(1); native \"graphics\" }\n", "native must be the only statement in its function")
    rejects(ctx, "function draw() { native \"graphics\"; print(1) }\n", "native must be the only statement in its function")
    rejects(ctx, "function draw() { if true { native \"graphics\" } }\n", "native must be the only statement in its function")
    rejects(ctx, "function draw() { if true {} else { native \"graphics\" } }\n", "native must be the only statement in its function")
    rejects(ctx, "function draw() { while true { native \"graphics\" } }\n", "native must be the only statement in its function")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_valid_native_signature") {
    let ctx = context(false)
    let ir = generated(ctx, "function draw(value: Float, ready: Boolean): Boolean {\nnative \"graphics\"\n}\n")
    test.check(test.contains(ir, "declare zeroext i1 @minyar_graphics_draw(double, i1 zeroext)"), "native Boolean argument/result ABI")
    test.check(test.contains(ir, "; minyar-native-library: graphics"), "native graphics library metadata")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_native_bindings_cannot_redeclare_any_emitted_runtime_symbol") {
    let ctx = context(false)
    rejects(ctx, "function enter(): Integer { native \"rc\" }\n", "native symbol conflicts with a runtime function")
    rejects(ctx, "function enter(value: Integer) { native \"rc\" }\n", "native symbol conflicts with a runtime function")
    rejects(ctx, "function enter() { native \"stack\" }\n", "native symbol conflicts with a runtime function")
    rejects(ctx, "function integer(value: Integer) { native \"print\" }\n", "native symbol conflicts with a runtime function")
    rejects(ctx, "function length(value: Bytes): Integer { native \"bytes\" }\n", "native symbol conflicts with a runtime function")
    rejects(ctx, "function division(value: Integer) { native \"fail_integer\" }\n", "native symbol conflicts with a runtime function")
    rejects(ctx, "function overflow() { native \"fail_integer\" }\n", "native symbol conflicts with a runtime function")
    ctx.arguments = ["--bounded-owners", "2048"]
    rejects(ctx, "function enter_stack_v1(slots: Text, frame: Text, count: Integer) { native \"rc\" }\n", "native symbol conflicts with a runtime function")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_imported_runtime_native_bindings_fail_direct_and_module_fallback") {
    let ctx = context(false)
    let modules = test.setting("MINYAR_TEST_MODULE_COMPILER", "./build/minyarc-modules")
    for declaration in ["function enter(): Integer { native \"rc\" }", "function enter(value: Integer) { native \"rc\" }", "function division(value: Integer) { native \"fail_integer\" }"] {
        writeTextFile(ctx.compiler.directory + "/collision.min", "public " + declaration + "\n")
        let entry = ctx.compiler.directory + "/entry.min"
        writeTextFile(entry, "use \"./collision.min\" as collision\n")
        for compiler in [ctx.compiler.executable, modules] {
            let llvm = ctx.compiler.directory + "/collision.ll"
            let prior = ctx.compiler.directory + "/prior.state"
            writeTextFile(prior, "")
            let command = [compiler, entry, llvm]
            if compiler != ctx.compiler.executable { for option in ["--module-state", prior, ctx.compiler.directory + "/next.state", ctx.compiler.directory + "/stats"] { command.add(option) } }
            let result = test.run(command, system.environment(), "", ctx.compiler.directory + "/collision-build", 30)
            test.check(result.status == 1, "imported native collision rejection status")
            test.check(test.contains(result.errorOutput, "native symbol conflicts with a runtime function"), "imported native collision diagnostic")
            test.check(files.pathSize(llvm) < 0, "invalid native ABI left LLVM output behind")
        }
    }
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_conflicting_native_signatures_are_rejected_before_llvm") {
    let ctx = context(false)
    writeTextFile(ctx.compiler.directory + "/integer.min", "public function sample(value: Integer): Integer { native \"graphics\" }\n")
    writeTextFile(ctx.compiler.directory + "/float.min", "public function sample(value: Float): Float { native \"graphics\" }\n")
    rejects(ctx, "use \"./integer.min\" as integer\nuse \"./float.min\" as float\n", "native symbol has conflicting function signatures")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_native_symbols_are_distinct_from_language_names") {
    let ctx = context(false)
    let ir = generated(ctx, "function sample(): Integer { native \"graphics\" }\nfunction minyar_graphics_sample(): Integer { return 42 }\n")
    test.check(test.contains(ir, "declare i64 @minyar_graphics_sample()"), "distinct native/language symbol")
    test.check(test.contains(ir, "define i64 @.minyar.fn.sample()"), "distinct native/language symbol")
    test.check(test.contains(ir, "define i64 @.minyar.fn.minyar_graphics_sample()"), "distinct native/language symbol")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_module_constant_shadowing_matches_single_module") {
    let ctx = context(false)
    writeTextFile(ctx.compiler.directory + "/empty.min", "public constant SENTINEL = 0\n")
    let source = "constant VALUE = 99\nfunction typed(VALUE: Integer): Integer { return VALUE }\nlet VALUE: Integer = 7\nprint(VALUE)\nprint(typed(12))\n"
    executes(ctx, source, "7\n12\n")
    executes(ctx, "use \"./empty.min\" as empty\n" + source, "7\n12\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_compound_assignment_captures_targets_before_side_effects") {
    let ctx = context(false)
    executes(ctx, "record Cell { number: Float; label: Text; bytes: Bytes }\nrecord Holder { cell: Cell }\nfunction replacement(holder: Holder): Float {\nholder.cell = Cell { number: 99.0; label: \"new\"; bytes: Bytes(1) }\nreturn 2.5\n}\nfunction replacementText(holder: Holder): Text {\nholder.cell = Cell { number: 88.0; label: \"latest\"; bytes: Bytes(1) }\nreturn \"!\"\n}\nfunction position(holder: Holder, visits: List<Integer>): Integer {\nvisits[0] += 1\nholder.cell = Cell { number: 77.0; label: \"bytes\"; bytes: Bytes(1) }\nreturn 0\n}\nlet holder = Holder { cell: Cell { number: 1.5; label: \"old\"; bytes: Bytes(1) } }\nholder.cell.number += replacement(holder)\nprint(holder.cell.number)\nholder.cell.label += replacementText(holder)\nprint(holder.cell.label)\nlet visits = [0]\nholder.cell.bytes[position(holder, visits)] += 1\nprint(holder.cell.bytes[0])\nprint(visits[0])\nlet values = [1.25]\nvalues[0] *= 4.0\nprint(values[0])\n", "99.0\nlatest\n0\n1\n5.0\n")
    test.removeTree(ctx.root)
}
if selected("CompilerHardening", "test_constant_boundaries_and_else_if") {
    let ctx = context(false)
    executes(ctx, "constant LOW = -9223372036854775808\nconstant HIGH = 9223372036854775807\nconstant SMALL: Float = -0.25\nconstant WORD = \"é\"\nfunction category(value: Integer): Text {\nif value < 0 { return \"negative\" } else if value == 0 { return WORD } else { return \"positive\" }\n}\nprint(LOW)\nprint(HIGH)\nprint(SMALL)\nprint(category(-1))\nprint(category(0))\nprint(category(1))\n", "-9223372036854775808\n9223372036854775807\n-0.25\nnegative\né\npositive\n")
    test.removeTree(ctx.root)
}
if selected("BootstrapHardening", "test_bootstrap_wrapping_and_else_if_match_the_language") {
    let ctx = context(true)
    executes(ctx, "function category(\nvalue: Integer\n): Integer {\nif value < 0 { return 1 }\nelse if value == 0 { return 2 }\nelse { return 3 }\n}\nfunction main() {\nprint(category(\n0\n))\nreturn 0\n}\n", "2\n")
    test.removeTree(ctx.root)
}
if selected("BootstrapHardening", "test_bootstrap_entry_is_not_an_ordinary_callable_function") {
    let ctx = context(true)
    rejects(ctx, "function main(): Integer { return main() }\n", "the executable entry main cannot be called")
    rejects(ctx, "function main(): Integer { return 0 }\nfunction invoke(): Integer { return main() }\n", "the executable entry main cannot be called")
    test.removeTree(ctx.root)
}
if selected("BootstrapHardening", "test_bootstrap_checked_character_conversion") {
    let ctx = context(true)
    executes(ctx, "function main() {\nprint(Character(128578))\nreturn 0\n}\n", "🙂\n")
    rejects(ctx, "function main() {\nprint(Character())\nreturn 0\n}\n", "Character expects exactly one Integer code point")
    rejects(ctx, "function main() {\nprint(Character(\"text\"))\nreturn 0\n}\n", "a Character code point needs Integer")
    test.removeTree(ctx.root)
}
if selected("BootstrapHardening", "test_bootstrap_integer_accepts_character_code_points") {
    let ctx = context(true)
    executes(ctx, "function main() {\nprint(Integer('a'))\nprint(Integer(Character(128578)))\nprint(Integer(42))\nreturn 0\n}\n", "97\n128578\n42\n")
    rejects(ctx, "function main() {\nprint(Integer())\nreturn 0\n}\n", "Integer expects exactly one Integer, Character, or Text value")
    rejects(ctx, "function main() {\nprint(Integer(true))\nreturn 0\n}\n", "Integer expects an Integer, Character, or Text value")
    test.removeTree(ctx.root)
}
print("Compiler and bootstrap hardening contracts: passed")
