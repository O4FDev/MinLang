// RFC 9000 sections 9.5 and 9.6 regression oracles.
// Uses only existing APIs so a baseline failure must be a protocol assertion,
// not a missing function or parser error. Run only after the heavy-work GO.
use "quic" as quic
use "quicwire" as wire
use "crypto" as crypto
use "errors" as errors
use "quiccrypto" as protection
use "tlstickets" as tickets
use "quicrecovery" as recovery

record Pair { client: quic.Connection; server: quic.Connection; now: Integer }
function drive(c: quic.Connection, s: quic.Connection, now: Integer) {
    for packet in quic.pollDatagrams(c, now) { quic.receivePath(s, packet.data, packet.pathId, now) }
    for packet in quic.pollDatagrams(s, now) { quic.receivePath(c, packet.data, packet.pathId, now) }
}
function connected(root: Bytes, identity: Bytes, key: Bytes, client: Bytes, clientKey: Bytes): Pair {
    let c = quic.client("localhost", randomBytes(80), "minyar-test", [root], [client], clientKey)
    let s = quic.server(randomBytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true)
    let now = 0
    for count in 0..200 { drive(c, s, now); now += 10 }
    return Pair { client: c; server: s; now: now }
}
function ready(p: Pair): Boolean {
    return p.client.state == quic.ESTABLISHED && p.server.state == quic.ESTABLISHED &&
        p.client.confirmed && p.server.confirmed && p.client.remoteIds.length == 2
}
function intentionalMigration(p: Pair): Integer {
    if !ready(p) { print("setup failed: authenticated peers or spare CID absent"); return 40 }
    let c = p.client; let s = p.server; let now = p.now
    let original = crypto.hex(c.remote)
    if !errors.booleanOk(quic.probePath(c, 7, now)) { print("setup failed: intentional probe refused despite spare CID"); return 41 }
    let observed = false
    for packet in quic.pollDatagrams(c, now) {
        if packet.pathId == 7 {
            let header = wire.header(packet.data, 0, s.local.length)
            if !header.valid || header.kind != wire.ONE_RTT { return 43 }
            if crypto.hex(header.destination) == original {
                print("semantic failure: intentional new path reused the original destination CID")
                return 42
            }
            let issued = false
            for known in c.remoteIds { if crypto.hex(known.id) == crypto.hex(header.destination) { issued = true } }
            if !issued { print("semantic failure: probe used an unissued CID"); return 44 }
            observed = true
        }
        quic.receivePath(s, packet.data, packet.pathId, now)
    }
    if !observed { print("setup failed: no new-path packet"); return 45 }
    for count in 0..200 { drive(c, s, now); now += 10 }
    if c.state != quic.ESTABLISHED || s.state != quic.ESTABLISHED || c.activePath != 7 { return 46 }
    print("intentional migration used a different issued CID and validated the exact new path")
    return 0
}
function noSpareCid(p: Pair): Integer {
    if !ready(p) { return 50 }
    let c = p.client
    // Model a peer that has not supplied another usable destination CID.
    // The wire/TLS state is already authenticated; no new transport API is used.
    c.remoteIds = [c.remoteIds[0]]
    let original = crypto.hex(c.remote); let paths = c.paths.length
    if errors.booleanOk(quic.probePath(c, 7, p.now)) {
        print("semantic failure: intentional migration accepted without an unused destination CID")
        return 52
    }
    if c.activePath != 0 || c.paths.length != paths || crypto.hex(c.remote) != original { return 53 }
    for packet in quic.pollDatagrams(c, p.now) { if packet.pathId == 7 { return 54 } }
    if c.state != quic.ESTABLISHED { return 55 }
    print("CID exhaustion left the validated original path usable without a new-path transmission")
    return 0
}
function preferredAddress(root: Bytes, identity: Bytes, key: Bytes, client: Bytes, clientKey: Bytes): Integer {
    let c = quic.client("localhost", randomBytes(80), "minyar-test", [root], [client], clientKey)
    let s = quic.server(randomBytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true)
    // RFC 9000 section 18.2: 192.0.2.44:443, absent IPv6 address/port,
    // an eight-byte alternative CID and a sixteen-byte stateless-reset token.
    // This test stops at authenticated client handshake completion before
    // the synthetic server would need to own/use the alternative CID.
    let value = crypto.fromHex("c000022c01bb")
    value.addBytes(Bytes(18)); value.add(8); value.addBytes(randomBytes(8)); value.addBytes(randomBytes(16))
    let transport = s.serverTLS.transportParameters.slice(0, s.serverTLS.transportParameters.length)
    transport.addBytes(errors.bytesValue(wire.encode(13)))
    transport.addBytes(errors.bytesValue(wire.encode(value.length))); transport.addBytes(value)
    s.serverTLS.transportParameters = transport
    let now = 0
    while now < 10000 && c.state != quic.ESTABLISHED && c.state != quic.FAILED {
        drive(c, s, now); now += 10
    }
    if c.state == quic.FAILED && c.code == 8 {
        print("semantic failure: a valid preferred_address caused a transport-parameter failure")
        return 62
    }
    if c.state != quic.ESTABLISHED || !c.clientTLS.authenticated { print("setup failed: preferred-address handshake did not authenticate"); return 63 }
    if c.activePath != 0 { print("semantic failure: unmapped preferred address changed the active path"); return 64 }
    print("valid preferred_address preserved authenticated handshake and the original active path")
    return 0
}
function natRebinding(p: Pair): Integer {
    if !ready(p) { return 70 }
    let c = p.client; let s = p.server; let now = p.now
    let original = crypto.hex(c.remote)
    let opened = quic.openStream(c, false); if !errors.integerOk(opened) { return 71 }
    let id = errors.integerValue(opened); let expected = Bytes("NAT rebinding keeps the existing client connection")
    if !errors.integerOk(quic.writeStream(c, id, expected, true)) { return 72 }
    let received = Bytes(); let observed = false
    for count in 0..500 {
        for packet in quic.pollDatagrams(c, now) {
            let header = wire.header(packet.data, 0, s.local.length)
            if header.valid && header.kind == wire.ONE_RTT {
                if crypto.hex(header.destination) != original { return 73 }
                observed = true
            }
            // Only the external source mapping changed. The client did not
            // deliberately probe/migrate its own local endpoint.
            quic.receivePath(s, packet.data, 7, now)
        }
        for packet in quic.pollDatagrams(s, now) { quic.receivePath(c, packet.data, 0, now) }
        let read = quic.readStream(s, id)
        if errors.bytesOk(read) { received.addBytes(errors.bytesValue(read)) }
        now += 10
    }
    if !observed || crypto.hex(received) != crypto.hex(expected) || c.state != quic.ESTABLISHED ||
       s.state != quic.ESTABLISHED || c.activePath != 0 || s.activePath != 7 { return 74 }
    print("NAT rebinding preserved the client's CID and authenticated stream while the server validated the source")
    return 0
}
function appendInteger(data: Bytes, value: Integer) { data.addBytes(errors.bytesValue(wire.encode(value))) }
function authenticatedFrame(sender: quic.Connection, receiver: quic.Connection, destination: Bytes, payload: Bytes): Bytes {
    let number = sender.spaces[2].next; sender.spaces[2].next += 1
    let header = Bytes(); header.add(0x43 | ((sender.spaces[2].writeGeneration & 1) << 2)); header.addBytes(destination)
    for index in 0..4 { header.add((number >> ((3 - index) * 8)) & 255) }
    return errors.bytesValue(protection.protect(sender.spaces[2].write,header,header.length - 4,number,payload))
}
function newCid(sequence: Integer, prior: Integer, id: Bytes, token: Bytes): Bytes {
    let data = Bytes(); appendInteger(data,24); appendInteger(data,sequence); appendInteger(data,prior)
    data.add(id.length); data.addBytes(id); data.addBytes(token); return data
}
function failedValidation(p: Pair): Integer {
    if !ready(p) { return 80 }
    let c=p.client;let s=p.server;let now=p.now;let original=crypto.hex(c.remote)
    if !errors.booleanOk(quic.probePath(c,7,now)) { return 81 }
    for count in 0..1000 {
        for packet in quic.pollDatagrams(c,now) { if packet.pathId==0 { quic.receivePath(s,packet.data,0,now) } }
        for packet in quic.pollDatagrams(s,now) { quic.receivePath(c,packet.data,0,now) }
        now+=10
    }
    if c.paths.length!=1 {
        print("semantic failure: expired intentional candidate retained its path and destination CID")
        return 82
    }
    if c.activePath!=0 || crypto.hex(c.remote)!=original || c.state!=quic.ESTABLISHED || s.state!=quic.ESTABLISHED { return 83 }
    if !errors.booleanOk(quic.probePath(c,9,now)) { print("failed candidate blocked the next migration despite replacement CID");return 84 }
    print("failed validation retired the candidate CID, kept the original route and allowed another bounded probe")
    return 0
}
function retirePrior(p: Pair): Integer {
    if !ready(p) { return 90 }
    let c=p.client;let s=p.server;let id=randomBytes(8);let token=randomBytes(16)
    let frame=newCid(2,2,id,token)
    quic.receivePath(c,authenticatedFrame(s,c,c.local,frame),0,p.now)
    if c.state!=quic.ESTABLISHED || c.remoteIds.length!=1 { return 91 }
    quic.ping(c);let observed=false
    for packet in quic.pollDatagrams(c,p.now) {
        let header=wire.header(packet.data,0,c.local.length)
        if header.valid && header.kind==wire.ONE_RTT {
            if crypto.hex(header.destination)!=crypto.hex(id) {
                print("semantic failure: retiring the active CID left a path transmitting the retired destination")
                return 92
            }
            observed=true
        }
    }
    if !observed { return 93 }
    print("increased retire-prior replaced every affected path before sending retirement frames")
    return 0
}
function duplicateRetirement(p: Pair): Integer {
    if !ready(p) { return 100 }
    let c=p.client;let s=p.server;let old=c.remoteIds[1]
    quic.receivePath(c,authenticatedFrame(s,c,c.local,newCid(2,2,randomBytes(8),randomBytes(16))),0,p.now)
    if c.state!=quic.ESTABLISHED { return 101 }
    for count in 0..1000 {
        quic.receivePath(c,authenticatedFrame(s,c,c.local,newCid(old.sequence,0,old.id,old.token)),0,p.now)
        if c.state!=quic.ESTABLISHED || c.remoteIds.length>2 || c.pending.length>8 {
            print("semantic failure: reordered duplicate NEW_CONNECTION_ID accumulated retirement state")
            return 102
        }
    }
    print("reordered obsolete NEW_CONNECTION_ID duplicates retained one bounded retirement per sequence")
    return 0
}
function successfulRetirement(p: Pair): Integer {
    let original=crypto.hex(p.client.remote)
    let result=intentionalMigration(p);if result!=0 { return result }
    if p.client.paths.length!=1 {
        print("semantic failure: validated intentional migration retained the abandoned original path")
        return 112
    }
    for known in p.client.remoteIds { if crypto.hex(known.id)==original { return 113 } }
    if crypto.hex(p.client.remote)==original { return 114 }
    print("validated migration retired the abandoned path CID")
    return 0
}
function unknownDestination(p: Pair): Integer {
    if !ready(p) { return 120 }
    let c=p.client;let s=p.server;let largest=c.spaces[2].largest;let paths=c.paths.length
    let id=randomBytes(8)
    while quic.ownsConnectionId(c,id) { id=randomBytes(8) }
    let payload=crypto.fromHex("0100000000")
    quic.receivePath(c,authenticatedFrame(s,c,id,payload),9,p.now)
    if c.spaces[2].largest!=largest || c.paths.length!=paths || c.activePath!=0 || c.state!=quic.ESTABLISHED { return 121 }
    print("unknown destination CID did not allocate a path or advance authenticated packet state")
    return 0
}

function preferredPair(root: Bytes, identity: Bytes, key: Bytes, client: Bytes, clientKey: Bytes, disabled: Boolean, configured: Boolean): Pair {
    let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
    let s=quic.server(randomBytes(80),"minyar-test",c.originalDestination,[identity],key,[root],true)
    if configured {
        if !errors.booleanOk(quic.configurePreferredAddress(s,crypto.fromHex("c000022c"),443,Bytes(16),0)) { return Pair { client:c;server:s;now:0 } }
    } else {
        let value=crypto.fromHex("c000022c01bb");value.addBytes(Bytes(18));value.add(8)
        value.addBytes(randomBytes(8));value.addBytes(randomBytes(16))
        let transport=s.serverTLS.transportParameters.slice(0,s.serverTLS.transportParameters.length)
        appendInteger(transport,13);appendInteger(transport,value.length);transport.addBytes(value)
        if disabled { appendInteger(transport,12);appendInteger(transport,0) }
        s.serverTLS.transportParameters=transport
    }
    let now=0
    while now<10000 && c.state!=quic.ESTABLISHED && c.state!=quic.FAILED { drive(c,s,now);now+=10 }
    // The synthetic server owns the authenticated preferred CID before it
    // processes client Finished. This leaves certificate/Finished checks intact.
    if c.state==quic.ESTABLISHED && c.remoteIds.length==2 {
        if !configured { s.localIds.add(c.remoteIds[1]);s.nextLocalSequence=2 }
        for count in 0..200 { drive(c,s,now);now+=10 }
    }
    return Pair { client:c;server:s;now:now }
}
function preferredValidation(p: Pair, disabled: Boolean): Integer {
    if !ready(p) || !p.client.clientTLS.authenticated || !p.client.peerPreferred.valid { return 150 }
    let c=p.client;let s=p.server;let now=p.now;let original=crypto.hex(c.remote)
    let preferred=crypto.hex(c.peerPreferred.connectionId)
    if crypto.hex(c.peerPreferred.ipv4)!="c000022c" || c.peerPreferred.ipv4Port!=443 || c.peerPreferred.ipv6Port!=0 { return 151 }
    if !errors.booleanOk(quic.probePath(c,7,now)) {
        if disabled { print("semantic failure: disable_active_migration blocked authenticated preferred-address validation");return 152 }
        return 153
    }
    let observed=false
    for packet in quic.pollDatagrams(c,now) {
        if packet.pathId==7 {
            let header=wire.header(packet.data,0,c.local.length)
            if crypto.hex(header.destination)!=preferred || crypto.hex(header.destination)==original { return 154 }
            let plaintext=protection.unprotect(s.spaces[2].read,packet.data,header.numberOffset,s.spaces[2].largest)
            if !plaintext.valid { return 155 }
            for frame in wire.frames(plaintext.payload).frames { if frame.type!=0 && frame.type!=26 { return 156 } }
            observed=true
        }
        quic.receivePath(s,packet.data,packet.pathId,now)
    }
    if !observed || c.activePath!=0 { return 157 }
    for count in 0..300 { drive(c,s,now);now+=10 }
    if c.activePath!=7 || crypto.hex(c.remote)!=preferred || c.paths.length!=1 || c.state!=quic.ESTABLISHED || s.state!=quic.ESTABLISHED { return 158 }
    let opened=quic.openStream(c,false);if !errors.integerOk(opened) { return 159 }
    let id=errors.integerValue(opened);quic.writeStream(c,id,Bytes("validated preferred route"),true)
    for count in 0..300 { drive(c,s,now);now+=10 }
    let received=quic.readStream(s,id)
    if !errors.bytesOk(received) || Text(errors.bytesValue(received))!="validated preferred route" { return 160 }
    print("authenticated preferred CID carried only probes until exact-path validation, then authenticated stream traffic")
    return 0
}
function preferredFallback(p: Pair): Integer {
    let result=failedValidation(p);if result!=0 { return result }
    let c=p.client;let s=p.server;let now=max(c.now,s.now)
    let opened=quic.openStream(c,false);if !errors.integerOk(opened) { return 165 }
    let id=errors.integerValue(opened);quic.writeStream(c,id,Bytes("original route survives"),true)
    for count in 0..300 {
        for packet in quic.pollDatagrams(c,now) { if packet.pathId==0 { quic.receivePath(s,packet.data,0,now) } }
        for packet in quic.pollDatagrams(s,now) { quic.receivePath(c,packet.data,0,now) }
        now+=10
    }
    let received=quic.readStream(s,id)
    if !errors.bytesOk(received) || Text(errors.bytesValue(received))!="original route survives" || c.activePath!=0 { return 166 }
    print("failed preferred-address validation kept the authenticated original route usable")
    return 0
}
function responseRoutes(p: Pair): Integer {
    if !ready(p) { return 170 }
    let c=p.client;let s=p.server;let now=p.now
    if !errors.booleanOk(quic.probePath(c,7,now)) { return 171 }
    let response=Bytes();appendInteger(response,27);response.addBytes(c.paths[1].challenge)
    quic.receivePath(c,authenticatedFrame(s,c,c.local,response),0,now)
    if c.activePath!=0 || c.paths[1].validated { return 172 }
    let correct=authenticatedFrame(s,c,c.local,response)
    let later=authenticatedFrame(s,c,c.local,crypto.fromHex("0100000000"))
    quic.receivePath(c,later,0,now)
    quic.receivePath(c,correct,7,now)
    if c.activePath!=7 || c.paths.length!=1 { return 173 }
    quic.receivePath(c,correct,7,now)
    if c.activePath!=7 || c.paths.length!=1 || c.state!=quic.ESTABLISHED { return 174 }
    print("wrong-route response was ignored; reordered matching response validated once and its replay changed no path")
    return 0
}
function lateResponse(p: Pair): Integer {
    if !ready(p) { return 180 }
    let c=p.client;let s=p.server;let now=p.now
    if !errors.booleanOk(quic.probePath(c,7,now)) { return 181 }
    let response=Bytes();appendInteger(response,27);response.addBytes(c.paths[1].challenge)
    for count in 0..1000 {
        for packet in quic.pollDatagrams(c,now) { if packet.pathId==0 { quic.receivePath(s,packet.data,0,now) } }
        for packet in quic.pollDatagrams(s,now) { quic.receivePath(c,packet.data,0,now) };now+=10
    }
    let largest=c.spaces[2].largest
    quic.receivePath(c,authenticatedFrame(s,c,c.local,response),7,now)
    if c.paths.length!=1 || c.activePath!=0 || c.spaces[2].largest!=largest || c.state!=quic.ESTABLISHED { return 182 }
    print("late response to an expired challenge did not recreate a path or advance received packet state")
    return 0
}
function tokenReuse(p: Pair): Integer {
    if !ready(p) { return 190 }
    let c=p.client;let s=p.server;let token=c.remoteIds[1].token
    quic.receivePath(c,authenticatedFrame(s,c,c.local,newCid(2,1,randomBytes(8),token)),0,p.now)
    if c.state!=quic.FAILED || c.code!=10 {
        print("semantic failure: two live destination CIDs shared a stateless-reset token")
        return 192
    }
    print("distinct live CID sequences cannot reuse a stateless-reset token")
    return 0
}
function retirementBound(p: Pair): Integer {
    if !ready(p) { return 200 }
    let c=p.client;let s=p.server
    for sequence in 2..6 {
        quic.receivePath(c,authenticatedFrame(s,c,c.local,newCid(sequence,sequence,randomBytes(8),randomBytes(16))),0,p.now)
    }
    if c.state!=quic.FAILED || c.code!=9 || c.remoteRetireOutstanding.length>4 || c.retiredRemote.length>64 { return 201 }
    print("unacknowledged retirement state is bounded at twice the advertised active CID limit")
    return 0
}
function retiredDestination(p: Pair): Integer {
    if !ready(p) { return 210 }
    let old=p.server.local
    let result=intentionalMigration(p);if result!=0 { return result }
    let s=p.server;let largest=s.spaces[2].largest;let paths=s.paths.length
    if quic.ownsConnectionId(s,old) { return 211 }
    quic.receivePath(s,authenticatedFrame(p.client,s,old,crypto.fromHex("0100000000")),19,max(p.client.now,s.now))
    if s.spaces[2].largest!=largest || s.paths.length!=paths || s.state!=quic.ESTABLISHED { return 212 }
    print("authenticated packets addressed to a retired CID cannot allocate a path or advance packet state")
    return 0
}
function earlyRoutes(root: Bytes, identity: Bytes, key: Bytes, client: Bytes, clientKey: Bytes): Integer {
    let store=tickets.store(randomBytes(16),3600);tickets.allowEarlyData(store,0xffffffff)
    let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
    let s=quic.serverWithTickets(randomBytes(80),"minyar-test",c.originalDestination,[identity],key,[root],true,store)
    for tick in 0..300 { drive(c,s,tick*10) }
    let ticket=quic.takeTicket(c);if !ticket.valid { return 220 }
    let early=quic.clientEarly("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey,ticket)
    let peer=quic.serverWithTickets(randomBytes(80),"minyar-test",early.originalDestination,[identity],key,[root],true,store)
    if errors.booleanOk(quic.probePath(early,7,0)) || early.paths.length!=1 { return 221 }
    let opened=quic.openEarlyStream(early,false);if !errors.integerOk(opened) { return 222 }
    let id=errors.integerValue(opened);quic.writeEarlyStream(early,id,Bytes("replay-safe"),true)
    let destination=crypto.hex(early.originalDestination);let earlySeen=false
    for tick in 0..300 {
        for packet in quic.pollDatagrams(early,tick*10) {
            let header=wire.header(packet.data,0,early.local.length)
            if packet.pathId!=0 { return 223 }
            if header.kind==wire.ZERO_RTT { if crypto.hex(header.destination)!=destination { return 224 };earlySeen=true }
            quic.receivePath(peer,packet.data,0,tick*10)
        }
        for packet in quic.pollDatagrams(peer,tick*10) { quic.receivePath(early,packet.data,0,tick*10) }
    }
    if !earlySeen || !early.confirmed || !early.clientTLS.resumed || !early.clientTLS.earlyAccepted || early.activePath!=0 || peer.state!=quic.ESTABLISHED { return 225 }
    print("0-RTT used the original destination and route; intentional migration remained unavailable before confirmation")
    return 0
}

function repeatedMigration(p: Pair): Integer {
    if !ready(p) { return 230 }
    let c=p.client;let s=p.server;let now=p.now
    for cycle in 0..50 {
        let original=crypto.hex(c.remote);let route=cycle+1
        if !errors.booleanOk(quic.probePath(c,route,now)) { return 231 }
        for tick in 0..100 { drive(c,s,now);now+=10 }
        if c.activePath!=route || crypto.hex(c.remote)==original || c.paths.length!=1 || s.paths.length>2 ||
           c.state!=quic.ESTABLISHED || s.state!=quic.ESTABLISHED || c.remoteIds.length>2 || s.localIds.length>2 ||
           c.remoteRetireOutstanding.length!=0 || c.retiredRemote.length>64 { return 232 }
    }
    print("fifty sequential migrations acknowledged each retirement and retained bounded CID/path state")
    return 0
}
function cidRebound(p: Pair): Integer {
    if !ready(p) { return 240 }
    let c=p.client;let s=p.server;let known=c.remoteIds[1]
    quic.receivePath(c,authenticatedFrame(s,c,c.local,newCid(known.sequence,0,randomBytes(8),known.token)),0,p.now)
    if c.state!=quic.FAILED || c.code!=10 { return 241 }
    print("an authenticated sequence rebound to another CID is a protocol error")
    return 0
}

function reciprocalMigration(p: Pair): Integer {
    if !ready(p) { return 200 }
    let c=p.client;let peer=p.server;let original=crypto.hex(peer.remote);let now=p.now
    if !errors.booleanOk(quic.probePath(c,7,now)) { return 201 }
    for packet in quic.pollDatagrams(c,now) { quic.receivePath(peer,packet.data,packet.pathId,now) }
    let replies=0;let received=0;let sent=0
    for path in peer.paths { if path.id==7 { received=path.received } }
    for packet in quic.pollDatagrams(peer,now) {
        if packet.pathId==7 {
            let header=wire.header(packet.data,0,c.local.length)
            if !header.valid || !quic.ownsConnectionId(c,header.destination) { return 203 }
            if crypto.hex(header.destination)==original {
                print("semantic failure: server reused its original destination CID for an intentional peer path")
                return 202
            }
            let opened=protection.unprotect(c.spaces[2].read,packet.data,header.numberOffset,-1)
            if !opened.valid || packet.data.length>1200 { return 204 }
            replies+=1;sent+=packet.data.length
        }
        quic.receivePath(c,packet.data,packet.pathId,now)
    }
    if replies==0 || sent>received*3 { return 205 }
    for tick in 0..200 { drive(c,peer,now);now+=10 }
    if c.activePath!=7 || peer.activePath!=7 || c.paths.length!=1 || peer.paths.length!=1 ||
       c.state!=quic.ESTABLISHED || peer.state!=quic.ESTABLISHED || crypto.hex(peer.remote)==original ||
       c.remoteRetireOutstanding.length!=0 || peer.remoteRetireOutstanding.length!=0 { return 206 }
    print("intentional peer migration used distinct issued CIDs in both directions, validated both routes and acknowledged bounded retirements")
    return 0
}
function serverWithoutSpare(p: Pair): Integer {
    if !ready(p) { return 210 }
    let c=p.client;let peer=p.server;peer.remoteIds=[peer.remoteIds[0]]
    let original=crypto.hex(peer.remote);let paths=peer.paths.length;let largest=peer.spaces[2].largest
    if !errors.booleanOk(quic.probePath(c,7,p.now)) { return 211 }
    for packet in quic.pollDatagrams(c,p.now) { quic.receivePath(peer,packet.data,packet.pathId,p.now) }
    for packet in quic.pollDatagrams(peer,p.now) {
        if packet.pathId==7 {
            print("semantic failure: server replied to intentional migration without an unused destination CID")
            return 214
        }
    }
    if peer.paths.length!=paths || peer.activePath!=0 || crypto.hex(peer.remote)!=original ||
       peer.spaces[2].largest!=largest || peer.state!=quic.ESTABLISHED { return 215 }
    for tick in 0..800 { drive(c,peer,p.now+tick*10) }
    if c.activePath!=0 || peer.activePath!=0 || c.state!=quic.ESTABLISHED || peer.state!=quic.ESTABLISHED { return 216 }
    print("server CID exhaustion refused intentional new-path transmission and preserved the validated original route")
    return 0
}

function candidateAckWidth(p: Pair): Integer {
    if !ready(p) { return 243 }
    let c=p.client;let s=p.server;let first=s.spaces[2].next;let destination=randomBytes(20)
    // Isolate a legal peer-issued 20-byte spare while keeping the original
    // eight-byte active destination. Registry ownership agrees at both ends.
    let sequence=c.remoteIds[1].sequence;c.remoteIds[1].id=destination
    for known in s.localIds { if known.sequence==sequence { known.id=destination } }
    if !errors.booleanOk(quic.probePath(c,7,p.now)) { return 244 }
    for index in 0..256 {
        s.spaces[2].next=first+index*((1<<30)+2)
        quic.receivePath(c,authenticatedFrame(s,c,c.local,crypto.fromHex("0100000000")),7,p.now)
    }
    if c.spaces[2].ranges.length!=256 || c.activePath!=0 { return 246 }
    let acknowledgements=0;let challenges=0;let flight=0
    for packet in quic.pollDatagrams(c,p.now) {
        if packet.pathId!=7 { return 247 }
        let header=wire.header(packet.data,0,20)
        if !header.valid || header.numberOffset!=21 || crypto.hex(header.destination)!=crypto.hex(destination) { return 248 }
        let opened=protection.unprotect(s.spaces[2].read,packet.data,header.numberOffset,-1)
        if !opened.valid { return 249 }
        let parsed=wire.frames(opened.payload);if !parsed.valid { return 250 }
        let eliciting=false
        for frame in parsed.frames {
            if frame.type==2 { acknowledgements+=1 }
            if frame.type==26 { challenges+=1 }
            if frame.type!=0 && frame.type!=2 && frame.type!=3 && frame.type!=28 && frame.type!=29 { eliciting=true }
        }
        if eliciting { flight+=packet.data.length }
        if packet.data.length>1200 {
            print("semantic failure: candidate-path ACK used active CID width and exceeded the peer MTU")
            return 245
        }
    }
    if acknowledgements!=1 || challenges!=1 || c.flight!=flight || c.spaces[2].ack { return 251 }
    print("candidate-path ACK honored its issued twenty-byte CID, peer MTU and exact challenge flight accounting")
    return 0
}

function routeState(c: quic.Connection): Text {
    let space=c.spaces[2]
    let state=Text(c.activePath)+":"+Text(c.incomingPath)+":"+Text(c.receivedBytes)+":"+Text(c.flight)+":"+Text(c.lastActivity)
    state+=":"+Text(space.readGeneration)+":"+Text(space.writeGeneration)+":"+crypto.hex(space.read.secret)+":"+crypto.hex(space.write.secret)
    state+=":"+crypto.hex(space.nextRead.secret)+":"+crypto.hex(space.previousRead.secret)+":"+Text(space.readAcknowledged)
    state+=":"+Text(space.largest)+":"+Text(space.ack)+":"+Text(space.ackDeadline)+":"+Text(space.ackCount)+":"+Text(space.ackQueued)
    for range in space.ranges { state+=":"+Text(range.first)+"-"+Text(range.last) }
    for sent in space.sent { state+=":"+Text(sent.number)+":"+Text(sent.status)+":"+Text(sent.bytes)+":"+crypto.hex(sent.payload) }
    for sent in c.history { state+=":"+Text(sent.number)+":"+Text(sent.status)+":"+Text(sent.bytes)+":"+crypto.hex(sent.payload) }
    for pending in c.pending { state+=":"+Text(pending.level)+":"+Text(pending.path)+":"+crypto.hex(pending.payload) }
    for path in c.paths { state+=":"+Text(path.id)+":"+Text(path.validated)+":"+Text(path.eligible)+":"+crypto.hex(path.challenge)+":"+Text(path.remoteSequence)+":"+crypto.hex(path.remoteId)+":"+crypto.hex(path.localId)+":"+Text(path.received)+":"+Text(path.sent)+":"+Text(path.deadline)+":"+Text(path.attempts) }
    return state
}
function unknownServerRoute(p: Pair): Integer {
    if !ready(p) { return 250 }
    let c=p.client;let s=p.server;let largest=c.spaces[2].largest;let paths=c.paths.length
    let read=c.spaces[2].readGeneration;let write=c.spaces[2].writeGeneration;let pending=c.pending.length
    let before=routeState(c)
    if !errors.booleanOk(quic.updateKeys(s)) { return 251 }
    let packet=authenticatedFrame(s,c,c.local,crypto.fromHex("0100000000"))
    // RFC9000 section9: unknown server addresses are discarded, including
    // an authentic next-key-phase packet. No transport key state may advance.
    quic.receivePath(c,packet,19,c.now)
    if c.spaces[2].readGeneration!=read || c.spaces[2].writeGeneration!=write ||
       c.spaces[2].largest!=largest || c.paths.length!=paths || c.pending.length!=pending || routeState(c)!=before {
        print("semantic failure: discarded unknown server route changed packet or key-phase state")
        return 252
    }
    if quic.pollDatagrams(c,p.now).length!=0 || c.activePath!=0 { return 253 }
    // The identical authenticated packet on the known original route remains
    // admissible: discard did not consume its packet number or key generation.
    quic.receivePath(c,packet,0,p.now)
    if c.spaces[2].readGeneration!=read+1 || c.spaces[2].writeGeneration!=write+1 ||
       c.spaces[2].largest<=largest || c.activePath!=0 || c.state!=quic.ESTABLISHED { return 254 }
    print("unknown server route preserved packet and key-phase state; the same authenticated packet remained valid on the original route")
    return 0
}

// RFC9000 9.3.3: apparent NAT rebinding must also elicit the old route.
function previousPathProbe(p: Pair): Integer {
    if !ready(p) { return 220 }
    let c=p.client;let s=p.server;let payload=crypto.fromHex("01");payload.resize(1171)
    quic.receivePath(s,authenticatedFrame(c,s,c.remote,payload),7,p.now)
    if s.paths.length!=2 || s.activePath!=0 { return 221 }
    let old=Bytes();let candidate=Bytes();let oldCount=0;let newCount=0;let newBytes=0
    for packet in quic.pollDatagrams(s,p.now) {
        let header=wire.header(packet.data,0,c.local.length)
        if !header.valid || !quic.ownsConnectionId(c,header.destination) || packet.data.length>1200 { return 222 }
        let opened=protection.unprotect(c.spaces[2].read,packet.data,header.numberOffset,-1)
        if !opened.valid { return 223 }
        for frame in wire.frames(opened.payload).frames {
            if frame.type==26 {
                if packet.pathId==0 { old=frame.data;oldCount+=1 }
                else if packet.pathId==7 { candidate=frame.data;newCount+=1 }
                else { return 226 }
            }
        }
        if packet.pathId==7 { newBytes+=packet.data.length }
    }
    if oldCount!=1 || old.length!=8 {
        print("semantic failure: apparent migration did not challenge the previously active route")
        return 224
    }
    if newCount!=1 || candidate.length!=8 || crypto.hex(old)==crypto.hex(candidate) || newBytes>3600 { return 225 }
    if !s.paths[0].validated || s.activePath!=0 || s.state!=quic.ESTABLISHED { return 227 }
    print("apparent migration emitted distinct authenticated challenges on old and candidate routes within MTU and amplification bounds")
    return 0
}
function previousPathReturn(p: Pair): Integer {
    if !ready(p) { return 230 }
    let c=p.client;let s=p.server;let original=crypto.hex(s.remote);let payload=crypto.fromHex("01");payload.resize(1171)
    let reordered=authenticatedFrame(c,s,c.remote,payload)
    let forwarded=authenticatedFrame(c,s,c.remote,payload)
    quic.receivePath(s,forwarded,7,p.now)
    if s.paths.length!=2 || s.activePath!=0 { return 231 }
    let challenge=s.paths[1].challenge
    // A lower-numbered original packet is insufficient to reverse migration.
    quic.receivePath(s,reordered,0,p.now)
    if s.paths.length!=2 || s.paths[1].challenge.length!=8 { return 232 }
    quic.receivePath(s,authenticatedFrame(c,s,c.remote,payload),0,p.now)
    if s.paths.length!=1 || s.activePath!=0 {
        print("semantic failure: newer original-route packet retained the spurious migration candidate")
        return 234
    }
    if crypto.hex(s.remote)!=original || s.remoteRetireOutstanding.length!=0 || s.state!=quic.ESTABLISHED { return 235 }
    for pending in s.pending { if pending.path==7 { return 236 } }
    // A delayed response for abandoned validation cannot allocate a new route.
    let response=Bytes();appendInteger(response,27);response.addBytes(challenge)
    let late=authenticatedFrame(c,s,c.remote,response);let largest=s.spaces[2].largest
    quic.receivePath(s,late,7,p.now)
    quic.receivePath(s,late,7,p.now)
    if s.paths.length!=1 || s.activePath!=0 || s.spaces[2].largest!=largest { return 237 }
    print("newer original-route traffic abandoned spurious validation; reordered and delayed duplicate responses changed no route")
    return 0
}
function previousPathTimeout(p: Pair): Integer {
    if !ready(p) { return 238 }
    let c=p.client;let s=p.server;let original=crypto.hex(s.remote);let payload=crypto.fromHex("01");payload.resize(1171)
    quic.receivePath(s,authenticatedFrame(c,s,c.remote,payload),7,p.now)
    // Both validation responses are dropped; previously validated route survives.
    for tick in 0..1000 { quic.pollDatagrams(s,p.now+tick*10) }
    if s.paths.length!=1 || s.activePath!=0 || !s.paths[0].validated || crypto.hex(s.remote)!=original ||
       s.paths[0].challenge.length!=0 || s.paths[0].deadline!=-1 || s.state!=quic.ESTABLISHED ||
       s.remoteRetireOutstanding.length!=0 { return 239 }
    let now=p.now+10000
    let opened=quic.openStream(c,false);if !errors.integerOk(opened) { return 240 }
    let id=errors.integerValue(opened);quic.writeStream(c,id,Bytes("old route remains usable"),true)
    for tick in 0..300 { drive(c,s,now);now+=10 }
    let read=quic.readStream(s,id)
    if !errors.bytesOk(read) || Text(errors.bytesValue(read))!="old route remains usable" || s.activePath!=0 { return 241 }
    print("expired old and candidate validation retained the validated original route without a live challenge or retired shared CID")
    return 0
}

function validationResponseOrder(p: Pair, firstChallenge: Boolean): Integer {
    if !ready(p) || !errors.booleanOk(quic.probePath(p.client,7,p.now)) { return 243 }
    let c=p.client;let s=p.server
    for packet in quic.pollDatagrams(c,p.now) { quic.receivePath(s,packet.data,packet.pathId,p.now) }
    let oldProbes=0;let candidateProbes=0;let responses=0;let candidateBytes=0;let firstCandidate=true
    for packet in quic.pollDatagrams(s,p.now) {
        let header=wire.header(packet.data,0,c.local.length)
        if !header.valid || !quic.ownsConnectionId(c,header.destination) || packet.data.length>1200 { return 244 }
        let opened=protection.unprotect(c.spaces[2].read,packet.data,header.numberOffset,-1)
        if !opened.valid { return 245 }
        if packet.pathId==7 && firstCandidate {
            let challenged=false
            for frame in wire.frames(opened.payload).frames { if frame.type==26 { challenged=true } }
            if firstChallenge && !challenged {
                print("semantic failure: first candidate response omitted its path challenge")
                return 248
            }
            firstCandidate=false
        }
        for frame in wire.frames(opened.payload).frames {
            if frame.type==26 {
                if packet.pathId==0 { oldProbes+=1 }
                else if packet.pathId==7 { candidateProbes+=1 }
                else { return 246 }
            }
            if frame.type==27 && packet.pathId==7 { responses+=1 }
        }
        if packet.pathId==7 { candidateBytes+=packet.data.length }
        // The old-route challenge is delivered on the original route.
        quic.receivePath(c,packet.data,packet.pathId,p.now)
    }
    if c.activePath!=7 || responses!=1 {
        print("semantic failure: old-route revalidation deferred the admitted candidate response")
        return 242
    }
    if oldProbes!=1 || candidateProbes!=1 || candidateBytes>3600 || c.state!=quic.ESTABLISHED { return 247 }
    print("candidate response preceded padded validation probes without changing exact routes, MTU or amplification bounds")
    return 0
}

// RFC9000 9.4: old-route packets keep delivery records but cannot
// update the RTT or congestion controller established for another route.
record RecoveryPair { pair: Pair; streamId: Integer; oldNumber: Integer; oldBytes: Integer; newProbe: Integer; latestWire: Integer; newBytes: Integer; now: Integer }
function recoveryPair(p: Pair): RecoveryPair {
    let c=p.client;let s=p.server;let now=p.now;let id=-1;let old=-1;let bytes=0;let probe=-1;let newBytes=0
    if ready(p) {
        let opened=quic.openStream(s,true)
        if errors.integerOk(opened) {
            id=errors.integerValue(opened);old=s.spaces[2].next
            quic.writeStream(s,id,Bytes("old-route delivery survives migration"),true)
            for packet in quic.pollDatagrams(s,now) { bytes+=packet.data.length }
        }
        now+=10
        if errors.booleanOk(quic.probePath(c,7,now)) {
            for packet in quic.pollDatagrams(c,now) { quic.receivePath(s,packet.data,packet.pathId,now) }
            for packet in quic.pollDatagrams(s,now) {
                if packet.pathId==7 {
                    newBytes+=packet.data.length
                    let header=wire.header(packet.data,0,c.local.length)
                    let opened=protection.unprotect(c.spaces[2].read,packet.data,header.numberOffset,-1)
                    if opened.valid { probe=opened.number }
                }
                // Retain every real old/new validation send without ACKing it.
            }
            let clientPath=-1;let serverPath=-1
            for at in 0..c.paths.length { if c.paths[at].id==7 { clientPath=at } }
            for at in 0..s.paths.length { if s.paths[at].id==7 { serverPath=at } }
            if clientPath>=0 && serverPath>=0 {
                let reply=Bytes();appendInteger(reply,27);reply.addBytes(c.paths[clientPath].challenge)
                quic.receivePath(c,authenticatedFrame(s,c,s.paths[serverPath].remoteId,reply),7,now+1)
                reply=Bytes();appendInteger(reply,27);reply.addBytes(s.paths[serverPath].challenge);appendInteger(reply,1)
                quic.receivePath(s,authenticatedFrame(c,s,c.remote,reply),7,now+2)
            }
        }
    }
    return RecoveryPair { pair:p;streamId:id;oldNumber:old;oldBytes:bytes;newProbe:probe;latestWire:s.spaces[2].next-1;newBytes:newBytes;now:now+2 }
}
function recoveryReady(r: RecoveryPair): Boolean {
    return r.streamId>=0 && r.oldNumber>=0 && r.oldBytes>0 && r.newProbe>r.oldNumber &&
        r.pair.client.activePath==7 && r.pair.server.activePath==7 &&
        r.pair.client.state==quic.ESTABLISHED && r.pair.server.state==quic.ESTABLISHED
}
function acknowledgePacket(c: quic.Connection, s: quic.Connection, first: Integer, last: Integer, now: Integer) {
    let payload=Bytes();appendInteger(payload,2);appendInteger(payload,last);appendInteger(payload,0)
    appendInteger(payload,0);appendInteger(payload,last-first)
    quic.receivePath(s,authenticatedFrame(c,s,c.remote,payload),s.activePath,now)
}
function exactFlight(c: quic.Connection): Integer { let bytes=0;for space in c.spaces { for sent in space.sent { bytes+=sent.bytes } };return bytes }
function reuseRecoveryRoute(r: RecoveryPair) {
    let c=r.pair.client;let s=r.pair.server;let now=r.now+10
    // Authenticated retirement makes each issuer supply a fresh spare CID.
    let retire=Bytes();appendInteger(retire,25);appendInteger(retire,0)
    quic.receivePath(s,authenticatedFrame(c,s,c.remote,retire),7,now)
    quic.receivePath(c,authenticatedFrame(s,c,s.remote,retire),7,now)
    for known in s.localIds { if known.sequence==2 { quic.receivePath(c,authenticatedFrame(s,c,s.remote,newCid(2,0,known.id,known.token)),7,now) } }
    for known in c.localIds { if known.sequence==2 { quic.receivePath(s,authenticatedFrame(c,s,c.remote,newCid(2,0,known.id,known.token)),7,now) } }
    if !errors.booleanOk(quic.probePath(c,0,now)) { r.streamId=-1;return }
    for packet in quic.pollDatagrams(c,now) {
        if packet.pathId==0 {
            let header=wire.header(packet.data,0,s.local.length)
            let opened=protection.unprotect(s.spaces[2].read,packet.data,header.numberOffset,-1)
            // Drop ACKs and unrelated control traffic to keep epoch-0 sends
            // genuinely outstanding while validating another use of route 0.
            if opened.valid { for frame in wire.frames(opened.payload).frames { if frame.type==26 {
                let payload=Bytes();appendInteger(payload,26);payload.addBytes(frame.data)
                quic.receivePath(s,authenticatedFrame(c,s,header.destination,payload),0,now)
            } } }
        }
    }
    r.newProbe=-1;r.newBytes=0
    for packet in quic.pollDatagrams(s,now) {
        if packet.pathId==0 {
            let header=wire.header(packet.data,0,c.local.length)
            let opened=protection.unprotect(c.spaces[2].read,packet.data,header.numberOffset,-1)
            if opened.valid { r.newProbe=opened.number;r.newBytes+=packet.data.length }
        }
    }
    let cp=-1;let sp=-1
    for at in 0..c.paths.length { if c.paths[at].id==0 { cp=at } }
    for at in 0..s.paths.length { if s.paths[at].id==0 { sp=at } }
    if cp<0 || sp<0 { r.streamId=-1;return }
    let reply=Bytes();appendInteger(reply,27);reply.addBytes(c.paths[cp].challenge)
    quic.receivePath(c,authenticatedFrame(s,c,s.paths[sp].remoteId,reply),0,now+1)
    reply=Bytes();appendInteger(reply,27);reply.addBytes(s.paths[sp].challenge);appendInteger(reply,1)
    quic.receivePath(s,authenticatedFrame(c,s,c.remote,reply),0,now+2)
    r.latestWire=s.spaces[2].next-1;r.now=now+2
}
function reusedRecoveryReady(r: RecoveryPair): Boolean {
    return r.streamId>=0 && r.newProbe>r.oldNumber && r.pair.client.activePath==0 && r.pair.server.activePath==0 &&
        r.pair.client.state==quic.ESTABLISHED && r.pair.server.state==quic.ESTABLISHED
}
function mixedRecoveryAck(p: Pair): Integer {
    let r=recoveryPair(p);if !recoveryReady(r) { return 153 };reuseRecoveryRoute(r)
    if !reusedRecoveryReady(r) { return 153 }
    let c=p.client;let s=p.server;let opened=quic.openStream(s,true);if !errors.integerOk(opened) { return 153 }
    let id=errors.integerValue(opened);let expected=Bytes("current-route delivery")
    quic.writeStream(s,id,expected,true);let at=r.now+30;let bytes=r.newBytes;let sent=false
    for packet in quic.pollDatagrams(s,at) {
        if packet.pathId!=0 { return 171 }
        let header=wire.header(packet.data,0,c.local.length)
        let decoded=protection.unprotect(c.spaces[2].read,packet.data,header.numberOffset,-1);let eliciting=false
        if decoded.valid { for frame in wire.frames(decoded.payload).frames { if frame.type!=0 && frame.type!=2 && frame.type!=3 && frame.type!=28 && frame.type!=29 { eliciting=true } } }
        if eliciting { bytes+=packet.data.length;sent=true }
    }
    if !sent { return 153 }
    acknowledgePacket(c,s,r.oldNumber,s.spaces[2].next-1,at+20)
    if s.congestion.window!=12000+bytes { print("semantic failure: mixed ACK ranges counted an earlier route epoch in the current window");return 170 }
    if !s.congestion.measured || s.congestion.latest!=20 || s.flight!=0 || exactFlight(s)!=0 { return 172 }
    let oldDelivered=false;let newDelivered=false
    for output in s.streams {
        if output.id==r.streamId { oldDelivered=output.sendAcknowledged==Bytes("old-route delivery survives migration").length && output.finalAcknowledged }
        if output.id==id { newDelivered=output.sendAcknowledged==expected.length && output.finalAcknowledged }
    }
    if !oldDelivered || !newDelivered || s.remoteRetireOutstanding.length!=0 { return 173 }
    print("mixed ACK ranges delivered both epochs and retired their control state while counting only the current route epoch")
    return 0
}
function oldPathAck(p: Pair, reuse: Boolean): Integer {
    let r=recoveryPair(p);if !recoveryReady(r) { print("setup failed: real old send and reciprocal migration absent");return 153 }
    if reuse { reuseRecoveryRoute(r);if !reusedRecoveryReady(r) { return 153 } }
    let s=p.server;let state=s.congestion;let window=state.window;let latest=state.latest;let smoothed=state.smoothed
    let variance=state.variance;let minimum=state.minimum;let measured=state.measured;let flight=s.flight
    acknowledgePacket(p.client,s,r.oldNumber,r.oldNumber,r.now+20)
    if s.congestion.latest!=latest || s.congestion.smoothed!=smoothed || s.congestion.variance!=variance ||
       s.congestion.minimum!=minimum || s.congestion.measured!=measured {
        print("semantic failure: delayed old-route ACK sampled the new route RTT");return 155
    }
    if s.congestion.window!=window { print("semantic failure: delayed old-route ACK grew the new route congestion window");return 156 }
    let delivered=false
    for output in s.streams { if output.id==r.streamId { delivered=output.sendAcknowledged==Bytes("old-route delivery survives migration").length && output.finalAcknowledged } }
    if !delivered || s.spaces[2].largestAck!=r.oldNumber || s.flight!=flight-r.oldBytes || s.flight!=exactFlight(s) { return 158 }
    let pending=s.pending.length;let retire=s.remoteRetireOutstanding.length;let remaining=s.spaces[2].sent.length
    acknowledgePacket(p.client,s,r.oldNumber,r.oldNumber,r.now+21)
    if s.congestion.window!=window || s.congestion.latest!=latest || s.flight!=flight-r.oldBytes ||
       s.pending.length!=pending || s.remoteRetireOutstanding.length!=retire || s.spaces[2].sent.length!=remaining { return 159 }
    print("old-route ACK and duplicate retained stream/flight/range/retirement bookkeeping without changing new-route RTT or congestion")
    return 0
}
function oldPathLoss(p: Pair, reuse: Boolean): Integer {
    let r=recoveryPair(p);if !recoveryReady(r) { return 153 }
    if reuse { reuseRecoveryRoute(r);if !reusedRecoveryReady(r) { return 153 } }
    let c=p.client;let s=p.server
    // ACK all real new-route validation packets, leaving only old-route sends.
    acknowledgePacket(c,s,r.newProbe,r.latestWire,r.now+20)
    let window=s.congestion.window;let latest=s.congestion.latest;let smoothed=s.congestion.smoothed;let variance=s.congestion.variance
    let retransmitted=false
    for packet in quic.pollDatagrams(s,r.now+2000) {
        let header=wire.header(packet.data,0,c.local.length)
        let opened=protection.unprotect(c.spaces[2].read,packet.data,header.numberOffset,-1)
        if opened.valid {
            for frame in wire.frames(opened.payload).frames {
                if frame.type>=8 && frame.type<=15 && frame.stream==r.streamId {
                    if packet.pathId!=s.activePath { return 160 };retransmitted=true
                }
            }
        }
        quic.receivePath(c,packet.data,packet.pathId,r.now+2000)
    }
    if s.congestion.window!=window { print("semantic failure: old-route loss reduced the new route congestion window");return 157 }
    if s.congestion.latest!=latest || s.congestion.smoothed!=smoothed || s.congestion.variance!=variance || s.flight!=exactFlight(s) { return 161 }
    if !retransmitted { print("old-route loss discarded stream data instead of retrying on the active route");return 162 }
    let read=quic.readStream(c,r.streamId)
    if !errors.bytesOk(read) || Text(errors.bytesValue(read))!="old-route delivery survives migration" { return 163 }
    let now=r.now+2010;for count in 0..100 { drive(c,s,now);now+=10 }
    let delivered=false;for output in s.streams { if output.id==r.streamId { delivered=output.sendAcknowledged==Bytes("old-route delivery survives migration").length && output.finalAcknowledged } }
    // A fully ACKed unidirectional stream is reclaimed by poll(); its
    // closed-stream ledger is the authoritative final-delivery record.
    for range in s.closedStreams { if range.kind==(r.streamId&3) && r.streamId/4>=range.first && r.streamId/4<=range.last { delivered=true } }
    if !delivered || s.flight!=exactFlight(s) || s.state!=quic.ESTABLISHED || c.state!=quic.ESTABLISHED { return 164 }
    print("old-route loss preserved new-route congestion and retried undelivered stream data on the validated route")
    return 0
}
function oldPathLateAck(p: Pair, reuse: Boolean): Integer {
    let r=recoveryPair(p);if !recoveryReady(r) { return 153 }
    if reuse { reuseRecoveryRoute(r);if !reusedRecoveryReady(r) { return 153 } }
    let c=p.client;let s=p.server
    acknowledgePacket(c,s,r.newProbe,r.latestWire,r.now+20)
    // Old data is lost, retransmitted on the current route, and dropped.
    quic.pollDatagrams(s,r.now+2000)
    let retained=false
    for at in s.spaces[2].lostStreamsAt..s.spaces[2].lostStreams.length { if s.spaces[2].lostStreams[at].number==r.oldNumber { retained=true } }
    let timer=s.spaces[2].probe
    if !retained || timer<=r.now+2000 { return 175 }
    quic.pollDatagrams(s,timer)
    let probes=s.congestion.probes;let window=s.congestion.window;let latest=s.congestion.latest;let flight=s.flight
    if probes<=0 { return 176 }
    acknowledgePacket(c,s,r.oldNumber,r.oldNumber,timer+10)
    if s.congestion.probes!=probes { print("semantic failure: late old-epoch delivery ACK reset the current route PTO backoff");return 174 }
    if s.congestion.window!=window || s.congestion.latest!=latest || s.flight!=flight || s.flight!=exactFlight(s) { return 177 }
    let delivered=false
    for output in s.streams { if output.id==r.streamId { delivered=output.sendAcknowledged==Bytes("old-route delivery survives migration").length && output.finalAcknowledged } }
    if !delivered || s.spaces[2].lostReferences!=0 || s.state!=quic.ESTABLISHED { return 178 }
    print("late old-epoch ACK delivered cached ranges while preserving current-route RTT/window/PTO and exact outstanding bytes")
    return 0
}
function currentPathRecovery(p: Pair, lose: Boolean): Integer {
    let r=recoveryPair(p);if !recoveryReady(r) { return 153 }
    let c=p.client;let s=p.server
    acknowledgePacket(c,s,0,r.latestWire,r.now+20)
    let at=r.now+30;let number=s.spaces[2].next;quic.ping(s)
    let sent=false
    for packet in quic.pollDatagrams(s,at) { if packet.pathId!=7 { return 165 };sent=true }
    if !sent { return 166 }
    let window=s.congestion.window
    if lose {
        for count in 0..3 {
            quic.ping(s);let emitted=false
            for packet in quic.pollDatagrams(s,at+count+1) { if packet.pathId==7 { emitted=true } }
            if !emitted { return 166 }
        }
        acknowledgePacket(c,s,s.spaces[2].next-1,s.spaces[2].next-1,at+20)
        quic.pollDatagrams(s,at+2000)
        if s.congestion.window>=window || s.congestion.window<2400 { return 167 }
    } else {
        acknowledgePacket(c,s,number,number,at+20)
        if !s.congestion.measured || s.congestion.latest!=20 || s.congestion.window<=window { return 168 }
    }
    if s.flight!=exactFlight(s) || s.state!=quic.ESTABLISHED { return 169 }
    print("current-route ACK/loss still updates its own RTT/congestion with exact flight accounting")
    return 0
}

// Probing on a retained NAT fallback does not itself request migration.
record RetainedRecovery { pair: Pair; newProbe: Integer; deadline: Integer; now: Integer }
function retainedRecovery(p: Pair): RetainedRecovery {
    let c=p.client;let s=p.server;let probe=-1;let deadline=-1
    if ready(p) {
        let payload=crypto.fromHex("01");payload.resize(1171)
        quic.receivePath(s,authenticatedFrame(c,s,c.remote,payload),7,p.now)
        for packet in quic.pollDatagrams(s,p.now) {
            let header=wire.header(packet.data,0,c.local.length)
            let opened=protection.unprotect(c.spaces[2].read,packet.data,header.numberOffset,-1)
            if packet.pathId==7 && opened.valid { probe=opened.number }
        }
        let at=-1
        for index in 0..s.paths.length {
            if s.paths[index].id==7 { at=index }
            if s.paths[index].id==0 { deadline=s.paths[index].deadline }
        }
        if at>=0 {
            let reply=Bytes();appendInteger(reply,27);reply.addBytes(s.paths[at].challenge)
            quic.receivePath(s,authenticatedFrame(c,s,c.remote,reply),7,p.now+1)
        }
    }
    return RetainedRecovery { pair:p;newProbe:probe;deadline:deadline;now:p.now+1 }
}
function retainedReady(r: RetainedRecovery): Boolean {
    return r.newProbe>=0 && r.deadline>r.now+20 && r.pair.server.activePath==7 &&
        r.pair.server.paths.length==2 && r.pair.server.state==quic.ESTABLISHED
}
function retainedOldTraffic(p: Pair, probing: Boolean): Integer {
    let r=retainedRecovery(p);if !retainedReady(r) { return 183 }
    let c=p.client;let s=p.server;let payload=Bytes()
    if probing { appendInteger(payload,26);payload.addBytes(randomBytes(8)) }
    else { appendInteger(payload,1) }
    quic.receivePath(s,authenticatedFrame(c,s,c.remote,payload),0,r.now+1)
    if probing && s.activePath!=7 {
        print("semantic failure: probing-only retained old-route packet changed the active route");return 181
    }
    if !probing && s.activePath!=0 { return 184 }
    if s.state!=quic.ESTABLISHED || s.flight!=exactFlight(s) { return 185 }
    print("retained old-route probing preserved the active route; ordinary authenticated traffic can return to the old route")
    return 0
}

record OldValidationSends { retained: RetainedRecovery; currentNumber: Integer; currentAt: Integer; highOldNumber: Integer; alarm: Integer; now: Integer }
function oldValidationSends(p: Pair): OldValidationSends {
    let r=retainedRecovery(p);let c=p.client;let s=p.server;let number=-1;let high=-1;let alarm=-1;let at=r.deadline-10;let now=r.deadline
    if retainedReady(r) {
        acknowledgePacket(c,s,r.newProbe,r.newProbe,at-1)
        number=s.spaces[2].next;quic.ping(s)
        let emitted=false
        for packet in quic.pollDatagrams(s,at) { if packet.pathId==7 { emitted=true } }
        if !emitted { number=-1 }
        alarm=s.spaces[2].probe
        for count in 0..3 {
            let payload=Bytes();appendInteger(payload,26);payload.addBytes(randomBytes(8))
            quic.receivePath(s,authenticatedFrame(c,s,c.remote,payload),0,at+1)
        }
        for count in 0..7 {
            now=r.deadline+count*2
            for packet in quic.pollDatagrams(s,now) {
                let header=wire.header(packet.data,0,c.local.length)
                let opened=protection.unprotect(c.spaces[2].read,packet.data,header.numberOffset,-1)
                if opened.valid && packet.pathId==0 { high=max(high,opened.number) }
            }
        }
    }
    return OldValidationSends { retained:r;currentNumber:number;currentAt:at;highOldNumber:high;alarm:alarm;now:now }
}
function oldValidationReady(v: OldValidationSends): Boolean {
    let s=v.retained.pair.server;let outstanding=false
    for sent in s.spaces[2].sent { if sent.number==v.currentNumber && sent.path==7 { outstanding=true } }
    if !outstanding || v.highOldNumber<v.currentNumber+3 || s.activePath!=7 || !s.congestion.measured ||
       v.now-v.currentAt>=recovery.lossDelay(s.congestion) { return false }
    return true
}
function oldValidationRecovery(p: Pair, mode: Text): Integer {
    let v=oldValidationSends(p);let c=p.client;let s=p.server
    if !oldValidationReady(v) { return 186 }
    let window=s.congestion.window;let latest=s.congestion.latest
    if mode=="current-route-alarm" {
        let sent=false;quic.ping(s)
        for packet in quic.pollDatagrams(s,v.now+1) { if packet.pathId==7 { sent=true } }
        if !sent || s.spaces[2].probe!=v.now+1+recovery.pto(s.congestion,true) ||
           s.spaces[2].probe<=v.alarm { return 191 }
    } else if mode=="old-route-alarm" {
        if s.spaces[2].probe!=v.alarm {
            print("semantic failure: retained old-route validation sends postponed the current route PTO");return 180
        }
    } else {
        acknowledgePacket(c,s,v.highOldNumber,v.highOldNumber,v.now)
        if mode=="old-high-ack" {
            quic.pollDatagrams(s,v.now)
            let outstanding=false
            for sent in s.spaces[2].sent { if sent.number==v.currentNumber { outstanding=true } }
            if !outstanding || s.congestion.window!=window {
                print("semantic failure: old-route high packet ACK triggered loss on the current route");return 179
            }
        } else {
            acknowledgePacket(c,s,v.currentNumber,v.currentNumber,v.now+1)
            if s.congestion.latest!=v.now+1-v.currentAt {
                print("semantic failure: old-route high packet ACK suppressed a later current-route RTT sample");return 182
            }
        }
    }
    if s.flight!=exactFlight(s) || s.state!=quic.ESTABLISHED { return 187 }
    print("old-route validation ACKs and sends preserved current-route loss, RTT and PTO authority with exact flight")
    return 0
}
function currentPacketThreshold(p: Pair): Integer {
    let r=retainedRecovery(p);if !retainedReady(r) { return 183 }
    let c=p.client;let s=p.server
    acknowledgePacket(c,s,r.newProbe,r.newProbe,r.now+30)
    let first=-1;let last=-1;let sentAt=r.now+31
    for count in 0..4 {
        let number=s.spaces[2].next;let emitted=false;quic.ping(s)
        for packet in quic.pollDatagrams(s,sentAt+count) { if packet.pathId==7 { emitted=true } }
        if !emitted { return 188 }
        if count==0 { first=number };last=number
    }
    let now=sentAt+4
    if last<first+3 || now-sentAt>=recovery.lossDelay(s.congestion) { return 189 }
    acknowledgePacket(c,s,last,last,now)
    let window=s.congestion.window
    quic.pollDatagrams(s,now)
    let retained=false
    for sent in s.spaces[2].sent { if sent.number==first { retained=true } }
    if retained || s.congestion.window>=window || s.congestion.window<2400 || s.flight!=exactFlight(s) { return 190 }
    print("three real current-route packets triggered packet-threshold loss before the time threshold")
    return 0
}

// Bounded inventory tests use real authenticated packets and actual poll wire
// output. They neither call a refill helper nor inspect a proposed use scalar.
record StockId { sequence: Integer; id: Bytes; token: Bytes; prior: Integer }
record CidStock {
    subject: quic.Connection; peer: quic.Connection; now: Integer; limit: Integer
    observed: List<StockId>; wireFrames: Integer; packets: Integer; baselineNumber: Integer; valid: Boolean
}
function stockId(c: quic.Connection, sequence: Integer): Bytes {
    for known in c.localIds { if known.sequence==sequence { return known.id } }
    return Bytes()
}
function stockSignature(c: quic.Connection): Text {
    let value=Text(c.nextLocalSequence)+":"+Text(c.connectionIdVersion)
    for known in c.localIds { value += ":"+Text(known.sequence)+":"+crypto.hex(known.id)+":"+crypto.hex(known.token) }
    return value
}
function stockReceived(c: quic.Connection, number: Integer): Boolean {
    for range in c.spaces[2].ranges { if number>=range.first && number<=range.last { return true } }
    return false
}
function stockRecord(st: CidStock, data: Bytes): Boolean {
    let header=wire.header(data,0,st.peer.local.length)
    if !header.valid { return false }
    if header.kind!=wire.ONE_RTT { return true }
    let opened=protection.unprotect(st.peer.spaces[2].read,data,header.numberOffset,-1)
    if !opened.valid { return false }
    let parsed=wire.frames(opened.payload);if !parsed.valid { return false }
    st.packets+=1
    for frame in parsed.frames { if frame.type==24 {
        st.wireFrames+=1
        if frame.data.length<17 { return false }
        let id=frame.data.slice(0,frame.data.length-16);let token=frame.data.slice(frame.data.length-16,frame.data.length)
        let prior=-1;let existing=-1;let owned=false
        for known in st.subject.localIds {
            if prior<0 || known.sequence<prior { prior=known.sequence }
            if known.sequence==frame.value && crypto.hex(known.id)==crypto.hex(id) && crypto.hex(known.token)==crypto.hex(token) { owned=true }
        }
        for index in 0..st.observed.length { if st.observed[index].sequence==frame.value { existing=index } }
        if existing>=0 {
            let previous=st.observed[existing]
            if crypto.hex(previous.id)!=crypto.hex(id) || crypto.hex(previous.token)!=crypto.hex(token) || previous.prior!=frame.offset { return false }
        } else {
            if !owned || frame.value!=st.observed.length || frame.offset!=prior { return false }
            for known in st.observed { if crypto.hex(known.id)==crypto.hex(id) || (known.token.length==16 && crypto.hex(known.token)==crypto.hex(token)) { return false } }
            st.observed.add(StockId { sequence:frame.value;id:id;token:token;prior:frame.offset })
            if frame.value==1 { st.baselineNumber=opened.number }
        }
    } }
    return true
}
function stockAck(st: CidStock, number: Integer) {
    let payload=Bytes();appendInteger(payload,2);appendInteger(payload,number)
    appendInteger(payload,0);appendInteger(payload,0);appendInteger(payload,0)
    st.now+=1
    let packet=authenticatedFrame(st.peer,st.subject,st.subject.localIds[0].id,payload)
    let header=wire.header(packet,0,st.subject.local.length)
    let decoded=protection.unprotect(st.subject.spaces[2].read,packet,header.numberOffset,-1)
    let parsed=wire.frames(decoded.payload)
    if !decoded.valid || !parsed.valid || parsed.frames.length!=1 || parsed.frames[0].type!=2 || parsed.frames[0].value!=number { st.valid=false;return }
    quic.receivePath(st.subject,packet,0,st.now)
    if !stockReceived(st.subject,decoded.number) { st.valid=false }
}
function stockDrain(st: CidStock): Boolean {
    // Thirty-two bounded polls allow normal pacing, and ACK actual packet
    // numbers. The independent peer never runs its two-CID receive policy
    // against the larger inventory advertised by this synthetic fixture.
    if !st.valid { return false }
    for turn in 0..32 {
        st.now+=10
        for packet in quic.pollDatagrams(st.subject,st.now) {
            let header=wire.header(packet.data,0,st.peer.local.length)
            if !header.valid || header.kind!=wire.ONE_RTT || !stockRecord(st,packet.data) { st.valid=false;return false }
            let opened=protection.unprotect(st.peer.spaces[2].read,packet.data,header.numberOffset,-1)
            let parsed=wire.frames(opened.payload);let eliciting=false
            for frame in parsed.frames { if frame.type!=0 && frame.type!=2 && frame.type!=3 && frame.type!=28 && frame.type!=29 { eliciting=true } }
            if eliciting && st.subject.state==quic.ESTABLISHED { stockAck(st,opened.number);if !st.valid { return false } }
        }
    }
    return true
}
function stockParameters(data: Bytes, fromServer: Boolean, limit: Integer): Bytes {
    let parsed=wire.parameters(data,fromServer);let result=Bytes();let replacements=0
    if !parsed.valid { return result }
    for parameter in parsed.parameters {
        let value=parameter.value
        if parameter.id==14 { value=errors.bytesValue(wire.encode(limit));replacements+=1 }
        appendInteger(result,parameter.id);appendInteger(result,value.length);result.addBytes(value)
    }
    if replacements!=1 { return Bytes() }
    return result
}
function stockPair(root: Bytes, identity: Bytes, key: Bytes, client: Bytes, clientKey: Bytes, limit: Integer, serverSubject: Boolean): CidStock {
    let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
    let s=quic.server(randomBytes(80),"minyar-test",c.originalDestination,[identity],key,[root],true)
    let subject=c;let peer=s
    if serverSubject { subject=s;peer=c }
    let st=CidStock { subject:subject;peer:peer;now:0;limit:limit;observed:[StockId { sequence:0;id:subject.local;token:Bytes();prior:0 }];wireFrames:0;packets:0;baselineNumber:-1;valid:true }
    if serverSubject {
        c.clientTLS.transportParameters=stockParameters(c.clientTLS.transportParameters,false,limit)
        if c.clientTLS.transportParameters.length==0 || !errors.booleanOk(quic.setCipherSuites(c,c.clientTLS.allowedSuites)) { st.valid=false;return st }
    } else {
        s.serverTLS.transportParameters=stockParameters(s.serverTLS.transportParameters,true,limit)
        if s.serverTLS.transportParameters.length==0 { st.valid=false;return st }
    }
    // Observe actual baseline NEW_CONNECTION_ID frames while the ordinary
    // peer still processes/ACKs the initial two IDs during authenticated setup.
    for tick in 0..200 {
        for packet in quic.pollDatagrams(c,st.now) {
            if !serverSubject && !stockRecord(st,packet.data) { st.valid=false;return st }
            quic.receivePath(s,packet.data,packet.pathId,st.now)
        }
        for packet in quic.pollDatagrams(s,st.now) {
            if serverSubject && !stockRecord(st,packet.data) { st.valid=false;return st }
            quic.receivePath(c,packet.data,packet.pathId,st.now)
        }
        st.now+=10
    }
    if c.state!=quic.ESTABLISHED || s.state!=quic.ESTABLISHED || !c.confirmed || !s.confirmed ||
       !c.clientTLS.authenticated || !s.serverTLS.authenticated || !subject.parametersChecked || subject.peerIdLimit!=limit ||
       subject.localIds.length!=2 || subject.nextLocalSequence!=2 || peer.remoteIds.length!=2 || st.observed.length!=2 || st.wireFrames<1 || st.baselineNumber<0 {
        st.valid=false;return st
    }
    stockAck(st,st.baselineNumber)
    if !stockDrain(st) || subject.spaces[2].sent.length!=0 { st.valid=false;return st }
    for pending in subject.pending { for frame in wire.frames(pending.payload).frames { if frame.type==24 { st.valid=false;return st } } }
    print("inventory setup authenticated both roles; peer limit "+Text(limit)+"; baseline wire IDs 0,1 drained and acknowledged")
    return st
}
function stockReceive(st: CidStock, destination: Bytes, payload: Bytes): Bytes {
    st.now+=1
    let packet=authenticatedFrame(st.peer,st.subject,destination,payload)
    quic.receivePath(st.subject,packet,0,st.now)
    return packet
}
function stockRetire(st: CidStock, destination: Bytes, sequence: Integer): Bytes {
    let payload=Bytes();appendInteger(payload,25);appendInteger(payload,sequence)
    while payload.length<5 { payload.add(0) }
    let packet=stockReceive(st,destination,payload)
    let header=wire.header(packet,0,st.subject.local.length)
    let opened=protection.unprotect(st.subject.spaces[2].read,packet,header.numberOffset,-1)
    if !opened.valid || !stockReceived(st.subject,opened.number) { st.valid=false }
    return packet
}
function stockCheck(st: CidStock, live: Integer, next: Integer, message: Text): Integer {
    if !st.valid || !stockDrain(st) { print("oracle failure: authenticated poll output or ACK drain failed");return 67 }
    if st.subject.state!=quic.ESTABLISHED || st.subject.localIds.length!=live || st.subject.nextLocalSequence!=next || st.observed.length!=next || live>min(st.limit,8) {
        print("semantic failure: "+message+"; live="+Text(st.subject.localIds.length)+" next="+Text(st.subject.nextLocalSequence)+" wire="+Text(st.observed.length));return 66
    }
    return 0
}
function stockUse(st: CidStock, sequence: Integer): Integer {
    let id=stockId(st.subject,sequence)
    if id.length==0 { print("semantic failure: required wire-issued CID unavailable");return 66 }
    let packet=stockReceive(st,id,crypto.fromHex("0100000000"))
    let header=wire.header(packet,0,st.subject.local.length)
    let opened=protection.unprotect(st.subject.spaces[2].read,packet,header.numberOffset,-1)
    if !opened.valid || st.subject.state!=quic.ESTABLISHED || !stockReceived(st.subject,opened.number) {
        print("oracle failure: requested CID packet was not authenticated and accepted");return 67
    }
    print("inventory accepted CID "+Text(sequence)+" packet "+Text(opened.number))
    return 0
}
function stockUseCheck(st: CidStock, sequence: Integer, live: Integer, next: Integer, message: Text): Integer {
    let result=stockUse(st,sequence);if result!=0 { return result }
    return stockCheck(st,live,next,message)
}
function stockSinglePath(st: CidStock): Integer {
    let before=stockSignature(st.subject);let original=st.subject.local
    for step in 0..16 { stockReceive(st,original,crypto.fromHex("0100000000"));if !stockDrain(st) { return 67 } }
    if stockSignature(st.subject)!=before { print("semantic failure: original-CID traffic changed the inventory version");return 66 }
    let result=stockCheck(st,2,2,"single-path stock changed");if result!=0 { return result }
    print("original-CID traffic retained exactly two drained wire IDs without extra issuance");return 0
}
function stockFirstUse(st: CidStock): Integer {
    let result=stockUseCheck(st,1,3,3,"authenticated CID1 use did not supply wire CID2")
    if result!=0 { return result }
    print("fresh authenticated spare-CID use supplied exactly one new wire CID2");return 0
}
function stockChain(st: CidStock): Integer {
    for sequence in 1..5 {
        let result=stockUseCheck(st,sequence,sequence+2,sequence+2,"consumed CID had no fresh wire-observed spare")
        if result!=0 { return result }
    }
    print("four successive authenticated path CID demands each supplied one wire-observed spare");return 0
}
function stockReorder(st: CidStock): Integer {
    let held=authenticatedFrame(st.peer,st.subject,stockId(st.subject,1),crypto.fromHex("0100000000"))
    let header=wire.header(held,0,st.subject.local.length)
    let decoded=protection.unprotect(st.subject.spaces[2].read,held,header.numberOffset,-1)
    if !decoded.valid || stockReceived(st.subject,decoded.number) { return 67 }
    let replay=stockReceive(st,stockId(st.subject,1),crypto.fromHex("0100000000"))
    let result=stockCheck(st,3,3,"first use had no spare before reordering control");if result!=0 { return result }
    result=stockUseCheck(st,2,4,4,"second use had no spare before reordering control");if result!=0 { return result }
    let before=stockSignature(st.subject);let largest=st.subject.spaces[2].largest
    st.now+=1;quic.receivePath(st.subject,held,0,st.now)
    if st.subject.spaces[2].largest!=largest || !stockReceived(st.subject,decoded.number) { return 68 }
    st.now+=1;quic.receivePath(st.subject,replay,0,st.now)
    stockReceive(st,stockId(st.subject,1),crypto.fromHex("0100000000"))
    if !stockDrain(st) || stockSignature(st.subject)!=before || st.observed.length!=4 { return 68 }
    print("fresh reordered old-CID packet, actual duplicate and repeated CID use added no extra spare");return 0
}
function stockRetiredSpare(st: CidStock): Integer {
    let old=stockId(st.subject,1)
    stockRetire(st,st.subject.local,1)
    let result=stockCheck(st,2,3,"retired unused spare did not get one replacement");if result!=0 { return result }
    let before=stockSignature(st.subject);let largest=st.subject.spaces[2].largest
    stockRetire(st,st.subject.local,1)
    let afterDuplicate=st.subject.spaces[2].largest
    if afterDuplicate<=largest { return 68 }
    st.now+=1;quic.receivePath(st.subject,authenticatedFrame(st.peer,st.subject,old,crypto.fromHex("0100000000")),0,st.now)
    if st.subject.spaces[2].largest!=afterDuplicate || stockSignature(st.subject)!=before { return 68 }
    result=stockUseCheck(st,2,3,4,"replacement spare first use did not supply the next wire CID");if result!=0 { return result }
    print("unused-spare retirement, duplicate retirement and retired-destination discard preserved exact replacement ordering");return 0
}
function stockRetireOrder(st: CidStock): Integer {
    stockRetire(st,stockId(st.subject,1),0)
    let result=stockCheck(st,2,3,"retirement plus first use emitted more or fewer than one replacement");if result!=0 { return result }
    let before=stockSignature(st.subject)
    stockRetire(st,stockId(st.subject,1),0)
    if !stockDrain(st) || stockSignature(st.subject)!=before { return 68 }
    result=stockUseCheck(st,2,3,4,"later use after retirement had no fresh wire spare");if result!=0 { return result }
    print("frame retirement supplied one replacement before first-use bookkeeping, without a duplicate refill");return 0
}
function stockLimit2(st: CidStock): Integer {
    let first=stockUseCheck(st,1,2,2,"peer limit2 exceeded on first use");if first!=0 { return first }
    for turn in 0..16 {
        let next=st.subject.nextLocalSequence;let current=stockId(st.subject,next-1);let retired=st.subject.localIds[0].sequence
        stockRetire(st,current,retired)
        let result=stockCheck(st,2,next+1,"limit2 retirement did not restore exactly two live IDs");if result!=0 { return result }
        result=stockUseCheck(st,next,2,next+1,"limit2 newest use over-issued");if result!=0 { return result }
    }
    print("peer limit2 allowed no extra live CID and sixteen retire-use rounds retained exactly two");return 0
}
function stockLimit3(st: CidStock): Integer {
    let first=stockFirstUse(st);if first!=0 { return first }
    first=stockUseCheck(st,2,3,3,"peer limit3 exceeded while full");if first!=0 { return first }
    stockRetire(st,stockId(st.subject,2),0)
    let result=stockCheck(st,3,4,"limit3 retirement did not restore one spare");if result!=0 { return result }
    print("peer limit3 capped first-use growth and restored one spare after retirement");return 0
}
function stockCap(st: CidStock): Integer {
    for sequence in 1..8 {
        let count=min(8,sequence+2)
        let result=stockUseCheck(st,sequence,count,count,"newest use did not follow bounded live inventory");if result!=0 { return result }
    }
    for turn in 0..16 {
        let next=st.subject.nextLocalSequence;let current=stockId(st.subject,next-1);let retired=st.subject.localIds[0].sequence
        stockRetire(st,current,retired)
        let result=stockCheck(st,8,next+1,"full inventory retirement did not restore one spare");if result!=0 { return result }
        result=stockUseCheck(st,next,8,next+1,"live cap8 exceeded by newest use");if result!=0 { return result }
    }
    print("authenticated peer limit "+Text(st.limit)+" respected local cap8 through sixteen retire-use rounds");return 0
}
function stockSpoof(st: CidStock): Integer {
    let before=stockSignature(st.subject);let largest=st.subject.spaces[2].largest;let failed=st.subject.failedAuthentication
    let data=authenticatedFrame(st.peer,st.subject,stockId(st.subject,1),crypto.fromHex("0100000000"))
    data[data.length-1]=data[data.length-1]^1
    st.now+=1;quic.receivePath(st.subject,data,0,st.now)
    let unknown=Bytes(8)
    for candidate in 0..9 { unknown[0]=candidate;if !quic.ownsConnectionId(st.subject,unknown) { break } }
    if quic.ownsConnectionId(st.subject,unknown) { return 65 }
    stockReceive(st,unknown,crypto.fromHex("0100000000"))
    st.now+=1;quic.receivePath(st.subject,data.slice(0,8),0,st.now)
    if st.subject.spaces[2].largest!=largest || st.subject.failedAuthentication!=failed+1 || stockSignature(st.subject)!=before { return 68 }
    stockReceive(st,st.subject.local,crypto.fromHex("0100000000"))
    if stockCheck(st,2,2,"spoof generated a local CID")!=0 || stockSignature(st.subject)!=before { return 66 }
    print("bad-tag, unknown-CID and truncated packets issued no CID; original route still accepted real traffic");return 0
}
function stockDiscardedRoute(st: CidStock): Integer {
    let before=stockSignature(st.subject);let largest=st.subject.spaces[2].largest
    let packet=authenticatedFrame(st.peer,st.subject,stockId(st.subject,1),crypto.fromHex("0100000000"))
    st.now+=1;quic.receivePath(st.subject,packet,99,st.now)
    if st.subject.spaces[2].largest!=largest || stockSignature(st.subject)!=before || stockCheck(st,2,2,"discarded route generated a CID")!=0 { return 68 }
    print("authenticated packet on an unaccepted client route did not consume the unused local CID");return 0
}
function stockWrongResponse(st: CidStock): Integer {
    if !errors.booleanOk(quic.probePath(st.subject,7,st.now)) { return 65 }
    // Observe the real wire challenge before the unchanged validation deadline.
    // Draining thirty-two polls here expires the candidate before this control.
    let challenge=Bytes();let deadline=-1
    for path in st.subject.paths { if path.id==7 { challenge=path.challenge;deadline=path.deadline } }
    if challenge.length!=8 || deadline<=st.now+1 { return 65 }
    st.now+=1;let challenges=0
    for packet in quic.pollDatagrams(st.subject,st.now) {
        if !stockRecord(st,packet.data) { return 67 }
        let header=wire.header(packet.data,0,st.peer.local.length)
        let opened=protection.unprotect(st.peer.spaces[2].read,packet.data,header.numberOffset,-1)
        let parsed=wire.frames(opened.payload)
        if !opened.valid || !parsed.valid { return 67 }
        for frame in parsed.frames { if frame.type==26 {
            if packet.pathId!=7 || crypto.hex(frame.data)!=crypto.hex(challenge) { return 67 }
            challenges+=1
        } }
    }
    if challenges!=1 { return 65 }
    let before=stockSignature(st.subject);let largest=st.subject.spaces[2].largest
    let payload=Bytes();payload.add(27);payload.addBytes(challenge)
    stockReceive(st,stockId(st.subject,1),payload)
    if st.subject.spaces[2].largest!=largest || stockSignature(st.subject)!=before || stockCheck(st,2,2,"wrong-route response generated a CID")!=0 { return 68 }
    print("real candidate challenge answered on the wrong route did not consume a spare CID");return 0
}
function stockFailure(st: CidStock, mode: Text): Integer {
    let before=stockSignature(st.subject);let payload=crypto.fromHex("1f00000000");let expected=7
    if mode=="cid-stock-forbidden-server" { payload=crypto.fromHex("1e00000000");expected=10 }
    if mode=="cid-stock-close" { payload=crypto.fromHex("1d00000000");expected=0 }
    if mode=="cid-stock-retire-current" { payload=Bytes();appendInteger(payload,25);appendInteger(payload,1);expected=10 }
    if mode=="cid-stock-retire-unissued" { payload=Bytes();appendInteger(payload,25);appendInteger(payload,2);expected=10 }
    while payload.length<5 { payload.add(0) }
    stockReceive(st,stockId(st.subject,1),payload)
    if expected==0 { if st.subject.state!=quic.CLOSED || !st.subject.draining { return 68 } }
    else { if st.subject.state!=quic.FAILED || st.subject.code!=expected { return 68 } }
    if stockSignature(st.subject)!=before || !stockDrain(st) || st.observed.length!=2 { return 68 }
    print("failed or closed authenticated CID1 packet preserved inventory; mode "+mode+" code "+Text(st.subject.code));return 0
}
function stockStale(st: CidStock): Integer {
    let held=authenticatedFrame(st.peer,st.subject,stockId(st.subject,1),crypto.fromHex("0100000000"))
    let header=wire.header(held,0,st.subject.local.length)
    let decoded=protection.unprotect(st.subject.spaces[2].read,held,header.numberOffset,-1)
    if !decoded.valid { return 67 }
    let before=stockSignature(st.subject)
    // Real packet-number gaps naturally exercise the maintained256-range
    // retention bound; no receiveFloor or CID-use bookkeeping is overwritten.
    for turn in 0..260 {
        st.peer.spaces[2].next+=1
        stockReceive(st,st.subject.local,crypto.fromHex("0100000000"))
        if !stockDrain(st) { return 67 }
    }
    if st.subject.spaces[2].receiveFloor<=decoded.number { return 65 }
    st.now+=1;quic.receivePath(st.subject,held,0,st.now)
    if !stockDrain(st) || stockSignature(st.subject)!=before || st.observed.length!=2 { return 68 }
    print("real receive-range pruning discarded an old authenticated unused-CID packet without issuing a spare");return 0
}
function stockMode(mode: Text): Boolean {
    for selected in ["cid-stock-single-path","cid-stock-first-use","cid-stock-first-use-server","cid-stock-chain","cid-stock-reorder","cid-stock-retired-spare","cid-stock-retire-order","cid-stock-limit2","cid-stock-limit3","cid-stock-cap8","cid-stock-large-limit","cid-stock-spoof","cid-stock-discarded-route","cid-stock-wrong-response","cid-stock-malformed","cid-stock-forbidden-server","cid-stock-close","cid-stock-retire-current","cid-stock-retire-unissued","cid-stock-stale"] { if mode==selected { return true } }
    return false
}
function stockCase(st: CidStock, mode: Text): Integer {
    if !st.valid { print("setup failure: authenticated inventory fixture, baseline wire stock or ACK closure failed");return 65 }
    if mode=="cid-stock-single-path" { return stockSinglePath(st) }
    if mode=="cid-stock-first-use" || mode=="cid-stock-first-use-server" { return stockFirstUse(st) }
    if mode=="cid-stock-chain" { return stockChain(st) }
    if mode=="cid-stock-reorder" { return stockReorder(st) }
    if mode=="cid-stock-retired-spare" { return stockRetiredSpare(st) }
    if mode=="cid-stock-retire-order" { return stockRetireOrder(st) }
    if mode=="cid-stock-limit2" { return stockLimit2(st) }
    if mode=="cid-stock-limit3" { return stockLimit3(st) }
    if mode=="cid-stock-cap8" || mode=="cid-stock-large-limit" { return stockCap(st) }
    if mode=="cid-stock-spoof" { return stockSpoof(st) }
    if mode=="cid-stock-discarded-route" { return stockDiscardedRoute(st) }
    if mode=="cid-stock-wrong-response" { return stockWrongResponse(st) }
    if mode=="cid-stock-stale" { return stockStale(st) }
    return stockFailure(st,mode)
}

// RFC9000 8.2.2 / 13.3. Challenges and ACKs are independently encoded and
// protected with the authenticated peer's keys; every observed poll packet
// is decrypted. No retry/padding helper from the implementation is an oracle.
record ResponseWire { valid: Boolean; number: Integer; payload: Bytes; responses: Integer; acknowledgements: Integer }
function responseWire(peer: quic.Connection, packet: quic.Datagram, token: Bytes, route: Integer): ResponseWire {
    let result=ResponseWire { valid:false;number:-1;payload:Bytes();responses:0;acknowledgements:0 }
    let header=wire.header(packet.data,0,peer.local.length)
    if !header.valid || header.kind!=wire.ONE_RTT || !quic.ownsConnectionId(peer,header.destination) || packet.data.length>1200 { return result }
    let opened=protection.unprotect(peer.spaces[2].read,packet.data,header.numberOffset,-1)
    if !opened.valid { return result }
    let parsed=wire.frames(opened.payload);if !parsed.valid { return result }
    for frame in parsed.frames {
        if frame.type==27 {
            if crypto.hex(frame.data)!=crypto.hex(token) || packet.pathId!=route { return result }
            result.responses+=1
        }
        if frame.type==2 || frame.type==3 { result.acknowledgements+=1 }
    }
    result.valid=true;result.number=opened.number;result.payload=opened.payload;return result
}
function responseChallenge(peer: quic.Connection, subject: quic.Connection, token: Bytes, size: Integer, route: Integer, now: Integer): Integer {
    let payload=Bytes();payload.add(26);payload.addBytes(token)
    // Independently account for the four-byte packet number and AEAD tag.
    if size>0 { payload.resize(size-1-subject.local.length-4-16) }
    let number=peer.spaces[2].next
    let packet=authenticatedFrame(peer,subject,subject.local,payload)
    if (size>0 && packet.length!=size) || !subject.clientTLS.authenticated && subject.clientRole || !subject.serverTLS.authenticated && !subject.clientRole { return -1 }
    quic.receivePath(subject,packet,route,now)
    if subject.state!=quic.ESTABLISHED || !stockReceived(subject,number) { return -1 }
    return number
}
function responseAck(peer: quic.Connection, subject: quic.Connection, number: Integer, now: Integer) {
    let payload=Bytes();payload.add(2);appendInteger(payload,number);appendInteger(payload,0);appendInteger(payload,0);appendInteger(payload,0)
    quic.receivePath(subject,authenticatedFrame(peer,subject,subject.local,payload),subject.activePath,now)
}
function responsePaddingFailure(): Integer { print("semantic failure: PATH_RESPONSE padding or admission violated");return 35 }
function responsePadding(p: Pair, mode: Text): Integer {
    if !ready(p) || !p.client.clientTLS.authenticated || !p.server.serverTLS.authenticated { return 30 }
    let subject=p.client;let peer=p.server
    if mode=="response-padding-server" || mode=="response-amp-credit" || mode=="response-amp-limited" || mode=="response-amp-blocked" { subject=p.server;peer=p.client }
    if subject.pending.length!=0 || subject.spaces[2].sent.length!=0 || subject.paths.length!=1 { print("setup failure: response fixture did not drain");return 30 }
    let width=8;if mode=="response-padding-width1" { width=1 };if mode=="response-padding-width20" { width=20 }
    if width!=8 {
        // Isolate legal short-header widths with consistent peer ownership.
        let id=randomBytes(width);let sequence=subject.paths[0].remoteSequence
        for known in peer.localIds { if known.sequence==sequence { known.id=id } }
        for known in subject.remoteIds { if known.sequence==sequence { known.id=id } }
        peer.local=id;subject.remote=id;subject.paths[0].remoteId=id
    }
    let path=subject.paths[0];path.id=9;subject.activePath=9
    let unvalidated=mode=="response-amp-credit" || mode=="response-amp-limited" || mode=="response-amp-blocked"
    if unvalidated { path.validated=false;path.received=0;path.sent=0 }
    let now=p.now+1;let token=randomBytes(8);let inputSize=1200
    if mode=="response-amp-limited" || mode=="response-amp-blocked" { inputSize=38 }
    if mode=="response-amp-blocked" { path.sent=1200 }
    let occupied=-1
    if mode=="response-congestion" {
        // Fill the window with a real, unacknowledged STREAM packet.
        subject.congestion.window=1200;subject.paceCredit=2400.0;subject.paceAt=now
        let opened=quic.openStream(subject,false);if !errors.integerOk(opened) { return 30 }
        quic.writeStream(subject,errors.integerValue(opened),Bytes(1000),true)
        for packet in quic.pollDatagrams(subject,now) {
            let observed=responseWire(peer,packet,token,9)
            if !observed.valid || observed.responses!=0 || occupied>=0 { return 31 }
            occupied=observed.number
        }
        if occupied<0 || subject.flight<=0 || subject.flight>=1200 { return 30 }
        now+=1
    }
    let received=responseChallenge(peer,subject,token,inputSize,9,now);if received<0 { return 30 }
    if mode=="response-pacing" { subject.paceCredit=0.0;subject.paceAt=now }
    let blocked=mode=="response-amp-blocked" || mode=="response-pacing" || mode=="response-congestion"
    if blocked {
        for turn in 0..4 {
            for packet in quic.pollDatagrams(subject,now) {
                let observed=responseWire(peer,packet,token,9)
                if !observed.valid { return 31 }
                if observed.responses!=0 { return responsePaddingFailure() }
            }
            let queued=0
            for pending in subject.pending { for frame in wire.frames(pending.payload).frames {
                if frame.type==27 { if pending.path!=9 || crypto.hex(frame.data)!=crypto.hex(token) || pending.payload.length>=1200 { return 32 };queued+=1 }
            } }
            if queued!=1 { print("blocked output discarded or duplicated its pending response");return 32 }
        }
        now+=100
        if mode=="response-amp-blocked" {
            let padding=Bytes(1171)
            quic.receivePath(subject,authenticatedFrame(peer,subject,subject.local,padding),9,now)
        }
        if occupied>=0 { responseAck(peer,subject,occupied,now) }
    }
    let count=0;let acks=0;let transmitted=0;let first=subject.spaces[2].next
    let beforeSent=path.sent;let beforeCredit=3*path.received-path.sent
    for packet in quic.pollDatagrams(subject,now) {
        let observed=responseWire(peer,packet,token,9);if !observed.valid { return 31 }
        count+=observed.responses;acks+=observed.acknowledgements;transmitted+=packet.data.length
        for frame in wire.frames(observed.payload).frames { if frame.type!=0 && frame.type!=2 && frame.type!=3 && frame.type!=27 { return 33 } }
        if observed.responses>0 {
            print("response wire: route "+Text(packet.pathId)+" CID width "+Text(width)+" UDP bytes "+Text(packet.data.length)+" echoes "+Text(observed.responses)+" ACKs "+Text(observed.acknowledgements)+" token matched; path validated "+Text(path.validated)+" credit "+Text(beforeCredit))
            if observed.responses!=1 { return 33 }
            if mode=="response-amp-limited" {
                if packet.data.length>=1200 || packet.data.length>beforeCredit { return 34 }
            } else if packet.data.length!=1200 { return responsePaddingFailure() }
        }
    }
    if count!=1 || acks!=1 || subject.spaces[2].next<=first || path.sent-beforeSent!=transmitted ||
       (unvalidated && path.sent>3*path.received) || subject.activePath!=9 { return 34 }
    responseAck(peer,subject,subject.spaces[2].next-1,now+1)
    for packet in quic.pollDatagrams(subject,now+2) { let observed=responseWire(peer,packet,token,9);if !observed.valid || observed.responses!=0 { return 34 } }
    print("PATH_RESPONSE wire padding, token, route and admission passed; mode "+mode+" width "+Text(width)+" bytes "+Text(transmitted));return 0
}
function responseRetry(p: Pair, mode: Text): Integer {
    if !ready(p) || !p.client.clientTLS.authenticated || !p.server.serverTLS.authenticated { return 30 }
    let subject=p.client;let peer=p.server
    if mode=="response-pto-server" || mode=="response-loss-server" || mode=="response-mixed-loss" { subject=p.server;peer=p.client }
    if subject.pending.length!=0 || subject.spaces[2].sent.length!=0 { return 30 }
    let mixed=mode=="response-mixed-pto" || mode=="response-mixed-loss" || mode=="response-mixed-path-loss"
    let loss=mode=="response-loss-client" || mode=="response-loss-server" || mode=="response-mixed-loss" || mode=="response-mixed-path-loss"
    let route=subject.activePath;let now=p.now+1;let id=-1;let expected=Bytes("reliable data survives a lost response");let control=-1;let cid=Bytes();let cidSequence=-1;let challenge=Bytes()
    subject.congestion.measured=true;subject.congestion.smoothed=100;subject.congestion.latest=100;subject.congestion.minimum=100;subject.congestion.variance=0
    if mode=="response-mixed-path-loss" {
        if !errors.booleanOk(quic.probePath(subject,7,now)) { return 30 }
        route=7;for path in subject.paths { if path.id==route { challenge=path.challenge } }
        if challenge.length!=8 { return 30 }
    }
    if mixed {
        let opened=quic.openStream(subject,false);if !errors.integerOk(opened) { return 30 }
        id=errors.integerValue(opened);quic.writeStream(subject,id,expected,true)
        // Actual retirement creates a replacement NEW_CONNECTION_ID control.
        let retirement=Bytes();retirement.add(25);appendInteger(retirement,1)
        quic.receivePath(subject,authenticatedFrame(peer,subject,subject.local,retirement),subject.activePath,now)
        subject.receiveMaxData+=1;control=subject.receiveMaxData
    }
    let token=randomBytes(8)
    if responseChallenge(peer,subject,token,1200,route,now)<0 { return 30 }
    if mixed {
        // Coalesce real maintained queues into one packet, as in existing
        // mixed retry fixtures. The reliable bytes are never synthesized.
        let payload=Bytes();let responseAt=-1
        for at in 0..subject.pending.length {
            let pending=subject.pending[at];if pending.acknowledgement { return 30 }
            for frame in wire.frames(pending.payload).frames {
                if frame.type==27 { responseAt=at }
                if frame.type==24 { cidSequence=frame.value;cid=frame.data }
            }
            payload.addBytes(pending.payload)
        }
        if responseAt<0 || cidSequence<0 { return 30 }
        payload.add(16);appendInteger(payload,control)
        let pending=subject.pending[responseAt];pending.payload=payload;subject.pending=[pending]
    }
    subject.paceCredit=2400.0;subject.paceAt=now
    let original=-1;let firstResponses=0;let originals=0
    for packet in quic.pollDatagrams(subject,now) {
        let observed=responseWire(peer,packet,token,route);if !observed.valid { return 31 }
        if observed.responses>0 { original=observed.number;originals+=1 };firstResponses+=observed.responses
        // Deliberately drop the authenticated output, including reliable data.
    }
    if original<0 || firstResponses!=1 || originals!=1 || subject.spaces[2].sent.length!=1 { return 30 }
    print("response original: PN "+Text(original)+" route "+Text(route)+" echoes "+Text(firstResponses)+" dropped; authenticated both roles")
    let sent=subject.spaces[2].sent[0];let probes=subject.congestion.probes
    if loss {
        for step in 1..4 {
            quic.ping(subject);subject.paceCredit=2400.0;subject.paceAt=now+step
            let count=0
            for packet in quic.pollDatagrams(subject,now+step) {
                let observed=responseWire(peer,packet,token,route);if !observed.valid || observed.responses!=0 { return 31 };count+=1
            }
            if count!=1 { return 30 }
        }
        responseAck(peer,subject,subject.spaces[2].next-1,now+4);now+=4
        // Exercise retained retry filtering while pacing rejects transmission.
        subject.paceCredit=0.0;subject.paceAt=now
    } else {
        let deadline=subject.spaces[2].probe
        if deadline<=now { return 30 }
        // Consume any earlier ACK deadline without changing the PTO alarm.
        for packet in quic.pollDatagrams(subject,deadline-1) {
            let observed=responseWire(peer,packet,token,route);if !observed.valid || observed.responses!=0 { return 31 }
        }
        if quic.nextTimer(subject)!=deadline { return 30 };now=quic.nextTimer(subject)
    }
    let responses=0;let streams=0;let controls=0;let cids=0;let challenges=0;let observedPackets=0
    // All packets from the real loss/PTO poll and following admission turn
    // are decrypted; the original challenge is not delivered again.
    for turn in 0..2 {
        for packet in quic.pollDatagrams(subject,now+turn*10) {
            let observed=responseWire(peer,packet,token,route);if !observed.valid { return 31 }
            observedPackets+=1;responses+=observed.responses
            for frame in wire.frames(observed.payload).frames {
                if frame.type>=8 && frame.type<=15 {
                    if frame.stream!=id || frame.offset!=0 || !frame.fin || crypto.hex(frame.data)!=crypto.hex(expected) || packet.pathId!=subject.activePath { return 37 };streams+=1
                }
                if frame.type==16 { if frame.value!=control || packet.pathId!=subject.activePath { return 37 };controls+=1 }
                if frame.type==24 {
                    if frame.value!=cidSequence || crypto.hex(frame.data)!=crypto.hex(cid) || packet.pathId!=subject.activePath { return 37 };cids+=1
                }
                if frame.type==26 { if crypto.hex(frame.data)!=crypto.hex(challenge) || packet.pathId!=route { return 37 };challenges+=1 }
            }
        }
    }
    print("response recovery: clock "+Text(now)+" loss "+Text(loss)+" packets "+Text(observedPackets)+" echoes "+Text(responses)+" STREAM "+Text(streams)+" MAX_DATA "+Text(controls)+" NEW_CONNECTION_ID "+Text(cids)+" PATH_CHALLENGE "+Text(challenges))
    if responses!=0 { print("semantic failure: PATH_RESPONSE retransmitted after loss or PTO");return 36 }
    if loss && sent.status!=2 || !loss && subject.congestion.probes!=probes+1 { return 38 }
    if mixed && (streams!=1 || controls!=1 || cids!=1) || !mixed && (streams!=0 || controls!=0 || cids!=0) ||
       (challenge.length==8 && challenges!=1) || (challenge.length==0 && challenges!=0) || (!loss && observedPackets<1) { return 38 }
    // A distinct authenticated challenge still earns exactly one fresh echo.
    now+=11;let fresh=randomBytes(8)
    if responseChallenge(peer,subject,fresh,1200,route,now)<0 { return 30 }
    let freshResponses=0
    for packet in quic.pollDatagrams(subject,now) { let observed=responseWire(peer,packet,fresh,route);if !observed.valid { return 31 };freshResponses+=observed.responses }
    if freshResponses!=1 { return 39 }
    print("PATH_RESPONSE sent once; reliable STREAM, control, CID and path-challenge retry preserved; mode "+mode);return 0
}
function main(): Integer {
    let root = readBytesFile(argument(0)); let identity = readBytesFile(argument(1)); let key = readBytesFile(argument(2))
    let client = readBytesFile(argument(3)); let clientKey = readBytesFile(argument(4)); let mode = argument(5)
    if stockMode(mode) {
        let limit=8
        if mode=="cid-stock-limit2" { limit=2 }
        if mode=="cid-stock-limit3" { limit=3 }
        if mode=="cid-stock-large-limit" { limit=wire.MAX_VARINT }
        let serverSubject=mode=="cid-stock-first-use-server" || mode=="cid-stock-forbidden-server"
        return stockCase(stockPair(root,identity,key,client,clientKey,limit,serverSubject),mode)
    }
    if mode == "preferred-address" { return preferredAddress(root, identity, key, client, clientKey) }
    if mode == "preferred-validation" || mode == "preferred-disabled" || mode == "preferred-fallback" || mode == "preferred-api" || mode == "preferred-reciprocal" {
        let preferred=preferredPair(root,identity,key,client,clientKey,mode=="preferred-disabled",mode=="preferred-api")
        if mode=="preferred-fallback" { return preferredFallback(preferred) }
        if mode=="preferred-reciprocal" { return reciprocalMigration(preferred) }
        return preferredValidation(preferred,mode=="preferred-disabled")
    }
    if mode=="early-routes" { return earlyRoutes(root,identity,key,client,clientKey) }
    let p = connected(root, identity, key, client, clientKey)
    if mode=="response-padding-client" || mode=="response-padding-server" || mode=="response-padding-width1" || mode=="response-padding-width20" || mode=="response-amp-credit" || mode=="response-amp-limited" || mode=="response-amp-blocked" || mode=="response-pacing" || mode=="response-congestion" { return responsePadding(p,mode) }
    if mode=="response-pto-client" || mode=="response-pto-server" || mode=="response-loss-client" || mode=="response-loss-server" || mode=="response-mixed-pto" || mode=="response-mixed-loss" || mode=="response-mixed-path-loss" { return responseRetry(p,mode) }
    if mode=="old-high-ack" || mode=="old-route-alarm" || mode=="old-high-current-rtt" || mode=="current-route-alarm" { return oldValidationRecovery(p,mode) }
    if mode=="current-packet-threshold" { return currentPacketThreshold(p) }
    if mode=="old-probing-return" { return retainedOldTraffic(p,true) }
    if mode=="old-nonprobing-return" { return retainedOldTraffic(p,false) }
    if mode=="old-path-late-ack" { return oldPathLateAck(p,false) }
    if mode=="reused-path-late-ack" { return oldPathLateAck(p,true) }
    if mode=="reused-path-ack" { return oldPathAck(p,true) }
    if mode=="reused-path-loss" { return oldPathLoss(p,true) }
    if mode=="mixed-path-ack" { return mixedRecoveryAck(p) }
    if mode=="old-path-ack" { return oldPathAck(p,false) }
    if mode=="old-path-loss" { return oldPathLoss(p,false) }
    if mode=="current-path-ack" { return currentPathRecovery(p,false) }
    if mode=="current-path-loss" { return currentPathRecovery(p,true) }
    if mode == "migration-cid" { return intentionalMigration(p) }
    if mode == "cid-unavailable" { return noSpareCid(p) }
    if mode == "nat-rebinding" { return natRebinding(p) }
    if mode == "failed-validation" { return failedValidation(p) }
    if mode == "retire-prior" { return retirePrior(p) }
    if mode == "duplicate-retirement" { return duplicateRetirement(p) }
    if mode == "successful-retirement" { return successfulRetirement(p) }
    if mode == "unknown-destination" { return unknownDestination(p) }
    if mode=="repeated-migration" { return repeatedMigration(p) }
    if mode=="cid-rebound" { return cidRebound(p) }
    if mode=="unknown-server-route" { return unknownServerRoute(p) }
    if mode=="candidate-ack-width" { return candidateAckWidth(p) }
    if mode=="validation-first-challenge" { return validationResponseOrder(p,true) }
    if mode=="validation-response-order" { return validationResponseOrder(p,false) }
    if mode=="previous-path-probe" { return previousPathProbe(p) }
    if mode=="previous-path-return" { return previousPathReturn(p) }
    if mode=="previous-path-timeout" { return previousPathTimeout(p) }
    if mode=="reciprocal-cid" { return reciprocalMigration(p) }
    if mode=="server-cid-unavailable" { return serverWithoutSpare(p) }
    if mode=="nat-cid-unavailable" { p.server.remoteIds=[p.server.remoteIds[0]];return natRebinding(p) }
    if mode=="response-routes" { return responseRoutes(p) }
    if mode=="late-response" { return lateResponse(p) }
    if mode=="token-reuse" { return tokenReuse(p) }
    if mode=="retirement-bound" { return retirementBound(p) }
    if mode=="retired-destination" { return retiredDestination(p) }
    print("unknown regression case"); return 2
}
