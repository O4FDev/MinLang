use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, io.readTextFile("tests/choice/generics.min"), "42\nheld\nquiet\n7 days\n1\n0\n2\n9\ninferred\n1\naction\n", levels, 0, "", false)
fixtures.executes(frontend, io.readTextFile("tests/choice/expressions.min"), "moon\nmoonlight\nquiet\n0\n42\ninside\nok\nsaved\nmoon\n42\n1\nkept alive\nempty\n42\nstopped\n42\n", levels, 0, "", false)
io.writeTextFile(frontend.compiler.directory + "/weather.min", io.readTextFile("tests/choice/module.min"))
fixtures.executes(frontend, "use \"./weather.min\" as weather\nlet value = weather.Weather.Rain(42)\nprint(match value { Sun { 0 } Rain(drops) { drops } })\n", "42\n", levels, 0, "", false)
fixtures.rejects(frontend, "let value: Maybe<Integer> = None\nlet n = match value { Some(n) { n } }\n", "match is missing cases: None", true)
test.removeTree(frontend.compiler.directory)
print("Choice smoke: passed")
