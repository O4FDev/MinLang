parallel function scalarInteger(unused: Integer, value: Integer): Integer { return value + 1 }
parallel function scalarFloat(value: Float): Float { return value + 0.5 }
parallel function scalarBoolean(value: Boolean): Boolean { return !value }
parallel function scalarCharacter(value: Character): Character { return value }
parallel function scalarNothing(value: Integer) {}
print(scalarInteger(0,41))
print(scalarFloat(1.5))
print(scalarBoolean(false))
print(scalarCharacter('A'))
scalarNothing(0)
