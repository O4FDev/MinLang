record Box { value: Integer }
function text(unused: Text): Integer { return 1 }
function bytes(unused: Bytes): Integer { return 2 }
function list(unused: List<Integer>): Integer { return 3 }
function box(unused: Box): Integer { return 4 }
print(text("allowed"))
print(bytes(Bytes(1)))
print(list([1]))
print(box(Box { value: 1 }))
