record Address { street: Text; number: Integer }
record Parcel { name: Text; address: Address }
record Shelf { value: Maybe<Parcel>; spares: List<Maybe<Parcel>> }

// Maybe declares Some first. This order gives null the first logical tag.
choice Availability { Vacant; Ready(value: Parcel) }

record Node {
    name: Text
    next: Maybe<Node>
    children: List<Maybe<Node>>
}

function parcel(name: Text, number: Integer): Parcel {
    return Parcel { name: name; address: Address { street: "sea" + " lane"; number: number } }
}

function parcelName(value: Maybe<Parcel>): Text {
    return match value { Some(item) { item.name } None { "none" } }
}

function nestedName(value: Maybe<Maybe<Parcel>>): Text {
    return match value { Some(inner) { "some " + parcelName(inner) } None { "outer none" } }
}

function nodeName(value: Maybe<Node>): Text {
    return match value { Some(node) { node.name } None { "none" } }
}

function identity<Item>(value: Item): Item { return value }
function wrap<Item>(value: Item): Maybe<Item> { return Some(value) }
function absent<Item>(): Maybe<Item> { return None }
function build<Item>(work: () -> Item): Maybe<Item> { return Some(work()) }
function fresh(name: Text): Maybe<Parcel> { return Some(parcel(name, 1)) }
function remember(value: Maybe<Parcel>): () -> Maybe<Parcel> {
    return function() { return value }
}

print("lifetimes")
let optional: Maybe<Parcel> = None
print(parcelName(optional))
optional = fresh("first")
print(parcelName(optional))
let alias = optional
optional = None
print(parcelName(alias))
print(parcelName(optional))
let saved = match fresh("saved") {
    Some(value) { value }
    None { parcel("missing", 0) }
}
print(saved.name)
let input = fresh("matched")
match (input) {
    Some(value) { input = None; print(value.name) }
    None { print("missing") }
}
print(parcelName(input))
let replaced = fresh("before")
let prior = replaced
match replaced {
    Some(value) { replaced = Some(parcel("after", 2)); print(value.name) }
    None { print("missing") }
}
print(parcelName(prior))
print(parcelName(replaced))

print("generics")
let owned = wrap(parcel("owned", 3))
print(parcelName(owned))
let borrowed = parcel("borrowed", 4)
let forwarded = wrap(identity(borrowed))
borrowed.name = "changed"
print(parcelName(forwarded))
let constructed = build<Parcel>(function() { return parcel("callback result", 5) })
print(parcelName(constructed))
print(parcelName(absent<Parcel>()))
let returned = identity(Some(parcel("returned", 6)))
print(parcelName(returned))
let read = remember(fresh("captured"))
print(parcelName(read()))
let captureShelf = Shelf { value: fresh("mutable capture"); spares: [] }
let readCurrent: () -> Maybe<Parcel> = function() { return captureShelf.value }
captureShelf.value = None
print(parcelName(readCurrent()))
// A callback itself is excluded from the nullable record niche.
let optionalRead: Maybe<() -> Text> = Some(function() { return "callable" })
print(match optionalRead { Some(work) { work() } None { "absent callback" } })
optionalRead = None
print(match optionalRead { Some(work) { work() } None { "absent callback" } })

print("nested")
let outerNone: Maybe<Maybe<Parcel>> = None
let innerNone: Maybe<Maybe<Parcel>> = Some(None<Parcel>())
let nested: Maybe<Maybe<Parcel>> = Some(Some(parcel("nested", 7)))
print(nestedName(outerNone))
print(nestedName(innerNone))
print(nestedName(nested))
print(outerNone == innerNone)
print(innerNone == Some(None<Parcel>()))
let nestedKeys: Map<Maybe<Maybe<Parcel>>, Integer> = Map()
nestedKeys[outerNone] = 10
nestedKeys[innerNone] = 20
nestedKeys[nested] = 30
print(nestedKeys.length)
print(nestedKeys[None])
print(nestedKeys[Some(None<Parcel>())])
print(nestedKeys[Some(Some(parcel("nested", 7)))])
let nestedSet: Set<Maybe<Maybe<Parcel>>> = Set()
nestedSet.add(outerNone)
nestedSet.add(innerNone)
nestedSet.add(nested)
nestedSet.add(Some(None<Parcel>()))
print(nestedSet.length)
print(nestedSet.contains(outerNone))
print(nestedSet.contains(innerNone))

print("case order")
let vacant: Availability = Vacant
let ready = Ready(parcel("ready", 1))
print(match vacant { Vacant { "vacant" } Ready(value) { value.name } })
print(match ready { Vacant { "vacant" } Ready(value) { value.name } })
print(vacant < ready)
print(ready > vacant)
print(Some(parcel("first", 1)) < Maybe<Parcel>.None)
let ordered: List<Availability> = [Ready(parcel("z", 1)), Vacant, Ready(parcel("a", 1))]
ordered.sort()
for value in ordered { print(match value { Vacant { "vacant" } Ready(item) { item.name } }) }
let maybeOrdered: List<Maybe<Parcel>> = [None, Some(parcel("z", 1)), Some(parcel("a", 1))]
maybeOrdered.sort()
for value in maybeOrdered { print(parcelName(value)) }

print("capabilities")
let original = parcel("key", 9)
let key: Maybe<Parcel> = Some(original)
print(key == Some(parcel("key", 9)))
print(key == None)
print(None<Parcel>() == None<Parcel>())
print(Some(parcel("a", 1)) < Some(parcel("b", 1)))
let entries: Map<Maybe<Parcel>, Integer> = Map()
entries[None] = 5
entries[key] = 42
original.address.number = 99
original.name = "changed"
print(entries[Some(parcel("key", 9))])
print(entries.has(key))
print(entries.has(None))
for snapshot in entries {
    match snapshot {
        Some(value) { value.name = "snapshot"; value.address.number = 88 }
        None {}
    }
}
print(entries[Some(parcel("key", 9))])
print(entries[None])
let seen: Set<Maybe<Parcel>> = Set()
let seed = parcel("seed", 2)
seen.add(Some(seed))
seen.add(None)
seed.address.number = 3
print(seen.contains(Some(parcel("seed", 2))))
print(seen.contains(Some(seed)))
for snapshot in seen {
    match snapshot { Some(value) { value.address.number = 77 } None {} }
}
print(seen.contains(Some(parcel("seed", 2))))
print(seen.remove(None))
print(seen.length)
let custom = parcel("custom", 11)
let customKey: Availability = Ready(custom)
let deliveries: Map<Availability, Text> = Map()
deliveries[Vacant] = "empty"
deliveries[customKey] = "kept"
custom.name = "altered"
custom.address.number = 12
print(deliveries[Ready(parcel("custom", 11))])
print(deliveries[Vacant])
for snapshot in deliveries {
    match snapshot { Vacant {} Ready(value) { value.address.number = 66 } }
}
print(deliveries[Ready(parcel("custom", 11))])
print(deliveries.has(customKey))

print("containers")
let shelf = Shelf { value: fresh("record"); spares: [None, fresh("list")] }
print(parcelName(shelf.value))
let retained = shelf.value
shelf.value = None
print(parcelName(retained))
print(parcelName(shelf.value))
let listSaved = match shelf.spares[1] {
    Some(value) { value }
    None { parcel("missing", 0) }
}
shelf.spares[1] = None
print(listSaved.name)
shelf.spares[0] = Some(parcel("added", 4))
for value in shelf.spares { print(parcelName(value)) }

print("cycles")
if true {
    let old = Node { name: "old"; next: None; children: [] }
    let node = Node { name: "self"; next: Some(old); children: [] }
    print(nodeName(node.next))
    node.next = Some(node)
    print(nodeName(node.next))
    // This local optional has no wrapper cycle of its own; its Node is traced.
    let held: Maybe<Node> = Some(node)
    let heldAlias = held
    held = None
    print(nodeName(heldAlias))
    print(nodeName(held))
}
if true {
    let children: List<Maybe<Node>> = []
    let node = Node { name: "list"; next: None; children: children }
    children.add(None)
    children.add(Some(node))
    print(children.length)
    print(nodeName(children[0]))
    print(nodeName(children[1]))
    let child = match children[1] {
        Some(value) { value }
        None { Node { name: "missing"; next: None; children: [] } }
    }
    children[1] = None
    print(child.name)
    children[1] = Some(node)
}
