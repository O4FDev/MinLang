use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "./native-evidence.min" as evidence
use "system" as system
use "files" as files
use "json" as json

record Child { result: test.Result; base: Text }

function executable(path: Text, source: Text) {
    io.writeTextFile(path, source)
    test.require(test.run(["/bin/chmod", "755", path], system.environment(), "", path + ".chmod", 10), "chmod " + path)
}
function environment(overrides: List<Text>): List<Text> {
    let result: List<Text> = []
    for entry in system.environment() {
        let keep = true
        for item in overrides {
            let raw = Bytes(item)
            let name = item
            for index in 0..raw.length { if raw[index] == 61 { name = Text(raw.slice(0, index)); break } }
            if test.contains(entry, "=") && Bytes(entry).length > Bytes(name).length && Text(Bytes(entry).slice(0, Bytes(name).length + 1)) == name + "=" { keep = false }
        }
        if keep { result.add(entry) }
    }
    for item in overrides { result.add(item) }
    return result
}
function child(self: Text, scratch: Text, label: Text, mode: Text, arguments: List<Text>, overrides: List<Text>): Child {
    let base = scratch + "/" + label + "-evidence"
    test.check(files.makeDirectory(base) == 0, "cannot create child evidence base")
    let command = [self, mode]
    for item in arguments { command.add(item) }
    let settings = [ "MINYAR_TEST_EVIDENCE=" + base ]
    for item in overrides { settings.add(item) }
    let result = test.run(command, environment(settings), "", scratch + "/" + label + ".log", 300)
    return Child { result: result; base: base }
}
function failedManifests(base: Text): Integer {
    let count = 0
    for name in files.list(base) {
        let manifest = base + "/" + name + "/evidence.json"
        if test.contains(name, "regression") && files.pathSize(manifest) >= 0 {
            let report = json.parse(io.readTextFile(manifest))
            if json.string(report, "status") == "failed" { count += 1 }
        }
    }
    return count
}
function fileProgram(destination: Text, contents: Text) {
    let context = evidence.context("regression", "FileProgram.runTest", "tests/native-evidence-harness.min")
    evidence.executes(context, "io.writeTextFile(processInfo.argument(0), \"" + contents + "\")\nprint(\"done\")\n", "done\n", 0, "", [destination],
        [evidence.FileOutput { path: destination; contents: Bytes("fresh") }])
    evidence.close(context, false)
}
function strayProgram() {
    let context = evidence.context("regression", "StrayStderr.runTest", "tests/native-evidence-harness.min")
    evidence.executes(context, "print(42)\n", "42\n", 0, "", [], [])
    evidence.close(context, false)
}
function timeoutProgram() {
    let context = evidence.context("regression", "ScaledTimeout.runTest", "tests/native-evidence-harness.min")
    // A finite child exercises timeout diagnostics and retained output, without an elapsed bound.
    evidence.run(context, ["/bin/sh", "-c", "printf timeout-ready; exec /bin/sleep 6"], "timeout-probe", 1, false)
    evidence.close(context, false)
}

function fileOutputsRequireFreshExactBytesForEveryOptimization(self: Text, scratch: Text, clang: Text) {
    let destination = scratch + "/result.bin"
    let fresh = child(self, scratch, "fresh", "--file-program", [destination, "fresh"], [])
    test.check(fresh.result.status == 0, "fresh file outputs failed\n" + fresh.result.output + fresh.result.errorOutput)
    test.check(Text(io.readBytesFile(destination)) == "fresh", "fresh file output bytes")
    let log = scratch + "/mutations.log"
    let wrapper = scratch + "/omit-second-write"
    executable(wrapper, "#!/bin/sh\nset -e\nmutate=0\nfor item do if [ \"$item\" = -O2 ]; then mutate=1; fi; done\nfor item do\n  shift\n  case \"$item\" in\n    *.ll) if [ \"$mutate\" = 1 ]; then grep -c 'call void @minyar_runtime_writeTextFile(' \"$item\" >> \"$MINYAR_HARNESS_LOG\" || :; grep -v 'call void @minyar_runtime_writeTextFile(' \"$item\" > \"$item.mutated.ll\" || :; item=\"$item.mutated.ll\"; fi;;\n  esac\n  set -- \"$@\" \"$item\"\ndone\nexec \"$MINYAR_HARNESS_CLANG\" \"$@\"\n")
    let missing = child(self, scratch, "missing", "--file-program", [destination, "fresh"],
        ["MINYAR_TEST_CLANG=" + wrapper, "MINYAR_HARNESS_CLANG=" + clang, "MINYAR_HARNESS_LOG=" + log])
    test.check(files.pathSize(log) >= 0 && test.lines(io.readTextFile(log)).length == 1 && test.lines(io.readTextFile(log))[0] == "1", "exactly one O2 file write must be removed")
    test.check(missing.result.status != 0, "missing O2 file output passed")
    test.check(test.contains(missing.result.errorOutput, "native program file bytes differ"), "missing file output was not a file-output failure\n" + missing.result.errorOutput)
    test.check(failedManifests(missing.base) == 1, "missing file output did not retain failed evidence")
    let wrong = child(self, scratch, "wrong", "--file-program", [destination, "wrong"], [])
    test.check(wrong.result.status != 0, "wrong file bytes passed")
    test.check(test.contains(wrong.result.errorOutput, "native program file bytes differ"), "wrong file bytes were not a file-output failure\n" + wrong.result.errorOutput)
    test.check(Text(io.readBytesFile(destination)) == "wrong", "wrong-byte program did not run")
}

function correctStdoutWithUnexpectedStderrIsRejectedAndRetained(self: Text, scratch: Text) {
    let wrapper = scratch + "/stray-stderr-link"
    executable(wrapper, "#!/bin/sh\nout=\nprevious=\nfor item do\n  if [ \"$previous\" = -o ]; then out=$item; fi\n  previous=$item\ndone\nprintf '#!/bin/sh\\nprintf \"42\\\\n\"\\nprintf \"unexpected\\\\n\" >&2\\n' > \"$out\"\nchmod 755 \"$out\"\n")
    let stray = child(self, scratch, "stray", "--stray-program", [], ["MINYAR_TEST_CLANG=" + wrapper])
    test.check(stray.result.status != 0, "unexpected stderr passed")
    test.check(test.contains(stray.result.errorOutput, "native output/status/stderr differs"), "unexpected stderr was not an output failure\n" + stray.result.errorOutput)
    test.check(failedManifests(stray.base) == 1, "unexpected stderr did not retain exactly one failed manifest")
}

function scaledTimeoutRecordsEffectiveLimitAndExactFailure(self: Text, scratch: Text) {
    let scaled = child(self, scratch, "scaled-timeout", "--timeout-program", [],
        ["MINYAR_TEST_TIMEOUT_SCALE=3", "MINYAR_TEST_COMPILER=/bin/true", "MINYAR_TEST_RUNTIME=/dev/null"])
    test.check(scaled.result.status != 0 && scaled.result.status != 124 && scaled.result.status != 137, "scaled child did not report its own timeout failure")
    test.check(failedManifests(scaled.base) == 1, "scaled timeout did not retain exactly one failed manifest")
    let manifest = ""
    for name in files.list(scaled.base) {
        let candidate = scaled.base + "/" + name + "/evidence.json"
        if files.pathSize(candidate) >= 0 { manifest = candidate }
    }
    let report = json.parse(io.readTextFile(manifest))
    let commands = json.member(report, "commands")
    test.check(commands.kind == json.ARRAY && commands.items.length == 1, "scaled timeout command count")
    let row = commands.items[0]
    test.check(json.member(row, "timeout").number == 3.0 && json.member(row, "configured_timeout").number == 1.0, "replay uses effective timeout and preserves configured base")
    test.check(json.member(row, "effective_timeout").number == 3.0 && json.member(row, "timeout_scale").number == 3.0, "scaled timeout evidence")
    test.check(json.string(row, "phase") == "timeout-probe" && json.member(row, "timed_out").truth && json.string(row, "exception") == "TimeoutExpired", "scaled timeout phase/status evidence")
    test.check(json.string(row, "stdout_base64") == "dGltZW91dC1yZWFkeQ==", "scaled timeout lost partial output")
    let command = "[\"/bin/sh\",\"-c\",\"printf timeout-ready; exec /bin/sleep 6\"]"
    test.check(evidence.serialize(json.member(row, "command")) == command, "scaled timeout recorded the wrong command")
    let diagnostics = scaled.result.errorOutput
    test.check(test.contains(diagnostics, "phase \"timeout-probe\" (effective limit 3s; configured 1s; scale 3; elapsed "), "scaled timeout diagnostic limits/phase\n" + diagnostics)
    test.check(test.contains(diagnostics, "elapsed " + json.member(row, "elapsed_seconds").text + "s)"), "scaled timeout diagnostic elapsed time\n" + diagnostics)
    test.check(test.contains(diagnostics, "command: " + command), "scaled timeout diagnostic command\n" + diagnostics)
    test.check(test.contains(diagnostics, "evidence: " + manifest) && json.string(report, "workspace") + "/evidence.json" == manifest, "scaled timeout diagnostic evidence path\n" + diagnostics)
}

test.check(processInfo.argumentCount() >= 1, "usage: native-evidence-harness SELF | --file-program PATH CONTENTS | --stray-program | --timeout-program")
let mode = processInfo.argument(0)
if mode == "--file-program" {
    test.check(processInfo.argumentCount() == 3, "usage: --file-program PATH CONTENTS")
    fileProgram(processInfo.argument(1), processInfo.argument(2))
} else if mode == "--stray-program" {
    strayProgram()
} else if mode == "--timeout-program" {
    test.check(processInfo.argumentCount() == 1, "usage: --timeout-program")
    timeoutProgram()
} else {
    test.check(processInfo.argumentCount() == 1, "usage: native-evidence-harness SELF")
    let scratch = test.scratch()
    let clang = test.setting("MINYAR_TEST_CLANG", "clang")
    fileOutputsRequireFreshExactBytesForEveryOptimization(mode, scratch, clang)
    correctStdoutWithUnexpectedStderrIsRejectedAndRetained(mode, scratch)
    scaledTimeoutRecordsEffectiveLimitAndExactFailure(mode, scratch)
    test.removeTree(scratch)
    print("native evidence harness: 3 cases passed")
}
