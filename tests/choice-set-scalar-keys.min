// Requires the qualified scalar-choice predecessor (interface10/delta8).
// This fixture does not enable scalar lowering in the Set implementation.
let flags: Set<Maybe<Boolean>> = Set()
flags.add(None); flags.add(Some(false)); flags.add(Some(true)); flags.add(None)
let optional: Maybe<Set<Maybe<Boolean>>> = Some(flags)
let absent: Maybe<Set<Maybe<Boolean>>> = None
print(flags.length)
print(flags.contains(None))
print(flags.contains(Some(false)))
print(optional == absent)
print(flags.remove(None))
print(flags.contains(None))
print(flags.contains(Some(false)))
print(flags.length)
flags.clear()
print(optional.unwrap().length)
print(optional.isSome())
print(optional == absent)
