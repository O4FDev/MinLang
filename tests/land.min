use "../tools/testing.min" as test
use "system" as system
use "files" as files
function run(args: List<Text>, cwd: Text, work: Text) {
    test.require(test.run(args, system.environment(), cwd, work + "/command", 30), "Git fixture command")
}
let work = test.scratch()
let realGit = "/usr/bin/git"
let bare = work + "/origin.git"
let candidate = work + "/candidate"
let writer = work + "/writer"
run([realGit, "init", "--bare", "--initial-branch=v2", bare], "", work)
run([realGit, "clone", bare, candidate], "", work)
for directory in [candidate] {
    run([realGit, "config", "user.name", "Land control"], directory, work)
    run([realGit, "config", "user.email", "land@example.invalid"], directory, work)
}
writeTextFile(candidate + "/.gitignore", "build/\n")
writeTextFile(candidate + "/value.min", "print(0)\n")
run([realGit, "add", "."], candidate, work)
run([realGit, "commit", "-m", "test(land): initialize control"], candidate, work)
run([realGit, "push", "origin", "v2"], candidate, work)
run([realGit, "clone", bare, writer], "", work)
run([realGit, "config", "user.name", "Land control"], writer, work)
run([realGit, "config", "user.email", "land@example.invalid"], writer, work)
writeTextFile(candidate + "/value.min", "print(42)\n")
run([realGit, "add", "value.min"], candidate, work)
run([realGit, "commit", "-m", "test(land): retain candidate change"], candidate, work)
test.check(files.makeDirectory(work + "/bin") == 0, "private command fixtures")
for directory in [candidate + "/build", candidate + "/build/tooling", candidate + "/build/tooling/scripts"] {
    test.check(files.makeDirectory(directory) == 0, "native check fixture path")
}
let checker = candidate + "/build/tooling/scripts/check-linux"
writeTextFile(checker, "#!/bin/sh\nset -eu\ntest \"$*\" = '--source . --jobs 2 --only check-control'\ntest \"$(cat value.min)\" = 'print(42)'\nprintf 'checked\\n' >> '" + work + "/checks'\n")
writeTextFile(work + "/bin/make", "#!/bin/sh\nset -eu\ntest \"$*\" = '-j2 build/tooling/scripts/check-linux'\n")
let racingGit = "#!/bin/sh\nset -eu\nif [ \"${1-}\" = push ] && [ ! -e '" + work + "/advanced' ]; then\n touch '" + work + "/advanced'\n printf 'upstream\\n' > '" + writer + "/upstream.txt'\n '" + realGit + "' -C '" + writer + "' add upstream.txt\n '" + realGit + "' -C '" + writer + "' commit -qm 'test(land): advance upstream'\n '" + realGit + "' -C '" + writer + "' push origin v2\nfi\nfor argument in \"$@\"; do case \"$argument\" in --force*|-f) exit 91;; esac; done\nexec '" + realGit + "' \"$@\"\n"
writeTextFile(work + "/bin/git", racingGit)
run(["chmod", "+x", checker, work + "/bin/git", work + "/bin/make"], "", work)
let environment: List<Text> = []
for entry in system.environment() { if !test.contains(entry, "PATH=") || !test.contains(Text(Bytes(entry).slice(0, 5)), "PATH=") { environment.add(entry) } }
environment.add("PATH=" + work + "/bin:" + system.getenv("PATH"))
let result = test.run([argument(0), "--jobs", "2", "--only", "check-control"], environment, candidate, work + "/land", 60)
test.require(result, "native land rebases a moving upstream then pushes normally")
test.check(readTextFile(work + "/checks") == "checked\nchecked\n", "both rebased candidates are checked before each push")
test.check(fileExists(candidate + "/upstream.txt"), "upstream change survives rebase")
let local = test.run([realGit, "rev-parse", "HEAD"], system.environment(), candidate, work + "/local", 10)
let remote = test.run([realGit, "rev-parse", "refs/heads/v2"], system.environment(), bare, work + "/remote", 10)
test.require(local, "local final revision")
test.require(remote, "remote final revision")
test.check(local.output == remote.output, "actual remote landing matches tested HEAD")
writeTextFile(candidate + "/untracked.min", "print(1)\n")
let dirty = test.run([argument(0), "--jobs", "2", "--only", "check-control"], environment, candidate, work + "/dirty", 10)
test.check(dirty.status != 0 && test.contains(dirty.errorOutput, "clean worktree"), "dirty worktree rejected before rebase or push")
test.removeTree(work)
print("Minyar native land controls: passed")
