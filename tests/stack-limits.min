use "io" as io
use "../tools/testing.min" as test
use "./sha256-support.min" as flags
use "system" as system

function find(source: Text, needle: Text, begin: Integer): Integer {
    let raw = Bytes(source)
    let pattern = Bytes(needle)
    if raw.length < pattern.length { return -1 }
    for index in begin..(raw.length - pattern.length + 1) {
        let equal = true
        for offset in 0..pattern.length { if raw[index + offset] != pattern[offset] { equal = false; break } }
        if equal { return index }
    }
    return -1
}
let work = test.scratch()
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let options = flags.shellWords(system.getenv("MINYAR_TEST_LINK_FLAGS"))
let message = "Minyar stopped: the program exceeded the maximum call depth.\n"
let cases = 0
for pair in [[8, 3], [2, 7]] {
    let maximum = pair[0]
    let fallback = pair[1]
    for known in [true, false] {
        for optimization in ["-O0", "-O2"] {
            let executable = work + "/limits-" + Text(maximum) + "-" + Text(fallback) + "-" + Text(known) + optimization
            let command = [clang, optimization]
            for flag in options { command.add(flag) }
            command.add("-DMINYAR_MAX_CALL_DEPTH=" + Text(maximum))
            command.add("-DMINYAR_FALLBACK_CALL_DEPTH=" + Text(fallback))
            if !known { command.add("-DMINYAR_TEST_NO_STACK_BOUNDS") }
            for item in ["tests/stack-limits.c", "-o", executable, "-lm"] { command.add(item) }
            test.require(test.run(command, system.environment(), "", executable + ".build", 60), "build exact configured stack bounds")
            let limit = maximum
            if !known && fallback < limit { limit = fallback }
            for count in [1, limit, limit + 1] {
                let result = test.run([executable, Text(count)], system.environment(), "", executable + ".run", 10)
                let expected = 0
                let diagnostic = ""
                if count > limit { expected = 1; diagnostic = message }
                test.check(result.status == expected, "stack boundary status " + Text(maximum) + "/" + Text(fallback) + "/" + Text(known) + "/" + Text(count) + "\n" + result.errorOutput)
                test.check(result.output == "", "stack boundary wrote standard output")
                test.check(result.errorOutput == diagnostic, "stack boundary exact diagnostic\n" + result.errorOutput)
                cases += 1
            }
        }
    }
}
let llvm = work + "/stack-enter.ll"
test.require(test.run([clang, "-O2", "-S", "-emit-llvm", "tests/stack-limits.c", "-o", llvm], system.environment(), "", work + "/guard-build", 60), "build stack guard common-path LLVM")
let source = io.readTextFile(llvm)
let begin = find(source, "@minyar_stack_enter()", 0)
test.check(begin >= 0, "stack guard definition is missing")
let ending = find(source, "\n}\n", begin)
test.check(ending >= begin, "stack guard definition is incomplete")
let body = Text(Bytes(source).slice(begin, ending))
let comparisons = 0
let position = 0
while true {
    let next = find(body, " icmp ", position)
    if next < 0 { break }
    comparisons += 1
    position = next + 6
}
test.check(comparisons == 2, "stack guard common path must contain exactly two comparisons\n" + body)
for name in ["@minyar_stack_bounds_ready", "@minyar_stack_high", "@minyar_find_stack_bounds"] { test.check(!test.contains(body, name), "cold stack bound work entered the guard common path: " + name) }
test.check(cases == 24, "exact stack boundary case count changed")
test.removeTree(work)
print("Stack limits: 24 native/fallback O0/O2 boundaries and two-comparison guard passed")
