// Build Trees with x = x.appended(e), including Lists that hold their own
// owner, so the traced in-place append records edges the collector must see.
record Tree {
    value: Integer
    children: List<Tree>
}

function collect(count: Integer): List<Tree> {
    let children: List<Tree> = []
    let index = 0
    while index < count {
        children = children.appended(Tree { value: index; children: [] })
        index = index + 1
    }
    return children
}

function grow(list: List<Tree>, extra: Tree): List<Tree> {
    // A parameter does not own its List: this must copy, not grow the caller's.
    list = list.appended(extra)
    return list
}

let total = 0
let round = 0
while round < 200 {
    let root = Tree { value: round; children: [] }
    let kids = collect(20)
    let shared = kids
    kids = kids.appended(root)
    root.children = kids
    // root -> kids -> root is a cycle made through an in-place append.
    root.children = root.children.appended(root)
    let longer = grow(shared, root)
    total = total + kids.length + shared.length + longer.length + root.children.length
    round = round + 1
}
print(total)

// Here the in-place append itself closes a cycle: kids holds root, then root
// holds kids. Only the edge recorded by the append lets the collector see it.
let cycles = 0
round = 0
while round < 200 {
    let root = Tree { value: round; children: [] }
    let kids: List<Tree> = []
    kids = kids.appended(Tree { value: -1; children: [] })
    kids = kids.appended(root)
    root.children = kids
    cycles = cycles + root.children.length + kids[1].children.length
    round = round + 1
}
print(cycles)
