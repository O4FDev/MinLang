record Node { value: Integer; next: List<Node> }
record Branch { leaves: List<Leaf> }
record Leaf { parent: Branch }
function ring(size: Integer): Node {
    let first = Node { value: 0; next: [] }
    let last = first
    let i = 1
    while i < size {
        let next = Node { value: i; next: [] }
        last.next.add(next)
        last = next
        i = i + 1
    }
    last.next.add(first)
    return first
}
function replace(node: Node): Node {
    node.next = [node]
    return node
}
function temporary(node: Node, other: Node): Integer {
    return node.value + other.value
}
let self = ring(1)
print(self.next[0].value)
self.next[0] = self
let branch = Branch { leaves: [] }
branch.leaves.add(Leaf { parent: branch })
branch.leaves[0].parent = branch
print(branch.leaves[0].parent.leaves.length)
let chain = ring(300)
print(chain.next[0].next[0].value)
print(temporary(chain.next[0], replace(chain)))
let i = 0
while i < 2000 {
    let garbage = ring(7)
    garbage.next = [garbage]
    i = i + 1
}
print(self.next[0].value)
