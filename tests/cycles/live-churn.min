record Node { value: Integer; next: List<Node> }
function ring(size: Integer): Node {
    let first = Node { value: 0; next: [] }
    let last = first
    let i = 1
    while i < size {
        let next = Node { value: i; next: [] }
        last.next.add(next)
        last = next
        i = i + 1
    }
    last.next.add(first)
    return first
}
let live = ring(1000)
let i = 0
while i < 100000 {
    let garbage = Node { value: i; next: [] }
    garbage.next.add(garbage)
    i = i + 1
}
print(live.next[0].value)
print(i)
