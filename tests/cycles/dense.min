record Node { links: List<Node> }
let round = 0
while round < 5000 {
    let nodes: List<Node> = []
    let i = 0
    while i < 24 {
        nodes.add(Node { links: [] })
        i = i + 1
    }
    i = 0
    while i < nodes.length {
        let j = 0
        while j < nodes.length {
            nodes[i].links.add(nodes[j])
            j = j + 1
        }
        i = i + 1
    }
    round = round + 1
}
print(round)
