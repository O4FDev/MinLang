use "process" as processInfo
use "erofs" as erofs
use "errors" as errors

function require(value: Boolean, message: Text) { if !value { fail(message) } }
let options = erofs.defaults()
require(errors.isError(erofs.writeDirectory("", processInfo.argument(0), options)), "empty source rejected")
require(errors.isError(erofs.writeDirectory(processInfo.argument(0), "", options)), "empty destination rejected")
let nul = Bytes(1)
require(errors.isError(erofs.writeDirectory(processInfo.argument(0) + Text(nul), processInfo.argument(1), options)), "NUL source rejected")
require(errors.isError(erofs.writeDirectory(processInfo.argument(0), processInfo.argument(1) + Text(nul), options)), "NUL destination rejected")
options.maximumBytes = -1
require(errors.isError(erofs.writeDirectory(processInfo.argument(0), processInfo.argument(1), options)), "negative image bound rejected")
options.maximumBytes = 9223372036854775807
require(errors.isError(erofs.writeDirectory(processInfo.argument(0), processInfo.argument(1), options)), "overflowing image bound rejected")
options = erofs.defaults(); options.compression = 99
require(errors.isError(erofs.writeDirectory(processInfo.argument(0), processInfo.argument(1), options)), "unknown compression rejected")
options = erofs.defaults(); options.compression = erofs.ZSTD; options.level = 9223372036854775807
require(errors.isError(erofs.writeDirectory(processInfo.argument(0), processInfo.argument(1), options)), "overflowing compression level rejected")
print("EROFS_API_PASS")
