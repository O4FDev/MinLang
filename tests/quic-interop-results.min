use "../tools/testing.min" as test
use "./quic-interop.min" as interop
use "./quic-json.min" as data
use "./quic-test-support.min" as quic
use "json" as json
use "sha256" as sha256
use "system" as system
use "files" as files

constant FIXTURES = "tests/fixtures/quic-interop/"
constant HANDSHAKE = "{\"abbr\": \"H\", \"name\": \"handshake\", \"result\": \"succeeded\"}"
constant TRANSFER = "{\"abbr\": \"DC\", \"name\": \"transfer\", \"result\": \"succeeded\"}"
constant RETRY = "{\"abbr\": \"S\", \"name\": \"retry\", \"result\": \"succeeded\"}"

record Run { status: Integer; error: Text; manifest: json.Value }

function script(path: Text, body: Text) {
    writeTextFile(path, "#!/bin/sh\n" + body)
    test.require(test.run(["chmod", "755", path], system.environment(), "", path + ".chmod", 10), "fake tool mode")
}
function parsed(source: Text): json.Value {
    let value = json.parse(source)
    test.check(value.kind != json.INVALID, "invalid fixture JSON: " + source)
    return value
}
function valid(): json.Value { return data.decode(readBytesFile(FIXTURES + "succeeded-ngtcp2.json")) }
function results(matrix: json.Value, source: Text): json.Value { return data.with(matrix, "results", parsed(source)) }

function invoke(matrix: Bytes, present: Boolean, servers: Text, clients: Text, cases: Text, runnerStatus: Integer, mustInclude: Text, expected: Integer): Run {
    let work = test.scratch()
    let runner = work + "/runner"
    let artifacts = work + "/artifacts"
    let tools = work + "/tools"
    for path in [runner, artifacts, tools] { test.check(files.makeDirectory(path) == 0, "cannot create controller fixture") }
    writeTextFile(runner + "/implementations_quic.json", "{}")
    writeTextFile(runner + "/docker-compose.yml", "services: {}\n")
    let matrixPath = artifacts + "/matrix.json"
    if present { writeBytesFile(matrixPath, matrix) }
    script(tools + "/tshark", "printf 'TShark (Wireshark) 4.6.0\\n'\n")
    script(tools + "/git", "printf 'frozen-runner\\n'\n")
    script(tools + "/docker", "printf '%s\\n' \"$*\" >>\"" + work + "/docker.log\"\nprintf 'frozen-runner\\n'\n")
    script(tools + "/python", "exit " + Text(runnerStatus) + "\n")
    let environment = quic.setting(system.environment(), "MINYAR_REMOTE_LOAD", "1")
    let outcome = interop.control(interop.Options { runner: runner; artifacts: artifacts; servers: servers; clients: clients; tests: cases; mustInclude: mustInclude
        temporary: work + "/runner-tmp"; python: tools + "/python"; tshark: tools + "/tshark"; docker: tools + "/docker"; git: tools + "/git"; platform: "Linux"; effectiveUser: 0
        environment: environment; deadline: 3600; controller: FIXTURES + "README.md" })
    if outcome.error != "" {
        test.check(files.pathSize(artifacts + "/manifest.json") < 0, "rejected controller selection wrote a manifest")
        test.removeTree(work)
        return Run { status: outcome.status; error: outcome.error; manifest: data.none() }
    }
    let calls = 0
    for line in test.lines(readTextFile(work + "/docker.log")) { if quic.starts(line, "compose ") { calls += 1 } }
    test.check(calls == 1, "official runner cleanup was not called exactly once")
    if expected >= 0 { test.check(outcome.status == expected, "unexpected controller status " + Text(outcome.status)) }
    let manifest = data.decode(readBytesFile(artifacts + "/manifest.json"))
    test.check(data.isObject(manifest), "controller manifest is not a JSON object")
    test.check(data.equal(manifest, data.decode(Bytes(outcome.manifest))), "printed controller manifest differs from the retained manifest")
    if present {
        test.check(Text(readBytesFile(matrixPath)) == Text(matrix), "controller rewrote official raw JSON")
        test.check(data.equalsText(data.field(manifest, "matrix_sha256"), sha256.hex(sha256.digest(matrix))), "official matrix hash mismatch")
        test.check(data.equalsInteger(data.field(manifest, "matrix_bytes"), matrix.length), "official matrix size mismatch")
    }
    test.check(data.equalsInteger(data.field(manifest, "runner_status"), runnerStatus), "runner status was not preserved")
    test.check(data.equalsInteger(data.field(manifest, "status"), outcome.status), "manifest status differs from the controller status")
    let registry = data.decode(readBytesFile(runner + "/implementations_quic.json"))
    test.check(data.equalsText(data.field(data.field(registry, "minyar"), "image"), interop.IMAGE), "controller did not register the Minyar image")
    test.removeTree(work)
    return Run { status: outcome.status; error: ""; manifest: manifest }
}
function matrixRun(matrix: json.Value, servers: Text, clients: Text, cases: Text, runnerStatus: Integer): Run {
    return invoke(Bytes(data.dumps(matrix)), true, servers, clients, cases, runnerStatus, "minyar", -1)
}
function validation(run: Run): json.Value { return data.field(run.manifest, "result_validation") }
function failedValidation(run: Run): Boolean { return data.equalsText(data.field(validation(run), "status"), "failed") }

let controls = 0

let unsupported = invoke(readBytesFile(FIXTURES + "unsupported-quinn.json"), true, "minyar", "quinn", "handshake,transfer,retry", 0, "minyar", 1)
test.check(unsupported.status == 1 && failedValidation(unsupported), "all-unsupported official result passed")
test.check(test.contains(data.field(validation(unsupported), "error").text, "handshake"), "unsupported verdict does not name handshake")
controls += 1

for version in ["TShark (Wireshark) 4.2.2", "unidentified tshark"] {
    let check = interop.tshark(version)
    test.check(!check.ok && test.contains(check.error, "4.5.0 or newer"), "unsupported tshark accepted: " + version)
    controls += 1
}
for version in ["TShark (Wireshark) 4.5.0", "TShark (Wireshark) 4.6.0"] {
    let check = interop.tshark(version)
    test.check(check.ok && check.value == version, "supported tshark rejected: " + version)
    controls += 1
}

let peers = [["succeeded-multipeer.json", "quiche,msquic", "minyar", "handshake,transfer", "4"], ["succeeded-ngtcp2.json", "minyar", "ngtcp2", "handshake,transfer,retry", "3"]]
for row in peers {
    let run = invoke(readBytesFile(FIXTURES + row[0]), true, row[1], row[2], row[3], 0, "minyar", -1)
    test.check(run.status == 0 && data.equalsText(data.field(validation(run), "status"), "succeeded"), "official success rejected: " + row[0])
    test.check(data.equalsInteger(data.field(validation(run), "succeeded_cases"), Integer(row[4])), "official success case count differs: " + row[0])
    controls += 1
}

let malformed = ["", "{", "[]", "null", "{}", "{\"servers\":[],\"servers\":[]}"]
let missing = invoke(Bytes(), false, "minyar", "ngtcp2", "handshake,transfer,retry", 0, "minyar", -1)
test.check(missing.status == 1 && failedValidation(missing), "missing official JSON passed")
controls += 1
for source in malformed {
    let run = invoke(Bytes(source), true, "minyar", "ngtcp2", "handshake,transfer,retry", 0, "minyar", -1)
    test.check(run.status == 1 && failedValidation(run), "malformed official JSON passed: " + source)
    controls += 1
}

let base = valid()
let row = parsed(HANDSHAKE)
let cellMutations = [
    "[]",
    "[[]]",
    "[[" + HANDSHAKE + ", " + TRANSFER + "]]",
    "[[{\"abbr\": \"H\", \"name\": \"handshake\", \"result\": null}, " + TRANSFER + ", " + RETRY + "]]",
    "[[{\"abbr\": \"H\", \"name\": \"handshake\", \"result\": \"failed\"}, " + TRANSFER + ", " + RETRY + "]]",
    "[[{\"abbr\": \"H\", \"name\": \"handshake\", \"result\": \"unsupported\"}, " + TRANSFER + ", " + RETRY + "]]",
    "[[{\"abbr\": \"H\", \"name\": \"handshake\"}, " + TRANSFER + ", " + RETRY + "]]",
    "[[{\"abbr\": \"H\", \"name\": \"other\", \"result\": \"succeeded\"}, " + TRANSFER + ", " + RETRY + "]]",
    "[[{\"abbr\": \"other\", \"name\": \"handshake\", \"result\": \"succeeded\"}, " + TRANSFER + ", " + RETRY + "]]",
    "[[" + HANDSHAKE + ", " + TRANSFER + ", " + RETRY + ", " + data.dumps(row) + "]]",
    "[[" + HANDSHAKE + ", " + TRANSFER + ", " + RETRY + ", {\"name\": \"handshake\", \"abbr\": \"different\", \"result\": \"succeeded\"}]]",
    "{\"0\": [" + HANDSHAKE + ", " + TRANSFER + ", " + RETRY + "]}",
    "[null]"
]
test.check(data.equal(data.field(base, "results"), parsed("[[" + HANDSHAKE + ", " + TRANSFER + ", " + RETRY + "]]")), "official success fixture changed")
for source in cellMutations {
    test.check(matrixRun(results(valid(), source), "minyar", "ngtcp2", "handshake,transfer,retry", 0).status == 1, "malformed official cell passed: " + source)
    controls += 1
}

let metadata = data.field(base, "tests")
let renamed = data.with(metadata, "H", data.with(data.field(metadata, "H"), "name", data.string("different")))
let axisMutations = [
    data.with(valid(), "servers", data.strings(["quiche"])),
    data.with(valid(), "clients", data.strings(["quinn"])),
    data.with(valid(), "clients", data.strings([])),
    data.with(valid(), "servers", data.strings(["minyar", "minyar"])),
    data.with(valid(), "tests", data.object([], [])),
    data.with(valid(), "tests", renamed),
    data.with(valid(), "tests", data.with(metadata, "X", data.object(["name"], [data.string("handshake")]))),
    data.with(valid(), "tests", data.with(metadata, "H", data.none())),
    results(valid(), "[[" + HANDSHAKE + ", " + TRANSFER + ", " + RETRY + "], []]")
]
for matrix in axisMutations {
    test.check(matrixRun(matrix, "minyar", "ngtcp2", "handshake,transfer,retry", 0).status == 1, "mismatched official axes or metadata passed")
    controls += 1
}

let succeeded = "[" + HANDSHAKE + ", " + TRANSFER + ", " + RETRY + "]"
let unsupportedCell = "[{\"abbr\": \"H\", \"name\": \"handshake\", \"result\": null}, {\"abbr\": \"DC\", \"name\": \"transfer\", \"result\": null}, {\"abbr\": \"S\", \"name\": \"retry\", \"result\": null}]"
let crossed = data.with(data.with(valid(), "servers", data.strings(["minyar", "quiche"])), "clients", data.strings(["msquic", "minyar"]))
let major = matrixRun(results(crossed, "[" + succeeded + ", " + unsupportedCell + ", " + succeeded + ", " + succeeded + "]"), "quiche,minyar", "minyar,msquic", "handshake,transfer,retry", 0)
test.check(major.status == 0 && data.equalsInteger(data.field(validation(major), "succeeded_cases"), 9), "client-major official selection failed")
test.check(data.equal(data.field(validation(major), "pairs"), parsed("[{\"server\": \"minyar\", \"client\": \"msquic\"}, {\"server\": \"minyar\", \"client\": \"minyar\"}, {\"server\": \"quiche\", \"client\": \"minyar\"}]")), "client-major official pairs differ")
let lastCell = "[{\"abbr\": \"H\", \"name\": \"handshake\", \"result\": null}, " + TRANSFER + ", " + RETRY + "]"
test.check(matrixRun(results(crossed, "[" + succeeded + ", " + unsupportedCell + ", " + succeeded + ", " + lastCell + "]"), "quiche,minyar", "minyar,msquic", "handshake,transfer,retry", 0).status == 1, "mandatory client-major cell was ignored")
controls += 2

let preserved = matrixRun(valid(), "minyar", "ngtcp2", "handshake,transfer,retry", 13)
test.check(preserved.status == 13 && data.equalsText(data.field(validation(preserved), "status"), "succeeded"), "nonzero runner status was replaced")
let preservedFailure = invoke(readBytesFile(FIXTURES + "unsupported-quinn.json"), true, "minyar", "quinn", "handshake,transfer,retry", 23, "minyar", -1)
test.check(preservedFailure.status == 23 && failedValidation(preservedFailure), "nonzero runner status was replaced after failed validation")
controls += 2

let rejectedSelections = [["minyar", "ngtcp2", "", "minyar"], ["minyar", "ngtcp2", "handshake,handshake", "minyar"], ["minyar,minyar", "ngtcp2", "handshake,transfer,retry", "minyar"], ["minyar", "ngtcp2", "handshake,transfer,retry", "minyar,quiche"]]
for selection in rejectedSelections {
    let run = invoke(Bytes(data.dumps(valid())), true, selection[0], selection[1], selection[2], 0, selection[3], -1)
    test.check(run.error != "", "invalid controller selection accepted: " + quic.joined(selection, " "))
    controls += 1
}
test.check(invoke(Bytes(data.dumps(valid())), true, "minyar", "ngtcp2", "handshake,transfer,retry", 0, "absent", -1).status == 1, "selection without the required implementation passed")
controls += 1
print("QUIC interop results: " + Text(controls) + " controls passed")
