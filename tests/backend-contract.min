use "../tools/testing.min" as test
use "system" as system

let directory = test.scratch()
for backend in ["native", "swift"] {
    let result = test.run(["./minyar", "--backend", backend, "--help"], system.environment(), "", directory + "/" + backend, 30)
    test.check(result.status == 2, "a backend option silently selected the Swift dialect")
    test.check(test.contains(result.errorOutput, "experimental"), "backend migration diagnostic omitted the experimental command")
}
let help = test.run(["./minyar", "--help"], system.environment(), "", directory + "/help", 30)
test.require(help, "read CLI help")
test.check(test.contains(help.output, "--backend llvm"), "CLI omitted the main language backend")
test.check(test.contains(help.output, "--experimental-swift"), "CLI omitted the explicit Swift experiment")
test.removeTree(directory)
print("Backend language contract: passed")
