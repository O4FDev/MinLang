use "erofs" as erofs
use "errors" as errors

thread function worker(seed: Integer, input: FrozenBytes, channel: BytesChannel): Integer { return seed }
function main() {
    nativeThreadSetup()
    let source = argument(0)
    let error = erofs.writeLayers([source + "/base.tar", source + "/additions.tar", source + "/upper.tar.zstd"], argument(1), erofs.defaults())
    if errors.isError(error) { fail(errors.message(error)) }
    let channel = bytesChannel(0, 1)
    let handle = startThread(worker, 42, freezeBytes(Bytes()), channel)
    if joinThread(handle) != 42 { fail("erofs layers thread result") }
    closeBytesChannel(channel)
    print("EROFS_LAYERS_MAIN_PASS")
}
