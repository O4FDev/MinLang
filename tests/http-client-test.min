// Keep-alive and streaming for the portable http Client at O0 and release, against a local fixture server.
use "./net-fixtures.min" as fixtures
use "../tools/testing.min" as test

fixtures.arguments([], [])
let context = fixtures.context(false)
let expected = "200 OK hello\nabcdefgh in 5 pieces\nlarge 300000 true true\nHEAD 200 no body\necho 7:payload\ncontinue 204\nconnections 1\nrequests on the first connection 7\ndropped\nafter drop hello connections 2\nuntil close\nafter close hello connections 3\nabandoned after 10\nrequests on a fresh connection 1, client opened 4\nrejected: an HTTP request target starts with /\nrejected: invalid http:// or https:// origin: ftp://127.0.0.1/\nidle read 0\nbye\n"
for mode in ["--debug", "--release"] {
    let server = context.work + "/server" + mode
    let client = context.work + "/client" + mode
    for pair in [["tests/http-client/server.min", server], ["tests/http-client/client.min", client]] {
        let built = fixtures.run(context, [context.root + "/minyar", mode, "--library", context.root + "/library", context.root + "/" + pair[0], "-o", pair[1]], 600)
        test.check(built.status == 0, "build " + pair[0] + " " + mode + "\n" + built.output + built.errorOutput)
    }
    let process = fixtures.launch(context, [server], 60)
    let port = fixtures.ready(context, process)
    let result = fixtures.run(context, [client, Text(port)], 60)
    let served = fixtures.collect(process)
    test.check(result.status == 0 && result.output == expected && result.errorOutput == "", "http client " + mode + "\n" + result.output + result.errorOutput)
    test.check(served.status == 0, "fixture server " + mode + "\n" + served.output + served.errorOutput)
}
fixtures.finish(context)
print("http client: keep-alive reuse and reconnects, chunked/length/close-delimited streaming at O0/release")
