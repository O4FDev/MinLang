test.check(io.readTextFile(existing + "/.gitignore") == "custom\n" && io.readTextFile(existing + "/tests/smoke.min") == "print(\"custom test\")\n", "init preserves user files")
io.writeTextFile(existing + "/src/main.min", test.sourceModules("print(\"not the library entry\")\n"))
test.check(test.contains(success(fixture, ["build"], existing).output, "/src/existing.min"), "explicit library kind wins over an unrelated main file")
io.writeTextFile(existing + "/Minyar.toml", "[package]\nname = \"existing\"\nversion = \"0.1.0\"\nkind = \"plugin\"\n")
rejected(fixture, ["metadata"], existing, "package.kind must be bin or lib")
// API lookup works outside any project: a module, one declaration, a member
// of a capability, and a search over every standard module's public names.
let outside = fixture.work + "/no project"
files.makeDirectory(outside)
let moduleView = success(fixture, ["doc", "disk"], outside).output
test.check(test.contains(moduleView, "use \"disk\" as disk") && test.contains(moduleView, "public capability Disk") && test.contains(moduleView, "public function simulated(world: simulation.World): SimulatedDisk"), "doc MODULE lists the public signatures\n" + moduleView)
let declaration = success(fixture, ["doc", "files.openFile"], outside).output
test.check(test.contains(declaration, "public function openFile(path: Text, flags: Integer): Result<Integer, errors.Error>"), "doc MODULE.NAME prints one declaration\n" + declaration)
let member = success(fixture, ["doc", "disk.Disk.sync"], outside).output
test.check(test.contains(member, "function sync(file: Integer): Result<Nothing, errors.Error>") && test.contains(member, "Makes the file's contents durable."), "doc MODULE.TYPE.MEMBER prints the member and its comment\n" + member)
let search = success(fixture, ["doc", "spawnSelf"], outside).output
test.check(test.contains(search, "workers.spawnSelf"), "doc WORD searches every module\n" + search)
let missing = invoke(fixture, ["doc", "noSuchNameAnywhere"], outside)
