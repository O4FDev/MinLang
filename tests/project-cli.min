test.check(forwarded.status == 7 && test.contains(forwarded.output, "a b\n$(touch SHOULD_NOT_EXIST); 'quoted'"), "literal arguments and exit code")
test.check(!io.fileExists(application + "/SHOULD_NOT_EXIST"), "arguments never enter a shell")
io.writeTextFile(application + "/src/main.min", test.sourceModules("print(\"working\")\n"))
io.writeTextFile(application + "/tests/fails.min", test.sourceModules("exit(9)\n"))
let failedTests = invoke(fixture, ["test"], application)
test.check(failedTests.status != 0 && test.contains(failedTests.output, "1 passed; 1 failed"), "test failure aggregation continues to later tests")
success(fixture, ["test", "smoke"], application)
test.check(files.remove(application + "/tests/fails.min") == 0, "remove failing fixture")
io.writeTextFile(application + "/tests/arguments.min", test.sourceModules("if processInfo.argumentCount() != 1 || processInfo.argument(0) != \"a b\" { fail(\"test args\") }\n"))
success(fixture, ["test", "arguments", "--", "a b"], application)
test.check(files.remove(application + "/tests/arguments.min") == 0, "remove argument fixture")
