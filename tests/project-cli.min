test.removeTree(installedSymbols)
success(fixture, ["remove", "geometry"], application)
io.writeTextFile(application + "/src/main.min", test.sourceModules("print(\"independent\")\n"))
success(fixture, ["build", "--manifest-path", application + "/Minyar.toml", "--no-incremental"], fixture.work)
success(fixture, ["clean"], application)
test.check(!io.fileExists(application + "/target/debug/greeting") && io.fileExists(application + "/src/main.min"), "clean preserves sources")
test.check(files.makeDirectory(application + "/target") == 0, "unowned target fixture")
io.writeTextFile(application + "/target/precious", "keep me\n")
rejected(fixture, ["clean"], application, "unowned target")
test.check(io.readTextFile(application + "/target/precious") == "keep me\n", "unowned directory survives")
rejected(fixture, ["build"], application, "unowned target")
test.check(files.remove(application + "/target/precious") == 0 && files.removeDirectory(application + "/target") == 0, "remove unowned fixture")
