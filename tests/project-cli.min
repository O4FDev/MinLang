rejected(fixture, ["clean"], application, "real directory")
rejected(fixture, ["build"], application, "real directory")
test.check(io.fileExists(library + "/src/geometry.min"), "symlink destination survives")
test.check(files.remove(application + "/target") == 0, "unlink target fixture")
// minyar new --extension: a host project's extension-template becomes a new library, paths rewritten
let hostProject = fixture.work + "/host db"
success(fixture, ["new", hostProject, "--name", "hostdb"], fixture.work)
success(fixture, ["new", hostProject + "/sdk", "--name", "hostsdk", "--lib"], fixture.work)
rejected(fixture, ["new", fixture.work + "/no-template", "--extension", hostProject], fixture.work, "has no extension template")
