test.check(io.readTextFile(leaf + "/Minyar.toml") == originalLeaf, "invalid dependency edit preserves the manifest")
io.writeTextFile(leaf + "/Minyar.toml", originalLeaf + "geometry = { path = \"../geometry\" }\n")
rejected(fixture, ["tree"], application, "dependency cycle")
io.writeTextFile(leaf + "/Minyar.toml", originalLeaf)
let manifest = io.readTextFile(application + "/Minyar.toml")
io.writeTextFile(application + "/Minyar.toml", manifest + "geometry = { path = \"../geometry\" }\n")
rejected(fixture, ["metadata"], application, "duplicate key")
io.writeTextFile(application + "/Minyar.toml", "[package]\nname = \"greeting\"\nversion = \"0.1.0\"\nunknown = \"value\"\n")
rejected(fixture, ["metadata"], application, "unknown package key")
io.writeTextFile(application + "/Minyar.toml", manifest)
rejected(fixture, ["add", "geometry", "--path", leaf], application, "library named geometry")
let dependentMain = io.readTextFile(application + "/src/main.min")
io.writeTextFile(application + "/src/main.min", "use \"geometry\" as geometry\nuse \"cartography\" as cartography\nprint(geometry.answer())\n")
rejected(fixture, ["check"], application, "no package named 'cartography': it is neither a dependency in Minyar.toml nor a standard module (there is no ")
io.writeTextFile(application + "/src/main.min", dependentMain)
success(fixture, ["install", "--release", "--root", prefix], application)
let installed = external(fixture, [prefix + "/bin/greeting"], application)
test.require(installed, "installed executable runs")
test.check(test.contains(installed.output, "51"), "installed executable is the built program")
rejected(fixture, ["install", "--root", prefix], application, "already exists")
success(fixture, ["install", "--force", "--root", prefix], application)
let installedBinary = prefix + "/bin/greeting"
let installedSymbols = installedBinary + ".dSYM"
if darwin {
    test.check(io.fileExists(installedSymbols + "/Contents/Info.plist"), "default debug install carries its dSYM")
    test.require(external(fixture, ["cmp", application + "/target/debug/greeting.dSYM/Contents/Resources/DWARF/greeting", installedSymbols + "/Contents/Resources/DWARF/greeting"], fixture.work), "installed symbols match the built binary")
}
test.require(external(fixture, ["cp", installedBinary, fixture.work + "/installed-before-failure"], fixture.work), "snapshot installed binary")
if darwin { test.require(external(fixture, ["cp", "-RP", installedSymbols, fixture.work + "/symbols-before-failure"], fixture.work), "snapshot installed symbols") }
let installedSource = io.readTextFile(application + "/src/main.min")
io.writeTextFile(application + "/src/main.min", test.sourceModules("let broken =\n"))
let failedInstall = invoke(fixture, ["install", "--force", "--root", prefix], application)
test.check(failedInstall.status != 0, "failed build rejects replacement installation")
test.require(external(fixture, ["cmp", installedBinary, fixture.work + "/installed-before-failure"], fixture.work), "failed install preserves executable")
if darwin { test.require(external(fixture, ["diff", "-r", installedSymbols, fixture.work + "/symbols-before-failure"], fixture.work), "failed install preserves symbols") }
io.writeTextFile(application + "/src/main.min", test.sourceModules(installedSource))
if darwin {
    test.check(files.rename(installedSymbols, installedSymbols + ".saved") == 0, "retain owned symbol bundle")
    test.require(external(fixture, ["ln", "-s", installedSymbols + ".saved", installedSymbols], fixture.work), "symlink replacement symbol fixture")
    rejected(fixture, ["install", "--force", "--release", "--root", prefix], application, "symlinked debug symbols")
    rejected(fixture, ["uninstall", "greeting", "--root", prefix], fixture.work, "symlinked debug symbols")
    test.check(io.fileExists(installedSymbols + ".saved/Contents/Info.plist") && io.fileExists(installedBinary), "symlink rejection preserves installation and external bundle")
    test.check(files.remove(installedSymbols) == 0 && files.rename(installedSymbols + ".saved", installedSymbols) == 0, "restore owned symbols")
}
success(fixture, ["install", "--force", "--release", "--root", prefix], application)
test.check(!io.fileExists(installedSymbols + "/Contents/Info.plist"), "release replacement removes stale installed symbols")
success(fixture, ["install", "--force", "--root", prefix], application)
if darwin { test.check(io.fileExists(installedSymbols + "/Contents/Info.plist"), "debug replacement reinstalls matching symbols") }
success(fixture, ["uninstall", "greeting", "--root", prefix], fixture.work)
test.check(!io.fileExists(prefix + "/bin/greeting"), "uninstall removes the binary")
