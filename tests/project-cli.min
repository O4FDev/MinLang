io.writeTextFile(hostProject + "/extension-template/src/{{name}}.min", test.sourceModules("use \"hostsdk\" as sdk\npublic function describe(): Text { return \"{{name}} \" + Text(sdk.answer()) }\n"))
let extension = fixture.work + "/extensions/sparkle"
