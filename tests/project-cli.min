use "io" as io
use "process" as processInfo
// End-to-end user workflows through the public launcher, with real compilation.
use "../tools/testing.min" as test
use "system" as system
use "files" as files

record Fixture { launcher: Text; work: Text; serial: Integer }
function invoke(fixture: Fixture, arguments: List<Text>, directory: Text): test.Result {
    fixture.serial += 1
    let command = [fixture.launcher]
    for item in arguments { command.add(item) }
    return test.run(command, system.environment(), directory, fixture.work + "/command-" + Text(fixture.serial), 600)
}
function success(fixture: Fixture, arguments: List<Text>, directory: Text): test.Result {
    let result = invoke(fixture, arguments, directory)
    test.require(result, "project CLI " + arguments[0])
    return result
}
function rejected(fixture: Fixture, arguments: List<Text>, directory: Text, message: Text) {
    let result = invoke(fixture, arguments, directory)
    test.check(result.status != 0 && test.contains(result.errorOutput, message), "expected rejection: " + message + "\n" + result.output + result.errorOutput)
}
function external(fixture: Fixture, arguments: List<Text>, directory: Text): test.Result {
    fixture.serial += 1
    return test.run(arguments, system.environment(), directory, fixture.work + "/external-" + Text(fixture.serial), 60)
}
let fixture = Fixture { launcher: processInfo.argument(0); work: test.scratch(); serial: 0 }
let application = fixture.work + "/app with spaces"
let library = fixture.work + "/geometry"
let leaf = fixture.work + "/leaf"
let prefix = fixture.work + "/installation with spaces"
let darwin = test.contains(external(fixture, ["uname", "-s"], fixture.work).output, "Darwin")
let helped = success(fixture, ["help"], fixture.work)
test.check(test.contains(helped.output, "Minyar project CLI"), "project help")
let collision = fixture.work + "/launcher-collision"
let protected = fixture.work + "/toolchain prefix"
success(fixture, ["new", collision, "--name", "minyar"], fixture.work)
test.require(external(fixture, ["mkdir", "-p", protected + "/bin"], fixture.work), "private toolchain prefix")
for marker in ["# Managed by Minyar toolchains (v1)\n", "# Installed by Minyar; self-contained toolchain\n"] {
    let launcher = "#!/bin/sh\n" + marker + "printf 'preserved toolchain\\n'\n"
    io.writeTextFile(protected + "/bin/minyar", launcher)
    rejected(fixture, ["install", "--force", "--root", protected], collision, "toolchain launcher")
    test.check(io.readTextFile(protected + "/bin/minyar") == launcher, "forced package installs preserve managed and legacy launchers")
    test.check(!io.fileExists(collision + "/target/debug/minyar"), "launcher collisions fail before compiling")
    io.writeTextFile(protected + "/bin/.minyar-installed-minyar", "minyar-installed-v1\n")
    rejected(fixture, ["uninstall", "minyar", "--root", protected], fixture.work, "toolchain launcher")
    test.check(io.readTextFile(protected + "/bin/minyar") == launcher, "a stale package marker never authorizes removing a toolchain")
    test.check(files.remove(protected + "/bin/.minyar-installed-minyar") == 0, "remove the private stale marker")
}
let separate = fixture.work + "/separate prefix"
success(fixture, ["install", "--release", "--root", separate], collision)
test.check(test.contains(external(fixture, [separate + "/bin/minyar"], fixture.work).output, "Hello, world!"), "a package named minyar may use its own prefix")
success(fixture, ["uninstall", "minyar", "--root", separate], fixture.work)
success(fixture, ["new", application, "--name", "greeting"], fixture.work)
test.check(io.fileExists(application + "/Minyar.toml") && io.fileExists(application + "/src/main.min"), "binary scaffold")
test.check(test.contains(io.readTextFile(application + "/Minyar.toml"), "kind = \"bin\""), "binary kind is explicit")
let atomicApplication = fixture.work + "/atomic-project"
let atomicLibrary = fixture.work + "/atomic-library"
success(fixture, ["new", atomicApplication, "--name", "atomicapp"], fixture.work)
success(fixture, ["new", atomicLibrary, "--name", "atomiclib", "--lib"], fixture.work)
let atomicWrapper = fixture.work + "/atomic-publish.sh"
io.writeTextFile(atomicWrapper, "#!/bin/sh\nlauncher=$1\nvictim=$2\ntemporary=$3\nshift 3\n/bin/ln -s \"$victim\" \"$temporary.tmp-$$\" || exit 91\nexec \"$launcher\" \"$@\"\n")
test.require(external(fixture, ["chmod", "+x", atomicWrapper], fixture.work), "atomic publication wrapper")
let lockVictim = fixture.work + "/lock-victim"
io.writeTextFile(lockVictim, "SAFE lock\n")
test.require(external(fixture, [atomicWrapper, fixture.launcher, lockVictim, atomicApplication + "/Minyar.lock", "metadata"], atomicApplication), "lock publication rejects predictable staging symlink")
test.check(io.readTextFile(lockVictim) == "SAFE lock\n" && io.fileExists(atomicApplication + "/Minyar.lock"), "lock publication uses private unpredictable staging")
let manifestVictim = fixture.work + "/manifest-victim"
io.writeTextFile(manifestVictim, "SAFE manifest\n")
test.require(external(fixture, [atomicWrapper, fixture.launcher, manifestVictim, atomicApplication + "/Minyar.toml", "add", "atomiclib", "--path", atomicLibrary], atomicApplication), "manifest publication rejects predictable staging symlink")
test.check(io.readTextFile(manifestVictim) == "SAFE manifest\n" && test.contains(io.readTextFile(atomicApplication + "/Minyar.toml"), "atomiclib ="), "manifest publication uses private unpredictable staging")
let mainBinary = fixture.work + "/main"
success(fixture, ["new", mainBinary], fixture.work)
test.check(test.contains(success(fixture, ["run"], mainBinary).output, "Hello, world!"), "main is a valid binary package name")
io.writeTextFile(mainBinary + "/Minyar.toml", "[package]\nname = \"main\"\nversion = \"0.1.0\"\n")
test.check(test.contains(success(fixture, ["run"], mainBinary).output, "Hello, world!"), "legacy main manifests infer a binary")
success(fixture, ["install", "--root", prefix], mainBinary)
success(fixture, ["uninstall", "main", "--root", prefix], fixture.work)
let portable = fixture.work + "/portable"
let portableApp = portable + "/consumer"
let mainLibrary = portable + "/main-library"
success(fixture, ["new", mainLibrary, "--name", "main", "--lib"], fixture.work)
test.check(test.contains(io.readTextFile(mainLibrary + "/Minyar.toml"), "kind = \"lib\""), "library kind disambiguates main")
success(fixture, ["build"], mainLibrary)
success(fixture, ["test"], mainLibrary)
test.check(!io.fileExists(mainLibrary + "/target/debug/main"), "main library build validates without making a binary")
rejected(fixture, ["run"], mainLibrary, "binary package")
rejected(fixture, ["install", "--root", prefix], mainLibrary, "binary package")
success(fixture, ["new", portableApp], fixture.work)
rejected(fixture, ["add", "main", "--path", mainBinary], portableApp, "library named main")
success(fixture, ["add", "main", "--path", "../../main-library"], portableApp + "/src")
test.check(test.contains(io.readTextFile(portableApp + "/Minyar.toml"), "path = \"../main-library\""), "nested add records a manifest-relative path")
let mixed = portable + "/mixed"
success(fixture, ["new", mixed], fixture.work)
io.writeTextFile(mixed + "/src/mixed.min", test.sourceModules("public function answer(): Integer { return 3 }\n"))
success(fixture, ["add", "mixed", "--path", "../../mixed"], portableApp + "/src")
io.writeTextFile(portableApp + "/src/consumer.min", test.sourceModules("public function answer(): Integer { return 7 }\n"))
io.writeTextFile(portableApp + "/src/main.min", test.sourceModules("use \"main\" as library\nuse \"consumer\" as own\nuse \"mixed\" as mixed\nprint(library.answer() + own.answer() + mixed.answer())\n"))
test.check(test.contains(success(fixture, ["run"], portableApp).output, "52"), "main library and mixed package exports remain consumable beside binary entry files")
let portableLock = io.readTextFile(portableApp + "/Minyar.lock")
let relocated = fixture.work + "/relocated"
test.check(files.rename(portable, relocated) == 0, "move sibling packages together")
let relocatedMetadata = success(fixture, ["metadata", "--locked"], relocated + "/consumer/src")
test.check(test.contains(relocatedMetadata.output, relocated + "/main-library/Minyar.toml"), "locked metadata resolves moved sibling packages")
test.check(io.readTextFile(relocated + "/consumer/Minyar.lock") == portableLock, "relocation preserves the lockfile")
rejected(fixture, ["new", application], fixture.work, "already exists")
rejected(fixture, ["init"], application, "refusing to overwrite")
let ran = success(fixture, ["run"], application)
test.check(test.contains(ran.output, "Hello, world!"), "real compiled binary runs")
test.check(io.fileExists(application + "/target/debug/greeting"), "debug binary layout")
test.check(io.fileExists(application + "/Minyar.lock"), "graph lock generated")
io.writeTextFile(application + "/src/main.min", test.sourceModules("let broken =\n"))
let broken = invoke(fixture, ["build"], application)
test.check(broken.status != 0, "invalid source rejects build")
let preserved = external(fixture, [application + "/target/debug/greeting"], application)
test.require(preserved, "previous executable survives failed compilation")
test.check(test.contains(preserved.output, "Hello, world!"), "failed build preserves the prior program")
io.writeTextFile(application + "/src/main.min", test.sourceModules("print(\"Hello, world!\")\n"))
success(fixture, ["build", "--release", "--locked"], application)
test.check(io.fileExists(application + "/target/release/greeting"), "release binary layout")
let defaultManifest = io.readTextFile(application + "/Minyar.toml")
let manifestParts = defaultManifest.split("kind = \"bin\"\n")
test.check(manifestParts.length == 2, "scaffold manifest declares its kind once")
let systemRelease = fixture.work + "/greeting-system"
test.require(external(fixture, ["cp", application + "/target/release/greeting", systemRelease], application), "keep the default release program")
io.writeTextFile(application + "/Minyar.toml", manifestParts[0] + "kind = \"bin\"\nmemory = \"eager\"\n" + manifestParts[1])
success(fixture, ["build", "--release"], application)
test.check(test.contains(external(fixture, [application + "/target/release/greeting"], application).output, "Hello, world!"), "eager memory profile program runs")
test.check(external(fixture, ["cmp", "-s", systemRelease, application + "/target/release/greeting"], application).status != 0, "package.memory changes the compiled reclamation profile")
io.writeTextFile(application + "/Minyar.toml", manifestParts[0] + "kind = \"bin\"\nmemory = \"fast\"\n" + manifestParts[1])
rejected(fixture, ["build"], application, "package.memory must be eager or system")
io.writeTextFile(application + "/Minyar.toml", manifestParts[0] + "kind = \"bin\"\ncpu = \"x86-64-v2\"\n" + manifestParts[1])
success(fixture, ["build", "--release"], application)
test.check(test.contains(external(fixture, [application + "/target/release/greeting"], application).output, "Hello, world!"), "package.cpu program runs")
io.writeTextFile(application + "/Minyar.toml", manifestParts[0] + "kind = \"bin\"\ncpu = \"pentium\"\n" + manifestParts[1])
rejected(fixture, ["build"], application, "package.cpu must be x86-64, x86-64-v2, x86-64-v3, x86-64-v4, baseline or native")
io.writeTextFile(application + "/Minyar.toml", defaultManifest)
success(fixture, ["build", "--release"], application)
let nested = application + "/src"
success(fixture, ["check", "--locked"], nested)
let tested = success(fixture, ["test"], nested)
test.check(test.contains(tested.output, "1 passed; 0 failed"), "generated smoke test runs")
rejected(fixture, ["test", "missing"], application, "no tests matched")
rejected(fixture, ["build", "--lib"], application, "not supported")
rejected(fixture, ["build", "--release", "--release"], application, "duplicate option")
