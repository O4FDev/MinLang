success(fixture, ["build"], library)
success(fixture, ["test"], library)
rejected(fixture, ["run"], library, "requires src/main.min")
io.writeTextFile(library + "/Minyar.toml", "# Shapes for the gallery.\n" + io.readTextFile(library + "/Minyar.toml") + "# keep dependencies sorted\n")
success(fixture, ["add", "leaf", "--path", leaf], library)
let commented = io.readTextFile(library + "/Minyar.toml")
test.check(commented.startsWith("# Shapes for the gallery.\n[package]\n") && test.contains(commented, "[dependencies]\nleaf = { path = \"../leaf\" }\n# keep dependencies sorted\n"), "add edits dependency lines and keeps comments\n" + commented)
io.writeTextFile(library + "/src/helper.min", test.sourceModules("public function offset(): Integer { return 1 }\n"))
io.writeTextFile(library + "/src/geometry.min", test.sourceModules("use \"leaf\" as leaf\nuse \"./helper.min\" as helper\npublic function answer(): Integer { return leaf.answer() + helper.offset() }\n"))
success(fixture, ["add", "geometry", "--path", library], nested)
test.check(test.contains(io.readTextFile(application + "/Minyar.toml"), "path = \"../geometry\""), "absolute add arguments also produce relative manifests")
rejected(fixture, ["build", "--locked"], application, "out of date")
io.writeTextFile(application + "/src/main.min", test.sourceModules("use \"geometry\" as geometry\nprint(geometry.answer())\n"))
let dependencyRun = success(fixture, ["run"], application)
test.check(test.contains(dependencyRun.output, "43"), "transitive dependencies and sibling module imports")
io.writeTextFile(leaf + "/src/leaf.min", test.sourceModules("public function answer(): Integer { return 50 }\n"))
let editedDependency = success(fixture, ["run", "--locked"], application)
test.check(test.contains(editedDependency.output, "51"), "locked local sources remain editable and invalidate cache")
let metadata = success(fixture, ["metadata", "--locked"], application)
test.check(test.contains(metadata.output, "\"packages\":[") && test.contains(metadata.output, "\"name\":\"leaf\""), "structured metadata includes transitive graph")
let tree = success(fixture, ["tree"], application)
test.check(test.contains(tree.output, "-> geometry") && test.contains(tree.output, "-> leaf"), "dependency edges")
