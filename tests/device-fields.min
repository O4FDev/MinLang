use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
let source = #"""
use "device" as device
function check(condition: Boolean) { if !condition { fail("bit field oracle mismatch") } }
let seed = 20261020
let cases = 0
"""#
source += "\n" + #"""
let wordMask8 = 0
for bit in 0..8 { wordMask8 = wordMask8 | (1 << bit) }
for first in 0..8 {
    for width in 1..(8 - first + 1) {
        let field = device.field8(first, width)
        let valueMask = 0
        for bit in 0..width { valueMask = valueMask | (1 << bit) }
        for sample in 0..8 {
            seed = wrappingAdd(wrappingMultiply(seed, 6364136223846793005), 1442695040888963407)
            let word = seed & wordMask8
            let value = seed & valueMask
            if sample == 0 { word = 0; value = 0 }
            if sample == 1 { word = wordMask8; value = valueMask }
            if sample == 2 { word = -9223372036854775808 & wordMask8; value = 0 }
            if sample == 3 { word = 9223372036854775807 & wordMask8; value = valueMask }
            let encoded = 0
            let extracted = 0
            let replaced = word
            for bit in 0..width {
                let at = first + bit
                let newBit = ((value >> bit) & 1) << at
                encoded = encoded | newBit
                extracted = extracted | (((word >> at) & 1) << bit)
                replaced = (replaced & ~(1 << at)) | newBit
            }
            check(device.encode8(field, value) == encoded)
            check(device.extract8(field, word) == extracted)
            check(device.replace8(field, word, value) == replaced)
            check(device.extract8(field, replaced) == value)
            cases += 1
        }
    }
}
"""#
source += "\n" + #"""
let wordMask16 = 0
for bit in 0..16 { wordMask16 = wordMask16 | (1 << bit) }
for first in 0..16 {
    for width in 1..(16 - first + 1) {
        let field = device.field16(first, width)
        let valueMask = 0
        for bit in 0..width { valueMask = valueMask | (1 << bit) }
        for sample in 0..8 {
            seed = wrappingAdd(wrappingMultiply(seed, 6364136223846793005), 1442695040888963407)
            let word = seed & wordMask16
            let value = seed & valueMask
            if sample == 0 { word = 0; value = 0 }
            if sample == 1 { word = wordMask16; value = valueMask }
            if sample == 2 { word = -9223372036854775808 & wordMask16; value = 0 }
            if sample == 3 { word = 9223372036854775807 & wordMask16; value = valueMask }
            let encoded = 0
            let extracted = 0
            let replaced = word
            for bit in 0..width {
                let at = first + bit
                let newBit = ((value >> bit) & 1) << at
                encoded = encoded | newBit
                extracted = extracted | (((word >> at) & 1) << bit)
                replaced = (replaced & ~(1 << at)) | newBit
            }
            check(device.encode16(field, value) == encoded)
            check(device.extract16(field, word) == extracted)
            check(device.replace16(field, word, value) == replaced)
            check(device.extract16(field, replaced) == value)
            cases += 1
        }
    }
}
"""#
source += "\n" + #"""
let wordMask32 = 0
for bit in 0..32 { wordMask32 = wordMask32 | (1 << bit) }
for first in 0..32 {
    for width in 1..(32 - first + 1) {
        let field = device.field32(first, width)
        let valueMask = 0
        for bit in 0..width { valueMask = valueMask | (1 << bit) }
        for sample in 0..8 {
            seed = wrappingAdd(wrappingMultiply(seed, 6364136223846793005), 1442695040888963407)
            let word = seed & wordMask32
            let value = seed & valueMask
            if sample == 0 { word = 0; value = 0 }
            if sample == 1 { word = wordMask32; value = valueMask }
            if sample == 2 { word = -9223372036854775808 & wordMask32; value = 0 }
            if sample == 3 { word = 9223372036854775807 & wordMask32; value = valueMask }
            let encoded = 0
            let extracted = 0
            let replaced = word
            for bit in 0..width {
                let at = first + bit
                let newBit = ((value >> bit) & 1) << at
                encoded = encoded | newBit
                extracted = extracted | (((word >> at) & 1) << bit)
                replaced = (replaced & ~(1 << at)) | newBit
            }
            check(device.encode32(field, value) == encoded)
            check(device.extract32(field, word) == extracted)
            check(device.replace32(field, word, value) == replaced)
            check(device.extract32(field, replaced) == value)
            cases += 1
        }
    }
}
"""#
source += "\n" + #"""
let wordMask64 = 0
for bit in 0..64 { wordMask64 = wordMask64 | (1 << bit) }
for first in 0..64 {
    for width in 1..(64 - first + 1) {
        let field = device.field64(first, width)
        let valueMask = 0
        for bit in 0..width { valueMask = valueMask | (1 << bit) }
        for sample in 0..8 {
            seed = wrappingAdd(wrappingMultiply(seed, 6364136223846793005), 1442695040888963407)
            let word = seed & wordMask64
            let value = seed & valueMask
            if sample == 0 { word = 0; value = 0 }
            if sample == 1 { word = wordMask64; value = valueMask }
            if sample == 2 { word = -9223372036854775808 & wordMask64; value = 0 }
            if sample == 3 { word = 9223372036854775807 & wordMask64; value = valueMask }
            let encoded = 0
            let extracted = 0
            let replaced = word
            for bit in 0..width {
                let at = first + bit
                let newBit = ((value >> bit) & 1) << at
                encoded = encoded | newBit
                extracted = extracted | (((word >> at) & 1) << bit)
                replaced = (replaced & ~(1 << at)) | newBit
            }
            check(device.encode64(field, value) == encoded)
            check(device.extract64(field, word) == extracted)
            check(device.replace64(field, word, value) == replaced)
            check(device.extract64(field, replaced) == value)
            cases += 1
        }
    }
}
"""#
source += "\nprint(cases)\n"
fixtures.executes(frontend, source, "22240\n", levels, 0, "", true)

let hardware = #"""
use "device" as device
function check(condition: Boolean) { if !condition { fail("register field mismatch") } }
let memory = device.allocate(32, 8)
let window = device.registers(device.addressOf(memory, 0), 32)
device.fill(memory, 0, 32, 0xA5)
"""#
hardware += "\n" + #"""
let register8 = device.register8(window, 0)
let field8 = device.field8(8 - 4, 3)
device.write8(register8, 255)
device.updateField8(register8, field8, 2)
check(device.readField8(register8, field8) == 2)
check(device.read8(register8) == device.replace8(field8, 255, 2))
// Write-one-to-clear/command payload: only the selected field is written.
device.write8(register8, device.encode8(field8, 5))
check(device.read8(register8) == (5 << (8 - 4)))
check(device.load8(memory, 1) == 0xA5)
device.fill(memory, 0, 32, 0xA5)
"""#
hardware += "\n" + #"""
let register16 = device.register16(window, 0)
let field16 = device.field16(16 - 4, 3)
device.write16(register16, 65535)
device.updateField16(register16, field16, 2)
check(device.readField16(register16, field16) == 2)
check(device.read16(register16) == device.replace16(field16, 65535, 2))
// Write-one-to-clear/command payload: only the selected field is written.
device.write16(register16, device.encode16(field16, 5))
check(device.read16(register16) == (5 << (16 - 4)))
check(device.load8(memory, 2) == 0xA5)
device.fill(memory, 0, 32, 0xA5)
"""#
hardware += "\n" + #"""
let register32 = device.register32(window, 0)
let field32 = device.field32(32 - 4, 3)
device.write32(register32, 4294967295)
device.updateField32(register32, field32, 2)
check(device.readField32(register32, field32) == 2)
check(device.read32(register32) == device.replace32(field32, 4294967295, 2))
// Write-one-to-clear/command payload: only the selected field is written.
device.write32(register32, device.encode32(field32, 5))
check(device.read32(register32) == (5 << (32 - 4)))
check(device.load8(memory, 4) == 0xA5)
device.fill(memory, 0, 32, 0xA5)
"""#
hardware += "\n" + #"""
let register64 = device.register64(window, 0)
let field64 = device.field64(64 - 4, 3)
device.write64(register64, -1)
device.updateField64(register64, field64, 2)
check(device.readField64(register64, field64) == 2)
check(device.read64(register64) == device.replace64(field64, -1, 2))
// Write-one-to-clear/command payload: only the selected field is written.
device.write64(register64, device.encode64(field64, 5))
check(device.read64(register64) == (5 << (64 - 4)))
check(device.load8(memory, 8) == 0xA5)
device.fill(memory, 0, 32, 0xA5)
"""#
hardware += "\nprint(\"registers passed\")\n"
fixtures.executes(frontend, hardware, "registers passed\n", levels, 0, "", true)

fixtures.executes(frontend, #"""
use "device" as device
let full = device.field64(0, 64)
for value in [-9223372036854775808, 9223372036854775807, -1, 0] {
    if device.encode64(full, value) != value || device.extract64(full, value) != value || device.replace64(full, -1, value) != value { fail("full-width field bits") }
}
print("full-width passed")
"""#, "full-width passed\n", levels, 0, "", true)

io.writeTextFile(frontend.compiler.directory + "/configuration.min", io.readTextFile("os/kernel/net/e1000config.min"))
fixtures.executes(frontend, #"""
use "./configuration.min" as configuration
if sizeOf(configuration.ReceiveDescriptor) != 16 || sizeOf(configuration.TransmitDescriptor) != 16 { fail("DMA descriptor size") }
if alignOf(configuration.ReceiveDescriptor) != 1 || alignOf(configuration.TransmitDescriptor) != 1 { fail("DMA packed alignment") }
if offsetOf(configuration.ReceiveDescriptor, "length") != 8 || offsetOf(configuration.ReceiveDescriptor, "status") != 12 { fail("receive descriptor offsets") }
if offsetOf(configuration.TransmitDescriptor, "length") != 8 || offsetOf(configuration.TransmitDescriptor, "command") != 11 || offsetOf(configuration.TransmitDescriptor, "status") != 12 { fail("transmit descriptor offsets") }
let bytes = Bytes(17)
let descriptor = cView(configuration.TransmitDescriptor, bytes, 1)
descriptor.address = -1; descriptor.length = 513; descriptor.command = 11; descriptor.status = 1
if bytes[0] != 0 || bytes[1] != 255 || bytes[8] != 255 || bytes[9] != 1 || bytes[10] != 2 || bytes[12] != 11 || bytes[13] != 1 { fail("packed DMA descriptor bytes") }
if configuration.transmitGap(10, 8, 6) != 6299658 { fail("TIPG legacy bytes") }
if configuration.transmitControl(15, 64) != 262394 { fail("TCTL legacy bytes") }
if configuration.transmitGap(1023, 1023, 1023) != 1073741823 { fail("TIPG maximum fields") }
if configuration.transmitControl(255, 1023) != 4194298 { fail("TCTL maximum fields") }
print("e1000 configuration passed")
"""#, "e1000 configuration passed\n", levels, 0, "", true)
fixtures.executes(frontend, "use \"./configuration.min\" as configuration\nprint(configuration.transmitControl(256, 64))\n", "", levels, 1,
    "Minyar stopped: field value 256 is outside 0 to 255\n", false)
fixtures.executes(frontend, io.readTextFile("examples/gallery/device-fields.min"),
    "transmitter enabled: true\ncollision threshold: 15\ncollision distance: 64\n", levels, 0, "", true)

for bits in [8, 16, 32] {
    for word in [-1, 1 << bits] {
        for operation in ["extract", "replace"] {
            let expression = "device." + operation + Text(bits) + "(device.field" + Text(bits) + "(0, 3), " + Text(word)
            if operation == "replace" { expression += ", 0" }
            fixtures.executes(frontend, "use \"device\" as device\nprint(" + expression + "))\n", "", levels, 1,
                "Minyar stopped: " + Text(word) + " does not fit in a " + Text(bits) + "-bit register\n", false)
        }
    }
}
fixtures.executes(frontend, "use \"device\" as device\nlet register = device.register32(device.registers(4097, 8), 0)\n", "", levels, 1,
    "Minyar stopped: a 32-bit register needs an address aligned to 4 bytes, not 4097\n", false)
fixtures.executes(frontend, "use \"device\" as device\nlet window = device.registers(9223372036854775807, 2)\n", "", levels, 1,
    "Minyar stopped: device register window exceeds the supported address range\n", false)

for bits in [8, 16, 32, 64] {
    let prefix = "use \"device\" as device\n"
    for pair in [[-1, 1], [bits, 1], [0, 0], [0, -1], [bits - 1, 2], [0, 9223372036854775807], [-9223372036854775808, 1]] {
        let expression = "device.field" + Text(bits) + "(" + Text(pair[0]) + ", " + Text(pair[1]) + ")"
        fixtures.executes(frontend, prefix + "let field = " + expression + "\n", "", levels, 1,
            "Minyar stopped: a " + Text(bits) + "-bit field needs a positive width within bits 0 to " + Text(bits - 1) + "\n", false)
    }
    for value in [-1, 8] {
        fixtures.executes(frontend, prefix + "print(device.encode" + Text(bits) + "(device.field" + Text(bits) + "(0, 3), " + Text(value) + "))\n", "", levels, 1,
            "Minyar stopped: field value " + Text(value) + " is outside 0 to 7\n", false)
        // An invalid value fails before this deliberately inaccessible MMIO address is read.
        fixtures.executes(frontend, prefix + "let register = device.register" + Text(bits) + "(device.registers(4096, 8), 0)\ndevice.updateField" + Text(bits) + "(register, device.field" + Text(bits) + "(0, 3), " + Text(value) + ")\n", "", levels, 1,
            "Minyar stopped: field value " + Text(value) + " is outside 0 to 7\n", false)
    }
    fixtures.rejects(frontend, prefix + "let field = device.Field" + Text(bits) + " { first: 0; mask: 7 }\n", "private", true)
}
fixtures.rejects(frontend, "use \"device\" as device\nlet register = device.register32(device.registers(4096, 8), 0)\nprint(device.readField32(register, device.field16(0, 3)))\n", "expected", true)
fixtures.rejects(frontend, "use \"device\" as device\nlet register = device.register16(device.registers(4096, 8), 0)\ndevice.updateField32(register, device.field32(0, 3), 1)\n", "expected", true)
test.removeScratch(frontend.compiler.directory)
print("device fields: 22240 oracle cases, MMIO and rejection checks passed")
