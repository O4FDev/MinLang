// A stop inside code the runtime called (here a sort comparator) is not
// contained: a merge could be half done, so the process still ends.
use "boundary" as boundary
let result = boundary.run(function() {
    let sorted = [3, 1, 2].sortedBy(function(left: Integer, right: Integer): Integer { fail("comparator stop") })
    print(sorted.length)
})
print("unreachable")
