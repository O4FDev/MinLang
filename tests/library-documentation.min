use "../tools/testing.min" as test
use "../tools/driver-support.min" as host
use "io" as io
use "json" as json
use "system" as system

let root = host.resolveName(".")
let launcher = root + "/minyar"
let work = test.scratch()
for profile in ["debug", "release"] {
    for input in ["library", "examples/gallery"] {
        let command = [launcher, "doc", "--path", root + "/" + input]
        if profile == "release" { command.add("--release") }
        let run = test.run(command, system.environment(), work, work + "/" + profile + "-" + host.baseName(input), 600)
        test.require(run, "verify " + input + " documentation " + profile)
        test.check(test.contains(run.output, "verified examples"), "documentation reports checked examples")
        let html = io.readTextFile(work + "/target/doc/index.html")
        let metadata = json.parse(io.readTextFile(work + "/target/doc/api.json"))
        test.check(metadata.kind == json.OBJECT && metadata.member("version").number == 1.0, "library API metadata")
        let paths: List<Text> = []
        host.walk(root + "/" + input, "", paths)
        let modules = 0
        for path in paths { if path.endsWith(".min") { modules += 1 } }
        test.check(metadata.member("modules").items.length == modules, "every source module has metadata")
        if input == "library" {
            for expected in ["The Minyar library", "Error.withContext", "original message", "Maybe", "still shining", "parseInteger", "parseUnique", "syncDirectory", "sqrt"] {
                test.check(test.contains(html, expected), "library reference includes " + expected)
            }
        } else {
            for expected in ["Postcard", "Letter", "Lantern.share", "firstOr", "There is light in the harbour."] {
                test.check(test.contains(html, expected), "gallery reference includes " + expected)
            }
        }
    }
}
test.removeTree(work)
print("Library and gallery documentation examples passed at O0/O2")
