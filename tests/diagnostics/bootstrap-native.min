function bootstrapNativeText(value: Text): Text { native "runtime" }
function bootstrapNativeBoolean(value: Boolean): Boolean { native "runtime" }
function bootstrapNativeInteger(value: Integer): Integer { native "runtime" }
function bootstrapNativeCharacter(value: Character): Character { native "runtime" }
function bootstrapNativeSet(value: Integer) { native "runtime" }
function bootstrapNativeCount(): Integer { native "runtime" }
function nativeAsName(native: Integer): Integer { native = native + 2; return native }

function main(): Integer {
    print(bootstrapNativeText("a light in the harbour · ★"))
    print(bootstrapNativeBoolean(false))
    print(bootstrapNativeInteger(-9223372036854775807 - 1))
    print(bootstrapNativeCharacter(Character(9733)))
    bootstrapNativeSet(42)
    print(bootstrapNativeCount())
    print(nativeAsName(40))
    return 0
}
