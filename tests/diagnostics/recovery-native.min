record DiagnosticJob { mode: Integer; attempts: Integer }
function diagnosticRun(job: DiagnosticJob): Boolean { native "diagnostics" }
function diagnosticRaiseOnStack() { native "runtime" }
function diagnosticProbeCount(): Integer { native "runtime" }
function diagnosticHasJob(): Boolean { native "runtime" }
function diagnosticCurrentJob(): DiagnosticJob { native "runtime" }
function diagnosticErrorCount(): Integer { native "runtime" }

function recoveryStack(job: DiagnosticJob): Integer {
    let message = Text(job.attempts)
    if job.mode == 1 { diagnosticRaiseOnStack() }
    return message.length
}
function recoveryOwned(job: DiagnosticJob) {
    let lights = ["a light in the harbour", "a window in the rain"]
    let size = recoveryStack(job)
    if size < 1 || lights.length != 2 { fail("recovery lost an owned value") }
}
function diagnosticCompileJob(job: DiagnosticJob) {
    if !diagnosticHasJob() { fail("recovery lost its active job") }
    if diagnosticCurrentJob().attempts != job.attempts { fail("recovery changed its job") }
    recoveryOwned(job)
    job.attempts = job.attempts + 1
}
function main(): Integer {
    let job = DiagnosticJob { mode: 1, attempts: 0 }
    let attempt = 0
    while attempt < 10 {
        job.mode = 1
        if diagnosticRun(job) { fail("recovery accepted a failed job") }
        job.mode = 0
        if !diagnosticRun(job) { fail("recovery rejected a good job") }
        attempt = attempt + 1
    }
    if job.attempts != 10 || diagnosticErrorCount() != 10 || diagnosticProbeCount() != 10 || diagnosticHasJob() { fail("recovery did not restore its boundary") }
    print("Ten revisions, and the light is still on.")
    return 0
}
