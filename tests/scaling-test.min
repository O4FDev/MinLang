use "io" as io
use "../tools/testing.min" as test
use "./performance-test-support.min" as timing
function compileSource(work: Text, source: Text, output: Text, log: Text): Float {
    let result = timing.measure(["build/minyarc", source, output, "--library", "library"], log, 10)
    if result.status != 0 { test.removeTree(work); fail("scaling input failed:\n" + result.errorOutput) }
    if result.usage { return result.cpu }
    return result.wall
}
function declarationProgram(path: Text, count: Integer, callLast: Boolean) {
    let target = "1"
    if callLast { target = "target()" }
    let parts: List<Text> = []
    for index in 0..count { parts.add("function f" + Text(index) + "(): Integer {\n    return " + target + "\n}\n\n") }
    if callLast { parts.add("function target(): Integer {\n    return 42\n}\n\n") }
    parts.add("print(f0())\n")
    io.writeTextParts(path, parts)
}
let work = test.scratch()
let names = ["250 declarations", "2000 declarations", "250 adversarial calls", "2000 adversarial calls"]
let counts = [250, 2000, 250, 2000]
let calls = [false, false, true, true]
let measured: List<Float> = []
for index in 0..names.length {
    let stem = work + "/" + test.replace(names[index], " ", "-")
    declarationProgram(stem + ".min", counts[index], calls[index])
    measured.add(compileSource(work, stem + ".min", stem + ".ll", stem + ".compile"))
}
let entry = timing.moduleChain(work + "/modules", 200)
names.add("200-module graph")
measured.add(compileSource(work, entry, work + "/modules.ll", work + "/modules.compile"))
test.removeTree(work)
let summary: List<Text> = []
for index in 0..names.length {
    if measured[index] > 5.0 { fail(names[index] + " used " + timing.fixed(measured[index], 2) + "s; scaling limit is 5s") }
    summary.add(names[index] + " " + timing.fixed(measured[index], 3) + "s")
}
let joined = ""
for index in 0..summary.length { if index > 0 { joined += ", " }; joined += summary[index] }
print("compiler scaling verified: " + joined)
