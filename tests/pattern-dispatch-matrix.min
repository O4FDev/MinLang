record Trace { digits: Integer }
choice Pair { Both(left: Maybe<Integer>, right: Maybe<Integer>); Absent }
function probe(trace: Trace, digit: Integer, accepted: Boolean): Boolean {
    trace.digits = trace.digits * 10 + digit
    return accepted
}
function value(tag: Integer): Maybe<Integer> {
    if tag == 0 { return None }
    return Some(tag - 2)
}
function choose(pair: Pair, trace: Trace): Integer {
    return match pair {
        Both(Some(0), None) where probe(trace, 1, false) { -100 }
        Both(None, Some(0)) where probe(trace, 2, true) { 200 }
        Both(Some(left), Some(right)) where probe(trace, 3, left < right) { 1000 + left * 10 + right }
        Both(_, None) where probe(trace, 4, false) { -400 }
        Both(Some(left), _) { left + 100 }
        Both(_, Some(right)) { right + 200 }
        Both(_, _) { -1 }
        Absent { -2 }
    }
}
for round in 0..100 {
    for left in 0..4 {
        for right in 0..4 {
            let expected = -1
            let digits = 0
            if right == 0 {
                digits = 4
                if left == 2 { digits = 14 }
                if left > 0 { expected = left - 2 + 100 }
            } else if left == 0 {
                expected = right - 2 + 200
                if right == 2 { digits = 2 }
            } else {
                digits = 3
                expected = left - 2 + 100
                if left < right { expected = 1000 + (left - 2) * 10 + right - 2 }
            }
            let trace = Trace { digits: 0 }
            let actual = choose(Both(value(left), value(right)), trace)
            if actual != expected || trace.digits != digits { fail("two-column matrix disagrees with scalar oracle") }
        }
    }
}
let trace = Trace { digits: 0 }
if choose(Absent, trace) != -2 || trace.digits != 0 { fail("absent matrix case") }
print("matrix dispatch passed")
