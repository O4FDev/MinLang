// The public github.com install route, entirely against local bare repositories.
use "../tools/testing.min" as test
use "../tools/package-git.min" as packages
use "../tools/driver-support.min" as host
use "process" as process
use "system" as system
use "io" as io
use "files" as files

if process.argumentCount() == 2 && process.argument(0) == "--bounded-timeout-helper" {
    let timeoutRoot = process.argument(1)
    let timeoutScript = "printf timeout-output; printf timeout-error >&2; /bin/sleep 5; exit 25"
    let timeoutStatus = host.spawnBounded(["/bin/sh", "-c", timeoutScript], [], true, timeoutRoot + "/timeout-stdout", timeoutRoot + "/timeout-stderr", 1, 200000, 200000)
    host.leave(timeoutStatus)
}

if process.argumentCount() == 7 && process.argument(0) == "--reference-race-helper" {
    packages.remember(process.argument(1), process.argument(2), packages.Source {
        repository: process.argument(3);
        revision: process.argument(4);
        commit: process.argument(5);
        checksum: process.argument(6);
        root: "";
    })
    host.leave(0)
}

record Fixture { launcher: Text; root: Text; environment: List<Text>; serial: Integer }
function command(fixture: Fixture, arguments: List<Text>, directory: Text): test.Result {
    fixture.serial += 1
    return test.run(arguments, fixture.environment, directory, fixture.root + "/command-" + Text(fixture.serial), 180)
}
function require(fixture: Fixture, arguments: List<Text>, directory: Text): test.Result {
    let result = command(fixture, arguments, directory)
    test.require(result, host.joined(arguments, " "))
    return result
}
function cli(fixture: Fixture, arguments: List<Text>, directory: Text): test.Result {
    return require(fixture, host.extended([fixture.launcher], arguments), directory)
}
function rejected(fixture: Fixture, arguments: List<Text>, directory: Text, message: Text) {
    let result = command(fixture, host.extended([fixture.launcher], arguments), directory)
    test.check(result.status != 0 && test.contains(result.errorOutput, message), "expected " + message + "\n" + result.output + result.errorOutput)
}
function git(fixture: Fixture, directory: Text, arguments: List<Text>): Text {
    return require(fixture, host.extended(["git", "-c", "core.hooksPath=/dev/null", "-c", "user.name=Minyar tests", "-c", "user.email=minyar@example.invalid", "-C", directory], arguments), fixture.root).output
}
function commit(fixture: Fixture, directory: Text, version: Text) {
    git(fixture, directory, ["add", "."])
    git(fixture, directory, ["commit", "--quiet", "-m", "feat(package): release " + version])
    git(fixture, directory, ["tag", "v" + version])
}
function makePackage(fixture: Fixture, name: Text, version: Text, source: Text, dependencies: Text): Text {
    let root = fixture.root + "/sources/" + name
    host.makeDirectories(root + "/src")
    io.writeTextFile(root + "/Minyar.toml", "[package]\nname = \"" + name + "\"\nversion = \"" + version + "\"\nkind = \"lib\"\n\n[dependencies]\n" + dependencies)
    io.writeTextFile(root + "/src/" + name + ".min", source)
    git(fixture, root, ["init", "--quiet", "--initial-branch=main"])
    return root
}
function mirror(fixture: Fixture, name: Text, root: Text) {
    host.makeDirectories(fixture.root + "/mirror/github.com/O4FDev")
    require(fixture, ["git", "clone", "--bare", "--quiet", "--no-hardlinks", root, fixture.root + "/mirror/github.com/O4FDev/" + name + ".git"], fixture.root)
}
function dependency(name: Text, revision: Text): Text { return name + " = { git = \"github.com/O4FDev/" + name + "\", rev = \"" + revision + "\" }\n" }
let root = test.scratch()
let environment: List<Text> = []
let inheritedPath = system.getenv("PATH")
for entry in system.environment() {
    if !entry.startsWith("MINYAR_HOME=") && !entry.startsWith("MINYAR_GIT_MIRROR=") && !entry.startsWith("MINYAR_REGISTRY=") && !entry.startsWith("MINYAR_TEST_REAL_GIT=") && !entry.startsWith("GIT_") && !entry.startsWith("PATH=") { environment.add(entry) }
}
let realGit = host.which("git")
test.check(realGit != "", "package Git tests require Git")
let gitShimRoot = root + "/git-shim"
let gitShim = gitShimRoot + "/git"
host.makeDirectories(gitShimRoot)
io.writeTextFile(gitShim, "#!/bin/sh\nis_fetch=0\nis_package_git=0\nhas_unpack_limit=0\nhas_no_maintenance=0\nhas_no_commit_graph=0\nfor argument in \"$@\"; do\n  case \"$argument\" in\n    fetch) is_fetch=1 ;;\n    credential.helper=) is_package_git=1 ;;\n    fetch.unpackLimit=0) has_unpack_limit=1 ;;\n    --no-auto-maintenance) has_no_maintenance=1 ;;\n    --no-write-commit-graph) has_no_commit_graph=1 ;;\n  esac\ndone\nif [ \"$is_fetch\" = 1 ] && [ \"$is_package_git\" = 1 ]; then\n  [ \"$(ulimit -f)\" = 524288 ] || { echo \"Git fetch file limit was not inherited\" >&2; exit 96; }\n  [ \"$has_unpack_limit\" = 1 ] || { echo \"Git fetch may create loose objects\" >&2; exit 97; }\n  [ \"$has_no_maintenance\" = 1 ] || { echo \"Git fetch may run maintenance\" >&2; exit 98; }\n  [ \"$has_no_commit_graph\" = 1 ] || { echo \"Git fetch may write a commit graph\" >&2; exit 99; }\nfi\nexec \"$MINYAR_TEST_REAL_GIT\" \"$@\"\n")
let gitShimMode = test.run(["/bin/chmod", "755", gitShim], environment, root, root + "/git-shim-mode", 10)
test.require(gitShimMode, "make the Git test shim executable")
environment.add("PATH=" + gitShimRoot + ":" + inheritedPath)
environment.add("MINYAR_TEST_REAL_GIT=" + realGit)
environment.add("MINYAR_HOME=" + root + "/home with spaces")
environment.add("MINYAR_GIT_MIRROR=" + root + "/mirror")
environment.add("GIT_CONFIG_NOSYSTEM=1")
environment.add("GIT_CONFIG_GLOBAL=/dev/null")
let timeoutResult = test.run([host.selfPath(), "--bounded-timeout-helper", root], environment, root, root + "/bounded-timeout", 10)
test.check(timeoutResult.status == 1 && test.contains(timeoutResult.errorOutput, "timed out after 1 seconds") && io.readTextFile(root + "/timeout-stdout") == "timeout-output" && io.readTextFile(root + "/timeout-stderr") == "timeout-error", "bounded Git capture preserves timeout handling while draining both output streams")
let fixture = Fixture { launcher: process.argument(0); root: root; environment: environment; serial: 0 }
let dualOutput = root + "/dual-stdout"
let dualErrors = root + "/dual-stderr"
let dualScript = "index=0; while [ \"$index\" -lt 20000 ]; do printf 12345678; index=$((index + 1)); done; index=0; while [ \"$index\" -lt 20000 ]; do printf 87654321 >&2; index=$((index + 1)); done; exit 23"
let dualStatus = host.spawnBounded(["/bin/sh", "-c", dualScript], [], true, dualOutput, dualErrors, 10, 200000, 200000)
test.check(dualStatus == 23 && files.pathSize(dualOutput) == 160000 && files.pathSize(dualErrors) == 160000, "bounded Git capture drains both pipes beyond pipe capacity and preserves timeout execution")
let boundedOutput = root + "/bounded-stdout"
let fastOutputScript = "index=0; while [ \"$index\" -lt 625 ]; do printf 12345678; index=$((index + 1)); done; exit 22"
let outputStatus = host.spawnBounded(["/bin/sh", "-c", fastOutputScript], [], true, boundedOutput, root + "/bounded-stdout-errors", 10, 4096, 200000)
test.check(outputStatus == host.OUTPUT_LIMIT && files.pathSize(boundedOutput) == 4096, "an immediate producer cannot exit successfully after crossing the stdout cap")
let boundedErrors = root + "/bounded-stderr"
let errorScript = "index=0; while [ \"$index\" -lt 20000 ]; do printf 87654321 >&2; index=$((index + 1)); done; exit 24"
let errorStatus = host.spawnBounded(["/bin/sh", "-c", errorScript], [], true, root + "/bounded-stderr-output", boundedErrors, 10, 200000, 4096)
test.check(errorStatus == host.ERROR_LIMIT && files.pathSize(boundedErrors) == 4096, "bounded Git capture stops promptly at the stderr cap")
test.check(packages.semver("v0.10.0") && !packages.semver("v01.0.0") && !packages.semver("v1.0.0-beta"), "canonical stable semver")
test.check(packages.compare("v0.10.0", "v0.2.0") > 0, "numeric version comparison")
for path in ["../escape", "/escape", "src/../escape", "src//file", "src/.git/config", "src/.GIT/config", "src\\escape", "src/\nfile", "C:escape"] { test.check(!packages.safePath(path), "reject unsafe source path " + path) }
test.check(packages.safePath("src/café.min"), "Unicode source paths")
test.check(packages.containedImport("src/ink.min", "../palette.min") && packages.containedImport("src/ink.min", "./nested/../../palette.min") && packages.containedImport("src/ink.min", "../café.min") && packages.containedImport("src/ink.min", "system"), "imports may use standard packages and the whole source tree")
for specifier in ["../../outside.min", "./nested/../../../outside.min", "../..\\outside.min", "./data.txt", "./extensionless", "/outside.min", "https://example.invalid/source"] { test.check(!packages.containedImport("src/ink.min", specifier), "imports stay inside the content-hashed source tree") }
let quote = Text(Character(34)); let slash = Text(Character(92)); let triple = quote + quote + quote
let nativeBody = "public function answer(): Integer { native " + quote + "surprise" + quote + " }\n"
let rawPrefix = "constant bait = #" + quote + slash + quote + "#\n"
let multilinePrefix = "constant bait = " + triple + "\n  one " + quote + " inside\n" + triple + "\n"
test.check(packages.sourceHasNative(rawPrefix + nativeBody), "raw closing quotes cannot hide native declarations")
test.check(packages.sourceHasNative(multilinePrefix + nativeBody), "multiline closing quotes cannot hide native declarations")
test.check(packages.sourceHasNative("/* outer /* text */ " + nativeBody), "block comments end at the first closing delimiter")
test.check(!packages.sourceHasNative("// " + nativeBody), "line comments are data")
test.check(!packages.sourceHasNative("/* " + nativeBody + " */"), "block comments are data")
test.check(!packages.sourceHasNative("constant words = #" + quote + "native " + quote + "surprise" + quote + quote + "#"), "raw text is data")
test.check(!packages.sourceHasNative("constant words = #" + triple + "\n" + quote + "# native " + quote + "surprise" + quote + "\n" + triple + "#"), "raw multiline text is data")
test.check(!packages.sourceHasNative("constant words = " + triple + "\nnative " + quote + "surprise" + quote + "\n" + triple), "multiline text is data")
test.check(packages.sourceHasNative("let words = " + quote + slash + "(function(): Integer { native " + quote + "surprise" + quote + " })" + quote), "interpolation contains code")
test.check(!packages.sourceHasNative("let words = " + quote + slash + "(" + quote + "native" + quote + ")" + quote), "nested text inside interpolation is data")

let leaf = makePackage(fixture, "leaf", "0.1.0", "public function answer(): Integer { return 10 }\n", "")
// Executable files are data. This script must never be run during an install.
io.writeTextFile(leaf + "/install.sh", "#!/bin/sh\ntouch SHOULD_NOT_EXIST\n")
require(fixture, ["chmod", "755", leaf + "/install.sh"], root)
commit(fixture, leaf, "0.1.0")
io.writeTextFile(leaf + "/Minyar.toml", "[package]\nname = \"leaf\"\nversion = \"0.2.0\"\nkind = \"lib\"\n")
io.writeTextFile(leaf + "/src/leaf.min", "public function answer(): Integer { return 20 }\n")
commit(fixture, leaf, "0.2.0")
io.writeTextFile(leaf + "/Minyar.toml", "[package]\nname = \"leaf\"\nversion = \"0.10.0\"\nkind = \"lib\"\n")
io.writeTextFile(leaf + "/src/leaf.min", "public function answer(): Integer { return 100 }\n")
commit(fixture, leaf, "0.10.0")
git(fixture, leaf, ["tag", "v99.0.0-preview"])
let head = host.strip(git(fixture, leaf, ["rev-parse", "HEAD"]))
let older = host.strip(git(fixture, leaf, ["rev-parse", "refs/tags/v0.2.0^{commit}"]))
let witnessStore = root + "/witness-race"
host.makeDirectories(witnessStore + "/refs")
let witnessRepository = "github.com/O4FDev/concurrent"
let witnessRevision = "v1.0.0"
let witnessReference = witnessStore + "/refs/" + host.hashBytes(Bytes(witnessRepository + "\n" + witnessRevision))
let oldChecksum = host.hashBytes(Bytes("old witness"))
let newChecksum = host.hashBytes(Bytes("new witness"))
let witnessLock = host.lockExclusive(witnessReference + ".lock")
test.check(witnessLock >= 0, "cannot hold package witness lock")
let witnessArguments = [host.selfPath(), "--reference-race-helper", witnessStore, witnessRevision, witnessRepository, witnessRevision, head, newChecksum]
let witnessChild = system.spawn(host.selfPath(), witnessArguments, system.environment(), root)
test.check(witnessChild > 0, "cannot start concurrent package witness writer")
test.require(test.run(["/bin/sleep", "1"], system.environment(), root, root + "/witness-race-delay", 5), "wait for the competing witness writer")
io.writeTextFile(witnessReference, older + "\n" + oldChecksum + "\n" + witnessRevision + "\n")
test.check(files.close(witnessLock) == 0, "cannot release package witness lock")
let witnessStatus = system.wait(witnessChild)
test.check(witnessStatus.state == system.EXITED && witnessStatus.exitCode != 0, "concurrent moved release replaced the first package witness")
test.check(io.readTextFile(witnessReference) == older + "\n" + oldChecksum + "\n" + witnessRevision + "\n", "concurrent moved release preserved the first package witness")
let prefix = host.textSlice(head, 0, 12)
git(fixture, leaf, ["tag", head, "v0.2.0"])
git(fixture, leaf, ["tag", prefix, "v0.2.0"])
let fakeCommit = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
git(fixture, leaf, ["tag", fakeCommit, "v0.2.0"])
io.writeTextFile(leaf + "/src/leaf.min", "public function answer(): Integer { return 101 }\n")
git(fixture, leaf, ["add", "."])
git(fixture, leaf, ["commit", "--quiet", "-m", "feat(package): add an unadvertised fixture commit"])
let hidden = host.strip(git(fixture, leaf, ["rev-parse", "HEAD"]))
git(fixture, leaf, ["branch", "unpublished", hidden])
git(fixture, leaf, ["reset", "--hard", head])
mirror(fixture, "leaf", leaf)
let leafMirror = root + "/mirror/github.com/O4FDev/leaf.git"
git(fixture, leafMirror, ["update-ref", "-d", "refs/heads/unpublished"])
git(fixture, leafMirror, ["config", "uploadpack.allowAnySHA1InWant", "true"])
let geometry = makePackage(fixture, "geometry", "0.1.0", Text(Character(65279)) + "use \"leaf\" as leaf\nuse #\"../offset.min\"# as offset\npublic function answer(): Integer { return leaf.answer() + offset.use() }\n", dependency("leaf", "v0.1.0"))
io.writeTextFile(geometry + "/offset.min", "public constant sample = #\"use \"../../outside.min\" as demo\"#\npublic function use(): Integer { return 0 }\n")
commit(fixture, geometry, "0.1.0"); mirror(fixture, "geometry", geometry)
let shapes = makePackage(fixture, "shapes", "0.1.0", "use \"leaf\" as leaf\npublic function answer(): Integer { return leaf.answer() }\n", dependency("leaf", "v0.2.0"))
commit(fixture, shapes, "0.1.0"); mirror(fixture, "shapes", shapes)
let application = root + "/application with spaces"
cli(fixture, ["new", application, "--name", "art"], root)
let addedGeometry = cli(fixture, ["add", "github.com/O4FDev/geometry"], application)
test.check(host.countText(addedGeometry.errorOutput, "  Fetching  github.com/O4FDev/geometry@") == 1, "adding latest fetches the package once")
cli(fixture, ["add", "github.com/O4FDev/shapes@v0.1.0"], application + "/src")
io.writeTextFile(application + "/src/main.min", "use \"geometry\" as geometry\nuse \"shapes\" as shapes\nprint(geometry.answer() + shapes.answer())\n")
let lock = io.readTextFile(application + "/Minyar.lock")
test.check(test.contains(lock, "version = 2") && test.contains(lock, "rev = \"v0.2.0\"") && test.contains(lock, "checksum = \""), "lock pins the minimally selected transitive release")
test.check(!test.contains(lock, "/home with spaces"), "lockfile contains no global cache paths")
test.check(test.contains(cli(fixture, ["run", "--locked", "--offline"], application).output, "40\n"), "debug diamond graph uses the highest requested minimum")
test.check(test.contains(cli(fixture, ["run", "--release", "--locked", "--offline"], application).output, "40\n"), "release diamond graph")
test.check(!io.fileExists(application + "/SHOULD_NOT_EXIST") && !io.fileExists(leaf + "/SHOULD_NOT_EXIST"), "install scripts never run")
let original = io.readTextFile(application + "/Minyar.toml")
cli(fixture, ["add", "https://github.com/O4FDev/leaf.git"], application)
test.check(test.contains(io.readTextFile(application + "/Minyar.toml"), "rev = \"v0.10.0\""), "latest stable tag uses numeric semver ordering")
let rollback = root + "/rollback"
cli(fixture, ["new", rollback], root)
git(fixture, leafMirror, ["update-ref", "-d", "refs/tags/v0.10.0"])
rejected(fixture, ["add", "github.com/O4FDev/leaf"], rollback, "latest Git release moved backwards from v0.10.0 to v0.2.0")
test.check(!test.contains(io.readTextFile(rollback + "/Minyar.toml"), "github.com/O4FDev/leaf") && !io.fileExists(rollback + "/Minyar.lock"), "latest release rollback preserves the manifest and lock")
git(fixture, leafMirror, ["update-ref", "refs/tags/v0.10.0", head])
let pinned = root + "/pinned"
cli(fixture, ["new", pinned], root)
cli(fixture, ["add", "github.com/O4FDev/leaf@" + head], pinned)
test.check(test.contains(io.readTextFile(pinned + "/Minyar.lock"), "commit = \"" + head + "\""), "explicit commit pin")
let exactLock = io.readTextFile(pinned + "/Minyar.lock")
io.writeTextFile(pinned + "/Minyar.lock", host.replaceText(exactLock, "commit = \"" + head + "\"", "commit = \"" + older + "\""))
rejected(fixture, ["tree", "--locked", "--offline"], pinned, "exact Git commit")
io.writeTextFile(pinned + "/Minyar.lock", exactLock)
let exactRef = root + "/home with spaces/packages/refs/" + host.hashBytes(Bytes("github.com/O4FDev/leaf\n" + head))
let referenceFields = host.lines(io.readTextFile(exactRef))
io.writeTextFile(exactRef, older + "\n" + referenceFields[1] + "\n" + head + "\n")
rejected(fixture, ["add", "github.com/O4FDev/leaf@" + head, "--offline"], pinned, "not cached")
cli(fixture, ["tree", "--locked", "--offline"], pinned)
cli(fixture, ["add", "github.com/O4FDev/leaf@" + head], pinned)
test.check(test.contains(io.readTextFile(pinned + "/Minyar.lock"), "commit = \"" + head + "\""), "incorrect cache hints never override a full commit ID")
rejected(fixture, ["add", "github.com/O4FDev/leaf@" + prefix], pinned, "use the full 40-character commit ID")
rejected(fixture, ["add", "github.com/O4FDev/leaf@" + fakeCommit], pinned, "revision not found")
let hiddenReference = root + "/home with spaces/packages/refs/" + host.hashBytes(Bytes("github.com/O4FDev/leaf\n" + hidden))
let referenceVictim = root + "/reference-victim"
let referenceWrapper = root + "/reference-wrapper"
io.writeTextFile(referenceVictim, "SAFE reference\n")
io.writeTextFile(referenceWrapper, "#!/bin/sh\nlauncher=$1\nvictim=$2\ntemporary=$3\nshift 3\n/bin/ln -s \"$victim\" \"$temporary.$$\" || exit 91\nexec \"$launcher\" \"$@\"\n")
test.require(test.run(["/bin/chmod", "+x", referenceWrapper], fixture.environment, root, root + "/reference-wrapper-mode", 10), "package reference attack wrapper permission")
require(fixture, [referenceWrapper, fixture.launcher, referenceVictim, hiddenReference, "add", "github.com/O4FDev/leaf@" + hidden], pinned)
test.check(io.readTextFile(referenceVictim) == "SAFE reference\n" && io.fileExists(hiddenReference), "package references use private unpredictable staging")
test.check(test.contains(io.readTextFile(pinned + "/Minyar.lock"), "commit = \"" + hidden + "\""), "full commits may be fetched directly when no advertised ref reaches them")
cli(fixture, ["tree", "--locked", "--offline"], pinned)
let gitPath = host.which("git")
let tracedGit = root + "/traced-git"
host.makeDirectories(tracedGit)
io.writeTextFile(tracedGit + "/git", "#!/bin/sh\nprintf '%s\\n' \"$*\" >> \"$MINYAR_TEST_GIT_TRACE\"\nexec \"$MINYAR_TEST_REAL_GIT\" \"$@\"\n")
require(fixture, ["chmod", "755", tracedGit + "/git"], root)
let branchEnvironment: List<Text> = []
for entry in fixture.environment { if !entry.startsWith("PATH=") { branchEnvironment.add(entry) } }
branchEnvironment.add("PATH=" + tracedGit + ":" + system.getenv("PATH"))
branchEnvironment.add("MINYAR_TEST_REAL_GIT=" + gitPath)
branchEnvironment.add("MINYAR_TEST_GIT_TRACE=" + root + "/branch-git.log")
let branchFixture = Fixture { launcher: fixture.launcher; root: root; environment: branchEnvironment; serial: fixture.serial + 1000 }
let addedBranch = cli(branchFixture, ["add", "github.com/O4FDev/leaf@main"], pinned)
test.check(host.countText(addedBranch.errorOutput, "  Fetching  github.com/O4FDev/leaf@") == 1, "refreshing a branch fetches once and locks that exact discovery")
let branchTrace = io.readTextFile(root + "/branch-git.log")
test.check(test.contains(branchTrace, "+refs/heads/main:refs/heads/main") && !test.contains(branchTrace, "+refs/heads/*:refs/heads/*"), "branch fetch must not download unrelated refs")
cli(fixture, ["tree", "--locked", "--offline"], pinned)
cli(fixture, ["remove", "leaf", "--offline"], pinned)
cli(fixture, ["tree", "--locked", "--offline"], pinned)
test.check(test.contains(io.readTextFile(pinned + "/Minyar.lock"), "version = 1\n"), "removing the last Git dependency publishes a ready local-only lock")
let removed = root + "/removed"
cli(fixture, ["new", removed, "--name", "art"], root)
io.writeTextFile(removed + "/Minyar.toml", io.readTextFile(application + "/Minyar.toml"))
io.writeTextFile(removed + "/Minyar.lock", io.readTextFile(application + "/Minyar.lock"))
cli(fixture, ["remove", "leaf", "--offline"], removed)
cli(fixture, ["tree", "--locked", "--offline"], removed)
test.check(test.contains(io.readTextFile(removed + "/Minyar.lock"), "version = 2\n"), "partial removals preserve ready Git graph locks")
let wrapped = makePackage(fixture, "wrapped", "0.1.0", "use \"leaf\" as leaf\npublic function answer(): Integer { return leaf.answer() }\n", dependency("leaf", "v0.1.0"))
let mixed = root + "/mixed"
cli(fixture, ["new", mixed], root)
cli(fixture, ["add", "wrapped", "--path", wrapped, "--offline"], mixed)
cli(fixture, ["tree", "--locked", "--offline"], mixed)
cli(fixture, ["remove", "wrapped", "--offline"], mixed)
cli(fixture, ["tree", "--locked", "--offline"], mixed)
test.check(test.contains(io.readTextFile(mixed + "/Minyar.lock"), "version = 1\n"), "removing a local wrapper of the final Git source also refreshes the lock")
let cachedRelease = root + "/cached release"
cli(fixture, ["new", cachedRelease, "--name", "cached-release"], root)
let reused = cli(fixture, ["add", "github.com/O4FDev/geometry@v0.1.0", "--offline"], cachedRelease)
test.check(!test.contains(reused.errorOutput, "Fetching"), "a discovered latest release is reusable by tag offline")
let cachedManifest = io.readTextFile(cachedRelease + "/Minyar.toml")
let cachedLock = io.readTextFile(cachedRelease + "/Minyar.lock")
io.writeTextFile(geometry + "/src/geometry.min", io.readTextFile(geometry + "/src/geometry.min") + "// a moved release tag\n")
git(fixture, geometry, ["add", "."])
git(fixture, geometry, ["commit", "--quiet", "-m", "fix(package): move a fixture release"])
git(fixture, geometry, ["tag", "--force", "v0.1.0"])
git(fixture, root + "/mirror/github.com/O4FDev/geometry.git", ["fetch", "--quiet", "--force", geometry, "+refs/heads/main:refs/heads/main", "+refs/tags/v0.1.0:refs/tags/v0.1.0"])
rejected(fixture, ["add", "github.com/O4FDev/geometry"], cachedRelease, "Git release changed after it was cached")
test.check(io.readTextFile(cachedRelease + "/Minyar.toml") == cachedManifest && io.readTextFile(cachedRelease + "/Minyar.lock") == cachedLock, "a moved tag preserves the manifest and exact lock")
cli(fixture, ["tree", "--locked", "--offline"], cachedRelease)
// Branch and semver requests cannot silently replace each other.
rejected(fixture, ["add", "github.com/O4FDev/leaf@main"], application, "dependency version conflict")
test.check(test.contains(io.readTextFile(application + "/Minyar.toml"), "rev = \"v0.10.0\""), "failed resolution preserves manifest")
// Restore the diamond, including its lock, then remove every remote source.
io.writeTextFile(application + "/Minyar.toml", original)
io.writeTextFile(application + "/Minyar.lock", lock)
test.check(files.rename(root + "/mirror", root + "/mirror-away") == 0, "take the Git host offline")
cli(fixture, ["run", "--offline", "--locked"], application)
test.check(io.readTextFile(application + "/Minyar.lock") == lock, "offline locked run preserves lock bytes")
let moved = root + "/relocated"
test.check(files.rename(application, moved) == 0, "move project independently of cache")
cli(fixture, ["metadata", "--locked", "--offline"], moved)
test.check(io.readTextFile(moved + "/Minyar.lock") == lock, "Git lock remains relocatable")
// Locate the selected leaf cache by its source, then corrupt a byte.
let cacheRoot = root + "/home with spaces/packages/sha256"
let corrupted = ""
for name in files.list(cacheRoot) {
    let path = cacheRoot + "/" + name + "/src/leaf.min"
    if io.fileExists(path) && test.contains(io.readTextFile(path), "return 20") { corrupted = path }
}
test.check(corrupted != "", "selected leaf is in content-addressed cache")
let bytes = io.readTextFile(corrupted)
io.writeTextFile(corrupted, bytes + "// changed\n")
rejected(fixture, ["tree", "--locked", "--offline"], moved, "checksum mismatch")
rejected(fixture, ["tree", "--offline"], moved, "checksum mismatch")
io.writeTextFile(corrupted, bytes)
io.writeTextFile(moved + "/Minyar.toml", original + dependency("uncached", "v0.1.0"))
rejected(fixture, ["tree", "--locked", "--offline"], moved, "out of date")
rejected(fixture, ["tree", "--offline"], moved, "not cached")
io.writeTextFile(moved + "/Minyar.toml", original)
test.check(files.rename(root + "/mirror-away", root + "/mirror") == 0, "restore local host")
let malicious = makePackage(fixture, "malicious", "0.1.0", "public function answer(): Integer { return 1 }\n", "")
require(fixture, ["ln", "-s", "../../outside", malicious + "/src/escape"], root)
commit(fixture, malicious, "0.1.0"); mirror(fixture, "malicious", malicious)
rejected(fixture, ["add", "github.com/O4FDev/malicious"], moved, "symlinks and submodules")
let native = makePackage(fixture, "unsafe", "0.1.0", "public function answer(): Integer { native \"surprise\" }\n", "")
commit(fixture, native, "0.1.0"); mirror(fixture, "unsafe", native)
rejected(fixture, ["add", "github.com/O4FDev/unsafe"], moved, "cannot declare native")
let camouflage = makePackage(fixture, "camouflage", "0.1.0", "/* outer /* text */ public function answer(): Integer { native \"surprise\" } // no nested comment\n", "")
commit(fixture, camouflage, "0.1.0"); mirror(fixture, "camouflage", camouflage)
rejected(fixture, ["add", "github.com/O4FDev/camouflage"], moved, "cannot declare native")
let rawEscape = makePackage(fixture, "raw_escape", "0.1.0", rawPrefix + nativeBody, "")
commit(fixture, rawEscape, "0.1.0"); mirror(fixture, "raw_escape", rawEscape)
rejected(fixture, ["add", "github.com/O4FDev/raw_escape"], moved, "cannot declare native")
let multilineEscape = makePackage(fixture, "multiline_escape", "0.1.0", multilinePrefix + nativeBody, "")
commit(fixture, multilineEscape, "0.1.0"); mirror(fixture, "multiline_escape", multilineEscape)
rejected(fixture, ["add", "github.com/O4FDev/multiline_escape"], moved, "cannot declare native")
let bidi = makePackage(fixture, "bidi", "0.1.0", "// " + Text(Character(8238)) + "\npublic function answer(): Integer { return 1 }\n", "")
commit(fixture, bidi, "0.1.0"); mirror(fixture, "bidi", bidi)
rejected(fixture, ["add", "github.com/O4FDev/bidi"], moved, "bidirectional formatting controls")
let local = makePackage(fixture, "escape", "0.1.0", "public function answer(): Integer { return 1 }\n", "leaf = { path = \"../../outside\" }\n")
commit(fixture, local, "0.1.0"); mirror(fixture, "escape", local)
rejected(fixture, ["add", "github.com/O4FDev/escape"], moved, "local path dependency")
let importEscape = makePackage(fixture, "escape_import", "0.1.0", "use \"../../outside.min\" as outside\npublic function answer(): Integer { return outside.answer() }\n", "")
commit(fixture, importEscape, "0.1.0"); mirror(fixture, "escape_import", importEscape)
rejected(fixture, ["add", "github.com/O4FDev/escape_import"], moved, "package import escapes")
let encodedImport = makePackage(fixture, "encoded_import", "0.1.0", "use " + quote + slash + "." + slash + "./" + slash + "." + slash + "./outside.min" + quote + " as outside\n", "")
commit(fixture, encodedImport, "0.1.0"); mirror(fixture, "encoded_import", encodedImport)
rejected(fixture, ["add", "github.com/O4FDev/encoded_import"], moved, "package import escapes")
let rawImport = makePackage(fixture, "raw_import", "0.1.0", "use /* flat /* comment */ #\"../../outside.min\"# as outside\n", "")
commit(fixture, rawImport, "0.1.0"); mirror(fixture, "raw_import", rawImport)
rejected(fixture, ["add", "github.com/O4FDev/raw_import"], moved, "package import escapes")
let multilineImport = makePackage(fixture, "multiline_import", "0.1.0", "use " + triple + "\n../../outside.min\n" + triple + " as outside\n", "")
commit(fixture, multilineImport, "0.1.0"); mirror(fixture, "multiline_import", multilineImport)
rejected(fixture, ["add", "github.com/O4FDev/multiline_import"], moved, "single-line quoted module paths")
let dataImport = makePackage(fixture, "data_import", "0.1.0", "use \"./implementation.txt\" as implementation\npublic function answer(): Integer { return implementation.processId() }\n", "")
io.writeTextFile(dataImport + "/src/implementation.txt", "public function processId(): Integer { native \"system\" }\n")
commit(fixture, dataImport, "0.1.0"); mirror(fixture, "data_import", dataImport)
rejected(fixture, ["add", "github.com/O4FDev/data_import"], moved, "relative .min path")
let bomImport = makePackage(fixture, "bom_import", "0.1.0", Text(Character(65279)) + "use \"./implementation.txt\" as implementation\npublic function answer(): Integer { return implementation.processId() }\n", "")
io.writeTextFile(bomImport + "/src/implementation.txt", "public function processId(): Integer { native \"system\" }\n")
commit(fixture, bomImport, "0.1.0"); mirror(fixture, "bom_import", bomImport)
rejected(fixture, ["add", "github.com/O4FDev/bom_import"], moved, "relative .min path")
let terminalImport = makePackage(fixture, "terminal_import", "0.1.0", "use " + quote + Text(Character(27)) + "[31moutside.min" + quote + " as outside\n", "")
commit(fixture, terminalImport, "0.1.0"); mirror(fixture, "terminal_import", terminalImport)
let terminalError = command(fixture, [fixture.launcher, "add", "github.com/O4FDev/terminal_import"], moved)
test.check(terminalError.status != 0 && test.contains(terminalError.errorOutput, "package import escapes") && !test.contains(terminalError.errorOutput, Text(Character(27))), "untrusted module paths never inject terminal control sequences into diagnostics")
test.check(io.readTextFile(moved + "/Minyar.toml") == original, "all unsafe additions preserve the project")
print("Git packages: semver, exact commits, MVS, O0/O2, offline locks, relocation, tamper and source policy passed")
