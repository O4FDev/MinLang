use "io" as io
use "files" as files
use "system" as system
use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures

// Strict Linux-only host harness. The generated program always creates a real
// ring. There is no unsupported success branch and no mock source selection.
let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
frontend.compiler.compileTimeout = 120
frontend.compiler.linkTimeout = 120
frontend.compiler.runTimeout = 30
frontend.helpers = "#include \"minyar_stack_frames.h\"\n"
frontend.sources = ["runtime/native/completionio.c", "runtime/native/files.c", "runtime/native/system.c", "-pthread"]
let root = test.resolvePath(".")
let destination = frontend.compiler.directory + "/fixtures/neodb-completion"
print("NeoDB completion evidence: " + frontend.compiler.directory)
let prepare = #"""
    import hashlib, json, os, pathlib, shutil, sys
    if sys.platform != 'linux':
        raise SystemExit('strict NeoDB completion proof requires Linux, never skip/pass')
    root, destination = map(pathlib.Path, sys.argv[1:3])
    scratch = destination.parent.parent
    os.chmod(scratch, 0o700)
    source = root / 'tests/fixtures/neodb-simulation/src/storage'
    expected = {
        'wal.min': (32022, '1dc0de2a4cc00e6c6490686dd14b1b0f704142cf5baab5c497b8a8cc4be2635b'),
        'crc32c.min': (2280, '585a6697149eb7dd2ac828eb734dbc73841bcff4313fe23f44c4ae3c8f6514b1'),
        'util.min': (2902, 'db3a95e5e7b00dbdebed389a6afbc7fcd5a831984de00cb3aff5ef2ac458f04d'),
        'snapshot.min': (22273, '0d54ab9a5f5725cdc93929ae0db10e894dfc64b333dca1eb5b94e9fa0e6f9c65'),
    }
    (destination / 'src/storage').mkdir(parents=True)
    (destination / 'lib').mkdir()
    for name, (size, digest) in expected.items():
        original = (source / name).read_bytes()
        if len(original) != size or hashlib.sha256(original).hexdigest() != digest:
            raise SystemExit('production NeoDB source pin mismatch: ' + name)
        copied = destination / 'src/storage' / name
        copied.write_bytes(original)
        if copied.read_bytes() != original:
            raise SystemExit('production NeoDB source copy mismatch: ' + name)
    facade = root / 'tests/neodb-completion/dbio.min'
    shutil.copyfile(facade, destination / 'lib/dbio.min')
    if facade.read_bytes() != (destination / 'lib/dbio.min').read_bytes():
        raise SystemExit('test-only facade copy mismatch')
    paths = [
        'tests/neodb-completion/dbio.min', 'tests/completionio-neodb-probe.min',
        'tests/completionio-neodb.min', 'library/completionio.min',
        'library/files.min', 'library/system.min', 'runtime/native/completionio.c',
        'runtime/native/files.c', 'runtime/native/system.c',
    ]
    evidence = {
        'source': 'neo-db',
        'commit': '3dd6b03d47e66e5695feefd74603ed2ee0e5a038',
        'fixture_origin': 'tests/fixtures/neodb-simulation/README.md',
        'production_modules': {name: {'bytes': size, 'sha256': digest}
                               for name, (size, digest) in expected.items()},
        'integration_inputs': {path: hashlib.sha256((root / path).read_bytes()).hexdigest()
                               for path in paths},
        'platform': sys.platform,
        'kernel': os.uname().release,
        'provider': 'runtime/native/completionio.c; actual Linux io_uring; no mock',
        'scope': 'selected standalone dbio contract; no notification reactor',
        'power_loss_proof': False,
    }
    (scratch / 'provenance.json').write_text(json.dumps(evidence, indent=2) + '\n')
    print('NeoDB four source pins and private fixture copies verified')
    """#
let prepared = test.run(["python3", "-I", "-c", prepare, root, destination],
    system.environment(), "", frontend.compiler.directory + "/provenance", 10)
test.require(prepared, "verify four byte-for-byte production source pins and stage private fixture")
test.check(prepared.output == "NeoDB four source pins and private fixture copies verified\n" && prepared.errorOutput == "",
    "exact source provenance oracle")
// Select exactly one private evidence root, independent of inherited settings.
let environment: List<Text> = []
for item in frontend.environment {
    if !item.startsWith("MINYAR_NEODB_COMPLETION_DATA=") { environment.add(item) }
}
environment.add("MINYAR_NEODB_COMPLETION_DATA=" + frontend.compiler.directory)
frontend.environment = environment
let source = io.readTextFile("tests/completionio-neodb-probe.min")
let expected = "NeoDB kernel completion: typed READ/WRITE/FSYNC, batch/CRC/LSNs, 64 rotations, ownership, sticky failure and snapshot verified\n"
// Separate serials preserve both optimizations' LLVM, executables and logs on
// failure, rather than overwriting O0 evidence with an O2 link/run.
for optimization in ["-O0", "-O2"] {
    fixtures.executes(frontend, source, expected, [optimization], 0, "", true)
}
if test.setting("MINYAR_NEODB_COMPLETION_KEEP", "0") != "1" { test.removeTree(frontend.compiler.directory) }
print("Pinned production NeoDB WAL/snapshot typed kernel completion passed ownership at O0/O2")
