use "io" as io
use "../tools/testing.min" as test

let compiler = test.compiler()
// Old library-shaped globals are no longer part of language lookup.
for name in ["sin", "sqrt", "readTextFile", "writeTextFile", "argument", "argumentCount", "randomBytes", "fileExists", "threadProcessId", "threadSleepNanoseconds", "threadFsync"] {
    test.rejects(compiler, name + "()\n", "I can't find a function named '" + name + "'")
}
// Their source names are available to user modules.
io.writeTextFile(compiler.directory + "/own.min", test.sourceModules("public function sin(): Integer { return 7 }\npublic function readTextFile(): Integer { return 8 }\npublic function argument(): Integer { return 9 }\n"))
test.executes(compiler, "use \"./own.min\" as own\nprint(own.sin() + own.readTextFile() + own.argument())\n", "24\n")
// Text and collection conveniences remain core.
test.executes(compiler, "let text = \"  b,a  \".trim().split(\",\")\ntext.sort()\nprint(joinText(text))\n", "ab\n")
let path = compiler.directory + "/payload"
let source = "use \"io\" as io\nuse \"math\" as math\nuse \"random\" as random\nuse \"process\" as process\n"
source += "io.writeTextParts(\"" + path + "\", [\"h\", \"é🙂\"])\nprint(io.readTextFile(\"" + path + "\"))\nprint(io.readBytesFile(\"" + path + "\").length)\n"
source += "io.writeBytesFile(\"" + path + "\", Bytes(\"binary\"))\nprint(io.readTextFile(\"" + path + "\"))\nprint(io.fileExists(\"" + path + "\"))\n"
source += "print(math.sqrt(81.0))\nprint(math.sin(0.0) + math.cos(0.0))\nprint(math.round(2.5))\nprint(random.bytes(32).length)\nprint(process.argumentCount())\n"
source += "if process.processId() <= 0 || process.sleepNanoseconds(-1) != -22 || process.sleepNanoseconds(0) != 0 || io.sync(-1) != -22 { fail(\"OS module operations\") }\n"
test.executes(compiler, source, "hé🙂\n7\nbinary\ntrue\n9.0\n1.0\n3.0\n32\n0\n")
let pixels = "use \"pixels\" as pixels\nuse \"machine\" as machine\nlet image = Bytes(16)\nlet at = machine.address(image)\n"
pixels += "pixels.blendSpan(at, 4, 0x102030, 256)\npixels.blendSpan(at, 1, 0x112233, 128)\nif image.getUInt32(0) != 0x102131 || image.getUInt32(4) != 0x102030 { fail(\"pixel blend\") }\n"
pixels += "let mask = Bytes(2); mask[0] = 0; mask[1] = 255\npixels.blendMask(at + 8, 2, machine.address(mask), 0xAABBCC, 256, 0, 255)\nif image.getUInt32(8) != 0x102030 || image.getUInt32(12) != 0xAABBCC { fail(\"mask blend\") }\n"
pixels += "let areas = Bytes(); areas.addFloat32(0.25); areas.addFloat32(0.25); areas.addFloat32(-0.75); areas.addFloat32(2.0)\nlet cover = Bytes(4)\npixels.coverage(machine.address(areas), machine.address(cover), 4)\nif cover[0] != 64 || cover[1] != 128 || cover[2] != 64 || cover[3] != 255 { fail(\"coverage\") }\nprint(\"pixels passed\")\n"
pixels += "function reference(pixel: Integer, color: Integer, opacity: Integer): Integer {\nlet result = 0\nfor channel in 0..3 {\nlet shift = channel * 8\nlet left = (pixel >> shift) & 255\nlet right = (color >> shift) & 255\nresult = result | ((left * (256 - opacity) + right * opacity) >> 8) << shift\n}\nreturn result\n}\n"
pixels += "for opacity in 0..257 {\nfor index in 0..16 {\nlet pixel = (index * 1048573) & 0xFFFFFF\nlet color = ((15 - index) * 1118481) & 0xFFFFFF\nimage.setUInt32(0, pixel)\npixels.blendSpan(at, 1, color, opacity)\nif image.getUInt32(0) != reference(pixel, color, opacity) { fail(\"blend oracle\") }\n}\n}\n"
test.executes(compiler, pixels, "pixels passed\n")
test.removeScratch(compiler.directory)
print("core modules: passed")
