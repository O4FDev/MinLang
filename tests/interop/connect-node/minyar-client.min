// The Minyar Connect client (connectclient over the portable http module)
// against server.min: results, codes, details, deadlines, refused connections.
use "connect" as connect
use "connectclient" as connectclient
use "rpc" as rpc
use "process" as process
use "text" as utf8
// Ping {text=1} in proto: field 1, length, bytes.
function ping(text: Text, code: Integer, delay: Integer): Bytes {
    let out = Bytes()
    out.add(10); out.add(Bytes(text).length); out.addBytes(Bytes(text))
    if code > 0 { out.add(16); out.add(code) }
    if delay > 0 { out.add(24); out.add(delay & 127 | 128); out.add(delay >> 7) }
    return out
}
let transport = connectclient.transport("http://127.0.0.1:" + process.argument(0), [], 5000, 1048576).unwrap()
let client = connect.client("", "proto", transport, "cc")
match client.unary("/minyar.interop.v1.Interop/Echo", ping("hi", 0, 0), connect.callOptions()) {
    Ok(reply) { print("echo " + Text(reply.message.length) + " " + reply.trailers[0].name) }
    Err(f) { print("echo failed " + f.error.message) }
}
match client.unary("/minyar.interop.v1.Interop/Fail", ping("no", 7, 0), connect.callOptions()) {
    Ok(_) { print("unexpected") }
    Err(f) { print(rpc.codeName(f.error.code) + " " + f.error.message + " " + f.error.details[0].type) }
}
let quick = connect.callOptions()
quick.timeoutMilliseconds = 100
match client.unary("/minyar.interop.v1.Interop/Slow", ping("", 0, 400), quick) {
    Ok(_) { print("unexpected") }
    Err(f) { print(rpc.codeName(f.error.code)) }
}
match client.unary("/minyar.interop.v1.Interop/Missing", ping("", 0, 0), connect.callOptions()) {
    Ok(_) { print("unexpected") }
    Err(f) { print(rpc.codeName(f.error.code)) }
}
let dead = connect.client("", "proto", connectclient.transport("http://127.0.0.1:1", [], 1000, 1024).unwrap(), "x")
match dead.unary("/a/B", Bytes(), connect.callOptions()) {
    Ok(_) { print("unexpected") }
    Err(f) { print(rpc.codeName(f.error.code)) }
}
