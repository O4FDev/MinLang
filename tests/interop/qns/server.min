// HTTP/0.9 files for the official interop runner, with fixture-only NSS logs.
use "quic" as quic
use "quicwire" as wire
use "crypto" as crypto
use "net" as net
use "errors" as errors
use "eventloop" as loop
use "quicinteropio" as file
use "tlstickets" as tickets
use "quicretry" as retry
record Transfer { id: Integer; request: Bytes; handle: Integer; size: Integer; sent: Integer; pending: Bytes; done: Boolean }
record Route { id: Integer; address: Text; port: Integer; socket: Integer }
record Peer { connection: quic.Connection; routes: List<Route>; nextRoute: Integer; transfers: List<Transfer>; logged: Boolean; writeLogged: Integer; readLogged: Integer; random: Text }
function routeFor(peer: Peer, socket: Integer, address: Text, port: Integer): Integer {
    for route in peer.routes { if route.socket == socket && route.address == address && route.port == port { return route.id } }
    let retained: List<Route> = []
    for route in peer.routes {
        for path in peer.connection.paths { if path.id == route.id { retained.add(route) } }
    }
    peer.routes = retained
    if peer.routes.length >= 8 { return -1 }
    let id = peer.nextRoute; peer.nextRoute += 1
    peer.routes.add(Route { id: id; address: address; port: port; socket: socket })
    return id
}
function httpPolicy(connection: quic.Connection) {
    // The independent early-data case sends forty concurrent tiny requests.
    // Keep the production default separate and the fixture below its 128
    // active-record bound. The authenticated ticket remembers this policy.
    connection.receiveBidi=64
    let parameters=wire.parameters(connection.serverTLS.transportParameters,true);let changed=Bytes()
    for parameter in parameters.parameters {
        let value=parameter.value;if parameter.id==8 { value=errors.bytesValue(wire.encode(64)) }
        changed.addBytes(errors.bytesValue(wire.encode(parameter.id)));changed.addBytes(errors.bytesValue(wire.encode(value.length)));changed.addBytes(value)
    }
    connection.serverTLS.transportParameters=changed
}
function logKeys(peer: Peer, path: Text) {
    let session=peer.connection.serverTLS
    if !peer.logged && (session.clientApplication.length!=32 || session.transcript.length<38) { return }
    if !peer.logged {
        peer.random=crypto.hex(session.transcript.slice(6,38))
    }
    let random=peer.random
    if !peer.logged {
        file.append(path,"CLIENT_HANDSHAKE_TRAFFIC_SECRET "+random+" "+crypto.hex(session.clientSecret)+"\nSERVER_HANDSHAKE_TRAFFIC_SECRET "+random+" "+crypto.hex(session.serverSecret)+"\nCLIENT_TRAFFIC_SECRET_0 "+random+" "+crypto.hex(session.clientApplication)+"\nSERVER_TRAFFIC_SECRET_0 "+random+" "+crypto.hex(session.serverApplication)+"\n")
        peer.logged=true
    }
    let space=peer.connection.spaces[2]
    if space.writeGeneration>peer.writeLogged { file.append(path,"SERVER_TRAFFIC_SECRET_"+Text(space.writeGeneration)+" "+random+" "+crypto.hex(space.write.secret)+"\n");peer.writeLogged=space.writeGeneration }
    if space.readGeneration>peer.readLogged { file.append(path,"CLIENT_TRAFFIC_SECRET_"+Text(space.readGeneration)+" "+random+" "+crypto.hex(space.read.secret)+"\n");peer.readLogged=space.readGeneration }
}
function integer(text: Text): Integer {
    let result=0
    for digit in text { if digit<'0' || digit>'9' { return -1 };result=result*10+Integer(digit)-48 }
    return result
}
function bind(port: Integer): Integer {
    let socket=net.udp("::",port)
    if socket<0 { socket=net.udp("0.0.0.0",port) }
    return socket
}

function ended(request: Bytes): Boolean { return request.length >= 2 && request[request.length - 2] == 13 && request[request.length - 1] == 10 }
function requested(request: Bytes): Text {
    let text = Text(request)
    if request.length > 4096 || crypto.hex(request.slice(0, 5)) != "474554202f" || !ended(request) { return "" }
    let name = text.slice(5, text.length - 2)
    if name.length < 1 || name.length > 255 { return "" }
    for character in name { if !(character >= 'a' && character <= 'z') && !(character >= 'A' && character <= 'Z') && !(character >= '0' && character <= '9') && character != '-' && character != '_' { return "" } }
    return name
}
function main(): Integer {
    let key = readBytesFile(argument(0)); let root = readBytesFile(argument(1)); let keyLog = argument(2); let directory = argument(3)
    let identity: List<Bytes> = [];let bindPort=443;let preferredPort=444
    let preferred4=crypto.fromHex("c1a76464");let preferred6=Bytes(16)
    for index in 5..argumentCount() {
        let value=argument(index)
        if value.length>7 && value.slice(0,7)=="--port=" { bindPort=integer(value.slice(7,value.length)) }
        else if value.length>17 && value.slice(0,17)=="--preferred-ipv4=" { preferred4=crypto.fromHex(value.slice(17,value.length)) }
        else if value.length>17 && value.slice(0,17)=="--preferred-ipv6=" { preferred6=crypto.fromHex(value.slice(17,value.length)) }
        else if value.length>17 && value.slice(0,17)=="--preferred-port=" { preferredPort=integer(value.slice(17,value.length)) }
        else { identity.add(readBytesFile(value)) }
    }
    if bindPort<1 || bindPort>65535 || preferredPort<1 || preferredPort>65535 { return 8 }
    let preferredPort4=0;let preferredPort6=0
    for byte in preferred4 { if byte!=0 { preferredPort4=preferredPort } }
    for byte in preferred6 { if byte!=0 { preferredPort6=preferredPort } }
    let socket=bind(bindPort);if socket<0 { print("QNS bind failed");return 1 }
    let sockets=[socket];let eventLoop=errors.integerValue(loop.create());loop.watch(eventLoop,socket,loop.readableInterest(),0)
    if argument(4)=="connectionmigration" {
        let alternative=bind(preferredPort);if alternative<0 { return 9 }
        sockets.add(alternative);loop.watch(eventLoop,alternative,loop.readableInterest(),1)
    }
    let store = tickets.store(randomBytes(16), 3600)
    let retries = retry.store(randomBytes(16),30000)
    if argument(4) == "zerortt" { tickets.allowEarlyData(store, 0xffffffff) }
    let peers: List<Peer> = []; let started = net.monotonicMilliseconds(); let now = 0
    print("QNS server ready")
    while now < 300000 {
        now = net.monotonicMilliseconds() - started; let timeout = 1000; let active: List<Peer> = []
        for peer in peers {
            let connection = peer.connection
            if connection.state == quic.ESTABLISHED || connection.serverTLS.earlyAccepted {
                for stream in connection.streams {
                    let index = -1; for at in 0..peer.transfers.length { if peer.transfers[at].id == stream.id { index = at } }
                    if index < 0 {
                        if peer.transfers.length >= 128 { return 2 }
                        peer.transfers.add(Transfer { id: stream.id; request: Bytes(); handle: -1; size: 0; sent: 0; pending: Bytes(); done: false }); index = peer.transfers.length - 1
                    }
                    let transfer = peer.transfers[index]
                    if transfer.handle >= 0 {
                        let completion=quic.readStream(connection,stream.id)
                        if errors.bytesOk(completion) && errors.bytesValue(completion).length>0 { print("unexpected request body");return 3 }
                    }
                    if !transfer.done {
                        if transfer.handle < 0 {
                            let read = quic.readStream(connection, stream.id)
                            if errors.bytesOk(read) { transfer.request.addBytes(errors.bytesValue(read)) }
                            if transfer.request.length > 4096 { print("invalid request"); return 3 }
                            if ended(transfer.request) {
                                let name = requested(transfer.request)
                                if name == "" { print("invalid path"); return 4 }
                                transfer.handle = file.openRead(directory + "/" + name); transfer.size = file.size(transfer.handle)
                                if transfer.handle < 0 || transfer.size < 0 || transfer.size > 67108864 { print("file unavailable"); return 5 }
                            }
                        }
                        if transfer.handle > 0 && connection.state == quic.ESTABLISHED {
                            if transfer.pending.length == 0 && transfer.sent < transfer.size { transfer.pending = file.read(transfer.handle, min(16384, transfer.size - transfer.sent)) }
                            if transfer.pending.length == 0 && transfer.sent < transfer.size { return 6 }
                            let final = transfer.sent + transfer.pending.length == transfer.size
                            let written = quic.writeStream(connection, stream.id, transfer.pending, final)
                            if errors.integerOk(written) {
                                transfer.sent += transfer.pending.length; transfer.pending = Bytes()
                                if final { transfer.done = true; file.close(transfer.handle) }
                            }
                        }
                    }
                }
            }
            for packet in quic.pollDatagrams(connection, now) {
                for route in peer.routes { if route.id == packet.pathId { net.sendDatagramTo(route.socket, route.address, route.port, packet.data) } }
            }
            let retained: List<Transfer> = []
            for transfer in peer.transfers {
                let present=false;for stream in connection.streams { if stream.id==transfer.id { present=true } }
                if present || !transfer.done { retained.add(transfer) }
            }
            peer.transfers=retained
            if connection.state == quic.FAILED { print("FAILED " + connection.error) }
            if (connection.state != quic.FAILED && connection.state != quic.CLOSED) || connection.closing || connection.draining { timeout = min(timeout, max(0, quic.nextTimer(connection) - now)); active.add(peer) }
            else { for transfer in peer.transfers { if transfer.handle > 0 && !transfer.done { file.close(transfer.handle) } } }
        }
        peers = active
        let batch = loop.wait(eventLoop, timeout, 64); if errors.isError(loop.batchError(batch)) { return 7 }
        now = net.monotonicMilliseconds() - started
        for event in loop.events(batch) {
            if event.token<0 || event.token>=sockets.length { continue }
            let incomingSocket=sockets[event.token]
            let packets = net.receiveDatagrams(incomingSocket, 64, 65535)
            if net.datagramBatchOk(packets) { for packet in net.datagrams(packets) {
                let data = net.datagramData(packet)
                if errors.bytesOk(data) {
                    let bytes = errors.bytesValue(data); let header = wire.header(bytes, 0, 8); let index = -1
                    if !header.valid || (header.kind != wire.ONE_RTT && header.version != 1) {
                        let response = wire.negotiateVersion(bytes)
                        if errors.bytesOk(response) { net.sendDatagramTo(incomingSocket, net.datagramSource(packet), net.datagramPort(packet), errors.bytesValue(response)) }
                        continue
                    }
                    if header.valid {
                        for at in 0..peers.length { if quic.ownsConnectionId(peers[at].connection, header.destination) || crypto.hex(header.destination) == crypto.hex(peers[at].connection.initialDestination) { index = at } }
                        if index < 0 && header.kind == wire.INITIAL && bytes.length >= 1200 && peers.length < 64 {
                            if argument(4)=="retry" {
                                let address=Bytes(net.datagramSource(packet)+"#"+Text(net.datagramPort(packet)))
                                if header.token.length==0 {
                                    let response=retry.reply(retries,bytes,address,randomBytes(8),now)
                                    if errors.bytesOk(response) { net.sendDatagramTo(incomingSocket,net.datagramSource(packet),net.datagramPort(packet),errors.bytesValue(response)) }
                                    continue
                                }
                                let validated=retry.validateInitial(retries,bytes,address,now)
                                if !retry.valid(validated) { continue }
                                let connection=quic.serverAfterRetry(randomBytes(80),"hq-interop",validated,identity,key,[root],false)
                                httpPolicy(connection)
                                if argument(4)=="chacha20" && !errors.booleanOk(quic.setCipherSuites(connection,[0x1303])) { return 10 }
                                peers.add(Peer { connection: connection; routes: [Route { id: 0; address: net.datagramSource(packet); port: net.datagramPort(packet); socket: incomingSocket }]; nextRoute: 1; transfers: []; logged: false; writeLogged: 0; readLogged: 0; random: "" })
                            } else {
                                let connection = quic.serverWithTickets(randomBytes(80), "hq-interop", header.destination, identity, key, [root], false, store)
                                httpPolicy(connection)
                                if argument(4)=="chacha20" && !errors.booleanOk(quic.setCipherSuites(connection,[0x1303])) { return 10 }
                                if argument(4)=="connectionmigration" && !errors.booleanOk(quic.configurePreferredAddress(connection,preferred4,preferredPort4,preferred6,preferredPort6)) { return 11 }
                                peers.add(Peer { connection: connection; routes: [Route { id: 0; address: net.datagramSource(packet); port: net.datagramPort(packet); socket: incomingSocket }]; nextRoute: 1; transfers: []; logged: false; writeLogged: 0; readLogged: 0; random: "" })
                            }
                            index = peers.length - 1
                        }
                        if index >= 0 {
                            let peer = peers[index]; let route = routeFor(peer,incomingSocket,net.datagramSource(packet),net.datagramPort(packet))
                            if route >= 0 { quic.receivePath(peer.connection, bytes, route, now); logKeys(peer, keyLog) }
                        }
                    }
                }
            } }
        }
    }
    loop.close(eventLoop);for socket in sockets { net.close(socket) }
    return 0
}
