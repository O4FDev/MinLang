FROM python:3.13-slim-bookworm AS python
FROM ubuntu:26.04
COPY --from=python /usr/local /usr/local
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3-venv tshark ethtool iproute2 docker.io docker-compose-v2 openssl git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/quic-runner && /opt/quic-runner/bin/pip install --no-cache-dir pycryptodome==3.24.1 random-slugs==1.0.4 termcolor==3.3.0 prettytable==3.18.0 pyshark==0.6 && /opt/quic-runner/bin/python -c 'import tempfile, struct, pyshark; source = tempfile.NamedTemporaryFile(); source.write(struct.pack("<IHHIIII", 0xa1b2c3d4, 2, 4, 0, 0, 65535, 1)); source.flush(); capture = pyshark.FileCapture(source.name); assert list(capture) == []; capture.close(); source.close()'
