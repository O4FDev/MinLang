public record Failure { serial: Integer; kind: Text; message: Text; notes: List<Text> }
public record StageError { stage: Text; kind: Text; message: Text }
public record Seams {
    clock: Callback<Integer>
    fault: Callback<Text, Text, Result<Boolean, Failure>>
    serial: List<Integer>
}

function realClock(): Callback<Integer> {
    return function(): Integer { return system.monotonicNanoseconds() }
}
function noFault(): Callback<Text, Text, Result<Boolean, Failure>> {
    return function(point: Text, detail: Text): Result<Boolean, Failure> { return Ok<Boolean, Failure>(true) }
}
function defaultSeams(): Seams {
    return Seams { clock: realClock(); fault: noFault(); serial: [0] }
}
public global SEAMS: Seams = defaultSeams()

public function resetSeams() {
    let seams = SEAMS
    seams.clock = realClock()
    seams.fault = noFault()
}
public function now(): Integer {
    let seams = SEAMS
    let clock = seams.clock
    return clock()
}
public function fault(point: Text, detail: Text): Result<Boolean, Failure> {
    let seams = SEAMS
    let hook = seams.fault
    return hook(point, detail)
}

public function failure(kind: Text, message: Text): Failure {
    let seams = SEAMS
    seams.serial[0] += 1
    return Failure { serial: seams.serial[0]; kind: kind; message: message; notes: [] }
}
public function ownership(message: Text): Failure { return failure("OwnershipError", message) }
public function cleanup(message: Text): Failure { return failure("CleanupError", message) }
public function same(left: Failure, right: Failure): Boolean { return left.serial == right.serial }
public function bytesEqual(left: Bytes, right: Bytes): Boolean {
    if left.length != right.length { return false }
    for index in 0..left.length { if left[index] != right[index] { return false } }
    return true
}

public function note(primary: Failure, value: Text) { primary.notes.add(value) }
public function hasNote(primary: Failure, needle: Text): Boolean {
    for value in primary.notes { if contains(value, needle) { return true } }
    return false
}
public function errorText(code: Integer): Text { return files.errorText(code) }
public function systemFailure(code: Integer, detail: Text): Failure {
    let kind = "OSError"
    if code == 2 { kind = "FileNotFoundError" }
    else if code == 3 { kind = "ProcessLookupError" }
    else if code == 10 { kind = "ChildProcessError" }
    else if code == 1 || code == 13 { kind = "PermissionError" }
    else if code == 17 { kind = "FileExistsError" }
    else if code == 20 { kind = "NotADirectoryError" }
    else if code == 21 { kind = "IsADirectoryError" }
    else if code == 11 { kind = "BlockingIOError" }
    else if code == 32 { kind = "BrokenPipeError" }
    let message = "[Errno " + Text(code) + "] " + errorText(code)
    if detail != "" { message = message + ": '" + detail + "'" }
    return failure(kind, message)
}
public function lookupMissing(value: Failure): Boolean {
    return value.kind == "FileNotFoundError" || value.kind == "ProcessLookupError"
}
public function exception(value: Failure): json.Value {
    return data.object(["type", "message"], [data.string(value.kind), data.string(value.message)])
}
public function stageError(stage: Text, value: Failure): StageError {
    return StageError { stage: stage; kind: value.kind; message: value.message }
}
public function stageJson(value: StageError): json.Value {
    if value.stage == "" { return data.object(["type", "message"], [data.string(value.kind), data.string(value.message)]) }
    return data.object(["stage", "type", "message"], [data.string(value.stage), data.string(value.kind), data.string(value.message)])
}
public function stageList(values: List<StageError>): json.Value {
    let items: List<json.Value> = []
    for value in values { items = items.appended(stageJson(value)) }
    return data.array(items)
}

public function contains(source: Text, needle: Text): Boolean { return source.find(needle) >= 0 }
public function replaceAll(source: Text, needle: Text, replacement: Text): Text {
    if needle == "" { return source }
    let parts: List<Text> = []
    let rest = source
    while true {
        let found = rest.find(needle)
        if found < 0 { break }
        parts.add(rest.slice(0, found))
        parts.add(replacement)
        rest = rest.slice(found + needle.length, rest.length)
    }
    parts.add(rest)
    return joinText(parts)
}
public function count(source: Text, needle: Text): Integer {
    if needle == "" { return 0 }
    let total = 0
    let rest = source
    while true {
        let found = rest.find(needle)
        if found < 0 { return total }
        total += 1
        rest = rest.slice(found + needle.length, rest.length)
    }
    return total
}
public function zeroFill(value: Integer, width: Integer): Text {
    let result = Text(value)
    while result.length < width { result = "0" + result }
    return result
}
public function lowerHex(value: Text, size: Integer): Boolean {
    let raw = Bytes(value)
    if raw.length != size { return false }
    for byte in raw { if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)) { return false } }
    return true
}
public function member(values: List<Text>, value: Text): Boolean {
    for item in values { if item == value { return true } }
    return false
}
public function sameTexts(left: List<Text>, right: List<Text>): Boolean {
    if left.length != right.length { return false }
    for index in 0..left.length { if left[index] != right[index] { return false } }
    return true
}
public function sameSet(left: List<Text>, right: List<Text>): Boolean {
    return sameTexts(unique(left.sorted()), unique(right.sorted()))
}
public function unique(values: List<Text>): List<Text> {
    let result: List<Text> = []
    for value in values { if !member(result, value) { result.add(value) } }
    return result
}
public function durationText(nanoseconds: Integer): Text {
    if nanoseconds % SECOND == 0 { return Text(nanoseconds / SECOND) }
    let whole = Text(nanoseconds / SECOND)
    let fraction = zeroFill(nanoseconds % SECOND, 9)
    while fraction.endsWith("0") { fraction = fraction.slice(0, fraction.length - 1) }
    return whole + "." + fraction
}
public function seconds(nanoseconds: Integer): json.Value { return data.decimal(durationText(nanoseconds)) }

