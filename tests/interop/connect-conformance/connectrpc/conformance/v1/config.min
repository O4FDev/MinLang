    registry.add(protobuf.TypeEntry { fullName: "connectrpc.conformance.v1.Config"; toJson: anyJsonConfig; fromJson: anyBinaryConfig; wrapped: false })
    registry.add(protobuf.TypeEntry { fullName: "connectrpc.conformance.v1.Features"; toJson: anyJsonFeatures; fromJson: anyBinaryFeatures; wrapped: false })
    registry.add(protobuf.TypeEntry { fullName: "connectrpc.conformance.v1.ConfigCase"; toJson: anyJsonConfigCase; fromJson: anyBinaryConfigCase; wrapped: false })
    registry.add(protobuf.TypeEntry { fullName: "connectrpc.conformance.v1.TLSCreds"; toJson: anyJsonTLSCreds; fromJson: anyBinaryTLSCreds; wrapped: false })
}
