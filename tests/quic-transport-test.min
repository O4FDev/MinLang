use "../tools/testing.min" as test
use "./quic-test-support.min" as quic
use "system" as system
use "files" as files

constant MODES: List<Text> = ["key-update", "migration", "migration-cids", "server-protocol", "resumption", "quic-resumption", "early", "fallback", "congestion", "stream-control", "stream-churn", "closing", "persistent", "retry", "rtt"]
constant PROGRAMS: List<Text> = ["tests/quic-key-update.min", "tests/quic-migration.min", "tests/quic-migration-cids.min", "tests/tls-server-protocol.min", "tests/tls-resumption.min", "tests/quic-resumption.min", "tests/quic-early.min", "tests/transport.min", "tests/quic-congestion.min", "tests/quic-stream-control.min", "tests/quic-stream-churn.min", "tests/quic-closing.min", "tests/quic-persistent.min", "tests/quic-retry.min", "tests/quic-rtt.min"]

function selected(mode: Text): Text {
    let modes = MODES
    let programs = PROGRAMS
    for index in 0..modes.length { if modes[index] == mode { return programs[index] } }
    return "tests/quic-transport.min"
}

let sanitize = false
let mode = ""
for index in 0..argumentCount() {
    let value = argument(index)
    if value == "--sanitize" { sanitize = true; continue }
    let known = false
    for name in MODES { if value == "--" + name { known = true } }
    test.check(known, "unknown QUIC transport option: " + value)
    test.check(mode == "", "QUIC transport modes are mutually exclusive")
    mode = quic.after(value, "--")
}
let program = selected(mode)
let directory = test.scratch()
let binary = directory + "/transport.exe"
quic.program(program, binary, sanitize)
if mode == "migration-cids" {
    let result = test.run(["./build/tooling/tests/quic-migration-cids-test", "--binary", binary, "--summary"], system.environment(), "", directory + "/cids.log", 120)
    files.writeStandardOutput(result.output)
    test.check(result.status == 0, "QUIC CID/migration cases failed (" + Text(result.status) + ")\n" + result.errorOutput)
    test.removeTree(directory)
    exit(0)
}
let ca = quic.mutual(directory)
let command = [binary]
for value in quic.peerArguments(ca) { command.add(value) }
let limit = 120
if sanitize && mode == "rtt" { limit = 240 }
let result = test.run(command, system.environment(), "", directory + "/transport.log", limit)
test.check(result.status == 0, "QUIC transport failed (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
files.writeStandardOutput(result.output)
test.removeTree(directory)
