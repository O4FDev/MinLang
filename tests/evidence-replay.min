use "process" as processInfo
use "./evidence-support.min" as evidence
use "system" as system
use "files" as files

let manifest = ""
let index = -1
let position = 0
while position < processInfo.argumentCount() {
    let value = processInfo.argument(position)
    if value == "--command" && position + 1 < processInfo.argumentCount() {
        position += 1
        index = Integer(processInfo.argument(position))
    } else if Bytes(value).length > 10 && Text(Bytes(value).slice(0, 10)) == "--command=" {
        index = Integer(Text(Bytes(value).slice(10, Bytes(value).length)))
    } else if manifest == "" {
        manifest = value
    } else {
        system.writeStandardError("usage: evidence-replay MANIFEST [--command INDEX]\n")
        exit(2)
    }
    position += 1
}
if manifest == "" {
    system.writeStandardError("usage: evidence-replay MANIFEST [--command INDEX]\n")
    exit(2)
}
let result = evidence.replay(manifest, index)
if result.error != "" {
    system.writeStandardError("ValueError: " + result.error + "\n")
    exit(1)
}
files.writeStandardOutput(Text(result.stdout))
system.writeStandardError(Text(result.stderr))
exit(((result.status % 256) + 256) % 256)
