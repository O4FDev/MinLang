// One unchanged production-size world; fixture output stays in a disposable cwd.
use "../examples/craft/terrain.min" as terrain

function flag(out: Bytes, value: Boolean) {
    if value { out.add(1) } else { out.add(0) }
}

let world = terrain.create(20260923)
let bytesAlias = world.blocks
let topsAlias = world.tops
let dirtyAlias = world.dirty
let oldTorches = world.torches
let state = Bytes()
state.addInt64(world.sizeX)
state.addInt64(world.sizeZ)
state.addInt64(world.height)
state.addInt64(world.seed)
state.addInt64(world.blocks.length)
state.addInt64(world.tops.length)
state.addInt64(world.dirty.length)
state.addInt64(world.torches.length)
let nonzero = 0
for block in world.blocks {
    if block != 0 { nonzero += 1 }
}
state.addInt64(nonzero)
let badTop = 0
for top in world.tops {
    if top != -1 { badTop += 1 }
}
state.addInt64(badTop)
let clean = 0
for dirty in world.dirty {
    if !dirty { clean += 1 }
}
state.addInt64(clean)
terrain.generate(world)
// generate intentionally leaves lighting metadata at the create sentinels.
let changedTop = 0
for top in world.tops {
    if top != -1 { changedTop += 1 }
}
state.addInt64(changedTop)
terrain.prepareLighting(world)
state.addInt64(world.torches.length)
state.addInt64(oldTorches.length)
// Restore every probe before saving; retained aliases observe actual mutations.
let last = world.blocks.length - 1
let lastValue = world.blocks[last]
world.blocks[last] = 21
flag(state, bytesAlias[last] == 21)
bytesAlias[last] = lastValue
flag(state, world.blocks[last] == lastValue)
let firstTop = world.tops[0]
world.tops[0] = -9
flag(state, topsAlias[0] == -9)
topsAlias[0] = firstTop
flag(state, world.tops[0] == firstTop)
world.dirty[0] = false
flag(state, !dirtyAlias[0])
dirtyAlias[0] = true
flag(state, world.dirty[0])
writeBytesFile("world.bin", world.blocks)
let tops = Bytes()
for top in world.tops { tops.addInt64(top) }
writeBytesFile("tops.bin", tops)
let dirty = Bytes()
for value in world.dirty { flag(dirty, value) }
writeBytesFile("dirty.bin", dirty)
writeBytesFile("state.bin", state)
print("round7 generation and lighting returned")
