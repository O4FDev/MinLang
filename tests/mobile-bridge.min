use "mobile" as mobile

record Model {
    count: Integer
    name: Text
    checked: Boolean
    renders: Integer
    events: List<mobile.Event>
}

function draw(model: Model): () -> Nothing {
    return function() {
        model.renders += 1
        mobile.begin()
        let root = mobile.node(0, 7, "", "", false, 12, 16)
        mobile.node(root, 1, "state", "Count \(model.count): \(model.name)", false, 0, 0)
        mobile.node(root, 3, "add", "Add", false, 0, 0)
        mobile.node(root, 4, "name", model.name, false, 0, 0)
        mobile.node(root, 5, "active", "Ready ✓", model.checked, 0, 0)
        mobile.end()
    }
}

function update(model: Model): (mobile.Event) -> Nothing {
    return function(event: mobile.Event) {
        model.events.add(event)
        if event.kind == mobile.ACTION {
            if event.key != "add" || event.text != "" || event.checked { fail("action payload changed") }
            model.count += 1
        }
        if event.kind == mobile.CHANGE {
            if event.key == "name" { model.name = event.text }
            if event.key == "active" { model.checked = event.checked }
        }
        if event.kind == mobile.SUBMIT {
            if event.key != "name" { fail("submit key changed") }
            model.name = event.text
            model.count += 10
        }
    }
}

function round(index: Integer) {
    let model = Model { count: 0; name: "Hello 🌍"; checked: false; renders: 0; events: [] }
    mobile.run("Mobile 🌕 " + Text(index), draw(model), update(model))
    if model.count != 11 || model.name != "Zoë 🌕!" || model.checked || model.renders != 7 {
        fail("callbacks lost captured model state")
    }
    if model.events.length != 5 { fail("draw dispatched an update or an event disappeared") }
    // These records outlive every callback and the fake native event buffers.
    let keys = ["add", "name", "active", "active", "name"]
    let texts = ["", "Zoë 🌕", "", "", "Zoë 🌕!"]
    let kinds = [mobile.ACTION, mobile.CHANGE, mobile.CHANGE, mobile.CHANGE, mobile.SUBMIT]
    for position in 0..5 {
        let event = model.events[position]
        if event.kind != kinds[position] || event.key != keys[position] || event.text != texts[position] {
            fail("event Text did not survive native buffer reuse")
        }
        if event.checked != (position == 2) { fail("event Boolean changed") }
    }
}

for index in 0..64 { round(index) }
print("64 mobile sessions; 448 snapshots; 320 retained events")
print("Unicode event copies and captured model updates passed")
