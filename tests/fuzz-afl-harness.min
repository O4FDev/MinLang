use "io" as io
use "../tools/testing.min" as test
use "system" as system
use "files" as files

record Campaign { result: test.Result; argv: List<Text>; llvm: Text; recorded: Boolean }

function executable(path: Text, source: Text) {
    io.writeTextFile(path, source)
    test.require(test.run(["/bin/chmod", "755", path], system.environment(), "", path + ".chmod", 10), "chmod " + path)
}
function copy(from: Text, to: Text) {
    io.writeBytesFile(to, io.readBytesFile(from))
    test.require(test.run(["/bin/chmod", "755", to], system.environment(), "", to + ".chmod", 10), "chmod " + to)
}
function campaign(scratch: Text, label: Text, validate: Boolean, executions: Text, finding: Text): Campaign {
    let root = scratch + "/" + label
    for name in ["", "/scripts", "/tests", "/tests/fuzz-corpus", "/tests/fuzz-corpus/inputs", "/runtime", "/bin", "/build", "/build/tooling", "/build/tooling/tools"] {
        test.check(files.makeDirectory(root + name) == 0, "cannot create AFL fixture directory " + name)
    }
    copy("scripts/fuzz-afl.sh", root + "/scripts/fuzz-afl.sh")
    copy("build/tooling/tools/sanitize-llvm", root + "/build/tooling/tools/sanitize-llvm")
    io.writeTextFile(root + "/runtime/minyar_runtime.c", "/* stub */\n")
    io.writeTextFile(root + "/tests/fuzz-corpus/minyar.dict", "\"print\"\n")
    io.writeTextFile(root + "/tests/fuzz-corpus/inputs/seed.min", test.sourceModules("print(1)\n"))
    executable(root + "/bin/make", "#!/bin/sh\nproject=\nprevious=\nfor item do\n  if [ \"$previous\" = -C ]; then project=$item; fi\n  previous=$item\ndone\nmkdir -p \"$project/build\"\nprintf 'define void @value() {\\n  ret void\\n}\\n' > \"$project/build/compiler-stage2.ll\"\n")
    executable(root + "/bin/afl-clang-fast", "#!/bin/sh\nsource=\nruntime=0\nlibm=0\nout=\nindex=0\nprevious=\nfor item do\n  index=$((index + 1))\n  case $item in *.ll) if [ -z \"$source\" ]; then source=$item; fi;; esac\n  case $item in *minyar_runtime.c) if [ \"$runtime\" -eq 0 ]; then runtime=$index; fi;; esac\n  if [ \"$item\" = -lm ] && [ \"$libm\" -eq 0 ]; then libm=$index; fi\n  if [ \"$previous\" = -o ]; then out=$item; fi\n  previous=$item\ndone\nif [ \"$VALIDATE_INSTRUMENTATION\" = 1 ]; then\n  grep -q sanitize_address \"$source\" || { echo 'generated LLVM lacks sanitize_address' >&2; exit 1; }\n  if [ \"$runtime\" -eq 0 ] || [ \"$libm\" -le \"$runtime\" ]; then echo 'libm must follow runtime source' >&2; exit 1; fi\n  if [ \"$AFL_USE_ASAN\" != 1 ] || [ \"$AFL_USE_UBSAN\" != 1 ]; then echo 'AFL sanitizers were not requested' >&2; exit 1; fi\nfi\nprintf '%s\\n' \"$@\" > \"$AFL_BUILD_RECORD.argv\"\ncat \"$source\" > \"$AFL_BUILD_RECORD.llvm\"\nprintf 'stub target' > \"$out\"\n")
    executable(root + "/bin/afl-fuzz", "#!/bin/sh\nout=\nprevious=\nfor item do\n  if [ \"$previous\" = -o ]; then out=$item; fi\n  previous=$item\ndone\nmkdir -p \"$out/default\"\nif [ \"$FAKE_EXECS\" != missing ]; then printf 'execs_done : %s\\n' \"$FAKE_EXECS\" > \"$out/default/fuzzer_stats\"; fi\nif [ -n \"$FAKE_FINDING\" ]; then mkdir \"$out/default/$FAKE_FINDING\"; printf bad > \"$out/default/$FAKE_FINDING/id:000000\"; fi\n")
    let environment: List<Text> = []
    let names = ["PATH", "MINYAR_AFL_SECONDS", "VALIDATE_INSTRUMENTATION", "AFL_BUILD_RECORD", "FAKE_EXECS", "FAKE_FINDING", "AFL_CC", "AFL_FUZZ", "MINYAR_AFL_FINDINGS"]
    for entry in system.environment() {
        let keep = true
        for name in names { if Bytes(entry).length > Bytes(name).length && Text(Bytes(entry).slice(0, Bytes(name).length + 1)) == name + "=" { keep = false } }
        if keep { environment.add(entry) }
    }
    let validation = "0"
    if validate { validation = "1" }
    let values = [root + "/bin:" + system.getenv("PATH"), "1", validation, root + "/record", executions, finding,
        root + "/bin/afl-clang-fast", root + "/bin/afl-fuzz", root + "/findings"]
    for index in 0..names.length { environment.add(names[index] + "=" + values[index]) }
    let result = test.run(["sh", root + "/scripts/fuzz-afl.sh"], environment, "", scratch + "/" + label + ".log", 15)
    let recorded = files.pathSize(root + "/record.argv") >= 0
    let argv: List<Text> = []
    let llvm = ""
    if recorded {
        argv = test.lines(io.readTextFile(root + "/record.argv"))
        llvm = io.readTextFile(root + "/record.llvm")
    }
    return Campaign { result: result; argv: argv; llvm: llvm; recorded: recorded }
}

let scratch = test.scratch()
let prepared = campaign(scratch, "prepared", true, "3", "")
test.check(prepared.result.status == 0, "instrumented AFL campaign failed\n" + prepared.result.errorOutput)
test.check(prepared.recorded && test.contains(prepared.llvm, "sanitize_address"), "generated compiler IR was not prepared for ASan")
let output = -1
for index in 0..prepared.argv.length { if prepared.argv[index] == "-o" { output = index } }
test.check(output > 0 && prepared.argv[output - 1] == "-lm", "libm must be the last input before the AFL target output")

let idle = campaign(scratch, "zero-executions", false, "0", "")
test.check(idle.result.status != 0 && test.contains(idle.result.errorOutput, "executions"), "zero-execution campaign passed\n" + idle.result.errorOutput)
let missing = campaign(scratch, "missing-stats", false, "missing", "")
test.check(missing.result.status != 0 && test.contains(missing.result.errorOutput, "stats"), "campaign without stats passed\n" + missing.result.errorOutput)
for category in ["crashes", "hangs"] {
    let found = campaign(scratch, category, false, "3", category)
    test.check(found.result.status != 0 && test.contains(found.result.errorOutput, category), "AFL " + category + " did not fail the campaign\n" + found.result.errorOutput)
}
test.removeTree(scratch)
print("AFL harness: 5 campaigns checked")
