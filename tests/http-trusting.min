// Portable http with caller trust roots: http.environmentTrust() reads SSL_CERT_FILE; mode "fetch" uses
// fetchTrusting and mode "client" the streaming Client with the same roots. Arguments: URL, mode.
use "process" as processInfo
use "http" as http

function main(): Integer {
    let url = processInfo.argument(0)
    match http.environmentTrust() {
        Ok(roots) {
            print("roots " + Text(roots.length))
            if processInfo.argument(1) == "fetch" {
                match http.fetchTrusting(url, [], 1048576, 20000, roots) {
                    Ok(reply) { print(Text(reply.status) + " " + Text(reply.body.length)); return 0 }
                    Err(problem) { print("failed: " + problem.describe()); return 1 }
                }
            }
            match http.connectTo(url, roots, 20000) {
                Ok(client) {
                    match client.begin("GET", "/", [], Bytes()) {
                        Ok(head) {
                            match client.readAll(1048576) {
                                Ok(body) { print("client " + Text(head.status) + " " + Text(body.length)); client.close(); return 0 }
                                Err(problem) { print("failed: " + problem.describe()); return 1 }
                            }
                        }
                        Err(problem) { print("failed: " + problem.describe()); return 1 }
                    }
                }
                Err(problem) { print("failed: " + problem.describe()); return 1 }
            }
        }
        Err(problem) { print("trust: " + problem.describe()); return 1 }
    }
}
