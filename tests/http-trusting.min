// Portable http with caller trust roots: http.environmentTrust() reads SSL_CERT_FILE, fetchTrusting uses only it.
use "process" as processInfo
use "http" as http

function main(): Integer {
    match http.environmentTrust() {
        Ok(roots) {
            print("roots " + Text(roots.length))
            match http.fetchTrusting(processInfo.argument(0), [], 1048576, 20000, roots) {
                Ok(reply) { print(Text(reply.status)); return 0 }
                Err(problem) { print("failed: " + problem.describe()); return 1 }
            }
        }
        Err(problem) { print("trust: " + problem.describe()); return 1 }
    }
}
