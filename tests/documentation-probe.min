function requireDocumentation(condition: Boolean, message: Text) { if !condition { fail(message) } }
function main() {
    let source = "/// A light.\nrecord Light {\n    /// Its name.\n    name: Text\n}\n/// Make it twice as bright.\nfunction twice(value: Integer): Integer { return value * 2 }\n"
    let kinds: List<Integer> = []
    let texts: List<Text> = []
    let locations = newSourceMap()
    locations.inputPath = "docs/é🙂.min"
    tokenize(source, kinds, texts, locations)
    let empty: List<Integer> = []
    let context = prepareSyntaxContext(kinds, texts, locations, empty, empty)
    let output: List<Text> = []
    let globals: List<Text> = []
    compileFunctions(context, output, globals, 0, "", empty)
    let tree = context.syntax
    requireDocumentation(tree.declarations.length == 2, "two declarations")
    requireDocumentation(tree.nodes[0].documentation == "", "the module root does not inherit its first declaration comment")
    let record = tree.declarations[0]
    let function = tree.declarations[1]
    requireDocumentation(tree.nodes[record].documentation == "A light.", "record documentation")
    requireDocumentation(tree.nodes[tree.nodes[record].firstChild].documentation == "Its name.", "field documentation")
    requireDocumentation(tree.nodes[function].documentation == "Make it twice as bright.", "function documentation")
    requireDocumentation(tree.nodes[function].type == 1, "documentation stays attached to checked signatures")
    requireDocumentation(syntaxSpan(tree, function).file == "docs/é🙂.min" && syntaxSpan(tree, function).line == 7, "source span")
    let copiedKinds: List<Integer> = []
    let copiedTexts: List<Text> = []
    let copiedLines = newSourceMap()
    let path = sourcePath(copiedLines, "copied.min")
    let position = 0
    while position < kinds.length {
        copyModuleToken(copiedKinds, copiedTexts, copiedLines, kinds[position], texts[position], locations, position, path)
        position += 1
    }
    let copied = prepareSyntaxContext(copiedKinds, copiedTexts, copiedLines, empty, empty)
    requireDocumentation(copied.syntax.nodes[copied.syntax.declarations[1]].documentation == "Make it twice as bright.", "documentation survives token transformations")
    let plain = "// A light.\nrecord Light {\n    // Its name.\n    name: Text\n}\n// Make it twice as bright.\nfunction twice(value: Integer): Integer { return value * 2 }\n"
    requireDocumentation(compileProgram(source) == compileProgram(plain), "documentation emits no runtime code or literals")
    print("documentation tree verified")
}
