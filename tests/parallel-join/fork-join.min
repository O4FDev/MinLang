// Fork-join on the work-stealing pool: recursive joins, joins over read-only
// buffers, nested parallel for inside parallel functions, and joins inside a
// parallel for body.
parallel function fibSerial(n: Integer): Integer {
    if n < 2 { return n }
    return fibSerial(n - 1) + fibSerial(n - 2)
}

parallel function fib(n: Integer): Integer {
    if n < 18 { return fibSerial(n) }
    let left, right = join(fib(n - 1), fib(n - 2))
    return left + right
}

parallel function sumRange(values: List<Integer>, first: Integer, after: Integer): Integer {
    if after - first <= 1000 {
        let total = 0
        for i in first..after { total += values[i] }
        return total
    }
    let middle = first + (after - first) / 2
    let low, high = join(sumRange(values, first, middle), sumRange(values, middle, after))
    return low + high
}

parallel function maxBytes(data: Bytes, first: Integer, after: Integer): Integer {
    if after - first <= 512 {
        let best = 0
        for i in first..after { best = max(best, data[i]) }
        return best
    }
    let middle = (first + after) / 2
    let a, b = join(maxBytes(data, first, middle), maxBytes(data, middle, after))
    return max(a, b)
}

parallel function area(steps: Integer, first: Integer, after: Integer): Float {
    if after - first <= 1000 {
        let total = 0.0
        for i in first..after {
            let x = (Float(i) + 0.5) / Float(steps)
            total += 4.0 / (1.0 + x * x)
        }
        return total
    }
    let middle = (first + after) / 2
    let left, right = join(area(steps, first, middle), area(steps, middle, after))
    return left + right
}

parallel function even(n: Integer): Boolean { return n % 2 == 0 }

// A loop inside a parallel function runs on the same pool as its caller.
parallel function fillRow(row: Bytes, base: Integer) {
    parallel for column in 0..row.length {
        row[column] = (base + column) % 251
    }
}

function total(values: List<Integer>): Integer {
    let low, high = join(sumRange(values, 0, values.length / 2), sumRange(values, values.length / 2, values.length))
    return low + high
}

function main() {
    print(fib(27))
    let values: List<Integer> = []
    for i in 0..200001 { values.add(i * 3 - 7) }
    print(sumRange(values, 0, values.length))
    print(total(values))
    let data = Bytes(100000)
    data[77777] = 200
    data[5] = 199
    print(maxBytes(data, 0, data.length))
    let pi, check = join(area(1000000, 0, 1000000), even(10))
    print(Integer(pi / 1000000.0 * 1000000.0))
    print(check)
    let grid = Bytes(64 * 300)
    parallel for row in 0..64 {
        let slots = grid.window(row, 300)
        fillRow(slots, row)
    }
    let checksum = 0
    for i in 0..grid.length { checksum += grid[i] }
    print(checksum)
    let fibs: List<Integer> = []
    for i in 0..8 { fibs.add(0) }
    parallel for i in 0..fibs.length {
        let x, y = join(fib(18 + i), fibSerial(5))
        fibs[i] = x + y
    }
    print(fibs[7])
}
