// join over ordinary functions: each branch may build records, Text, Lists and
// Maps and returns a sendable value; arguments are copied into the branch.
record Sale { id: Integer; region: Text; amount: Integer; tags: List<Text> }
choice Shade { Light; Dark }

function build(first: Integer, after: Integer): List<Sale> {
    let out: List<Sale> = []
    for i in first..after {
        out.add(Sale { id: i; region: "r" + Text(i % 7); amount: (i * 37) % 101; tags: ["t" + Text(i % 3)] })
    }
    return out
}

// Divide and conquer that grows a List in every branch and concatenates in order.
function buildAll(first: Integer, after: Integer): List<Sale> {
    if after - first <= 500 { return build(first, after) }
    let middle = first + (after - first) / 2
    let left, right = join(buildAll(first, middle), buildAll(middle, after))
    left.addAll(right)
    return left
}

// A per-branch dictionary, folded into counts the caller merges.
function regionTotals(first: Integer, after: Integer): List<Integer> {
    let totals: Map<Text, Integer> = Map()
    for sale in build(first, after) {
        if totals.has(sale.region) { totals[sale.region] = totals[sale.region] + sale.amount } else { totals[sale.region] = sale.amount }
    }
    let out: List<Integer> = []
    for r in 0..7 { out.add(totals["r" + Text(r)]) }
    return out
}

function countWords(text: Text): Integer { return text.split(" ").length }
function shout(text: Text): Text { return text + text + "!" }
function grow(values: List<Integer>): Integer {
    values.add(99)
    return values.length
}
function measure(values: List<Integer>): Integer { return values.length }
function rename(sale: Sale): Sale {
    sale.region = "moved"
    return sale
}
function half(x: Float): Float { return x / 2.0 }
function even(n: Integer): Boolean { return n % 2 == 0 }
function letter(n: Integer): Character { return Character(Integer('a') + n) }
function shade(n: Integer): Shade {
    if n > 0 { return Shade.Dark }
    return Shade.Light
}
function header(n: Integer): Bytes {
    let out = Bytes(n)
    for i in 0..n { out[i] = i * 3 }
    return out
}
function greet(name: Text): Text { return "héllo " + name + " 🙂" }
parallel function square(n: Integer): Integer { return n * n }
function bump(hits: AtomicInteger, times: Integer): Integer {
    for i in 0..times { hits.fetchAddRelaxed(1) }
    return times
}
function sumFrozen(data: FrozenBytes, first: Integer, after: Integer): Integer {
    let total = 0
    for i in first..after { total += data.getUInt8(i) }
    return total
}
function frozenTotal(data: FrozenBytes, first: Integer, after: Integer): Integer {
    if after - first <= 64 { return sumFrozen(data, first, after) }
    let middle = first + (after - first) / 2
    let low, high = join(frozenTotal(data, first, middle), frozenTotal(data, middle, after))
    return low + high
}

let sales = buildAll(0, 20000)
let total = 0
for sale in sales { total += sale.amount }
print(Text(sales.length) + " " + Text(total) + " " + sales[19999].region + " " + sales[12345].tags[0])
let lowTotals, highTotals = join(regionTotals(0, 5000), regionTotals(5000, 10000))
let merged = 0
for r in 0..7 { merged += lowTotals[r] + highTotals[r] }
print(merged)
let words, loud = join(countWords("one two three"), shout("join"))
print(Text(words) + " " + loud)
// Each branch owns a copy of its arguments; the caller keeps its own values.
let values = [1, 2, 3]
let grown, seen = join(grow(values), measure(values))
print(Text(grown) + " " + Text(seen) + " " + Text(values.length))
let original = Sale { id: 1; region: "home"; amount: 5; tags: [] }
let moved, kept = join(rename(original), rename(original))
print(moved.region + " " + kept.region + " " + original.region)
let h, e = join(half(5.0), even(4))
print(Text(h) + " " + Text(e))
let l, s = join(letter(2), shade(1))
print(Text(l) + " " + Text(s == Shade.Dark))
let bytes, hello = join(header(4), greet("wörld"))
print(Text(bytes[3]) + " " + hello)
let sq, other = join(square(7), countWords("a b"))
print(Text(sq) + " " + Text(other))
let hits = atomicInteger(0)
let first, second = join(bump(hits, 1000), bump(hits, 2000))
print(Text(first + second) + " " + Text(hits.load()))
let raw = Bytes(1000)
for i in 0..1000 { raw[i] = i % 256 }
print(frozenTotal(freezeBytes(raw), 0, 1000))
