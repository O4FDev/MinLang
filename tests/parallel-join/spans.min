// In-place divide and conquer: each call of a join writes its own span of one
// buffer, and the join checks at the fork that the parts do not overlap.
parallel function insertion(keys: List<Integer>): Integer {
    for i in 1..keys.length {
        let value = keys[i]
        let j = i - 1
        while j >= 0 && keys[j] > value {
            keys[j + 1] = keys[j]
            j -= 1
        }
        keys[j + 1] = value
    }
    return 0
}

parallel function swap(keys: List<Integer>, a: Integer, b: Integer): Integer {
    let value = keys[a]
    keys[a] = keys[b]
    keys[b] = value
    return 0
}

// Lomuto partition around the median of the first, middle and last keys.
parallel function partition(keys: List<Integer>): Integer {
    let last = keys.length - 1
    let middle = last / 2
    if keys[middle] < keys[0] { swap(keys, middle, 0) }
    if keys[last] < keys[0] { swap(keys, last, 0) }
    if keys[middle] < keys[last] { swap(keys, middle, last) }
    let pivot = keys[last]
    let store = 0
    for i in 0..last {
        if keys[i] < pivot {
            swap(keys, i, store)
            store += 1
        }
    }
    swap(keys, store, last)
    return store
}

parallel function quicksort(keys: List<Integer>): Integer {
    if keys.length <= 24 { return insertion(keys) }
    let p = partition(keys)
    let low, high = join(quicksort(keys.span(0, p)), quicksort(keys.span(p + 1, keys.length)))
    return low + high + 1
}

parallel function fill(out: Bytes, value: Integer): Integer {
    for i in 0..out.length { out[i] = value }
    return out.length
}

parallel function total(values: List<Integer>): Integer {
    let sum = 0
    for i in 0..values.length { sum += values[i] }
    return sum
}

parallel function scale(out: List<Integer>, source: List<Integer>, factor: Integer): Integer {
    for i in 0..out.length { out[i] = source[i] * factor }
    return out.length
}

function sortedCheck(keys: List<Integer>): Boolean {
    for i in 1..keys.length { if keys[i - 1] > keys[i] { return false } }
    return true
}

let keys: List<Integer> = []
let state = 12345
for i in 0..50000 {
    state = (state * 1103515245 + 12345) % 2147483648
    keys.add(state % 100000)
}
let before = 0
for key in keys { before += key }
let splits = quicksort(keys)
let after = 0
for key in keys { after += key }
print(Text(sortedCheck(keys)) + " " + Text(before == after) + " " + Text(splits > 0))
let bytes = Bytes(10)
let a, b = join(fill(bytes.span(0, 4), 7), fill(bytes.span(4, 10), 9))
print(Text(a + b) + " " + Text(bytes[3]) + " " + Text(bytes[4]))
let source = [1, 2, 3, 4]
let out = [0, 0, 0, 0]
let c, d = join(scale(out.span(0, 2), source, 10), total(source))
print(Text(c) + " " + Text(d) + " " + Text(out[1]) + " " + Text(out[2]))
let empty = [5]
let e, f = join(total(empty.span(0, 0)), total(empty.span(0, 1)))
print(Text(e) + " " + Text(f))
