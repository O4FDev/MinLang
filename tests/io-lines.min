use "errors" as errors
use "io" as io
use "../tools/testing.min" as test

// SYS-8: io.readLine over a piped multi-line standard input. The Make target
// writes: alpha CRLF, beta LF, an empty line, a 1 MiB + 1 byte line, omega LF,
// an invalid UTF-8 line. Every reading is checked in order, then end of input.

function line(what: Text): Text {
    match io.readLine() {
        Ok(found) {
            match found {
                Some(text) { return text }
                None { fail(what + ": unexpected end of input") }
            }
        }
        Err(problem) { fail(what + ": " + errors.describe(problem)) }
    }
    return ""
}

function atEnd(what: Text): Boolean {
    match io.readLine() {
        Ok(found) {
            match found {
                Some(text) { return false }
                None { return true }
            }
        }
        Err(problem) { fail(what + ": " + errors.describe(problem)) }
    }
    return false
}

test.check(line("reading alpha") == "alpha", "CRLF input yields a line without the carriage return")
test.check(line("reading beta") == "beta", "LF input yields a line")
test.check(line("reading the empty line") == "", "an empty line is a line, not end of input")
test.check(line("reading omega") == "omega", "a terminated final short line is a line")

let overlong = errors.none()
match io.readLine() {
    Ok(found) { fail("the over-long line was accepted") }
    Err(problem) { overlong = problem }
}
test.check(errors.code(overlong) == errors.overflowCode(), "a line past MAXIMUM_LINE_BYTES is an overflow error")
test.check(errors.nativeCode(overlong) == -1000001, "the overflow keeps the reader's own marker")
test.check(errors.message(overlong) != "", "the overflow is described")
test.check(line("reading after the overflow") == "after", "reading continues at the line after the rejected one")

let invalid = errors.none()
match io.readLine() {
    Ok(found) { fail("invalid UTF-8 was accepted") }
    Err(problem) { invalid = problem }
}
test.check(errors.code(invalid) == errors.invalidDataCode(), "invalid UTF-8 is an invalid-data error")
test.check(atEnd("reading past invalid UTF-8"), "end of input is None")
test.check(atEnd("reading after the end"), "end of input stays end of input")
print("Standard input line reading passed")
