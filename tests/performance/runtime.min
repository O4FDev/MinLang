// Runtime benchmark: exercises the hot paths of compiled Minyar programs.
// The scale argument multiplies every workload so tests/performance.py can
// compare a small run against a large one and detect superlinear behaviour.

record Point {
    x: Integer
    y: Integer
}

function fibonacci(value: Integer): Integer {
    if value < 2 {
        return value
    }
    return fibonacci(value - 1) + fibonacci(value - 2)
}

function callWorkload(count: Integer): Integer {
    let total = 0
    let position = 0
    while position < count {
        total = total + fibonacci(15)
        position = position + 1
    }
    return total
}

function listWorkload(count: Integer): Integer {
    let values: List<Integer> = []
    let position = 0
    while position < count {
        values.add(position % 97)
        position = position + 1
    }
    let total = 0
    position = 0
    while position < values.length {
        total = total + values[position]
        position = position + 1
    }
    return total
}

function recordWorkload(count: Integer): Integer {
    let points: List<Point> = []
    let position = 0
    while position < count {
        points.add(Point { x: position, y: position * 2 })
        position = position + 1
    }
    let total = 0
    position = 0
    while position < points.length {
        total = total + points[position].y - points[position].x
        position = position + 1
    }
    return total
}

function textWorkload(count: Integer): Integer {
    let parts: List<Text> = []
    let position = 0
    while position < count {
        parts.add("ab")
        position = position + 1
    }
    let joined = joinText(parts)
    let total = 0
    position = 0
    while position < joined.length {
        if joined[position] == 'a' {
            total = total + 1
        }
        position = position + 1
    }
    let sliced = joined.slice(0, joined.length / 2)
    return total + sliced.length + joined.byteLength
}

function arithmeticWorkload(count: Integer): Integer {
    let total = 0
    let position = 0
    while position < count {
        total = (total + position * 3 - position / 2 + position % 5) % 1000003
        position = position + 1
    }
    return total
}

let scale = 1
if argumentCount() > 0 {
    let requested = argument(0)
    let digits = 0
    let parsed = 0
    while digits < requested.length {
        let character = requested[digits]
        let digit = 0
        if character == '1' { digit = 1 }
        if character == '2' { digit = 2 }
        if character == '3' { digit = 3 }
        if character == '4' { digit = 4 }
        if character == '5' { digit = 5 }
        if character == '6' { digit = 6 }
        if character == '7' { digit = 7 }
        if character == '8' { digit = 8 }
        if character == '9' { digit = 9 }
        parsed = parsed * 10 + digit
        digits = digits + 1
    }
    scale = parsed
}

print(listWorkload(200000 * scale))
print(recordWorkload(100000 * scale))
print(textWorkload(100000 * scale))
print(arithmeticWorkload(500000 * scale))
print(callWorkload(20 * scale))
