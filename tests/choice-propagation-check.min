use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
fixtures.executes(frontend, io.readTextFile("tests/choice-propagation.min"), io.readTextFile("tests/choice-propagation.expected"), ["-O0", "-O2"], 0, "", true)
frontend.sources.add("-pthread")
fixtures.executes(frontend, io.readTextFile("tests/choice-composition.min"), io.readTextFile("tests/choice-composition.expected"), ["-O0", "-O2"], 0, "", true)
fixtures.executes(frontend, io.readTextFile("tests/choice-composition-cycle.min"), io.readTextFile("tests/choice-composition-cycle.expected"), ["-O0", "-O2"], 0, "", true)
test.removeTree(frontend.compiler.directory)
print("Choice propagation: passed")
