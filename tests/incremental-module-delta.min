use "io" as io
use "../tools/testing.min" as test
use "./thread-port-support.min" as support
use "./cycle-port-support.min" as groups
use "system" as system
use "files" as files

record Context { directory: Text; driver: Text; compiler: Text; entry: Text; output: Text; cache: Text; stats: Text; serial: Integer }
function run(context: Context, command: List<Text>): test.Result {
    context.serial += 1
    let result = test.run(command, system.environment(), "", context.directory + "/.log-" + Text(context.serial), 60)
    test.check(result.status == 0, support.joined(command, " ") + "\n" + result.errorOutput)
    return result
}
function build(context: Context, reused: Integer, compiled: Integer): List<Integer> {
    run(context, [context.driver, context.compiler, context.entry, context.output, context.cache, context.stats])
    let fields = test.words(io.readTextFile(context.stats))
    let counters: List<Integer> = []
    for index in 0..6 { counters.add(groups.parseInteger(fields[index])) }
    run(context, [context.compiler, context.entry, context.directory + "/cold.ll", "--module-state", context.directory + "/empty", context.directory + "/state", context.directory + "/cold.stats"])
    test.check(io.readTextFile(context.output) == io.readTextFile(context.directory + "/cold.ll"), "overlay differs from cold compilation")
    if reused >= 0 { test.check(counters[0] == reused && counters[1] == compiled, "counters " + Text(counters[0]) + "," + Text(counters[1]) + " != " + Text(reused) + "," + Text(compiled)) }
    for name in files.list(context.cache) { test.check(!support.starts(name, "invocation."), "invocation files leaked") }
    return counters
}
function cacheBase(context: Context): Text {
    for name in files.list(context.cache) {
        let raw = Bytes(name)
        if raw.length > 6 && Text(raw.slice(raw.length - 6, raw.length)) == ".cache" { return context.cache + "/" + name }
    }
    fail("module cache base is missing")
}

let work = test.scratch()
let context = Context { directory: work; driver: test.setting("MINYAR_MODULE_DRIVER", "build/minyar-module-build"); compiler: test.setting("MINYAR_TEST_COMPILER", "build/minyarc-modules"); entry: work + "/main.min"; output: work + "/out.ll"; cache: work + "/cache"; stats: work + "/stats"; serial: 0 }
let imports: List<Text> = []
let terms: List<Text> = []
for index in 0..8 {
    imports.add("use \"./m" + Text(index) + ".min\" as m" + Text(index) + "\n")
    terms.add("m" + Text(index) + ".answer()")
    io.writeTextFile(work + "/m" + Text(index) + ".min", test.sourceModules("public function answer(): Integer { return " + Text(index) + " }\n"))
}
let source = joinText(imports) + "function main() { print(" + support.joined(terms, " + ") + ") }\n"
io.writeTextFile(context.entry, source)
io.writeTextFile(work + "/empty", "")
build(context, 0, 9)
let base = cacheBase(context)
let original = io.readTextFile(base)
let delta = base + ".delta"
io.writeTextFile(context.entry, test.replace(source, "print(", "let extra = \"λ\"\nprint("))
build(context, 8, 1)
test.check(io.readTextFile(base) == original, "one edit rewrote base")
test.check(files.pathSize(delta) >= 0 && files.pathSize(delta) < files.pathSize(base), "delta overlay is missing or not smaller")
let firstDelta = io.readTextFile(delta)
let reused = build(context, 9, 0)
test.check(reused[2] == 0 && reused[3] == 9 && reused[4] == 0 && reused[5] == 0, "fully reused counters changed")
io.writeTextFile(work + "/m0.min", test.sourceModules("public function answer(): Integer { return 20 }\n"))
build(context, 8, 1)
test.check(io.readTextFile(base) == original, "dependency edit rewrote base")
build(context, 9, 0)
io.writeTextFile(context.entry, source)
build(context, 8, 1)
build(context, 9, 0)
io.writeTextFile(delta, "broken overlay")
build(context, 8, 1)
build(context, 9, 0)
test.check(io.readTextFile(base) == original, "broken overlay rewrote base")
io.writeTextFile(work + "/new.min", test.sourceModules("public record New { value: Integer }\npublic function answer(): Integer { return 9 }\n"))
io.writeTextFile(context.entry, "use \"./new.min\" as new\n" + source)
build(context, 8, 2)
build(context, 10, 0)
io.writeTextFile(context.entry, source + "use \"./new.min\" as new\n")
build(context, 9, 1)
build(context, 10, 0)
io.writeTextFile(context.entry, source)
build(context, 8, 1)
build(context, 9, 0)
for index in 0..6 { io.writeTextFile(work + "/m" + Text(index) + ".min", test.sourceModules("public function answer(): Integer { return " + Text(30 + index) + " }\n")) }
build(context, 3, 6)
test.check(io.readTextFile(base) != original, "compaction kept the old base")
io.writeTextFile(delta, firstDelta)
build(context, 9, 0)
let newBase = io.readTextFile(base)
io.writeTextFile(context.entry, test.replace(source, "print(", "let second = 1\nprint("))
build(context, 8, 1)
let newDelta = io.readTextFile(delta)
io.writeTextFile(base, original)
build(context, -1, -1)
io.writeTextFile(base, newBase)
io.writeTextFile(delta, newDelta)
build(context, 9, 0)
run(context, ["clang", "-O0", "-Wno-override-module", context.output, "build/minyar-runtime.o", "-o", work + "/program", "-lm"])
test.check(run(context, [work + "/program"]).output == "208\n", "delta program output changed")
test.removeTree(work)
print("module deltas: cumulative/reverted edits, graph changes, corruption and mismatched generations match cold native builds")
