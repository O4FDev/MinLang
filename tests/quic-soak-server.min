// Remote scale fixture: keyed routing, indexed timers and bounded slot reuse.
use "quic" as quic
use "quicwire" as wire
use "quicdispatch" as dispatch
use "net" as net
use "eventloop" as loop
use "errors" as errors
use "tlstickets" as tickets
record Peer {
    connection: quic.Connection; address: Text; port: Integer; reported: Boolean
    live: Boolean; queued: Boolean; pending: Bytes; pendingId: Integer; final: Boolean
}
function number(text: Text): Integer { let value = 0; for digit in text { value = value * 10 + Integer(digit) - 48 }; return value }
function mark(peers: List<Peer>, work: List<Integer>, id: Integer) {
    if id >= 0 && id < peers.length && peers[id].live && !peers[id].queued { peers[id].queued = true; work.add(id) }
}
function idleFixture(connection: quic.Connection) {
    connection.idleTimeout=180000
    let parameters=wire.parameters(connection.serverTLS.transportParameters,true);let changed=Bytes()
    for parameter in parameters.parameters {
        let value=parameter.value
        if parameter.id==1 { value=errors.bytesValue(wire.encode(180000)) }
        changed.addBytes(errors.bytesValue(wire.encode(parameter.id)));changed.addBytes(errors.bytesValue(wire.encode(value.length)));changed.addBytes(value)
    }
    connection.serverTLS.transportParameters=changed
}
function main(): Integer {
    let duration = number(argument(3)); let maximum = number(argument(4))
    if duration < 1 || maximum < 1 || maximum > 32768 { return 1 }
    let socket = net.udp("127.0.0.1",0); if socket < 0 { return 1 }
    print("READY " + Text(net.localPort(socket)))
    let eventLoop = errors.integerValue(loop.create()); loop.watch(eventLoop,socket,loop.readableInterest(),0)
    let identity = readBytesFile(argument(0)); let key = readBytesFile(argument(1)); let root = readBytesFile(argument(2))
    let peers: List<Peer> = []; let free: List<Integer> = []; let freeCount = 0; let active = 0; let peak = 0
    let work: List<Integer> = []; let echoes = 0; let accepted = 0; let authenticated = 0; let failures = 0
    let routing = dispatch.table(maximum * 2,65536,randomBytes(16)); let timers = dispatch.timers(maximum)
    let issueTickets = argumentCount() > 5 && (argument(5) == "tickets" || argument(5) == "early")
    let store = tickets.store(randomBytes(16),3600); let resumed = 0
    if argumentCount() > 5 && argument(5) == "early" { tickets.allowEarlyData(store,0xffffffff) }
    let started = net.monotonicMilliseconds(); let now = 0; let retainedAt = 10000
    while now < duration {
        now = net.monotonicMilliseconds() - started
        if argumentCount()>5 && argument(5)=="idle" && now >= retainedAt {
            print("RETAINED " + Text(now) + " " + Text(active) + " " + Text(authenticated) + " " + Text(routing.count) + " " + Text(timers.count))
            retainedAt = now + 10000
        }
        let due = dispatch.takeDue(timers,now)
        while due >= 0 { mark(peers,work,due); due = dispatch.takeDue(timers,now) }
        for id in work {
            let peer = peers[id]; peer.queued = false; let connection = peer.connection
            if connection.state == quic.ESTABLISHED {
                if !peer.reported {
                    peer.reported = true; authenticated += 1
                    if connection.serverTLS.resumed { resumed += 1 }
                    if authenticated == 1 || authenticated % 1000 == 0 { print("AUTHENTICATED " + Text(authenticated)) }
                }
                if peer.pendingId >= 0 {
                    let written = quic.writeStream(connection,peer.pendingId,peer.pending,peer.final)
                    if errors.integerOk(written) { peer.pending = Bytes(); peer.pendingId = -1; echoes += 1 }
                    else if errors.code(errors.integerError(written)) != errors.wouldBlockCode() { return 2 }
                }
                if peer.pendingId < 0 {
                    for input in connection.streams {
                        if !input.sendClosed {
                            let data = quic.readStream(connection,input.id)
                            if errors.bytesOk(data) && errors.bytesValue(data).length > 0 {
                                peer.pending = errors.bytesValue(data); peer.pendingId = input.id; peer.final = input.final >= 0 && input.delivered == input.final
                            } else if input.final >= 0 && input.delivered == input.final { peer.pending = Bytes(); peer.pendingId = input.id; peer.final = true }
                            if peer.pendingId >= 0 {
                                let written = quic.writeStream(connection,peer.pendingId,peer.pending,peer.final)
                                if errors.integerOk(written) { peer.pending = Bytes(); peer.pendingId = -1; echoes += 1 }
                                else if errors.code(errors.integerError(written)) != errors.wouldBlockCode() { return 2 }
                                if peer.pendingId >= 0 { break }
                            }
                        }
                    }
                }
            }
            for packet in quic.poll(connection,now) { net.sendDatagramTo(socket,peer.address,peer.port,packet) }
            if connection.state == quic.FAILED { failures += 1; print("FAILED " + connection.error) }
            if (connection.state == quic.FAILED || connection.state == quic.CLOSED) && !connection.closing && !connection.draining {
                dispatch.remove(routing,connection.local); dispatch.remove(routing,connection.originalDestination); dispatch.cancel(timers,id)
                quic.release(connection); peer.pending = Bytes(); peer.pendingId = -1; peer.live = false; peer.address = ""; active -= 1
                if freeCount == free.length { free.add(id) } else { free[freeCount] = id }; freeCount += 1
            } else {
                let deadline = quic.nextTimer(connection)
                if deadline >= 0 { dispatch.schedule(timers,id,deadline) } else { dispatch.cancel(timers,id) }
            }
        }
        work = []
        let timeout = min(5000,max(0,duration - now)); let deadline = dispatch.nextDeadline(timers)
        if deadline >= 0 { timeout = min(timeout,max(0,deadline - now)) }
        let batch = loop.wait(eventLoop,timeout,64); if errors.isError(loop.batchError(batch)) { return 3 }
        now = net.monotonicMilliseconds() - started
        for event in loop.events(batch) {
            let packets = net.receiveDatagrams(socket,64,1500)
            if net.datagramBatchOk(packets) { for packet in net.datagrams(packets) {
                let received = net.datagramData(packet)
                if errors.bytesOk(received) {
                    let data = errors.bytesValue(received); let cid = wire.destinationId(data,8)
                    if errors.bytesOk(cid) {
                        let destination = errors.bytesValue(cid); let id = dispatch.lookup(routing,destination)
                        if id < 0 && active < maximum {
                            let header = wire.header(data,0,8)
                            if header.valid && header.kind == wire.INITIAL && data.length >= 1200 {
                                let connection = quic.server(randomBytes(80),"minyar-test",header.destination,[identity],key,[root],true)
                                if issueTickets { connection = quic.serverWithTickets(randomBytes(80),"minyar-test",header.destination,[identity],key,[root],true,store) }
                                if argumentCount()>5 && argument(5)=="idle" { idleFixture(connection) }
                                if dispatch.lookup(routing,connection.local) < 0 {
                                    id = peers.length; if freeCount > 0 { freeCount -= 1; id = free[freeCount] }
                                    if !errors.booleanOk(dispatch.insert(routing,connection.local,id)) || !errors.booleanOk(dispatch.insert(routing,header.destination,id)) { return 5 }
                                    let peer = Peer { connection: connection; address: net.datagramSource(packet); port: net.datagramPort(packet); reported: false; live: true; queued: false; pending: Bytes(); pendingId: -1; final: false }
                                    if id == peers.length { peers.add(peer) } else { peers[id] = peer }
                                    accepted += 1; active += 1; peak = max(peak,active)
                                }
                            }
                        }
                        if id >= 0 && peers[id].address == net.datagramSource(packet) && peers[id].port == net.datagramPort(packet) {
                            quic.receive(peers[id].connection,data,now); mark(peers,work,id)
                        }
                    }
                }
            } }
        }
    }
    loop.close(eventLoop); net.close(socket)
    print("RESULT " + Text(accepted) + " " + Text(echoes) + " " + Text(failures))
    print("AUTHENTICATED_TOTAL " + Text(authenticated) + " PEAK " + Text(peak) + " ROUTES " + Text(routing.entries.length) + " SLOTS " + Text(peers.length))
    print("LIVE " + Text(active) + " LIVE_ROUTES " + Text(routing.count) + " LIVE_TIMERS " + Text(timers.count))
    if issueTickets { print("RESUMED " + Text(resumed)) }
    if failures > 0 { return 4 }; return 0
}
