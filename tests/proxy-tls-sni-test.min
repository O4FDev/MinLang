use "./net-fixtures.min" as fixtures
use "../tools/testing.min" as test

fixtures.arguments(["--sanitize"], [])
let context = fixtures.context(fixtures.flag("--sanitize"))
for mode in ["debug", "release"] {
    let binary = context.work + "/sni-" + mode
    let command = [context.root + "/minyar", "--" + mode, "--library", context.root + "/library", context.root + "/tests/proxy-tls-sni.min", "-o", binary]
    test.require(fixtures.run(context, command, 120), "compile " + mode + " SNI parser regression")
    let result = fixtures.run(context, [binary], 30)
    test.check(result.status == 0 && result.output == "TLS SNI: bounded DNS names and all 256 octets pass TCP/QUIC fragmented-input controls\n" &&
        result.errorOutput == "", mode + " SNI parser regression (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
}
print("TLS SNI: debug/release parser regressions passed")
fixtures.finish(context)
