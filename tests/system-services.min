use "system" as system
function check(condition: Boolean, what: Text) { if !condition { fail("system services: " + what) } }
check(system.getenv("MINYAR_SYSTEM_TEST") == "snowman-☃", "Unicode environment value")
check(system.lastError() == 0, "getenv success")
check(system.getenv("MINYAR_SYSTEM_EMPTY") == "" && system.lastError() == 0, "present empty")
check(system.getenv("MINYAR_SYSTEM_MISSING") == "" && system.lastError() == -2, "missing value")
check(system.getenv("BAD=KEY") == "" && system.lastError() == -22, "invalid name")
let found = 0
for entry in system.environment() { if entry == "MINYAR_SYSTEM_TEST=snowman-☃" { found += 1 } }
check(found == 1, "environment snapshot")
check(system.getSoftLimit(9223372036854775807) == -22, "unknown resource")
check(system.setResourceLimit(system.OPEN_FILES, -1, 1) == -22, "negative limit")
check(system.writeStandardError("system services: stderr λ\n") == 27, "UTF-8 stderr byte count")
print("system services: passed")
