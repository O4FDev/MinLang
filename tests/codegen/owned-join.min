// CHECK-LABEL: define ptr @.minyar.fn.join(
// CHECK: [[LEFT:%[^ ]+]] = call ptr @minyar_join_text(
// CHECK: call ptr @minyar_join_text_take_left(ptr [[LEFT]],
// CHECK: ret ptr
function join(text: Text): Text { return (text + "!") + "?" }
print(join("hello"))

// CHECK-LABEL: define i64 @.minyar.fn.walk(
// CHECK: while.condition.
// CHECK: phi i1
// CHECK: ret i64
function walk(limit: Integer, flag: Boolean): Integer {
    let total = 0
    let index = 0
    while index < limit {
        if index < 2 {
            total = total + index
        } else {
            if flag && index < 4 { total = total + index * 2 } else { total = total - 1 }
        }
        index = index + 1
    }
    return total
}
print(walk(0, true))
print(walk(6, true))
print(walk(6, false))

// A Text field grows in place when the record holds the only reference:
// `log.text = log.text + piece` reads and borrows the field, then appends.
// CHECK-LABEL: define void @.minyar.fn.grow(
// CHECK: call void @minyar_rc_borrow(ptr [[OLD:%[^)]+]])
// CHECK: call void @minyar_record_append_text(ptr {{%[^,]+}}, i64 0, ptr [[OLD]], ptr
// CHECK-NOT: @minyar_record_replace
// CHECK: ret void
record Log {
    text: Text
}
function grow(log: Log, piece: Text) {
    log.text = log.text + piece
}
let log = Log { text: "" }
for index in 0..3 { grow(log, "ab") }
let kept = log.text
grow(log, "!")
print(kept)
print(log.text)

// Storing through a field needs no borrow of the field when the rest of the
// statement makes no call; a call could replace the field, so then it keeps one.
// CHECK-LABEL: define void @.minyar.fn.store(
// CHECK-NOT: @minyar_rc_borrow
// CHECK: call void @.minyar.list.set.scalar.checked
// CHECK: ret void
// CHECK-LABEL: define void @.minyar.fn.storeCall(
// CHECK: call void @minyar_rc_borrow
// CHECK: ret void
record Grid {
    cells: List<Integer>
}
function store(grid: Grid, position: Integer, value: Integer) {
    grid.cells[position * 2] = value + 1
}
function replaceCells(grid: Grid): Integer {
    grid.cells = [7, 7, 7, 7]
    return 5
}
function storeCall(grid: Grid) {
    grid.cells[0] = replaceCells(grid)
}
let grid = Grid { cells: [0, 0, 0, 0] }
store(grid, 1, 41)
print(grid.cells[2])
storeCall(grid)
print(grid.cells[0])

// A record literal may span lines; a call on a later line still needs the
// borrow, or replacing the field during the call frees the List stored into.
// CHECK-LABEL: define void @.minyar.fn.storeLiteral(
// CHECK: call void @minyar_rc_borrow
// CHECK: ret void
record Cell {
    first: Integer
    value: Integer
}
record Board {
    cells: List<Cell>
}
function replaceBoard(board: Board): Integer {
    board.cells = [Cell { first: 0; value: 9 }]
    return 5
}
function storeLiteral(board: Board) {
    board.cells[0] = Cell {
        first: 1
        value: replaceBoard(board)
    }
}
let board = Board { cells: [Cell { first: 0; value: 1 }] }
storeLiteral(board)
print(board.cells[0].value)

// `;` is a line end even inside brackets; a call after one still needs it.
// CHECK-LABEL: define void @.minyar.fn.storeSeparated(
// CHECK: call void @minyar_rc_borrow
// CHECK: ret void
record Grid2 {
    rows: List<List<Integer>>
}
function resetGrid(grid: Grid2): Integer {
    grid.rows = [[7], [7]]
    return 1
}
function storeSeparated(grid: Grid2) {
    grid.rows[0] = [; resetGrid(grid)]
}
let grid2 = Grid2 { rows: [[1], [2]] }
storeSeparated(grid2)
print(grid2.rows[0][0])

// x = x.appended(e) moves x's owner into the append: a List that only x
// holds grows in place, so building a List of a self-referential record,
// which cannot use add, stays linear.
// CHECK-LABEL: define ptr @.minyar.fn.collect(
// CHECK: call void @minyar_rc_local_move(
// CHECK: call ptr @minyar_list_appended_take(
// CHECK: ret ptr
record Tree {
    value: Integer
    children: List<Tree>
}
function collect(count: Integer): List<Tree> {
    let children: List<Tree> = []
    let index = 0
    while index < count {
        children = children.appended(Tree { value: index; children: [] })
        index = index + 1
    }
    return children
}
// An alias keeps the List it saw, a loop iterates the List it started with,
// and the argument reads the List before the append consumes it.
// CHECK-LABEL: define i64 @.minyar.fn.aliases(
// CHECK: call ptr @minyar_list_appended_take(
// CHECK: ret i64
function aliases(): Integer {
    let children = collect(3)
    let before = children
    for child in children {
        children = children.appended(child)
    }
    children = children.appended(children[0])
    return before.length * 100 + children.length
}
print(collect(4).length)
print(aliases())
