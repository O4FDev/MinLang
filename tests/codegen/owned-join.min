// CHECK-LABEL: define ptr @.minyar.fn.join(
// CHECK: [[LEFT:%[^ ]+]] = call ptr @minyar_join_text(
// CHECK: call ptr @minyar_join_text_take_left(ptr [[LEFT]],
// CHECK: ret ptr
function join(text: Text): Text { return (text + "!") + "?" }
print(join("hello"))

// CHECK-LABEL: define i64 @.minyar.fn.walk(
// CHECK: while.condition.
// CHECK: phi i1
// CHECK: ret i64
function walk(limit: Integer, flag: Boolean): Integer {
    let total = 0
    let index = 0
    while index < limit {
        if index < 2 {
            total = total + index
        } else {
            if flag && index < 4 { total = total + index * 2 } else { total = total - 1 }
        }
        index = index + 1
    }
    return total
}
print(walk(0, true))
print(walk(6, true))
print(walk(6, false))

// A Text field grows in place when the record holds the only reference:
// `log.text = log.text + piece` reads and borrows the field, then appends.
// CHECK-LABEL: define void @.minyar.fn.grow(
// CHECK: call void @minyar_rc_borrow(ptr [[OLD:%[^)]+]])
// CHECK: call void @minyar_record_append_text(ptr {{%[^,]+}}, i64 0, ptr [[OLD]], ptr
// CHECK-NOT: @minyar_record_replace
// CHECK: ret void
record Log {
    text: Text
}
function grow(log: Log, piece: Text) {
    log.text = log.text + piece
}
let log = Log { text: "" }
for index in 0..3 { grow(log, "ab") }
let kept = log.text
grow(log, "!")
print(kept)
print(log.text)
