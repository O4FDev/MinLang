use "./net-fixtures.min" as fixtures
use "./net-evidence.min" as evidence
use "../tools/testing.min" as test
use "system" as system

fixtures.arguments([], ["--mode", "--evidence"])
let requested = fixtures.option("--mode", "")
test.check(requested == "" || requested == "native" || requested == "sanitize", "invalid mode: " + requested)
let context = fixtures.context(false)
let platform = fixtures.strip(fixtures.execute(context, ["uname", "-s"], 10, "uname").output)
let windows = platform == "Windows" || fixtures.starts(platform, "MSYS") || fixtures.starts(platform, "MINGW") || fixtures.starts(platform, "CYGWIN")
if windows && requested == "sanitize" {
    system.writeStandardError("net-native-test: error: native network sanitizer mode is unavailable on Windows\n")
    fixtures.finish(context)
    exit(2)
}
let modes = ["native", "sanitize"]
if windows { modes = ["native"] }
if requested != "" { modes = [requested] }
let suffix = ""
if windows { suffix = ".exe" }
let clang = fixtures.value(context.environment, "MINYAR_TEST_CLANG")
if clang == "" { clang = "clang" }
let record = evidence.create(context.root, fixtures.option("--evidence", ""), context.work, ["tests/net-native-test.min", "tests/net-evidence.min", "tests/net-fixtures.min",
    "tests/net-native.c", "tests/net-batch.c", "tests/net-contract.min", "runtime/native/net.c", "runtime/minyar_runtime.c", "minyar"])
let leaks = "detect_leaks=0"
if platform == "Linux" { leaks = "detect_leaks=1" }
let failure = ""
if record.enabled { failure = evidence.run(record, [clang, "--version"], "clang-version", context.environment, "", 10, true, true).failure }
for mode in modes {
    let flags = ["-O2"]
    if mode == "sanitize" { flags = ["-O1", "-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"] }
    let environment = fixtures.withSetting(context.environment, "ASAN_OPTIONS", leaks)
    for fixture in ["net-native", "net-batch"] {
        if failure != "" { break }
        let executable = record.directory + "/" + fixture + "-" + mode + suffix
        let command = [clang, "-std=c11", "-D_GNU_SOURCE", "-DMINYAR_SYSTEM_HEAP=1", "-Wall", "-Wextra", "-Werror"]
        for flag in flags { command.add(flag) }
        for item in [context.root + "/tests/" + fixture + ".c", context.root + "/runtime/native/net.c", context.root + "/runtime/minyar_runtime.c", "-lm", "-o", executable] { command.add(item) }
        if windows { command.add("-lws2_32") }
        failure = evidence.run(record, command, fixture + "-" + mode + "-compile", context.environment, context.root, 600, false, true).failure
        if failure == "" { failure = evidence.run(record, [executable], fixture + "-" + mode + "-run", environment, "", 30, false, true).failure }
    }
}
if failure == "" {
    if requested != "sanitize" {
        let program = record.directory + "/net-contract" + suffix
        failure = evidence.run(record, [context.root + "/minyar", context.root + "/tests/net-contract.min", "-o", program], "net-contract-compile", context.environment, context.root, 600, true, true).failure
        if failure == "" {
            let result = evidence.run(record, [program], "net-contract-run", context.environment, "", 30, true, true)
            failure = result.failure
            let expected = "true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\n"
            if failure == "" && result.output != expected { failure = "AssertionError: " + result.output + result.errorOutput }
        }
        if failure == "" { print("Minyar network result contracts verified") }
    } else {
        print("Native network ASan/UBSan contracts verified")
    }
}
let status = "failed"
if failure == "" { status = "passed" }
evidence.finish(record, modes, status, failure)
fixtures.finish(context)
