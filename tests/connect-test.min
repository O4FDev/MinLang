// check-connect: the rpc handler API and the Connect server and client,
// without sockets. Each tests/connect/NAME.min runs at O0 and O2 and must print
// tests/connect/NAME.out exactly. simulation-retry proves its universe
// deterministic and shows a retried call whose response was lost runs its
// handler once.
use "io" as io
use "./net-fixtures.min" as fixtures

let family = "Connect"
let names = ["rpc", "server", "client", "stream", "receive", "simulation-retry"]
let selectors = fixtures.selectors(family, names)
let cases = fixtures.cases(false)
for name in names {
    if fixtures.selected(selectors, family, name) {
        let base = cases.root + "/tests/connect/" + name
        fixtures.executesCase(cases, io.readTextFile(base + ".min"), io.readTextFile(base + ".out"), [])
    }
}
fixtures.finishCases(cases)
