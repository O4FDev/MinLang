use "../tools/testing.min" as test
use "system" as system

function run(command: List<Text>, log: Text): test.Result {
    let argv = ["sh", "-c", "log=$1; shift; exec /usr/bin/env -- \"$@\" >\"$log\" 2>\"$log.err\"", "minyar", log]
    for item in command { argv.add(item) }
    return test.finish(system.spawn("/bin/sh", argv, system.environment(), ""), log)
}
let names = ["test_largest_integer_has_no_intermediate_overflow", "test_real_compiler_source_has_no_c_undefined_behavior"]
let selectors: List<Text> = []
for index in 0..argumentCount() {
    let selector = argument(index)
    if selector == "-v" || selector == "--verbose" || selector == "-q" || selector == "--quiet" { continue }
    let known = selector == "BootstrapPortability"
    for name in names { if selector == name || selector == "BootstrapPortability." + name { known = true } }
    test.check(known, "unknown bootstrap portability selector: " + selector)
    selectors.add(selector)
}
let directory = test.scratch()
test.require(run(["make", "-s", "build/compiler.min"], directory + "/assembly"), "assemble current bootstrap compiler source")
writeBytesFile(directory + "/compiler.min", readBytesFile("build/compiler.min"))
let clang = test.setting("MINYAR_TEST_BOOTSTRAP_CC", test.setting("CC", test.setting("MINYAR_TEST_CLANG", "clang")))
test.require(run([clang, "-std=c11", "-O2", "-g", "-fsanitize=undefined", "-fno-sanitize-recover=all", "-isystem", "vendor", "bootstrap/stage0.c", "-o", directory + "/stage0"], directory + "/build"), "build original UBSan stage0 probe")
for index in 0..names.length {
    let selected = selectors.length == 0
    for selector in selectors { if selector == "BootstrapPortability" || selector == names[index] || selector == "BootstrapPortability." + names[index] { selected = true } }
    if selected {
        let source = directory + "/compiler.min"
        if index == 0 {
            source = directory + "/boundary.min"
            writeTextFile(source, "function main() {\nprint(9223372036854775807)\nreturn 0\n}\n")
        }
        test.require(run([directory + "/stage0", source, "-o", directory + "/probe" + Text(index) + ".ll"], directory + "/run" + Text(index)), "bootstrap C semantics " + names[index])
    }
}
test.removeTree(directory)
print("Bootstrap C portability: passed")
