let text = "é" + "🙂"
print(text.length)
text = text + "xy"
print(text.length)
print(text[0])
print(text[1])
print(text[2])
print(text[3])
print(text.slice(0, 2))

let ascii = "x" + "y"
let unicode = "é" + "🙂"
print(ascii.length)
print(unicode.length)
ascii = ascii + unicode
print(ascii.length)
print(ascii[2])
print(ascii[3])
print(ascii.slice(2, 4))

