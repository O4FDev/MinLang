use "io" as io
use "process" as processInfo
use "tlsverify" as trust
function pack(certificate: Bytes): Bytes {
    let result=Bytes();result.add((certificate.length>>16)&255);result.add((certificate.length>>8)&255);result.add(certificate.length&255)
    result.addBytes(certificate);result.add(0);result.add(0);return result
}
function main(): Integer {
    let leaf=io.readBytesFile(processInfo.argument(0));let chain=pack(leaf);let anchors=pack(io.readBytesFile(processInfo.argument(1)))
    for index in 4..6 { if processInfo.argument(index)!="" { chain.addBytes(pack(io.readBytesFile(processInfo.argument(index)))) } }
    let failure=trust.chain("localhost",chain,anchors)
    if processInfo.argument(2)=="client" { failure=trust.clientChain(chain,anchors) }
    if (failure=="")!=(processInfo.argument(3)=="valid") { print("unexpected certificate signing usage acceptance: "+processInfo.argument(2)+" "+processInfo.argument(3)+" "+failure);return 1 }
    for prefix in 0..leaf.length { if trust.chain("localhost",pack(leaf.slice(0,prefix)),anchors)=="" { return 2 } }
    let trailing=leaf.slice(0,leaf.length);trailing.add(0)
    if trust.chain("localhost",pack(trailing),anchors)=="" { return 3 }
    return 0
}
