function main() {
    let names: List<Text> = ["", "same", "same", "é", "é", "界", "🙂", "same"]
    let kinds: List<Integer> = [1, 1, 2, 2, 3, 4, 1, 1]
    let position = 0
    while position < 700 {
        names.add("shared_prefix_" + Text(position))
        kinds.add(1 + position % 4)
        position = position + 1
    }
    let lookup = buildDeclarationIndex(names, kinds)
    if lookup[0] != names.length { fail("index declaration count") }
    let collisions = 0
    position = 0
    while position < names.length {
        let bucket = declarationHash(names[position], kinds[position]) % (lookup.length - 1)
        if lookup[1 + bucket] != position { collisions = collisions + 1 }
        let kind = 1
        while kind <= 4 {
            let actual = findIndexedSymbol(lookup, names, kinds, names[position], kind)
            let expected = findSymbol(names, kinds, names[position], kind)
            if actual != expected { fail("hash lookup disagrees with independent linear lookup") }
            kind = kind + 1
        }
        let absent = "missing_" + Text(position)
        if findIndexedSymbol(lookup, names, kinds, absent, 1) != -1 { fail("absent declaration") }
        position = position + 1
    }
    if collisions < 20 { fail("collision coverage disappeared") }
    if findIndexedSymbol(lookup, names, kinds, "sa" + "me", 1) != 1 { fail("first duplicate must win") }
    let emptyNames: List<Text> = []
    let emptyKinds: List<Integer> = []
    let empty = buildDeclarationIndex(emptyNames, emptyKinds)
    if findIndexedSymbol(empty, emptyNames, emptyKinds, "absent", 1) != -1 { fail("empty index") }
    print("declaration index verified")
}
