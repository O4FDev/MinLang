use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, "use \"errors\" as errors\nrecord Pair<First, Second> { first: First; second: Second }\nfunction keep<Item>(value: errors.ValueResult<Item>): errors.ValueResult<Item> { return value }\nlet result = keep(errors.success(Pair { first: \"pearl\"; second: [42] }))\nlet pair = errors.value(result)\nprint(pair.first)\nprint(pair.second[0])\nprint(Text(errors.value(errors.success(Bytes(\"sea\")))))\nlet bad = errors.failure([\"fallback\"], errors.make(errors.invalidDataCode(), 7, \"broken\"))\nprint(errors.ok(bad))\nprint(errors.message(errors.error(bad)))\n", "pearl\n42\nsea\nfalse\nbroken\n", levels, 0, "", true)
fixtures.executes(frontend, "use \"errors\" as errors\nlet first: errors.ValueResult<Integer> = errors.integer(0)\nlet second: errors.IntegerResult = errors.success(42)\nlet flag: errors.BooleanResult = errors.success(false)\nprint(errors.value(first))\nprint(errors.integerValue(second))\nprint(errors.booleanOk(flag))\nprint(errors.booleanValue(flag))\nprint(second.ok())\nprint(second.value())\nprint(flag.ok())\nprint(flag.value())\nlet overflow = errors.checkedAdd(9223372036854775807, 1)\nprint(errors.integerOk(overflow))\nprint(errors.code(errors.integerError(overflow)))\n", "0\n42\ntrue\nfalse\ntrue\n42\ntrue\nfalse\nfalse\n13\n", levels, 0, "", true)
fixtures.executes(frontend, io.readTextFile("examples/gallery/generic-results.min"), "dawn: 1.2 m\nthe tide gauge needs a gentle reset\ndusk: 1.4 m\n", levels, 0, "", true)
fixtures.executes(frontend, "use \"errors\" as errors\nerrors.value(errors.failure(\"\", errors.make(7, 9, \"bad\")))\n", "", levels, 1, "Minyar stopped: cannot read the value of a failed ValueResult\n", false)
fixtures.executes(frontend, "use \"errors\" as errors\nerrors.integerValue(errors.integerFailure(errors.make(7, 9, \"bad\")))\n", "", levels, 1, "Minyar stopped: cannot read the value of a failed IntegerResult\n", false)
fixtures.executes(frontend, "use \"errors\" as errors\nerrors.booleanValue(errors.booleanFailure(errors.make(7, 9, \"bad\")))\n", "", levels, 1, "Minyar stopped: cannot read the value of a failed BooleanResult\n", false)
fixtures.executes(frontend, "use \"errors\" as errors\nerrors.failure(0, errors.none())\n", "", levels, 1, "Minyar stopped: a failure result requires an error\n", false)
fixtures.rejects(frontend, "use \"errors\" as errors\nlet forged = errors.IntegerResult { value: 0; error: errors.none() }\n", "private", true)
fixtures.rejects(frontend, "use \"errors\" as errors\nlet forged = errors.ValueResult<Integer> { value: 0; error: errors.none() }\n", "private", true)
fixtures.rejects(frontend, "use \"errors\" as errors\nlet result = errors.integer(42)\nresult.error = errors.none()\n", "private", true)
test.removeTree(frontend.compiler.directory)
print("Generic library results: passed")
