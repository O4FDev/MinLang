if chosen("test_production_macos_uses_only_explicit_provisioned_keychain_paths") {
    let fixture = setup()
    let production = function(args: List<Text>): release.Completed {
        fixture.calls.add(args)
        let result = respond(fixture, args)
        if prefix(args, ["hdiutil", "create"]) { io.writeTextFile(args[args.length - 1], "contract DMG") }
        if prefix(args, ["xcrun", "notarytool", "submit"]) { result.output = "{\"status\": \"Accepted\"}" }
        return result
    }
    let settings = release.options()
    settings.keychain = fixture.keychain
    settings.notaryKeychain = fixture.keychain
    expect(release.macos(fixture.app, fixture.root + "/production.dmg", "Developer ID Application: Owner (TEAM)", "owner-notary", settings, release.Hooks { run: production; replace: release.systemReplace() }), [""], "", "production signing")
    let keychain = support.resolve(fixture.keychain).path
    for command in fixture.calls {
        if prefix(command, ["codesign", "--force"]) || prefix(command, ["xcrun", "notarytool", "submit"]) {
            test.check(argumentAt(command, "--keychain") == keychain, "explicit keychain path in " + helpers.join(command, " "))
        }
        test.check(command[0] != "security" && command[0] != "sudo", "production signing changed credentials")
    }
    finish(fixture)
    cases += 1
}
