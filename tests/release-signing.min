if chosen("test_production_manifest_default_retains_existing_subprocess_options") {
    let fixture = setup()
    let fake = fixture.root + "/mock-openssl"
    let log = fixture.root + "/openssl.log"
    io.writeTextFile(fake, "#!/bin/sh\nlog=\"$(dirname -- \"$0\")/openssl.log\"\nprintf '%s\\037' \"$0\" \"$@\" >> \"$log\"\nprintf '\\n' >> \"$log\"\nif [ \"$1\" = pkey ]; then printf '\\060\\052\\060\\005\\006\\003\\053\\145\\160\\003\\041\\000PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP'; fi\nfor argument in \"$@\"; do if [ \"$argument\" = -sign ]; then printf 'SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS'; fi; done\nexit 0\n")
    test.require(test.run(["chmod", "755", fake], system.environment(), "", fixture.root + "/fake.mode", 10), "fake openssl mode")
    let signature = manifest.signed(Bytes("production contract"), fixture.cert, fake, "OWNER_PASSPHRASE_ENV")
    test.check(signature.error == "", "production signer: " + signature.error)
    test.check(helpers.same(signature.signature, Bytes(helpers.repeat("S", 64))) && helpers.same(signature.publicKey, Bytes(helpers.repeat("P", 32))), "production signer output")
    let calls: List<List<Text>> = []
    let separator = Bytes()
    separator.add(31)
    for line in test.lines(io.readTextFile(log)) {
        let parts = helpers.split(line, Text(separator))
        let args: List<Text> = []
        for index in 0..(parts.length - 1) { args.add(parts[index]) }
        calls.add(args)
    }
    test.check(calls.length == 3, "production signer process count " + Text(calls.length))
    for command in calls { test.check(command[0] == fake, "production signer executable " + command[0]) }
    for index in 0..2 { test.check(argumentAt(calls[index], "-passin") == "env:OWNER_PASSPHRASE_ENV", "production signer passphrase source") }
    finish(fixture)
    cases += 1
}
if chosen("test_mac_ci_cleanup_attempts_all_steps_and_refuses_failures_or_drift") {
    let fixture = setup()
    for failure in ["trust removal", "keychain deletion", "search list drift", "trust drift", "partial setup"] {
        let credentials = fixture.root + "/" + helpers.join(helpers.split(failure, " "), "-")
        test.check(files.makeDirectory(credentials) == 0, "credentials directory")
        let target = pipeline.newReport()
        let calls: List<List<Text>> = []
        let state = Counter { calls: 0; failure: -1; closing: false }
        let hooks = pipeline.defaults()
        hooks.environment = ciEnvironment(fixture.root)
        hooks.platform = "darwin"
        hooks.run = function(request: pipeline.Command): support.Execution {
            let args = request.args
            calls.add(args)
            if prefix(args, ["openssl", "req"]) { io.writeTextFile(argumentAt(args, "-out"), "TEST cert") }
            if prefix(args, ["openssl", "x509"]) { io.writeTextFile(argumentAt(args, "-out"), "TEST DER") }
            if prefix(args, ["security", "create-keychain"]) { io.writeTextFile(args[args.length - 1], "") }
            if prefix(args, ["sudo", "-n", "security", "add-trusted-cert"]) && failure == "partial setup" { return support.Execution { status: 1; output: Bytes(); errorOutput: ""; timedOut: false; launch: 0 } }
            if prefix(args, ["sudo", "-n", "security", "remove-trusted-cert"]) {
                state.closing = true
                if failure == "trust removal" { return support.Execution { status: 1; output: Bytes(); errorOutput: ""; timedOut: false; launch: 0 } }
            }
            if prefix(args, ["security", "delete-keychain"]) {
                if failure == "keychain deletion" { return support.Execution { status: 1; output: Bytes(); errorOutput: ""; timedOut: false; launch: 0 } }
                test.check(files.remove(args[args.length - 1]) == 0, "delete keychain fixture")
            }
            let output = Bytes()
            if prefix(args, ["security", "list-keychains"]) {
                if state.closing && failure == "search list drift" { output = Bytes("drift") } else { output = Bytes("login") }
            }
            if prefix(args, ["security", "dump-trust-settings"]) && state.closing && failure == "trust drift" { output = Bytes("drift") }
            return success(output)
        }
        let outcome = pipeline.macosCredentials(hooks, credentials, "openssl", target, true, function(identities: pipeline.Identities): pipeline.Outcome { return pipeline.succeeded() })
        expectPipeline(outcome, ["ValueError", "CalledProcessError"], "", failure)
        let deleted = false
        for call in calls { if prefix(call, ["security", "delete-keychain"]) { deleted = true } }
        test.check(deleted, failure + ": keychain deletion was not attempted")
        let inventoried = false
        let start = calls.length - 3
        if start < 0 { start = 0 }
        for index in start..calls.length { if prefix(calls[index], ["security", "dump-trust-settings"]) { inventoried = true } }
        test.check(inventoried, failure + ": trust inventory was not rechecked last")
        let cleanup = json.parse(pipeline.valueOf(target, "macosCredentialCleanup"))
        let expected = "FAILED"
        if failure == "partial setup" { expected = "verified" }
        test.check(json.string(cleanup, "status") == expected, failure + ": cleanup status " + json.string(cleanup, "status"))
    }
    finish(fixture)
    cases += 1
}
if chosen("test_independent_decoder_refuses_escape_duplicates_and_truncation") {
    let fixture = setup()
    let variants: List<Bytes> = []
    for group in [["../main"], ["main", "MAIN"], ["main"], ["main"]] {
        let data = Bytes("MINYAR-BUNDLE-1\n")
        for byte in [0, 0, 0, 4] { data.add(byte) }
        data.addBytes(Bytes("main"))
        for byte in [0, 0, 0, group.length] { data.add(byte) }
        for name in group {
            let encoded = Bytes(name)
            data.add(70)
            data.add(1)
            for byte in [0, 0, 0, encoded.length, 0, 0, 0, 0, 0, 0, 0, 1] { data.add(byte) }
            data.addBytes(encoded)
            data.addBytes(Bytes("x"))
        }
        variants.add(data)
    }
    variants[2] = variants[2].slice(0, variants[2].length - 1)
    variants[3].addBytes(Bytes("tail"))
    for index in 0..variants.length {
        let decoded = pipeline.decode(variants[index], fixture.root + "/decoded-" + Text(index))
        expectPipeline(decoded.outcome, ["ValueError", "UnicodeDecodeError"], "", "hostile bundle " + Text(index))
    }
    finish(fixture)
    cases += 1
}
if chosen("test_cleanup_failure_prevents_atomic_pipeline_publication") {
    let fixture = setup()
    let failures = ["openssl", "credential cleanup", "staging cleanup", "publication", "report", ""]
    for index in 0..failures.length {
        let failure = failures[index]
        let output = fixture.root + "/TEST-output-" + Text(index)
        let reportPath = fixture.root + "/TEST-status-" + Text(index) + ".json"
        let stages = Stages { works: []; commits: 0 }
        let hooks = pipeline.defaults()
        hooks.authorize = false
        hooks.ciGuard = false
        hooks.machine = "arm64"
        hooks.run = function(request: pipeline.Command): support.Execution {
            if failure == "openssl" { return support.Execution { status: 1; output: Bytes(); errorOutput: ""; timedOut: false; launch: 0 } }
            return success(Bytes("OpenSSL 3.6.0"))
        }
        hooks.replacePipeline = true
        hooks.pipeline = function(arguments: pipeline.Arguments, work: Text, publication: Text, target: pipeline.Report): pipeline.Outcome {
            stages.works.add(work)
            io.writeTextFile(publication + "/TEST-evidence.txt", "public fixture")
            if failure == "credential cleanup" { return pipeline.failure("ValueError", "credential cleanup failed") }
            return pipeline.succeeded()
        }
        let cleaner = hooks.unstage
        hooks.unstage = function(path: Text): pipeline.Outcome {
            let cleaned = cleaner(path)
            if failure == "staging cleanup" { return pipeline.failure("OSError", "private staging cleanup failed") }
            return cleaned
        }
        let realPublish = hooks.publish
        hooks.publish = function(source: Text, destination: Text): pipeline.Outcome {
            stages.commits += 1
            test.check(stages.works.length > 0, "publication before staging")
            for work in stages.works { test.check(!support.exists(work), "publication before private staging cleanup") }
            let report = json.parse(io.readTextFile(source + "/TEST-report.json"))
            test.check(json.string(report, "stagingCleanup") == "verified: removed before publication", "published report staging status")
            if failure == "publication" { return pipeline.failure("OSError", "atomic commit failed") }
            return realPublish(source, destination)
        }
        let realWriter = hooks.writeReport
        hooks.writeReport = function(path: Text, text: Text): pipeline.Outcome {
            if failure == "report" { return pipeline.failure("OSError", "external report failed") }
            return realWriter(path, text)
        }
        let exit = pipeline.invoke(["--native", "macos", "--output", output, "--openssl", "openssl", "--cc", "clang", "--ephemeral-macos-ci", "--report", reportPath], hooks)
        let label = "cleanup failure '" + failure + "'"
        if failure == "" { test.check(exit.status == 0, label + ": exit " + Text(exit.status) + "\n" + exit.errorOutput) }
        else { test.check(exit.status == 1, label + ": exit " + Text(exit.status)) }
        let expectedCommits = 1
        if failure == "openssl" || failure == "credential cleanup" || failure == "staging cleanup" { expectedCommits = 0 }
        test.check(stages.commits == expectedCommits, label + ": publication attempts " + Text(stages.commits))
        test.check(support.exists(output) == (failure == "report" || failure == ""), label + ": output existence")
        test.check(staged(fixture.root, ".minyar-test-pipeline-") == 0, label + ": private staging remains")
        test.check(staged(fixture.root, ".minyar-test-generation-") == 0, label + ": unpublished generation remains")
        if failure == "report" {
            test.check(test.contains(exit.errorOutput, "generation published; external status reporting failed"), label + ": published failure summary")
            test.check(test.contains(exit.errorOutput, "\"generationPublished\": true"), label + ": published failure report")
        } else {
            let value = parsedReport(reportPath)
            let status = "FAILED"
            if failure == "" { status = "passed" }
            test.check(member(value, "status") == status, label + ": report status " + member(value, "status"))
            test.check(memberBoolean(value, "generationPublished") == (failure == ""), label + ": report publication flag")
            if failure == "openssl" { test.check(member(value, "stagingCleanup") == "not created", label + ": staging status") }
            if failure != "" { test.check(test.contains(exit.errorOutput, "no successful generation"), label + ": failure summary") }
        }
    }
    finish(fixture)
    cases += 1
}
