if chosen("test_ci_guard_refuses_missing_or_file_runner_temp_before_any_operations") {
    let fixture = setup()
    for root in [fixture.root + "/missing-runner-temp", fixture.cert] {
        let output = root + "/TEST-output"
        let reportPath = fixture.root + "/TEST-root-refusal.json"
        let counters: List<Counter> = []
        let hooks = guarded(counters)
        hooks.environment = ciEnvironment(root)
        hooks.platform = "darwin"
        let exit = pipeline.invoke(["--native", "macos", "--ephemeral-macos-ci", "--output", output, "--report", reportPath, "--cc", "mock-clang", "--openssl", "mock-openssl"], hooks)
        test.check(exit.status == 1, "invalid RUNNER_TEMP exit " + Text(exit.status))
        let entered = Counter { calls: 0; failure: -1; closing: false }
        let direct = pipeline.macosCredentials(hooks, root + "/credentials", "mock-openssl", pipeline.newReport(), true, function(identities: pipeline.Identities): pipeline.Outcome { entered.calls += 1; return pipeline.succeeded() })
        expectPipeline(direct, ["ValueError", "OSError", "FileNotFoundError"], "", "invalid runner root direct credentials")
        test.check(entered.calls == 0, "invalid runner root admitted direct credentials")
        untouched(counters, "invalid RUNNER_TEMP " + root)
        test.check(!support.exists(output), "invalid RUNNER_TEMP created output")
        test.check(!support.exists(reportPath), "invalid RUNNER_TEMP wrote a report")
    }
    test.check(!support.exists(fixture.root + "/missing-runner-temp"), "missing RUNNER_TEMP was created")
    test.check(io.readTextFile(fixture.cert) == "contract certificate", "certificate changed")
    finish(fixture)
    cases += 1
}
