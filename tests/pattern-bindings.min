use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.validate("PatternBindings", ["conditions", "loops", "let_records", "generics", "contextual", "ownership", "rejections", "product_rejections", "modules", "gallery"])

if fixtures.selected("PatternBindings", "conditions") {
    fixtures.executes(frontend, io.readTextFile("tests/pattern-bindings/conditions.min"), "42\n1\ndifferent case\n42\ndays\nrecord fallback\n42\n99\n99\n42\nclosed\nmissing\ndone\nliteral\n42\n7\ndirect\nordinary is\n", levels, 0, "", true)
}
if fixtures.selected("PatternBindings", "loops") {
    fixtures.executes(frontend, io.readTextFile("tests/pattern-bindings/loops.min"), "one\nthree\nfour\n4\n4\none\n2\n5\n5\nheld\none\n1\n2\n", levels, 0, "", true)
}
if fixtures.selected("PatternBindings", "let_records") {
    fixtures.executes(frontend, io.readTextFile("tests/pattern-bindings/let-records.min"), "42\nmoon\n7\ndays\n8\nhours\n3\nlayers\nuppercase\n1\nonce\n1\n42\nouter\n40\ncomplete\n", levels, 0, "", true)
}
if fixtures.selected("PatternBindings", "generics") {
    fixtures.executes(frontend, io.readTextFile("tests/pattern-bindings/generics.min"), "42\ngeneric\ndays\n7\n42\nchoice\n7\nnested\nfound\nfallback\nrecord\n", levels, 0, "", true)
}
if fixtures.selected("PatternBindings", "contextual") {
    fixtures.executes(frontend, io.readTextFile("tests/pattern-bindings/contextual.min"), "42\n42\n20\n22\n42\n42\n42\nordinary condition\n1\n7\n42\n1\n2\n42\n", levels, 0, "", true)
}
if fixtures.selected("PatternBindings", "ownership") {
    fixtures.executes(frontend, io.readTextFile("tests/pattern-bindings/ownership.min"), "conditional\nconditional\ncaptured\ndestructured\nrecord kept\nchoice kept\nlist kept\n2\n2\n1\nclean\n", levels, 0, "", true)
}

if fixtures.selected("PatternBindings", "rejections") {
    fixtures.rejects(frontend, "let Some(value) = Some(42)\n", "let pattern can miss", true)
    fixtures.rejects(frontend, "let Ok(value) = Ok<Integer, Text>(42)\n", "let pattern can miss", true)
    fixtures.rejects(frontend, #"""
        record Pair { first: Integer; second: Text }
        let Pair(42, word) = Pair { first: 42; second: "literal" }
        """#, "let pattern can miss", true)
    fixtures.rejects(frontend, #"""
        choice Wrapper { Wrapped(value: Maybe<Integer>) }
        let Wrapped(Some(value)) = Wrapped(Some(42))
        """#, "let pattern can miss", true)
    fixtures.rejects(frontend, #"""
        record Pair { first: Integer; second: Integer }
        let Pair(number, number) = Pair { first: 1; second: 2 }
        """#, "duplicate pattern binding", true)
    fixtures.rejects(frontend, #"""
        record Pair { first: Maybe<Integer>; second: Maybe<Integer> }
        if Pair { first: Some(1); second: Some(2) } is Pair(Some(number), Some(number)) {}
        """#, "duplicate pattern binding", true)
    fixtures.rejects(frontend, #"""
        record Pair { first: Integer; second: Text }
        let Pair("wrong", word) = Pair { first: 42; second: "text" }
        """#, "pattern has the wrong type", true)
    fixtures.rejects(frontend, "if Some(42) is Other(_) {}\n", "unknown case", true)
    fixtures.rejects(frontend, "if Some(42) is Some(number) {}\nprint(number)\n", "I can't find a value named 'number'", true)
    fixtures.rejects(frontend, "if None<Integer>() is Some(number) {} else { print(number) }\n", "I can't find a value named 'number'", true)
    fixtures.rejects(frontend, "while None<Integer>() is Some(number) {}\nprint(number)\n", "I can't find a value named 'number'", true)
    fixtures.rejects(frontend, "if Some(1) is Some(first) {} else if Some(2) is Some(second) { print(first) }\n", "I can't find a value named 'first'", true)
    fixtures.rejects(frontend, #"""
        record Pair { first: Integer; second: Text }
        let Pair(number, word) = Pair { first: number; second: "forward" }
        """#, "I can't find a value named 'number'", true)
    fixtures.rejects(frontend, "if Some(1) is Some(number) where true {}\n", "error:", true)
    fixtures.rejects(frontend, "if Some(1) is Some(number {}\n", "expected ')'", true)
    fixtures.rejects(frontend, "while Some(1) is Some(", "error:", true)
    fixtures.rejects(frontend, #"""
        record Pair { first: Integer; second: Text }
        let Pair(first, second, third) = Pair { first: 1; second: "extra" }
        """#, "expected ')'", true)
}

if fixtures.selected("PatternBindings", "product_rejections") {
    fixtures.rejects(frontend, #"""
        record Pair { first: Integer; second: Integer }
        let Pair(0, value) = Pair { first: 1; second: 2 }
        print(value)
        """#, "let pattern can miss", true)
    fixtures.rejects(frontend, #"""
        record Pair { first: Integer; second: Integer }
        record Other { first: Integer; second: Integer }
        let Pair(first, second) = Other { first: 1; second: 2 }
        """#, "unknown case", true)
    fixtures.rejects(frontend, #"""
        record Pair { first: Integer; second: Integer }
        record Other { first: Integer; second: Integer }
        let value = Other { first: 1; second: 2 }
        if value is Pair(first, second) {}
        """#, "unknown case", true)
    fixtures.rejects(frontend, #"""
        record Position native "c" { x: Int64; y: Int64 }
        let Position(x, y) = Position { x: 1; y: 2 }
        """#, "record patterns do not yet support native C layouts", true)
    fixtures.rejects(frontend, #"""
        record Position native "c" { x: Int64; y: Int64 }
        let value = Position { x: 1; y: 2 }
        if value is Position(x, y) {}
        """#, "record patterns do not yet support native C layouts", true)
    fixtures.rejects(frontend, #"""
        record Pair { value: Integer }
        function nothing() {}
        let Pair(value) = nothing()
        """#, "Nothing cannot be matched or stored in a binding", true)
    fixtures.rejects(frontend, "function nothing() {}\nif nothing() is _ {}\n", "Nothing cannot be matched or stored in a binding", true)
    fixtures.rejects(frontend, "function nothing() {}\nwhile nothing() is _ {}\n", "Nothing cannot be matched or stored in a binding", true)
}

if fixtures.selected("PatternBindings", "modules") {
    io.writeTextFile(frontend.compiler.directory + "/binding-values.min", io.readTextFile("tests/pattern-bindings/module.min"))
    fixtures.executes(frontend, #"""
        use "./binding-values.min" as values
        let Open(number, text) = values.open()
        print(number)
        print(text)
        if values.open() is Open(7, word) { print(word) }
        let Generic(contents) = values.wrap("exported")
        print(contents)
        if values.bag() is Wrapped(Open(number, word)) { print(number); print(word) }
        print(values.inside())
        """#, "7\nmodule\nmodule\nexported\n7\nmodule\nprivate\n", levels, 0, "", true)
    fixtures.rejects(frontend, "use \"./binding-values.min\" as values\nlet Account(label, secret) = values.account()\nprint(secret)\n", "is private", true)
    fixtures.rejects(frontend, "use \"./binding-values.min\" as values\nif values.account() is Account(label, secret) { print(secret) }\n", "is private", true)
}

if fixtures.selected("PatternBindings", "gallery") {
    fixtures.executes(frontend, io.readTextFile("examples/gallery/pattern-bindings.min"), "the first letter is for the harbour\nto the harbour,\nkeep one light for the boats\nand one for those still dreaming\nto the morning,\nbring the sea its silver\nand leave the windows open\nthe rest is a little silence\n", levels, 0, "", true)
}

test.removeTree(frontend.compiler.directory)
print("Pattern bindings: passed")
