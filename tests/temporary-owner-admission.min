use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "system" as system
use "files" as files
function starts(source: Text, prefix: Text): Boolean {
    let raw = Bytes(source)
    let pattern = Bytes(prefix)
    if raw.length < pattern.length { return false }
    for index in 0..pattern.length { if raw[index] != pattern[index] { return false } }
    return true
}
function parent(path: Text): Text {
    let raw = Bytes(path)
    let ending = -1
    for index in 0..raw.length { if raw[index] == 47 { ending = index } }
    if ending < 0 { return "." }
    if ending == 0 { return "/" }
    return Text(raw.slice(0, ending))
}
function count(source: Text, needle: Text): Integer {
    let raw = Bytes(source)
    let pattern = Bytes(needle)
    let found = 0
    if raw.length < pattern.length { return 0 }
    for start in 0..(raw.length - pattern.length + 1) {
        let equal = true
        for index in 0..pattern.length { if raw[start + index] != pattern[index] { equal = false; break } }
        if equal { found += 1 }
    }
    return found
}
let runtimeSource = "runtime/minyar_runtime.c"
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let index = 0
while index < processInfo.argumentCount() {
    let option = processInfo.argument(index)
    if option == "--runtime-source" || option == "--clang" {
        test.check(index + 1 < processInfo.argumentCount(), "missing temporary admission option value")
        if option == "--runtime-source" { runtimeSource = processInfo.argument(index + 1) }
        else { clang = processInfo.argument(index + 1) }
        index += 1
    } else if starts(option, "--runtime-source=") { runtimeSource = Text(Bytes(option).slice(17, Bytes(option).length)) }
    else if starts(option, "--clang=") { clang = Text(Bytes(option).slice(8, Bytes(option).length)) }
    else { fail("unknown temporary admission option " + option) }
    index += 1
}
let environment: List<Text> = []
for entry in system.environment() {
    if !starts(entry, "ASAN_OPTIONS=") && !starts(entry, "UBSAN_OPTIONS=") { environment.add(entry) }
}
environment.add("ASAN_OPTIONS=detect_leaks=0:halt_on_error=1")
environment.add("UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=0")
let work = test.scratch()
let runtime = work + "/runtime"
test.check(files.makeDirectory(runtime) == 0, "temporary admission runtime directory")
test.require(test.run(["cp", "-p", runtimeSource, runtime + "/minyar_runtime.c"], system.environment(), "", work + "/copy-runtime", 10), "copy selected admission runtime")
let headers = files.list(parent(runtimeSource))
test.check(files.lastError() == 0, "list selected admission runtime headers")
for name in headers {
    let raw = Bytes(name)
    if raw.length >= 2 && raw[raw.length - 2] == 46 && raw[raw.length - 1] == 104 {
        test.require(test.run(["cp", "-p", parent(runtimeSource) + "/" + name, runtime + "/" + name], system.environment(), "", work + "/copy-header", 10), "copy admission runtime header")
    }
}
let header = runtime + "/minyar_bounded_rc.h"
let source = io.readTextFile(header)
let signature = "size_t minyar_rc_poll(size_t budget) {"
test.check(count(source, signature) == 1, "poll definition changed")
io.writeTextFile(header, test.replace(source, signature, "size_t probe_poll_impl(size_t budget) {"))
let checks = 0
for budget in [1, 2, 7, 32, 1024] {
    for profile in ["fixed", "lazy"] {
        for mode in ["native", "sanitize"] {
            let command = [clang, "-std=c11", "-O2", "-DMINYAR_RC_POLL_BUDGET=" + Text(budget), "-DMINYAR_RUNTIME_SOURCE=\"" + runtime + "/minyar_runtime.c\""]
            if profile == "lazy" { command.add("-DMINYAR_LAZY_HEAP=1") }
            if mode == "sanitize" { for flag in ["-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-g"] { command.add(flag) } }
            let executable = work + "/admission"
            for item in ["tests/temporary-owner-admission.c", "-lm", "-o", executable] { command.add(item) }
            test.require(test.run(command, system.environment(), "", work + "/build", 90), "build admission " + Text(budget) + " " + profile + " " + mode)
            for chunk in ["first", "rollover", "existing"] {
                for owner in ["owned", "borrow"] {
                    test.require(test.run([executable, chunk, owner], environment, "", work + "/run", 60), "admission " + Text(budget) + " " + profile + " " + mode + " " + chunk + " " + owner)
                    checks += 1
                }
            }
        }
    }
}
for budget in [1, 32, 1024] {
    for profile in ["system", "fixed", "lazy"] {
        for mode in ["native", "sanitize"] {
            let command = [clang, "-std=c11", "-O2", "-DMINYAR_RC_POLL_BUDGET=" + Text(budget), "-DMINYAR_RUNTIME_SOURCE=\"" + runtime + "/minyar_runtime.c\""]
            if profile == "system" { command.add("-DMINYAR_SYSTEM_HEAP=1") }
            else { command.add("-DMINYAR_BOUNDED_HEAP=1"); command.add("-DMINYAR_BOUNDED_HEAP_BYTES=4096") }
            if profile == "lazy" { command.add("-DMINYAR_LAZY_HEAP=1") }
            if mode == "sanitize" { for flag in ["-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-g"] { command.add(flag) } }
            let executable = work + "/idle"
            for item in ["tests/temporary-owner-idle.c", "-lm", "-o", executable] { command.add(item) }
            test.require(test.run(command, system.environment(), "", work + "/build", 90), "build idle " + Text(budget) + " " + profile + " " + mode)
            test.require(test.run([executable], environment, "", work + "/run", 60), "idle " + Text(budget) + " " + profile + " " + mode)
            checks += 1
        }
    }
}
test.check(checks == 138, "temporary admission original case domain")
test.removeTree(work)
print("Temporary-owner admission passed: " + Text(checks) + " pressure, alias, idle and work-ceiling checks.")
