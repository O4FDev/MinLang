use "../tools/testing.min" as test
use "../tools/test-runtime.min" as runtime
use "./compiler-port-support.min" as port
use "system" as system
use "files" as files

record Context { compiler: test.Compiler; runTimeout: Integer }
function compile(context: Context, source: Text): test.Result {
    let compiler = context.compiler
    compiler.serial += 1
    let path = compiler.directory + "/case" + Text(compiler.serial)
    writeTextFile(path + ".min", source)
    let result = test.run([compiler.executable, path + ".min", path + ".ll", "--library", "library"], system.environment(), "", path + ".compile", compiler.compileTimeout)
    if result.status == 0 && test.addressEnabled(compiler.flags) { writeTextFile(path + ".ll", test.instrument(readTextFile(path + ".ll"))) }
    return result
}
function llvm(context: Context): Text {
    return readTextFile(context.compiler.directory + "/case" + Text(context.compiler.serial) + ".ll")
}
function executes(context: Context, source: Text, expected: Text, status: Integer, diagnostic: Text) {
    let compiler = context.compiler
    let result = compile(context, source)
    test.check(result.status == 0, result.errorOutput)
    let path = compiler.directory + "/case" + Text(compiler.serial)
    let engine = runtime.cycleSource(readTextFile("runtime/minyar_runtime.c"))
    writeTextFile(compiler.directory + "/runtime.c", test.replace(readTextFile("tests/memory-contracts-runtime.c"), "#include \"../runtime/minyar_runtime.c\"", engine))
    let optimization = "-O2"
    if compiler.flags.length > 0 { optimization = "-O1" }
    let command = [compiler.clang, optimization]
    for flag in compiler.flags { command.add(flag) }
    for item in ["-DMINYAR_SYSTEM_HEAP=1", "-iquote", "runtime", "-c", compiler.directory + "/runtime.c", "-o", compiler.directory + "/runtime.o"] { command.add(item) }
    let built = test.run(command, system.environment(), "", path + ".runtime", 30)
    test.check(built.status == 0, built.errorOutput)
    for level in ["-O0", "-O2"] {
        let executable = path + "." + Text(Bytes(level).slice(1, 3))
        let link = [compiler.clang, level]
        for flag in compiler.flags { link.add(flag) }
        for item in ["-Wno-override-module", path + ".ll", compiler.directory + "/runtime.o", "-o", executable, "-lm"] { link.add(item) }
        let linked = test.run(link, system.environment(), "", executable + ".link", 30)
        test.check(linked.status == 0, linked.errorOutput)
        let run = test.run([executable], system.environment(), "", executable + ".run", context.runTimeout)
        test.check(run.status == status, level + " status " + Text(run.status) + "\n" + run.errorOutput)
        test.check(run.output == expected, level + " output\n" + run.output)
        test.check(run.errorOutput == diagnostic, level + " diagnostics\n" + run.errorOutput)
    }
}
function recursivePrograms(context: Context) {
    let sources = ["record Callback { value: Integer }\nfunction value(record: Callback): Integer { return record.value }\nlet callback = Callback { value: 42 }\nprint(value(callback))\nprint(\"function(x: Integer) { Callback<Integer, Integer> }\")\n", "record Tree { value: Integer; children: List<Tree> }\nfunction leaf(n: Integer): Tree { return Tree { value: n; children: [] } }\nlet child = leaf(42)\nlet branches: List<Tree> = []\nlet complete = branches.appended(child)\nlet root = Tree { value: 1; children: complete }\nprint(root.children[0].value)\n", "record Box { value: Text }\nlet box = Box { value: \"before\" }\nbox.value = box.value + \" after\"\nlet values: List<Box> = []\nvalues.add(box)\nprint(values[0].value)\n", "use \"json\" as json\nlet value = json.parse(\"{\\\"x\\\":[1,2,{\\\"y\\\":true}]}\")\nprint(json.pretty(value, \"\"))\n"]
    let outputs = ["42\nfunction(x: Integer) { Callback<Integer, Integer> }\n", "42\n", "before after\n", "{\n  \"x\": [\n    1,\n    2,\n    {\n      \"y\": true\n    }\n  ]\n}\n"]
    for index in 0..sources.length {
        executes(context, sources[index], outputs[index], 0, "")
        let result = compile(context, sources[index])
        test.check(result.status == 0, result.errorOutput)
        let ir = llvm(context)
        test.check(!test.contains(ir, "minyar-cycle-runtime") && !test.contains(ir, "_traced("), "acyclic program selected the cycle runtime")
    }
}
function listEdge(context: Context) {
    executes(context, "record Node { value: Integer; children: List<Node> }\nlet n = Node { value: 7; children: [] }\nn.children.add(n)\nprint(n.children[0].children[0].value)\n", "7\n", 0, "")
}
function recordEdge(context: Context) {
    executes(context, "record Node { value: Integer; children: List<Node> }\nlet n = Node { value: 9; children: [] }\nn.children = [n]\nprint(n.children[0].value)\n", "9\n", 0, "")
}
function mutualAliases(context: Context) {
    executes(context, "record Parent { value: Integer; leaves: List<Leaf> }\nrecord Leaf { parent: Parent }\nlet p = Parent { value: 11; leaves: [] }\nlet leaf = Leaf { parent: p }\np.leaves.add(leaf)\nlet alias = p.leaves\np.leaves[0] = Leaf { parent: p }\nprint(alias[0].parent.value)\nlet other = Parent { value: 13; leaves: [] }\nalias[0].parent = other\nprint(p.leaves[0].parent.value)\n", "11\n13\n", 0, "")
}
function fieldAssignment(context: Context) {
    executes(context, "record A { next: B }\nrecord B { back: List<A>; value: Integer }\nlet b = B { back: []; value: 41 }\nlet a = A { next: b }\nb.back.add(a)\nlet alias = a\na.next = B { back: [a]; value: 42 }\nprint(alias.next.back[0].next.value)\n", "42\n", 0, "")
}
function closureCapture(context: Context) {
    executes(context, "record Box { value: Integer }\nlet offset = 40\nlet box = Box { value: 1 }\nlet callback = function(value: Integer): Integer {\n    return offset + box.value + value\n}\nbox.value = 2\nprint(callback(0))\n", "42\n", 0, "")
}
function indexContract(context: Context) {
    executes(context, "record Node { children: List<Node> }\nlet empty: List<Node> = []\nlet node = Node { children: empty }\nnode.children[0] = node\n", "", 1, "Minyar stopped: List position 0 is outside its length of 0.\n")
}
function moduleAliases(context: Context) {
    writeTextFile(context.compiler.directory + "/node.min", "public record Node { children: List<Node> }\npublic function empty(): Node { return Node { children: [] } }\n")
    test.check(files.makeDirectory(context.compiler.directory + "/nested") == 0, "cannot create nested module directory")
    for write in ["children.add(node)", "children[0] = node"] { executes(context, "use \"./node.min\" as a\nuse \"./nested/../node.min\" as b\nlet children: List<a.Node> = [a.empty()]\nlet node = b.Node { children: children }\n" + write + "\n", "", 0, "") }
}
function nestedHelpers(context: Context) {
    for source in ["record Node { layers: List<List<Node>> }\nfunction attach(target: List<Node>, node: Node) { target.add(node) }\nlet inner: List<Node> = []\nlet layers: List<List<Node>> = [inner]\nlet node = Node { layers: layers }\nattach(inner, node)\n", "record Node { children: List<Node> }\nfunction identity(values: List<Node>): List<Node> { return values }\nlet values: List<Node> = []\nlet node = Node { children: values }\nidentity(values).add(node)\n"] { executes(context, source, "", 0, "") }
}
function projectionCycles(context: Context) {
    for expression in ["alias.add(node)", "children(node).add(node)", "node.children.add(node)"] { executes(context, "record Node { children: List<Node> }\nfunction children(node: Node): List<Node> { return node.children }\nlet items: List<Node> = []\nlet node = Node { children: items }\nlet alias = items\n" + expression + "\n", "", 0, "") }
}
function untracedAllocations(context: Context) {
    let source = "record Cyclic { edges: List<Cyclic> }\nrecord Tree { children: List<Tree> }\nfunction acyclic(): Tree { return Tree { children: [] } }\nlet cycle = Cyclic { edges: [] }\ncycle.edges.add(cycle)\nprint(acyclic().children.length)\n"
    executes(context, source, "0\n", 0, "")
    let result = compile(context, source)
    test.check(result.status == 0, result.errorOutput)
    let ir = llvm(context)
    let begin = port.find(ir, "define ptr @.minyar.fn.acyclic(", 0)
    test.check(begin >= 0, "acyclic constructor is missing")
    let rest = Text(Bytes(ir).slice(begin + 31, Bytes(ir).length))
    let end = port.find(rest, "\n}\n", 0)
    let definition = rest
    if end >= 0 { definition = Text(Bytes(rest).slice(0, end)) }
    test.check(test.contains(definition, "@minyar_record_new(") && test.contains(definition, "@minyar_list_new()"), "acyclic allocations changed\n" + definition)
    test.check(!test.contains(definition, "_traced"), "acyclic allocation became traced\n" + definition)
}
function graphChurn(context: Context) {
    context.runTimeout = 120
    let fixtures = ["graphs", "churn", "dense", "field", "live-churn", "appended", "sol-graphs"]
    let sol = ["15\n", "22\n", "33\n"]
    for value in 0..20 { sol.add(Text(value * 1000) + "\n") }
    let outputs = ["0\n1\n2\n1\n0\n", "100000\n", "5000\n", "", "1\n100000\n", "16800\n800\n", joinText(sol)]
    for index in 0..fixtures.length { executes(context, readTextFile("tests/managed-graphs/" + fixtures[index] + ".min"), outputs[index], 0, "") }
    context.runTimeout = 30
}

let names = ["test_existing_recursive_programs_preserve_behavior", "test_list_edge_can_close_a_self_cycle", "test_enabling_cycles_preserves_index_contract_failure",
    "test_record_edge_can_close_a_self_cycle", "test_mutually_recursive_aliases_and_replacement", "test_preserved_module_aliases_execute_cycle_writes",
    "test_preserved_nested_list_helper_and_return_alias_cycles", "test_preserved_alias_return_and_record_projection_cycles",
    "test_preserved_record_field_assignment_closes_shared_mutual_cycle", "test_unrelated_recursive_types_keep_untraced_allocations",
    "test_adapted_graph_churn_temporaries_and_shared_append", "test_closure_callback_retains_lexical_capture"]
let selectors = port.selectors("ManagedGraphs", names)
let context = Context { compiler: port.compiler(); runTimeout: 30 }
let ran = 0
for index in 0..names.length {
    if !port.selected(selectors, "ManagedGraphs", names[index]) { continue }
    if index == 0 { recursivePrograms(context) }
    else if index == 1 { listEdge(context) }
    else if index == 2 { indexContract(context) }
    else if index == 3 { recordEdge(context) }
    else if index == 4 { mutualAliases(context) }
    else if index == 5 { moduleAliases(context) }
    else if index == 6 { nestedHelpers(context) }
    else if index == 7 { projectionCycles(context) }
    else if index == 8 { fieldAssignment(context) }
    else if index == 9 { untracedAllocations(context) }
    else if index == 10 { graphChurn(context) }
    else { closureCapture(context) }
    ran += 1
}
test.removeTree(context.compiler.directory)
print("ManagedGraphs: " + Text(ran) + " checks passed")
