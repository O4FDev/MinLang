use "./net-fixtures.min" as fixtures
use "../benchmarks/httpserver/front-oracle.min" as oracle
use "../tools/testing.min" as test

fixtures.arguments([], [])
let context = fixtures.context(false)
let directory = context.work
for pair in [["cache", "tests/httpserver-cache.min"], ["front", "benchmarks/httpserver/front.min"]] {
    let program = directory + "/" + pair[0]
    fixtures.execute(context, [context.root + "/minyar", "--release", context.root + "/" + pair[1], "-o", program], 90, "compile " + pair[1])
    if pair[0] == "cache" {
        let result = fixtures.execute(context, [program], 5, "cache fixture")
        test.check(result.output == "cache fixture exact LRU verified\n" && result.errorOutput == "", "cache fixture output\n" + result.output + result.errorOutput)
    }
}
let queries = ["a b", "second", "third", "fourth"]
let bodies: List<Bytes> = []
let delays: List<Integer> = []
for query in queries {
    bodies.add(Bytes("{\"query\": \"" + query + "\", \"total_us\": 1000}"))
    delays.add(1000)
}
let upstream = oracle.replay(context, queries, bodies, delays)
oracle.verifyLru(context, directory + "/front", upstream.port, queries, bodies, directory)
oracle.verifyHol(context, directory + "/front", upstream, queries, bodies, directory)
oracle.closeReplay(upstream)
oracle.controls()
print("HTTP server cache-front exact bytes/LRU, raw key and causal HoL verified")
fixtures.finish(context)
