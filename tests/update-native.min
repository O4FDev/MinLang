use "io" as io
use "../tools/testing.min" as test
use "system" as system
use "./release-support.min" as support

let work = test.scratch()
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let leaks = "detect_leaks=0"
if support.kernel(work + "/kernel") == "Linux" { leaks = "detect_leaks=1" }
let environment = support.environment(["ASAN_OPTIONS=" + leaks])
for sanitize in [false, true] {
    let suffix = ""
    if sanitize { suffix = "-sanitize" }
    let binary = work + "/probe" + suffix
    let compiler = clang
    let flags = ["-O2"]
    if sanitize {
        compiler = test.setting("MINYAR_SANITIZER_CLANG", clang)
        flags = ["-O1", "-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
    }
    let command = [compiler, "-std=c11", "-D_GNU_SOURCE", "-DMINYAR_SYSTEM_HEAP=1", "-DMINYAR_UPDATE_TEST_HOOK=1", "-Wall", "-Wextra", "-Werror"]
    for flag in flags { command.add(flag) }
    for path in ["tests/update-native.c", "runtime/native/update.c", "runtime/native/update_monocypher.c", "runtime/native/update_ed25519.c", "runtime/minyar_runtime.c", "-lm", "-o", binary] { command.add(path) }
    test.require(test.run(command, system.environment(), "", binary + ".build", 300), "build native update probe" + suffix)
    let installed = work + "/state" + suffix
    support.privateDirectory(installed, installed + ".mode")
    test.require(test.run([binary, installed], environment, "", installed + ".log", 30), "native update install" + suffix)
    for point in ["artifact-before-replace", "artifact-after-replace", "state-before-replace", "state-after-replace"] {
        let target = work + "/" + point + suffix
        support.privateDirectory(target, target + ".mode")
        let crashed = test.run([binary, target, point], environment, "", target + ".crash", 30)
        test.check(crashed.status == 87, point + " abrupt exit status " + Text(crashed.status) + "\n" + crashed.errorOutput)
        let expected = "old"
        if point == "state-after-replace" { expected = "new" }
        let recovered = test.run([binary, target, "reopen"], environment, "", target + ".reopen", 30)
        test.require(recovered, point + " reopen")
        test.check(recovered.output == expected, point + " recovered " + recovered.output)
        let artifact = target + "/versions/" + joinText(["aaaaaaaaaaaaaaaa", "aaaaaaaaaaaaaaaa", "aaaaaaaaaaaaaaaa", "aaaaaaaaaaaaaaaa"]) + ".bin"
        test.check(io.readTextFile(artifact) == "old", point + " retained old artifact")
    }
}
test.removeTree(work)
print("All publication transitions survive abrupt exit; OS releases updater locks")
