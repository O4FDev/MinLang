use "./net-fixtures.min" as fixtures
use "../tools/testing.min" as test

fixtures.arguments(["--sanitize"], [])
let context = fixtures.context(fixtures.flag("--sanitize"))
let binary = context.work + "/expiry.exe"
fixtures.compileProgram(context, "tests/tls-resumption-expiry.min", binary)
// Each mode waits out its own certificate expiry, so start both before collecting either.
let modes = ["server", "client"]
let handles: List<Integer> = []
let logs: List<Text> = []
for mode in modes {
    let ca = fixtures.authority(context, context.work + "/" + mode)
    fixtures.root(ca, "root")
    let expires = fixtures.nowSeconds() + 5
    for name in ["server", "client"] {
        let options = fixtures.ec(name + "Auth")
        if name == mode { options.start = expires - 3600; options.end = expires }
        fixtures.leaf(ca, name, "root", options)
    }
    let log = fixtures.logPath(context, "run")
    handles.add(test.start([binary, fixtures.path(ca, "root", "der"), fixtures.path(ca, "server", "der"), fixtures.path(ca, "server", "pk8"),
        fixtures.path(ca, "client", "der"), fixtures.path(ca, "client", "pk8"), mode, Text(expires * 1000)], context.environment, "", log, 12))
    logs.add(log)
}
for index in 0..modes.length {
    let result = test.finish(handles[index], logs[index])
    test.check(result.status == 0, modes[index] + " resumption expiry failed (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
    fixtures.emit(result.output)
}
fixtures.finish(context)
