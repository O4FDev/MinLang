use "./net-fixtures.min" as fixtures
use "../tools/testing.min" as test

fixtures.arguments(["--sanitize"], [])
let context = fixtures.context(fixtures.flag("--sanitize"))
let binary = context.work + "/expiry.exe"
fixtures.compileProgram(context, "tests/tls-resumption-expiry.min", binary)
for mode in ["server", "client"] {
    let ca = fixtures.authority(context, context.work + "/" + mode)
    fixtures.root(ca, "root")
    let expires = fixtures.nowSeconds() + 5
    for name in ["server", "client"] {
        let options = fixtures.ec(name + "Auth")
        if name == mode { options.start = expires - 3600; options.end = expires }
        fixtures.leaf(ca, name, "root", options)
    }
    let result = fixtures.run(context, [binary, fixtures.path(ca, "root", "der"), fixtures.path(ca, "server", "der"), fixtures.path(ca, "server", "pk8"),
        fixtures.path(ca, "client", "der"), fixtures.path(ca, "client", "pk8"), mode, Text(expires * 1000)], 12)
    test.check(result.status == 0, mode + " resumption expiry failed (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
    fixtures.emit(result.output)
}
fixtures.finish(context)
