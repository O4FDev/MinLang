use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io
let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, io.readTextFile("tests/choice/contextual-keyword.min"), "42\n42\n42\n7\n20\n22\n42\n", levels, 0, "", false)
io.writeTextFile(frontend.compiler.directory + "/choice-names.min", "public record Schedule { choices: List<Integer>; choice: Integer }\npublic function choice(schedule: Schedule): Integer { let sum = schedule.choice; for choice in schedule.choices { sum += choice }; return sum }\n")
fixtures.executes(frontend, "use \"./choice-names.min\" as choice\nlet value = choice.Schedule { choices: [20, 22]; choice: 0 }\nprint(choice.choice(value))\n", "42\n", levels, 0, "", false)
fixtures.rejects(frontend, "function build() { choice Hidden { Case } }\nbuild()\n", "I can't find a value named 'choice'", true)
test.removeTree(frontend.compiler.directory)
print("Contextual choice identifiers: passed")
