use "io" as io
use "process" as processInfo
use "random" as secureRandom
use "quic" as quic
use "errors" as errors
use "crypto" as crypto
use "quicwire" as wire
use "quiccrypto" as protection

function drive(c: quic.Connection, s: quic.Connection, now: Integer) {
    for packet in quic.pollDatagrams(c, now) { quic.receivePath(s, packet.data, packet.pathId, now) }
    for packet in quic.pollDatagrams(s, now) { quic.receivePath(c, packet.data, packet.pathId, now) }
}
function handshakePing(c: quic.Connection, number: Integer): Bytes {
    let header = Bytes(); header.add(0xe3)
    for index in 0..4 { header.add((c.version >> ((3 - index) * 8)) & 255) }
    header.add(c.remote.length); header.addBytes(c.remote); header.add(c.local.length); header.addBytes(c.local)
    header.add(25)
    for index in 0..4 { header.add((number >> ((3 - index) * 8)) & 255) }
    return errors.bytesValue(protection.protect(c.spaces[1].write, header, header.length - 4, number, crypto.fromHex("0100000000")))
}
function handshakeRebinding(root: Bytes, identity: Bytes, key: Bytes, client: Bytes, clientKey: Bytes): Integer {
    let c = quic.client("localhost", secureRandom.bytes(80), "minyar-test", [root], [client], clientKey)
    let s = quic.server(secureRandom.bytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true)
    let rebound = false; let guarded = false; let dropped = 0; let now = 0
    while now < 12000 && (!c.confirmed || !s.confirmed) {
        if !guarded && c.spaces[1].write.key.length > 0 && c.spaces[1].next == 0 {
            guarded = true
            let ping = handshakePing(c, 0); c.spaces[1].next = 1
            let invalid = ping.slice(0, ping.length); invalid[invalid.length - 1] = invalid[invalid.length - 1] ^ 1
            quic.receivePath(s, invalid, 99, now)
            quic.receivePath(s, invalid, 0, now)
            if s.paths.length != 1 || s.activePath != 0 || s.state == quic.FAILED || s.serverTLS.authenticated { return 28 }
            quic.receivePath(s, ping, 0, now)
            if s.spaces[1].largest != 0 || s.serverTLS.authenticated { return 29 }
            quic.receivePath(s, ping, 98, now)
            if s.paths.length != 1 || s.activePath != 0 || s.serverTLS.authenticated { return 30 }
            let nextPing = handshakePing(c, 1); c.spaces[1].next = 2
            quic.receivePath(s, nextPing, 7, now)
            if s.paths.length != 2 || s.activePath != 7 || s.serverTLS.authenticated { return 31 }
        }
        for packet in quic.pollDatagrams(c, now) {
            let header = wire.header(packet.data, 0, 8)
            if header.valid && header.kind == wire.HANDSHAKE { rebound = true }
            let route = 0; if rebound { route = 7 }; quic.receivePath(s, packet.data, route, now)
        }
        for packet in quic.pollDatagrams(s, now) {
            if !rebound || packet.pathId == 7 { quic.receivePath(c, packet.data, 0, now) }
            else { dropped += 1 }
        }
        now += 10
    }
    if !guarded || !rebound || !c.confirmed || !s.confirmed || s.activePath != 7 {
        print("handshake NAT rebinding failed " + Text(c.confirmed) + " " + Text(s.confirmed) + " dropped " + Text(dropped)); return 20
    }
    if !c.clientTLS.authenticated || !s.serverTLS.authenticated { return 21 }
    print("handshake NAT rebinding: authenticated peers and replacement path survived")
    return 0
}
function lostDataMigration(root: Bytes, identity: Bytes, key: Bytes, client: Bytes, clientKey: Bytes): Integer {
    let c = quic.client("localhost", secureRandom.bytes(80), "minyar-test", [root], [client], clientKey)
    let s = quic.server(secureRandom.bytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true)
    let now = 0
    while now < 10000 && (!c.confirmed || !s.confirmed) { drive(c, s, now); now += 10 }
    if !c.confirmed || !s.confirmed { return 22 }
    let id = errors.integerValue(quic.openStream(s, false)); let expected = secureRandom.bytes(32768)
    if !errors.integerOk(quic.writeStream(s, id, expected, true)) { return 23 }
    let lost = quic.pollDatagrams(s, now).length
    if lost == 0 { return 24 }
    if !errors.booleanOk(quic.probePath(c, 7, now)) { return 25 }
    let received = Bytes(); let retired = 0
    for count in 0..2000 {
        for packet in quic.pollDatagrams(c, now) { quic.receivePath(s, packet.data, 7, now) }
        for packet in quic.pollDatagrams(s, now) {
            if packet.pathId == 7 { quic.receivePath(c, packet.data, 7, now) }
            else { retired += 1 }
        }
        let read = quic.readStream(c, id)
        if errors.bytesOk(read) { received.addBytes(errors.bytesValue(read)) }
        now += 10
        if received.length == expected.length { break }
    }
    if crypto.hex(received) != crypto.hex(expected) {
        print("lost data migration failed bytes " + Text(received.length) + " retired packets " + Text(retired)); return 26
    }
    if c.state != quic.ESTABLISHED || s.state != quic.ESTABLISHED { return 27 }
    print("lost data migration: old-route loss recovered on validated replacement path")
    return 0
}
function appendInteger(data: Bytes, value: Integer) { data.addBytes(errors.bytesValue(wire.encode(value))) }
function retirePacket(sender: quic.Connection, receiver: quic.Connection, destination: Bytes, sequence: Integer, now: Integer) {
    let payload = Bytes(); appendInteger(payload, 25); appendInteger(payload, sequence)
    let number = sender.spaces[2].next; sender.spaces[2].next += 1
    let header = Bytes(); header.add(0x43); header.addBytes(destination)
    for index in 0..4 { header.add((number >> ((3-index)*8)) & 255) }
    let packet = errors.bytesValue(protection.protect(sender.spaces[2].write, header, header.length-4, number, payload))
    quic.receive(receiver, packet, now)
}
function connectionIdLifecycle(root: Bytes, identity: Bytes, key: Bytes, client: Bytes, clientKey: Bytes): Integer {
    let c = quic.client("localhost", secureRandom.bytes(80), "minyar-test", [root], [client], clientKey)
    let s = quic.server(secureRandom.bytes(80), "minyar-test", c.originalDestination, [identity], key, [root], true)
    let now = 0
    for count in 0..200 { drive(c, s, now); now += 10 }
    if !c.confirmed || !s.confirmed { return 33 }
    if c.remoteIds.length != 2 || s.remoteIds.length != 2 { return 32 }
    if c.remoteIds[1].id.length != 8 || c.remoteIds[1].token.length != 16 ||
       crypto.hex(c.remoteIds[0].id) == crypto.hex(c.remoteIds[1].id) { return 34 }
    for round in 0..12 {
        let oldSequence = c.remoteIds[0].sequence
        let destination = c.remoteIds[1].id
        retirePacket(c, s, destination, oldSequence, now)
        if s.state != quic.ESTABLISHED { return 35 }
        // The replacement remains reliable if all initial replies are lost.
        if round == 0 { let lost = quic.pollDatagrams(s, now); if lost.length == 0 { return 36 }; now += 1000 }
        for count in 0..200 { drive(c, s, now); now += 10 }
        if c.state != quic.ESTABLISHED || s.state != quic.ESTABLISHED || c.remoteIds.length != 2 ||
           c.remoteIds[0].sequence != oldSequence+1 || c.remoteIds[1].sequence != oldSequence+2 { return 37 }
        // Repeated retirements of an already retired CID do not consume the pool.
        retirePacket(c, s, c.remoteIds[0].id, oldSequence, now)
        for count in 0..50 { drive(c, s, now); now += 10 }
        if s.state != quic.ESTABLISHED || c.remoteIds.length != 2 || c.remoteIds[1].sequence != oldSequence+2 { return 38 }
    }
    for malformed in 0..2 {
        let badClient = quic.client("localhost", secureRandom.bytes(80), "minyar-test", [root], [client], clientKey)
        let badServer = quic.server(secureRandom.bytes(80), "minyar-test", badClient.originalDestination, [identity], key, [root], true)
        let at = 0
        for count in 0..200 { drive(badClient, badServer, at); at += 10 }
        let sequence = badClient.remoteIds[0].sequence
        if malformed == 1 { sequence = badClient.remoteIds[1].sequence+1 }
        retirePacket(badClient, badServer, badClient.remoteIds[0].id, sequence, at)
        if badServer.state != quic.FAILED || badServer.code != 10 { return 39 }
    }
    print("QUIC connection IDs: supply, retirement, retransmission, duplicates and invalid retirements passed")
    return 0
}

function main(): Integer {
    let root = io.readBytesFile(processInfo.argument(0)); let server = io.readBytesFile(processInfo.argument(1)); let serverKey = io.readBytesFile(processInfo.argument(2))
    let client = io.readBytesFile(processInfo.argument(3)); let clientKey = io.readBytesFile(processInfo.argument(4))
    let cid = connectionIdLifecycle(root, server, serverKey, client, clientKey); if cid != 0 { return cid }
    let c = quic.client("localhost", secureRandom.bytes(80), "minyar-test", [root], [client], clientKey)
    let s = quic.server(secureRandom.bytes(80), "minyar-test", c.originalDestination, [server], serverKey, [root], true)
    if errors.booleanOk(quic.probePath(c, 7, 0)) { return 1 }
    let now = 0
    while now < 10000 && (!c.confirmed || !s.confirmed) { drive(c, s, now); now += 10 }
    let id = errors.integerValue(quic.openStream(c, false))
    quic.writeStream(c, id, Bytes("before"), false)
    for count in 0..20 { drive(c, s, now); now += 10 }
    if Text(errors.bytesValue(quic.readStream(s, id))) != "before" { return 2 }
    // An attacker controls UDP source endpoints but not TLS traffic keys.
    for path in 1..1000 { quic.receivePath(s, secureRandom.bytes(1200), path, now) }
    if s.paths.length != 1 || s.activePath != 0 { return 3 }
    if !errors.booleanOk(quic.probePath(c, 7, now)) { return 4 }
    let challenges = quic.pollDatagrams(c, now)
    if challenges.length == 0 || challenges[0].pathId != 7 || challenges[0].data.length < 1200 { return 5 }
    for packet in challenges { quic.receivePath(s, packet.data, 7, now) }
    let replies = quic.pollDatagrams(s, now)
    // Even a cryptographically valid response on another path cannot validate.
    for packet in replies { quic.receivePath(c, packet.data, 8, now) }
    if c.activePath != 0 { return 6 }
    for packet in replies { quic.receivePath(c, packet.data, 7, now) }
    if c.activePath != 7 { return 7 }
    quic.writeStream(c, id, Bytes("after"), false)
    for count in 0..200 { drive(c, s, now); now += 10 }
    if c.state != quic.ESTABLISHED || s.state != quic.ESTABLISHED || s.activePath != 7 || Text(errors.bytesValue(quic.readStream(s, id))) != "after" { return 8 }
    if c.paths.length > 2 || s.paths.length > 2 { return 9 }
    let loss = lostDataMigration(root, server, serverKey, client, clientKey); if loss != 0 { return loss }
    let rebinding = handshakeRebinding(root, server, serverKey, client, clientKey); if rebinding != 0 { return rebinding }
    print("QUIC migration: authenticated exact-path validation, forged endpoints, bounded candidates and surviving streams passed")
    return 0
}
