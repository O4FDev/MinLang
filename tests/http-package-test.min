use "./net-fixtures.min" as fixtures
use "./net-redis.min" as ports
use "../tools/testing.min" as test

fixtures.arguments([], [])
let context = fixtures.context(false)
if fixtures.strip(fixtures.execute(context, ["uname", "-s"], 10, "uname").output) != "Darwin" {
    print("http tests skipped: the http package currently requires macOS")
    fixtures.finish(context)
    exit(0)
}
let peer = fixtures.launch(context, [fixtures.helper(context, "tests/http-peer.c", "http-peer", ""), "package", "4"], 600)
let port = fixtures.ready(context, peer)
let closed = ports.reservePort()
let program = context.work + "/http"
fixtures.execute(context, [context.root + "/minyar", context.root + "/tests/http.min", "-o", program], 600, "compile http package probe")
let result = fixtures.run(context, [program, "http://127.0.0.1:" + Text(port), "http://127.0.0.1:" + Text(closed) + "/"], 60)
fixtures.stop(peer)
let expected = "200 OK héllo []\ntrue\n201 {\"method\": \"POST\", \"test\": \"é\", \"body\": \"ü\"}\n404 Not Found\n0 true 0 true 0 true\n200 héllo\n201 {\"method\": \"POST\", \"test\": \"é\", \"body\": \"ü\"}\n0 true\ntrue 0 true\ntrue 0 true\n200 application/x-ndjson café done true\ntrue cancelled\n0 true\n0 only http:// and https:// URLs are supported: localhost:8080/health\n1 2\n"
test.check(result.status == 0 && result.output == expected, "http package (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
print("http requests, validated framing, bounded buffering, Unicode bodies, streaming, cancellation, failures and no caching verified")
fixtures.finish(context)
