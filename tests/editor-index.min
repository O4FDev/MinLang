use "../tools/editor-index.min" as index
use "../tools/lsp-protocol.min" as protocol
use "../tools/editor-source.min" as source
use "../tools/lsp-workspace.min" as workspace
use "../tools/lsp-features.min" as features
use "../tools/lsp-inlay.min" as inlay
use "../tools/driver-support.min" as host
use "../tools/testing.min" as test
use "io" as io
use "json" as json

let code = "/// The home light.\npublic record Lamp { light: Integer; private secret: Text }\nfunction Lamp.glow(amount: Integer) { let hidden = 0xFE; self.light += amount }\nlet name: Text = \"moon\"\nfunction other() { let name: Integer = 42; print(name) }\nprint(name)\n"
let syntax = index.build(code)
test.check(syntax.error == "", "valid editor source was rejected")
let lamp = index.find(syntax, "Lamp", 0, "")
test.check(lamp >= 0 && syntax.symbols[lamp].documentation == "The home light." && syntax.symbols[lamp].exported, "record docs and visibility")
let field = index.find(syntax, "light", 0, "Lamp")
let privateField = index.find(syntax, "secret", 0, "Lamp")
test.check(field >= 0 && syntax.symbols[field].type == "Integer" && syntax.symbols[field].exported, "field type")
test.check(privateField >= 0 && !syntax.symbols[privateField].exported, "private fields stay private")
let method = index.find(syntax, "glow", 0, "Lamp")
test.check(method >= 0 && syntax.symbols[method].kind == 6, "method index")
let global = index.find(syntax, "name", code.byteLength - 3, "")
test.check(global >= 0 && syntax.symbols[global].type == "Text", "a closed scope leaked its local name")
let hidden = index.find(syntax, "hidden", code.byteLength - 3, "")
test.check(hidden < 0, "a method local leaked into module completion")
for symbol in syntax.symbols {
    if symbol.name == "hidden" {
        test.check(symbol.type == "Integer", "hexadecimal inference must stay Integer")
    }
}
test.check(index.build("let choice = 1\nlet type = 2\nrecord Context { choice: Integer; type: Integer }\n").symbols.length == 5, "contextual names became declarations")
let shadowed = index.build("let value = 1; print(value); let value = 2; print(value)")
test.check(index.find(shadowed, "value", 0, "") == - 1, "a runtime binding was visible before its declaration")
test.check(index.find(shadowed, "value", 20, "") == 0 && index.find(shadowed, "value", 50, "") == 1, "top-level shadowing lost declaration order")
let transformed = index.build("record A { light: Integer }\nlet value = A { light: 1 }.other()\n")
let transformedValue = index.find(transformed, "value", 60, "")
test.check(transformedValue >= 0 && transformed.symbols[transformedValue].type == "", "a postfix expression inherited its first token's receiver type")
test.check(index.build("print(\"unfinished\n").error != "", "unfinished string recovery")
test.check(index.build("print([1, 2)\n").error != "", "mismatched bracket recovery")
let nested = source.scan("print(\"outer \\(name + \"nested \\(Integer(2))\")\")\n")
test.check(nested.error == "" && nested.tokens.length == 5, "nested interpolation must remain one lossless literal")

let contractCode = "record Box { value: Integer }\nfunction accept(predicate: () -> Boolean): Boolean { return predicate() }\nfunction guarded(value: Integer): Integer requires(accept(function(): Boolean { return value >= 0 })) ensures(result >= 0) { return value }\nfunction after() {}\n"
let contractIndex = index.build(contractCode)
let guarded = index.find(contractIndex, "guarded", 0, "")
test.check(contractIndex.error == "" && guarded >= 0 && contractIndex.symbols[guarded].type == "Integer", "contract clauses entered the function return annotation")
test.check(contractIndex.symbols[guarded].end == contractCode.find("\nfunction after"), "callback predicate brace became the function body")
test.check(contractIndex.symbols[guarded].detail.find("requires(") >= 0 && contractIndex.symbols[guarded].detail.find("ensures(") >= 0, "contract header detail was truncated")
test.check(index.find(contractIndex, "value", contractCode.find("{ return value }"), "") >= 0, "callback predicate truncated the parameter scope")
test.check(index.find(contractIndex, "value", contractCode.find("function after"), "") < 0, "contract parameter escaped the function body")

let literalCode = "record Box { value: Integer }\nfunction boxed(value: Integer): Box requires(Box { value: 1 }.value > 0) { return Box { value: value } }\nfunction afterLiteral() {}\n"
let literalIndex = index.build(literalCode)
let boxed = index.find(literalIndex, "boxed", 0, "")
test.check(boxed >= 0 && literalIndex.symbols[boxed].type == "Box", "contracted record return type was lost")
test.check(literalIndex.symbols[boxed].end == literalCode.find("\nfunction afterLiteral"), "record predicate brace became the function body")
test.check(index.find(literalIndex, "value", literalCode.find("return Box"), "") >= 0, "record predicate truncated the parameter scope")

let clauseIndex = index.build("function pre(): Integer requires(true) { return 1 }\nfunction post(): Integer ensures(result > 0) { return 1 }\nfunction steady(): Integer invariant(true) { return 1 }\nrecord requires { value: Integer }\nfunction identity(value: requires): requires ensures(true) { return value }\nfunction requires(value: Integer): Integer { return value }\nfunction ensures(value: Integer): Integer { return value }\nfunction invariant(value: Integer): Integer { return value }\n")
for name in ["pre", "post", "steady", "requires", "ensures", "invariant"] {
    let found = index.find(clauseIndex, name, 0, "")
    test.check(found >= 0 && clauseIndex.symbols[found].type == "Integer", "contextual contract function return type for " + name)
}
let identity = index.find(clauseIndex, "identity", 0, "")
test.check(identity >= 0 && clauseIndex.symbols[identity].type == "requires", "an ordinary contract identifier became a clause")

let longCode = "function longHeader(value: Integer): Integer\n"
for clause in 0..14 {
    longCode += "requires(value >= 0)\n"
}
longCode += "ensures(result >= 0)\n{ return value }\nfunction afterLong() {}\n"
let longIndex = index.build(longCode)
let longHeader = index.find(longIndex, "longHeader", 0, "")
test.check(longHeader >= 0 && longIndex.symbols[longHeader].end == longCode.find("\nfunction afterLong"), "long contract header did not find its body")
test.check(index.find(longIndex, "value", longCode.find("{ return value }"), "") >= 0, "long contract header lost the parameter scope")
test.check(index.find(longIndex, "value", longCode.find("function afterLong"), "") < 0, "long contract header leaked its parameter")

let methodCode = "record Lamp { light: Integer }\nfunction Lamp.glow(amount: Integer) requires(amount <= self.light) invariant(self.light >= 0) { self.light += amount }\nfunction afterMethod() {}\n"
let methodIndex = index.build(methodCode)
let headerSelf = index.find(methodIndex, "self", methodCode.find("self.light)"), "@self")
test.check(headerSelf >= 0 && methodIndex.symbols[headerSelf].type == "Lamp", "method self is missing from contract predicates")
test.check(index.find(methodIndex, "self", methodCode.find("self.light +="), "@self") >= 0, "method self is missing from the body")
test.check(index.find(methodIndex, "self", methodCode.find("function afterMethod"), "@self") < 0, "method self escaped the contracted method")

for declaration in ["function later(): Integer { return 42 }", "public function later(): Integer { return 42 }"] {
    let recoveryCode = "function pending(value: Integer): Integer\n" + declaration + "\n"
    let recoveryIndex = index.build(recoveryCode)
    let pending = index.find(recoveryIndex, "pending", 0, "")
    let later = index.find(recoveryIndex, "later", 0, "")
    test.check(pending >= 0 && later >= 0 && recoveryIndex.symbols[pending].end < recoveryIndex.symbols[later].start, "unfinished header consumed a later declaration body")
    test.check(index.find(recoveryIndex, "value", recoveryCode.find("return 42"), "") < 0, "unfinished header leaked its parameter into a later function")
}

let text = "a🌙é\r\nb\rc\n"
test.check(protocol.offset(text, 0, 1) == 1 && protocol.offset(text, 0, 3) == 5 && protocol.offset(text, 0, 2) == - 1, "UTF-16 surrogate boundaries")
test.check(protocol.offset(text, 1, 0) == 9 && protocol.offset(text, 2, 0) == 11 && protocol.offset(text, 3, 0) == 13, "editor line endings")
for offset in [0, 1, 5, 7, 9, 10, 11, 12, 13] {
    test.check(protocol.at(text, json.parse(protocol.position(text, offset))) == offset, "position round trip at \(offset)")
}
test.check(protocol.scalarOffset(text, 1, 3) == 5 && protocol.scalarOffset(text, 2, 3) == 11, "compiler scalar coordinates")
let path = "/tmp/Minyar café #星?.min"
test.check(protocol.path(protocol.uri(path)) == path, "file URI round trip")
test.check(protocol.path("https://example.invalid/a.min") == "" && protocol.path("file:///tmp/%00.min") == "" && protocol.path("file:///tmp/%ff.min") == "", "invalid URI rejection")

let scratch = test.scratch()
let state = workspace.create(scratch, "", [])
let literalSource = "let moon = \"🌙\"; constant count = -2\nlet typed: Integer = 3\nlet compared = 1 == 1\nlet commented = 1 /*\n*/ == 1\nlet multiline = \"\"\"hello\nthere\"\"\" == \"hello\"\n"
let document = workspace.update(state, protocol.uri(scratch + "/literals.min"), literalSource, 1)
let hints = json.parse(inlay.hints(state, document, 0, literalSource.byteLength))
test.check(hints.kind == json.ARRAY && hints.items.length == 2, "inlay hints must not guess expression types")
test.check(json.string(hints.items[0], "label") == ": Text" && json.string(hints.items[1], "label") == ": Integer", "literal inlay types")

// A truncated scan must stop loading source files, not merely stop returning
// their IDs. The same limit applies to a single root with many direct imports.
let bounded = scratch + "/bounded"
host.makeDirectories(bounded)
let imports: List<Text> = []
for number in 0..520 {
    let name = "source-\(number).min"
    io.writeTextFile(bounded + "/" + name, "let value = 1\n")
    imports.add("use \"./" + name + "\" as source\(number)\n")
}
let boundedState = workspace.create(bounded, "", [])
let discovered = workspace.projectDocuments(boundedState)
test.check(discovered.length == 512 && boundedState.documents.length == 512 && boundedState.graphTruncated, "workspace file scan exceeded its source limit")
let issue = features.renameError(boundedState, discovered[0], 5, "renamed")
test.check(host.hasText(issue, "source scan limit"), "rename must reject a truncated workspace")
io.writeTextFile(bounded + "/root.min", joinText(imports))
let graphState = workspace.create(bounded, "", [])
let root = workspace.loadDocument(graphState, protocol.uri(bounded + "/root.min"))
let graph = workspace.snapshot(graphState, root)
test.check(graph.documents.length == 512 && graphState.documents.length == 512 && graphState.graphTruncated, "import graph exceeded its source limit")
host.cleanup()
test.removeScratch(scratch)
print("editor source index, scopes, recovery, UTF-16 and URI checks passed")
