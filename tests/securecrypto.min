use "securecrypto" as native
use "crypto" as crypto
function same(left: Bytes, right: Text): Boolean { return crypto.hex(left) == right }
function main(): Integer {
    let alice = crypto.fromHex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
    let bob = crypto.fromHex("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f")
    if !same(native.x25519(alice, bob), "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742") { return 1 }
    let low = Bytes(32)
    if native.x25519(alice, low).length != 0 { return 2 }; low[0] = 1
    if native.x25519(alice, low).length != 0 || native.x25519(Bytes(31), bob).length != 0 || native.x25519(alice, Bytes(33)).length != 0 { return 3 }
    let key = crypto.fromHex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    let nonce = crypto.fromHex("070000004041424344454647"); let additional = crypto.fromHex("50515253c0c1c2c3c4c5c6c7")
    let message = Bytes("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.")
    let sealed = native.seal(key, nonce, additional, message)
    if sealed.length != message.length + 16 || !same(sealed.slice(0,16), "d31a8d34648e60db7b86afbc53ef7ec2") || !same(sealed.slice(sealed.length - 16, sealed.length), "1ae10b594f09e26a7e902ecbd0600691") { return 4 }
    let opened = native.open(key, nonce, additional, sealed)
    if opened.length != message.length + 1 || opened[0] != 1 || crypto.hex(opened.slice(1, opened.length)) != crypto.hex(message) { return 5 }
    for index in 0..sealed.length {
        let bad = sealed.slice(0,sealed.length); bad[index] = bad[index] ^ 1
        if native.open(key,nonce,additional,bad).length != 0 { return 6 }
    }
    for length in 0..16 { if native.open(key,nonce,additional,Bytes(length)).length != 0 { return 7 } }
    for length in 0..32 { if native.seal(Bytes(length),nonce,additional,message).length != 0 || native.x25519(Bytes(length),bob).length != 0 { return 8 } }
    for length in 0..12 { if native.seal(key,Bytes(length),additional,message).length != 0 { return 9 } }
    let empty = native.seal(key,nonce,Bytes(),Bytes()); let emptyOpened = native.open(key,nonce,Bytes(),empty)
    if empty.length != 16 || emptyOpened.length != 1 || emptyOpened[0] != 1 { return 10 }
    if native.chacha20(key,-1,nonce,message).length != 0 || native.chacha20(key,0x100000000,nonce,message).length != 0 || native.chacha20(key,0xffffffff,nonce,Bytes(65)).length != 0 { return 11 }
    let poly = crypto.fromHex("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
    if !same(native.poly1305(poly,Bytes("Cryptographic Forum Research Group")),"a8061dc1305136c6c22b8baf0c0127a9") { return 12 }
    for length in 0..65 {
        let original = Bytes(length)
        if !native.equal(original,original) || native.equal(original,Bytes(length+1)) { return 13 }
        for index in 0..length { let other=Bytes(length); other[index]=1; if native.equal(original,other) { return 14 } }
    }
    print("Native crypto: RFC 7748/8439, low-order X25519 rejection, tag tampering, empty messages, invalid lengths and counter bounds passed")
    return 0
}
