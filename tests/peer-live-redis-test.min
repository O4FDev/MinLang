use "io" as io
use "./net-fixtures.min" as fixtures
use "./net-redis.min" as redis
use "../tools/testing.min" as test
use "json" as json

function repeated(character: Text, count: Integer): Text {
    let parts: List<Text> = []
    for index in 0..count { parts.add(character) }
    return joinText(parts)
}
function ttl(client: redis.Client, key: Text) {
    let remaining = redis.command(client, ["PTTL", key])
    test.check(remaining.kind == redis.INTEGER && remaining.integer >= 44000 && remaining.integer <= 45000, "unexpected PTTL " + Text(remaining.integer))
}

let family = "PeerLiveRedis"
let selectors = fixtures.selectors(family, ["test_actual_redis_fences_replaced_owners_and_preserves_exact_ttl"])
if fixtures.selected(selectors, family, "test_actual_redis_fences_replaced_owners_and_preserves_exact_ttl") {
    let cases = fixtures.cases(true)
    let context = fixtures.context(false)
    let directory = cases.compiler.directory
    let paths: List<Text> = []
    for name in ["bind-a", "bind-b", "refresh-a", "refresh-b", "drop-a", "drop-b"] { paths.add(directory + "/" + name + ".resp") }
    let source = "use \"peerlive\" as live\nuse \"errors\" as errors\nlet health = live.heartbeat(Bytes(\"{\\\"in_flight\\\":0,\\\"max_concurrent\\\":8,\\\"paused\\\":false,\\\"policy_hash\\\":\\\"HASH\\\",\\\"public_ip\\\":\\\"203.0.113.2\\\",\\\"asn\\\":64500,\\\"country\\\":\\\"GB\\\"}\"))\nlet first = \"FIRST\"; let second = \"SECOND\"\nlet a = errors.bytesValue(live.payload(health,\"exit-a\",\"edge-a\",first,1000,0,false,false,1.0))\nlet b = errors.bytesValue(live.payload(health,\"exit-a\",\"edge-b\",second,1001,0,false,false,1.0))\nio.writeBytesFile(processInfo.argument(0),errors.bytesValue(live.bindCommand(\"exit-a\",first,a)))\nio.writeBytesFile(processInfo.argument(1),errors.bytesValue(live.bindCommand(\"exit-a\",second,b)))\nio.writeBytesFile(processInfo.argument(2),errors.bytesValue(live.refreshCommand(\"exit-a\",first,a)))\nio.writeBytesFile(processInfo.argument(3),errors.bytesValue(live.refreshCommand(\"exit-a\",second,b)))\nio.writeBytesFile(processInfo.argument(4),errors.bytesValue(live.dropCommand(\"exit-a\",first)))\nio.writeBytesFile(processInfo.argument(5),errors.bytesValue(live.dropCommand(\"exit-a\",second)))\nprint(\"ready\")\n"
    source = test.replace(test.replace(test.replace(source, "HASH", repeated("a", 64)), "FIRST", repeated("b", 64)), "SECOND", repeated("c", 64))
    fixtures.executesCase(cases, source, "ready\n", paths)
    let commands: List<Bytes> = []
    for path in paths { commands.add(io.readBytesFile(path)) }
    let server = redis.start(context, directory)
    let client = redis.connect(server)
    let key = "peer:live:{exit-a}"
    test.check(redis.isText(redis.sendRaw(client, commands[0]), "OK"), "first bind")
    ttl(client, key)
    test.check(redis.isText(redis.sendRaw(client, commands[1]), "OK"), "replacement bind")
    let replacement = redis.command(client, ["GET", key])
    test.check(replacement.kind == redis.BULK && json.string(json.parse(Text(replacement.data)), "_epoch") == repeated("c", 64), "replacement epoch")
    test.check(redis.isInteger(redis.sendRaw(client, commands[2]), 0), "delayed old heartbeat")
    test.check(redis.isInteger(redis.sendRaw(client, commands[4]), 0), "delayed old disconnect")
    let unchanged = redis.command(client, ["GET", key])
    test.check(unchanged.kind == redis.BULK && fixtures.hex(unchanged.data) == fixtures.hex(replacement.data), "replacement changed")
    test.check(redis.isInteger(redis.sendRaw(client, commands[3]), 1), "current refresh")
    ttl(client, key)
    test.check(redis.isText(redis.command(client, ["SET", key, "{malformed"]), "OK"), "corrupt state")
    test.check(redis.isInteger(redis.sendRaw(client, commands[3]), 0), "refresh over malformed state")
    test.check(redis.isInteger(redis.sendRaw(client, commands[5]), 0), "drop over malformed state")
    test.check(redis.isText(redis.command(client, ["GET", key]), "{malformed"), "malformed state retained")
    test.check(redis.isText(redis.sendRaw(client, commands[1]), "OK"), "rebind over malformed state")
    test.check(redis.isInteger(redis.sendRaw(client, commands[5]), 1), "current drop")
    test.check(redis.command(client, ["GET", key]).kind == redis.NULL, "dropped key absent")
    test.check(redis.isInteger(redis.sendRaw(client, commands[2]), 0), "absent key never resurrects old owner")
    test.check(redis.isText(redis.sendRaw(client, commands[1]), "OK"), "final bind")
    test.check(redis.isInteger(redis.command(client, ["PEXPIRE", key, "1"]), 1), "expire")
    fixtures.pause("0.02")
    test.check(redis.command(client, ["GET", key]).kind == redis.NULL, "expired key absent")
    test.check(redis.isInteger(redis.sendRaw(client, commands[3]), 0), "refresh after expiry")
    redis.close(client)
    let stopped = redis.stop(server)
    test.check(stopped.status == 0, "Redis exit " + Text(stopped.status) + "\n" + stopped.errorOutput)
    fixtures.finish(context)
    fixtures.finishCases(cases)
}
