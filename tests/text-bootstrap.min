use "io" as io
use "../tools/testing.min" as test
use "system" as system
use "files" as files

let compiler = test.compiler()
let stage0 = test.setting("MINYAR_TEST_STAGE0", "./build/stage0")
let path = compiler.directory + "/bootstrap"
io.writeTextFile(path + ".min", io.readTextFile("tests/text/bootstrap.min"))
test.require(test.run([stage0, path + ".min", "-o", path + ".ll"], system.environment(), "", path + ".compile", 30), "compile bootstrap text literals")
let expected = io.readTextFile("tests/text/bootstrap.stdout")
for optimization in ["-O0", "-O2"] {
    let link = [compiler.clang, optimization, "-Wno-override-module", path + ".ll", "build/minyar-compiler-runtime.ll", "-lm", "-o", path + ".exe"]
    test.require(test.run(link, system.environment(), "", path + ".link", 120), "link bootstrap text literals")
    let result = test.run([path + ".exe"], system.environment(), "", path + ".run", 30)
    test.check(result.status == 0 && result.output == expected && result.errorOutput == "", "bootstrap text output " + optimization + "\n" + result.output + result.errorOutput)
}
let bad = ["function main(): Integer { print(\"\\([1])\"); return 0 }\n", "function main(): Integer { print(\"\"\"\n  short\n    \"\"\"); return 0 }\n", "function main(): Integer { print(#\"missing\"); return 0 }\n"]
let messages = ["text interpolation needs Integer, Boolean, Character, or Text", "multi-line Text has less indentation", "raw Text is missing its closing delimiter"]
for index in 0..bad.length {
    let rejected = path + "-bad" + Text(index)
    io.writeTextFile(rejected + ".min", bad[index])
    let result = test.run([stage0, rejected + ".min", "-o", rejected + ".ll"], system.environment(), "", rejected + ".compile", 30)
    test.check(result.status == 1 && result.output == "" && test.contains(result.errorOutput, messages[index]), "bootstrap text rejection\n" + result.errorOutput)
    test.check(files.pathSize(rejected + ".ll") < 0, "rejected bootstrap Text emitted LLVM")
}
test.removeTree(compiler.directory)
print("Bootstrap text literals: passed")
