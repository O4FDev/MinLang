// Preserved from bakeoff/sol-cycles at 73c0749; exact output remains unchanged.
record Node { value: Integer; next: List<Node> }
record Branch { leaves: List<Leaf> }
record Leaf { parent: Branch; value: Integer }
function self(value: Integer): Node {
    let node = Node { value: value; next: [] }
    node.next.add(node)
    return node
}
function read(node: Node, garbage: Node): Integer {
    return node.next[0].value + garbage.value
}
function churn(value: Integer): Node {
    let i = 0
    while i < 300 { let garbage = self(i); i += 1 }
    return self(value)
}
// The first call result survives collection during evaluation of the second.
print(read(self(7), churn(8)))
let a = self(11)
let b = self(22)
a.next[0] = b
b.next[0] = a
let saved = a.next[0]
a.next = []
b.next = []
print(saved.value)
let branch = Branch { leaves: [] }
let leaf = Leaf { parent: branch; value: 33 }
branch.leaves.add(leaf)
let other = Branch { leaves: [] }
leaf.parent = other
other.leaves.add(leaf)
print(other.leaves[0].parent.leaves[0].value)
let i = 0
while i < 20000 {
    let node = self(i)
    if i % 1000 == 0 { print(node.next[0].value) }
    i += 1
}
