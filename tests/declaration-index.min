use "io" as io
use "../tools/testing.min" as test
use "system" as system
use "./frontend-fixtures.min" as fixtures

let compiler = test.compiler()
let core = io.readTextFile(test.setting("MINYAR_TEST_SOURCE", "build/compiler.min"))
let main = core.find("\nfunction main(")
test.check(main >= 0, "compiler source entry point changed")
let probe = core.slice(0, main) + "\n" + io.readTextFile("tests/declaration-index-probe.min")
test.require(test.compile(compiler, probe), "compile selected declaration index")
let llvm = compiler.directory + "/case" + Text(compiler.serial) + ".ll"
for optimization in ["-O0", "-O2"] {
    let executable = compiler.directory + "/declaration-index"
    let command = [compiler.clang, optimization]
    for flag in compiler.flags { command.add(flag) }
    for item in ["-Wno-override-module", llvm, compiler.runtime, "-lm", "-o", executable] { command.add(item) }
    test.require(test.run(command, system.environment(), "", compiler.directory + "/link", 120), "link declaration index " + optimization)
    let run = test.run([executable], system.environment(), "", compiler.directory + "/run", 30)
    test.require(run, "execute declaration index " + optimization)
    test.check(run.output == "declaration index verified\n" && run.errorOutput == "", "declaration index oracle")
}
test.removeTree(compiler.directory)
let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
fixtures.executes(frontend, io.readTextFile("examples/gallery/constellations.min"), "Sirius: ✦ ✦\nVega: ✦ ✦ ✦ ✦\nPolaris: ✦ ✦ ✦ ✦ ✦ ✦ ✦ ✦ ✦\n", ["-O0", "-O2"], 0, "", true)
for declaration in ["function repeated() {}\nfunction repeated() {}\n", "record Repeated { value: Integer }\nrecord Repeated { value: Integer }\n", "constant REPEATED = 1\nconstant REPEATED = 2\n", "global REPEATED: List<Integer> = [1]\nglobal REPEATED: List<Integer> = [2]\n"] {
    fixtures.rejects(frontend, declaration, "more than once", true)
}
test.removeTree(frontend.compiler.directory)
print("Hashed declarations: empty, missing, duplicate, kind, Unicode and collision cases passed at O0/O2")
