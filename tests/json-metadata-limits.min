use "json" as json
function check(condition: Boolean, message: Text) { if !condition { fail(message) } }

let pieces: List<Text> = []
for index in 0..70000 { pieces.add("a") }
let wire = Bytes("\"" + joinText(pieces) + "\"")
check(json.parseUniqueBytes(wire, 131072).kind == json.INVALID, "existing byte metadata cap stays at 64 KiB")
check(json.parseUniqueBytesWithin(wire, wire.length, 1, 1).kind == json.STRING, "explicit byte budget permits a larger scalar")
check(json.parseUniqueBytesWithin(wire, wire.length - 1, 1, 1).kind == json.INVALID, "byte budget boundary")
let items: List<Text> = []
for index in 0..5000 { items.add("0") }
let joined: List<Text> = ["["]
for index in 0..items.length { if index > 0 { joined.add(",") }; joined.add(items[index]) }
joined.add("]")
let array = Bytes(joinText(joined))
check(json.parseUniqueBytes(array, 65536).kind == json.INVALID, "existing 4096-value budget stays unchanged")
check(json.parseUniqueBytesWithin(array, 65536, 5001, 1).kind == json.ARRAY, "explicit value budget")
check(json.parseUniqueBytesWithin(array, 65536, 5000, 1).kind == json.INVALID, "value budget includes the root")
let object = Bytes("{\"a\":1,\"b\":2}")
check(json.parseUniqueBytesWithin(object, 100, 3, 2).kind == json.OBJECT, "object budget boundary")
check(json.parseUniqueBytesWithin(object, 100, 3, 1).kind == json.INVALID, "member limit")
check(json.parseUniqueBytesWithin(object, 100, 2, 2).kind == json.INVALID, "object values include the root")
let duplicate = Bytes("{\"a\":0,\"\\u0061\":1}")
check(json.parseUniqueBytesWithin(duplicate, 100, 10, 10).kind == json.INVALID, "decoded duplicate keys stay rejected")
check(json.parseUniqueBytesWithin(Bytes("\"\\ud800\""), 100, 10, 10).kind == json.INVALID, "strict surrogate validation stays enabled")
let invalid = Bytes(); invalid.add(255)
check(json.parseUniqueBytesWithin(invalid, 100, 10, 10).kind == json.INVALID, "UTF-8 validation")
check(json.parseUniqueBytesWithin(object, 0, 3, 2).kind == json.INVALID, "invalid policy")
print("JSON metadata limits passed")
