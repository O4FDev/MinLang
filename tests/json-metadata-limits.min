use "json" as json
function check(condition: Boolean, message: Text) { if !condition { fail(message) } }

let pieces: List<Text> = []
for index in 0..70000 { pieces.add("a") }
let wire = Bytes("\"" + joinText(pieces) + "\"")
check(json.parseUniqueBytes(wire, 131072).kind == json.INVALID, "existing byte metadata cap stays at 64 KiB")
check(json.parseUniqueBytesWithin(wire, wire.length, 1, 1).kind == json.STRING, "explicit byte budget permits a larger scalar")
check(json.parseUniqueBytesWithin(wire, wire.length - 1, 1, 1).kind == json.INVALID, "byte budget boundary")
let items: List<Text> = []
for index in 0..5000 { items.add("0") }
let joined: List<Text> = ["["]
for index in 0..items.length { if index > 0 { joined.add(",") }; joined.add(items[index]) }
joined.add("]")
let array = Bytes(joinText(joined))
check(json.parseUniqueBytes(array, 65536).kind == json.INVALID, "existing 4096-value budget stays unchanged")
check(json.parseUniqueBytesWithin(array, 65536, 5001, 1).kind == json.ARRAY, "explicit value budget")
check(json.parseUniqueBytesWithin(array, 65536, 5000, 1).kind == json.INVALID, "value budget includes the root")
let earlyValue = json.parseUniqueBytesWithin(Bytes("[?]"), 100, 1, 1)
check(earlyValue.kind == json.INVALID && earlyValue.text == "JSON metadata value limit exceeded", "value budget stops parsing before an unallocated child")
let object = Bytes("{\"a\":1,\"b\":2}")
check(json.parseUniqueBytesWithin(object, 100, 3, 2).kind == json.OBJECT, "object budget boundary")
check(json.parseUniqueBytesWithin(object, 100, 3, 1).kind == json.INVALID, "member limit")
check(json.parseUniqueBytesWithin(object, 100, 2, 2).kind == json.INVALID, "object values include the root")
let earlyMember = json.parseUniqueBytesWithin(Bytes("{\"a\":0,?}"), 100, 10, 1)
check(earlyMember.kind == json.INVALID && earlyMember.text == "JSON metadata member limit exceeded", "member budget stops parsing before another member name")
let duplicate = Bytes("{\"a\":0,\"\\u0061\":1}")
check(json.parseUniqueBytesWithin(duplicate, 100, 10, 10).kind == json.INVALID, "decoded duplicate keys stay rejected")
let members: List<Text> = ["{"]
for index in 0..8192 {
    if index > 0 { members.add(",") }
    members.add("\"key" + Text(index) + "\":" + Text(index))
}
members.add("}")
let distinctText = joinText(members)
let distinct = Bytes(distinctText)
check(distinct.length < 262144, "large distinct-key fixture remains within the service wire budget")
check(json.parseUniqueBytesWithin(distinct, 262144, 8193, 8192).kind == json.OBJECT, "8192 distinct members parse within exact budgets")
check(json.parseUniqueBytesWithin(distinct, 262144, 8192, 8192).text == "JSON metadata value limit exceeded", "large object value limit is enforced during parsing")
check(json.parseUniqueBytesWithin(distinct, 262144, 8193, 8191).text == "JSON metadata member limit exceeded", "large object member limit is enforced during parsing")
let escapedDuplicate = Bytes(distinctText.slice(0, distinctText.length - 1) + ",\"\\u006bey0\":0}")
check(json.parseUniqueBytesWithin(escapedDuplicate, 262144, 8194, 8193).text == "duplicate JSON member", "large decoded-equal escaped key is rejected without a quadratic scan")
check(json.parseUniqueBytesWithin(Bytes("\"\\ud800\""), 100, 10, 10).kind == json.INVALID, "strict surrogate validation stays enabled")
let invalid = Bytes(); invalid.add(255)
check(json.parseUniqueBytesWithin(invalid, 100, 10, 10).kind == json.INVALID, "UTF-8 validation")
check(json.parseUniqueBytesWithin(object, 0, 3, 2).kind == json.INVALID, "invalid policy")
for source in ["1e9999", "-1e9999"] {
    let number = json.parse(source)
    check(number.kind == json.INVALID && number.text.find("number is not finite") == 0, "nonfinite JSON number is rejected: " + source)
}
check(json.parse("1e308").kind == json.NUMBER, "largest ordinary finite exponent remains accepted")
check(json.parse("1e-9999").kind == json.NUMBER && json.parse("1e-9999").number == 0.0, "finite exponent underflow remains accepted")
check(json.parse("0e9999").kind == json.NUMBER && json.parse("0e9999").number == 0.0, "zero stays finite with an enormous exponent")
check(json.parseUniqueBytesWithin(Bytes("0e9999"), 100, 1, 1).kind == json.NUMBER, "bounded strict parsing accepts finite zero")
print("JSON metadata limits passed")
