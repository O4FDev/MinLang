use "eventloop" as loop
use "errors" as errors
use "net" as net

let created = loop.create()
if !errors.integerOk(created) { fail("loop create") }
let handle = errors.integerValue(created)
let socket = net.udp("127.0.0.1", 0)
let watched = loop.watch(handle, socket, loop.readableInterest(), 91)
if !errors.integerOk(watched) { fail("loop watch") }
let registration = errors.integerValue(watched)
let scheduled = loop.timer(handle, 2, 0, 123)
if !errors.integerOk(scheduled) { fail("timer create") }
let batch = loop.wait(handle, 1000, 8)
if errors.isError(loop.batchError(batch)) { fail("loop wait") }
let events = loop.events(batch)
if events.length != 1 { fail("timer count") }
if events[0].token != 123 || !loop.isTimer(events[0]) { fail("timer identity") }
let old = events[0]
let failed = loop.wait(-1, 0, 8)
if !errors.isError(loop.batchError(failed)) { fail("invalid loop accepted") }
if old.token != 123 { fail("owned event changed") }
// Allocation-free forms: a reused caller buffer, counts, accessors and negated codes.
let buffer = Bytes()
if loop.updateInterest(handle, registration, loop.writableInterest(), 92) != 0 { fail("update interest") }
let count = loop.waitInto(handle, 1000, 8, buffer)
if count != 1 || buffer.length != 40 { fail("waitInto count") }
if loop.eventToken(buffer, 0) != 92 || loop.eventRegistration(buffer, 0) != registration { fail("waitInto identity") }
if loop.eventFlags(buffer, 0) & loop.WRITABLE == 0 || loop.eventKind(buffer, 0) != 0 || loop.eventNativeCode(buffer, 0) != 0 { fail("waitInto flags") }
if loop.updateInterest(handle, registration, loop.writableInterest(), 93) != 0 { fail("token-only update") }
if loop.waitInto(handle, 1000, 8, buffer) != 1 || loop.eventToken(buffer, 0) != 93 { fail("token-only update applied") }
if loop.updateInterest(handle, registration, loop.readableInterest(), 91) != 0 { fail("restore interest") }
if loop.waitInto(handle, 0, 8, buffer) != 0 || buffer.length != 8 { fail("waitInto timeout") }
let again = errors.integerValue(loop.timer(handle, 0, 0, 124))
if loop.waitInto(handle, 1000, 8, buffer) != 1 || loop.eventKind(buffer, 0) != loop.TIMER_KIND || loop.eventToken(buffer, 0) != 124 || loop.eventRegistration(buffer, 0) != again { fail("waitInto timer") }
if loop.waitInto(handle, -2, 8, buffer) >= 0 { fail("waitInto invalid timeout") }
if loop.updateInterest(handle, registration, 4, 0) >= 0 { fail("update invalid interest") }
if loop.waitInto(-1, 0, 8, buffer) >= 0 || loop.updateInterest(-1, registration, 1, 0) >= 0 { fail("invalid loop handle") }
if !errors.booleanValue(loop.remove(handle, registration)) { fail("loop remove") }
if loop.updateInterest(handle, registration, 1, 0) >= 0 { fail("stale registration updated") }
if errors.booleanOk(loop.remove(handle, registration)) { fail("stale registration accepted") }
if !errors.booleanValue(loop.close(handle)) { fail("loop close") }
if net.localPort(socket) <= 0 { fail("loop stole socket ownership") }
net.close(socket)
print("loop module verified")
