use "eventloop" as loop
use "errors" as errors
use "net" as net

let created = loop.create()
if !errors.integerOk(created) { fail("loop create") }
let handle = errors.integerValue(created)
let socket = net.udp("127.0.0.1", 0)
let watched = loop.watch(handle, socket, loop.readableInterest(), 91)
if !errors.integerOk(watched) { fail("loop watch") }
let registration = errors.integerValue(watched)
let scheduled = loop.timer(handle, 2, 0, 123)
if !errors.integerOk(scheduled) { fail("timer create") }
let batch = loop.wait(handle, 1000, 8)
if errors.isError(loop.batchError(batch)) { fail("loop wait") }
let events = loop.events(batch)
if events.length != 1 { fail("timer count") }
if events[0].token != 123 || !loop.isTimer(events[0]) { fail("timer identity") }
let old = events[0]
let failed = loop.wait(-1, 0, 8)
if !errors.isError(loop.batchError(failed)) { fail("invalid loop accepted") }
if old.token != 123 { fail("owned event changed") }
if !errors.booleanValue(loop.remove(handle, registration)) { fail("loop remove") }
if errors.booleanOk(loop.remove(handle, registration)) { fail("stale registration accepted") }
if !errors.booleanValue(loop.close(handle)) { fail("loop close") }
if net.localPort(socket) <= 0 { fail("loop stole socket ownership") }
net.close(socket)
print("loop module verified")
