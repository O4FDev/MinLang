use "json" as json
use "text" as text
use "errors" as errors

public function present(value: json.Value, name: Text): Boolean {
    if value.kind != json.OBJECT { return false }
    for key in value.keys { if key == name { return true } }
    return false
}
public function field(value: json.Value, name: Text): json.Value { return json.member(value, name) }
public function isText(value: json.Value): Boolean { return value.kind == json.STRING }
public function isObject(value: json.Value): Boolean { return value.kind == json.OBJECT }
public function isArray(value: json.Value): Boolean { return value.kind == json.ARRAY }
public function isNull(value: json.Value): Boolean { return value.kind == json.NULL }
public function isTrue(value: json.Value): Boolean { return value.kind == json.BOOLEAN && value.truth }
public function isFalse(value: json.Value): Boolean { return value.kind == json.BOOLEAN && !value.truth }
public function exactInteger(value: json.Value): Boolean {
    if value.kind != json.NUMBER { return false }
    let raw = Bytes(value.text)
    let start = 0
    if raw.length > 0 && raw[0] == 45 { start = 1 }
    if start == raw.length { return false }
    for index in start..raw.length { if raw[index] < 48 || raw[index] > 57 { return false } }
    return raw.length - start <= 18
}
public function integer(value: json.Value): Integer {
    if !exactInteger(value) { fail("JSON value is not an exact integer") }
    return errors.integerValue(text.parseInteger(value.text))
}
public function within(value: json.Value, minimum: Integer, maximum: Integer): Boolean {
    return exactInteger(value) && integer(value) >= minimum && integer(value) <= maximum
}
public function equalsInteger(value: json.Value, expected: Integer): Boolean {
    return exactInteger(value) && integer(value) == expected
}
public function equalsText(value: json.Value, expected: Text): Boolean {
    return value.kind == json.STRING && value.text == expected
}
public function texts(value: json.Value): List<Text> {
    let result: List<Text> = []
    if value.kind != json.ARRAY { return result }
    for item in value.items { result.add(item.text) }
    return result
}
public function allTexts(value: json.Value): Boolean {
    if value.kind != json.ARRAY { return false }
    for item in value.items { if item.kind != json.STRING { return false } }
    return true
}
public function duplicate(value: json.Value): Text {
    if value.kind == json.OBJECT {
        let names = value.keys.sorted()
        for index in 1..names.length { if names[index] == names[index - 1] { return names[index] } }
    }
    for child in value.items {
        let found = duplicate(child)
        if found != "" { return found }
    }
    return ""
}
public function invalid(message: Text): json.Value {
    return json.Value { kind: json.INVALID; text: message; number: 0.0; truth: false; items: []; keys: [] }
}
public function decode(raw: Bytes): json.Value {
    if !text.validUTF8(raw) { return invalid("invalid UTF-8 JSON document") }
    let value = json.parse(Text(raw))
    if value.kind == json.INVALID { return value }
    let repeated = duplicate(value)
    if repeated != "" { return invalid("duplicate JSON field: " + repeated) }
    return value
}
public function equal(left: json.Value, right: json.Value): Boolean {
    if left.kind != right.kind { return false }
    if left.kind == json.NUMBER {
        if exactInteger(left) && exactInteger(right) { return integer(left) == integer(right) }
        return left.number == right.number
    }
    if left.kind == json.STRING || left.kind == json.BOOLEAN || left.kind == json.NULL { return left.text == right.text }
    if left.items.length != right.items.length { return false }
    if left.kind == json.ARRAY {
        for index in 0..left.items.length { if !equal(left.items[index], right.items[index]) { return false } }
        return true
    }
    for index in 0..left.keys.length {
        if !present(right, left.keys[index]) || !equal(left.items[index], field(right, left.keys[index])) { return false }
    }
    return true
}

public function string(value: Text): json.Value {
    return json.Value { kind: json.STRING; text: value; number: 0.0; truth: false; items: []; keys: [] }
}
public function number(value: Integer): json.Value {
    return json.Value { kind: json.NUMBER; text: Text(value); number: Float(value); truth: false; items: []; keys: [] }
}
public function decimal(value: Text): json.Value {
    return json.Value { kind: json.NUMBER; text: value; number: 0.0; truth: false; items: []; keys: [] }
}
public function boolean(value: Boolean): json.Value {
    return json.Value { kind: json.BOOLEAN; text: Text(value); number: 0.0; truth: value; items: []; keys: [] }
}
public function none(): json.Value {
    return json.Value { kind: json.NULL; text: "null"; number: 0.0; truth: false; items: []; keys: [] }
}
public function object(keys: List<Text>, items: List<json.Value>): json.Value {
    if keys.length != items.length { fail("JSON object keys and values differ") }
    return json.Value { kind: json.OBJECT; text: ""; number: 0.0; truth: false; items: items; keys: keys }
}
public function array(items: List<json.Value>): json.Value {
    return json.Value { kind: json.ARRAY; text: ""; number: 0.0; truth: false; items: items; keys: [] }
}
public function strings(values: List<Text>): json.Value {
    let items: List<json.Value> = []
    for value in values { items = items.appended(string(value)) }
    return array(items)
}
public function with(value: json.Value, name: Text, item: json.Value): json.Value {
    let keys: List<Text> = []
    let items: List<json.Value> = []
    let replaced = false
    for index in 0..value.keys.length {
        keys.add(value.keys[index])
        if value.keys[index] == name { items = items.appended(item); replaced = true }
        else { items = items.appended(value.items[index]) }
    }
    if !replaced { keys.add(name); items = items.appended(item) }
    return object(keys, items)
}
public function without(value: json.Value, name: Text): json.Value {
    let keys: List<Text> = []
    let items: List<json.Value> = []
    for index in 0..value.keys.length {
        if value.keys[index] != name { keys.add(value.keys[index]); items = items.appended(value.items[index]) }
    }
    return object(keys, items)
}

function hexDigits(code: Integer): Text {
    let digits = Bytes("0123456789abcdef")
    let result = Bytes()
    for shift in [12, 8, 4, 0] { result.add(digits[(code >> shift) & 15]) }
    return Text(result)
}
public function quote(value: Text): Text {
    let parts: List<Text> = ["\""]
    for character in value {
        let code = Integer(character)
        if character == '"' { parts.add("\\\"") }
        else if character == '\\' { parts.add("\\\\") }
        else if code == 10 { parts.add("\\n") }
        else if code == 13 { parts.add("\\r") }
        else if code == 9 { parts.add("\\t") }
        else if code == 8 { parts.add("\\b") }
        else if code == 12 { parts.add("\\f") }
        else if code < 32 || (code > 126 && code < 65536) { parts.add("\\u" + hexDigits(code)) }
        else if code >= 65536 {
            let reduced = code - 65536
            parts.add("\\u" + hexDigits(55296 + (reduced >> 10)) + "\\u" + hexDigits(56320 + (reduced & 1023)))
        } else { parts.add(Text(character)) }
    }
    parts.add("\"")
    return joinText(parts)
}
function write(value: json.Value, indent: Text, pretty: Boolean, parts: List<Text>) {
    if value.kind == json.STRING { parts.add(quote(value.text)); return }
    if value.kind == json.OBJECT || value.kind == json.ARRAY {
        let open = "["
        let close = "]"
        if value.kind == json.OBJECT { open = "{"; close = "}" }
        if value.items.length == 0 { parts.add(open + close); return }
        parts.add(open)
        let inner = indent + "  "
        for index in 0..value.items.length {
            if index > 0 { parts.add(",") }
            if pretty { parts.add("\n" + inner) } else if index > 0 { parts.add(" ") }
            if value.kind == json.OBJECT { parts.add(quote(value.keys[index]) + ": ") }
            write(value.items[index], inner, pretty, parts)
        }
        if pretty { parts.add("\n" + indent) }
        parts.add(close)
        return
    }
    if value.kind == json.BOOLEAN {
        if value.truth { parts.add("true") } else { parts.add("false") }
        return
    }
    if value.kind == json.NULL { parts.add("null"); return }
    parts.add(value.text)
}
public function dumps(value: json.Value): Text {
    let parts: List<Text> = []
    write(value, "", false, parts)
    return joinText(parts)
}
public function pretty(value: json.Value): Text {
    let parts: List<Text> = []
    write(value, "", true, parts)
    return joinText(parts)
}
