// connecthttp.gzip: a Connect Compressor over the deflate module, with its
// output bound, rejection of invalid data, and use by a server and client.
use "connecthttp" as connecthttp
use "connect" as connect
use "rpc" as rpc
use "text" as utf8

let gzip = connecthttp.gzip()
let input = Bytes("hello ".repeat(1000))
let packed = gzip.compress(input).unwrap()
print(Text(packed.length < 200) + " " + Text(packed[0]) + " " + Text(packed[1]))
print(gzip.decompress(packed, 6000).unwrap().length)
match gzip.decompress(packed, 5999) { Ok(_) { print("no limit") } Err(problem) { print(problem.message()) } }
match gzip.decompress(Bytes("nope"), 100) { Ok(_) { print("accepted") } Err(problem) { print(problem.message()) } }
print(gzip.decompress(gzip.compress(Bytes()).unwrap(), 10).unwrap().length)

let services = rpc.services()
services.addUnary("/t.v1.S/Echo", rpc.IDEMPOTENCY_UNKNOWN, function(call: rpc.Call, data: Bytes): Result<Bytes, rpc.Error> { return Ok(data) })
let options = connect.defaults(function(): Integer { return 0 })
options.compressors.add(connecthttp.gzip())
let server = connect.server(services, options)
let sizes: List<Text> = []
let client = connect.client("", "proto", function(request: connect.Request): Result<connect.Response, rpc.Error> {
    let response = server.handle(request)
    sizes.add(Text(request.body.length) + "/" + rpc.headerValue(response.headers, "content-encoding") + "/" + Text(response.body.length))
    return Ok(response)
}, "")
client.compressors.add(connecthttp.gzip())
match client.unary("/t.v1.S/Echo", input, connect.callOptions()) {
    Ok(reply) { print(Text(reply.message.length) + " " + Text(utf8.decodeOrStop(reply.message.slice(0, 6)) == "hello ")) }
    Err(failure) { print(failure.error.message) }
}
client.sendCompression = "gzip"
for size in [10, 6000] {
    match client.unary("/t.v1.S/Echo", Bytes("x".repeat(size)), connect.callOptions()) {
        Ok(reply) { print(reply.message.length) }
        Err(failure) { print(failure.error.message) }
    }
}
let get = connect.callOptions()
get.get = true
services.addUnary("/t.v1.S/Look", rpc.NO_SIDE_EFFECTS, function(call: rpc.Call, data: Bytes): Result<Bytes, rpc.Error> { return Ok(data) })
match client.unary("/t.v1.S/Look", Bytes("y".repeat(3000)), get) {
    Ok(reply) { print(reply.message.length) }
    Err(failure) { print(failure.error.message) }
}
let compressed = connect.Request { method: "POST"; target: "/t.v1.S/Echo"
    headers: [rpc.Header { name: "content-type"; value: "application/proto" }, rpc.Header { name: "content-encoding"; value: "gzip" }]; body: packed }
print(server.handle(compressed).body.length)
let bomb = gzip.compress(Bytes(5000000)).unwrap()
let exploded = server.handle(connect.Request { method: "POST"; target: "/t.v1.S/Echo"
    headers: [rpc.Header { name: "content-type"; value: "application/proto" }, rpc.Header { name: "content-encoding"; value: "gzip" }]; body: bomb })
print(Text(exploded.status) + " " + utf8.decodeOrStop(exploded.body))
print(joinText(sizes, " "))
