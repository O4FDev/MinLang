use "tlsverify" as trust
function tlv(tag: Integer,data: Bytes): Bytes {
    let result=Bytes();result.add(tag);result.add(data.length);result.addBytes(data);return result
}
function certificate(before: Text,after: Text,general: Boolean): Bytes {
    let tag=23;if general { tag=24 }
    let validity=tlv(tag,Bytes(before));validity.addBytes(tlv(tag,Bytes(after)))
    let tbs=tlv(2,Bytes(1));tbs.addBytes(tlv(48,Bytes()));tbs.addBytes(tlv(48,Bytes()));tbs.addBytes(tlv(48,validity))
    tbs.addBytes(tlv(48,Bytes()));tbs.addBytes(tlv(48,Bytes()))
    let body=tlv(48,tbs);body.addBytes(tlv(48,Bytes()));body.addBytes(tlv(3,Bytes(1)))
    return tlv(48,body)
}
function pack(data: Bytes): Bytes {
    let result=Bytes();result.add((data.length>>16)&255);result.add((data.length>>8)&255);result.add(data.length&255);result.addBytes(data);result.add(0);result.add(0);return result
}
function main(): Integer {
    // Synthetic DER below exercises only time extraction, never establishes
    // trust. RFC5280 date rules and independent Python datetime epochs.
    let utc=pack(certificate("500101000000Z","491231235959Z",false))
    if trust.currentCertificateExpiry(utc) != 2524607999000 { return 1 }
    let general=pack(certificate("19000101000000Z","99991231235959Z",true))
    if trust.currentCertificateExpiry(general) != 253402300799000 { return 2 }
    let leap=pack(certificate("000229000000Z","480229000000Z",false))
    if trust.currentCertificateExpiry(leap) != 2466547200000 { return 3 }
    for date in ["490231235959Z","490431235959Z","491331235959Z","491200235959Z","491231245959Z","491231236059Z","491231235960Z","49123123595AZ","491231235959+","491231235959","491231235959Zx"] {
        if trust.currentCertificateExpiry(pack(certificate("500101000000Z",date,false))) != 0 { return 4 }
    }
    for prefix in 0..utc.length { if trust.currentCertificateExpiry(utc.slice(0,prefix)) != 0 { return 5 } }
    let trailing=utc.slice(0,utc.length);trailing.add(0);if trust.currentCertificateExpiry(trailing) != 0 { return 6 }
    let cert=readBytesFile(argument(0));let expected=0;for digit in argument(1) { expected=expected*10+Integer(digit)-48 }
    if trust.currentCertificateExpiry(pack(cert)) != expected { return 7 }
    if trust.currentCertificateExpiry(pack(readBytesFile(argument(2)))) != 0 || trust.currentCertificateExpiry(pack(readBytesFile(argument(3)))) != 0 { return 8 }
    let merged=general.slice(0,general.length);merged.addBytes(utc)
    if trust.currentCertificateExpiry(merged) != 2524607999000 { return 9 }
    if argument(4)!="" {
        let corpus=readBytesFile(argument(4));let at=0;let count=0
        while at<corpus.length {
            if corpus.length-at<10 { return 10 }
            let length=(corpus[at]<<8)|corpus[at+1];at+=2;let wanted=0
            for offset in 0..8 { wanted=(wanted<<8)|corpus[at+offset] };at+=8
            if length>corpus.length-at { return 11 }
            let observed=trust.currentCertificateExpiry(corpus.slice(at,at+length))
            if observed!=wanted { print("calendar oracle mismatch at "+Text(count)+" expected "+Text(wanted)+" got "+Text(observed));return 12 }
            at+=length;count+=1
        }
        print("TLS calendar property corpus: "+Text(count)+" seeded independent datetime cases passed")
    }
    print("TLS identity time bounds: UTC century, generalized range, leap/calendar adversaries, every prefix and real certificate oracle passed")
    return 0
}
