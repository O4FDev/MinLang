use "process" as processInfo
use "http" as http

function download(url: Text, mode: Text): http.Response {
    if mode == "default" { return http.getBounded(url, [], 8) }
    return http.getBoundedWithin(url, [], 8, 500)
}

let mode = processInfo.argument(1)
if mode == "binary" {
    let response = download(processInfo.argument(0), mode)
    print(response.status)
    for byte in response.body { print(byte) }
} else if mode == "HEAD" || mode == "GET" {
    let response = http.request(mode, processInfo.argument(0), [], "")
    print(response.status)
    print(response.body.length)
    print(response.error != "")
} else {
    let response = download(processInfo.argument(0), mode)
    print(response.status)
    print(response.body.length)
    print(response.error != "")
}
