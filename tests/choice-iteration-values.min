choice Tone { Low; High }
record Cursor { position: Integer; after: Integer }
function Tone.iterator(): Cursor {
    let after = match self { Low { 2 } High { 3 } }
    return Cursor { position: -1; after: after }
}
function Cursor.advance(): Boolean {
    self.position += 1
    return self.position < self.after
}
function Cursor.current(): Integer { return self.position }
function total<Source: Iterable>(source: Source): Integer {
    let result = 0
    for item in source { result += item }
    return result
}
function marker<Source: Iterable>(source: Source): Integer { return 42 }
function cursorMarker<Value: Iterator>(cursor: Value): Integer { return 43 }
function double(value: Integer): Integer { return value * 2 }
function positive(value: Integer): Boolean { return value > 0 }
for item in Tone.Low { print(item) }
print(total(Tone.Low))
print(total(Tone.High))
print(marker(Tone.Low))
print(cursorMarker(Tone.Low.iterator()))
let recipe = Tone.High.map(double).filter(positive)
for item in recipe { print(item) }
print(total(recipe))
print(marker(recipe))

choice Switch { Present(flag: Boolean); Absent }
function Switch.iterator(): Cursor {
    let after = 0
    match self {
        Present(flag) { if flag { after = 2 } else { after = 1 } }
        Absent {}
    }
    return Cursor { position: -1; after: after }
}
function count<Source: Iterable>(source: Source): Integer {
    let result = 0
    for item in source { result += 1 }
    return result
}
print(count(Switch.Present(true)))
print(count(Switch.Present(false)))
print(count(Switch.Absent))
print(marker(Switch.Present(true)))
let scalarRecipe = Switch.Present(true).map(double)
print(total(scalarRecipe))

choice EmptyCursor { Stopped }
function EmptyCursor.iterator(): EmptyCursor { return self }
function EmptyCursor.advance(): Boolean { return false }
function EmptyCursor.current(): Integer { return 0 }
if marker(EmptyCursor.Stopped) != 42 || cursorMarker(EmptyCursor.Stopped) != 43 { fail("scalar enum cursor capability") }
for item in EmptyCursor.Stopped { fail("advance false must skip the scalar cursor body") }
