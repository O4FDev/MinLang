record Pair {
    left: Integer, right: Integer
}

function add(left: Integer, right: Integer): Integer {
    return left + right
}

function main() {
    let total = 1 +
        2 +
        3
    print(total)

    let joined = add(
        20,
        22,
    )
    print(joined); print(joined - 1)

    let pair = Pair { left: 5
        right: 6 }
    print(pair.left * pair.right)

    let flag = total == 6 &&
        joined == 42
    if flag {
        print("continued")
    }

    let result = total
    -joined
    print(result)
}
