function sum(values: List<Integer>): Integer {
    let position = 0
    let total = 0
    while position < values.length {
        total = total + values[position]
        position = position + 1
    }
    return total
}

function main() {
    let numbers: List<Integer> = []
    numbers.add(20)
    numbers.add(22)
    numbers[0] = 21
    numbers[1] = 21
    print(sum(numbers))

    let names: List<Text> = []
    names.add("Minyar")
    print(names[0])
}
