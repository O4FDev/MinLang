use "../tools/testing.min" as test
use "./performance-support.min" as metrics
use "../experiments/memory/study-support.min" as data
use "files" as files
use "json" as json
public record Options { sizes: List<Integer>; shapes: List<Text>; repeats: Integer; compiler: Text; output: Text; clang: Text; link: Boolean; enforce: Boolean; prepare: Boolean; prepared: Text; functional: Boolean; cpuAvailable: Boolean; inflated: Boolean; darwin: Boolean }
public function options(root: Text, darwin: Boolean): Options {
    let result = Options { sizes: [100, 400]; shapes: ["chain", "wide", "shared"]; repeats: 5; compiler: root + "/build/minyarc-modules"; output: root + "/build/incremental-module-performance.json"; clang: test.setting("MINYAR_TEST_CLANG", test.setting("LLVM_CC", "clang")); link: false; enforce: false; prepare: false; prepared: ""; functional: false; cpuAvailable: true; inflated: false; darwin: darwin }
    let index = 0
    while index < argumentCount() {
        let option = argument(index)
        if option == "--link" { result.link = true }
        else if option == "--enforce" { result.enforce = true }
        else if option == "--prepare-only" { result.prepare = true }
        else if option == "--functional" { result.functional = true }
        else if option == "--cpu-unavailable" { result.cpuAvailable = false }
        else if option == "--inflated-driver" { result.inflated = true }
        else if option == "--sizes" || option == "--shapes" {
            index += 1
            let sizes: List<Integer> = []; let shapes: List<Text> = []
            while index < argumentCount() {
                let value = argument(index); if data.starts(value, "--") { break }
                if option == "--sizes" { sizes.add(Integer(value)) } else { shapes.add(value) }
                index += 1
            }
            if option == "--sizes" { test.check(sizes.length > 0, "--sizes requires values"); result.sizes = sizes }
            else { test.check(shapes.length > 0, "--shapes requires values"); result.shapes = shapes }
            continue
        } else {
            let name = option; let value = ""; let position = -1; let raw = Bytes(option)
            for offset in 0..raw.length { if raw[offset] == 61 { position = offset; break } }
            if position >= 0 { name = Text(raw.slice(0, position)); value = Text(raw.slice(position + 1, raw.length)) }
            else { index += 1; test.check(index < argumentCount(), "option requires value"); value = argument(index) }
            if name == "--repeats" { result.repeats = Integer(value) }
            else if name == "--compiler" { result.compiler = value }
            else if name == "--output" { result.output = value }
            else if name == "--clang" { result.clang = value }
            else if name == "--run-prepared" { result.prepared = value }
            else if name == "--sizes" { result.sizes = [Integer(value)] }
            else if name == "--shapes" { result.shapes = [value] }
            else { fail("unknown incremental performance option " + name) }
        }
        index += 1
    }
    test.check(result.repeats > 0, "positive sizes and repeats required")
    for count in result.sizes { test.check(count > 0, "positive sizes and repeats required") }
    for shape in result.shapes { test.check(shape == "chain" || shape == "wide" || shape == "shared", "invalid graph shape") }
    let phases = 0; if result.prepare { phases += 1 }; if result.prepared != "" { phases += 1 }; if result.functional { phases += 1 }
    test.check(phases <= 1, "incremental performance phase must be singular")
    return result
}
public record Context { options: Options; root: Text; work: Text; report: json.Value; manifest: json.Value; serial: Integer; measuredCalls: Integer }
function hash(path: Text, work: Text): Text { return json.string(metrics.fileIdentity(path, work + "/hash"), "sha256") }
function copy(source: Text, target: Text, work: Text) { test.require(metrics.capture(["/bin/cp", "-p", source, target], work + "/copy"), "freeze measurement artifact") }
function save(context: Context) { files.makeDirectory(data.parent(context.options.output)); writeTextFile(context.options.output, json.pretty(context.report, "") + "\n") }
function expect(context: Context, condition: Boolean, message: Text) {
    if !condition { data.set(context.report, "status", data.text("failed")); data.set(context.report, "error", data.text(message)); save(context); fail(message) }
}
function configuration(options: Options): json.Value { return data.object(["sizes", "shapes", "repeats", "link", "enforce", "clang"], [data.integerArray(options.sizes), data.strings(options.shapes), data.integer(options.repeats), data.boolean(options.link), data.boolean(options.enforce), data.text(options.clang)]) }
function freeze(options: Options, root: Text, work: Text): json.Value {
    let identities = data.object([], []); let labels = ["driver", "compiler", "production", "runtime.o"]
    let sources = [root + "/build/minyar-module-build", options.compiler, root + "/build/minyarc", root + "/build/minyar-runtime.o"]
    for index in 0..labels.length {
        let digest = hash(sources[index], work); copy(sources[index], work + "/" + labels[index], work)
        test.check(hash(work + "/" + labels[index], work) == digest, "same frozen compiler/runtime bytes")
        data.set(identities, labels[index], data.text(digest))
    }
    for shape in options.shapes { for count in options.sizes { metrics.generate(work + "/" + shape + "-" + Text(count), shape, count, 4, 12) } }
    return identities
}
public function prepare(options: Options, root: Text): Text {
    let work = test.scratch()
    let identities = freeze(options, root, work)
    options.clang = metrics.executable(options.clang, work + "/clang-path")
    let version = metrics.capture([options.clang, "--version"], work + "/clang-version"); test.require(version, "LLVM version")
    test.check(test.contains(version.output, "clang version 23.1.2"), "LLVM exactly23.1.2 required")
    let linker = "/usr/lib/llvm-23/bin/ld.lld"; let linkerVersion = metrics.capture([linker, "--version"], work + "/linker-version"); test.require(linkerVersion, "LLVM linker version")
    test.check(test.contains(linkerVersion.output, "LLD 23.1.2"), "matching LLVM linker required")
    let toolchain = json.parse(readTextFile(root + "/build/.toolchain.json"))
    test.check(json.string(toolchain, "llvm_version") == "23.1.2", "matched compiler toolchain")
    let sourceHashes = data.object([], [])
    for shape in options.shapes { for count in options.sizes { let directory = shape + "-" + Text(count); for name in files.list(work + "/" + directory) { data.set(sourceHashes, directory + "/" + name, data.text(hash(work + "/" + directory + "/" + name, work))) } } }
    let manifest = data.object(["config", "artifacts", "source_hashes", "clang_sha256", "clang_version", "linker_sha256", "linker_version", "toolchain", "environment", "workspace_source_sha256"], [configuration(options), identities, sourceHashes, data.text(hash(options.clang, work)), data.text(version.output), data.text(hash(linker, work)), data.text(linkerVersion.output), toolchain, metrics.configurationEnvironment(), data.text(hash(test.setting("MINYAR_TEST_COMPILER_SOURCE", root + "/build/compiler.min"), work))])
    writeTextFile(work + "/prepared.json", json.pretty(manifest, "") + "\n")
    print(work + "/prepared.json")
    return work
}
public function context(options: Options, root: Text): Context {
    let work = ""
    let manifest = data.object([], [])
    if options.functional {
        work = test.scratch()
        for label in ["driver", "compiler", "production", "runtime.o"] { writeTextFile(work + "/" + label, label) }
        for shape in options.shapes { for count in options.sizes { metrics.generate(work + "/" + shape + "-" + Text(count), shape, count, 4, 12) } }
    } else if options.prepared == "" {
        work = test.scratch()
        manifest = data.object(["artifacts"], [freeze(options, root, work)])
        options.clang = metrics.executable(options.clang, work + "/clang-path")
    } else {
        work = data.parent(options.prepared); manifest = json.parse(readTextFile(options.prepared))
        let frozen = json.member(manifest, "config")
        options.sizes = []; for value in json.member(frozen, "sizes").items { options.sizes.add(Integer(value.text)) }
        options.shapes = []; for value in json.member(frozen, "shapes").items { options.shapes.add(value.text) }
        options.repeats = data.number(frozen, "repeats"); options.link = json.member(frozen, "link").truth; options.enforce = json.member(frozen, "enforce").truth; options.clang = json.string(frozen, "clang")
        let identities = json.member(manifest, "artifacts")
        for label in identities.keys { test.check(hash(work + "/" + label, work) == json.string(identities, label), "prepared artifact identity") }
        let sourceHashes = json.member(manifest, "source_hashes")
        for source in sourceHashes.keys { test.check(hash(work + "/" + source, work) == json.string(sourceHashes, source), "prepared same graph source identity") }
        test.check(hash(options.clang, work) == json.string(manifest, "clang_sha256") && hash("/usr/lib/llvm-23/bin/ld.lld", work) == json.string(manifest, "linker_sha256"), "prepared Clang/linker identities")
        test.check(metrics.equal(metrics.configurationEnvironment(), json.member(manifest, "environment")), "prepared SDK identities")
    }
    let platform = metrics.capture(["/usr/bin/uname", "-a"], work + "/platform"); test.require(platform, "benchmark platform")
    let artifacts = data.object([], [])
    for label in ["driver", "compiler", "production", "runtime"] { let filename = label; if label == "runtime" { filename = "runtime.o" }; data.set(artifacts, label, data.text(hash(work + "/" + filename, work))) }
    let clangVersion = data.text("controlled clang version\n")
    if options.prepared != "" { clangVersion = json.member(manifest, "clang_version") }
    else if !options.functional { let version = metrics.capture([options.clang, "--version"], work + "/clang-version"); test.require(version, "Clang version"); clangVersion = data.text(version.output) }
    let report = data.object(["platform", "includes_native_link", "method", "rows", "artifacts", "metric_units", "missing_metric_policy", "clang"], [data.text(platform.output), data.boolean(options.link), data.text("Measure the complete native cache driver against direct production builds."), data.array([]), artifacts, data.object(["cpu_ms", "wall_ms"], [data.text("child user plus system CPU milliseconds"), data.text("elapsed milliseconds")]), data.text("An unavailable phase or sample makes its aggregate unavailable; no zero substitution."), clangVersion])
    if options.prepared != "" { data.set(report, "prepared_configuration", manifest) }
    return Context { options: options; root: root; work: work; report: report; manifest: manifest; serial: 0; measuredCalls: 0 }
}
function fixtureCommand(context: Context, label: Text, command: List<Text>, count: Integer): test.Result {
    if label == "driver" {
        let cache = command[4]; files.makeDirectory(cache); let cold = files.pathSize(cache + "/case.cache") < 0
        let entry = readTextFile(command[2]); let library = readTextFile(data.parent(command[2]) + "/m0.min")
        let edited = test.contains(entry, "let changed") || test.contains(library, "result = result + 2")
        let counters = [count + 1, 0, 0, count + 1, 0, 0]
        if cold { counters = [0, count + 1, 0, 0, 0, 0] } else if edited { counters = [count + 1, 1, 0, count, 0, 0] }
        writeTextFile(cache + "/case.cache", "cache"); let words: List<Text> = []; for value in counters { words.add(Text(value)) }; writeTextFile(command[5], metrics.joined(words, " "))
        writeTextFile(command[3], metrics.compilerLLVM())
    } else if label == "production" { writeTextFile(command[2], metrics.compilerLLVM()) }
    else { for index in 0..(command.length - 1) { if command[index] == "-o" { writeTextFile(command[index + 1], "functional linked artifact") } } }
    return test.Result { status: 0; output: ""; errorOutput: "" }
}
function timed(context: Context, label: Text, command: List<Text>, count: Integer): json.Value {
    context.serial += 1; context.measuredCalls += 1
    let result = metrics.success(data.nullValue())
    if context.options.functional {
        let process = fixtureCommand(context, label, command, count)
        expect(context, process.status == 0, process.errorOutput)
        result = metrics.success(metrics.controlledPhase(label, context.options.cpuAvailable, context.options.inflated))
    } else { result = metrics.timed(command, context.work + "/phase" + Text(context.serial), 30) }
    expect(context, result.ok, result.error)
    return result.value
}
public function run(context: Context) {
    let options = context.options; let rows = json.member(context.report, "rows")
    for shape in options.shapes {
        for count in options.sizes {
            let directory = context.work + "/" + shape + "-" + Text(count); let entry = directory + "/main.min"; let library = directory + "/m0.min"
            let original = readTextFile(entry); let libOriginal = readTextFile(library)
            let cache = directory + "/cache"; let stats = directory + "/stats.txt"
            let driver = [context.work + "/driver", context.work + "/compiler", entry, directory + "/cached.ll", cache, stats]
            let production = [context.work + "/production", entry, directory + "/production.ll"]
            timed(context, "driver", driver, count)
            let cacheFile = ""; for file in files.list(cache) { if data.ends(file, ".cache") { cacheFile = cache + "/" + file; break } }
            expect(context, cacheFile != "", "driver produced a baseline cache")
            let baseline = readBytesFile(cacheFile)
            for scenario in ["unchanged", "entry-edit", "dependency-edit", "interface-edit", "cold"] {
                writeTextFile(entry, original); writeTextFile(library, libOriginal)
                if scenario == "entry-edit" { writeTextFile(entry, test.replace(original, "    print(", "    let changed = 1\n    print(")) }
                if scenario == "dependency-edit" { writeTextFile(library, metrics.replaceFirst(libOriginal, "result = result + 1", "result = result + 2")) }
                if scenario == "interface-edit" { writeTextFile(library, libOriginal + "\npublic record Added { value: Integer }\n") }
                let productionSamples: List<json.Value> = []; let driverSamples: List<json.Value> = []; let counters: List<Text> = []
                timed(context, "production", production, count)
                for repeat in 0..(options.repeats + 1) {
                    metrics.clear(cacheFile + ".delta")
                    if scenario == "cold" { metrics.clear(cacheFile) } else { writeBytesFile(cacheFile, baseline) }
                    let order = ["driver", "production"]; if repeat % 2 != 0 { order = ["production", "driver"] }
                    for label in order {
                        let command = driver; if label == "production" { command = production }
                        let measurement = timed(context, label, command, count)
                        if options.link {
                            let llvm = directory + "/cached.ll"; if label == "production" { llvm = directory + "/production.ll" }
                            let link = [options.clang, "-O0", "-Wno-override-module"]
                            if options.prepared != "" { link.add("--ld-path=/usr/lib/llvm-23/bin/ld.lld") }
                            for item in [llvm, context.work + "/runtime.o", "-o", directory + "/" + label + "-program"] { link.add(item) }
                            if !options.darwin { link.add("-lm") }
                            let linked = timed(context, "clang", link, count)
                            let frontend = measurement; let combined = metrics.combine([frontend, linked]); expect(context, combined.ok, combined.error); measurement = combined.value
                            data.set(measurement, "frontend_ms", frontend); data.set(measurement, "link_ms", linked)
                        }
                        if repeat > 0 { if label == "driver" { driverSamples.add(measurement) } else { productionSamples.add(measurement) } }
                    }
                    let words = test.words(readTextFile(stats)); expect(context, words.length >= 6, "complete cache counters")
                    if scenario == "unchanged" { let expected = [count + 1, 0, 0, count + 1, 0, 0]; for index in 0..6 { expect(context, Integer(words[index]) == expected[index], "unchanged exact six cache counters") } }
                    if scenario == "entry-edit" || scenario == "dependency-edit" { expect(context, Integer(words[1]) == 1, "edited exact one module compilation") }
                    if scenario == "cold" { expect(context, Integer(words[0]) == 0 && Integer(words[1]) == count + 1, "cold exact all module compilations") }
                    if repeat > 0 { counters.add(metrics.joined(words, " ")) }
                    for file in files.list(cache) { expect(context, !data.starts(file, "invocation."), "no invocation storage retained") }
                }
                let driverSummary = metrics.summarize(driverSamples); let productionSummary = metrics.summarize(productionSamples); expect(context, driverSummary.ok && productionSummary.ok, "valid complete build summaries")
                let resultBytes = 0; let deltaBytes = 0
                for file in files.list(cache) { if test.contains(file, ".cache") { resultBytes += files.pathSize(cache + "/" + file) }; if data.ends(file, ".delta") { deltaBytes += files.pathSize(cache + "/" + file) } }
                let cpuAvailable = json.member(driverSummary.value, "cpu_ms").kind != json.NULL && json.member(productionSummary.value, "cpu_ms").kind != json.NULL
                let ceilingStatus = "not-requested"
                if options.enforce {
                    ceilingStatus = "evaluated"
                    if options.link || count < 400 { ceilingStatus = "not-applicable" }
                    else if !cpuAvailable { ceilingStatus = "unavailable" }
                    else if json.member(productionSummary.value, "cpu_ms").number < 20.0 { ceilingStatus = "below-measurement-floor" }
                }
                let medians = data.object(["driver", "production"], [driverSummary.value, productionSummary.value])
                let row = data.object(["shape", "modules", "scenario", "samples", "counters", "median_ms", "cache_bytes", "result_cache_bytes", "delta_bytes", "cpu_ceiling_status"], [data.text(shape), data.integer(count), data.text(scenario), data.object(["production", "driver"], [data.array(productionSamples), data.array(driverSamples)]), data.strings(counters), medians, data.integer(baseline.length), data.integer(resultBytes), data.integer(deltaBytes), data.text(ceilingStatus)])
                rows.items.add(row); save(context)
                print(shape + " " + Text(count) + " " + scenario + " " + json.pretty(medians, ""))
                if ceilingStatus == "evaluated" {
                    let ceiling = 1.05; if scenario == "cold" { ceiling = 3.5 }; if scenario == "interface-edit" { ceiling = 1.8 }
                    expect(context, json.member(driverSummary.value, "cpu_ms").number <= json.member(productionSummary.value, "cpu_ms").number * ceiling, "incremental CPU ceiling exceeded")
                }
            }
        }
    }
    if !options.functional {
        let artifacts = json.member(context.manifest, "artifacts")
        for label in artifacts.keys { expect(context, hash(context.work + "/" + label, context.work) == json.string(artifacts, label), "frozen compiler/runtime unchanged after measurement") }
    }
    if options.prepared != "" {
        expect(context, hash(options.clang, context.work) == json.string(context.manifest, "clang_sha256") && hash("/usr/lib/llvm-23/bin/ld.lld", context.work) == json.string(context.manifest, "linker_sha256"), "matched LLVM23 unchanged after measurement")
        expect(context, metrics.equal(metrics.configurationEnvironment(), json.member(context.manifest, "environment")), "matched SDK unchanged after measurement")
    }
    save(context)
}
