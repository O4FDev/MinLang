use "io" as io
use "../tools/testing.min" as test
use "system" as system

function engineSource(): Text {
    let engine = io.readTextFile("runtime/minyar_runtime.c")
    for header in ["minyar_rc.h", "minyar_collections.h"] {
        let replacement = "minyar_cycle_rc.h"
        if header == "minyar_collections.h" { replacement = "minyar_cycle_collections.h" }
        let directive = "#include \"" + header + "\""
        test.check(engine.byteLength - test.replace(engine, directive, "").byteLength == directive.byteLength, "managed graph runtime requires exactly one ownership header")
        engine = test.replace(engine, directive, "#include \"" + replacement + "\"")
    }
    return "#define MINYAR_SORT_GRAPH 1\n#define MINYAR_MAP_CYCLE_RUNTIME 1\n#if defined(__GNUC__) || defined(__clang__)\n#define MINYAR_NOINLINE __attribute__((noinline))\n#else\n#define MINYAR_NOINLINE\n#endif\n" + engine + "\n#include \"minyar_callbacks.h\"\n"
}

function setting(environment: List<Text>, name: Text, value: Text): List<Text> {
    let result: List<Text> = []
    let prefix = name + "="
    for entry in environment {
        let raw = Bytes(entry)
        if raw.length < prefix.byteLength || Text(raw.slice(0, prefix.byteLength)) != prefix { result.add(entry) }
    }
    result.add(prefix + value)
    return result
}

let work = test.scratch()
let engine = work + "/managed-graphs-engine.c"
io.writeTextFile(engine, engineSource())
let source = work + "/callback-domains.c"
io.writeTextFile(source, test.replace(io.readTextFile("tests/callback-domains.c"), "../build/managed-graphs-engine.c", engine))
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let environment = setting(system.environment(), "ASAN_OPTIONS", "detect_leaks=0:halt_on_error=1")
environment = setting(environment, "UBSAN_OPTIONS", "halt_on_error=1")
for mode in ["native", "sanitize"] {
    let binary = work + "/" + mode
    let command = [clang]
    if mode == "sanitize" {
        for flag in ["-O1", "-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"] { command.add(flag) }
    } else { command.add("-O2") }
    for item in ["-std=c11", "-Wall", "-Wextra", "-Werror", "-DMINYAR_SYSTEM_HEAP=1", "-iquote", "runtime", source, "-o", binary, "-pthread", "-lm"] { command.add(item) }
    test.require(test.run(command, system.environment(), "", binary + ".build", 30), "domain fixture compile")
    for entry in ["", "callback", "environment"] {
        let invocation = [binary]
        if entry != "" { invocation.add(entry) }
        let result = test.run(invocation, environment, "", binary + ".run-" + entry, 10)
        if entry != "" {
            test.check(result.status == 1, "foreign owner entry returned " + Text(result.status) + "\n" + result.errorOutput)
            test.check(test.contains(result.errorOutput, "different execution domain"), "foreign owner diagnostic changed\n" + result.errorOutput)
        } else {
            test.require(result, "owned domain execution")
            test.check(result.output == "callback domains passed\n" && result.errorOutput == "", "owned domain output changed\n" + result.output + result.errorOutput)
        }
        let label = entry
        if label == "" { label = "owned" }
        print(mode + " " + label + " passed")
    }
}
test.removeTree(work)
