choice Tone { Dawn; Noon; Dusk }
choice PresentFirst { Carry(values: Set<Text>); Empty }
choice EmptyFirst { Vacant; Filled(values: Set<Text>) }
record SetBox { values: Maybe<Set<Text>> }
record Detail { name: Text; tone: Tone }
record Key { detail: Detail; number: Integer }

function textSet(word: Text): Set<Text> {
    let values: Set<Text> = Set()
    values.add(word)
    return values
}
function key(name: Text, tone: Tone, number: Integer): Key {
    return Key { detail: Detail { name: name; tone: tone }; number: number }
}
function remember(value: Maybe<Set<Text>>): () -> Maybe<Set<Text>> { return function() { return value } }
function nestedName(value: Maybe<Maybe<Set<Text>>>): Text {
    return match value {
        Some(inner) { match inner { Some(values) { "present " + Text(values.length) } None { "inner none" } } }
        None { "outer none" }
    }
}

print("cases")
print(match Carry(Set<Text>()) { Carry(values) { "carry " + Text(values.length) } Empty { "empty" } })
print(match PresentFirst.Empty { Carry(values) { "carry " + Text(values.length) } Empty { "empty" } })
print(match EmptyFirst.Vacant { Vacant { "vacant" } Filled(values) { "filled " + Text(values.length) } })
print(match Filled(Set<Text>()) { Vacant { "vacant" } Filled(values) { "filled " + Text(values.length) } })
let presentEmpty: Maybe<Set<Text>> = Some(Set<Text>())
let missing: Maybe<Set<Text>> = None
print(presentEmpty.isSome())
print(presentEmpty.unwrap().length)
print(presentEmpty == missing)
print(Some(Set<Text>()) == Some(Set<Text>()))
print(Carry(textSet("sea")) == Carry(textSet("sea")))
print(Filled(textSet("sea")) == Filled(textSet("sea")))

print("equality")
let left: Maybe<Set<Text>> = Some(textSet("sea"))
let right: Maybe<Set<Text>> = Some(textSet("sea"))
print(left == right)
right.unwrap().add("sky")
print(left == right)
if !right.unwrap().remove("sky") { fail("missing sky") }
print(left == right)
let firstBox = SetBox { values: left }
let secondBox = SetBox { values: right }
print(firstBox == secondBox)
secondBox.values = None
print(firstBox == secondBox)
secondBox.values = Some(textSet("sea"))
print(firstBox == secondBox)

print("aliases")
let original = textSet("sea")
let optional: Maybe<Set<Text>> = Some(original)
let alias = optional
optional = None
original = Set<Text>()
let kept = match alias { Some(values) { values } None { Set<Text>() } }
kept.add("sky")
print(alias.unwrap().length)
let box = SetBox { values: alias }
let rows: List<Maybe<Set<Text>>> = [None, box.values]
alias = None
box.values = None
let projected = rows[1].unwrap()
print(projected.remove("sea"))
print(projected.contains("sky"))
let read = remember(Some(projected))
rows[1] = None
projected.clear()
print(read().unwrap().length)
print(read().isSome())
let input: Maybe<Set<Text>> = Some(textSet("held"))
match (input) {
    Some(values) { input = None; values.add("after"); print(values.length) }
    None { fail("missing input") }
}
print(input.isNone())

print("records")
let source = key("pearl", Dawn, 7)
let keys: Set<Key> = Set()
keys.add(source)
keys.add(key("pearl", Dawn, 7))
let stored: Maybe<Set<Key>> = Some(keys)
print(keys.length)
source.detail.name = "changed"; source.detail.tone = Dusk; source.number = 9
print(stored.unwrap().contains(key("pearl", Dawn, 7)))
print(stored.unwrap().contains(source))
for snapshot in stored.unwrap() {
    snapshot.detail.name = "iterated"; snapshot.detail.tone = Dusk; snapshot.number = 99
}
print(stored.unwrap().contains(key("pearl", Dawn, 7)))
let other: Set<Key> = Set()
other.add(key("pearl", Dawn, 7))
print(stored == Some(other))
other.add(key("shell", Noon, 8))
print(stored == Some(other))
if !other.remove(key("shell", Noon, 8)) { fail("missing shell") }
print(stored == Some(other))
print(keys.remove(key("pearl", Dawn, 7)))
print(stored.unwrap().length)
print(stored.isSome())

print("enums")
let tones: Set<Tone> = Set()
tones.add(Dawn); tones.add(Dusk); tones.add(Dawn)
let toneValues: Maybe<Set<Tone>> = Some(tones)
tones = Set<Tone>()
print(toneValues.unwrap().contains(Dawn))
print(toneValues.unwrap().length)
print(toneValues.unwrap().remove(Dawn))
print(toneValues.unwrap().remove(Dawn))
print(toneValues.unwrap().length)
toneValues.unwrap().clear()
print(toneValues.unwrap().length)
print(toneValues.isSome())

print("text growth")
let words: Set<Text> = Set()
let growing: Maybe<Set<Text>> = Some(words)
for index in 0..40 { words.add("key" + Text(index)) }
print(growing.unwrap().length)
for index in 0..20 { if !words.remove("key" + Text(index * 2)) { fail("missing even key") } }
print(growing.unwrap().length)
print(growing.unwrap().contains("key1"))
print(growing.unwrap().contains("key2"))
words.clear()
print(growing.unwrap().length)
print(growing.isSome())

print("nested")
let outerNone: Maybe<Maybe<Set<Text>>> = None
let innerNone: Maybe<Maybe<Set<Text>>> = Some(None<Set<Text>>())
let nestedEmpty: Maybe<Maybe<Set<Text>>> = Some(Some(Set<Text>()))
print(nestedName(outerNone)); print(nestedName(innerNone)); print(nestedName(nestedEmpty))
print(outerNone == innerNone)
print(innerNone == Some(None<Set<Text>>()))
print(nestedEmpty == innerNone)
print(Some(Some(Set<Text>())) == nestedEmpty)
