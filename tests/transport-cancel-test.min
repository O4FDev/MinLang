use "./net-fixtures.min" as fixtures
use "../tools/testing.min" as test

fixtures.arguments(["--sanitize"], [])
let context = fixtures.context(fixtures.flag("--sanitize"))
let ca = fixtures.authority(context, context.work + "/ca")
fixtures.root(ca, "root")
fixtures.leaf(ca, "server", "root", fixtures.ec("serverAuth"))
fixtures.leaf(ca, "client", "root", fixtures.ec("clientAuth"))
let binary = context.work + "/cancel"
fixtures.compileProgram(context, "tests/transport-cancel.min", binary)
let result = fixtures.run(context, [binary, fixtures.path(ca, "root", "der"), fixtures.path(ca, "server", "der"), fixtures.path(ca, "server", "pk8"),
    fixtures.path(ca, "client", "der"), fixtures.path(ca, "client", "pk8")], 120)
test.check(result.status == 0, "transport cancel failed (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
fixtures.emit(result.output)
fixtures.finish(context)
