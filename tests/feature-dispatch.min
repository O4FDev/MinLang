use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "files" as files

function selected(selectors: List<Text>, name: Text): Boolean {
    if selectors.length == 0 { return true }
    for selector in selectors { if selector == "FeatureDispatch" || selector == name || selector == "FeatureDispatch." + name { return true } }
    return false
}
let names = ["test_valid_feature_headers_compile_in_the_primary_frontend", "test_feature_looking_text_and_ordinary_record_name_do_not_dispatch", "test_modifier_names_as_bindings_do_not_enable_frontends", "test_incomplete_typed_headers_remain_source_errors"]
let selectors: List<Text> = []
for index in 0..processInfo.argumentCount() {
    let selector = processInfo.argument(index)
    if selector == "-v" || selector == "--verbose" || selector == "-q" || selector == "--quiet" { continue }
    let known = selector == "FeatureDispatch"
    for name in names { if selector == name || selector == "FeatureDispatch." + name { known = true } }
    test.check(known, "unknown feature dispatch selector: " + selector)
    selectors.add(selector)
}
let compiler = test.compiler()
if selected(selectors, names[0]) {
    for source in ["function make(): Callback<Nothing> { fail(\"unused\") }\n", "function make(): Callback<Integer, Text, Integer> { fail(\"unused\") }\n", "function make(): Callback<List<Integer>> { fail(\"unused\") }\n", "function make(): Callback<List<Integer>, List<Text>, Nothing> { fail(\"unused\") }\n", "function make(): Callback<List<List<Integer> >, Integer> { fail(\"unused\") }\n", "let callback = function() {}\n", "let callback = function(value: Integer) { print(value) }\n", "let callback = function(first: Integer, second: Text): Integer { return first }\n", "record Node { children: List<Node> }\nlet node = Node { children: [] }\nnode.children.add(node)\n", "record Node { children: List<Node> }\nlet node = Node { children: [] }\nnode.children = [node]\n"] {
        let result = test.compile(compiler, source)
        test.require(result, "valid parsed feature header")
        test.check(result.output == "" && result.errorOutput == "", "valid parsed feature header emitted diagnostics")
        test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") >= 0, "valid parsed feature header emitted no LLVM")
    }
}
if selected(selectors, names[1]) {
    test.require(test.compile(compiler, "record Callback { value: Integer }\nfunction value(record: Callback): Integer { return record.value }\nprint(value(Callback { value: 42 }))\nprint(\"Callback<Integer> function(value: Integer) {}\")\n"), "ordinary feature-looking text")
    let path = compiler.directory + "/case" + Text(compiler.serial) + ".ll"
    test.check(files.pathSize(path) >= 0, "ordinary feature-looking text emitted no LLVM")
    let ir = io.readTextFile(path)
    test.check(!test.contains(ir, "minyar-cycle-runtime") && !test.contains(ir, "minyar-callback-runtime"), "ordinary feature-looking text enabled a frontend")
}
if selected(selectors, names[2]) {
    test.executes(compiler, "let parallel = 1\nlet thread = 2\nprint(parallel + thread)\n", "3\n")
    let ir = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
    test.check(!test.contains(ir, "minyar-thread-runtime") && !test.contains(ir, "minyar-parallel:"), "modifier bindings enabled a frontend")
}
if selected(selectors, names[3]) {
    for source in ["let callback = function(value) {}\n", "let callback = function(1: Integer) {}\n", "let callback = function(): Integer\n", "function make(): Callback<> {}\n", "function make(): Callback<Integer {}\n"] {
        let result = test.compile(compiler, source)
        test.check(result.status == 1, "incomplete feature header status\n" + result.errorOutput)
        test.check(result.errorOutput != "", "incomplete feature header lost its source diagnostic")
        test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "incomplete feature header emitted unsafe LLVM")
    }
}
test.removeTree(compiler.directory)
print("Parsed feature dispatch: passed")
