// VMM-1: a hosted Linux Minyar program cannot make a system call that the
// standard library does not wrap. A VMM needs open(O_RDWR) on /dev/kvm,
// ioctl with struct pointers, mmap of a vCPU's kvm_run, eventfd, epoll,
// futex, signalfd, memfd. There is no `syscall` builtin or `machine.syscall`
// intrinsic, and a user package cannot declare `native "linux"` and link C
// (see vmm-3). Expected: something like
//     let fd = machine.syscall(2, path, 2, 0, 0, 0, 0)   // open
//     let version = machine.syscall(16, fd, 0xAE00, 0, 0, 0, 0)   // ioctl KVM_GET_API_VERSION
// Workaround in neo-vm: shim/linux.c exports minyar_linux_syscall(n, a..f),
// declared in mlib/linux.min as `native "linux"` and linked by tools/mbuild.
use "machine" as machine

let path = Bytes("/dev/kvm")
path.add(0)
let fd = machine.syscall(2, machine.address(path), 2, 0, 0, 0, 0)   // compile error: no such intrinsic
print(fd)
