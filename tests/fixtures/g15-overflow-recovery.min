// Adapted from neo-db/minyar-gaps/g15_overflow_untrappable.min (G15).
use "errors" as errors

function scale(digits: Integer): errors.IntegerResult {
    let r = 1
    for i in 0..digits {
        let next = errors.checkedMultiply(r, 10)
        if !errors.integerOk(next) { return next }
        r = errors.integerValue(next)
    }
    return errors.integer(r)
}

print(errors.integerValue(scale(18)))
let overflow = scale(19)
print(errors.integerOk(overflow))
print(errors.code(errors.integerError(overflow)) == errors.overflowCode())
print(errors.integerValue(scale(2)))
print("still alive")
