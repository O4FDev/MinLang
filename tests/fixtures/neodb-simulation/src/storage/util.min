// Small helpers shared by the storage modules. Name matching works on raw bytes: a file name that is not valid
// UTF-8 must never stop recovery (Minyar validates UTF-8 on Text character operations).
use "../../lib/dbio.min" as dbio

public function storageFail(what: Text, code: Integer) {
    fail("storage: " + what + ": " + dbio.errorText(code) + " (" + Text(code) + ")")
}

public function hex16(value: Integer): Text {
    let b = Bytes()
    let shift = 60
    while shift >= 0 {
        let d = (value >> shift) & 15
        if d < 10 { b.add(48 + d) } else { b.add(87 + d) }
        shift -= 4
    }
    return Text(b)
}

// Parses 16 lowercase/uppercase hex digits from b[offset, offset+16); -1 if invalid.
public function parseHex16(b: Bytes, offset: Integer): Integer {
    if offset < 0 || offset + 16 > b.length { return -1 }
    let v = 0
    let last = offset + 16
    for i in offset..last {
        let ch = b[i]
        let d = -1
        if ch >= 48 && ch <= 57 { d = ch - 48 }
        if ch >= 97 && ch <= 102 { d = ch - 87 }
        if ch >= 65 && ch <= 70 { d = ch - 55 }
        if d < 0 { return -1 }
        if i == offset && d >= 8 { return -1 }   // keep it a positive Integer
        v = (v << 4) | d
    }
    return v
}

// name (as raw bytes) is prefix ++ <16 hex digits> ++ suffix; returns the hex value or -1.
public function matchHexName(name: Text, prefix: Text, suffix: Text): Integer {
    let b = Bytes(name)
    let p = Bytes(prefix)
    let s = Bytes(suffix)
    if b.length != p.length + 16 + s.length { return -1 }
    if !hasPrefix(b, p) || !hasSuffix(b, s) { return -1 }
    return parseHex16(b, p.length)
}

public function hasPrefix(b: Bytes, p: Bytes): Boolean {
    if b.length < p.length { return false }
    for i in 0..p.length {
        if b[i] != p[i] { return false }
    }
    return true
}

public function hasSuffix(b: Bytes, s: Bytes): Boolean {
    if b.length < s.length { return false }
    let off = b.length - s.length
    for i in 0..s.length {
        if b[off + i] != s[i] { return false }
    }
    return true
}

public function nameHasPrefixSuffix(name: Text, prefix: Text, suffix: Text): Boolean {
    let b = Bytes(name)
    return b.length >= Bytes(prefix).length + Bytes(suffix).length && hasPrefix(b, Bytes(prefix)) &&
           hasSuffix(b, Bytes(suffix))
}

public record NamedLsn {
    lsn: Integer
    path: Text
}

// Sorts by lsn, ascending (or descending). Insertion sort: there are only a handful of files.
public function sortByLsn(items: List<NamedLsn>, descending: Boolean) {
    let i = 1
    while i < items.length {
        let j = i
        while j > 0 && ((!descending && items[j - 1].lsn > items[j].lsn) || (descending && items[j - 1].lsn < items[j].lsn)) {
            let tmp = items[j - 1]
            items[j - 1] = items[j]
            items[j] = tmp
            j -= 1
        }
        i += 1
    }
}
