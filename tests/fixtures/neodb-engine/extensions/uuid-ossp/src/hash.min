// MD5 (RFC 1321) and SHA-1 (FIPS 180-4) for name-based UUIDs. Not for security.
use "math" as math

constant M32 = 4294967295

function rotl(x: Integer, c: Integer): Integer { return ((x << c) | (x >> (32 - c))) & M32 }

function padded(data: Bytes, bigEndianLength: Boolean): Bytes {
    let m = Bytes()
    m.addBytes(data)
    m.add(128)
    while m.length % 64 != 56 { m.add(0) }
    let bits = data.length * 8
    let i = 0
    while i < 8 {
        if bigEndianLength { m.add((bits >> (56 - i * 8)) & 255) } else { m.add((bits >> (i * 8)) & 255) }
        i += 1
    }
    return m
}

public function md5(data: Bytes): Bytes {
    let shifts = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21]
    let k: List<Integer> = []
    let i = 0
    while i < 64 {
        let s = math.sin(Float(i + 1))
        if s < 0.0 { s = -s }
        k.add(Integer(math.floor(s * 4294967296.0)))
        i += 1
    }
    let m = padded(data, false)
    let a0 = 1732584193
    let b0 = 4023233417
    let c0 = 2562383102
    let d0 = 271733878
    let chunk = 0
    while chunk < m.length {
        let a = a0
        let b = b0
        let c = c0
        let d = d0
        i = 0
        while i < 64 {
            let f = 0
            let g = 0
            if i < 16 {
                f = (b & c) | ((b ^ M32) & d)
                g = i
            } else if i < 32 {
                f = (d & b) | ((d ^ M32) & c)
                g = (5 * i + 1) % 16
            } else if i < 48 {
                f = b ^ c ^ d
                g = (3 * i + 5) % 16
            } else {
                f = c ^ (b | (d ^ M32))
                g = (7 * i) % 16
            }
            let word = m.getUInt32(chunk + g * 4)
            f = (f + a + k[i] + word) & M32
            a = d
            d = c
            c = b
            b = (b + rotl(f, shifts[(i / 16) * 4 + i % 4])) & M32
            i += 1
        }
        a0 = (a0 + a) & M32
        b0 = (b0 + b) & M32
        c0 = (c0 + c) & M32
        d0 = (d0 + d) & M32
        chunk += 64
    }
    let out = Bytes()
    out.addUInt32(a0)
    out.addUInt32(b0)
    out.addUInt32(c0)
    out.addUInt32(d0)
    return out
}

function be32(m: Bytes, at: Integer): Integer {
    return (m[at] << 24) | (m[at + 1] << 16) | (m[at + 2] << 8) | m[at + 3]
}

public function sha1(data: Bytes): Bytes {
    let m = padded(data, true)
    let h0 = 1732584193
    let h1 = 4023233417
    let h2 = 2562383102
    let h3 = 271733878
    let h4 = 3285377520
    let w: List<Integer> = []
    let i = 0
    while i < 80 {
        w.add(0)
        i += 1
    }
    let chunk = 0
    while chunk < m.length {
        i = 0
        while i < 16 {
            w[i] = be32(m, chunk + i * 4)
            i += 1
        }
        while i < 80 {
            w[i] = rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1)
            i += 1
        }
        let a = h0
        let b = h1
        let c = h2
        let d = h3
        let e = h4
        i = 0
        while i < 80 {
            let f = 0
            let k = 0
            if i < 20 {
                f = (b & c) | ((b ^ M32) & d)
                k = 1518500249
            } else if i < 40 {
                f = b ^ c ^ d
                k = 1859775393
            } else if i < 60 {
                f = (b & c) | (b & d) | (c & d)
                k = 2400959708
            } else {
                f = b ^ c ^ d
                k = 3395469782
            }
            let t = (rotl(a, 5) + f + e + k + w[i]) & M32
            e = d
            d = c
            c = rotl(b, 30)
            b = a
            a = t
            i += 1
        }
        h0 = (h0 + a) & M32
        h1 = (h1 + b) & M32
        h2 = (h2 + c) & M32
        h3 = (h3 + d) & M32
        h4 = (h4 + e) & M32
        chunk += 64
    }
    let out = Bytes()
    for h in [h0, h1, h2, h3, h4] {
        out.add((h >> 24) & 255)
        out.add((h >> 16) & 255)
        out.add((h >> 8) & 255)
        out.add(h & 255)
    }
    return out
}
