// feed_redact: change feeds without secrets. Before any listener sees a change, columns named password, ssn
// or email (or ending in _secret) read "redacted", and tables whose names start with "_" send nothing.
use "neodb-sdk" as sdk

public function extension(): sdk.Extension {
    let x = sdk.extension("feed_redact", "1.0", "remove secrets from change feeds")
    x.feedTransform("redact", function(call) { redact(call) })
    return x
}

function secret(column: Text): Boolean {
    return column == "password" || column == "ssn" || column == "email" || column.endsWith("_secret")
}

deterministic function redact(call: sdk.Call) {
    let change = call.change()
    if change.table.startsWith("_") {
        call.returnNull()
        return
    }
    for column in change.columns {
        if secret(column) { change.setText(column, "redacted") }
    }
    call.returnText(change.json())
}
