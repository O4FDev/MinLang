// IEEE half precision (binary16) conversions for halfvec. Halves are stored as their 16-bit patterns.

function pow2(e: Integer): Float {
    let r = 1.0
    let n = e
    while n > 0 { r = r * 2.0; n -= 1 }
    while n < 0 { r = r / 2.0; n += 1 }
    return r
}

// Round half to even, for x >= 0.
function roundEven(x: Float): Integer {
    let r = Integer(x)
    let d = x - Float(r)
    if d > 0.5 || (d == 0.5 && r % 2 == 1) { r += 1 }
    return r
}

// Half bits of f, rounded to nearest even; values beyond the half range become infinity.
public function fromFloat(f: Float): Integer {
    if f != f { return 32256 }
    let sign = 0
    let a = f
    if f < 0.0 || (f == 0.0 && 1.0 / f < 0.0) {
        sign = 32768
        a = -f
    }
    if a >= 65520.0 { return sign + 31744 }
    if a < 0.00006103515625 {
        // subnormal: multiples of 2^-24
        return sign + roundEven(a * 16777216.0)
    }
    let e = 0
    let m = a
    while m >= 2.0 { m = m / 2.0; e += 1 }
    while m < 1.0 { m = m * 2.0; e -= 1 }
    let frac = roundEven((m - 1.0) * 1024.0)
    if frac == 1024 {
        frac = 0
        e += 1
    }
    if e > 15 { return sign + 31744 }
    return sign + (e + 15) * 1024 + frac
}

public function toFloat(h: Integer): Float {
    let sign = 1.0
    if h >= 32768 { sign = -1.0 }
    let e = (h / 1024) % 32
    let frac = h % 1024
    if e == 0 { return sign * Float(frac) / 16777216.0 }
    if e == 31 {
        if frac != 0 { return 0.0 / 0.0 }
        return sign / 0.0
    }
    return sign * (1.0 + Float(frac) / 1024.0) * pow2(e - 15)
}

public function isInfinite(h: Integer): Boolean { return h % 32768 == 31744 }
