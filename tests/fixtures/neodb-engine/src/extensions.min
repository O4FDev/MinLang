// Extensions compiled into this neo-db build. Each one is a Minyar package (see docs/r2/extensions.md);
// add it with `minyar add <name> --path <dir>` (or a git URL) and list its extension() here.
// Compiled in = available (pg_available_extensions); CREATE EXTENSION installs it in one database.
// Built-ins (src/builtin) are neo-db's own core types written with the same SDK; they are always installed.
use "neodb-sdk" as sdk
use "vector" as vector
use "uuid-ossp" as uuid
use "feed-redact" as redact
use "./builtin/bit.min" as bit

public function available(): List<sdk.Extension> {
    return [bit.extension(), vector.extension(), uuid.extension(), redact.extension(),
            sdk.extension("tin", "1.0.6", "full-text search with TINQL and exact BM25 (built into neo-db's engine)"),
            sdk.extension("search", "1.0", "full-text search (alias of tin)")]
}
