// Stemmer registry: the Snowball languages of TIN/Lead (rust-stemmers 1.2.0), by their ISO 639-1 codes, all 18
// generated from rust-stemmers into snowball/ (see ops/search/snowball/gen.sh), English included (the hand-written
// Porter2 in stem.min follows a newer revision and differs from TIN on a few words; it is no longer used for
// indexes). Ids are stored in index files and the catalog: never renumber them.
use "./snowball/runtime.min" as sb
use "./snowball/english.min" as english
use "./snowball/arabic.min" as arabic
use "./snowball/danish.min" as danish
use "./snowball/dutch.min" as dutch
use "./snowball/finnish.min" as finnish
use "./snowball/french.min" as french
use "./snowball/german.min" as german
use "./snowball/greek.min" as greek
use "./snowball/hungarian.min" as hungarian
use "./snowball/italian.min" as italian
use "./snowball/norwegian.min" as norwegian
use "./snowball/portuguese.min" as portuguese
use "./snowball/romanian.min" as romanian
use "./snowball/russian.min" as russian
use "./snowball/spanish.min" as spanish
use "./snowball/swedish.min" as swedish
use "./snowball/tamil.min" as tamil
use "./snowball/turkish.min" as turkish

public constant NONE = 0
public constant EN = 1
public constant AR = 2
public constant DA = 3
public constant NL = 4
public constant FI = 5
public constant FR = 6
public constant DE = 7
public constant EL = 8
public constant HU = 9
public constant IT = 10
public constant NO = 11
public constant PT = 12
public constant RO = 13
public constant RU = 14
public constant ES = 15
public constant SV = 16
public constant TA = 17
public constant TR = 18

public constant CODES = "en, ar, da, nl, fi, fr, de, el, hu, it, no, pt, ro, ru, es, sv, ta, tr"

// The id of a Lead stemmer code (lower-case ISO 639-1, as Lead accepts them), or -1.
public function byCode(code: Text): Integer {
    if code == "en" { return EN }
    if code == "ar" { return AR }
    if code == "da" { return DA }
    if code == "nl" { return NL }
    if code == "fi" { return FI }
    if code == "fr" { return FR }
    if code == "de" { return DE }
    if code == "el" { return EL }
    if code == "hu" { return HU }
    if code == "it" { return IT }
    if code == "no" { return NO }
    if code == "pt" { return PT }
    if code == "ro" { return RO }
    if code == "ru" { return RU }
    if code == "es" { return ES }
    if code == "sv" { return SV }
    if code == "ta" { return TA }
    if code == "tr" { return TR }
    return -1
}

public function code(id: Integer): Text {
    if id == EN { return "en" }
    if id == AR { return "ar" }
    if id == DA { return "da" }
    if id == NL { return "nl" }
    if id == FI { return "fi" }
    if id == FR { return "fr" }
    if id == DE { return "de" }
    if id == EL { return "el" }
    if id == HU { return "hu" }
    if id == IT { return "it" }
    if id == NO { return "no" }
    if id == PT { return "pt" }
    if id == RO { return "ro" }
    if id == RU { return "ru" }
    if id == ES { return "es" }
    if id == SV { return "sv" }
    if id == TA { return "ta" }
    if id == TR { return "tr" }
    return ""
}

// Appends the stem of buf[off .. off + len) to out. The word must be lower-case (and NFC for the Snowball languages);
// z is scratch state reused across words.
public function stem(z: sb.Env, id: Integer, buf: Bytes, off: Integer, len: Integer, out: Bytes) {
    if id == EN {
        sb.start(z, buf, off, len, english.INTEGERS, english.STRINGS)
        english.stem(z)
    } else if id == AR {
        sb.start(z, buf, off, len, arabic.INTEGERS, arabic.STRINGS)
        arabic.stem(z)
    } else if id == DA {
        sb.start(z, buf, off, len, danish.INTEGERS, danish.STRINGS)
        danish.stem(z)
    } else if id == NL {
        sb.start(z, buf, off, len, dutch.INTEGERS, dutch.STRINGS)
        dutch.stem(z)
    } else if id == FI {
        sb.start(z, buf, off, len, finnish.INTEGERS, finnish.STRINGS)
        finnish.stem(z)
    } else if id == FR {
        sb.start(z, buf, off, len, french.INTEGERS, french.STRINGS)
        french.stem(z)
    } else if id == DE {
        sb.start(z, buf, off, len, german.INTEGERS, german.STRINGS)
        german.stem(z)
    } else if id == EL {
        sb.start(z, buf, off, len, greek.INTEGERS, greek.STRINGS)
        greek.stem(z)
    } else if id == HU {
        sb.start(z, buf, off, len, hungarian.INTEGERS, hungarian.STRINGS)
        hungarian.stem(z)
    } else if id == IT {
        sb.start(z, buf, off, len, italian.INTEGERS, italian.STRINGS)
        italian.stem(z)
    } else if id == NO {
        sb.start(z, buf, off, len, norwegian.INTEGERS, norwegian.STRINGS)
        norwegian.stem(z)
    } else if id == PT {
        sb.start(z, buf, off, len, portuguese.INTEGERS, portuguese.STRINGS)
        portuguese.stem(z)
    } else if id == RO {
        sb.start(z, buf, off, len, romanian.INTEGERS, romanian.STRINGS)
        romanian.stem(z)
    } else if id == RU {
        sb.start(z, buf, off, len, russian.INTEGERS, russian.STRINGS)
        russian.stem(z)
    } else if id == ES {
        sb.start(z, buf, off, len, spanish.INTEGERS, spanish.STRINGS)
        spanish.stem(z)
    } else if id == SV {
        sb.start(z, buf, off, len, swedish.INTEGERS, swedish.STRINGS)
        swedish.stem(z)
    } else if id == TA {
        sb.start(z, buf, off, len, tamil.INTEGERS, tamil.STRINGS)
        tamil.stem(z)
    } else if id == TR {
        sb.start(z, buf, off, len, turkish.INTEGERS, turkish.STRINGS)
        turkish.stem(z)
    } else {
        let i = 0
        while i < len {
            out.add(buf[off + i])
            i += 1
        }
        return
    }
    out.addBytes(z.cur)
}
