// The primary composite of first + second, or -1 (first * 0x110000 + second is the sorted key).
public function compose(first: Integer, second: Integer): Integer {
    let key = first * 0x110000 + second
    let lo = 0
    let hi = KEYS.length
    while lo < hi {
        let mid = (lo + hi) >> 1
        let k = KEYS[mid]
        if k == key { return VALUES[mid] }
        if k < key { lo = mid + 1 } else { hi = mid }
    }
    return -1
}
