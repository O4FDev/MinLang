public constant AT_DROP_NOT_NULL = 11   // text: column
public constant AT_RENAME_CONSTRAINT = 12 // text: old name; child 1: new K_NAME
public constant AT_SET_OPTIONS = 13     // child 0: K_LIST of K_DEF_ELEM (SET (fillfactor = 100))
