// SQL AST arena shared by the parser (src/sql/parser.min) and the engine.
//
// Every node lives in Ast.nodes; a node refers to its children by index (node id).
// -1 means "absent" in a fixed child slot. Variable-length parts are a K_LIST node.
// The full contract (slots, op, flags, text, intValue for every kind) is docs/AST.md.
// Numbering is stable: kinds/ops/flags may be ADDED but never renumbered or repurposed.

public record Node {
    kind: Integer
    op: Integer
    text: Text
    intValue: Integer
    floatValue: Float
    flags: Integer
    position: Integer          // 0-based character offset into the whole SQL string (PG position = +1)
    children: List<Integer>
}

public record Ast {
    nodes: List<Node>
    statements: List<Integer>   // root node id of each statement, in source order (empty statements skipped)
    stmtStart: List<Integer>    // character offset of each statement's first character
    stmtEnd: List<Integer>      // character offset one past its last character (the ';' is excluded)
    stmtText: List<Text>        // source text of each statement (trimmed of surrounding whitespace)
    paramCount: Integer         // highest $n seen anywhere (0 if none)
}

public record ParseResult {
    ast: Ast
    ok: Boolean
    error: Text                 // "" when ok
    errorPosition: Integer      // 0-based character offset of the offending token, -1 if none
    sqlstate: Text              // "42601" on syntax errors, "" when ok
}

// ---------------------------------------------------------------- node kinds
// Generic
public constant K_LIST = 1              // children: the items
public constant K_NAME = 2              // text: identifier (unquoted ones are lower-cased)
// Literals
public constant K_INT_LIT = 10          // text: digits as written; intValue: value; flags F_INT_OVERFLOW if it does not fit int64
public constant K_NUM_LIT = 11          // text: literal as written (1.5, .5, 1e10); floatValue: approximate value
public constant K_STR_LIT = 12          // text: decoded string value; flags F_STR_ESCAPE (E'..'), F_STR_DOLLAR, F_STR_BIT (B'..'/X'..' raw)
public constant K_BOOL_LIT = 13         // intValue: 1 true, 0 false
public constant K_NULL_LIT = 14
public constant K_PARAM = 15            // intValue: n of $n (1-based)
public constant K_DEFAULT = 16          // DEFAULT keyword inside VALUES rows / SET c = DEFAULT
// Expressions
public constant K_COLUMN_REF = 20       // text: column name; children: qualifier K_NAMEs in order (t | s,t | c,s,t)
public constant K_STAR = 21             // * or t.*; children: qualifier K_NAMEs in order
public constant K_BINARY_OP = 22        // op: OP_*; text: operator symbol / keyword; children [left, right]
public constant K_UNARY_OP = 23         // op: OP_NEG/OP_POS/OP_NOT/OP_BIT_NOT/OP_OTHER; text: symbol; children [arg]
public constant K_FUNC_CALL = 24        // text: function name; children [schema K_NAME|-1, args K_LIST, filter|-1, over K_WINDOW_DEF|-1, aggOrderBy K_LIST|-1]
public constant K_CAST = 25             // op: CAST_*; children [expr, K_TYPENAME]
public constant K_TYPENAME = 26         // text: canonical type name; op: INTERVAL_* fields; intValue: array dims; children [modifiers K_LIST|-1]
public constant K_CASE = 27             // children [arg|-1, whens K_LIST of K_WHEN, else|-1]
public constant K_WHEN = 28             // children [condition (or comparand for simple CASE), result]
public constant K_BETWEEN = 29          // flags F_NOT, F_SYMMETRIC; children [expr, low, high]
public constant K_IN_LIST = 30          // flags F_NOT; children [expr, K_LIST of values]
public constant K_IN_SUBQUERY = 31      // flags F_NOT; children [expr, query]
public constant K_EXISTS = 32           // children [query]
public constant K_SUBQUERY_EXPR = 33    // scalar subquery; children [query]
public constant K_QUANTIFIED = 34       // x op ANY/SOME/ALL (...); op: OP_*; text: symbol; intValue: QUANT_*; flags F_SUBQUERY; children [expr, query|arrayExpr]
public constant K_LIKE = 35             // op: LIKE_*; flags F_NOT; children [expr, pattern, escape|-1]
public constant K_IS_TEST = 36          // op: TEST_*; flags F_NOT; children [expr]
public constant K_ARRAY_EXPR = 37       // ARRAY[...]; children [K_LIST of elements]
public constant K_ARRAY_SUBQUERY = 38   // ARRAY(select); children [query]
public constant K_ROW_EXPR = 39         // (a, b) or ROW(a, b); flags F_EXPLICIT_ROW for ROW(...); children [K_LIST]
public constant K_SUBSCRIPT = 40        // a[i] / a[i:j]; flags F_SLICE; children [expr, lower|-1, upper|-1]
public constant K_COLLATE = 41          // text: collation name; children [expr]
public constant K_WINDOW_DEF = 42       // text: window name (WINDOW w AS ...) or ""; intValue unused;
                                        // children [refName K_NAME|-1, partitionBy K_LIST|-1, orderBy K_LIST|-1, frame K_FRAME|-1]
public constant K_FRAME = 43            // op: FRAME_*; intValue: EXCLUDE_*; children [start K_FRAME_BOUND, end K_FRAME_BOUND|-1]
public constant K_FRAME_BOUND = 44      // op: BOUND_*; children [offset|-1]
public constant K_FIELD_SELECT = 45     // (expr).field; text: field name ("*" for (expr).*); children [expr]
public constant K_GROUPING_SET = 46     // op: GSET_*; children [K_LIST] (items may be K_ROW_EXPR for sub-lists)
// Queries (a "query" is K_SELECT, K_SET_OP or K_VALUES; all three share slots 5,6,7,9)
public constant K_SELECT = 60           // children [targets, from|-1, where|-1, groupBy|-1, having|-1, orderBy|-1, limit|-1, offset|-1, distinctOn|-1, with|-1, windows|-1]
public constant K_SET_OP = 61           // op: SETOP_*; flags F_ALL; children [left, right, -1, -1, -1, orderBy|-1, limit|-1, offset|-1, -1, with|-1, -1]
public constant K_VALUES = 62           // children [rows K_LIST of K_LIST, -1, -1, -1, -1, orderBy|-1, limit|-1, offset|-1, -1, with|-1, -1]
public constant K_TARGET = 63           // text: output column name (alias, or PG's derived name); flags F_TARGET_ALIAS; children [expr]
public constant K_TABLE_REF = 64        // text: table name; flags F_ONLY; children [schema K_NAME|-1, alias K_ALIAS|-1]
public constant K_SUBQUERY_REF = 65     // flags F_LATERAL; children [query, alias K_ALIAS|-1]
public constant K_FUNC_REF = 66         // function in FROM; flags F_LATERAL, F_WITH_ORDINALITY; children [K_FUNC_CALL, alias K_ALIAS|-1]
public constant K_JOIN = 67             // op: JOIN_*; flags F_NATURAL; children [left, right, on|-1, using K_LIST of K_NAME|-1, alias K_ALIAS|-1]
public constant K_ALIAS = 68            // text: alias; children [columnAliases K_LIST of K_NAME|-1]
public constant K_SORT_ITEM = 69        // op: SORT_*; intValue: NULLS_*; children [expr]  (also used for index elements)
public constant K_WITH = 70             // flags F_RECURSIVE; children [K_LIST of K_CTE]
public constant K_CTE = 71              // text: name; flags F_MATERIALIZED/F_NOT_MATERIALIZED; children [query (or DML), columns K_LIST|-1]
// DML
public constant K_INSERT = 80           // flags F_DEFAULT_VALUES; children [target K_TABLE_REF, columns K_LIST of K_NAME|-1, source query|-1, onConflict|-1, returning K_LIST of K_TARGET|-1, with|-1]
public constant K_UPDATE = 81           // children [target K_TABLE_REF, set K_LIST of K_SET_ITEM/K_MULTI_SET, from K_LIST|-1, where|-1, returning|-1, with|-1]
public constant K_DELETE = 82           // children [target K_TABLE_REF, using K_LIST|-1, where|-1, returning|-1, with|-1]
public constant K_SET_ITEM = 83         // text: column name; children [value expr (may be K_DEFAULT), subscripts/fields K_LIST|-1]
public constant K_MULTI_SET = 84        // (a, b) = (expr, expr) | (select); children [columns K_LIST of K_NAME, value (K_ROW_EXPR or K_SUBQUERY_EXPR)]
public constant K_ON_CONFLICT = 85      // op: CONFLICT_*; text: constraint name (ON CONSTRAINT x) or ""; children [targetCols K_LIST|-1, set K_LIST|-1, updateWhere|-1, targetWhere|-1]
// DDL
public constant K_CREATE_TABLE = 90     // text: table; flags F_IF_NOT_EXISTS, F_TEMP, F_UNLOGGED; children [schema K_NAME|-1, elements K_LIST, options K_LIST of K_DEF_ELEM|-1]
public constant K_CREATE_TABLE_AS = 91  // text: table; flags F_IF_NOT_EXISTS, F_TEMP, F_UNLOGGED, F_WITH_NO_DATA; children [schema|-1, columns K_LIST|-1, query, options|-1]
public constant K_COLUMN_DEF = 92       // text: column name; children [K_TYPENAME, constraints K_LIST of K_CONSTRAINT]
public constant K_CONSTRAINT = 93       // op: CONSTR_*; text: constraint name or ""; intValue: FK actions (onDelete + 8*onUpdate);
                                        // flags F_DEFERRABLE, F_INITIALLY_DEFERRED, F_NOT_VALID; children
                                        // [expr|-1 (DEFAULT/CHECK/GENERATED), columns K_LIST|-1 (table-level), refTable K_TABLE_REF|-1, refColumns K_LIST|-1, options K_LIST|-1]
public constant K_DEF_ELEM = 94         // name = value option; text: name (lower); children [value|-1]
public constant K_CREATE_INDEX = 95     // text: index name or ""; flags F_UNIQUE, F_IF_NOT_EXISTS, F_CONCURRENTLY;
                                        // children [table K_TABLE_REF, elements K_LIST of K_SORT_ITEM, where|-1, include K_LIST|-1, options K_LIST|-1, method K_NAME|-1]
public constant K_DROP = 96             // op: OBJ_*; flags F_IF_EXISTS, F_CASCADE, F_RESTRICT, F_CONCURRENTLY; children [K_LIST of K_TABLE_REF (names)]
public constant K_CREATE_VIEW = 97      // text: view; flags F_OR_REPLACE, F_TEMP, F_MATERIALIZED; children [schema|-1, columns K_LIST|-1, query]
public constant K_ALTER_TABLE = 98      // flags F_IF_EXISTS, F_ONLY; children [K_TABLE_REF, K_LIST of K_ALTER_CMD]
public constant K_ALTER_CMD = 99        // op: AT_*; text: column/constraint name; flags F_IF_EXISTS, F_IF_NOT_EXISTS, F_CASCADE;
                                        // children [definition|-1 (K_COLUMN_DEF/K_CONSTRAINT/K_TYPENAME/expr/K_LIST), newName K_NAME|-1]
public constant K_TRUNCATE = 100        // flags F_RESTART_IDENTITY, F_CASCADE; children [K_LIST of K_TABLE_REF]
public constant K_CREATE_SCHEMA = 101   // text: schema; flags F_IF_NOT_EXISTS
public constant K_CREATE_SEQUENCE = 102 // text: name; flags F_IF_NOT_EXISTS, F_TEMP; children [schema|-1, options K_LIST of K_DEF_ELEM|-1]
public constant K_CREATE_DATABASE = 103 // text: name; children [options K_LIST|-1]
// Utility
public constant K_TRANSACTION = 110     // op: TX_*; text: savepoint / gid; intValue: ISO_*; flags F_TX_*
public constant K_SET = 111             // op: SET_*; text: variable name (lower, dotted); flags F_SET_LOCAL, F_SET_SESSION; children [values K_LIST|-1]
public constant K_SET_TRANSACTION = 112 // intValue: ISO_*; flags F_TX_* (F_TX_SESSION_CHARACTERISTICS for SET SESSION CHARACTERISTICS AS TRANSACTION)
public constant K_SHOW = 113            // text: variable name (lower), "all"
public constant K_RESET = 114           // text: variable name (lower), "all"
public constant K_VACUUM = 115          // flags F_VACUUM_*; children [tables K_LIST|-1]
public constant K_ANALYZE = 116         // flags F_VACUUM_VERBOSE; children [tables K_LIST|-1]
public constant K_CHECKPOINT = 117
public constant K_COPY = 118            // op: COPY_FROM/COPY_TO; intValue: COPY_STDIO/COPY_FILE/COPY_PROGRAM; text: file name / program;
                                        // children [table K_TABLE_REF|-1, columns K_LIST|-1, query|-1, options K_LIST of K_DEF_ELEM|-1, where|-1]
public constant K_EXPLAIN = 119         // flags F_EXPLAIN_*; children [statement, options K_LIST of K_DEF_ELEM|-1]
public constant K_DISCARD = 120         // text: "all" | "plans" | "sequences" | "temp"
public constant K_DEALLOCATE = 121      // text: name or ""; flags F_ALL
public constant K_PREPARE = 122         // text: name; children [paramTypes K_LIST of K_TYPENAME|-1, statement]
public constant K_EXECUTE = 123         // text: name; children [args K_LIST|-1]
public constant K_LOCK = 124            // text: lock mode (lower, e.g. "access exclusive"); flags F_NOWAIT; children [K_LIST of K_TABLE_REF]
public constant K_LISTEN = 125          // text: channel
public constant K_UNLISTEN = 126        // text: channel or "*"
public constant K_NOTIFY = 127          // text: channel; children [payload K_STR_LIT|-1]
public constant K_COMMENT = 128         // COMMENT ON ... (parsed, no-op); text: object kind; children [object K_TABLE_REF|-1, comment|-1]
// Cursors (kinds 150..169 are reserved for the sql2 agent's additions)
public constant K_DECLARE = 150         // DECLARE name ... CURSOR FOR query; text: name; flags F_CUR_*; children [query]
public constant K_FETCH = 151           // FETCH / MOVE; text: cursor; op: FETCH_*; intValue: count; flags F_FETCH_ALL, F_FETCH_MOVE
public constant K_CLOSE = 152           // CLOSE name | ALL; text: name ("" with F_ALL)
// Partitioning. K_CREATE_TABLE children gain [3] = K_PART_SPEC|-1 (PARTITION BY), [4] = parent K_TABLE_REF|-1
// (PARTITION OF), [5] = K_PART_BOUND|-1.
public constant K_PART_SPEC = 153       // op: PART_*; children [K_LIST of K_DEF_ELEM (text: opclass or ""; children [key expr])]
public constant K_PART_BOUND = 154      // op: PB_*; children [K_LIST values (IN list / FROM / MODULUS, REMAINDER), K_LIST TO values|-1];
                                        // MINVALUE / MAXVALUE are K_NAME "minvalue" / "maxvalue"
public constant K_TABLE_LIKE = 155      // LIKE t in CREATE TABLE elements; flags F_LIKE_DEFAULTS; children [K_TABLE_REF]

