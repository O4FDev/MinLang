// ---------------------------------------------------------------- flags (bit masks; meaning is per kind, see docs/AST.md)
public constant F_NOT = 1               // K_IN_LIST, K_IN_SUBQUERY, K_BETWEEN, K_LIKE, K_IS_TEST
public constant F_SYMMETRIC = 2         // K_BETWEEN
public constant F_SUBQUERY = 2          // K_QUANTIFIED: right side is a subquery (else an array expression)
public constant F_INT_OVERFLOW = 1      // K_INT_LIT: does not fit int64 (treat as numeric)
public constant F_STR_ESCAPE = 1        // K_STR_LIT: E'..'
public constant F_STR_DOLLAR = 2        // K_STR_LIT: $$..$$
public constant F_STR_BIT = 4           // K_STR_LIT: B'..' or X'..' (text holds the raw digits)
public constant F_STR_NATIONAL = 8      // K_STR_LIT: N'..'
public constant F_EXPLICIT_ROW = 1      // K_ROW_EXPR: ROW(...)
public constant F_SLICE = 1             // K_SUBSCRIPT
// K_FUNC_CALL
public constant F_FUNC_DISTINCT = 1     // agg(DISTINCT x)
public constant F_FUNC_STAR = 2         // count(*) (args list empty)
public constant F_FUNC_NO_PARENS = 4    // CURRENT_DATE, CURRENT_TIMESTAMP, LOCALTIMESTAMP, CURRENT_USER, ...
public constant F_FUNC_SPECIAL = 8      // rewritten from EXTRACT/SUBSTRING/POSITION/TRIM/OVERLAY/AT TIME ZONE syntax
public constant F_FUNC_VARIADIC = 16
public constant F_FUNC_ALL = 32         // agg(ALL x)
public constant F_FUNC_WITHIN_GROUP = 64 // aggOrderBy came from WITHIN GROUP (ORDER BY ..)
// K_TARGET
public constant F_TARGET_ALIAS = 1      // explicit alias given (with or without AS)
// K_SELECT
public constant F_DISTINCT = 1
public constant F_DISTINCT_ON = 2
public constant F_FOR_UPDATE = 4
public constant F_FOR_SHARE = 8
public constant F_FOR_NO_KEY_UPDATE = 16
public constant F_FOR_KEY_SHARE = 32
public constant F_NOWAIT = 64           // also K_LOCK
public constant F_SKIP_LOCKED = 128
public constant F_WITH_TIES = 256       // FETCH FIRST n ROWS WITH TIES
public constant F_SELECT_INTO = 512     // SELECT ... INTO t (unsupported by engine; parsed)
// K_SET_OP, K_DEALLOCATE
public constant F_ALL = 1
// K_JOIN
public constant F_NATURAL = 1
// K_SUBQUERY_REF / K_FUNC_REF
public constant F_LATERAL = 1
public constant F_WITH_ORDINALITY = 2
// K_TABLE_REF, K_ALTER_TABLE
public constant F_ONLY = 1024
// K_WITH / K_CTE
public constant F_RECURSIVE = 1
public constant F_MATERIALIZED = 1      // K_CTE, K_CREATE_VIEW (CREATE MATERIALIZED VIEW)
public constant F_NOT_MATERIALIZED = 2
// K_INSERT
public constant F_DEFAULT_VALUES = 1
// DDL flags (unique bits so they can be combined freely)
public constant F_IF_EXISTS = 4
public constant F_IF_NOT_EXISTS = 8
public constant F_CASCADE = 16
public constant F_RESTRICT = 32
public constant F_TEMP = 64
public constant F_UNIQUE = 128
public constant F_OR_REPLACE = 256
public constant F_CONCURRENTLY = 512
public constant F_UNLOGGED = 2048
public constant F_WITH_NO_DATA = 4096
public constant F_RESTART_IDENTITY = 8192
// K_CONSTRAINT
public constant F_DEFERRABLE = 1
public constant F_INITIALLY_DEFERRED = 2
public constant F_NOT_VALID = 4
// K_TRANSACTION / K_SET_TRANSACTION
public constant F_TX_READ_ONLY = 1
public constant F_TX_READ_WRITE = 2
public constant F_TX_DEFERRABLE = 4
public constant F_TX_NOT_DEFERRABLE = 8
public constant F_TX_CHAIN = 16
public constant F_TX_START = 32
public constant F_TX_SESSION_CHARACTERISTICS = 64
// K_DECLARE
public constant F_CUR_SCROLL = 1
public constant F_CUR_NO_SCROLL = 2
public constant F_CUR_HOLD = 4
public constant F_CUR_BINARY = 8
// K_TABLE_LIKE
public constant F_LIKE_DEFAULTS = 1
// K_FETCH
public constant F_FETCH_ALL = 1
public constant F_FETCH_MOVE = 2
// K_SET
public constant F_SET_LOCAL = 1
public constant F_SET_SESSION = 2
// K_VACUUM / K_ANALYZE
public constant F_VACUUM_FULL = 1
public constant F_VACUUM_FREEZE = 2
public constant F_VACUUM_VERBOSE = 4
public constant F_VACUUM_ANALYZE = 8
// K_EXPLAIN
public constant F_EXPLAIN_ANALYZE = 1
public constant F_EXPLAIN_VERBOSE = 2

// Fixed child slots of query nodes (K_SELECT / K_SET_OP / K_VALUES share 5,6,7,9).
public constant Q_TARGETS = 0
public constant Q_FROM = 1
public constant Q_WHERE = 2
public constant Q_GROUP_BY = 3
public constant Q_HAVING = 4
public constant Q_ORDER_BY = 5
public constant Q_LIMIT = 6
public constant Q_OFFSET = 7
public constant Q_DISTINCT_ON = 8
public constant Q_WITH = 9
public constant Q_WINDOWS = 10
public constant Q_LEFT = 0              // K_SET_OP
public constant Q_RIGHT = 1             // K_SET_OP
public constant Q_ROWS = 0              // K_VALUES

// ---------------------------------------------------------------- construction

public function newAst(): Ast {
    return Ast { nodes: []; statements: []; stmtStart: []; stmtEnd: []; stmtText: []; paramCount: 0 }
}

public function addNode(ast: Ast, kind: Integer, op: Integer, text: Text, position: Integer, children: List<Integer>): Integer {
    let id = ast.nodes.length
    ast.nodes.add(Node { kind: kind; op: op; text: text; intValue: 0; floatValue: 0.0; flags: 0; position: position; children: children })
    return id
}

// ---------------------------------------------------------------- access helpers

public function node(ast: Ast, id: Integer): Node {
    return ast.nodes[id]
}

public function kind(ast: Ast, id: Integer): Integer {
    if id < 0 { return 0 }
    return ast.nodes[id].kind
}

public function text(ast: Ast, id: Integer): Text {
    if id < 0 { return "" }
    return ast.nodes[id].text
}

public function hasFlag(ast: Ast, id: Integer, flag: Integer): Boolean {
    if id < 0 { return false }
    return (ast.nodes[id].flags & flag) != 0
}

// Child i of node id, or -1 when id is absent or the slot does not exist.
public function child(ast: Ast, id: Integer, i: Integer): Integer {
    if id < 0 { return -1 }
    let children = ast.nodes[id].children
    if i < 0 || i >= children.length { return -1 }
    return children[i]
}

public function childCount(ast: Ast, id: Integer): Integer {
    if id < 0 { return 0 }
    return ast.nodes[id].children.length
}

// Items of a K_LIST (empty for -1).
public function items(ast: Ast, listId: Integer): List<Integer> {
    if listId < 0 { return [] }
    return ast.nodes[listId].children
}

public function isQuery(ast: Ast, id: Integer): Boolean {
    let k = kind(ast, id)
    return k == K_SELECT || k == K_SET_OP || k == K_VALUES
}

// Immediate qualifier of a K_COLUMN_REF / K_STAR (t in s.t.a), or "".
public function qualifier(ast: Ast, id: Integer): Text {
    if id < 0 { return "" }
    let children = ast.nodes[id].children
    if children.length == 0 { return "" }
    return ast.nodes[children[children.length - 1]].text
}

// Schema of a K_TABLE_REF / K_FUNC_CALL / named DDL node, or "".
public function schemaOf(ast: Ast, id: Integer): Text {
    return text(ast, child(ast, id, 0))
}

// Alias name of a K_TABLE_REF / K_SUBQUERY_REF / K_FUNC_REF / K_JOIN, or "".
public function aliasOf(ast: Ast, id: Integer): Text {
    let k = kind(ast, id)
    if k == K_TABLE_REF || k == K_SUBQUERY_REF || k == K_FUNC_REF { return text(ast, child(ast, id, 1)) }
    if k == K_JOIN { return text(ast, child(ast, id, 4)) }
    return ""
}

// ---------------------------------------------------------------- names (for dumps and messages)

public function kindName(k: Integer): Text {
    if k == K_LIST { return "list" }
    if k == K_NAME { return "name" }
    if k == K_INT_LIT { return "int" }
    if k == K_NUM_LIT { return "num" }
    if k == K_STR_LIT { return "str" }
    if k == K_BOOL_LIT { return "bool" }
    if k == K_NULL_LIT { return "null" }
    if k == K_PARAM { return "param" }
    if k == K_DEFAULT { return "default" }
    if k == K_COLUMN_REF { return "col" }
    if k == K_STAR { return "star" }
    if k == K_BINARY_OP { return "binop" }
    if k == K_UNARY_OP { return "unop" }
    if k == K_FUNC_CALL { return "func" }
    if k == K_CAST { return "cast" }
    if k == K_TYPENAME { return "type" }
    if k == K_CASE { return "case" }
    if k == K_WHEN { return "when" }
    if k == K_BETWEEN { return "between" }
    if k == K_IN_LIST { return "in" }
    if k == K_IN_SUBQUERY { return "in-sub" }
    if k == K_EXISTS { return "exists" }
    if k == K_SUBQUERY_EXPR { return "subquery" }
    if k == K_QUANTIFIED { return "quantified" }
    if k == K_LIKE { return "like" }
    if k == K_IS_TEST { return "is" }
    if k == K_ARRAY_EXPR { return "array" }
    if k == K_ARRAY_SUBQUERY { return "array-sub" }
    if k == K_ROW_EXPR { return "row" }
    if k == K_SUBSCRIPT { return "subscript" }
    if k == K_COLLATE { return "collate" }
    if k == K_WINDOW_DEF { return "window" }
    if k == K_FRAME { return "frame" }
    if k == K_FRAME_BOUND { return "bound" }
    if k == K_FIELD_SELECT { return "field" }
    if k == K_GROUPING_SET { return "grouping-set" }
    if k == K_SELECT { return "select" }
    if k == K_SET_OP { return "setop" }
    if k == K_VALUES { return "values" }
    if k == K_TARGET { return "target" }
    if k == K_TABLE_REF { return "table" }
    if k == K_SUBQUERY_REF { return "subquery-ref" }
    if k == K_FUNC_REF { return "func-ref" }
    if k == K_JOIN { return "join" }
    if k == K_ALIAS { return "alias" }
    if k == K_SORT_ITEM { return "sort" }
    if k == K_WITH { return "with" }
    if k == K_CTE { return "cte" }
    if k == K_INSERT { return "insert" }
    if k == K_UPDATE { return "update" }
    if k == K_DELETE { return "delete" }
    if k == K_SET_ITEM { return "set-item" }
    if k == K_MULTI_SET { return "multi-set" }
    if k == K_ON_CONFLICT { return "on-conflict" }
    if k == K_CREATE_TABLE { return "create-table" }
    if k == K_CREATE_TABLE_AS { return "create-table-as" }
    if k == K_COLUMN_DEF { return "column" }
    if k == K_CONSTRAINT { return "constraint" }
    if k == K_DEF_ELEM { return "option" }
    if k == K_CREATE_INDEX { return "create-index" }
    if k == K_DROP { return "drop" }
    if k == K_CREATE_VIEW { return "create-view" }
    if k == K_ALTER_TABLE { return "alter-table" }
    if k == K_ALTER_CMD { return "alter-cmd" }
    if k == K_TRUNCATE { return "truncate" }
    if k == K_CREATE_SCHEMA { return "create-schema" }
    if k == K_CREATE_SEQUENCE { return "create-sequence" }
    if k == K_CREATE_DATABASE { return "create-database" }
    if k == K_TRANSACTION { return "transaction" }
    if k == K_SET { return "set" }
    if k == K_SET_TRANSACTION { return "set-transaction" }
    if k == K_SHOW { return "show" }
    if k == K_RESET { return "reset" }
    if k == K_VACUUM { return "vacuum" }
    if k == K_ANALYZE { return "analyze" }
    if k == K_CHECKPOINT { return "checkpoint" }
    if k == K_COPY { return "copy" }
    if k == K_EXPLAIN { return "explain" }
    if k == K_DISCARD { return "discard" }
    if k == K_DEALLOCATE { return "deallocate" }
    if k == K_PREPARE { return "prepare" }
    if k == K_EXECUTE { return "execute" }
    if k == K_LOCK { return "lock" }
    if k == K_LISTEN { return "listen" }
    if k == K_UNLISTEN { return "unlisten" }
    if k == K_NOTIFY { return "notify" }
    if k == K_COMMENT { return "comment" }
    if k == K_DECLARE { return "declare" }
    if k == K_FETCH { return "fetch" }
    if k == K_CLOSE { return "close" }
    if k == K_PART_SPEC { return "part-spec" }
    if k == K_PART_BOUND { return "part-bound" }
    if k == K_TABLE_LIKE { return "like" }
    return "kind" + Text(k)
}

// Canonical S-expression of a subtree: (kind[:op][ "text"][ #int][ !flags] child...); -1 prints as _.
public function dump(ast: Ast, id: Integer): Text {
    let parts: List<Text> = []
    dumpInto(ast, id, parts)
    return joinText(parts)
}

function dumpInto(ast: Ast, id: Integer, parts: List<Text>) {
    if id < 0 {
        parts.add("_")
        return
    }
    let n = ast.nodes[id]
    parts.add("(")
    parts.add(kindName(n.kind))
    if n.op != 0 {
        parts.add(":")
        parts.add(Text(n.op))
    }
    if n.text != "" || n.kind == K_STR_LIT {
        parts.add(" ")
        parts.add(quote(n.text))
    }
    if n.intValue != 0 {
        parts.add(" #")
        parts.add(Text(n.intValue))
    }
    if n.flags != 0 {
        parts.add(" !")
        parts.add(Text(n.flags))
    }
    for c in n.children {
        parts.add(" ")
        dumpInto(ast, c, parts)
    }
    parts.add(")")
}

function quote(value: Text): Text {
    let simple = true
    for c in value {
        if c == '"' || c == '\\' || c == '\n' { simple = false }
    }
    if simple { return "\"" + value + "\"" }
    let parts: List<Text> = ["\""]
    for c in value {
        if c == '"' {
            parts.add("\\\"")
        } else if c == '\\' {
            parts.add("\\\\")
        } else if c == '\n' {
            parts.add("\\n")
        } else {
            parts.add(Text(c))
        }
    }
    parts.add("\"")
    return joinText(parts)
}
