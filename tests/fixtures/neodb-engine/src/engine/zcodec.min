// Deterministic stand-in for src/engine/zcodec.min in crash-universe builds (tests/search/sim.sh): never compresses.
public function bound(length: Integer): Integer { return length + 16 }
public function compress(src: Bytes, out: Bytes): Integer { return 0 }
public function decompress(src: Bytes, out: Bytes): Integer { fail("sim zcodec: no compressed values in sim builds") }
