// Plan arena, register-based expression evaluator and pull-based operators.
// Every expression node owns a register (null flag, Integer, aux Integers, Float, text view); evaluating a node
// writes its register. Operators set slot rows; column references read table storage directly.
use "math" as math
use "./values.min" as v
use "./hashmap.min" as hm
use "./table.min" as tb
use "./index.min" as ix
use "./catalog.min" as cat
use "./txn.min" as txn
use "./numeric.min" as nm
use "./strfn.min" as sf
use "./pgcatalog.min" as pgc
use "./regex.min" as rx
use "./json.min" as js
use "../sql/lexer.min" as lexer
use "./ext.min" as ext
use "../search/index.min" as si
use "./array.min" as arr
use "neodb-sdk" as sdk
use "../../lib/dbio.min" as dbio
use "text" as utf8

