// pg_catalog and information_schema relations, materialised from the engine catalog when a query opens them
// (compat agent). Column lists are PG 17's (names, order, types); rows describe neo-db's own tables, views,
// indexes and constraints with stable OIDs, so drivers' metadata queries (pgjdbc DatabaseMetaData, psql \d,
// ORMs) work unchanged. Ordinary statements never touch this module.
//
// OIDs (stable across restarts: the catalog is rebuilt by replaying DDL in order, so positions never move):
//   user table 16384 + table id; view 1016384 + view position; index 3016384 + hash index id (or 4016384 +
//   ordered index id when it has no hash part); PRIMARY KEY / UNIQUE constraint = its index oid + 2000000;
//   foreign key 7016384 + position; column default 8016384 + table id * 1700 + attnum.
use "./values.min" as v
use "./table.min" as tb
use "./index.min" as ix
use "./catalog.min" as cat

public constant OID_TABLE = 16384
public constant OID_VIEW = 1016384
public constant OID_HASHIDX = 3016384
public constant OID_ORDIDX = 4016384
public constant OID_CON_OFFSET = 2000000
public constant OID_FK = 7016384
public constant OID_ATTRDEF = 8016384
public constant NS_CATALOG = 11
public constant NS_PUBLIC = 2200
public constant NS_INFO = 13265
public constant NS_TOAST = 99

// relation codes
public constant R_NAMESPACE = 1
public constant R_CLASS = 2
public constant R_ATTRIBUTE = 3
public constant R_TYPE = 4
public constant R_INDEX = 5
public constant R_CONSTRAINT = 6
public constant R_ATTRDEF = 7
public constant R_DESCRIPTION = 8
public constant R_AM = 9
public constant R_SETTINGS = 10
public constant R_DATABASE = 11
public constant R_TABLES = 12
public constant R_INDEXES = 13
public constant R_VIEWS = 14
public constant R_STAT_ARCHIVER = 15
public constant R_STAT_BGWRITER = 16
public constant R_STAT_DATABASE = 17
public constant R_STAT_DB_CONFLICTS = 18
public constant R_STAT_USER_TABLES = 19
public constant R_STATIO_USER_TABLES = 20
public constant R_STAT_USER_INDEXES = 21
public constant R_STATIO_USER_INDEXES = 22
public constant R_ROLES = 23
public constant R_USER = 24
public constant R_PROC = 25
public constant R_INHERITS = 26
public constant R_TRIGGER = 27
public constant R_SEQUENCE = 28
public constant R_COLLATION = 29
public constant R_TABLESPACE = 30
public constant R_EXTENSION = 31
public constant R_ENUM = 32
public constant R_RANGE = 33
public constant R_STAT_ACTIVITY = 34
public constant R_IS_TABLES = 35
public constant R_IS_COLUMNS = 36
public constant R_IS_SCHEMATA = 37
public constant R_IS_KEY_COLUMN_USAGE = 38
public constant R_IS_TABLE_CONSTRAINTS = 39
public constant R_IS_REFERENTIAL_CONSTRAINTS = 40
public constant R_IS_VIEWS = 41
public constant R_LAST = 41

// ---------------------------------------------------------------- relation registry

public function relName(code: Integer): Text {
    if code == R_NAMESPACE { return "pg_namespace" }
    if code == R_CLASS { return "pg_class" }
    if code == R_ATTRIBUTE { return "pg_attribute" }
    if code == R_TYPE { return "pg_type" }
    if code == R_INDEX { return "pg_index" }
    if code == R_CONSTRAINT { return "pg_constraint" }
    if code == R_ATTRDEF { return "pg_attrdef" }
    if code == R_DESCRIPTION { return "pg_description" }
    if code == R_AM { return "pg_am" }
    if code == R_SETTINGS { return "pg_settings" }
    if code == R_DATABASE { return "pg_database" }
    if code == R_TABLES { return "pg_tables" }
    if code == R_INDEXES { return "pg_indexes" }
    if code == R_VIEWS { return "pg_views" }
    if code == R_STAT_ARCHIVER { return "pg_stat_archiver" }
    if code == R_STAT_BGWRITER { return "pg_stat_bgwriter" }
    if code == R_STAT_DATABASE { return "pg_stat_database" }
    if code == R_STAT_DB_CONFLICTS { return "pg_stat_database_conflicts" }
    if code == R_STAT_USER_TABLES { return "pg_stat_user_tables" }
    if code == R_STATIO_USER_TABLES { return "pg_statio_user_tables" }
    if code == R_STAT_USER_INDEXES { return "pg_stat_user_indexes" }
    if code == R_STATIO_USER_INDEXES { return "pg_statio_user_indexes" }
    if code == R_ROLES { return "pg_roles" }
    if code == R_USER { return "pg_user" }
    if code == R_PROC { return "pg_proc" }
    if code == R_INHERITS { return "pg_inherits" }
    if code == R_TRIGGER { return "pg_trigger" }
    if code == R_SEQUENCE { return "pg_sequence" }
    if code == R_COLLATION { return "pg_collation" }
    if code == R_TABLESPACE { return "pg_tablespace" }
    if code == R_EXTENSION { return "pg_extension" }
    if code == R_ENUM { return "pg_enum" }
    if code == R_RANGE { return "pg_range" }
    if code == R_STAT_ACTIVITY { return "pg_stat_activity" }
    if code == R_IS_TABLES { return "tables" }
    if code == R_IS_COLUMNS { return "columns" }
    if code == R_IS_SCHEMATA { return "schemata" }
    if code == R_IS_KEY_COLUMN_USAGE { return "key_column_usage" }
    if code == R_IS_TABLE_CONSTRAINTS { return "table_constraints" }
    if code == R_IS_REFERENTIAL_CONSTRAINTS { return "referential_constraints" }
    if code == R_IS_VIEWS { return "views" }
    return ""
}

public function relOidOf(code: Integer): Integer {
    if code == R_NAMESPACE { return 2615 }
    if code == R_CLASS { return 1259 }
    if code == R_ATTRIBUTE { return 1249 }
    if code == R_TYPE { return 1247 }
    if code == R_INDEX { return 2610 }
    if code == R_CONSTRAINT { return 2606 }
    if code == R_ATTRDEF { return 2604 }
    if code == R_DESCRIPTION { return 2609 }
    if code == R_AM { return 2601 }
    if code == R_SETTINGS { return 12104 }
    if code == R_DATABASE { return 1262 }
    if code == R_TABLES { return 12033 }
    if code == R_INDEXES { return 12043 }
    if code == R_VIEWS { return 12028 }
    if code == R_STAT_ARCHIVER { return 12285 }
    if code == R_STAT_BGWRITER { return 12289 }
    if code == R_STAT_DATABASE { return 12266 }
    if code == R_STAT_DB_CONFLICTS { return 12271 }
    if code == R_STAT_USER_TABLES { return 12161 }
    if code == R_STATIO_USER_TABLES { return 12179 }
    if code == R_STAT_USER_INDEXES { return 12192 }
    if code == R_STATIO_USER_INDEXES { return 12205 }
    if code == R_ROLES { return 12000 }
    if code == R_USER { return 12014 }
    if code == R_PROC { return 1255 }
    if code == R_INHERITS { return 2611 }
    if code == R_TRIGGER { return 2620 }
    if code == R_SEQUENCE { return 2224 }
    if code == R_COLLATION { return 3456 }
    if code == R_TABLESPACE { return 1213 }
    if code == R_EXTENSION { return 3079 }
    if code == R_ENUM { return 3501 }
    if code == R_RANGE { return 3541 }
    if code == R_STAT_ACTIVITY { return 12222 }
    return 13300 + code
}

public function relSchemaOid(code: Integer): Integer {
    if code >= R_IS_TABLES { return NS_INFO }
    return NS_CATALOG
}

// 'r' for catalog tables, 'v' for the system views.
public function relKindOf(code: Integer): Integer {
    if code == R_SETTINGS || code == R_TABLES || code == R_INDEXES || code == R_VIEWS || code == R_ROLES || code == R_USER || code == R_STAT_ACTIVITY { return 118 }
    if code >= R_STAT_ARCHIVER && code <= R_STATIO_USER_INDEXES { return 118 }
    if code >= R_IS_TABLES { return 118 }
    return 114
}

// Catalog relation for (schema, name), or 0. Unqualified names resolve in pg_catalog only (callers try user
// tables first, as PG's search path puts pg_catalog first but neo-db users cannot create pg_* tables anyway).
public function lookup(schema: Text, name: Text): Integer {
    if schema != "" && schema != "pg_catalog" && schema != "information_schema" { return 0 }
    let code = 1
    while code <= R_LAST {
        if relName(code) == name {
            let isInfo = code >= R_IS_TABLES
            if schema == "information_schema" && isInfo { return code }
            if schema != "information_schema" && !isInfo { return code }
        }
        code += 1
    }
    return 0
}

