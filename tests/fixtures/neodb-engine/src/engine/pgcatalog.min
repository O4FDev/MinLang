    if code == R_CLASS {
        return "oid oid;relname name;relnamespace oid;reltype oid;reloftype oid;relowner oid;relam oid;relfilenode oid;reltablespace oid;relpages int4;reltuples float4;relallvisible int4;reltoastrelid oid;relhasindex bool;relisshared bool;relpersistence char;relkind char;relnatts int2;relchecks int2;relhasrules bool;relhastriggers bool;relhassubclass bool;relrowsecurity bool;relforcerowsecurity bool;relispopulated bool;relreplident char;relispartition bool;relrewrite oid;relfrozenxid xid;relminmxid xid;relacl aclitem[];reloptions text[];relpartbound pg_node_tree"
