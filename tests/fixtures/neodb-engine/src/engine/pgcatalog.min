    }
    if code == R_INDEX {
        return "indexrelid oid;indrelid oid;indnatts int2;indnkeyatts int2;indisunique bool;indnullsnotdistinct bool;indisprimary bool;indisexclusion bool;indimmediate bool;indisclustered bool;indisvalid bool;indcheckxmin bool;indisready bool;indislive bool;indisreplident bool;indkey int2vector;indcollation oidvector;indclass oidvector;indoption int2vector;indexprs pg_node_tree;indpred pg_node_tree"
