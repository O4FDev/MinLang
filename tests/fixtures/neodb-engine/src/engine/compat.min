// Canned answers for client catalog probes (pgbench, psql, drivers). Kept in one file so they are easy to audit.
use "./values.min" as v

public constant PROBE_NONE = 0
public constant PROBE_PGBENCH_PARTITION = 1   // pgbench -i/run: partition probe on pgbench_accounts
public constant PROBE_RELKIND = 2             // pgbench 17: select relkind from pg_class where oid = 'x'::regclass
public constant PROBE_EMPTY = 3               // other pg_catalog probes: empty result

public function contains(hay: Bytes, needle: Text): Boolean {
    return indexOf(hay, Bytes(needle), 0) >= 0
}

public function indexOf(hay: Bytes, nb: Bytes, from: Integer): Integer {
    let n = hay.length
    let m = nb.length
    if m == 0 { return from }
    let first = nb[0]
    let i = from
    while i + m <= n {
        if hay[i] == first && v.equalBytes(hay, i, m, nb, 0, m) { return i }
        i += 1
    }
    return -1
}

public function classify(sql: Bytes): Integer {
    if sql.length < 20 { return PROBE_NONE }
    if !contains(sql, "pg_catalog.") { return PROBE_NONE }
    if contains(sql, "partstrat") { return PROBE_PGBENCH_PARTITION }
    // relkind / regclass probes are answered by the real pg_catalog (src/engine/pgcatalog.min)
    return PROBE_NONE
}

// Quoted name inside the probe ('pgbench_accounts'): the first single-quoted string.
public function firstQuoted(sql: Bytes): Text {
    let a = indexOf(sql, Bytes("'"), 0)
    if a < 0 { return "" }
    let b = indexOf(sql, Bytes("'"), a + 1)
    if b < 0 { return "" }
    return Text(sql.slice(a + 1, b))
}
