// Catalog: tables (id = position, never reused), indexes, views, and the DDL history used by snapshots.
use "./values.min" as v
use "./table.min" as tb
use "./index.min" as ix
use "../search/index.min" as si
use "./ext.min" as ext
use "neodb-sdk" as sdk

public record Catalog {
    tables: List<tb.Table>
    hashIdx: List<ix.HashIndex>
    ordIdx: List<ix.OrdIndex>
    annIdx: List<AnnIndex>
    annFailure: sdk.IndexFailure   // a row an extension index refused (raised at the end of the statement)
    viewNames: List<Text>
    viewSql: List<Text>
    ddlLog: List<Text>       // replayable DDL in order (snapshot catalog)
    version: Integer         // bumped on every DDL: invalidates cached plans
    nextOid: Integer
    fks: List<ForeignKey>    // foreign keys (position = identity, dropped ones stay as tombstones); rebuilt by DDL replay
    conNames: List<Text>     // index names that back a PRIMARY KEY / UNIQUE constraint (pg_constraint rows)
    nLiveFks: Integer        // foreign keys not dropped: 0 keeps the DML paths free of FK work
    searchIdx: List<si.Index>      // full-text search indexes (tables refer to them by position: tb.Table.searchIds)
    extensions: List<Integer>      // installed extensions (positions in ext.min's registry), in install order
    extensionVersions: List<Text>  // their installed versions
}

// An index of an extension's access method (CREATE INDEX ... USING hnsw (embedding vector_l2_ops)): an
// in-memory structure inside the extension (handle), fed one column's stored values by row id; rebuilt when the
// table loads like every other index.
public record AnnIndex {
    id: Integer
    tableId: Integer          // -1 once dropped
    name: Text
    col: Integer
    method: Integer           // ext.method position
    opclass: Integer          // position in the method's operator classes
    operator: Text            // the operator the index orders by (<->)
    options: sdk.IndexOptions // as created, to rebuild
    handle: Integer
}

// FOREIGN KEY (childCols) REFERENCES parent (parentCols). Enforced at statement end (src/engine/fk.min).
public record ForeignKey {
    name: Text
    childId: Integer
    childCols: List<Integer>
    parentId: Integer
    parentCols: List<Integer>
    parentIdx: Integer       // unique hash index on the parent covering exactly parentCols
    keyMap: List<Integer>    // per parent index column j: position i in childCols/parentCols
    onDelete: Integer        // ast.FK_* action codes
    onUpdate: Integer
    deferrable: Boolean
    deferred: Boolean
    dropped: Boolean
    probe: ix.Key            // reusable probe key for the parent index (child -> parent checks)
}

public function newCatalog(): Catalog {
    return Catalog { tables: []; hashIdx: []; ordIdx: []; annIdx: []; annFailure: sdk.newIndexFailure(); viewNames: []; viewSql: []; ddlLog: []; version: 1; nextOid: 16384
                     fks: []; conNames: []; nLiveFks: 0; searchIdx: []
                     extensions: []; extensionVersions: [] }
}

public function addForeignKey(c: Catalog, fk: ForeignKey) {
    c.fks.add(fk)
    c.nLiveFks += 1
    c.version += 1
}

public function dropForeignKey(c: Catalog, i: Integer) {
    if c.fks[i].dropped { return }
    c.fks[i].dropped = true
    c.nLiveFks -= 1
    c.version += 1
}

public function findTable(c: Catalog, name: Text): Integer {
    let i = 0
    let n = c.tables.length
    while i < n {
        let t = c.tables[i]
        if t.name == name && t.cols.length >= 0 && !isDropped(t) { return i }
        i += 1
    }
    return -1
}

public function isDropped(t: tb.Table): Boolean {
    return t.name == ""
}

public function findView(c: Catalog, name: Text): Integer {
    let i = 0
    while i < c.viewNames.length {
        if c.viewNames[i] == name { return i }
        i += 1
    }
    return -1
}

public function createTable(c: Catalog, name: Text): tb.Table {
    let t = tb.newTable(c.tables.length, name)
    c.tables.add(t)
    c.version += 1
    return t
}

public function dropTable(c: Catalog, id: Integer) {
    // foreign keys from or to a dropped table go with it
    let fi = 0
    while fi < c.fks.length {
        if !c.fks[fi].dropped && (c.fks[fi].childId == id || c.fks[fi].parentId == id) { dropForeignKey(c, fi) }
        fi += 1
    }
    let t = c.tables[id]
    // detach indexes
    for hid in t.hashIds {
        c.hashIdx[hid].tableId = -1
        c.hashIdx[hid].name = ""
    }
    for oid in t.ordIds {
        c.ordIdx[oid].tableId = -1
        c.ordIdx[oid].name = ""
    }
    for aid in t.annIds { dropAnn(c, aid) }
    let dead = tb.newTable(id, "")
    c.tables[id] = dead
    c.version += 1
}

public function indexNameExists(c: Catalog, name: Text): Boolean {
    if findSearchIndexNamed(c, name) >= 0 { return true }
    for h in c.hashIdx {
        if h.name == name { return true }
    }
    for o in c.ordIdx {
        if o.name == name { return true }
    }
    for x in c.annIdx {
        if x.name == name { return true }
    }
    return false
}

// An index dropped inside an open transaction block keeps existing under this name prefix until COMMIT.
public constant DROPPED_INDEX = "pg_neo_dropped_index_"

public function isDroppedIndexName(name: Text): Boolean {
    let p = Bytes(DROPPED_INDEX)
    let b = Bytes(name)
    if b.length < p.length { return false }
    let i = 0
    while i < p.length {
        if b[i] != p[i] { return false }
        i += 1
    }
    return true
}

// ---------------------------------------------------------------- extension (ANN) indexes

// Create extension index `name` of method m on column col and fill it from the table's live rows. Returns its
// id, or -1 with the method's error in options.
public function addAnnIndex(c: Catalog, t: tb.Table, name: Text, col: Integer, m: Integer, opclass: Integer, options: sdk.IndexOptions, handle: Integer): Integer {
    let def = ext.method(m)
    let h = handle
    if h < 0 { h = def.create(options) }
    if options.failed { return -1 }
    let x = AnnIndex { id: c.annIdx.length; tableId: t.id; name: name; col: col; method: m; opclass: opclass
                       operator: def.opclasses[opclass].operator; options: options; handle: h }
    c.annIdx.add(x)
    t.annIds.add(x.id)
    if !fillAnn(c, t, x) {
        // a row the method refuses: no index
        options.fail(c.annFailure.code, c.annFailure.message)
        takeAnnFailure(c)
        dropAnn(c, x.id)
        let kept: List<Integer> = []
        for aid in t.annIds {
            if aid != x.id { kept.add(aid) }
        }
        t.annIds = kept
        return -1
    }
    c.version += 1
    return x.id
}

// Index every live row, and rows open transactions hold (as the core indexes do); false when a row is refused.
function fillAnn(c: Catalog, t: tb.Table, x: AnnIndex): Boolean {
    let r = 0
    while r < t.nrows {
        let st = t.state[r]
        if st == 0 || (st & tb.ST_LOCKED) != 0 {
            annInsert(c, t, x, r)
            if c.annFailure.failed { return false }
        }
        r += 1
    }
    ext.method(x.method).built(x.handle)
    return true
}

function annInsert(c: Catalog, t: tb.Table, x: AnnIndex, r: Integer) {
    let col = t.cols[x.col]
    if tb.isNull(col, r) { return }
    ext.method(x.method).insert(x.handle, r, col.heap, tb.textOff(col, r), tb.textLen(col, r), c.annFailure)
}

// The row refusal of the running statement, cleared; failed is false when there is none.
public function takeAnnFailure(c: Catalog): sdk.IndexFailure {
    let f = c.annFailure
    c.annFailure = sdk.newIndexFailure()
    return f
}

public function dropAnn(c: Catalog, aid: Integer) {
    let x = c.annIdx[aid]
    if x.tableId < 0 { return }
    ext.method(x.method).drop(x.handle)
    x.tableId = -1
    x.name = ""
    c.version += 1
}

// Rebuild an extension index from scratch (the table's rows were reloaded or renumbered).
function rebuildAnn(c: Catalog, t: tb.Table, x: AnnIndex) {
    let def = ext.method(x.method)
    def.drop(x.handle)
    x.handle = def.create(x.options)
    // rows were accepted when they were stored: a refusal here cannot happen, and is dropped if it does
    fillAnn(c, t, x)
    takeAnnFailure(c)
}

// The live extension index on column col of t whose operator class orders by `operator`, or -1.
public function findAnnIndexOn(c: Catalog, t: tb.Table, col: Integer, operator: Text): Integer {
    for aid in t.annIds {
        let x = c.annIdx[aid]
        // an index dropped in an open transaction block is hidden under DROPPED_INDEX + N: not used; an
        // expression index matches by its expression (the same expression can have several hidden columns while a
        // block drops and re-creates an index)
        let same = x.col == col
        if !same && x.col < t.cols.length && tb.isGenerated(t.cols[col]) { same = t.cols[x.col].generated == t.cols[col].generated }
        if x.tableId >= 0 && same && x.operator == operator && !isDroppedIndexName(x.name) { return aid }
    }
    return -1
}

// Create the index structures for a table. kind: 0 auto (hash + ordered for a single-column key),
// 1 hash only, 2 ordered only. Returns false if a unique index finds duplicates.
public function addIndex(c: Catalog, t: tb.Table, name: Text, cols: List<Integer>, unique: Boolean, primary: Boolean, wantHash: Boolean, wantOrd: Boolean): Boolean {
    if wantHash {
        let h = ix.newHashIndex(c.hashIdx.length, t.id, name, cols, unique, t.nrows)
        h.primary = primary
        let chk = ix.hashBuildCheck(h, t)
        if unique && (chk == 1 || (chk == 2 && hasDuplicates(t, h))) { return false }
        c.hashIdx.add(h)
        t.hashIds.add(h.id)
    }
    if wantOrd {
        let o = ix.newOrdIndex(c.ordIdx.length, t.id, name, cols, unique)
        ix.ordBuild(o, t)
        if unique && !wantHash && ordHasDuplicates(t, o) { return false }
        c.ordIdx.add(o)
        t.ordIds.add(o.id)
    }
    if primary {
        t.pkCols = cols
        for ci in cols { t.cols[ci].notNull = true }
    }
    c.version += 1
    return true
}

function hasDuplicates(t: tb.Table, h: ix.HashIndex): Boolean {
    let r = 0
    while r < t.nrows {
        if t.state[r] == 0 && !ix.rowHasNullKey(t, h.cols, r) {
            let hv = ix.hashRow(t, h.cols, r)
            let s = ix.probeNext(h, hv, ix.probeStart(h, hv))
            while s >= 0 {
                let o = ix.slotRow(h, s)
                if o != r && t.state[o] == 0 && ix.rowsEqual(t, h.cols, r, o) { return true }
                s = ix.probeNext(h, hv, s + 1)
            }
        }
        r += 1
    }
    return false
}

function ordHasDuplicates(t: tb.Table, o: ix.OrdIndex): Boolean {
    let prev = -1
    for c in o.chunks {
        let i = 0
        while i < c.length / 8 {
            let b = c.getInt64(i * 8)
            if prev >= 0 && t.state[prev] == 0 && t.state[b] == 0 && ix.rowsEqual(t, o.cols, prev, b) { return true }
            prev = b
            i += 1
        }
    }
    return false
}

public function rebuildAnnIndexes(c: Catalog, t: tb.Table) {
    for aid in t.annIds {
        if c.annIdx[aid].tableId >= 0 { rebuildAnn(c, t, c.annIdx[aid]) }
    }
}

public function rebuildIndexes(c: Catalog, t: tb.Table) {
    for hid in t.hashIds { ix.hashBuild(c.hashIdx[hid], t) }
    for oid in t.ordIds { ix.ordBuild(c.ordIdx[oid], t) }
    for sid in t.searchIds { si.build(c.searchIdx[sid], t) }
    for aid in t.annIds {
        if c.annIdx[aid].tableId >= 0 { rebuildAnn(c, t, c.annIdx[aid]) }
    }
}

// ---- full-text search indexes (src/search/index.min)

public function buildSearchIndexes(c: Catalog, t: tb.Table) {
    for sid in t.searchIds { si.build(c.searchIdx[sid], t) }
}

// WAL replay (recovery, replica promotion): row r of t is about to change / has changed. Search indexes loaded from
// the checkpoint image are maintained here, so they need no rebuild; hash and ordered indexes are rebuilt after replay.
public function searchRowChanging(c: Catalog, t: tb.Table, r: Integer) {
    for sid in t.searchIds { si.touchRow(c.searchIdx[sid], t, r) }
}

public function searchRowChanged(c: Catalog, t: tb.Table, r: Integer) {
    for sid in t.searchIds { si.insertRow(c.searchIdx[sid], t, r) }
}

public function searchTruncated(c: Catalog, t: tb.Table) {
    for sid in t.searchIds { si.invalidate(c.searchIdx[sid]) }
}

// After replay: hash, ordered and extension indexes are rebuilt from the rows; search indexes were maintained (built here only
// if they never were, e.g. not in the image).
public function rebuildAfterReplay(c: Catalog, t: tb.Table) {
    for hid in t.hashIds { ix.hashBuild(c.hashIdx[hid], t) }
    for oid in t.ordIds { ix.ordBuild(c.ordIdx[oid], t) }
    for sid in t.searchIds {
        if !c.searchIdx[sid].built { si.build(c.searchIdx[sid], t) }
    }
    rebuildAnnIndexes(c, t)   // extension (hnsw, ivfflat) indexes have no image: rebuilt from the rows
}

public function addSearchIndex(c: Catalog, t: tb.Table, name: Text, col: Integer, stemmer: Integer): Integer {
    let id = c.searchIdx.length
    let x = si.newIndex(id, t.id, col, name, stemmer)
    c.searchIdx.add(x)
    t.searchIds.add(id)
    if t.chunk < 0 { si.build(x, t) }
    c.version += 1
    return id
}

// Registry id of the search index named `name` on a live table, or -1.
public function findSearchIndexNamed(c: Catalog, name: Text): Integer {
    for t in c.tables {
        for sid in t.searchIds {
            if c.searchIdx[sid].name == name { return sid }
        }
    }
    return -1
}

// Search index on column col of t, or -1.
public function findSearchIndexOn(c: Catalog, t: tb.Table, col: Integer): Integer {
    for sid in t.searchIds {
        if c.searchIdx[sid].column == col { return sid }
    }
    return -1
}

public function dropSearchIndexNamed(c: Catalog, name: Text): Boolean {
    let found = false
    for t in c.tables {
        let keep: List<Integer> = []
        for sid in t.searchIds {
            if c.searchIdx[sid].name == name {
                found = true
                let dropped = c.searchIdx[sid]
                dropped.name = ""
            } else {
                keep.add(sid)
            }
        }
        t.searchIds = keep
    }
    if found { c.version += 1 }
    return found
}

// Does any index of t involve column ci?
public function columnIndexed(c: Catalog, t: tb.Table, ci: Integer): Boolean {
    for hid in t.hashIds {
        for k in c.hashIdx[hid].cols {
            if k == ci { return true }
        }
    }
    for oid in t.ordIds {
        for k in c.ordIdx[oid].cols {
            if k == ci { return true }
        }
    }
    for sid in t.searchIds {
        if c.searchIdx[sid].column == ci { return true }
    }
    for aid in t.annIds {
        if c.annIdx[aid].tableId >= 0 && c.annIdx[aid].col == ci { return true }
    }
    return false
}

public function indexRemoveRow(c: Catalog, t: tb.Table, r: Integer) {
    for hid in t.hashIds {
        let h = c.hashIdx[hid]
        ix.hashRemove(h, ix.hashRow(t, h.cols, r), r)
    }
    for oid in t.ordIds { ix.ordRemove(c.ordIdx[oid], t, r) }
    for sid in t.searchIds { si.touchRow(c.searchIdx[sid], t, r) }
    for aid in t.annIds {
        let x = c.annIdx[aid]
        if x.tableId >= 0 { ext.method(x.method).remove(x.handle, r) }
    }
}

public function indexInsertRow(c: Catalog, t: tb.Table, r: Integer) {
    for hid in t.hashIds {
        let h = c.hashIdx[hid]
        ix.hashInsert(h, t, ix.hashRow(t, h.cols, r), r)
    }
    for oid in t.ordIds { ix.ordInsert(c.ordIdx[oid], t, r) }
    for sid in t.searchIds { si.insertRow(c.searchIdx[sid], t, r) }
    for aid in t.annIds {
        if c.annIdx[aid].tableId >= 0 { annInsert(c, t, c.annIdx[aid], r) }
    }
}

// Find a hash index whose columns are exactly `cols` (any order), or -1.
public function findHashIndexOn(c: Catalog, t: tb.Table, col: Integer): Integer {
    for hid in t.hashIds {
        let h = c.hashIdx[hid]
        if h.cols.length == 1 && h.cols[0] == col { return hid }
    }
    return -1
}

public function findOrdIndexOn(c: Catalog, t: tb.Table, col: Integer): Integer {
    for oid in t.ordIds {
        let o = c.ordIdx[oid]
        if o.cols.length >= 1 && o.cols[0] == col { return oid }
    }
    return -1
}
