// Planner: AST -> Stmt (a Plan plus statement metadata). Name resolution, PG typing rules, access paths,
// join ordering (index nested loop / hash join / nested loop), aggregation, sort, limit, set operations.
use "../sql/ast.min" as ast
use "./values.min" as v
use "./table.min" as tb
use "./index.min" as ix
use "./catalog.min" as cat
use "./exec.min" as ex
use "./pgcatalog.min" as pgc

public constant SK_SELECT = 1
public constant SK_INSERT = 2
public constant SK_UPDATE = 3
public constant SK_DELETE = 4
public constant SK_UTILITY = 5

public record Stmt {
    kind: Integer
    p: ex.Plan
    root: Integer
    outExprs: List<Integer>
    outNames: List<Text>
    outTypes: List<Integer>
    outMods: List<Integer>
    tableId: Integer
    slot: Integer
    rowExprs: List<Integer>
    nRows: Integer
    srcExprs: List<Integer>
    setCols: List<Integer>
    setExprs: List<Integer>
    conflict: Integer
    returning: Boolean
    paramNodes: List<Integer>
    paramIdx: List<Integer>
    paramTypes: List<Integer>
    litNodes: List<Integer>
    litPos: List<Integer>
    pinPos: List<Integer>
    pinText: List<Text>
    tree: ast.Ast
    astRoot: Integer
    catVersion: Integer
    err: Boolean
    errCode: Text
    errMsg: Text
    errPos: Integer
    sql: Text
    sqlBytes: Bytes
    serialNodes: List<Integer>
    tableIds: List<Integer>
    constChecks: List<Integer>
    route: List<Route>         // partition routing / constraint checks
    routeIdx: Integer          // route of the current DML target, -1 for none
    fromBuf: Integer           // UPDATE ... FROM: temp holding SET values per target row, -1 otherwise
    // UPDATE / DELETE over a partitioned table: one target per leaf partition (empty otherwise)
    mtTid: List<Integer>
    mtSlot: List<Integer>
    mtRoot: List<Integer>
    mtSetCols: List<List<Integer>>
    mtSetExprs: List<List<Integer>>
    mtOut: List<List<Integer>>
    mtRoute: List<Integer>
    mtFromBuf: List<Integer>
    // INSERT ... ON CONFLICT DO UPDATE (conflict = 2): arbiter hash index, excluded row buffer, update filter
    conflictHid: Integer
    exclTemp: Integer
    exclSlot: Integer
    conflictWhere: Integer
}

record Range {
    name: Text
    slot: Integer
    level: Integer
    tableId: Integer
    cols: List<Text>
    types: List<Integer>
    mods: List<Integer>
    hidden: List<Boolean>
}

record PC {
    p: ex.Plan
    st: Stmt
    a: ast.Ast
    c: cat.Catalog
    ranges: List<Range>
    rCount: Integer
    level: Integer
    minRef: Integer
    // aggregation (current level)
    aggActive: Boolean
    aggLevel: Integer
    aggSlot: Integer
    groupAst: List<Integer>
    groupNodes: List<Integer>
    aggAst: List<Integer>
    collecting: Boolean
    // CTEs
    cteName: List<Text>
    cteAst: List<Integer>
    cteCount: Integer
    err: Boolean
    errCode: Text
    errMsg: Text
    errPos: Integer
    // target aliases (for GROUP BY / ORDER BY resolution)
    tgtNames: List<Text>
    tgtAst: List<Integer>
    slotLevel: List<Integer>
    views: ViewCache
    noTrack: Boolean
    suppressConst: Integer
    // partitions: DML target override (a leaf of the statement's partitioned target) and routing root
    targetOverride: Integer
    targetAlias: Text
    routeRoot: Integer
    // compat agent: set-returning function in the select list, window functions (current SELECT level)
    srfAst: Integer
    srfSlot: Integer
    srfKind: Integer
    winSlot: Integer
    winTable: tb.Table
    winEval: List<Integer>      // (expr, column) pairs evaluated per row after capture
    winSpec: List<Integer>      // per call: nPart, nOrd, kind, resultCol, (col, desc, nullsFirst) * (nPart + nOrd)
}

public function newStmt(tree: ast.Ast, root: Integer, p: ex.Plan, sql: Text): Stmt {
    return Stmt {
        kind: 0; p: p; root: -1; outExprs: []; outNames: []; outTypes: []; outMods: []
        tableId: -1; slot: -1; rowExprs: []; nRows: 0; srcExprs: []; setCols: []; setExprs: []; conflict: 0; returning: false
        paramNodes: []; paramIdx: []; paramTypes: []; litNodes: []; litPos: []; pinPos: []; pinText: []
        tree: tree; astRoot: root; catVersion: 0; err: false; errCode: ""; errMsg: ""; errPos: 0; sql: sql; sqlBytes: Bytes(); serialNodes: []; tableIds: []; constChecks: []
        route: []; routeIdx: -1; fromBuf: -1; mtTid: []; mtSlot: []; mtRoot: []; mtSetCols: []; mtSetExprs: []; mtOut: []; mtRoute: []; mtFromBuf: []
        conflictHid: -1; exclTemp: -1; exclSlot: -1; conflictWhere: -1
    }
}

function perr(pc: PC, code: Text, msg: Text, pos: Integer) {
    if pc.err { return }
    pc.err = true
    pc.errCode = code
    pc.errMsg = msg
    pc.errPos = pos
}

function posOf(pc: PC, id: Integer): Integer {
    if id < 0 { return -1 }
    return pc.a.nodes[id].position
}

// ---------------------------------------------------------------- entry

public function planStatement(c: cat.Catalog, views: ViewCache, env: ex.Env, tree: ast.Ast, root: Integer, sql: Text, paramTypes: List<Integer>): Stmt {
    return planStatementOver(c, views, env, tree, root, sql, paramTypes, -1, "", -1)
}

// planStatement with the DML target replaced by table `override` (named `alias` in the query), routing rows
// relative to partitioned table `routeRoot`.
function planStatementOver(c: cat.Catalog, views: ViewCache, env: ex.Env, tree: ast.Ast, root: Integer, sql: Text,
                           paramTypes: List<Integer>, override: Integer, alias: Text, routeRoot: Integer): Stmt {
    let p = ex.newPlan(env)
    let st = newStmt(tree, root, p, sql)
    st.catVersion = c.version
    for t in paramTypes { st.paramTypes.add(t) }
    let pc = PC {
        p: p; st: st; a: tree; c: c; ranges: []; rCount: 0; level: 0; minRef: 1000000
        aggActive: false; aggLevel: -1; aggSlot: -1; groupAst: []; groupNodes: []; aggAst: []; collecting: false
        cteName: []; cteAst: []; cteCount: 0; err: false; errCode: ""; errMsg: ""; errPos: -1
        tgtNames: []; tgtAst: []; slotLevel: []; views: views; noTrack: false; suppressConst: 0
        targetOverride: override; targetAlias: alias; routeRoot: routeRoot
        srfAst: -1; srfSlot: -1; srfKind: 0; winSlot: -1; winTable: tb.newTable(-1, ""); winEval: []; winSpec: []
    }
    let k = ast.kind(tree, root)
    if ast.isQuery(tree, root) {
        st.kind = SK_SELECT
        let q = compileQuery(pc, root)
        if !pc.err {
            let i = 0
            while i < q.exprs.length {
                if p.et[q.exprs[i]] == v.T_UNKNOWN {
                    q.exprs[i] = coerce(pc, q.exprs[i], v.T_TEXT, -1, false)
                    q.types[i] = v.T_TEXT
                }
                i += 1
            }
            st.root = q.root
            st.outExprs = q.exprs
            st.outNames = q.names
            st.outTypes = q.types
            st.outMods = q.mods
        }
    } else if k == ast.K_INSERT {
        st.kind = SK_INSERT
        compileInsert(pc, root)
    } else if k == ast.K_UPDATE {
        st.kind = SK_UPDATE
        compileUpdate(pc, root)
    } else if k == ast.K_DELETE {
        st.kind = SK_DELETE
        compileDelete(pc, root)
    } else {
        st.kind = SK_UTILITY
    }
    // unresolved parameter types default to text
    let i = 0
    while i < st.paramTypes.length {
        if st.paramTypes[i] == v.T_UNKNOWN { st.paramTypes[i] = v.T_TEXT }
        i += 1
    }
    i = 0
    while i < st.paramNodes.length {
        let n = st.paramNodes[i]
        if p.et[n] == v.T_UNKNOWN { p.et[n] = st.paramTypes[st.paramIdx[i]] }
        i += 1
    }
    ex.computeConst(p)
    if pc.err {
        st.err = true
        st.errCode = pc.errCode
        st.errMsg = pc.errMsg
        st.errPos = pc.errPos
    }
    return st
}

// ---------------------------------------------------------------- temp tables

// Temp tables live in the catalog as "pg_temp_<session>.<name>" and shadow permanent tables of that name.
public function tempName(session: Integer, name: Text): Text {
    return "pg_temp_" + Text(session) + "." + name
}

public function isTempName(name: Text): Boolean {
    return name.length > 8 && name.slice(0, 8) == "pg_temp_"
}

// Table id for a relation name as the session sees it (its temp table first), or -1.
public function findRel(c: cat.Catalog, env: ex.Env, name: Text): Integer {
    if env.tempCount > 0 {
        let t = cat.findTable(c, tempName(env.session, name))
        if t >= 0 { return t }
    }
    return cat.findTable(c, name)
}

// ---------------------------------------------------------------- types

public function typeFromName(name: Text): Integer {
    if name == "int4" || name == "int" || name == "integer" || name == "serial" { return v.T_INT4 }
    if name == "int8" || name == "bigint" || name == "bigserial" { return v.T_INT8 }
    if name == "int2" || name == "smallint" || name == "smallserial" { return v.T_INT2 }
    if name == "float8" || name == "double" { return v.T_FLOAT8 }
    if name == "float4" || name == "real" { return v.T_FLOAT4 }
    if name == "numeric" || name == "decimal" { return v.T_NUMERIC }
    if name == "bool" || name == "boolean" { return v.T_BOOL }
    if name == "text" { return v.T_TEXT }
    if name == "varchar" { return v.T_VARCHAR }
    if name == "bpchar" || name == "char" { return v.T_BPCHAR }
    if name == "date" { return v.T_DATE }
    if name == "timestamp" { return v.T_TIMESTAMP }
    if name == "timestamptz" { return v.T_TIMESTAMPTZ }
    if name == "interval" { return v.T_INTERVAL }
    if name == "bytea" { return v.T_BYTEA }
    if name == "name" { return v.T_NAME }
    if name == "time" { return v.T_TIME }
    if name == "oid" { return v.T_OID }
    if name == "regclass" { return v.T_REGCLASS }
    if name == "json" || name == "jsonb" || name == "uuid" || name == "xml" || name == "citext" { return v.T_TEXT }
    return -1
}

// Type of a K_TYPENAME node; fills typmod into pc via return pair (type, typmod) encoded: type + typmod * 256
function typeOfTypename(pc: PC, tn: Integer): Integer {
    let name = ast.text(pc.a, tn)
    let t = typeFromName(name)
    if t < 0 {
        perr(pc, "42704", "type \"" + name + "\" does not exist", posOf(pc, tn))
        return v.T_TEXT
    }
    return t
}

function typmodOfTypename(pc: PC, tn: Integer): Integer {
    let name = ast.text(pc.a, tn)
    let mods = ast.items(pc.a, ast.child(pc.a, tn, 0))
    let t = typeFromName(name)
    if t == v.T_VARCHAR || t == v.T_BPCHAR {
        if mods.length >= 1 {
            pin(pc, mods[0])
            return pc.a.nodes[mods[0]].intValue
        }
        if t == v.T_BPCHAR { return 1 }
        return -1
    }
    if t == v.T_NUMERIC {
        if mods.length >= 1 {
            pin(pc, mods[0])
            let prec = pc.a.nodes[mods[0]].intValue
            let scale = 0
            if mods.length >= 2 {
                pin(pc, mods[1])
                scale = pc.a.nodes[mods[1]].intValue
            }
            return prec * 65536 + (scale & 65535)
        }
        return -1
    }
    let i = 0
    while i < mods.length {
        pin(pc, mods[i])
        i += 1
    }
    return -1
}

function pin(pc: PC, id: Integer) {
    if pc.noTrack { return }
    let k = ast.kind(pc.a, id)
    if k == ast.K_INT_LIT || k == ast.K_NUM_LIT || k == ast.K_STR_LIT {
        pc.st.pinPos.add(pc.a.nodes[id].position)
        pc.st.pinText.add(pc.a.nodes[id].text)
    }
}

function numRank(t: Integer): Integer {
    if t == v.T_INT2 { return 1 }
    if t == v.T_INT4 { return 2 }
    if t == v.T_INT8 || t == v.T_OID { return 3 }
    if t == v.T_NUMERIC { return 4 }
    if t == v.T_FLOAT4 { return 5 }
    if t == v.T_FLOAT8 { return 6 }
    return 0
}

function rankType(r: Integer): Integer {
    if r == 1 { return v.T_INT2 }
    if r == 2 { return v.T_INT4 }
    if r == 3 { return v.T_INT8 }
    if r == 4 { return v.T_NUMERIC }
    if r == 5 { return v.T_FLOAT4 }
    return v.T_FLOAT8
}

// Common type of two types, or -1.
public function commonType(a: Integer, b: Integer): Integer {
    if a == b { return a }
    if a == v.T_UNKNOWN { return b }
    if b == v.T_UNKNOWN { return a }
    let ra = numRank(a)
    let rb = numRank(b)
    if ra > 0 && rb > 0 {
        let r = ra
        if rb > r { r = rb }
        return rankType(r)
    }
    // string category: text is preferred; otherwise the first type is kept (casts both ways are implicit)
    if v.isTextType(a) && v.isTextType(b) { return a }
    if (a == v.T_DATE && (b == v.T_TIMESTAMP || b == v.T_TIMESTAMPTZ)) { return b }
    if (b == v.T_DATE && (a == v.T_TIMESTAMP || a == v.T_TIMESTAMPTZ)) { return a }
    if (a == v.T_TIMESTAMP && b == v.T_TIMESTAMPTZ) || (b == v.T_TIMESTAMP && a == v.T_TIMESTAMPTZ) { return v.T_TIMESTAMPTZ }
    if (a == v.T_OID && b == v.T_REGCLASS) || (a == v.T_REGCLASS && b == v.T_OID) { return v.T_OID }
    return -1
}

// Coerce expression node to type (implicit or explicit). Returns the (possibly new) node.
function coerce(pc: PC, n: Integer, to: Integer, typmod: Integer, explicit: Boolean): Integer {
    if n < 0 { return n }
    let p = pc.p
    let from = p.et[n]
    if from == to && typmod < 0 { return n }
    if from == v.T_UNKNOWN {
        if to == v.T_UNKNOWN { return n }
        if p.ek[n] == ex.EX_CONST && p.rNull[n] != 0 {
            // typed NULL: a fresh node, so the same untyped NULL can take different types in different contexts
            return nullConst(pc, to)
        }
        if p.ek[n] == ex.EX_PARAM {
            // parameter of unresolved type: adopt the target type
            let idx = paramIndexOf(pc, n)
            if idx >= 0 && pc.st.paramTypes[idx] == v.T_UNKNOWN {
                pc.st.paramTypes[idx] = to
                p.et[n] = to
                if typmod >= 0 { return ex.addExpr(p, ex.EX_CAST, to, n, 0, typmod, 0) }
                return n
            }
        }
        let lc = ex.addExpr(p, ex.EX_LITCAST, to, n, 0, typmod, 0)
        if p.ek[n] == ex.EX_CONST { noteConst(pc, lc) }
        return lc
    }
    if isNullConst(pc, n) { return nullConst(pc, to) }
    // same class without typmod: no cast needed for ints/text family
    let fc = ex.classOf(from)
    let tc = ex.classOf(to)
    if typmod < 0 && fc == tc && fc == ex.CL_INT && v.isIntType(from) && v.isIntType(to) && numRank(from) <= numRank(to) { return n }
    if typmod < 0 && fc == tc && fc == ex.CL_TEXT && to != v.T_BPCHAR && from != v.T_BPCHAR { return n }
    let e = 0
    if explicit { e = 1 }
    return ex.addExpr(p, ex.EX_CAST, to, n, e, typmod, 0)
}

function paramIndexOf(pc: PC, n: Integer): Integer {
    let i = 0
    while i < pc.st.paramNodes.length {
        if pc.st.paramNodes[i] == n { return pc.st.paramIdx[i] }
        i += 1
    }
    return -1
}

function cmpClass(t: Integer): Integer {
    if t == v.T_BPCHAR { return ex.CL_BPCHAR }
    return ex.classOf(t)
}

// ---------------------------------------------------------------- ranges / name resolution

function pushRange(pc: PC, r: Range) {
    if pc.rCount < pc.ranges.length {
        pc.ranges[pc.rCount] = r
    } else {
        pc.ranges.add(r)
    }
    pc.rCount += 1
}

function newSlot(pc: PC, t: tb.Table): Integer {
    let s = ex.addSlot(pc.p, t)
    pc.slotLevel.add(pc.level)
    return s
}

// Resolve a column reference: returns node id (EX_COL) or -1 with error.
function resolveColumn(pc: PC, id: Integer): Integer {
    let name = ast.text(pc.a, id)
    let quals = ast.items(pc.a, id)
    let qual = ""
    if quals.length > 0 { qual = pc.a.nodes[quals[quals.length - 1]].text }
    let i = pc.rCount - 1
    let foundLevel = -1
    let foundR = -1
    let foundC = -1
    while i >= 0 {
        let r = pc.ranges[i]
        if foundLevel >= 0 && r.level != foundLevel { break }
        if qual == "" || r.name == qual {
            let j = 0
            while j < r.cols.length {
                if r.cols[j] == name && (qual != "" || !r.hidden[j]) {
                    if foundR >= 0 && foundR != i {
                        perr(pc, "42702", "column reference \"" + name + "\" is ambiguous", posOf(pc, id))
                        return -1
                    }
                    foundR = i
                    foundC = j
                    foundLevel = r.level
                }
                j += 1
            }
            if qual != "" && foundR < 0 && r.name == qual {
                // qualifier matched but no such column
                perr(pc, "42703", "column " + qual + "." + name + " does not exist", posOf(pc, id))
                return -1
            }
        }
        i -= 1
    }
    if foundR < 0 {
        if qual != "" {
            // whole-row or unknown table
            let known = false
            i = pc.rCount - 1
            while i >= 0 {
                if pc.ranges[i].name == qual { known = true }
                i -= 1
            }
            if !known {
                perr(pc, "42P01", "missing FROM-clause entry for table \"" + qual + "\"", posOf(pc, id))
                return -1
            }
        }
        perr(pc, "42703", "column \"" + name + "\" does not exist", posOf(pc, id))
        return -1
    }
    let r = pc.ranges[foundR]
    if r.level < pc.minRef { pc.minRef = r.level }
    if pc.aggActive && !pc.collecting && r.level == pc.aggLevel {
        // post-aggregation: a bare column must be a grouping expression (handled by caller); error here
        perr(pc, "42803", "column \"" + r.name + "." + name + "\" must appear in the GROUP BY clause or be used in an aggregate function", posOf(pc, id))
        return -1
    }
    return ex.addExpr(pc.p, ex.EX_COL, r.types[foundC], r.slot, foundC, 0, r.mods[foundC])
}

// ---------------------------------------------------------------- literals

// Postgres folds a strict operator/function with a NULL constant argument to NULL at plan time
// (eval_const_expressions), so the other operands are never evaluated (no overflow / division errors).
// Constant expression (evaluated by PG's planner): literals and arithmetic/casts/functions over them.
function isConstExpr(pc: PC, n: Integer): Boolean {
    if n < 0 { return false }
    let p = pc.p
    let k = p.ek[n]
    if k == ex.EX_CONST { return true }
    if k == ex.EX_ARITH { return isConstExpr(pc, p.ea[n]) && isConstExpr(pc, p.eb[n]) }
    if k == ex.EX_NEG || k == ex.EX_CAST || k == ex.EX_LITCAST { return isConstExpr(pc, p.ea[n]) }
    return false
}

// Fully constant expression of safe kinds (no columns, params, subqueries, volatile functions).
function isConstGeneral(pc: PC, n: Integer): Boolean {
    if n < 0 { return false }
    let p = pc.p
    let k = p.ek[n]
    if k == ex.EX_CONST { return true }
    if k == ex.EX_ARITH || k == ex.EX_CMP || k == ex.EX_AND || k == ex.EX_OR || k == ex.EX_CONCAT || k == ex.EX_DISTINCT {
        return isConstGeneral(pc, p.ea[n]) && isConstGeneral(pc, p.eb[n])
    }
    if k == ex.EX_NEG || k == ex.EX_CAST || k == ex.EX_LITCAST || k == ex.EX_NOT || k == ex.EX_ISNULL || k == ex.EX_ISBOOL {
        return isConstGeneral(pc, p.ea[n])
    }
    if k == ex.EX_LIKE {
        return isConstGeneral(pc, p.ea[n]) && isConstGeneral(pc, p.eb[n]) && (p.ed[n] < 0 || isConstGeneral(pc, p.ed[n]))
    }
    return false
}

// Evaluate a constant boolean at plan time: 1 true, 0 false or NULL, -1 not constant / error.
function constBool(pc: PC, n: Integer): Integer {
    if !isConstGeneral(pc, n) { return -1 }
    let p = pc.p
    ex.ev(p, n)
    if p.err {
        ex.clearError(p)
        return -1
    }
    if p.rNull[n] != 0 || p.rInt[n] == 0 { return 0 }
    return 1
}

function noteConst(pc: PC, n: Integer) {
    if n >= 0 && pc.suppressConst == 0 && isConstExpr(pc, n) { pc.st.constChecks.add(n) }
}

// 1 = constant TRUE, 0 = constant FALSE (not NULL), -1 otherwise. Only untracked constants (bool literals,
// folded NULLs/results) so cached plans stay valid when literals are re-bound.
function constBoolNode(pc: PC, n: Integer): Integer {
    let p = pc.p
    if n < 0 || p.ek[n] != ex.EX_CONST || p.rNull[n] != 0 || p.et[n] != v.T_BOOL { return -1 }
    if isTrackedLiteral(pc, n) { return -1 }
    if p.rInt[n] != 0 { return 1 }
    return 0
}

function isTrackedLiteral(pc: PC, n: Integer): Boolean {
    for x in pc.st.litNodes {
        if x == n { return true }
    }
    return false
}

function isNullConst(pc: PC, n: Integer): Boolean {
    return n >= 0 && pc.p.ek[n] == ex.EX_CONST && pc.p.rNull[n] != 0
}

function constNode(pc: PC, type: Integer): Integer {
    return ex.addExpr(pc.p, ex.EX_CONST, type, 0, 0, 0, 0)
}

function nullConst(pc: PC, type: Integer): Integer {
    let n = constNode(pc, type)
    pc.p.rNull[n] = 1
    return n
}

function intConst(pc: PC, x: Integer, type: Integer): Integer {
    let n = constNode(pc, type)
    ex.setIntReg(pc.p, n, x)
    return n
}

function textConst(pc: PC, t: Text): Integer {
    let n = constNode(pc, v.T_TEXT)
    let b = Bytes(t)
    ex.setTextReg(pc.p, n, b, 0, b.length)
    return n
}

function trackLit(pc: PC, n: Integer, id: Integer) {
    if pc.noTrack { return }
    pc.st.litNodes.add(n)
    pc.st.litPos.add(pc.a.nodes[id].position)
}

function compileLiteral(pc: PC, id: Integer): Integer {
    let nd = pc.a.nodes[id]
    let k = nd.kind
    let p = pc.p
    if k == ast.K_INT_LIT {
        if (nd.flags & ast.F_INT_OVERFLOW) != 0 {
            let n = constNode(pc, v.T_NUMERIC)
            let b = Bytes(nd.text)
            ex.parseInto(p, b, 0, b.length, false, n, v.T_NUMERIC, -1, 0)
            if p.err {
                perr(pc, p.errCode, p.errMsg, nd.position)
                ex.clearError(p)
                return -1
            }
            trackLit(pc, n, id)
            return n
        }
        let x = nd.intValue
        let t = v.T_INT8
        if x >= -2147483648 && x <= 2147483647 { t = v.T_INT4 }
        let n = intConst(pc, x, t)
        trackLit(pc, n, id)
        return n
    }
    if k == ast.K_NUM_LIT {
        let n = constNode(pc, v.T_NUMERIC)
        let b = Bytes(nd.text)
        ex.parseInto(p, b, 0, b.length, false, n, v.T_NUMERIC, -1, 0)
        if p.err {
            perr(pc, p.errCode, p.errMsg, nd.position)
            ex.clearError(p)
            return -1
        }
        trackLit(pc, n, id)
        return n
    }
    if k == ast.K_STR_LIT {
        let n = constNode(pc, v.T_UNKNOWN)
        let b = Bytes(nd.text)
        ex.setTextReg(p, n, b, 0, b.length)
        trackLit(pc, n, id)
        return n
    }
    if k == ast.K_BOOL_LIT {
        let n = constNode(pc, v.T_BOOL)
        ex.setIntReg(p, n, nd.intValue)
        return n
    }
    if k == ast.K_NULL_LIT {
        return nullConst(pc, v.T_UNKNOWN)
    }
    return -1
}

function compileParam(pc: PC, id: Integer): Integer {
    let idx = pc.a.nodes[id].intValue - 1
    while pc.st.paramTypes.length <= idx { pc.st.paramTypes.add(v.T_UNKNOWN) }
    let t = pc.st.paramTypes[idx]
    let n = ex.addExpr(pc.p, ex.EX_PARAM, t, idx, 0, 0, 0)
    pc.p.rNull[n] = 1
    pc.st.paramNodes.add(n)
    pc.st.paramIdx.add(idx)
    return n
}

// ---------------------------------------------------------------- expressions

function isAggName(name: Text): Boolean {
    return name == "count" || name == "sum" || name == "avg" || name == "min" || name == "max" ||
        name == "bool_and" || name == "bool_or" || name == "every" || name == "string_agg" ||
        name == "stddev" || name == "stddev_samp" || name == "variance" || name == "var_samp" ||
        name == "stddev_pop" || name == "var_pop" || name == "any_value" || twoArgAggKind(name) > 0
}

// float8 regression / covariance aggregates (two arguments: Y, X)
function twoArgAggKind(name: Text): Integer {
    if name == "regr_count" { return ex.AG_REGR_COUNT }
    if name == "regr_sxx" { return ex.AG_REGR_SXX }
    if name == "regr_syy" { return ex.AG_REGR_SYY }
    if name == "regr_sxy" { return ex.AG_REGR_SXY }
    if name == "regr_avgx" { return ex.AG_REGR_AVGX }
    if name == "regr_avgy" { return ex.AG_REGR_AVGY }
    if name == "regr_r2" { return ex.AG_REGR_R2 }
    if name == "regr_slope" { return ex.AG_REGR_SLOPE }
    if name == "regr_intercept" { return ex.AG_REGR_INTERCEPT }
    if name == "covar_pop" { return ex.AG_COVAR_POP }
    if name == "covar_samp" { return ex.AG_COVAR_SAMP }
    if name == "corr" { return ex.AG_CORR }
    return 0
}

function isAggCall(pc: PC, id: Integer): Boolean {
    if ast.kind(pc.a, id) != ast.K_FUNC_CALL { return false }
    if ast.child(pc.a, id, 3) >= 0 { return false }
    return isAggName(ast.text(pc.a, id))
}

// Compile an expression in the current scope.
function compileExpr(pc: PC, id: Integer): Integer {
    if pc.err || id < 0 { return -1 }
    let a = pc.a
    let nd = a.nodes[id]
    let k = nd.kind
    let p = pc.p
    // post-aggregation mapping
    if pc.aggActive && !pc.collecting {
        let gi = 0
        while gi < pc.groupAst.length {
            if astEqual(pc, pc.groupAst[gi], id) {
                return ex.addExpr(p, ex.EX_COL, p.et[pc.groupNodes[gi]], pc.aggSlot, gi, 0, -1)
            }
            gi += 1
        }
        if k == ast.K_FUNC_CALL && isAggCall(pc, id) {
            let ai = 0
            while ai < pc.aggAst.length {
                if pc.aggAst[ai] == id {
                    let t = v.sqlType(pc.p.slotTable[pc.aggSlot].cols[pc.groupAst.length + ai].type)
                    return ex.addExpr(p, ex.EX_COL, t, pc.aggSlot, pc.groupAst.length + ai, 0, -1)
                }
                ai += 1
            }
        }
    }
    if k == ast.K_INT_LIT || k == ast.K_NUM_LIT || k == ast.K_STR_LIT || k == ast.K_BOOL_LIT || k == ast.K_NULL_LIT {
        return compileLiteral(pc, id)
    }
    if k == ast.K_PARAM { return compileParam(pc, id) }
    if k == ast.K_COLUMN_REF { return resolveColumn(pc, id) }
    if k == ast.K_BINARY_OP { return compileBinary(pc, id) }
    if k == ast.K_UNARY_OP {
        let op = nd.op
        let arg = compileExpr(pc, nd.children[0])
        if arg < 0 { return -1 }
        if op == ast.OP_NOT {
            arg = coerceBool(pc, arg, "NOT", id)
            if arg < 0 || pc.err { return -1 }
            return ex.addExpr(p, ex.EX_NOT, v.T_BOOL, arg, 0, 0, 0)
        }
        if op == ast.OP_NEG {
            if isNullConst(pc, arg) && p.et[arg] != v.T_UNKNOWN { return nullConst(pc, p.et[arg]) }
            let t = p.et[arg]
            if t == v.T_UNKNOWN {
                arg = coerce(pc, arg, v.T_NUMERIC, -1, false)
                t = v.T_NUMERIC
            }
            if numRank(t) == 0 && t != v.T_INTERVAL {
                perr(pc, "42883", "operator does not exist: - " + v.typeName(t), nd.position)
                return -1
            }
            return ex.addExpr(p, ex.EX_NEG, t, arg, 0, 0, 0)
        }
        if op == ast.OP_POS { return arg }
        let at = p.et[arg]
        if op == ast.OP_BIT_NOT {
            if at == v.T_UNKNOWN {
                arg = coerce(pc, arg, v.T_INT4, -1, false)
                at = v.T_INT4
            }
            if !v.isIntType(at) {
                perr(pc, "42883", "operator does not exist: ~ " + v.typeName(at), nd.position)
                return -1
            }
            if isNullConst(pc, arg) { return nullConst(pc, at) }
            return ex.addExpr(p, ex.EX_ARITH, at, arg, intConst(pc, -1, at), ast.OP_BIT_XOR, ex.AM_INT)
        }
        if nd.text == "@" {
            if at == v.T_UNKNOWN {
                arg = coerce(pc, arg, v.T_FLOAT8, -1, false)
                at = v.T_FLOAT8
            }
            if numRank(at) == 0 {
                perr(pc, "42883", "operator does not exist: @ " + v.typeName(at), nd.position)
                return -1
            }
            let fa: List<Integer> = [arg]
            return mkFunc(pc, ex.FN_ABS, at, fa)
        }
        if nd.text == "|/" || nd.text == "||/" {
            if at != v.T_UNKNOWN && numRank(at) == 0 {
                perr(pc, "42883", "operator does not exist: " + nd.text + " " + v.typeName(at), nd.position)
                return -1
            }
            let fa: List<Integer> = [coerce(pc, arg, v.T_FLOAT8, -1, false)]
            let fn = ex.FN_SQRT
            if nd.text == "||/" { fn = ex.FN_CBRT }
            return mkFunc(pc, fn, v.T_FLOAT8, fa)
        }
        perr(pc, "42883", "operator does not exist: " + nd.text + " " + v.typeName(at), nd.position)
        return -1
    }
    if k == ast.K_FUNC_CALL {
        if pc.srfSlot >= 0 && astEqual(pc, pc.srfAst, id) {
            let col = 0
            if pc.srfKind == 1 { col = 2 }
            let st0 = p.slotTable[pc.srfSlot]
            return ex.addExpr(p, ex.EX_COL, st0.cols[col].type, pc.srfSlot, col, 0, -1)
        }
        return compileFunc(pc, id)
    }
    if k == ast.K_CAST {
        let tn = nd.children[1]
        let t = typeOfTypename(pc, tn)
        let tm = typmodOfTypename(pc, tn)
        let inner = nd.children[0]
        let arg = compileExpr(pc, inner)
        if arg < 0 { return -1 }
        let n = coerce(pc, arg, t, tm, true)
        if n == arg && p.et[n] != t {
            n = ex.addExpr(p, ex.EX_CAST, t, arg, 1, tm, 0)
        }
        if p.ek[n] == ex.EX_LITCAST || p.ek[n] == ex.EX_CAST {
            p.ed[n] = pc.a.nodes[tn].op
            noteConst(pc, n)
        }
        return n
    }
    if k == ast.K_CASE { return compileCase(pc, id) }
    if k == ast.K_BETWEEN {
        let e = compileExpr(pc, nd.children[0])
        let lo = compileExpr(pc, nd.children[1])
        let hi = compileExpr(pc, nd.children[2])
        if pc.err { return -1 }
        let c1 = makeCmp(pc, ast.OP_GE, e, lo, nd.position)
        let c2 = makeCmp(pc, ast.OP_LE, e, hi, nd.position)
        if pc.err { return -1 }
        let both = ex.addExpr(p, ex.EX_AND, v.T_BOOL, c1, c2, 0, 0)
        if (nd.flags & ast.F_SYMMETRIC) != 0 {
            let c3 = makeCmp(pc, ast.OP_GE, e, hi, nd.position)
            let c4 = makeCmp(pc, ast.OP_LE, e, lo, nd.position)
            let both2 = ex.addExpr(p, ex.EX_AND, v.T_BOOL, c3, c4, 0, 0)
            both = ex.addExpr(p, ex.EX_OR, v.T_BOOL, both, both2, 0, 0)
        }
        if (nd.flags & ast.F_NOT) != 0 { return ex.addExpr(p, ex.EX_NOT, v.T_BOOL, both, 0, 0, 0) }
        return both
    }
    if k == ast.K_IN_LIST {
        let e = compileExpr(pc, nd.children[0])
        if e < 0 { return -1 }
        let items = ast.items(a, nd.children[1])
        let nodes: List<Integer> = []
        let t = p.et[e]
        for it in items {
            let x = compileExpr(pc, it)
            if x < 0 { return -1 }
            nodes.add(x)
            let ct = commonType(t, p.et[x])
            if ct < 0 {
                perr(pc, "42883", "operator does not exist: " + v.typeName(t) + " = " + v.typeName(p.et[x]), nd.position)
                return -1
            }
            t = ct
        }
        if t == v.T_UNKNOWN { t = v.T_TEXT }
        e = coerce(pc, e, t, -1, false)
        let i = 0
        while i < nodes.length {
            nodes[i] = coerce(pc, nodes[i], t, -1, false)
            i += 1
        }
        let start = ex.addArgs(p, nodes)
        let flags = nodes.length
        if (nd.flags & ast.F_NOT) != 0 { flags = flags | 1048576 }
        return ex.addExpr(p, ex.EX_INLIST, v.T_BOOL, e, start, flags, cmpClassMixed(t, p.et[e]))
    }
    if k == ast.K_LIKE {
        let e = compileExpr(pc, nd.children[0])
        let pt = compileExpr(pc, nd.children[1])
        let esc = -1
        if nd.children[2] >= 0 { esc = coerce(pc, compileExpr(pc, nd.children[2]), v.T_TEXT, -1, false) }
        if pc.err { return -1 }
        if nd.op == ast.LIKE_SIMILAR {
            perr(pc, "0A000", "SIMILAR TO is not supported", nd.position)
            return -1
        }
        if !v.isTextType(p.et[e]) || !v.isTextType(p.et[pt]) {
            perr(pc, "42883", "operator does not exist: " + v.typeName(p.et[e]) + " ~~ " + v.typeName(p.et[pt]), nd.position)
            return -1
        }
        e = coerceText(pc, e)
        pt = coerceText(pc, pt)
        let flags = 0
        if (nd.flags & ast.F_NOT) != 0 { flags = flags | 1 }
        if nd.op == ast.LIKE_ILIKE { flags = flags | 2 }
        return ex.addExpr(p, ex.EX_LIKE, v.T_BOOL, e, pt, flags, esc)
    }
    if k == ast.K_IS_TEST {
        let e = compileExpr(pc, nd.children[0])
        if e < 0 { return -1 }
        let neg = (nd.flags & ast.F_NOT) != 0
        if nd.op == ast.TEST_NULL {
            let f = 0
            if neg { f = 1 }
            return ex.addExpr(p, ex.EX_ISNULL, v.T_BOOL, e, 0, f, 0)
        }
        e = coerceBool(pc, e, "IS", id)
        if e < 0 { return -1 }
        let f = 0
        if neg { f = 1 }
        return ex.addExpr(p, ex.EX_ISBOOL, v.T_BOOL, e, 0, nd.op, f)
    }
    if k == ast.K_SUBQUERY_EXPR {
        return compileSubqueryExpr(pc, nd.children[0], 1, -1, 0, id)
    }
    if k == ast.K_EXISTS {
        return compileSubqueryExpr(pc, nd.children[0], 2, -1, 0, id)
    }
    if k == ast.K_IN_SUBQUERY {
        let e = compileExpr(pc, nd.children[0])
        if e < 0 { return -1 }
        let f = 0
        if (nd.flags & ast.F_NOT) != 0 { f = 1 }
        return compileSubqueryExpr(pc, nd.children[1], 3, e, f, id)
    }
    if k == ast.K_QUANTIFIED {
        if (nd.flags & ast.F_SUBQUERY) == 0 {
            perr(pc, "0A000", "ANY/ALL over arrays is not supported", nd.position)
            return -1
        }
        let e = compileExpr(pc, nd.children[0])
        if e < 0 { return -1 }
        let f = nd.op
        if nd.intValue == ast.QUANT_ALL { f = f | 256 }
        return compileSubqueryExpr(pc, nd.children[1], 4, e, f, id)
    }
    if k == ast.K_COLLATE {
        return compileExpr(pc, nd.children[0])
    }
    if k == ast.K_SUBSCRIPT { return compileSubscript(pc, id) }
    if k == ast.K_FIELD_SELECT { return compileFieldSelect(pc, id) }
    if k == ast.K_ROW_EXPR {
        let items = ast.items(a, nd.children[0])
        if items.length == 1 { return compileExpr(pc, items[0]) }
        perr(pc, "0A000", "row expressions are not supported", nd.position)
        return -1
    }
    if k == ast.K_DEFAULT {
        perr(pc, "42601", "DEFAULT is not allowed in this context", nd.position)
        return -1
    }
    perr(pc, "0A000", "unsupported expression: " + ast.kindName(k), nd.position)
    return -1
}

function cmpClassMixed(t: Integer, et: Integer): Integer {
    if t == v.T_BPCHAR || et == v.T_BPCHAR { return ex.CL_BPCHAR }
    return ex.classOf(t)
}

function coerceText(pc: PC, n: Integer): Integer {
    if n < 0 { return n }
    let t = pc.p.et[n]
    if t == v.T_UNKNOWN { return coerce(pc, n, v.T_TEXT, -1, false) }
    if t == v.T_BPCHAR { return coerce(pc, n, v.T_TEXT, -1, false) }
    if v.isTextType(t) { return n }
    return coerce(pc, n, v.T_TEXT, -1, true)
}

function coerceBool(pc: PC, n: Integer, what: Text, id: Integer): Integer {
    if n < 0 { return n }
    let t = pc.p.et[n]
    if t == v.T_BOOL { return n }
    if t == v.T_UNKNOWN { return coerce(pc, n, v.T_BOOL, -1, false) }
    perr(pc, "42804", "argument of " + what + " must be type boolean, not type " + v.typeName(t), posOf(pc, id))
    return -1
}

function makeCmp(pc: PC, op: Integer, l: Integer, r: Integer, pos: Integer): Integer {
    if l < 0 || r < 0 { return -1 }
    let p = pc.p
    if (isNullConst(pc, l) || isNullConst(pc, r)) && commonType(p.et[l], p.et[r]) >= 0 {
        return nullConst(pc, v.T_BOOL)
    }
    return makeCmpCore(pc, op, l, r, pos)
}

// Comparison node without constant-NULL folding (IS [NOT] DISTINCT FROM needs both operands).
function makeCmpCore(pc: PC, op: Integer, l: Integer, r: Integer, pos: Integer): Integer {
    if l < 0 || r < 0 { return -1 }
    let p = pc.p
    let lt = p.et[l]
    let rt = p.et[r]
    let ct = commonType(lt, rt)
    if ct < 0 {
        perr(pc, "42883", "operator does not exist: " + v.typeName(lt) + " " + opSymbol(op) + " " + v.typeName(rt), pos)
        return -1
    }
    if ct == v.T_UNKNOWN { ct = v.T_TEXT }
    let cl = cmpClassMixed(ct, ct)
    if lt == v.T_BPCHAR || rt == v.T_BPCHAR {
        if (lt == v.T_BPCHAR || lt == v.T_UNKNOWN) && (rt == v.T_BPCHAR || rt == v.T_UNKNOWN) {
            ct = v.T_BPCHAR
        }
        cl = ex.CL_BPCHAR
    }
    // avoid casting the column side when classes already agree (keeps index matching simple)
    let l2 = l
    let r2 = r
    if !sameRepresentation(lt, ct) {
        l2 = coerce(pc, l, ct, -1, false)
    }
    if !sameRepresentation(rt, ct) {
        r2 = coerce(pc, r, ct, -1, false)
    }
    return ex.addExpr(p, ex.EX_CMP, v.T_BOOL, l2, r2, op, cl)
}

// Values of type a compare correctly as type b without a cast (ints of any width, text family, same type).
// date vs timestamp are both Integers but in different units, so they are NOT interchangeable.
function sameRepresentation(a: Integer, b: Integer): Boolean {
    if a == v.T_UNKNOWN { return false }
    if a == b { return true }
    if v.isIntType(a) && v.isIntType(b) { return true }
    if ex.classOf(a) == ex.CL_TEXT && ex.classOf(b) == ex.CL_TEXT { return true }
    return false
}

function opSymbol(op: Integer): Text {
    if op == ast.OP_EQ { return "=" }
    if op == ast.OP_NE { return "<>" }
    if op == ast.OP_LT { return "<" }
    if op == ast.OP_LE { return "<=" }
    if op == ast.OP_GT { return ">" }
    if op == ast.OP_GE { return ">=" }
    if op == ast.OP_ADD { return "+" }
    if op == ast.OP_SUB { return "-" }
    if op == ast.OP_MUL { return "*" }
    if op == ast.OP_DIV { return "/" }
    if op == ast.OP_MOD { return "%" }
    return "?"
}

function compileBinary(pc: PC, id: Integer): Integer {
    let nd = pc.a.nodes[id]
    let op = nd.op
    let p = pc.p
    if op == ast.OP_AND || op == ast.OP_OR {
        let what = "AND"
        if op == ast.OP_OR { what = "OR" }
        let l = coerceBool(pc, compileExpr(pc, nd.children[0]), what, id)
        let r = coerceBool(pc, compileExpr(pc, nd.children[1]), what, id)
        if pc.err { return -1 }
        let lc = constBoolNode(pc, l)
        let rc = constBoolNode(pc, r)
        if op == ast.OP_AND {
            if lc == 0 { return l }
            if rc == 0 { return r }
            if lc == 1 { return r }
            if rc == 1 { return l }
            return ex.addExpr(p, ex.EX_AND, v.T_BOOL, l, r, 0, 0)
        }
        if lc == 1 { return l }
        if rc == 1 { return r }
        if lc == 0 { return r }
        if rc == 0 { return l }
        return ex.addExpr(p, ex.EX_OR, v.T_BOOL, l, r, 0, 0)
    }
    let l = compileExpr(pc, nd.children[0])
    let r = compileExpr(pc, nd.children[1])
    if pc.err { return -1 }
    if op >= ast.OP_EQ && op <= ast.OP_GE { return makeCmp(pc, op, l, r, nd.position) }
    if op == ast.OP_IS_DISTINCT_FROM || op == ast.OP_IS_NOT_DISTINCT_FROM {
        let c = makeCmpCore(pc, ast.OP_EQ, l, r, nd.position)
        if c < 0 { return -1 }
        let f = 0
        if op == ast.OP_IS_NOT_DISTINCT_FROM { f = 1 }
        return ex.addExpr(p, ex.EX_DISTINCT, v.T_BOOL, p.ea[c], p.eb[c], f, p.ed[c])
    }
    if op == ast.OP_CONCAT {
        let lt0 = p.et[l]
        let rt0 = p.et[r]
        if (lt0 == v.T_BYTEA && (rt0 == v.T_BYTEA || rt0 == v.T_UNKNOWN)) || (rt0 == v.T_BYTEA && lt0 == v.T_UNKNOWN) {
            if isNullConst(pc, l) || isNullConst(pc, r) { return nullConst(pc, v.T_BYTEA) }
            l = coerce(pc, l, v.T_BYTEA, -1, false)
            r = coerce(pc, r, v.T_BYTEA, -1, false)
            return ex.addExpr(p, ex.EX_CONCAT, v.T_BYTEA, l, r, 0, 0)
        }
        if !v.isTextType(lt0) && !v.isTextType(rt0) {
            perr(pc, "42883", "operator does not exist: " + v.typeName(lt0) + " || " + v.typeName(rt0), nd.position)
            return -1
        }
        if isNullConst(pc, l) || isNullConst(pc, r) { return nullConst(pc, v.T_TEXT) }
        l = coerceText(pc, l)
        r = coerceText(pc, r)
        return ex.addExpr(p, ex.EX_CONCAT, v.T_TEXT, l, r, 0, 0)
    }
    if op == ast.OP_ADD || op == ast.OP_SUB || op == ast.OP_MUL || op == ast.OP_DIV || op == ast.OP_MOD || op == ast.OP_POW {
        return makeArith(pc, op, l, r, nd.position)
    }
    if op == ast.OP_REGEX || op == ast.OP_REGEX_I || op == ast.OP_NOT_REGEX || op == ast.OP_NOT_REGEX_I {
        if isNullConst(pc, l) || isNullConst(pc, r) { return nullConst(pc, v.T_BOOL) }
        let f = 0
        if op == ast.OP_NOT_REGEX || op == ast.OP_NOT_REGEX_I { f = f | 1 }
        if op == ast.OP_REGEX_I || op == ast.OP_NOT_REGEX_I { f = f | 2 }
        return ex.addExpr(p, ex.EX_REGEX, v.T_BOOL, coerceText(pc, l), coerceText(pc, r), f, 0)
    }
    if op == ast.OP_OTHER && (nd.text == "~~" || nd.text == "!~~" || nd.text == "~~*" || nd.text == "!~~*") {
        let f = 0
        if nd.text == "!~~" || nd.text == "!~~*" { f = f | 1 }
        if nd.text == "~~*" || nd.text == "!~~*" { f = f | 2 }
        return ex.addExpr(p, ex.EX_LIKE, v.T_BOOL, coerceText(pc, l), coerceText(pc, r), f, -1)
    }
    if op == ast.OP_BIT_AND || op == ast.OP_BIT_OR || op == ast.OP_BIT_XOR || op == ast.OP_SHL || op == ast.OP_SHR {
        return makeBitOp(pc, op, l, r, nd)
    }
    perr(pc, "0A000", "operator is not supported: " + nd.text, nd.position)
    return -1
}

// Integer bitwise operators (& | # << >>); shifts take an int4 count and keep the left type.
function makeBitOp(pc: PC, op: Integer, l: Integer, r: Integer, nd: ast.Node): Integer {
    let p = pc.p
    let lt = p.et[l]
    let rt = p.et[r]
    if lt == v.T_UNKNOWN {
        l = coerce(pc, l, v.T_INT4, -1, false)
        lt = v.T_INT4
    }
    if rt == v.T_UNKNOWN {
        r = coerce(pc, r, v.T_INT4, -1, false)
        rt = v.T_INT4
    }
    let sym = nd.text
    if !v.isIntType(lt) || !v.isIntType(rt) {
        perr(pc, "42883", "operator does not exist: " + v.typeName(lt) + " " + sym + " " + v.typeName(rt), nd.position)
        return -1
    }
    let t = lt
    if op == ast.OP_SHL || op == ast.OP_SHR {
        r = coerce(pc, r, v.T_INT4, -1, false)
    } else {
        t = commonType(lt, rt)
        l = coerce(pc, l, t, -1, false)
        r = coerce(pc, r, t, -1, false)
    }
    if isNullConst(pc, l) || isNullConst(pc, r) { return nullConst(pc, t) }
    let n = ex.addExpr(p, ex.EX_ARITH, t, l, r, op, ex.AM_INT)
    noteConst(pc, n)
    return n
}

function makeArith(pc: PC, op: Integer, l: Integer, r: Integer, pos: Integer): Integer {
    let p = pc.p
    let lt = p.et[l]
    let rt = p.et[r]
    if isNullConst(pc, l) || isNullConst(pc, r) {
        let folded = makeArithTyped(pc, op, l, r, pos)
        if folded < 0 { return -1 }
        return nullConst(pc, p.et[folded])
    }
    return makeArithTyped(pc, op, l, r, pos)
}

function makeArithTyped(pc: PC, op: Integer, l: Integer, r: Integer, pos: Integer): Integer {
    let p = pc.p
    let lt = p.et[l]
    let rt = p.et[r]
    if lt == v.T_DATE || rt == v.T_DATE || lt == v.T_TIMESTAMP || rt == v.T_TIMESTAMP || lt == v.T_TIMESTAMPTZ || rt == v.T_TIMESTAMPTZ || lt == v.T_INTERVAL || rt == v.T_INTERVAL {
        return makeDateArith(pc, op, l, r, pos)
    }
    if lt == v.T_UNKNOWN && rt == v.T_UNKNOWN {
        l = coerce(pc, l, v.T_NUMERIC, -1, false)
        r = coerce(pc, r, v.T_NUMERIC, -1, false)
        lt = v.T_NUMERIC
        rt = v.T_NUMERIC
    }
    let ct = commonType(lt, rt)
    if ct < 0 || numRank(ct) == 0 {
        perr(pc, "42883", "operator does not exist: " + v.typeName(lt) + " " + opSymbol(op) + " " + v.typeName(rt), pos)
        return -1
    }
    if op == ast.OP_POW {
        if ct != v.T_NUMERIC { ct = v.T_FLOAT8 }
    }
    if op == ast.OP_MOD && (ct == v.T_FLOAT8 || ct == v.T_FLOAT4) {
        perr(pc, "42883", "operator does not exist: " + v.typeName(lt) + " % " + v.typeName(rt), pos)
        return -1
    }
    l = coerce(pc, l, ct, -1, false)
    r = coerce(pc, r, ct, -1, false)
    let cl = ex.classOf(ct)
    let mode = ex.AM_INT
    if cl == ex.CL_FLT { mode = ex.AM_FLT }
    if cl == ex.CL_NUM { mode = ex.AM_NUM }
    let an = ex.addExpr(p, ex.EX_ARITH, ct, l, r, op, mode)
    noteConst(pc, an)
    return an
}

function makeDateArith(pc: PC, op: Integer, l: Integer, r: Integer, pos: Integer): Integer {
    let p = pc.p
    let lt = p.et[l]
    let rt = p.et[r]
    if lt == v.T_UNKNOWN {
        if rt == v.T_INTERVAL {
            l = coerce(pc, l, v.T_TIMESTAMP, -1, false)
        } else {
            l = coerce(pc, l, rt, -1, false)
        }
        lt = p.et[l]
    }
    if rt == v.T_UNKNOWN {
        if lt == v.T_DATE && op == ast.OP_ADD {
            r = coerce(pc, r, v.T_INT4, -1, false)
        } else if lt == v.T_DATE && op == ast.OP_SUB {
            r = coerce(pc, r, v.T_DATE, -1, false)
        } else {
            r = coerce(pc, r, v.T_INTERVAL, -1, false)
        }
        rt = p.et[r]
    }
    let ts = lt == v.T_TIMESTAMP || lt == v.T_TIMESTAMPTZ
    if lt == v.T_DATE && v.isIntType(rt) && (op == ast.OP_ADD || op == ast.OP_SUB) {
        return ex.addExpr(p, ex.EX_ARITH, v.T_DATE, l, r, op, ex.AM_DATE_INT)
    }
    if v.isIntType(lt) && rt == v.T_DATE && op == ast.OP_ADD {
        return ex.addExpr(p, ex.EX_ARITH, v.T_DATE, l, r, op, ex.AM_INT_DATE)
    }
    if lt == v.T_DATE && rt == v.T_DATE && op == ast.OP_SUB {
        return ex.addExpr(p, ex.EX_ARITH, v.T_INT4, l, r, op, ex.AM_DATE_DATE)
    }
    if lt == v.T_DATE && rt == v.T_INTERVAL && (op == ast.OP_ADD || op == ast.OP_SUB) {
        return ex.addExpr(p, ex.EX_ARITH, v.T_TIMESTAMP, l, r, op, ex.AM_DATE_IV)
    }
    if lt == v.T_INTERVAL && rt == v.T_DATE && op == ast.OP_ADD {
        return ex.addExpr(p, ex.EX_ARITH, v.T_TIMESTAMP, r, l, op, ex.AM_DATE_IV)
    }
    if ts && rt == v.T_INTERVAL && (op == ast.OP_ADD || op == ast.OP_SUB) {
        return ex.addExpr(p, ex.EX_ARITH, lt, l, r, op, ex.AM_TS_IV)
    }
    if lt == v.T_INTERVAL && (rt == v.T_TIMESTAMP || rt == v.T_TIMESTAMPTZ) && op == ast.OP_ADD {
        return ex.addExpr(p, ex.EX_ARITH, rt, r, l, op, ex.AM_TS_IV)
    }
    if (ts || lt == v.T_DATE) && (rt == v.T_TIMESTAMP || rt == v.T_TIMESTAMPTZ || rt == v.T_DATE) && op == ast.OP_SUB {
        l = coerce(pc, l, v.T_TIMESTAMP, -1, false)
        r = coerce(pc, r, v.T_TIMESTAMP, -1, false)
        return ex.addExpr(p, ex.EX_ARITH, v.T_INTERVAL, l, r, op, ex.AM_TS_TS)
    }
    if lt == v.T_INTERVAL && rt == v.T_INTERVAL && (op == ast.OP_ADD || op == ast.OP_SUB) {
        return ex.addExpr(p, ex.EX_ARITH, v.T_INTERVAL, l, r, op, ex.AM_IV_IV)
    }
    if lt == v.T_INTERVAL && numRank(rt) > 0 && (op == ast.OP_MUL || op == ast.OP_DIV) {
        r = coerce(pc, r, v.T_FLOAT8, -1, false)
        if op == ast.OP_MUL { return ex.addExpr(p, ex.EX_ARITH, v.T_INTERVAL, l, r, op, ex.AM_IV_MUL) }
        return ex.addExpr(p, ex.EX_ARITH, v.T_INTERVAL, l, r, op, ex.AM_IV_DIV)
    }
    if rt == v.T_INTERVAL && numRank(lt) > 0 && op == ast.OP_MUL {
        l = coerce(pc, l, v.T_FLOAT8, -1, false)
        return ex.addExpr(p, ex.EX_ARITH, v.T_INTERVAL, r, l, op, ex.AM_IV_MUL)
    }
    perr(pc, "42883", "operator does not exist: " + v.typeName(lt) + " " + opSymbol(op) + " " + v.typeName(rt), pos)
    return -1
}

function compileCase(pc: PC, id: Integer): Integer {
    let nd = pc.a.nodes[id]
    let p = pc.p
    let operand = -1
    if nd.children[0] >= 0 { operand = compileExpr(pc, nd.children[0]) }
    let whens = ast.items(pc.a, nd.children[1])
    let conds: List<Integer> = []
    let results: List<Integer> = []
    let rt = v.T_UNKNOWN
    let saveSuppress = pc.suppressConst
    for w in whens {
        let wn = pc.a.nodes[w]
        let c = -1
        if operand >= 0 {
            let val = compileExpr(pc, wn.children[0])
            c = makeCmp(pc, ast.OP_EQ, operand, val, wn.position)
        } else {
            c = coerceBool(pc, compileExpr(pc, wn.children[0]), "CASE/WHEN", w)
        }
        if pc.err { return -1 }
        let cb = constBool(pc, c)
        let constCond = cb >= 0
        let condFalse = cb == 0
        if condFalse { pc.suppressConst += 1 }
        let res = compileExpr(pc, wn.children[1])
        if condFalse { pc.suppressConst -= 1 }
        if constCond && !condFalse { pc.suppressConst += 1 }
        if pc.err { return -1 }
        conds.add(c)
        results.add(res)
        let ct = commonType(rt, p.et[res])
        if ct < 0 {
            perr(pc, "42804", "CASE types " + v.typeName(rt) + " and " + v.typeName(p.et[res]) + " cannot be matched", wn.position)
            return -1
        }
        rt = ct
    }
    let elseN = -1
    if nd.children[2] >= 0 {
        elseN = compileExpr(pc, nd.children[2])
        pc.suppressConst = saveSuppress
        if pc.err { return -1 }
        // PG resolves the CASE type with the ELSE result first
        let ct = p.et[elseN]
        for res in results {
            let c2 = commonType(ct, p.et[res])
            if c2 < 0 {
                perr(pc, "42804", "CASE types " + v.typeName(ct) + " and " + v.typeName(p.et[res]) + " cannot be matched", nd.position)
                return -1
            }
            ct = c2
        }
        rt = ct
    }
    pc.suppressConst = saveSuppress
    if rt == v.T_UNKNOWN { rt = v.T_TEXT }
    let args: List<Integer> = []
    let i = 0
    while i < conds.length {
        args.add(conds[i])
        args.add(coerce(pc, results[i], rt, -1, false))
        i += 1
    }
    if elseN >= 0 { elseN = coerce(pc, elseN, rt, -1, false) }
    let start = ex.addArgs(p, args)
    return ex.addExpr(p, ex.EX_CASE, rt, -1, start, conds.length, elseN)
}

// mode: 1 scalar, 2 exists, 3 in, 4 quantified
function compileSubqueryExpr(pc: PC, q: Integer, mode: Integer, lhs: Integer, flags: Integer, id: Integer): Integer {
    let p = pc.p
    let saveAgg = pc.aggActive
    let saveCollect = pc.collecting
    let saveMin = pc.minRef
    pc.aggActive = false
    pc.collecting = false
    pc.level += 1
    pc.minRef = 1000000
    let saveR = pc.rCount
    let r = compileQuery(pc, q)
    let correlated = pc.minRef < pc.level
    pc.rCount = saveR
    pc.level -= 1
    let innerMin = pc.minRef
    pc.minRef = saveMin
    if innerMin < pc.minRef { pc.minRef = innerMin }
    pc.aggActive = saveAgg
    pc.collecting = saveCollect
    if pc.err { return -1 }
    let corr = 0
    if correlated { corr = 1 }
    if mode == 1 {
        if r.exprs.length != 1 {
            perr(pc, "42601", "subquery must return only one column", posOf(pc, id))
            return -1
        }
        let out = r.exprs[0]
        if p.et[out] == v.T_UNKNOWN { out = coerce(pc, out, v.T_TEXT, -1, false) }
        return ex.addExpr(p, ex.EX_SUBQ, p.et[out], r.root, out, corr, 0)
    }
    if mode == 2 {
        return ex.addExpr(p, ex.EX_EXISTS, v.T_BOOL, r.root, 0, corr, 0)
    }
    if r.exprs.length != 1 {
        perr(pc, "42601", "subquery has too many columns", posOf(pc, id))
        return -1
    }
    let out = r.exprs[0]
    let ct = commonType(p.et[lhs], p.et[out])
    if ct < 0 {
        perr(pc, "42883", "operator does not exist: " + v.typeName(p.et[lhs]) + " = " + v.typeName(p.et[out]), posOf(pc, id))
        return -1
    }
    if ct == v.T_UNKNOWN { ct = v.T_TEXT }
    lhs = coerce(pc, lhs, ct, -1, false)
    out = coerce(pc, out, ct, -1, false)
    let cl = cmpClassMixed(ct, ct)
    if mode == 3 {
        let f = flags
        if correlated { f = f | 2 }
        f = f | (cl << 8)
        if !correlated {
            let t = tb.newTable(-1, "inset")
            t.isTemp = true
            tb.addColumn(t, tb.newColumn("v", p.et[out], -1, false))
            let ti = ex.addTemp(p, t)
            let mi = ex.addMap(p)
            while ti < mi { ti = ex.addTemp(p, t) }
            while mi < ti { mi = ex.addMap(p) }
            f = f | (mi << 16)
        }
        return ex.addExpr(p, ex.EX_INSUB, v.T_BOOL, lhs, r.root, out, f)
    }
    let d = (flags & 255) | (((flags >> 8) & 1) << 8) | (cl << 16)
    return ex.addExpr(p, ex.EX_QUANT, v.T_BOOL, lhs, r.root, out, d)
}

// ---------------------------------------------------------------- functions

function fnArgs(pc: PC, id: Integer): List<Integer> {
    let out: List<Integer> = []
    for a in ast.items(pc.a, ast.child(pc.a, id, 1)) {
        out.add(compileExpr(pc, a))
    }
    return out
}

function mkFunc(pc: PC, fn: Integer, type: Integer, args: List<Integer>): Integer {
    if fn != ex.FN_CONCAT && fn != ex.FN_CONCAT_WS && fn != ex.FN_RANDOM && fn != ex.FN_PI {
        for a in args {
            if isNullConst(pc, a) { return nullConst(pc, type) }
        }
    }
    let start = ex.addArgs(pc.p, args)
    return ex.addExpr(pc.p, ex.EX_FUNC, type, start, args.length, fn, 0)
}

function compileFunc(pc: PC, id: Integer): Integer {
    let nd = pc.a.nodes[id]
    let name = nd.text
    let p = pc.p
    if isAggCall(pc, id) {
        if pc.collecting {
            perr(pc, "42803", "aggregate function calls cannot be nested", nd.position)
            return -1
        }
        perr(pc, "42803", "aggregate functions are not allowed in this context", nd.position)
        return -1
    }
    if ast.child(pc.a, id, 3) >= 0 { return compileWindowCall(pc, id) }
    let catf = compileCatFunc(pc, id, name)
    if catf != -2 { return catf }
    let rawArgs = ast.items(pc.a, ast.child(pc.a, id, 1))
    let nargs = rawArgs.length
    if name == "coalesce" || name == "greatest" || name == "least" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        let t = v.T_UNKNOWN
        for a in args {
            let ct = commonType(t, p.et[a])
            if ct < 0 {
                perr(pc, "42804", name + " types " + v.typeName(t) + " and " + v.typeName(p.et[a]) + " cannot be matched", nd.position)
                return -1
            }
            t = ct
        }
        if t == v.T_UNKNOWN { t = v.T_TEXT }
        let i = 0
        while i < args.length {
            args[i] = coerce(pc, args[i], t, -1, false)
            i += 1
        }
        let start = ex.addArgs(p, args)
        if name == "coalesce" { return ex.addExpr(p, ex.EX_COALESCE, t, start, args.length, 0, 0) }
        let least = 0
        if name == "least" { least = 1 }
        return ex.addExpr(p, ex.EX_GREATEST, t, start, args.length, least, cmpClass(t))
    }
    if name == "nullif" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        if args.length != 2 { return badArgs(pc, name, id) }
        let c = makeCmp(pc, ast.OP_EQ, args[0], args[1], nd.position)
        if c < 0 { return -1 }
        if p.ek[c] != ex.EX_CMP { return args[0] }
        let nt = p.et[p.ea[c]]
        if nt == v.T_VARCHAR || nt == v.T_NAME || nt == v.T_UNKNOWN || (nt == v.T_BPCHAR && p.et[p.eb[c]] != v.T_BPCHAR) { nt = v.T_TEXT }
        return ex.addExpr(p, ex.EX_NULLIF, nt, p.ea[c], p.eb[c], 0, p.ed[c])
    }
    if name == "now" || name == "current_timestamp" || name == "localtimestamp" || name == "statement_timestamp" || name == "transaction_timestamp" || name == "clock_timestamp" {
        let t = v.T_TIMESTAMPTZ
        if name == "localtimestamp" { t = v.T_TIMESTAMP }
        for ra in rawArgs { pin(pc, ra) }
        return ex.addExpr(p, ex.EX_NOW, t, 0, 0, 0, 0)
    }
    if name == "current_date" {
        let n = ex.addExpr(p, ex.EX_NOW, v.T_TIMESTAMP, 0, 0, 0, 0)
        return ex.addExpr(p, ex.EX_CAST, v.T_DATE, n, 1, -1, 0)
    }
    if name == "version" {
        return textConst(pc, "PostgreSQL 17.0 (neo-db) on x86_64-pc-linux-gnu, compiled by Minyar, 64-bit")
    }
    if name == "current_user" || name == "session_user" || name == "user" || name == "current_role" {
        return textConst(pc, "postgres")
    }
    if name == "current_database" || name == "current_catalog" { return textConst(pc, "postgres") }
    if name == "current_schema" { return textConst(pc, "public") }
    if name == "pg_backend_pid" { return intConst(pc, 1, v.T_INT4) }
    if name == "current_setting" {
        if nargs >= 1 && ast.kind(pc.a, rawArgs[0]) == ast.K_STR_LIT {
            pin(pc, rawArgs[0])
            return textConst(pc, settingDefault(pc.a.nodes[rawArgs[0]].text))
        }
        return textConst(pc, "")
    }
    if name == "set_config" {
        if nargs >= 2 && ast.kind(pc.a, rawArgs[1]) == ast.K_STR_LIT {
            pin(pc, rawArgs[1])
            return textConst(pc, pc.a.nodes[rawArgs[1]].text)
        }
        return textConst(pc, "")
    }
    if name == "pg_typeof" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        if args.length != 1 { return badArgs(pc, name, id) }
        return textConst(pc, v.typeName(p.et[args[0]]))
    }
    if name == "extract" || name == "date_part" || name == "date_trunc" {
        if nargs != 2 { return badArgs(pc, name, id) }
        pin(pc, rawArgs[0])
        let field = compileExpr(pc, rawArgs[0])
        let val = compileExpr(pc, rawArgs[1])
        if pc.err { return -1 }
        field = coerce(pc, field, v.T_TEXT, -1, false)
        let vt = p.et[val]
        if vt == v.T_UNKNOWN {
            val = coerce(pc, val, v.T_TIMESTAMP, -1, false)
            vt = v.T_TIMESTAMP
        }
        let args: List<Integer> = [field, val]
        if name == "date_trunc" {
            let rt = vt
            if vt == v.T_DATE { rt = v.T_TIMESTAMP }
            return mkFunc(pc, ex.FN_DATE_TRUNC, rt, args)
        }
        let n = mkFunc(pc, ex.FN_EXTRACT, v.T_NUMERIC, args)
        if name == "date_part" { return ex.addExpr(p, ex.EX_CAST, v.T_FLOAT8, n, 1, -1, 0) }
        return n
    }
    if ast.items(pc.a, ast.child(pc.a, id, 1)).length > 100 {
        perr(pc, "54023", "cannot pass more than 100 arguments to a function", nd.position)
        return -1
    }
    let args = fnArgs(pc, id)
    if pc.err { return -1 }
    if name == "abs" {
        if args.length != 1 { return badArgs(pc, name, id) }
        let t = numericArgType(pc, args, 0)
        args[0] = coerce(pc, args[0], t, -1, false)
        return mkFunc(pc, ex.FN_ABS, t, args)
    }
    if name == "round" || name == "trunc" || name == "floor" || name == "ceil" || name == "ceiling" {
        if args.length < 1 || args.length > 2 { return badArgs(pc, name, id) }
        let t = numericArgType(pc, args, 0)
        if v.isIntType(t) {
            if name == "floor" || name == "ceil" || name == "ceiling" { t = v.T_FLOAT8 } else { t = v.T_NUMERIC }
        }
        if args.length == 2 {
            t = v.T_NUMERIC
            args[1] = coerce(pc, args[1], v.T_INT4, -1, false)
        }
        args[0] = coerce(pc, args[0], t, -1, false)
        let fn = ex.FN_ROUND
        if name == "trunc" { fn = ex.FN_TRUNC }
        if name == "floor" { fn = ex.FN_FLOOR }
        if name == "ceil" || name == "ceiling" { fn = ex.FN_CEIL }
        return mkFunc(pc, fn, t, args)
    }
    if name == "mod" {
        if args.length != 2 { return badArgs(pc, name, id) }
        return makeArith(pc, ast.OP_MOD, args[0], args[1], nd.position)
    }
    if name == "div" {
        if args.length != 2 { return badArgs(pc, name, id) }
        args[0] = coerce(pc, args[0], v.T_NUMERIC, -1, false)
        args[1] = coerce(pc, args[1], v.T_NUMERIC, -1, false)
        return mkFunc(pc, ex.FN_DIV, v.T_NUMERIC, args)
    }
    if name == "power" || name == "pow" || name == "sqrt" || name == "exp" || name == "ln" || name == "log" || name == "log10" || name == "cbrt" {
        let t = v.T_FLOAT8
        if args.length >= 1 && p.et[args[0]] == v.T_NUMERIC && name != "cbrt" { t = v.T_NUMERIC }
        if args.length >= 2 && p.et[args[1]] == v.T_NUMERIC { t = v.T_NUMERIC }
        if args.length == 2 && name == "log" { t = v.T_NUMERIC }
        if args.length >= 2 && (p.et[args[0]] == v.T_FLOAT8 || p.et[args[0]] == v.T_FLOAT4 || p.et[args[1]] == v.T_FLOAT8 || p.et[args[1]] == v.T_FLOAT4) && name != "log" { t = v.T_FLOAT8 }
        let i = 0
        while i < args.length {
            args[i] = coerce(pc, args[i], t, -1, false)
            i += 1
        }
        let fn = ex.FN_POWER
        if name == "sqrt" { fn = ex.FN_SQRT }
        if name == "exp" { fn = ex.FN_EXP }
        if name == "ln" { fn = ex.FN_LN }
        if name == "log" || name == "log10" { fn = ex.FN_LOG10 }
        if name == "cbrt" { fn = ex.FN_CBRT }
        return mkFunc(pc, fn, t, args)
    }
    if name == "sign" {
        if args.length != 1 { return badArgs(pc, name, id) }
        let t = numericArgType(pc, args, 0)
        if v.isIntType(t) { t = v.T_NUMERIC }
        args[0] = coerce(pc, args[0], t, -1, false)
        return mkFunc(pc, ex.FN_SIGN, t, args)
    }
    if name == "pi" { return mkFunc(pc, ex.FN_PI, v.T_FLOAT8, args) }
    if name == "gcd" || name == "lcm" {
        if args.length != 2 { return badArgs(pc, name, id) }
        let t = commonType(numericArgType(pc, args, 0), numericArgType(pc, args, 1))
        if pc.err { return -1 }
        if p.et[args[0]] == v.T_INT2 && p.et[args[1]] == v.T_INT2 {
            perr(pc, "42725", "function " + name + "(smallint, smallint) is not unique", nd.position)
            return -1
        }
        if t == v.T_INT2 { t = v.T_INT4 }
        if t != v.T_INT4 && t != v.T_INT8 && t != v.T_NUMERIC {
            perr(pc, "42883", "function " + name + "(" + v.typeName(p.et[args[0]]) + ", " + v.typeName(p.et[args[1]]) + ") does not exist", nd.position)
            return -1
        }
        args[0] = coerce(pc, args[0], t, -1, false)
        args[1] = coerce(pc, args[1], t, -1, false)
        let fn = ex.FN_GCD
        if name == "lcm" { fn = ex.FN_LCM }
        return mkFunc(pc, fn, t, args)
    }
    if name == "booland_statefunc" || name == "boolor_statefunc" {
        if args.length != 2 { return badArgs(pc, name, id) }
        args[0] = coerceBool(pc, args[0], name, id)
        args[1] = coerceBool(pc, args[1], name, id)
        if pc.err { return -1 }
        let fn = ex.FN_BOOLAND
        if name == "boolor_statefunc" { fn = ex.FN_BOOLOR }
        return mkFunc(pc, fn, v.T_BOOL, args)
    }
    if name == "random" { return mkFunc(pc, ex.FN_RANDOM, v.T_FLOAT8, args) }
    if name == "length" || name == "char_length" || name == "character_length" || name == "octet_length" {
        if args.length != 1 { return badArgs(pc, name, id) }
        if p.et[args[0]] == v.T_UNKNOWN { args[0] = coerce(pc, args[0], v.T_TEXT, -1, false) }
        if !v.isTextType(p.et[args[0]]) {
            perr(pc, "42883", "function " + name + "(" + v.typeName(p.et[args[0]]) + ") does not exist", nd.position)
            return -1
        }
        let fn = ex.FN_LENGTH
        if name == "octet_length" { fn = ex.FN_OCTET_LENGTH }
        return mkFunc(pc, fn, v.T_INT4, args)
    }
    let fn = textFunctionId(name)
    if fn > 0 {
        let i = 0
        while i < args.length {
            let want = v.T_TEXT
            if (fn == ex.FN_SUBSTR) && i > 0 { want = v.T_INT4 }
            if (fn == ex.FN_LEFT || fn == ex.FN_RIGHT || fn == ex.FN_REPEAT || fn == ex.FN_LPAD || fn == ex.FN_RPAD) && i == 1 { want = v.T_INT4 }
            if fn == ex.FN_SPLIT_PART && i == 2 { want = v.T_INT4 }
            if want == v.T_TEXT {
                args[i] = coerceText(pc, args[i])
            } else {
                args[i] = coerce(pc, args[i], want, -1, false)
            }
            i += 1
        }
        let rt = v.T_TEXT
        if fn == ex.FN_POSITION || fn == ex.FN_ASCII { rt = v.T_INT4 }
        if args.length > 0 && p.et[args[0]] == v.T_BYTEA && (fn == ex.FN_SUBSTR || fn == ex.FN_BTRIM || fn == ex.FN_LTRIM || fn == ex.FN_RTRIM) {
            rt = v.T_BYTEA
            if args.length > 1 && fn != ex.FN_SUBSTR { args[1] = coerce(pc, args[1], v.T_BYTEA, -1, false) }
        }
        return mkFunc(pc, fn, rt, args)
    }
    if name == "concat" {
        let i = 0
        while i < args.length {
            if p.et[args[i]] == v.T_UNKNOWN { args[i] = coerce(pc, args[i], v.T_TEXT, -1, false) }
            i += 1
        }
        return mkFunc(pc, ex.FN_CONCAT, v.T_TEXT, args)
    }
    if name == "concat_ws" {
        if args.length < 1 { return badArgs(pc, name, id) }
        let i = 0
        while i < args.length {
            if p.et[args[i]] == v.T_UNKNOWN { args[i] = coerce(pc, args[i], v.T_TEXT, -1, false) }
            i += 1
        }
        args[0] = coerceText(pc, args[0])
        return mkFunc(pc, ex.FN_CONCAT_WS, v.T_TEXT, args)
    }
    if args.length == 1 && typeFromName(name) >= 0 && name != "char" && name != "time" {
        return coerce(pc, args[0], typeFromName(name), -1, true)
    }
    if name == "chr" {
        if args.length != 1 { return badArgs(pc, name, id) }
        args[0] = coerce(pc, args[0], v.T_INT4, -1, false)
        return mkFunc(pc, ex.FN_CHR, v.T_TEXT, args)
    }
    let sfn = compileStrFunc(pc, id, name, args)
    if sfn != -2 { return sfn }
    perr(pc, "42883", "function " + name + "() does not exist", nd.position)
    return -1
}

// String / bytea functions evaluated by ex.evalStrFunc. Returns -2 when `name` is not one of them.
function compileStrFunc(pc: PC, id: Integer, name: Text, args: List<Integer>): Integer {
    let p = pc.p
    let n = args.length
    if name == "quote_literal" || name == "quote_nullable" || name == "quote_ident" {
        if n != 1 { return badArgs(pc, name, id) }
        args[0] = coerceText(pc, args[0])
        let fn = ex.FN_QUOTE_LITERAL
        if name == "quote_ident" { fn = ex.FN_QUOTE_IDENT }
        if name == "quote_nullable" { fn = ex.FN_QUOTE_NULLABLE }
        return strFuncNode(pc, fn, v.T_TEXT, args, 0)
    }
    if name == "to_hex" || name == "to_oct" || name == "to_bin" {
        if n != 1 { return badArgs(pc, name, id) }
        let t = p.et[args[0]]
        if t == v.T_UNKNOWN || t == v.T_INT2 { t = v.T_INT4 }
        if t != v.T_INT4 && t != v.T_INT8 {
            perr(pc, "42883", "function " + name + "(" + v.typeName(t) + ") does not exist", posOf(pc, id))
            return -1
        }
        args[0] = coerce(pc, args[0], t, -1, false)
        let bits = 4
        if name == "to_oct" { bits = 3 }
        if name == "to_bin" { bits = 1 }
        return strFuncNode(pc, ex.FN_TO_BASE, v.T_TEXT, args, bits)
    }
    if name == "overlay" {
        if n < 3 || n > 4 { return badArgs(pc, name, id) }
        let t = v.T_TEXT
        if p.et[args[0]] == v.T_BYTEA || p.et[args[1]] == v.T_BYTEA { t = v.T_BYTEA }
        args[0] = coerce(pc, args[0], t, -1, false)
        args[1] = coerce(pc, args[1], t, -1, false)
        args[2] = coerce(pc, args[2], v.T_INT4, -1, false)
        if n > 3 { args[3] = coerce(pc, args[3], v.T_INT4, -1, false) }
        if t == v.T_TEXT {
            args[0] = coerceText(pc, args[0])
            args[1] = coerceText(pc, args[1])
        }
        return strFuncNode(pc, ex.FN_OVERLAY, t, args, 0)
    }
    if name == "unistr" {
        if n != 1 { return badArgs(pc, name, id) }
        args[0] = coerceText(pc, args[0])
        return strFuncNode(pc, ex.FN_UNISTR, v.T_TEXT, args, 0)
    }
    if name == "sha224" || name == "sha256" || name == "sha384" || name == "sha512" {
        if n != 1 { return badArgs(pc, name, id) }
        args[0] = coerce(pc, args[0], v.T_BYTEA, -1, false)
        let bits = 224
        if name == "sha256" { bits = 256 }
        if name == "sha384" { bits = 384 }
        if name == "sha512" { bits = 512 }
        return strFuncNode(pc, ex.FN_SHA, v.T_BYTEA, args, bits)
    }
    if name == "md5" {
        if n != 1 { return badArgs(pc, name, id) }
        if p.et[args[0]] != v.T_BYTEA { args[0] = coerceText(pc, args[0]) }
        return strFuncNode(pc, ex.FN_MD5_HEX, v.T_TEXT, args, 0)
    }
    if name == "encode" || name == "decode" {
        if n != 2 { return badArgs(pc, name, id) }
        if name == "encode" {
            args[0] = coerce(pc, args[0], v.T_BYTEA, -1, false)
        } else {
            args[0] = coerceText(pc, args[0])
        }
        args[1] = coerceText(pc, args[1])
        if name == "encode" { return strFuncNode(pc, ex.FN_ENCODE, v.T_TEXT, args, 0) }
        return strFuncNode(pc, ex.FN_DECODE, v.T_BYTEA, args, 0)
    }
    if name == "get_bit" || name == "get_byte" || name == "set_bit" || name == "set_byte" || name == "bit_count" {
        let want = 2
        if name == "set_bit" || name == "set_byte" { want = 3 }
        if name == "bit_count" { want = 1 }
        if n != want { return badArgs(pc, name, id) }
        args[0] = coerce(pc, args[0], v.T_BYTEA, -1, false)
        let i = 1
        while i < n {
            args[i] = coerce(pc, args[i], v.T_INT4, -1, false)
            i += 1
        }
        if name == "bit_count" { return strFuncNode(pc, ex.FN_BIT_COUNT, v.T_INT8, args, 0) }
        if name == "get_bit" { return strFuncNode(pc, ex.FN_GET_BIT, v.T_INT4, args, 0) }
        if name == "get_byte" { return strFuncNode(pc, ex.FN_GET_BYTE, v.T_INT4, args, 0) }
        if name == "set_bit" { return strFuncNode(pc, ex.FN_SET_BIT, v.T_BYTEA, args, 0) }
        return strFuncNode(pc, ex.FN_SET_BYTE, v.T_BYTEA, args, 0)
    }
    if name == "format" {
        if n < 1 { return badArgs(pc, name, id) }
        args[0] = coerceText(pc, args[0])
        let i = 1
        while i < n {
            if p.et[args[i]] == v.T_UNKNOWN { args[i] = coerce(pc, args[i], v.T_TEXT, -1, false) }
            i += 1
        }
        return strFuncNode(pc, ex.FN_FORMAT, v.T_TEXT, args, 0)
    }
    if name == "booleq" || name == "boolne" {
        if n != 2 { return badArgs(pc, name, id) }
        let l = coerceBool(pc, args[0], name, id)
        let r = coerceBool(pc, args[1], name, id)
        if pc.err { return -1 }
        if name == "booleq" { return makeCmp(pc, ast.OP_EQ, l, r, posOf(pc, id)) }
        return makeCmp(pc, ast.OP_NE, l, r, posOf(pc, id))
    }
    return -2
}

// EX_FUNC node for evalStrFunc (no NULL folding: quote_nullable / format are not strict). d: per-function variant.
function strFuncNode(pc: PC, fn: Integer, type: Integer, args: List<Integer>, d: Integer): Integer {
    let start = ex.addArgs(pc.p, args)
    return ex.addExpr(pc.p, ex.EX_FUNC, type, start, args.length, fn, d)
}

function textFunctionId(name: Text): Integer {
    if name == "lower" { return ex.FN_LOWER }
    if name == "upper" { return ex.FN_UPPER }
    if name == "initcap" { return ex.FN_INITCAP }
    if name == "substring" || name == "substr" { return ex.FN_SUBSTR }
    if name == "position" || name == "strpos" { return ex.FN_POSITION }
    if name == "btrim" || name == "trim" { return ex.FN_BTRIM }
    if name == "ltrim" { return ex.FN_LTRIM }
    if name == "rtrim" { return ex.FN_RTRIM }
    if name == "replace" { return ex.FN_REPLACE }
    if name == "translate" { return ex.FN_TRANSLATE }
    if name == "left" { return ex.FN_LEFT }
    if name == "right" { return ex.FN_RIGHT }
    if name == "repeat" { return ex.FN_REPEAT }
    if name == "reverse" { return ex.FN_REVERSE }
    if name == "lpad" { return ex.FN_LPAD }
    if name == "rpad" { return ex.FN_RPAD }
    if name == "split_part" { return ex.FN_SPLIT_PART }
    if name == "ascii" { return ex.FN_ASCII }
    return 0
}

function badArgs(pc: PC, name: Text, id: Integer): Integer {
    perr(pc, "42883", "function " + name + " with these arguments does not exist", posOf(pc, id))
    return -1
}

function numericArgType(pc: PC, args: List<Integer>, i: Integer): Integer {
    if i >= args.length { return v.T_NUMERIC }
    let t = pc.p.et[args[i]]
    if t == v.T_UNKNOWN { return v.T_FLOAT8 }
    if numRank(t) == 0 {
        perr(pc, "42883", "function does not exist for type " + v.typeName(t), -1)
        return v.T_NUMERIC
    }
    return t
}

public function settingDefault(name: Text): Text {
    if name == "server_version" { return "17.0" }
    if name == "server_version_num" { return "170000" }
    if name == "transaction_isolation" || name == "default_transaction_isolation" { return "read committed" }
    if name == "client_encoding" || name == "server_encoding" { return "UTF8" }
    if name == "datestyle" { return "ISO, MDY" }
    if name == "timezone" { return "UTC" }
    if name == "standard_conforming_strings" { return "on" }
    if name == "integer_datetimes" { return "on" }
    if name == "max_identifier_length" { return "63" }
    if name == "search_path" { return "\"$user\", public" }
    if name == "extra_float_digits" { return "1" }
    if name == "application_name" { return "" }
    if name == "lc_collate" || name == "lc_ctype" { return "C" }
    if name == "is_superuser" { return "on" }
    if name == "transaction_read_only" || name == "default_transaction_read_only" { return "off" }
    if name == "synchronous_commit" { return "on" }
    if name == "fsync" { return "on" }
    if name == "max_connections" { return "10000" }
    if name == "block_size" { return "8192" }
    if name == "max_index_keys" { return "32" }
    if name == "max_function_args" { return "100" }
    if name == "intervalstyle" { return "postgres" }
    return ""
}

// ---------------------------------------------------------------- AST structural equality

function astEqual(pc: PC, x: Integer, y: Integer): Boolean {
    if x == y { return true }
    if x < 0 || y < 0 { return false }
    let a = pc.a.nodes[x]
    let b = pc.a.nodes[y]
    if a.kind == ast.K_COLUMN_REF && b.kind == ast.K_COLUMN_REF {
        if a.text != b.text { return false }
        let qa = ast.qualifier(pc.a, x)
        let qb = ast.qualifier(pc.a, y)
        return qa == qb || qa == "" || qb == ""
    }
    if a.kind != b.kind || a.op != b.op || a.text != b.text || a.intValue != b.intValue || a.flags != b.flags { return false }
    if a.children.length != b.children.length { return false }
    let i = 0
    while i < a.children.length {
        if !astEqual(pc, a.children[i], b.children[i]) { return false }
        i += 1
    }
    return true
}

// ---------------------------------------------------------------- queries

record QResult {
    root: Integer
    exprs: List<Integer>
    names: List<Text>
    types: List<Integer>
    mods: List<Integer>
    sortKeys: List<Integer>    // ORDER BY keys as columns of the sorted output (WITH TIES), else empty
}

function emptyResult(): QResult {
    return QResult { root: -1; exprs: []; names: []; types: []; mods: []; sortKeys: [] }
}

function compileQuery(pc: PC, q: Integer): QResult {
    let k = ast.kind(pc.a, q)
    let saveCte = pc.cteCount
    let withN = ast.child(pc.a, q, ast.Q_WITH)
    if withN >= 0 {
        if ast.hasFlag(pc.a, withN, ast.F_RECURSIVE) {
            perr(pc, "0A000", "WITH RECURSIVE is not supported", posOf(pc, withN))
            return emptyResult()
        }
        for cte in ast.items(pc.a, ast.child(pc.a, withN, 0)) {
            addCte(pc, pc.a.nodes[cte].text, cte)
        }
    }
    let r = emptyResult()
    if k == ast.K_SELECT {
        r = compileSelect(pc, q)
    } else if k == ast.K_VALUES {
        r = applyOrderLimit(pc, q, valuesAsTemp(pc, q, []))
    } else if k == ast.K_SET_OP {
        r = compileSetOp(pc, q)
    } else {
        perr(pc, "0A000", "unsupported query", posOf(pc, q))
    }
    pc.cteCount = saveCte
    return r
}

function addCte(pc: PC, name: Text, id: Integer) {
    if pc.cteCount < pc.cteName.length {
        pc.cteName[pc.cteCount] = name
        pc.cteAst[pc.cteCount] = id
    } else {
        pc.cteName.add(name)
        pc.cteAst.add(id)
    }
    pc.cteCount += 1
}

function findCte(pc: PC, name: Text): Integer {
    let i = pc.cteCount - 1
    while i >= 0 {
        if pc.cteName[i] == name { return pc.cteAst[i] }
        i -= 1
    }
    return -1
}

function nullsFirstOf(pc: PC, si: Integer, desc: Boolean): Integer {
    let nv = pc.a.nodes[si].intValue
    if nv == ast.NULLS_FIRST { return 1 }
    if nv == ast.NULLS_LAST { return 0 }
    if desc { return 1 }
    return 0
}

// ORDER BY / LIMIT for set-operation and VALUES queries (keys must be output columns).
function applyOrderLimit(pc: PC, q: Integer, r: QResult): QResult {
    if pc.err { return r }
    let ob = ast.child(pc.a, q, ast.Q_ORDER_BY)
    if ob >= 0 {
        let keys: List<Integer> = []
        let desc: List<Integer> = []
        let nf: List<Integer> = []
        for si in ast.items(pc.a, ob) {
            let e = ast.child(pc.a, si, 0)
            let idx = -1
            if ast.kind(pc.a, e) == ast.K_INT_LIT {
                pin(pc, e)
                idx = pc.a.nodes[e].intValue - 1
            } else if ast.kind(pc.a, e) == ast.K_COLUMN_REF {
                let j = 0
                while j < r.names.length {
                    if r.names[j] == pc.a.nodes[e].text && idx < 0 { idx = j }
                    j += 1
                }
            }
            if idx < 0 || idx >= r.exprs.length {
                perr(pc, "42703", "invalid ORDER BY for this query", posOf(pc, e))
                return r
            }
            keys.add(r.exprs[idx])
            let d = sortDesc(pc, si)
            desc.add(d)
            nf.add(nullsFirstOf(pc, si, d == 1))
        }
        r = addSort(pc, r, keys, desc, nf)
    }
    return applyLimit(pc, q, r)
}

// 1 for DESC or ORDER BY x USING > / >=, else 0.
function sortDesc(pc: PC, si: Integer): Integer {
    let nd = pc.a.nodes[si]
    if nd.op == ast.SORT_DESC { return 1 }
    if nd.op == ast.SORT_USING && (nd.text == ">" || nd.text == ">=" || nd.text == "~>~" || nd.text == "~>=~") { return 1 }
    return 0
}

function applyLimit(pc: PC, q: Integer, r: QResult): QResult {
    if pc.err { return r }
    let lim = ast.child(pc.a, q, ast.Q_LIMIT)
    let off = ast.child(pc.a, q, ast.Q_OFFSET)
    let ties = ast.hasFlag(pc.a, q, ast.F_WITH_TIES)
    if ties {
        if r.sortKeys.length == 0 {
            perr(pc, "42601", "WITH TIES cannot be specified without ORDER BY clause", posOf(pc, lim))
            return r
        }
        if ast.hasFlag(pc.a, q, ast.F_SKIP_LOCKED) {
            perr(pc, "42601", "SKIP LOCKED and WITH TIES options cannot be used together", posOf(pc, q))
            return r
        }
        if ast.kind(pc.a, lim) == ast.K_NULL_LIT {
            perr(pc, "2201W", "row count cannot be null in FETCH FIRST ... WITH TIES clause", posOf(pc, lim))
            return r
        }
    }
    if lim < 0 && off < 0 { return r }
    let le = -1
    let oe = -1
    if lim >= 0 && ast.kind(pc.a, lim) != ast.K_NULL_LIT {
        le = coerce(pc, compileExpr(pc, lim), v.T_INT8, -1, false)
    }
    if off >= 0 {
        oe = coerce(pc, compileExpr(pc, off), v.T_INT8, -1, false)
    }
    if pc.err { return r }
    let tiesBlk = 0
    if ties {
        // [n, key1, saved1, key2, saved2, ...]: keys of the last row within the limit are saved for comparison
        let spec: List<Integer> = [r.sortKeys.length]
        for k in r.sortKeys {
            spec.add(k)
            spec.add(constNode(pc, pc.p.et[k]))
        }
        tiesBlk = ex.listBlock(pc.p, spec) + 1
    }
    r.root = ex.addOp(pc.p, ex.O_LIMIT, r.root, le, oe, tiesBlk, 0, 0)
    return r
}

// Materialize r's outputs plus extra keys into a temp table, sorted.
function addSort(pc: PC, r: QResult, keys: List<Integer>, desc: List<Integer>, nf: List<Integer>): QResult {
    let p = pc.p
    if p.ok[r.root] == ex.O_RANGE {
        let cols = pc.c.ordIdx[p.ob[r.root]].cols
        let ordered = keys.length <= cols.length
        let i = 0
        while i < keys.length && ordered {
            let key = keys[i]
            ordered = desc[i] == 0 && nf[i] == 0 && p.ek[key] == ex.EX_COL
            if ordered {
                ordered = p.ea[key] == p.oa[r.root] && p.eb[key] == cols[i]
            }
            i += 1
        }
        if ordered {
            r.sortKeys = keys
            return r
        }
    }
    let t = tb.newTable(-1, "sort")
    t.isTemp = true
    let cols: List<Integer> = []
    let i = 0
    while i < r.exprs.length {
        let e = r.exprs[i]
        if p.et[e] == v.T_UNKNOWN {
            e = coerce(pc, e, v.T_TEXT, -1, false)
            r.exprs[i] = e
        }
        tb.addColumn(t, tb.newColumn("c" + Text(i), p.et[e], -1, false))
        cols.add(e)
        i += 1
    }
    let keyCols: List<Integer> = []
    i = 0
    while i < keys.length {
        let k = keys[i]
        let found = -1
        let j = 0
        while j < cols.length {
            if cols[j] == k && found < 0 { found = j }
            j += 1
        }
        if found < 0 {
            if p.et[k] == v.T_UNKNOWN { k = coerce(pc, k, v.T_TEXT, -1, false) }
            tb.addColumn(t, tb.newColumn("k" + Text(i), p.et[k], -1, false))
            cols.add(k)
            found = cols.length - 1
        }
        keyCols.add(found)
        i += 1
    }
    let ti = ex.addTemp(p, t)
    let slot = newSlot(pc, t)
    let spec: List<Integer> = [cols.length]
    for c in cols { spec.add(c) }
    spec.add(keyCols.length)
    i = 0
    while i < keyCols.length {
        spec.add(keyCols[i])
        spec.add(desc[i])
        spec.add(nf[i])
        i += 1
    }
    let blk = ex.listBlock(p, spec)
    let mi = ex.addMap(p)
    let op = ex.addOp(p, ex.O_SORT, r.root, ti, slot, 0, blk, mi)
    let out = emptyResult()
    out.root = op
    i = 0
    while i < r.exprs.length {
        out.exprs.add(ex.addExpr(p, ex.EX_COL, v.sqlType(t.cols[i].type), slot, i, 0, -1))
        out.names.add(r.names[i])
        out.types.add(v.sqlType(t.cols[i].type))
        out.mods.add(r.mods[i])
        i += 1
    }
    for kc in keyCols { out.sortKeys.add(ex.addExpr(p, ex.EX_COL, t.cols[kc].type, slot, kc, 0, -1)) }
    return out
}

function valuesAsTemp(pc: PC, q: Integer, colNames: List<Text>): QResult {
    let p = pc.p
    let rows = ast.items(pc.a, ast.child(pc.a, q, ast.Q_ROWS))
    let compiled: List<Integer> = []
    let nc = -1
    let types: List<Integer> = []
    for row in rows {
        let items = ast.items(pc.a, row)
        if nc < 0 {
            nc = items.length
            let i = 0
            while i < nc {
                types.add(v.T_UNKNOWN)
                i += 1
            }
        }
        if items.length != nc {
            perr(pc, "42601", "VALUES lists must all be the same length", posOf(pc, row))
            return emptyResult()
        }
        let i = 0
        while i < nc {
            let e = compileExpr(pc, items[i])
            if pc.err { return emptyResult() }
            compiled.add(e)
            let ct = commonType(types[i], p.et[e])
            if ct < 0 {
                perr(pc, "42804", "VALUES types " + v.typeName(types[i]) + " and " + v.typeName(p.et[e]) + " cannot be matched", posOf(pc, items[i]))
                return emptyResult()
            }
            types[i] = ct
            i += 1
        }
    }
    let t = tb.newTable(-1, "values")
    t.isTemp = true
    let i = 0
    while i < nc {
        if types[i] == v.T_UNKNOWN { types[i] = v.T_TEXT }
        tb.addColumn(t, tb.newColumn("column" + Text(i + 1), types[i], -1, false))
        i += 1
    }
    let j = 0
    while j < compiled.length {
        compiled[j] = coerce(pc, compiled[j], types[j % nc], -1, false)
        j += 1
    }
    let ti = ex.addTemp(p, t)
    let slot = newSlot(pc, t)
    let spec: List<Integer> = [rows.length, nc]
    for c in compiled { spec.add(c) }
    let blk = ex.listBlock(p, spec)
    let op = ex.addOp(p, ex.O_VALUES, -1, ti, slot, 0, blk, 0)
    let r = emptyResult()
    r.root = op
    i = 0
    while i < nc {
        r.exprs.add(ex.addExpr(p, ex.EX_COL, types[i], slot, i, 0, -1))
        let nm = "column" + Text(i + 1)
        if i < colNames.length { nm = colNames[i] }
        r.names.add(nm)
        r.types.add(types[i])
        r.mods.add(-1)
        i += 1
    }
    return r
}

function compileSetOp(pc: PC, q: Integer): QResult {
    let p = pc.p
    let nd = pc.a.nodes[q]
    let saveR = pc.rCount
    let left = compileQuery(pc, nd.children[ast.Q_LEFT])
    pc.rCount = saveR
    let right = compileQuery(pc, nd.children[ast.Q_RIGHT])
    pc.rCount = saveR
    if pc.err { return emptyResult() }
    if left.exprs.length != right.exprs.length {
        perr(pc, "42601", "each " + setOpName(nd.op) + " query must have the same number of columns", nd.position)
        return emptyResult()
    }
    let nc = left.exprs.length
    let t = tb.newTable(-1, "setop")
    t.isTemp = true
    let i = 0
    while i < nc {
        let ct = commonType(p.et[left.exprs[i]], p.et[right.exprs[i]])
        if ct < 0 {
            perr(pc, "42804", setOpName(nd.op) + " types " + v.typeName(p.et[left.exprs[i]]) + " and " + v.typeName(p.et[right.exprs[i]]) + " cannot be matched", nd.position)
            return emptyResult()
        }
        if ct == v.T_UNKNOWN { ct = v.T_TEXT }
        left.exprs[i] = coerce(pc, left.exprs[i], ct, -1, false)
        right.exprs[i] = coerce(pc, right.exprs[i], ct, -1, false)
        tb.addColumn(t, tb.newColumn(left.names[i], ct, -1, false))
        i += 1
    }
    tb.addColumn(t, tb.newColumn("lc", v.T_INT8, -1, false))
    tb.addColumn(t, tb.newColumn("rc", v.T_INT8, -1, false))
    let ti = ex.addTemp(p, t)
    let slot = newSlot(pc, t)
    let spec: List<Integer> = [nc]
    for e in left.exprs { spec.add(e) }
    spec.add(right.root)
    for e in right.exprs { spec.add(e) }
    let blk = ex.listBlock(p, spec)
    let mi = ex.addMap(p)
    let kind = 1
    if nd.op == ast.SETOP_INTERSECT { kind = 2 }
    if nd.op == ast.SETOP_EXCEPT { kind = 3 }
    if (nd.flags & ast.F_ALL) != 0 { kind = kind | 256 }
    let op = ex.addOp(p, ex.O_SETOP, left.root, ti, slot, kind, blk, mi)
    let r = emptyResult()
    r.root = op
    i = 0
    while i < nc {
        r.exprs.add(ex.addExpr(p, ex.EX_COL, v.sqlType(t.cols[i].type), slot, i, 0, -1))
        r.names.add(left.names[i])
        r.types.add(v.sqlType(t.cols[i].type))
        r.mods.add(-1)
        i += 1
    }
    return applyOrderLimit(pc, q, r)
}

function setOpName(op: Integer): Text {
    if op == ast.SETOP_INTERSECT { return "INTERSECT" }
    if op == ast.SETOP_EXCEPT { return "EXCEPT" }
    return "UNION"
}

// ---------------------------------------------------------------- FROM

record Leaf {
    op: Integer
    slot: Integer
    tableId: Integer
    slots: List<Integer>
    outer: Boolean
}

function slotBit(leaves: List<Leaf>, slot: Integer): Integer {
    let i = 0
    while i < leaves.length {
        for s in leaves[i].slots {
            if s == slot { return 1 << i }
        }
        i += 1
    }
    return 0
}

function allMask(leaves: List<Leaf>): Integer {
    return (1 << leaves.length) - 1
}

// Bitmask of leaves referenced by compiled expression n (correlated subqueries count as all leaves).
function exprMask(pc: PC, leaves: List<Leaf>, n: Integer): Integer {
    if n < 0 { return 0 }
    let p = pc.p
    let k = p.ek[n]
    if k == ex.EX_COL { return slotBit(leaves, p.ea[n]) }
    if k == ex.EX_CONST || k == ex.EX_PARAM || k == ex.EX_NOW { return 0 }
    if k == ex.EX_SUBQ || k == ex.EX_EXISTS {
        if p.ec[n] == 1 { return allMask(leaves) }
        return 0
    }
    if k == ex.EX_INSUB {
        let m = exprMask(pc, leaves, p.ea[n])
        if (p.ed[n] & 2) != 0 { m = allMask(leaves) }
        return m
    }
    if k == ex.EX_QUANT { return allMask(leaves) }
    if k == ex.EX_FUNC || k == ex.EX_COALESCE || k == ex.EX_GREATEST {
        let m = 0
        let i = 0
        while i < p.eb[n] {
            m = m | exprMask(pc, leaves, p.eargs[p.ea[n] + i])
            i += 1
        }
        return m
    }
    if k == ex.EX_CASE {
        let m = exprMask(pc, leaves, p.ed[n])
        let i = 0
        while i < p.ec[n] * 2 {
            m = m | exprMask(pc, leaves, p.eargs[p.eb[n] + i])
            i += 1
        }
        return m
    }
    if k == ex.EX_INLIST {
        let m = exprMask(pc, leaves, p.ea[n])
        let i = 0
        while i < (p.ec[n] & 1048575) {
            m = m | exprMask(pc, leaves, p.eargs[p.eb[n] + i])
            i += 1
        }
        return m
    }
    if k == ex.EX_LIKE {
        return exprMask(pc, leaves, p.ea[n]) | exprMask(pc, leaves, p.eb[n]) | exprMask(pc, leaves, p.ed[n])
    }
    if k == ex.EX_CAST || k == ex.EX_LITCAST || k == ex.EX_NOT || k == ex.EX_NEG || k == ex.EX_ISNULL || k == ex.EX_ISBOOL {
        return exprMask(pc, leaves, p.ea[n])
    }
    return exprMask(pc, leaves, p.ea[n]) | exprMask(pc, leaves, p.eb[n])
}

function addRangeForTable(pc: PC, alias: Text, slot: Integer, t: tb.Table, colAliases: List<Text>) {
    if colAliases.length > t.cols.length {
        perr(pc, "42P10", "table \"" + alias + "\" has " + Text(t.cols.length) + " columns available but " + Text(colAliases.length) + " columns specified", -1)
        return
    }
    let r = Range { name: alias; slot: slot; level: pc.level; tableId: t.id; cols: []; types: []; mods: []; hidden: [] }
    let i = 0
    for c in t.cols {
        let nm = c.name
        if i < colAliases.length { nm = colAliases[i] }
        r.cols.add(nm)
        r.types.add(v.sqlType(c.type))
        r.mods.add(c.typmod)
        r.hidden.add(false)
        i += 1
    }
    pushRange(pc, r)
}

function aliasColumns(pc: PC, aliasNode: Integer): List<Text> {
    let out: List<Text> = []
    if aliasNode < 0 { return out }
    for n in ast.items(pc.a, ast.child(pc.a, aliasNode, 0)) {
        out.add(pc.a.nodes[n].text)
    }
    return out
}

function splitAnd(pc: PC, id: Integer, out: List<Integer>) {
    if id < 0 { return }
    let nd = pc.a.nodes[id]
    if nd.kind == ast.K_BINARY_OP && nd.op == ast.OP_AND {
        splitAnd(pc, nd.children[0], out)
        splitAnd(pc, nd.children[1], out)
        return
    }
    out.add(id)
}

function compileFromItem(pc: PC, id: Integer, leaves: List<Leaf>, conjAst: List<Integer>) {
    if pc.err { return }
    let a = pc.a
    let k = ast.kind(a, id)
    let p = pc.p
    if k == ast.K_TABLE_REF {
        let name = a.nodes[id].text
        let aliasNode = ast.child(a, id, 1)
        let alias = name
        if aliasNode >= 0 { alias = a.nodes[aliasNode].text }
        let cteId = findCte(pc, name)
        if cteId >= 0 && ast.child(a, id, 0) < 0 {
            let q = ast.child(a, cteId, 0)
            let colNames = aliasColumns(pc, aliasNode)
            if colNames.length == 0 {
                for n in ast.items(a, ast.child(a, cteId, 1)) { colNames.add(a.nodes[n].text) }
            }
            compileDerived(pc, q, alias, colNames, leaves)
            return
        }
        let schema = ast.text(a, ast.child(a, id, 0))
        let tid = -1
        if schema == "" || schema == "public" { tid = findRel(pc.c, pc.p.env, name) }
        if tid < 0 && (schema == "pg_catalog" || schema == "information_schema" || (schema == "" && findViewTree(pc, name) < 0)) {
            let code = pgc.lookup(schema, name)
            if code > 0 {
                compileCatalogRel(pc, code, alias, aliasColumns(pc, aliasNode), leaves)
                return
            }
        }
        if tid < 0 {
            let vi = findViewTree(pc, name)
            if vi >= 0 {
                compileView(pc, vi, alias, aliasColumns(pc, aliasNode), leaves)
                return
            }
            perr(pc, "42P01", "relation \"" + name + "\" does not exist", a.nodes[id].position)
            return
        }
        let t = pc.c.tables[tid]
        pc.st.tableIds.add(tid)
        if isPartitioned(pc.views, pc.c, tid) && (a.nodes[id].flags & ast.F_ONLY) == 0 {
            compileAppend(pc, tid, alias, aliasColumns(pc, aliasNode), leaves)
            return
        }
        let slot = newSlot(pc, t)
        addRangeForTable(pc, alias, slot, t, aliasColumns(pc, aliasNode))
        leaves.add(Leaf { op: -1; slot: slot; tableId: tid; slots: [slot]; outer: false })
        return
    }
    if k == ast.K_SUBQUERY_REF {
        let aliasNode = ast.child(a, id, 1)
        let alias = ""
        if aliasNode >= 0 { alias = a.nodes[aliasNode].text }
        compileDerived(pc, ast.child(a, id, 0), alias, aliasColumns(pc, aliasNode), leaves)
        return
    }
    if k == ast.K_FUNC_REF {
        let fc = ast.child(a, id, 0)
        let fname = a.nodes[fc].text
        let aliasNode = ast.child(a, id, 1)
        let alias = fname
        if aliasNode >= 0 { alias = a.nodes[aliasNode].text }
        if fname != "generate_series" {
            perr(pc, "0A000", "function " + fname + " in FROM is not supported", a.nodes[id].position)
            return
        }
        let args = ast.items(a, ast.child(a, fc, 1))
        if args.length < 2 {
            perr(pc, "42883", "function generate_series needs 2 or 3 arguments", a.nodes[id].position)
            return
        }
        let e1 = compileExpr(pc, args[0])
        let e2 = compileExpr(pc, args[1])
        let e3 = -1
        if args.length > 2 { e3 = compileExpr(pc, args[2]) }
        if pc.err { return }
        let ty = v.T_INT4
        if p.et[e1] == v.T_INT8 || p.et[e2] == v.T_INT8 { ty = v.T_INT8 }
        e1 = coerce(pc, e1, v.T_INT8, -1, false)
        e2 = coerce(pc, e2, v.T_INT8, -1, false)
        if e3 >= 0 { e3 = coerce(pc, e3, v.T_INT8, -1, false) }
        let ca = aliasColumns(pc, aliasNode)
        let colName = alias
        if ca.length > 0 { colName = ca[0] }
        let t = tb.newTable(-1, "series")
        t.isTemp = true
        tb.addColumn(t, tb.newColumn(colName, ty, -1, false))
        let ti = ex.addTemp(p, t)
        let slot = newSlot(pc, t)
        let op = ex.addOp(p, ex.O_SERIES, slot, ti, e1, e2, e3, 0)
        let r = Range { name: alias; slot: slot; level: pc.level; tableId: -1; cols: [colName]; types: [ty]; mods: [-1]; hidden: [false] }
        pushRange(pc, r)
        leaves.add(Leaf { op: op; slot: -1; tableId: -1; slots: [slot]; outer: false })
        return
    }
    if k == ast.K_JOIN {
        let jt = a.nodes[id].op
        if (jt == ast.JOIN_INNER || jt == ast.JOIN_CROSS) && !hasOuterJoin(pc, id) {
            compileFromItem(pc, ast.child(a, id, 0), leaves, conjAst)
            let before = pc.rCount
            compileFromItem(pc, ast.child(a, id, 1), leaves, conjAst)
            if pc.err { return }
            let on = ast.child(a, id, 2)
            if on >= 0 { splitAnd(pc, on, conjAst) }
            if ast.child(a, id, 3) >= 0 || (a.nodes[id].flags & ast.F_NATURAL) != 0 {
                addUsingConjuncts(pc, id, before, conjAst)
            }
            return
        }
        compileOuterJoin(pc, id, leaves)
        return
    }
    perr(pc, "0A000", "unsupported FROM item " + ast.kindName(k), posOf(pc, id))
}

function hasOuterJoin(pc: PC, id: Integer): Boolean {
    if ast.kind(pc.a, id) != ast.K_JOIN { return false }
    let jt = pc.a.nodes[id].op
    if jt == ast.JOIN_LEFT || jt == ast.JOIN_RIGHT || jt == ast.JOIN_FULL { return true }
    return hasOuterJoin(pc, ast.child(pc.a, id, 0)) || hasOuterJoin(pc, ast.child(pc.a, id, 1))
}

// USING / NATURAL: equality conjuncts (as precompiled ids -(node+2)); the right side's columns get hidden.
function addUsingConjuncts(pc: PC, id: Integer, rightStart: Integer, conjAst: List<Integer>) {
    let names: List<Text> = []
    let usingList = ast.child(pc.a, id, 3)
    if usingList >= 0 {
        for n in ast.items(pc.a, usingList) { names.add(pc.a.nodes[n].text) }
    } else {
        let ri = rightStart
        while ri < pc.rCount {
            for cn in pc.ranges[ri].cols {
                let i = 0
                while i < rightStart {
                    let l = pc.ranges[i]
                    if l.level == pc.level {
                        for lc in l.cols {
                            if lc == cn {
                                let dup = false
                                for x in names {
                                    if x == cn { dup = true }
                                }
                                if !dup { names.add(cn) }
                            }
                        }
                    }
                    i += 1
                }
            }
            ri += 1
        }
    }
    for nm in names {
        let li = -1
        let lc = -1
        let i = rightStart - 1
        while i >= 0 && li < 0 {
            let l = pc.ranges[i]
            if l.level == pc.level {
                let j = 0
                while j < l.cols.length {
                    if l.cols[j] == nm && !l.hidden[j] && li < 0 {
                        li = i
                        lc = j
                    }
                    j += 1
                }
            }
            i -= 1
        }
        let ri = -1
        let rc = -1
        i = rightStart
        while i < pc.rCount && ri < 0 {
            let r = pc.ranges[i]
            let j = 0
            while j < r.cols.length {
                if r.cols[j] == nm && ri < 0 {
                    ri = i
                    rc = j
                }
                j += 1
            }
            i += 1
        }
        if li < 0 || ri < 0 {
            perr(pc, "42703", "column \"" + nm + "\" specified in USING clause does not exist in both tables", posOf(pc, id))
            return
        }
        let l = pc.ranges[li]
        let r = pc.ranges[ri]
        let ln = ex.addExpr(pc.p, ex.EX_COL, l.types[lc], l.slot, lc, 0, -1)
        let rn = ex.addExpr(pc.p, ex.EX_COL, r.types[rc], r.slot, rc, 0, -1)
        let c = makeCmp(pc, ast.OP_EQ, ln, rn, posOf(pc, id))
        conjAst.add(-(c + 2))
        r.hidden[rc] = true
    }
}

function compileDerived(pc: PC, q: Integer, alias: Text, colNames: List<Text>, leaves: List<Leaf>) {
    let p = pc.p
    let saveAgg = pc.aggActive
    pc.aggActive = false
    pc.level += 1
    let saveR = pc.rCount
    let saveMin = pc.minRef
    pc.minRef = 1000000
    let r = compileQuery(pc, q)
    pc.rCount = saveR
    pc.level -= 1
    pc.minRef = saveMin
    pc.aggActive = saveAgg
    if pc.err { return }
    if colNames.length > r.exprs.length {
        perr(pc, "42P10", "table \"" + alias + "\" has " + Text(r.exprs.length) + " columns available but " + Text(colNames.length) + " columns specified", -1)
        return
    }
    let t = tb.newTable(-1, alias)
    t.isTemp = true
    let i = 0
    while i < r.exprs.length {
        let e = r.exprs[i]
        if p.et[e] == v.T_UNKNOWN {
            e = coerce(pc, e, v.T_TEXT, -1, false)
            r.exprs[i] = e
        }
        let nm = r.names[i]
        if i < colNames.length { nm = colNames[i] }
        tb.addColumn(t, tb.newColumn(nm, p.et[e], -1, false))
        i += 1
    }
    let ti = ex.addTemp(p, t)
    let slot = newSlot(pc, t)
    let spec: List<Integer> = [r.exprs.length]
    for e in r.exprs { spec.add(e) }
    let blk = ex.listBlock(p, spec)
    let op = ex.addOp(p, ex.O_MAT, r.root, ti, slot, 0, blk, 0)
    let rg = Range { name: alias; slot: slot; level: pc.level; tableId: -1; cols: []; types: []; mods: []; hidden: [] }
    i = 0
    while i < t.cols.length {
        rg.cols.add(t.cols[i].name)
        rg.types.add(v.sqlType(t.cols[i].type))
        rg.mods.add(r.mods[i])
        rg.hidden.add(false)
        i += 1
    }
    pushRange(pc, rg)
    leaves.add(Leaf { op: op; slot: -1; tableId: -1; slots: [slot]; outer: false })
}

public record ViewCache {
    names: List<Text>
    trees: List<ast.Ast>
    roots: List<Integer>
    cols: List<List<Text>>
    // partitioning metadata (rebuilt by DDL replay), one entry per partitioned table or partition
    pTid: List<Integer>
    pParent: List<Integer>       // parent table id, -1 for a root
    pSpecTree: List<ast.Ast>     // CREATE TABLE holding PARTITION BY
    pSpec: List<Integer>         // K_PART_SPEC node, -1 for a leaf
    pBoundTree: List<ast.Ast>    // statement holding FOR VALUES
    pBound: List<Integer>        // K_PART_BOUND node, -1 for a root
}

public function findView(vc: ViewCache, name: Text): Integer {
    let i = vc.names.length - 1
    while i >= 0 {
        if vc.names[i] == name { return i }
        i -= 1
    }
    return -1
}

public function newViewCache(): ViewCache {
    return ViewCache { names: []; trees: []; roots: []; cols: []; pTid: []; pParent: []; pSpecTree: []; pSpec: []; pBoundTree: []; pBound: [] }
}

function findViewTree(pc: PC, name: Text): Integer {
    let i = pc.views.names.length - 1
    while i >= 0 {
        if pc.views.names[i] == name { return i }
        i -= 1
    }
    return -1
}

function compileView(pc: PC, vi: Integer, alias: Text, colNames: List<Text>, leaves: List<Leaf>) {
    let saveA = pc.a
    let saveTrack = pc.noTrack
    pc.a = pc.views.trees[vi]
    pc.noTrack = true
    let names = colNames
    if names.length == 0 { names = pc.views.cols[vi] }
    let saveCte = pc.cteCount
    pc.cteCount = 0
    compileDerived(pc, pc.views.roots[vi], alias, names, leaves)
    pc.cteCount = saveCte
    pc.a = saveA
    pc.noTrack = saveTrack
}

// Outer joins (and inner joins nested in them) compile as written into one leaf.
function compileOuterJoin(pc: PC, id: Integer, leaves: List<Leaf>) {
    let a = pc.a
    let jt = a.nodes[id].op
    if jt == ast.JOIN_FULL {
        perr(pc, "0A000", "FULL JOIN is not supported", a.nodes[id].position)
        return
    }
    let leftId = ast.child(a, id, 0)
    let rightId = ast.child(a, id, 1)
    let lLeaves: List<Leaf> = []
    let lConj: List<Integer> = []
    compileFromItem(pc, leftId, lLeaves, lConj)
    let before = pc.rCount
    let rLeaves: List<Leaf> = []
    let rConj: List<Integer> = []
    compileFromItem(pc, rightId, rLeaves, rConj)
    if pc.err { return }
    let onConj: List<Integer> = []
    let on = ast.child(a, id, 2)
    if on >= 0 { splitAnd(pc, on, onConj) }
    if ast.child(a, id, 3) >= 0 || (a.nodes[id].flags & ast.F_NATURAL) != 0 {
        addUsingConjuncts(pc, id, before, onConj)
    }
    // compile ON conjuncts
    let onNodes: List<Integer> = []
    for c in onConj {
        if c < 0 {
            onNodes.add(-(c + 2))
        } else {
            onNodes.add(coerceBool(pc, compileExpr(pc, c), "JOIN/ON", c))
        }
    }
    if pc.err { return }
    let lConjNodes = compileConjList(pc, lConj)
    let rConjNodes = compileConjList(pc, rConj)
    if pc.err { return }
    let outerSide = lLeaves
    let outerConj = lConjNodes
    let innerSide = rLeaves
    let innerConj = rConjNodes
    if jt == ast.JOIN_RIGHT {
        outerSide = rLeaves
        outerConj = rConjNodes
        innerSide = lLeaves
        innerConj = lConjNodes
    }
    let outerOp = planJoins(pc, outerSide, outerConj)
    let all: List<Leaf> = []
    for l in outerSide { all.add(l) }
    let innerStart = all.length
    for l in innerSide { all.add(l) }
    let outerMask = (1 << innerStart) - 1
    let innerMask = allMask(all) - outerMask
    // ON conjuncts that only touch the inner side are pushed into it
    let pushed: List<Integer> = []
    let rest: List<Integer> = []
    for n in onNodes {
        let m = exprMask(pc, all, n)
        if m != 0 && (m & outerMask) == 0 && jt != ast.JOIN_INNER && jt != ast.JOIN_CROSS {
            pushed.add(n)
        } else {
            rest.add(n)
        }
    }
    for n in innerConj { pushed.add(n) }
    let innerSlots: List<Integer> = []
    for l in innerSide {
        for s in l.slots { innerSlots.add(s) }
    }
    let joinType = 1
    if jt == ast.JOIN_INNER || jt == ast.JOIN_CROSS {
        joinType = 0
        for n in rest { pushed.add(n) }
        rest = []
    }
    let op = -1
    // index nested loop / hash join on an equality between outer and a single inner base leaf
    if innerSide.length == 1 && innerSide[0].op < 0 && joinType == 1 {
        let leaf = innerSide[0]
        let t = pc.c.tables[leaf.tableId]
        let used: List<Boolean> = []
        for n in rest { used.add(false) }
        let i = 0
        while i < rest.length && op < 0 {
            let n = rest[i]
            let col = eqColumnOf(pc, n, leaf.slot, all, outerMask)
            if col >= 0 {
                let other = otherSide(pc, n, leaf.slot)
                let hid = cat.findHashIndexOn(pc.c, t, col)
                if hid >= 0 && sameRepresentation(pc.p.et[other], t.cols[col].type) {
                    let keyBlk = ex.listBlock(pc.p, [1, other])
                    let key = keyIndex(pc, 1)
                    let inner = ex.addOp(pc.p, ex.O_HASHEQ, leaf.slot, hid, andChain(pc, pushed), keyBlk, key, 0)
                    used[i] = true
                    let remaining: List<Integer> = []
                    let j = 0
                    while j < rest.length {
                        if !used[j] { remaining.add(rest[j]) }
                        j += 1
                    }
                    let nb = ex.listBlock(pc.p, nullBlock(innerSlots))
                    op = ex.addOp(pc.p, ex.O_NL, outerOp, inner, andChain(pc, remaining), 1, nb, 0)
                }
            }
            i += 1
        }
    }
    if op < 0 {
        // inner side as one operator with its pushed conjuncts
        let innerOp = planJoins(pc, innerSide, pushed)
        // hash join on equalities between outer and inner
        let bkeys: List<Integer> = []
        let pkeys: List<Integer> = []
        let residual: List<Integer> = []
        for n in rest {
            let pair = equiPair(pc, n, all, outerMask, innerMask)
            if pair {
                let l = pc.p.ea[n]
                let r = pc.p.eb[n]
                if (exprMask(pc, all, l) & innerMask) != 0 {
                    bkeys.add(l)
                    pkeys.add(r)
                } else {
                    bkeys.add(r)
                    pkeys.add(l)
                }
            } else {
                residual.add(n)
            }
        }
        if bkeys.length > 0 {
            op = hashJoinOp(pc, outerOp, innerOp, bkeys, pkeys, residual, joinType, innerSlots)
        } else {
            let nb = ex.listBlock(pc.p, nullBlock(innerSlots))
            op = ex.addOp(pc.p, ex.O_NL, outerOp, innerOp, andChain(pc, rest), joinType, nb, 0)
        }
    }
    let slots: List<Integer> = []
    for l in all {
        for s in l.slots { slots.add(s) }
    }
    leaves.add(Leaf { op: op; slot: -1; tableId: -1; slots: slots; outer: true })
}

function nullBlock(slots: List<Integer>): List<Integer> {
    let out: List<Integer> = [slots.length]
    for s in slots { out.add(s) }
    return out
}

function compileConjList(pc: PC, conjAst: List<Integer>): List<Integer> {
    let out: List<Integer> = []
    for c in conjAst {
        if c < 0 {
            out.add(-(c + 2))
        } else {
            let n = coerceBool(pc, compileExpr(pc, c), "WHERE", c)
            if n < 0 || pc.err {
                return out
            }
            addQual(pc, n, out)
        }
    }
    return out
}

// PG canonicalize_qual: push NOT down (De Morgan, inverted comparisons, NOT NOT x = x) and flatten AND,
// so a NULL constant conjunct makes the whole qual false without evaluating anything else.
function addQual(pc: PC, n: Integer, out: List<Integer>) {
    let p = pc.p
    let k = p.ek[n]
    if k == ex.EX_AND {
        addQual(pc, p.ea[n], out)
        addQual(pc, p.eb[n], out)
        return
    }
    if k == ex.EX_NOT {
        let m = p.ea[n]
        let mk = p.ek[m]
        if mk == ex.EX_NOT {
            addQual(pc, p.ea[m], out)
            return
        }
        if mk == ex.EX_OR {
            addQual(pc, negateQual(pc, p.ea[m]), out)
            addQual(pc, negateQual(pc, p.eb[m]), out)
            return
        }
        if mk == ex.EX_CMP {
            out.add(negateQual(pc, m))
            return
        }
        if mk == ex.EX_CONST {
            out.add(negateQual(pc, m))
            return
        }
    }
    if k == ex.EX_INLIST && (p.ec[n] & 1048576) != 0 {
        // x NOT IN (..., NULL, ...) is never true
        let i = 0
        while i < (p.ec[n] & 1048575) {
            if isNullConst(pc, p.eargs[p.eb[n] + i]) {
                out.add(nullConst(pc, v.T_BOOL))
                return
            }
            i += 1
        }
    }
    out.add(n)
}

function negateQual(pc: PC, n: Integer): Integer {
    let p = pc.p
    let k = p.ek[n]
    if k == ex.EX_NOT { return p.ea[n] }
    if k == ex.EX_CONST && p.et[n] == v.T_BOOL && !isTrackedLiteral(pc, n) {
        if p.rNull[n] != 0 { return nullConst(pc, v.T_BOOL) }
        let c = constNode(pc, v.T_BOOL)
        ex.setIntReg(p, c, 1 - p.rInt[n])
        return c
    }
    if k == ex.EX_CMP {
        let op = p.ec[n]
        let inv = op
        if op == ex.OPR_EQ { inv = ex.OPR_NE }
        if op == ex.OPR_NE { inv = ex.OPR_EQ }
        if op == ex.OPR_LT { inv = ex.OPR_GE }
        if op == ex.OPR_LE { inv = ex.OPR_GT }
        if op == ex.OPR_GT { inv = ex.OPR_LE }
        if op == ex.OPR_GE { inv = ex.OPR_LT }
        return ex.addExpr(p, ex.EX_CMP, v.T_BOOL, p.ea[n], p.eb[n], inv, p.ed[n])
    }
    if k == ex.EX_AND {
        return ex.addExpr(p, ex.EX_OR, v.T_BOOL, negateQual(pc, p.ea[n]), negateQual(pc, p.eb[n]), 0, 0)
    }
    if k == ex.EX_OR {
        return ex.addExpr(p, ex.EX_AND, v.T_BOOL, negateQual(pc, p.ea[n]), negateQual(pc, p.eb[n]), 0, 0)
    }
    return ex.addExpr(p, ex.EX_NOT, v.T_BOOL, n, 0, 0, 0)
}

function andChain(pc: PC, nodes: List<Integer>): Integer {
    let r = -1
    for n in nodes {
        if r < 0 {
            r = n
        } else {
            r = ex.addExpr(pc.p, ex.EX_AND, v.T_BOOL, r, n, 0, 0)
        }
    }
    return r
}

function keyIndex(pc: PC, n: Integer): Integer {
    pc.p.keys.add(ix.newKey(n))
    return pc.p.keys.length - 1
}

// If n is `slotcol = expr` (either side) with expr not touching `slot` and within `allowedMask`, the column index.
function eqColumnOf(pc: PC, n: Integer, slot: Integer, leaves: List<Leaf>, allowedMask: Integer): Integer {
    let p = pc.p
    if p.ek[n] != ex.EX_CMP || p.ec[n] != ex.OPR_EQ { return -1 }
    let l = p.ea[n]
    let r = p.eb[n]
    let bit = slotBit(leaves, slot)
    if p.ek[l] == ex.EX_COL && p.ea[l] == slot {
        let m = exprMask(pc, leaves, r)
        if (m & bit) == 0 && (m & allowedMask) == m { return p.eb[l] }
    }
    if p.ek[r] == ex.EX_COL && p.ea[r] == slot {
        let m = exprMask(pc, leaves, l)
        if (m & bit) == 0 && (m & allowedMask) == m { return p.eb[r] }
    }
    return -1
}

function otherSide(pc: PC, n: Integer, slot: Integer): Integer {
    let p = pc.p
    let l = p.ea[n]
    if p.ek[l] == ex.EX_COL && p.ea[l] == slot { return p.eb[n] }
    return l
}

// Equality whose sides split between the two masks.
function equiPair(pc: PC, n: Integer, leaves: List<Leaf>, maskA: Integer, maskB: Integer): Boolean {
    let p = pc.p
    if p.ek[n] != ex.EX_CMP || p.ec[n] != ex.OPR_EQ { return false }
    let ml = exprMask(pc, leaves, p.ea[n])
    let mr = exprMask(pc, leaves, p.eb[n])
    if ml == 0 || mr == 0 { return false }
    if (ml & maskA) == ml && (mr & maskB) == mr { return true }
    if (ml & maskB) == ml && (mr & maskA) == mr { return true }
    return false
}

function hashJoinOp(pc: PC, probe: Integer, build: Integer, bkeys: List<Integer>, pkeys: List<Integer>, residual: List<Integer>, joinType: Integer, innerSlots: List<Integer>): Integer {
    let spec: List<Integer> = [bkeys.length]
    for b in bkeys { spec.add(b) }
    for q in pkeys { spec.add(q) }
    spec.add(innerSlots.length)
    for s in innerSlots { spec.add(s) }
    let blk = ex.listBlock(pc.p, spec)
    let mi = ex.addMap(pc.p)
    return ex.addOp(pc.p, ex.O_HASHJ, probe, build, andChain(pc, residual), joinType, blk, mi)
}

// Access path for one leaf with its pushed conjuncts (marks consumed entries in `used`).
function accessPath(pc: PC, leaves: List<Leaf>, li: Integer, conjs: List<Integer>, masks: List<Integer>, used: List<Boolean>): Integer {
    let leaf = leaves[li]
    let bit = 1 << li
    let mine: List<Integer> = []
    let i = 0
    while i < conjs.length {
        if !used[i] && masks[i] == bit {
            mine.add(i)
        }
        i += 1
    }
    if leaf.op >= 0 {
        let fs: List<Integer> = []
        for ci in mine {
            fs.add(conjs[ci])
            used[ci] = true
        }
        if fs.length == 0 { return leaf.op }
        return ex.addOp(pc.p, ex.O_FILTER, leaf.op, -1, andChain(pc, fs), 0, 0, 0)
    }
    let t = pc.c.tables[leaf.tableId]
    let slot = leaf.slot
    // 1. hash index fully covered by equalities with leaf-independent expressions
    for hid in t.hashIds {
        let h = pc.c.hashIdx[hid]
        let keyExprs: List<Integer> = []
        let keyConj: List<Integer> = []
        for col in h.cols {
            let found = -1
            for ci in mine {
                if found < 0 {
                    let c = eqColumnOf(pc, conjs[ci], slot, leaves, 0)
                    if c == col {
                        let other = otherSide(pc, conjs[ci], slot)
                        if sameRepresentation(pc.p.et[other], t.cols[col].type) { found = ci }
                    }
                }
            }
            if found >= 0 {
                keyExprs.add(otherSide(pc, conjs[found], slot))
                keyConj.add(found)
            }
        }
        if keyExprs.length == h.cols.length {
            let fs: List<Integer> = []
            for ci in mine {
                let isKey = false
                for kc in keyConj {
                    if kc == ci { isKey = true }
                }
                if !isKey { fs.add(conjs[ci]) }
                used[ci] = true
            }
            let spec: List<Integer> = [keyExprs.length]
            for e in keyExprs { spec.add(e) }
            let blk = ex.listBlock(pc.p, spec)
            let key = keyIndex(pc, keyExprs.length)
            return ex.addOp(pc.p, ex.O_HASHEQ, slot, hid, andChain(pc, fs), blk, key, 0)
        }
    }
    // 2. ordered index: equalities on a prefix of its columns, then an optional range on the next column
    let bestOrd = -1
    let bestScore = 0
    let bestEq: List<Integer> = []
    let bestEqC: List<Integer> = []
    let bestLo = -1
    let bestHi = -1
    let bestLoC = -1
    let bestHiC = -1
    let bestLoStrict = 0
    let bestHiStrict = 0
    for oid in t.ordIds {
        let o = pc.c.ordIdx[oid]
        let eqs: List<Integer> = []
        let eqC: List<Integer> = []
        let lo = -1
        let loStrict = 0
        let hi = -1
        let hiStrict = 0
        let loC = -1
        let hiC = -1
        let k = 0
        let stop = false
        while k < o.cols.length && !stop {
            let col = o.cols[k]
            let eqFound = -1
            let eqExpr = -1
            for ci in mine {
                let n = conjs[ci]
                let p = pc.p
                if p.ek[n] == ex.EX_CMP {
                    let op = p.ec[n]
                    let l = p.ea[n]
                    let r = p.eb[n]
                    let colOnLeft = p.ek[l] == ex.EX_COL && p.ea[l] == slot && p.eb[l] == col && exprMask(pc, leaves, r) == 0
                    let colOnRight = p.ek[r] == ex.EX_COL && p.ea[r] == slot && p.eb[r] == col && exprMask(pc, leaves, l) == 0
                    if colOnLeft || colOnRight {
                        let other = r
                        if colOnRight {
                            other = l
                            op = flipOp(op)
                        }
                        if sameRepresentation(p.et[other], t.cols[col].type) {
                            if op == ex.OPR_EQ {
                                if eqFound < 0 {
                                    eqFound = ci
                                    eqExpr = other
                                }
                            } else {
                                if (op == ex.OPR_GE || op == ex.OPR_GT) && lo < 0 {
                                    lo = other
                                    loC = ci
                                    loStrict = 0
                                    if op == ex.OPR_GT { loStrict = 1 }
                                }
                                if (op == ex.OPR_LE || op == ex.OPR_LT) && hi < 0 {
                                    hi = other
                                    hiC = ci
                                    hiStrict = 0
                                    if op == ex.OPR_LT { hiStrict = 1 }
                                }
                            }
                        }
                    }
                }
            }
            if eqFound >= 0 {
                eqs.add(eqExpr)
                eqC.add(eqFound)
                lo = -1
                hi = -1
                loC = -1
                hiC = -1
                k += 1
            } else {
                stop = true
            }
        }
        let score = eqs.length * 2
        if lo >= 0 || hi >= 0 { score += 1 }
        if score > bestScore {
            bestScore = score
            bestOrd = oid
            bestEq = eqs
            bestEqC = eqC
            bestLo = lo
            bestHi = hi
            bestLoC = loC
            bestHiC = hiC
            bestLoStrict = loStrict
            bestHiStrict = hiStrict
        }
    }
    if bestOrd >= 0 {
        let fs: List<Integer> = []
        for ci in mine {
            // with an equality prefix, NULLs in the range column sort inside the bounds: keep range conjuncts as filters
            let consumed = (ci == bestLoC || ci == bestHiC) && bestEq.length == 0
            for x in bestEqC {
                if x == ci { consumed = true }
            }
            if !consumed { fs.add(conjs[ci]) }
            used[ci] = true
        }
        let loN = bestEq.length
        if bestLo >= 0 { loN += 1 }
        let hiN = bestEq.length
        if bestHi >= 0 { hiN += 1 }
        let loS = bestLoStrict
        if bestLo < 0 { loS = 0 }
        let hiS = bestHiStrict
        if bestHi < 0 { hiS = 0 }
        let spec: List<Integer> = [loN, loS, hiN, hiS, keyIndex(pc, loN), keyIndex(pc, hiN), 0]
        for x in bestEq { spec.add(x) }
        if bestLo >= 0 { spec.add(bestLo) }
        for x in bestEq { spec.add(x) }
        if bestHi >= 0 { spec.add(bestHi) }
        let blk = ex.listBlock(pc.p, spec)
        return ex.addOp(pc.p, ex.O_RANGE, slot, bestOrd, andChain(pc, fs), blk, 0, 0)
    }
    let fs: List<Integer> = []
    for ci in mine {
        fs.add(conjs[ci])
        used[ci] = true
    }
    return ex.addOp(pc.p, ex.O_SCAN, slot, leaf.tableId, andChain(pc, fs), 0, 0, 0)
}

function flipOp(op: Integer): Integer {
    if op == ex.OPR_LT { return ex.OPR_GT }
    if op == ex.OPR_LE { return ex.OPR_GE }
    if op == ex.OPR_GT { return ex.OPR_LT }
    if op == ex.OPR_GE { return ex.OPR_LE }
    return op
}

// Hash index of base leaf lf whose every column is bound by an unused equality whose other side only uses
// constants or leaves in inSet (and at least one key part references inSet). Fills key expressions / conjuncts in
// index column order. Returns the hash index id or -1.
function coveringHash(pc: PC, leaves: List<Leaf>, lf: Leaf, conjs: List<Integer>, used: List<Boolean>, inSet: Integer,
                      keyExprs: List<Integer>, keyConjs: List<Integer>): Integer {
    let t = pc.c.tables[lf.tableId]
    for hid in t.hashIds {
        let h = pc.c.hashIdx[hid]
        let ke: List<Integer> = []
        let kc: List<Integer> = []
        let joins = false
        let ok = true
        for col in h.cols {
            let found = -1
            let ci = 0
            while ci < conjs.length && found < 0 {
                if !used[ci] && eqColumnOf(pc, conjs[ci], lf.slot, leaves, inSet) == col {
                    let other = otherSide(pc, conjs[ci], lf.slot)
                    if sameRepresentation(pc.p.et[other], t.cols[col].type) {
                        found = ci
                        ke.add(other)
                        kc.add(ci)
                        if exprMask(pc, leaves, other) != 0 { joins = true }
                    }
                }
                ci += 1
            }
            if found < 0 { ok = false }
        }
        if ok && joins {
            for x in ke { keyExprs.add(x) }
            for x in kc { keyConjs.add(x) }
            return hid
        }
    }
    return -1
}

function leafHasIndexedConst(pc: PC, leaves: List<Leaf>, li: Integer, conjs: List<Integer>, masks: List<Integer>): Boolean {
    let leaf = leaves[li]
    if leaf.op >= 0 { return false }
    let t = pc.c.tables[leaf.tableId]
    let i = 0
    while i < conjs.length {
        if masks[i] == (1 << li) {
            let c = eqColumnOf(pc, conjs[i], leaf.slot, leaves, 0)
            if c >= 0 && cat.findHashIndexOn(pc.c, t, c) >= 0 { return true }
        }
        i += 1
    }
    return false
}

function leafSize(pc: PC, leaf: Leaf): Integer {
    if leaf.op >= 0 { return 1000 }
    return pc.c.tables[leaf.tableId].nrows
}

// Greedy join planning over leaves with conjuncts.
function planJoins(pc: PC, leaves: List<Leaf>, conjs: List<Integer>): Integer {
    let p = pc.p
    if pc.err { return -1 }
    let masks: List<Integer> = []
    let used: List<Boolean> = []
    for c in conjs {
        masks.add(exprMask(pc, leaves, c))
        used.add(false)
    }
    if leaves.length == 0 {
        let one = ex.addOp(p, ex.O_ONE, 0, 0, 0, 0, 0, 0)
        if conjs.length == 0 { return one }
        return ex.addOp(p, ex.O_FILTER, one, -1, andChain(pc, conjs), 0, 0, 0)
    }
    if leaves.length > 60 {
        perr(pc, "54000", "too many tables in FROM", -1)
        return -1
    }
    for c in conjs {
        if p.ek[c] == ex.EX_CONST && (p.rNull[c] != 0 || p.rInt[c] == 0) && !isTrackedLiteral(pc, c) {
            // WHERE/ON FALSE: PG plans a one-time filter and never evaluates the inputs
            let one = ex.addOp(p, ex.O_ONE, 0, 0, 0, 0, 0, 0)
            return ex.addOp(p, ex.O_FILTER, one, -1, c, 0, 0, 0)
        }
    }
    // start leaf: an empty base table first (the join produces nothing and nothing else is evaluated,
    // like PG), then one with an indexed constant lookup
    let start = -1
    let i = 0
    while i < leaves.length && start < 0 {
        if leaves.length > 1 && leaves[i].op < 0 && pc.c.tables[leaves[i].tableId].live == 0 && pc.c.tables[leaves[i].tableId].chunk < 0 { start = i }
        i += 1
    }
    i = 0
    while i < leaves.length && start < 0 {
        if leafHasIndexedConst(pc, leaves, i, conjs, masks) { start = i }
        i += 1
    }
    if start < 0 {
        // largest base table first (it streams as the probe side)
        let best = -1
        i = 0
        while i < leaves.length {
            if leaves.length > 1 && (best < 0 || leafSize(pc, leaves[i]) > leafSize(pc, leaves[best])) { best = i }
            i += 1
        }
        start = best
        if start < 0 { start = 0 }
    }
    let cur = accessPath(pc, leaves, start, conjs, masks, used)
    let inSet = 1 << start
    let joined = 1
    while joined < leaves.length {
        // choose next leaf
        let bestLeaf = -1
        let bestKind = 0
        let j = 0
        while j < leaves.length {
            if (inSet & (1 << j)) == 0 {
                let kind = 1
                let ci = 0
                while ci < conjs.length {
                    if !used[ci] && equiPair(pc, conjs[ci], leaves, inSet, 1 << j) {
                        if kind < 2 { kind = 2 }
                        let lf = leaves[j]
                        if lf.op < 0 && kind < 3 {
                            let ke: List<Integer> = []
                            let kc: List<Integer> = []
                            if coveringHash(pc, leaves, lf, conjs, used, inSet, ke, kc) >= 0 { kind = 3 }
                        }
                    }
                    ci += 1
                }
                if kind > bestKind {
                    bestKind = kind
                    bestLeaf = j
                }
            }
            j += 1
        }
        let nl = bestLeaf
        let bit = 1 << nl
        let newSet = inSet | bit
        let leaf = leaves[nl]
        let innerSlots: List<Integer> = []
        for s in leaf.slots { innerSlots.add(s) }
        if bestKind == 3 {
            // index nested loop: a hash index of the inner table whose columns are all bound by equalities to
            // constants or to columns of the tables joined so far (composite keys included)
            let keyExprs: List<Integer> = []
            let keyConjs: List<Integer> = []
            let hid = coveringHash(pc, leaves, leaf, conjs, used, inSet, keyExprs, keyConjs)
            if hid >= 0 {
                for kc in keyConjs { used[kc] = true }
                let fs: List<Integer> = []
                let ci = 0
                while ci < conjs.length {
                    if !used[ci] && masks[ci] == bit {
                        fs.add(conjs[ci])
                        used[ci] = true
                    }
                    ci += 1
                }
                let kb: List<Integer> = [keyExprs.length]
                for x in keyExprs { kb.add(x) }
                let keyBlk = ex.listBlock(p, kb)
                let inner = ex.addOp(p, ex.O_HASHEQ, leaf.slot, hid, andChain(pc, fs), keyBlk, keyIndex(pc, keyExprs.length), 0)
                let cond: List<Integer> = []
                ci = 0
                while ci < conjs.length {
                    if !used[ci] && (masks[ci] & newSet) == masks[ci] && masks[ci] != 0 {
                        cond.add(conjs[ci])
                        used[ci] = true
                    }
                    ci += 1
                }
                let nb = ex.listBlock(p, nullBlock(innerSlots))
                cur = ex.addOp(p, ex.O_NL, cur, inner, andChain(pc, cond), 0, nb, 0)
                inSet = newSet
                joined += 1
                continue
            }
            bestKind = 2
        }
        let innerOp = accessPath(pc, leaves, nl, conjs, masks, used)
        if bestKind == 2 {
            let bkeys: List<Integer> = []
            let pkeys: List<Integer> = []
            let residual: List<Integer> = []
            let ci = 0
            while ci < conjs.length {
                if !used[ci] && (masks[ci] & newSet) == masks[ci] && masks[ci] != 0 {
                    let n = conjs[ci]
                    if equiPair(pc, n, leaves, inSet, bit) {
                        let l = p.ea[n]
                        let r = p.eb[n]
                        if (exprMask(pc, leaves, l) & bit) != 0 {
                            bkeys.add(l)
                            pkeys.add(r)
                        } else {
                            bkeys.add(r)
                            pkeys.add(l)
                        }
                    } else {
                        residual.add(n)
                    }
                    used[ci] = true
                }
                ci += 1
            }
            cur = hashJoinOp(pc, cur, innerOp, bkeys, pkeys, residual, 0, innerSlots)
        } else {
            let cond: List<Integer> = []
            let ci = 0
            while ci < conjs.length {
                if !used[ci] && (masks[ci] & newSet) == masks[ci] && masks[ci] != 0 {
                    cond.add(conjs[ci])
                    used[ci] = true
                }
                ci += 1
            }
            let nb = ex.listBlock(p, nullBlock(innerSlots))
            cur = ex.addOp(p, ex.O_NL, cur, innerOp, andChain(pc, cond), 0, nb, 0)
        }
        inSet = newSet
        joined += 1
    }
    let rest: List<Integer> = []
    i = 0
    while i < conjs.length {
        if !used[i] { rest.add(conjs[i]) }
        i += 1
    }
    if rest.length > 0 {
        cur = ex.addOp(p, ex.O_FILTER, cur, -1, andChain(pc, rest), 0, 0, 0)
    }
    return cur
}

// ---------------------------------------------------------------- SELECT

function collectAggs(pc: PC, id: Integer, out: List<Integer>) {
    if id < 0 { return }
    let nd = pc.a.nodes[id]
    let k = nd.kind
    if k == ast.K_SELECT || k == ast.K_SET_OP || k == ast.K_VALUES { return }
    if k == ast.K_FUNC_CALL && isAggCall(pc, id) {
        out.add(id)
        return
    }
    for c in nd.children { collectAggs(pc, c, out) }
}

function aggKind(name: Text, star: Boolean): Integer {
    if name == "count" {
        if star { return ex.AG_COUNT_STAR }
        return ex.AG_COUNT
    }
    if name == "sum" { return ex.AG_SUM }
    if name == "avg" { return ex.AG_AVG }
    if name == "min" { return ex.AG_MIN }
    if name == "max" { return ex.AG_MAX }
    if name == "bool_and" || name == "every" { return ex.AG_BOOL_AND }
    if name == "bool_or" { return ex.AG_BOOL_OR }
    if name == "string_agg" { return ex.AG_STRING_AGG }
    if name == "stddev_pop" { return ex.AG_STDDEV_POP }
    if name == "var_pop" { return ex.AG_VAR_POP }
    if name == "stddev" || name == "stddev_samp" { return ex.AG_STDDEV }
    if name == "any_value" { return ex.AG_ANY_VALUE }
    let k2 = twoArgAggKind(name)
    if k2 > 0 { return k2 }
    return ex.AG_VARIANCE
}

function compileSelect(pc: PC, q: Integer): QResult {
    let saveSrfAst = pc.srfAst
    let saveSrfSlot = pc.srfSlot
    let saveSrfKind = pc.srfKind
    let saveWinSlot = pc.winSlot
    let saveWinTable = pc.winTable
    let saveWinEval = pc.winEval
    let saveWinSpec = pc.winSpec
    pc.srfSlot = -1
    pc.winSlot = -1
    let r0 = compileSelectInner(pc, q)
    pc.srfAst = saveSrfAst
    pc.srfSlot = saveSrfSlot
    pc.srfKind = saveSrfKind
    pc.winSlot = saveWinSlot
    pc.winTable = saveWinTable
    pc.winEval = saveWinEval
    pc.winSpec = saveWinSpec
    return r0
}

function compileSelectInner(pc: PC, q: Integer): QResult {
    let a = pc.a
    let p = pc.p
    let nd = a.nodes[q]
    if (nd.flags & ast.F_DISTINCT_ON) != 0 {
        perr(pc, "0A000", "DISTINCT ON is not supported", nd.position)
        return emptyResult()
    }
    if ast.child(a, q, ast.Q_WINDOWS) >= 0 {
        perr(pc, "0A000", "window functions are not supported", nd.position)
        return emptyResult()
    }
    let leaves: List<Leaf> = []
    let conjAst: List<Integer> = []
    for item in ast.items(a, ast.child(a, q, ast.Q_FROM)) {
        compileFromItem(pc, item, leaves, conjAst)
    }
    if pc.err { return emptyResult() }
    splitAnd(pc, ast.child(a, q, ast.Q_WHERE), conjAst)
    let conjs = compileConjList(pc, conjAst)
    if pc.err { return emptyResult() }
    let root = planJoins(pc, leaves, conjs)
    if pc.err { return emptyResult() }
    // targets (expand stars)
    let tgtExprAst: List<Integer> = []
    let tgtNames: List<Text> = []
    let starSlot: List<Integer> = []
    let starCol: List<Integer> = []
    if ast.items(a, ast.child(a, q, ast.Q_TARGETS)).length > 1664 {
        perr(pc, "54011", "target lists can have at most 1664 entries", -1)
        return emptyResult()
    }
    for t in ast.items(a, ast.child(a, q, ast.Q_TARGETS)) {
        let e = ast.child(a, t, 0)
        if ast.kind(a, e) == ast.K_STAR {
            let qual = ast.qualifier(a, e)
            let any = false
            let ri = 0
            while ri < pc.rCount {
                let r = pc.ranges[ri]
                if r.level == pc.level && (qual == "" || r.name == qual) {
                    let ci = 0
                    while ci < r.cols.length {
                        if !(qual == "" && r.hidden[ci]) {
                            tgtExprAst.add(-1)
                            tgtNames.add(r.cols[ci])
                            starSlot.add(ri)
                            starCol.add(ci)
                            any = true
                        }
                        ci += 1
                    }
                }
                ri += 1
            }
            if !any && qual != "" {
                perr(pc, "42P01", "missing FROM-clause entry for table \"" + qual + "\"", a.nodes[e].position)
                return emptyResult()
            }
            if !any && qual == "" && leaves.length == 0 {
                perr(pc, "42601", "SELECT * with no tables specified is not valid", a.nodes[e].position)
                return emptyResult()
            }
        } else {
            tgtExprAst.add(e)
            tgtNames.add(a.nodes[t].text)
            starSlot.add(-1)
            starCol.add(-1)
        }
    }
    // aggregation?
    let aggs: List<Integer> = []
    for e in tgtExprAst { collectAggs(pc, e, aggs) }
    let having = ast.child(a, q, ast.Q_HAVING)
    collectAggs(pc, having, aggs)
    let ob = ast.child(a, q, ast.Q_ORDER_BY)
    for si in ast.items(a, ob) { collectAggs(pc, ast.child(a, si, 0), aggs) }
    let gb = ast.child(a, q, ast.Q_GROUP_BY)
    let saveAggActive = pc.aggActive
    let saveGroupAst = pc.groupAst
    let saveGroupNodes = pc.groupNodes
    let saveAggAst = pc.aggAst
    let saveAggSlot = pc.aggSlot
    let saveAggLevel = pc.aggLevel
    let grouped = aggs.length > 0 || gb >= 0 || having >= 0
    if grouped {
        let groupAst: List<Integer> = []
        for g in ast.items(a, gb) {
            let gk = ast.kind(a, g)
            if gk == ast.K_GROUPING_SET {
                perr(pc, "0A000", "GROUPING SETS / ROLLUP / CUBE are not supported", a.nodes[g].position)
                return emptyResult()
            }
            if gk == ast.K_INT_LIT {
                pin(pc, g)
                let idx = a.nodes[g].intValue - 1
                if idx < 0 || idx >= tgtExprAst.length || tgtExprAst[idx] < 0 {
                    perr(pc, "42P10", "GROUP BY position " + Text(idx + 1) + " is not in select list", a.nodes[g].position)
                    return emptyResult()
                }
                groupAst.add(tgtExprAst[idx])
            } else if gk == ast.K_COLUMN_REF && ast.items(a, g).length == 0 && !columnVisible(pc, a.nodes[g].text) {
                let idx = -1
                let i = 0
                while i < tgtNames.length {
                    if tgtNames[i] == a.nodes[g].text && tgtExprAst[i] >= 0 && idx < 0 { idx = i }
                    i += 1
                }
                if idx >= 0 { groupAst.add(tgtExprAst[idx]) } else { groupAst.add(g) }
            } else {
                groupAst.add(g)
            }
        }
        // compile group expressions and aggregate arguments over the input
        pc.aggActive = false
        pc.collecting = true
        let groupNodes: List<Integer> = []
        for g in groupAst {
            let n = compileExpr(pc, g)
            if pc.err { return emptyResult() }
            if p.et[n] == v.T_UNKNOWN { n = coerce(pc, n, v.T_TEXT, -1, false) }
            groupNodes.add(n)
        }
        let t = tb.newTable(-1, "agg")
        t.isTemp = true
        let i = 0
        while i < groupNodes.length {
            tb.addColumn(t, tb.newColumn("g" + Text(i), p.et[groupNodes[i]], -1, false))
            i += 1
        }
        let spec: List<Integer> = [groupNodes.length]
        for g in groupNodes { spec.add(g) }
        spec.add(aggs.length)
        let aggTypes: List<Integer> = []
        let nTwoArg = 0
        for ag in aggs {
            let an = a.nodes[ag]
            let star = (an.flags & ast.F_FUNC_STAR) != 0
            let kind = aggKind(an.text, star)
            let args = ast.items(a, an.children[1])
            let arg = -1
            let arg2 = -1
            let twoArg = kind >= ex.AG_REGR_COUNT && kind <= ex.AG_CORR
            if !star {
                if args.length < 1 || (twoArg && args.length != 2) {
                    perr(pc, "42883", "function " + an.text + "() does not exist", an.position)
                    return emptyResult()
                }
                arg = compileExpr(pc, args[0])
                if pc.err { return emptyResult() }
                if twoArg {
                    arg2 = compileExpr(pc, args[1])
                    if pc.err { return emptyResult() }
                    if numRank(p.et[arg]) == 0 && p.et[arg] != v.T_UNKNOWN || numRank(p.et[arg2]) == 0 && p.et[arg2] != v.T_UNKNOWN {
                        perr(pc, "42883", "function " + an.text + "(" + v.typeName(p.et[arg]) + ", " + v.typeName(p.et[arg2]) + ") does not exist", an.position)
                        return emptyResult()
                    }
                    arg = coerce(pc, arg, v.T_FLOAT8, -1, false)
                    arg2 = coerce(pc, arg2, v.T_FLOAT8, -1, false)
                }
                if p.et[arg] == v.T_UNKNOWN { arg = coerce(pc, arg, v.T_TEXT, -1, false) }
            }
            let at = v.T_INT8
            if arg >= 0 { at = p.et[arg] }
            let rt = v.T_INT8
            if kind == ex.AG_SUM {
                if at == v.T_INT2 || at == v.T_INT4 { rt = v.T_INT8 }
                else if at == v.T_INT8 || at == v.T_NUMERIC { rt = v.T_NUMERIC }
                else if at == v.T_FLOAT4 { rt = v.T_FLOAT4 }
                else if at == v.T_FLOAT8 { rt = v.T_FLOAT8 }
                else {
                    perr(pc, "42883", "function sum(" + v.typeName(at) + ") does not exist", an.position)
                    return emptyResult()
                }
            } else if kind == ex.AG_AVG || kind == ex.AG_STDDEV || kind == ex.AG_VARIANCE || kind == ex.AG_STDDEV_POP || kind == ex.AG_VAR_POP {
                if at == v.T_FLOAT4 || at == v.T_FLOAT8 { rt = v.T_FLOAT8 }
                else if numRank(at) > 0 { rt = v.T_NUMERIC }
                else {
                    perr(pc, "42883", "function " + an.text + "(" + v.typeName(at) + ") does not exist", an.position)
                    return emptyResult()
                }
            } else if kind == ex.AG_MIN || kind == ex.AG_MAX {
                rt = at
                if at == v.T_VARCHAR || at == v.T_NAME {
                    rt = v.T_TEXT
                    arg = coerce(pc, arg, v.T_TEXT, -1, false)
                }
            } else if kind == ex.AG_BOOL_AND || kind == ex.AG_BOOL_OR {
                arg = coerceBool(pc, arg, an.text, ag)
                rt = v.T_BOOL
            } else if kind == ex.AG_STRING_AGG {
                arg = coerceText(pc, arg)
                rt = v.T_TEXT
            } else if kind == ex.AG_ANY_VALUE {
                rt = at
            } else if twoArg {
                rt = v.T_FLOAT8
                if kind == ex.AG_REGR_COUNT { rt = v.T_INT8 }
            }
            aggTypes.add(rt)
            let distinct = 0
            let extra = -1
            let dtiSlot = -1
            if (an.flags & ast.F_FUNC_DISTINCT) != 0 && arg >= 0 && !twoArg {
                let dt = tb.newTable(-1, "dist")
                dt.isTemp = true
                tb.addColumn(dt, tb.newColumn("v", p.et[arg], -1, false))
                tb.addColumn(dt, tb.newColumn("g", v.T_INT8, -1, false))
                dtiSlot = ex.addTemp(p, dt)
                let dmi = ex.addMap(p)
                distinct = dmi + 1
            }
            if kind == ex.AG_MIN || kind == ex.AG_MAX {
                extra = ex.addExpr(p, ex.EX_CONST, rt, 0, 0, 0, 0)
            }
            if kind == ex.AG_STRING_AGG {
                let sep = textConst(pc, ",")
                if args.length > 1 { sep = coerceText(pc, compileExpr(pc, args[1])) }
                extra = sep
            }
            let rcol = -1
            if twoArg {
                rcol = groupNodes.length + 3 * aggs.length + 4 * nTwoArg
                nTwoArg += 1
            }
            let filt = -1
            if an.children[2] >= 0 { filt = coerceBool(pc, compileExpr(pc, an.children[2]), "FILTER", ag) }
            if pc.err { return emptyResult() }
            spec.add(kind)
            spec.add(arg)
            spec.add(distinct)
            spec.add(filt)
            spec.add(extra)
            spec.add(dtiSlot)
            spec.add(arg2)
            spec.add(rcol)
        }
        pc.collecting = false
        i = 0
        while i < aggs.length {
            let ct = aggTypes[i]
            let col = tb.newColumn("a" + Text(i), ct, -1, false)
            tb.addColumn(t, col)
            i += 1
        }
        i = 0
        while i < aggs.length {
            tb.addColumn(t, tb.newColumn("n" + Text(i), v.T_INT8, -1, false))
            let qt = v.T_FLOAT8
            if aggTypes[i] == v.T_NUMERIC { qt = v.T_NUMERIC }
            tb.addColumn(t, tb.newColumn("q" + Text(i), qt, -1, false))
            i += 1
        }
        // regression aggregates: Sxx, Syy, Sxy, Sy (Sx lives in q, N in n)
        i = 0
        while i < nTwoArg * 4 {
            tb.addColumn(t, tb.newColumn("r" + Text(i), v.T_FLOAT8, -1, false))
            i += 1
        }
        let ti = ex.addTemp(p, t)
        let aslot = newSlot(pc, t)
        let blk = ex.listBlock(p, spec)
        let mi = ex.addMap(p)
        root = ex.addOp(p, ex.O_AGG, root, ti, aslot, 0, blk, mi)
        pc.aggActive = true
        pc.aggLevel = pc.level
        pc.aggSlot = aslot
        pc.groupAst = groupAst
        pc.groupNodes = groupNodes
        pc.aggAst = aggs
        if having >= 0 {
            let hn = coerceBool(pc, compileExpr(pc, having), "HAVING", having)
            if pc.err { return emptyResult() }
            root = ex.addOp(p, ex.O_FILTER, root, -1, hn, 0, 0, 0)
        }
    }
    // set-returning function in the select list (runs once per input row, after WHERE / GROUP BY / HAVING)
    let srf = -1
    for e in tgtExprAst {
        if srf < 0 && e >= 0 { srf = findSrf(pc, e) }
    }
    if srf >= 0 {
        root = setupSrf(pc, srf, root)
        if pc.err { return emptyResult() }
    }
    // window functions: their rows are materialised by O_WINDOW; expressions compiled from here on read it
    let winOp = -1
    let winNodeStart = 0
    let winSlotLimit = 0
    let hasWin = false
    for e in tgtExprAst {
        if e >= 0 && hasWindowCall(pc, e) { hasWin = true }
    }
    for si in ast.items(a, ob) {
        if hasWindowCall(pc, ast.child(a, si, 0)) { hasWin = true }
    }
    if hasWin {
        let wt = tb.newTable(-1, "window")
        wt.isTemp = true
        let wti = ex.addTemp(p, wt)
        winSlotLimit = p.slotTable.length
        pc.winSlot = newSlot(pc, wt)
        pc.winTable = wt
        pc.winEval = []
        pc.winSpec = []
        winNodeStart = p.ek.length
        winOp = ex.addOp(p, ex.O_WINDOW, root, wti, pc.winSlot, 0, 0, ex.addMap(p))
        root = winOp
    }
    let r = emptyResult()
    let i = 0
    while i < tgtExprAst.length {
        let e = tgtExprAst[i]
        let n = -1
        let mod = -1
        if e < 0 {
            let rg = pc.ranges[starSlot[i]]
            if pc.aggActive {
                // star with grouping: each column must be grouped
                let colAst = -1
                n = -1
                let gi = 0
                while gi < pc.groupNodes.length {
                    let gn = pc.groupNodes[gi]
                    if p.ek[gn] == ex.EX_COL && p.ea[gn] == rg.slot && p.eb[gn] == starCol[i] {
                        n = ex.addExpr(p, ex.EX_COL, p.et[gn], pc.aggSlot, gi, 0, -1)
                    }
                    gi += 1
                }
                if n < 0 {
                    perr(pc, "42803", "column \"" + rg.name + "." + rg.cols[starCol[i]] + "\" must appear in the GROUP BY clause or be used in an aggregate function", nd.position)
                    return emptyResult()
                }
                let unusedColAst = colAst
            } else {
                n = ex.addExpr(p, ex.EX_COL, rg.types[starCol[i]], rg.slot, starCol[i], 0, -1)
            }
            mod = rg.mods[starCol[i]]
        } else {
            n = compileExpr(pc, e)
            if pc.err { return emptyResult() }
            if p.ek[n] == ex.EX_COL && !pc.aggActive { mod = p.ed[n] }
        }
        r.exprs.add(n)
        r.names.add(tgtNames[i])
        r.types.add(p.et[n])
        r.mods.add(mod)
        i += 1
    }
    r.root = root
    // DISTINCT (PG resolves untyped literal outputs to text here)
    if (nd.flags & ast.F_DISTINCT) != 0 {
        i = 0
        while i < r.exprs.length {
            if p.et[r.exprs[i]] == v.T_UNKNOWN {
                r.exprs[i] = coerce(pc, r.exprs[i], v.T_TEXT, -1, false)
                r.types[i] = v.T_TEXT
            }
            i += 1
        }
        let t = tb.newTable(-1, "distinct")
        t.isTemp = true
        let spec: List<Integer> = [r.exprs.length]
        i = 0
        while i < r.exprs.length {
            tb.addColumn(t, tb.newColumn("d" + Text(i), p.et[r.exprs[i]], -1, false))
            spec.add(r.exprs[i])
            i += 1
        }
        let ti = ex.addTemp(p, t)
        let blk = ex.listBlock(p, spec)
        let mi = ex.addMap(p)
        r.root = ex.addOp(p, ex.O_DISTINCT, r.root, ti, 0, 0, blk, mi)
    }
    // ORDER BY
    if ob >= 0 {
        let keys: List<Integer> = []
        let desc: List<Integer> = []
        let nf: List<Integer> = []
        for si in ast.items(a, ob) {
            let e = ast.child(a, si, 0)
            let key = -1
            let ek = ast.kind(a, e)
            if ek == ast.K_INT_LIT {
                pin(pc, e)
                let idx = a.nodes[e].intValue - 1
                if idx < 0 || idx >= r.exprs.length {
                    perr(pc, "42P10", "ORDER BY position " + Text(idx + 1) + " is not in select list", a.nodes[e].position)
                    return emptyResult()
                }
                key = r.exprs[idx]
            } else if ek == ast.K_COLUMN_REF && ast.items(a, e).length == 0 {
                let idx = -1
                let j = 0
                while j < r.names.length {
                    if r.names[j] == a.nodes[e].text {
                        if idx >= 0 && !astEqual(pc, tgtExprAst[idx], tgtExprAst[j]) {
                            perr(pc, "42702", "ORDER BY \"" + a.nodes[e].text + "\" is ambiguous", a.nodes[e].position)
                            return emptyResult()
                        }
                        if idx < 0 { idx = j }
                    }
                    j += 1
                }
                if idx >= 0 { key = r.exprs[idx] }
            }
            if key < 0 {
                let j = 0
                while j < tgtExprAst.length && key < 0 {
                    if tgtExprAst[j] >= 0 && astEqual(pc, tgtExprAst[j], e) { key = r.exprs[j] }
                    j += 1
                }
            }
            if key < 0 {
                if (nd.flags & ast.F_DISTINCT) != 0 {
                    perr(pc, "42P10", "for SELECT DISTINCT, ORDER BY expressions must appear in select list", a.nodes[e].position)
                    return emptyResult()
                }
                key = compileExpr(pc, e)
                if pc.err { return emptyResult() }
            }
            // a constant sort key does not order anything (PG drops it)
            if !isConstGeneral(pc, key) {
                keys.add(key)
                let d = sortDesc(pc, si)
                desc.add(d)
                nf.add(nullsFirstOf(pc, si, d == 1))
            }
        }
        if keys.length > 0 { r = addSort(pc, r, keys, desc, nf) }
    }
    if winOp >= 0 {
        finishWindow(pc, winOp, winNodeStart, winSlotLimit)
        if pc.err { return emptyResult() }
    }
    pc.aggActive = saveAggActive
    pc.groupAst = saveGroupAst
    pc.groupNodes = saveGroupNodes
    pc.aggAst = saveAggAst
    pc.aggSlot = saveAggSlot
    pc.aggLevel = saveAggLevel
    return applyLimit(pc, q, r)
}

function columnVisible(pc: PC, name: Text): Boolean {
    let i = pc.rCount - 1
    while i >= 0 {
        let r = pc.ranges[i]
        if r.level == pc.level {
            for c in r.cols {
                if c == name { return true }
            }
        }
        i -= 1
    }
    return false
}

// ---------------------------------------------------------------- DML

function targetTable(pc: PC, ref: Integer): Integer {
    if pc.targetOverride >= 0 {
        pc.st.tableIds.add(pc.targetOverride)
        return pc.targetOverride
    }
    let name = pc.a.nodes[ref].text
    let tid = findRel(pc.c, pc.p.env, name)
    if tid < 0 {
        perr(pc, "42P01", "relation \"" + name + "\" does not exist", pc.a.nodes[ref].position)
    } else {
        pc.st.tableIds.add(tid)
    }
    return tid
}

function defaultExpr(pc: PC, t: tb.Table, ci: Integer): Integer {
    let c = t.cols[ci]
    let ct = v.sqlType(c.type)
    if c.defaultKind == 0 { return nullConst(pc, ct) }
    if c.defaultKind == 2 {
        let n = intConst(pc, 0, ct)
        pc.st.serialNodes.add(n)
        return n
    }
    if c.defaultKind == 3 {
        let n = ex.addExpr(pc.p, ex.EX_NOW, v.T_TIMESTAMPTZ, 0, 0, 0, 0)
        return coerce(pc, n, ct, c.typmod, false)
    }
    if c.defaultNull { return nullConst(pc, ct) }
    let n = constNode(pc, v.T_UNKNOWN)
    let b = Bytes(c.defaultText)
    ex.setTextReg(pc.p, n, b, 0, b.length)
    return coerce(pc, n, ct, c.typmod, false)
}

function assignExpr(pc: PC, t: tb.Table, ci: Integer, id: Integer): Integer {
    if ast.kind(pc.a, id) == ast.K_DEFAULT { return defaultExpr(pc, t, ci) }
    let n = compileExpr(pc, id)
    if n < 0 { return -1 }
    return assignCoerce(pc, t, ci, n, id)
}

function assignCoerce(pc: PC, t: tb.Table, ci: Integer, n: Integer, id: Integer): Integer {
    let c = t.cols[ci]
    let ct = v.sqlType(c.type)
    let from = pc.p.et[n]
    if from != v.T_UNKNOWN && commonType(from, ct) < 0 && !(v.isTextType(ct)) {
        perr(pc, "42804", "column \"" + c.name + "\" is of type " + v.typeName(ct) + " but expression is of type " + v.typeName(from), posOf(pc, id))
        return -1
    }
    let explicit = false
    if v.isTextType(ct) && !v.isTextType(from) { explicit = true }
    return coerce(pc, n, ct, c.typmod, explicit)
}

function compileInsert(pc: PC, id: Integer) {
    let a = pc.a
    let st = pc.st
    let tid = targetTable(pc, ast.child(a, id, 0))
    if pc.err { return }
    registerWith(pc, ast.child(a, id, 5))
    if pc.err { return }
    let t = pc.c.tables[tid]
    st.tableId = tid
    let ncols = t.cols.length
    // column mapping: target position -> table column
    let colMap: List<Integer> = []
    let colList = ast.child(a, id, 1)
    if colList >= 0 {
        for cn in ast.items(a, colList) {
            let ci = tb.columnIndex(t, a.nodes[cn].text)
            if ci < 0 {
                perr(pc, "42703", "column \"" + a.nodes[cn].text + "\" of relation \"" + t.name + "\" does not exist", a.nodes[cn].position)
                return
            }
            for x in colMap {
                if x == ci {
                    perr(pc, "42701", "column \"" + a.nodes[cn].text + "\" specified more than once", a.nodes[cn].position)
                    return
                }
            }
            colMap.add(ci)
        }
    } else {
        let i = 0
        while i < ncols {
            colMap.add(i)
            i += 1
        }
    }
    let src = ast.child(a, id, 2)
    if src < 0 {
        // DEFAULT VALUES
        let i = 0
        while i < ncols {
            st.rowExprs.add(defaultExpr(pc, t, i))
            i += 1
        }
        st.nRows = 1
    } else if ast.kind(a, src) == ast.K_VALUES && ast.child(a, src, ast.Q_ORDER_BY) < 0 && ast.child(a, src, ast.Q_LIMIT) < 0 {
        let rows = ast.items(a, ast.child(a, src, ast.Q_ROWS))
        for row in rows {
            let items = ast.items(a, row)
            if items.length > colMap.length {
                perr(pc, "42601", "INSERT has more expressions than target columns", posOf(pc, row))
                return
            }
            let rowNodes: List<Integer> = []
            let i = 0
            while i < ncols {
                rowNodes.add(-3)
                i += 1
            }
            i = 0
            while i < items.length {
                let ci = colMap[i]
                rowNodes[ci] = assignExpr(pc, t, ci, items[i])
                if pc.err { return }
                i += 1
            }
            if items.length < colMap.length && colList >= 0 {
                perr(pc, "42601", "INSERT has more target columns than expressions", posOf(pc, row))
                return
            }
            i = 0
            while i < ncols {
                if rowNodes[i] == -3 { rowNodes[i] = defaultExpr(pc, t, i) }
                st.rowExprs.add(rowNodes[i])
                i += 1
            }
            st.nRows += 1
        }
    } else {
        pc.level += 1
        let r = compileQuery(pc, src)
        pc.level -= 1
        if pc.err { return }
        if r.exprs.length > colMap.length {
            perr(pc, "42601", "INSERT has more expressions than target columns", posOf(pc, src))
            return
        }
        st.root = r.root
        let rowNodes: List<Integer> = []
        let i = 0
        while i < ncols {
            rowNodes.add(-3)
            i += 1
        }
        i = 0
        while i < r.exprs.length {
            let ci = colMap[i]
            rowNodes[ci] = assignCoerce(pc, t, ci, r.exprs[i], src)
            if pc.err { return }
            i += 1
        }
        i = 0
        while i < ncols {
            if rowNodes[i] == -3 { rowNodes[i] = defaultExpr(pc, t, i) }
            st.srcExprs.add(rowNodes[i])
            i += 1
        }
    }
    let oc = ast.child(a, id, 3)
    if oc >= 0 {
        if a.nodes[oc].op == ast.CONFLICT_NOTHING {
            st.conflict = 1
        } else {
            compileConflictUpdate(pc, id, oc, t)
            if pc.err { return }
        }
    }
    compileReturning(pc, t, ast.child(a, id, 4))
    if partIndex(pc.views, tid) >= 0 { buildRoute(pc, tid, tid) }
}

function compileReturning(pc: PC, t: tb.Table, list: Integer) {
    let st = pc.st
    if st.slot < 0 {
        st.slot = newSlot(pc, t)
        addRangeForTable(pc, displayName(t.name), st.slot, t, [])
    }
    if list < 0 { return }
    st.returning = true
    for tg in ast.items(pc.a, list) {
        let e = ast.child(pc.a, tg, 0)
        if ast.kind(pc.a, e) == ast.K_STAR {
            let i = 0
            while i < t.cols.length {
                st.outExprs.add(ex.addExpr(pc.p, ex.EX_COL, v.sqlType(t.cols[i].type), st.slot, i, 0, -1))
                st.outNames.add(t.cols[i].name)
                st.outTypes.add(v.sqlType(t.cols[i].type))
                st.outMods.add(t.cols[i].typmod)
                i += 1
            }
        } else {
            let n = compileExpr(pc, e)
            if pc.err { return }
            if pc.p.et[n] == v.T_UNKNOWN { n = coerce(pc, n, v.T_TEXT, -1, false) }
            st.outExprs.add(n)
            st.outNames.add(pc.a.nodes[tg].text)
            st.outTypes.add(pc.p.et[n])
            st.outMods.add(-1)
        }
    }
}

function targetScope(pc: PC, ref: Integer, t: tb.Table): List<Leaf> {
    let a = pc.a
    let aliasNode = ast.child(a, ref, 1)
    let alias = displayName(t.name)
    if pc.targetAlias != "" { alias = pc.targetAlias }
    if aliasNode >= 0 { alias = a.nodes[aliasNode].text }
    let slot = newSlot(pc, t)
    pc.st.slot = slot
    addRangeForTable(pc, alias, slot, t, [])
    let leaves: List<Leaf> = [Leaf { op: -1; slot: slot; tableId: t.id; slots: [slot]; outer: false }]
    return leaves
}

function compileUpdate(pc: PC, id: Integer) {
    let a = pc.a
    let ref = ast.child(a, id, 0)
    let tid = targetTable(pc, ref)
    if pc.err { return }
    registerWith(pc, ast.child(a, id, 5))
    if pc.err { return }
    let base = pc.rCount
    compileUpdateTarget(pc, id, tid, ref)
    if pc.err { return }
    partitionDml(pc, id, tid, ref, base)
}

// UPDATE of one target table (the statement's, or one leaf of a partitioned target): scope, FROM, WHERE, SET
// and RETURNING compiled into pc.st.
function compileUpdateTarget(pc: PC, id: Integer, tid: Integer, ref: Integer) {
    let a = pc.a
    let st = pc.st
    let t = pc.c.tables[tid]
    st.tableId = tid
    st.fromBuf = -1
    let leaves = targetScope(pc, ref, t)
    let conjAst: List<Integer> = []
    let fromList = ast.child(a, id, 2)
    for item in ast.items(a, fromList) { compileFromItem(pc, item, leaves, conjAst) }
    if pc.err { return }
    splitAnd(pc, ast.child(a, id, 3), conjAst)
    let conjs = compileConjList(pc, conjAst)
    if pc.err { return }
    st.root = planJoins(pc, leaves, conjs)
    if pc.err { return }
    for item in ast.items(a, ast.child(a, id, 1)) {
        if ast.kind(a, item) == ast.K_MULTI_SET {
            compileMultiSet(pc, t, item)
            if pc.err { return }
            continue
        }
        let ci = setColumn(pc, t, a.nodes[item].text, item)
        if ci < 0 { return }
        if ast.child(a, item, 1) >= 0 {
            perr(pc, "0A000", "assignment to subscripts or fields is not supported", posOf(pc, item))
            return
        }
        let n = assignExpr(pc, t, ci, ast.child(a, item, 0))
        if pc.err { return }
        st.setCols.add(ci)
        st.setExprs.add(n)
    }
    if fromList >= 0 {
        // SET values are computed while the join is positioned (dml.collectTargets) and kept here
        let fb = tb.newTable(-1, "setbuf")
        fb.isTemp = true
        for n in st.setExprs { tb.addColumn(fb, tb.newColumn("s", pc.p.et[n], -1, false)) }
        st.fromBuf = ex.addTemp(pc.p, fb)
    }
    compileReturning(pc, t, ast.child(a, id, 4))
}

// ON CONFLICT (...) DO UPDATE SET ... [WHERE ...]: the existing row is the target slot, the proposed one
// is "excluded" (a one-row buffer).
function compileConflictUpdate(pc: PC, id: Integer, oc: Integer, t: tb.Table) {
    let a = pc.a
    let st = pc.st
    // arbiter: unique hash index on exactly the listed columns, or the named constraint
    let hid = -1
    let cname = a.nodes[oc].text
    let targetCols = ast.child(a, oc, 0)
    if cname != "" {
        for h in t.hashIds {
            if pc.c.hashIdx[h].name == cname && pc.c.hashIdx[h].unique { hid = h }
        }
        if hid < 0 {
            perr(pc, "42704", "constraint \"" + cname + "\" for table \"" + displayName(t.name) + "\" does not exist", posOf(pc, oc))
            return
        }
    } else if targetCols >= 0 {
        let cols: List<Integer> = []
        for e in ast.items(a, targetCols) {
            if ast.kind(a, e) != ast.K_COLUMN_REF {
                perr(pc, "42P10", "there is no unique or exclusion constraint matching the ON CONFLICT specification", posOf(pc, e))
                return
            }
            let ci = tb.columnIndex(t, a.nodes[e].text)
            if ci < 0 {
                perr(pc, "42703", "column \"" + a.nodes[e].text + "\" does not exist", posOf(pc, e))
                return
            }
            cols.add(ci)
        }
        for h in t.hashIds {
            let hx = pc.c.hashIdx[h]
            if hx.unique && hid < 0 && sameColumnSet(hx.cols, cols) { hid = h }
        }
        if hid < 0 {
            perr(pc, "42P10", "there is no unique or exclusion constraint matching the ON CONFLICT specification", posOf(pc, oc))
            return
        }
    } else {
        perr(pc, "42601", "ON CONFLICT DO UPDATE requires inference specification or constraint name", posOf(pc, oc))
        return
    }
    st.conflict = 2
    st.conflictHid = hid
    // scope: target table (existing row) and excluded (proposed row)
    let ref = ast.child(a, id, 0)
    let alias = displayName(t.name)
    if ast.child(a, ref, 1) >= 0 { alias = a.nodes[ast.child(a, ref, 1)].text }
    if st.slot < 0 {
        st.slot = newSlot(pc, t)
        addRangeForTable(pc, alias, st.slot, t, [])
    }
    let excl = tb.newTable(-1, "excluded")
    excl.isTemp = true
    for col in t.cols { tb.addColumn(excl, tb.newColumn(col.name, col.type, col.typmod, false)) }
    tb.reserveRow(excl, 0)
    st.exclTemp = ex.addTemp(pc.p, excl)
    st.exclSlot = newSlot(pc, excl)
    addRangeForTable(pc, "excluded", st.exclSlot, excl, [])
    for item in ast.items(a, ast.child(a, oc, 1)) {
        if ast.kind(a, item) == ast.K_MULTI_SET {
            compileMultiSet(pc, t, item)
            if pc.err { return }
            continue
        }
        let ci = setColumn(pc, t, a.nodes[item].text, item)
        if ci < 0 { return }
        let n = assignExpr(pc, t, ci, ast.child(a, item, 0))
        if pc.err { return }
        st.setCols.add(ci)
        st.setExprs.add(n)
    }
    let w = ast.child(a, oc, 2)
    if w >= 0 { st.conflictWhere = coerceBool(pc, compileExpr(pc, w), "WHERE", w) }
}

function sameColumnSet(x: List<Integer>, y: List<Integer>): Boolean {
    if x.length != y.length { return false }
    for a in x {
        let found = false
        for b in y {
            if a == b { found = true }
        }
        if !found { return false }
    }
    return true
}

// WITH attached to INSERT / UPDATE / DELETE: its CTEs are visible to the whole statement.
function registerWith(pc: PC, withN: Integer) {
    if withN < 0 { return }
    if ast.hasFlag(pc.a, withN, ast.F_RECURSIVE) {
        perr(pc, "0A000", "WITH RECURSIVE is not supported", posOf(pc, withN))
        return
    }
    for cte in ast.items(pc.a, ast.child(pc.a, withN, 0)) {
        let body = ast.child(pc.a, cte, 0)
        if !ast.isQuery(pc.a, body) {
            perr(pc, "0A000", "data-modifying statements in WITH are not supported", posOf(pc, cte))
            return
        }
        addCte(pc, pc.a.nodes[cte].text, cte)
    }
}

// Column index of a SET target (errors for unknown and repeated columns).
function setColumn(pc: PC, t: tb.Table, name: Text, item: Integer): Integer {
    let ci = tb.columnIndex(t, name)
    if ci < 0 {
        perr(pc, "42703", "column \"" + name + "\" of relation \"" + displayName(t.name) + "\" does not exist", posOf(pc, item))
        return -1
    }
    for x in pc.st.setCols {
        if x == ci {
            perr(pc, "42601", "multiple assignments to same column \"" + name + "\"", posOf(pc, item))
            return -1
        }
    }
    return ci
}

// (a, b, ...) = (expr, ...) | ROW(...) | (SELECT ...)
function compileMultiSet(pc: PC, t: tb.Table, item: Integer) {
    let a = pc.a
    let st = pc.st
    let names = ast.items(a, ast.child(a, item, 0))
    let val = ast.child(a, item, 1)
    let cols: List<Integer> = []
    for nm in names {
        let ci = setColumn(pc, t, a.nodes[nm].text, nm)
        if ci < 0 { return }
        cols.add(ci)
        st.setCols.add(ci)
        st.setExprs.add(-1)
    }
    let base = st.setExprs.length - cols.length
    let vk = ast.kind(a, val)
    if vk == ast.K_SUBQUERY_EXPR {
        let nodes = compileSubqueryColumns(pc, ast.child(a, val, 0), cols.length, val)
        if pc.err { return }
        let i = 0
        while i < cols.length {
            st.setExprs[base + i] = assignCoerce(pc, t, cols[i], nodes[i], val)
            if pc.err { return }
            i += 1
        }
        return
    }
    if vk != ast.K_ROW_EXPR {
        perr(pc, "0A000", "source for a multiple-column UPDATE item must be a sub-SELECT or ROW() expression", posOf(pc, val))
        return
    }
    let items = ast.items(a, ast.child(a, val, 0))
    // ROW(v.*) expands to the columns of v
    let exprs: List<Integer> = []
    let fromStar: List<Boolean> = []
    for it in items {
        if ast.kind(a, it) == ast.K_STAR {
            for n in starColumns(pc, it) {
                exprs.add(n)
                fromStar.add(true)
            }
            if pc.err { return }
        } else {
            exprs.add(it)
            fromStar.add(false)
        }
    }
    if exprs.length != cols.length {
        perr(pc, "42601", "number of columns does not match number of values", posOf(pc, val))
        return
    }
    let i = 0
    while i < cols.length {
        if fromStar[i] {
            st.setExprs[base + i] = assignCoerce(pc, t, cols[i], exprs[i], val)
        } else {
            st.setExprs[base + i] = assignExpr(pc, t, cols[i], exprs[i])
        }
        if pc.err { return }
        i += 1
    }
}

// Compiled column references for t.* (or * over the current level).
function starColumns(pc: PC, star: Integer): List<Integer> {
    let out: List<Integer> = []
    let qual = ast.qualifier(pc.a, star)
    let ri = 0
    while ri < pc.rCount {
        let r = pc.ranges[ri]
        if r.level == pc.level && (qual == "" || r.name == qual) {
            let ci = 0
            while ci < r.cols.length {
                if !(qual == "" && r.hidden[ci]) { out.add(ex.addExpr(pc.p, ex.EX_COL, r.types[ci], r.slot, ci, 0, r.mods[ci])) }
                ci += 1
            }
        }
        ri += 1
    }
    if out.length == 0 && qual != "" { perr(pc, "42P01", "missing FROM-clause entry for table \"" + qual + "\"", posOf(pc, star)) }
    return out
}

// A row subquery used for several columns: one scalar-subquery node per output column.
function compileSubqueryColumns(pc: PC, q: Integer, ncols: Integer, id: Integer): List<Integer> {
    let p = pc.p
    let out: List<Integer> = []
    let saveAgg = pc.aggActive
    let saveCollect = pc.collecting
    let saveMin = pc.minRef
    pc.aggActive = false
    pc.collecting = false
    pc.level += 1
    pc.minRef = 1000000
    let saveR = pc.rCount
    let r = compileQuery(pc, q)
    let correlated = pc.minRef < pc.level
    pc.rCount = saveR
    pc.level -= 1
    let innerMin = pc.minRef
    pc.minRef = saveMin
    if innerMin < pc.minRef { pc.minRef = innerMin }
    pc.aggActive = saveAgg
    pc.collecting = saveCollect
    if pc.err { return out }
    if r.exprs.length != ncols {
        perr(pc, "42601", "number of columns does not match number of values", posOf(pc, id))
        return out
    }
    let corr = 0
    if correlated { corr = 1 }
    for e in r.exprs {
        let o = e
        if p.et[o] == v.T_UNKNOWN { o = coerce(pc, o, v.T_TEXT, -1, false) }
        out.add(ex.addExpr(p, ex.EX_SUBQ, p.et[o], r.root, o, corr, 0))
    }
    return out
}

function compileDelete(pc: PC, id: Integer) {
    let a = pc.a
    let ref = ast.child(a, id, 0)
    let tid = targetTable(pc, ref)
    if pc.err { return }
    registerWith(pc, ast.child(a, id, 4))
    if pc.err { return }
    let base = pc.rCount
    compileDeleteTarget(pc, id, tid, ref)
    if pc.err { return }
    partitionDml(pc, id, tid, ref, base)
}

function compileDeleteTarget(pc: PC, id: Integer, tid: Integer, ref: Integer) {
    let a = pc.a
    let st = pc.st
    let t = pc.c.tables[tid]
    st.tableId = tid
    let leaves = targetScope(pc, ref, t)
    let conjAst: List<Integer> = []
    for item in ast.items(a, ast.child(a, id, 1)) { compileFromItem(pc, item, leaves, conjAst) }
    if pc.err { return }
    splitAnd(pc, ast.child(a, id, 2), conjAst)
    let conjs = compileConjList(pc, conjAst)
    if pc.err { return }
    st.root = planJoins(pc, leaves, conjs)
    compileReturning(pc, t, ast.child(a, id, 3))
}

// Compile a standalone expression (column defaults, CHECK) against a table: used by DDL.
public function typeOfName(name: Text): Integer {
    return typeFromName(name)
}

// ---------------------------------------------------------------- partitioning

public record Route {
    buf: tb.Table               // one-row buffer with the routing root's columns
    bufSlot: Integer
    check: Integer              // the root's own partition constraint (its ancestors' bounds), -1 if none
    rootName: Text
    rootTid: Integer
    nodeTid: List<Integer>      // routing nodes: partitioned tables, node 0 = the root when partitioned
    nodeFirst: List<Integer>
    nodeCount: List<Integer>
    chTid: List<Integer>        // children of the routing nodes
    chBound: List<Integer>      // boolean expression over the buffer: the row belongs to this child
    chNode: List<Integer>       // routing node of a partitioned child, else -1
    chLeaf: List<Integer>       // leaf index of a leaf child, else -1
    leafTid: List<Integer>
    leafRegs: List<List<Integer>>  // registers in leaf column order (loaded from the buffer)
    leafMap: List<List<Integer>>   // leaf column -> buffer column
    bufRegs: List<Integer>         // one register per buffer column (UPDATE builds the new row through them)
}

public function partIndex(vc: ViewCache, tid: Integer): Integer {
    let i = 0
    while i < vc.pTid.length {
        if vc.pTid[i] == tid { return i }
        i += 1
    }
    return -1
}

// Entry for table tid (created empty if missing).
public function partEnsure(vc: ViewCache, tid: Integer): Integer {
    let i = partIndex(vc, tid)
    if i >= 0 { return i }
    vc.pTid.add(tid)
    vc.pParent.add(-1)
    vc.pSpecTree.add(ast.newAst())
    vc.pSpec.add(-1)
    vc.pBoundTree.add(ast.newAst())
    vc.pBound.add(-1)
    return vc.pTid.length - 1
}

// Live table: not dropped and not hidden by a pending DROP in an open transaction.
public function tableLive(c: cat.Catalog, tid: Integer): Boolean {
    if tid < 0 || tid >= c.tables.length { return false }
    let t = c.tables[tid]
    if cat.isDropped(t) { return false }
    return !(t.name.length > 15 && t.name.slice(0, 15) == "pg_neo_dropped_")
}

public function isPartitioned(vc: ViewCache, c: cat.Catalog, tid: Integer): Boolean {
    let i = partIndex(vc, tid)
    return i >= 0 && vc.pSpec[i] >= 0 && tableLive(c, tid)
}

public function partParentOf(vc: ViewCache, c: cat.Catalog, tid: Integer): Integer {
    let i = partIndex(vc, tid)
    if i < 0 { return -1 }
    let par = vc.pParent[i]
    if !tableLive(c, par) { return -1 }
    return par
}

public function partStrategy(vc: ViewCache, tid: Integer): Integer {
    let i = partIndex(vc, tid)
    if i < 0 || vc.pSpec[i] < 0 { return 0 }
    return vc.pSpecTree[i].nodes[vc.pSpec[i]].op
}

function isDefaultBound(vc: ViewCache, i: Integer): Boolean {
    let b = vc.pBound[i]
    return b >= 0 && vc.pBoundTree[i].nodes[b].op == ast.PB_DEFAULT
}

// Live children of a partitioned table, default partition last.
public function partChildren(vc: ViewCache, c: cat.Catalog, tid: Integer): List<Integer> {
    let out: List<Integer> = []
    let def: List<Integer> = []
    let i = 0
    while i < vc.pTid.length {
        if vc.pParent[i] == tid && tableLive(c, vc.pTid[i]) {
            if isDefaultBound(vc, i) { def.add(vc.pTid[i]) } else { out.add(vc.pTid[i]) }
        }
        i += 1
    }
    for d in def { out.add(d) }
    return out
}

public function partDefaultChild(vc: ViewCache, c: cat.Catalog, tid: Integer): Integer {
    let i = 0
    while i < vc.pTid.length {
        if vc.pParent[i] == tid && tableLive(c, vc.pTid[i]) && isDefaultBound(vc, i) { return vc.pTid[i] }
        i += 1
    }
    return -1
}

// Leaf partitions under tid (depth first, bounded depth).
public function partLeaves(vc: ViewCache, c: cat.Catalog, tid: Integer): List<Integer> {
    let out: List<Integer> = []
    collectLeaves(vc, c, tid, out, 0)
    return out
}

function collectLeaves(vc: ViewCache, c: cat.Catalog, tid: Integer, out: List<Integer>, depth: Integer) {
    if depth > 64 { return }
    if !isPartitioned(vc, c, tid) {
        out.add(tid)
        return
    }
    for ch in partChildren(vc, c, tid) { collectLeaves(vc, c, ch, out, depth + 1) }
}

// All descendants (partitioned and leaf), parents before children.
public function partDescendants(vc: ViewCache, c: cat.Catalog, tid: Integer): List<Integer> {
    let out: List<Integer> = []
    collectDescendants(vc, c, tid, out, 0)
    return out
}

function collectDescendants(vc: ViewCache, c: cat.Catalog, tid: Integer, out: List<Integer>, depth: Integer) {
    if depth > 64 { return }
    for ch in partChildren(vc, c, tid) {
        out.add(ch)
        collectDescendants(vc, c, ch, out, depth + 1)
    }
}

public function displayName(name: Text): Text {
    if !isTempName(name) { return name }
    let i = 8
    while i < name.length && name[i] != '.' { i += 1 }
    if i >= name.length { return name }
    return name.slice(i + 1, name.length)
}

// SELECT over a partitioned table: its leaves appended into one materialized result (columns matched by name).
function compileAppend(pc: PC, tid: Integer, alias: Text, colAliases: List<Text>, leaves: List<Leaf>) {
    let p = pc.p
    let t = pc.c.tables[tid]
    let out = tb.newTable(-1, alias)
    out.isTemp = true
    for col in t.cols { tb.addColumn(out, tb.newColumn(col.name, col.type, col.typmod, false)) }
    let spec: List<Integer> = [0]
    let nchild = 0
    for lt in partLeaves(pc.views, pc.c, tid) {
        if lt == tid { continue }
        let leaf = pc.c.tables[lt]
        pc.st.tableIds.add(lt)
        let ls = newSlot(pc, leaf)
        let scan = ex.addOp(p, ex.O_SCAN, ls, 0, -1, 0, 0, 0)
        spec.add(scan)
        spec.add(t.cols.length)
        for col in t.cols {
            let li = tb.columnIndex(leaf, col.name)
            if li < 0 {
                spec.add(nullConst(pc, col.type))
            } else {
                spec.add(ex.addExpr(p, ex.EX_COL, leaf.cols[li].type, ls, li, 0, leaf.cols[li].typmod))
            }
        }
        nchild += 1
    }
    spec[0] = nchild
    let ti = ex.addTemp(p, out)
    let slot = newSlot(pc, out)
    let blk = ex.listBlock(p, spec)
    let op = ex.addOp(p, ex.O_APPEND, -1, ti, slot, 0, blk, 0)
    addRangeForTable(pc, alias, slot, out, colAliases)
    leaves.add(Leaf { op: op; slot: -1; tableId: -1; slots: [slot]; outer: false })
}

// Partition key expressions of partitioned table ptid, compiled against the current scope.
function compileKeys(pc: PC, ptid: Integer): List<Integer> {
    let out: List<Integer> = []
    let i = partIndex(pc.views, ptid)
    if i < 0 || pc.views.pSpec[i] < 0 { return out }
    let saveA = pc.a
    let saveTrack = pc.noTrack
    pc.a = pc.views.pSpecTree[i]
    pc.noTrack = true
    for item in ast.items(pc.a, ast.child(pc.a, pc.views.pSpec[i], 0)) {
        let n = compileExpr(pc, ast.child(pc.a, item, 0))
        if pc.err { break }
        out.add(n)
    }
    pc.a = saveA
    pc.noTrack = saveTrack
    return out
}

function boolConst(pc: PC, b: Boolean): Integer {
    let n = constNode(pc, v.T_BOOL)
    ex.setBoolReg(pc.p, n, b)
    return n
}

function isTrueExpr(pc: PC, n: Integer): Integer {
    return ex.addExpr(pc.p, ex.EX_ISBOOL, v.T_BOOL, n, 0, ast.TEST_TRUE, 0)
}

function andExpr(pc: PC, l: Integer, r: Integer): Integer {
    if l < 0 { return r }
    if r < 0 { return l }
    return ex.addExpr(pc.p, ex.EX_AND, v.T_BOOL, l, r, 0, 0)
}

function orExpr(pc: PC, l: Integer, r: Integer): Integer {
    if l < 0 { return r }
    if r < 0 { return l }
    return ex.addExpr(pc.p, ex.EX_OR, v.T_BOOL, l, r, 0, 0)
}

// Bound value i of a K_LIST in the bound tree: 1 MINVALUE, 2 MAXVALUE, else 0.
function boundMarker(a: ast.Ast, id: Integer): Integer {
    if ast.kind(a, id) == ast.K_NAME {
        if a.nodes[id].text == "minvalue" { return 1 }
        if a.nodes[id].text == "maxvalue" { return 2 }
    }
    if ast.kind(a, id) == ast.K_COLUMN_REF && ast.items(a, id).length == 0 {
        if a.nodes[id].text == "minvalue" { return 1 }
        if a.nodes[id].text == "maxvalue" { return 2 }
    }
    return 0
}

// Compile bound value `id` (in the bound tree) coerced to the key's type.
function boundValue(pc: PC, bi: Integer, id: Integer, key: Integer): Integer {
    let saveA = pc.a
    let saveTrack = pc.noTrack
    pc.a = pc.views.pBoundTree[bi]
    pc.noTrack = true
    let n = compileExpr(pc, id)
    pc.a = saveA
    pc.noTrack = saveTrack
    if n < 0 || pc.err { return -1 }
    return coerce(pc, n, pc.p.et[key], -1, false)
}

// key tuple >= lo (lower) or < hi (upper), lexicographic with MINVALUE / MAXVALUE markers.
function rangeCmp(pc: PC, bi: Integer, keys: List<Integer>, vals: List<Integer>, i: Integer, lower: Boolean): Integer {
    if i >= keys.length || i >= vals.length { return boolConst(pc, lower) }
    let a = pc.views.pBoundTree[bi]
    let m = boundMarker(a, vals[i])
    if m == 1 { return boolConst(pc, lower) }
    if m == 2 { return boolConst(pc, !lower) }
    let bv = boundValue(pc, bi, vals[i], keys[i])
    if bv < 0 { return -1 }
    let strict = ast.OP_GT
    if !lower { strict = ast.OP_LT }
    let s = makeCmp(pc, strict, keys[i], bv, -1)
    let eq = makeCmp(pc, ast.OP_EQ, keys[i], bv, -1)
    let rest = rangeCmp(pc, bi, keys, vals, i + 1, lower)
    if pc.err || s < 0 || eq < 0 || rest < 0 { return -1 }
    return orExpr(pc, isTrueExpr(pc, s), andExpr(pc, isTrueExpr(pc, eq), rest))
}

// Boolean expression: the row (buffer) belongs to child partition ctid of partitioned table ptid.
function boundExpr(pc: PC, ptid: Integer, ctid: Integer, keys: List<Integer>, depth: Integer): Integer {
    let bi = partIndex(pc.views, ctid)
    if bi < 0 || pc.views.pBound[bi] < 0 { return boolConst(pc, false) }
    let a = pc.views.pBoundTree[bi]
    let b = pc.views.pBound[bi]
    let kind = a.nodes[b].op
    if kind == ast.PB_DEFAULT {
        if depth > 0 { return boolConst(pc, false) }
        let any = -1
        for sib in partChildren(pc.views, pc.c, ptid) {
            if sib != ctid {
                let e = boundExpr(pc, ptid, sib, keys, depth + 1)
                if e < 0 { return -1 }
                any = orExpr(pc, any, isTrueExpr(pc, e))
            }
        }
        if any < 0 { return boolConst(pc, true) }
        return ex.addExpr(pc.p, ex.EX_NOT, v.T_BOOL, any, 0, 0, 0)
    }
    if keys.length == 0 { return boolConst(pc, false) }
    if kind == ast.PB_LIST {
        let k = keys[0]
        let res = -1
        for val in ast.items(a, ast.child(a, b, 0)) {
            if ast.kind(a, val) == ast.K_NULL_LIT {
                res = orExpr(pc, res, ex.addExpr(pc.p, ex.EX_ISNULL, v.T_BOOL, k, 0, 0, 0))
            } else {
                let bv = boundValue(pc, bi, val, k)
                if bv < 0 { return -1 }
                let c = makeCmp(pc, ast.OP_EQ, k, bv, -1)
                if c < 0 { return -1 }
                res = orExpr(pc, res, isTrueExpr(pc, c))
            }
        }
        if res < 0 { return boolConst(pc, false) }
        return res
    }
    if kind == ast.PB_RANGE {
        let lo = ast.items(a, ast.child(a, b, 0))
        let hi = ast.items(a, ast.child(a, b, 1))
        let notNull = -1
        for k in keys {
            notNull = andExpr(pc, notNull, ex.addExpr(pc.p, ex.EX_ISNULL, v.T_BOOL, k, 0, 1, 0))
        }
        let ge = rangeCmp(pc, bi, keys, lo, 0, true)
        let lt = rangeCmp(pc, bi, keys, hi, 0, false)
        if ge < 0 || lt < 0 { return -1 }
        return andExpr(pc, notNull, andExpr(pc, ge, lt))
    }
    // hash: our own hash of the key values (placement differs from PG's hash opclasses)
    let mods = ast.items(a, ast.child(a, b, 0))
    let args: List<Integer> = []
    for k in keys { args.add(k) }
    args.add(intConst(pc, a.nodes[mods[0]].intValue, v.T_INT8))
    let h = strFuncNode(pc, ex.FN_PART_HASH, v.T_INT8, args, 0)
    return makeCmp(pc, ast.OP_EQ, h, intConst(pc, a.nodes[mods[1]].intValue, v.T_INT8), -1)
}

// The partition constraint of table tid: its bound under each ancestor (expressions over the buffer scope).
function ancestorCheck(pc: PC, tid: Integer): Integer {
    let res = -1
    let cur = tid
    let depth = 0
    while depth < 64 {
        let par = partParentOf(pc.views, pc.c, cur)
        if par < 0 { break }
        let keys = compileKeys(pc, par)
        if pc.err { return -1 }
        let e = boundExpr(pc, par, cur, keys, 0)
        if e < 0 { return -1 }
        res = andExpr(pc, res, isTrueExpr(pc, e))
        cur = par
        depth += 1
    }
    return res
}

// Route rows of DML on target table `target` relative to partition tree root `root` (target itself, or the
// partitioned table an UPDATE named when target is one of its leaves).
function buildRoute(pc: PC, root: Integer, target: Integer) {
    let p = pc.p
    let rt = pc.c.tables[root]
    let buf = tb.newTable(-1, "partbuf")
    buf.isTemp = true
    for col in rt.cols { tb.addColumn(buf, tb.newColumn(col.name, col.type, col.typmod, false)) }
    tb.reserveRow(buf, 0)
    let slot = newSlot(pc, buf)
    let r = Route {
        buf: buf; bufSlot: slot; check: -1; rootName: displayName(rt.name); rootTid: root; nodeTid: []; nodeFirst: []
        nodeCount: []; chTid: []; chBound: []; chNode: []; chLeaf: []; leafTid: []; leafRegs: []; leafMap: []; bufRegs: []
    }
    for col in buf.cols { r.bufRegs.add(constNode(pc, col.type)) }
    let saveR = pc.rCount
    let saveAgg = pc.aggActive
    pc.aggActive = false
    pc.level += 1
    addRangeForTable(pc, displayName(rt.name), slot, buf, [])
    r.check = ancestorCheck(pc, root)
    if isPartitioned(pc.views, pc.c, root) {
        addRouteNode(pc, r, root, 0)
    } else {
        addRouteLeaf(pc, r, root)
    }
    pc.rCount = saveR
    pc.level -= 1
    pc.aggActive = saveAgg
    if pc.err { return }
    pc.st.route.add(r)
    pc.st.routeIdx = pc.st.route.length - 1
}

function addRouteLeaf(pc: PC, r: Route, tid: Integer): Integer {
    let t = pc.c.tables[tid]
    let regs: List<Integer> = []
    let map: List<Integer> = []
    for col in t.cols {
        regs.add(constNode(pc, col.type))
        map.add(tb.columnIndex(r.buf, col.name))
    }
    r.leafTid.add(tid)
    r.leafRegs.add(regs)
    r.leafMap.add(map)
    pc.st.tableIds.add(tid)
    return r.leafTid.length - 1
}

function addRouteNode(pc: PC, r: Route, tid: Integer, depth: Integer): Integer {
    let ni = r.nodeTid.length
    r.nodeTid.add(tid)
    r.nodeFirst.add(0)
    r.nodeCount.add(0)
    if depth > 64 { return ni }
    let keys = compileKeys(pc, tid)
    if pc.err { return ni }
    let kids = partChildren(pc.views, pc.c, tid)
    let bounds: List<Integer> = []
    for ch in kids {
        let e = boundExpr(pc, tid, ch, keys, 0)
        if pc.err || e < 0 { return ni }
        bounds.add(e)
    }
    // children are appended contiguously; nested nodes come after this node's child block
    let first = r.chTid.length
    r.nodeFirst[ni] = first
    r.nodeCount[ni] = kids.length
    let i = 0
    while i < kids.length {
        r.chTid.add(kids[i])
        r.chBound.add(bounds[i])
        r.chNode.add(-1)
        r.chLeaf.add(-1)
        i += 1
    }
    i = 0
    while i < kids.length {
        if isPartitioned(pc.views, pc.c, kids[i]) {
            r.chNode[first + i] = addRouteNode(pc, r, kids[i], depth + 1)
        } else {
            r.chLeaf[first + i] = addRouteLeaf(pc, r, kids[i])
        }
        i += 1
    }
    return ni
}

// UPDATE / DELETE: a partitioned target gets one target per leaf partition; a partition target checks its
// partition constraint (UPDATE). Called after the statement compiled against `tid` itself.
function partitionDml(pc: PC, id: Integer, tid: Integer, ref: Integer, base: Integer) {
    let st = pc.st
    if pc.targetOverride >= 0 { return }
    if isPartitioned(pc.views, pc.c, tid) {
        // keep the statement-level outputs (RETURNING column descriptions) of the partitioned table itself
        let outN = st.outNames
        let outT = st.outTypes
        let outM = st.outMods
        let alias = displayName(pc.c.tables[tid].name)
        let saveR = base
        for leaf in partLeaves(pc.views, pc.c, tid) {
            if leaf == tid { continue }
            pc.rCount = saveR
            pc.targetOverride = leaf
            pc.targetAlias = alias
            st.slot = -1
            st.root = -1
            st.setCols = []
            st.setExprs = []
            st.outExprs = []
            st.outNames = []
            st.outTypes = []
            st.outMods = []
            st.routeIdx = -1
            if st.kind == SK_UPDATE {
                compileUpdateTarget(pc, id, leaf, ref)
                if !pc.err { buildRoute(pc, tid, leaf) }
            } else {
                compileDeleteTarget(pc, id, leaf, ref)
            }
            if pc.err { return }
            st.mtTid.add(leaf)
            st.mtSlot.add(st.slot)
            st.mtRoot.add(st.root)
            st.mtSetCols.add(st.setCols)
            st.mtSetExprs.add(st.setExprs)
            st.mtOut.add(st.outExprs)
            st.mtRoute.add(st.routeIdx)
            st.mtFromBuf.add(st.fromBuf)
        }
        pc.targetOverride = -1
        pc.targetAlias = ""
        pc.rCount = saveR
        st.outNames = outN
        st.outTypes = outT
        st.outMods = outM
        st.routeIdx = -1
        if st.mtTid.length == 0 {
            // no partitions: a target that matches nothing
            st.mtTid.add(-1)
            st.mtSlot.add(-1)
            st.mtRoot.add(-1)
            st.mtSetCols.add([])
            st.mtSetExprs.add([])
            st.mtOut.add([])
            st.mtRoute.add(-1)
            st.mtFromBuf.add(-1)
        }
        return
    }
    if st.kind == SK_UPDATE && partParentOf(pc.views, pc.c, tid) >= 0 { buildRoute(pc, tid, tid) }
}

// ---------------------------------------------------------------- compat agent: catalog, arrays, SRFs, windows

// A pg_catalog / information_schema relation: a temp table filled from the catalog when the plan opens it.
function compileCatalogRel(pc: PC, code: Integer, alias: Text, colAliases: List<Text>, leaves: List<Leaf>) {
    let p = pc.p
    let t = pgc.newRelTable(code)
    let ti = ex.addTemp(p, t)
    let slot = newSlot(pc, t)
    let state = constNode(pc, v.T_INT4)
    let op = ex.addOp(p, ex.O_CATALOG, slot, ti, code, state, 0, 0)
    addRangeForTable(pc, alias, slot, t, colAliases)
    leaves.add(Leaf { op: op; slot: -1; tableId: -1; slots: [slot]; outer: false })
}

function compileSubscript(pc: PC, id: Integer): Integer {
    let nd = pc.a.nodes[id]
    let p = pc.p
    if (nd.flags & ast.F_SLICE) != 0 || nd.children[2] >= 0 {
        perr(pc, "0A000", "array slices are not supported", nd.position)
        return -1
    }
    let arr = compileExpr(pc, nd.children[0])
    let idx = compileExpr(pc, nd.children[1])
    if pc.err { return -1 }
    let at = p.et[arr]
    if !v.isArrayType(at) {
        perr(pc, "42804", "cannot subscript type " + v.typeName(at) + " because it does not support subscripting", nd.position)
        return -1
    }
    let it = p.et[idx]
    if it == v.T_UNKNOWN || !v.isIntType(it) { idx = coerce(pc, idx, v.T_INT4, -1, false) }
    let et = v.arrayElemType(at)
    if isNullConst(pc, arr) || isNullConst(pc, idx) { return nullConst(pc, et) }
    return ex.addExpr(p, ex.EX_SUBSCRIPT, et, arr, idx, 0, 0)
}

function compileFieldSelect(pc: PC, id: Integer): Integer {
    let nd = pc.a.nodes[id]
    let p = pc.p
    let inner = nd.children[0]
    let field = nd.text
    if pc.srfSlot >= 0 && pc.srfKind == 1 && astEqual(pc, pc.srfAst, inner) {
        let col = -1
        if field == "x" { col = 0 }
        if field == "n" { col = 1 }
        if col < 0 {
            perr(pc, "42703", "column \"" + field + "\" not found in data type record", nd.position)
            return -1
        }
        let st0 = p.slotTable[pc.srfSlot]
        return ex.addExpr(p, ex.EX_COL, st0.cols[col].type, pc.srfSlot, col, 0, -1)
    }
    let e = compileExpr(pc, inner)
    if pc.err { return -1 }
    if p.et[e] != v.T_RECORD || (field != "x" && field != "n") {
        perr(pc, "0A000", "field selection is supported on information_schema._pg_expandarray records only", nd.position)
        return -1
    }
    let f = 0
    if field == "n" { f = 1 }
    return ex.addExpr(p, ex.EX_FIELD, v.T_INT4, e, 0, f, 0)
}

function isSrfName(name: Text): Boolean {
    return name == "_pg_expandarray" || name == "unnest" || name == "generate_series"
}

// First set-returning function call in expression id (not inside subqueries or window calls), or -1.
function findSrf(pc: PC, id: Integer): Integer {
    if id < 0 { return -1 }
    let nd = pc.a.nodes[id]
    let k = nd.kind
    if k == ast.K_SELECT || k == ast.K_SET_OP || k == ast.K_VALUES { return -1 }
    if k == ast.K_FUNC_CALL && isSrfName(nd.text) && ast.child(pc.a, id, 3) < 0 { return id }
    for c in nd.children {
        let f = findSrf(pc, c)
        if f >= 0 { return f }
    }
    return -1
}

function setupSrf(pc: PC, srf: Integer, root: Integer): Integer {
    let p = pc.p
    let nd = pc.a.nodes[srf]
    let args = fnArgs(pc, srf)
    if pc.err { return root }
    let t = tb.newTable(-1, "srf")
    t.isTemp = true
    let spec: List<Integer> = []
    let kind = 2
    if nd.text == "_pg_expandarray" { kind = 1 }
    if nd.text == "generate_series" { kind = 3 }
    if kind == 3 {
        if args.length < 2 || args.length > 3 {
            perr(pc, "42883", "function generate_series needs 2 or 3 arguments", nd.position)
            return root
        }
        let ty = v.T_INT4
        if p.et[args[0]] == v.T_INT8 || p.et[args[1]] == v.T_INT8 { ty = v.T_INT8 }
        let i = 0
        while i < args.length {
            if !v.isIntType(p.et[args[i]]) && p.et[args[i]] != v.T_UNKNOWN {
                perr(pc, "0A000", "generate_series is supported over integers only", nd.position)
                return root
            }
            args[i] = coerce(pc, args[i], v.T_INT8, -1, false)
            i += 1
        }
        tb.addColumn(t, tb.newColumn("generate_series", ty, -1, false))
        spec = [3, args[0], args[1], -1]
        if args.length > 2 { spec[3] = args[2] }
    } else {
        if args.length != 1 || !v.isArrayType(p.et[args[0]]) {
            perr(pc, "0A000", nd.text + " is supported over catalog arrays only", nd.position)
            return root
        }
        let et = v.arrayElemType(p.et[args[0]])
        tb.addColumn(t, tb.newColumn("x", et, -1, false))
        if kind == 1 {
            tb.addColumn(t, tb.newColumn("n", v.T_INT4, -1, false))
            tb.addColumn(t, tb.newColumn("rec", v.T_RECORD, -1, false))
        }
        spec = [kind, args[0]]
    }
    let ti = ex.addTemp(p, t)
    let slot = newSlot(pc, t)
    let blk = ex.listBlock(p, spec)
    pc.srfAst = srf
    pc.srfSlot = slot
    pc.srfKind = kind
    return ex.addOp(p, ex.O_SRF, root, ti, slot, blk, 0, 0)
}

function hasWindowCall(pc: PC, id: Integer): Boolean {
    if id < 0 { return false }
    let nd = pc.a.nodes[id]
    let k = nd.kind
    if k == ast.K_SELECT || k == ast.K_SET_OP || k == ast.K_VALUES { return false }
    if k == ast.K_FUNC_CALL && ast.child(pc.a, id, 3) >= 0 { return true }
    for c in nd.children {
        if hasWindowCall(pc, c) { return true }
    }
    return false
}

// row_number / rank / dense_rank / count(*) OVER (PARTITION BY ... ORDER BY ...): a bigint column of the window table.
function compileWindowCall(pc: PC, id: Integer): Integer {
    let nd = pc.a.nodes[id]
    let p = pc.p
    if pc.winSlot < 0 {
        perr(pc, "42P20", "window functions are not allowed here", nd.position)
        return -1
    }
    let name = nd.text
    let kind = 0
    if name == "row_number" { kind = ex.WF_ROW_NUMBER }
    if name == "rank" { kind = ex.WF_RANK }
    if name == "dense_rank" { kind = ex.WF_DENSE_RANK }
    if name == "count" && (nd.flags & ast.F_FUNC_STAR) != 0 { kind = ex.WF_COUNT }
    if kind == 0 {
        perr(pc, "0A000", "window function " + name + " is not supported", nd.position)
        return -1
    }
    if kind != ex.WF_COUNT && ast.items(pc.a, ast.child(pc.a, id, 1)).length > 0 {
        return badArgs(pc, name, id)
    }
    let over = ast.child(pc.a, id, 3)
    if ast.child(pc.a, over, 0) >= 0 {
        perr(pc, "0A000", "named windows are not supported", nd.position)
        return -1
    }
    let t = pc.winTable
    let keys: List<Integer> = []
    let nPart = 0
    for e in ast.items(pc.a, ast.child(pc.a, over, 1)) {
        let n = compileExpr(pc, e)
        if pc.err { return -1 }
        if p.et[n] == v.T_UNKNOWN { n = coerce(pc, n, v.T_TEXT, -1, false) }
        let col = t.cols.length
        tb.addColumn(t, tb.newColumn("wk" + Text(col), p.et[n], -1, false))
        pc.winEval.add(n)
        pc.winEval.add(col)
        keys.add(col)
        keys.add(0)
        keys.add(0)
        nPart += 1
    }
    let nOrd = 0
    for si in ast.items(pc.a, ast.child(pc.a, over, 2)) {
        let n = compileExpr(pc, ast.child(pc.a, si, 0))
        if pc.err { return -1 }
        if p.et[n] == v.T_UNKNOWN { n = coerce(pc, n, v.T_TEXT, -1, false) }
        let col = t.cols.length
        tb.addColumn(t, tb.newColumn("wk" + Text(col), p.et[n], -1, false))
        pc.winEval.add(n)
        pc.winEval.add(col)
        let d = sortDesc(pc, si)
        keys.add(col)
        keys.add(d)
        keys.add(nullsFirstOf(pc, si, d == 1))
        nOrd += 1
    }
    let res = t.cols.length
    tb.addColumn(t, tb.newColumn("wf" + Text(res), v.T_INT8, -1, false))
    pc.winSpec.add(nPart)
    pc.winSpec.add(nOrd)
    pc.winSpec.add(kind)
    pc.winSpec.add(res)
    for x in keys { pc.winSpec.add(x) }
    return ex.addExpr(p, ex.EX_COL, v.T_INT8, pc.winSlot, res, 0, -1)
}

// Every column read compiled since the window op was placed (select list, ORDER BY, window keys) is redirected to
// a captured copy in the window table; O_WINDOW copies those columns from its input rows.
function finishWindow(pc: PC, op: Integer, nodeStart: Integer, slotLimit: Integer) {
    let p = pc.p
    let t = pc.winTable
    let capSlot: List<Integer> = []
    let capCol: List<Integer> = []
    let capDst: List<Integer> = []
    let end = p.ek.length
    let n = nodeStart
    while n < end {
        if p.ek[n] == ex.EX_COL {
            let s = p.ea[n]
            if s != pc.winSlot && s < slotLimit && s < pc.slotLevel.length && pc.slotLevel[s] == pc.level {
                let dst = -1
                let i = 0
                while i < capSlot.length {
                    if capSlot[i] == s && capCol[i] == p.eb[n] { dst = capDst[i] }
                    i += 1
                }
                if dst < 0 {
                    dst = t.cols.length
                    let srcCol = p.slotBase[s].cols[p.eb[n]]
                    tb.addColumn(t, tb.newColumn("c" + Text(dst), v.sqlType(srcCol.type), -1, false))
                    capSlot.add(s)
                    capCol.add(p.eb[n])
                    capDst.add(dst)
                }
                p.ea[n] = pc.winSlot
                p.eb[n] = dst
            }
        }
        n += 1
    }
    let caps: List<Integer> = []
    let i = 0
    while i < capSlot.length {
        let srcCol = p.slotBase[capSlot[i]].cols[capCol[i]]
        caps.add(ex.addExpr(p, ex.EX_COL, v.sqlType(srcCol.type), capSlot[i], capCol[i], 0, -1))
        caps.add(capDst[i])
        i += 1
    }
    let keyEvals: List<Integer> = []
    for x in pc.winEval { keyEvals.add(x) }
    // specs: per call a sort block [nKeys, (col, desc, nf)...]
    let sortPos: List<Integer> = []
    let w = 0
    while w < pc.winSpec.length {
        let nPart = pc.winSpec[w]
        let nOrd = pc.winSpec[w + 1]
        let sb: List<Integer> = [nPart + nOrd]
        let k = 0
        while k < (nPart + nOrd) * 3 {
            sb.add(pc.winSpec[w + 4 + k])
            k += 1
        }
        sortPos.add(ex.listBlock(p, sb))
        w += 4 + (nPart + nOrd) * 3
    }
    let blk: List<Integer> = [caps.length / 2]
    for x in caps { blk.add(x) }
    blk.add(keyEvals.length / 2)
    for x in keyEvals { blk.add(x) }
    blk.add(sortPos.length)
    w = 0
    let si = 0
    while w < pc.winSpec.length {
        let nPart = pc.winSpec[w]
        let nOrd = pc.winSpec[w + 1]
        blk.add(sortPos[si])
        blk.add(nPart)
        blk.add(nOrd)
        blk.add(1)
        blk.add(pc.winSpec[w + 2])
        blk.add(pc.winSpec[w + 3])
        w += 4 + (nPart + nOrd) * 3
        si += 1
    }
    p.oe[op] = ex.listBlock(p, blk)
}

// Catalog and session functions drivers call (pgjdbc, psql \d). Returns -2 when `name` is not one of them.
function compileCatFunc(pc: PC, id: Integer, name: Text): Integer {
    let p = pc.p
    if name == "pg_get_expr" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        if args.length < 2 || args.length > 3 { return badArgs(pc, name, id) }
        if isNullConst(pc, args[0]) { return nullConst(pc, v.T_TEXT) }
        return coerceText(pc, args[0])
    }
    if name == "pg_get_indexdef" || name == "pg_get_constraintdef" || name == "format_type" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        if args.length < 1 || args.length > 3 { return badArgs(pc, name, id) }
        args[0] = coerce(pc, args[0], v.T_OID, -1, false)
        let fn = ex.FN_PG_INDEXDEF
        if name == "pg_get_constraintdef" { fn = ex.FN_CONSTRAINTDEF }
        if name == "format_type" { fn = ex.FN_FORMAT_TYPE }
        let use: List<Integer> = [args[0]]
        if args.length > 1 && fn != ex.FN_CONSTRAINTDEF {
            // format_type(oid, NULL) means "no typmod"
            if !(fn == ex.FN_FORMAT_TYPE && isNullConst(pc, args[1])) { use.add(coerce(pc, args[1], v.T_INT4, -1, false)) }
        }
        return mkFunc(pc, fn, v.T_TEXT, use)
    }
    if name == "obj_description" || name == "col_description" || name == "shobj_description" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        return nullConst(pc, v.T_TEXT)
    }
    if name == "pg_table_is_visible" || name == "pg_type_is_visible" || name == "pg_function_is_visible" ||
       name == "has_table_privilege" || name == "has_schema_privilege" || name == "has_database_privilege" ||
       name == "has_column_privilege" || name == "has_function_privilege" || name == "has_sequence_privilege" || name == "pg_has_role" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        let n = constNode(pc, v.T_BOOL)
        ex.setIntReg(p, n, 1)
        return n
    }
    if name == "pg_get_userbyid" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        let n = textConst(pc, "postgres")
        p.et[n] = v.T_NAME
        return n
    }
    if name == "pg_encoding_to_char" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        let n = textConst(pc, "UTF8")
        p.et[n] = v.T_NAME
        return n
    }
    if name == "current_schemas" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        let all = args.length == 1 && constBoolNode(pc, args[0]) == 1
        let n = textConst(pc, "{public}")
        if all { n = textConst(pc, "{pg_catalog,public}") }
        p.et[n] = v.T_TEXTARRAY
        return n
    }
    if name == "array_upper" || name == "array_lower" || name == "array_length" || name == "cardinality" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        let want = 2
        if name == "cardinality" { want = 1 }
        if args.length != want { return badArgs(pc, name, id) }
        if !v.isArrayType(p.et[args[0]]) {
            perr(pc, "42883", "function " + name + "(" + v.typeName(p.et[args[0]]) + ") does not exist", posOf(pc, id))
            return -1
        }
        let use: List<Integer> = [args[0]]
        if want == 2 { use.add(coerce(pc, args[1], v.T_INT4, -1, false)) }
        let fn = ex.FN_ARRAY_UPPER
        if name == "array_lower" { fn = ex.FN_ARRAY_LOWER }
        if name == "array_length" || name == "cardinality" { fn = ex.FN_ARRAY_LENGTH }
        return mkFunc(pc, fn, v.T_INT4, use)
    }
    if name == "pg_relation_size" || name == "pg_total_relation_size" || name == "pg_table_size" || name == "pg_indexes_size" {
        let args = fnArgs(pc, id)
        if pc.err { return -1 }
        if args.length < 1 { return badArgs(pc, name, id) }
        return mkFunc(pc, ex.FN_REL_SIZE, v.T_INT8, [coerce(pc, args[0], v.T_REGCLASS, -1, false)])
    }
    return -2
}
