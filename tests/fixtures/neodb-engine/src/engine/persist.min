// Table and index images, format v3 (ADR-010): every buffer of a table (row state, column data / null bitmap /
// numeric scales / text heap, hash index slots, ordered index runs) is stored as-is in 128 KiB pieces in data.db.
// A table descriptor (one manifest chunk per table) lists where each piece is. A checkpoint writes only pieces
// that changed (tb.Seg dirty bits, length changes, or a content hash for the row state and scales), into free
// space; loading a table is pread into Bytes (no decode, indexes included); a table that is not loaded can answer
// primary-key point lookups from its image with a few preads (paged mode, see index.min / table.min).
//
// Images are raw copies of memory at the checkpoint LSN. Rows that were uncommitted then are corrected by:
//   * the persisted row state, which holds the COMMITTED status of every row (0 live, 1 dead), and
//   * the overlay: committed before-images of rows updated by transactions still active at the checkpoint,
//     applied when the table is loaded (like a rollback, index entries included).
use "../../lib/dbio.min" as dbio
use "../storage/crc32c.min" as crc
use "../storage/datafile.min" as df
use "./values.min" as v
use "./hashmap.min" as hm
use "./table.min" as tb
use "./index.min" as ix
use "./catalog.min" as cat
use "./txn.min" as txn

public constant FORMAT = 3

public constant K_STATE = 1
public constant K_DATA = 2
public constant K_NULLS = 3
public constant K_SCALES = 4
public constant K_HEAP = 5
public constant K_SLOTS = 6
public constant K_OMAIN = 7
public constant K_ODELTA = 8

constant ENC_RAW = 0
constant ENC_CONST = 1

// One persisted buffer.
public record SegImage {
    kind: Integer
    obj: Integer                 // column index, or position in t.hashIds / t.ordIds
    length: Integer
    offs: Bytes                  // i64 per piece: data file offset; -1 = constant piece
    words: Bytes                 // i64 per piece: the repeated word of a constant piece
    crcs: Bytes                  // i64 per piece: crc32c of a raw piece
    sums: Bytes                  // i64 per piece: wrapping sum of 8-byte words (row state / scales change detection)
}

public record TableImage {
    present: Boolean
    nrows: Integer
    live: Integer
    heapShared: Bytes            // i64 per column
    heapDead: Bytes              // i64 per column
    hashMeta: Bytes              // i64 x 3 per hash index: mask, used, live
    nord: Integer
    segs: List<SegImage>
    overlay: Bytes               // per entry: varint row, varint image length, image (tb.encodeRow format)
    noverlay: Integer
}

public function emptyImage(): TableImage {
    return TableImage {
        present: false; nrows: 0; live: 0; heapShared: Bytes(); heapDead: Bytes(); hashMeta: Bytes(); nord: 0
        segs: []; overlay: Bytes(); noverlay: 0
    }
}

function newSegImage(kind: Integer, obj: Integer, length: Integer): SegImage {
    return SegImage { kind: kind; obj: obj; length: length; offs: Bytes(); words: Bytes(); crcs: Bytes(); sums: Bytes() }
}

public function pieceCount(length: Integer): Integer { return (length + tb.PIECE - 1) >> tb.PIECE_SHIFT }

function pieceLen(length: Integer, p: Integer): Integer {
    return min(tb.PIECE, length - (p << tb.PIECE_SHIFT))
}

// Per engine.
public record Store {
    dir: Text
    data: df.DataFile
    table: crc.Table
    images: List<TableImage>     // by table id
    known: Bytes                 // per table id: 1 = images[id] is the table's current persisted image
    fingerprintOk: Boolean       // persisted index images were written with this build's hash functions
    toFree: Bytes                // i64 (offset, length) pairs: freed once the next manifest is durable
    newOffs: Bytes               // i64 (offset, length, crc) triples written by the checkpoint in progress
    oldImages: List<TableImage>  // images replaced by the checkpoint in progress (restored if it is abandoned)
    oldIds: Bytes                // i64 table ids of oldImages
    scratch: Bytes
    lastWritten: Integer         // diagnostics: bytes / pieces written by the last checkpoint
    lastPieces: Integer
    lastReused: Integer
    loads: Integer
}

public function newStore(dir: Text): Store {
    return Store {
        dir: dir; data: df.open(dir); table: crc.makeTable(); images: []; known: Bytes(); fingerprintOk: true
        toFree: Bytes(); newOffs: Bytes(); oldImages: []; oldIds: Bytes(); scratch: Bytes(); lastWritten: 0
        lastPieces: 0; lastReused: 0; loads: 0
    }
}

public function dataFile(st: Store): df.DataFile { return st.data }

function ensureSlot(st: Store, tid: Integer) {
    while st.images.length <= tid {
        st.images.add(emptyImage())
        st.known.add(0)
    }
}

public function isKnown(st: Store, tid: Integer): Boolean { return tid < st.known.length && st.known[tid] == 1 }
public function imageOf(st: Store, tid: Integer): TableImage {
    ensureSlot(st, tid)
    return st.images[tid]
}
public function setImage(st: Store, tid: Integer, img: TableImage) {
    ensureSlot(st, tid)
    st.images[tid] = img
    st.known[tid] = 1
}

// Hash functions the persisted hash index images depend on: a build whose hashing differs rebuilds indexes.
public function fingerprint(): Integer {
    let h = v.hashInt(1)
    h = v.hashCombine(h, v.hashInt(-123456789))
    h = v.hashCombine(h, v.hashBytes(Bytes("neo-db index image v3"), 0, 21))
    h = v.hashCombine(h, v.hashFloat(2.5))
    h = v.hashCombine(h, ix.normNumeric(12300, 2))
    return v.mix64(h)
}

// ---------------------------------------------------------------- descriptor encoding

public function encodeDescriptor(img: TableImage): Bytes {
    let out = Bytes()
    out.add(FORMAT)
    tb.putUVarint(out, img.nrows)
    tb.putUVarint(out, img.live)
    let ncols = img.heapShared.length / 8
    tb.putUVarint(out, ncols)
    for i in 0..ncols {
        tb.putUVarint(out, img.heapShared.getInt64(i * 8))
        tb.putUVarint(out, img.heapDead.getInt64(i * 8))
    }
    let nh = img.hashMeta.length / 24
    tb.putUVarint(out, nh)
    for i in 0..nh * 3 { tb.putUVarint(out, img.hashMeta.getInt64(i * 8)) }
    tb.putUVarint(out, img.nord)
    tb.putUVarint(out, img.segs.length)
    for s in img.segs {
        out.add(s.kind)
        tb.putUVarint(out, s.obj)
        tb.putUVarint(out, s.length)
        let np = pieceCount(s.length)
        for p in 0..np {
            let o = s.offs.getInt64(p * 8)
            if o < 0 {
                out.add(ENC_CONST)
                out.addInt64(s.words.getInt64(p * 8))
            } else {
                out.add(ENC_RAW)
                tb.putUVarint(out, o / df.PAGE)
                out.addUInt32(s.crcs.getInt64(p * 8))
                out.addInt64(s.sums.getInt64(p * 8))
            }
        }
    }
    tb.putUVarint(out, img.noverlay)
    tb.putUVarint(out, img.overlay.length)
    out.addBytes(img.overlay)
    return out
}

// Untrusted input (a chunk that passed its CRC, but still): every count is bounds-checked against the chunk so a
// bad descriptor fails loudly instead of allocating wildly.
public function decodeDescriptor(b: Bytes): TableImage {
    let img = emptyImage()
    if b.length == 0 { return img }
    if b[0] != FORMAT { fail("storage: table descriptor has format " + Text(b[0]) + ", expected " + Text(FORMAT)) }
    let cur = tb.Cursor { pos: 1 }
    img.present = true
    img.nrows = tb.getUVarint(b, cur)
    img.live = tb.getUVarint(b, cur)
    let ncols = boundedCount(b, cur, 2)
    for i in 0..ncols {
        img.heapShared.addInt64(tb.getUVarint(b, cur))
        img.heapDead.addInt64(tb.getUVarint(b, cur))
    }
    let nh = boundedCount(b, cur, 3)
    for i in 0..nh * 3 { img.hashMeta.addInt64(tb.getUVarint(b, cur)) }
    img.nord = tb.getUVarint(b, cur)
    let nsegs = boundedCount(b, cur, 3)
    for i in 0..nsegs {
        let kind = b[cur.pos]
        cur.pos += 1
        let obj = tb.getUVarint(b, cur)
        let length = tb.getUVarint(b, cur)
        let s = newSegImage(kind, obj, length)
        let np = pieceCount(length)
        if np > b.length - cur.pos { fail("storage: corrupt table descriptor (piece count)") }
        for p in 0..np {
            let enc = b[cur.pos]
            cur.pos += 1
            if enc == ENC_CONST {
                s.offs.addInt64(-1)
                s.words.addInt64(b.getInt64(cur.pos))
                s.crcs.addInt64(0)
                s.sums.addInt64(0)
                cur.pos += 8
            } else {
                s.offs.addInt64(tb.getUVarint(b, cur) * df.PAGE)
                s.words.addInt64(0)
                s.crcs.addInt64(b.getUInt32(cur.pos))
                s.sums.addInt64(b.getInt64(cur.pos + 4))
                cur.pos += 12
            }
        }
        img.segs.add(s)
    }
    img.noverlay = tb.getUVarint(b, cur)
    let olen = tb.getUVarint(b, cur)
    if olen > b.length - cur.pos { fail("storage: corrupt table descriptor (overlay)") }
    img.overlay = b.slice(cur.pos, cur.pos + olen)
    return img
}

function boundedCount(b: Bytes, cur: tb.Cursor, minBytesEach: Integer): Integer {
    let n = tb.getUVarint(b, cur)
    if n * minBytesEach > b.length - cur.pos + minBytesEach { fail("storage: corrupt table descriptor (count)") }
    return n
}

function findSeg(img: TableImage, kind: Integer, obj: Integer): SegImage {
    for s in img.segs {
        if s.kind == kind && s.obj == obj { return s }
    }
    return newSegImage(kind, obj, 0)
}

// ---------------------------------------------------------------- allocator setup

// Every raw extent an image references (offset, length) appended to off/len.
function addExtents(img: TableImage, off: Bytes, len: Bytes) {
    for s in img.segs {
        let np = pieceCount(s.length)
        for p in 0..np {
            let o = s.offs.getInt64(p * 8)
            if o >= 0 {
                off.addInt64(o)
                len.addInt64(pieceLen(s.length, p))
            }
        }
    }
}

// Before the first checkpoint: the allocator needs every extent any readable manifest references. `extra` are
// images of other manifests still on disk (a kept fallback), normally none.
public function initAllocator(st: Store, extra: List<TableImage>) {
    if df.isReady(st.data) { return }
    let off = Bytes()
    let len = Bytes()
    let i = 0
    while i < st.images.length {
        if st.known[i] == 1 { addExtents(st.images[i], off, len) }
        i += 1
    }
    for img in extra { addExtents(img, off, len) }
    df.initAllocator(st.data, off, len)
}

// ---------------------------------------------------------------- committed row state at the checkpoint

// Committed status of row r at the checkpoint (0 live, 1 dead), given the raw state byte s != 0.
function committedState(c: cat.Catalog, tm: txn.TxnMgr, committing: Bytes, t: tb.Table, r: Integer, s: Integer): Integer {
    if (s & tb.ST_LOCKED) == 0 {
        if s == tb.ST_DEAD + tb.ST_NEW && bulkCommitting(tm, committing, t, r) { return 0 }
        return 1
    }
    let owner = txn.ownerOf(tm, t.id, r)
    if owner < 0 {
        if (s & tb.ST_DEAD) != 0 { return 1 }
        return 0
    }
    let tx = tm.txns[owner]
    if tx.state == txn.TX_COMMITTING {
        if (s & tb.ST_DEAD) != 0 { return 1 }
        return 0
    }
    if (s & tb.ST_NEW) != 0 { return 1 }   // inserted by an active transaction
    return 0                              // updated/deleted by an active one: the committed version is live
}

function bulkCommitting(tm: txn.TxnMgr, committing: Bytes, t: tb.Table, r: Integer): Boolean {
    let i = 0
    let n = committing.length / 8
    while i < n {
        let tx = tm.txns[committing.getInt64(i * 8)]
        let u = 0
        while u < tx.uCount {
            let k = tx.uKind.getInt64(u * 8)
            if (k & 15) == txn.U_BULK && tx.uTable.getInt64(u * 8) == t.id && r >= tx.uRow.getInt64(u * 8) && r < (k >> 8) {
                return true
            }
            u += 1
        }
        i += 1
    }
    return false
}

// Committed state bytes of rows [from, from + n) into out (cleared first); returns the number of live rows.
function stateImage(c: cat.Catalog, tm: txn.TxnMgr, committing: Bytes, t: tb.Table, from: Integer, n: Integer, out: Bytes): Integer {
    out.clear()
    let state = t.state
    let liveRows = 0
    let r = from
    let end = from + n
    while r + 8 <= end {
        let w = state.getInt64(r)
        if w == 0 {
            out.addInt64(0)
            liveRows += 8
        } else if w == 72340172838076673 {      // eight dead rows (0x0101010101010101)
            out.addInt64(w)
        } else {
            for k in 0..8 {
                let s = state[r + k]
                if s == 0 {
                    out.add(0)
                    liveRows += 1
                } else if s == tb.ST_DEAD {
                    out.add(1)
                } else {
                    let cs = committedState(c, tm, committing, t, r + k, s)
                    out.add(cs)
                    if cs == 0 { liveRows += 1 }
                }
            }
        }
        r += 8
    }
    while r < end {
        let s = state[r]
        if s == 0 {
            out.add(0)
            liveRows += 1
        } else if s == tb.ST_DEAD {
            out.add(1)
        } else {
            let cs = committedState(c, tm, committing, t, r, s)
            out.add(cs)
            if cs == 0 { liveRows += 1 }
        }
        r += 1
    }
    return liveRows
}

// Overlay: committed images of rows of t updated by transactions active now.
function overlayFor(tm: txn.TxnMgr, t: tb.Table, img: TableImage) {
    let scratch = tb.cloneSchema(t, -5)
    tb.reserveRow(scratch, 0)
    for tx in tm.txns {
        if tx.state == txn.TX_ACTIVE {
            let u = 0
            while u < tx.uCount {
                let k = tx.uKind.getInt64(u * 8)
                if (k & 15) == txn.U_UPDATE && (k & txn.U_OWNER) != 0 && tx.uTable.getInt64(u * 8) == t.id {
                    let off = tx.uImgOff.getInt64(u * 8)
                    let cur = tb.Cursor { pos: off }
                    tb.decodeRow(scratch, 0, tx.uImg, cur)
                    tb.putUVarint(img.overlay, tx.uRow.getInt64(u * 8))
                    tb.putUVarint(img.overlay, cur.pos - off)
                    img.overlay.addBytes(tx.uImg.slice(off, cur.pos))
                    img.noverlay += 1
                }
                u += 1
            }
        }
    }
}

// ---------------------------------------------------------------- writing pieces

function wordSum(b: Bytes, from: Integer, n: Integer): Integer {
    let s = 0
    let i = from
    let end = from + n
    while i + 8 <= end {
        s = wrappingAdd(s, b.getInt64(i))
        i += 8
    }
    while i < end {
        s = wrappingAdd(s, b[i] << ((i - from) & 7))
        i += 1
    }
    return s
}

// The repeated 8-byte word if buf[from, from + n) is one word repeated (n a multiple of 8), else -1 in ok[0].
function constWord(b: Bytes, from: Integer, n: Integer, ok: Bytes): Integer {
    ok[0] = 0
    if n == 0 || n % 8 != 0 { return 0 }
    let w = b.getInt64(from)
    let i = from + 8
    let end = from + n
    while i < end {
        if b.getInt64(i) != w { return 0 }
        i += 8
    }
    ok[0] = 1
    return w
}

// Appends piece p of `out` from buf[from, from + n): a constant piece, or a raw piece written to free space.
function emitPiece(st: Store, out: SegImage, buf: Bytes, from: Integer, n: Integer, wantSum: Boolean) {
    let flag = Bytes(1)
    let w = constWord(buf, from, n, flag)
    if flag[0] == 1 {
        out.offs.addInt64(-1)
        out.words.addInt64(w)
        out.crcs.addInt64(0)
        out.sums.addInt64(0)
        return
    }
    let off = df.alloc(st.data, n)
    df.write(st.data, off, buf, from, n)
    let c = crc.update(st.table, 0, buf, from, n)
    out.offs.addInt64(off)
    out.words.addInt64(0)
    out.crcs.addInt64(c)
    if wantSum { out.sums.addInt64(wordSum(buf, from, n)) } else { out.sums.addInt64(0) }
    st.newOffs.addInt64(off)
    st.newOffs.addInt64(n)
    st.newOffs.addInt64(c)
    st.lastWritten += n
    st.lastPieces += 1
}

function reusePiece(st: Store, out: SegImage, old: SegImage, p: Integer) {
    out.offs.addInt64(old.offs.getInt64(p * 8))
    out.words.addInt64(old.words.getInt64(p * 8))
    out.crcs.addInt64(old.crcs.getInt64(p * 8))
    out.sums.addInt64(old.sums.getInt64(p * 8))
    st.lastReused += 1
}

// A buffer tracked by a Seg: pieces that are dirty, new, or changed length are written; the rest keep their extent.
function writeTracked(st: Store, kind: Integer, obj: Integer, buf: Bytes, seg: tb.Seg, old: SegImage): SegImage {
    let out = newSegImage(kind, obj, buf.length)
    let np = pieceCount(buf.length)
    let oldN = pieceCount(old.length)
    for p in 0..np {
        let n = pieceLen(buf.length, p)
        let dirty = seg.all || p >= oldN || pieceLen(old.length, p) != n ||
                    (p < seg.dirty.length && seg.dirty[p] != 0)
        if dirty {
            emitPiece(st, out, buf, p << tb.PIECE_SHIFT, n, false)
        } else {
            reusePiece(st, out, old, p)
        }
    }
    seg.dirty = Bytes()
    seg.all = false
    return out
}

// A buffer without write tracking (scales, or the committed-state image): pieces whose content hash (crc + word
// sum + length) is unchanged keep their extent.
function writeHashed(st: Store, kind: Integer, obj: Integer, buf: Bytes, old: SegImage): SegImage {
    let out = newSegImage(kind, obj, buf.length)
    let np = pieceCount(buf.length)
    let oldN = pieceCount(old.length)
    for p in 0..np {
        let from = p << tb.PIECE_SHIFT
        let n = pieceLen(buf.length, p)
        let same = false
        if p < oldN && pieceLen(old.length, p) == n {
            let o = old.offs.getInt64(p * 8)
            if o < 0 {
                let flag = Bytes(1)
                let w = constWord(buf, from, n, flag)
                same = flag[0] == 1 && w == old.words.getInt64(p * 8)
            } else {
                same = crc.update(st.table, 0, buf, from, n) == old.crcs.getInt64(p * 8) &&
                       wordSum(buf, from, n) == old.sums.getInt64(p * 8)
            }
        }
        if same {
            reusePiece(st, out, old, p)
        } else {
            emitPiece(st, out, buf, from, n, true)
        }
    }
    return out
}

// Checkpoint one loaded table: write its changed pieces; returns (and records) its new image. The old image is
// kept until commit() or abandon().
public function writeTable(st: Store, c: cat.Catalog, tm: txn.TxnMgr, committing: Bytes, t: tb.Table): TableImage {
    let old = imageOf(st, t.id)
    st.oldImages.add(old)
    st.oldIds.addInt64(t.id)
    let img = emptyImage()
    img.present = true
    img.nrows = t.nrows
    // committed row state, built piece by piece into one buffer
    let stateBuf = Bytes()
    let piece = st.scratch
    let liveRows = 0
    let r = 0
    while r < t.nrows {
        let n = min(tb.PIECE, t.nrows - r)
        liveRows += stateImage(c, tm, committing, t, r, n, piece)
        stateBuf.addBytes(piece)
        r += n
    }
    img.live = liveRows
    img.segs.add(writeHashed(st, K_STATE, 0, stateBuf, findSeg(old, K_STATE, 0)))
    let ci = 0
    for col in t.cols {
        img.heapShared.addInt64(col.heapShared)
        img.heapDead.addInt64(col.heapDead)
        if col.segs.length == 0 { col.segs = [tb.newSeg(), tb.newSeg(), tb.newSeg()] }
        img.segs.add(writeTracked(st, K_DATA, ci, col.data, col.segs[0], findSeg(old, K_DATA, ci)))
        img.segs.add(writeTracked(st, K_NULLS, ci, col.nulls, col.segs[1], findSeg(old, K_NULLS, ci)))
        if col.perRowScale { img.segs.add(writeHashed(st, K_SCALES, ci, col.scales, findSeg(old, K_SCALES, ci))) }
        if v.isTextType(col.type) { img.segs.add(writeTracked(st, K_HEAP, ci, col.heap, col.segs[2], findSeg(old, K_HEAP, ci))) }
        ci += 1
    }
    let hi = 0
    for hid in t.hashIds {
        let h = c.hashIdx[hid]
        img.hashMeta.addInt64(h.mask)
        img.hashMeta.addInt64(h.used)
        img.hashMeta.addInt64(h.live)
        if h.segs.length == 0 { h.segs = [tb.newSeg()] }
        img.segs.add(writeTracked(st, K_SLOTS, hi, h.slots, h.segs[0], findSeg(old, K_SLOTS, hi)))
        hi += 1
    }
    let oi = 0
    for oid in t.ordIds {
        let o = c.ordIdx[oid]
        if o.segs.length == 0 { o.segs = [tb.newSeg(), tb.newSeg()] }
        img.segs.add(writeTracked(st, K_OMAIN, oi, o.main, o.segs[0], findSeg(old, K_OMAIN, oi)))
        img.segs.add(writeTracked(st, K_ODELTA, oi, o.delta, o.segs[1], findSeg(old, K_ODELTA, oi)))
        oi += 1
    }
    img.nord = t.ordIds.length
    overlayFor(tm, t, img)
    setImage(st, t.id, img)
    return img
}

// A table that no longer exists (dropped): its image goes away with the next manifest.
public function dropImage(st: Store, tid: Integer) {
    if isKnown(st, tid) && st.images[tid].present {
        st.oldImages.add(st.images[tid])
        st.oldIds.addInt64(tid)
    }
    setImage(st, tid, emptyImage())
}

public function beginCheckpoint(st: Store) {
    st.newOffs = Bytes()
    st.oldImages = []
    st.oldIds = Bytes()
    st.lastWritten = 0
    st.lastPieces = 0
    st.lastReused = 0
}

// Make the new pieces durable (blocking fdatasync) and re-read them: every new piece must read back with its CRC.
public function syncAndVerify(st: Store): Boolean {
    if st.newOffs.length == 0 { return true }
    df.sync(st.data)
    let n = st.newOffs.length / 24
    let b = Bytes()
    for i in 0..n {
        let off = st.newOffs.getInt64(i * 24)
        let len = st.newOffs.getInt64(i * 24 + 8)
        b.clear()
        df.readAppend(st.data, off, b, len)
        if crc.update(st.table, 0, b, 0, len) != st.newOffs.getInt64(i * 24 + 16) { return false }
    }
    return true
}

// The new manifest is durable and verified: extents only the replaced images used are free now.
public function commit(st: Store) {
    let keep = hm.newIntMap(64)
    let i = 0
    while i < st.images.length {
        if st.known[i] == 1 {
            for s in st.images[i].segs {
                let np = pieceCount(s.length)
                for p in 0..np {
                    let o = s.offs.getInt64(p * 8)
                    if o >= 0 { hm.put(keep, o, 1) }
                }
            }
        }
        i += 1
    }
    for img in st.oldImages {
        for s in img.segs {
            let np = pieceCount(s.length)
            for p in 0..np {
                let o = s.offs.getInt64(p * 8)
                if o >= 0 && !hm.contains(keep, o) {
                    df.release(st.data, o, pieceLen(s.length, p))
                    hm.put(keep, o, 1)
                }
            }
        }
    }
    st.oldImages = []
    st.oldIds = Bytes()
    st.newOffs = Bytes()
    df.trimTail(st.data)
}

// The checkpoint was not published (or not verified): restore the previous images, free the new pieces, and mark
// the tables all-dirty so the next checkpoint writes them again.
public function abandon(st: Store, c: cat.Catalog) {
    let n = st.oldIds.length / 8
    for i in 0..n {
        let tid = st.oldIds.getInt64(i * 8)
        setImage(st, tid, st.oldImages[i])
        if tid < c.tables.length { markAllDirty(c, c.tables[tid]) }
    }
    let m = st.newOffs.length / 24
    for i in 0..m { df.release(st.data, st.newOffs.getInt64(i * 24), st.newOffs.getInt64(i * 24 + 8)) }
    st.oldImages = []
    st.oldIds = Bytes()
    st.newOffs = Bytes()
}

public function markAllDirty(c: cat.Catalog, t: tb.Table) {
    for col in t.cols {
        for s in col.segs { s.all = true }
    }
    for hid in t.hashIds {
        for s in c.hashIdx[hid].segs { s.all = true }
    }
    for oid in t.ordIds {
        for s in c.ordIdx[oid].segs { s.all = true }
    }
}

// ---------------------------------------------------------------- loading

// pread every piece of a persisted buffer into one Bytes (adjacent pieces in one read) and check piece CRCs.
function readSeg(st: Store, s: SegImage): Bytes {
    let out = Bytes()
    let np = pieceCount(s.length)
    let p = 0
    while p < np {
        let o = s.offs.getInt64(p * 8)
        if o < 0 {
            let n = pieceLen(s.length, p)
            let w = s.words.getInt64(p * 8)
            let k = 0
            while k + 8 <= n {
                out.addInt64(w)
                k += 8
            }
            p += 1
        } else {
            // run of raw pieces that are contiguous in the file
            let q = p + 1
            let total = pieceLen(s.length, p)
            while q < np && s.offs.getInt64(q * 8) == o + total && pieceLen(s.length, q - 1) == tb.PIECE {
                total += pieceLen(s.length, q)
                q += 1
            }
            let base = out.length
            df.readAppend(st.data, o, out, total)
            let at = base
            while p < q {
                let n = pieceLen(s.length, p)
                if crc.update(st.table, 0, out, at, n) != s.crcs.getInt64(p * 8) {
                    fail("storage: data.db piece at " + Text(s.offs.getInt64(p * 8)) + " fails its CRC (table image " +
                         "kind " + Text(s.kind) + "); the data file is corrupt")
                }
                at += n
                p += 1
            }
        }
    }
    return out
}

function cleanSeg(): tb.Seg {
    let s = tb.newSeg()
    s.all = false
    return s
}

// Load table t from its image: buffers by pread, indexes included (rebuilt instead if the image was written with
// different hash functions), then the overlay. Replaces any paged stand-in.
public function loadTable(st: Store, c: cat.Catalog, t: tb.Table, img: TableImage) {
    st.loads += 1
    t.paged = []
    for hid in t.hashIds { c.hashIdx[hid].paged = [] }
    if !img.present {
        tb.truncate(t)
        cat.rebuildIndexes(c, t)
        return
    }
    t.state = readSeg(st, findSeg(img, K_STATE, 0))
    t.nrows = img.nrows
    t.live = img.live
    t.lockedCount = 0
    let ci = 0
    for col in t.cols {
        col.data = readSeg(st, findSeg(img, K_DATA, ci))
        col.nulls = readSeg(st, findSeg(img, K_NULLS, ci))
        if col.perRowScale { col.scales = readSeg(st, findSeg(img, K_SCALES, ci)) } else { col.scales = Bytes() }
        if v.isTextType(col.type) { col.heap = readSeg(st, findSeg(img, K_HEAP, ci)) } else { col.heap = Bytes() }
        if ci * 8 < img.heapShared.length {
            col.heapShared = img.heapShared.getInt64(ci * 8)
            col.heapDead = img.heapDead.getInt64(ci * 8)
        }
        col.segs = [cleanSeg(), cleanSeg(), cleanSeg()]
        if col.data.length != t.nrows * col.width { fail("storage: table image of " + t.name + " has a bad column length") }
        ci += 1
    }
    if t.state.length != t.nrows { fail("storage: table image of " + t.name + " has a bad row state length") }
    let useImages = st.fingerprintOk && img.hashMeta.length / 24 == t.hashIds.length && img.nord == t.ordIds.length
    if useImages {
        let hi = 0
        for hid in t.hashIds {
            let h = c.hashIdx[hid]
            h.slots = readSeg(st, findSeg(img, K_SLOTS, hi))
            h.mask = img.hashMeta.getInt64(hi * 24)
            h.used = img.hashMeta.getInt64(hi * 24 + 8)
            h.live = img.hashMeta.getInt64(hi * 24 + 16)
            h.segs = [cleanSeg()]
            if h.slots.length != (h.mask + 1) * 8 { fail("storage: hash index image of " + t.name + " has a bad length") }
            hi += 1
        }
        let oi = 0
        for oid in t.ordIds {
            let o = c.ordIdx[oid]
            o.main = readSeg(st, findSeg(img, K_OMAIN, oi))
            o.delta = readSeg(st, findSeg(img, K_ODELTA, oi))
            o.segs = [cleanSeg(), cleanSeg()]
            oi += 1
        }
    } else {
        cat.rebuildIndexes(c, t)
    }
    applyOverlay(c, t, img)
    setImage(st, t.id, img)
}

function applyOverlay(c: cat.Catalog, t: tb.Table, img: TableImage) {
    if img.noverlay == 0 { return }
    let b = img.overlay
    let cur = tb.Cursor { pos: 0 }
    for i in 0..img.noverlay {
        let r = tb.getUVarint(b, cur)
        let len = tb.getUVarint(b, cur)
        let start = cur.pos
        if r < t.nrows {
            cat.indexRemoveRow(c, t, r)
            let rc = tb.Cursor { pos: start }
            tb.decodeRow(t, r, b, rc)
            cat.indexInsertRow(c, t, r)
        }
        cur.pos = start + len
    }
}

// ---------------------------------------------------------------- paged point lookups

function segMap(s: SegImage): tb.SegMap {
    return tb.SegMap { length: s.length; offs: s.offs; words: s.words }
}

// Put table t (not loaded, image img) into paged mode for hash index hid: row 0 becomes the stand-in that
// index probes fault rows into. False if the image cannot serve lookups (overlay rows, other hash functions).
public function pagedSetup(st: Store, c: cat.Catalog, t: tb.Table, hid: Integer, img: TableImage): Boolean {
    if !img.present || img.noverlay > 0 || !st.fingerprintOk { return false }
    if img.hashMeta.length / 24 != t.hashIds.length { return false }
    let hi = -1
    let k = 0
    for h in t.hashIds {
        if h == hid { hi = k }
        k += 1
    }
    if hi < 0 { return false }
    let fd = df.fd(st.data)
    let h = c.hashIdx[hid]
    if t.paged.length == 0 {
        let pg = tb.Paged {
            fd: fd; nrows: img.nrows; state: segMap(findSeg(img, K_STATE, 0)); data: []; nulls: []; scales: []; heap: []
            buf: Bytes(); faults: 0
        }
        let ci = 0
        for col in t.cols {
            pg.data.add(segMap(findSeg(img, K_DATA, ci)))
            pg.nulls.add(segMap(findSeg(img, K_NULLS, ci)))
            pg.scales.add(segMap(findSeg(img, K_SCALES, ci)))
            pg.heap.add(segMap(findSeg(img, K_HEAP, ci)))
            col.data = Bytes(col.width)
            col.nulls = Bytes(2)
            col.heap = Bytes()
            if col.perRowScale { col.scales = Bytes(1) } else { col.scales = Bytes() }
            ci += 1
        }
        t.state = Bytes(1)
        t.state[0] = tb.ST_DEAD
        t.nrows = 1
        t.live = 0
        t.paged = [pg]
    }
    if h.paged.length == 0 {
        h.mask = img.hashMeta.getInt64(hi * 24)
        h.paged = [ix.PagedSlots { table: t; slots: segMap(findSeg(img, K_SLOTS, hi)); pageNos: Bytes(); pages: [] }]
    }
    return true
}

public function faults(t: tb.Table): Integer {
    if t.paged.length == 0 { return 0 }
    return t.paged[0].faults
}

// ---------------------------------------------------------------- sliced checkpoints (M3)
//
// begin() captures the state at the checkpoint LSN S in one short step: the row state and scales are copied
// (memcpy), rows locked at S get their committed status computed now, the overlay is built, and every tracked
// buffer is armed for copy-before-write (tb.Seg.capOn) with its changed pieces marked pending. step() then writes
// pieces in time-bounded slices (a pending piece is read from the live buffer, which nobody has changed since S,
// or from the copy taken before its first change), waits for the background fdatasync of data.db, and re-reads the
// new pieces; the engine then publishes the manifest. Nothing a durable manifest references is overwritten, so a
// crash at any point leaves the previous checkpoint intact.

record CapBuf {
    kind: Integer
    obj: Integer
    buf: Bytes                   // tracked: the buffer object at S; hashed: a copy taken at S
    seg: tb.Seg
    tracked: Boolean
    len: Integer
    old: SegImage
    out: SegImage
    next: Integer
}

record CapTable {
    tid: Integer
    img: TableImage
    bufs: List<CapBuf>
    next: Integer
    stateRaw: Bytes              // row state at S
    fix: hm.IntMap               // row -> committed state, for rows locked at S
    bulkLo: Bytes                // committing COPY ranges at S: rows still dead+new in them are live
    bulkHi: Bytes
    liveRows: Integer
}

public record Ckpt {
    active: Boolean
    lsn: Integer
    phase: Integer               // 1 write pieces, 2 wait for data.db fdatasync, 3 verify, 4 ready to publish
    tables: List<CapTable>
    ti: Integer
    vi: Integer
    ntables: Integer             // catalog size at S
    descs: List<Bytes>           // per table id < ntables: encoded descriptor (captured tables filled at the end)
    dropped: Bytes               // i64 ids of tables dropped at S
    catalog: Bytes
    began: Integer               // monotonic ns
    slices: Integer
    maxSliceUs: Integer
}

public function idleCkpt(): Ckpt {
    return Ckpt {
        active: false; lsn: 0; phase: 0; tables: []; ti: 0; vi: 0; ntables: 0; descs: []; dropped: Bytes()
        catalog: Bytes(); began: 0; slices: 0; maxSliceUs: 0
    }
}

function capTracked(st: Store, kind: Integer, obj: Integer, buf: Bytes, seg: tb.Seg, old: SegImage): CapBuf {
    let np = pieceCount(buf.length)
    let oldN = pieceCount(old.length)
    let pend = Bytes(np)
    let copies: List<Bytes> = []
    let none = Bytes()
    for p in 0..np {
        let n = pieceLen(buf.length, p)
        if seg.all || p >= oldN || pieceLen(old.length, p) != n || (p < seg.dirty.length && seg.dirty[p] != 0) { pend[p] = 1 }
        copies.add(none)
    }
    seg.dirty = Bytes()
    seg.all = false
    seg.capState = pend
    seg.capCopies = copies
    seg.capLen = buf.length
    seg.capOn = true
    return CapBuf { kind: kind; obj: obj; buf: buf; seg: seg; tracked: true; len: buf.length; old: old
                    out: newSegImage(kind, obj, buf.length); next: 0 }
}

function capHashed(kind: Integer, obj: Integer, copy: Bytes, len: Integer, old: SegImage): CapBuf {
    return CapBuf { kind: kind; obj: obj; buf: copy; seg: tb.newSeg(); tracked: false; len: len; old: old
                    out: newSegImage(kind, obj, len); next: 0 }
}

function captureTable(st: Store, c: cat.Catalog, tm: txn.TxnMgr, committing: Bytes, t: tb.Table): CapTable {
    let old = imageOf(st, t.id)
    let img = emptyImage()
    img.present = true
    img.nrows = t.nrows
    let ct = CapTable { tid: t.id; img: img; bufs: []; next: 0; stateRaw: t.state.slice(0, t.nrows); fix: hm.newIntMap(16)
                        bulkLo: Bytes(); bulkHi: Bytes(); liveRows: 0 }
    // committed status of rows locked at S, and COPY ranges of transactions committing at S
    for tx in tm.txns {
        if tx.state == txn.TX_ACTIVE || tx.state == txn.TX_COMMITTING {
            let u = 0
            while u < tx.uCount {
                let k = tx.uKind.getInt64(u * 8)
                if tx.uTable.getInt64(u * 8) == t.id {
                    let r = tx.uRow.getInt64(u * 8)
                    if (k & txn.U_OWNER) != 0 && r < t.nrows && (t.state[r] & tb.ST_LOCKED) != 0 {
                        hm.put(ct.fix, r, committedState(c, tm, committing, t, r, t.state[r]))
                    }
                    if (k & 15) == txn.U_BULK && tx.state == txn.TX_COMMITTING {
                        ct.bulkLo.addInt64(r)
                        ct.bulkHi.addInt64(k >> 8)
                    }
                }
                u += 1
            }
        }
    }
    ct.bufs.add(capHashed(K_STATE, 0, Bytes(), t.nrows, findSeg(old, K_STATE, 0)))   // built per piece from stateRaw
    let ci = 0
    for col in t.cols {
        img.heapShared.addInt64(col.heapShared)
        img.heapDead.addInt64(col.heapDead)
        if col.segs.length == 0 { col.segs = [tb.newSeg(), tb.newSeg(), tb.newSeg()] }
        ct.bufs.add(capTracked(st, K_DATA, ci, col.data, col.segs[0], findSeg(old, K_DATA, ci)))
        ct.bufs.add(capTracked(st, K_NULLS, ci, col.nulls, col.segs[1], findSeg(old, K_NULLS, ci)))
        if col.perRowScale {
            let sc = col.scales.slice(0, col.scales.length)
            ct.bufs.add(capHashed(K_SCALES, ci, sc, sc.length, findSeg(old, K_SCALES, ci)))
        }
        if v.isTextType(col.type) { ct.bufs.add(capTracked(st, K_HEAP, ci, col.heap, col.segs[2], findSeg(old, K_HEAP, ci))) }
        ci += 1
    }
    let hi = 0
    for hid in t.hashIds {
        let h = c.hashIdx[hid]
        img.hashMeta.addInt64(h.mask)
        img.hashMeta.addInt64(h.used)
        img.hashMeta.addInt64(h.live)
        if h.segs.length == 0 { h.segs = [tb.newSeg()] }
        ct.bufs.add(capTracked(st, K_SLOTS, hi, h.slots, h.segs[0], findSeg(old, K_SLOTS, hi)))
        hi += 1
    }
    let oi = 0
    for oid in t.ordIds {
        let o = c.ordIdx[oid]
        if o.segs.length == 0 { o.segs = [tb.newSeg(), tb.newSeg()] }
        ct.bufs.add(capTracked(st, K_OMAIN, oi, o.main, o.segs[0], findSeg(old, K_OMAIN, oi)))
        ct.bufs.add(capTracked(st, K_ODELTA, oi, o.delta, o.segs[1], findSeg(old, K_ODELTA, oi)))
        oi += 1
    }
    img.nord = t.ordIds.length
    overlayFor(tm, t, img)
    return ct
}

// Capture the state at LSN lsn. Loaded tables are captured; the others carry their current image.
public function begin(st: Store, ck: Ckpt, c: cat.Catalog, tm: txn.TxnMgr, committing: Bytes, lsn: Integer, catalog: Bytes) {
    beginCheckpoint(st)
    ck.active = true
    ck.lsn = lsn
    ck.phase = 1
    ck.tables = []
    ck.ti = 0
    ck.vi = 0
    ck.ntables = c.tables.length
    ck.descs = []
    ck.dropped = Bytes()
    ck.catalog = catalog
    ck.began = dbio.monotonicNanos()
    ck.slices = 0
    ck.maxSliceUs = 0
    for t in c.tables {
        if cat.isDropped(t) {
            ck.dropped.addInt64(t.id)
            ck.descs.add(Bytes())
        } else if t.chunk >= 0 {
            ck.descs.add(encodeDescriptor(imageOf(st, t.id)))
        } else {
            ck.tables.add(captureTable(st, c, tm, committing, t))
            ck.descs.add(Bytes())
        }
    }
}

// Committed state bytes of rows [from, from + n) from the capture; returns live rows.
function capState(ct: CapTable, from: Integer, n: Integer, out: Bytes): Integer {
    out.clear()
    let raw = ct.stateRaw
    let liveRows = 0
    let r = from
    let end = from + n
    while r < end {
        if r + 8 <= end && raw.getInt64(r) == 0 {
            out.addInt64(0)
            liveRows += 8
            r += 8
        } else {
            let s = raw[r]
            let cs = 1
            if s == 0 {
                cs = 0
            } else if s == tb.ST_DEAD {
                cs = 1
            } else if (s & tb.ST_LOCKED) != 0 {
                cs = hm.get(ct.fix, r, -1)
                if cs < 0 {
                    if (s & tb.ST_DEAD) != 0 { cs = 1 } else { cs = 0 }
                }
            } else {
                let k = 0
                let nb = ct.bulkLo.length / 8
                while k < nb {
                    if r >= ct.bulkLo.getInt64(k * 8) && r < ct.bulkHi.getInt64(k * 8) { cs = 0 }
                    k += 1
                }
            }
            out.add(cs)
            if cs == 0 { liveRows += 1 }
            r += 1
        }
    }
    return liveRows
}

// One piece of one captured buffer.
function capPiece(st: Store, ct: CapTable, cb: CapBuf) {
    let p = cb.next
    let from = p << tb.PIECE_SHIFT
    let n = pieceLen(cb.len, p)
    if cb.kind == K_STATE {
        ct.liveRows += capState(ct, from, n, st.scratch)
        hashedPiece(st, cb, st.scratch, 0, n, p)
    } else if !cb.tracked {
        hashedPiece(st, cb, cb.buf, from, n, p)
    } else {
        let ps = cb.seg.capState[p]
        if ps == 0 {
            reusePiece(st, cb.out, cb.old, p)
        } else if ps == 2 {
            emitPiece(st, cb.out, cb.seg.capCopies[p], 0, n, false)
            cb.seg.capCopies[p] = Bytes()
        } else {
            emitPiece(st, cb.out, cb.buf, from, n, false)
        }
        cb.seg.capState[p] = 0
    }
    cb.next = p + 1
}

function hashedPiece(st: Store, cb: CapBuf, b: Bytes, from: Integer, n: Integer, p: Integer) {
    let old = cb.old
    let same = false
    if p < pieceCount(old.length) && pieceLen(old.length, p) == n {
        let o = old.offs.getInt64(p * 8)
        if o < 0 {
            let flag = Bytes(1)
            let w = constWord(b, from, n, flag)
            same = flag[0] == 1 && w == old.words.getInt64(p * 8)
        } else {
            same = crc.update(st.table, 0, b, from, n) == old.crcs.getInt64(p * 8) && wordSum(b, from, n) == old.sums.getInt64(p * 8)
        }
    }
    if same { reusePiece(st, cb.out, old, p) } else { emitPiece(st, cb.out, b, from, n, true) }
}

function endCapture(cb: CapBuf) {
    if cb.tracked && cb.seg.capOn {
        cb.seg.capOn = false
        cb.seg.capState = Bytes()
        cb.seg.capCopies = []
    }
}

// Advance the checkpoint for about budgetNs of loop time (at least one piece). True when ready to publish.
public function step(st: Store, ck: Ckpt, budgetNs: Integer): Boolean {
    if !ck.active { return false }
    let t0 = dbio.monotonicNanos()
    ck.slices += 1
    while ck.phase == 1 {
        if ck.ti >= ck.tables.length {
            if st.newOffs.length == 0 {
                ck.phase = 4
            } else {
                df.syncStart(st.data)
                ck.phase = 2
            }
        } else {
            let ct = ck.tables[ck.ti]
            if ct.next >= ct.bufs.length {
                ct.img.live = ct.liveRows
                ck.ti += 1
            } else {
                let cb = ct.bufs[ct.next]
                if cb.next >= pieceCount(cb.len) {
                    endCapture(cb)
                    ct.img.segs.add(cb.out)
                    ct.next += 1
                } else {
                    capPiece(st, ct, cb)
                }
            }
        }
        if dbio.monotonicNanos() - t0 > budgetNs { return sliceEnd(ck, t0) }
    }
    if ck.phase == 2 {
        if !df.synced(st.data) { return sliceEnd(ck, t0) }
        ck.phase = 3
    }
    if ck.phase == 3 {
        let n = st.newOffs.length / 24
        let b = Bytes()
        while ck.vi < n {
            let off = st.newOffs.getInt64(ck.vi * 24)
            let len = st.newOffs.getInt64(ck.vi * 24 + 8)
            b.clear()
            df.readAppend(st.data, off, b, len)
            if crc.update(st.table, 0, b, 0, len) != st.newOffs.getInt64(ck.vi * 24 + 16) {
                fail("storage: data.db piece at " + Text(off) + " did not read back with its CRC right after being written")
            }
            ck.vi += 1
            if dbio.monotonicNanos() - t0 > budgetNs { return sliceEnd(ck, t0) }
        }
        ck.phase = 4
    }
    sliceEnd(ck, t0)
    return ck.phase == 4
}

function sliceEnd(ck: Ckpt, t0: Integer): Boolean {
    let us = (dbio.monotonicNanos() - t0) / 1000
    if us > ck.maxSliceUs { ck.maxSliceUs = us }
    return false
}

// Descriptors for the manifest (call when step() returned true); installs the new images. The caller publishes the
// manifest, then commit() (verified) or abandon().
public function finish(st: Store, ck: Ckpt): List<Bytes> {
    let n = ck.dropped.length / 8
    for i in 0..n { dropImage(st, ck.dropped.getInt64(i * 8)) }
    for ct in ck.tables {
        st.oldImages.add(imageOf(st, ct.tid))
        st.oldIds.addInt64(ct.tid)
        setImage(st, ct.tid, ct.img)
        ck.descs[ct.tid] = encodeDescriptor(ct.img)
    }
    df.syncStop(st.data)
    ck.active = false
    ck.tables = []
    let out = ck.descs
    ck.descs = []
    return out
}
