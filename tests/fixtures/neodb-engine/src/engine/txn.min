// Transactions: undo log, exclusive row locks (held until durable), before-image visibility, serial lock.
use "./values.min" as v
use "./hashmap.min" as hm
use "./table.min" as tb
use "./index.min" as ix
use "./catalog.min" as cat
use "../search/index.min" as si

public constant U_INSERT = 1
public constant U_UPDATE = 2
public constant U_DELETE = 3
public constant U_BULK = 4        // rows [uRow, uImgOff) inserted dead+new by COPY; made live at commit
public constant U_OWNER = 16      // flag: this entry took the row lock (first touch of the row by the txn)
public constant U_KEYCHG = 32     // flag: the update changed an indexed column

public constant TX_IDLE = 0
public constant TX_ACTIVE = 1
public constant TX_COMMITTING = 2

public record Txn {
    slot: Integer
    session: Integer
    state: Integer
    failed: Boolean
    serializable: Boolean
    commitLsn: Integer
    uKind: Bytes          // Int64 per undo entry (Bytes so it can be truncated)
    uTable: Bytes
    uRow: Bytes
    uImgOff: Bytes
    uCount: Integer
    uImg: Bytes
    redo: Bytes
    ddl: Boolean
    gen: Integer
}

public record TxnMgr {
    txns: List<Txn>
    freeSlots: Bytes
    locks: hm.IntMap
    serialOwner: Integer
    waitsFor: List<Integer>
    lockEpoch: Integer
    retain: Retain        // row versions for a statement suspended at a yield point (C2)
    catalog: List<cat.Catalog>   // the catalog whose search indexes see every row a transaction touches
}

public function newTxnMgr(): TxnMgr {
    return TxnMgr { txns: []; freeSlots: Bytes(); locks: hm.newIntMap(1024); serialOwner: -1; waitsFor: []; lockEpoch: 0; catalog: []; retain: newRetain() }
}

public function begin(m: TxnMgr, session: Integer): Txn {
    let slot = -1
    if m.freeSlots.length > 0 {
        slot = m.freeSlots.getInt64(m.freeSlots.length - 8)
        m.freeSlots.resize(m.freeSlots.length - 8)
    }
    if slot < 0 {
        slot = m.txns.length
        let t = newTxn(slot)
        m.txns.add(t)
        m.waitsFor.add(-1)
    }
    let t = m.txns[slot]
    t.session = session
    t.state = TX_ACTIVE
    t.failed = false
    t.serializable = false
    t.commitLsn = 0
    t.ddl = false
    t.gen += 1
    m.waitsFor[slot] = -1
    return t
}

function newTxn(slot: Integer): Txn {
    return Txn { slot: slot; session: -1; state: TX_IDLE; failed: false; serializable: false; commitLsn: 0
                 uKind: Bytes(); uTable: Bytes(); uRow: Bytes(); uImgOff: Bytes(); uCount: 0; uImg: Bytes(); redo: Bytes(); ddl: false; gen: 0 }
}

function resetTxn(m: TxnMgr, t: Txn) {
    t.state = TX_IDLE
    t.uKind.clear()
    t.uTable.clear()
    t.uRow.clear()
    t.uImgOff.clear()
    t.uCount = 0
    if t.uImg.length > 65536 { t.uImg = Bytes() } else { t.uImg.clear() }
    if t.redo.length > 65536 { t.redo = Bytes() } else { t.redo.clear() }
    t.failed = false
    if m.serialOwner == t.slot { m.serialOwner = -1 }
    m.waitsFor[t.slot] = -1
    m.freeSlots.addInt64(t.slot)
}

public function lockKey(tableId: Integer, row: Integer): Integer {
    return (tableId << 40) | row
}

// Owner txn slot of a locked row, or -1.
public function ownerOf(m: TxnMgr, tableId: Integer, row: Integer): Integer {
    let x = hm.get(m.locks, lockKey(tableId, row), -1)
    if x < 0 { return -1 }
    return x >> 32
}

public function ownerUndo(m: TxnMgr, tableId: Integer, row: Integer): Integer {
    let x = hm.get(m.locks, lockKey(tableId, row), -1)
    if x < 0 { return -1 }
    return x & 4294967295
}

// Visibility of row r of t for reader txn slot `me` (-1 = no txn).
// Returns 0 invisible, 1 visible (current data), 2 visible through the before-image.
public function visibility(m: TxnMgr, t: tb.Table, r: Integer, me: Integer): Integer {
    let st = t.state[r]
    if st == 0 { return 1 }
    if (st & tb.ST_LOCKED) == 0 { return 0 }
    let x = hm.get(m.locks, lockKey(t.id, r), -1)
    if x < 0 {
        if (st & tb.ST_DEAD) != 0 { return 0 }
        return 1
    }
    let owner = x >> 32
    if owner == me {
        if (st & tb.ST_DEAD) != 0 { return 0 }
        return 1
    }
    if (st & tb.ST_NEW) != 0 { return 0 }
    let ow = m.txns[owner]
    let u = x & 4294967295
    if (ow.uKind.getInt64(u * 8) & 15) == U_UPDATE { return 2 }
    return 1
}

// Decode the before-image of a locked row into row 0 of scratch.
public function loadBeforeImage(m: TxnMgr, t: tb.Table, r: Integer, scratch: tb.Table) {
    let x = hm.get(m.locks, lockKey(t.id, r), -1)
    let owner = x >> 32
    let u = x & 4294967295
    let ow = m.txns[owner]
    if scratch.nrows == 0 { tb.reserveRow(scratch, 0) }
    let cur = tb.Cursor { pos: ow.uImgOff.getInt64(u * 8) }
    tb.decodeRow(scratch, 0, ow.uImg, cur)
}

// Can txn `me` modify row r? Returns -1 if yes, else the owner slot that blocks.
public function blocker(m: TxnMgr, t: tb.Table, r: Integer, me: Integer): Integer {
    let st = t.state[r]
    if (st & tb.ST_LOCKED) == 0 { return -1 }
    let owner = ownerOf(m, t.id, r)
    if owner < 0 || owner == me { return -1 }
    return owner
}

// ---- row versions for a preempted statement (C2, docs/r2/search.md "Preemptible searches")
// While a long read-only search statement is suspended at a yield point, short statements of other sessions run and may
// commit. The suspended statement must still read every row as of its own start: the first change of a row during the
// window keeps a copy of the row as it was (state byte + tb.encodeRow image), and that statement reads the copy.

public record Retain {
    on: Boolean
    rows: hm.IntMap        // (table id << 36) | row -> index into imgs
    imgs: List<Bytes>      // state byte, then the encoded row
    limit: Bytes           // int64 per table id: rows at or beyond it did not exist when the window opened (0 = no table)
}

function newRetain(): Retain { return Retain { on: false; rows: hm.newIntMap(16); imgs: []; limit: Bytes() } }

public function retainOn(m: TxnMgr, c: cat.Catalog) {
    let rt = m.retain
    rt.on = true
    rt.rows = hm.newIntMap(64)
    rt.imgs = []
    rt.limit = Bytes(c.tables.length * 8)
    let i = 0
    while i < c.tables.length {
        rt.limit.setInt64(i * 8, c.tables[i].nrows)
        i += 1
    }
}

public function retainOff(m: TxnMgr) { m.retain = newRetain() }

public function retaining(m: TxnMgr): Boolean { return m.retain.on }

// Keep row r of t as the window's statement sees it, if this is its first change since the window opened: the row as it
// is, or for a row locked by a transaction that is still open, its committed version (that transaction's before-image).
public function retainRow(m: TxnMgr, t: tb.Table, r: Integer) {
    let rt = m.retain
    if !rt.on || t.id * 8 >= rt.limit.length || r >= rt.limit.getInt64(t.id * 8) { return }
    let key = (t.id << 36) | r
    if hm.contains(rt.rows, key) { return }
    let b = Bytes()
    let st = t.state[r]
    if (st & tb.ST_LOCKED) != 0 {
        let x = hm.get(m.locks, lockKey(t.id, r), -1)
        if (st & tb.ST_NEW) != 0 {
            b.add(tb.ST_NEW)                     // inserted by an open transaction: not visible
        } else if x >= 0 && (m.txns[x >> 32].uKind.getInt64((x & 4294967295) * 8) & 15) == U_UPDATE {
            let ow = m.txns[x >> 32]
            let off = ow.uImgOff.getInt64((x & 4294967295) * 8)
            b.add(0)
            let tmp = tb.cloneSchema(t, -3)
            tb.reserveRow(tmp, 0)
            let cur = tb.Cursor { pos: off }
            tb.decodeRow(tmp, 0, ow.uImg, cur)
            tb.encodeRow(tmp, 0, b)
        } else {
            b.add(0)                             // deleted (or locked) by an open transaction: the data is unchanged
            tb.encodeRow(t, r, b)
        }
    } else {
        b.add(st)
        tb.encodeRow(t, r, b)
    }
    hm.put(rt.rows, key, rt.imgs.length)
    rt.imgs.add(b)
}

// Image of row r of t as of the window's start: -1 when unchanged since, else 0 (dead or invisible: no image) or 1 (the
// image is decoded into row 0 of scratch).
public function retainedRow(m: TxnMgr, t: tb.Table, r: Integer, scratch: tb.Table): Integer {
    let rt = m.retain
    if !rt.on { return -1 }
    if t.id * 8 < rt.limit.length && r >= rt.limit.getInt64(t.id * 8) { return 0 }
    let i = hm.get(rt.rows, (t.id << 36) | r, -1)
    if i < 0 { return -1 }
    let b = rt.imgs[i]
    let st = b[0]
    // the state at the window's start, seen by a statement outside every transaction then: live unless dead or new
    if (st & tb.ST_DEAD) != 0 && (st & tb.ST_LOCKED) == 0 { return 0 }
    if (st & tb.ST_NEW) != 0 { return 0 }
    if scratch.nrows == 0 { tb.reserveRow(scratch, 0) }
    let cur = tb.Cursor { pos: 1 }
    tb.decodeRow(scratch, 0, b, cur)
    return 1
}

// Record an undo entry; takes the lock on first touch. Returns the undo index.
public function addUndo(m: TxnMgr, tx: Txn, t: tb.Table, r: Integer, kind: Integer, withImage: Boolean): Integer {
    retainRow(m, t, r)
    if t.searchIds.length > 0 && m.catalog.length > 0 {
        let c = m.catalog[0]
        for sid in t.searchIds { si.touchRow(c.searchIdx[sid], t, r) }
    }
    let u = tx.uCount
    let k = kind
    let st = t.state[r]
    if (st & tb.ST_LOCKED) == 0 {
        k = k | U_OWNER
        hm.put(m.locks, lockKey(t.id, r), (tx.slot << 32) | u)
        t.state[r] = st | tb.ST_LOCKED
        t.lockedCount += 1
    }
    tx.uKind.addInt64(k)
    tx.uTable.addInt64(t.id)
    tx.uRow.addInt64(r)
    tx.uImgOff.addInt64(tx.uImg.length)
    tx.uCount = u + 1
    if withImage { tb.encodeRow(t, r, tx.uImg) }
    return u
}

// Bulk-insert undo entry (no locks): rows [start, end) of t.
public function addBulkUndo(tx: Txn, t: tb.Table, start: Integer, end: Integer) {
    tx.uKind.addInt64(U_BULK | (end << 8))
    tx.uTable.addInt64(t.id)
    tx.uRow.addInt64(start)
    tx.uImgOff.addInt64(tx.uImg.length)
    tx.uCount += 1
}

public function extendBulkUndo(tx: Txn, u: Integer, end: Integer) {
    tx.uKind.setInt64(u * 8, U_BULK | (end << 8))
}

public function markKeyChange(tx: Txn, u: Integer) {
    tx.uKind.setInt64(u * 8, tx.uKind.getInt64(u * 8) | U_KEYCHG)
}

// Undo entries [from, end) in reverse; releases locks taken by them.
public function rollbackTo(m: TxnMgr, c: cat.Catalog, tx: Txn, from: Integer) {
    let i = tx.uCount - 1
    let released = false
    while i >= from {
        let k = tx.uKind.getInt64(i * 8)
        let t = c.tables[tx.uTable.getInt64(i * 8)]
        let r = tx.uRow.getInt64(i * 8)
        let kind = k & 15
        if !cat.isDropped(t) && r < t.nrows {
            if kind == U_INSERT {
                if (t.state[r] & tb.ST_DEAD) == 0 { t.live -= 1 }
                t.state[r] = t.state[r] | tb.ST_DEAD
            } else if kind == U_UPDATE {
                if (k & U_KEYCHG) != 0 { cat.indexRemoveRow(c, t, r) }
                let cur = tb.Cursor { pos: tx.uImgOff.getInt64(i * 8) }
                tb.decodeRow(t, r, tx.uImg, cur)
                if (k & U_KEYCHG) != 0 { cat.indexInsertRow(c, t, r) }
            } else if kind == U_DELETE {
                if (t.state[r] & tb.ST_DEAD) != 0 { t.live += 1 }
                t.state[r] = t.state[r] & (255 - tb.ST_DEAD)
            } else if kind == U_BULK {
                let e = k >> 8
                let x = r
                while x < e && x < t.nrows {
                    t.state[x] = tb.ST_DEAD
                    x += 1
                }
            }
            if (k & U_OWNER) != 0 {
                hm.remove(m.locks, lockKey(t.id, r))
                t.state[r] = t.state[r] & (255 - tb.ST_LOCKED - tb.ST_NEW)
                t.lockedCount -= 1
                released = true
            }
        }
        i -= 1
    }
    if from < tx.uCount {
        tx.uImg.resize(tx.uImgOff.getInt64(from * 8))
    }
    tx.uKind.resize(from * 8)
    tx.uTable.resize(from * 8)
    tx.uRow.resize(from * 8)
    tx.uImgOff.resize(from * 8)
    tx.uCount = from
    if released { m.lockEpoch += 1 }
}

// Abort: undo everything and free the txn.
public function abort(m: TxnMgr, c: cat.Catalog, tx: Txn) {
    rollbackTo(m, c, tx, 0)
    resetTxn(m, tx)
    m.lockEpoch += 1
}

// Commit became durable: release locks, keep changes.
public function finishCommit(m: TxnMgr, c: cat.Catalog, tx: Txn) {
    let n = tx.uCount
    let i = 0
    while i < n {
        let k = tx.uKind.getInt64(i * 8)
        if (k & 15) == U_BULK {
            let t = c.tables[tx.uTable.getInt64(i * 8)]
            let x = tx.uRow.getInt64(i * 8)
            let e = k >> 8
            if !cat.isDropped(t) {
                while x < e && x < t.nrows {
                    if t.state[x] == tb.ST_DEAD + tb.ST_NEW {
                        t.state[x] = 0
                        t.live += 1
                    }
                    x += 1
                }
            }
        }
        if (k & U_OWNER) != 0 {
            let t = c.tables[tx.uTable.getInt64(i * 8)]
            let r = tx.uRow.getInt64(i * 8)
            if !cat.isDropped(t) && r < t.nrows {
                // a statement suspended at a yield point started while this transaction was not yet visible: it keeps
                // reading the row as it was before (retainRow takes the before-image while the row is still locked)
                retainRow(m, t, r)
                hm.remove(m.locks, lockKey(t.id, r))
                t.state[r] = t.state[r] & (255 - tb.ST_LOCKED - tb.ST_NEW)
                t.lockedCount -= 1
            }
        }
        i += 1
    }
    resetTxn(m, tx)
    m.lockEpoch += 1
}

// Read-only or already-empty txn end.
public function finishEmpty(m: TxnMgr, tx: Txn) {
    resetTxn(m, tx)
    m.lockEpoch += 1
}

public function hasWrites(tx: Txn): Boolean {
    return tx.uCount > 0 || tx.redo.length > 0
}

// Wait-for graph: does making `me` wait for `other` close a cycle?
public function wouldDeadlock(m: TxnMgr, me: Integer, other: Integer): Boolean {
    let cur = other
    let steps = 0
    while cur >= 0 && steps < 10000 {
        if cur == me { return true }
        if m.txns[cur].state != TX_ACTIVE { return false }
        cur = m.waitsFor[cur]
        steps += 1
    }
    return false
}
