use "./net-fixtures.min" as fixtures
use "../tools/testing.min" as test

fixtures.arguments(["--sanitize"], [])
let context = fixtures.context(fixtures.flag("--sanitize"))
let binary = context.work + "/churn"
fixtures.compileProgram(context, "tests/yamux-churn.min", binary)
let result = fixtures.run(context, [binary], 30)
test.check(result.status == 0, "yamux churn failed (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
fixtures.emit(result.output)
fixtures.finish(context)
