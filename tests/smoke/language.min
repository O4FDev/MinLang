// Smoke program: touches every ordinary language feature once so a broken
// build fails here in a second rather than deep inside the fuzzers.

record Point {
    x: Integer
    y: Integer
}

record Segment {
    start: Point
    end: Point
    label: Text
}

function factorial(value: Integer): Integer {
    if value <= 1 {
        return 1
    }
    return value * factorial(value - 1)
}

function classify(value: Integer): Text {
    if value < 0 {
        return "negative"
    } else {
        if value == 0 {
            return "zero"
        } else {
            if value % 2 == 0 {
                return "even"
            }
            return "odd"
        }
    }
}

function loud(): Boolean {
    print("short-circuit failed")
    return false
}

function manhattan(segment: Segment): Integer {
    let dx = segment.end.x - segment.start.x
    let dy = segment.end.y - segment.start.y
    if dx < 0 {
        dx = -dx
    }
    if dy < 0 {
        dy = -dy
    }
    return dx + dy
}

function countMatching(values: List<Integer>, wanted: Integer): Integer {
    let position = 0
    let found = 0
    while position < values.length {
        if values[position] == wanted {
            found = found + 1
        }
        position = position + 1
    }
    return found
}

function firstVowel(text: Text): Integer {
    let position = 0
    while position < text.length {
        let character = text[position]
        if character == 'a' || character == 'e' || character == 'i' || character == 'o' || character == 'u' {
            return position
        }
        position = position + 1
    }
    return -1
}

// arithmetic and remainder
print(7 % 3)
print(-7 % 3)
print(17 / 5)
print(factorial(10))

// comparisons
print(1 != 2)
print(3 >= 3)
print(2 <= 1)
print('a' < 'b')
print('z' == 'z')
print(true == true)
print(false != true)

// boolean logic and short-circuiting
print(true || loud())
print(false && loud())
print(!(1 == 2))

// nested if/else chains (Minyar has no else-if form yet)
print(classify(-5))
print(classify(0))
print(classify(4))
print(classify(9))

// text escapes, conversions, and slicing
print("tab\tquote\"backslash\\")
print("line one\nline two")
print(Text(true))
print(Text('q'))
print("Minyar".slice(0, 3))
print("Minyar".slice(3, 6))
print("Minyar".slice(2, 2).length)
print(firstVowel("Minyar"))
print(firstVowel("xyz"))

// records, nesting, and lists of records
let origin = Point { x: 0, y: 0 }
let segment = Segment {
    label: "diagonal"
    start: origin
    end: Point { x: -3, y: 4 }
}
print(segment.label)
print(manhattan(segment))

let segments: List<Segment> = []
segments.add(segment)
print(segments[0].end.y)

// nested lists and indexed assignment (assigning through grid[0][1] is not supported yet)
let grid: List<List<Integer>> = []
let row: List<Integer> = []
row.add(1)
row.add(2)
row.add(3)
grid.add(row)
row[1] = 20
print(grid[0][1])
print(countMatching(row, 20))

// block scope: an inner binding does not replace the outer one after the block
let outer = 1
if true {
    let inner = outer + 1
    outer = inner * 10
}
print(outer)

// joinText
let parts: List<Text> = []
parts.add("a")
parts.add("b")
parts.add("c")
print(joinText(parts))

// early return from inside a loop and reaching the end of the program
let countdown = 3
while countdown > 0 {
    countdown = countdown - 1
}
print(countdown)
