// Remote-only host qualification of the production virtio block driver
// (os/shared/virtio) against a deterministic virtio-blk model. Each seed is a
// process: the model's World picks request sizes, completion delays and device
// faults (spurious completions, short completions, I/O errors). A seed must
// either read the disk image exactly or stop the driver; returning bytes the
// device never wrote is a driver bug. O0 and O2 must behave identically.
use "../tools/testing.min" as test
use "system" as system

let compiler = test.compiler()
let path = compiler.directory + "/virtio-model"
let environment = system.environment()
let compiled = test.run([compiler.executable, "tests/osdev-virtio-fixtures/driver.min", path + ".ll",
    "--library", "tests/osdev-virtio-fixtures/library", "--library", "library"], environment, "", path + ".compile", 60)
test.require(compiled, "compile actual virtio block/PCI with injected machine/arch")
let platform = test.run(["uname", "-s"], environment, "", path + ".platform", 10)
test.require(platform, "host platform")
let refusals = ["the disk reported error", "virtio device completed chain", "the disk wrote", "virtio device published a completion"]
let outcomes: List<Text> = []
let wrong: List<Text> = []
for optimization in ["-O0", "-O2"] {
    let command = [compiler.clang, optimization, "-Wno-override-module", "-ffunction-sections", "-fdata-sections"]
    for flag in compiler.flags { command.add(flag) }
    if platform.output == "Darwin\n" { command.add("-Wl,-dead_strip") } else { command.add("-Wl,--gc-sections") }
    for item in [path + ".ll", compiler.runtime, "-lm", "-o", path + optimization] { command.add(item) }
    test.require(test.run(command, environment, "", path + optimization + ".link", 60), "link virtio model " + optimization)
    let passed = 0
    let refused = 0
    // Delays only: every read must be exact.
    for seed in 1..31 {
        let result = test.run([path + optimization, Text(seed), "1", "6"], environment, "", path + optimization + "-clean", 60)
        test.check(result.status == 0 && result.errorOutput == "" && test.contains(result.output, "VIRTIO PASS"),
            "virtio clean seed " + Text(seed) + " " + optimization + "\n" + result.output + result.errorOutput)
        outcomes.add(optimization + " clean " + Text(seed) + " " + Text(result.status))
    }
    // All faults: exact data or a fail-closed stop, never wrong data.
    for seed in 1..61 {
        let result = test.run([path + optimization, Text(seed), "31", "6"], environment, "", path + optimization + "-faults", 60)
        if result.status == 0 {
            test.check(test.contains(result.output, "VIRTIO PASS"), "virtio pass transcript")
            passed += 1
        } else if result.status == 3 {
            wrong.add(optimization + " seed " + Text(seed) + ": " + result.output)
        } else {
            let known = false
            for message in refusals { if test.contains(result.errorOutput, message) { known = true } }
            test.check(known && result.status != 124 && result.status != 137, "unexpected virtio fault outcome seed " + Text(seed) + "\n" + result.output + result.errorOutput)
            refused += 1
        }
        outcomes.add(Text(seed) + " " + Text(result.status) + " " + result.output)
    }
    print(optimization + ": 30 delayed-completion seeds exact; 60 fault seeds: " + Text(passed) + " exact, " + Text(refused) + " refused, " + Text(wrong.length) + " wrong so far")
}
for line in wrong { print("WRONG DATA " + line) }
test.check(wrong.length == 0, "the virtio driver returned bytes the device never wrote on " + Text(wrong.length) + " seed runs")
// Each fault seed's transcript must match between -O0 and -O2.
let half = outcomes.length / 2
for index in 0..half {
    if index >= 30 { test.check(outcomes[index] == outcomes[half + index], "virtio seed replay differs between -O0 and -O2") }
}
test.removeTree(compiler.directory)
print("virtio host device model passed")
