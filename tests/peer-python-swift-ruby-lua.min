        print(x)
    } else { fail(\"wrong branch\") }
    print(x); print(a); print(b); print(c); print(d)
    print(d0); print(d1); print(d2); print(d3); print(d4)
    print(d5); print(d6); print(d7); print(d8); print(d9)
    let shadow = 10; print(shadow)
}
shadow(2); print(x);;
"
