function productStepsFit(a: Integer, b: Integer, offset: Integer): Boolean {
    if !errors.integerOk(errors.checkedMultiply(a, b)) { return false }
    let shiftedA = errors.checkedAdd(a, offset)
    let shiftedB = errors.checkedAdd(b, offset)
    if !errors.integerOk(shiftedA) || !errors.integerOk(shiftedB) { return false }
    let x = errors.integerValue(shiftedA)
    let y = errors.integerValue(shiftedB)
    let product = errors.checkedMultiply(x, y)
    let left = errors.checkedMultiply(x, 100)
    let right = errors.checkedMultiply(y, 100)
    if !errors.integerOk(product) || !errors.integerOk(left) || !errors.integerOk(right) { return false }
    let first = errors.checkedSubtract(errors.integerValue(product), errors.integerValue(left))
    if offset < 0 { first = errors.checkedAdd(errors.integerValue(product), errors.integerValue(left)) }
    if !errors.integerOk(first) { return false }
    let second = errors.checkedSubtract(errors.integerValue(first), errors.integerValue(right))
    if offset < 0 { second = errors.checkedAdd(errors.integerValue(first), errors.integerValue(right)) }
    if !errors.integerOk(second) { return false }
    return errors.integerOk(errors.checkedAdd(errors.integerValue(second), 10000))
}
function test_integer_product_expansions_only_when_every_intermediate_fits(c: peer.Case) {
    let values = integerValues(c)
    let offsets = [-100, 100]
    let counts = [4843, 4829]
    for which in 0..2 {
        let offset = offsets[which]
        let lower: List<Integer> = []
        let upper: List<Integer> = []
        let expected: List<Text> = []
        for a in values {
            let positions: List<Integer> = []
            for j in 0..values.length {
                let b = values[j]
                if productStepsFit(a, b, offset) {
                    let x = a + offset
                    let y = b + offset
                    let product = x * y
                    let left = x * 100
                    let right = y * 100
                    let first = 0
                    if offset < 0 { first = product + left } else { first = product - left }
                    let second = 0
                    if offset < 0 { second = first + right } else { second = first - right }
                    let result = second + 10000
                    peer.equalInteger(c, result, a * b, "product expansion of " + Text(a) + " and " + Text(b))
                    positions.add(j)
                    expected.add(Text(a * b))
                    expected.add(Text(a * b))
                }
            }
            if positions.length > 0 {
                contiguousRange(c, positions, "product expansion " + Text(a))
                lower.add(positions[0])
                upper.add(positions[positions.length - 1] + 1)
            } else {
                lower.add(0)
                upper.add(0)
            }
        }
        peer.equalInteger(c, expected.length / 2, counts[which], "product expansion count for offset " + Text(offset))
        let sign = "-"
        if offset < 0 { sign = "+" }
        let source = ["let values = [" + peer.joined(peer.texts(values), ",") + "]",
            "let low = [" + peer.joined(peer.texts(lower), ",") + "]",
            "let high = [" + peer.joined(peer.texts(upper), ",") + "]",
            "let i = 0", "while i < values.length {", "let a = values[i]",
            "let j = low[i]", "while j < high[i] {", "let b = values[j]",
            "let x = a + (" + Text(offset) + ")", "let y = b + (" + Text(offset) + ")",
            "print(x*y " + sign + " x*100 " + sign + " y*100 + 10000)",
            "print(a*b)", "j = j + 1", "}", "i = i + 1", "}"]
        peer.executes(c, peer.lines(source), peer.lines(expected))
    }
}
