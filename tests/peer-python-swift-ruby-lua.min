function unicodeProbe(c: peer.Case, optimization: Text): Text {
    let fixture = c.suite.root + "/tests/peer-pyswru-unicode-runtime.c"
    peer.input(c, fixture)
    let program = peer.path(c, "unicode-probe." + suffix(optimization))
    let result = peer.run(c, clangCommand(clangWith(c, ["-std=c11", optimization], ["-Wall", "-Wextra", "-Werror", fixture, c.compiler.runtime, "-o", program])), "link-c-runtime-probe", 30)
    requireSuccess(c, result, "unicode probe link at " + optimization)
    return program
}
function test_valid_scalar_lengths_and_numeric_character_reads(c: peer.Case) {
    let lengthTexts = ["", "abc", "¡¢", "你好", "a😀"]
    let lengthValues = [0, 3, 2, 2, 2]
    let positionTexts: List<Text> = []
    let positionIndices: List<Integer> = []
    let positionValues: List<Integer> = []
    for text in ["abc", "¡¢", "你好", "a😀"] {
        let index = 0
        for character in text {
            positionTexts.add(text)
            positionIndices.add(index)
            positionValues.add(Integer(character))
            index += 1
        }
    }
    peer.equalInteger(c, positionTexts.length, 9, "numeric character read count")
    let lengths: List<json.Value> = []
    for index in 0..lengthTexts.length { lengths.add(peer.jsonArray([peer.jsonText(lengthTexts[index]), peer.jsonInteger(lengthValues[index])])) }
    let reads: List<json.Value> = []
    for index in 0..positionTexts.length { reads.add(peer.jsonArray([peer.jsonText(positionTexts[index]), peer.jsonInteger(positionIndices[index]), peer.jsonInteger(positionValues[index])])) }
    let first = peer.jsonObject()
    peer.put(first, "source_codepoints", peer.jsonIntegers([97, 55296, 98, 57343, 99]))
    peer.put(first, "source_length", peer.jsonInteger(5))
    let second = peer.jsonObject()
    peer.put(second, "source_codepoints", peer.jsonIntegers([55348, 56606]))
    peer.put(second, "source_length", peer.jsonInteger(2))
    let domain = peer.jsonObject()
    peer.put(domain, "lengths", peer.jsonArray(lengths))
    peer.put(domain, "numeric_character_reads", peer.jsonArray(reads))
    peer.put(domain, "excluded_surrogate_strings", peer.jsonArray([first, second]))
    peer.control(c, "source_domain", domain)
    for optimization in c.variants {
        let program = unicodeProbe(c, optimization)
        for index in 0..lengthTexts.length {
            peer.observe(c, peer.run(c, [program, lengthTexts[index], "length"], "execute", c.runTimeout), 0, Text(lengthValues[index]) + "\n", "", "length of '" + lengthTexts[index] + "' at " + optimization)
        }
        for index in 0..positionTexts.length {
            peer.observe(c, peer.run(c, [program, positionTexts[index], Text(positionIndices[index])], "execute", c.runTimeout), 0, Text(positionValues[index]) + "\n", "", "scalar " + Text(positionIndices[index]) + " of '" + positionTexts[index] + "' at " + optimization)
        }
    }
}
function test_checked_numeric_scalar_reads_reject_all_four_invalid_positions(c: peer.Case) {
    let cellTexts: List<Text> = []
    let cellPositions: List<Integer> = []
    for text in ["abc", "¡¢", "你好", "a😀"] {
        for position in [text.length, peer.MAXIMUM, -1, peer.MINIMUM] {
            cellTexts.add(text)
            cellPositions.add(position)
        }
    }
    peer.equalInteger(c, cellTexts.length, 16, "invalid scalar read count")
    let cells: List<json.Value> = []
    for index in 0..cellTexts.length { cells.add(peer.jsonArray([peer.jsonText(cellTexts[index]), peer.jsonInteger(cellPositions[index])])) }
    peer.control(c, "source_domain", peer.jsonArray(cells))
    for optimization in c.variants {
        let program = unicodeProbe(c, optimization)
        for index in 0..cellTexts.length {
            let message = "a Text position was outside the Text."
            if cellPositions[index] < 0 { message = "a Text position cannot be negative." }
            peer.observe(c, peer.run(c, [program, cellTexts[index], Text(cellPositions[index])], "execute", c.runTimeout), 1, "", "Minyar stopped: " + message + "\n", "position " + Text(cellPositions[index]) + " of '" + cellTexts[index] + "' at " + optimization)
        }
    }
}

