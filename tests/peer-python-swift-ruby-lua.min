print(a == b); print(b == a)
print(a != b); print(b != a)
print(a < b); print(b > a)
print(a <= b); print(b >= a)
print(a > b); print(b < a)
print(a >= b); print(b <= a)
}
observe(1001, 1001)
observe(1001, 1002)
"
    let expected = [true, true, false, false, false, false, true, true,
        false, false, true, true,
        false, false, true, true, true, true, true, true,
        false, false, false, false]
