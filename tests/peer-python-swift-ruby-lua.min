function test_flat_list_literal_preserves_all_263145_positions(c: peer.Case) {
    let last = (1 << 18) + 1000
    let source = "let values = [" + peer.joined(peer.texts(peer.range(0, last + 1)), ",") + "]\n"
    source += "print(values.length)
print(values[263142]); print(values[263143]); print(values[263144])
let i = 0; while i < values.length { if values[i] != i { fail(\"literal position\") }; i = i + 1 }; print(i)
"
    let expected = "263145\n263142\n263143\n263144\n263145\n"
    let compiled = peer.compile(c, source)
    peer.observe(c, compiled.result, 0, "", "", "large literal compilation")
    let control = peer.jsonObject()
    peer.put(control, "elements", peer.jsonInteger(last + 1))
    peer.put(control, "stdout", peer.jsonText(expected))
    peer.put(control, "link_timeout_seconds", peer.jsonInteger(180))
    peer.put(control, "all_positions_checked", peer.jsonBoolean(true))
    peer.control(c, "large_literal", control)
    for optimization in c.variants {
        let program = peer.executable(compiled.base, optimization)
        let link = peer.run(c, clangCommand(clangWith(c, [optimization], ["-Wno-override-module", compiled.llvm, c.compiler.runtime, "-o", program])), "link-large-literal", 180)
        requireSuccess(c, link, "large literal link at " + optimization)
        peer.observe(c, peer.run(c, [program], "execute-large-literal", 30), 0, expected, "", "large literal at " + optimization)
    }
}
function test_documented_whitespace_and_raw_nul_literal(c: peer.Case) {
