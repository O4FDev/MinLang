function test_list_literal_capacity_boundaries_and_computed_elements(c: peer.Case) {
    let source: List<Text> = []
    let expected: List<Text> = []
    for size in [0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 30, 31, 32, 33, 34, 254, 255, 256, 257, 500, 1001] {
        let name = "values" + Text(size)
        let elements = peer.texts(peer.range(0, size))
        peer.extend(source, ["let " + name + ": List<Integer> = [" + peer.joined(elements, ",") + "]", "print(" + name + ".length)", "let i = 0", "while i < " + name + ".length { print(" + name + "[i]); i = i + 1 }"])
        expected.add(Text(size))
        peer.extend(expected, elements)
        if size > 0 {
            peer.extend(source, [name + "[" + Text(size - 1) + "] = -1", "print(" + name + "[" + Text(size - 1) + "])"])
            expected.add("-1")
        }
    }
    source.add("record Box { value: Text }")
    for size in [0, 1, 2, 5, 33, 257] {
        let name = "boxes" + Text(size)
        let boxes: List<Text> = []
        for i in 0..size { boxes.add("Box { value: Text(" + Text(i) + ") + \"é\" }") }
        peer.extend(source, ["let " + name + ": List<Box> = [" + peer.joined(boxes, ",") + "]", "print(" + name + ".length)", "let i = 0", "while i < " + name + ".length { print(" + name + "[i].value); i = i + 1 }"])
        expected.add(Text(size))
        for i in 0..size { expected.add(Text(i) + "é") }
    }
    peer.extend(source, ["let computed = [1 + 2, 3 + 4, 5 + 6]", "print(computed.length)", "print(computed[0])", "print(computed[1])", "print(computed[2])", "computed[1] = computed[0] + computed[2]", "print(computed[1])"])
    peer.extend(expected, ["3", "3", "7", "11", "14"])
    peer.executes(c, peer.lines(source), peer.lines(expected))
}
