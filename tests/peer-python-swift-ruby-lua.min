    }
    peer.executes(c, "let x \t\r = \"a" + nul + "a\" \t\r\nprint(x)\nprint(x.length)\nprint(x.byteLength)\nprint(x[1] == \"" + nul + "\"[0])\n", "a" + nul + "a\n3\n3\ntrue\n")
}
function test_four_line_endings_keep_documented_diagnostic_positions(c: peer.Case) {
    for ending in ["\n", "\r", "\n\r", "\r\n"] {
        let prefix = "let a = 1;" + ending + "let b = 2;" + ending
        peer.executes(c, prefix + "print(a + b)\n", "3\n")
        let commented = "let value = 1;\n// value = 2;" + ending + "value = 3;\nprint(value)\n"
        if peer.contains(ending, "\n") { peer.executes(c, commented, "3\n") } else { peer.executes(c, commented, "1\n") }
        let value = "hi" + ending + "there"
        let raw = "let text = \"" + value + "\"\nprint(text)\nprint(text.length)\nprint(text.byteLength)\n"
        peer.executes(c, raw, value + "\n" + Text(value.length) + "\n" + Text(Bytes(value).length) + "\n")
        let source = prefix + "print(missing)\n"
        let bytes = Bytes(source)
        let offset = peer.find(source, "missing", 0)
        let line = 1
        let lastNewline = -1
        for index in 0..offset {
            if bytes[index] == 10 {
                line += 1
                lastNewline = index
            }
        }
        let column = offset - lastNewline
        let compiled = peer.compile(c, source)
        peer.observe(c, compiled.result, 1, "", "Minyar stopped: line " + Text(line) + ", column " + Text(column) + ": I can't find a value named 'missing'\n", "missing name after line ending " + peer.hexBytes(Bytes(ending)))
        peer.expect(c, files.pathSize(compiled.llvm) < 0, "missing name left LLVM output behind")
    }
}
