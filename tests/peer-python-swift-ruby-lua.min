function gcdMagnitude(first: Integer, second: Integer): Integer {
    let a = peer.absolute(first)
    let b = peer.absolute(second)
    while b != 0 {
        let next = a % b
        a = b
        b = next
    }
    return a
}
function test_euclidean_gcd_full_signed_one_through_nineteen_domain(c: peer.Case) {
    let source = "function floorRemainder(left: Integer, right: Integer): Integer {
let remainder = left % right
if remainder != 0 && ((remainder < 0) != (right < 0)) {
return remainder + right
}
return remainder
}
function gcd(first: Integer, second: Integer): Integer {
let a = first
let b = second
while a != 0 {
let next = floorRemainder(b, a)
b = a
a = next
}
return b
}
function observe(index: Integer, a: Integer, b: Integer): Nothing {
print(index); print(a); print(b); print(gcd(a, b))
}
"
    let firsts = [10, 10, 10, 100, -10, 10, -10]
    let seconds = [12, 15, 11, 15, 2, -2, -2]
    let answers = [2, 5, 1, 5, -2, 2, -2]
    for i in 1..20 {
        for j in 1..20 {
            for pair in [[i, j], [-i, j], [i, -j], [-i, -j]] {
                firsts.add(pair[0])
                seconds.add(pair[1])
                let sign = -1
                if pair[0] > 0 { sign = 1 }
                answers.add(gcdMagnitude(pair[0], pair[1]) * sign)
            }
        }
    }
    peer.equalInteger(c, firsts.length, 1451, "gcd case count")
    let calls: List<Text> = [source]
    let expected: List<Text> = []
    for index in 0..firsts.length {
        calls.add("observe(" + Text(index) + ", " + Text(firsts[index]) + ", " + Text(seconds[index]) + ")\n")
        for value in [index, firsts[index], seconds[index], answers[index]] { expected.add(Text(value) + "\n") }
    }
    let coverage = peer.jsonObject()
    peer.put(coverage, "calls", peer.jsonInteger(1451))
    peer.put(coverage, "explicit_examples", peer.jsonInteger(7))
    peer.put(coverage, "signed_grid", peer.jsonInteger(1444))
    peer.control(c, "domain_coverage", coverage)
    peer.executes(c, joinText(calls), joinText(expected))
}
