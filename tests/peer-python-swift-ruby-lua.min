function test_every_byte_in_identifier_start_and_continuation(c: peer.Case) {
    let accepted: List<Text> = []
    for position in ["start", "continuation"] {
        for byte in 0..256 {
            let name = peer.bytes([byte])
            if position == "continuation" { name = peer.bytes([97, byte, 49]) }
            let valid = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || (position == "continuation" && byte >= 48 && byte <= 57)
            let source = peer.concat(peer.concat(Bytes("let "), name), Bytes(" = 1\n"))
            let stem = "identifier-" + position + "-" + Text(byte)
            let path = peer.writeBytes(c, stem + ".min", source)
            let llvm = peer.path(c, stem + ".ll")
            let result = peer.run(c, [c.compiler.executable, path, llvm, "--library", "library"], "compile-identifier-byte", c.compiler.compileTimeout)
            let status = 1
            if valid { status = 0 }
            peer.expect(c, result.status == status, stem + " status " + Text(result.status) + "\n" + result.errorOutput)
            peer.equal(c, result.output, "", stem + " stdout")
            peer.expect(c, (files.pathSize(llvm) >= 0) == valid, stem + " LLVM presence")
            if valid {
                peer.equal(c, result.errorOutput, "", stem + " stderr")
                accepted.add(Text(source) + "print(" + Text(name) + ")\n")
            } else {
                peer.expect(c, peer.validUTF8(Bytes(result.errorOutput)), stem + " diagnostic is not UTF-8")
                peer.expect(c, peer.validCompilerDiagnostics(result.errorOutput), stem + " diagnostic prefix\n" + result.errorOutput)
                if byte >= 128 { peer.expect(c, peer.contains(result.errorOutput, "Text contained invalid UTF-8"), stem + " invalid UTF-8 diagnostic\n" + result.errorOutput) }
            }
        }
    }
    peer.equalInteger(c, accepted.length, 116, "accepted identifier count")
    peer.executes(c, joinText(accepted), peer.repeat("1\n", accepted.length))
}
function operatorValue(symbol: Text, a: Integer, b: Integer): Text {
    if symbol == "+" { return Text(a + b) }
    if symbol == "-" { return Text(a - b) }
    if symbol == "*" { return Text(a * b) }
    if symbol == "/" { return Text(peer.quotient(a, b)) }
    if symbol == "%" { return Text(peer.remainder(a, b)) }
    if symbol == "==" { return peer.boolean(a == b) }
    if symbol == "!=" { return peer.boolean(a != b) }
    if symbol == "<" { return peer.boolean(a < b) }
    if symbol == ">" { return peer.boolean(a > b) }
    if symbol == "<=" { return peer.boolean(a <= b) }
    return peer.boolean(a >= b)
}
function test_seven_operands_all_supported_operator_placements(c: peer.Case) {
    let values = [3, 100, 5, -10, -5, 10000, -10000]
    for symbol in ["+", "-", "*", "/", "%", "==", "!=", "<", ">", "<=", ">="] {
        let resultType = "Integer"
        if symbol == "==" || symbol == "!=" || symbol == "<" || symbol == ">" || symbol == "<=" || symbol == ">=" { resultType = "Boolean" }
        let source = ["function apply(a: Integer,b: Integer): " + resultType + " { return a " + symbol + " b }"]
        let expected: List<Text> = []
        for a in values {
            for b in values {
                let value = operatorValue(symbol, a, b)
                peer.extend(source, ["let a = " + Text(a), "let b = " + Text(b)])
                let lefts = [Text(a), "a", Text(a), "a"]
                let rights = [Text(b), Text(b), "b", "b"]
                for placement in 0..4 { source.add("print((" + lefts[placement] + ") " + symbol + " (" + rights[placement] + "))") }
                source.add("print(apply(a,b))")
                for repetition in 0..5 { expected.add(value) }
            }
        }
        peer.executes(c, peer.lines(source), peer.lines(expected))
    }
}
function test_demorgan_truth_and_short_circuit_effect_traces(c: peer.Case) {
    for a in [false, true] {
        for b in [false, true] {
            let source = ["function left(value: Boolean): Boolean { print(\"left\"); return value }",
                "function right(value: Boolean): Boolean { print(\"right\"); return value }",
                "let a = " + peer.boolean(a), "let b = " + peer.boolean(b)]
            let expected: List<Text> = []
            let expressions = ["!(left(a) && right(b))", "!left(a) || !right(b)", "!(left(a) || right(b))", "!left(a) && !right(b)"]
            let answers = [!(a && b), !(a && b), !(a || b), !(a || b)]
            let visits = [a, a, !a, !a]
            for index in 0..4 {
                source.add("print(" + expressions[index] + ")")
                expected.add("left")
                if visits[index] { expected.add("right") }
                expected.add(peer.boolean(answers[index]))
            }
            peer.executes(c, peer.lines(source), peer.lines(expected))
        }
    }
}
function test_checked_negation_square_and_cube_never_wrap(c: peer.Case) {
    let expressions = ["0 - (-9223372036854775808)", "(-9223372036854775808) * (-9223372036854775808)", "9223372036854775807 * 9223372036854775807 * 9223372036854775807"]
    let helpers = ["function calculate(a: Integer): Integer { return 0 - a }", "function calculate(a: Integer): Integer { return a * a }", "function calculate(a: Integer): Integer { return a * a * a }"]
    let arguments = ["-9223372036854775808", "-9223372036854775808", "9223372036854775807"]
    for index in 0..3 {
        peer.executesStatus(c, "print(" + expressions[index] + ")\n", "", 1, peer.OVERFLOW)
        peer.executesStatus(c, helpers[index] + "\nprint(calculate(" + arguments[index] + "))\n", "", 1, peer.OVERFLOW)
    }
}
record Forest { leaf: List<Integer>; operation: List<Integer>; negated: List<Boolean>; left: List<Integer>; right: List<Integer> }
function forestLeaf(forest: Forest, leaf: Integer): Integer {
    forest.leaf.add(leaf)
    forest.operation.add(0)
    forest.negated.add(false)
    forest.left.add(-1)
    forest.right.add(-1)
    return forest.leaf.length - 1
}
function forestNode(forest: Forest, operation: Integer, negated: Boolean, left: Integer, right: Integer): Integer {
    forest.leaf.add(-1)
    forest.operation.add(operation)
    forest.negated.add(negated)
    forest.left.add(left)
    forest.right.add(right)
    return forest.leaf.length - 1
}
function renderTree(forest: Forest, tree: Integer, glob: Integer, probe: Boolean, position: List<Integer>): Text {
    if forest.leaf[tree] >= 0 {
        let index = position[0]
        position[0] = index + 1
        let expression = "true"
        if forest.leaf[tree] == 0 {
            if glob == 0 { expression = "F" } else { expression = "false" }
        } else if forest.leaf[tree] == 2 { expression = "(0 == glob)" }
        if probe { return "visit(" + expression + "," + Text(index) + ")" }
        return expression
    }
    let symbol = "&&"
    if forest.operation[tree] == 1 { symbol = "||" }
    let left = renderTree(forest, forest.left[tree], glob, probe, position)
    let right = renderTree(forest, forest.right[tree], glob, probe, position)
    let expression = "(" + left + " " + symbol + " " + right + ")"
    if forest.negated[tree] { return "!" + expression }
    return expression
}
function treeOracle(forest: Forest, tree: Integer, glob: Integer, position: List<Integer>, trace: List<Integer>): Boolean {
    if forest.leaf[tree] >= 0 {
        let index = position[0]
        position[0] = index + 1
        trace.add(index)
        if forest.leaf[tree] == 0 { return false }
        if forest.leaf[tree] == 1 { return true }
        return glob == 0
    }
    let leftValue = treeOracle(forest, forest.left[tree], glob, position, trace)
    let rightTrace: List<Integer> = []
    let rightValue = treeOracle(forest, forest.right[tree], glob, position, rightTrace)
    let conjunction = forest.operation[tree] == 0
    let useRight = !leftValue
    if conjunction { useRight = leftValue }
    if useRight { for item in rightTrace { trace.add(item) } }
    let value = leftValue || rightValue
    if conjunction { value = leftValue && rightValue }
    if forest.negated[tree] { return !value }
    return value
}
function test_all_boolean_trees_through_four_leaves(c: peer.Case) {
    let forest = Forest { leaf: []; operation: []; negated: []; left: []; right: [] }
    let cases: List<List<Integer>> = [[]]
    cases.add([forestLeaf(forest, 0), forestLeaf(forest, 1), forestLeaf(forest, 2)])
    for size in 2..5 {
        let built: List<Integer> = []
        for split in 1..size {
            for left in cases[split] {
                for right in cases[size - split] {
                    for operation in [0, 1] {
                        for negated in [false, true] { built.add(forestNode(forest, operation, negated, left, right)) }
                    }
                }
            }
        }
        cases.add(built)
    }
    let trees: List<Integer> = []
    for size in 1..5 { for tree in cases[size] { trees.add(tree) } }
    peer.expect(c, cases[1].length == 3 && cases[2].length == 36 && cases[3].length == 864 && cases[4].length == 25920, "boolean tree counts differ")
    let domain = peer.jsonObject()
    peer.put(domain, "trees", peer.jsonInteger(trees.length))
    peer.put(domain, "global_values", peer.jsonIntegers([0, 1]))
    let bindings = peer.jsonObject()
    peer.put(bindings, "0", peer.jsonText("local F=false"))
    peer.put(bindings, "1", peer.jsonText("literal false"))
    peer.put(domain, "false_bindings", bindings)
    peer.put(domain, "leaves", peer.jsonTexts(["false", "true", "0==glob"]))
    peer.put(domain, "chunk_size", peer.jsonInteger(192))
    peer.control(c, "boolean_tree_domain", domain)
    let offset = 0
    while offset < trees.length {
        let end = min(offset + 192, trees.length)
        let source = ["function visit(value: Boolean, position: Integer): Boolean { print(position); return value }"]
        let expected: List<Text> = []
        for glob in [0, 1] {
            peer.extend(source, ["function run" + Text(glob) + "(glob: Integer) {", "let F = false"])
            for index in offset..end {
                let tree = trees[index]
                let expression = renderTree(forest, tree, glob, false, [0])
                let probe = renderTree(forest, tree, glob, true, [0])
                peer.extend(source, ["let branch = false", "if " + expression + " { branch = true }", "print(branch)", "print(" + expression + ")", "print(" + probe + ")"])
                let trace: List<Integer> = []
                let word = peer.boolean(treeOracle(forest, tree, glob, [0], trace))
                peer.extend(expected, [word, word])
                peer.extend(expected, peer.texts(trace))
                expected.add(word)
            }
            source.add("}")
        }
        peer.extend(source, ["run0(0)", "run1(1)"])
        peer.executes(c, peer.lines(source), peer.lines(expected))
        offset += 192
    }
}
function test_runner_cwd_environment_and_output_isolation(c: peer.Case) {
    let beforeDirectory = currentDirectory()
    let beforeEnvironment = system.environment()
    let original = peer.path(c, "original.txt")
    let base = peer.executesWith(c, "io.writeTextFile(processInfo.argument(0),processInfo.argument(1))\nprint(io.readTextFile(processInfo.argument(0)))\n", "baseline\n", 0, "", [original, "baseline"])
    for optimization in c.variants {
        let directories = [peer.path(c, suffix(optimization) + "-left"), peer.path(c, suffix(optimization) + "-right")]
        for directory in directories { peer.expect(c, files.makeDirectory(directory) == 0, "cannot create " + directory) }
        for index in 0..2 {
            let directory = directories[index]
            let payload = optimization + "-" + Text(index) + "-é"
            let sibling = directories[1 - index] + "/result.txt"
            let siblingExisted = files.pathSize(sibling) >= 0
            let siblingBefore = Bytes()
            if siblingExisted { siblingBefore = io.readBytesFile(sibling) }
            let environment = peer.withEnvironment(c.environment, "MINYAR_PEER_ISOLATION", payload)
            let result = peer.launch(c, [peer.executable(base, optimization), "result.txt", payload], "isolated-execute", c.runTimeout, environment, directory, "")
            peer.observe(c, result, 0, payload + "\n", "", "isolated execution " + payload)
            peer.expect(c, files.pathSize(directory + "/result.txt") >= 0, payload + " did not write its own result")
            peer.expect(c, peer.bytesEqual(io.readBytesFile(directory + "/result.txt"), Bytes(payload)), payload + " result bytes differ")
            peer.expect(c, (files.pathSize(sibling) >= 0) == siblingExisted, payload + " changed its sibling's presence")
            if siblingExisted { peer.expect(c, peer.bytesEqual(io.readBytesFile(sibling), siblingBefore), payload + " changed its sibling's bytes") }
            peer.expect(c, peer.bytesEqual(io.readBytesFile(original), Bytes("baseline")), payload + " changed the original output")
            peer.equal(c, currentDirectory(), beforeDirectory, "runner working directory")
            peer.expect(c, sameTexts(system.environment(), beforeEnvironment), "runner environment changed")
        }
    }
    let probe = peer.launch(c, ["/bin/sh", "-c", "printf '%s\\n' \"$MINYAR_PEER_ISOLATION\"; pwd -P"], "isolated-environment-probe", c.runTimeout, ["MINYAR_PEER_ISOLATION=fresh"], c.directory, "")
    peer.expect(c, probe.status == 0, probe.errorOutput)
    peer.equal(c, probe.output, "fresh\n" + c.directory + "\n", "isolated environment probe")
    peer.expect(c, sameTexts(system.environment(), beforeEnvironment), "runner environment changed")
}
function test_ascii_and_empty_scalar_sequence_assembly(c: peer.Case) {
    let values = ["hello World", "", peer.codepoints([27721, 23383, 47, 28450, 23383]),
        peer.codepoints([0, 127, 128, 2047, 2048, 65535, 65536, 1114111]),
        peer.codepoints([26085, 26412, 35486, 97, 45, 52, 0, 233, 243]),
        peer.codepoints([0x23cb7, 0x2070e, 0x20c53, 0x2107b, 0x20d7c, 97, 98, 0x20ea2]),
        peer.codepoints([0x28cca, 0x29d98, 0x269fa, 0x28cd2, 0x2512b, 0x244d3, 0x10ffff]),
