function depthProgram(shape: Text, depth: Integer): List<Text> {
    if shape == "constructor" { return ["let value = " + repeatText("[", depth) + "0" + repeatText("]", depth) + "\nprint(value" + repeatText("[0]", depth) + ")\n", "0\n"] }
    if shape == "parentheses" { return ["print(" + repeatText("(", depth) + "2" + repeatText(")", depth) + ")\n", "2\n"] }
    if shape == "call" { return ["function identity(x: Text): Text { return x }\nprint(" + repeatText("identity(", depth) + "\"2.2\"" + repeatText(")", depth) + ")\n", "2.2\n"] }
    if shape == "block" { return [repeatText("if true { ", depth) + "print(\"done\")" + repeatText(" }", depth) + "\n", "done\n"] }
    if shape == "while" { return [repeatText("while false { ", depth) + "fail(\"inner ran\")" + repeatText(" }", depth) + "\nprint(\"done\")\n", "done\n"] }
    if shape == "if-else" { return [repeatText("if false { fail(\"wrong branch\") } else { ", depth) + "print(\"done\")" + repeatText(" }", depth) + "\n", "done\n"] }
    return ["let a = \"\"\nprint(" + repeatText("a + ", depth) + "\"a\")\n", "a\n"]
}
function test_supported_syntax_depth_shapes_and_controlled_limits(c: peer.Case) {
    for shape in ["constructor", "parentheses", "call", "block", "while", "if-else", "concat"] {
        for depth in [100, 500] {
            let program = depthProgram(shape, depth)
            peer.executes(c, program[0], program[1])
        }
        if shape == "concat" { continue }
        let program = depthProgram(shape, 100000)
        let compiled = peer.compile(c, program[0])
        peer.expect(c, compiled.result.status == 0 || compiled.result.status == 1, shape + " depth 100000 compiler status " + Text(compiled.result.status) + "\n" + compiled.result.errorOutput)
        peer.equal(c, compiled.result.output, "", shape + " depth 100000 compiler stdout")
        if compiled.result.status != 0 {
            peer.equal(c, compiled.result.errorOutput, "Minyar stopped: the program exceeded the maximum call depth.\n", shape + " depth 100000 diagnostic")
            peer.expect(c, files.pathSize(compiled.llvm) < 0, shape + " depth 100000 left LLVM output behind")
        } else {
            peer.equal(c, compiled.result.errorOutput, "", shape + " depth 100000 compiler stderr")
            let saved = c.linkTimeout
            c.linkTimeout = 180
            peer.executes(c, program[0], program[1])
            c.linkTimeout = saved
        }
    }
}
