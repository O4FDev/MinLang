function executesWithCleanCompilation(c: peer.Case, source: Text, expected: Text) {
    let oracle = peer.jsonObject()
    peer.put(oracle, "source", peer.jsonText("case" + Text(c.compiler.serial + 1) + ".min"))
    peer.put(oracle, "stdout", peer.jsonText(expected))
    peer.put(oracle, "stderr", peer.jsonText(""))
    peer.put(oracle, "status", peer.jsonInteger(0))
    peer.put(oracle, "optimizations", peer.jsonTexts(c.variants))
    peer.put(oracle, "arguments", peer.jsonTexts([]))
    peer.put(oracle, "file_outputs", peer.jsonArray([]))
    peer.appendControl(c, "execution_oracles", oracle)
    let compiled = peer.compile(c, source)
    if compiled.result.status == 0 {
        peer.equal(c, compiled.result.output, "", "clean compilation stdout")
        peer.equal(c, compiled.result.errorOutput, "", "clean compilation stderr")
    }
    peer.expect(c, compiled.result.status == 0, "compilation failed\n" + compiled.result.errorOutput)
    for optimization in c.variants {
        let program = peer.executable(compiled.base, optimization)
        peer.link(c, compiled.llvm, optimization, program)
        peer.observe(c, peer.run(c, [program], "execute", c.runTimeout), 0, expected, "", "execution at " + optimization)
    }
}
