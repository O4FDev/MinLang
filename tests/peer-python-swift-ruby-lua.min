function test_runtime_applicable_strict_warning_profiles(c: peer.Case) {
    peer.campaign(c, ["O2"])
    let source = c.suite.root + "/runtime/minyar_runtime.c"
    runtimeInputs(c, [source])
    let warnings = ["-Wall", "-Wextra", "-Werror", "-Wshadow", "-Wundef", "-Wwrite-strings", "-Wredundant-decls", "-Wdouble-promotion", "-Wstrict-prototypes", "-Wold-style-definition"]
    let profiles = ["default", "system", "bounded", "compiler"]
    let defines = ["", "-DMINYAR_SYSTEM_HEAP=1", "-DMINYAR_BOUNDED_HEAP=1", "-DMINYAR_COMPILER_ARENA=1"]
    let configurations: List<Text> = []
    for index in 0..profiles.length {
        let before = ["-std=c11", "-O2"]
        peer.extend(before, warnings)
        let after: List<Text> = []
        if defines[index] != "" { after.add(defines[index]) }
        peer.extend(after, ["-c", source, "-o", peer.path(c, profiles[index] + ".o")])
        let command = clangCommand(clangWith(c, before, after))
        peer.observe(c, peer.run(c, command, "compile-strict-warnings", 60), 0, "", "", profiles[index] + " strict warnings")
        for flag in command {
            if flag == "-O0" || flag == "-O1" || flag == "-O2" || flag == "-O3" || flag == "-Os" {
                if !peer.hasText(configurations, suffix(flag)) { configurations.add(suffix(flag)) }
            }
        }
    }
    peer.control(c, "campaign_configurations", peer.jsonTexts(peer.sortTexts(configurations)))
}
function test_owned_recursion_allocator_growth_campaign(c: peer.Case) {
    peer.campaign(c, ["O2"])
    let source = "function grow(n: Integer): Integer {
    let label = \"frame\" + Text(40000 + n)
    if n == 0 { print(label); return 1 }
    let result = 1 + grow(n - 1)
    if label.length != 10 { fail(\"lost caller Text\") }
    return result
}
print(grow(100))
"
    let inputPath = peer.path(c, "large-pair.txt")
    let inputBytes = Bytes(peer.repeat("a", 10000))
    io.writeBytesFile(inputPath, inputBytes)
    let pairSource = "let text = io.readTextFile(" + peer.literal(inputPath) + ")\n"
    pairSource += "let parts = [text, text]
let joined = joinText(parts)
parts = []; text = \"replaced\"
print(joined.length); print(joined)
"
    let cases = [AllocationCase { name: "peer-owned-recursion"; source: source; expected: "frame40000\n101\n" },
        AllocationCase { name: "peer-large-pair"; source: pairSource; expected: "20000\n" + peer.repeat("a", 20000) + "\n" }]
    let output = peer.path(c, "recursive-allocation-results.json")
    let mode = allocationMode(c)
    allocationCampaign(c, cases, mode, output)
    let report = peer.load(output)
    peer.equal(c, peer.textField(report, "status"), "passed", "allocation campaign status")
    let configurations: List<Text> = []
    for item in json.member(report, "configurations").items { configurations.add(item.text) }
    peer.expect(c, peer.hasText(configurations, "O2"), "allocation campaign configurations lack O2: " + peer.joined(configurations, ", "))
    peer.expect(c, peer.bytesEqual(io.readBytesFile(inputPath), inputBytes), "large pair input file changed")
    let rows = json.member(report, "cases").items
    peer.equalInteger(c, rows.length, 4, "allocation campaign rows")
    let names: List<Text> = []
    for row in rows { names.add(peer.textField(row, "case")) }
    peer.expect(c, sameTexts(peer.unique(names), ["peer-owned-recursion", "peer-large-pair"]), "allocation campaign cases differ: " + peer.joined(names, ", "))
    for row in rows {
        let name = peer.textField(row, "case")
        peer.expect(c, peer.field(row, "allocation_failures") >= 1, name + " has no allocation failures")
        peer.equalInteger(c, peer.field(row, "frame_entries"), peer.field(row, "frame_leaves"), name + " frame entries and leaves")
        if name == "peer-owned-recursion" {
            peer.expect(c, peer.field(row, "frame_entries") >= 101, name + " frame entries")
            peer.expect(c, peer.field(row, "peak_frames") >= 101, name + " peak frames")
            peer.expect(c, peer.field(row, "released_objects") >= 101, name + " released objects")
            peer.expect(c, peer.field(row, "allocation_failures") <= 8 * peer.field(row, "frame_entries"), name + " allocation failures exceed eight per frame")
        }
        peer.expect(c, peer.field(row, "byte_budget_failures") > 0, name + " has no byte budget failures")
        peer.equalInteger(c, peer.field(row, "byte_budget_successes"), 2, name + " byte budget successes")
    }
    peer.control(c, "campaign_configurations", json.member(report, "configurations"))
    peer.control(c, "peer_allocation_results", report)
}
function rejectsExactDiagnostic(c: peer.Case, source: Text, diagnostic: Text) {
    let expected = "Minyar stopped: " + diagnostic + "\n"
    let oracle = peer.jsonObject()
    peer.put(oracle, "source", peer.jsonText("case" + Text(c.compiler.serial + 1) + ".min"))
    peer.put(oracle, "status", peer.jsonInteger(1))
    peer.put(oracle, "stdout", peer.jsonText(""))
    peer.put(oracle, "stderr", peer.jsonText(expected))
    peer.put(oracle, "llvm_created", peer.jsonBoolean(false))
    peer.appendControl(c, "rejection_oracles", oracle)
    let compiled = peer.compile(c, source)
    peer.expect(c, compiled.result.status == 1, "expected compiler rejection status 1, got " + Text(compiled.result.status) + "\n" + compiled.result.errorOutput)
    peer.equal(c, compiled.result.output, "", "rejected source stdout")
    peer.equal(c, compiled.result.errorOutput, expected, "rejection diagnostic")
    peer.expect(c, files.pathSize(compiled.llvm) < 0, "invalid source left LLVM output behind")
}
function test_integer_total_order_1001_and_1002(c: peer.Case) {
