function pythonSlice(text: Text, start: Integer, end: Integer): Text {
    let first = min(start, text.length)
    let last = min(end, text.length)
    if last <= first { return "" }
    return text.slice(first, last)
}
function test_missing_nonnegative_clipped_substring_matrix(c: peer.Case) {
    let source = ["function clippedSlice(value: Text, start: Integer, end: Integer): Text {
let first = start
let last = end
if first > value.length { first = value.length }
if last > value.length { last = value.length }
if last < first { return \"\" }
return value.slice(first, last)
}"]
    let expected: List<Text> = []
    let cells: List<json.Value> = []
    let total = 0
    for text in ["ab", "ab¡¢", "ab¡¢你好", "ab¡¢你好😀😁"] {
        let starts = peer.range(0, text.length + 2)
        starts.add(peer.MAXIMUM)
        for start in starts {
            let ends: List<Integer> = []
            let lowest = start - 1
            if lowest < 0 { lowest = 0 }
            if lowest < text.length + 2 { ends = peer.range(lowest, text.length + 2) }
            ends.add(peer.MAXIMUM)
            for end in ends {
                total += 1
                if 0 <= start && start <= end && end <= text.length { continue }
                let result = pythonSlice(text, start, end)
                let cell = Text(cells.length)
                let row = peer.jsonObject()
                peer.put(row, "text", peer.jsonText(text))
                peer.put(row, "start", peer.jsonInteger(start))
                peer.put(row, "end", peer.jsonInteger(end))
                peer.put(row, "expected", peer.jsonText(result))
                cells.add(row)
                peer.extend(source, ["function case" + cell + "() {", "let root = " + peer.literal(text),
                    "let view = clippedSlice(root, " + Text(start) + ", " + Text(end) + ")",
                    "root = \"released\"", "print(view)", "print(view.length)",
                    "print(view.byteLength)", "}", "case" + cell + "()"])
                peer.extend(expected, [result, Text(result.length), Text(Bytes(result).length)])
            }
        }
    }
    peer.equalInteger(c, total, 178, "clipped substring source pairs")
    peer.equalInteger(c, cells.length, 84, "clipped substring new cells")
    let domain = peer.jsonObject()
    peer.put(domain, "total", peer.jsonInteger(total))
    peer.put(domain, "new_cells", peer.jsonArray(cells))
    peer.put(domain, "existing_strict_spans", peer.jsonInteger(94))
    peer.put(domain, "adaptation", peer.jsonText("explicit nonnegative clipping adapter; native slice is strict"))
    peer.control(c, "source_domain", domain)
    peer.executes(c, peer.lines(source), peer.lines(expected))
}
function test_utf8_constructor_value_projections_keep_complete_bytes(c: peer.Case) {
    let raws = [Bytes("abc"), Bytes("abc"), peer.concat(Bytes("abc"), peer.concat(peer.bytes([0]), Bytes("def"))),
        peer.fromHex("c2a1c2a2"), peer.fromHex("e4bda0"), peer.fromHex("f09f9880"), Bytes()]
    let counts = [-1, 2, -1, -1, -1, -1, -1]
    let source: List<Text> = []
    let expected: List<Text> = []
    let domain: List<json.Value> = []
    for index in 0..raws.length {
        let raw = raws[index]
        let name = Text(index)
        let path = peer.writeBytes(c, "constructor-" + name + ".bin", raw)
        let projected = raw
        if counts[index] >= 0 { projected = raw.slice(0, counts[index]) }
        peer.expect(c, peer.validUTF8(projected), "constructor cell " + name + " is not UTF-8")
        let value = Text(projected)
        let selection = "let value = original"
        if counts[index] >= 0 { selection = "let value = original.slice(0, 2)" }
        peer.extend(source, ["function case" + name + "() {", "let original = io.readTextFile(" + peer.literal(path) + ")",
            "print(original.byteLength)", selection,
            "print(value.length)", "print(value.byteLength)", "print(value)"])
        let scalars = peer.scalars(value)
        for position in 0..scalars.length { source.add("print(value[" + Text(position) + "])") }
        peer.extend(source, ["}", "case" + name + "()"])
        peer.extend(expected, [Text(raw.length), Text(scalars.length), Text(Bytes(value).length), value])
        peer.extend(expected, scalars)
        let row = peer.jsonObject()
        peer.put(row, "hex", peer.jsonText(peer.hexBytes(raw)))
        if counts[index] >= 0 { peer.put(row, "count", peer.jsonInteger(counts[index])) } else { peer.put(row, "count", peer.jsonNull()) }
        peer.put(row, "expected", peer.jsonText(value))
        domain.add(row)
    }
    peer.control(c, "source_domain", peer.jsonArray(domain))
    peer.executes(c, peer.lines(source), peer.lines(expected))
}
