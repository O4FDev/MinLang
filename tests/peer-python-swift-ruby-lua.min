use "io" as io
use "./peer-support.min" as peer
use "../tools/testing.min" as test
use "system" as system
use "files" as files
use "json" as json
use "errors" as errors
use "sha256" as sha256

constant INVALID_UTF8 = "Minyar stopped: Text contained invalid UTF-8.\n"
constant OOM = "Minyar stopped: the computer ran out of memory.\n"

function isDigit(byte: Integer): Boolean { return byte >= 48 && byte <= 57 }
function isOctal(byte: Integer): Boolean { return byte >= 48 && byte <= 55 }
function isHex(byte: Integer): Boolean { return isDigit(byte) || (byte >= 97 && byte <= 102) || (byte >= 65 && byte <= 70) }
function isIdentifierStart(byte: Integer): Boolean { return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || byte == 95 }
function digitValue(byte: Integer): Integer {
    if isDigit(byte) { return byte - 48 }
    if byte >= 97 && byte <= 102 { return byte - 87 }
    return byte - 55
}
function hexPrefix(raw: Bytes, start: Integer): Boolean { return raw.length - start >= 2 && raw[start] == 48 && (raw[start + 1] == 120 || raw[start + 1] == 88) }
function octalPrefix(raw: Bytes, start: Integer): Boolean { return raw.length - start >= 2 && raw[start] == 48 && raw[start + 1] == 111 }
function octalBody(raw: Bytes, start: Integer): Boolean {
    if !octalPrefix(raw, start) || raw.length - start < 3 { return false }
    for index in (start + 2)..raw.length { if !isOctal(raw[index]) { return false } }
    return true
}
function identifierShape(name: Text): Boolean {
    let raw = Bytes(name)
    if raw.length == 0 || !isIdentifierStart(raw[0]) { return false }
    for index in 1..raw.length { if !isIdentifierStart(raw[index]) && !isDigit(raw[index]) { return false } }
    return true
}
function decimalAccepted(token: Text): Boolean {
    let raw = Bytes(token)
    let start = 0
    if raw.length > 0 && raw[0] == 45 { start = 1 }
    let size = raw.length - start
    if size <= 0 { return false }
    if hexPrefix(raw, start) && size >= 3 {
        let hex = true
        for index in (start + 2)..raw.length { if !isHex(raw[index]) { hex = false } }
        if hex { return true }
    }
    if octalBody(raw, start) { return true }
    if size == 1 && raw[start] == 48 { return true }
    if raw[start] >= 49 && raw[start] <= 57 {
        for index in (start + 1)..raw.length { if !isDigit(raw[index]) { return false } }
        return true
    }
    return false
}
function decimalValue(token: Text): Integer {
    let raw = Bytes(token)
    let sign = 1
    let start = 0
    if raw.length > 0 && raw[0] == 45 { sign = -1; start = 1 }
    let base = 10
    if hexPrefix(raw, start) { base = 16 } else if octalPrefix(raw, start) { base = 8 }
    let begin = start
    if base != 10 { begin = start + 2 }
    let value = 0
    for index in begin..raw.length { value = value * base + digitValue(raw[index]) }
    return sign * value
}
function numberPrefix(raw: Bytes): Integer {
    let starts: List<Integer> = []
    if raw.length > 0 && raw[0] == 45 { starts.add(1) }
    starts.add(0)
    for start in starts {
        if hexPrefix(raw, start) && raw.length - start >= 3 && isHex(raw[start + 2]) {
            let end = start + 3
            while end < raw.length && isHex(raw[end]) { end += 1 }
            return end
        }
        if start < raw.length && isDigit(raw[start]) {
            let end = start + 1
            while end < raw.length && isDigit(raw[end]) { end += 1 }
            return end
        }
    }
    return -1
}
function decimalDiagnostic(c: peer.Case, token: Text): Text {
    peer.expect(c, !decimalAccepted(token), "diagnostic requested for accepted token " + token)
    if token == "" { return "print expects 1 argument, but received 0" }
    let raw = Bytes(token)
    let offset = 0
    if raw[0] == 43 || raw[0] == 45 { offset = 1 }
    if octalPrefix(raw, offset) && !octalBody(raw, offset) { return "line 1, column " + Text(7 + offset) + ": an octal Integer literal needs only digits 0 through 7 after 0o" }
    if raw.length - offset >= 3 && raw[offset] == 48 && raw[offset + 1] == 98 && isDigit(raw[offset + 2]) { return "line 1, column " + Text(7 + offset) + ": binary Integer literals are not supported; use decimal digits, 0xFF for hexadecimal, or 0o755 for octal" }
    if offset < raw.length && isDigit(raw[offset]) {
        let end = offset
        if hexPrefix(raw, offset) && raw.length - offset >= 3 && isHex(raw[offset + 2]) {
            end = offset + 2
            while end < raw.length && isHex(raw[end]) { end += 1 }
        } else { while end < raw.length && isDigit(raw[end]) { end += 1 } }
        if end < raw.length && raw[end] == 95 { return "line 1, column " + Text(7 + offset) + ": number separators are not supported; remove '_' from this number" }
    }
    if raw.length - offset >= 2 && raw[offset] == 48 && isDigit(raw[offset + 1]) { return "line 1, column " + Text(7 + offset) + ": decimal Integer literals cannot have a leading zero; use 0o for octal" }
    if raw[0] == 43 { return "line 1, column 7: expected an expression, found '+'" }
    if token == "-" { return "line 1, column 8: expected an expression, found ')'" }
    let number = numberPrefix(raw)
    if number >= 0 { offset = number }
    let name = Text(raw.slice(offset, raw.length))
    peer.expect(c, identifierShape(name), "decimal diagnostic name is not an identifier: " + name)
    return "line 1, column " + Text(7 + offset) + ": I can't find a value named '" + name + "'"
}
record DecimalCell { cohort: Text; token: Text; accepted: Boolean; value: Integer; diagnostic: Text }
function rejectedCell(c: peer.Case, cohort: Text, token: Text): DecimalCell {
    return DecimalCell { cohort: cohort; token: token; accepted: false; value: 0; diagnostic: decimalDiagnostic(c, token) }
}
function decimalCells(c: peer.Case): List<DecimalCell> {
    let cells: List<DecimalCell> = []
    let alphabet = ["0", "1", "_", "9", "f"]
    for prefix in ["", "0x", "0o", "0b", "0d", "-", "+"] {
        for size in 0..4 {
            let total = 1
            for power in 0..size { total *= 5 }
            for number in 0..total {
                let digits: List<Text> = []
                let remaining = number
                for place in 0..size { digits.add(alphabet[remaining % 5]); remaining = remaining / 5 }
                let pieces = [prefix]
                let index = digits.length - 1
                while index >= 0 { pieces.add(digits[index]); index -= 1 }
                let token = joinText(pieces)
                if decimalAccepted(token) { cells.add(DecimalCell { cohort: "ruby-product"; token: token; accepted: true; value: decimalValue(token); diagnostic: "" }) }
                else { cells.add(rejectedCell(c, "ruby-product", token)) }
            }
        }
    }
    for token in ["0_0_0", "4_2", "1_0000_0000", "0_", "42_", "0_b0", "0_xf", "0_o5", "0_7", "09_99", "4_______2"] { cells.add(rejectedCell(c, "python-explicit-decimal", token)) }
    for sign in ["", "-", "+"] {
        for radix in ["0x", "0o", "0b", "0d"] { cells.add(rejectedCell(c, "ruby-bug2407-tail", sign + radix + "_")) }
    }
    for token in ["0o5_", "0b1001__0100", "0xffff__ffff", "0o5__77"] { cells.add(rejectedCell(c, "python-additional-integer-underscores", token)) }
    return cells
}

function suffix(optimization: Text): Text {
    let raw = Bytes(optimization)
    return Text(raw.slice(1, raw.length))
}
function literals(values: List<Text>): List<Text> {
    let result: List<Text> = []
    for value in values { result.add(peer.literal(value)) }
    return result
}
function repeatText(value: Text, count: Integer): Text {
    let result = ""
    let piece = value
    let remaining = count
    while remaining > 0 {
        if remaining % 2 == 1 { result = result + piece }
        remaining = remaining / 2
        if remaining > 0 { piece = piece + piece }
    }
    return result
}
function lowercase(value: Text): Text {
    let result = Bytes()
    for byte in Bytes(value) {
        if byte >= 65 && byte <= 90 { result.add(byte + 32) } else { result.add(byte) }
    }
    return Text(result)
}
function sameTexts(left: List<Text>, right: List<Text>): Boolean {
    let first = peer.sortTexts(left)
    let second = peer.sortTexts(right)
    if first.length != second.length { return false }
    for index in 0..first.length { if first[index] != second[index] { return false } }
    return true
}
function darwin(): Boolean {
    let directory = test.scratch()
    let result = test.run(["/usr/bin/uname", "-s"], system.environment(), "", directory + "/uname", 10)
    test.removeTree(directory)
    test.require(result, "uname")
    return result.output == "Darwin\n"
}
function currentDirectory(): Text {
    let directory = test.scratch()
    let result = test.run(["/bin/pwd", "-P"], system.environment(), "", directory + "/pwd", 10)
    test.removeTree(directory)
    test.require(result, "pwd")
    return result.output
}
function clangCommand(arguments: List<Text>): List<Text> {
    for argument in arguments {
        if argument == "-c" || argument == "-S" || argument == "-E" || argument == "-fsyntax-only" || argument == "--version" || argument == "-v" { return arguments }
    }
    if darwin() { return arguments }
    let result: List<Text> = []
    for argument in arguments { if argument != "-lm" { result.add(argument) } }
    result.add("-lm")
    return result
}
function clangWith(c: peer.Case, before: List<Text>, after: List<Text>): List<Text> {
    let command = [c.compiler.clang]
    peer.extend(command, before)
    peer.extend(command, c.compiler.flags)
    peer.extend(command, after)
    return command
}
function runtimeInputs(c: peer.Case, first: List<Text>) {
    for path in first { peer.input(c, path) }
    let names: List<Text> = []
    for name in files.list(c.suite.root + "/runtime") { if peer.ends(name, ".h") && !peer.starts(name, ".") { names.add(name) } }
    for name in peer.sortTexts(names) { peer.input(c, c.suite.root + "/runtime/" + name) }
}
function requireSuccess(c: peer.Case, result: test.Result, phase: Text) {
    peer.expect(c, result.status == 0, phase + " failed with status " + Text(result.status) + "\n" + result.errorOutput)
}
function vectors(c: peer.Case): json.Value {
    let path = c.suite.root + "/tests/peer-pyswru-vectors.json"
    peer.input(c, path)
    let data = peer.load(path)
    peer.equalInteger(c, peer.field(data, "schema_version"), 1, "vector schema")
    return data
}

function test_three_hundred_positional_parameters_and_values(c: peer.Case) {
    let parameters: List<Text> = []
    let body = ["let checksum = 0"]
    let arguments: List<Text> = []
    let total = 0
    for i in 0..300 {
        parameters.add("p" + Text(i) + ": Integer")
        body.add("checksum = checksum + p" + Text(i) + " * " + Text(i + 1))
        arguments.add(Text(i))
        total += i * (i + 1)
    }
    peer.extend(body, ["print(p0)", "print(p149)", "print(p299)", "return checksum"])
    let source = "function wide(" + peer.joined(parameters, ", ") + "): Integer {\n" + peer.joined(body, "\n") + "\n}\n"
    source += "print(wide(" + peer.joined(arguments, ", ") + "))\n"
    peer.executes(c, source, "0\n149\n299\n" + Text(total) + "\n")
}
function test_ten_five_hundred_and_thousand_positional_arguments(c: peer.Case) {
    for count in [10, 500, 1000] {
        let declared: List<Text> = []
        let values: List<Text> = []
        let prints: List<Text> = []
        for i in 0..count {
            declared.add("p" + Text(i) + ": Integer")
            values.add(Text(i))
            prints.add("print(p" + Text(i) + ")\n")
        }
        let parameters = peer.joined(declared, ", ")
        let arguments = peer.joined(values, ", ")
        let source = "function middle(" + parameters + "): Integer { return p" + Text(count / 2) + " }\n"
        source += "function every(" + parameters + "): Nothing {\n"
        source += joinText(prints) + "}\n"
        source += "print(middle(" + arguments + "))\nevery(" + arguments + ")\n"
        let expected = [Text(count / 2)]
        peer.extend(expected, values)
        peer.executes(c, source, peer.joined(expected, "\n") + "\n")
    }
}
function test_filtered_iteration_preserves_present_payload_order(c: peer.Case) {
    let source = "record Item { present: Boolean; value: Integer }
let items: List<Item> = [
Item { present: true, value: 1 }, Item { present: false, value: 91 },
Item { present: true, value: 2 }, Item { present: false, value: 92 },
Item { present: true, value: 3 }, Item { present: false, value: 93 },
Item { present: false, value: 94 }, Item { present: false, value: 95 },
Item { present: true, value: 4 }, Item { present: true, value: 5 },
]
let i = 0
while i <= 6 {
    if i % 2 == 0 { print(i) }
    i = i + 1
}
print(\"present\")
i = 0
while i < items.length {
    if items[i].present { print(items[i].value) }
    i = i + 1
}
print(\"filtered\")
i = 0
while i < items.length {
    if items[i].present && items[i].value != 3 { print(items[i].value) }
    i = i + 1
}
"
    peer.executes(c, source, "0\n2\n4\n6\npresent\n1\n2\n3\n4\n5\nfiltered\n1\n2\n4\n5\n")
}
function test_text_suffix_candidates_use_scalar_boundaries(c: peer.Case) {
    let nul = peer.character(0)
    let values = ["hello", "hello", "hello", "hello", "", "hello", "hello", "céréale", "hello", "", "hello", "céréale", "a🙂é", "a🙂é", "a" + nul + "🙂", "a" + nul + "🙂"]
    let suffixes: List<List<Text>> = [["o"], ["llo"], ["ll"], [""], [""], ["x", "y", "llo", "z"], [], ["réale"], ["hello!"], ["o"], ["x", "y"], ["réal"], ["🙂é"], ["a🙂"], [nul + "🙂"], [nul]]
    let answers = [true, true, false, true, true, true, false, true, false, false, false, false, true, false, true, false]
    let source = "function endsWithAny(value: Text, suffixes: List<Text>): Boolean {
    let i = 0
    while i < suffixes.length {
        let suffix = suffixes[i]
        if suffix.length <= value.length {
            if value.slice(value.length - suffix.length, value.length) == suffix {
                return true
            }
        }
        i = i + 1
    }
    return false
}
"
    let expected: List<Text> = []
    for index in 0..values.length {
        let found = false
        for candidate in suffixes[index] { if peer.ends(values[index], candidate) { found = true } }
        peer.expect(c, found == answers[index], "suffix oracle " + Text(index))
        source += "print(endsWithAny(" + peer.literal(values[index]) + ", [" + peer.joined(literals(suffixes[index]), ", ") + "]))\n"
        expected.add(peer.boolean(answers[index]) + "\n")
    }
    peer.executes(c, source, joinText(expected))
}
function graphNodes(keys: List<Integer>, edges: List<List<Integer>>): List<Integer> {
    let nodes: List<Integer> = []
    for key in keys { if !peer.hasInteger(nodes, key) { nodes.add(key) } }
    for targets in edges { for target in targets { if !peer.hasInteger(nodes, target) { nodes.add(target) } } }
    return peer.sortIntegers(nodes)
}
function writeGraph(c: peer.Case, folder: Text, nodes: List<Integer>, keys: List<Integer>, edges: List<List<Integer>>, acyclic: Boolean) {
    for node in nodes {
        let targets: List<Integer> = []
        for index in 0..keys.length { if keys[index] == node { targets = edges[index] } }
        let source = ""
        for target in targets {
            if !acyclic || target > node { source += "use \"./node" + Text(target) + ".min\" as n" + Text(target) + "\n" }
        }
        source += "public function value(): Integer { return " + Text(node) + " }\n"
        io.writeTextFile(folder + "/node" + Text(node) + ".min", test.sourceModules(source))
    }
}
function test_five_module_cycle_shapes_and_acyclic_controls(c: peer.Case) {
    let keys = [[1], [1, 2, 3], [1, 2, 3, 5, 4], [1, 2, 3, 4, 6, 7], [1, 2, 3, 4]]
    let edges = [[[1]], [[2], [3], [1]], [[2], [3], [1], [4], [6]], [[2], [1], [4], [5], [7], [6]], [[2], [3], [2, 4], [5]]]
    for index in 0..keys.length {
        let nodes = graphNodes(keys[index], edges[index])
        let folder = peer.path(c, "graph" + Text(index))
        peer.expect(c, files.makeDirectory(folder) == 0, "cannot create " + folder)
        let entry = ""
        let calls: List<Text> = []
        let total = 0
        for node in nodes {
            entry += "use \"./graph" + Text(index) + "/node" + Text(node) + ".min\" as n" + Text(node) + "\n"
            calls.add("n" + Text(node) + ".value()")
            total += node
        }
        entry += "print(" + peer.joined(calls, " + ") + ")\n"
        writeGraph(c, folder, nodes, keys[index], edges[index], false)
        peer.rejects(c, entry, "module import cycle:")
        writeGraph(c, folder, nodes, keys[index], edges[index], true)
        peer.executes(c, entry, Text(total) + "\n")
    }
}
function test_unicode_filename_read_write_and_missing_path_guards(c: peer.Case) {
    let rows = json.member(vectors(c), "filenames").items
    peer.equalInteger(c, rows.length, 19, "filename vector count")
    let prefixes = [16, 17, 18]
    let spaces = [0x2000, 0x2001, 0x2003]
    for index in 0..3 {
        peer.equal(c, peer.textField(rows[prefixes[index] - 1], "filename"), Text(prefixes[index]) + "_" + peer.repeat(peer.character(spaces[index]), 3) + "A", "filename vector " + Text(prefixes[index]))
    }
    for row in rows { peer.expect(c, !peer.contains(peer.textField(row, "filename"), "\\u"), "filename contains an unevaluated Unicode escape") }
    let source: List<Text> = []
    let expected: List<Text> = []
    let outputs: List<peer.Output> = []
    let arguments: List<Text> = []
    let inputs = peer.path(c, "inputs")
    let outputDirectory = peer.path(c, "outputs")
    peer.expect(c, files.makeDirectory(inputs) == 0, "cannot create inputs")
    peer.expect(c, files.makeDirectory(outputDirectory) == 0, "cannot create outputs")
    let apple = darwin()
    for index in 0..rows.length {
        let row = rows[index]
        let filename = peer.textField(row, "filename")
        if json.member(row, "non_apple_only").truth && apple {
            peer.appendControl(c, "platform_exclusions", peer.jsonText(filename))
            continue
        }
        let path = inputs + "/" + filename
        let output = outputDirectory + "/" + filename
        let payload = "file" + Text(index) + ":é" + peer.character(0) + "🙂"
        io.writeBytesFile(path, Bytes(payload))
        let argumentIndex = arguments.length
        arguments.add(path)
        arguments.add(output)
        let name = Text(index)
        peer.extend(source, ["let path" + name + " = processInfo.argument(" + Text(argumentIndex) + ")", "let output" + name + " = processInfo.argument(" + Text(argumentIndex + 1) + ")",
            "let text" + name + " = io.readTextFile(path" + name + ")", "print(text" + name + ")",
            "io.writeTextFile(output" + name + ", text" + name + " + \"!\")",
            "print(io.readTextFile(output" + name + "))"])
        peer.extend(expected, [payload, payload + "!"])
        outputs.add(peer.Output { path: output; contents: Bytes(payload + "!") })
    }
    for optimization in c.variants {
        for output in outputs {
            if files.pathSize(output.path) >= 0 { peer.expect(c, files.remove(output.path) == 0, "cannot clear " + output.path) }
        }
        peer.executesFull(c, peer.lines(source), peer.lines(expected), 0, "", arguments, [], [optimization])
        for output in outputs {
            peer.expect(c, files.pathSize(output.path) >= 0, "program did not create " + output.path)
            peer.expect(c, peer.bytesEqual(io.readBytesFile(output.path), output.contents), "file bytes differ at " + optimization + ": " + output.path)
        }
    }
    let missing = peer.path(c, "absent-Γειά-🙂")
    peer.executesWith(c, "print(io.readTextFile(processInfo.argument(0)))\n", "", 1, "Minyar stopped: the file '" + missing + "' could not be opened.\n", [missing])
}
function checkLiteralPayloads(c: peer.Case, texts: List<Text>) {
    let source: List<Text> = []
    let expected: List<Text> = []
    for index in 0..texts.length {
        let text = texts[index]
        let name = Text(index)
        let path = peer.writeBytes(c, "payload" + name + ".txt", Bytes(text))
        peer.extend(source, ["let text" + name + " = " + peer.literal(text), "let disk" + name + " = io.readTextFile(" + peer.literal(path) + ")",
            "print(text" + name + " == disk" + name + ")", "print(text" + name + ".length)", "print(text" + name + ".byteLength)",
            "print(text" + name + ")"])
        peer.extend(expected, ["true", Text(text.length), Text(Bytes(text).length), text])
        let scalars = peer.scalars(text)
        for position in 0..scalars.length {
            let at = "[" + Text(position) + "]"
            peer.extend(source, ["print(Text(text" + name + at + "))", "print(text" + name + at + " == disk" + name + at + ")"])
            peer.extend(expected, [scalars[position], "true"])
        }
        for begin in 0..(text.length + 1) {
            for end in begin..(text.length + 1) {
                source.add("print(text" + name + ".slice(" + Text(begin) + ", " + Text(end) + "))")
                expected.add(text.slice(begin, end))
            }
        }
    }
    peer.executes(c, peer.lines(source), peer.lines(expected))
}
function test_python_literal_payloads_match_independent_utf8_files(c: peer.Case) {
    let rows = json.member(vectors(c), "python_literals").items
    peer.equalInteger(c, rows.length, 7, "Python literal vector count")
    let texts: List<Text> = []
    for row in rows { texts.add(peer.textField(row, "text")) }
    checkLiteralPayloads(c, texts)
}
function test_swift_flag_and_mathematical_scalar_literals(c: peer.Case) {
    let rows = json.member(vectors(c), "swift_literals").items
    peer.equalInteger(c, rows.length, 6, "Swift literal vector count")
    let payloads: List<Text> = []
    for row in rows { payloads.add(peer.textField(row, "payload")) }
    let texts = peer.unique(payloads)
    peer.expect(c, texts.length == 2 && texts[0] == peer.codepoints([0x1f1e6, 0x1f1fa]) && texts[1] == peer.codepoints([0x1d539]), "Swift literal payloads differ: " + peer.joined(texts, ", "))
    checkLiteralPayloads(c, texts)
}
function test_zig_and_ruby_malformed_utf8_ingress_vectors(c: peer.Case) {
    let rows = json.member(vectors(c), "invalid_utf8").items
    peer.equalInteger(c, rows.length, 35, "invalid UTF-8 vector count")
    let hexes: List<Text> = []
    for row in rows { hexes.add(peer.textField(row, "hex")) }
    peer.equalInteger(c, peer.unique(hexes).length, 35, "distinct invalid UTF-8 vectors")
    let paths: List<Text> = []
    let lengths: List<Integer> = []
    for index in 0..rows.length {
        let raw = peer.fromHex(hexes[index])
        peer.expect(c, !peer.validUTF8(raw), "invalid UTF-8 vector decoded: " + hexes[index])
        paths.add(peer.writeBytes(c, "invalid" + Text(index) + ".txt", raw))
        lengths.add(raw.length)
    }
    let source = "let raw = io.readBytesFile(processInfo.argument(0))\nprint(raw.length)\nlet text = Text(raw)\nprint(text.length)\n"
    let base = peer.executesWith(c, source, Text(lengths[0]) + "\n", 1, INVALID_UTF8, [paths[0]])
    for optimization in c.variants {
        for index in 1..rows.length {
            peer.observe(c, peer.run(c, [peer.executable(base, optimization), paths[index]], "execute-peer-malformed-utf8", c.runTimeout), 1, Text(lengths[index]) + "\n", INVALID_UTF8, hexes[index] + " at " + optimization)
        }
    }
}
function test_ruby_quotient_remainder_operand_placements(c: peer.Case) {
    let numerators = [13, 4, -200, -1000]
    let divisors = [4, 13, -256, -512]
    let quotients = [3, 0, 0, 1]
    let remainders = [1, 4, -200, -488]
    let source = ["function quotient(a: Integer, b: Integer): Integer { return a / b }", "function remainder(a: Integer, b: Integer): Integer { return a % b }"]
    let expected: List<Text> = []
    for index in 0..4 {
        peer.expect(c, numerators[index] == quotients[index] * divisors[index] + remainders[index], "quotient identity " + Text(index))
        let name = Text(index)
        let a = Text(numerators[index])
        let b = Text(divisors[index])
        peer.extend(source, ["let a" + name + " = " + a, "let b" + name + " = " + b])
        let lefts = [a, "a" + name, a, "a" + name]
        let rights = [b, b, "b" + name, "b" + name]
        for placement in 0..4 {
            peer.extend(source, ["print(" + lefts[placement] + " / " + rights[placement] + ")", "print(" + lefts[placement] + " % " + rights[placement] + ")"])
            peer.extend(expected, [Text(quotients[index]), Text(remainders[index])])
        }
        peer.extend(source, ["print(quotient(a" + name + ", b" + name + "))", "print(remainder(a" + name + ", b" + name + "))"])
        peer.extend(expected, [Text(quotients[index]), Text(remainders[index])])
    }
    peer.executes(c, peer.lines(source), peer.lines(expected))
}
