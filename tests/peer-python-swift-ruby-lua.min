function integerValues(c: peer.Case): List<Integer> {
    let path = c.suite.root + "/tests/peer-pyswru-integer-values.json"
    peer.input(c, path)
    let values: List<Integer> = []
    for item in json.member(peer.load(path), "values").items { values.add(peer.number(item)) }
    peer.equalInteger(c, values.length, 79, "integer value count")
    for index in 1..values.length { peer.expect(c, values[index - 1] < values[index], "integer values are not sorted and unique at " + Text(index)) }
    return values
}
function fitsOperation(symbol: Text, a: Integer, b: Integer): Boolean {
    if symbol == "+" { return errors.integerOk(errors.checkedAdd(a, b)) }
    if symbol == "-" { return errors.integerOk(errors.checkedSubtract(a, b)) }
    return errors.integerOk(errors.checkedMultiply(a, b))
}
function contiguousRange(c: peer.Case, positions: List<Integer>, label: Text) {
    for index in 0..positions.length { peer.expect(c, positions[index] == positions[0] + index, label + " positions are not contiguous") }
}
function test_signed_integer_peer_corpus_safe_arithmetic_and_boolean_storage(c: peer.Case) {
    let values = integerValues(c)
    let source = ["let values = [" + peer.joined(peer.texts(values), ",") + "]"]
    let expected: List<Text> = []
    let labels = ["add", "sub", "mul"]
    let symbols = ["+", "-", "*"]
    for operation in 0..3 {
        let label = labels[operation]
        let symbol = symbols[operation]
        let lower: List<Integer> = []
        let upper: List<Integer> = []
        for a in values {
            let positions: List<Integer> = []
            for j in 0..values.length { if fitsOperation(symbol, a, values[j]) { positions.add(j) } }
            peer.expect(c, positions.length > 0, label + " has no safe operand for " + Text(a))
            contiguousRange(c, positions, label + " " + Text(a))
            lower.add(positions[0])
            upper.add(positions[positions.length - 1] + 1)
        }
        source.add("let " + label + "Low = [" + peer.joined(peer.texts(lower), ",") + "]")
        source.add("let " + label + "High = [" + peer.joined(peer.texts(upper), ",") + "]")
        peer.extend(source, ["let i = 0", "while i < values.length {", "let a = values[i]",
            "let j = " + label + "Low[i]", "while j < " + label + "High[i] {",
            "let b = values[j]", "let c = a " + symbol + " b", "print(c)"])
        if symbol == "+" { peer.extend(source, ["print(b + a)", "print(c - b)"]) }
        else if symbol == "-" { peer.extend(source, ["print(c + b)", "print(c - a)", "print(-b)"]) }
        else { peer.extend(source, ["print(b * a)", "if a != 0 { print(c / a) }"]) }
        peer.extend(source, ["j = j + 1", "}", "i = i + 1", "}"])
        for i in 0..values.length {
            let a = values[i]
            for j in lower[i]..upper[i] {
                let b = values[j]
                if symbol == "+" {
                    let result = a + b
                    peer.extend(expected, [Text(result), Text(result), Text(a)])
                } else if symbol == "-" {
                    let result = a - b
                    peer.extend(expected, [Text(result), Text(a), Text(-b), Text(-b)])
                } else {
                    let result = a * b
                    peer.extend(expected, [Text(result), Text(result)])
                    if a != 0 { expected.add(Text(b)) }
                }
            }
        }
    }
    peer.extend(source, ["function carry(value: Boolean): Boolean { return value }",
        "let i = 0", "while i < values.length {", "let a = values[i]",
        "print(a)", "print(-a)", "print(0 - a)", "print(a + -a)",
        "let j = 0", "while j < values.length {", "let b = values[j]",
        "let comparisons = [carry(a < b), carry(a <= b), carry(a > b), carry(a >= b), carry(a == b), carry(a != b)]",
        "let k = 0", "while k < comparisons.length { print(comparisons[k]); k = k + 1 }",
        "print(b == a)", "if b != 0 {", "let q = a / b", "let r = a % b",
        "print(q)", "print(r)", "print(b * q + r)", "}",
        "j = j + 1", "}", "i = i + 1", "}"])
    for i in 0..values.length {
        let a = values[i]
        peer.extend(expected, [Text(a), Text(-a), Text(-a), "0"])
        for j in 0..values.length {
            let b = values[j]
            for truth in [i < j, i <= j, i > j, i >= j, i == j, i != j, j == i] { expected.add(peer.boolean(truth)) }
            if b != 0 {
                let division = peer.division(a, b)
                peer.extend(expected, [Text(division.quotient), Text(division.remainder), Text(a)])
            }
        }
    }
    peer.executes(c, peer.lines(source), peer.lines(expected))
}
function test_signed_integer_peer_corpus_overflow_and_zero_divisors(c: peer.Case) {
    let values = integerValues(c)
    let source = ["function operand(text: Text): Integer {"]
    for value in values { source.add("if text == \"" + Text(value) + "\" { return " + Text(value) + " }") }
    peer.extend(source, ["return 0", "}", "let op = processInfo.argument(0)", "let a = operand(processInfo.argument(1))", "let b = operand(processInfo.argument(2))"])
    for op in ["+", "-", "*", "/", "%"] { source.add("if op == \"" + op + "\" { print(a " + op + " b) }") }
    let base = peer.executesWith(c, peer.lines(source), "0\n", 0, "", ["+", "0", "0"])
    let cases: List<List<Text>> = []
    let failures: List<Text> = []
    for op in ["+", "-", "*"] {
        for a in values {
            for b in values {
                if !fitsOperation(op, a, b) {
                    cases.add([op, Text(a), Text(b)])
                    failures.add(peer.OVERFLOW)
                }
            }
        }
    }
    for a in values {
        for op in ["/", "%"] {
            cases.add([op, Text(a), "0"])
            failures.add(peer.ZERO)
        }
    }
    peer.equalInteger(c, cases.length, 1486, "integer failure case count")
    let rows: List<json.Value> = []
    for item in cases { rows.add(peer.jsonTexts(item)) }
    peer.control(c, "peer_integer_failure_cases", peer.jsonArray(rows))
    for optimization in c.variants {
        for index in 0..cases.length {
            let command = [peer.executable(base, optimization)]
            peer.extend(command, cases[index])
            peer.observe(c, peer.run(c, command, "peer-integer-failure", c.runTimeout), 1, "", failures[index], peer.joined(cases[index], " ") + " at " + optimization)
        }
    }
}
function test_decimal_prefix_and_separator_finite_lexical_product(c: peer.Case) {
    let acceptedTokens: List<Text> = []
    let acceptedValues: List<Integer> = []
    let rejected = 0
    for cell in decimalCells(c) {
        if cell.accepted {
            acceptedTokens.add(cell.token)
            acceptedValues.add(cell.value)
        } else {
            rejectsExactDiagnostic(c, "print(" + cell.token + ")\n", cell.diagnostic)
            rejected += 1
        }
    }
    peer.expect(c, acceptedTokens.length == 152 && rejected == 967, "decimal cells: " + Text(acceptedTokens.length) + " accepted and " + Text(rejected) + " rejected")
    let source: List<Text> = []
    let expected: List<Text> = []
    for index in 0..acceptedTokens.length {
        source.add("print(" + acceptedTokens[index] + ")\n")
        expected.add(Text(acceptedValues[index]) + "\n")
    }
    peer.executes(c, joinText(source), joinText(expected))
}
