print(i)
let x = 1
function shadow(a: Integer) {
    let d0 = 0; let d1 = 1; let d2 = 2; let d3 = 3; let d4 = 4
    let d5 = 5; let d6 = 6; let d7 = 7; let d8 = 8; let d9 = 9
    let x = 3; let b = a; let c = a; let d = b
