            "print(value.length)", "print(value.byteLength)", "let i = 0",
            "while i < value.length { print(value[i]); parts.add(Text(value[i])); i = i + 1 }",
            "print(i)", "print(joinText(parts) == value)", "print(joinText(parts))"]
        let expected = [Text(scalars.length), Text(Bytes(value).length)]
        peer.extend(expected, scalars)
        peer.extend(expected, [Text(scalars.length), "true", value])
        peer.executes(c, peer.lines(source), peer.lines(expected))
    }
}
