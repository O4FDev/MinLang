use "../tools/testing.min" as test
let compiler = test.compiler()
let allowed: List<Text> = []
allowed.add("PeerMemoryFollowups")
allowed.add("PeerMemoryFollowups.test_nim_early_return_after_duplicate_owner_insertion")
allowed.add("PeerMemoryFollowups")
allowed.add("PeerMemoryFollowups.test_koka_projected_child_and_whole_parent_survive_transfer")
allowed.add("PeerMemoryFollowups")
allowed.add("PeerMemoryFollowups.test_koka_managed_separator_and_join_accumulator")
for index in 0..argumentCount() {
    let valid = false
    for name in allowed { if argument(index) == name { valid = true; break } }
    test.check(valid, "unknown peer memory test selector")
}
if true {
    let selected = argumentCount() == 0
    for index in 0..argumentCount() { if argument(index) == "PeerMemoryFollowups" || argument(index) == "PeerMemoryFollowups.test_nim_early_return_after_duplicate_owner_insertion" { selected = true } }
    if selected {
        test.executes(compiler, "record Transfer { left: List<List<Text>>; right: List<List<Text>> }\nfunction build(stop: Integer, chooseLeft: Boolean): Transfer {\n    let left: List<List<Text>> = []\n    let right: List<List<Text>> = []\n    let value = [\"owned\" + \"!\"]\n    let index = 0\n    while index < 4 {\n        if index == stop { return Transfer { left: left; right: right } }\n        left.add(value)\n        index = index + 1\n    }\n    if chooseLeft { left.add(value) } else { right.add(value) }\n    return Transfer { left: left; right: right }\n}\nlet early = build(2, false)\nprint(early.left.length)\nprint(early.right.length)\nprint(early.left[0][0])\nprint(early.left[1][0])\nlet left = build(-1, true)\nprint(left.left.length)\nprint(left.right.length)\nprint(left.left[4][0])\nlet right = build(-1, false)\nprint(right.left.length)\nprint(right.right.length)\nprint(right.right[0][0])\nlet saved = early.left[0]\nearly = Transfer { left: []; right: [] }\nleft = Transfer { left: []; right: [] }\nright = Transfer { left: []; right: [] }\nprint(saved[0])\n", "2\n0\nowned!\nowned!\n5\n0\nowned!\n4\n1\nowned!\nowned!\n")
    }
}
if true {
    let selected = argumentCount() == 0
    for index in 0..argumentCount() { if argument(index) == "PeerMemoryFollowups" || argument(index) == "PeerMemoryFollowups.test_koka_projected_child_and_whole_parent_survive_transfer" { selected = true } }
    if selected {
        test.executes(compiler, "record Payload { text: Text }\nrecord Result { selected: List<Payload>; original: List<Payload> }\nfunction prepend(values: List<Payload>): Result {\n    if values.length == 0 { return Result { selected: []; original: [] } }\n    return Result { selected: [values[0]]; original: values }\n}\nlet result = prepend([Payload { text: \"first\" + \"!\" }, Payload { text: \"second\" + \"!\" }])\nprint(result.selected[0].text)\nprint(result.original[0].text)\nlet saved = result.selected[0]\nlet parent = result.original\nresult = prepend([])\nparent[0] = Payload { text: \"changed\" + \"!\" }\nprint(saved.text)\nprint(parent[0].text)\nprint(parent[1].text)\nprint(result.selected.length)\nprint(result.original.length)\n", "first!\nfirst!\nfirst!\nchanged!\nsecond!\n0\n0\n")
    }
}
if true {
    let selected = argumentCount() == 0
    for index in 0..argumentCount() { if argument(index) == "PeerMemoryFollowups" || argument(index) == "PeerMemoryFollowups.test_koka_managed_separator_and_join_accumulator" { selected = true } }
    if selected {
        test.executes(compiler, "function join(values: List<Text>, separator: Text): Text {\n    if values.length == 0 { return \"\" }\n    let result = values[0]\n    let index = 1\n    while index < values.length {\n        result = result + separator + values[index]\n        index = index + 1\n    }\n    return result\n}\nprint(\"[\" + join([], \"empty\" + \"!\") + \"]\")\nprint(join([\"solo\" + \"!\"], \"unused\" + \"!\"))\nlet separator = \"<\" + \">\"\nlet values = [\"alpha\" + \"!\", \"beta\" + \"!\", \"gamma\" + \"!\"]\nlet result = join(values, separator)\nprint(separator)\nprint(values[0])\nvalues = []\nseparator = \"replacement\" + \"!\"\nprint(result)\nlet index = 0\nwhile index < 40 {\n    result = join([\"left\" + Text(index), \"right\" + Text(index)], \":\" + \"!\")\n    index = index + 1\n}\nprint(result)\n", "[]\nsolo!\n<>\nalpha!\nalpha!<>beta!<>gamma!\nleft39:!right39\n")
    }
}
test.removeTree(compiler.directory)
print("peer-memory-nim-koka-followups: passed")
