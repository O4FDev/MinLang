record Vec { x: Float; y: Float }
function length(v: Vec): Float {
    return sqrt(v.x * v.x + v.y * v.y)
}
let v = Vec { x: 3.0; y: 4.0 }
print(length(v))
print(0.1 + 0.2)
print(1.0 / 3.0)
print(-2.5)
print(100000.0)
print(1.5e300)
print(1.0e-9)
print(Float(7) / 2.0)
print(Integer(-7.9))
print(floor(-7.5))
print(Text(2.0) + "!")
let values: List<Float> = [1.5, 2.25]
values.add(-0.0)
print(values[1] + values[0])
print(values[2])
print(3.0 < 4.0)
print(0.0 / 0.0 == 0.0 / 0.0)
print(0.0 / 0.0 != 0.0 / 0.0)
print(min(3, -2))
print(max(1.5, 2.5))
print(clamp(15, 0, 10))
print(abs(-4))
print(abs(-4.5))
print(0xFF & 0x0F)
print(1 << 10)
print(-16 >> 2)
print(5 | 2 ^ 1)
print(~0)
print(wrappingMultiply(9223372036854775807, 2))
print(wrappingAdd(9223372036854775807, 1))
print(x_is_even(6))
function x_is_even(n: Integer): Boolean {
    return n & 1 == 0
}
let nested: List<List<Integer>> = [[1], [2, 3]]
print(nested[1][1])
print(Integer('A'))
print(Character(66))
print(pow(2.0, 10.0))
print(atan2(1.0, 1.0) * 4.0)
print(sin(0.0) + cos(0.0))
print(round(2.5))
