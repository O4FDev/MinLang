record Leaf { name: Text; data: Bytes; score: Integer }
record Box { leaf: Leaf; items: List<Leaf>; label: Text; numbers: List<Integer> }
record Holder { box: Box; boxes: List<Box> }

function freshLeaf(n: Integer): Leaf {
    return Leaf { name: "leaf " + Text(n); data: Bytes(n % 7 + 1); score: n }
}

function freshBox(n: Integer): Box {
    return Box { leaf: freshLeaf(n); items: [freshLeaf(n + 1), freshLeaf(n + 2)]; label: "box " + Text(n); numbers: [n, n + 1] }
}

// Replaces the holder's box while an assignment into the old box is in progress.
function swapBox(holder: Holder, n: Integer): Integer {
    holder.box = freshBox(n)
    holder.boxes = [freshBox(n + 10)]
    return n
}

function swapLeaf(box: Box, n: Integer): Text {
    box.leaf = freshLeaf(n)
    box.items = []
    return "x" + Text(n)
}

let holder = Holder { box: freshBox(1); boxes: [freshBox(2), freshBox(3)] }
let alias = holder.box
let total = 0
for round in 0..3000 {
    // Nested targets whose containers are replaced while the right side runs.
    holder.box.leaf.score = swapBox(holder, round)
    holder.boxes[0].leaf.name = swapLeaf(holder.boxes[0], round)
    holder.box.items[0] = freshLeaf(round)
    holder.box.label += Text(round % 10)
    holder.box.numbers[1] += round
    // Aliases observe and survive replacement.
    alias.leaf = holder.box.leaf
    alias = holder.boxes[0]
    let leaf = holder.box.leaf
    holder.box.leaf = freshLeaf(round + 5)
    leaf.name += "!"
    leaf.data.addInt32(round)
    // Call-free index reads that skip the borrow.
    total += holder.box.numbers[round % 2] % 97 + holder.box.leaf.data.length
    holder.box.leaf.data[0] = round % 256
    total += holder.box.leaf.data[0]
    if holder.box.label.length > 50 { holder.box.label = "reset" }
}
print(total)
print(alias.leaf.name)
print(holder.box.label)
