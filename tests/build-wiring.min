use "./build-wiring-support.min" as wire
use "./build-wiring-graphs.min" as graphs
use "./build-wiring-quic.min" as quic
use "./build-wiring-network.min" as network

constant NAMES: List<Text> = ["test_bakeoff_stress_is_mandatory_with_bounded_quick_profiles",
    "test_event_loop_native_and_sanitizer_keep_distinct_limits",
    "test_network_evidence_preserves_primary_and_finalizes_independently",
    "test_network_native_and_sanitizer_keep_distinct_limits",
    "test_cycle_progress_observability_is_mandatory_without_idle_replay",
    "test_quic_ledger_requires_full_offline_controls",
    "test_quic_rfc_requires_owned_lifecycle_controls",
    "test_quic_rfc_gates_keep_all_drivers_and_public_frontends",
    "test_generated_llvm_sanitizer_is_mandatory_and_tracks_canonical_helper",
    "test_private_retirement_gates_execute_actual_operation_contract",
    "test_parallel_signature_gates_prepare_every_frontend_and_fixture",
    "test_signed_relay_has_pinned_peer_and_all_lifetime_gates",
    "test_ack_scheduling_has_both_optimizations_and_all_mandatory_gates",
    "test_handshake_pto_has_native_and_sanitizer_gates",
    "test_registration_exposure_has_required_native_and_sanitizer_gates",
    "test_registered_growth_is_mandatory_with_native_and_sanitizer_drivers",
    "test_native_sanitizers_use_supported_leak_detection",
    "test_managed_graph_launcher_builds_only_supported_incremental_driver",
    "test_peer_driver_gates_prepare_the_request_frontend",
    "test_grpc_gates_verify_external_peers_and_bound_default_builds",
    "test_quic_official_adapter_requires_all_linux_controls",
    "test_os_tlsverify_sanitizer_selects_override_and_complete_directory",
    "test_os_freestanding_provider_inputs_invalidate_object",
    "test_relay_wrong_key_changes_decoded_signature_even_with_aa_tail",
    "test_network_sanitizers_select_override_and_complete_directory"]

function selected(selectors: List<Text>, name: Text): Boolean {
    if selectors.length == 0 { return true }
    for value in selectors { if value == "BuildWiring" || value == name || value == "BuildWiring." + name { return true } }
    return false
}
function dispatch(w: wire.Wiring, name: Text) {
    if name == "test_bakeoff_stress_is_mandatory_with_bounded_quick_profiles" { graphs.test_bakeoff_stress_is_mandatory_with_bounded_quick_profiles(w) }
    if name == "test_event_loop_native_and_sanitizer_keep_distinct_limits" { network.test_event_loop_native_and_sanitizer_keep_distinct_limits(w) }
    if name == "test_network_evidence_preserves_primary_and_finalizes_independently" { network.test_network_evidence_preserves_primary_and_finalizes_independently(w) }
    if name == "test_network_native_and_sanitizer_keep_distinct_limits" { network.test_network_native_and_sanitizer_keep_distinct_limits(w) }
    if name == "test_cycle_progress_observability_is_mandatory_without_idle_replay" { graphs.test_cycle_progress_observability_is_mandatory_without_idle_replay(w) }
    if name == "test_quic_ledger_requires_full_offline_controls" { quic.test_quic_ledger_requires_full_offline_controls(w) }
    if name == "test_quic_rfc_requires_owned_lifecycle_controls" { quic.test_quic_rfc_requires_owned_lifecycle_controls(w) }
    if name == "test_quic_rfc_gates_keep_all_drivers_and_public_frontends" { quic.test_quic_rfc_gates_keep_all_drivers_and_public_frontends(w) }
    if name == "test_generated_llvm_sanitizer_is_mandatory_and_tracks_canonical_helper" { graphs.test_generated_llvm_sanitizer_is_mandatory_and_tracks_canonical_helper(w) }
    if name == "test_private_retirement_gates_execute_actual_operation_contract" { graphs.test_private_retirement_gates_execute_actual_operation_contract(w) }
    if name == "test_parallel_signature_gates_prepare_every_frontend_and_fixture" { graphs.test_parallel_signature_gates_prepare_every_frontend_and_fixture(w) }
    if name == "test_signed_relay_has_pinned_peer_and_all_lifetime_gates" { quic.test_signed_relay_has_pinned_peer_and_all_lifetime_gates(w) }
    if name == "test_ack_scheduling_has_both_optimizations_and_all_mandatory_gates" { quic.test_ack_scheduling_has_both_optimizations_and_all_mandatory_gates(w) }
    if name == "test_handshake_pto_has_native_and_sanitizer_gates" { quic.test_handshake_pto_has_native_and_sanitizer_gates(w) }
    if name == "test_registration_exposure_has_required_native_and_sanitizer_gates" { graphs.test_registration_exposure_has_required_native_and_sanitizer_gates(w) }
    if name == "test_registered_growth_is_mandatory_with_native_and_sanitizer_drivers" { graphs.test_registered_growth_is_mandatory_with_native_and_sanitizer_drivers(w) }
    if name == "test_native_sanitizers_use_supported_leak_detection" { network.test_native_sanitizers_use_supported_leak_detection(w) }
    if name == "test_managed_graph_launcher_builds_only_supported_incremental_driver" { graphs.test_managed_graph_launcher_builds_only_supported_incremental_driver(w) }
    if name == "test_peer_driver_gates_prepare_the_request_frontend" { network.test_peer_driver_gates_prepare_the_request_frontend(w) }
    if name == "test_grpc_gates_verify_external_peers_and_bound_default_builds" { network.test_grpc_gates_verify_external_peers_and_bound_default_builds(w) }
    if name == "test_quic_official_adapter_requires_all_linux_controls" { quic.test_quic_official_adapter_requires_all_linux_controls(w) }
    if name == "test_os_tlsverify_sanitizer_selects_override_and_complete_directory" { network.test_os_tlsverify_sanitizer_selects_override_and_complete_directory(w) }
    if name == "test_os_freestanding_provider_inputs_invalidate_object" { network.test_os_freestanding_provider_inputs_invalidate_object(w) }
    if name == "test_relay_wrong_key_changes_decoded_signature_even_with_aa_tail" { network.test_relay_wrong_key_changes_decoded_signature_even_with_aa_tail(w) }
    if name == "test_network_sanitizers_select_override_and_complete_directory" { network.test_network_sanitizers_select_override_and_complete_directory(w) }
}

let selectors: List<Text> = []
for index in 0..argumentCount() {
    let value = argument(index)
    let known = value == "BuildWiring"
    for name in NAMES { if value == name || value == "BuildWiring." + name { known = true } }
    wire.check(known, "unknown BuildWiring selector: " + value)
    selectors.add(value)
}
let w = wire.wiring()
let ran = 0
for name in NAMES {
    if !selected(selectors, name) { continue }
    dispatch(w, name)
    print(name + " ... ok")
    ran += 1
}
wire.finish(w)
print("Ran " + Text(ran) + " tests")
print("OK")
