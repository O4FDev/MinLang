use "./net-fixtures.min" as fixtures
use "../tools/testing.min" as test

fixtures.arguments(["--sanitize"], [])
let context = fixtures.context(fixtures.flag("--sanitize"))
let binary = context.work + "/crypto"
fixtures.compileProgram(context, "tests/securecrypto.min", binary)
let result = fixtures.run(context, [binary], 120)
test.check(result.status == 0 && result.errorOutput == "", "securecrypto failed (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
fixtures.emit(result.output)
let shared = context.work + "/shared"
fixtures.compileProgram(context, "tests/securecrypto-update.min", shared)
let update = fixtures.run(context, [shared], 120)
test.check(update.status == 0 && update.output == "true\ntrue\n" && update.errorOutput == "", "shared primitive object failed (" + Text(update.status) + ")\n" + update.output + update.errorOutput)
fixtures.finish(context)
