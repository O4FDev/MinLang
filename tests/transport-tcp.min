use "transport" as transport
use "net" as net
use "errors" as errors
record Message { id: Integer; data: Bytes; finished: Boolean; count: Integer }
function main(): Integer {
    let server = argument(0) == "server"
    let identity = readBytesFile(argument(2)); let key = readBytesFile(argument(3)); let root = readBytesFile(argument(4))
    let connection = transport.client("localhost", randomBytes(80), "minyar-test", [root], [identity], key)
    let socket = -1
    if server {
        let listener = net.listen("127.0.0.1", 0, 16); if listener < 0 { return 1 }
        print("READY " + Text(net.localPort(listener)))
        if !net.ready(listener, 10000) { return 2 }
        socket = net.accept(listener); net.close(listener)
        connection = transport.serverTCP(randomBytes(64), "minyar-test", [identity], key, [root], true, 0)
    } else {
        let port = 0; for digit in argument(1) { port = port * 10 + Integer(digit) - 48 }
        socket = net.connect("127.0.0.1", port)
        transport.udpUnavailable(connection); transport.startTCP(connection, randomBytes(64), 0)
    }
    if socket < 0 { return 3 }
    let started = net.monotonicMilliseconds(); let opened = false; let completed = 0; let messages: List<Message> = []
    while net.monotonicMilliseconds() - started < 12000 {
        let now = net.monotonicMilliseconds() - started
        if !server && connection.state == transport.TCP_READY && !opened {
            opened = true
            for index in 0..16 {
                let id = errors.integerValue(transport.openStream(connection)); let data = Bytes(32768)
                for at in 0..data.length { data[at] = index }
                if !errors.integerOk(transport.write(connection, id, data, true)) { return 4 }
                messages.add(Message { id: id; data: Bytes(); finished: false; count: 0 })
            }
        }
        if connection.state == transport.TCP_READY {
            for id in transport.streamIds(connection) {
                let index = -1; for at in 0..messages.length { if messages[at].id == id { index = at } }
                if index < 0 { messages.add(Message { id: id; data: Bytes(); finished: false; count: 0 }); index = messages.length - 1 }
                if !messages[index].finished {
                    let data = transport.read(connection, id)
                    if errors.bytesStatus(data) == errors.endOfStreamStatus() {
                        if messages[index].count != 32768 { return 5 }
                        if server && !errors.integerOk(transport.write(connection, id, messages[index].data, true)) { return 6 }
                        messages[index].finished = true; completed += 1
                    } else if errors.bytesOk(data) {
                        let bytes = errors.bytesValue(data); messages[index].count += bytes.length
                        if server { messages[index].data.addBytes(bytes) }
                        else { for byte in bytes { if byte != index { return 7 } } }
                    }
                }
            }
        }
        let outgoing = transport.pollTCP(connection, now); let at = 0
        while at < outgoing.length {
            let count = net.send(socket, outgoing.slice(at, min(outgoing.length, at + 1021)))
            if count <= 0 { return 8 }; at += count
        }
        if completed == 16 {
            transport.close(connection); net.send(socket, transport.pollTCP(connection, now)); net.close(socket)
            print("Minyar TLS/yamux: 16 authenticated multiplexed half-closed streams passed"); return 0
        }
        if connection.state == transport.FAILED { print(connection.error); return 9 }
        if net.ready(socket, 10) {
            let data = net.receive(socket, 65536)
            if data.length == 0 { transport.endTCPInput(connection); print(connection.error); return 10 }
            transport.receiveTCP(connection, data, net.monotonicMilliseconds() - started)
        }
    }
    net.close(socket); print("TCP multiplex timeout " + Text(completed)); return 11
}
