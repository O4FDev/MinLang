use "../tools/testing.min" as test
let compiler = test.compiler()
let allowed: List<Text> = []
allowed.add("PeerMemorySemantics")
allowed.add("PeerMemorySemantics.test_nim_effectful_assignment_indices_keep_order_and_old_alias")
allowed.add("PeerMemorySemantics")
allowed.add("PeerMemorySemantics.test_nim_saved_scope_survives_owner_replacement")
allowed.add("PeerMemorySemantics")
allowed.add("PeerMemorySemantics.test_nim_record_constructor_keeps_an_earlier_projection")
