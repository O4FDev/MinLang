allowed.add("PeerMemorySemantics.test_nim_conditional_saved_projection_survives_later_rows")
allowed.add("PeerMemorySemantics")
allowed.add("PeerMemorySemantics.test_nim_returned_member_survives_same_slot_overwrite")
allowed.add("PeerMemorySemantics")
allowed.add("PeerMemorySemantics.test_nim_part_to_whole_assignment_uses_one_dynamic_index")
allowed.add("PeerMemorySemantics")
allowed.add("PeerMemorySemantics.test_koka_nested_selection_keeps_only_the_selected_child")
allowed.add("PeerMemorySemantics")
allowed.add("PeerMemorySemantics.test_koka_record_rotation_preserves_shared_input_lists")
allowed.add("PeerMemorySemantics")
