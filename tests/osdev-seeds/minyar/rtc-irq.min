// Minyar counterpart of tests/osdev-seeds/c/rtc_irq.c. The handler only records
// the tick: acknowledging Register C and the PIC are port I/O, a native effect
// that interrupt context rejects, so ordinary code does them after takeInterrupt.
// The seeded-mistake study inserts one mistake at the SEED line.
use "device" as device
use "machine" as machine

constant RTC_TICK = 0
constant RTC_VECTOR = 40

interrupt function rtcTick(vector: Integer) handles(RTC_VECTOR) {
    signalInterrupt(RTC_TICK)
    // SEED
}

function acknowledge() {
    let selector = device.port8(0x70)
    let data = device.port8(0x71)
    device.out8(selector, 0x0C)
    let flags = device.in8(data)
    device.out8(device.port8(0xA0), 0x20)
    device.out8(device.port8(0x20), 0x20)
}

function main(): Integer {
    if takeInterrupt(RTC_TICK) { acknowledge() }
    return 0
}
