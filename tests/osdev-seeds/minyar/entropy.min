// Host model of the capability sequence in os/shared/virtio/virtio.min
// readOneEntropyByte: allocate, poison, submit, reclaim, read, dispose. The
// deterministic model stands in for the device between begin and finish.
// The seeded-mistake study edits begin/finish; main is the host test.
use "dma" as dma
use "dma_model" as model

function begin(queue: dma.Queue, count: Integer): dma.Pending {
    let cpu = dma.allocate(count, 64)
    dma.store8(cpu, 0, 0xA5)
    let pending = dma.submit(queue, cpu, count)
    return pending
}

function finish(pending: dma.Pending, count: Integer): Bytes {
    let completed = dma.reclaim(pending, 1000)
    let bytes = dma.copyOut(completed, 0, count)
    dma.dispose(completed)
    return bytes
}

function main(): Integer {
    let queue = model.modelQueue()
    let pending = begin(queue, 8)
    if !model.modelDeliver(queue, Bytes("entropy!")) { fail("the model refused the delivery") }
    let bytes = finish(pending, 8)
    if bytes.length != 8 || bytes[0] != 101 || bytes[7] != 33 { fail("the entropy bytes differ from the model") }
    print("MINYAR ENTROPY HOST PASS")
    return 0
}
