use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, io.readTextFile("examples/gallery/methods.min"), "Ada has 7 seeds.\nGrace has 5 seeds.\nA garden grows when we share.\n", levels, 0, "", true)

io.writeTextFile(frontend.compiler.directory + "/account.min", "public record Account { private value: Integer }\npublic function open(n: Integer): Account { return Account { value: n } }\nfunction Account.twice(): Integer { return self.value * 2 }\npublic function Account.balance(): Integer { return self.twice() / 2 }\npublic function Account.deposit(n: Integer): Account { self.value += n; return self }\n")
fixtures.executes(frontend, "use \"./account.min\" as bank\nlet ada = bank.open(20)\nlet alias = ada\nprint(ada.deposit(2).deposit(20).balance())\nprint(alias.balance())\nprint(bank.open(42).balance())\n", "42\n42\n42\n", levels, 0, "", true)
fixtures.executes(frontend, "record Box { value: Text }\nrecord Holder { box: Box }\nfunction Box.read(other: Box): Text { return self.value + other.value }\nfunction replace(holder: Holder): Box { holder.box = Box { value: \"new\" }; return holder.box }\nlet holder = Holder { box: Box { value: \"old\" } }\nprint(holder.box.read(replace(holder)))\nprint(holder.box.value)\n", "oldnew\nnew\n", levels, 0, "", true)
fixtures.executes(frontend, "record Box { apply: (Integer) -> Integer }\nfunction Box.read(): Integer { return self.apply(40) }\nlet box = Box { apply: function(n) { return n + 2 } }\nprint(box.read())\nprint(box.apply(40))\n", "42\n42\n", levels, 0, "", true)
fixtures.rejects(frontend, "use \"./account.min\" as bank\nprint(bank.open(2).twice())\n", "method 'twice' is private to its module", true)
fixtures.rejects(frontend, "use \"./account.min\" as bank\nfunction bank.Account.spoil() {}\n", "methods must be declared in the module that declares their record", true)
fixtures.rejects(frontend, "function Missing.read() {}\n", "methods must be declared in the module that declares their record", true)
fixtures.rejects(frontend, "record Box { value: Integer }\nfunction Box.read(self: Integer) {}\n", "declares parameter 'self' twice", true)
fixtures.rejects(frontend, "record Box { value: Integer }\nfunction Box.read(n: Integer) {}\nBox { value: 0 }.read()\n", "method 'read' expects 1 arguments", true)
fixtures.rejects(frontend, "record Box { value: Integer }\nfunction Box.read(n: Integer) {}\nBox { value: 0 }.read(1, 2)\n", "method 'read' received too many arguments", true)
fixtures.rejects(frontend, "record Box { value: Integer }\nfunction Box.read(n: Integer) {}\nBox { value: 0 }.read(\"wrong\")\n", "an argument passed to method 'read' has the wrong type", true)
fixtures.rejects(frontend, "record Box { value: Integer }\nfunction Box.read() {}\nfunction Box.read() {}\n", "module declares 'Box$read' more than once", true)
test.removeTree(frontend.compiler.directory)
print("Record methods: passed")
