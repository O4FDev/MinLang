use "../tools/testing.min" as test
use "system" as system
let work = test.scratch()
let tool = argument(0)
test.require(test.run(["tar", "-xzf", argument(1), "--strip-components=1", "-C", work], system.environment(), "", work + "/extract", 30), "pinned GLFW source")
let source = work + "/src/nsgl_context.m"
let original = readTextFile(source)
let output = work + "/patched.m"
test.require(test.run([tool, source, output], system.environment(), "", work + "/patch", 10), "software pixel format fallback")
let patched = readTextFile(output)
let addition = "    if (window->context.nsgl.pixelFormat == nil)\n    {\n        assert(attribs[0] == NSOpenGLPFAAccelerated);\n        window->context.nsgl.pixelFormat =\n            [[NSOpenGLPixelFormat alloc] initWithAttributes:(attribs + 1)];\n    }\n"
let restored = test.replace(test.replace(patched, "#define MINYAR_CI_SOFTWARE_GLFW 1\n", ""), addition, "")
test.check(restored == original && patched != original, "fallback preserves every original version, profile and sample attribute")
test.check(test.contains(patched, "NSOpenGLPFAAccelerated") && test.contains(patched, addition), "hardware selection precedes software retry")
for input in [patched, test.replace(original, "attribs[40]", "attribs[41]"), original + original] {
    writeTextFile(work + "/invalid.m", input)
    let result = test.run([tool, work + "/invalid.m", work + "/rejected.m"], system.environment(), "", work + "/reject", 10)
    test.check(result.status != 0 && !fileExists(work + "/rejected.m"), "source drift or repeated patch fails before publication")
}
test.removeTree(work)
print("Minyar GLFW source controls: passed")
