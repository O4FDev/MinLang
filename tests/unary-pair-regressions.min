use "../tools/testing.min" as test
use "system" as system
use "json" as json
use "sha256" as sha

record Report { evidence: Text; status: Text; error: Text; checks: List<Text>; sources: List<Text> }
function save(report: Report) {
    let parts: List<Text> = ["{\n  \"status\": ", json.quote(report.status), ",\n  \"checks\": ["]
    for index in 0..report.checks.length {
        if index > 0 { parts.add(",") }
        parts.add("\n    " + report.checks[index])
    }
    parts.add("\n  ],\n  \"source_sha256\": {")
    for index in 0..report.sources.length {
        if index > 0 { parts.add(",") }
        parts.add("\n    " + report.sources[index])
    }
    parts.add("\n  },\n  \"reference_transformation\": \"Remove only the sole-unvisited-unary pair fast path; retain the unary locality scheduler.\",\n  \"requested_budgets\": [")
    for budget in 1..34 {
        if budget > 1 { parts.add(", ") }
        parts.add(Text(budget))
    }
    parts.add("],\n  \"configured_budgets\": [1, 32, 1024]")
    if report.status == "failed" { parts.add(",\n  \"error\": " + json.quote(report.error)) }
    parts.add("\n}\n")
    writeTextFile(report.evidence + "/results.json", joinText(parts))
}
function ensure(report: Report, condition: Boolean, message: Text) {
    if !condition {
        report.status = "failed"
        report.error = message
        save(report)
        fail(message)
    }
}
function shell(command: List<Text>, log: Text) {
    test.require(test.run(command, system.environment(), "", log, 60), command[0])
}
function list(values: List<Text>): Text {
    let parts: List<Text> = []
    for index in 0..values.length {
        if index > 0 { parts.add(", ") }
        parts.add(json.quote(values[index]))
    }
    return "[" + joinText(parts) + "]"
}
function run(report: Report, environment: List<Text>, label: Text, command: List<Text>): Text {
    let path = report.evidence + "/" + label
    let checked = test.run(command, environment, "", path + ".stdout", 120)
    writeTextFile(path + ".stderr", checked.errorOutput)
    report.checks.add("{\"label\": " + json.quote(label) + ", \"command\": " + list(command) + ", \"returncode\": " + Text(checked.status) + "}")
    save(report)
    let tail = Bytes(checked.errorOutput)
    let start = 0
    if tail.length > 5000 { start = tail.length - 5000 }
    ensure(report, checked.status == 0, label + "\n" + Text(tail.slice(start, tail.length)))
    return checked.output
}

let runtimeSource = "runtime/minyar_runtime.c"
let clang = "clang"
let output = ""
let index = 0
while index < argumentCount() {
    test.check(index + 1 < argumentCount(), "option needs a value: " + argument(index))
    if argument(index) == "--runtime-source" { runtimeSource = argument(index + 1) }
    else if argument(index) == "--clang" { clang = argument(index + 1) }
    else if argument(index) == "--output-dir" { output = argument(index + 1) }
    else { fail("unknown option: " + argument(index)) }
    index += 2
}
let logs = test.scratch()
let parent = test.setting("TMPDIR", "/tmp")
if output != "" {
    shell(["mkdir", "-p", "--", output], logs + "/mkdir")
    parent = output
}
let created = test.run(["mktemp", "-d", parent + "/minyar-unary-pair-tests-XXXXXXXX"], system.environment(), "", logs + "/mktemp", 10)
test.require(created, "create evidence directory")
let resolved = test.run(["sh", "-c", "cd \"$(dirname -- \"$1\")\" && pwd -P", "minyar", runtimeSource], system.environment(), "", logs + "/runtime", 10)
test.require(resolved, "resolve runtime directory")
let runtimeDirectory = test.lines(resolved.output)[0]
let evidence = test.lines(created.output)[0]
for version in ["candidate", "reference"] {
    shell(["mkdir", "-p", "--", evidence + "/" + version + "/tests"], logs + "/mkdir")
    shell(["cp", "-R", "--", runtimeDirectory, evidence + "/" + version + "/runtime"], logs + "/copy")
    for name in ["unary-order.c", "pair-transcript.c"] { shell(["cp", "-p", "--", "tests/" + name, evidence + "/" + version + "/tests/" + name], logs + "/copy") }
}
let referenceHeader = evidence + "/reference/runtime/minyar_bounded_rc.h"
let header = readTextFile(referenceHeader)
let raw = Bytes(header)
function find(raw: Bytes, needle: Text, begin: Integer): Integer {
    let pattern = Bytes(needle)
    let position = begin
    while position + pattern.length <= raw.length {
        if Text(raw.slice(position, position + pattern.length)) == needle { return position }
        position += 1
    }
    return -1
}
let begin = find(raw, "            /* With one unvisited unary record, locality makes its field visit", 0)
test.check(begin >= 0, "unary pair fast path marker is missing")
let end = find(raw, "            /* A ready recent task", begin)
test.check(end >= 0, "ready recent task marker is missing")
let removed = Text(raw.slice(begin, end))
let pairs = 0
let cursor = find(Bytes(removed), "work += 2;", 0)
while cursor >= 0 {
    pairs += 1
    cursor = find(Bytes(removed), "work += 2;", cursor + 10)
}
test.check(pairs == 1 || pairs == 2, "unexpected unary pair work charge count")
writeTextFile(referenceHeader, Text(raw.slice(0, begin)) + Text(raw.slice(end, raw.length)))
let listed = test.run(["sh", "-c", "cd \"$1\" && find . -type f | LC_ALL=C sort", "minyar", evidence], system.environment(), "", logs + "/find", 30)
test.require(listed, "list evidence sources")
let report = Report { evidence: evidence; status: "running"; error: ""; checks: []; sources: [] }
for line in test.lines(listed.output) {
    let name = Text(Bytes(line).slice(2, Bytes(line).length))
    report.sources.add(json.quote(name) + ": " + json.quote(sha.hex(sha.digest(readBytesFile(evidence + "/" + name)))))
}
test.removeScratch(logs)
save(report)
print(evidence)
let environment: List<Text> = []
for item in system.environment() {
    let bytes = Bytes(item)
    let asan = bytes.length >= 13 && Text(bytes.slice(0, 13)) == "ASAN_OPTIONS="
    let ubsan = bytes.length >= 14 && Text(bytes.slice(0, 14)) == "UBSAN_OPTIONS="
    if !asan && !ubsan { environment.add(item) }
}
environment.add("ASAN_OPTIONS=detect_leaks=0:abort_on_error=1")
environment.add("UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1")
let modes = ["native", "sanitize"]
let modeFlags: List<List<Text>> = [[], ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]]
for position in 0..modes.length {
    let mode = modes[position]
    for budget in [1, 32, 1024] {
        let outputs: List<Text> = []
        for version in ["reference", "candidate"] {
            let label = mode + "-k" + Text(budget) + "-" + version
            let command = [clang, "-O2"]
            for flag in modeFlags[position] { command.add(flag) }
            for item in ["-DMINYAR_RC_POLL_BUDGET=" + Text(budget), evidence + "/" + version + "/tests/pair-transcript.c", "-o", evidence + "/" + label, "-lm"] { command.add(item) }
            run(report, environment, label + "-compile", command)
            outputs.add(run(report, environment, label, [evidence + "/" + label]))
        }
        ensure(report, outputs[0] == outputs[1], mode + " " + Text(budget) + " scheduler transcript mismatch")
        let label = mode + "-k" + Text(budget) + "-free-order"
        let command = [clang, "-O2"]
        for flag in modeFlags[position] { command.add(flag) }
        for item in ["-DMINYAR_RC_POLL_BUDGET=" + Text(budget), evidence + "/candidate/tests/unary-order.c", "-o", evidence + "/" + label, "-lm"] { command.add(item) }
        run(report, environment, label + "-compile", command)
        run(report, environment, label, [evidence + "/" + label])
        print(mode + " " + Text(budget) + " exact transcript/free order/2N units passed")
    }
}
report.status = "passed"
save(report)
print(evidence + "/results.json")
