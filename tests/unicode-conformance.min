// Published Unicode 18 vectors are an independent oracle for the native provider.
use "unicode" as text
use "io" as io

function check(condition: Boolean, message: Text) {
    if !condition { fail(message) }
}

function hexadecimal(word: Text): Integer {
    let value = 0
    for character in word {
        let digit = Integer(character) - 48
        if character >= 'A' && character <= 'F' { digit = Integer(character) - 55 }
        check(digit >= 0 && digit < 16, "invalid Unicode corpus hexadecimal digit")
        value = value * 16 + digit
    }
    return value
}

function scalars(field: Text): Text {
    let pieces: List<Text> = []
    for word in field.trim().split(" ") {
        if word != "" { pieces.add(Text(Character(hexadecimal(word)))) }
    }
    return joinText(pieces)
}

function normalization(): Integer {
    let count = 0
    for raw in io.readTextFile("tests/fixtures/unicode-18.0.0/NormalizationTest.txt").split("\n") {
        let line = raw.split("#")[0].trim()
        if line == "" || line.startsWith("@") { continue }
        let fields = line.split(";")
        check(fields.length >= 5, "incomplete normalization vector")
        let columns: List<Text> = []
        for index in 0..5 { columns.add(scalars(fields[index])) }
        for index in 0..5 {
            let expected = columns[1]
            if index >= 3 { expected = columns[3] }
            check(text.normalized(columns[index]) == expected, "NFC vector " + Text(count) + " column " + Text(index))
        }
        // Canonical caseless keys must also agree for every canonical pair.
        check(text.caseFold(columns[0]) == text.caseFold(columns[2]), "canonical fold vector " + Text(count))
        count += 1
    }
    check(count == 20171, "normalization corpus is incomplete")
    return count
}

function graphemes(): Integer {
    let count = 0
    for raw in io.readTextFile("tests/fixtures/unicode-18.0.0/GraphemeBreakTest.txt").split("\n") {
        let line = raw.split("#")[0].trim()
        if line == "" { continue }
        let expected: List<Integer> = []
        let pieces: List<Text> = []
        let position = 0
        for word in line.split(" ") {
            if word == "÷" { expected.add(position) }
            else if word != "×" && word != "" {
                pieces.add(Text(Character(hexadecimal(word))))
                position += 1
            }
        }
        let source = joinText(pieces)
        let actual = text.graphemeBoundaries(source)
        check(actual.length == expected.length, "grapheme boundary count vector " + Text(count))
        for index in 0..expected.length {
            check(actual[index] == expected[index], "grapheme position vector " + Text(count))
        }
        check(text.graphemeCount(source) == expected.length - 1, "grapheme count vector " + Text(count))
        let clusters = text.graphemes(source)
        check(clusters.length == expected.length - 1 && joinText(clusters) == source, "grapheme roundtrip vector " + Text(count))
        count += 1
    }
    check(count == 853, "grapheme corpus is incomplete")
    return count
}

function folding(): Integer {
    let count = 0
    for raw in io.readTextFile("tests/fixtures/unicode-18.0.0/CaseFolding.txt").split("\n") {
        let line = raw.split("#")[0].trim()
        if line == "" { continue }
        let fields = line.split(";")
        check(fields.length >= 3, "incomplete case-fold vector")
        let status = fields[1].trim()
        if status != "C" && status != "F" { continue }
        let source = scalars(fields[0])
        let expected = text.normalized(scalars(fields[2]))
        let actual = text.caseFold(source)
        check(actual == expected, "full case-fold vector " + Text(count))
        check(text.caseFold(actual) == actual, "case-fold idempotence vector " + Text(count))
        count += 1
    }
    check(count == 1606, "case-fold corpus is incomplete")
    return count
}

check(text.unicodeVersion() == "18.0.0", "Unicode data version changed")
print("Unicode 18: " + Text(graphemes()) + " grapheme, " + Text(normalization()) + " normalization, " + Text(folding()) + " full case-fold vectors passed")
