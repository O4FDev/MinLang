use "io" as io
use "./net-fixtures.min" as fixtures
use "../tools/testing.min" as test
use "files" as files

record Mutant { name: Text; file: Text; before: Text; after: Text; expected: Text }

let mutants = [Mutant { name: "signature"; file: "peerauth.min"; before: "!verify(token.slice(0, dots[1]), signature, key)"; after: "false"; expected: "signature bit mutation" },
    Mutant { name: "exit"; file: "peerauth.min"; before: "field(claims, \"exit_id\") != authenticatedExitID"; after: "false"; expected: "claim exit_id 'exit-b'" },
    Mutant { name: "connection"; file: "peerauth.min"; before: "field(claims, \"conn_id\") != requestConnID"; after: "false"; expected: "wrong connection" },
    Mutant { name: "deadline"; file: "peerauth.min"; before: "establishmentDeadlineSeconds > expiry"; after: "false"; expected: "deadline after expiry" },
    Mutant { name: "lifetime"; file: "peerauth.min"; before: "expiry - issued > 60"; after: "false"; expected: "claim exp 1061" },
    Mutant { name: "pad-bits"; file: "peerauth.min"; before: "if value != 0 { return Bytes() }"; after: "if false { return Bytes() }"; expected: "noncanonical signature pad bits" },
    Mutant { name: "duplicates"; file: "json.min"; before: "return parseUnique(Text(source))"; after: "return parseText(Text(source), true)"; expected: "duplicate decoded header key" }]
fixtures.arguments([], ["--probe"])
let context = fixtures.context(false)
let probe = fixtures.option("--probe", context.root + "/build/tooling/tests/peer-auth-test")
for mutant in mutants {
    let directory = context.work + "/" + mutant.name
    test.check(files.makeDirectory(directory) == 0, "create mutant library")
    let source = io.readTextFile(context.root + "/library/" + mutant.file)
    test.check(fixtures.count(source, mutant.before) == 1, mutant.name + ": mutation site drift")
    io.writeTextFile(directory + "/" + mutant.file, test.replace(source, mutant.before, mutant.after))
    let result = test.run([probe, "--library", directory], context.environment, context.root, fixtures.logPath(context, mutant.name), 300)
    test.check(result.status != 0 && result.status != 124 && test.contains(result.errorOutput, mutant.expected), mutant.name + " survived (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
    print("Killed " + mutant.name + ": " + mutant.expected)
}
print("Peer auth: all " + Text(mutants.length) + " deliberate policy mutations killed")
fixtures.finish(context)
