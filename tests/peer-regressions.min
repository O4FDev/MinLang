    peer.put(domain, "source", peer.jsonText(program))
    peer.put(domain, "rule", peer.jsonText("all 0 <= begin <= end <= length, including empty spans"))
    peer.put(domain, "count", peer.jsonInteger((characters.length + 1) * (characters.length + 2) / 2))
    peer.control(c, "substring_domain", domain)
    for begin in 0..(characters.length + 1) {
        for end in begin..(characters.length + 1) {
            let compiled = peer.compile(c, scalarSlice(program, begin, end))
            let result = compiled.result
            let label = "substring " + Text(begin) + ".." + Text(end)
            peer.expect(c, result.status == 0 || result.status == 1, label + " status " + Text(result.status) + "\n" + result.errorOutput)
            peer.expect(c, result.output == "", label + " wrote standard output")
            if result.status == 0 {
                peer.expect(c, result.errorOutput == "", label + " wrote diagnostics")
                peer.expect(c, files.pathSize(compiled.llvm) >= 0, label + " emitted no LLVM")
            } else {
                peer.expect(c, peer.validCompilerDiagnostics(result.errorOutput), label + " diagnostic\n" + result.errorOutput)
                peer.expect(c, !peer.contains(result.errorOutput, "List position"), label + " List-position failure")
                peer.expect(c, !peer.contains(result.errorOutput, "outside the supported range"), label + " range failure")
                peer.expect(c, files.pathSize(compiled.llvm) < 0, label + " left LLVM")
            }
        }
    }
}
function test_arithmetic_grouping_and_invalid_assignment_targets(c: peer.Case) {
    peer.executes(c, "function grouping(a: Integer, b: Integer, c: Integer) {
print(a / (b / c))
print((a / b) / c)
print(a / b / c)
}
grouping(16, 4, 2)
print(16 / (4 / 2))
print((16 / 4) / 2)
print(16 / 4 / 2)
print(-1*1/1 + 1*1 - ---1*1)
", "8\n2\n2\n8\n2\n2\n1\n")
    for assignment in ["x + 1 = 1", "x + 1 = y + 2"] { peer.rejects(c, "let x = 1\nlet y = 2\n" + assignment + "\n", "Minyar stopped:") }
}
function test_wide_products_and_square_overflow_boundary(c: peer.Case) {
    peer.executes(c, "function product(a: Integer, b: Integer): Integer { return a * b }
print(product(4608, 1024) * 1024)
print(product(3037000499, 3037000499))
print(product(-3037000499, 3037000499))
", "4831838208\n9223372030926249001\n-9223372030926249001\n")
    for pair in [[3037000500, 3037000500], [-3037000500, 3037000500], [4831838208, 4831838208], [peer.MINIMUM, 7]] {
        peer.executesStatus(c, "function product(a: Integer, b: Integer): Integer { return a * b }\nprint(product(" + Text(pair[0]) + ", " + Text(pair[1]) + "))\n", "", 1, peer.OVERFLOW)
    }
}
function test_subtraction_table_and_mutation_order(c: peer.Case) {
    let values = [-4275878552, -4275878551, -4660, -3, -2, -1, 0, 1, 2, 3, 4660, 4275878551, 4275878552]
    let source = ["function subtract(a: Integer, b: Integer): Integer { return a - b }", "function add(a: Integer, b: Integer): Integer { return a + b }", "function divide(a: Integer, b: Integer): Integer { return a / b }", "function remainder(a: Integer, b: Integer): Integer { return a % b }", "function multiply(a: Integer, b: Integer): Integer { return a * b }"]
    let expected: List<Text> = []
    let overflowLeft: List<Integer> = []
    let overflowRight: List<Integer> = []
    for a in values {
        for b in values {
            let x = Text(a)
            let y = Text(b)
            peer.extend(source, ["print(subtract(" + x + ", " + y + "))", "print(" + x + " - " + y + ")", "print(add(" + x + ", " + y + "))", "print(" + x + " + " + y + ")"])
            let difference = peer.bigText(peer.bigSubtract(peer.big(a), peer.big(b)))
            let sum = peer.bigText(peer.bigAdd(peer.big(a), peer.big(b)))
            peer.extend(expected, [difference, difference, sum, sum])
            if b != 0 {
                let result = peer.division(a, b)
                peer.extend(source, ["print(divide(" + x + ", " + y + "))", "print(" + x + " / " + y + ")"])
                peer.extend(expected, [Text(result.quotient), Text(result.quotient)])
                peer.extend(source, ["print(remainder(" + x + ", " + y + "))", "print(" + x + " % " + y + ")"])
                peer.extend(expected, [Text(result.remainder), Text(result.remainder)])
            }
            if peer.productFits(a, b) {
                peer.extend(source, ["print(multiply(" + x + ", " + y + "))", "print(" + x + " * " + y + ")"])
                let product = peer.bigText(peer.product(a, b))
                peer.extend(expected, [product, product])
            } else { overflowLeft.add(a); overflowRight.add(b) }
        }
    }
    let pairs = [[4923, 2], [1342177, 800], [65536, 65536]]
    for index in 0..3 {
        let a = Text(pairs[index][0])
        let b = Text(pairs[index][1])
        peer.extend(source, ["let a" + Text(index) + " = " + a, "let b" + Text(index) + " = " + b, "print(" + a + " * " + b + ")", "print(a" + Text(index) + " * b" + Text(index) + ")", "print(multiply(" + a + ", " + b + "))"])
        let product = peer.bigText(peer.product(pairs[index][0], pairs[index][1]))
        peer.extend(expected, [product, product, product])
    }
    peer.extend(source, ["function change(values: List<Integer>): Integer { values[0] = 1; return 1 }", "function changeTwo(values: List<Integer>): Integer { values[0] = 2; return 2 }",
        "let values = [0]", "print(change(values) - values[0])",
        "values[0] = 0", "print(values[0] - change(values))",
        "values[0] = 0", "print(change(values) + values[0])",
        "values[0] = 0", "print(values[0] + change(values))",
        "values[0] = 0", "print(change(values) % values[0])",
        "values[0] = 1", "print(values[0] % changeTwo(values))",
        "values[0] = 0", "print(change(values) * values[0])",
        "values[0] = 0", "print(values[0] * change(values))",
        "values[0] = 0", "print(change(values) / values[0])",
        "values[0] = 1", "print(values[0] / changeTwo(values))",
        "values[0] = 0", "print(values[0] / change(values))"])
    peer.extend(expected, ["0", "-1", "2", "1", "0", "1", "1", "0", "1", "0", "0"])
    for pair in [[101, 51], [101, -51], [-101, 51], [-101, -51]] {
        peer.extend(source, ["print(remainder(" + Text(pair[0]) + ", " + Text(pair[1]) + "))", "print(" + Text(pair[0]) + " % " + Text(pair[1]) + ")"])
        let value = "-50"
        if pair[0] > 0 { value = "50" }
        peer.extend(expected, [value, value])
    }
    peer.executes(c, peer.lines(source), peer.lines(expected))
    let overflow = ["function multiply(a: Integer, b: Integer): Integer { return a * b }", "let choice = processInfo.argument(0)"]
    let choices: List<Text> = []
    let rows: List<json.Value> = []
    for index in 0..overflowLeft.length {
        let a = Text(overflowLeft[index])
        let b = Text(overflowRight[index])
        rows.add(peer.jsonIntegers([overflowLeft[index], overflowRight[index]]))
        let kinds = ["literal", "parameter"]
        let expressions = [a + " * " + b, "multiply(" + a + ", " + b + ")"]
        for kind in 0..2 {
            let choice = Text(index) + "-" + kinds[kind]
            choices.add(choice)
            overflow.add("if choice == \"" + choice + "\" { print(" + expressions[kind] + ") }")
        }
    }
    overflow.add("print(\"ready\")")
    let base = peer.executesWith(c, peer.lines(overflow), "ready\n", 0, "", ["probe"])
    peer.control(c, "multiplication_overflow_pairs", peer.jsonArray(rows))
    for optimization in c.variants {
        for choice in choices {
            peer.observe(c, peer.run(c, [peer.executable(base, optimization), choice], "execute-multiplication-overflow", 10), 1, "", peer.OVERFLOW, choice + " at " + optimization)
        }
    }
}
function test_loop_exit_zero_is_not_used_as_divisor(c: peer.Case) {
    let total = 0
    let divisor = 50
    while divisor > 0 {
        let result = peer.division(20, divisor)
        total += result.quotient + result.remainder
        divisor -= 2
    }
    peer.executes(c, "function calculate(start: Integer): Integer {
let divisor = start
let total = 0
while divisor > 0 {
total = total + 20 / divisor + 20 % divisor
divisor = divisor - 2
}
return total
}
print(calculate(50))
print(calculate(0))
", Text(total) + "\n0\n")
}
function test_negative_remainder_remains_invalid_list_index(c: peer.Case) {
    for divisor in [999, 1000, 1001] {
        peer.executesStatus(c, "function access(value: Integer) { let values: List<Integer> = []; let index = 0; while index < 1000 { values.add(index); index = index + 1 }; print(values[value % " + Text(divisor) + "]) }\naccess(-1)\n", "", 1, "Minyar stopped: List position -1 is outside its length of 1000.\n")
    }
}
function test_repeated_old_value_concatenation_and_unaligned_views(c: peer.Case) {
    let value = ""
    for unused in 0..3 { value = "a" + value + "b" + value + "c" }
    let payload = peer.repeat("0123456789é🙂", 100)
    peer.executes(c, "let text = \"\"\nlet index = 0\nwhile index < 3 { text = \"a\" + text + \"b\" + text + \"c\"; index = index + 1 }\nprint(text)\n" + "let root = \"12345\" + " + peer.literal(payload) + "\n" + "let view = root.slice(5, root.length)\nroot = \"gone\"\n" + "print(view == " + peer.literal(payload) + ")\n", value + "\ntrue\n")
}
function test_lto_preserves_checked_arithmetic_and_list_aliases(c: peer.Case) {
    if !peer.extended() { peer.skip(c, "extended LTO lane"); return }
    let flags = peer.ltoFlags()
    let sources = ["function calculate(x: Integer): Integer { return (x + 13) - 7 }\nprint(calculate(9223372036854775797))\n", "function change(write: List<Integer>, read: List<Integer>): Integer {
write[0] = 42
return read[0]
}
let values = [1]
print(change(values, values))
"]
    let outputs = ["", "42\n"]
    let statuses = [1, 0]
    let errors = [peer.OVERFLOW, ""]
    for index in 0..2 {
        let compiled = peer.compiles(c, sources[index])
        let program = compiled.base + ".lto"
        let command = [c.compiler.clang, "-O2"]
        peer.extend(command, flags)
        peer.extend(command, ["-DMINYAR_SYSTEM_HEAP=1", "-Wno-override-module", compiled.llvm, c.suite.root + "/runtime/minyar_runtime.c", "-o", program, "-lm"])
        let linked = peer.run(c, command, "link-lto", 60)
        peer.expect(c, linked.status == 0, "LTO link failed\n" + linked.errorOutput)
        peer.observe(c, peer.run(c, [program], "execute-lto", 10), statuses[index], outputs[index], errors[index], "LTO execution")
    }
}
function test_mixed_width_boundary_views_survive_nonsequential_access(c: peer.Case) {
    let scalars = peer.codepoints([0, 0x7f, 0x80, 0x7ff, 0x800, 0xd7ff, 0xe000, 0xffff, 0x10000, 0x10ffff])
    let value = peer.repeat(scalars, 14) + "e" + peer.character(0x301) + "🙂"
    let characters = peer.scalars(value)
    let source = ["let text = " + peer.literal(value) + " + \"\"", "let parts: List<Text> = []"]
    let expected: List<Text> = []
    let indices = peer.range(0, characters.length)
    peer.shuffle(random.seeded("1346717010"), indices)
    for index in indices {
        source.add("print(text[" + Text(index) + "] == " + peer.literal(characters[index]) + "[0])")
        expected.add("true")
    }
    peer.extend(source, ["let index = 0", "while index < text.length {", "parts.add(text.slice(index, index + 1))", "index = index + 1", "}", "print(joinText(parts) == text)", "let view = text.slice(61, 132).slice(2, 68)", "text = \"released root binding\"", "print(view == " + peer.literal(scalarSlice(value, 63, 129)) + ")", "print(view.length)"])
    peer.extend(expected, ["true", "true", "66"])
    peer.executes(c, peer.lines(source), peer.lines(expected))
}
function test_self_join_keeps_old_alias_across_growth(c: peer.Case) {
    let value = "A" + peer.character(0) + "é🙂"
    let source = ["let text = " + peer.literal(value) + " + \"\""]
    let expected: List<Text> = []
    for index in 0..8 {
        peer.extend(source, ["let old" + Text(index) + " = text", "text = text + text", "print(old" + Text(index) + " == " + peer.literal(value) + ")", "print(text == " + peer.literal(value + value) + ")"])
        peer.extend(expected, ["true", "true"])
        value += value
    }
    peer.executes(c, peer.lines(source), peer.lines(expected))
}

