function previousSpaces(value: Text): List<Integer> {
    let characters = peer.scalars(value)
    let starts: List<Integer> = []
    for index in 0..characters.length {
        if characters[index] == " " && (index == 0 || characters[index - 1] != " ") { starts.add(index) }
    }
    let result: List<Integer> = []
    for seek in 0..characters.length {
        let best = 0
        for start in starts { if start < seek && start > best { best = start } }
        result.add(best)
    }
    return result
}
