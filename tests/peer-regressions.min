    let fragments = ["let $ = 1", "let $$ = 1", "let Σ$ = 1", "let $Σ = 1", "let" + nbsp + "x = 1", "let" + ideographic + "x = 1",
        "let ༀ = 1", "let 𑩐 = 1", "let 𐠈 = 1", "let ꙮ = 1", "let 𝛛 = 1", "let ₉ = 1", "let a¹b₍₄₂₎∇ = 1",
        "let 🌹 = 1", "let 🫎 = 1", "let 👷 = 1", "let 👷" + joiner + "♀ = 1", "let 🌵 = 1", "let 🌻 = 1", "let 🌷 = 1",
        "let n" + greekQuestion + " = 1", "let n꞉꞉v = 1", "let v＝［＝］（auto）｛return～x；｝（） = 1", "let " + wordJoiner + "x" + bom + "x" + joiner + " = 1",
        "let ∣foo = 1", "let foo" + zeroWidth + "bar = 1", "let a" + nbsp + "b = 1", "let a¹b = 1", "let a" + greekQuestion + "b = 1", "let aΣb = 1",
        "let aༀb = 1", "let a" + zeroWidth + "b = 1", "let a" + joiner + "b = 1", "let a" + wordJoiner + "b = 1", "let a₂b = 1",
        "let a₄b = 1", "let a₉b = 1", "let a₍b = 1", "let a₎b = 1", "let a∇b = 1", "let a∣b = 1", "let a♀b = 1",
        "let a" + ideographic + "b = 1", "let aꙮb = 1", "let a꞉b = 1", "let a" + bom + "b = 1", "let a（b = 1", "let a）b = 1",
        "let a；b = 1", "let a＝b = 1", "let a［b = 1", "let a］b = 1", "let a｛b = 1", "let a｝b = 1", "let a～b = 1",
        "let a𐠈b = 1", "let a𑩐b = 1", "let a𝛛b = 1", "let a🌵b = 1", "let a🌷b = 1", "let a🌹b = 1", "let a🌻b = 1",
        "let a👷b = 1", "let a🫎b = 1"]
    peer.equalInteger(c, fragments.length, 64, "confusable fragment count")
    for fragment in fragments { peer.rejects(c, fragment + "\n", "Minyar stopped:") }
    peer.rejects(c, "let foobar = 1\nprint(foo" + zeroWidth + "bar)\n", "names must use ASCII")
}
