function test_large_unicode_nul_file_roundtrip(c: peer.Case) {
    let value = peer.repeat("abé🙂" + peer.character(0) + "\n", 11000) + "last🙂"
    let original = peer.writeFile(c, "large-input.txt", value)
    let output = peer.path(c, "large-output.txt")
    peer.executesFull(c, "let text = io.readTextFile(processInfo.argument(0))\nprint(text.length)\nio.writeTextFile(processInfo.argument(1), text)\nprint(io.readTextFile(processInfo.argument(1)) == text)\n", Text(value.length) + "\ntrue\n", 0, "", [original, output], [peer.Output { path: output; contents: Bytes(value) }], c.variants)
}
function test_unicode_composition_vectors_indices_slices_and_files(c: peer.Case) {
    let vectors = [[27721, 23383, 47, 28450, 23383], [0, 97, 98, 99, 1], [0, 127, 128, 2047, 2048, 65535, 65536, 1114111], [26085, 26412, 35486, 97, 45, 52, 0, 233, 243], [0x23CB7, 0x2070E, 0x20C53, 0x2107B, 0x20D7C, 97, 98, 0x20EA2], [0x28CCA, 0x29D98, 0x269FA, 0x28CD2, 0x2512B, 0x244D3, 0x10FFFF], [0xC7, 0x2202, 0xE9, 0x192, 0x67], [0x8987], [0x24B62]]
    for number in 0..vectors.length {
        let points = vectors[number]
        let value = peer.codepoints(points)
        let original = peer.writeFile(c, "composition" + Text(number) + "-input.txt", value)
        let output = peer.path(c, "composition" + Text(number) + "-output.txt")
        let source = ["let text = io.readTextFile(processInfo.argument(0))", "print(text.length)", "print(text.byteLength)", "print(text == " + peer.literal(value) + ")", "let parts: List<Text> = []"]
        let expected = [Text(points.length), Text(Bytes(value).length), "true"]
        for index in 0..points.length {
            source.add("print(text[" + Text(index) + "])")
            source.add("parts.add(Text(text[" + Text(index) + "]))")
            expected.add(peer.character(points[index]))
        }
        for begin in 0..(points.length + 1) {
            for end in begin..(points.length + 1) {
                source.add("print(text.slice(" + Text(begin) + ", " + Text(end) + "))")
                let slice: List<Integer> = []
                for index in begin..end { slice.add(points[index]) }
                expected.add(peer.codepoints(slice))
            }
        }
        peer.extend(source, ["let joined = joinText(parts)", "text = \"released\"", "print(joined)", "io.writeTextFile(processInfo.argument(1), joined)", "print(io.readTextFile(processInfo.argument(1)))"])
        expected.add(value); expected.add(value)
        peer.executesFull(c, peer.lines(source), peer.lines(expected), 0, "", [original, output], [peer.Output { path: output; contents: Bytes(value) }], c.variants)
    }
}
function test_text_equality_compares_bytes_after_nul(c: peer.Case) {
    let nul = peer.character(0)
    let left = "abc" + nul + "def"
    let right = "abc" + nul + "xyz"
    let paths = [peer.writeFile(c, "nul-left.txt", left), peer.writeFile(c, "nul-right.txt", right)]
    let source = ["function compare(left: Text, right: Text) {", "print(left == right)", "print(left != right)", "}",
        "compare(" + peer.literal(left) + ", " + peer.literal(right) + ")",
        "let left = io.readTextFile(processInfo.argument(0))", "let right = io.readTextFile(processInfo.argument(1))",
        "compare(left, right)", "compare(right, left)",
        "compare(left, " + peer.literal(left) + ")",
        "compare(right, " + peer.literal(right) + ")",
        "compare(left.slice(3, 7), right.slice(3, 7))",
        "compare(joinText([left.slice(0, 4), \"def\"]), left)",
        "compare(joinText([left.slice(0, 4), \"xyz\"]), left)",
        "compare(\"a\", " + peer.literal("a" + nul) + ")",
        "compare(" + peer.literal("a" + nul) + ", \"a\")",
        "compare(left.slice(0, 1), left.slice(0, 1) + " + peer.literal(nul) + ")",
        "compare(joinText([\"a\", " + peer.literal(nul) + "]), \"a\")"]
    peer.executesWith(c, peer.lines(source), peer.repeat("false\ntrue\n", 3) + peer.repeat("true\nfalse\n", 2) + "false\ntrue\ntrue\nfalse\nfalse\ntrue\n" + peer.repeat("false\ntrue\n", 4), 0, "", paths)
}
function test_identical_mutable_constructor_calls_remain_independent(c: peer.Case) {
    peer.executes(c, "function make(): List<Integer> { return [0] }
function makeEmpty(): List<Integer> { return [] }
let first = make()
let second = make()
first[0] = 10
print(second[0])
second[0] = 20
print(first[0])
let third = make()
print(third[0])
third[0] = 30
let fourth = make()
print(fourth[0])
print(first[0])
print(second[0])
print(third[0])
let emptyFirst = makeEmpty()
let emptySecond = makeEmpty()
emptyFirst.add(10)
print(emptySecond.length)
emptySecond.add(20)
print(emptyFirst.length)
print(emptySecond.length)
print(emptyFirst[0])
print(emptySecond[0])
emptyFirst.add(30)
print(emptySecond.length)
", "0\n10\n0\n0\n10\n20\n30\n0\n1\n1\n10\n20\n1\n")
}
function test_long_record_fields_and_late_diagnostic_line(c: peer.Case) {
    let prefix = "field" + peer.repeat("x", 300)
    peer.executes(c, "record Wide { " + prefix + "0: Integer; " + prefix + "1: Integer }\nfunction read(value: Wide): Integer { return value." + prefix + "0 * 100 + value." + prefix + "1 }\nprint(read(Wide { " + prefix + "0: 12; " + prefix + "1: 34 }))\n", "1234\n")
    peer.rejects(c, peer.repeat("\n", 300) + "print(missingName)\n", "line 301, column 7:")
}
function leafExpression(identity: Integer, value: Boolean): Text { return "mark(" + peer.boolean(value) + ", " + Text(identity) + ", trace)" }
function leafValue(identity: Integer, value: Boolean, trace: List<Integer>): Boolean { trace.add(identity); return value }
function nestedExpression(operator: Text, negate: Boolean, firstIdentity: Integer, firstValue: Boolean, secondIdentity: Integer, secondValue: Boolean): Text {
    let body = "(" + leafExpression(firstIdentity, firstValue) + " " + operator + " " + leafExpression(secondIdentity, secondValue) + ")"
    if negate { return "!" + body }
    return body
}
function nestedValue(operator: Text, negate: Boolean, firstIdentity: Integer, firstValue: Boolean, secondIdentity: Integer, secondValue: Boolean, trace: List<Integer>): Boolean {
    let first = leafValue(firstIdentity, firstValue, trace)
    let result = first
    if operator == "&&" { if first { result = leafValue(secondIdentity, secondValue, trace) } }
    else { if !first { result = leafValue(secondIdentity, secondValue, trace) } }
    if negate { return !result }
    return result
}
function test_boolean_tree_values_and_short_circuit_trace(c: peer.Case) {
    let source = ["function mark(value: Boolean, identity: Integer, trace: List<Integer>): Boolean { trace.add(identity); return value }", "let trace: List<Integer> = []"]
    let expected: List<Text> = []
    for bits in 0..8 {
        let values = [(bits & 1) != 0, (bits & 2) != 0, (bits & 4) != 0]
        for outer in ["&&", "||"] {
            for inner in ["&&", "||"] {
                for negations in 0..4 {
                    let innerNegate = (negations & 1) != 0
                    let outerNegate = (negations & 2) != 0
                    for shape in 0..2 {
                        let trace: List<Integer> = []
                        let expression = ""
                        let result = false
                        if shape == 0 {
                            let nested = nestedExpression(inner, innerNegate, 1, values[0], 2, values[1])
                            expression = "(" + nested + " " + outer + " " + leafExpression(3, values[2]) + ")"
                            let first = nestedValue(inner, innerNegate, 1, values[0], 2, values[1], trace)
                            result = first
                            if outer == "&&" { if first { result = leafValue(3, values[2], trace) } }
                            else { if !first { result = leafValue(3, values[2], trace) } }
                        } else {
                            let nested = nestedExpression(inner, innerNegate, 2, values[1], 3, values[2])
                            expression = "(" + leafExpression(1, values[0]) + " " + outer + " " + nested + ")"
                            let first = leafValue(1, values[0], trace)
                            result = first
                            if outer == "&&" { if first { result = nestedValue(inner, innerNegate, 2, values[1], 3, values[2], trace) } }
                            else { if !first { result = nestedValue(inner, innerNegate, 2, values[1], 3, values[2], trace) } }
                        }
                        if outerNegate { expression = "!" + expression; result = !result }
                        source.add("trace = []")
                        source.add("print(" + expression + ")")
                        source.add("print(trace.length)")
                        for index in 0..trace.length { source.add("print(trace[" + Text(index) + "])") }
                        expected.add(peer.boolean(result))
                        expected.add(Text(trace.length))
                        for identity in trace { expected.add(Text(identity)) }
                    }
                }
            }
        }
    }
    peer.executes(c, peer.lines(source), peer.lines(expected))
    for invalid in ["true * false", "1 && 2"] { peer.rejects(c, "print(" + invalid + ")\n", "Minyar stopped:") }
}
function test_character_integer_arithmetic_never_coerces(c: peer.Case) {
    let parameters = ["Integer", "Character"]
    let arguments = ["\"x\"[0]", "120"]
    for index in 0..2 {
        peer.rejects(c, "function accept(value: " + parameters[index] + ") { print(value) }\naccept(" + arguments[index] + ")\n", "an argument passed to accept has the wrong type")
    }
    for operator in ["+", "-", "*", "/"] {
        peer.rejects(c, "print(\"x\"[0] " + operator + " 1)\n", "Minyar stopped:")
        peer.rejects(c, "print(1 " + operator + " \"x\"[0])\n", "Minyar stopped:")
        peer.rejects(c, "function mixed(character: Character, integer: Integer) { print(character " + operator + " integer) }\n", "Minyar stopped:")
        peer.rejects(c, "function mixed(character: Character, integer: Integer) { print(integer " + operator + " character) }\n", "Minyar stopped:")
    }
}
function test_record_operators_initializers_and_boolean_indexing_reject(c: peer.Case) {
    let declaration = "record Box { field: List<Integer> }\nlet left = Box { field: [1] }\nlet right = Box { field: [2] }\n"
    for operator in ["+", "-", "*", "/", "%", "==", "!=", "<", "<=", ">", ">="] {
        let diagnostic = "needs Integer or Float operands"
        if operator == "==" || operator == "!=" { diagnostic = "is not Equatable" }
        else if operator == "<" || operator == "<=" || operator == ">" || operator == ">=" { diagnostic = "is not Ordered" }
        peer.rejects(c, declaration + "print(left " + operator + " right)\n", diagnostic)
    }
    peer.rejects(c, "record Box { field: Integer }\nlet value = Box { field: 10; field: 20 }\n", "record field 'field' was provided twice")
    peer.rejects(c, "let bad = true\nprint(bad[0])\n", "indexing needs Text, a List, or Bytes")
    peer.rejects(c, "let bad = true\nbad[0] = bad[0]\n", "indexed assignment needs a List")
}
function test_file_paths_reject_embedded_nul_without_touching_prefix(c: peer.Case) {
    let contents = Bytes("original contents\n")
    let file = peer.writeBytes(c, "existing-prefix.txt", contents)
    for operation in ["print(io.readTextFile(path))", "io.writeTextFile(path, \"overwritten\")"] {
        let source = "let path = processInfo.argument(0) + " + peer.literal(peer.character(0) + "suffix") + "\n" + operation + "\n"
        peer.executesWith(c, source, "", 1, "Minyar stopped: a file path cannot contain a zero byte.\n", [file])
        peer.expect(c, peer.bytesEqual(io.readBytesFile(file), contents), "embedded NUL path touched its prefix")
    }
}
function test_malformed_utf8_file_corpus(c: peer.Case) {
    let corpus = [peer.bytes([0xe3]), peer.concat(Bytes("abc"), peer.concat(peer.bytes([0xe3]), Bytes("def"))), peer.bytes([0xf4, 0x9f, 0xbf]), peer.bytes([0xf4, 0x9f, 0xbf, 0xbf]),
        peer.concat(Bytes("ab"), peer.bytes([0xff])), peer.bytes([0xf4, 0x90, 0x80, 0x80]), peer.concat(Bytes("in"), peer.concat(peer.bytes([0x80]), Bytes("valid"))), peer.concat(peer.bytes([0xbf]), Bytes("invalid")),
        peer.concat(Bytes("αλφ"), peer.concat(peer.bytes([0xbf]), Bytes("α"))),
        peer.bytes([0xed, 0xa0, 0x80]), peer.bytes([0xed, 0xbf, 0xbf]), peer.bytes([0xc0, 0x80]), peer.bytes([0xc1, 0xbf]),
        peer.bytes([0xe0, 0x9f, 0xbf]), peer.bytes([0xf0, 0x8f, 0xbf, 0xbf]), peer.bytes([0x80]), peer.bytes([0xbf]), peer.bytes([0xfe]), peer.bytes([0xff]),
        peer.bytes([0xff, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80])]
    for invalid in [peer.bytes([0x80]), peer.bytes([0xbf])] {
        corpus.add(peer.concat(Bytes("汉字"), invalid))
        corpus.add(peer.concat(invalid, Bytes("hello")))
        corpus.add(peer.concat(Bytes("hel"), peer.concat(invalid, Bytes("lo"))))
    }
    let paths: List<Text> = []
    for index in 0..corpus.length { paths.add(peer.writeBytes(c, "invalid-" + Text(index) + ".txt", corpus[index])) }
    let error = "Minyar stopped: Text contained invalid UTF-8.\n"
    let base = peer.executesWith(c, "let raw = io.readBytesFile(processInfo.argument(0))\nprint(raw.length)\nlet text = Text(raw)\nprint(text.length)\n", Text(corpus[0].length) + "\n", 1, error, [paths[0]])
    for optimization in c.variants {
        for index in 1..corpus.length {
            peer.observe(c, peer.run(c, [peer.executable(base, optimization), paths[index]], "execute-invalid-utf8", 10), 1, Text(corpus[index].length) + "\n", error, paths[index] + " at " + optimization)
        }
    }
}
record Vector { path: Text; status: Integer; stdout: Text; stderr: Text }
function test_utf8_lead_continuation_and_endpoint_vectors(c: peer.Case) {
    let fixture = c.suite.root + "/tests/peer-utf8-vectors.json"
    peer.input(c, fixture)
    let data = peer.load(fixture)
    peer.equalInteger(c, peer.field(data, "schema_version"), 1, "UTF-8 vector schema")
    let vectors = json.member(data, "vectors").items
    peer.equalInteger(c, vectors.length, 83, "UTF-8 vector count")
    let cases: List<Vector> = []
    for index in 0..vectors.length {
        let vector = vectors[index]
        let raw = peer.fromHex(peer.textField(vector, "hex"))
        let file = peer.writeBytes(c, "utf8-vector-" + Text(index) + ".txt", raw)
        if json.member(vector, "valid").truth {
            let points: List<Integer> = []
            for point in json.member(vector, "codepoints").items { points.add(peer.number(point)) }
            peer.expect(c, peer.bytesEqual(Bytes(peer.codepoints(points)), raw), "UTF-8 vector encoding " + Text(index))
            let expected = Text(raw.length) + "\n" + Text(points.length) + "\n" + Text(raw.length) + "\n" + Text(raw) + "\n"
            for point in points { expected += peer.character(point) + "\n" }
            cases.add(Vector { path: file; status: 0; stdout: expected; stderr: "" })
        } else {
            peer.expect(c, !peer.validUTF8(raw), "invalid UTF-8 vector decoded " + Text(index))
            cases.add(Vector { path: file; status: 1; stdout: Text(raw.length) + "\n"; stderr: "Minyar stopped: Text contained invalid UTF-8.\n" })
        }
    }
    let source = "let raw = io.readBytesFile(processInfo.argument(0))
print(raw.length)
let text = Text(raw)
print(text.length)
print(text.byteLength)
print(text)
let index = 0
while index < text.length { print(text[index]); index = index + 1 }
"
    let base = peer.executesWith(c, source, cases[0].stdout, cases[0].status, cases[0].stderr, [cases[0].path])
    for optimization in c.variants {
        for index in 1..cases.length {
            let item = cases[index]
            peer.observe(c, peer.run(c, [peer.executable(base, optimization), item.path], "execute-utf8-vector", 10), item.status, item.stdout, item.stderr, item.path + " at " + optimization)
        }
    }
}
function scalarSlice(value: Text, start: Integer, end: Integer): Text {
    let parts = peer.scalars(value)
    let pieces: List<Text> = []
    for index in start..end { pieces.add(parts[index]) }
    return joinText(pieces)
}
function test_unicode_width_compositions_and_cached_append_queries(c: peer.Case) {
    let fixture = c.suite.root + "/tests/peer-unicode-compositions.json"
    peer.input(c, fixture)
    let data = peer.load(fixture)
    peer.equalInteger(c, peer.field(data, "schema_version"), 1, "composition schema")
    let cases = json.member(data, "cases").items
    peer.equalInteger(c, cases.length, 167, "composition case count")
    let source = ["function compareCompositions(left: Text, right: Text) {", "print(left == right)", "print(right == left)", "print(left != right)", "print(right != left)", "}"]
    let expected: List<Text> = []
    let scalarsSeen: List<Integer> = []
    for index in 0..cases.length {
        let item = cases[index]
        let kind = peer.textField(item, "kind")
        if kind == "incremental_append" {
            let scalar = peer.field(item, "scalar")
            if !peer.hasInteger(scalarsSeen, scalar) { scalarsSeen.add(scalar) }
            continue
        }
        source.add("function case" + Text(index) + "() {")
        if kind == "concat" {
            let left = peer.textField(item, "left")
            let right = peer.textField(item, "right")
            let value = peer.textField(item, "expected")
            peer.expect(c, value == left + right, "composition concat " + Text(index))
            peer.extend(source, ["let left = " + peer.literal(left), "let right = " + peer.literal(right), "let alias = left", "left = left + right", "right = \"released\"", "print(left)", "print(left.length)", "print(left.byteLength)", "print(alias)"])
            peer.extend(expected, [value, Text(peer.scalars(value).length), Text(Bytes(value).length), left])
        } else if kind == "slice" {
            let text = peer.textField(item, "text")
            let start = peer.field(item, "start")
            let end = peer.field(item, "end")
            let value = peer.textField(item, "expected")
            peer.expect(c, value == scalarSlice(text, start, end), "composition slice " + Text(index))
            peer.extend(source, ["let root = " + peer.literal(text), "let view = root.slice(" + Text(start) + ", " + Text(end) + ")", "root = \"released\"", "print(view)", "print(view.length)", "print(view.byteLength)"])
            peer.extend(expected, [value, Text(peer.scalars(value).length), Text(Bytes(value).length)])
        } else {
            peer.expect(c, kind == "equality", "unknown composition kind " + kind)
            let left = peer.textField(item, "left")
            let right = peer.textField(item, "right")
            let equal = json.member(item, "expected").truth
            peer.expect(c, equal == peer.bytesEqual(Bytes(left), Bytes(right)), "composition equality " + Text(index))
            let leftPath = peer.writeFile(c, "composition-left-" + Text(index) + ".txt", left)
            let rightPath = peer.writeFile(c, "composition-right-" + Text(index) + ".txt", right)
            peer.extend(source, ["let left = " + peer.literal(left), "let right = " + peer.literal(right), "print(left == right)", "print(right == left)", "print(left != right)", "print(right != left)", "compareCompositions(left, right)", "compareCompositions(io.readTextFile(" + peer.literal(leftPath) + "), io.readTextFile(" + peer.literal(rightPath) + "))"])
            for unused in 0..3 { peer.extend(expected, [peer.boolean(equal), peer.boolean(equal), peer.boolean(!equal), peer.boolean(!equal)]) }
        }
        source.add("}")
        source.add("case" + Text(index) + "()")
    }
    for scalar in scalarsSeen {
        let counts: List<Integer> = []
        source.add("function append" + Text(scalar) + "() {")
        source.add("let text = \"\"")
        for item in cases {
            if peer.textField(item, "kind") != "incremental_append" || peer.field(item, "scalar") != scalar { continue }
            let total = peer.field(item, "count")
            counts.add(total)
            let value = peer.textField(item, "expected")
            peer.expect(c, value == peer.repeat(peer.character(scalar), total), "composition append " + Text(scalar))
            source.add("text = text + " + peer.literal(peer.character(scalar)))
            for unused in 0..2 {
                peer.extend(source, ["print(text)", "print(text.length)", "print(text.byteLength)"])
                peer.extend(expected, [value, Text(total), Text(Bytes(value).length)])
                for index in 0..total { source.add("print(text[" + Text(index) + "])") }
                peer.extend(expected, peer.scalars(value))
            }
        }
        peer.expect(c, peer.joined(peer.texts(counts), ",") == "1,2,3,4,5", "composition append counts " + Text(scalar))
        source.add("}")
        source.add("append" + Text(scalar) + "()")
    }
    peer.executes(c, peer.lines(source), peer.lines(expected))
}
function test_signed_comparisons_preserve_boolean_values(c: peer.Case) {
    let values = [peer.MINIMUM, -9223372036854775807, -4611686018427387904, -123, -1, 0, 1, 123, 4294967295, 4611686018427387903, 9223372036854775806, peer.MAXIMUM]
    let symbols = ["==", "!=", "<", "<=", ">", ">="]
    let source = ["function identity(value: Boolean): Boolean { return value }"]
    let expected: List<Text> = []
    for index in 0..symbols.length {
        let symbol = symbols[index]
        source.add("function compare" + Text(index) + "(a: Integer, b: Integer): Boolean { return a " + symbol + " b }")
        for a in values {
            for b in values {
                source.add("print(identity(" + Text(a) + " " + symbol + " " + Text(b) + "))")
                source.add("print(identity(compare" + Text(index) + "(" + Text(a) + ", " + Text(b) + ")))")
                let order = peer.bigCompare(peer.big(a), peer.big(b))
                let result = order == 0
                if symbol == "!=" { result = order != 0 }
                if symbol == "<" { result = order < 0 }
                if symbol == "<=" { result = order <= 0 }
                if symbol == ">" { result = order > 0 }
                if symbol == ">=" { result = order >= 0 }
                expected.add(peer.boolean(result)); expected.add(peer.boolean(result))
            }
        }
    }
    peer.extend(source, ["function atMost(a: Integer, b: Integer): Boolean { return a < b || a == b }", "function greater(a: Integer, b: Integer): Boolean { return a > b && a != b }", "function negatedRange(a: Integer, b: Integer): Boolean { return !(a < b || a == b) }"])
    for a in values {
        for b in values {
            source.add("print(atMost(" + Text(a) + ", " + Text(b) + "))")
            source.add("print(greater(" + Text(a) + ", " + Text(b) + "))")
            source.add("print(negatedRange(" + Text(a) + ", " + Text(b) + "))")
            let order = peer.bigCompare(peer.big(a), peer.big(b))
            peer.extend(expected, [peer.boolean(order <= 0), peer.boolean(order > 0), peer.boolean(order > 0)])
        }
    }
    peer.executes(c, peer.lines(source), peer.lines(expected))
}
function test_signed64_arithmetic_runtime_matrix(c: peer.Case) {
    let values = [0, 1, 2, -1, -2, peer.MAXIMUM, peer.MAXIMUM - 1, peer.MINIMUM, peer.MINIMUM + 1]
    let source = ["function operand(value: Text): Integer {"]
    for value in values { source.add("if value == \"" + Text(value) + "\" { return " + Text(value) + " }") }
    peer.extend(source, ["fail(\"unknown matrix operand\")", "}", "let operation = processInfo.argument(0)", "let a = operand(processInfo.argument(1))", "let b = operand(processInfo.argument(2))"])
    for symbol in ["+", "-", "*", "/", "%"] { source.add("if operation == \"" + symbol + "\" { print(a " + symbol + " b) }") }
    source.add("if operation == \"negate\" { print(-a) }")
    let base = peer.executesWith(c, peer.lines(source), "0\n", 0, "", ["+", "0", "0"])
    let arguments: List<List<Text>> = []
    let outputs: List<Text> = []
    let errors: List<Text> = []
    for symbol in ["+", "-", "*", "/", "%"] {
        for a in values {
            for b in values {
                let error = ""
                let result = peer.big(0)
                if (symbol == "/" || symbol == "%") && b == 0 { error = peer.ZERO }
                else if (symbol == "/" || symbol == "%") && a == peer.MINIMUM && b == -1 { error = peer.DIVISION }
                else if symbol == "+" { result = peer.bigAdd(peer.big(a), peer.big(b)) }
                else if symbol == "-" { result = peer.bigSubtract(peer.big(a), peer.big(b)) }
                else if symbol == "*" { result = peer.product(a, b) }
                else {
                    let division = peer.division(a, b)
                    result = peer.big(division.quotient)
                    if symbol == "%" { result = peer.big(division.remainder) }
                }
                if error == "" && !peer.bigFits(result) { error = peer.OVERFLOW }
                arguments.add([symbol, Text(a), Text(b)])
                if error == "" { outputs.add(peer.bigText(result) + "\n") } else { outputs.add("") }
                errors.add(error)
            }
        }
    }
    for a in values {
        let error = ""
        if a == peer.MINIMUM { error = peer.OVERFLOW }
        arguments.add(["negate", Text(a), "0"])
        if error == "" { outputs.add(Text(-a) + "\n") } else { outputs.add("") }
        errors.add(error)
    }
    let oracles: List<json.Value> = []
    for index in 0..arguments.length {
        let row = peer.jsonObject()
        peer.put(row, "arguments", peer.jsonTexts(arguments[index]))
        peer.put(row, "stdout", peer.jsonText(outputs[index]))
        peer.put(row, "stderr", peer.jsonText(errors[index]))
        let status = 0
        if errors[index] != "" { status = 1 }
        peer.put(row, "status", peer.jsonInteger(status))
        oracles.add(row)
    }
    peer.control(c, "integer_matrix_oracles", peer.jsonArray(oracles))
    let environment = peer.withEnvironment(c.environment, "MSYS2_ARG_CONV_EXCL", "*")
    for optimization in c.variants {
        for index in 0..arguments.length {
            let command = [peer.executable(base, optimization)]
            for item in arguments[index] { command.add(item) }
            let status = 0
            if errors[index] != "" { status = 1 }
            peer.observe(c, peer.launch(c, command, "execute-integer-matrix", 10, environment, "", ""), status, outputs[index], errors[index], peer.joined(arguments[index], " ") + " at " + optimization)
        }
    }
}
function test_ascii_identifier_policy_rejects_confusables(c: peer.Case) {
