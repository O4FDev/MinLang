function test_malformed_radix_like_literals_do_not_accept_valid_prefix(c: peer.Case) {
    for value in ["0x", "0X", "0xG", "0b2", "00b0", "0b", "0o8", "00o0", "0o", "123name"] { peer.rejects(c, "print(" + value + ")\n", "Minyar stopped:") }
    for value in 70..78 { peer.rejects(c, "print(0" + Text(value) + ")\n", "decimal Integer literals cannot have a leading zero") }
    let source: List<Text> = []
    let expected: List<Text> = []
    for value in 70..78 { source.add("print(0o" + peer.octal(value) + ")"); expected.add(Text(value) + "\n") }
    peer.executes(c, peer.joined(source, "\n"), joinText(expected))
}
function test_invalid_source_bytes_are_not_hidden_by_comments_or_eof(c: peer.Case) {
    let invalid = [peer.bytes([239]), peer.bytes([239, 187]), peer.bytes([128]), peer.bytes([192, 175]), peer.bytes([237, 160, 128]), peer.bytes([244, 144, 128, 128])]
    let prefixes = [Bytes(""), Bytes("// "), Bytes("/* ")]
    let suffixes = [Bytes(""), Bytes("\nprint(42)\n"), Bytes(" */\nprint(42)\n")]
    let programs: List<Bytes> = []
    for value in invalid {
        for index in 0..3 { programs.add(peer.concat(peer.concat(prefixes[index], value), suffixes[index])) }
    }
    programs.add(peer.concat(peer.concat(Bytes("print(42)"), peer.bytes([0])), Bytes("print(99)\n")))
    programs.add(peer.concat(peer.concat(Bytes("print(42)"), peer.bytes([26])), Bytes("print(99)\n")))
    for index in 0..programs.length {
        let source = peer.writeBytes(c, "bytes" + Text(index) + ".min", programs[index])
        let llvm = peer.path(c, "bytes" + Text(index) + ".ll")
        let result = peer.run(c, [c.compiler.executable, source, llvm, "--library", "library"], "compile-reject", 10)
        peer.expect(c, result.status == 1, "invalid source bytes status " + Text(result.status) + "\n" + result.errorOutput)
        peer.expect(c, peer.validCompilerDiagnostics(result.errorOutput), "invalid source bytes diagnostic")
        peer.expect(c, result.output == "", "invalid source bytes wrote standard output")
        peer.expect(c, files.pathSize(llvm) < 0, "invalid source bytes emitted LLVM")
    }
}
function test_algebraic_simplification_preserves_inner_overflow(c: peer.Case) {
    let expressions = ["0 * (x + 1)", "(x + 1) * 0", "x * 2 * 0", "(x * 2) * 0", "(x + 1) - x", "(x * 100) / 10"]
    let values = ["9223372036854775807", "9223372036854775807", "9223372036854775807", "9223372036854775807", "9223372036854775807", "92233720368547759"]
    for index in 0..6 {
        peer.executesStatus(c, "function calculate(x: Integer): Integer { return " + expressions[index] + " }\nprint(\"before\")\nprint(calculate(" + values[index] + "))\n", "before\n", 1, peer.OVERFLOW)
    }
    for expression in ["9223372036854775807 * 2 * 0", "(9223372036854775807 * 2) * 0"] { peer.executesStatus(c, "print(" + expression + ")\n", "", 1, peer.OVERFLOW) }
    peer.executes(c, "function safe(x: Integer): Integer { return x * (2 * 0) }\nprint(safe(9223372036854775807))\nprint(9223372036854775807 * (2 * 0))\n", "0\n0\n")
    peer.executesStatus(c, "function greater(x: Integer): Boolean { return x + 1 > x }\nprint(greater(9223372036854775807))\n", "", 1, peer.OVERFLOW)
    peer.executes(c, "function greater(x: Integer): Boolean { return x + 1 > x }\nprint(greater(9223372036854775806))\n", "true\n")
    peer.executesStatus(c, "function count(start: Integer): Integer {
let index = start
let count = 0
while index <= start + 4 { count = count + 1; index = index + 2 }
return count
}
print(count(9223372036854775804))
", "", 1, peer.OVERFLOW)
}
record Pair { left: Integer; right: Integer }
function pairBefore(a: Pair, b: Pair): Boolean { return a.left < b.left || (a.left == b.left && a.right < b.right) }
function addPair(pairs: List<Pair>, left: Integer, right: Integer) {
    for pair in pairs { if pair.left == left && pair.right == right { return } }
    pairs.add(Pair { left: left; right: right })
}
function sortedPairs(pairs: List<Pair>): List<Pair> {
    let result: List<Pair> = []
    for pair in pairs {
        result.add(pair)
        let index = result.length - 1
        while index > 0 && pairBefore(result[index], result[index - 1]) {
            let previous = result[index - 1]
            result[index - 1] = result[index]
            result[index] = previous
            index -= 1
        }
    }
    return result
}
function test_signed_division_remainder_and_operand_placement_grid(c: peer.Case) {
    let pairs: List<Pair> = []
    for a in -6..7 { for b in -6..7 { if b != 0 { addPair(pairs, a, b) } } }
    let boundaries = [peer.MINIMUM, -9223372036854775807, -2, -1, 0, 1, 2, 9223372036854775806, peer.MAXIMUM]
    let lua = [-16, -15, -3, -2, -1, 0, 1, 2, 3, 15]
    for a in lua { for b in lua { if b != 0 { addPair(pairs, a, b) } } }
    for a in boundaries { for b in boundaries { if b != 0 && !(a == peer.MINIMUM && b == -1) { addPair(pairs, a, b) } } }
    let source = ["function divide(a: Integer, b: Integer): Integer { return a / b }", "function remainder(a: Integer, b: Integer): Integer { return a % b }"]
    let expected: List<Text> = []
    let ordered = sortedPairs(pairs)
    for index in 0..ordered.length {
        let a = ordered[index].left
        let b = ordered[index].right
        let result = peer.division(a, b)
        let name = Text(index)
        source.add("let a" + name + " = " + Text(a))
        source.add("let b" + name + " = " + Text(b))
        let lefts = [Text(a), "a" + name, Text(a), "a" + name]
        let rights = [Text(b), Text(b), "b" + name, "b" + name]
        for placement in 0..4 {
            source.add("print(" + lefts[placement] + " / " + rights[placement] + ")")
            source.add("print(" + lefts[placement] + " % " + rights[placement] + ")")
            expected.add(Text(result.quotient)); expected.add(Text(result.remainder))
        }
        source.add("print(divide(a" + name + ", b" + name + "))")
        source.add("print(remainder(a" + name + ", b" + name + "))")
        expected.add(Text(result.quotient)); expected.add(Text(result.remainder))
    }
    peer.executes(c, peer.lines(source), peer.lines(expected))
}
function test_negation_literal_and_parameter_paths(c: peer.Case) {
    peer.executes(c, "print(-2 == 0 - 2)\n", "true\n")
    peer.executes(c, "function negate(value: Integer): Integer { return -value }\nprint(negate(2305843009213693697))\nprint(-(2305843009213693697))\nprint(negate(2305843009213693697) != -2305843009213693696)\n", "-2305843009213693697\n-2305843009213693697\ntrue\n")
    for operator in ["/", "%"] {
        for expression in ["-9223372036854775808 " + operator + " -1", "calculate(-9223372036854775808, -1)"] {
            peer.executesStatus(c, "function calculate(a: Integer, b: Integer): Integer { return a " + operator + " b }\nprint(" + expression + ")\n", "", 1, peer.DIVISION)
        }
    }
    peer.executes(c, "function negate(value: Integer): Integer { return -value }\nprint(-0)\nprint(--2)\nprint(negate(0))\nprint(negate(negate(2)))\nprint(negate(-9223372036854775807))\n", "0\n2\n0\n2\n9223372036854775807\n")
    peer.executesStatus(c, "print(-(-9223372036854775808))\n", "", 1, peer.OVERFLOW)
    for expression in ["0 * (1 / 0)", "0 * (1 % 0)"] { peer.executesStatus(c, "print(" + expression + ")\n", "", 1, peer.ZERO) }
}
