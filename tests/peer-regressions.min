    let device = peer.runChecked(c, ["/usr/bin/stat", "-L", "-c", "%F %t %T", "/dev/full"], "device-stat", 10)
    peer.equal(c, device.output, "character special file 1 7\n", "/dev/full device identity")
    for length in [1, 65536] {
        let source = "let text = \"x\"\nwhile text.byteLength < " + Text(length) + " { text = text + text }\nprint(\"before\")\nio.writeTextFile(\"/dev/full\", text)\nprint(\"unexpected success\")\n"
        peer.executesStatus(c, source, "before\n", 1, "Minyar stopped: a requested text file could not be written.\n")
    }
}
