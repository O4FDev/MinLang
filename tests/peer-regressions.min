function test_power_of_two_neighbor_cancellation(c: peer.Case) {
    let start = 2
    while start < 63 {
        let source = ["function localPair(left: Integer, right: Integer) {", "print(left + right)", "print(-left - right)", "}"]
        let expected: List<Text> = []
        let last = start + 8
        if last > 63 { last = 63 }
        for exponent in start..last {
            let power = 1 << exponent
            for small in -3..4 {
                let other = power - small
                let name = Text(exponent) + "_" + Text(small + 3)
                peer.extend(source, ["print(" + Text(small) + " + " + Text(other) + ")", "print(-(" + Text(small) + ") - " + Text(other) + ")",
                    "localPair(" + Text(small) + ", " + Text(other) + ")",
                    "let left" + name + " = " + Text(small), "let right" + name + " = " + Text(other),
                    "print(left" + name + " + " + Text(other) + ")", "print(-left" + name + " - " + Text(other) + ")",
                    "print(" + Text(small) + " + right" + name + ")", "print(-(" + Text(small) + ") - right" + name + ")"])
                for unused in 0..4 { expected.add(Text(power)); expected.add(Text(-power)) }
            }
        }
        peer.executes(c, peer.lines(source), peer.lines(expected))
        start += 8
    }
}
function test_full_int32_constant_divisor_domain(c: peer.Case) {
    let values = [-2147483648, 715827883, 1431655766, -1431655765, -1431655764, 123, -1234, 12345, -123456, 1234567, -12345678, 123456789]
    let positive: List<Integer> = []
    for shift in 6..31 { positive.add(1 << shift) }
    for value in 1..33 { positive.add(value) }
    let magnitude = 100
    for unused in 2..10 {
        for offset in 0..10 { positive.add(magnitude + offset) }
        magnitude *= 10
    }
    for value in positive { values.add(value); values.add(-value) }
    let distinct: List<Integer> = []
    for value in values { if !peer.hasInteger(distinct, value) { distinct.add(value) } }
    peer.equalInteger(c, values.length, 286, "division domain length")
    peer.equalInteger(c, distinct.length, 286, "division domain distinct values")
    let domain = peer.jsonObject()
    peer.put(domain, "values", peer.jsonIntegers(values))
    peer.put(domain, "excluded_pair", peer.jsonIntegers([-2147483648, -1]))
    peer.put(domain, "pairs", peer.jsonInteger(81795))
    peer.put(domain, "operations", peer.jsonTexts(["division", "remainder"]))
    peer.put(domain, "placements", peer.jsonTexts(["constant-divisor", "parameter-divisor"]))
    peer.control(c, "division_domain", domain)
    let valueList: List<Text> = []
    for value in values { valueList.add(Text(value)) }
    let checked = 0
    let start = 0
    while start < values.length {
        let end = start + 16
        if end > values.length { end = values.length }
        let source = ["function divide(a: Integer, b: Integer): Integer { return a / b }", "function remainder(a: Integer, b: Integer): Integer { return a % b }"]
        for offset in 0..(end - start) {
            peer.extend(source, ["function constant" + Text(offset) + "(a: Integer) {", "print(a / (" + Text(values[start + offset]) + "))", "print(a % (" + Text(values[start + offset]) + "))", "}"])
        }
        source.add("let values = [" + peer.joined(valueList, ", ") + "]")
        let expected: List<Text> = []
        for offset in 0..(end - start) {
            let divisor = values[start + offset]
            peer.extend(source, ["let index = 0", "while index < values.length {", "let value = values[index]"])
            if divisor == -1 { source.add("if value != -2147483648 {") }
            peer.extend(source, ["constant" + Text(offset) + "(value)", "print(divide(value, " + Text(divisor) + "))", "print(remainder(value, " + Text(divisor) + "))"])
            if divisor == -1 { source.add("}") }
            peer.extend(source, ["index = index + 1", "}"])
            for value in values {
                if value == -2147483648 && divisor == -1 { continue }
                let result = peer.division(value, divisor)
                for unused in 0..2 { expected.add(Text(result.quotient)); expected.add(Text(result.remainder)) }
                checked += 1
            }
        }
        peer.executes(c, peer.lines(source), peer.lines(expected))
        start += 16
    }
    peer.equalInteger(c, checked, 81795, "division domain pairs")
}
