use "io" as io
use "./peer-support.min" as peer
use "system" as system
use "files" as files
use "json" as json
use "./cpython-random.min" as random

function test_index_assignment_ignores_brackets_inside_literals(c: peer.Case) {
    let kinds = ["Text", "Character"]
    let quotes = ["\"", "'"]
    let receivers = ["values", "values", "holder.values", "holder.values"]
    let brackets = ["[", "]", "[", "]"]
    for kind in 0..2 {
        let source = "record Holder { values: List<Integer> }\nfunction position(value: " + kinds[kind] + ", calls: List<Integer>): Integer {\nprint(value)\ncalls[0] = calls[0] + 1\nreturn 0\n}\nlet calls = [0]\nlet values = [0]\nlet holder = Holder { values: values }\n"
        for index in 0..4 {
            source += receivers[index] + "[position(" + quotes[kind] + brackets[index] + quotes[kind] + ", calls)] = " + Text(index + 1) + "\n"
            source += "print(values[0])\n"
        }
        source += "print(calls[0])\nprint(holder.values[0])\n"
        peer.executes(c, source, "[\n1\n]\n2\n[\n3\n]\n4\n4\n4\n")
    }
}
function test_final_statement_without_newline_and_incomplete_input(c: peer.Case) {
    for ending in ["", ";", " // comment at EOF", " /* comment at EOF */", "\n ", "\n//" + peer.repeat("x", 10000), "\n//" + peer.repeat("x", 10002)] {
        peer.executes(c, "print(42)" + ending, "42\n")
    }
    peer.executes(c, "let value = 42\r\nprint(value)", "42\n")
    peer.rejects(c, "let a = 42\rlet b = -13\rprint(a)\rprint(b)", "unexpected 'let'; start the next statement on a new line")
    peer.executes(c, "let value = 1 // comment ending in \\\nvalue = 2\nprint(value)\n", "2\n")
    for incomplete in ["print(42", "let value =", "if true { print(42)", "function f(): Integer { return 42"] {
        peer.rejects(c, incomplete, "Minyar stopped:")
    }
}
function test_wide_argument_positions_survive_register_stack_boundary(c: peer.Case) {
    let parameters: List<Text> = []
    let terms: List<Text> = []
    let arguments: List<Text> = []
    let total = 0
    for index in 0..41 {
        parameters.add("value" + Text(index) + ": Integer")
        terms.add("value" + Text(index) + " * " + Text(index + 1))
        if index == 39 { arguments.add("input") } else { arguments.add(Text(index)) }
        total += index * (index + 1)
    }
    peer.executes(c, "function wide(" + peer.joined(parameters, ", ") + "): Integer { return " + peer.joined(terms, " + ") + " }\nfunction caller(input: Integer): Integer {\nlet result = wide(" + peer.joined(arguments, ", ") + ")\nprint(input)\nreturn result\n}\nprint(caller(39))\n", "39\n" + Text(total) + "\n")
}
function operandValue(item: json.Value, name: Text): Integer { return peer.field(item, name) }
function test_associative_products_preserve_checked_intermediates(c: peer.Case) {
    let fixture = c.suite.root + "/tests/peer-associative-vectors.json"
    peer.input(c, fixture)
    let data = peer.load(fixture)
    peer.equalInteger(c, peer.field(data, "schema_version"), 1, "associative schema")
    let cases = json.member(data, "cases").items
    peer.equalInteger(c, cases.length, 96, "associative case count")
    let source: List<Text> = []
    let expected: List<Text> = []
    let failureChoices: List<Text> = []
    let failureExpressions: List<Text> = []
    for index in 0..cases.length {
        let item = cases[index]
        let expression = peer.textField(item, "expression")
        let raw = Bytes(expression)
        let shaped = raw.length == 7
        if shaped {
            for position in [0, 2, 4, 6] { if raw[position] < 97 || raw[position] > 99 { shaped = false } }
            if raw[1] != 42 || raw[5] != 42 || (raw[3] != 43 && raw[3] != 45) { shaped = false }
        }
        peer.expect(c, shaped, "unexpected associative expression " + expression)
        let left = peer.product(operandValue(item, Text(raw.slice(0, 1))), operandValue(item, Text(raw.slice(2, 3))))
        let right = peer.product(operandValue(item, Text(raw.slice(4, 5))), operandValue(item, Text(raw.slice(6, 7))))
        let result = peer.bigAdd(left, right)
        if raw[3] == 45 { result = peer.bigSubtract(left, right) }
        let overflow = ""
        if !peer.bigFits(left) { overflow = "left product" }
        else if !peer.bigFits(right) { overflow = "right product" }
        else if !peer.bigFits(result) { overflow = "final result" }
        peer.equal(c, peer.bigText(result), json.member(item, "result").text, "associative result " + Text(index))
        let stage = json.member(item, "overflow_stage")
        if overflow == "" { peer.expect(c, stage.kind == json.NULL, "associative stage " + Text(index)) }
        else { peer.expect(c, stage.kind == json.STRING && stage.text == overflow, "associative stage " + Text(index)) }
        source.add("function calculate" + Text(index) + "(a: Integer, b: Integer, c: Integer): Integer { return " + expression + " }")
        let constant: List<Text> = []
        for character in expression {
            if character == 'a' || character == 'b' || character == 'c' { constant.add("(" + json.member(item, Text(character)).text + ")") }
            else { constant.add(Text(character)) }
        }
        let call = "calculate" + Text(index) + "(" + json.member(item, "a").text + ", " + json.member(item, "b").text + ", " + json.member(item, "c").text + ")"
        if overflow != "" {
            failureChoices.add(Text(index) + "-literal"); failureExpressions.add(joinText(constant))
            failureChoices.add(Text(index) + "-parameter"); failureExpressions.add(call)
        } else {
            source.add("print(" + joinText(constant) + ")")
            source.add("print(" + call + ")")
            expected.add(peer.bigText(result)); expected.add(peer.bigText(result))
        }
    }
    peer.equalInteger(c, failureChoices.length, 80, "associative failure count")
    source.add("let choice = processInfo.argument(0)")
    for index in 0..failureChoices.length {
        source.add("if choice == \"" + failureChoices[index] + "\" { print(\"before\"); print(" + failureExpressions[index] + ") }")
    }
    source.add("print(\"ready\")")
    let prefix = peer.joined(expected, "\n") + "\n"
    let base = peer.executesWith(c, peer.lines(source), prefix + "ready\n", 0, "", ["probe"])
    for optimization in c.variants {
        for choice in failureChoices {
            peer.observe(c, peer.run(c, [peer.executable(base, optimization), choice], "execute-associative-overflow", 10), 1, prefix + "before\n", peer.OVERFLOW, choice + " at " + optimization)
        }
    }
}
function test_intermediate_overflow_cannot_be_reassociated_away(c: peer.Case) {
    let expressions = ["(x + 13) - 7", "(x - 13) + 7"]
    let values = ["9223372036854775797", "-9223372036854775798"]
    for index in 0..2 {
        peer.executesStatus(c, "function calculate(x: Integer): Integer { return " + expressions[index] + " }\nprint(\"before\")\nprint(calculate(" + values[index] + "))\n", "before\n", 1, peer.OVERFLOW)
    }
    peer.executes(c, "function calculate(x: Integer): Integer { return (x + 13) - 7 }
print(calculate(9223372036854775794))
", "9223372036854775800\n")
}
function test_unused_dynamic_arithmetic_must_still_trap(c: peer.Case) {
    let expressions = ["x + 1", "x - 1", "x * 2", "-x", "7 / x", "7 % x"]
    let values = ["9223372036854775807", "-9223372036854775808", "4611686018427387904", "-9223372036854775808", "0", "0"]
    let errors = [peer.OVERFLOW, peer.OVERFLOW, peer.OVERFLOW, peer.OVERFLOW, peer.ZERO, peer.ZERO]
    for index in 0..6 {
        peer.executesStatus(c, "function calculate(x: Integer) {\nlet unused = " + expressions[index] + "\nprint(\"incorrectly survived\")\n}\ncalculate(" + values[index] + ")\n", "", 1, errors[index])
    }
}
function test_unreachable_traps_and_safe_neighbors(c: peer.Case) {
