use "quic" as quic
use "quicretry" as retry
use "quicwire" as wire
use "quiccrypto" as protection
use "crypto" as crypto
use "errors" as errors
function equal(left: Bytes,right: Bytes): Boolean { return crypto.hex(left)==crypto.hex(right) }
function transfer(c: quic.Connection,s: quic.Connection,now: Integer) {
    for packet in quic.poll(c,now) { quic.receive(s,packet,now) }
    for packet in quic.poll(s,now) { quic.receive(c,packet,now) }
}
function negotiation(c: quic.Connection,versions: Bytes): Bytes {
    let packet=Bytes();packet.add(0x80);packet.addBytes(Bytes(4));packet.add(c.local.length);packet.addBytes(c.local)
    packet.add(c.originalDestination.length);packet.addBytes(c.originalDestination);packet.addBytes(versions);return packet
}
function main(): Integer {
    let root=readBytesFile(argument(0));let cert=readBytesFile(argument(1));let key=readBytesFile(argument(2));let client=readBytesFile(argument(3));let clientKey=readBytesFile(argument(4))
    let store=retry.store(randomBytes(16),30000);let address=Bytes("127.0.0.1:50001")
    let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
    let initial=quic.poll(c,0)[0];let source=randomBytes(8)
    let issued=retry.reply(store,initial,address,source,1000)
    if !errors.bytesOk(issued) { return 1 };let packet=errors.bytesValue(issued);let header=wire.header(packet,0,8)
    if !header.valid || !protection.retryValid(1,packet,c.originalDestination) { return 2 }
    let opened=retry.validate(store,header.token,address,source,c.local,1001)
    if !retry.valid(opened) || !equal(retry.original(opened),c.originalDestination) { return 3 }
    for index in 0..header.token.length {
        let changed=header.token.slice(0,header.token.length);changed[index]=changed[index]^1
        if retry.valid(retry.validate(store,changed,address,source,c.local,1001)) { return 4 }
        if retry.valid(retry.validate(store,header.token.slice(0,index),address,source,c.local,1001)) { return 5 }
    }
    if retry.valid(retry.validate(store,header.token,Bytes("127.0.0.1:50002"),source,c.local,1001)) || retry.valid(retry.validate(store,header.token,address,randomBytes(8),c.local,1001)) || retry.valid(retry.validate(store,header.token,address,source,randomBytes(8),1001)) || retry.valid(retry.validate(store,header.token,address,source,c.local,31001)) || retry.valid(retry.validate(store,header.token,address,source,c.local,999)) { return 6 }
    let before=c.spaces[0].next
    for index in 0..packet.length { let changed=packet.slice(0,packet.length);changed[index]=changed[index]^1;quic.receive(c,changed,10) }
    if c.retryAccepted || !equal(c.remote,c.originalDestination) { return 7 }
    quic.receive(c,packet,10)
    if !c.retryAccepted || !equal(c.remote,source) || c.spaces[0].next != before { return 8 }
    let restarted=quic.poll(c,10);if restarted.length==0 { return 9 }
    let next=wire.header(restarted[0],0,8)
    if !equal(next.destination,source) || !equal(next.source,c.local) || !equal(next.token,header.token) { return 10 }
    if !retry.valid(retry.validateInitial(store,restarted[0],address,1001)) { return 16 }
    let s=quic.serverAfterRetry(randomBytes(80),"minyar-test",opened,[cert],key,[root],true)
    for data in restarted { quic.receive(s,data,10) }
    for now in 20..2000 { transfer(c,s,now) }
    if c.state != quic.ESTABLISHED || s.state != quic.ESTABLISHED { print(c.error);print(s.error);return 11 }
    quic.receive(c,packet,2000);if !equal(c.remote,s.local) { return 12 }
    for scenario in 0..2 {
        let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
        let issued=errors.bytesValue(retry.reply(store,quic.poll(c,0)[0],address,randomBytes(8),1000))
        quic.receive(c,issued,1);let packet=quic.poll(c,1)[0]
        let opened=retry.validateInitial(store,packet,address,1001)
        let s=quic.serverAfterRetry(randomBytes(80),"minyar-test",opened,[cert],key,[root],true)
        let parameters=wire.parameters(s.serverTLS.transportParameters,true);let changed=Bytes()
        for parameter in parameters.parameters {
            if parameter.id != 16 || scenario==1 {
                let value=parameter.value;if parameter.id==16 { value=randomBytes(8) }
                changed.addBytes(errors.bytesValue(wire.encode(parameter.id)));changed.addBytes(errors.bytesValue(wire.encode(value.length)));changed.addBytes(value)
            }
        }
        s.serverTLS.transportParameters=changed;quic.receive(s,packet,1)
        for now in 2..500 { transfer(c,s,now) }
        if c.state != quic.FAILED || c.code != 8 { return 17 }
    }
    let v=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
    quic.poll(v,0)
    quic.receive(v,negotiation(v,crypto.fromHex("000000016b3343cf")),1)
    if v.state != quic.STARTING { return 13 }
    let wrong=negotiation(v,crypto.fromHex("6b3343cf"));wrong[6]=wrong[6]^1;quic.receive(v,wrong,1)
    if v.state != quic.STARTING { return 14 }
    quic.receive(v,negotiation(v,crypto.fromHex("6b3343cf")),2)
    if v.state != quic.FAILED || v.code != 0 || quic.poll(v,2).length != 0 { return 15 }
    print("QUIC Retry: authenticated address/CID/expiry tokens, all-byte tamper/truncation, original CID/TLS binding, fresh packet numbers and strict v1 negotiation passed")
    return 0
}
