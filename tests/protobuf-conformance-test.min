use "../tools/testing.min" as test
use "io" as io
use "process" as process
use "system" as system
use "text" as text
// Google's Protocol Buffers conformance suite against code generated by
// protoc-gen-minyar: every binary and JSON test for proto3 messages must pass,
// with the testee compiled at -O0 and at -O2. Proto2 and editions messages and
// the text format are skipped by the testee.
//
//   protobuf-conformance-test RUNNER   RUNNER is a conformance_test_runner of
//                                      the pinned release (tools/protoc-gen-minyar/conformance-runner.sh).

constant PLUGIN = "build/tooling/tools/protoc-gen-minyar/main"
// The binary and JSON tests of the pinned 36.2 suite that a proto3-only testee runs.
constant MINIMUM_SUCCESSES = 1498

function sh(script: Text, log: Text, seconds: Integer): test.Result {
    return test.run(["/bin/sh", "-c", script], system.environment(), "", log, seconds)
}

function quoted(path: Text): Text { return "'" + path + "'" }

// The success count from a "CONFORMANCE SUITE PASSED: N successes, ..." line.
function successes(line: Text): Integer {
    let marker = "PASSED: "
    let start = line.find(marker) + marker.length
    let end = line.find(" ", start)
    return text.integer(line.slice(start, end)).unwrap()
}

let runner = process.argument(0)
if !io.fileExists(runner) {
    if system.getenv("MINYAR_REQUIRE_LAB_TOOLS") == "1" { test.check(false, "no conformance_test_runner at " + runner) }
    print("SKIP check-protobuf-conformance: no conformance_test_runner at " + runner + "; build it with make " + runner)
    exit(0)
}
let scratch = test.scratch()
let generated = scratch + "/generated"
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
test.require(test.run(["mkdir", "-p", generated], system.environment(), "", scratch + "/mkdir", 10), "scratch")
test.require(sh("protoc --plugin=protoc-gen-minyar=" + quoted(PLUGIN) + " -Ivendor/protobuf --minyar_out=" + quoted(generated) + " conformance/conformance.proto google/protobuf/test_messages_proto3.proto", scratch + "/generate", 60), "protoc-gen-minyar")
io.writeTextFile(generated + "/conformance-testee.min", io.readTextFile("tests/protobuf/conformance-testee.min"))
test.require(test.run(["./build/minyarc-modules", generated + "/conformance-testee.min", scratch + "/testee.ll", "--library", "library"], system.environment(), "", scratch + "/compile", 300), "compile the testee")
for level in ["-O0", "-O2"] {
    let testee = scratch + "/testee" + level
    test.require(test.run([clang, level, "-Wno-override-module", scratch + "/testee.ll", "build/testing/cycle-runtime.o", "build/tooling/runtime/native/system.o", "build/tooling/runtime/native/files.o", "-lm", "-o", testee], system.environment(), "", testee + ".link", 600), "link the testee " + level)
    let results = scratch + "/results" + level
    test.require(test.run(["mkdir", "-p", results], system.environment(), "", results + ".mkdir", 10), "results directory")
    let run = test.run([runner, "--maximum_edition", "PROTO3", "--output_dir", results, testee], system.environment(), "", testee + ".suite", 1800)
    let report = run.output + run.errorOutput
    test.check(run.status == 0, "conformance suite failed at " + level + "\n" + report)
    let suites = 0
    for line in test.lines(report) {
        if !line.contains("CONFORMANCE SUITE") { continue }
        test.check(line.contains("CONFORMANCE SUITE PASSED") && line.contains(" 0 unexpected failures"), "conformance suite at " + level + ": " + line)
        if suites == 0 { test.check(successes(line) >= MINIMUM_SUCCESSES, "fewer binary and JSON tests ran than expected at " + level + ": " + line) }
        suites += 1
    }
    test.check(suites == 2, "expected the binary/JSON and text format suite summaries at " + level + "\n" + report)
}
test.removeScratch(scratch)
print("protobuf conformance: ok")
