use "../tools/testing.min" as test
use "./thread-port-support.min" as support
use "./cycle-port-support.min" as groups
use "system" as system
use "files" as files

record Context { directory: Text; root: Text; compiler: Text; base: Text; empty: Text; prior: Text; next: Text; stats: Text; cold: Text; warm: Text; serial: Integer }
record Measured { counts: List<Integer>; table: Boolean }
function run(context: Context, command: List<Text>, success: Boolean): test.Result {
    context.serial += 1
    let result = test.run(command, system.environment(), "", context.directory + "/.run-" + Text(context.serial), 60)
    test.check(result.status != 124 && (result.status == 0) == success, support.joined(command, " ") + "\n" + result.errorOutput)
    return result
}
function state(context: Context, entry: Text, prior: Text, output: Text): List<Text> {
    return [context.compiler, entry, output, "--module-state", prior, context.next, context.stats, "--library", context.root + "/library"]
}
function same(left: List<Integer>, right: List<Integer>): Boolean {
    if left.length != right.length { return false }
    for index in 0..left.length { if left[index] != right[index] { return false } }
    return true
}
function show(values: List<Integer>): Text {
    let parts: List<Text> = []
    for value in values { parts.add(Text(value)) }
    return "(" + support.joined(parts, ", ") + ")"
}
function compileProgram(context: Context, entry: Text, expected: Text, counts: List<Integer>, update: Boolean): Measured {
    run(context, state(context, entry, context.prior, context.warm), true)
    let fields = test.words(readTextFile(context.stats))
    let measured: List<Integer> = []
    for index in 0..6 { measured.add(groups.parseInteger(fields[index])) }
    let table = fields[6] == "true"
    let produced = readTextFile(context.next)
    if update && produced != "" { writeTextFile(context.prior, produced) }
    run(context, state(context, entry, context.empty, context.cold), true)
    test.check(readTextFile(context.cold) == readTextFile(context.warm), "clean and reused module LLVM differ")
    if counts.length > 0 { test.check(same(measured, counts), entry + " " + show(measured) + " != " + show(counts)) }
    if expected != "" {
        let binary = context.directory + "/program"
        run(context, ["clang", "-O0", "-Wno-override-module", context.warm, context.root + "/build/minyar-runtime.o", "-o", binary, "-lm"], true)
        test.check(run(context, [binary], true).output == expected, "module program output changed")
        run(context, [context.base, entry, context.directory + "/base.ll"], true)
        run(context, ["clang", "-O0", "-Wno-override-module", context.directory + "/base.ll", context.root + "/build/minyar-runtime.o", "-o", context.directory + "/base", "-lm"], true)
        test.check(run(context, [context.directory + "/base"], true).output == expected, "production program output changed")
    }
    return Measured { counts: measured; table: table }
}
function compile(context: Context, entry: Text, expected: Text): Measured { return compileProgram(context, entry, expected, [], true) }
function counted(context: Context, entry: Text, expected: Text, counts: List<Integer>): Measured { return compileProgram(context, entry, expected, counts, true) }
function rejected(context: Context, entry: Text): test.Result { return run(context, state(context, entry, context.prior, context.warm), false) }
function prefix(values: List<Integer>, a: Integer, b: Integer): Boolean { return values[0] == a && values[1] == b }

let work = test.scratch()
let root = test.lines(test.run(["pwd", "-P"], system.environment(), "", work + "/.root", 10).output)[0]
let resolved = test.run(["realpath", "--", test.setting("MINYAR_TEST_COMPILER", root + "/build/minyarc-modules")], system.environment(), "", work + "/.compiler", 10)
test.require(resolved, "resolve module compiler")
let context = Context { directory: work; root: root; compiler: test.lines(resolved.output)[0]; base: root + "/build/minyarc"; empty: work + "/empty.state"; prior: work + "/prior.state"; next: work + "/next.state"; stats: work + "/stats.txt"; cold: work + "/cold.ll"; warm: work + "/warm.ll"; serial: 0 }
writeTextFile(context.empty, "")
writeTextFile(context.prior, "")
let cases = ["basic", "diamond", "explicit-main", "windows-path"]
let outputs = ["Hello, Ada\n42\nAda\n", "42\n", "42\n", "42\n"]
for index in 0..cases.length {
    writeTextFile(context.prior, "")
    let entry = root + "/tests/modules/" + cases[index] + "/main.min"
    let first = compile(context, entry, outputs[index])
    let second = compile(context, entry, outputs[index])
    test.check(same(second.counts, [first.counts[1], 0, 0, first.counts[1], 0, 0]), cases[index] + " second " + show(second.counts))
    test.check(second.table, cases[index] + " did not reuse its table")
}
writeTextFile(context.prior, "")
let leaf = work + "/leaf.min"
let library = work + "/library.min"
let entry = work + "/main.min"
let leafSource = "record Hidden { value: Integer, label: Text }\npublic function make(): Hidden { return Hidden { value: 40, label: \"λ\\n@.text.123\" } }\n"
let librarySource = "use \"./leaf.min\" as leaf\npublic function answer(): Integer { return leaf.make().value }\npublic function label(): Text { return leaf.make().label }\nfunction secret(): Integer { return 5 }\n"
let mainSource = "use \"./library.min\" as library\nfunction main() {\n    print(library.answer() + 2)\n    print(library.label())\n}\n"
writeTextFile(leaf, leafSource)
writeTextFile(library, librarySource)
writeTextFile(entry, mainSource)
let labelled = "42\nλ\n@.text.123\n"
counted(context, entry, labelled, [0, 3, 3, 0, 5, 0])
counted(context, entry, "", [3, 0, 0, 3, 0, 0])
writeTextFile(library, test.replace(librarySource, "return 5", "return 6"))
test.check(counted(context, entry, labelled, [2, 1, 1, 2, 3, 0]).table, "library body edit lost table reuse")
writeTextFile(entry, test.replace(mainSource, "    print(library.answer()", "    let moved = \"entry literal\"\n    print(library.answer()"))
test.check(counted(context, entry, labelled, [2, 1, 1, 2, 1, 0]).table, "entry edit lost table reuse")
run(context, ["touch", "-r", leaf, work + "/leaf.stamp"], true)
writeTextFile(leaf, test.replace(leafSource, "value: 40", "value: 41"))
run(context, ["touch", "-r", work + "/leaf.stamp", leaf], true)
test.check(counted(context, entry, "43\nλ\n@.text.123\n", [2, 1, 1, 2, 1, 0]).table, "same-size same-mtime edit lost table reuse")
writeTextFile(leaf, test.replace(leafSource, "value: Integer, label: Text", "label: Text, value: Integer"))
test.check(!counted(context, entry, labelled, [1, 2, 2, 2, 4, 0]).table, "hidden layout change kept the table")
writeTextFile(library, "use \"./leaf.min\" as leaf\npublic function get(): leaf.Hidden { return leaf.make() }\n")
test.check(test.contains(rejected(context, entry).errorOutput, "private to its module"), "private signature type was accepted")
let publicLeaf = test.replace(leafSource, "record Hidden", "public record Hidden")
writeTextFile(leaf, publicLeaf)
writeTextFile(entry, "use \"./library.min\" as library\nprint(library.get().value)\n")
compile(context, entry, "40\n")
writeTextFile(leaf, test.replace(publicLeaf, "value: Integer, label: Text", "label: Text, value: Integer"))
let reordered = compile(context, entry, "40\n")
test.check(reordered.counts[0] == 0 && reordered.counts[1] == 3, show(reordered.counts))
writeTextFile(leaf, publicLeaf)
writeTextFile(entry, "use \"./leaf.min\" as leaf\nlet value = leaf.Hidden { value: 7, label: \"x\" }\nprint(value.value)\n")
compile(context, entry, "7\n")
writeTextFile(leaf, leafSource)
let saved = readTextFile(context.prior)
test.check(test.contains(rejected(context, entry).errorOutput, "private to its module"), "private constructor was accepted")
test.check(readTextFile(context.prior) == saved, "failed compilation changed prior state")
writeTextFile(leaf, publicLeaf)
writeTextFile(work + "/unused.min", "public record Earlier { value: Integer }\npublic function extra(): Integer { return 3 }\n")
let baseMain = "use \"./leaf.min\" as leaf\nprint(leaf.make().value)\n"
writeTextFile(entry, baseMain)
compile(context, entry, "40\n")
writeTextFile(entry, "use \"./unused.min\" as unused\n" + baseMain)
let added = compile(context, entry, "40\n")
test.check(prefix(added.counts, 1, 2) && !added.table, show(added.counts))
writeTextFile(entry, baseMain + "use \"./unused.min\" as unused\n")
test.check(prefix(compile(context, entry, "40\n").counts, 2, 1), "reordered import identities changed")
writeTextFile(entry, baseMain)
test.check(prefix(compile(context, entry, "40\n").counts, 1, 1), "removed import identities changed")
let broken = ["use \"./main.min\" as main\n" + publicLeaf, publicLeaf + "\nprint(1)\n", test.replace(publicLeaf, "return Hidden", "return missing")]
let diagnostics = ["module import cycle", "executable top-level statements", ""]
for index in 0..broken.length {
    writeTextFile(leaf, broken[index])
    let failure = rejected(context, entry)
    if diagnostics[index] != "" { test.check(test.contains(failure.errorOutput, diagnostics[index]), failure.errorOutput) }
}
files.remove(leaf)
test.check(test.contains(rejected(context, entry).errorOutput, "could not be opened"), "missing cached import was accepted")
writeTextFile(leaf, publicLeaf)
let lines: List<Text> = ["function longBody(): Integer {\n"]
for index in 0..20 { lines.add("    let x = 1\n") }
lines.add("    return 1\n}\n\n")
let bad = joinText(lines) + "public function bad(value: Missing): Integer { return 0 }\n"
writeTextFile(library, bad)
writeTextFile(entry, "use \"./library.min\" as library\nprint(1)\n")
let failure = rejected(context, entry)
test.check(test.contains(failure.errorOutput, library + ":25, column "), failure.errorOutput)
let odd = work + "/space λ \"quote\" | part"
test.check(files.makeDirectory(odd) == 0, "cannot create unusual module directory")
writeTextFile(odd + "/lib.min", "public function answer(): Integer { return 42 }\n")
writeTextFile(odd + "/main.min", "use \"./lib.min\" as lib\nprint(lib.answer())\n")
writeTextFile(context.prior, "")
compile(context, odd + "/main.min", "42\n")
counted(context, odd + "/main.min", "42\n", [2, 0, 0, 2, 0, 0])
let declarations = work + "/declarations.min"
writeTextFile(declarations, "record Node { children: List<Node>; values: List<Integer>; }\n")
writeTextFile(context.prior, "")
counted(context, declarations, "", [0, 1, 1, 0, 0, 1])
counted(context, declarations, "", [1, 0, 0, 1, 0, 0])
let tree = work + "/tree.min"
let treeSource = "public record Node { value: Integer, children: List<Node> }\npublic function make(): Node {\n    let child = Node { value: 2, children: [] }\n    return Node { value: 40, children: [child] }\n}\npublic function total(node: Node): Integer {\n    let value = node.value\n    let i = 0\n    while i < node.children.length {\n        value = value + total(node.children[i])\n        i = i + 1\n    }\n    return value\n}\n"
writeTextFile(tree, treeSource)
let treeMain = "use \"./tree.min\" as tree\nprint(tree.total(tree.make()))\n"
writeTextFile(entry, treeMain)
writeTextFile(context.prior, "")
compile(context, entry, "42\n")
counted(context, entry, "42\n", [2, 0, 0, 2, 0, 0])
writeTextFile(entry, "use \"./unused.min\" as unused\n" + treeMain)
test.check(prefix(compile(context, entry, "42\n").counts, 1, 2), "unrelated record shifted tree identities")
writeTextFile(tree, test.replace(treeSource, "value: Integer, children: List<Node>", "children: List<Node>, value: Integer"))
test.check(prefix(compile(context, entry, "42\n").counts, 1, 2), "recursive layout change was not localized")
let listed = test.run(["sh", "-c", "for path in examples/*.min; do printf '%s\\n' \"$path\"; done | LC_ALL=C sort"], system.environment(), "", work + "/.examples", 10)
test.require(listed, "list examples")
for fixture in test.lines(listed.output) {
    writeTextFile(context.prior, "")
    let probe = work + "/feature-probe.ll"
    if files.pathSize(probe) >= 0 { files.remove(probe) }
    run(context, [context.compiler, root + "/" + fixture, probe, "--library", root + "/library"], true)
    let first = compile(context, root + "/" + fixture, "")
    if readTextFile(context.next) == "" {
        test.check(first.counts[0] == 0 && first.counts[4] == 0 && first.counts[5] == 0, fixture + " fallback " + show(first.counts))
        let again = compile(context, root + "/" + fixture, "")
        test.check(same(again.counts, first.counts) && !again.table && readTextFile(context.next) == "", fixture + " fallback reused state")
        continue
    }
    let again = compile(context, root + "/" + fixture, "")
    test.check(same(again.counts, [first.counts[1], 0, 0, first.counts[1], 0, 0]) && again.table, fixture + " " + show(again.counts))
}
test.removeTree(work)
print("module interfaces: native equivalence, actual body bypass, stable identities, typed private closures, invalidation and source diagnostics verified")
