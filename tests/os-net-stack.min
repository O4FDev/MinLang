use "../os/kernel/net/wire.min" as wire

function check(condition: Boolean, message: Text) {
    if !condition { fail("OS network parser regression: " + message) }
}

function put16(data: Bytes, at: Integer, value: Integer) {
    data[at] = (value >> 8) & 255
    data[at + 1] = value & 255
}

function put32(data: Bytes, at: Integer, value: Integer) {
    put16(data, at, (value >> 16) & 0xFFFF)
    put16(data, at + 2, value & 0xFFFF)
}

function dhcpReply(hardware: Bytes, transaction: Integer, kind: Integer, offered: Integer, server: Integer): Bytes {
    let message = Bytes(240)
    message[0] = 2
    message[1] = 1
    message[2] = 6
    put32(message, 4, transaction)
    put32(message, 16, offered)
    for index in 0..6 { message[28 + index] = hardware[index] }
    put32(message, 236, 0x63825363)
    message.add(53); message.add(1); message.add(kind)
    message.add(54); message.add(4)
    let serverBytes = Bytes(4)
    put32(serverBytes, 0, server)
    message.addBytes(serverBytes)
    message.add(1); message.add(4)
    let mask = Bytes(4)
    put32(mask, 0, 0xFFFFFF00)
    message.addBytes(mask)
    message.add(3); message.add(4); message.addBytes(serverBytes)
    message.add(6); message.add(4); message.addBytes(serverBytes)
    message.add(255)
    return message
}

function dnsResponse(name: Text, id: Integer, owner: Text, kind: Integer, address: Integer): Bytes {
    let message = wire.dnsQuery(name, id)
    put16(message, 2, 0x8180)
    put16(message, 6, 1)
    if owner == name {
        message.add(0xC0); message.add(0x0C)
    } else {
        let ownerQuery = wire.dnsQuery(owner, 0)
        message.addBytes(ownerQuery.slice(12, ownerQuery.length - 4))
    }
    let record = Bytes(14)
    put16(record, 0, kind)
    put16(record, 2, 1)
    put16(record, 8, 4)
    put32(record, 10, address)
    message.addBytes(record)
    return message
}

let udp = Bytes(8)
put16(udp, 0, 67)
put16(udp, 2, 68)
put16(udp, 4, 0)
check(!wire.udp(udp).valid, "zero UDP length accepted")
put16(udp, 4, 7)
check(!wire.udp(udp).valid, "short UDP length accepted")
put16(udp, 4, 9)
check(!wire.udp(udp).valid, "UDP length beyond packet accepted")
put16(udp, 4, 8)
let emptyUdp = wire.udp(udp)
check(emptyUdp.valid && emptyUdp.sourcePort == 67 && emptyUdp.destinationPort == 68 && emptyUdp.payload.length == 0,
      "valid empty UDP datagram rejected")

let transaction = 0x4D494E59
let hardware = Bytes(6)
for index in 0..6 { hardware[index] = index + 1 }
let truncatedDhcp = Bytes(244)
truncatedDhcp[0] = 2
truncatedDhcp[1] = 1
truncatedDhcp[2] = 6
put32(truncatedDhcp, 4, transaction)
for index in 0..6 { truncatedDhcp[28 + index] = hardware[index] }
put32(truncatedDhcp, 236, 0x63825363)
truncatedDhcp[240] = 1
truncatedDhcp[241] = 4
check(!wire.dhcp(truncatedDhcp, transaction, hardware).valid, "truncated DHCP address option accepted")
let missingKind = Bytes(244)
missingKind[0] = 2
missingKind[1] = 1
missingKind[2] = 6
put32(missingKind, 4, transaction)
for index in 0..6 { missingKind[28 + index] = hardware[index] }
put32(missingKind, 236, 0x63825363)
missingKind[240] = 0
missingKind[241] = 0
missingKind[242] = 53
missingKind[243] = 0
check(!wire.dhcp(missingKind, transaction, hardware).valid, "empty DHCP message-kind option accepted")
let server = 0x0A000202
let offered = 0x0A00020F
let validDhcp = dhcpReply(hardware, transaction, 2, offered, server)
let offer = wire.dhcp(validDhcp, transaction, hardware)
check(offer.valid && offer.kind == 2 && offer.offered == 0x0A00020F && offer.mask == 0xFFFFFF00,
      "valid DHCP offer rejected")
check(wire.dhcpReplyAccepted(offer, 1, server, 67, 68, 0, 0, 0), "bound DHCP offer rejected")
check(!wire.dhcpReplyAccepted(offer, 0, server, 67, 68, 0, 0, 0), "DHCP offer accepted outside discover state")
let relay = server + 1
check(wire.dhcpReplyAccepted(offer, 1, relay, 67, 68, 0, 0, 0), "relayed DHCP offer rejected")
check(!wire.dhcpReplyAccepted(offer, 1, 0, 67, 68, 0, 0, 0), "DHCP offer without source accepted")
check(!wire.dhcpReplyAccepted(offer, 1, server, 68, 67, 0, 0, 0), "DHCP offer accepted on wrong UDP ports")
let multipleAddresses = dhcpReply(hardware, transaction, 2, offered, server)
multipleAddresses[multipleAddresses.length - 1] = 3
multipleAddresses.add(8)
let addresses = Bytes(8)
put32(addresses, 0, server)
put32(addresses, 4, relay)
multipleAddresses.addBytes(addresses)
multipleAddresses.add(6); multipleAddresses.add(8); multipleAddresses.addBytes(addresses)
multipleAddresses.add(255)
check(wire.dhcp(multipleAddresses, transaction, hardware).valid, "DHCP router and DNS address lists rejected")
validDhcp[0] = 1
check(!wire.dhcp(validDhcp, transaction, hardware).valid, "DHCP request accepted as a reply")
validDhcp[0] = 2
validDhcp[28] = 99
check(!wire.dhcp(validDhcp, transaction, hardware).valid, "DHCP reply for another client accepted")
let ack = wire.dhcp(dhcpReply(hardware, transaction, 5, offered, server), transaction, hardware)
check(wire.dhcpReplyAccepted(ack, 2, server, 67, 68, server, offered, relay), "bound DHCP acknowledgement rejected")
check(wire.dhcpReplyAccepted(ack, 2, relay, 67, 68, server, offered, relay), "relayed DHCP acknowledgement rejected")
check(!wire.dhcpReplyAccepted(ack, 2, relay + 1, 67, 68, server, offered, relay), "DHCP acknowledgement from an unselected source accepted")
check(!wire.dhcpReplyAccepted(ack, 2, server, 67, 68, server + 1, offered, relay), "DHCP acknowledgement from an unselected server accepted")
check(!wire.dhcpReplyAccepted(ack, 2, server, 67, 68, server, offered + 1, relay), "DHCP acknowledgement for an unselected address accepted")

let validDns = dnsResponse("example.com", 9, "example.com", 1, 0x01020304)
let answer = wire.dns(validDns, 9, "example.com")
check(answer.valid && answer.id == 9 && answer.address == 0x01020304, "valid DNS A answer rejected")
check(!wire.dns(validDns, 8, "example.com").valid, "DNS answer with unexpected identifier accepted")
check(!wire.dns(validDns, 9, "other.example").valid, "DNS answer with unexpected question accepted")
let unrelatedDns = dnsResponse("example.com", 9, "attacker.invalid", 1, 0x05060708)
let unrelatedAnswer = wire.dns(unrelatedDns, 9, "example.com")
check(unrelatedAnswer.valid && unrelatedAnswer.address == 0, "unrelated DNS answer owner supplied an address")
let wrongTypeDns = dnsResponse("example.com", 9, "example.com", 28, 0x05060708)
let wrongTypeAnswer = wire.dns(wrongTypeDns, 9, "example.com")
check(wrongTypeAnswer.valid && wrongTypeAnswer.address == 0, "non-A DNS answer supplied an IPv4 address")
let truncatedDns = validDns.slice(0, validDns.length - 1)
check(!wire.dns(truncatedDns, 9, "example.com").valid, "truncated DNS A record accepted")
check(wire.dnsQuery("example.com", 9).length > 12, "valid DNS query rejected")
check(wire.dnsQuery("bad..example", 9).length == 0, "empty DNS label accepted")
check(wire.dnsQuery("", 9).length == 0, "empty DNS name accepted")
check(wire.dnsTupleAccepted(0x0A000203, 53, 60000, 0x0A000203, 60000), "bound DNS response tuple rejected")
check(!wire.dnsTupleAccepted(0x0A000204, 53, 60000, 0x0A000203, 60000), "DNS response from an unexpected resolver accepted")
check(!wire.dnsTupleAccepted(0x0A000203, 54, 60000, 0x0A000203, 60000), "DNS response from an unexpected source port accepted")
check(!wire.dnsTupleAccepted(0x0A000203, 53, 5353, 0x0A000203, 60000), "DNS response for an unexpected randomized port accepted")
check(!wire.dnsTimedOut(-1, 100, 5099), "DNS query expired before its timeout")
check(wire.dnsTimedOut(-1, 100, 5100), "DNS query retained after its timeout")
check(wire.retainDnsQuery(-1, 100, -1, 5099), "pending DNS query removed before timeout")
check(!wire.retainDnsQuery(-1, 100, -1, 5100), "expired pending DNS query retained")
check(wire.retainDnsQuery(0, 100, 200, 30199), "completed DNS query removed before result retention elapsed")
check(!wire.retainDnsQuery(0, 100, 200, 30200), "expired DNS result retained")
check(wire.MAX_DNS_QUERIES == 64, "DNS query state is not capped")

let localIp = 0x0A00020F
let arp = Bytes(42)
put16(arp, 12, 0x0806)
put16(arp, 14, 1)
put16(arp, 16, 0x0800)
arp[18] = 6
arp[19] = 4
put16(arp, 20, 2)
for index in 0..6 { arp[22 + index] = index + 1 }
put32(arp, 28, 0x0A000202)
put32(arp, 38, localIp)
let reply = wire.arp(arp, localIp, true)
check(reply.valid && reply.senderIp == 0x0A000202 && reply.senderMac.length == 6, "valid targeted ARP reply rejected")
check(!wire.arp(arp, localIp, false).valid, "ARP cached before configuration")
put32(arp, 38, localIp + 1)
check(!wire.arp(arp, localIp, true).valid, "irrelevant ARP target accepted")

let addresses: List<Integer> = []
let macs: List<Bytes> = []
for index in 0..80 {
    let mac = Bytes(6)
    mac[5] = index
    check(wire.rememberArp(addresses, macs, index + 1, mac, wire.MAX_ARP_ENTRIES), "ARP cache update failed")
}
check(addresses.length == wire.MAX_ARP_ENTRIES && macs.length == wire.MAX_ARP_ENTRIES,
      "ARP cache exceeded its entry limit")
check(addresses[0] == 17 && addresses[addresses.length - 1] == 80, "ARP cache did not evict oldest entries")
let replacement = Bytes(6)
replacement[0] = 99
check(wire.rememberArp(addresses, macs, 42, replacement, wire.MAX_ARP_ENTRIES), "known ARP entry update failed")
let updated = false
for index in 0..addresses.length {
    if addresses[index] == 42 { updated = macs[index][0] == 99 }
}
check(updated && addresses.length == wire.MAX_ARP_ENTRIES, "known ARP entry update changed cache size")

check(wire.incomingFits(0, wire.MAX_CONNECTION_INCOMING), "connection cap rejected exact maximum")
check(wire.incomingFits(wire.MAX_CONNECTION_INCOMING - 1400, 1400), "connection cap rejected fitting segment")
check(!wire.incomingFits(wire.MAX_CONNECTION_INCOMING - 1399, 1400), "connection cap accepted oversized segment")
check(!wire.incomingFits(wire.MAX_CONNECTION_INCOMING, 1), "connection cap accepted byte beyond maximum")
check(wire.retainConnection(true, 1000, 30999), "terminal connection removed before retention elapsed")
check(!wire.retainConnection(true, 1000, 31000), "expired terminal connection was retained")
check(wire.retainConnection(false, 1000, 31000), "live connection was removed by terminal cleanup")

check(!wire.tcpAcknowledgesSyn(100, 101, false), "SYN reset without ACK accepted")
check(!wire.tcpAcknowledgesSyn(100, 100, true), "SYN reset with stale ACK accepted")
check(wire.tcpAcknowledgesSyn(100, 101, true), "SYN reset acknowledging the SYN rejected")
check(wire.tcpAcknowledgesSyn(0xFFFFFFFF, 0, true), "wrapped SYN acknowledgement rejected")
check(wire.tcpSequenceAccepted(700, 700), "exact established sequence rejected")
check(!wire.tcpSequenceAccepted(700, 699), "stale established sequence accepted")
check(!wire.tcpSequenceAccepted(700, 701), "future established sequence accepted")
check(!wire.tcpAcknowledgmentAccepted(700, 699, 400, 20, false, 410), "out-of-sequence ACK advanced send state")
check(wire.tcpAcknowledgmentAccepted(700, 700, 400, 20, false, 410), "in-sequence ACK rejected")
check(!wire.tcpAcknowledgmentAccepted(700, 700, 400, 20, false, 399), "stale ACK accepted")
check(!wire.tcpAcknowledgmentAccepted(700, 700, 400, 20, false, 421), "ACK beyond sent data accepted")
check(wire.tcpAcknowledgmentAccepted(700, 700, 400, 20, true, 421), "FIN acknowledgement rejected")
check(wire.tcpAcknowledgmentAccepted(700, 700, 0xFFFFFFF8, 16, false, 4), "wrapped in-range ACK rejected")

print("OS network parsers: UDP, bound DHCP/DNS, bounded state, ARP, TCP sequence, receive and cleanup controls passed")
