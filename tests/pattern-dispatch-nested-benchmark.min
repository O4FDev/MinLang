use "system" as system
use "process" as processInfo

choice Dispatch {
    Case0(value: Integer)
    Case1(value: Integer)
    Case2(value: Integer)
    Case3(value: Integer)
    Case4(value: Integer)
    Case5(value: Integer)
    Case6(value: Integer)
    Case7(value: Integer)
    Case8(value: Integer)
    Case9(value: Integer)
    Case10(value: Integer)
    Case11(value: Integer)
    Case12(value: Integer)
    Case13(value: Integer)
    Case14(value: Integer)
    Case15(value: Integer)
    Case16(value: Integer)
    Case17(value: Integer)
    Case18(value: Integer)
    Case19(value: Integer)
}

choice Envelope { Wrapped(value: Dispatch); Vacant }

function create(tag: Integer, payload: Integer): Dispatch {
    return match tag {
        0 { Case0(payload) }
        1 { Case1(payload) }
        2 { Case2(payload) }
        3 { Case3(payload) }
        4 { Case4(payload) }
        5 { Case5(payload) }
        6 { Case6(payload) }
        7 { Case7(payload) }
        8 { Case8(payload) }
        9 { Case9(payload) }
        10 { Case10(payload) }
        11 { Case11(payload) }
        12 { Case12(payload) }
        13 { Case13(payload) }
        14 { Case14(payload) }
        15 { Case15(payload) }
        16 { Case16(payload) }
        17 { Case17(payload) }
        18 { Case18(payload) }
        _ { Case19(payload) }
    }
}

function score(value: Envelope): Integer {
    return match value {
        Wrapped(Case0(number)) { number * 2 + 17 }
        Wrapped(Case1(number)) { number * 3 + 18 }
        Wrapped(Case2(number)) { number * 5 + 21 }
        Wrapped(Case3(number)) { number * 7 + 26 }
        Wrapped(Case4(number)) { number * 11 + 33 }
        Wrapped(Case5(number)) { number * 13 + 42 }
        Wrapped(Case6(number)) { number * 17 + 53 }
        Wrapped(Case7(number)) { number * 19 + 66 }
        Wrapped(Case8(number)) { number * 23 + 81 }
        Wrapped(Case9(number)) { number * 29 + 98 }
        Wrapped(Case10(number)) { number * 31 + 117 }
        Wrapped(Case11(number)) { number * 37 + 138 }
        Wrapped(Case12(number)) { number * 41 + 161 }
        Wrapped(Case13(number)) { number * 43 + 186 }
        Wrapped(Case14(number)) { number * 47 + 213 }
        Wrapped(Case15(number)) { number * 53 + 242 }
        Wrapped(Case16(number)) { number * 59 + 273 }
        Wrapped(Case17(number)) { number * 61 + 306 }
        Wrapped(Case18(number)) { number * 67 + 341 }
        Wrapped(Case19(number)) { number * 71 + 378 }
        Vacant { 0 }
    }
}

function number(text: Text): Integer {
    let value = 0
    for digit in text { value = value * 10 + Integer(digit) - Integer('0') }
    return value
}

let rounds = number(processInfo.argument(0))
let seed = number(processInfo.argument(1))
let values: List<Envelope> = []
for index in 0..4096 {
    seed = seed * 48271 % 2147483647
    values.add(Wrapped(create(seed % 20, seed % 97)))
}
let checksum = 0
let start = system.monotonicNanoseconds()
for round in 0..rounds {
    for index in 0..4096 { checksum += score(values[index]) }
}
let elapsed = system.monotonicNanoseconds() - start
print(Text(elapsed) + " " + Text(checksum))
