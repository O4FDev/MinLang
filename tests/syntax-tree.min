use "io" as io
use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "system" as system

let compiler = test.compiler()
let core = io.readTextFile(test.setting("MINYAR_TEST_SOURCE", "build/compiler.min"))
let main = core.find("\nfunction main(")
test.check(main >= 0, "compiler source entry point changed")
test.require(test.compile(compiler, core.slice(0, main) + "\n" + io.readTextFile("tests/syntax-tree-probe.min")), "compile selected syntax tree")
let llvm = compiler.directory + "/case" + Text(compiler.serial) + ".ll"
for optimization in ["-O0", "-O2"] {
    let executable = compiler.directory + "/syntax-tree"
    let command = [compiler.clang, optimization]
    for flag in compiler.flags { command.add(flag) }
    for item in ["-Wno-override-module", llvm, compiler.runtime, "-lm", "-o", executable] { command.add(item) }
    test.require(test.run(command, system.environment(), "", compiler.directory + "/link", 120), "link syntax tree " + optimization)
    let run = test.run([executable], system.environment(), "", compiler.directory + "/run", 30)
    test.require(run, "execute syntax tree " + optimization)
    test.check(run.output == "syntax tree verified\n" && run.errorOutput == "", "syntax tree structural oracle")
    let error = test.run([executable, "span-error"], system.environment(), "", compiler.directory + "/error", 30)
    test.check(error.status == 1 && error.output == "" && error.errorOutput == "Minyar stopped: folder/é🙂.min:4294967297:9: expected a star\n", "file:line:column diagnostic API")
}
test.removeTree(compiler.directory)

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
fixtures.executes(frontend, io.readTextFile("examples/gallery/observatory.min"), "Sirius · ✦ ✦ ✦\nVega · · · ✦\nPolaris · · · ·\n", ["-O0", "-O2"], 0, "", true)
fixtures.executes(frontend, io.readTextFile("tests/syntax-tree-cases/expressions.min"), "41\n", ["-O0", "-O2"], 0, "", true)
fixtures.executes(frontend, io.readTextFile("tests/syntax-tree-cases/declarations.min"), "2\n", ["-O0", "-O2"], 0, "", true)
test.removeTree(frontend.compiler.directory)
print("Typed syntax nodes, precedence, ranges, cached spans and ownership passed at O0/O2")
