record Trace { digits: Integer }
choice Packet { Data(value: Maybe<Integer>); Label(text: Text); Empty }

function probe(trace: Trace, digit: Integer, accepted: Boolean): Boolean {
    trace.digits = trace.digits * 10 + digit
    return accepted
}

function classify(packet: Packet, trace: Trace): Integer {
    return match packet {
        _ where probe(trace, 1, false) { 100 }
        Data(Some(0)) where probe(trace, 2, false) { 200 }
        Label("stop") where probe(trace, 3, true) { 300 }
        Data(Some(number)) where probe(trace, 4, number < 0) { -number }
        _ where probe(trace, 5, false) { 500 }
        Data(None) { 600 }
        Label(text) { text.length }
        Data(Some(number)) { number + 700 }
        Empty { 800 }
    }
}

let packets = [Data(Some(0)), Data(Some(-3)), Data(Some(9)), Data(None<Integer>()), Label("stop"), Label("go"), Empty]
let answers = [700, 3, 709, 600, 300, 2, 800]
let traces = [1245, 14, 145, 15, 13, 15, 15]
for round in 0..100 {
    for index in 0..packets.length {
        let trace = Trace { digits: 0 }
        if classify(packets[index], trace) != answers[index] { fail("wrong ordered result") }
        if trace.digits != traces[index] { fail("wrong guard order or extra side effect") }
    }
}

function nested(value: Maybe<Maybe<Integer>>, trace: Trace): Integer {
    return match value {
        Some(Some(1)) where probe(trace, 1, false) { 10 }
        None where probe(trace, 2, false) { 20 }
        Some(None) { 30 }
        Some(Some(number)) where probe(trace, 3, number == 2) { 40 }
        _ where probe(trace, 4, false) { 50 }
        Some(Some(number)) { number }
        None { 60 }
    }
}
let trace = Trace { digits: 0 }
if nested(Some(Some(1)), trace) != 1 || trace.digits != 134 { fail("nested overlap") }
trace.digits = 0
if nested(None<Maybe<Integer>>(), trace) != 60 || trace.digits != 24 { fail("nested wildcard") }
trace.digits = 0
if nested(Some(Some(2)), trace) != 40 || trace.digits != 3 { fail("nested selected guard") }

let total = 0
for index in 0..10 {
    match Data(Some(index)) {
        Label(_) { fail("incompatible arm") }
        Data(Some(number)) where number < 2 { continue }
        Data(Some(number)) where number == 8 { break }
        _ { total += index }
    }
}
if total != 27 { fail("match break or continue") }
print("ordered dispatch passed")
