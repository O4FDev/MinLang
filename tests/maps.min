use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "system" as system
use "files" as files
use "json" as json

public record Runtime { name: Text; object: Text }
record Program { source: Text; expected: Text }
function rejects(compiler: test.Compiler, source: Text, diagnostic: Text) {
    let result = test.compile(compiler, source)
    test.check(result.status == 1, "expected compiler rejection\n" + result.errorOutput)
    test.check(result.output == "", "rejected source wrote standard output")
    test.check(test.contains(result.errorOutput, diagnostic), "missing diagnostic: " + diagnostic + "\n" + result.errorOutput)
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "invalid source left LLVM output")
    test.check(!test.contains(result.errorOutput, "List position"), "compiler rejection reported a runtime List trap")
}

public function runtimes(): List<Runtime> {
    let source = test.setting("MINYAR_MAP_RUNTIMES", "null")
    let value = json.parse(source)
    let result: List<Runtime> = []
    if value.kind == json.NULL { return result }
    test.check(value.kind == json.ARRAY, "invalid Map runtime matrix JSON")
    for row in value.items {
        test.check(row.kind == json.ARRAY && row.items.length == 2, "invalid Map runtime matrix row")
        test.check(row.items[0].kind == json.STRING && row.items[1].kind == json.STRING, "invalid Map runtime names/objects")
        result.add(Runtime { name: row.items[0].text; object: row.items[1].text })
    }
    return result
}
function executes(compiler: test.Compiler, runtimes: List<Runtime>, source: Text, expected: Text, status: Integer, diagnostics: Text) {
    test.require(test.compile(compiler, source), "Map compile")
    let path = compiler.directory + "/case" + Text(compiler.serial)
    for optimization in ["-O0", "-O2"] {
        let objects = runtimes
        if objects.length == 0 { objects = [Runtime { name: "default"; object: compiler.runtime }] }
        let input = path + ".ll"
        if runtimes.length > 0 {
            input = path + "." + optimization + ".o"
            let command = [compiler.clang, optimization]
            for flag in compiler.flags { command.add(flag) }
            for item in ["-Wno-override-module", "-c", path + ".ll", "-o", input] { command.add(item) }
            test.require(test.run(command, system.environment(), "", input + ".codegen", 30), "Map codegen")
        }
        for runtime in objects {
            let executable = path + "." + optimization + "." + runtime.name
            let command = [compiler.clang, optimization]
            for flag in compiler.flags { command.add(flag) }
            if runtimes.length == 0 { command.add("-Wno-override-module") }
            for item in [input, runtime.object, "-o", executable, "-lm"] { command.add(item) }
            let timeout = 30
            if runtimes.length == 0 { timeout = compiler.linkTimeout }
            test.require(test.run(command, system.environment(), "", executable + ".link", timeout), "Map runtime link")
            let result = test.run([executable], system.environment(), "", executable + ".run", compiler.runTimeout)
            test.check(result.status == status, "Map execution returned " + Text(result.status) + "\n" + result.errorOutput)
            test.check(result.output == expected, "Map output changed\n" + result.output)
            test.check(result.errorOutput == diagnostics, "Map diagnostics changed\n" + result.errorOutput)
        }
    }
}
function model(): Program {
    let rows = test.lines(io.readTextFile("tests/maps-model-cases.tsv"))
    test.check(rows.length == 240, "seeded Map operation corpus changed")
    let present: List<Boolean> = []
    let values: List<Integer> = []
    for key in 0..65 { present.add(false); values.add(0) }
    let program = ["let m = Map<Integer, Integer>()"]
    let expected = ""
    for step in 0..rows.length {
        let fields = test.words(rows[step])
        test.check(fields.length == 2, "invalid Map operation corpus row")
        let key = Integer(fields[0])
        let operation = Integer(fields[1])
        let position = key + 32
        if operation < 2 {
            values[position] = step
            present[position] = true
            program.add("m[" + Text(key) + "] = " + Text(step))
        } else if operation == 2 {
            program.add("print(m.remove(" + Text(key) + "))")
            expected += Text(present[position]) + "\n"
            present[position] = false
        } else if operation == 3 {
            program.add("print(m.has(" + Text(key) + "))")
            expected += Text(present[position]) + "\n"
        } else if present[position] {
            program.add("print(m[" + Text(key) + "])")
            expected += Text(values[position]) + "\n"
        }
    }
    let length = 0
    for flag in present { if flag { length += 1 } }
    program.add("print(m.length)")
    expected += Text(length) + "\n"
    for position in 0..65 {
        if present[position] {
            program.add("print(m[" + Text(position - 32) + "])")
            expected += Text(values[position]) + "\n"
        }
    }
    let source = ""
    for index in 0..program.length {
        if index > 0 { source += "\n" }
        source += program[index]
    }
    return Program { source: source; expected: expected }
}
function selected(selectors: List<Text>, name: Text): Boolean {
    if selectors.length == 0 { return true }
    for selector in selectors {
        if selector == "Maps" || selector == "Maps." + name || selector == name { return true }
    }
    return false
}
public function run(compiler: test.Compiler, runtimes: List<Runtime>, selectors: List<Text>) {
    if selected(selectors, "test_python_dictionary_model") {
        let program = model()
        executes(compiler, runtimes, program.source, program.expected, 0, "")
    }
    if selected(selectors, "test_key_and_value_survive_right_side_clear") {
        executes(compiler, runtimes, "function reset(m: Map<Text, Text>): Text { m.clear(); return \"after\" + \"!\" }\nlet m = Map<Text, Text>()\nm[\"key\"] = \"borrowed\" + \"!\"\nm[m[\"key\"]] = reset(m)\nprint(m[\"borrowed!\"])\nm[\"borrowed!\"] = m[\"borrowed!\"]\nlet saved = m[\"borrowed!\"]\nprint(m.remove(\"borrowed!\"))\nprint(saved)\n", "after!\ntrue\nafter!\n", 0, "")
    }
    if selected(selectors, "test_managed_growth_and_all_removal_positions") {
        executes(compiler, runtimes, "let m = Map<Integer, List<Text>>()\nlet value = [\"owned\" + \"!\"]\nlet i = 0\nwhile i < 300 { m[i] = value; i = i + 1 }\nlet saved = m[299]\ni = 299\nwhile i >= 0 { m.remove(i); i = i - 1 }\nprint(m.length)\nprint(saved[0])\nm[0] = saved\nm.clear()\nm.clear()\nprint(value[0])\n", "0\nowned!\nowned!\n", 0, "")
    }
    if selected(selectors, "test_compound_assignment_and_contextual_arguments") {
        executes(compiler, runtimes, "function fresh(m: Map<Integer, Integer>): Map<Integer, Integer> { return m }\nfunction make(): Map<Integer, Integer> { return Map() }\nlet m = fresh(Map())\nm[1] = 40\nm[1] += 2\nprint(m[1])\nlet others: List<Map<Text, List<Integer>>> = [Map()]\nothers[0][\"a\"] = [1, 2]\nothers[0][\"a\"][1] += 3\nprint(others[0][\"a\"][1])\nprint(make().length)\n", "42\n5\n0\n", 0, "")
    }
    if selected(selectors, "test_map_types_in_imported_records_and_constructors") {
        io.writeTextFile(compiler.directory + "/map-values.min", test.sourceModules("public record Value { text: Text }\npublic function make(): Map<Text, List<Value>> {\nlet result: Map<Text, List<Value>> = Map()\nresult[\"a\"] = [Value { text: \"module\" + \"!\" }]\nreturn result\n}\n"))
        executes(compiler, runtimes, "use \"./map-values.min\" as values\nlet m = values.make()\nprint(m[\"a\"][0].text)\nlet explicit = Map<Text, List<values.Value>>()\nexplicit[\"b\"] = [values.Value { text: \"explicit\" + \"!\" }]\nprint(explicit[\"b\"][0].text)\n", "module!\nexplicit!\n", 0, "")
    }
    if selected(selectors, "test_image_path_dedup_contextual_constructor") {
        executes(compiler, runtimes, "let paths = [\"usr/bin/a\", \"etc/passwd\", \"usr/bin/a\"]\nlet seen: Map<Text, Integer> = Map()\nlet unique: List<Text> = []\nfor p in paths { if !seen.has(p) { seen[p] = unique.length; unique.add(p) } }\nprint(unique.length)\nprint(seen[\"etc/passwd\"])\nprint(seen.remove(\"usr/bin/a\"))\nprint(seen.remove(\"usr/bin/a\"))\nseen.clear()\nprint(seen.length)\n", "2\n1\ntrue\nfalse\n0\n", 0, "")
    }
    if selected(selectors, "test_explicit_constructor_growth_alias_and_replacement") {
        executes(compiler, runtimes, "let seen = Map<Integer, Integer>()\nlet alias = seen\nlet i = 0\nwhile i < 1000 { seen[i] = i * 7; i = i + 1 }\ni = 0\nlet sum = 0\nwhile i < 1000 { sum = sum + alias[i]; i = i + 1 }\nalias[0] = 42\nprint(seen.length)\nprint(sum)\nprint(seen[0])\n", "1000\n3496500\n42\n", 0, "")
    }
    if selected(selectors, "test_managed_values_and_nested_generics") {
        executes(compiler, runtimes, "record Box { text: Text }\nfunction make(): Map<Text, List<Map<Integer, Box>>> {\nlet result: Map<Text, List<Map<Integer, Box>>> = Map()\nlet inner = Map<Integer, Box>()\ninner[9] = Box { text: \"old\" + \"!\" }\nresult[\"key\"] = [inner]\nreturn result\n}\nlet outer = make()\nlet inner = outer[\"key\"][0]\nlet saved = inner[9]\ninner[9] = Box { text: \"new\" + \"!\" }\nouter.clear()\nprint(saved.text)\nprint(inner[9].text)\ninner.clear()\nprint(saved.text)\n", "old!\nnew!\nold!\n", 0, "")
    }
    if selected(selectors, "test_scalar_key_and_value_slots") {
        executes(compiler, runtimes, "let flags = Map<Boolean, Float>()\nflags[true] = 1.5\nprint(flags[true])\nlet letters = Map<Character, Boolean>()\nletters['λ'] = true\nprint(letters['λ'])\nlet floats = Map<Float, Integer>()\nfloats[-0.0] = 7\nprint(floats[0.0])\n", "1.5\ntrue\n7\n", 0, "")
    }
    if selected(selectors, "test_missing_key_is_fatal") {
        executes(compiler, runtimes, "let m = Map<Integer, Integer>()\nprint(m[9])\n", "", 1, "Minyar stopped: Map key is absent.\n")
    }
    if selected(selectors, "test_nan_key_is_fatal_and_float_zeros_are_equal") {
        executes(compiler, runtimes, "let m = Map<Float, Integer>()\nm[0.0] = 1\nm[-0.0] = 2\nprint(m.length)\nprint(m[0.0])\nprint(m.remove(-0.0))\n", "1\n2\ntrue\n", 0, "")
        executes(compiler, runtimes, "let m = Map<Float, Integer>()\nm[math.sqrt(-1.0)] = 1\n", "", 1, "Minyar stopped: NaN cannot be used as a Map key or Set element.\n")
    }
    if selected(selectors, "test_type_and_arity_diagnostics") {
        rejects(compiler, "let m = Map()", "Map() needs a contextual Map<K, V> type")
        rejects(compiler, "let m = Map<Integer>()", "expected ','")
        rejects(compiler, "let m = Map<Bytes, Integer>()", "Map keys must be Hashable: Integer, Text, Character, Boolean, Float, or a finite Hashable record")
        rejects(compiler, "let m = Map<Integer, Nothing>()", "Nothing cannot be used as a value type")
        rejects(compiler, "let m = Map<Integer, Integer>()\nm[\"x\"] = 1", "Map key has the wrong type")
        rejects(compiler, "let m = Map<Integer, Integer>()\nm[1] = \"x\"", "Map value has the wrong type")
        rejects(compiler, "let m = Map<Integer, Integer>()\nm.has()", "expected an expression")
        rejects(compiler, "let m = Map<Integer, Integer>()\nm.clear(1)", "expected ')'")
    }
    if selected(selectors, "test_map_cycles_are_rejected_in_every_frontend") {
        rejects(compiler, "record Node { children: Map<Integer, Node> }\nfunction insert(m: Map<Integer, Node>, n: Node) { m[1] = n }\n", "Map mutation could create a reference cycle")
    }
    if selected(selectors, "test_generic_encoding_limit") {
        let value = "Integer"
        for depth in 0..24 { value = "Map<Integer, " + value + ">" }
        rejects(compiler, "function f(m: " + value + ") { }\n", "generic type nesting exceeds the supported limit")
    }
}
function main(): Integer {
    let selectors: List<Text> = []
    let names = ["test_python_dictionary_model", "test_key_and_value_survive_right_side_clear", "test_managed_growth_and_all_removal_positions", "test_compound_assignment_and_contextual_arguments", "test_map_types_in_imported_records_and_constructors", "test_image_path_dedup_contextual_constructor", "test_explicit_constructor_growth_alias_and_replacement", "test_managed_values_and_nested_generics", "test_scalar_key_and_value_slots", "test_missing_key_is_fatal", "test_nan_key_is_fatal_and_float_zeros_are_equal", "test_type_and_arity_diagnostics", "test_map_cycles_are_rejected_in_every_frontend", "test_generic_encoding_limit"]
    for index in 0..processInfo.argumentCount() {
        let selector = processInfo.argument(index)
        if selector == "-v" || selector == "--verbose" || selector == "-q" || selector == "--quiet" { continue }
        let known = selector == "Maps"
        for name in names { if selector == name || selector == "Maps." + name { known = true } }
        test.check(known, "unknown Map test selector: " + selector)
        selectors.add(selector)
    }
    let compiler = test.compiler()
    run(compiler, runtimes(), selectors)
    test.removeTree(compiler.directory)
    print("Map contracts: passed")
    return 0
}
