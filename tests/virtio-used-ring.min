use "../tools/testing.min" as test
use "../os/shared/virtio/used.min" as used

test.check(used.validOffer(4, 0, 0, 0, false), "empty queue accepts a valid descriptor head")
test.check(used.validOffer(4, 1, 0xFFFE, 3, false), "offer count wraps at 16 bits")
test.check(!used.validOffer(4, 1, 0, 0, true), "outstanding descriptor cannot be offered twice")
test.check(!used.validOffer(4, 4, 0, 0, false), "full queue rejects another offer")
test.check(!used.validOffer(4, 2, 0xFFFE, 0, false), "wrapped full queue rejects another offer")
test.check(!used.validOffer(4, 0, 0, -1, false), "negative descriptor head is rejected")
test.check(!used.validOffer(4, 0, 0, 4, false), "descriptor head past the queue is rejected")

test.check(used.validCompletion(4, 2, 0, 1, 3, true), "one of two outstanding chains may complete")
test.check(used.validCompletion(4, 1, 0xFFFE, 0, 0, true), "completion count wraps at 16 bits")
test.check(!used.validCompletion(4, 2, 1, 2, 0, false), "device cannot replay a completed descriptor head")
test.check(!used.validCompletion(4, 1, 0xFFFE, 2, 0, true), "device cannot complete more chains than are outstanding")
test.check(!used.validCompletion(4, 1, 0, 1, 4, true), "device completion head past the queue is rejected")
test.check(!used.validCompletion(4, 1, 0, 0, 0, true), "unchanged used index is not a completion")
test.check(!used.validCompletion(4, 6, 0, 1, 0, true), "corrupt outstanding count is rejected")
test.check(!used.validCompletion(0, 0, 0, 1, 0, true), "zero-sized queue is rejected")

test.check(used.validLength(8, 8, 8), "complete input event length is accepted")
test.check(!used.validLength(7, 8, 8), "short input event length is rejected")
test.check(!used.validLength(9, 8, 8), "input event length beyond its DMA buffer is rejected")
test.check(!used.validLength(8, 9, 8), "required length beyond capacity is rejected")

test.check(used.validLength(513, 513, 513), "one-sector block data and status length is accepted")
test.check(!used.validLength(512, 513, 513), "block completion missing its status or data byte is rejected")
test.check(!used.validLength(514, 513, 513), "block completion beyond writable capacity is rejected")

print("virtio used-ring validation passed")
