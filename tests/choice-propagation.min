record Label { text: Text }
record IntegerCell { value: Maybe<Integer> }
record LabelCell { value: Maybe<Label> }

choice Delivery {
    Empty
    Words(text: Text, number: Integer)
    Named(item: Label, number: Integer)
    Many(values: List<Text>, number: Integer)
    Work(read: () -> Text, number: Integer)
    Bundle(text: Text, item: Label, values: List<Text>, read: () -> Text, number: Integer)
}

record DeliveryCell { value: Delivery }
record Problem { message: Text }
public function Problem.withContext(context: Text): Problem {
    return Problem { message: context + ": " + self.message }
}

function label(text: Text): Label { return Label { text: text } }
function words(text: Text): List<Text> { return [text] }
function reader(text: Text): () -> Text { return function() { return text } }

function decode(good: Boolean): Result<Integer, Text> {
    if good { return Ok(42) }
    return Err("stopped" + " here")
}

function decodeLabel(good: Boolean): Result<Label, Text> {
    if good { return Ok(label("nullable")) }
    return Err("stopped" + " here")
}

function integerName(value: Maybe<Integer>): Text {
    return match value { Some(number) { Text(number) } None { "none" } }
}

function deliveryName(value: Delivery): Text {
    return match value {
        Empty { "empty" }
        Words(text, number) { text + ":" + Text(number) }
        Named(item, number) { item.text + ":" + Text(number) }
        Many(values, number) { values[0] + ":" + Text(number) }
        Work(read, number) { read() + ":" + Text(number) }
        Bundle(text, item, values, read, number) {
            text + "|" + item.text + "|" + values[0] + "|" + read() + ":" + Text(number)
        }
    }
}

function integerReport(result: Result<Integer, Text>): Text {
    return match result { Ok(value) { "ok " + Text(value) } Err(error) { "error " + error } }
}

function deliveryReport(result: Result<Delivery, Text>): Text {
    return match result { Ok(value) { deliveryName(value) } Err(error) { "error " + error } }
}

function maybeReport(result: Result<Maybe<Integer>, Text>): Text {
    return match result { Ok(value) { integerName(value) } Err(error) { "error " + error } }
}

function succeeded<Item>(result: Result<Item, Text>): Boolean {
    return match result { Ok(_) { true } Err(_) { false } }
}

function storeInteger(cell: IntegerCell, good: Boolean): Result<Integer, Text> {
    cell.value = Some(try decode(good))
    return Ok(42)
}

function returnInteger(good: Boolean): Result<Maybe<Integer>, Text> {
    return Ok(Some(try decode(good)))
}

function addInteger(values: List<Maybe<Integer>>, good: Boolean): Result<Integer, Text> {
    values.add(Some(try decode(good)))
    return Ok(values.length)
}

function textResult(good: Boolean): Result<Delivery, Text> {
    return Ok(Words("owned" + " text", try decode(good)))
}

function recordResult(good: Boolean): Result<Delivery, Text> {
    return Ok(Named(label("owned" + " record"), try decode(good)))
}

function listResult(good: Boolean): Result<Delivery, Text> {
    return Ok(Many(words("owned" + " list"), try decode(good)))
}

function callbackResult(good: Boolean): Result<Delivery, Text> {
    return Ok(Work(reader("owned" + " callback"), try decode(good)))
}

function borrowedResult(text: Text, item: Label, values: List<Text>, read: () -> Text, good: Boolean): Result<Delivery, Text> {
    return Ok(Bundle(text, item, values, read, try decode(good)))
}

function localResult(good: Boolean): Result<Delivery, Text> {
    let value: Delivery = Empty
    value = Words("local" + " value", try decode(good))
    return Ok(value)
}

function storeDelivery(cell: DeliveryCell, good: Boolean): Result<Integer, Text> {
    cell.value = Bundle("owned" + " text", label("owned" + " record"), words("owned" + " list"), reader("owned" + " callback"), try decode(good))
    return Ok(42)
}

function replaceDelivery(values: List<Delivery>, good: Boolean): Result<Integer, Text> {
    values[0] = Words("replaced" + " value", try decode(good))
    return Ok(values.length)
}

function addDelivery(values: List<Delivery>, good: Boolean): Result<Integer, Text> {
    values.add(Words("added" + " value", try decode(good)))
    return Ok(values.length)
}

function literalResult(good: Boolean): Result<List<Delivery>, Text> {
    return Ok([Empty, Words("literal" + " value", try decode(good))])
}

// This constructor has no wrapper allocation before its fallible payload.
function storeNullable(cell: LabelCell, good: Boolean): Result<Integer, Text> {
    cell.value = Some(try decodeLabel(good))
    return Ok(1)
}

function contextualDecode(good: Boolean): Result<Integer, Problem> {
    if good { return Ok(42) }
    return Err(Problem { message: "stopped" + " here" })
}

function context(): Text { print("context evaluated"); return "loading choice" }

function contextualResult(good: Boolean): Result<Delivery, Problem> {
    return Ok(Words("context" + " value", try contextualDecode(good) else context()))
}

function contextualReport(result: Result<Delivery, Problem>): Text {
    return match result { Ok(value) { deliveryName(value) } Err(problem) { "error " + problem.message } }
}

print("maybe")
let integerCell = IntegerCell { value: None }
print(integerReport(storeInteger(integerCell, true)))
print(integerName(integerCell.value))
print(integerReport(storeInteger(integerCell, false)))
print(integerName(integerCell.value))
print(maybeReport(returnInteger(true)))
print(maybeReport(returnInteger(false)))
let integerValues: List<Maybe<Integer>> = []
print(integerReport(addInteger(integerValues, true)))
print(integerReport(addInteger(integerValues, false)))
print(integerValues.length)
print(integerName(integerValues[0]))

print("owned payloads")
print(deliveryReport(textResult(true)))
print(deliveryReport(textResult(false)))
print(deliveryReport(recordResult(true)))
print(deliveryReport(recordResult(false)))
print(deliveryReport(listResult(true)))
print(deliveryReport(listResult(false)))
print(deliveryReport(callbackResult(true)))
print(deliveryReport(callbackResult(false)))

print("borrowed payloads")
let borrowedText = "borrowed" + " text"
let borrowedLabel = label("borrowed" + " record")
let borrowedValues = words("borrowed" + " list")
let borrowedRead = reader("borrowed" + " callback")
let borrowedSuccess = borrowedResult(borrowedText, borrowedLabel, borrowedValues, borrowedRead, true)
print(deliveryReport(borrowedSuccess))
print(deliveryReport(borrowedResult(borrowedText, borrowedLabel, borrowedValues, borrowedRead, false)))
borrowedLabel.text = "changed record"
borrowedValues[0] = "changed list"
print(deliveryReport(borrowedSuccess))
print(borrowedText + "|" + borrowedLabel.text + "|" + borrowedValues[0] + "|" + borrowedRead())

print("storage")
print(deliveryReport(localResult(true)))
print(deliveryReport(localResult(false)))
let deliveryCell = DeliveryCell { value: Empty }
print(integerReport(storeDelivery(deliveryCell, true)))
print(deliveryName(deliveryCell.value))
print(integerReport(storeDelivery(deliveryCell, false)))
print(deliveryName(deliveryCell.value))
let deliveries: List<Delivery> = [Empty]
print(integerReport(replaceDelivery(deliveries, true)))
print(integerReport(replaceDelivery(deliveries, false)))
print(integerReport(addDelivery(deliveries, true)))
print(integerReport(addDelivery(deliveries, false)))
for value in deliveries { print(deliveryName(value)) }
match literalResult(true) {
    Ok(values) { for value in values { print(deliveryName(value)) } }
    Err(error) { print("error " + error) }
}
match literalResult(false) {
    Ok(values) { for value in values { print(deliveryName(value)) } }
    Err(error) { print("error " + error) }
}

print("nullable")
let labelCell = LabelCell { value: None }
print(integerReport(storeNullable(labelCell, true)))
print(match labelCell.value { Some(value) { value.text } None { "none" } })
print(integerReport(storeNullable(labelCell, false)))
print(match labelCell.value { Some(value) { value.text } None { "none" } })

print("context")
print(contextualReport(contextualResult(true)))
print(contextualReport(contextualResult(false)))

print("loops")
let successes = 0
let failures = 0
for index in 0..40 {
    let good = index % 2 == 0
    let outcomes = [
        succeeded(storeInteger(integerCell, good)),
        succeeded(textResult(good)),
        succeeded(recordResult(good)),
        succeeded(listResult(good)),
        succeeded(callbackResult(good)),
        succeeded(borrowedResult(borrowedText, borrowedLabel, borrowedValues, borrowedRead, good)),
        succeeded(localResult(good)),
        succeeded(storeDelivery(deliveryCell, good)),
        succeeded(literalResult(good)),
        succeeded(addDelivery(deliveries, good))
    ]
    for success in outcomes {
        if success { successes += 1 } else { failures += 1 }
    }
}
print(successes)
print(failures)
