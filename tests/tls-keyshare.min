use "tlsverify" as trust
use "crypto" as crypto
function main(): Integer {
    for trial in 0..32 {
        let a=trust.p256Key();let b=trust.p256Key();let ap=trust.p256Public(a);let bp=trust.p256Public(b)
        if a.length==0 || b.length==0 || ap.length!=65 || bp.length!=65 || ap[0]!=4 || bp[0]!=4 || crypto.constantTimeEqual(ap,bp) { return 1 }
        let ab=trust.p256(a,bp);let ba=trust.p256(b,ap)
        if ab.length!=32 || !crypto.constantTimeEqual(ab,ba) || crypto.constantTimeEqual(ab,Bytes(32)) { return 2 }
        for prefix in 0..65 { if trust.p256(a,bp.slice(0,prefix)).length!=0 { return 3 } }
        let invalid=Bytes(65);invalid[0]=4
        if trust.p256(a,invalid).length!=0 { return 4 }
        for at in 1..65 { invalid[at]=255 }
        if trust.p256(a,invalid).length!=0 { return 5 }
        invalid=bp.slice(0,bp.length);invalid[0]=2
        if trust.p256(a,invalid).length!=0 { return 6 }
        invalid=bp.slice(0,bp.length);invalid.add(0)
        if trust.p256(a,invalid).length!=0 || trust.p256(Bytes(32),bp).length!=0 || trust.p256Public(Bytes(32)).length!=0 { return 7 }
    }
    let privateKey=trust.p256Key();let peer=readBytesFile(argument(0))
    let shared=trust.p256(privateKey,peer);if shared.length!=32 { return 8 }
    print("ORACLE "+crypto.hex(trust.p256Public(privateKey))+" "+crypto.hex(shared))
    print("TLS P-256: native random key pairs, bidirectional agreement, every prefix, invalid points and encodings passed")
    return 0
}
