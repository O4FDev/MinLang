// The variable-shift probe as a record method: methods share the Boolean return ABI of functions.
record Bitmap { words: Bytes; count: Integer }
function Bitmap.has(row: Integer): Boolean {
    if self.count >= 4096 { return ((self.words.getInt64((row >> 6) * 8) >> (row & 63)) & 1) != 0 }
    let lo = 0
    let hi = self.count
    while lo < hi {
        let m = (lo + hi) >> 1
        if self.words.getUInt16(m * 2) < row { lo = m + 1 } else { hi = m }
    }
    if lo < self.count { return self.words.getUInt16(lo * 2) == row }
    return false
}
let a = Bytes(16384)
a.setInt64(109 * 8, 144132782409646112)
let sizes = [0, 5042]
let bitmap = Bitmap { words: a; count: sizes[1] }
print(bitmap.has(7000))
print(bitmap.has(6977))
