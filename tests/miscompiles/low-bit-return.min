// Boolean return ABI: `(word & 1) != 0` becomes `trunc i64 to i1`, so an out-of-line callee returned the
// word's low byte (6) while callers read the whole byte as zeroext. Wrong (true) at -O1/-O2 before the fix.
function odd(a: Bytes, count: Integer, row: Integer): Boolean {
    if count >= 4096 { return (a.getInt64(row * 8) & 1) != 0 }
    let lo = 0
    let hi = count
    while lo < hi {
        let m = (lo + hi) >> 1
        if a.getUInt16(m * 2) < row { lo = m + 1 } else { hi = m }
    }
    if lo < count { return a.getUInt16(lo * 2) == row }
    return false
}
let a = Bytes(1024)
a.setInt64(8, 6)
let sizes = [0, 5042]
print(odd(a, 5042, 1))
print(odd(a, sizes[1], 1))
