// KNOWN MISCOMPILE (expected to fail; not wired into any check). Found by lane parsearch, 2026-10-25.
// Expected output: "false\nfalse\n" (bit 24 of word 109 is clear). Observed on Linux x86_64, LLVM 23.1.3, run25
// c442bb34c: -O0 prints false false; -O1 and -O2 print false true. The call with a constant count is right; the
// count read from a List is wrong. Correct at -O2 when the bitmap test uses a mask, (x & (1 << (row & 63))) != 0,
// or when the binary-search tail is removed. Build: minyarc file.min out.ll; clang -O2 out.ll minyar-runtime.o.
function has(a: Bytes, count: Integer, row: Integer): Boolean {
    if count >= 4096 { return ((a.getInt64((row >> 6) * 8) >> (row & 63)) & 1) != 0 }
    let lo = 0
    let hi = count
    while lo < hi {
        let m = (lo + hi) >> 1
        if a.getUInt16(m * 2) < row { lo = m + 1 } else { hi = m }
    }
    if lo < count { return a.getUInt16(lo * 2) == row }
    return false
}
let a = Bytes(16384)
a.setInt64(109 * 8, 144132782409646112)
let sizes = [0, 5042]
let constant = has(a, 5042, 7000)
let computed = has(a, sizes[1], 7000)
print(constant)
print(computed)
