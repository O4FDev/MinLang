// Boolean return ABI regression, found by lane parsearch on 2026-10-25. Call sites emitted
// `call zeroext i1 @.minyar.fn.has` but the definition was `define i1`, so at -O1/-O2 LLVM returned
// `(word >> (row & 63))` in %al without clearing bits 1-7 and the caller's zero extension read 0x80 as true.
// The constant-count call is inlined and was always right; the List-read count calls the out-of-line body.
function has(a: Bytes, count: Integer, row: Integer): Boolean {
    if count >= 4096 { return ((a.getInt64((row >> 6) * 8) >> (row & 63)) & 1) != 0 }
    let lo = 0
    let hi = count
    while lo < hi {
        let m = (lo + hi) >> 1
        if a.getUInt16(m * 2) < row { lo = m + 1 } else { hi = m }
    }
    if lo < count { return a.getUInt16(lo * 2) == row }
    return false
}
let a = Bytes(16384)
a.setInt64(109 * 8, 144132782409646112)
let sizes = [0, 5042]
let constant = has(a, 5042, 7000)
let computed = has(a, sizes[1], 7000)
print(constant)
print(computed)
