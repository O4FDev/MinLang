// A custom Equatable `equal` reached through `==`: the generated equality thunk calls it as `zeroext i1`.
record Probe { words: Bytes; count: Integer; row: Integer }
function Probe.equal(other: Probe): Boolean {
    let row = other.row
    if self.count >= 4096 { return ((self.words.getInt64((row >> 6) * 8) >> (row & 63)) & 1) != 0 }
    let lo = 0
    let hi = self.count
    while lo < hi {
        let m = (lo + hi) >> 1
        if self.words.getUInt16(m * 2) < row { lo = m + 1 } else { hi = m }
    }
    if lo < self.count { return self.words.getUInt16(lo * 2) == row }
    return false
}
conform Probe to Equatable
let a = Bytes(16384)
a.setInt64(109 * 8, 144132782409646112)
let sizes = [0, 5042]
let left = Probe { words: a; count: sizes[1]; row: 0 }
let right = Probe { words: a; count: sizes[1]; row: 7000 }
print(left == right)
print(left != right)
