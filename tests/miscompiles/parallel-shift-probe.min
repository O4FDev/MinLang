// The variable-shift probe as a `parallel function`: same Boolean return ABI mismatch, same wrong result.
parallel function has(a: Bytes, count: Integer, row: Integer): Boolean {
    if count >= 4096 { return ((a.getInt64((row >> 6) * 8) >> (row & 63)) & 1) != 0 }
    let lo = 0
    let hi = count
    while lo < hi {
        let m = (lo + hi) >> 1
        if a.getUInt16(m * 2) < row { lo = m + 1 } else { hi = m }
    }
    if lo < count { return a.getUInt16(lo * 2) == row }
    return false
}
let a = Bytes(16384)
a.setInt64(109 * 8, 144132782409646112)
let sizes = [0, 5042]
print(has(a, 5042, 7000))
print(has(a, sizes[1], 7000))
