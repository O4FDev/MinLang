use "process" as processInfo
use "../tools/testing.min" as test
use "../tools/check-runner.min" as runner
use "system" as system
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
if processInfo.argumentCount() > 0 {
    test.check(processInfo.argumentCount() == 2 && processInfo.argument(0) == "--clang", "expected optional --clang value")
    clang = processInfo.argument(1)
}
let work = test.scratch()
let environment = runner.environment(system.environment(), "ASAN_OPTIONS", "detect_leaks=0:abort_on_error=1")
environment = runner.environment(environment, "UBSAN_OPTIONS", "halt_on_error=1:print_stacktrace=1")
for profile in ["system", "fixed", "lazy"] {
    for budget in [1, 2, 32, 1024] {
        for mode in ["native", "sanitize"] {
            let executable = work + "/" + profile + "-" + Text(budget) + "-" + mode
            let command = [clang, "-std=c11", "-Wall", "-Wextra", "-Werror", "-O2"]
            if profile == "system" { command.add("-DMINYAR_SYSTEM_HEAP=1") }
            else { command.add("-DMINYAR_BOUNDED_HEAP=1") }
            if profile == "lazy" { command.add("-DMINYAR_LAZY_HEAP=1") }
            command.add("-DMINYAR_RC_POLL_BUDGET=" + Text(budget))
            if mode == "sanitize" {
                command.add("-g")
                command.add("-fsanitize=address,undefined")
            }
            for item in ["tests/text-view-budget.c", "-lm", "-o", executable] { command.add(item) }
            test.require(test.run(command, environment, "", work + "/compile", 90), "Text backing root budget compile")
            test.require(test.run([executable], environment, "", work + "/run", 30), "Text backing root budget execution")
            print(profile + " K" + Text(budget) + " " + mode + ": passed")
        }
    }
}
test.removeTree(work)
