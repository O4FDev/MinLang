use "process" as processInfo
use "erofs" as erofs
use "errors" as errors

let options = erofs.defaults()
if processInfo.argument(0) == "lz4" { options.compression = erofs.LZ4 }
if processInfo.argument(0) == "zstd" { options.compression = erofs.ZSTD }
if processInfo.argument(0) == "bounded" { options.maximumBytes = 65536 }
let layers: List<Text> = []
for index in 2..processInfo.argumentCount() { layers.add(processInfo.argument(index)) }
let error = erofs.writeLayers(layers, processInfo.argument(1), options)
if errors.isError(error) { fail("erofs layers: " + Text(errors.nativeCode(error)) + " " + errors.message(error)) }
print("EROFS_LAYERS_PASS")
