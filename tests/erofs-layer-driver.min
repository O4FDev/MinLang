use "erofs" as erofs
use "errors" as errors

let options = erofs.defaults()
if argument(0) == "lz4" { options.compression = erofs.LZ4 }
if argument(0) == "zstd" { options.compression = erofs.ZSTD }
let layers: List<Text> = []
for index in 2..argumentCount() { layers.add(argument(index)) }
let error = erofs.writeLayers(layers, argument(1), options)
if errors.isError(error) { fail("erofs layers: " + Text(errors.nativeCode(error)) + " " + errors.message(error)) }
print("EROFS_LAYERS_PASS")
