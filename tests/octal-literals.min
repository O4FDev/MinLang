use "../tools/testing.min" as test
function octal(value: Integer): Text {
    let negative = value < 0
    let remaining = value
    if remaining > 0 { remaining = -remaining }
    let digits = "01234567"
    let result = ""
    while remaining < 0 {
        result = Text(digits[-(remaining % 8)]) + result
        remaining /= 8
    }
    if result == "" { result = "0" }
    if negative { return "-0o" + result }
    return "0o" + result
}
let compiler = test.compiler()
let values = [0, 1, 7, 8, 493, 1023, 9223372036854775807, -9223372036854775808]
let state = 20261012
for index in 0..32 {
    state = wrappingAdd(wrappingMultiply(state, 6364136223846793005), 1442695040888963407)
    values.add(state)
}
let source = ""
let expected = ""
for value in values {
    source += "print(" + octal(value) + ")\n"
    expected += Text(value) + "\n"
}
source += "constant MODE: Integer = 0o755\nprint(MODE)\nprint(0.25)\nprint(0xFF)\n"
test.executes(compiler, source, expected + "493\n0.25\n255\n")
for literal in ["00", "01", "0755", "-0002", "0009223372036854775808"] {
    test.rejects(compiler, "print(" + literal + ")\n", "decimal Integer literals cannot have a leading zero; use 0o for octal")
}
test.executes(compiler, "print(0)\nprint(-0)\nfor i in 0..2 { print(i) }\n", "0\n0\n0\n1\n")
for literal in ["0o", "0o8", "0o9", "0o78", "0o755x", "0o7_1"] {
    test.rejects(compiler, "print(" + literal + ")\n", "an octal Integer literal needs only digits 0 through 7 after 0o")
}
test.rejects(compiler, "print(0o7.5)\n", "octal literals are Integers and cannot have a decimal point")
for literal in ["0o1000000000000000000000", "-0o1000000000000000000001", "0o77777777777777777777777"] {
    test.rejects(compiler, "constant UNUSED = " + literal + "\nprint(1)\n", "Integer literal is outside the supported range")
}
test.removeScratch(compiler.directory)
print("octal literals: passed")
