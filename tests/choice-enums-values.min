choice Signal { Low; Middle; High }
choice Flag<Item> { Raised; Lowered }
type Light = Signal
record Reading { signal: Signal }
choice Delivery { Quiet; State(signal: Signal); Message(text: Text) }

function Signal.code(): Integer {
    return match self { Low { 0 } Middle { 1 } High { 2 } }
}

function identity<Item>(value: Item): Item { return value }
function ordered<Item: Ordered>(left: Item, right: Item): Boolean { return left < right }
function nativeSignal(value: Signal): Signal { native "choice_enum_abi" }
function remembered(value: Signal): (Signal) -> Signal {
    return function(other: Signal): Signal { if other == Low { return value }; return other }
}

let light: Light = identity(Middle)
print(light.code())
print(ordered(Signal.Low, Signal.High))
print(Flag<Integer>.Raised == Flag<Integer>.Raised)
let recall = remembered(High)
print(recall(Low).code())
print(recall(Middle).code())

let signals: List<Signal> = [High, Low, Middle]
let compare = function(left: Signal, right: Signal): Integer {
    if left < right { return 1 }
    if left > right { return -1 }
    return 0
}
let descending = signals.sortedBy(compare)
signals.sortBy(compare)
for index in 0..signals.length { print(signals[index] == descending[index]) }
print(signals[0].code())
signals.sort()
print(signals[0].code())
let nested: List<List<Signal>> = [signals, [High]]
nested[1].add(Middle)
nested[1][0] = Low
print(nested[1][0].code())
print(nested[1][1].code())

let values: Map<Signal, Signal> = Map()
values[Low] = High
values[Middle] = Low
let same: Map<Signal, Signal> = Map()
same[Middle] = Low
same[Low] = High
print(values == same)
same[Low] = Middle
print(values == same)
print(values[Low].code())
let tables: Map<Signal, Map<Signal, Signal>> = Map()
tables[Low] = values
let copies: Map<Signal, Map<Signal, Signal>> = Map()
copies[Low] = values
print(tables == copies)
record Key { signal: Signal }
let recordTables: Map<Key, Map<Signal, Signal>> = Map()
recordTables[Key { signal: Low }] = values
let recordCopies: Map<Key, Map<Signal, Signal>> = Map()
recordCopies[Key { signal: Low }] = values
print(recordTables == recordCopies)

let keys: Set<Signal> = Set()
keys.add(Low); keys.add(High); keys.add(Low)
print(keys.length)
print(keys.contains(Middle))
print(keys.remove(High))
let readings: Map<Reading, Integer> = Map()
let reading = Reading { signal: Low }
readings[reading] = 42
reading.signal = High
print(readings[Reading { signal: Low }])
print(readings.has(reading))
let deliveries: Map<Delivery, Integer> = Map()
deliveries[State(High)] = 7
print(deliveries[State(High)])
print(State(Low) == State(Low))
print(State(Low) < State(High))

let output: List<Signal> = [Low, Low, Low, Low]
let selected: Signal = High
parallel for index in 0..output.length { output[index] = selected }
for signal in output { print(signal == High) }
print(nativeSignal(Low).code())
print(nativeSignal(Middle).code())
print(nativeSignal(High).code())

let signalLists: Map<Signal, List<Signal>> = Map()
signalLists[Low] = [Middle, High]
print(signalLists[Low][1].code())
signalLists[Low][0] = Low
print(signalLists[Low][0].code())
let signalReadings: Map<Signal, Reading> = Map()
let sharedReading = Reading { signal: Middle }
signalReadings[High] = sharedReading
sharedReading.signal = Low
print(signalReadings[High].signal.code())
signalReadings[High] = Reading { signal: High }
print(signalReadings[High].signal.code())
