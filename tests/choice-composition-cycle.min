choice Tone { Soft; Clear }
record Node { tone: Tone; next: Maybe<Node>; ring: List<Maybe<Node>> }
record Wire native "c" { tone: Tone; number: Integer }
function toneName(tone: Tone): Text { return match tone { Soft { "soft" } Clear { "clear" } } }

print("cycles")
let ring: List<Maybe<Node>> = []
let node = Node { tone: Soft; next: None; ring: ring }
node.next = Some(node)
ring.add(Some(node))
let wrapped: Maybe<Node> = Some(node)
let alias = wrapped
let saved = match (wrapped) { Some(value) { value } None { node } }
wrapped = None
node.next = None
ring[0] = None
node = Node { tone: Soft; next: None; ring: [] }
saved.tone = Clear
print(toneName(saved.tone))
print(match alias { Some(value) { toneName(value.tone) } None { "none" } })
print(match wrapped { Some(value) { toneName(value.tone) } None { "none" } })
print(match ring[0] { Some(value) { toneName(value.tone) } None { "empty ring" } })
saved.next = Some(saved)
saved.ring[0] = Some(saved)
saved.tone = Soft
print(match saved.next { Some(value) { toneName(value.tone) } None { "none" } })
print(match saved.ring[0] { Some(value) { toneName(value.tone) } None { "none" } })

print("wrappers")
let missing: Maybe<Tone> = None
let first: Maybe<Tone> = Some(Soft)
print(missing == first)
print(first == Some(Soft))
let values: List<Maybe<Tone>> = [missing, first]
for value in values { print(match value { Some(tone) { toneName(tone) } None { "none" } }) }
let entries: Map<Maybe<Tone>, Integer> = Map()
entries[missing] = 7
entries[first] = 42
print(entries.length)
print(entries[None])
print(entries[Some(Soft)])

print("native fields")
let wire = Wire { tone: Soft; number: 42 }
print(toneName(wire.tone))
wire.tone = Clear
print(toneName(wire.tone))
print(wire.number)
