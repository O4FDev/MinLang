    executes(context, "record Segment native \"c\" { selector: UInt16; base: UInt64 }\nrecord Outer native \"c\" { tag: UInt8; segment: Segment; limit: UInt32 }\nlet bytes = Bytes(16)\nlet value = cView(Segment, bytes, 0)\nvalue.base = 42\nbytes.resize(17)\n", "", 1, "Minyar stopped: Bytes storage with C-layout views cannot grow.\n")
    executes(context, "record Segment native \"c\" { selector: UInt16; base: UInt64 }\nrecord Outer native \"c\" { tag: UInt8; segment: Segment; limit: UInt32 }\nlet bytes = Bytes(16)\nlet value = cView(Segment, bytes, 0)\nvalue.base = 42\nbytes.resize(0); bytes.resize(16)\n", "", 1, "Minyar stopped: Bytes storage with C-layout views cannot grow.\n")
    executes(context, "record Segment native \"c\" { selector: UInt16; base: UInt64 }\nrecord Outer native \"c\" { tag: UInt8; segment: Segment; limit: UInt32 }\nlet bytes = Bytes(16)\nlet value = cView(Segment, bytes, 0)\nvalue.base = 42\nbytes.add(1)\n", "", 1, "Minyar stopped: Bytes storage with C-layout views cannot grow.\n")
}
if selected("test_native_append_cannot_move_pinned_storage") {
    executes(context, "record Segment native \"c\" { selector: UInt16; base: UInt64 }\nrecord Outer native \"c\" { tag: UInt8; segment: Segment; limit: UInt32 }\nfunction appendZero(bytes: Bytes): Integer { native \"layout\" }\nfunction append(bytes: Bytes): Integer { native \"layout\" }\nlet bytes = Bytes(16)\nlet value = cView(Segment, bytes, 0)\nvalue.base = 42\nprint(appendZero(bytes)); print(value.base)\nbytes.resize(8)\nprint(appendZero(bytes)); print(value.base)\nprint(append(bytes))\n", "1\n42\n1\n42\n", 1, "Minyar stopped: Bytes storage with C-layout views cannot grow.\n")
}
if selected("test_bounds_integer_width_null_return_and_alignment_diagnostics") {
    executes(context, "record R native \"c\" { value: UInt8 }\nlet value = R { value: 256 }\n", "", 1, "Minyar stopped: an Integer does not fit in its C-layout field.\n")
    executes(context, "record Segment native \"c\" { selector: UInt16; base: UInt64 }\nrecord Outer native \"c\" { tag: UInt8; segment: Segment; limit: UInt32 }\nlet value = cView(Segment, Bytes(16), 1)\n", "", 1, "Minyar stopped: a C-layout view must fit within its backing Bytes.\n")
    executes(context, "record Mixed native \"c\" {\n    tag: UInt8; delta: Int16; count: UInt32; mask: UInt64\n    narrow: Float32; wide: Float64; enabled: Boolean; bytes: Bytes[3]\n}\nfunction null(): Mixed { native \"layout\" }\nlet value = null()\n", "", 1, "Minyar stopped: a native C-layout record returned a null pointer.\n")
    executes(context, "record Mixed native \"c\" {\n    tag: UInt8; delta: Int16; count: UInt32; mask: UInt64\n    narrow: Float32; wide: Float64; enabled: Boolean; bytes: Bytes[3]\n}\nfunction verify(value: Mixed): Integer { native \"layout\" }\nlet value = cView(Mixed, Bytes(41), 1)\nprint(verify(value))\n", "", 1, "Minyar stopped: a native C-layout record pointer is not correctly aligned.\n")
}
if selected("test_managed_holders_callbacks_and_results_keep_C_owners") {
    executes(context, "record Segment native \"c\" { selector: UInt16; base: UInt64 }\nrecord Outer native \"c\" { tag: UInt8; segment: Segment; limit: UInt32 }\nrecord Holder { segment: Segment; label: Text }\nfunction make(): Callback<Integer, Segment> {\n    let holder = Holder { segment: Segment { selector: 7; base: 40 }; label: \"held\" }\n    return function(delta: Integer): Segment {\n        holder.segment.base += delta\n        return holder.segment\n    }\n}\nfunction success(value: Segment): Result<Segment, Text> { return Ok<Segment, Text>(value) }\nlet callback = make()\nlet value = callback(2)\nlet values: List<Segment> = [value, callback(1)]\nprint(value.base); print(values[1].base)\nlet result = success(value)\nmatch result { Ok(held) { print(held.base); print(held.selector) } Err(error) { fail(error) } }\n", "43\n43\n43\n7\n", 0, "")
}
if selected("test_recovery_preserves_pointer_and_value_native_ownership") {
    executes(context, "use \"calldepth\" as depth\nuse \"errors\" as errors\nrecord Single native \"c\" { bits: UInt64 }\nfunction pendingPointer(): Single { native \"layout\" }\nfunction pendingValue(): Single { native \"layout\" value }\nlet pointer = depth.run(4, function(): Integer { let value = pendingPointer(); return value.bits })\nlet value = depth.run(4, function(): Integer { let record = pendingValue(); return record.bits })\nprint(errors.integerOk(pointer)); print(errors.integerOk(value)); print(\"alive\")\n", "false\nfalse\nalive\n", 0, "")
}
if selected("test_native_layout_past_the_first_thousand_nominal_types") {
    let records: List<Text> = []
    for index in 0..1001 { records.add("record R" + Text(index) + " {}\n") }
    executes(context, joinText(records) + "record Single native \"c\" { bits: UInt64 }\nfunction nominal(value: Single): Integer { native \"layout\" }\nprint(nominal(Single { bits: 42 }))\n", "1\n", 0, "")
}
if selected("test_ordinary_functions_can_use_layout_builtin_names") {
    executes(context, "function sizeOf(): Integer { return 42 }\nfunction answer(): Integer { native \"c\" }\nrecord Plain { value: Integer }\nprint(sizeOf()); print(answer()); print(Plain { value: 21 }.value)\n", "42\n7\n21\n", 0, "")
}
if selected("test_invalid_layouts_and_managed_record_diagnostics") {
    let result = compile(context, "record R native \"c\" { value: Text }\n")
    test.check(result.status == 1, "invalid C-layout rejection status")
    test.check(test.contains(result.errorOutput, "C-layout fields require"), "invalid C-layout diagnostic")
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "invalid C-layout emitted LLVM")
    result = compile(context, "record R native \"c\" { value: Bytes }\n")
    test.check(result.status == 1, "invalid C-layout rejection status")
    test.check(test.contains(result.errorOutput, "expected '['"), "invalid C-layout diagnostic")
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "invalid C-layout emitted LLVM")
    result = compile(context, "record R native \"c\" {}\n")
    test.check(result.status == 1, "invalid C-layout rejection status")
    test.check(test.contains(result.errorOutput, "must contain at least one field"), "invalid C-layout diagnostic")
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "invalid C-layout emitted LLVM")
    result = compile(context, "record R native \"c\" { value: R }\n")
    test.check(result.status == 1, "invalid C-layout rejection status")
    test.check(test.contains(result.errorOutput, "recursive inline fields"), "invalid C-layout diagnostic")
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "invalid C-layout emitted LLVM")
    result = compile(context, "record M { value: Integer }\nrecord R native \"c\" { value: M }\n")
    test.check(result.status == 1, "invalid C-layout rejection status")
    test.check(test.contains(result.errorOutput, "cannot contain a managed record"), "invalid C-layout diagnostic")
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "invalid C-layout emitted LLVM")
    result = compile(context, "record R native \"c\" { value: UInt8 }\nlet value = R {}\n")
    test.check(result.status == 1, "invalid C-layout rejection status")
    test.check(test.contains(result.errorOutput, "missing field 'value'"), "invalid C-layout diagnostic")
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "invalid C-layout emitted LLVM")
    result = compile(context, "record R native \"c\" { value: UInt8 }\nlet value = R { value: true }\n")
    test.check(result.status == 1, "invalid C-layout rejection status")
    test.check(test.contains(result.errorOutput, "wrong type"), "invalid C-layout diagnostic")
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "invalid C-layout emitted LLVM")
    result = compile(context, "record R { value: UInt8 }\n")
    test.check(result.status == 1, "invalid C-layout rejection status")
    test.check(test.contains(result.errorOutput, "unknown type 'UInt8'"), "invalid C-layout diagnostic")
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "invalid C-layout emitted LLVM")
}
if selected("test_native_package_driver_builds_and_reuses_aggregate_adapters") {
    writeTextFile(compiler.directory + "/layout.min", "public record Pair native \"c\" { bits: UInt64; value: Float64 }\npublic function pair(value: Pair, add: Integer, scale: Float): Pair { native \"layout\" value }\n")
    test.require(compile(context, "use \"./layout.min\" as layout\nlet value = layout.pair(layout.Pair { bits: 40; value: 1.5 }, 2, 2.0)\nprint(value.bits); print(value.value); print(sizeOf(layout.Pair))\n"), "compile native package adapter")
    let path = compiler.directory + "/case" + Text(compiler.serial)
    for optimization in ["-O0", "-O2"] {
        let executable = compiler.directory + "/package-" + optimization
        let options: List<Text> = []
        for flag in context.target { options.add(flag) }
        for flag in compiler.flags { options.add(flag) }
        options.add(optimization)
        let nativeFlags = joinFlags(options)
        options.add("-Wno-override-module")
        let environment: List<Text> = []
        for entry in system.environment() {
            if !starts(entry, "MINYAR_CLANG=") && !starts(entry, "MINYAR_CLANG_FLAGS=") && !starts(entry, "MINYAR_NATIVE_FLAGS=") && !starts(entry, "MINYAR_LINK_ARTIFACTS=") { environment.add(entry) }
        }
        environment.add("MINYAR_CLANG=" + compiler.clang)
        environment.add("MINYAR_CLANG_FLAGS=" + joinFlags(options))
        environment.add("MINYAR_NATIVE_FLAGS=" + nativeFlags)
        let command = ["python3", root + "/tools/clang-driver.py", "link", root, path + ".ll", compiler.runtime, executable, "0", "0", path + ".min", "--native-source", "layout=" + root + "/tests/c-layout-records.c"]
        for repeat in 0..2 {
            test.require(test.run(command, environment, "", path + ".package-link", 180), "production native adapter build/reuse")
            let run: List<Text> = []
            for item in context.runner { run.add(item) }
            run.add(executable)
            let result = test.run(run, system.environment(), "", path + ".package-run", 180)
            test.check(result.status == 0 && result.output == "42\n3.0\n16\n" && result.errorOutput == "", "native aggregate adapter execution")
        }
    }
}
if selected("test_storage_owner_counts_and_nested_cleanup") {
    for optimization in ["-O0", "-O2"] {
        let executable = compiler.directory + "/storage-" + optimization
        let command = [compiler.clang]
        for flag in context.target { command.add(flag) }
        command.add(optimization)
        for flag in compiler.flags { command.add(flag) }
        for item in ["-DMINYAR_SYSTEM_HEAP=1", "tests/c-layout-storage.c", "-pthread", "-lm", "-o", executable] { command.add(item) }
        test.require(test.run(command, system.environment(), "", executable + ".build", 180), "compile C-layout storage ownership")
        command = []
        for item in context.runner { command.add(item) }
        command.add(executable)
        let result = test.run(command, system.environment(), "", executable + ".run", 180)
        test.check(result.status == 0 && result.output == "C-layout roots, nested views, borrowed addresses and ordinary Bytes passed\n" && result.errorOutput == "", "C-layout storage ownership")
        for state in ["pinned", "shrunk"] {
            let rejection: List<Text> = []
            for item in command { rejection.add(item) }
            rejection.add(state)
            result = test.run(rejection, system.environment(), "", executable + ".reject", 30)
            test.check(result.status == 1 && result.output == "" && result.errorOutput == "Minyar stopped: these Bytes cannot be detached.\n", "C-layout detach rejection " + state)
        }
    }
}
test.removeTree(compiler.directory)
print("C-layout records, aggregate ABI and ownership: passed")
