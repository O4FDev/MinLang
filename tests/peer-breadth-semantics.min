function cases(): List<Case> {
    return [test_go_branch_counts_and_three_binding_levels(), test_else_if_conditions_stop_after_selected_arm(), test_condition_record_rechecks_after_continue_but_not_break(), test_nested_range_endpoint_effects_are_per_entry(), test_loop_shadow_initializer_escapes_before_continue(), test_unused_nested_boolean_literals_keep_effect_schedule(), test_nested_constructor_effects_follow_source_depth(), test_three_arguments_capture_old_replacement_and_new_scalar(), test_compound_index_update_captures_between_effects(), test_loop_field_replacement_keeps_storage_and_live_element_updates(), test_mixed_wide_record_survives_recursive_return_and_field_write(), test_interval_algebra_returns_independent_endpoint_records(), test_mixed_record_branch_returns_preserve_all_field_kinds(), test_returned_ragged_record_topology_keeps_empty_rows(), test_fresh_and_shared_record_fill_have_distinct_mutation_results(), test_shared_record_fields_diverge_on_one_field_replacement(), test_borrowed_nested_record_returns_after_parent_is_replaced(), test_managed_loop_binding_survives_slot_overwrite_and_transfers(), test_deep_snapshot_and_sibling_aliases_split_at_inner_replacement(), test_record_bytes_slice_keeps_numeric_snapshot_after_field_rebind(), test_rational_normalization_moves_sign_and_canonicalizes_zero(), test_ragged_gcd_fold_returns_scalars_independent_of_rows(), test_extrema_initializer_captures_before_and_after_mutation(), test_divmod_record_recomposes_saved_operands_after_input_overwrite(), test_signed_shift_results_pack_in_order_across_returned_bytes()]
}
function pilot(): List<Text> { return ["test_else_if_conditions_stop_after_selected_arm", "test_unused_nested_boolean_literals_keep_effect_schedule", "test_mixed_wide_record_survives_recursive_return_and_field_write", "test_managed_loop_binding_survives_slot_overwrite_and_transfers", "test_rational_normalization_moves_sign_and_canonicalizes_zero"] }
function text(value: Text): json.Value { return json.Value { kind: json.STRING; text: value; number: 0.0; truth: false; items: []; keys: [] } }
function integer(value: Integer): json.Value { return json.Value { kind: json.NUMBER; text: Text(value); number: Float(value); truth: false; items: []; keys: [] } }
function decimal(value: Float): json.Value { return json.Value { kind: json.NUMBER; text: Text(value); number: value; truth: false; items: []; keys: [] } }
function truth(value: Boolean): json.Value {
    let spelling = "false"
    if value { spelling = "true" }
    return json.Value { kind: json.BOOLEAN; text: spelling; number: 0.0; truth: value; items: []; keys: [] }
}
function array(items: List<json.Value>): json.Value { return json.Value { kind: json.ARRAY; text: ""; number: 0.0; truth: false; items: items; keys: [] } }
function object(keys: List<Text>, items: List<json.Value>): json.Value { return json.Value { kind: json.OBJECT; text: ""; number: 0.0; truth: false; items: items; keys: keys } }
function texts(values: List<Text>): json.Value {
    let items: List<json.Value> = []
    for value in values { items.add(text(value)) }
    return array(items)
}
function contract(item: Case): json.Value {
    return object(["category", "peer", "compatibility", "closest_existing", "new_contract"], [text(item.category), text(item.peer), text(item.compatibility), text(item.closest), text(item.difference)])
}
function ledger(item: Case): json.Value {
    return object(["observed_status", "category", "peer", "compatibility", "closest_existing", "new_contract"], [text(item.status), text(item.category), text(item.peer), text(item.compatibility), text(item.closest), text(item.difference)])
}
function override(flag: Text): Boolean {
    if flag == "-Ofast" { return true }
    let raw = Bytes(flag)
    if raw.length != 3 || raw[0] != 45 || raw[1] != 79 { return false }
    for allowed in Bytes("0123szg") { if raw[2] == allowed { return true } }
    return false
}
function usage(message: Text) {
    system.writeStandardError("usage: peer-breadth-semantics [--pilot] [--list-cases] [--run-record RUN_RECORD] [tests ...]\npeer-breadth-semantics: error: " + message + "\n")
    exit(2)
}
function attempt(compiler: test.Compiler, item: Case): Text {
    let compiled = test.compile(compiler, item.source)
    if compiled.status != 0 { return "compilation failed (" + Text(compiled.status) + ")\n" + compiled.errorOutput }
    let path = compiler.directory + "/case" + Text(compiler.serial)
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization]
        for flag in compiler.flags { command.add(flag) }
        for part in ["-Wno-override-module", path + ".ll", compiler.runtime, "-o", path + optimization, "-lm"] { command.add(part) }
        let linked = test.run(command, system.environment(), "", path + optimization + ".link", compiler.linkTimeout)
        if linked.status != 0 { return "link failed at " + optimization + "\n" + linked.errorOutput }
        let result = test.run([path + optimization], system.environment(), "", path + optimization + ".run", compiler.runTimeout)
        if result.status != 0 { return "execution at " + optimization + " exited " + Text(result.status) + "\n" + result.errorOutput }
        if result.errorOutput != "" { return "execution at " + optimization + " wrote standard error\n" + result.errorOutput }
        if result.output != item.expected { return "execution at " + optimization + " printed\n" + result.output + "expected\n" + item.expected }
    }
    return ""
}
function digestFile(path: Text): Text { return sha256.hex(sha256.digest(readBytesFile(path))) }

let all = cases()
let listCases = false
let pilotOnly = false
let runRecord = ""
let requested: List<Text> = []
let index = 0
while index < argumentCount() {
    let value = argument(index)
    index += 1
    if value == "--pilot" { pilotOnly = true; continue }
    if value == "--list-cases" { listCases = true; continue }
    if value == "--run-record" {
        if index >= argumentCount() { usage("argument --run-record: expected one argument") }
        runRecord = argument(index)
        index += 1
        continue
    }
    if Bytes(value).length > 13 && Text(Bytes(value).slice(0, 13)) == "--run-record=" {
        runRecord = Text(Bytes(value).slice(13, Bytes(value).length))
        continue
    }
    requested.add(value)
}
if listCases {
    let keys: List<Text> = []
    let items: List<json.Value> = []
    for item in all { keys.add(item.name); items.add(contract(item)) }
    print(json.pretty(object(keys, items), ""))
    exit(0)
}
let names = requested
if pilotOnly { names = pilot() }
if names.length == 0 { for item in all { names.add(item.name) } }
for name in names {
    let known = false
    for item in all { if item.name == name { known = true } }
    if !known { usage("Unknown case: " + name) }
}
for flag in test.words(test.setting("MINYAR_TEST_LINK_FLAGS", "")) { if override(flag) { usage("O0/O2 coverage requires link flags without optimization overrides.") } }
let compiler = test.compiler()
let started = system.monotonicNanoseconds()
let failures = 0
let attempted = 0
for name in names {
    for item in all {
        if item.name != name { continue }
        attempted += 1
        let failure = attempt(compiler, item)
        if failure == "" {
            item.status = "passed_O0_O2"
            print(name + " (PeerBreadthSemantics." + name + ") ... ok")
        } else {
            item.status = "failed"
            failures += 1
            print(name + " (PeerBreadthSemantics." + name + ") ... FAIL")
            system.writeStandardError("FAIL: " + name + "\n" + failure + "\n")
        }
    }
}
test.removeTree(compiler.directory)
let elapsed = Float(system.monotonicNanoseconds() - started) / 1000000000.0
print("Ran " + Text(attempted) + " tests in " + Text(elapsed) + "s")
if failures == 0 { print("OK") } else { print("FAILED (failures=" + Text(failures) + ")") }
if runRecord != "" {
    let passed = 0
    let categories: List<Text> = []
    let caseKeys: List<Text> = []
    let caseItems: List<json.Value> = []
    for item in all {
        if item.status == "passed_O0_O2" { passed += 1 }
        let seen = false
        for category in categories { if category == item.category { seen = true } }
        if !seen { categories.add(item.category) }
        caseKeys.add(item.name)
        caseItems.add(ledger(item))
    }
    let command = ["peer-breadth-semantics"]
    for position in 0..argumentCount() { command.add(argument(position)) }
    let status = "passed"
    if failures > 0 { status = "failed" }
    let identities = object(["tests/peer-breadth-semantics.min", compiler.executable, compiler.runtime],
        [text(digestFile("tests/peer-breadth-semantics.min")), text(digestFile(compiler.executable)), text(digestFile(compiler.runtime))])
    let record = object(["schema", "status", "command", "authored_cases", "selected_cases", "attempted_cases", "executed_cases", "elapsed_seconds", "passed_cases", "categories", "peers", "validation_dimensions", "clang", "link_flags", "retained_manifests", "coverage_only_unless_observed_contract_failure", "identities", "cases"],
        [text("minyar-breadth-semantic-progress-v1"), text(status), texts(command), integer(all.length), integer(names.length), integer(attempted), integer(passed), decimal(elapsed), integer(passed),
         texts(categories.sorted()), texts(["Go", "Zig", "Swift", "LLVM/libc++"]), texts(["O0", "O2"]), text(compiler.clang), texts(compiler.flags),
         texts(["research/2026-10-memory/peer-readonly-go-zig-round3.json", "research/2026-10-memory/peer-readonly-swift-round7.json", "research/2026-10-memory/peer-readonly-values-round9.json"]),
         truth(true), identities, object(caseKeys, caseItems)])
    writeTextFile(runRecord, json.pretty(record, "") + "\n")
}
if failures > 0 { exit(1) }
