function test_go_branch_counts_and_three_binding_levels(): Case {
    return Case { name: "test_go_branch_counts_and_three_binding_levels"; category: "control_scope"; peer: "go-zig-round3:I1-I9/P8"; compatibility: "Ordinary if/else; initializer clauses become explicit helper scope."; closest: "scalar-record-storage:test_shadowing_and_conditional_scopes"; difference: "One nine-branch count sequence and explicit initializer/body/outer shadow levels."; status: "authored_unexecuted"; expected: "1\n0\n1\n0\n1\n1\n-1\n-1\n-1\n1\n"; source: "function counts(): Integer {
let count = 0
if true { count += 1 }; print(count)
count = 0; if false { count += 1 }; print(count)
count = 0; let t = 1; if true { count += t }; print(count)
count = 0; if false { count += t }; print(count)
count = 0; if t == 1 { count += 1 }; print(count)
count = 0; if true { count += 1 } else { count -= 1 }; print(count)
count = 0; if false { count += 1 } else { count -= 1 }; print(count)
count = 0
if true { let t = 7; if false { count += t } else { let t = -1; count += t } }
print(count)
count = 0
if false { let t = 7; count += t } else { let t = -1; count += t }
print(count)
return t
}
print(counts())
" }
}
