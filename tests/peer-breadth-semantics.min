function test_rational_normalization_moves_sign_and_canonicalizes_zero(): Case {
    return Case { name: "test_rational_normalization_moves_sign_and_canonicalizes_zero"; category: "numeric_composition"; peer: "values-round9:P1/G1-G3,L4,W1"; compatibility: "Original rational normalization with representable abs inputs; no std::gcd API/constexpr/unsigned behavior."; closest: "memory-research-peer-projections:test_euclidean_remainder_composes_at_signed_boundaries"; difference: "Euclid feeds returned numerator/denominator normalization, sign movement and zero canonicalization."; status: "authored_unexecuted"; expected: "-3\n4\n3\n4\n0\n1\n2\n1\n"; source: "record Rational { numerator: Integer; denominator: Integer }
function gcd(a: Integer, b: Integer): Integer {
a = abs(a); b = abs(b)
while b != 0 { let next = a % b; a = b; b = next }
return a
}
function normalize(n: Integer, d: Integer): Rational {
let factor = gcd(n, d)
n = n / factor; d = d / factor
if d < 0 { n = -n; d = -d }
return Rational { denominator: d; numerator: n }
}
function show(value: Rational) { print(value.numerator); print(value.denominator) }
show(normalize(42, -56)); show(normalize(-42, -56)); show(normalize(0, -17))
show(normalize(9223372036854775806, 4611686018427387903))
" }
}
function test_ragged_gcd_fold_returns_scalars_independent_of_rows(): Case {
    return Case { name: "test_ragged_gcd_fold_returns_scalars_independent_of_rows"; category: "numeric_composition"; peer: "values-round9:P1;go-zig-round3:Z26/P3"; compatibility: "Original Euclidean fold over ordinary ragged Lists; peer gcd API excluded."; closest: "memory-research-peer-projections:test_euclidean_remainder_composes_at_signed_boundaries"; difference: "Repeated gcd composition across empty, zero and signed rows yields independent returned records after source mutation."; status: "authored_unexecuted"; expected: "0\n0\n6\n4\n0\n2\n1\n2\n"; source: "record Fold { value: Integer; count: Integer }
function gcd(a: Integer, b: Integer): Integer {
a = abs(a); b = abs(b)
while b != 0 { let next = a % b; a = b; b = next }
return a
}
function fold(values: List<Integer>): Fold {
let value = 0
for next in values { value = gcd(value, next) }
return Fold { count: values.length; value: value }
}
