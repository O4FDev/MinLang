let trace = 0
while gate(state).open {
if state[0] == 1 { continue }
trace = trace * 10 + state[0]
if state[0] == 3 { break }
}
print(state[0]); print(trace)
while gate(state).open { trace = trace * 10 + state[0] }
print(state[0]); print(trace)
" }
}
