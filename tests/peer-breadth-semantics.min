function test_condition_record_rechecks_after_continue_but_not_break(): Case {
    return Case { name: "test_condition_record_rechecks_after_continue_but_not_break"; category: "control_scope"; peer: "go-zig-round3:P8;swift-round7:X2"; compatibility: "Original loop-condition/record-return composition using ordinary Boolean conditions."; closest: "peer-research-reachability:test_observable_effects_before_return_or_break_are_preserved"; difference: "Returned condition records distinguish condition reevaluation after continue from break."; status: "authored_unexecuted"; expected: "3\n23\n5\n234\n"; source: "record Gate { open: Boolean; visit: Integer }
function gate(state: List<Integer>): Gate {
state[0] += 1
return Gate { visit: state[0]; open: state[0] < 5 }
