use "../tools/testing.min" as test
use "system" as system

function engineSource(): Text {
    let engine = readTextFile("runtime/minyar_runtime.c")
    for header in ["minyar_rc.h", "minyar_collections.h"] {
        let replacement = "minyar_cycle_rc.h"
        if header == "minyar_collections.h" { replacement = "minyar_cycle_collections.h" }
        let directive = "#include \"" + header + "\""
        test.check(engine.byteLength - test.replace(engine, directive, "").byteLength == directive.byteLength, "managed graph runtime requires exactly one ownership header")
        engine = test.replace(engine, directive, "#include \"" + replacement + "\"")
    }
    return "#define MINYAR_SORT_GRAPH 1\n#define MINYAR_MAP_CYCLE_RUNTIME 1\n#if defined(__GNUC__) || defined(__clang__)\n#define MINYAR_NOINLINE __attribute__((noinline))\n#else\n#define MINYAR_NOINLINE\n#endif\n" + engine + "\n#include \"minyar_callbacks.h\"\n"
}

function setting(environment: List<Text>, name: Text, value: Text): List<Text> {
    let result: List<Text> = []
    let prefix = name + "="
    for entry in environment {
        let raw = Bytes(entry)
        if raw.length < prefix.byteLength || Text(raw.slice(0, prefix.byteLength)) != prefix { result.add(entry) }
    }
    result.add(prefix + value)
    return result
}

record Profile { name: Text; defines: List<Text> }
let mode = "both"
let optionIndex = 0
while optionIndex < argumentCount() {
    test.check(argument(optionIndex) == "--mode" && optionIndex + 1 < argumentCount(), "unknown sort model option")
    optionIndex += 1
    mode = argument(optionIndex)
    optionIndex += 1
}
test.check(mode == "both" || mode == "native" || mode == "sanitize", "unsupported sort model mode")
let modes: List<Text> = []
if mode == "both" || mode == "native" { modes.add("native") }
if mode == "both" || mode == "sanitize" { modes.add("sanitize") }
let profiles = [
    Profile { name: "arena"; defines: ["-DMINYAR_COMPILER_ARENA=1"] },
    Profile { name: "eager"; defines: [] },
    Profile { name: "system-k1"; defines: ["-DMINYAR_SYSTEM_HEAP=1", "-DMINYAR_RC_POLL_BUDGET=1"] },
    Profile { name: "system-k32"; defines: ["-DMINYAR_SYSTEM_HEAP=1", "-DMINYAR_RC_POLL_BUDGET=32"] },
    Profile { name: "bounded"; defines: ["-DMINYAR_BOUNDED_HEAP=1", "-DMINYAR_BOUNDED_HEAP_BYTES=33554432"] },
    Profile { name: "lazy"; defines: ["-DMINYAR_BOUNDED_HEAP=1", "-DMINYAR_BOUNDED_HEAP_BYTES=33554432", "-DMINYAR_LAZY_HEAP=1"] }
]
let work = test.scratch()
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let fixture = readTextFile("tests/list-sort-runtime.c")
let configurations = 0
for selected in modes {
    let flags: List<Text> = []
    if selected == "sanitize" { flags = ["-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-g"] }
    for engine in ["ordinary", "graph"] {
        let replacement = readTextFile("runtime/minyar_runtime.c")
        if engine == "graph" { replacement = engineSource() }
        let source = work + "/" + engine + ".c"
        writeTextFile(source, test.replace(fixture, "#include \"../runtime/minyar_runtime.c\"", replacement))
        for profile in profiles {
            for level in ["-O0", "-O2"] {
                let executable = work + "/" + selected + "-" + engine + "-" + profile.name + "-" + level
                let command = [clang, "-std=c11", level]
                for flag in flags { command.add(flag) }
                for define in profile.defines { command.add(define) }
                for item in ["-iquote", "runtime", source, "-o", executable, "-lm"] { command.add(item) }
                test.require(test.run(command, system.environment(), "", executable + ".build", 60), "sort model compile")
                let leak = "detect_leaks=1:halt_on_error=1"
                if profile.name == "arena" { leak = "detect_leaks=0:halt_on_error=1" }
                let environment = setting(system.environment(), "ASAN_OPTIONS", leak)
                environment = setting(environment, "UBSAN_OPTIONS", "halt_on_error=1")
                let result = test.run([executable], environment, "", executable + ".run", 30)
                test.check(result.status == 0 && result.output == "natural-models-alias-copy-float-text-comparator-stability-ok\n" && result.errorOutput == "", "sort model result changed\n" + result.output + result.errorOutput)
                environment = setting(environment, "ASAN_OPTIONS", "detect_leaks=0:halt_on_error=1")
                for mutation in ["set", "add"] {
                    result = test.run([executable, mutation], environment, "", executable + "." + mutation, 30)
                    test.check(result.status == 1 && result.output == "" && result.errorOutput == "Minyar stopped: the List was mutated during its sort comparator.\n", "sort mutation rejection changed\n" + result.output + result.errorOutput)
                }
                configurations += 1
                print(selected + " " + engine + " " + profile.name + " " + level + " PASS")
            }
        }
    }
}
test.removeTree(work)
print(Text(configurations) + " configurations passed")
