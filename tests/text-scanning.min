use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

// Text scanning without intermediate objects, at O0 and O2 under the exact
// ownership-debt runtime, with the LLVM shapes that make it so:
// `for piece in text.split(separator)` scans in place (no List, one reused
// view while the body keeps nothing), Integer(text.slice(a, b)) parses the
// range without a slice, and Text length and indexing read the header inline.

function functionBody(llvm: Text, name: Text): Text {
    let body: List<Text> = []
    let taking = false
    for line in test.lines(llvm) {
        if line.startsWith("define ") && (test.contains(line, "@.minyar.fn." + name + "(") || test.moduleFunction(line, name)) { taking = true }
        if taking {
            body.add(line + "\n")
            if line == "}" { return joinText(body) }
        }
    }
    fail("Text scanning LLVM function is missing: " + name)
}

// Whether one function body defines a local name twice. LLVM names are
// function-scoped, so two definitions of `%value.N.suffix` are invalid IR even
// in different blocks.
function duplicateLocals(body: Text): Boolean {
    let seen: List<Text> = []
    for line in test.lines(body) {
        if line.startsWith("  %") {
            let equals = line.find(" = ")
            if equals > 2 {
                let name = line.slice(2, equals)
                let index = 0
                while index < seen.length {
                    if seen[index] == name { return true }
                    index = index + 1
                }
                seen.add(name)
            }
        }
    }
    return false
}

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]

// Every separator shape, edge pieces, Unicode lengths and indexing.
fixtures.executes(frontend, #"""
    function show(text: Text, separator: Text): Text {
        let pieces: List<Text> = []
        for piece in text.split(separator) { pieces.add("[" + piece + "]" + Text(piece.length)) }
        return joinText(pieces, " ")
    }
    print(show("a,b,,c", ","))
    print(show(",lead,trail,", ","))
    print(show("", ","))
    print(show("abc", ""))
    print(show("", ""))
    print(show("x--y----z", "--"))
    print(show("aaab", "aab"))
    print(show("ab", "abc"))
    print(show("añb,é🙂,ü", ","))
    print(show("añ🙂b", ""))
    print(show("1🙂2🙂🙂3", "🙂"))
    let total = 0
    for word in "Mïnyar text split".split(" ") { total += word.length; print(word[1]) }
    print(total)
    """#, "[a]1 [b]1 []0 [c]1\n[]0 [lead]4 [trail]5 []0\n[]0\n[a]1 [b]1 [c]1\n\n[x]1 [y]1 []0 [z]1\n[a]1 []0\n[ab]2\n[añb]3 [é🙂]2 [ü]1\n[a]1 [ñ]1 [🙂]1 [b]1\n[1]1 [2]1 []0 [3]1\nï\ne\np\n15\n", levels, 0, "", true)

// Kept pieces survive the loop's reuse: some in a List, some as Map keys,
// some through a record; the loop variable may also be reassigned.
fixtures.executes(frontend, #"""
    record Holder { word: Text }
    function keepEveryOther(text: Text): List<Text> {
        let kept: List<Text> = []
        let index = 0
        for piece in text.split(" ") {
            if index % 2 == 0 { kept.add(piece) }
            index += 1
        }
        return kept
    }
    print(joinText(keepEveryOther("zero one two three four five"), ","))
    let counts: Map<Text, Integer> = Map()
    for word in "b a b c a b".split(" ") {
        if counts.has(word) { counts[word] += 1 } else { counts[word] = 1 }
    }
    let names: List<Text> = []
    for name in counts { names.add(name) }
    names.sort()
    for name in names { print(name + "=" + Text(counts[name])) }
    let holders: List<Holder> = []
    for word in "red green blue".split(" ") { holders.add(Holder { word: word }) }
    for holder in holders { print(holder.word) }
    let changed: List<Text> = []
    for piece in "p q r".split(" ") {
        piece = piece + "!"
        changed.add(piece)
    }
    print(joinText(changed, ""))
    let last = ""
    for piece in "k1 k2 k3".split(" ") { last = piece }
    print(last)
    """#, "zero,two,four\na=2\nb=3\nc=1\nred\ngreen\nblue\np!q!r!\nk3\n", levels, 0, "", true)

// break, continue and return leave the loop owning nothing; nested loops
// split a piece of the outer one; owned receivers and computed separators.
fixtures.executes(frontend, #"""
    function firstLong(text: Text): Text {
        for word in text.split(" ") { if word.length > 3 { return word } }
        return "none"
    }
    function make(count: Integer): Text {
        let parts: List<Text> = []
        for index in 0..count { parts.add("w" + Text(index)) }
        return joinText(parts, ";")
    }
    function joined(separator: Text): Text { return separator + separator }
    print(firstLong("a bb ccc dddd eeeee"))
    print(firstLong("a b"))
    let seen = 0
    for word in make(10).split(";") {
        if word == "w2" { continue }
        if word == "w5" { break }
        seen += 1
    }
    print(seen)
    let cells = 0
    let sum = 0
    for row in "1,2,3\n4,5\n\n6".split("\n") {
        for cell in row.split(",") {
            if cell.length > 0 { sum += Integer(cell); cells += 1 }
        }
    }
    print(Text(cells) + " " + Text(sum))
    let separator = "-"
    let pieces = 0
    for piece in "a--b--c".split(joined(separator)) { pieces += piece.length }
    print(pieces)
    for repetition in 0..200 {
        for piece in make(3).split(";") { if piece.length != 2 { fail("lost a piece") } }
    }
    print("repeated")
    """#, "dddd\nnone\n4\n6 21\n3\nrepeated\n", levels, 0, "", true)

// Large sources: kept small pieces are compacted, unkept ones never copy.
fixtures.executes(frontend, #"""
    let lines: List<Text> = []
    for index in 0..3000 { lines.add("line " + Text(index) + ",field,\(index % 7)") }
    let source = joinText(lines, "\n")
    let kept: List<Text> = []
    let total = 0
    for line in source.split("\n") {
        let index = 0
        for field in line.split(",") {
            if index == 2 { total += Integer(field) }
            index += 1
        }
        if line.endsWith(",6") { kept.add(line) }
    }
    print(total)
    print(kept.length)
    print(kept[0])
    print(kept[kept.length - 1])
    """#, "8994\n428\nline 6,field,6\nline 2995,field,6\n", levels, 0, "", true)

// Body locals that alias the piece (trim with nothing to trim) and locals
// that keep it, over a large source, with early exits.
fixtures.executes(frontend, #"""
    let rows: List<Text> = []
    for index in 0..2000 { rows.add("key\(index) = \(index % 10)") }
    let source = joinText(rows, "\n")
    let kept: List<Text> = []
    let sum = 0
    for raw in source.split("\n") {
        let line = raw.trim()
        let alias = line
        if alias.endsWith("= 9") { kept.add(line) }
        let equals = line.find("=")
        sum += Integer(line.slice(equals + 1, line.length))
        if sum > 8990 { break }
    }
    print(sum)
    print(kept.length)
    print(kept[kept.length - 1])
    """#, "8991\n199\nkey1989 = 9\n", levels, 0, "", true)

// The lowering applies only to a direct `for` over a split call.
fixtures.executes(frontend, #"""
    function direct(text: Text): Integer {
        let count = 0
        for piece in text.split(",") { count += piece.length }
        return count
    }
    function stored(text: Text): Integer {
        let parts = text.split(",")
        let count = 0
        for piece in parts { count += piece.length }
        return count + parts.length
    }
    print(direct("ab,c"))
    print(stored("ab,c"))
    """#, "3\n5\n", levels, 0, "", true)
let path = frontend.compiler.directory + "/case" + Text(frontend.compiler.serial)
let llvm = io.readTextFile(path + ".ll")
let direct = functionBody(llvm, "direct")
test.check(test.contains(direct, "@minyar_text_split_next("), "a for over a split call must scan in place")
test.check(!test.contains(direct, "@minyar_text_split(") && !test.contains(direct, "@minyar_list_"), "a for over a split call must not build a List")
let stored = functionBody(llvm, "stored")
test.check(test.contains(stored, "@minyar_text_split(") && !test.contains(stored, "@minyar_text_split_next("), "a stored split keeps its List")

// text.slice(start, end) == other compares the range in place when other is
// a literal or a local; a right side that runs code keeps the slice first.
fixtures.executes(frontend, #"""
    function hasPrefix(text: Text, prefix: Text): Boolean { return text.length >= prefix.length && text.slice(0, prefix.length) == prefix }
    function scheme(url: Text): Text {
        if url.slice(0, 8) == "https://" { return "secure" }
        if url.slice(0, 7) != "http://" { return "other" }
        return "plain"
    }
    function shout(text: Text): Text { print("evaluated"); return text }
    print(hasPrefix("Mïnyar", "Mï"))
    print(hasPrefix("Mïnyar", "Mi"))
    print(scheme("https://a") + " " + scheme("http://b") + " " + scheme("ftp://c/long"))
    let word = "añb🙂c"
    print(word.slice(1, 4) == "ñb🙂")
    print(word.slice(4, 5) != "c")
    print(word.slice(0, 2) == shout("añ"))
    """#, "true\nfalse\nsecure plain other\ntrue\nfalse\nevaluated\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "let t = \"abc\"\nlet e = \"bc\"\nprint(t.slice(1, 4) == e)\n", "", levels, 1, "Minyar stopped: a Text slice must stay within the Text and end after it starts.\n", false)
fixtures.executes(frontend, #"""
    function prefixed(text: Text, prefix: Text): Boolean { return text.slice(0, 2) == prefix }
    function called(text: Text): Boolean { return text.slice(0, 2) == text.trim() }
    print(prefixed("abc", "ab"))
    print(called("ab"))
    """#, "true\ntrue\n", levels, 0, "", true)
let equalityLLVM = io.readTextFile(frontend.compiler.directory + "/case" + Text(frontend.compiler.serial) + ".ll")
let prefixedBody = functionBody(equalityLLVM, "prefixed")
test.check(test.contains(prefixedBody, "call zeroext i1 @minyar_text_range_equals(") && !test.contains(prefixedBody, "@minyar_text_slice(") && !test.contains(prefixedBody, "@minyar_texts_are_equal("), "a slice compared with a local must compare the range in place")
let calledBody = functionBody(equalityLLVM, "called")
test.check(test.contains(calledBody, "@minyar_text_slice(") && test.contains(calledBody, "@minyar_texts_are_equal(") && !test.contains(calledBody, "@minyar_text_range_equals("), "a right side that runs code keeps the slice")

// trim of an owned receiver consumes it, trimming a view nothing else holds
// in place; a borrowed receiver keeps the ordinary trim.
fixtures.executes(frontend, #"""
    function padded(word: Text): Text { return "  " + word + "\t " }
    function key(line: Text): Text {
        let equals = line.find("=")
        return line.slice(0, equals).trim()
    }
    function kept(line: Text): Text { return line.trim() }
    let wide = "  ñame = value"
    print("[" + key("  name  = 1") + "]" + Text(key(wide).length))
    print("[" + padded("x").trim() + "]")
    print("[" + "plain".slice(0, 5).trim() + "]")
    let large: List<Text> = []
    for index in 0..1000 { large.add("  item \(index % 7)  ") }
    let source = joinText(large, ";")
    let total = 0
    let pieces: List<Text> = []
    for index in 0..1000 {
        let piece = source.slice(index * 11, index * 11 + 10).trim()
        total += piece.length
        if index % 250 == 0 { pieces.add(piece) }
    }
    print(Text(total) + " " + joinText(pieces, ","))
    print("[" + kept("  k  ") + "]")
    """#, "[name]4\n[x]\n[plain]\n6000 item 0,item 5,item 3,item 1\n[k]\n", levels, 0, "", true)
let trimLLVM = io.readTextFile(frontend.compiler.directory + "/case" + Text(frontend.compiler.serial) + ".ll")
test.check(test.contains(functionBody(trimLLVM, "key"), "call ptr @minyar_text_trim_take("), "trim of a fresh slice consumes it")
test.check(test.contains(functionBody(trimLLVM, "kept"), "call ptr @minyar_text_trim(") && !test.contains(functionBody(trimLLVM, "kept"), "@minyar_text_trim_take("), "trim of a borrowed receiver keeps the receiver")

// Inline length and indexing: ASCII, Unicode (runtime path), a Text the
// runtime has not counted yet, and the scanning loop of a parser record.
fixtures.executes(frontend, #"""
    use "text" as textLibrary
    record Scanner { text: Text; position: Integer }
    function Scanner.skipSpaces() {
        while self.position < self.text.length && self.text[self.position] == ' ' { self.position += 1 }
    }
    function Scanner.number(): Integer {
        self.skipSpaces()
        let start = self.position
        while self.position < self.text.length && self.text[self.position] >= '0' && self.text[self.position] <= '9' { self.position += 1 }
        return Integer(self.text.slice(start, self.position))
    }
    let scanner = Scanner { text: "  12   345 6"; position: 0 }
    let sum = 0
    for count in 0..3 { sum += scanner.number() }
    print(sum)
    let unicode = "añ🙂b"
    let seen: List<Text> = []
    for index in 0..unicode.length { seen.add(Text(unicode[index])) }
    print(joinText(seen, "|") + " " + Text(unicode.length))
    let decoded = textLibrary.decodeOrStop(Bytes("héllo"))
    print(Text(decoded.length) + " " + Text(decoded[1]) + Text(decoded[4]))
    let ascii = textLibrary.decodeOrStop(Bytes("plain"))
    print(Text(ascii[4]) + Text(ascii.length))
    let uncounted = "xñy🙂z".slice(1, 4)
    print(Text(uncounted[2]) + Text(uncounted.length) + Text(uncounted[0]))
    """#, "363\na|ñ|🙂|b 4\n5 éo\nn5\n🙂3ñ\n", levels, 0, "", true)
fixtures.executes(frontend, "let t = \"abc\"\nlet i = 3\nprint(t[i])\n", "", levels, 1, "Minyar stopped: a Text position was outside the Text.\n", false)
fixtures.executes(frontend, "let t = \"abc\"\nlet i = -1\nprint(t[i])\n", "", levels, 1, "Minyar stopped: a Text position cannot be negative.\n", false)
fixtures.executes(frontend, #"""
    function count(text: Text, wanted: Character): Integer {
        let found = 0
        let index = 0
        while index < text.length {
            if text[index] == wanted { found += 1 }
            index += 1
        }
        return found
    }
    print(count("a,b,,c", ','))
    """#, "3\n", levels, 0, "", true)
let indexLLVM = io.readTextFile(frontend.compiler.directory + "/case" + Text(frontend.compiler.serial) + ".ll")
let countBody = functionBody(indexLLVM, "count")
test.check(test.contains(countBody, "call i64 @.minyar.text.length(") && test.contains(countBody, "call i32 @.minyar.text.character("), "Text length and indexing must use the inline header reads")
test.check(!test.contains(countBody, "@minyar_text_length(") && !test.contains(countBody, "@minyar_text_character_at("), "Text length and indexing must not call the runtime on the fast path")
test.check(test.contains(indexLLVM, "!\"minyar text header\"") && test.contains(indexLLVM, "!\"minyar text byte\""), "Text header and byte loads need their own type tags")
test.require(test.run([frontend.compiler.clang, "-O2", "-S", "-emit-llvm", "-Wno-override-module", frontend.compiler.directory + "/case" + Text(frontend.compiler.serial) + ".ll", "-o", frontend.compiler.directory + "/count.opt.ll"], frontend.environment, "", frontend.compiler.directory + "/count.opt", 60), "optimise the Text scanning loop")
let optimised = io.readTextFile(frontend.compiler.directory + "/count.opt.ll")
test.check(!test.contains(optimised, "@.minyar.text.character(") && test.contains(optimised, "call i32 @minyar_text_character_at("), "the inline read keeps the runtime only on its slow path")

// Integer(text.slice(start, end)) parses in place, with the slice's bounds
// check and Integer's parse errors, at Unicode positions too.
fixtures.executes(frontend, #"""
    function field(line: Text, start: Integer, end: Integer): Integer { return Integer(line.slice(start, end)) }
    let line = "id=  -42 ;ü=+7;big=9223372036854775807"
    print(field(line, 3, 8))
    print(Integer(line.slice(12, 14)))
    print(Integer(line.slice(19, line.length)) - 1)
    let text = "x123y"
    let start = 1
    let total = 0
    for end in 2..5 { total += Integer(text.slice(start, end)) }
    print(total)
    """#, "-42\n7\n9223372036854775806\n136\n", levels, 0, "", true)
fixtures.executes(frontend, "let t = \"12\"\nprint(Integer(t.slice(1, 3)))\n", "", levels, 1, "Minyar stopped: a Text slice must stay within the Text and end after it starts.\n", false)
fixtures.executes(frontend, "let t = \"1 2\"\nprint(Integer(t.slice(0, 3)))\n", "", levels, 1, "Minyar stopped: Integer(Text) requires a signed decimal ASCII integer.\n", false)
fixtures.executes(frontend, "let t = \"a b\"\nprint(Integer(t.slice(1, 2)))\n", "", levels, 1, "Minyar stopped: Integer(Text) requires a signed decimal ASCII integer.\n", false)
fixtures.executes(frontend, "let t = \"99999999999999999999\"\nprint(Integer(t.slice(0, 20)))\n", "", levels, 1, "Minyar stopped: Integer(Text) is outside the signed 64-bit range.\n", false)
fixtures.executes(frontend, #"""
    function direct(text: Text): Integer { return Integer(text.slice(1, 3)) }
    function kept(text: Text): Integer {
        let piece = text.slice(1, 3)
        return Integer(piece) + piece.length
    }
    print(direct("a12b"))
    print(kept("a12b"))
    """#, "12\n14\n", levels, 0, "", true)
let slicePath = frontend.compiler.directory + "/case" + Text(frontend.compiler.serial)
let sliceLLVM = io.readTextFile(slicePath + ".ll")
let directSlice = functionBody(sliceLLVM, "direct")
test.check(test.contains(directSlice, "call i64 @minyar_text_integer_range(") && !test.contains(directSlice, "@minyar_text_slice(") && !test.contains(directSlice, "@minyar_rc_"), "Integer of a slice must parse the range without a slice")
let keptSlice = functionBody(sliceLLVM, "kept")
test.check(test.contains(keptSlice, "@minyar_text_slice(") && test.contains(keptSlice, "@minyar_text_integer(") && !test.contains(keptSlice, "@minyar_text_integer_range("), "a stored slice is still a Text")

// A loop that reads one Text's characters or length tests it once: a counted
// ASCII Text reads its bytes directly in a copy of the loop, and every other
// Text runs the counted loop unchanged with the same results and traps.
fixtures.executes(frontend, #"""
    record Cursor { text: Text; position: Integer }
    function Cursor.spaces() {
        while self.position < self.text.length && self.text[self.position] == ' ' { self.position += 1 }
    }
    function count(text: Text): Integer {
        let found = 0
        let index = 0
        while index < text.length {
            if text[index] == 'a' { found += 1 }
            index += 1
        }
        return found
    }
    function letters(text: Text): Integer {
        let total = 0
        for character in text { if character != ' ' { total += 1 } }
        return total
    }
    let cursor = Cursor { text: "   drei", position: 0 }
    cursor.spaces()
    print(cursor.position)
    print(count("aña🙂a"))
    print(count(""))
    print(letters("a b c"))
    let unicode = "añ🙂b"
    let shown: List<Text> = []
    for index in 0..unicode.length { shown.add(Text(unicode[index])) }
    print(joinText(shown, "|") + " " + Text(unicode.length))
    """#, "3\n3\n0\n3\na|ñ|🙂|b 4\n", levels, 0, "", true)
let countPath = frontend.compiler.directory + "/case" + Text(frontend.compiler.serial)
let countLLVM = io.readTextFile(countPath + ".ll")
let counted = functionBody(countLLVM, "count")
test.check(test.contains(counted, "@.minyar.text.character.known(") && test.contains(counted, "icmp sgt i64"), "a loop over one Text tests counted ASCII once and reads bytes directly")
test.check(test.contains(counted, "call i32 @.minyar.text.character("), "the counted loop stays for a Text that is not counted ASCII")
let letterBody = functionBody(countLLVM, "letters")
test.check(test.contains(letterBody, "@.minyar.text.character.known("), "a for loop over a Text reads bytes directly")

// The fast copy traps exactly where the counted loop does.
fixtures.executes(frontend, #"""
    let text = "abc"
    let index = 0
    while index <= text.length {
        print(Text(text[index]))
        index += 1
    }
    """#, "a\nb\nc\n", levels, 1, "Minyar stopped: a Text position was outside the Text.\n", false)

// Text and List versioning copy the same loop region independently, and an
// enclosing copy renames a nested copy again. Every pass keeps its own name
// suffix, so nesting any depth leaves one definition per local name.
fixtures.executes(frontend, #"""
    record Entry { text: Text; weight: Integer }
    function countLetters(text: Text): Integer {
        let total = 0
        for character in text { if character != ' ' { total += 1 } }
        return total
    }
    function windowScan(values: List<Integer>, text: Text): Integer {
        let total = 0
        for j in 0..3 {
            total += values[j] + text.length
        }
        return total
    }
    function scanInsideList(values: List<Integer>, text: Text): Integer {
        let total = 0
        for j in 0..3 {
            let index = 0
            while index < text.length {
                if text[index] == 'a' { total += values[j] }
                index += 1
            }
        }
        return total
    }
    function textInsideText(outer: Text, inner: Text): Integer {
        let total = 0
        for left in outer {
            let index = 0
            while index < inner.length {
                if inner[index] == 'b' { total += 1 }
                index += 1
            }
            total += 1
        }
        return total
    }
    function threeLevels(rows: List<Text>): Integer {
        let total = 0
        for row in rows {
            let outer = 0
            while outer < row.length {
                let inner = 0
                while inner < row.length {
                    if row[inner] != ' ' { total += 1 }
                    inner += 1
                }
                outer += 1
            }
        }
        return total
    }
    function recordScans(entries: List<Entry>): Integer {
        let total = 0
        for entry in entries {
            let index = 0
            while index < entry.text.length {
                if entry.text[index] == 'x' { total += entry.weight }
                index += 1
            }
        }
        return total
    }
    function scanWithCalls(rows: List<Text>, text: Text): Integer {
        let total = 0
        for row in rows {
            let index = 0
            while index < text.length {
                if text[index] == 'z' { total += countLetters(row) }
                index += 1
            }
        }
        return total
    }
    function whileOuter(words: List<Text>): Integer {
        let total = 0
        let start = 0
        while start < words.length {
            let word = words[start]
            let index = 0
            while index < word.length {
                if word[index] == 'c' { total += 1 }
                index += 1
            }
            start += 1
        }
        return total
    }
    function whileOverWindow(values: List<Integer>, text: Text): Integer {
        let total = 0
        let outer = 0
        while outer < 2 {
            for j in 0..3 {
                total += values[j] + text.length
            }
            outer += 1
        }
        return total
    }
    function textOverWindow(values: List<Integer>, text: Text): Integer {
        let total = 0
        for left in text {
            for j in 0..3 {
                total += values[j] + text.length
            }
        }
        return total
    }
    print(windowScan([1, 2, 3], "abcdef"))
    print(scanInsideList([1, 2, 3], "aa"))
    print(textInsideText("xy", "bbb"))
    print(threeLevels(["ab", "c"]))
    print(recordScans([Entry { text: "xoxo", weight: 3 }, Entry { text: "zz", weight: 9 }]))
    print(scanWithCalls(["ab c", "de"], "zzz"))
    print(whileOuter(["ac", "cc"]))
    print(whileOverWindow([1, 2, 3], "abc"))
    print(textOverWindow([1, 2, 3], "ab"))
    """#, "24\n12\n8\n5\n6\n15\n3\n30\n24\n", levels, 0, "", true)
let nestedPath = frontend.compiler.directory + "/case" + Text(frontend.compiler.serial)
let nestedLLVM = io.readTextFile(nestedPath + ".ll")
for name in ["windowScan", "scanInsideList", "textInsideText", "threeLevels", "recordScans", "scanWithCalls", "whileOuter", "whileOverWindow", "textOverWindow"] {
    test.check(!duplicateLocals(functionBody(nestedLLVM, name)), "nested loop copies define one LLVM local twice: " + name)
}
let windowBody = functionBody(nestedLLVM, "windowScan")
test.check(test.contains(windowBody, "for.guard.") && test.contains(windowBody, "@.minyar.text.length("), "a List window loop keeps its List copy and its Text length read")
test.check(test.contains(functionBody(nestedLLVM, "scanInsideList"), "@.minyar.text.character.known("), "a nested Text scan still reads bytes directly")
let overWindowBody = functionBody(nestedLLVM, "whileOverWindow")
test.check(test.contains(overWindowBody, "for.guard.") && test.contains(overWindowBody, "@.minyar.text.length("), "an enclosing Text copy and a nested List window copy coexist")
// `let fields = text.split(sep)` read only by position keeps no List: the
// pieces are computed where they are read, and Integer or a comparison with a
// literal reads the bytes in place. Edge pieces, Unicode content, dynamic
// positions and the List's own bound message must all match split.
fixtures.executes(frontend, #"""
    function field(line: Text, at: Integer): Text {
        let fields = line.split(",")
        return fields[at]
    }
    function integerAt(line: Text, at: Integer): Integer {
        let fields = line.split(",")
        return Integer(fields[at])
    }
    function named(line: Text): Integer {
        let fields = line.split(",")
        let count = fields.length
        if fields[1] == "WARN" { count += 100 }
        if fields[2] != "" { count += 1000 }
        return count
    }
    print(field("a,b,c", 0) + "|" + field("a,b,c", 2))
    print(integerAt("10,20,30", 1))
    print(named("t,WARN,x"))
    print(named("t,INFO,"))
    print(named(",,"))
    let unicode = "añb,é🙂,ü"
    print(field(unicode, 1) + Text(field(unicode, 1).length))
    print(integerAt(",,  7 ", 2))
    let empty = ""
    let none = empty.split(",")
    print(none.length)
    let trail = "a,"
    let parts = trail.split(",")
    print(parts.length + none.length)
    for line in "1,2\n3,4\n5,6".split("\n") {
        let cells = line.split(",")
        if Integer(cells[0]) + 1 != Integer(cells[1]) { fail("wrong cells") }
        print(cells[1] + "-" + cells[0])
    }
    """#, "a|c\n20\n1103\n3\n3\né🙂2\n7\n1\n3\n2-1\n4-3\n6-5\n", levels, 0, "", true)
fixtures.executes(frontend, #"""
    function outside(line: Text): Text {
        let fields = line.split(",")
        return fields[4]
    }
    print(outside("a,b,c"))
    """#, "", levels, 1, "Minyar stopped: List position 4 is outside its length of 3.\n", false)
// A split whose pieces leave the block, or a whole-List use, keeps its List.
fixtures.executes(frontend, #"""
    function first(line: Text): Text {
        let fields = line.split(",")
        return fields[1]
    }
    function sorted(line: Text): Text {
        let fields = line.split(",")
        fields.sort()
        return joinText(fields, "|")
    }
    function stored(line: Text): Integer {
        let fields = line.split(",")
        let copy: List<Text> = []
        for field in fields { copy.add(field) }
        return copy.length
    }
    function replaced(line: Text): Text {
        let fields = line.split(",")
        fields[1] = "x"
        return joinText(fields, "|")
    }
    print(first("p,q,r"))
    print(sorted("c,a,b"))
    print(stored("1,2,3"))
    print(replaced("1,2,3"))
    """#, "q\na|b|c\n3\n1|x|3\n", levels, 0, "", true)
// A binding a closure captures keeps the ordinary split: the closure body is
// a function of its own and cannot hold a value this block never stored.
fixtures.executes(frontend, #"""
    function reserve(line: Text): Callback<Text> {
        let fields = line.split(",")
        return function(): Text { return fields[1] }
    }
    let pick = reserve("x,y,z")
    print(pick())
    """#, "y\n", levels, 0, "", true)

// A slice used as a Map key or a Set element: the probe reads the range, so
// no piece Text is made. A key that runs code keeps the slice.
fixtures.executes(frontend, #"""
    function counts(text: Text): Text {
        let seen: Map<Text, Integer> = Map()
        for line in text.split("\n") {
            let colon = line.find(":")
            let name = line.slice(colon + 1, line.length)
            if !seen.has(line.slice(0, colon)) { seen[line.slice(0, colon)] = 0 }
            seen[line.slice(0, colon)] += 1
            if name.length < 0 { print("never") }
        }
        let names: List<Text> = []
        for name in seen { names.add(name) }
        names.sort()
        let out: List<Text> = []
        for name in names { out.add(name + "=" + Text(seen[name])) }
        return joinText(out, " ")
    }
    function operators(source: Text): Integer {
        let two: Set<Text> = Set()
        for op in ["==", "!=", "<="] { two.add(op) }
        let count = 0
        let index = 0
        while index + 1 < source.length {
            if two.contains(source.slice(index, index + 2)) { count += 1 }
            index += 1
        }
        return count
    }
    print(counts("a:1\nb:2\na:3\na:4"))
    print(operators("a==b != c <= d"))
    """#, "a=3 b=1\n3\n", levels, 0, "", true)

// A split field used as a Map key: a range index hashes and compares the
// piece where it lies, so `has` and a lookup make no piece; only the key a
// store keeps is materialised.
fixtures.executes(frontend, #"""
    record Count { hits: Integer; last: Text }
    function tally(lines: Text): Integer {
        let counts: Map<Text, Count> = Map()
        for line in lines.split("\n") {
            let fields = line.split(",")
            if !counts.has(fields[1]) { counts[fields[1]] = Count { hits: 0; last: "" } }
            let entry = counts[fields[1]]
            entry.hits += Integer(fields[2])
            entry.last = fields[0]
        }
        let names: List<Text> = []
        for name in counts { names.add(name) }
        names.sort()
        let total = 0
        for name in names {
            let entry = counts[name]
            print(name + " " + Text(entry.hits) + " " + entry.last)
            total += entry.hits
        }
        return total
    }
    print(tally("a,red,2\nb,blue,3\na,red,4\nc,blue,5"))
    """#, "blue 8 c\nred 6 a\n14\n", levels, 0, "", true)

fixtures.executes(frontend, #"""
    function field(line: Text, at: Integer): Text {
        let fields = line.split(",")
        return fields[at]
    }
    function named(line: Text): Integer {
        let fields = line.split(",")
        if fields[1] == "WARN" { return 100 }
        if fields[2] != "" { return 1000 }
        return fields.length
    }
    function window(line: Text): Integer {
        let fields = line.split(",")
        return Integer(fields[1]) + fields.length
    }
    function first(line: Text): Text {
        let fields = line.split(",")
        return fields[1]
    }
    function sorted(line: Text): Text {
        let fields = line.split(",")
        fields.sort()
        return joinText(fields, "|")
    }
    print(field("a,b,c", 1))
    print(named("t,WARN,x"))
    print(window("1,20,3"))
    print(first("p,q,r"))
    print(sorted("c,a,b"))
    """#, "b\n100\n23\nq\na|b|c\n", levels, 0, "", true)
let piecePath = frontend.compiler.directory + "/case" + Text(frontend.compiler.serial)
let pieceLLVM = io.readTextFile(piecePath + ".ll")
let windowBody = functionBody(pieceLLVM, "window")
test.check(test.contains(windowBody, "call i64 @minyar_text_split_count("), "a positioned split's count must not build the List")
test.check(test.contains(windowBody, "call i64 @minyar_text_split_integer(") && !test.contains(windowBody, "@minyar_text_integer("), "Integer of a positioned piece must parse it where it lies")
test.check(!test.contains(windowBody, "@minyar_text_split(") && !test.contains(windowBody, "@minyar_list_"), "a positioned split must not build a List")
let pieceBody = functionBody(pieceLLVM, "field")
test.check(test.contains(pieceBody, "call ptr @minyar_text_split_at(") && !test.contains(pieceBody, "@minyar_list_get("), "a piece read must compute one piece in place")
let namedBody = functionBody(pieceLLVM, "named")
test.check(test.contains(namedBody, "call zeroext i1 @minyar_text_split_index_equals(") && !test.contains(namedBody, "@minyar_texts_are_equal("), "a positioned piece compared with a literal must compare in place")
test.check(test.contains(namedBody, "call ptr @minyar_text_split_index(") && !test.contains(namedBody, "@minyar_text_split(") && !test.contains(namedBody, "@minyar_list_"), "three reads share one range index instead of a List")
let keptByReturn = functionBody(pieceLLVM, "first")
test.check(test.contains(keptByReturn, "@minyar_text_split_at(") && !test.contains(keptByReturn, "@minyar_text_split("), "a returned piece is one piece, not a List")
let sortedBody = functionBody(pieceLLVM, "sorted")
test.check(test.contains(sortedBody, "@minyar_text_split("), "a whole-List use keeps the split's List")

test.removeTree(frontend.compiler.directory)
print("Text scanning: passed")
