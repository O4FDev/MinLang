// Deliberately no collection storage: every constructed value reaches a match.
choice OptionalPhase { Value(value: Phase); Empty }
choice Phase { Low; Middle; High }
function choiceScalarBool(index: Integer): Maybe<Boolean> {
    if index % 3 == 0 { return Some(false) }
    if index % 3 == 1 { return Some(true) }
    return None
}
function choiceScalarEnum(index: Integer): OptionalPhase {
    if index % 4 == 0 { return Value(Low) }
    if index % 4 == 1 { return Value(Middle) }
    if index % 4 == 2 { return Value(High) }
    return Empty
}
let boolSum = 0
let enumSum = 0
for index in 0..10000 {
    boolSum += match choiceScalarBool(index) { Some(flag) { ifFlag(flag) } None { 3 } }
    enumSum += match choiceScalarEnum(index) { Value(phase) { match phase { Low { 10 } Middle { 20 } High { 30 } } } Empty { 40 } }
}
function ifFlag(flag: Boolean): Integer { if flag { return 2 }; return 1 }
print(boolSum)
print(enumSum)
