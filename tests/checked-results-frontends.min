use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
fixtures.validate("CheckedFrontends", ["test_module_frontend_returns_existing_private_result", "test_callback_recovers_and_retains_captured_result", "test_typed_result_match_and_try_propagate_overflow"])
if fixtures.selected("CheckedFrontends", "test_module_frontend_returns_existing_private_result") {
    let frontend = fixtures.fixture("MINYAR_CHECKED_MODULES_COMPILER", "./build/minyarc-modules")
    fixtures.executes(frontend, "use \"errors\" as errors\nfunction add(a: Integer, b: Integer): errors.IntegerResult { return errors.checkedAdd(a, b) }\nprint(errors.integerOk(add(9223372036854775807, 1)))\nprint(errors.integerValue(add(19, 23)))\n", "false\n42\n", ["-O0", "-O2"], 0, "", false)
    test.removeTree(frontend.compiler.directory)
}
if fixtures.selected("CheckedFrontends", "test_callback_recovers_and_retains_captured_result") {
    let frontend = fixtures.fixture("MINYAR_CHECKED_CALLBACKS_COMPILER", "./build/minyarc-callbacks")
    fixtures.executes(frontend, "use \"errors\" as errors\nfunction create(saved: errors.IntegerResult): Callback<Integer, Integer> {\n    return function(value: Integer): Integer {\n        let result = errors.checkedMultiply(value, 10)\n        if !errors.integerOk(result) { return errors.integerValue(saved) }\n        return errors.integerValue(result)\n    }\n}\nlet callback = create(errors.checkedSubtract(100, 58))\nprint(callback(9223372036854775807))\nprint(callback(2))\nprint(\"still alive\")\n", "42\n20\nstill alive\n", ["-O0", "-O2"], 0, "", true)
    test.removeTree(frontend.compiler.directory)
}
if fixtures.selected("CheckedFrontends", "test_typed_result_match_and_try_propagate_overflow") {
    let frontend = fixtures.fixture("MINYAR_CHECKED_ERRORS_COMPILER", "./build/minyarc-errors")
    fixtures.executes(frontend, "use \"errors\" as errors\nfunction scale(digits: Integer): Result<Integer, errors.Error> {\n    let value = 1\n    for i in 0..digits {\n        let next = errors.checkedMultiply(value, 10)\n        if !errors.integerOk(next) { return Err<Integer, errors.Error>(errors.integerError(next)) }\n        value = errors.integerValue(next)\n    }\n    return Ok<Integer, errors.Error>(value)\n}\nfunction propagated(digits: Integer): Result<Integer, errors.Error> {\n    let value = try scale(digits)\n    return Ok<Integer, errors.Error>(value)\n}\nmatch propagated(18) { Ok(value) { print(value) } Err(error) { print(errors.code(error)) } }\nmatch propagated(19) { Ok(value) { print(value) } Err(error) { print(errors.code(error) == errors.overflowCode()) } }\nmatch propagated(2) { Ok(value) { print(value) } Err(error) { print(errors.code(error)) } }\nprint(\"still alive\")\n", "1000000000000000000\ntrue\n100\nstill alive\n", ["-O0", "-O2"], 0, "", true)
    test.removeTree(frontend.compiler.directory)
}
print("Checked arithmetic through module, callback and Result frontends: passed")
