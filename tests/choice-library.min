use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io
use "system" as system

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
frontend.sources = ["runtime/native/update.c", "runtime/native/update_ed25519.c", "runtime/native/update_monocypher.c", "runtime/native/securecrypto.c", "runtime/native/aes.c", "runtime/native/tlsverify.c"]
if system.getenv("OS") == "Windows_NT" {
    for flag in ["-lcrypt32", "-lbcrypt", "-lncrypt", "-lws2_32"] { frontend.sources.add(flag) }
} else {
    let host = test.run(["uname", "-s"], frontend.environment, "", frontend.compiler.directory + "/host", 10)
    test.require(host, "identify choice library native provider")
    if host.output == "Darwin\n" {
        for flag in ["-framework", "Security", "-framework", "CoreFoundation"] { frontend.sources.add(flag) }
    } else { frontend.sources.add("-lcrypto") }
}
fixtures.executes(frontend, io.readTextFile("tests/choice/status.min"), "true\nok\n0\nok\nfalse\n10\n10\nok\n", ["-O0", "-O2"], 0, "", true)
fixtures.executes(frontend, "use \"peerwire\" as wire\nuse \"errors\" as errors\nlet value = wire.StatusResult.RejectedStatus(errors.make(10, 0, \"bad\"))\nwire.statusValue(value)\n", "", ["-O0", "-O2"], 1, "Minyar stopped: cannot read a rejected relay status\n", false)
test.removeTree(frontend.compiler.directory)
print("Choice library compatibility: passed")
