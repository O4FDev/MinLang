use "../tools/testing.min" as test
use "system" as system
use "sha256" as sha
use "json" as json

public function requireHost(hostname: Text, work: Text) {
    let platform = test.run(["uname", "-s"], system.environment(), "", work + "/platform", 10)
    test.require(platform, "benchmark platform query")
    let host = test.run(["hostname"], system.environment(), "", work + "/hostname", 10)
    test.require(host, "benchmark host query")
    test.check(platform.output == "Linux\n" && host.output == hostname + "\n", "benchmark phase requires Linux host " + hostname)
}
public function digest(path: Text): Text { return sha.hex(sha.digest(readBytesFile(path))) }
public function verify(path: Text, expected: Text) { test.check(digest(path) == expected, "prepared benchmark input changed: " + path) }
public function quote(source: Text): Text {
    let output = Bytes("\"")
    let digits = Bytes("0123456789abcdef")
    for byte in Bytes(source) {
        if byte == 34 || byte == 92 { output.add(92); output.add(byte) }
        else if byte < 32 { output.addBytes(Bytes("\\u00")); output.add(digits[byte / 16]); output.add(digits[byte % 16]) }
        else { output.add(byte) }
    }
    output.add(34)
    return Text(output)
}
public function strings(values: List<Text>): Text {
    let output = "["
    for index in 0..values.length { if index > 0 { output += "," }; output += quote(values[index]) }
    return output + "]"
}
public function read(path: Text): json.Value { let value = json.parse(readTextFile(path)); test.check(value.kind == json.OBJECT, "invalid prepared benchmark manifest"); return value }
public function string(value: json.Value, name: Text): Text { let member = json.member(value, name); test.check(member.kind == json.STRING, "missing prepared benchmark field " + name); return member.text }
public function integer(value: json.Value, name: Text): Integer { let member = json.member(value, name); test.check(member.kind == json.NUMBER, "missing prepared benchmark count " + name); return Integer(member.text) }
public function array(value: json.Value, name: Text): List<Text> {
    let member = json.member(value, name)
    test.check(member.kind == json.ARRAY, "missing prepared benchmark arguments " + name)
    let result: List<Text> = []
    for item in member.items { test.check(item.kind == json.STRING, "non-text prepared benchmark argument"); result.add(item.text) }
    return result
}
public function same(left: List<Text>, right: List<Text>): Boolean { if left.length != right.length { return false }; for index in 0..left.length { if left[index] != right[index] { return false } }; return true }
public function absolute(path: Text, work: Text): Text { return test.canonical(path, work + "/resolve") }
