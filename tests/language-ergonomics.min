use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]

fixtures.executes(frontend, #"""
    let Ok = 1
    let Err = 3
    print(Ok < 2)
    print(Err > 2)
    function make(): Integer { let Ok: () -> Integer = function() { return 42 }; return Ok() }
    print(make())

    """#, "true\ntrue\n42\n", levels, 0, "", true)

io.writeTextFile(frontend.compiler.directory + "/callable.min", test.sourceModules(#"""
    public record Box { value: Integer }
    public record Handler { apply: (Integer, Box) -> Box }
    public function create(): Handler { return Handler { apply: function(n, box) { return Box { value: box.value + n } } } }

    """#))
fixtures.executes(frontend, #"""
    use "./callable.min" as handler
    let callback = handler.create()
    print(callback.apply(2, handler.Box { value: 40 }).value)

    """#, "42\n", levels, 0, "", true)

fixtures.executes(frontend, #"""
    use "text" as text
    let invalid = [[128], [192, 128], [224, 128, 128], [237, 160, 128], [244, 144, 128, 128], [240, 159], [65, 255]]
    for values in invalid { let bytes = Bytes(); for value in values { bytes.add(value) }; match text.decode(bytes) { Ok(value) { print("bad") } Err(error) { print("rejected") } } }

    """#, "rejected\nrejected\nrejected\nrejected\nrejected\nrejected\nrejected\n", levels, 0, "", true)

fixtures.executes(frontend, #"""
    function check(): Result<Boolean, Text> { return Err("condition failed") }
    function run(): Result<Integer, Text> { if try check() { return Ok(42) }; return Ok(0) }
    match run() { Ok(n) { print(n) } Err(e) { print(e) } }

    """#, "condition failed\n", levels, 0, "", true)
fixtures.executes(frontend, #"""
    global TABLE: List<Integer> = [42]
    function value(): Integer { return TABLE[0] }
    print(value())

    """#, "42\n", levels, 0, "", true)
fixtures.rejects(frontend, #"""
    constant TABLE: List<Integer> = [42]

    """#, "a compile-time table has no type annotation", true)

fixtures.executes(frontend, #"""
    function read(good: Boolean): Result<Integer, Text> { if good { return Ok(40) }; return Err("bad") }
    function run(good: Boolean): Result<Integer, Text> { let owned = [Bytes(64)]; return Ok(try read(good) + owned.length + 1) }
    match run(true) { Ok(n) { print(n) } Err(e) { print(e) } }
    match run(false) { Ok(n) { print(n) } Err(e) { print(e) } }

    """#, "42\nbad\n", levels, 0, "", true)
fixtures.executes(frontend, #"""
    function save(good: Boolean): Result<Nothing, Text> { if !good { return Err("failed") }; return Ok() }
    function run(good: Boolean): Result<Integer, Text> { try save(good); return Ok(42) }
    match save(true) { Ok() { print("saved") } Err(e) { print(e) } }
    match run(false) { Ok(n) { print(n) } Err(e) { print(e) } }
    match run(true) { Ok(n) { print(n) } Err(e) { print(e) } }

    """#, "saved\nfailed\n42\n", levels, 0, "", true)
fixtures.executes(frontend, #"""
    record Box { apply: (Integer) -> Result<Integer, Text> }
    let box = Box { apply: function(n) { return Ok(n + 2) } }
    let callbacks: List<(Integer) -> Result<Integer, Text>> = [box.apply]
    match callbacks[0](40) { Ok(n) { print(n) } Err(e) { print(e) } }

    """#, "42\n", levels, 0, "", true)
fixtures.executes(frontend, #"""
    function accept(callback: (Integer, Integer) -> Integer): Integer { return callback(20, 22) }
    print(accept(function(a, b) { return a + b }))
    let factory: () -> (Integer) -> Integer = function() { return function(n) { return n + 2 } }
    print(factory()(40))

    """#, "42\n42\n", levels, 0, "", true)
fixtures.executes(frontend, #"""
    print(1 << 2 + 1)
    print(12 & 3 * 2)
    print(1 | 2 & 4)
    print(7 & 1 == 1)

    """#, "8\n4\n1\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, #"""
    function run(): Integer { constant answer = 20 + 22; constant values = [answer]; values.add(1); if true { constant answer = 7; print(answer) }; return values[0] }
    print(run())

    """#, "7\n42\n", levels, 0, "", true)
fixtures.rejects(frontend, #"""
    function run() { constant answer = 42; answer += 1 }
    run()

    """#, "constant 'answer' cannot be reassigned", true)
fixtures.rejects(frontend, #"""
    let callback = function(n) { print(n) }
    callback(42)

    """#, "untyped callback parameter needs a contextual callable type", true)
fixtures.rejects(frontend, #"""
    let value = Ok(42)

    """#, "needs a contextual Result", true)
fixtures.executes(frontend, #"""
    use "text" as text
    use "errors" as errors
    let invalid = Bytes(2); invalid[0] = 65; invalid[1] = 255
    match text.decode(invalid) { Ok(value) { print(value) } Err(error) { print(errors.code(error)) } }
    match text.decode(Bytes("é🙂")) { Ok(value) { print(value.length); print(value.byteLength) } Err(error) { print(errors.message(error)) } }
    print("alive")

    """#, "6\n2\n6\nalive\n", levels, 0, "", true)
fixtures.executes(frontend, #"""
    let invalid = Bytes(1); invalid[0] = 255
    let value = Text(invalid)
    print("too late")

    """#, "", levels, 1, "Minyar stopped: Text contained invalid UTF-8.\n", false)
test.removeTree(frontend.compiler.directory)
print("Language ergonomics: passed")
