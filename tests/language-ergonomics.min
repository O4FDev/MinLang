use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]

fixtures.executes(frontend, "let Ok = 1\nlet Err = 3\nprint(Ok < 2)\nprint(Err > 2)\nfunction make(): Integer { let Ok: () -> Integer = function() { return 42 }; return Ok() }\nprint(make())\n", "true\ntrue\n42\n", levels, 0, "", true)

io.writeTextFile(frontend.compiler.directory + "/callable.min", test.sourceModules("public record Box { value: Integer }\npublic record Handler { apply: (Integer, Box) -> Box }\npublic function create(): Handler { return Handler { apply: function(n, box) { return Box { value: box.value + n } } } }\n"))
fixtures.executes(frontend, "use \"./callable.min\" as handler\nlet callback = handler.create()\nprint(callback.apply(2, handler.Box { value: 40 }).value)\n", "42\n", levels, 0, "", true)

fixtures.executes(frontend, "use \"text\" as text\nlet invalid = [[128], [192, 128], [224, 128, 128], [237, 160, 128], [244, 144, 128, 128], [240, 159], [65, 255]]\nfor values in invalid { let bytes = Bytes(); for value in values { bytes.add(value) }; match text.decode(bytes) { Ok(value) { print(\"bad\") } Err(error) { print(\"rejected\") } } }\n", "rejected\nrejected\nrejected\nrejected\nrejected\nrejected\nrejected\n", levels, 0, "", true)

fixtures.executes(frontend, "function check(): Result<Boolean, Text> { return Err(\"condition failed\") }\nfunction run(): Result<Integer, Text> { if try check() { return Ok(42) }; return Ok(0) }\nmatch run() { Ok(n) { print(n) } Err(e) { print(e) } }\n", "condition failed\n", levels, 0, "", true)
fixtures.executes(frontend, "global TABLE: List<Integer> = [42]\nfunction value(): Integer { return TABLE[0] }\nprint(value())\n", "42\n", levels, 0, "", true)
fixtures.rejects(frontend, "constant TABLE: List<Integer> = [42]\n", "a module constant needs a literal initializer", true)

fixtures.executes(frontend, "function read(good: Boolean): Result<Integer, Text> { if good { return Ok(40) }; return Err(\"bad\") }\nfunction run(good: Boolean): Result<Integer, Text> { let owned = [Bytes(64)]; return Ok(try read(good) + owned.length + 1) }\nmatch run(true) { Ok(n) { print(n) } Err(e) { print(e) } }\nmatch run(false) { Ok(n) { print(n) } Err(e) { print(e) } }\n", "42\nbad\n", levels, 0, "", true)
fixtures.executes(frontend, "function save(good: Boolean): Result<Nothing, Text> { if !good { return Err(\"failed\") }; return Ok() }\nfunction run(good: Boolean): Result<Integer, Text> { try save(good); return Ok(42) }\nmatch save(true) { Ok() { print(\"saved\") } Err(e) { print(e) } }\nmatch run(false) { Ok(n) { print(n) } Err(e) { print(e) } }\nmatch run(true) { Ok(n) { print(n) } Err(e) { print(e) } }\n", "saved\nfailed\n42\n", levels, 0, "", true)
fixtures.executes(frontend, "record Box { apply: (Integer) -> Result<Integer, Text> }\nlet box = Box { apply: function(n) { return Ok(n + 2) } }\nlet callbacks: List<(Integer) -> Result<Integer, Text>> = [box.apply]\nmatch callbacks[0](40) { Ok(n) { print(n) } Err(e) { print(e) } }\n", "42\n", levels, 0, "", true)
fixtures.executes(frontend, "function accept(callback: (Integer, Integer) -> Integer): Integer { return callback(20, 22) }\nprint(accept(function(a, b) { return a + b }))\nlet factory: () -> (Integer) -> Integer = function() { return function(n) { return n + 2 } }\nprint(factory()(40))\n", "42\n42\n", levels, 0, "", true)
fixtures.executes(frontend, "print(1 << 2 + 1)\nprint(12 & 3 * 2)\nprint(1 | 2 & 4)\nprint(7 & 1 == 1)\n", "8\n4\n1\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "function run(): Integer { constant answer = 20 + 22; constant values = [answer]; values.add(1); if true { constant answer = 7; print(answer) }; return values[0] }\nprint(run())\n", "7\n42\n", levels, 0, "", true)
fixtures.rejects(frontend, "function run() { constant answer = 42; answer += 1 }\nrun()\n", "constant 'answer' cannot be reassigned", true)
fixtures.rejects(frontend, "let callback = function(n) { print(n) }\ncallback(42)\n", "untyped callback parameter needs a contextual callable type", true)
fixtures.rejects(frontend, "let value = Ok(42)\n", "needs a contextual Result", true)
fixtures.executes(frontend, "use \"text\" as text\nuse \"errors\" as errors\nlet invalid = Bytes(2); invalid[0] = 65; invalid[1] = 255\nmatch text.decode(invalid) { Ok(value) { print(value) } Err(error) { print(errors.code(error)) } }\nmatch text.decode(Bytes(\"é🙂\")) { Ok(value) { print(value.length); print(value.byteLength) } Err(error) { print(errors.message(error)) } }\nprint(\"alive\")\n", "6\n2\n6\nalive\n", levels, 0, "", true)
fixtures.executes(frontend, "let invalid = Bytes(1); invalid[0] = 255\nlet value = Text(invalid)\nprint(\"too late\")\n", "", levels, 1, "Minyar stopped: Text contained invalid UTF-8.\n", false)
test.removeTree(frontend.compiler.directory)
print("Language ergonomics: passed")
