// Bounded complete operations and shared owner lifetime regression tests.
use "zstd" as zstd
use "deflate" as deflate
use "machine" as machine
function check(ok: Boolean, message: Text) { if !ok { fail("compression: " + message) } }
let source = Bytes("shared raw dictionary payload shared raw dictionary payload")
let c = zstd.createCCtx()
let d = zstd.createDCtx()
check(zstd.isOpenCCtx(c) && zstd.isOpenDCtx(d), "context creation")
let packed = zstd.compressWith(c, source, 3, 256)
check(zstd.ok(packed), "zstd compress")
let unpacked = zstd.decompressWith(d, zstd.data(packed), source.length)
check(zstd.ok(unpacked) && Text(zstd.data(unpacked)) == Text(source), "zstd exact cap")
check(zstd.status(zstd.decompressWith(d, zstd.data(packed), source.length - 1)) == zstd.LIMIT, "zstd output bound")
check(zstd.ok(zstd.decompressWith(d, zstd.data(packed), source.length)), "zstd recovery")
let rawOutput = Bytes(source.length)
check(zstd.decompressCtxRaw(d, machine.address(zstd.data(packed)), zstd.data(packed).length, machine.address(rawOutput), rawOutput.length) == source.length, "reused raw shim signature")
check(Text(rawOutput) == Text(source), "raw output")
check(zstd.decompressCtxRaw(d, -1, 1, machine.address(rawOutput), rawOutput.length) == zstd.INVALID, "raw invalid range")
check(zstd.status(zstd.compressWith(c, source, 2147483647, 256)) == zstd.INVALID, "invalid compression level")
check(zstd.ok(zstd.compressWith(c, source, 3, 256)), "compress context recovery")
let dictionary = Bytes("shared raw dictionary payload")
let cd = zstd.createCDict(dictionary, 3)
let dd = zstd.createDDict(dictionary)
dictionary[0] = 0
let withDict = zstd.compressDictionary(c, cd, source, 256)
check(zstd.ok(withDict), "dictionary compress")
let fromDict = zstd.decompressDictionary(d, dd, zstd.data(withDict), source.length)
check(zstd.ok(fromDict) && Text(zstd.data(fromDict)) == Text(source), "by copy dictionary")
zstd.closeCDict(cd)
zstd.closeCDict(cd)
check(zstd.status(zstd.compressDictionary(c, cd, source, 256)) == zstd.CLOSED, "closed dictionary")
let copiedDDict = dd
zstd.closeDDict(dd)
zstd.closeDDict(copiedDDict)
check(!zstd.isOpenDDict(copiedDDict), "copied dictionary close")
check(zstd.status(zstd.decompressDictionary(d, copiedDDict, zstd.data(withDict), source.length)) == zstd.CLOSED, "closed decode dictionary")
let copied = c
zstd.closeCCtx(c)
zstd.closeCCtx(copied)
check(!zstd.isOpenCCtx(copied), "shared close state")
check(zstd.status(zstd.compressWith(copied, source, 3, 256)) == zstd.CLOSED, "copied closed owner")
zstd.closeDCtx(d)
for format in [deflate.GZIP, deflate.ZLIB, deflate.RAW] {
    let compressed = deflate.compress(source, format, 6, 256)
    check(deflate.ok(compressed), "deflate compress")
    let decoded = deflate.decompress(deflate.data(compressed), format, source.length)
    check(deflate.ok(decoded) && Text(deflate.data(decoded)) == Text(source), "deflate exact cap")
    check(deflate.status(deflate.decompress(deflate.data(compressed), format, source.length - 1)) == deflate.LIMIT, "deflate bound")
    let prefix = Bytes(source.length - 1)
    check(deflate.decompressInto(deflate.data(compressed), prefix, format) == deflate.LIMIT, "Into output cap")
    check(prefix.length == source.length - 1 && Text(prefix) == Text(source.slice(0, source.length - 1)), "Into partial prefix")
    check(deflate.ok(deflate.decompress(deflate.data(compressed), format, source.length)), "deflate recovery")
    check(deflate.status(deflate.decompress(deflate.data(compressed).slice(0, deflate.data(compressed).length - 1), format, source.length)) == deflate.TRUNCATED, "deflate trailer truncation")
}
let empty = deflate.compress(Bytes(), deflate.GZIP, 6, 64)
let first = deflate.compress(source, deflate.GZIP, 6, 256)
let members = deflate.data(first).slice(0, deflate.data(first).length)
members.addBytes(deflate.data(empty))
members.addBytes(deflate.data(empty))
check(deflate.ok(deflate.decompress(members, deflate.GZIP, source.length)), "empty members at exact cap")
check(deflate.ok(deflate.decompress(deflate.data(empty), deflate.GZIP, 0)), "empty zero cap")
check(zstd.status(zstd.compress(source, 3, -1)) == zstd.INVALID, "invalid bound")
check(zstd.status(zstd.compress(source, 3, 268435457)) == zstd.INVALID, "allocation ceiling")
print("compression: ok")
