use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "system" as system
use "files" as files

// `make check-in-parallel` must pass exactly when every check passes, build a shared file
// prerequisite once, and give checks the CI environment.
test.check(processInfo.argumentCount() == 1, "usage: check-in-parallel TOOL")
let tool = processInfo.argument(0)
let work = test.scratch()
io.writeTextFile(work + "/Makefile", ".PHONY: FORCE passing mixed pass fail shared settings restamp\nFORCE:\n" +
    "passing: pass shared settings\n" +
    "mixed: pass fail\n" +
    "pass:\n\t@echo pass\n" +
    "fail:\n\t@exit 3\n" +
    "shared: built\n\t@test \"$$(cat built)\" = once\n" +
    "built:\n\t@test ! -e built && echo once > built\n" +
    "settings:\n\t@test \"$$MINYAR_TEST_SHARED_HOST\" = 1 && test \"$$MINYAR_TEST_JOBS\" = 1\n" +
    "restamp: pass\n\t@echo changed > build/.toolchain.json\n")
let passing = test.run([tool, "--jobs", "2", "passing"], system.environment(), work, work + "/passing", 120)
test.check(passing.status == 0 && test.contains(passing.output, "Parallel checks passed\n") && !test.contains(passing.output, "Failed check:"),
    "passing checks must pass\n" + passing.output + passing.errorOutput)
test.check(files.pathSize(work + "/built") > 0, "shared prerequisite was not built")
let mixed = test.run([tool, "--jobs", "2", "mixed"], system.environment(), work, work + "/mixed", 120)
test.check(mixed.status == 1 && test.contains(mixed.output, "Failed check: fail\n") && test.contains(mixed.output, "Failed check: mixed\n") &&
    !test.contains(mixed.output, "Failed check: pass\n"), "a failing check must fail its aggregate only\n" + mixed.output + mixed.errorOutput)
io.writeTextFile(work + "/build/.toolchain.json", "{}\n")
let restamped = test.run([tool, "--jobs", "2", "restamp"], system.environment(), work, work + "/restamp", 120)
test.check(restamped.status == 1 && test.contains(restamped.output, "Failed check: toolchain-stamp\n") && !test.contains(restamped.output, "Failed check: pass\n"),
    "a toolchain stamp change during the run must fail it\n" + restamped.output + restamped.errorOutput)
let runs = files.list(work + "/build/check-in-parallel")
let retained = 0
for name in runs { if files.pathSize(work + "/build/check-in-parallel/" + name + "/results.json") > 0 { retained += 1 } }
test.check(retained == 1, "only the latest run is retained")
test.removeTree(work)
print("check-in-parallel: aggregation, shared builds and environment passed")
