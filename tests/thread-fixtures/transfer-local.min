record Box { bytes: Bytes, text: Text }

thread function consumer(seed: Integer, input: FrozenBytes, queue: BytesChannel): Integer {
    let local = Bytes(0)
    let box = Box { bytes: local, text: "receiver λ🙂" }
    let aliases: List<Bytes> = [local]
    if !receiveBytes(queue, local) { fail("receiver missed bytes") }
    if box.bytes.length != 8 || aliases[0].getInt64(0) != 987654321 { fail("receive did not update receiver aliases") }
    return box.bytes.getInt64(0) + input.getInt64(0)
}

function main() {
    let source = Bytes(0)
    source.addInt64(987654321)
    let box = Box { bytes: source, text: "sender λ🙂" }
    let aliases: List<Bytes> = [source]
    let shared = freezeBytes(source)
    let queue = bytesChannel(4096, 4)
    let started = startThreadResult(consumer, 0, shared, queue)
    if !started.ok { fail("consumer creation failed") }
    if !sendBytes(queue, source) { fail("send failed") }
    if box.bytes.length != 0 || aliases[0].length != 0 { fail("send did not empty every sender alias") }
    source.addInt64(1)
    closeBytesChannel(queue)
    let joined = joinThreadResult(started.thread)
    if !joined.ok || joined.value != 1975308642 { fail("transferred/shared values were corrupted") }
    print("managed local transfer passed")
}
