thread function publish(seed: Integer, input: FrozenBytes, queue: FrozenBytesChannel): Nothing {
    let slept = threadSleepNanoseconds(10000000)
    if slept != 0 { fail("worker sleep failed") }
    let local = Bytes(0)
    local.addInt64(seed)
    let frozen = freezeBytesTake(local)
    if !sendFrozen(queue, frozen) { fail("nested publication failed") }
}

thread function parent(seed: Integer, input: FrozenBytes, queue: FrozenBytesChannel): Nothing {
    let child = startThread(publish, seed, input, queue)
    // Implicit Nothing return must join the child before destroying this domain.
}

function main() {
    let queue = frozenBytesChannel(64, 1)
    let empty = tryReceiveFrozen(queue)
    if empty.ok || empty.code != 1 { fail("try receive did not report empty") }
    let frozen = freezeBytes(Bytes(0))
    let started = startThreadResult(parent, 37, frozen, queue)
    if !started.ok || started.code != 0 { fail("Nothing thread creation failed") }
    let completed = joinThreadResult(started.thread)
    if !completed.ok || completed.code != 0 || completed.value != 0 {
        fail("Nothing return did not bridge to successful zero")
    }
    let message = tryReceiveFrozen(queue)
    if !message.ok || message.value.getInt64(0) != 37 { fail("nested child was not joined") }
    closeFrozenChannel(queue)
    let closed = receiveFrozen(queue)
    if closed.ok || closed.code != 2 { fail("receive did not report closed") }
    print("Nothing and nested joins passed")
}
