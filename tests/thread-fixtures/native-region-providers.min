use "machine" as machine
use "zstd" as zstd
use "json" as json

thread function worker(seed: Integer, input: NativeRegion, channel: BytesChannel): Integer {
    return input.getInt64(0)
}

function main() {
    nativeThreadSetup()
    let context = zstd.createDCtx()
    if !zstd.isOpenDCtx(context) { fail("zstd context") }
    let compressed = Bytes()
    let frame: List<Integer> = [40, 181, 47, 253, 32, 5, 41, 0, 0, 104, 101, 108, 108, 111]
    for byte in frame { compressed.add(byte) }
    let output = Bytes(16)
    let length = zstd.decompressInto(context, compressed, output)
    zstd.closeDCtx(context)
    if length != 5 || Text(output.slice(0, 5)) != "hello" { fail("maintained zstd decode") }
    let parsed = json.parse("{\"number\":42}")
    if parsed.kind != json.OBJECT { fail("pure Minyar JSON") }
    let input = mapNativeRegion(4096, 3, 34, -1, 0)
    input.setInt64(0, 42)
    let channel = bytesChannel(0, 1)
    let handle = startThread(worker, 0, input, channel)
    if joinThread(handle) != 42 { fail("region worker") }
    closeBytesChannel(channel)
    print("native-region-providers passed")
}
