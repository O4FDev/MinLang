use "process" as processInfo
use "../tools/testing.min" as test
use "../tools/check-runner.min" as runner
use "system" as system
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let sanitize = false
let index = 0
while index < processInfo.argumentCount() {
    let option = processInfo.argument(index)
    if option == "--sanitize" { sanitize = true }
    else if option == "--clang" {
        index += 1
        test.check(index < processInfo.argumentCount(), "--clang needs a value")
        clang = processInfo.argument(index)
    } else { fail("unknown Bytes test option: " + option) }
    index += 1
}
let work = test.scratch()
let environment = runner.environment(system.environment(), "ASAN_OPTIONS", "detect_leaks=0:halt_on_error=1")
environment = runner.environment(environment, "UBSAN_OPTIONS", "halt_on_error=1")
for profile in ["eager", "arena", "system", "fixed", "lazy"] {
    let executable = work + "/" + profile
    let command = [clang, "-std=c11", "-Wall", "-Wextra", "-Werror"]
    if sanitize {
        for flag in ["-O1", "-g", "-fsanitize=address,undefined"] { command.add(flag) }
    } else { command.add("-O2") }
    if profile == "arena" { command.add("-DMINYAR_COMPILER_ARENA") }
    if profile == "system" { command.add("-DMINYAR_SYSTEM_HEAP=1") }
    if profile == "fixed" || profile == "lazy" { command.add("-DMINYAR_BOUNDED_HEAP=1") }
    if profile == "lazy" { command.add("-DMINYAR_LAZY_HEAP=1") }
    for item in ["tests/runtime-bytes.c", "-o", executable, "-lm"] { command.add(item) }
    test.require(test.run(command, environment, "", work + "/compile", 60), "Bytes model compile")
    let result = test.run([executable], environment, "", work + "/run", 30)
    test.require(result, "Bytes model execution")
    print(result.output)
    print(profile + ": 20,000 model transitions and work bounds passed")
}
test.removeTree(work)
