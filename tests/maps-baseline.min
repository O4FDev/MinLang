use "../tools/testing.min" as test
use "system" as system
use "sha256" as sha
use "./benchmark-phases.min" as phase
use "json" as json

function pinCPU(): Integer { native "mapsbaseline" }
function childCPU(): Float { native "mapsbaseline" }
function waitForExit(pid: Integer, milliseconds: Integer): Integer { native "mapsbaseline" }
record Sample { cpu: Float; wall: Float }
function median(samples: List<Sample>): Float {
    let values: List<Float> = []
    for sample in samples { values.add(sample.cpu) }
    test.check(values.length > 0, "missing compiler timing samples")
    for index in 1..values.length {
        let position = index
        while position > 0 && values[position] < values[position - 1] {
            let earlier = values[position - 1]
            values[position - 1] = values[position]
            values[position] = earlier
            position -= 1
        }
    }
    let middle = values.length / 2
    if values.length % 2 == 1 { return values[middle] }
    return (values[middle - 1] + values[middle]) / 2.0
}
function compile(compiler: Text, source: Text, output: Text): Sample {
    let before = childCPU()
    test.check(before >= 0.0, "cannot read child CPU usage")
    let start = system.monotonicNanoseconds()
    let handle = system.spawn(compiler, [compiler, source, output], system.environment(), "")
    test.check(handle > 0, "cannot launch benchmark compiler")
    let pid = system.childProcessId(handle)
    if waitForExit(pid, 30000) != 1 {
        system.sendSignal(pid, 9)
        system.wait(handle)
        fail("benchmark compiler exceeded 30 seconds or wait failed")
    }
    let result = system.wait(handle)
    let wall = Float(system.monotonicNanoseconds() - start) / 1000000000.0
    test.check(result.error == 0 && result.state == system.EXITED && result.exitCode == 0, "benchmark compiler failed")
    let after = childCPU()
    test.check(after >= before, "invalid child CPU accounting")
    return Sample { cpu: after - before; wall: wall }
}

function samplesJSON(samples: List<Sample>): Text {
    let output = "["
    for index in 0..samples.length { if index > 0 { output += "," }; output += "{\"cpu_seconds\":" + Text(samples[index].cpu) + ",\"wall_seconds\":" + Text(samples[index].wall) + "}" }
    return output + "]"
}

function measure(directory: Text, source: Text, compilers: List<Text>, repeats: Integer) {
    let cpu = pinCPU()
    test.check(cpu >= 0, "cannot pin benchmark to the minimum allowed CPU")
    let baseline: List<Sample> = []
    let candidate: List<Sample> = []
    let outputHashes = ["", ""]
    for repetition in (-1)..repeats {
        let order = [0, 1]
        if repetition % 2 == 0 { order = [1, 0] }
        for index in order {
            let output = directory + "/baseline.ll"
            if index == 1 { output = directory + "/candidate.ll" }
            let sample = compile(compilers[index], source, output)
            if repetition >= 0 { if index == 0 { baseline.add(sample) } else { candidate.add(sample) } }
            outputHashes[index] = phase.digest(output)
        }
    }
    test.check(outputHashes[0] == outputHashes[1], "baseline and candidate emitted different LLVM")
    let baselineMedian = median(baseline)
    let candidateMedian = median(candidate)
    test.check(baselineMedian > 0.0, "baseline median CPU usage is zero")
    let ratio = candidateMedian / baselineMedian
    let medians = "{\"baseline\":" + Text(baselineMedian) + ",\"candidate\":" + Text(candidateMedian) + "}"
    let report = "{\"samples\":{\"baseline\":" + samplesJSON(baseline) + ",\"candidate\":" + samplesJSON(candidate) + "},\"median_cpu_seconds\":" + medians + ",\"ratio\":" + Text(ratio) + ",\"limit\":1.01,\"source_sha256\":" + phase.quote(phase.digest(source)) + ",\"output_sha256\":{\"baseline\":" + phase.quote(outputHashes[0]) + ",\"candidate\":" + phase.quote(outputHashes[1]) + "},\"compiler_sha256\":{\"baseline\":" + phase.quote(phase.digest(compilers[0])) + ",\"candidate\":" + phase.quote(phase.digest(compilers[1])) + "},\"affinity\":[" + Text(cpu) + "]}"
    writeTextFile(directory + "/results.json", report + "\n")
    print("{\"median_cpu_seconds\":" + medians + ",\"ratio\":" + Text(ratio) + ",\"limit\":1.01}")
    test.check(ratio <= 1.01, "fixed-input selfcompile exceeds the unchanged 1% gate")
}

let repeats = 31
let repeatsSelected = false
let prepareOnly = false
let runPrepared = false
let directory = "build/maps-baseline"
let optionIndex = 0
while optionIndex < argumentCount() {
    let option = argument(optionIndex)
    if option == "--prepare-only" { prepareOnly = true }
    else if option == "--run-prepared" { runPrepared = true }
    else if option == "--repeats" || option == "--work" {
        test.check(optionIndex + 1 < argumentCount(), "missing baseline benchmark option value")
        optionIndex += 1
        if option == "--repeats" { repeats = Integer(argument(optionIndex)); repeatsSelected = true }
        else { directory = argument(optionIndex) }
    } else { fail("unknown baseline benchmark option: " + option) }
    optionIndex += 1
}
test.check(!(prepareOnly && runPrepared), "baseline benchmark accepts at most one --prepare-only/--run-prepared phase")
let scratch = test.scratch()
if prepareOnly || runPrepared {
    let hostname = "seipnxmg.vm"
    if runPrepared { hostname = "5xnqjvps.vm" }
    phase.requireHost(hostname, scratch)
}
test.require(test.run(["mkdir", "-p", "--", directory], system.environment(), "", scratch + "/mkdir", 10), "baseline benchmark artifact directory")
directory = phase.absolute(directory, scratch)
let source = "build/compiler-baseline-control.min"
let compilers = ["./build/minyarc-baseline", "./build/minyarc"]
let sourceHash = "a5f30a7954381231fbe04a712b72bd9663d1bd7082c667fef851b739ec63c3cf"
phase.verify(source, sourceHash)
let manifestPath = directory + "/prepared.json"
if prepareOnly {
    test.check(repeats > 0, "baseline benchmark needs measured samples")
    let manifest = "{\"kind\":\"maps-baseline\",\"repeats\":" + Text(repeats) + ",\"source_sha256\":" + phase.quote(sourceHash) + ",\"compiler_sha256\":{\"baseline\":" + phase.quote(phase.digest(compilers[0])) + ",\"candidate\":" + phase.quote(phase.digest(compilers[1])) + "},\"driver_binary_sha256\":" + phase.quote(phase.digest("/proc/self/exe")) + ",\"driver_sha256\":" + phase.quote(phase.digest("tests/maps-baseline.min")) + ",\"phase_support_sha256\":" + phase.quote(phase.digest("tests/benchmark-phases.min")) + ",\"adapter_sha256\":" + phase.quote(phase.digest("tests/maps-baseline-runtime.c")) + "}"
    writeTextFile(manifestPath, manifest + "\n")
    print("Prepared maps baseline: " + manifestPath)
} else if !runPrepared {
    test.check(repeats > 0, "baseline benchmark needs measured samples")
    measure(directory, source, compilers, repeats)
} else {
    let manifest = phase.read(manifestPath)
    test.check(phase.string(manifest, "kind") == "maps-baseline", "wrong prepared baseline benchmark kind")
    if repeatsSelected { test.check(repeats == phase.integer(manifest, "repeats"), "baseline sample count differs from preparation") }
    repeats = phase.integer(manifest, "repeats")
    test.check(repeats > 0, "baseline benchmark needs measured samples")
    test.check(phase.string(manifest, "source_sha256") == sourceHash, "prepared fixed compiler source hash changed")
    let identities = json.member(manifest, "compiler_sha256")
    phase.verify(compilers[0], phase.string(identities, "baseline"))
    phase.verify(compilers[1], phase.string(identities, "candidate"))
    phase.verify("/proc/self/exe", phase.string(manifest, "driver_binary_sha256"))
    phase.verify("tests/maps-baseline.min", phase.string(manifest, "driver_sha256"))
    phase.verify("tests/benchmark-phases.min", phase.string(manifest, "phase_support_sha256"))
    phase.verify("tests/maps-baseline-runtime.c", phase.string(manifest, "adapter_sha256"))
    measure(directory, source, compilers, repeats)
}
test.removeTree(scratch)
