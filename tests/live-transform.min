use "../tools/live-transform.min" as live
use "../tools/driver-support.min" as host
use "../tools/testing.min" as test
use "io" as io
use "system" as system

function same(before: Text, after: Text, label: Text) {
    let first = live.surface(before)
    let second = live.surface(after)
    test.check(first.startsWith("live-surface-v1\n") && second.startsWith("live-surface-v1\n"), label + " was not a complete source surface")
    test.check(first == second, label)
}
function different(before: Text, after: Text, label: Text) {
    let first = live.surface(before)
    let second = live.surface(after)
    test.check(first.startsWith("live-surface-v1\n") && second.startsWith("live-surface-v1\n"), label + " was not a complete source surface")
    test.check(first != second, label)
}

same("function value(): Integer { return 1 }\n", "function value(): Integer {\n    let result = 40\n    return result + 2\n}\n", "ordinary function body edits preserve the surface")
same("function Counter.tick(): Integer { return self.value }\n", "function Counter.tick(): Integer { self.value += 1; return self.value }\n", "method body edits preserve the surface")
same("// first\nfunction value(): Integer { return 1 }\n", "// changed comment\nfunction /* header comment */ value(): Integer { return 2 }\n", "comments are excluded from the surface")
same("function value(): Text { return #\"a } b\"# }\n", "function value(): Text { return \"\"\"a { b\nsecond line }\"\"\" }\n", "raw and multiline literal braces stay inside the function")
same("function value(): Character { return '{' }\n", "function value(): Character { return '}' }\n", "character literal braces stay inside the function")
same("function value(): Text { return \"a \\(1 + 2) }\" }\n", "function value(): Text { return \"b \\(3 + 4) {\" }\n", "interpolation is kept inside its containing literal")
same("function value(): Integer { /* } { */ return 1 }\n", "function value(): Integer { if true { return 2 }; return 3 }\n", "nested bodies and comment braces are balanced")
different("function value(): Integer { return 1 }\n", "function value(): Float { return 1.0 }\n", "function return headers are part of the surface")
different("function value(x: Integer): Integer { return x }\n", "function value(x: Float): Integer { return 1 }\n", "function parameter headers are part of the surface")
different("function main() { print(1) }\n", "function main() { print(2) }\n", "main remains initialization code")
different("print(1)\n", "print(2)\n", "top-level initialization stays exact")
different("record Point { x: Integer; y: Text }\n", "record Point { y: Text; x: Integer }\n", "record field order is part of the surface")
different("record Point { x: Integer }\n", "record Point { x: Text }\n", "record field types are part of the surface")
different("global count: Integer = 1\n", "global count: Integer = 2\n", "global initialization is part of the surface")
different("constant count = 1\n", "constant count = 2\n", "constant values are part of the surface")
different("use \"./first.min\" as dependency\n", "use \"./second.min\" as dependency\n", "imports are part of the surface")
different("function value(): Integer { native \"first\" }\n", "function value(): Integer { native \"second\" }\n", "native implementations require restarting")
different("function lastError(): Integer { ; native \"files\" }\n", "function lastError(): Integer { ; native \"system\" }\n", "native implementations after a semicolon require restarting")
different("function lastError(): Integer { let marker = 0; native \"files\" }\n", "function lastError(): Integer { let marker = 0; native \"system\" }\n", "native implementations after another statement require restarting")
different("function lastError(): Integer { ; native\n\"files\" }\n", "function lastError(): Integer { ; native\n\"system\" }\n", "native implementations separated from their library by a newline stay guarded")
different("function value(): Integer { return 1 }\n", "function value(): Integer { native \"first\" }\n", "switching from Minyar to native requires restarting")
for malformed in ["function broken() {", "function broken() { return [1) }", "function broken(): Text { return \"unfinished }", "/* unfinished"] {
    test.check(live.surface(malformed).startsWith("live-surface-error: "), "malformed source must not become a reusable ABI surface")
}

let ir = "@\"minyar.constant|session|value\" = internal global ptr zeroinitializer\n@\"minyar.constant|session|state\" = internal global i8 0\n@.text = private unnamed_addr constant [16 x i8] c\"@.minyar.fn.add\\00\"\n; preserve @.minyar.fn.add in this comment\ndefine internal i64 @.helper() alwaysinline {\nentry:\n  ret i64 2\n}\ndefine i64 @.minyar.fn.add(i64 %argument.0, i64 %argument.1) uwtable {\nentry:\n  %sum = add i64 %argument.0, %argument.1\n  ret i64 %sum\n}\ndefine i1 @.minyar.fn.flip(i1 %argument.0) uwtable {\nentry:\n  %result = xor i1 %argument.0, true\n  ret i1 %result\n}\ndefine double @.minyar.fn.scale(double %argument.0) uwtable {\nentry:\n  %result = fmul double %argument.0, 2.0\n  ret double %result\n}\ndefine i32 @.minyar.fn.character(i32 %argument.0) uwtable {\nentry:\n  ret i32 %argument.0\n}\ndefine ptr @.minyar.fn.identity(ptr %argument.0) uwtable {\nentry:\n  ret ptr %argument.0\n}\ndefine void @.minyar.fn.observe(ptr %argument.0) uwtable {\nentry:\n  store i64 42, ptr %argument.0\n  ret void\n}\ndefine i32 @main(i32 %count, ptr %values) uwtable {\nentry:\n  %two = call i64 @.helper()\n  %sum = call i64 @.minyar.fn.add(i64 40, i64 %two)\n  %integer.ok = icmp eq i64 %sum, 42\n  %boolean.ok = call i1 @.minyar.fn.flip(i1 false)\n  %scaled = call double @.minyar.fn.scale(double 21.0)\n  %float.ok = fcmp oeq double %scaled, 42.0\n  %character = call i32 @.minyar.fn.character(i32 65)\n  %character.ok = icmp eq i32 %character, 65\n  %cell = alloca i64\n  store i64 0, ptr %cell\n  %identity = call ptr @.minyar.fn.identity(ptr %cell)\n  %reference.ok = icmp eq ptr %identity, %cell\n  call void @.minyar.fn.observe(ptr %identity)\n  %observed = load i64, ptr %cell\n  %nothing.ok = icmp eq i64 %observed, 42\n  %a = and i1 %integer.ok, %boolean.ok\n  %b = and i1 %float.ok, %character.ok\n  %c = and i1 %reference.ok, %nothing.ok\n  %d = and i1 %a, %b\n  %ok = and i1 %d, %c\n  %bad = xor i1 %ok, true\n  %status = zext i1 %bad to i32\n  ret i32 %status\n}\n"
let initial = live.transform(ir, 0, true)
let next = live.transform(ir, 1, false)
test.check(initial.error == "" && next.error == "", "supported LLVM must transform: " + initial.error + next.error)
test.check(initial.names.length == 6 && initial.symbols.length == 6, "only ordinary named language functions enter the manifest")
test.check(initial.names[0] == ".minyar.fn.add", "the manifest keeps canonical source function names")
test.check(initial.symbols[0] != next.symbols[0], "implementation exports differ between generations")
test.check(initial.signature == next.signature, "generation names do not change the ABI signature")
let changedPolicy = live.transform(ir + "; minyar-cycle-runtime: 1\n", 1, false)
test.check(changedPolicy.error == "" && changedPolicy.signature != initial.signature, "runtime ownership requirements are part of the image ABI")
test.check(host.hasText(initial.llvm, "define i32 @main("), "the original executable retains main")
test.check(!host.hasText(next.llvm, "define i32 @main("), "replacement images cannot preempt main")
test.check(!host.hasText(initial.llvm, "define internal i64 @.helper("), "internal helpers receive generation-specific names")
test.check(host.hasText(initial.llvm, "@\"minyar.constant|session|value\" = global ptr zeroinitializer"), "original module values are exported")
test.check(host.hasText(initial.llvm, "@\"minyar.constant|session|state\" = global i8 0"), "original module initialization states are exported")
test.check(host.hasText(next.llvm, "@\"minyar.constant|session|value\" = external global ptr"), "reloaded code refers to original module values")
test.check(host.hasText(next.llvm, "@\"minyar.constant|session|state\" = external global i8"), "reloaded code refers to original initialization state")
test.check(host.hasText(initial.llvm, "c\"@.minyar.fn.add\\00\""), "symbol rewriting preserves literal data")
test.check(host.hasText(initial.llvm, "; preserve @.minyar.fn.add in this comment"), "symbol rewriting preserves comments")
test.check(host.hasText(initial.llvm, "call ptr @minyar_live_bind(ptr @minyar.live.0.key."), "wrappers ask the shared runtime for the current body once")
test.check(host.hasText(initial.llvm, "@minyar.live.0.slot."), "later calls read the wrapper's own slot")
test.check(host.hasText(initial.llvm, "load atomic i64, ptr %live.page acquire"), "every call notices a newly published epoch")
test.check(host.hasText(initial.llvm, "call double %live.target(double %argument.0)"), "Float forwarding retains the scalar ABI")
test.check(host.hasText(initial.llvm, "call void %live.target(ptr %argument.0)"), "Nothing forwarding does not invent a return value")
let changedBody = live.transform(host.replaceText(ir, "%sum = add i64", "%sum = sub i64"), 2, false)
let changedHeader = live.transform(host.replaceText(ir, "define i64 @.minyar.fn.add(i64", "define i64 @.minyar.fn.add(i32"), 2, false)
test.check(changedBody.error == "" && changedBody.signature == initial.signature, "body instructions do not become ABI signatures")
test.check(changedHeader.error == "" && changedHeader.signature != initial.signature, "parameter ABI changes alter the image signature")
// Generic instances are emitted in first-use order, so a body edit can reorder definitions; updates bind by name.
let scaleDefinition = "define double @.minyar.fn.scale(double %argument.0) uwtable {\nentry:\n  %result = fmul double %argument.0, 2.0\n  ret double %result\n}\n"
let characterDefinition = "define i32 @.minyar.fn.character(i32 %argument.0) uwtable {\nentry:\n  ret i32 %argument.0\n}\n"
test.check(host.hasText(ir, scaleDefinition + characterDefinition), "reorder fixture matches the sample image")
let reordered = live.transform(host.replaceText(ir, scaleDefinition + characterDefinition, characterDefinition + scaleDefinition), 2, false)
test.check(reordered.error == "" && live.compatibility(initial.signature, reordered.signature) == "", "definition order is not part of the image ABI")
let quoted = live.transform("define i64 @\".minyar.fn.quote\\22slash\\5Cname\"() {\nentry:\n  ret i64 1\n}\n", 9, false)
test.check(quoted.error == "" && quoted.names[0] == ".minyar.fn.quote\"slash\\name", "quoted LLVM names decode exact bytes for runtime lookup")
test.check(host.hasText(quoted.llvm, "c\".minyar.fn.quote\\22slash\\5Cname\\00\""), "runtime lookup keys re-escape quotes and backslashes")
let aliases = live.transform("define i64 @\".minyar.fn.alias\"() {\nentry:\n  ret i64 1\n}\ndefine i32 @main() {\nentry:\n  %value = call i64 @.minyar.fn.alias()\n  ret i32 0\n}\n", 0, true)
test.check(aliases.error == "" && !host.hasText(aliases.llvm, "call i64 @.minyar.fn.alias("), "quoted and unquoted spellings of one LLVM symbol share their binding")
test.check(live.transform("define i64 @\".minyar.fn.bad\\GG\"() {\n  ret i64 0\n}\n", 0, true).error != "", "invalid LLVM symbol escapes fail closed")
test.check(live.transform("define i64 @.minyar.fn.bad(i64 noundef %x) {\n  ret i64 %x\n}\n", 0, true).error != "", "unsupported parameter attributes fail closed")
test.check(live.transform(ir + "; minyar-thread-runtime: 1\n", 0, true).error == "", "managed-thread programs are accepted")
test.check(live.transform(ir + "; minyar-data-parallel-runtime: 1\n", 0, true).error == "", "parallel loop programs are accepted")
test.check(host.hasText(initial.llvm, "load atomic ptr, ptr @minyar.live.0.slot.") && host.hasText(initial.llvm, "load atomic i64, ptr @minyar_live_epoch_seen acquire"), "wrappers read shared dispatch state atomically; a seen epoch carries its slots")
test.check(host.hasText(initial.llvm, "load atomic ptr, ptr @minyar_live_epoch unordered"), "the epoch page pointer may be set while parallel workers call wrappers")
test.check(live.transform(ir, -1, true).error != "", "invalid generation identity is rejected")
test.check(live.transform("define i64 @.minyar.fn.bad() {\n  ret i64 1\n", 0, true).error != "", "incomplete generated functions fail closed")

// Update images hold only changed bodies and call through the original wrappers.
let published = live.decodePairs(initial.digests)
let exports = live.decodePairs(initial.exports)
let cells = live.decodePairs(initial.cells)
test.check(cells["minyar.constant|session|value"] == "ptr" && cells["minyar.constant|session|state"] == "i8", "the original image records its module state cells")
test.check(exports.has(".minyar.fn.add") && published.has(".minyar.fn.add") && !exports.has("main"), "the original image records language wrappers and body fingerprints")
let same = live.transformUpdate(ir, 3, live.sessionOf(initial))
test.check(same.error == "" && same.names.length == 0 && same.signature == initial.signature, "unchanged bodies compile nothing: " + same.error)
let partial = live.transformUpdate(host.replaceText(ir, "%sum = add i64", "%sum = sub i64"), 3, live.sessionOf(initial))
test.check(partial.error == "" && partial.names.length == 1 && partial.names[0] == ".minyar.fn.add", "an update compiles only the changed body: " + partial.error)
test.check(partial.signature == initial.signature, "a partial update keeps the whole ABI signature")
test.check(!host.hasText(partial.llvm, "define i1 @") && !host.hasText(partial.llvm, "define double @"), "unchanged bodies are not recompiled")
test.check(host.hasText(partial.llvm, "declare i64 @" + exports[".minyar.fn.add"] + "(i64, i64)"), "update calls go through the original wrappers")
test.check(!host.hasText(partial.llvm, "minyar_live_bind"), "update images need no wrappers of their own")
let literalIr = "@.message = private unnamed_addr constant [3 x i8] c\"ab\\00\"\ndefine ptr @.minyar.fn.message() uwtable {\nentry:\n  ret ptr @.message\n}\ndefine i64 @.minyar.fn.other() uwtable {\nentry:\n  ret i64 1\n}\ndefine i32 @main() {\nentry:\n  ret i32 0\n}\n"
let literalInitial = live.transform(literalIr, 0, true)
let literalUpdate = live.transformUpdate(host.replaceText(literalIr, "c\"ab\\00\"", "c\"cd\\00\""), 4, live.sessionOf(literalInitial))
test.check(literalUpdate.error == "" && literalUpdate.names.length == 1 && literalUpdate.names[0] == ".minyar.fn.message", "editing a literal recompiles the functions that read it")
let everything = live.transformUpdate(ir, 3, live.session(initial.digests, live.encodePairs([], []), initial.cells, ""))
test.check(everything.error == "" && everything.added.length == 6, "functions the executable lacks are added: " + everything.error)
let closureIr = "define internal i64 @.minyar.closure.7(i64 %value) {\nentry:\n  %next = add i64 %value, 1\n  ret i64 %next\n}\ndefine ptr @.minyar.fn.outer() uwtable {\nentry:\n  ret ptr @.minyar.closure.7\n}\ndefine i64 @.minyar.fn.other() uwtable {\nentry:\n  ret i64 1\n}\n"
let closureInitial = live.transform(closureIr, 0, true)
let closureUpdate = live.transformUpdate(host.replaceText(closureIr, "add i64 %value, 1", "add i64 %value, 2"), 5, live.sessionOf(closureInitial))
test.check(closureUpdate.error == "" && closureUpdate.names.length == 1 && closureUpdate.names[0] == ".minyar.fn.outer", "editing a closure recompiles the functions that create it")

let unusedIr = "define internal i64 @.minyar.fn.unused() uwtable {\nentry:\n  %value = load i64, ptr @os_only_table\n  ret i64 %value\n}\ndefine internal i64 @.minyar.fn.used() uwtable {\nentry:\n  ret i64 1\n}\ndefine i32 @main() {\nentry:\n  %value = call i64 @.minyar.fn.used()\n  ret i32 0\n}\n"
let pruned = live.transformProgram(unusedIr, 0, true)
test.check(pruned.error == "" && pruned.names.length == 1 && pruned.names[0] == ".minyar.fn.used", "live programs drop functions nothing reaches: " + pruned.error)
test.check(!host.hasText(pruned.llvm, "os_only_table"), "an unreachable function's references leave with it")
test.check(live.transform(unusedIr, 0, true).names.length == 2, "the REPL transform keeps every declaration")
test.check(live.transformUpdate(unusedIr, 1, live.sessionOf(pruned)).error == "", "updates prune the same functions")
let stopsCalling = live.transformUpdate(host.replaceText(unusedIr, "%value = call i64 @.minyar.fn.used()\n", ""), 1, live.sessionOf(pruned))
test.check(stopsCalling.error == "" && stopsCalling.signature == pruned.signature, "a body edit that stops calling a function keeps the signature: " + stopsCalling.error)
let startsCalling = live.transformUpdate(host.replaceText(unusedIr, "@.minyar.fn.used()\n  ret i32", "@.minyar.fn.unused()\n  ret i32"), 1, live.sessionOf(pruned))
test.check(startsCalling.error == "" && host.hasText(startsCalling.llvm, "define internal i64 @minyar.live.1.body.0(") && startsCalling.added.length == 0, "a first call to an intrinsic the program left out carries its body: " + startsCalling.error)
test.check(live.compatibility(pruned.signature, startsCalling.signature) == "", "a first call to a left-out intrinsic is a body edit")
let tableIr = "@.dispatch.4 = private unnamed_addr constant [2 x { i64, i64 }] [\n  { i64, i64 } { i64 1, i64 10 },\n  { i64, i64 } { i64 2, i64 20 }\n]\ndefine i64 @.minyar.fn.lookup(i64 %key) uwtable {\nentry:\n  %row = getelementptr { i64, i64 }, ptr @.dispatch.4, i64 %key\n  %value = load i64, ptr %row\n  ret i64 %value\n}\ndefine i64 @.minyar.fn.other() uwtable {\nentry:\n  ret i64 1\n}\n"
let tableInitial = live.transformProgram(tableIr, 0, true)
let tableUpdate = live.transformUpdate(host.replaceText(tableIr, "i64 2, i64 20", "i64 2, i64 21"), 6, live.sessionOf(tableInitial))
test.check(tableUpdate.error == "" && tableUpdate.names.length == 1 && tableUpdate.names[0] == ".minyar.fn.lookup", "editing a multi-line table recompiles its readers: " + tableUpdate.error)

// Edits may add functions, records and imports; nothing else.
let base = "use \"./other.min\" as other\nrecord Point { x: Integer }\nglobal count: Integer = 1\nfunction value(): Integer { return 1 }\nprint(value())\n"
function added(before: Text, after: Text): Text { return live.additions(live.surfaceItems(before).items, live.surfaceItems(after).items) }
test.check(added(base, base) == "", "an unchanged surface adds nothing")
test.check(added(base, base + "function extra(x: Integer): Integer { return x }\n") == "", "a new function may be added")
test.check(added(base, "deterministic function first(): Integer { return 0 }\n" + base) == "", "a new function with modifiers may be added anywhere")
test.check(added(base, "use \"./third.min\" as third\n" + base) == "", "a new import may be added")
test.check(added(base, base + "public record Pair { a: Integer; b: Integer }\n") == "", "a new record may be added")
test.check(added(base, host.replaceText(base, "function value(): Integer { return 1 }", "function value(): Integer { return 2 }")) == "", "a body edit adds nothing")
test.check(added(base, base + "global other: Integer = 2\n") != "", "a new global needs its initializer run")
test.check(added(base, base + "print(2)\n") != "", "new top-level statements need a restart")
test.check(added(base, host.replaceText(base, "x: Integer", "x: Float")) != "", "a changed record needs a restart")
test.check(added(base, host.replaceText(base, "function value(): Integer {", "function value(): Float {")) != "", "a changed function header needs a restart")
test.check(added(base, host.replaceText(base, "function value(): Integer { return 1 }\n", "")) != "", "a removed function needs a restart")
test.check(added(base, host.replaceText(base, "./other.min", "./another.min")) != "", "a changed import needs a restart")
test.check(live.surface(base) == "live-surface-v1\n" + joinText(fieldsWithoutKinds(live.surfaceItems(base).items)), "the surface is its items' tokens")
function fieldsWithoutKinds(items: List<Text>): List<Text> {
    let result: List<Text> = []
    for item in items { result.add(host.textSlice(item, 1, item.byteLength)) }
    return result
}

// An update may add functions (with wrappers of its own) but not module state;
// the signature check keeps every original function and type.
let addIr = "@\"minyar.constant|session|value\" = internal global ptr zeroinitializer\ndefine i64 @.minyar.fn.keep() uwtable {\nentry:\n  ret i64 1\n}\ndefine i32 @main() {\nentry:\n  %value = call i64 @.minyar.fn.keep()\n  ret i32 0\n}\n"
let addInitial = live.transformProgram(addIr, 0, true)
let grownIr = host.replaceText(addIr, "  ret i64 1\n}\n", "  %more = call i64 @.minyar.fn.fresh(i64 1)\n  ret i64 %more\n}\ndefine i64 @.minyar.fn.fresh(i64 %x) uwtable {\nentry:\n  ret i64 %x\n}\n")
let grown = live.transformUpdate(grownIr, 7, live.sessionOf(addInitial))
test.check(grown.error == "" && grown.added.length == 1 && grown.added[0] == ".minyar.fn.fresh", "an update adds a new function: " + grown.error)
test.check(grown.names.length == 2 && host.listed(grown.names, ".minyar.fn.fresh") && host.listed(grown.names, ".minyar.fn.keep"), "the table lists the added function and its changed caller")
test.check(host.hasText(grown.llvm, "call ptr @minyar_live_bind(ptr @minyar.live.7.key."), "an added function gets a wrapper of its own")
test.check(host.hasText(grown.llvm, "call i64 @minyar.live.7.function."), "the changed caller calls the added function through its wrapper")
test.check(live.compatibility(addInitial.signature, grown.signature) == "", "an added function keeps the program compatible")
test.check(host.hasText(live.compatibility(grown.signature, addInitial.signature), "cannot remove or rename fresh"), "a removed function is named")
test.check(host.hasText(live.compatibility(addInitial.signature, live.transformProgram(host.replaceText(addIr, "define i64 @.minyar.fn.keep()", "define i1 @.minyar.fn.keep()"), 1, false).signature), "changed a compiled function signature (keep)"), "a changed signature is named")
test.check(host.hasText(live.compatibility(addInitial.signature, live.transformProgram(addIr + "; minyar-native-library: json\n", 1, false).signature), "cannot add native code"), "a new native library needs a restart")
test.check(live.compatibility(addInitial.signature, live.transformProgram("%record.Point = type { i64 }\n" + addIr, 1, false).signature) == "", "a new type may be added")
let stateIr = "@\"minyar.constant|fresh|value\" = internal global i64 0\n" + addIr
test.check(host.hasText(live.transformUpdate(stateIr, 8, live.sessionOf(addInitial)).error, "cannot add module state (fresh)"), "new module state needs a restart")
test.check(live.wellFormed(addInitial.exports) && !live.wellFormed("live-pairs-v1\n3:ab\n") && !live.wellFormed(""), "malformed session files are recognised")

// Whole programs tag each module by its path, not its import position, so an
// update that adds a module carries only the new code; other names are unchanged.
function moduleIr(): Text {
    let parts: List<Text> = []
    parts.add("@\"minyar.constant|minyar_module_0123456789abcdef_COUNT|value\" = internal global i64 0\n")
    parts.add("define i64 @.minyar.fn.minyar_module_0123456789abcdef_count() uwtable {\nentry:\n  %value = load i64, ptr @\"minyar.constant|minyar_module_0123456789abcdef_COUNT|value\"\n  ret i64 %value\n}\n")
    parts.add("define i64 @.minyar.fn.minyar_module_fedcba9876543210_other() uwtable {\nentry:\n  %value = call i64 @.minyar.fn.minyar_module_0123456789abcdef_count()\n  ret i64 %value\n}\n")
    parts.add("define i32 @main() {\nentry:\n  %value = call i64 @.minyar.fn.minyar_module_fedcba9876543210_other()\n  ret i32 0\n}\n")
    return joinText(parts)
}
let modulesInitial = live.transformProgram(moduleIr(), 0, true)
test.check(modulesInitial.error == "", "module image: " + modulesInitial.error)
let inserted = live.transformUpdate(moduleIr() + "define i64 @.minyar.fn.minyar_module_00112233445566ff_fresh() uwtable {\nentry:\n  ret i64 7\n}\n", 9, live.sessionOf(modulesInitial))
test.check(inserted.error == "" && inserted.names.length == 1 && inserted.added.length == 1 && host.hasText(inserted.added[0], "minyar_module_00112233445566ff_fresh"), "an added module carries only its own function: " + inserted.error)

// Generic instances are numbered by first use; a renumbering that gives an
// existing name another instantiation's code is refused.
function genericIr(first: Text, second: Text): Text {
    return "define ptr @.minyar.fn.minyar_generic_function_0_show(ptr %value) uwtable {\nentry:\n  " + first + "\n  ret ptr %value\n}\ndefine ptr @.minyar.fn.minyar_generic_function_1_show(ptr %value) uwtable {\nentry:\n  " + second + "\n  ret ptr %value\n}\ndefine i32 @main() {\nentry:\n  ret i32 0\n}\n"
}
let genericInitial = live.transformProgram(genericIr("call void @a()", "call void @b()"), 0, true)
test.check(live.transformUpdate(genericIr("call void @a2()", "call void @b()"), 10, live.sessionOf(genericInitial)).error == "", "editing one instantiation's code is a body edit")
test.check(host.hasText(live.transformUpdate(genericIr("call void @b()", "call void @a()"), 10, live.sessionOf(genericInitial)).error, "generic instantiations apart"), "swapped generic instance names are refused")
let thirdIr = genericIr("call void @c()", "call void @a()") + "define ptr @.minyar.fn.minyar_generic_function_2_show(ptr %value) uwtable {\nentry:\n  call void @b()\n  ret ptr %value\n}\n"
test.check(host.hasText(live.transformUpdate(thirdIr, 10, live.sessionOf(genericInitial)).error, "generic instantiations apart"), "an instantiation inserted before others is refused")
let appendedIr = genericIr("call void @a()", "call void @b()") + "define ptr @.minyar.fn.minyar_generic_function_2_show(ptr %value) uwtable {\nentry:\n  call void @c()\n  ret ptr %value\n}\n"
test.check(live.transformUpdate(appendedIr, 10, live.sessionOf(genericInitial)).error == "", "an instantiation added after the others is an addition")

// Compile generated forwarding code, so the contract checks cover real LLVM
// syntax and every supported scalar/pointer ABI at both useful optimizations.
let work = test.scratch()
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
io.writeTextFile(work + "/initial.ll", initial.llvm)
io.writeTextFile(work + "/next.ll", next.llvm)
io.writeTextFile(work + "/partial.ll", partial.llvm)
io.writeTextFile(work + "/resolver.c", "static const long long epoch; const long long *minyar_live_epoch = &epoch; long long minyar_live_epoch_seen;\nvoid *minyar_live_bind(const char *name, void *initial, void **slot) { (void)name; *slot = initial; return initial; }\n")
for optimization in ["-O0", "-O2"] {
    test.require(test.run([clang, optimization, "-Wno-override-module", work + "/initial.ll", work + "/resolver.c", "-o", work + "/program"], system.environment(), "", work + "/link", 30), "live forwarding " + optimization)
    let execution = test.run([work + "/program"], system.environment(), "", work + "/run", 10)
    test.check(execution.status == 0 && execution.output == "" && execution.errorOutput == "", "live forwarding ABI execution " + optimization + ": " + execution.errorOutput)
    test.require(test.run([clang, optimization, "-Wno-override-module", "-fPIC", "-c", work + "/next.ll", "-o", work + "/next.o"], system.environment(), "", work + "/object", 30), "replacement image LLVM " + optimization)
    test.require(test.run([clang, optimization, "-Wno-override-module", "-fPIC", "-c", work + "/partial.ll", "-o", work + "/partial.o"], system.environment(), "", work + "/partial", 30), "partial update LLVM " + optimization)
    io.writeTextFile(work + "/grown.ll", grown.llvm)
    test.require(test.run([clang, optimization, "-Wno-override-module", "-fPIC", "-c", work + "/grown.ll", "-o", work + "/grown.o"], system.environment(), "", work + "/grown", 30), "additive update LLVM " + optimization)
}
print("live transform tests passed")
