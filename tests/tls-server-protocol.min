use "io" as io
use "process" as processInfo
use "random" as secureRandom
use "tls" as tls
use "tlsserver" as server

function length(message: Bytes, at: Integer): Integer { return (message[at + 1] << 16) | (message[at + 2] << 8) | message[at + 3] }
function main(): Integer {
    let root = io.readBytesFile(processInfo.argument(0)); let identity = io.readBytesFile(processInfo.argument(1)); let key = io.readBytesFile(processInfo.argument(2))
    let client = io.readBytesFile(processInfo.argument(3)); let clientKey = io.readBytesFile(processInfo.argument(4))
    // An unauthenticated ClientHello cannot make the duplicate-extension check
    // quadratic: 16,000 distinct empty extensions (64 KB, the most its length
    // field allows) once cost 128 million comparisons before the hello was
    // refused for other reasons.
    let crowded = server.quicServer(secureRandom.bytes(64), "minyar-test", Bytes(), [identity], key, [root], true)
    let extensions = Bytes()
    for type in 0..16000 { extensions.add((type + 256) >> 8); extensions.add((type + 256) & 255); extensions.add(0); extensions.add(0) }
    let hello = Bytes(); hello.add(3); hello.add(3); hello.addBytes(Bytes(32)); hello.add(0)
    hello.add(0); hello.add(2); hello.add(0x13); hello.add(0x01); hello.add(1); hello.add(0)
    hello.add(extensions.length >> 8); hello.add(extensions.length & 255); hello.addBytes(extensions)
    let framed = Bytes(); framed.add(1); framed.add(hello.length >> 16); framed.add((hello.length >> 8) & 255); framed.add(hello.length & 255); framed.addBytes(hello)
    server.receiveHandshake(crowded, framed, 0)
    if crowded.state != server.FAILED || crowded.error != "too many ClientHello extensions" { print("crowded ClientHello: " + crowded.error); return 5 }
    for mode in 0..8 {
        let c = tls.quicClient("localhost", secureRandom.bytes(64), "minyar-test", Bytes(), [root], [client], clientKey)
        let s = server.quicServer(secureRandom.bytes(64), "minyar-test", Bytes(), [identity], key, [root], true)
        server.receiveHandshake(s, tls.takeOutgoing(c), 0)
        tls.receiveHandshake(c, server.takeInitial(s), 0)
        tls.receiveHandshake(c, server.takeHandshake(s), 1)
        if c.state != tls.ESTABLISHED || s.state != server.HANDSHAKE { return 1 }
        let flight = tls.takeOutgoing(c)
        let certificateEnd = 4 + length(flight, 0)
        let verifyEnd = certificateEnd + 4 + length(flight, certificateEnd)
        if mode == 1 { flight[verifyEnd - 1] = flight[verifyEnd - 1] ^ 1 }
        if mode == 2 { flight[flight.length - 1] = flight[flight.length - 1] ^ 1 }
        if mode == 3 { let replaced = flight.slice(0, certificateEnd); replaced.addBytes(flight.slice(verifyEnd, flight.length)); flight = replaced }
        if mode == 4 { flight = flight.slice(verifyEnd, flight.length) }
        if mode == 5 { flight[certificateEnd + 7] = flight[certificateEnd + 7] ^ 1 }
        if mode == 6 { flight = flight.slice(0, flight.length - 1) }
        if mode == 7 { server.receiveHandshake(s, flight, 0) }
        else { server.receiveHandshake(s, flight, 1) }
        if mode == 6 { server.endInput(s) }
        if mode == 0 {
            if s.state != server.ESTABLISHED || !s.authenticated { return 2 }
            server.endInput(s)
            if s.state != server.ESTABLISHED { return 3 }
        } else if s.state != server.FAILED { print("server accepted adversarial flight " + Text(mode)); return 4 }
    }
    print("TLS server adversarial proof: forged CertificateVerify/Finished, skipped messages, wrong level and truncated handshake rejected")
    return 0
}
