use "zstd" as zstd
use "deflate" as deflate
let codec = argument(0)
let operation = argument(1)
let input = readBytesFile(argument(2))
function number(text: Text): Integer {
    let value = 0
    for character in text { value = value * 10 + Integer(character) - 48 }
    return value
}
let cap = number(argument(4))
let status = 0
let output = Bytes()
if codec == "zstd" {
    let c = zstd.createCCtx()
    let d = zstd.createDCtx()
    if operation == "compress" {
        let result = zstd.compressWith(c, input, 3, cap)
        status = zstd.status(result); output = zstd.data(result)
    } else {
        let result = zstd.decompressWith(d, input, cap)
        status = zstd.status(result); output = zstd.data(result)
    }
    zstd.closeCCtx(c); zstd.closeDCtx(d)
} else {
    let format = deflate.GZIP
    if codec == "zlib" { format = deflate.ZLIB }
    if codec == "raw" { format = deflate.RAW }
    if operation == "compress" {
        let result = deflate.compress(input, format, 6, cap)
        status = deflate.status(result); output = deflate.data(result)
    } else {
        let result = deflate.decompress(input, format, cap)
        status = deflate.status(result); output = deflate.data(result)
    }
}
writeBytesFile(argument(3), output)
print(status)
