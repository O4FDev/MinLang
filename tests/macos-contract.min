use "macos" as mac

function require(value: Boolean) {
    if !value { fail("macOS language ABI contract failed") }
}

mac.initialize("Language contract")
let window = mac.window("Unicode 🙂", 500, 400)
let layout = mac.column(window, 8)
let label = mac.label(layout, "hello")
let check = mac.checkbox(layout, "Enabled", true)
require(mac.checked(check))
mac.setChecked(check, false)
require(!mac.checked(check))
let slider = mac.slider(layout, 0.0, 10.0, 2.5)
require(mac.value(slider) == 2.5)
mac.setValue(slider, 7.25)
require(mac.value(slider) == 7.25)
require(mac.width(window) == 500)
require(mac.height(window) == 400)
let field = mac.textField(layout, "é🙂漢")
require(mac.text(field) == "é🙂漢")
require(mac.text(field).length == 3)
let saved = mac.text(field)
mac.setText(field, "replaced")
require(saved == "é🙂漢")
let i = 0
while i < 2000 {
    mac.setText(label, "Title " + Text(i))
    require(mac.text(label) == "Title " + Text(i))
    i = i + 1
}
mac.destroy(window)
// Returned text is owned by Minyar, independent of the native object lifetime.
require(saved == "é🙂漢")
mac.quit()
let quits = 0
while mac.nextEvent(0.0) {
    if mac.eventType() == mac.QUIT { quits = quits + 1 }
}
require(quits == 1)
print("Minyar desktop ABI and Text ownership verified")
