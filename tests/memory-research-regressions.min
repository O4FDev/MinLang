use "process" as processInfo
use "../tools/testing.min" as test
use "system" as system

record Case { name: Text; fixture: Text; optimization: Text; definitions: List<Text> }
function prefixed(value: Text, prefix: Text): Boolean {
    let raw = Bytes(value)
    let start = Bytes(prefix)
    if start.length > raw.length { return false }
    return Text(raw.slice(0, start.length)) == prefix
}
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let sanitize = false
let index = 0
while index < processInfo.argumentCount() {
    let option = processInfo.argument(index)
    if option == "--clang" && index + 1 < processInfo.argumentCount() { clang = processInfo.argument(index + 1); index += 1 }
    else if option == "--sanitize" { sanitize = true }
    else { fail("unknown memory regression option: " + option) }
    index += 1
}
let system32 = ["-DMINYAR_SYSTEM_HEAP=1", "-DMINYAR_RC_POLL_BUDGET=32"]
let cases = [
    Case { name: "small-system-backing"; fixture: "system-small-heap.c"; optimization: "-O2"; definitions: [] },
    Case { name: "append-system-o0"; fixture: "memory-research-list-reserve.c"; optimization: "-O0"; definitions: system32 },
    Case { name: "append-system-o2"; fixture: "memory-research-list-reserve.c"; optimization: "-O2"; definitions: system32 },
    Case { name: "append-pressure-k1"; fixture: "memory-research-list-debt-pressure.c"; optimization: "-O2"; definitions: ["-DMINYAR_RC_POLL_BUDGET=1"] },
    Case { name: "append-pressure-k32"; fixture: "memory-research-list-debt-pressure.c"; optimization: "-O2"; definitions: ["-DMINYAR_RC_POLL_BUDGET=32"] },
    Case { name: "append-owner-debt-k1"; fixture: "memory-research-list-owner-debt.c"; optimization: "-O2"; definitions: ["-DMINYAR_RC_POLL_BUDGET=1"] },
    Case { name: "indexed-text-system"; fixture: "memory-research-text-join-index.c"; optimization: "-O2"; definitions: system32 }
]
let environment: List<Text> = []
for entry in system.environment() {
    if !prefixed(entry, "ASAN_OPTIONS=") && !prefixed(entry, "UBSAN_OPTIONS=") { environment.add(entry) }
}
environment.add("ASAN_OPTIONS=detect_leaks=0:halt_on_error=1")
environment.add("UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1")
let work = test.scratch()
for item in cases {
    let executable = work + "/" + item.name
    let command = [clang, "-std=c11", "-Wall", "-Wextra", "-Werror", item.optimization]
    if sanitize { for flag in ["-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"] { command.add(flag) } }
    for flag in item.definitions { command.add(flag) }
    for flag in ["tests/" + item.fixture, "-o", executable, "-lm"] { command.add(flag) }
    test.require(test.run(command, system.environment(), "", executable + ".build", 60), item.name + " compile")
    let modes = [""]
    if item.fixture == "memory-research-list-owner-debt.c" { modes = ["frame", "chunk"] }
    for mode in modes {
        let argv = [executable]
        if mode != "" { argv.add(mode) }
        test.require(test.run(argv, environment, "", executable + ".run", 10), item.name + " " + mode)
    }
    if item.fixture == "memory-research-text-join-index.c" {
        let invalid = test.run([executable, "--invalid-utf8"], environment, "", executable + ".invalid", 10)
        test.check(invalid.status == 1 && invalid.output == "" && invalid.errorOutput == "Minyar stopped: Text contained invalid UTF-8.\n",
            "invalid UTF-8 join diagnostic (" + Text(invalid.status) + ")\n" + invalid.output + invalid.errorOutput)
    }
    print(item.name + ": contents, ownership and focused invariants passed")
}
test.removeTree(work)
