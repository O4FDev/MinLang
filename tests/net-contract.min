use "net" as net
use "errors" as errors

let receiver = net.udp("127.0.0.1", 0)
let sender = net.udp("127.0.0.1", 0)
if receiver < 0 || sender < 0 { fail("cannot bind UDP test sockets") }
if !net.udpConnect(sender, "127.0.0.1", net.localPort(receiver)) { fail("cannot connect UDP test peer") }
let pending = net.receiveDatagram(receiver, 64)
print(errors.bytesStatus(pending) == errors.wouldBlockStatus())
let sent = net.write(sender, Bytes())
print(errors.integerOk(sent) && errors.integerValue(sent) == 0)
if !net.ready(receiver, 1000) { fail("empty datagram did not arrive") }
let empty = net.receiveDatagram(receiver, 64)
print(errors.bytesStatus(empty) == errors.successStatus() && errors.bytesValue(empty).length == 0)
let failure = net.read(-1, 64)
print(errors.bytesStatus(failure) == errors.failureStatus() && errors.nativeCode(errors.bytesError(failure)) != 0)
let data = Bytes(257)
for index in 0..data.length { data[index] = index % 256 }
let written = net.write(sender, data)
print(errors.integerOk(written) && errors.integerValue(written) == data.length)
if !net.ready(receiver, 1000) { fail("test datagram did not arrive") }
let read = net.receiveDatagram(receiver, 512)
let correct = errors.bytesStatus(read) == errors.successStatus()
let bytes = errors.bytesValue(read)
for index in 0..bytes.length { if bytes[index] != data[index] { correct = false } }
print(correct && bytes.length == data.length)
print(errors.bytesStatus(pending) == errors.wouldBlockStatus() && errors.bytesStatus(failure) == errors.failureStatus())
let sentBatch = net.sendDatagrams(sender, [Bytes(), Bytes("one"), Bytes("two")])
print(errors.integerOk(sentBatch) && errors.integerValue(sentBatch) == 3)
if !net.ready(receiver, 1000) { fail("batch did not arrive") }
let packets: List<net.Datagram> = []
while packets.length < 3 {
    if !net.ready(receiver, 1000) { fail("incomplete batch") }
    let batch = net.receiveDatagrams(receiver, 16, 64)
    if !net.datagramBatchOk(batch) { fail(errors.message(net.datagramBatchError(batch))) }
    for packet in net.datagrams(batch) { packets.add(packet) }
}
print(packets.length == 3)
print(errors.bytesValue(net.datagramData(packets[0])).length == 0 && Text(errors.bytesValue(net.datagramData(packets[2]))) == "two")
print(net.datagramSource(packets[1]) == "127.0.0.1" && net.datagramPort(packets[1]) == net.localPort(sender))
net.close(sender)
net.close(receiver)
