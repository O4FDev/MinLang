// Restricted cipher policy tests: the red stage records policy explicitly,
// while the old negotiation/offer/ticket code is otherwise unchanged.
use "quic" as quic
use "tls" as tls
use "tlsserver" as tlsserver
use "tlstickets" as tickets
use "quiccrypto" as protection
use "crypto" as crypto
use "errors" as errors
constant AES=0x1301
constant CHACHA=0x1303
function drive(c:quic.Connection,s:quic.Connection,now:Integer) {
    for packet in quic.poll(c,now) { quic.receive(s,packet,now) }
    for packet in quic.poll(s,now) { quic.receive(c,packet,now) }
}
function transfer(c:quic.Connection,s:quic.Connection,now:Integer):Boolean {
    let opened=quic.openStream(c,false);if !errors.integerOk(opened) { return false }
    let id=errors.integerValue(opened);quic.writeStream(c,id,Bytes("restricted cipher authenticated stream"),true)
    for tick in 0..200 { drive(c,s,now+tick*10) }
    let got=quic.readStream(s,id)
    return errors.bytesOk(got) && Text(errors.bytesValue(got))=="restricted cipher authenticated stream"
}
function policy(root:Bytes,cert:Bytes,key:Bytes,client:Bytes,clientKey:Bytes,mode:Text):Integer {
    let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
    let s=quic.server(randomBytes(80),"minyar-test",c.originalDestination,[cert],key,[root],true)
    if mode=="client-policy" || mode=="chacha-update" { if !errors.booleanOk(quic.setCipherSuites(c,[CHACHA])) { return 30 } }
    if mode=="server-policy" { if !errors.booleanOk(quic.setCipherSuites(s,[CHACHA])) { return 40 } }
    for tick in 0..300 { drive(c,s,tick*10) }
    if c.state!=quic.ESTABLISHED || s.state!=quic.ESTABLISHED || !c.clientTLS.authenticated || !s.serverTLS.authenticated { return 31 }
    let expected=CHACHA;if mode=="default-aes" { expected=AES }
    if c.clientTLS.cipherSuite!=expected || s.serverTLS.cipherSuite!=expected {
        if mode=="server-policy" { print("semantic failure: server ignored its restricted ChaCha cipher policy");return 42 }
        print("semantic failure: client ignored its restricted ChaCha cipher offer");return 32
    }
    if c.spaces[2].write.suite!=expected || s.spaces[2].read.suite!=expected || !transfer(c,s,3000) { return 33 }
    if mode=="chacha-update" {
        let hp=crypto.hex(c.spaces[2].write.hp)
        if !errors.booleanOk(quic.updateKeys(c)) || errors.booleanOk(quic.updateKeys(c)) { return 34 }
        quic.ping(c)
        for tick in 0..300 { drive(c,s,6000+tick*10) }
        if c.state!=quic.ESTABLISHED || s.state!=quic.ESTABLISHED || c.spaces[2].writeGeneration!=1 || s.spaces[2].writeGeneration!=1 ||
           c.spaces[2].readGeneration!=1 || s.spaces[2].readGeneration!=1 || crypto.hex(c.spaces[2].write.hp)!=hp { return 35 }
        if !transfer(c,s,9000) { return 36 }
        print("restricted ChaCha packet/HP protection and reciprocal ACK-gated key update preserved authenticated streams")
    } else { print("cipher policy authenticated the selected suite and stream") }
    return 0
}
function ticketPolicy(root:Bytes,cert:Bytes,key:Bytes,client:Bytes,clientKey:Bytes,clientOnly:Boolean):Integer {
    let store=tickets.store(randomBytes(16),3600);tickets.allowEarlyData(store,0xffffffff)
    let first=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
    let issuer=quic.serverWithTickets(randomBytes(80),"minyar-test",first.originalDestination,[cert],key,[root],true,store)
    for tick in 0..300 { drive(first,issuer,tick*10) }
    let ticket=quic.takeTicket(first);if !ticket.valid || ticket.suite!=AES { return 50 }
    let c=quic.clientEarly("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey,ticket)
    let s=quic.serverWithTickets(randomBytes(80),"minyar-test",c.originalDestination,[cert],key,[root],true,store)
    if clientOnly {
        if !errors.booleanOk(quic.setCipherSuites(c,[CHACHA])) { return 60 }
        if c.clientTLS.ticket.valid || c.clientTLS.earlyOffered {
            print("semantic failure: client retained an AES ticket and 0-RTT under a ChaCha-only policy");return 62
        }
    } else { if !errors.booleanOk(quic.setCipherSuites(s,[CHACHA])) { return 51 } }
    for tick in 0..300 { drive(c,s,tick*10) }
    if c.clientTLS.cipherSuite!=CHACHA || s.serverTLS.cipherSuite!=CHACHA || c.clientTLS.resumed || s.serverTLS.resumed {
        print("semantic failure: resumption restored an excluded ticket cipher over server policy");return 52
    }
    if c.state!=quic.ESTABLISHED || s.state!=quic.ESTABLISHED || !transfer(c,s,3000) { return 53 }
    print("excluded AES ticket fell back to a fresh authenticated ChaCha handshake without early data")
    return 0
}
function unoffered(root:Bytes,cert:Bytes,key:Bytes,client:Bytes,clientKey:Bytes):Integer {
    let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
    let original=c.initialHandshake
    if !errors.booleanOk(quic.setCipherSuites(c,[CHACHA])) { return 70 }
    let server=tlsserver.quicServer(randomBytes(80),"minyar-test",Bytes(),[cert],key,[root],true)
    tlsserver.receiveHandshake(server,original,0)
    let hello=server.initialOutgoing
    if hello.length<40 || hello[0]!=2 || server.cipherSuite!=AES { return 71 }
    tls.receiveHandshake(c.clientTLS,hello,0)
    if c.clientTLS.state!=tls.FAILED {
        print("semantic failure: client accepted a ServerHello cipher excluded by its offer");return 72
    }
    print("client rejected an unoffered ServerHello cipher before accepting handshake keys")
    return 0
}
function invalidPolicy(root:Bytes,cert:Bytes,key:Bytes,client:Bytes,clientKey:Bytes):Integer {
    let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
    let original=crypto.hex(c.initialHandshake)
    if errors.booleanOk(quic.setCipherSuites(c,[])) || errors.booleanOk(quic.setCipherSuites(c,[CHACHA,CHACHA])) ||
       errors.booleanOk(quic.setCipherSuites(c,[0x1302])) || crypto.hex(c.initialHandshake)!=original { return 80 }
    let s=quic.server(randomBytes(80),"minyar-test",c.originalDestination,[cert],key,[root],true)
    for tick in 0..300 { drive(c,s,tick*10) }
    if errors.booleanOk(quic.setCipherSuites(c,[CHACHA])) || errors.booleanOk(quic.setCipherSuites(s,[CHACHA])) || c.clientTLS.cipherSuite!=AES { return 81 }
    print("invalid or late policy changes were refused and default AES negotiation stayed intact")
    return 0
}
function main():Integer {
    let root=readBytesFile(argument(0));let cert=readBytesFile(argument(1));let key=readBytesFile(argument(2))
    let client=readBytesFile(argument(3));let clientKey=readBytesFile(argument(4));let mode=argument(5)
    if mode=="server-ticket" || mode=="client-ticket" { return ticketPolicy(root,cert,key,client,clientKey,mode=="client-ticket") }
    if mode=="unoffered" { return unoffered(root,cert,key,client,clientKey) }
    if mode=="invalid-policy" { return invalidPolicy(root,cert,key,client,clientKey) }
    return policy(root,cert,key,client,clientKey,mode)
}
