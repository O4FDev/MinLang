use "ui" as ui
use "ui-macos" as app
use "macos" as mac
use "process" as process

function click(title: Text) { native "uitest" }
function edit(previous: Text, value: Text) { native "uitest" }
function select(value: Text) { native "uitest" }
function selectionKept(value: Text): Boolean { native "uitest" }
function hasSpacing(points: Integer): Boolean { native "uitest" }
function badSpacing(points: Integer) {
    let window = mac.window("Invalid spacing", 100, 100)
    let row = mac.row(window, 0)
    mac.spacing(row, points)
    fail("accepted invalid spacing")
}
function require(condition: Boolean, message: Text) { if !condition { fail(message) } }
function view(name: Text, checked: Boolean, caption: Text): ui.View {
    return ui.padded(ui.column([
        ui.heading(caption), ui.input("name", name),
        ui.toggle("enabled", "Shine", checked), ui.button("add", "Add light"),
    ]), 16)
}
function receive(window: app.Application, kind: Integer, key: Text) {
    // Bound event draining by count; native AppKit calls dispatch queued events.
    for attempt in 0..100 {
        require(app.nextEvent(window, 0.0), "window stopped during test")
        if app.eventKind(window) == kind && app.eventKey(window) == key { return }
    }
    fail("expected native event for " + key)
}

app.initialize("Declarative UI contract")
let window = app.open("Declarative UI", 480, 320, view("Ada", true, "Hello 🙂"))
let name = app.handle(window, "name")
let action = app.handle(window, "add")
require(name != 0 && action != 0 && app.handle(window, "missing") == 0, "control lookup")
let mode = ""
if process.argumentCount() > 0 { mode = process.argument(0) }
if mode == "invalid" { app.update(window, ui.row([ui.button("same", "One"), ui.button("same", "Two")])) }
if mode == "disposed" { app.dispose(window); app.update(window, view("Ada", false, "Later")) }
if mode == "multiple" { app.open("Another", 320, 240, ui.label("Another")) }
if mode == "spacing-type" { mac.spacing(app.handle(window, "name"), 12) }
if mode == "spacing-negative" { badSpacing(-1) }
if mode == "spacing-large" { badSpacing(100001) }

click("Add light")
receive(window, app.ACTION, "add")
edit("Ada", "é🙂漢")
receive(window, app.CHANGE, "name")
require(app.eventText(window) == "é🙂漢", "native edit snapshot")
select("é🙂漢")
app.update(window, view(app.eventText(window), false, "Welcome home"))
require(app.handle(window, "name") == name && app.handle(window, "add") == action, "value update replaced controls")
require(app.text(window, "name") == "é🙂漢" && !app.isChecked(window, "enabled"), "controlled values")
require(selectionKept("é🙂漢"), "value-identical input update lost focus or selection")
for points in [0, 20, 256] {
    app.update(window, ui.spaced(view("é🙂漢", false, "Welcome home"), points))
    require(hasSpacing(points), "native stack did not apply spacing")
    require(app.handle(window, "name") == name && app.handle(window, "add") == action, "spacing update replaced controls")
    require(selectionKept("é🙂漢"), "spacing update lost focus or selection")
}
for index in 0..200 {
    app.update(window, view(Text(index), index % 2 == 0, "Count " + Text(index)))
    require(app.handle(window, "name") == name, "repeated update replaced editor")
}
click("Shine")
receive(window, app.ACTION, "enabled")
require(app.isChecked(window, "enabled"), "native checkbox action")
app.update(window, ui.padded(ui.row([ui.input("name", "Rebuilt"), ui.button("add", "Again")]), 12))
require(app.handle(window, "name") != name && app.handle(window, "add") != action, "structural update reused destroyed controls")
require(app.text(window, "name") == "Rebuilt", "structural update values")
click("Again")
receive(window, app.ACTION, "add")
let handle = app.windowHandle(window)
mac.close(handle)
let closed = false
for attempt in 0..100 { if !app.nextEvent(window, 0.0) { closed = true; break } }
require(closed, "window closure was not delivered")
app.dispose(window)
app.dispose(window)
print("Declarative AppKit events, Unicode, 200 retained updates, rebuild and closure verified")
