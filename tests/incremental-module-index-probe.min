function moduleIndexProbeRow(prior: List<Text>, path: Text, role: Text) {
    prior.add(path)
    prior.add(role)
    let column = 2
    while column < 10 { prior.add(""); column = column + 1 }
}

function moduleIndexProbeLinear(prior: List<Text>, path: Text, role: Text): Integer {
    let position = 3
    while position + 9 < prior.length {
        if prior[position] == path && prior[position + 1] == role { return position }
        position = position + 10
    }
    return -1
}

function main() {
    let prior: List<Text> = []
    let length = 0
    while length <= 12 {
        let empty = buildModuleIndex(prior)
        if priorModule(prior, empty, "absent", "entry") != -1 { fail("empty or partial cache row") }
        prior.add("")
        length = length + 1
    }
    let paths: List<Text> = ["", "/same", "/same", "/same", "/space λ \"quote\" | suffix", "/é", "/é", "/界", "/🙂", "/same"]
    let roles: List<Text> = ["", "entry", "library", "entry", "library", "library", "library", "entry", "not-library", ""]
    prior = ["schema", "signature", "table"]
    let position = 0
    while position < paths.length {
        moduleIndexProbeRow(prior, paths[position], roles[position])
        position = position + 1
    }
    position = 0
    while position < 700 {
        moduleIndexProbeRow(prior, "/shared_prefix_" + Text(position), "library")
        position = position + 1
    }
    prior.add("/partial")
    prior.add("entry")
    let lookup = buildModuleIndex(prior)
    let collisions = 0
    position = 3
    while position + 9 < prior.length {
        let bucket = moduleRowHash(prior[position], prior[position + 1]) % lookup.length
        if lookup[bucket] != position { collisions = collisions + 1 }
        for role in ["entry", "library", "not-library", "", "absent"] {
            let actual = priorModule(prior, lookup, prior[position], role)
            let expected = moduleIndexProbeLinear(prior, prior[position], role)
            if actual != expected { fail("module row index disagrees with independent linear lookup") }
        }
        if priorModule(prior, lookup, "/missing_" + Text(position), "library") != -1 { fail("absent module row") }
        position = position + 10
    }
    if collisions < 20 { fail("module row collision coverage disappeared") }
    if priorModule(prior, lookup, "/sa" + "me", "entry") != 13 { fail("first duplicate module row must win") }
    if priorModule(prior, lookup, "/same", "library") != 23 { fail("module row role must remain part of identity") }
    if priorModule(prior, lookup, "/partial", "entry") != -1 { fail("incomplete trailing module row") }
    print("module row index verified")
}
