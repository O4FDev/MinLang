record Cell {
    value: Integer
    callback: Callback<Integer, Integer>
}

let cell = Cell {
    value: 1
    callback: function(value: Integer): Integer { return value * 2 }
}
let values = [-1, 2, 3]
let answers = {"answer": 21}
values[0] += cell.callback(answers["answer"])
cell.value = values[0]
if !(cell.value == 0) && true || false {
    print(cell.value)
} else if cell.value == 1 {
    print(0)
} else {
    print(-1)
}

let iterations = 0
while true {
    iterations += 1
    if iterations == 1 { continue }
    break
}
