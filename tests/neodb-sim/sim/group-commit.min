use "simulation" as simulation
use "../src/workload.min" as workload

// Up to three sessions each leave a commit in flight; recovery must keep every
// acknowledged commit and a prefix of the in-flight ones, across two power
// losses that tear every file in 512-byte sectors.
public function universe(world: simulation.World): Text {
    return workload.run(world, workload.Mix { earlyAck: false; crashes: 2; sectors: true; checkpoints: true; transactions: true; sessions: 3 })
}
