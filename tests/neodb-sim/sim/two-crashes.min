use "simulation" as simulation
use "../src/workload.min" as workload

// Acknowledged commits survive two power losses in a row, with work between
// them; each keeps any subset of the unsynced 512-byte WAL sectors.
public function universe(world: simulation.World): Text { return workload.run(world, workload.Mix { earlyAck: false; crashes: 2; sectors: true; checkpoints: true; transactions: false; sessions: 1 }) }
