use "simulation" as simulation
use "../src/workload.min" as workload

// Multi-statement transactions are all or nothing across two power losses that
// tear every file in 512-byte sectors, with checkpoints in between.
public function universe(world: simulation.World): Text {
    return workload.run(world, workload.Mix { earlyAck: false; crashes: 2; sectors: true; checkpoints: true; transactions: true; sessions: 1 })
}
