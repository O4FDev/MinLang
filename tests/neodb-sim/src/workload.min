use "simulation" as simulation
use "../../fixtures/neodb-engine/lib/dbio.min" as dbio
use "../../fixtures/neodb-engine/src/engine/api.min" as engine
use "../../fixtures/neodb-engine/src/engine/values.min" as values
use "../../fixtures/neodb-engine/src/storage/wal.min" as wal
use "text" as utf8

// One universe of the pinned production neo-db engine over the simulated dbio
// facade: random autocommit statements, each acknowledged only once durable,
// one statement in flight, a crash keeping a random prefix of the WAL, then
// recovery. Recovered rows must match the acknowledged history, with the
// in-flight statement either applied or absent.

record Rows { ids: List<Integer>; values: List<Integer> }

function copyRows(rows: Rows): Rows {
    let result = Rows { ids: []; values: [] }
    for index in 0..rows.ids.length { result.ids.add(rows.ids[index]); result.values.add(rows.values[index]) }
    return result
}

// Apply one statement to the model and return its SQL.
function statement(world: simulation.World, rows: Rows, base: Integer): Text {
    let id = base + 1 + simulation.choose(world, 6)
    let kind = simulation.choose(world, 3)
    if kind == 0 || rows.ids.length < 2 {
        let value = simulation.choose(world, 1000)
        rows.ids.add(id)
        rows.values.add(value)
        return "INSERT INTO cargo VALUES (" + Text(id) + ", " + Text(value) + ")"
    }
    if kind == 1 {
        let delta = 1 + simulation.choose(world, 50)
        for index in 0..rows.ids.length { if rows.ids[index] == id { rows.values[index] += delta } }
        return "UPDATE cargo SET weight = weight + " + Text(delta) + " WHERE id = " + Text(id)
    }
    let kept = Rows { ids: []; values: [] }
    for index in 0..rows.ids.length {
        if rows.ids[index] != id { kept.ids.add(rows.ids[index]); kept.values.add(rows.values[index]) }
    }
    rows.ids = kept.ids
    rows.values = kept.values
    return "DELETE FROM cargo WHERE id = " + Text(id)
}

function drive(e: engine.Engine, world: simulation.World): Boolean {
    engine.afterLoopIteration(e)
    let attempts = 0
    while simulation.pendingCount(world) > 0 {
        attempts += 1
        if attempts > 128 || dbio.completeNext() <= 0 { return false }
    }
    engine.onSyncReadable(e)
    return true
}

// Run one statement; "" when it succeeded (and, if `wait`, became durable).
function execute(e: engine.Engine, session: engine.Session, world: simulation.World, text: Text, wait: Boolean): Text {
    let outcomes = engine.simpleQuery(e, session, text)
    if outcomes.length == 0 { return "no outcome for " + text }
    for outcome in outcomes {
        if outcome.status != engine.STATUS_OK { return text + ": " + outcome.message }
        let attempts = 0
        while wait && engine.durableLsn(e) < outcome.waitLsn {
            attempts += 1
            if attempts > 128 || !drive(e, world) { return "commit never became durable: " + text }
        }
    }
    return ""
}

// The single Integer of a one-row, one-column result, or -1.
function scalar(e: engine.Engine, session: engine.Session, text: Text): Integer {
    let outcomes = engine.simpleQuery(e, session, text)
    if outcomes.length != 1 || outcomes[0].status != engine.STATUS_OK || outcomes[0].rowCount != 1 { return -1 }
    let data = outcomes[0].rowData
    if data.length < 11 || data[0] != 68 { return -1 }
    let length = values.getBE32(data, 7)
    if length < 1 || length != data.length - 11 { return -1 }
    let digits = utf8.decodeOrStop(data.slice(11, 11 + length))
    let result = 0
    for digit in digits {
        if digit < '0' || digit > '9' { return -1 }
        result = result * 10 + Integer(digit) - 48
    }
    return result
}

function open(): engine.Engine {
    let options = engine.defaultOptions()
    options.checkpointIntervalMs = 0
    options.noPrealloc = true
    options.slicedLoads = false   // embedded use: a table loads in one step
    return engine.openWithOptions("/db", options)
}

// `states[k]` is the state with the first k in-flight commits applied.
record Round { problem: Text; states: List<Rows>; inFlight: Text }

// A checkpoint publishes a snapshot and lets the WAL restart in a new segment.
function checkpoint(e: engine.Engine, session: engine.Session, world: simulation.World): Text {
    let requested = engine.simpleQuery(e, session, "CHECKPOINT")
    if requested.length != 1 || requested[0].status == engine.STATUS_ERROR { return "CHECKPOINT was refused" }
    let attempts = 0
    while engine.backgroundPending(e) {
        attempts += 1
        if attempts > 128 || !drive(e, world) { return "checkpoint never finished" }
    }
    simulation.reached(world, "checkpoint completed")
    return ""
}

// What one universe exercises.
public record Mix { earlyAck: Boolean; crashes: Integer; sectors: Boolean; checkpoints: Boolean; transactions: Boolean; sessions: Integer }

record Unit { text: Text; problem: Text }

// One autocommit statement or, with transactions, sometimes BEGIN, two to four
// statements and COMMIT. `rows` changes only if the unit commits; the COMMIT
// waits for durability when `wait` is set.
function unit(world: simulation.World, e: engine.Engine, session: engine.Session, rows: Rows, mix: Mix, wait: Boolean, base: Integer): Unit {
    if !mix.transactions || simulation.choose(world, 3) != 0 {
        let text = statement(world, rows, base)
        return Unit { text: text; problem: execute(e, session, world, text, wait) }
    }
    let staged = copyRows(rows)
    let parts: List<Text> = ["BEGIN"]
    let problem = execute(e, session, world, "BEGIN", false)
    for index in 0..2 + simulation.choose(world, 3) {
        if problem == "" {
            let text = statement(world, staged, base)
            parts.add(text)
            problem = execute(e, session, world, text, false)
        }
    }
    parts.add("COMMIT")
    if problem == "" { problem = execute(e, session, world, "COMMIT", wait) }
    rows.ids = staged.ids
    rows.values = staged.values
    simulation.reached(world, "transaction committed")
    let text = ""
    for index in 0..parts.length {
        if index > 0 { text += "; " }
        text += parts[index]
    }
    return Unit { text: text; problem: problem }
}

// Acknowledged units, in-flight units from one or more sessions, and a crash,
// on top of `rows`, the state the engine holds now. Afterwards `rows` includes
// every in-flight unit and the result lists the states in commit order.
function round(world: simulation.World, e: engine.Engine, rows: Rows, mix: Mix): Round {
    let session = engine.newSession(e, "sim", "sim")
    for serial in 0..1 + simulation.choose(world, 12) {
        if mix.checkpoints && simulation.choose(world, 8) == 0 {
            let problem = checkpoint(e, session, world)
            if problem != "" { return Round { problem: problem; states: [rows]; inFlight: "" } }
        }
        let done = unit(world, e, session, rows, mix, !mix.earlyAck, 0)
        if done.problem != "" { return Round { problem: done.problem; states: [rows]; inFlight: "" } }
    }
    // One unit in flight per session, each session in its own id range, so a
    // later session never depends on an earlier session's unfinished commit.
    let states: List<Rows> = [copyRows(rows)]
    let inFlight = ""
    for index in 0..1 + simulation.choose(world, mix.sessions) {
        let other = session
        if index > 0 { other = engine.newSession(e, "sim", "sim") }
        let flying = unit(world, e, other, rows, mix, false, index * 10)
        if inFlight != "" { inFlight += " | " }
        inFlight += flying.text
        if flying.problem != "" { return Round { problem: flying.problem; states: states; inFlight: inFlight } }
        states.add(copyRows(rows))
        if index > 0 { simulation.reached(world, "several commits in flight") }
    }
    // Before the crash the engine holds the acknowledged state plus a prefix of
    // the in-flight commits: a commit becomes visible once it is durable.
    let live = compare(e, states, inFlight)
    if live < 0 { return Round { problem: "before the crash, the live engine holds " + mismatch(e, states, inFlight); states: states; inFlight: inFlight } }
    // Let the in-flight write and sync complete partly, fully or not at all.
    engine.afterLoopIteration(e)
    for step in 0..simulation.choose(world, simulation.pendingCount(world) + 1) {
        if simulation.pendingCount(world) > 0 { dbio.completeNext() }
    }
    // The power loss reaches every file: WAL segments, snapshots and manifests.
    for name in simulation.names(world, "/db") {
        let file = simulation.openFile(world, "/db/" + name, false)
        if file > 0 && mix.sectors {
            simulation.persistSectors(world, file, 512)
        } else if file > 0 {
            let size = simulation.size(world, file)
            let kept = simulation.choose(world, size + 1)
            if kept < size { simulation.reached(world, "crash cut a file's tail") }
            simulation.persistPrefix(world, file, kept)
        }
    }
    dbio.crash()
    return Round { problem: ""; states: states; inFlight: inFlight }
}

// Ids 0..SHAPE_IDS - 1 cover every session's id range (10 per session).
constant SHAPE_IDS = 27

// Rows and total weight for each id that has rows, the shape compare() checks.
function modelShape(rows: Rows): Text {
    let parts: List<Text> = []
    for id in 0..SHAPE_IDS {
        let count = 0
        let weight = 0
        for index in 0..rows.ids.length { if rows.ids[index] == id { count += 1; weight += rows.values[index] } }
        if count != 0 { parts.add(Text(id) + ":" + Text(count) + "/" + Text(weight) + " ") }
    }
    return joinText(parts)
}

function engineShape(e: engine.Engine, reader: engine.Session): Text {
    let parts: List<Text> = []
    for id in 0..SHAPE_IDS {
        let count = scalar(e, reader, "SELECT count(*) FROM cargo WHERE id = " + Text(id))
        let weight = 0
        if count != 0 {
            weight = scalar(e, reader, "SELECT sum(weight) FROM cargo WHERE id = " + Text(id))
            parts.add(Text(id) + ":" + Text(count) + "/" + Text(weight) + " ")
        }
    }
    return joinText(parts)
}

// How many in-flight commits the engine's state includes, or -1. Per-id counts
// and weights tell apart states whose totals happen to match.
function compare(e: engine.Engine, states: List<Rows>, inFlight: Text): Integer {
    let shape = engineShape(e, engine.newSession(e, "sim", "sim"))
    for index in 0..states.length { if shape == modelShape(states[index]) { return index } }
    return -1
}

function mismatch(e: engine.Engine, states: List<Rows>, inFlight: Text): Text {
    return "id:rows/weight " + engineShape(e, engine.newSession(e, "sim", "sim")) + "instead of " + modelShape(states[0]) + "(in-flight " + inFlight + ")"
}

// `mix.earlyAck` is the planted mistake: units count as acknowledged before
// their commit is durable. Each universe survives `mix.crashes` power losses,
// which keep a random prefix of every file or, with `mix.sectors`, any subset
// of its unsynced 512-byte sectors and either file length.
public deterministic function run(world: simulation.World, mix: Mix): Text {
    dbio.bind(world)
    let e = open()
    let session = engine.newSession(e, "sim", "sim")
    let problem = execute(e, session, world, "CREATE TABLE cargo (id INTEGER, weight INTEGER)", true)
    if problem == "" { problem = execute(e, session, world, "INSERT INTO cargo VALUES (0, 0)", true) }
    if problem != "" { return problem }
    let rows = Rows { ids: [0]; values: [0] }
    for crash in 0..mix.crashes {
        let result = round(world, e, rows, mix)
        if result.problem != "" { return result.problem }
        e = open()
        let kept = compare(e, result.states, result.inFlight)
        if kept < 0 { return "after crash " + Text(crash + 1) + ": " + mismatch(e, result.states, result.inFlight) }
        if kept > 0 { simulation.reached(world, "in-flight unit survived") }
        if kept > 0 && kept < result.states.length - 1 { simulation.reached(world, "some in-flight commits survived, later ones did not") }
        rows.ids = result.states[kept].ids
        rows.values = result.states[kept].values
        if crash > 0 { simulation.reached(world, "recovered after a second crash") }
    }
    return ""
}
