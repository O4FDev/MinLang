use "quicrecovery" as recovery
use "quicstream" as stream

function main(): Integer {
    let state = recovery.create(1200)
    if state.window != 12000 || state.smoothed != 333 || recovery.pto(state, false) != 999 { return 1 }
    recovery.sample(state, 100, 25, true)
    if state.latest != 100 || state.minimum != 100 || state.smoothed != 100 || state.variance != 50 { return 2 }
    recovery.sample(state, 140, 25, true)
    if state.smoothed != 101 || state.variance != 41 { return 3 }
    let before = state.window
    recovery.acknowledged(state, 1200, 1000, 900)
    if state.window != before + 1200 { return 4 }
    recovery.lost(state, 1100, 1000)
    if state.window != 9240 { return 5 }
    recovery.lost(state, 1101, 999)
    if state.window != 9240 { return 6 }
    for index in 0..100 { recovery.acknowledged(state, 1200, 1200 + index * 100, 1101 + index * 100) }
    if state.window <= 9240 { return 7 }
    if !recovery.isLost(state, 9, 12, 1000, 1001) { return 8 }
    if recovery.isLost(state, 11, 12, 1000, 1001) { return 9 }
    if !recovery.isLost(state, 11, 12, 1000, 1200) { return 10 }
    let input = stream.create(0, 100, 100)
    if !stream.insert(input, 5, Bytes("world"), true) || stream.take(input).length != 0 { return 11 }
    if !stream.insert(input, 0, Bytes("hello"), false) || Text(stream.take(input)) != "helloworld" || !stream.finished(input) { return 12 }
    if !stream.insert(input, 0, Bytes("hello"), false) { return 13 }
    if stream.insert(input, 10, Bytes("bad"), false) { return 14 }
    let conflict = stream.create(4, 100, 100)
    if !stream.insert(conflict, 3, Bytes("xyz"), false) { return 15 }
    if stream.insert(conflict, 4, Bytes("wrong"), false) { return 16 }
    let limits = stream.create(8, 10, 10)
    if stream.insert(limits, 10, Bytes("x"), false) { return 17 }
    if !stream.insert(limits, 9, Bytes("x"), true) { return 18 }
    if stream.insert(limits, 8, Bytes(), true) { return 19 }
    let overlap = stream.create(12, 100, 100)
    if !stream.insert(overlap, 2, Bytes("cdef"), false) || !stream.insert(overlap, 0, Bytes("abcd"), false) || Text(stream.take(overlap)) != "abcdef" { return 20 }
    let acknowledged=stream.create(16,10000,10000)
    acknowledged.sendOffset=10000;acknowledged.sendClosed=true
    // FIN acknowledged before preceding bytes must not permit reclamation.
    if !stream.acknowledgeSend(acknowledged,9000,1000,true) || acknowledged.sendAcknowledged != 0 { return 21 }
    for index in 0..9 {
        let offset=((index*7)%9)*1000
        if !stream.acknowledgeSend(acknowledged,offset,1000,false) { return 22 }
    }
    if acknowledged.sendAcknowledged != 10000 || acknowledged.acknowledged.length != 0 || !acknowledged.finalAcknowledged { return 23 }
    print("QUIC state: RFC recovery, CUBIC, ordered reassembly, final-size, overlap and flow limits passed")
    return 0
}
