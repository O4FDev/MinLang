// Test vectors from the RFCs that define each primitive.
use "crypto" as crypto

function repeated(byte: Integer, count: Integer): Bytes {
    let result = Bytes()
    for index in 0..count { result.add(byte) }
    return result
}

function range(first: Integer, last: Integer): Bytes {
    let result = Bytes()
    for value in first..(last + 1) { result.add(value) }
    return result
}

print(crypto.hex(crypto.sha256(Bytes("abc"))))
print(crypto.hex(crypto.sha256(Bytes(""))))
print(crypto.hex(crypto.hmac(repeated(0x0b, 20), Bytes("Hi There"))))
let prk = crypto.hkdfExtract(range(0, 12), repeated(0x0b, 22))
print(crypto.hex(prk))
print(crypto.hex(crypto.hkdfExpand(prk, range(0xf0, 0xf9), 42)))
let key = range(0x80, 0x9f)
let nonce = crypto.fromHex("070000004041424344454647")
let additional = crypto.fromHex("50515253c0c1c2c3c4c5c6c7")
let plaintext = Bytes("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.")
let sealed = crypto.seal(key, nonce, additional, plaintext)
print(crypto.hex(sealed.slice(0, 16)))
print(crypto.hex(sealed.slice(sealed.length - 16, sealed.length)))
let opened = crypto.open(key, nonce, additional, sealed)
print(opened.valid && Text(opened.plaintext) == Text(plaintext))
sealed[3] = sealed[3] ^ 1
print(crypto.open(key, nonce, additional, sealed).valid)
let alice = crypto.fromHex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
let bob = crypto.fromHex("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb")
print(crypto.hex(crypto.x25519Public(alice)))
print(crypto.hex(crypto.x25519(alice, crypto.x25519Public(bob))))
print(crypto.hex(crypto.x25519(bob, crypto.x25519Public(alice))))
