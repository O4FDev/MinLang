use "json" as json

let value = json.parse("{\"model\": \"atacama\", \"sources\": [{\"title\": \"Berlin Wall\"}], \"seconds\": 0.25, \"lookup\": null, \"note\": \"caf\\u00e9 \\\"quoted\\\"\"}")
print(json.string(value, "model"))
print(json.member(value, "sources").items.length)
print(json.string(json.member(value, "sources").items[0], "title"))
print(json.member(value, "seconds").number)
print(json.member(value, "lookup").kind == json.NULL)
print(json.string(value, "note"))
print(json.quote("line\nbreak"))
print(json.parse("[1, 2").kind == json.INVALID)
