function guarded(): Int {
    guard let value = Optional(40) else { return 0 }
    value += 2
    return value
}

if let value = Optional(40) {
    value += 2
    print(value)
}
print(guarded())
let iterations = 0
while let value = Optional(41), iterations == 0 {
    value += 1
    print(value)
    iterations += 1
}
if constant value = Optional(42) { precondition(value == 42) }
