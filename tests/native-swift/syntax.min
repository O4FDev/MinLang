// use "Fake" function constant let record
  use "Foundation" // trailing
use "SwiftUI.View"
record UnicodeBox<T> {
  constant café: T
  function apply<U>(value: U, named other: T): U { value }
  function nested(value: [[String: T]]): [[String: T]] { value }
  function unnamed(_: Int): Int { 1 }
  function escaped(`record`: Int): Int { `record` }
}
function literals(): String {
  let café = "record function constant let"
  constant raw = #"use "Module" \#(café)"#
  constant regex = #/function let record/#
  constant multiline = """
    function \(café)
    constant
    """
  return raw + multiline
}
enum ParserFailure: Error { case expected }
function typedResult() throws(ParserFailure): Int { 1 }
function opaqueResult(): some Equatable { 1 }
function constrained<T>(value: T): T where T: Equatable { value }
