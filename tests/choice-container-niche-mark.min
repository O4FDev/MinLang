record MarkNode { value: Integer; children: List<MarkNode> }
record MarkParent { self: Maybe<MarkParent>; value: Maybe<List<MarkNode>> }
choice MarkChain { MarkLink(next: List<MarkChain>); MarkEnd }
record MarkBranch { children: Maybe<List<MarkBranch>> }

function makeMarkParent(): MarkParent {
    let children: List<MarkNode> = []
    let node = MarkNode { value: 431; children: children }
    children.add(node)
    let parent = MarkParent { self: None; value: Some(children) }
    parent.self = Some(parent)
    return parent
}
function armMark(parent: MarkParent): Integer { native "choice_mark" }
function assertSaved(): Integer { native "choice_mark" }
function assertRemoved(): Integer { native "choice_mark" }
function armChain(value: MarkChain): Integer { native "choice_mark" }
function assertChain(): Integer { native "choice_mark" }
function armNode(value: MarkBranch): Integer { native "choice_mark" }
function assertNode(): Integer { native "choice_mark" }
function finishMark(): Integer { native "choice_mark" }

if true {
    let parent = makeMarkParent()
    let saved: Maybe<List<MarkNode>> = Some<List<MarkNode>>([])
    armMark(parent)
    saved = parent.value
    // Observers take no references. The test runtime also observes the owner
    // at the cleanup boundary, before dropping the expression temporary.
    assertSaved()
    parent.value = None
    assertRemoved()
    finishMark()
    if saved.unwrap()[0].value != 431 { fail("lost the independent optional List root") }
}
if true {
    let values: List<MarkChain> = []
    let chain = MarkLink(values)
    armChain(chain)
    values.add(chain)
    assertChain()
    finishMark()
}
if true {
    let children: List<MarkBranch> = []
    let node = MarkBranch { children: Some(children) }
    children.add(node)
    let saved: Maybe<List<MarkBranch>> = Some(children)
    armNode(node)
    node.children = None
    assertNode()
    finishMark()
    if saved.unwrap().length != 1 { fail("lost the removed nullable List edge") }
    node.children = saved
}
print("Container MARK: optional root, List self-edge and nullable Node removal passed")
