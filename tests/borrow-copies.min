use "io" as io
use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures

function body(ir: Text, name: Text): Text {
    let found = false
    let complete = false
    let parts: List<Text> = []
    for line in test.lines(ir) {
        if !found && test.contains(line, "define ") && (test.contains(line, "@.minyar.fn." + name + "(") || test.moduleFunction(line, name)) { found = true }
        else if found {
            if line == "}" { complete = true; break }
            parts.add(line + "\n")
        }
    }
    test.check(found && complete, "missing function " + name)
    return joinText(parts)
}

function count(source: Text, needle: Text): Integer {
    let found = 0
    let rest = source
    let position = rest.find(needle)
    while position >= 0 {
        found += 1
        rest = rest.slice(position + needle.length, rest.length)
        position = rest.find(needle)
    }
    return found
}

// Every ownership operation a binding can take: a copy that borrows takes none.
function ownershipCount(emitted: Text): Integer {
    return count(emitted, "call void @minyar_rc_retain(") + count(emitted, "call void @minyar_rc_local(") + count(emitted, "call void @minyar_rc_borrow(") + count(emitted, "call void @minyar_rc_local_take(")
}

function counts(ir: Text, name: Text): Integer {
    return ownershipCount(body(ir, name))
}

// A function found by a symbol fragment, such as a closure body.
function symbolBody(ir: Text, marker: Text): Text {
    let found = false
    let complete = false
    let parts: List<Text> = []
    for line in test.lines(ir) {
        if !found && test.contains(line, "define ") && test.contains(line, marker) { found = true }
        else if found {
            if line == "}" { complete = true; break }
            parts.add(line + "\n")
        }
    }
    test.check(found && complete, "missing function " + marker)
    return joinText(parts)
}

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let compiler = frontend.compiler
// A copy of one stable local names the object that local already keeps alive:
// a readonly parameter or capture, or a binding its block never reassigns. The
// copy takes no count, so a match payload copied into a binding, a binding
// reassigned from a payload, and a copy of a borrowed parameter stay borrowed.
// A copy from a local declared in an inner block is not stable (the target's
// scope may outlive the source), so it keeps its count.
let source = #"""
    record Item { name: Text; size: Integer }
    choice Shape {
        Dot(size: Integer)
        Box(item: Item)
    }

    function payloadCopy(shape: Shape): Integer {
        let total = 0
        match shape {
            Dot(size) { total = size }
            Box(item) {
                let held = item
                total = held.size
            }
        }
        return total
    }

    function payloadBranch(shape: Shape): Integer {
        let total = 0
        match shape {
            Dot(size) { total = size }
            Box(item) {
                let held = item
                if item.size > 1 { held = item }
                total = held.size
            }
        }
        return total
    }

    function parameterCopy(item: Item): Integer {
        let held = item
        if item.size > 2 { held = item }
        return held.size
    }

    function runRead(read: () -> Integer): Integer { return read() }
    function captureCopy(item: Item): Integer {
        let read: () -> Integer = function(): Integer {
            let held = item
            return held.size
        }
        return runRead(read)
    }

    function innerSource(item: Item, other: Item): Integer {
        let kept = item
        let sum = 0
        while sum < 2 {
            let inner = other
            kept = inner
            sum += kept.size
        }
        return kept.size
    }

    record Bag { items: List<Item>; label: Text }
    function readOnly(item: Item): Integer { return item.size }
    function shrink(items: List<Item>): Integer { items.pop(); return items.length }
    function guardedRead(bag: Bag, index: Integer): Integer {
        let items = bag.items
        let item = bag.items[index]
        return readOnly(item) + items.length
    }
    function guardedRelease(bag: Bag): Integer {
        let item = bag.items[0]
        let left = shrink(bag.items)
        return item.size + left
    }

    record Label { text: Text }
    function relabel(label: Label): Integer {
        label.text = "y" + Text(7)
        return 1
    }
    function measure(text: Text, extra: Integer): Integer { return text.length + extra }
    function deferredTemporary(label: Label): Integer {
        let total = measure(label.text, relabel(label))
        return total + label.text.length
    }

    let item = Item { name: "ab" + "c"; size: 2 }
    let shapes = [Shape.Dot(3), Shape.Box(item)]
    let total = 0
    for shape in shapes { total += payloadCopy(shape) + payloadBranch(shape) }
    print(total)
    print(parameterCopy(item))
    print(captureCopy(item))
    print(innerSource(item, Item { name: "x" + "y"; size: 9 }))
    let bag = Bag { items: [item, Item { name: "q" + "r"; size: 7 }]; label: "b" + "" }
    print(guardedRead(bag, 0))
    print(guardedRelease(bag))
    let label = Label { text: "x" + Text(1) }
    print(deferredTemporary(label))
    """#
let expected = "10\n2\n2\n9\n4\n3\n5\n"

test.require(fixtures.compile(frontend, source), "compile borrow copy IR")
let ir = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
// A payload binding the arm never reassigns is a stable root, and a binding
// copied from it owns nothing.
test.check(counts(ir, "payloadCopy") == 0, "payloadCopy: a payload binding and a copy of it borrow")
test.check(counts(ir, "payloadBranch") == 0, "payloadBranch: a reassigned binding copies a payload borrow")
test.check(counts(ir, "parameterCopy") == 0, "parameterCopy: a copy of a readonly parameter owns nothing")
test.check(ownershipCount(symbolBody(ir, "@.minyar.closure.captureCopy.1(")) == 0, "captureCopy: a closure copies its capture without a count")
// The source is declared in the loop body, so the target could outlive it.
test.check(counts(ir, "innerSource") > 0, "innerSource: a copy from an inner block keeps its count")
// A guarded field or element binding takes an owner only when a call after it
// can release the holder: the module end decides once every callee is compiled.
test.check(counts(ir, "guardedRead") == 0, "guardedRead: release-free calls leave the binding borrowed")
test.check(counts(ir, "guardedRelease") > 0, "guardedRelease: a callee that removes a List slot keeps the owner")
// A statement temporary whose count the module end settles inside a function
// that owns nothing else: the fill must never land in a function without the
// frame its borrow or slot needs, and here it stays a retain the statement end
// releases.
let deferred = body(ir, "deferredTemporary")
test.check(test.contains(deferred, "call void @minyar_rc_retain(ptr ") && test.contains(deferred, "call void @minyar_rc_release(ptr ") && !test.contains(deferred, "@minyar_rc_enter(") && !test.contains(deferred, "@minyar_rc_borrow(") && !test.contains(deferred, "@minyar_rc_local("), "deferredTemporary: a deferred statement borrow in a function that owns nothing else is a retain and a release without a frame")
// A grid borrowed from a record field and swapped with a second grid: the
// binding the loop reassigns is not a stable root, so every copy of it keeps
// its own count. Without that count the next round's copy borrows a List the
// reassignment already released.
let swapSource = #"""
    record World { cells: List<List<Integer>>; rows: Integer; columns: Integer; rounds: Integer }

    function makeWorld(rows: Integer, columns: Integer): World {
        let cells: List<List<Integer>> = []
        for r in 0..rows {
            let row: List<Integer> = []
            for c in 0..columns { row.add((r * 37 + c * 11) % 1000) }
            cells.add(row)
        }
        return World { cells: cells; rows: rows; columns: columns; rounds: 5 }
    }

    function zeros(rows: Integer, columns: Integer): List<List<Integer>> {
        let grid: List<List<Integer>> = []
        for r in 0..rows {
            let row: List<Integer> = []
            for c in 0..columns { row.add(0) }
            grid.add(row)
        }
        return grid
    }

    function smooth(grid: List<List<Integer>>, next: List<List<Integer>>, k: Integer) {
        let rows = grid.length
        let columns = grid[0].length
        for r in 0..rows {
            let row = grid[r]
            let out = next[r]
            for c in 0..columns {
                let h = row[c]
                let level = h
                if r > 0 { level += (grid[r - 1][c] - h) / 8 }
                if r + 1 < rows { level += (grid[r + 1][c] - h) / 8 }
                if c > 0 { level += (row[c - 1] - h) / 8 }
                if c + 1 < columns { level += (row[c + 1] - h) / 8 }
                if (r * 3 + c * 5 + k) % 41 == 0 { level += 2 }
                out[c] = level
            }
        }
    }

    function totalOf(grid: List<List<Integer>>, rows: Integer, columns: Integer): Integer {
        let total = 0
        for r in 0..rows { for c in 0..columns { total += grid[r][c] * (c + 1) } }
        return total
    }

    // The hidden program's shape: a grid borrowed from a record field, swapped
    // with a second grid, and read through row and out bindings.
    function stencilSwap(): Integer {
        let world = makeWorld(24, 18)
        let grid = world.cells
        let next = zeros(world.rows, world.columns)
        for k in 0..world.rounds {
            smooth(grid, next, k)
            let previous = grid
            grid = next
            next = previous
        }
        return totalOf(grid, world.rows, world.columns)
    }

    // The same swap written through a temporary before the assignment.
    function thirdSwap(): Integer {
        let world = makeWorld(16, 12)
        let grid = world.cells
        let next = zeros(world.rows, world.columns)
        for k in 0..world.rounds {
            let temporary = grid
            grid = next
            next = temporary
            smooth(grid, next, k)
        }
        return totalOf(grid, world.rows, world.columns)
    }

    function twist(values: List<Integer>, k: Integer) {
        for i in 0..values.length { values[i] = (values[i] + k + 1) % 101 }
    }

    // A flat List<Integer> instead of a List of rows.
    function flatSwap(): Integer {
        let a: List<Integer> = []
        let b: List<Integer> = []
        for i in 0..64 {
            a.add(i * 7 % 13)
            b.add(i % 5)
        }
        for k in 0..5 {
            twist(a, k)
            let previous = a
            a = b
            b = previous
        }
        let total = 0
        for i in 0..a.length { total += a[i] * (i + 1) }
        return total
    }

    record Tally { left: List<Integer>; right: List<Integer> }

    // Record fields instead of bindings.
    function fieldSwap(): Integer {
        let leftValues: List<Integer> = []
        let rightValues: List<Integer> = []
        for i in 0..32 {
            leftValues.add(i * 3 % 17)
            rightValues.add(i % 7)
        }
        let tally = Tally { left: leftValues; right: rightValues }
        for k in 0..4 {
            twist(tally.left, k)
            let previous = tally.left
            tally.left = tally.right
            tally.right = previous
        }
        let total = 0
        for i in 0..tally.left.length { total += tally.left[i] * (i + 1) }
        return total
    }

    // The reassignment sits inside an if branch under the copy's block.
    function ifSwap(): Integer {
        let world = makeWorld(20, 14)
        let grid = world.cells
        let next = zeros(world.rows, world.columns)
        for k in 0..world.rounds {
            smooth(grid, next, k)
            let previous = grid
            if k % 2 == 0 { grid = next }
            next = previous
        }
        return totalOf(grid, world.rows, world.columns)
    }

    print(stencilSwap())
    print(thirdSwap())
    print(flatSwap())
    print(fieldSwap())
    print(ifSwap())
    """#
let swapExpected = "2173955\n264\n16640\n6339\n938238\n"
test.require(fixtures.compile(frontend, swapSource), "compile swapped grid IR")
let swapIr = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
// A count and its release for the copy; a bare copy from the swapped binding
// would emit four ownership operations instead of six.
test.check(counts(swapIr, "stencilSwap") == 6, "stencilSwap: a copy of a binding the loop reassigns keeps a count")
test.check(counts(swapIr, "thirdSwap") == 6, "thirdSwap: a copy before the assignment keeps a count")
test.check(counts(swapIr, "ifSwap") == 6, "ifSwap: a reassignment inside an if branch invalidates the copy")
// The default launcher profile (scope cells with the 32-work bounded cleanup
// budget) and the eager profile print the same totals, at -O0 and -O2, and the
// sanitized compiler run checks every access.
frontend.extra = ["--scope-owners", "--bounded-owners", "32"]
fixtures.executes(frontend, swapSource, swapExpected, ["-O0", "-O2"], 0, "", true)
frontend.extra = ["--scope-owners"]
frontend.runtimeFlags = ["-DMINYAR_RC_POLL_BUDGET=32"]
fixtures.executes(frontend, swapSource, swapExpected, ["-O0", "-O2"], 0, "", true)
frontend.extra = []
frontend.runtimeFlags = []
fixtures.executes(frontend, source, expected, ["-O0", "-O2"], 0, "", true)

// Last-use moves: a count that already sits in a cell moves into the consumer
// instead of being taken a second time and dropped. `set_take` takes the
// local's count into the record field, and a `.r` return hands its local's
// count to the pair, so neither shape retains the value first.
let moveSource = #"""
    choice Expr {
        Number(value: Integer)
        Binary(left: Expr, right: Expr)
    }

    function depth(expression: Expr): Integer {
        return match expression {
            Number(_) { 1 }
            Binary(left, right) { 1 + depth(left) + depth(right) }
        }
    }

    // Both payloads are locals at their last use: the fields take their counts.
    function fieldTake(): Integer {
        let left = Number(4)
        let right = Number(5)
        let node = Binary(left, right)
        return depth(node)
    }

    // The returned local's count moves out of its scope cell into the pair,
    // on the branch that returns and on the branch below it.
    function pairReturn(flag: Boolean): Result<Expr, Text> {
        let node = Binary(Number(2), Number(3))
        if flag { return Ok(node) }
        return Err("no")
    }

    // The loop reassigns the binding it reads, so a copy of it keeps a count.
    function loopCarried(rounds: Integer): Integer {
        let current = Number(1)
        let total = 0
        for i in 0..rounds {
            let previous = current
            current = Binary(previous, Number(i))
            total += depth(current)
        }
        return total
    }

    function main() {
        print(fieldTake())
        match pairReturn(true) {
            Ok(value) { print(depth(value)) }
            Err(message) { print(message) }
        }
        match pairReturn(false) {
            Ok(value) { print(depth(value)) }
            Err(message) { print(message) }
        }
        print(loopCarried(3))
    }
    """#
let moveExpected = "3\n3\nno\n15\n"
// The scope-cell profile: the move is defined over the cells the launcher uses.
frontend.extra = ["--scope-owners", "--bounded-owners", "32"]
test.require(fixtures.compile(frontend, moveSource), "compile last-use move IR")
let moveIr = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
// A field whose value is a local's last use takes that local's count, so the
// record store is the taking setter and the local's cell is released empty.
test.check(test.contains(body(moveIr, "fieldTake"), "call void @minyar_record_set_take("), "fieldTake: a field store takes a local's last use instead of retaining it")
// The pair return moves the local's count out of its scope cell: no retain and
// a moved cell, so the caller gets the one count the local already held.
let pairBody = body(moveIr, "pairReturn.r")
test.check(test.contains(pairBody, "minyar_rc_scope_move_v1(ptr ") && !test.contains(pairBody, "call void @minyar_rc_retain(ptr "), "pairReturn: the returned local's count moves into the pair instead of a retain and a drop")
test.check(counts(moveIr, "loopCarried") > 0, "loopCarried: a copy the loop reassigns keeps a count")
// The default launcher profile and the eager profile print the same totals at
// -O0 and -O2, and the sanitized compiler run checks every access.
fixtures.executes(frontend, moveSource, moveExpected, ["-O0", "-O2"], 0, "", true)
frontend.extra = ["--scope-owners"]
frontend.runtimeFlags = ["-DMINYAR_RC_POLL_BUDGET=32"]
fixtures.executes(frontend, moveSource, moveExpected, ["-O0", "-O2"], 0, "", true)
frontend.extra = []
frontend.runtimeFlags = []
fixtures.executes(frontend, moveSource, moveExpected, ["-O0", "-O2"], 0, "", true)
test.removeTree(compiler.directory)
print("Borrow copies: passed")
