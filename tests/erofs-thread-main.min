use "erofs" as erofs
use "errors" as errors

thread function worker(seed: Integer, input: FrozenBytes, channel: BytesChannel): Integer { return seed }
function main() {
    nativeThreadSetup()
    let error = erofs.writeDirectory(argument(0), argument(1), erofs.defaults())
    if errors.isError(error) { fail(errors.message(error)) }
    let channel = bytesChannel(0, 1)
    let handle = startThread(worker, 42, freezeBytes(Bytes()), channel)
    if joinThread(handle) != 42 { fail("erofs thread result") }
    closeBytesChannel(channel)
    print("EROFS_MAIN_PASS")
}
