choice Leaf { Page(text: Text); Blank }
choice Tree { Twig(value: Leaf); Fork(left: Tree, right: Tree); Empty }

function read(tree: Tree): Text {
    return match tree {
        Twig(Page("moon")) { "moonlight" }
        Twig(Page(text)) { text }
        Twig(Blank) { "folded" }
        Fork(Twig(Page(left)), Twig(Page(right))) { left + right }
        Fork(_, _) { "branch" }
        Empty { "empty" }
    }
}

for tree in [Twig(Page("moon")), Twig(Page("paper")), Twig(Blank), Fork(Twig(Page("star")), Twig(Page("light"))), Fork(Empty, Empty), Empty] {
    print(read(tree))
}

function describe(value: Result<Maybe<Integer>, Text>): Text {
    return match value {
        Ok(Some(42)) { "answer" }
        Ok(Some(number)) { Text(number) }
        Ok(None) { "absent" }
        Err("closed") { "closed" }
        Err(error) { error }
    }
}

print(describe(Ok(Some(42))))
print(describe(Ok(Some(7))))
print(describe(Ok(None)))
print(describe(Err("closed")))
print(describe(Err("broken")))

let deep: Maybe<Result<Maybe<Maybe<Integer>>, Text>> = Some(Ok(Some(Some(42))))
print(match deep { Some(Ok(Some(Some(number)))) { number } _ { 0 } })
let completed: Result<Nothing, Text> = Ok()
print(match completed { Ok() { "done" } Err(_) { "failed" } })
print(match Twig(Page("whole")) { tree { read(tree) } })
