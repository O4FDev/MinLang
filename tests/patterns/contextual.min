choice First { Ready(value: Integer); Waiting }
choice Second { Ready(value: Text); Waiting }
choice Envelope { Pair(left: First, right: Second) }

let value = Pair(First.Ready(20), Second.Ready("moon"))
print(match value {
    Pair(Ready(number), Ready(word)) { Text(number) + " " + word }
    Pair(Waiting, Waiting) { "both waiting" }
    Pair(_, _) { "one waiting" }
})
print(match Pair(First.Waiting, Second.Waiting) {
    Pair(Waiting, Waiting) { "both waiting" }
    _ { "other" }
})

record Schedule { where: Integer }
function where(value: Integer): Integer { return value + 1 }
function echo(where: Integer): Integer { return where }
let schedule = Schedule { where: 41 }
print(where(schedule.where))
print(echo(42))
for where in [20, 22] { print(where) }
print(match Some(42) { Some(where) where where > 0 { where } _ { 0 } })
let where = 42
print(where)
print(match Some(42) { Some(where) { where } None { 0 } })
