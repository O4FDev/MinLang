record Counter { inputs: Integer; guards: Integer }
choice Reading { Number(value: Integer); Missing }
function next(counter: Counter, value: Reading): Reading { counter.inputs += 1; return value }
function accepts(counter: Counter, value: Integer): Boolean { counter.guards += 1; return value > 10 }

let counter = Counter { inputs: 0; guards: 0 }
let value = match next(counter, Number(7)) {
    Missing where accepts(counter, 99) { "wrong constructor" }
    Number(8) where accepts(counter, 99) { "wrong literal" }
    Number(number) where accepts(counter, number) { "large" }
    Number(number) where number == 7 { "seven" }
    Number(_) { "small" }
    Missing { "missing" }
}
print(value)
print(counter.inputs)
print(counter.guards)

print(match next(counter, Number(42)) {
    Number(number) where accepts(counter, number) && number == 42 { "first" }
    Number(number) where accepts(counter, number) { "second" }
    _ { "fallback" }
})
print(counter.inputs)
print(counter.guards)

let nested: Maybe<Result<Integer, Text>> = Some(Ok(-7))
print(match nested {
    Some(Ok(number)) where number < 0 { "below zero" }
    Some(Err(error)) where error == "closed" { "closed" }
    _ { "other" }
})
print(match 42 { number where number > 0 { number } _ { 0 } })
print(match false { _ where false { "wrong" } _ { "unguarded" } })

let total = 0
for number in 0..5 {
    match Some(number) {
        Some(value) where value < 2 { continue }
        Some(value) where value == 4 { break }
        Some(value) { total += value }
        None {}
    }
}
print(total)

function classify(value: Maybe<Integer>): Text {
    match value {
        Some(number) where number == 0 { return "zero" }
        Some(number) where number > 0 { return "positive" }
        Some(_) { return "negative" }
        None { return "absent" }
    }
}
for value in [Some(0), Some(42), Some(-1), None<Integer>()] { print(classify(value)) }
