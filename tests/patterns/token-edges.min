function word(value: Text): Text {
    return match value {
        "true" { "Text true" }
        "false" { "Text false" }
        "-" { "Text minus" }
        "None" { "Text None" }
        "else" { "Text else" }
        "where" { "Text where" }
        _ { "Text other" }
    }
}
for value in ["true", "false", "-", "None", "else", "where", "other"] { print(word(value)) }

function nested(value: Maybe<Text>): Text {
    return match value {
        Some("true") { "nested true" }
        Some("false") { "nested false" }
        Some("-") { "nested minus" }
        Some("None") { "nested None" }
        Some("else") { "nested else" }
        Some("where") { "nested where" }
        Some(_) { "nested other" }
        None { "absent" }
    }
}
for value in [Some("true"), Some("false"), Some("-"), Some("None"), Some("else"), Some("where"), Some("other"), None<Text>()] { print(nested(value)) }

function punctuation(value: Character): Text {
    return match value { '-' { "Character minus" } '{' { "Character brace" } ')' { "Character close" } _ { "Character other" } }
}
for value in ['-', '{', ')', 'x'] { print(punctuation(value)) }
print(match Some('-') { Some('-') { "nested Character minus" } _ { "wrong" } })
print(match Some('{') { Some('{') { "nested Character brace" } _ { "wrong" } })
print(match Some(')') { Some(')') { "nested Character close" } _ { "wrong" } })

print(match 0 { -0 { "Integer negative zero" } _ { "wrong" } })
print(match -0 { 0x0 { "Integer hexadecimal zero" } _ { "wrong" } })
print(match 1 { 0o1 { "Integer octal one" } _ { "wrong" } })
print(match 0.0 { -0.0 { "Float negative zero" } _ { "wrong" } })
print(match -0.0 { 0.0e0 { "Float exponent zero" } _ { "wrong" } })
print(match 1.0 { 01.0 { "Float leading one" } _ { "wrong" } })
print(match Some(0) { Some(0x0) { "nested Integer zero" } _ { "wrong" } })
print(match Some(0.0) { Some(-0.0e0) { "nested Float zero" } _ { "wrong" } })

let minimum = -9223372036854775808
print(match minimum { -9223372036854775808 { "minimum Integer" } _ { "wrong" } })
print(match Some(minimum) { Some(-9223372036854775808) { "nested minimum Integer" } _ { "wrong" } })

choice Digit { Count(value: Integer) }
choice Parcel { Wrapped(value: Digit) }
print(match Wrapped(Count(42)) { Wrapped(Count(Value)) { Value } })

function unwrap<Item>(value: Maybe<Maybe<Item>>, fallback: Item): Item {
    return match value { Some(Some(Value)) { Value } _ { fallback } }
}
print(unwrap(Some(Some(42)), 0))
print(unwrap(Some(Some("uppercase")), "missing"))
