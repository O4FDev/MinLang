function integer(value: Integer): Text {
    return match value { -7 { "negative" } 0 { "zero" } 42 { "answer" } _ { "integer" } }
}
for value in [-7, 0, 42, 8] { print(integer(value)) }

function floating(value: Float): Text {
    return match value { -2.5 { "below" } 0.0 { "still" } 1.25 { "above" } _ { "float" } }
}
for value in [-2.5, 0.0, 1.25, 8.0] { print(floating(value)) }

function boolean(value: Boolean): Text {
    return match value { true { "yes" } false { "no" } }
}
print(boolean(true))
print(boolean(false))

function character(value: Character): Text {
    return match value { 'é' { "accent" } '🙂' { "smile" } '\n' { "newline" } _ { "character" } }
}
for value in ['é', '🙂', '\n', 'x'] { print(character(value)) }

function text(value: Text): Text {
    return match value {
        "" { "empty" }
        "moon" { "light" }
        "é🙂" { "unicode" }
        "where { }" { "punctuation" }
        "a\nb" { "escaped" }
        _ { "text" }
    }
}
for value in ["", "moon", "é🙂", "where { }", "a\nb", "other"] { print(text(value)) }

choice Reading { Number(value: Integer); Fraction(value: Float); Flag(value: Boolean); Glyph(value: Character); Words(value: Text) }
function nested(value: Reading): Text {
    return match value {
        Number(-7) { "nested integer" }
        Fraction(-2.5) { "nested float" }
        Flag(false) { "nested Boolean" }
        Glyph('🙂') { "nested Character" }
        Words("moon") { "nested Text" }
        _ { "other" }
    }
}
for value in [Number(-7), Fraction(-2.5), Flag(false), Glyph('🙂'), Words("moon"), Number(8)] { print(nested(value)) }
match -7 { -7 { print("statement") } _ { print("wrong") } }
print(match 41 { number { number + 1 } })
