record Letter { text: Text; lines: List<Text>; bytes: Bytes }
record Holder { value: Maybe<Result<Letter, Text>> }
function fresh(label: Text): Holder {
    return Holder { value: Some(Ok(Letter { text: label; lines: [label]; bytes: Bytes(label) })) }
}
function clear(holder: Holder, accepted: Boolean): Boolean { holder.value = None; return accepted }
function words(holder: Holder): List<Text> {
    match (holder.value) {
        Some(Ok(letter)) { holder.value = None; return letter.lines }
        _ { return [] }
    }
}

let holder = fresh("kept")
match (holder.value) {
    Some(Ok(letter)) {
        holder.value = None
        for index in 0..100 { let scratch = Bytes(32); scratch[0] = index }
        print(letter.text)
        print(letter.lines[0])
        print(Text(letter.bytes))
    }
    _ { fail("lost a nested payload") }
}

let guarded = fresh("from guard")
print(match guarded.value {
    Some(Ok(letter)) where clear(guarded, true) { letter.text }
    _ { "lost" }
})
let rejected = fresh("after false guard")
print(match rejected.value {
    Some(Ok(letter)) where clear(rejected, false) { "wrong" }
    Some(Ok(letter)) { letter.text }
    _ { "lost" }
})

let returned = words(fresh("returned"))
print(returned[0])
let captured = fresh("captured")
let read: () -> Text = match captured.value {
    Some(Ok(letter)) { function() { return letter.text } }
    _ { function() { return "lost" } }
}
captured.value = None
print(read())

record ResultHolder { value: Result<Maybe<List<Text>>, Text> }
function replace(holder: ResultHolder): Boolean { holder.value = Err("replaced"); return false }
let result = ResultHolder { value: Ok(Some(["result kept"])) }
print(match result.value {
    Ok(Some(lines)) where replace(result) { "wrong" }
    Ok(Some(lines)) { lines[0] }
    _ { "lost" }
})

for index in 0..100 {
    let temporary = fresh("loop")
    let value = match temporary.value {
        Some(Ok(letter)) where clear(temporary, false) { "wrong" }
        Some(Ok(letter)) { letter.text }
        _ { "lost" }
    }
    if value != "loop" { fail("lost a repeated nested payload") }
}
print("clean")
