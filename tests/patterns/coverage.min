choice Pair { Both(left: Boolean, right: Boolean); Neither }
function bits(pair: Pair): Integer {
    return match pair {
        Both(false, false) { 0 }
        Both(false, true) { 1 }
        Both(true, false) { 2 }
        Both(true, true) { 3 }
        Neither { 4 }
    }
}
for pair in [Both(false, false), Both(false, true), Both(true, false), Both(true, true), Neither] { print(bits(pair)) }

function number(value: Maybe<Maybe<Boolean>>): Integer {
    return match value {
        Some(Some(false)) { 0 }
        Some(Some(true)) { 1 }
        Some(None) { 2 }
        None { 3 }
    }
}
print(number(Some(Some(false))))
print(number(Some(Some(true))))
print(number(Some(None)))
print(number(None))

function outcome(value: Result<Maybe<Boolean>, Boolean>): Integer {
    match value {
        Ok(Some(false)) { return 10 }
        Ok(Some(true)) { return 11 }
        Ok(None) { return 12 }
        Err(false) { return 13 }
        Err(true) { return 14 }
    }
}
print(outcome(Ok(Some(false))))
print(outcome(Ok(Some(true))))
print(outcome(Ok(None)))
print(outcome(Err(false)))
print(outcome(Err(true)))

function column(pair: Pair): Integer {
    return match pair { Both(false, _) { 0 } Both(true, _) { 1 } Neither { 2 } }
}
print(column(Both(false, true)))
print(column(Both(true, false)))
print(column(Neither))
