use "../tools/testing.min" as test
use "./sha256-support.min" as arguments
use "./system-test-build.min" as build
use "system" as system
use "files" as files

let mode = "native"
let language = false
let rootOnly = false
let prebuilt = false
let optionIndex = 0
while optionIndex < argumentCount() {
    let option = argument(optionIndex)
    if option == "--language" { language = true }
    else if option == "--root" { rootOnly = true }
    else if option == "--prebuilt" { prebuilt = true }
    else if option == "--mode" {
        test.check(optionIndex + 1 < argumentCount(), "missing system process mode")
        optionIndex += 1
        mode = argument(optionIndex)
    } else { fail("unknown system process option: " + option) }
    optionIndex += 1
}
test.check(mode == "native" || mode == "sanitize", "unknown system process mode")
let work = test.scratch()
work = test.canonical(work, work + "/canonical")
let root = build.root(work)
let platform = build.platform(work)
let windows = system.getenv("OS") == "Windows_NT" || test.contains(platform, "MSYS") || test.contains(platform, "MINGW") || test.contains(platform, "CYGWIN") || platform == "Windows"
test.check(!rootOnly || !windows, "--root requires POSIX")
test.require(test.run(["chmod", "--", "755", work], system.environment(), root, work + "/directory-mode", 10), "private process fixture directory mode")
let name = "process"
if windows { name += ".exe" }
let binary = work + "/" + name
let command = [test.setting("MINYAR_TEST_CLANG", "clang"), "-std=c11", "-Wall", "-Wextra", "-Werror"]
if mode == "sanitize" { for flag in ["-O1", "-g", "-fsanitize=address,undefined"] { command.add(flag) } }
else { command.add("-O2") }
for value in [root + "/tests/system-process.c", "-o", binary] { command.add(value) }
if windows { for flag in ["-lpsapi", "-municode"] { command.add(flag) } }
else { command.add("-pthread"); if platform != "Darwin" { command.add("-lm") } }
test.require(test.run(command, system.environment(), root, binary + ".build", 40), "native process fixture build")
let unicode = work + "/Unicode λ"
test.check(files.makeDirectory(unicode) == 0, "cannot create Unicode process fixture directory")
test.require(test.run(["chmod", "--", "755", unicode], system.environment(), root, work + "/unicode-mode", 10), "private Unicode fixture directory mode")
let target = unicode + "/" + name
test.require(test.run(["cp", "-p", "--", binary, target], system.environment(), root, work + "/copy", 10), "Unicode process fixture copy")
test.require(test.run(["chmod", "--", "755", target], system.environment(), root, work + "/target-mode", 10), "private Unicode process fixture mode")
let environment = arguments.environment(system.environment(), "MINYAR_PARENT_ONLY", "must not inherit")
environment = arguments.environment(environment, "ASAN_OPTIONS", "detect_leaks=0")
environment = arguments.environment(environment, "UBSAN_OPTIONS", "halt_on_error=1")
let fixture = [target, "contracts", unicode]
if rootOnly { fixture = ["sudo", "-n", "timeout", "20", target, "root-contracts", unicode] }
let result = test.run(fixture, environment, root, work + "/contracts", 25)
test.check(result.status == 0, "system process fixture failed\n" + Text(result.status) + "\n" + result.output + result.errorOutput)
test.check(result.output == "child stdout\nsystem process: passed\n" && result.errorOutput == "child stderr λ\n", "system process fixture output changed\n" + result.output + result.errorOutput)
print("system process " + mode + ": passed")
if language {
    let executable = work + "/language"
    if windows { executable += ".exe" }
    build.buildLanguage(root, root + "/tests/system-process.min", executable, prebuilt, mode == "sanitize")
    result = test.run([executable, target, unicode], environment, root, work + "/language-run", 20)
    test.check(result.status == 0, "system process language fixture failed\n" + result.output + result.errorOutput)
    test.check(result.output == "system process language: passed\n" && result.errorOutput == "", "system process language output changed\n" + result.output + result.errorOutput)
    print("system process language: passed")
}
test.removeTree(work)
