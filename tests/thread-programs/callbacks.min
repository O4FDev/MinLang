// Closures, function values and ordinary collection methods run inside a thread's own domain.
function double(value: Integer): Integer { return value * 2 }

thread function worker(seed: Integer, unused: FrozenBytes, done: BytesChannel): Integer {
    let offset = seed
    let shift = function(value: Integer): Integer { return value + offset }
    let total = 0
    for value in [1, 2, 3].map(double) { total += shift(value) }
    let words = ["tide", "kelp", "reef"]
    words.sort()
    let names: Map<Text, Integer> = Map()
    for word in words { names[word] = word.length + seed }
    return total * 100 + names["kelp"]
}

function main() {
    let none = freezeBytes(Bytes(0))
    let channel = bytesChannel(0, 1)
    let threads = [startThread(worker, 1, none, channel), startThread(worker, 2, none, channel)]
    for thread in threads { print(joinThread(thread)) }
    let local = function(value: Integer): Integer { return value * 3 }
    print(local(2))
}
