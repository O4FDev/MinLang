use "io" as io
use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "../tools/test-runtime.min" as runtime
use "system" as system

// Share the ownership oracle across cases, as in nitpick-language.min. The
// generated programs still run at both O0 and O2 with every cleanup assertion.
function prepareOwnership(frontend: fixtures.Frontend) {
    let compiler = frontend.compiler
    let path = compiler.directory + "/ownership-runtime"
    let engine = runtime.cycleSource(io.readTextFile("runtime/minyar_runtime.c"))
    let contract = test.replace(io.readTextFile("tests/memory-contracts-runtime.c"), "#include \"../runtime/minyar_runtime.c\"", engine)
    io.writeTextFile(path + ".c", contract)
    compiler.runtime = path + ".o"
    let command = [compiler.clang, "-O1", "-DMINYAR_SYSTEM_HEAP=1", "-iquote", "runtime", "-c", path + ".c", "-o", compiler.runtime]
    for flag in compiler.flags { command.add(flag) }
    test.require(test.run(command, system.environment(), "", path + ".build", 30), "build shared text ownership runtime")
}

function measureJoin(frontend: fixtures.Frontend, llvm: Text) {
    let compiler = frontend.compiler
    let path = compiler.directory + "/join-probe"
    let engine = runtime.cycleSource(io.readTextFile("runtime/minyar_runtime.c"))
    let allocator = "MINYAR_HOT void *data_allocate(size_t size, size_t alignment) {"
    test.check(test.contains(engine, allocator), "missing measured data allocator")
    engine = test.replace(engine, allocator, allocator + "\n    if (text_probe_active) { text_probe_buffers++; text_probe_bytes = size; }")
    // Short output shares the Text header's allocation; longer output takes
    // one separate buffer. Either way the storage holds exactly length + 1.
    let allocation = "    MinyarText *text = new_text_storage(length, length);\n    ((unsigned char *)text->bytes)[length] = 0;\n    return text;"
    test.check(test.contains(engine, allocation), "missing measured interpolation allocation")
    engine = test.replace(engine, allocation, "    text_probe_active = 1; text_probe_buffers = 0;\n    MinyarText *text = new_text_storage(length, length);\n    unsigned char *bytes = (unsigned char *)text->bytes;\n    text_probe_active = 0; text_probe_joins++;\n    assert(rc_text_is_inline(text) ? text_probe_buffers == 0 && (((RcData *)bytes - 1)->size & ~RC_INLINE_TEXT) == (unsigned long long)length + 1 : text_probe_buffers == 1 && text_probe_bytes == (unsigned long long)length + 1);\n    bytes[length] = 0;\n    return text;")
    let counters = "#include <assert.h>\nstatic int text_probe_active, text_probe_buffers, text_probe_joins;\nstatic unsigned long long text_probe_bytes;\n"
    let contract = test.replace(io.readTextFile("tests/memory-contracts-runtime.c"), "#include \"../runtime/minyar_runtime.c\"", counters + engine)
    contract += "\n__attribute__((destructor)) static void measured_join_contract(void) { assert(text_probe_joins == 1); }\n"
    io.writeTextFile(path + ".c", contract)
    io.writeTextFile(path + ".ll", llvm)
    let build = [compiler.clang, "-O1", "-DMINYAR_SYSTEM_HEAP=1", "-iquote", "runtime", "-c", path + ".c", "-o", path + ".o"]
    for flag in compiler.flags { build.add(flag) }
    test.require(test.run(build, system.environment(), "", path + ".build", 30), "build measured interpolation runtime")
    for optimization in ["-O0", "-O2"] {
        let link = [compiler.clang, optimization, "-Wno-override-module", path + ".ll", path + ".o", "-lm", "-o", path + ".exe"]
        for flag in compiler.flags { link.add(flag) }
        test.require(test.run(link, system.environment(), "", path + ".link", 30), "link measured interpolation")
        let observed = test.run([path + ".exe"], system.environment(), "", path + ".run", 30)
        test.check(observed.status == 0 && observed.output == "left 42 middle true right\n" && observed.errorOutput == "", "interpolation must allocate one exactly sized output buffer\n" + observed.errorOutput)
    }
}

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
prepareOwnership(frontend)
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, io.readTextFile("tests/text/interpolation.min"), io.readTextFile("tests/text/interpolation.stdout"), levels, 0, "", false)
fixtures.executes(frontend, io.readTextFile("tests/text/multiline.min"), io.readTextFile("tests/text/multiline.stdout"), levels, 0, "", false)
fixtures.executes(frontend, io.readTextFile("tests/text/choice.min"), io.readTextFile("tests/text/choice.stdout"), levels, 0, "", false)
fixtures.executes(frontend, io.readTextFile("tests/text/generics.min"), io.readTextFile("tests/text/generics.stdout"), levels, 0, "", false)
fixtures.executes(frontend, io.readTextFile("tests/text/methods.min"), io.readTextFile("tests/text/methods.stdout"), levels, 0, "", false)
fixtures.executes(frontend, "print(\"\"\"\r\n\tfirst\r\n\t  second\r\n\t\"\"\")\r\n", "first\n  second\n", levels, 0, "", false)
fixtures.executes(frontend, io.readTextFile("examples/gallery/text.min"), io.readTextFile("examples/gallery/text.stdout"), levels, 0, "", false)
io.writeTextFile(frontend.compiler.directory + "/greeting.min", "public function greeting(name: Text): Text { return \"Hello, \\(name)!\" }\n")
fixtures.executes(frontend, "use \"./greeting.min\" as greeting\nprint(greeting.greeting(\"Ada\"))\n", "Hello, Ada!\n", levels, 0, "", false)

for declaration in ["let value = [1]", "record Box { n: Integer }; let value = Box { n: 1 }", "let value = Bytes()", "let value = function() {}"] {
    fixtures.rejects(frontend, declaration + "\nprint(\"value: \\(value)\")\n", "text interpolation needs Integer, Float, Boolean, Character, or Text; convert this value to Text explicitly", true)
}
fixtures.rejects(frontend, "print(\"value: \\(unknown)\")\n", "line 1, column 17: I can't find a value named 'unknown'", true)
fixtures.rejects(frontend, "print(\"value: \\([1])\")\n", "line 1, column 17: text interpolation needs", true)
fixtures.rejects(frontend, "print(\"value: \\(1\n", "text interpolation is missing its closing ')'", true)
fixtures.rejects(frontend, "print(\"value: \\()\")\n", "text interpolation is missing a value", true)
fixtures.rejects(frontend, "print(\"value: \\(1, 2)\")\n", "text interpolation needs", true)
fixtures.rejects(frontend, "print(\"\"\"inline\"\"\")\n", "multi-line Text must begin on a new line", true)
fixtures.rejects(frontend, "print(\"\"\"\n    inline\"\"\")\n", "closing delimiter for multi-line Text must be on its own line", true)
fixtures.rejects(frontend, "print(\"\"\"\n  short\n    \"\"\")\n", "line 2, column 1: multi-line Text has less indentation", true)
fixtures.rejects(frontend, "print(\"\"\"\n  \\(42)\n    \"\"\")\n", "line 2, column 1: multi-line Text has less indentation", true)
fixtures.rejects(frontend, "print(#\"unclosed\")\n", "raw Text is missing its closing delimiter", true)
fixtures.rejects(frontend, "print(\"\"\"\n    unclosed\n", "multi-line Text is missing its closing delimiter", true)
fixtures.rejects(frontend, "print(\"\"\"\n    \\(unknown)\n    \"\"\")\n", "line 2, column 7: I can't find a value named 'unknown'", true)

// Digit counts at every power-of-ten boundary, and character counts of
// ASCII and non-ASCII results, through the compiled interpolation.
fixtures.executes(frontend, #"""
    let numbers = [0, 9, 10, 99, 100, 999999999999999999, 1000000000000000000, 9223372036854775807, -1, -9, -10, -99, -100, -1000000000000000000, -9223372036854775807]
    for n in numbers {
        let text = "<\(n)>"
        print(text + " " + Text(text.length))
    }
    let u = "ü"
    print("é\(1)".length)
    print("[\(u)]".length)
    print("[\('🙂')]".length)
    print("ab\(12)".length)
    let yes = 1 < 2
    print("\(yes):\(!yes)")
    """#, "<0> 3\n<9> 3\n<10> 4\n<99> 4\n<100> 5\n<999999999999999999> 20\n<1000000000000000000> 21\n<9223372036854775807> 21\n<-1> 4\n<-9> 4\n<-10> 5\n<-99> 5\n<-100> 6\n<-1000000000000000000> 22\n<-9223372036854775807> 22\n2\n3\n3\n4\ntrue:false\n", levels, 0, "", false)
// Bytes of an interpolation is written straight into the Bytes.
fixtures.executes(frontend, #"""
    use "text" as textLibrary
    function message(key: Integer, value: Text): Bytes { return Bytes("OK \(key) \(value) \('é')\n") }
    let bytes = message(42, "v")
    print(bytes.length)
    print(textLibrary.decodeOrStop(bytes))
    let plain = "x"
    print(Bytes(plain).length)
    print(Bytes("f \(1.5)").length)
    """#, "11\nOK 42 v é\n\n1\n5\n", levels, 0, "", false)
let bytesLLVM = io.readTextFile(frontend.compiler.directory + "/case" + Text(frontend.compiler.serial) + ".ll")
let messageLines: List<Text> = []
let inMessage = false
for line in test.lines(bytesLLVM) {
    if line.startsWith("define ") && (test.contains(line, "@.minyar.fn.message(") || test.moduleFunction(line, "message")) { inMessage = true }
    if inMessage { messageLines.add(line) }
    if inMessage && line == "}" { inMessage = false }
}
let messageBody = joinText(messageLines, "\n")
test.check(test.contains(messageBody, "call ptr @minyar_bytes_builder(i64 ") && !test.contains(messageBody, "@minyar_text_bytes(") && !test.contains(messageBody, "@minyar_text_builder(") && !test.contains(messageBody, "@minyar_text_builder_finish("), "Bytes of an interpolation must be written in place")
test.check(test.contains(bytesLLVM, "call ptr @minyar_text_bytes("), "Bytes of a Text value keeps its copy")
test.require(fixtures.compile(frontend, "let x = 1.5\nprint(\"x \\(x) y\")\n"), "compile Float interpolation")
let floatLLVM = io.readTextFile(frontend.compiler.directory + "/case" + Text(frontend.compiler.serial) + ".ll")
test.check(test.contains(floatLLVM, " = call ptr (i64, ...) @minyar_interpolate(i64 3, i64 2, ") && test.contains(floatLLVM, ", i64 7, i64 "), "a Float part keeps the runtime join")
test.require(fixtures.compile(frontend, "let n = 42\nprint(\"left \\(n) middle \\(true) right\")\n"), "compile single interpolation join")
let llvm = io.readTextFile(frontend.compiler.directory + "/case" + Text(frontend.compiler.serial) + ".ll")
let joins = 0
for line in test.lines(llvm) { if test.contains(line, " = call ptr @minyar_text_builder(i64 ") { joins += 1 } }
test.check(joins == 1, "interpolation must make exactly one result for all parts")
test.check(!test.contains(llvm, " = call ptr (i64, ...) @minyar_interpolate("), "an interpolation without Float parts must not use the runtime join")
test.check(test.contains(llvm, "call i64 @minyar_integer_text_length(i64 ") && test.contains(llvm, "call void @minyar_text_builder_integer(") && test.contains(llvm, "call void @minyar_text_builder_boolean("), "interpolation must size and write its scalar parts in place")
test.check(test.contains(llvm, "call void @llvm.memcpy.p0.p0.i64(") && test.contains(llvm, ", i64 5, i1 false)"), "literal parts must be copied with their constant lengths")
test.check(!test.contains(llvm, "call ptr @minyar_integer_text(") && !test.contains(llvm, "call ptr @minyar_boolean_text(") && !test.contains(llvm, "call ptr @minyar_join_texts("), "interpolation converted a scalar part through a temporary Text")
test.check(!test.contains(llvm, " = call ptr @minyar_join_text(") && !test.contains(llvm, " = call ptr @minyar_join_text_take_left("), "interpolation emitted a concatenation chain")
measureJoin(frontend, llvm)
test.removeTree(frontend.compiler.directory)
print("Text literals: passed")
