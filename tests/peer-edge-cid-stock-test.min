use "./net-fixtures.min" as fixtures
use "./peer-edge-lab.min" as lab
use "../tools/testing.min" as test
use "json" as json

fixtures.arguments(["--sanitize"], ["--binary", "--client-binary", "--case", "--evidence"])
let cases: List<Text> = []
for index in 0..argumentCount() {
    if argument(index) == "--case" {
        let value = argument(index + 1)
        test.check(value == "limit3" || value == "limit8" || value == "maximum32768", "invalid case: " + value)
        cases.add(value)
    }
}
if cases.length == 0 { cases = ["limit3", "limit8", "maximum32768"] }
let sanitize = fixtures.flag("--sanitize")
let context = fixtures.context(sanitize)
let directory = context.work + "/run"
let evidence = fixtures.option("--evidence", "")
if evidence != "" {
    if !fixtures.starts(evidence, "/") { evidence = context.root + "/" + evidence }
    fixtures.execute(context, ["mkdir", "-p", evidence], 10, "create evidence directory")
    directory = fixtures.strip(fixtures.execute(context, ["mktemp", "-d", evidence + "/run-XXXXXXXX"], 10, "create run directory").output)
} else {
    fixtures.execute(context, ["mkdir", "-p", directory], 10, "create run directory")
}
context.environment = fixtures.withSetting(lab.environment(context, sanitize), "MAKEFLAGS", "-j1")
let environment = context.environment
let client = fixtures.option("--client-binary", directory + "/client")
if fixtures.option("--client-binary", "") == "" {
    context.environment = fixtures.withSetting(environment, "MINYAR_LINK_ARTIFACTS", directory + "/client-link")
    lab.recorded(context, directory, [context.root + "/minyar", context.root + "/tests/peer-edge-cid-stock.min", "-o", client], 240)
    context.environment = environment
}
let binary = fixtures.option("--binary", "")
if binary == "" {
    binary = directory + "/edge"
    context.environment = fixtures.withSetting(environment, "MINYAR_LINK_ARTIFACTS", directory + "/edge-link")
    fixtures.execute(context, [context.root + "/minyar", context.root + "/examples/peer-edge.min", "-o", binary], 240, "compile peer edge")
    context.environment = environment
}
let results: List<Text> = []
for name in cases {
    let maximum = 1
    if name == "maximum32768" { maximum = 32768 }
    let limit = 8
    if name == "limit3" { limit = 3 }
    let state = lab.create(context, directory + "/" + name, lab.options(binary, sanitize, 8000, maximum))
    for session in 0..3 {
        let output = lab.recorded(context, directory, [client, fixtures.path(state.certs, "ca", "der"), fixtures.path(state.certs, "device", "der"), fixtures.path(state.certs, "device", "pk8"), Text(state.udpPort), Text(limit)], 10)
        let expected = "authenticated edge with peer limit " + Text(limit) + " and wire CID0/CID1\nGREEN actual edge stock limit " + Text(limit) + ": all live IDs route, retired CID0 is silent and replacement remains bounded\n"
        lab.require(state, output == expected, name + " session " + Text(session) + "\n" + output)
        fixtures.pause("0.25")
    }
    let values = lab.counts(lab.completed(state, 10000))
    lab.require(state, lab.count(values, "allocated") == 3 && lab.count(values, "retry_validated") == 3, name + " allocated " + lab.describe(values))
    lab.require(state, lab.count(values, "active") == 0 && lab.count(values, "peer_slots") == 1, name + " active " + lab.describe(values))
    lab.require(state, lab.count(values, "routes") == 0, name + " routes " + lab.describe(values))
    let counts: List<Text> = []
    for item in values { counts.add(json.quote(item.name) + ": " + json.quote(item.value)) }
    results.add("{\"case\": " + json.quote(name) + ", \"maximum\": " + Text(maximum) + ", \"limit\": " + Text(limit) + ", \"counts\": {" + lab.joined(counts, ", ") + "}}")
    lab.close(state)
}
writeTextFile(directory + "/results.json", "{\n  \"sanitize\": " + fixtures.truth(sanitize) + ",\n  \"results\": [" + lab.joined(results, ", ") + "]\n}\n")
print("[" + lab.joined(results, ", ") + "]")
fixtures.finish(context)
