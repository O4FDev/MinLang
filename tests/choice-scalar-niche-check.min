use "../tools/testing.min" as test
use "../tools/test-runtime.min" as runtime
use "./frontend-fixtures.min" as fixtures
use "io" as io
use "files" as files

function pack(values: List<Text>): Text {
    let pieces: List<Text> = []
    for value in values { pieces.add(Text(value.length) + "\n" + value) }
    return joinText(pieces)
}

function hasIdentitySignature(code: Text, name: Text, physical: Text): Boolean {
    for line in test.lines(code) {
        if line.startsWith("define " + physical + " @") && (test.contains(line, ".fn." + name + "(") || test.contains(line, "_" + name + "(")) && test.contains(line, "(" + physical + " %argument.0)") { return true }
    }
    return false
}

function linkAndRun(frontend: fixtures.Frontend, path: Text, object: Text, expected: Text, diagnostic: Text, status: Integer, partial: Boolean) {
    let compiler = frontend.compiler
    for level in ["-O0", "-O2"] {
        let command = [compiler.clang, level]
        for flag in compiler.flags { command.add(flag) }
        for argument in ["-Wno-override-module", path + ".ll", object, "-pthread", "-lm", "-o", path + ".exe"] { command.add(argument) }
        test.require(test.run(command, frontend.environment, "", path + ".link", 60), "link scalar niche fixture " + level)
        let result = test.run([path + ".exe"], frontend.environment, "", path + ".run", 30)
        let correct = test.sameDiagnostic(result.errorOutput, diagnostic)
        if partial { correct = test.contains(result.errorOutput, diagnostic) }
        test.check(result.status == status && result.output == expected && correct, "scalar niche fixture " + level + "\n" + result.output + result.errorOutput)
    }
}

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let compiler = frontend.compiler
let levels = ["-O0", "-O2"]

// This fixture is also the intentionally red prior pointer-layout control.
// Point MINYAR_TEST_COMPILER at the retained c132d9ce3 compiler to run it.
test.require(fixtures.compile(frontend, io.readTextFile("tests/choice-scalar-niche-bench.min")), "compile scalar niche counter benchmark")
let path = compiler.directory + "/case" + Text(compiler.serial)
let llvm = io.readTextFile(path + ".ll")
for name in ["choiceScalarBool", "choiceScalarEnum"] {
    test.check(test.contains(llvm, "i64 @.minyar.fn." + name + "(i64 %argument.0)"), "finite payload choice ABI must be i64: " + name)
}
for operation in ["call ptr @minyar_record_new", "call i64 @minyar_record_get", "call void @minyar_record_set", "call void @minyar_rc_", "call void @minyar_rc_retain", "call void @minyar_rc_borrow", "call void @minyar_rc_local", "call void @minyar_rc_keep", "call void @minyar_rc_release"] {
    test.check(!test.contains(llvm, operation), "scalar niche constructor/match emitted managed traffic: " + operation)
}
test.check(test.contains(llvm, "zext i1 ") && test.contains(llvm, " to i64") && test.contains(llvm, " to i1"), "Boolean payload projection must retain i1")
test.check(!test.contains(llvm, " = inttoptr i64 ") && !test.contains(llvm, " = ptrtoint ptr "), "scalar niche benchmark used pointer conversions")
llvm = test.replace(llvm, "@minyar_record_new", "@choice_enums_new")
io.writeTextFile(path + ".ll", llvm)
let contract = test.replace(io.readTextFile("tests/choice-enums-runtime.c"), "#include \"../runtime/minyar_runtime.c\"", runtime.cycleSource(io.readTextFile("runtime/minyar_runtime.c")))
io.writeTextFile(path + "-runtime.c", contract)
let command = [compiler.clang, "-O1"]
for flag in compiler.flags { command.add(flag) }
for argument in ["-DMINYAR_SYSTEM_HEAP=1", "-iquote", "runtime", "-c", path + "-runtime.c", "-o", path + "-runtime.o"] { command.add(argument) }
test.require(test.run(command, frontend.environment, "", path + ".runtime-build", 60), "compile scalar niche zero-allocation runtime")
linkAndRun(frontend, path, path + "-runtime.o", "19999\n250000\n", "choice enums: 0 record allocations, 0 live objects, 0 live bytes\n", 0, false)

frontend.helpers = "\nlong long minyar_choice_scalar_echo(long long value) { assert(value >= 0 && value <= 2); return value; }\nlong long minyar_choice_scalar_missing(void) { return 2; }\nlong long minyar_choice_scalar_headerFlag(void *value) { const long long *fields = value; assert(fields[0] == 1 && fields[1] == 0 && fields[2] == 2); return fields[0]; }\n"
fixtures.executes(frontend, io.readTextFile("tests/choice-scalar-niche-values.min"), io.readTextFile("tests/choice-scalar-niche-values.expected"), levels, 0, "", true)
let composition = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
test.check(hasIdentitySignature(composition, "forwardIdentity", "i64"), "forward enum payload layout must precede signatures")
test.check(hasIdentitySignature(composition, "boxedInner", "ptr") && hasIdentitySignature(composition, "loneIdentity", "ptr") && hasIdentitySignature(composition, "recursiveIdentity", "ptr"), "nested, single-case and recursive wrappers must stay boxed")
test.check(test.contains(composition, "declare i64 @minyar_choice_scalar_echo(i64)") && test.contains(composition, "declare i64 @minyar_choice_scalar_missing()"), "native Maybe<Boolean> must use encoded i64 ABI")
test.check(hasIdentitySignature(composition, "integerOptional", "ptr") && hasIdentitySignature(composition, "floatOptional", "ptr"), "Integer and Float optionals must stay boxed")
test.check(hasIdentitySignature(composition, "threeIdentity", "ptr") && hasIdentitySignature(composition, "twoIdentity", "ptr"), "three-case and two-payload choices must stay boxed")
test.check(test.contains(composition, "zext i32 ") && test.contains(composition, " to i32"), "Character payload projection must retain i32")
let scalarCallback = false
for line in test.lines(composition) {
    if test.contains(line, "define i64 @.minyar.closure.") && test.contains(line, "(ptr %environment, i64 %argument.0)") { scalarCallback = true }
}
test.check(scalarCallback, "scalar niche callback must use i64 parameters/results")
fixtures.executes(frontend, io.readTextFile("examples/gallery/scalar-choices.min"), io.readTextFile("examples/gallery/scalar-choices.expected"), levels, 0, "", true)

// Keep concrete Maybe alias coverage separate from the inherited ambiguity
// between its facade and unqualified constructors of another instantiation.
fixtures.executes(frontend, "choice Phase { Low; High }\ntype Current = Maybe<Phase>\nfunction aliasIdentity(value: Current): Current { return value }\nlet present: Current = Maybe<Phase>.Some(Phase.High)\nlet missing: Current = Maybe<Phase>.None\nprint(match aliasIdentity(present) { Some(phase) { phase == Phase.High } None { false } })\nprint(present != missing)\n", "true\ntrue\n", levels, 0, "", true)

// C-value ABI metadata must agree with direct native i64 and C field storage.
test.require(fixtures.compile(frontend, "record Header native \"c\" { flag: Maybe<Boolean> }\nfunction convert(value: Maybe<Boolean>, header: Header): Maybe<Boolean> { native \"choice_scalar\" value }\n"), "compile scalar niche C-value ABI metadata")
test.check(test.contains(io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll"), "; minyar-c-value: minyar_choice_scalar_convert|1|1|C"), "C-value scalar niche metadata must use kind 1")

for invalid in [
    "choice First { Value(flag: Boolean); Empty }\nchoice Second { Value(flag: Boolean); Empty }\nfunction take(value: First) {}\ntake(Second.Value(false))\n",
    "choice Phase { Low; High }\nchoice Other { Low; High }\nfunction take(value: Maybe<Phase>) {}\ntake(Some<Other>(Other.Low))\n",
    "let value: Maybe<Boolean> = Some(0)\n",
    "let value = Some<Boolean>(false) + 1\n",
    "choice Flag<Item> { Raised; Lowered }\nfunction take(value: Maybe<Flag<Integer>>) {}\ntake(Some<Flag<Text>>(Flag<Text>.Raised))\n"
] {
    let rejected = fixtures.compile(frontend, invalid)
    test.check(rejected.status == 1 && test.validCompilerDiagnostics(rejected.errorOutput), "scalar niche lost nominal type checking\n" + rejected.errorOutput)
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "rejected scalar source emitted LLVM")
}
for invalid in [-1, 55296, 57343, 1114112] {
    test.require(fixtures.compile(frontend, "function invalid(): Integer { return " + Text(invalid) + " }\nlet value: Maybe<Character> = Some(Character(invalid()))\nprint(match value { Some(letter) { Integer(letter) } None { -1 } })\n"), "compile existing Character validity contract")
    linkAndRun(frontend, compiler.directory + "/case" + Text(compiler.serial), compiler.runtime, "", "Minyar stopped: this Integer is not a Unicode scalar value.\n", 1, false)
}

// Imported concrete generic/alias signatures must agree with local discovery.
let leaf = compiler.directory + "/scalar-export.min"
io.writeTextFile(leaf, "public choice Optional { Present(value: Phase); Empty }\npublic choice Phase { Low; High }\npublic type Current = Maybe<Phase>\npublic function value(): Current { return Some(High) }\npublic function code(value: Current): Integer { return match value { Some(phase) { match phase { Low { 0 } High { 1 } } } None { 2 } } }\npublic function forward(value: Optional): Optional { return value }\n")
let imported = "use \"./scalar-export.min\" as sample\nprint(sample.code(sample.value()))\nprint(match sample.forward(sample.Optional.Present(sample.Phase.High)) { Present(value) { value == sample.Phase.High } Empty { false } })\n"
fixtures.executes(frontend, imported, "1\ntrue\n", levels, 0, "", true)
let entry = compiler.directory + "/scalar-main.min"
io.writeTextFile(entry, imported)
let empty = compiler.directory + "/empty.state"
let prior = compiler.directory + "/prior.state"
let next = compiler.directory + "/next.state"
let stats = compiler.directory + "/stats"
io.writeTextFile(empty, "")
// Previous schema is a rejection/fallback fixture, not a genuine prior binary.
io.writeTextFile(prior, pack(["minyar-module-interface-v8", "old", "old"]))
let codecPrior = compiler.directory + "/codec-prior.state"
io.writeTextFile(codecPrior, pack(["minyar-module-interface-v9", "old", "old"]))
let baseline = ""
for previous in [empty, prior, codecPrior, next] {
    test.require(test.run([compiler.executable, entry, compiler.directory + "/state.ll", "--module-state", previous, next, stats, "--library", "library"], frontend.environment, "", compiler.directory + "/state.compile", 60), "compile scalar choice module fallback")
    let fields = test.words(io.readTextFile(stats))
    test.check(fields.length >= 7 && fields[0] == "0" && fields[1] == "2" && fields[6] == "false", "scalar choices must keep whole-program fallback")
    let current = io.readTextFile(compiler.directory + "/state.ll")
    if baseline == "" { baseline = current }
    test.check(current == baseline && io.readTextFile(next) == "", "scalar module fallback retained artifacts or changed ABI")
}

// Failure rendering must project the payload, not print the raw niche code.
let failed = compiler.directory + "/failed"
io.writeTextFile(failed + ".min", "test \"scalar rendering\" { let value: Maybe<Boolean> = Some(false); let missing: Maybe<Boolean> = None; expect(value == missing) }\n")
test.require(test.run([compiler.executable, failed + ".min", failed + ".ll", "--test-mode", "--library", "library"], frontend.environment, "", failed + ".compile", 60), "compile failing scalar test rendering")
if test.addressEnabled(compiler.flags) { io.writeTextFile(failed + ".ll", test.instrument(io.readTextFile(failed + ".ll"))) }
linkAndRun(frontend, failed, compiler.runtime, "", "expected None, got Some(false)", 1, true)

test.removeTree(compiler.directory)
print("Choice scalar niches: passed; Boolean/Character/enum payloads, zero benchmark records/live bytes, i64 ABI and boxed nested identity")
