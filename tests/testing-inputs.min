use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "system" as system
use "files" as files
if processInfo.argumentCount() == 3 && processInfo.argument(0) == "--publish" {
    print(test.stableInput(io.readTextFile(processInfo.argument(2)), processInfo.argument(2), processInfo.argument(1)))
    exit(0)
}
let work = test.scratch()
let root = work + "/inputs"
test.check(files.makeDirectory(root) == 0, "private shared input directory")
let original = "print(\"Aa\")\n"
let collision = "print(\"BB\")\n"
let first = work + "/first.min"
let second = work + "/second.min"
io.writeTextFile(first, test.sourceModules(original))
io.writeTextFile(second, test.sourceModules(original))
test.check(test.stableInput(original, first, "") == first, "shared paths are opt-in")
let one = test.stableInput(original, first, root)
let two = test.stableInput(original, second, root)
test.check(one == two && io.readTextFile(one) == original, "identical source bytes share one immutable path")
test.check(io.readTextFile(first) == original && io.readTextFile(second) == original, "private source files are retained")
io.writeTextFile(second, test.sourceModules(collision))
let changed = test.stableInput(collision, second, root)
test.check(changed != one && io.readTextFile(changed) == collision && io.readTextFile(one) == original, "hash collisions preserve both exact sources")
let mutant = "print(\"AB\")\n"
io.writeTextFile(second, test.sourceModules(mutant))
let mutated = test.stableInput(mutant, second, root)
test.check(mutated != one && mutated != changed && io.readTextFile(mutated) == mutant, "mutants cannot reuse a baseline source")
let imported = "use \"./sibling.min\"\nprint(42)\n"
io.writeTextFile(second, test.sourceModules(imported))
test.check(test.stableInput(imported, second, root) == second, "relative imports retain their private source directory")
for whitespace in ["\t", "\n"] {
    let multilineImport = "use" + whitespace + "\"./sibling.min\"\nprint(42)\n"
    io.writeTextFile(second, test.sourceModules(multilineImport))
    test.check(test.stableInput(multilineImport, second, root) == second, "import whitespace cannot move a source out of its private directory")
}
let crlf = "print(\"Aa\")\r\n"
io.writeTextFile(second, test.sourceModules(crlf))
let carriage = test.stableInput(crlf, second, root)
test.check(carriage != one && io.readTextFile(carriage) == crlf, "source whitespace remains byte-exact")
let concurrent = work + "/concurrent"
test.check(files.makeDirectory(concurrent) == 0, "private concurrent cache")
io.writeTextFile(first, test.sourceModules(original))
io.writeTextFile(second, test.sourceModules(collision))
let left = test.start([processInfo.argument(0), "--publish", concurrent, first], system.environment(), "", work + "/left", 10)
let right = test.start([processInfo.argument(0), "--publish", concurrent, second], system.environment(), "", work + "/right", 10)
let leftResult = test.finish(left, work + "/left")
let rightResult = test.finish(right, work + "/right")
test.require(leftResult, "concurrent first publication")
test.require(rightResult, "concurrent colliding publication")
let leftPath = test.lines(leftResult.output)[0]
let rightPath = test.lines(rightResult.output)[0]
test.check(leftPath != rightPath && io.readTextFile(leftPath) == original && io.readTextFile(rightPath) == collision, "concurrent collision publication cannot replace another source")
test.removeTree(work)
print("Minyar immutable test input controls: passed")
