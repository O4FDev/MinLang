record Scalars { number: Integer; fraction: Float; flag: Boolean; letter: Character }
function mutate(input: Scalars) {
    let value = Scalars { number: 2; fraction: 1.5; flag: false; letter: 'a' }
    value.number += 40
    value.fraction = 2.5
    value.flag = true
    value.letter = 'Z'
    print(value.number) // debugger pause: all mutated fields remain live
    print(value.fraction)
    print(value.flag)
    print(value.letter)
    print(input.number)
}
mutate(Scalars { number: 7; fraction: 3.5; flag: false; letter: 'b' })
