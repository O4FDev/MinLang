record Star { name: Text; brightness: Float }
choice Phase { Waxing; Full; Waning }
choice Watch { Quiet; Seen(star: Star) }
choice Signal { Lit(on: Boolean); Dark }
choice Weather { Clear; Clouded(cover: Float); Storm(wind: Integer, rain: Float) }
let phase = Full
let watch = Seen(Star { name: "Vega"; brightness: 0.5 })
let signal = Lit(true)
let weather = Storm(12, 0.75)
print("watching") // debugger pause: every choice layout is initialized
match phase {
    Waxing { print("waxing") }
    Full { print("full") }
    Waning { print("waning") }
}
match watch {
    Quiet { print("quiet") }
    Seen(star) { print(star.name) }
}
match signal {
    Lit(on) { print(on) }
    Dark { print("dark") }
}
match weather {
    Clear { print("clear") }
    Clouded(cover) { print(cover) }
    Storm(wind, rain) { print(wind); print(rain) }
}
