choice Signal { Low; Middle; High }
choice Singleton { Only }
choice Flag<Item> { Raised; Lowered }

record Beacon { name: Text; signal: Signal }
record Box<Item> { value: Item }

choice Delivery {
    Waiting
    Number(value: Integer)
    Message(text: Text)
    Point(x: Float, y: Float)
    State(signal: Signal)
    Packet(beacon: Beacon)
    Pair(first: Beacon, second: Beacon)
}

choice Work {
    Rest
    Items(values: List<Signal>)
    Action(run: () -> Signal)
}

choice Branch {
    End
    Nodes(children: List<Branch>)
    Mark(signal: Signal)
}

function signalName(signal: Signal): Text {
    return match signal {
        Low { "low" }
        Middle { "middle" }
        High { "high" }
    }
}

function advance(signal: Signal): Signal {
    match signal {
        Low { return Middle }
        Middle { return High }
        High { return Low }
    }
}

function identity<Item>(value: Item): Item { return value }
function same<Item: Equatable>(left: Item, right: Item): Boolean { return left == right }
function greatest<Item: Ordered>(values: List<Item>): Item { return values.sorted()[values.length - 1] }
function keep<Item: Hashable>(value: Item): Item { return value }
function remember<Item>(value: Item): () -> Item { return function() { return value } }

function describe(delivery: Delivery): Text {
    return match delivery {
        Waiting { "waiting" }
        Number(value) { "number " + Text(value) }
        Message(text) { "words " + text }
        Point(x, y) { "point " + Text(x + y) }
        State(signal) { "state " + signalName(signal) }
        Packet(beacon) { "packet " + beacon.name + ": " + signalName(beacon.signal) }
        Pair(first, second) { "pair " + first.name + " and " + second.name }
    }
}

function findBeacon(found: Boolean): Maybe<Beacon> {
    if found { return Some(Beacon { name: "kept" + " light"; signal: High }) }
    return None
}

print("constructors")
print(signalName(Signal.Low))
print(signalName(Middle()))
print(signalName(Signal.High()))
print(match Singleton.Only { Only { "only" } })

print("flow")
let signal: Signal = Low
for index in 0..3 {
    signal = advance(signal)
    print(signalName(signal))
}

print("lists")
let signals: List<Signal> = [High, Low, Middle]
signals.sort()
for value in signals { print(signalName(value)) }
signals[2] = Low
print(signalName(signals[2]))

print("records")
let beacon = Beacon { name: "harbour"; signal: Low }
beacon.signal = advance(Middle)
print(beacon.name + ": " + signalName(beacon.signal))

print("generics")
let box = Box { value: identity(Middle) }
print(signalName(box.value))
let recalled = remember(High)
print(signalName(recalled()))
let raised = Flag<Integer>.Raised
let lowered: Flag<Text> = Lowered
print(same(raised, Flag<Integer>.Raised()))
print(lowered == Flag<Text>.Raised)

print("capabilities")
print(same(Low, Low))
print(same(Low, High))
print(Signal.Low < Signal.High)
print(signalName(greatest([Middle, High, Low])))
print(signalName(keep(Middle)))
print(same(Box { value: Low }, Box { value: Low }))
let counts: Map<Signal, Integer> = Map()
counts[Low] = 7
counts[High] = 42
print(counts[Low])
print(counts[High])
print(counts.has(Middle))
let seen: Set<Signal> = Set()
seen.add(Low)
seen.add(High)
seen.add(Low)
print(seen.length)
print(seen.contains(High))
print(seen.remove(Low))
print(seen.length)

print("mixed")
let deliveries: List<Delivery> = [
    Waiting,
    Number(42),
    Message("tide"),
    Point(3.0, 4.0),
    State(High),
    Packet(Beacon { name: "tower"; signal: Middle }),
    Pair(Beacon { name: "east"; signal: Low }, Beacon { name: "west"; signal: High })
]
for delivery in deliveries { print(describe(delivery)) }
let pending: Delivery = Packet(Beacon { name: "saved"; signal: High })
let saved = match pending {
    Packet(value) { value }
    else { Beacon { name: "missing"; signal: Low } }
}
pending = Number(9)
print(describe(Packet(saved)))
print(describe(pending))
pending = Message("held" + " words")
match pending {
    Message(text) { pending = Number(7); print(text) }
    else { print("missing words") }
}
print(describe(pending))
print(same(State(Low), State(Low)))
print(same(State(Low), State(High)))
print(Delivery.Waiting < Delivery.Number(0))
let messages: Map<Delivery, Integer> = Map()
messages[Message("tide")] = 12
print(messages[Message("ti" + "de")])

print("optional")
let optional: Maybe<Beacon> = findBeacon(true)
let savedBeacon = match (optional) {
    Some(value) { value }
    None { Beacon { name: "missing"; signal: Low } }
}
optional = None
print(savedBeacon.name)
print(match optional { Some(value) { value.name } None { "absent" } })
let candidates: List<Maybe<Beacon>> = [findBeacon(false), Some(beacon)]
for candidate in candidates { print(match candidate { Some(value) { value.name } None { "absent" } }) }

print("ownership")
let work: Work = Items([Low, Middle, High])
match work {
    Items(values) { work = Rest; print(values.length) }
    else { print(0) }
}
work = Action(function() { return advance(Low) })
print(match work { Action(run) { signalName(run()) } else { "rest" } })
let children: List<Branch> = []
let root: Branch = Nodes(children)
children.add(root)
print(match root { Nodes(values) { values.length } else { 0 } })
