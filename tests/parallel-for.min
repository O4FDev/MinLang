use "io" as io
use "../tools/testing.min" as test
use "../tools/test-runtime.min" as runtime
use "system" as system
use "files" as files

function compileCase(compiler: test.Compiler, source: Text): test.Result {
    compiler.serial += 1
    let path = compiler.directory + "/case" + Text(compiler.serial)
    io.writeTextFile(path + ".min", test.sourceModules(source))
    let command = [compiler.executable, path + ".min", path + ".ll"]
    if test.setting("MINYAR_PARALLEL_MODULES", "0") == "1" {
        for option in ["--module-state", compiler.directory + "/prior.state", path + ".state", path + ".stats"] { command.add(option) }
    }
    command.add("--library")
    command.add("library")
    return test.run(command, system.environment(), "", path + ".compile", 30)
}

function executes(compiler: test.Compiler, source: Text, expected: Text) {
    test.require(compileCase(compiler, source), "compile safe parallel loop")
    let path = compiler.directory + "/case" + Text(compiler.serial)
    if test.addressEnabled(compiler.flags) { io.writeTextFile(path + ".ll", test.instrument(io.readTextFile(path + ".ll"))) }
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization, "-Wno-override-module"]
        for flag in compiler.flags { command.add(flag) }
        for option in [path + ".ll", compiler.runtime, "-lm", "-o", path + ".exe"] { command.add(option) }
        test.require(test.run(command, system.environment(), "", path + ".link", 120), "link safe parallel loop")
        let result = test.run([path + ".exe"], system.environment(), "", path + ".run", 30)
        test.require(result, "execute safe parallel loop")
        test.check(result.output == expected && result.errorOutput == "", "parallel output\n" + result.output + result.errorOutput)
    }
}

function rejects(compiler: test.Compiler, source: Text, diagnostic: Text) {
    let result = compileCase(compiler, source)
    test.check(result.status == 1 && test.contains(result.errorOutput, diagnostic), "parallel rejection\n" + result.errorOutput)
    test.check(!test.contains(result.errorOutput, "List position"), "internal compiler bounds fault")
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "rejected parallel loop published LLVM")
}

let compiler = test.compiler()
io.writeTextFile(compiler.directory + "/prior.state", "")
let engine = runtime.cycleSource(io.readTextFile("runtime/minyar_runtime.c"))
let contract = test.replace(io.readTextFile("tests/memory-contracts-runtime.c"), "#include \"../runtime/minyar_runtime.c\"", engine)
io.writeTextFile(compiler.directory + "/runtime.c", contract)
compiler.runtime = compiler.directory + "/runtime.o"
let build = [compiler.clang, "-O1", "-DMINYAR_SYSTEM_HEAP=1", "-iquote", "runtime", "-c", compiler.directory + "/runtime.c", "-o", compiler.runtime]
for flag in compiler.flags { build.add(flag) }
test.require(test.run(build, system.environment(), "", compiler.directory + "/runtime-build", 120), "build parallel ownership oracle")

executes(compiler, io.readTextFile("tests/parallel-for/slots.min"), "0\n0.0\nfalse\n0\n12\n5.5\nfalse\n11\n15\n7.0\ntrue\n14\n20\n9.5\nfalse\n19\n27\n13.0\ntrue\n26\n0\n0.0\nfalse\n0\n1\n1\n42\n")
executes(compiler, "let values = [0, 0, 0, 0]\nparallel for index in 0..4 { if index == 2 { continue }; let total = 0; for part in 0..index { total += part }; values[index] = total }\nfor value in values { print(value) }\n", "0\n0\n0\n3\n")
executes(compiler, "use \"math\" as math\nlet letters = ['a', 'a', 'a']\nlet samples = [0.0, 0.0, 0.0]\nparallel for index in 0..3 { letters[index] = Character(65 + index); samples[index] = math.sqrt(Float(index * index)) }\nfor letter in letters { print(letter) }\nfor sample in samples { print(sample) }\n", "A\nB\nC\n0.0\n1.0\n2.0\n")
executes(compiler, io.readTextFile("examples/gallery/parallel.min"), io.readTextFile("tests/parallel-for/gallery.out"))
let setup = "let output = [0, 0, 0, 0]\nlet total = 0\n"
for body in ["output[0] = index", "output[index + 1] = index", "total += index", "total = index", "index = 0", "index += 1"] {
    rejects(compiler, setup + "parallel for index in 0..4 { " + body + " }\n", "parallel for:")
}
for body in ["let index = 0", "let total = 1", "let copy = output", "output.add(index)", "print(index)", "break", "let message = \"hello\"", "let f = function() {}", "parallel for other in 0..4 { output[other] = 0 }"] {
    rejects(compiler, setup + "function run() {}\nparallel for index in 0..4 { " + body + " }\n", "parallel for:")
}
rejects(compiler, "function run() { let output = [0]; parallel for index in 0..1 { return } }\nrun()\n", "parallel for:")
rejects(compiler, setup + "parallel for index in output { output[index] = 0 }\n", "use an Integer range")
rejects(compiler, setup + "parallel for index in 0..4 { output[index] = output[0] }\n", "shared values may only")
rejects(compiler, "let output = [\"a\"]\nparallel for index in 0..1 { output[index] = \"b\" }\n", "parallel for:")
rejects(compiler, "function impure(value: Integer): Integer { return value }\n" + setup + "parallel for index in 0..4 { output[index] = impure(index) }\n", "pure parallel function")
rejects(compiler, "use \"machine\" as machine\nparallel function unsafe(value: Integer): Integer { machine.store64(value, 0); return 0 }\nparallel function wrapper(value: Integer): Integer { return unsafe(value) }\n" + setup + "parallel for index in 0..4 { output[index] = wrapper(index) }\n", "pure parallel function")
test.removeTree(compiler.directory)
print("Safe parallel ranges: passed O0/O2 ownership and race rejections")
