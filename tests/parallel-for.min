use "io" as io
use "../tools/testing.min" as test
use "../tools/test-runtime.min" as runtime
use "system" as system
use "files" as files

function compileCase(compiler: test.Compiler, source: Text): test.Result {
    compiler.serial += 1
    let path = compiler.directory + "/case" + Text(compiler.serial)
    source = test.replace(source, "\"./parallel-image.min\"", "\"parallel-image\"")
    source = test.replace(source, "\"../../os/shared/graphics/glow.min\"", "\"glow\"")
    io.writeTextFile(path + ".min", test.sourceModules(source))
    let command = [compiler.executable, path + ".min", path + ".ll"]
    if test.setting("MINYAR_PARALLEL_MODULES", "0") == "1" {
        for option in ["--module-state", compiler.directory + "/prior.state", path + ".state", path + ".stats"] { command.add(option) }
    }
    for root in ["library", "examples/gallery", "os/shared/graphics"] {
        command.add("--library"); command.add(root)
    }
    return test.run(command, system.environment(), "", path + ".compile", 30)
}

function checkWorkerIsolation(llvm: Text) {
    let worker = false
    let entry = false
    let count = 0
    for line in test.lines(llvm) {
        if test.contains(line, "define internal ") && test.contains(line, "@.minyar.parallel.") { worker = true; count += 1 }
        if line == "entry:" { entry = true }
        else { if line.endsWith(":") { entry = false } }
        if worker {
            test.check(!test.contains(line, "@minyar_rc_") && !test.contains(line, "@minyar_stack_"), "a scalar worker touched owner-thread machinery")
        }
        if test.contains(line, "%parallel.environment.") && test.contains(line, " = alloca ") {
            test.check(entry, "a repeated dispatch would grow the native stack")
        }
        if line == "}" { worker = false; entry = false }
    }
    test.check(count > 0, "a hosted parallel test did not emit a worker")
}

function executes(compiler: test.Compiler, source: Text, expected: Text) {
    test.require(compileCase(compiler, source), "compile safe parallel loop")
    let path = compiler.directory + "/case" + Text(compiler.serial)
    checkWorkerIsolation(io.readTextFile(path + ".ll"))
    if test.addressEnabled(compiler.flags) { io.writeTextFile(path + ".ll", test.instrument(io.readTextFile(path + ".ll"))) }
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization, "-Wno-override-module"]
        for flag in compiler.flags { command.add(flag) }
        for option in [path + ".ll", compiler.runtime, "-pthread", "-lm", "-o", path + ".exe"] { command.add(option) }
        test.require(test.run(command, system.environment(), "", path + ".link", 120), "link safe parallel loop")
        let result = test.run([path + ".exe"], system.environment(), "", path + ".run", 30)
        test.require(result, "execute safe parallel loop")
        test.check(result.output == expected && result.errorOutput == "", "parallel output\n" + result.output + result.errorOutput)
    }
}

function rejects(compiler: test.Compiler, source: Text, diagnostic: Text) {
    let result = compileCase(compiler, source)
    test.check(result.status == 1 && test.contains(result.errorOutput, diagnostic), "parallel rejection\n" + result.errorOutput)
    test.check(!test.contains(result.errorOutput, "List position"), "internal compiler bounds fault")
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "rejected parallel loop published LLVM")
}

function traps(compiler: test.Compiler, source: Text, diagnostic: Text) {
    test.require(compileCase(compiler, source), "compile checked parallel failure")
    let path = compiler.directory + "/case" + Text(compiler.serial)
    if test.addressEnabled(compiler.flags) { io.writeTextFile(path + ".ll", test.instrument(io.readTextFile(path + ".ll"))) }
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization, "-Wno-override-module"]
        for flag in compiler.flags { command.add(flag) }
        for option in [path + ".ll", compiler.runtime, "-pthread", "-lm", "-o", path + ".exe"] { command.add(option) }
        test.require(test.run(command, system.environment(), "", path + ".link", 120), "link checked parallel failure")
        let result = test.run([path + ".exe"], system.environment(), "", path + ".run", 30)
        test.check(result.status == 1 && test.contains(result.errorOutput, diagnostic), "parallel failure must terminate without deadlock\n" + result.errorOutput)
        test.check(!test.contains(result.errorOutput, "Sanitizer") && !test.contains(result.errorOutput, "runtime error:"), "parallel failure must preserve checked memory access")
    }
}

let compiler = test.compiler()
io.writeTextFile(compiler.directory + "/prior.state", "")
let engine = runtime.cycleSource(io.readTextFile("runtime/minyar_runtime.c"))
let contract = test.replace(io.readTextFile("tests/memory-contracts-runtime.c"), "#include \"../runtime/minyar_runtime.c\"", engine)
io.writeTextFile(compiler.directory + "/runtime.c", contract)
compiler.runtime = compiler.directory + "/runtime.o"
let build = [compiler.clang, "-O1", "-DMINYAR_SYSTEM_HEAP=1", "-iquote", "runtime", "-c", compiler.directory + "/runtime.c", "-o", compiler.runtime]
for flag in compiler.flags { build.add(flag) }
test.require(test.run(build, system.environment(), "", compiler.directory + "/runtime-build", 120), "build parallel ownership oracle")

executes(compiler, io.readTextFile("tests/parallel-for/slots.min"), "0\n0.0\nfalse\n0\n12\n5.5\nfalse\n11\n15\n7.0\ntrue\n14\n20\n9.5\nfalse\n19\n27\n13.0\ntrue\n26\n0\n0.0\nfalse\n0\n1\n1\n42\n")
executes(compiler, "let values = [0, 0, 0, 0]\nparallel for index in 0..4 { if index == 2 { continue }; let total = 0; for part in 0..index { total += part }; values[index] = total }\nfor value in values { print(value) }\n", "0\n0\n0\n3\n")
executes(compiler, "use \"math\" as math\nlet letters = ['a', 'a', 'a']\nlet samples = [0.0, 0.0, 0.0]\nparallel for index in 0..3 { letters[index] = Character(65 + index); samples[index] = math.sqrt(Float(index * index)) }\nfor letter in letters { print(letter) }\nfor sample in samples { print(sample) }\n", "A\nB\nC\n0.0\n1.0\n2.0\n")
executes(compiler, io.readTextFile("examples/gallery/parallel.min"), io.readTextFile("tests/parallel-for/gallery.out"))
executes(compiler, io.readTextFile("tests/parallel-for/pixels.min"), "typed pixels: blend, mask, coverage and clipped desktop glow match packed oracles\n")
executes(compiler, "use \"./parallel-image.min\" as image\nlet pixels = Bytes()\nfor color in [0xFF0000, 0x00FF00, 0x0000FF, 0xFFFFFF] { pixels.addUInt32(color) }\nfor byte in image.png(pixels, 2, 2) { print(byte) }\n", io.readTextFile("tests/parallel-for/png.out"))
traps(compiler, "use \"pixels\" as pixels\nlet buffer = Bytes(40012)\npixels.maskBytes(buffer, buffer, 0x4691F7, 256, 0, 255)\n", "aliases a buffer written by parallel for")
traps(compiler, "use \"pixels\" as pixels\npixels.blendBytes(Bytes(3), 0, 256)\n", "four bytes per pixel")
traps(compiler, "use \"pixels\" as pixels\npixels.maskBytes(Bytes(8), Bytes(1), 0, 256, 0, 255)\n", "one byte per pixel")
executes(compiler, io.readTextFile("tests/parallel-for/threaded.min"), "25365210\n10071\n19999\n")
executes(compiler, "function bound(calls: List<Integer>, value: Integer): Integer { calls[0] += 1; return value }\nlet calls = [0]\nlet output = [0, 0, 0, 0]\nparallel for index in bound(calls, 1)..bound(calls, 4) { output[index] = index }\nprint(calls[0]); print(output[3])\n", "2\n3\n")
traps(compiler, "let output = [0]\nparallel for index in 0..10003 { output[index] = index }\n", "List position")
traps(compiler, "let output = Bytes(10003)\nparallel for index in 0..10003 { output[index] = 256 }\n", "does not fit")
traps(compiler, io.readTextFile("tests/parallel-for/overflow.min"), "this Integer calculation is outside the supported range")
traps(compiler, "let output = Bytes(10003)\nparallel for index in 0..output.length { output[index] = index % 256; if index == 5000 { output[index] = index / 0 } }\n", "divided by zero")
executes(compiler, "let input = [7, 11]\nlet output = [0, 0, 0, 0]\nparallel for index in 0..4 { output[index] = input[index % 2] }\nfor value in output { print(value) }\n", "7\n11\n7\n11\n")
executes(compiler, "let input = Bytes(2); input[0] = 7; input[1] = 11\nlet output = Bytes(4)\nparallel for index in 0..4 { output[index] = input[index % 2] }\nfor value in output { print(value) }\n", "7\n11\n7\n11\n")
executes(compiler, "let output = [3, 4]\nlet alias = output\nparallel for index in 4..2 { output[index] = alias[0] }\nprint(output[0])\n", "3\n")
traps(compiler, "function gather(output: List<Integer>, input: List<Integer>) { parallel for index in 0..output.length { output[index] = input[0] } }\nlet values = [7, 11, 13, 17]\ngather(values, values)\n", "aliases a buffer written by parallel for")
traps(compiler, "let output = Bytes(10003)\nlet alias = output\nparallel for index in 0..output.length { output[index] = alias[0] }\n", "aliases a buffer written by parallel for")
executes(compiler, io.readTextFile("tests/parallel-for/reductions.min"), "12512508\n6256251.5\n42\n42\n-9223372036854775807\n9223372036854775806\n0.0\n-0.0\n43\n48\n")
for body in ["total = index", "total -= index", "total += total", "let copy = total", "if total > 0 { total += index }"] {
    rejects(compiler, "let total = 0\nparallel for index in 0..4 reduce total { " + body + " }\n", "reduction binding")
}
for declaration in ["constant total = 0", "let total = false", "let total = [0]"] {
    rejects(compiler, "function reject() { " + declaration + "; parallel for index in 0..4 reduce total {} }\nreject()\n", "mutable Integer or Float binding")
}
traps(compiler, "let total = 9223372036854775807\nparallel for index in 0..1 reduce total { total += 1 }\n", "outside the supported range")
traps(compiler, "let total = 0\nparallel for index in 0..10003 reduce total { if index == 5000 { total += 9223372036854775807; total += 1 } }\n", "outside the supported range")
let setup = "let output = [0, 0, 0, 0]\nlet total = 0\n"
for body in ["output[0] = index", "output[index + 1] = index", "total += index", "total = index", "index = 0", "index += 1"] {
    rejects(compiler, setup + "parallel for index in 0..4 { " + body + " }\n", "parallel for:")
}
for body in ["let index = 0", "let total = 1", "let copy = output", "output.add(index)", "print(index)", "break", "let message = \"hello\"", "let f = function() {}", "parallel for other in 0..4 { output[other] = 0 }"] {
    rejects(compiler, setup + "function run() {}\nparallel for index in 0..4 { " + body + " }\n", "parallel for:")
}
rejects(compiler, "function run() { let output = [0]; parallel for index in 0..1 { return } }\nrun()\n", "parallel for:")
rejects(compiler, setup + "parallel for index in output { output[index] = 0 }\n", "use an Integer range")
rejects(compiler, setup + "parallel for index in 0..4 { output[index] = output[0] }\n", "another index while writing")
rejects(compiler, "let output = [\"a\"]\nparallel for index in 0..1 { output[index] = \"b\" }\n", "parallel for:")
rejects(compiler, "function impure(value: Integer): Integer { return value }\n" + setup + "parallel for index in 0..4 { output[index] = impure(index) }\n", "pure parallel function")
rejects(compiler, "use \"machine\" as machine\nparallel function unsafe(value: Integer): Integer { machine.store64(value, 0); return 0 }\nparallel function wrapper(value: Integer): Integer { return unsafe(value) }\n" + setup + "parallel for index in 0..4 { output[index] = wrapper(index) }\n", "pure parallel function")
test.removeTree(compiler.directory)
print("Safe parallel ranges: passed O0/O2 ownership and race rejections")
