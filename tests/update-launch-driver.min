use "io" as io
use "process" as processInfo
use "update" as update
use "crypto" as crypto
use "errors" as errors
function number(text: Text): Integer {
    let value = 0
    for c in text { value = value * 10 + Integer(c) - 48 }
    return value
}
let key = crypto.fromHex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
let arguments: List<Text> = []
for index in 7..processInfo.argumentCount() { arguments.add(processInfo.argument(index)) }
// Construct this inside the caller: Windows cannot start a process whose own
// command line already exceeds its limit, so external argv cannot test this API.
if processInfo.argument(0) == "launch-overlong" {
    let oversized = "x"
    for index in 0..16 { oversized = oversized + oversized }
    arguments.add(oversized.slice(0, 32769))
}
if processInfo.argument(0) == "install" {
    let result = update.install(processInfo.argument(1), io.readBytesFile(processInfo.argument(2)), io.readBytesFile(processInfo.argument(3)), key,
        io.readBytesFile(processInfo.argument(4)), "org.tolum.peer", update.hostTarget(), "stable",
        "https://updates.example", number(processInfo.argument(5)), processInfo.argument(6), "1.0.0")
    print(errors.booleanOk(result))
    if errors.booleanOk(result) { print(errors.booleanValue(result)) } else {
        print(errors.code(errors.booleanError(result))); print(errors.message(errors.booleanError(result)))
    }
} else {
    if processInfo.argument(0) == "restart" {
        let result = update.restart(processInfo.argument(1), key, "org.tolum.peer", update.hostTarget(), "stable",
            "https://updates.example", number(processInfo.argument(5)), processInfo.argument(6), processInfo.argument(4), arguments)
        print(errors.integerOk(result))
        if !errors.integerOk(result) { print(errors.message(errors.integerError(result))) }
    } else {
    let result = update.launch(processInfo.argument(1), key, "org.tolum.peer", update.hostTarget(), "stable",
        "https://updates.example", number(processInfo.argument(5)), processInfo.argument(6), processInfo.argument(4), arguments)
    print(errors.integerOk(result))
    if errors.integerOk(result) {
        let waited = update.wait(errors.integerValue(result))
        if errors.integerOk(waited) { print(errors.integerValue(waited)) } else {
            print(errors.message(errors.integerError(waited)))
        }
    } else { print(errors.code(errors.integerError(result))); print(errors.message(errors.integerError(result))) }
    }
}
