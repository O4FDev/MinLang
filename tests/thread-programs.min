// Thread programs whose threads own their sockets, files and event loops (PAR-1).
// Fixtures run at O0 and O2 on the threaded runtime with exact ownership checks;
// rejections keep the effect graph honest for unreviewed native code.
use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io
use "system" as system

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
frontend.runtimeFlags = ["-DMINYAR_THREADED=1", "-DMINYAR_SYSTEM_HEAP=1"]
let root = test.lines(test.run(["pwd", "-P"], system.environment(), "", frontend.compiler.directory + "/root", 10).output)[0]
// Native modules built as the launcher builds them for a thread program.
let natives: List<Text> = []
for name in ["net", "files", "system"] {
    let wrapper = frontend.compiler.directory + "/threaded-" + name + ".c"
    io.writeTextFile(wrapper, "#define MINYAR_THREADED 1\n#include \"" + root + "/runtime/native/" + name + ".c\"\n")
    natives.add(wrapper)
}
let levels = ["-O0", "-O2"]

frontend.sources = natives
fixtures.executes(frontend, io.readTextFile("tests/thread-programs/owned-io.min"), "worker 1 wrote this\nworker 2 wrote this\nworker 3 wrote this\n57\n", levels, 0, "", true)
print("owned-io: passed")
frontend.sources = []
fixtures.executes(frontend, io.readTextFile("tests/thread-programs/callbacks.min"), "1505\n1806\n6\n", levels, 0, "", true)
print("callbacks: passed")

// Typed entries and channels (PAR-1 entries, PAR-4 channels).
frontend.sources = natives
fixtures.executes(frontend, io.readTextFile("tests/thread-programs/typed-channels.min"), "6\n0:w0:1.0x\n1:w1:1.0x\n2:w2:1.0x\n3:w3:1.0x\n4:w4:1.0x\n5:w5:1.0x\nfalse\nshelf back 4 4 2\n1\n0\n1\n-1\nno value yet\n2\n1\n8 then 7\nwoke 42\n", levels, 0, "", true)
print("typed-channels: passed")
frontend.sources = []
// The queue under a channel checks every value's type when it is received.
fixtures.executes(frontend, "let q = minyarQueue(0)\nminyarQueueSend(q, \"text\")\nlet numbers: List<Integer> = []\nprint(minyarQueueReceive(q, numbers))\n", "", levels, 1, "Minyar stopped: a value of another type was sent on this channel.\n", true)
let typed = "use \"channels\" as channels\n"
fixtures.rejects(frontend, "thread function w(m: Map<Text, Integer>): Integer { return m.length }\nlet t = startThread(w, Map())\n", "thread entry 'w' parameter 'm' cannot cross threads: Map<Text, Integer> is not sendable", true)
fixtures.rejects(frontend, "thread function w(f: (Integer) -> Integer): Integer { return f(1) }\nlet t = startThread(w, function(n: Integer): Integer { return n })\n", "thread entry 'w' parameter 'f' cannot cross threads", true)
fixtures.rejects(frontend, "record Node { value: Integer; next: List<Node> }\nthread function w(n: Node): Integer { return n.value }\nlet t = startThread(w, Node { value: 1; next: [] })\n", "cannot cross threads: record 'Node' contains itself", true)
fixtures.rejects(frontend, "thread function w(t: Thread): Integer { return 0 }\nthread function v(n: Integer): Integer { return n }\nlet t = startThread(w, startThread(v, 1))\n", "thread entry 'w' parameter 't' cannot cross threads: Thread is not sendable", true)
fixtures.rejects(frontend, "thread function w(a: Integer, b: Text): Integer { return a }\nlet t = startThread(w, 1)\n", "startThread for 'w' expects 2 arguments after the entry, but received 1", true)
fixtures.rejects(frontend, "thread function w(a: Integer, b: Text): Integer { return a }\nlet t = startThread(w, \"one\", \"two\")\n", "argument 1 of thread entry 'w'", true)
fixtures.rejects(frontend, "thread function w(a: Integer): Text { return \"\" }\nlet t = startThread(w, 1)\n", "thread entry 'w' must be a named function returning Integer or Nothing", true)
fixtures.rejects(frontend, typed + "let c: channels.Channel<Map<Text, Integer>> = channels.unbounded()\nlet m: Map<Text, Integer> = Map()\nprint(channels.send(c, m))\n", "a channel value cannot cross threads: Map<Text, Integer> is not sendable", true)
fixtures.rejects(frontend, typed + "let c: channels.Channel<Integer> = channels.unbounded()\nprint(channels.send(c, \"one\"))\n", "", true)
print("typed rejections: passed")

// Atomic cells (PAR-3) on threads, through channels and in a parallel for (PAR-8).
fixtures.executes(frontend, io.readTextFile("tests/thread-programs/atomics.min"), "200000 of 200000\nfalse\n0\n60000 guarded, 3 arrived\n12\n21\n400\n5\n9\ntrue\n12\n10\n100\n-3\n253\n253\n254\ntrue\nfalse\ntrue\nfalse\ntrue\ntrue\n334 998001\n", levels, 0, "", true)
print("atomics: passed")
let cell = "let value = atomicInteger(0)\nlet flag = atomicBoolean(false)\n"
fixtures.rejects(frontend, cell + "print(value.loadRelease())\n", "a load cannot have Release ordering", true)
fixtures.rejects(frontend, cell + "value.storeAcquire(1)\n", "a store cannot have Acquire ordering", true)
fixtures.rejects(frontend, cell + "print(flag.fetchAdd(true))\n", "AtomicBoolean has no method 'fetchAdd'", true)
fixtures.rejects(frontend, cell + "value.waitAcquire(0)\n", "waits and wakes have no ordering", true)
fixtures.rejects(frontend, cell + "print(value.fetchAdd(true))\n", "AtomicInteger.fetchAdd argument", true)
fixtures.rejects(frontend, cell + "print(value.increment())\n", "AtomicInteger has no method 'increment'", true)
fixtures.rejects(frontend, "let forged = AtomicInteger(1)\n", "opaque thread types cannot be constructed", true)
fixtures.rejects(frontend, cell + "let out: List<Integer> = [0, 0]\nparallel for i in 0..2 {\n    let alias = value\n    out[i] = alias.load()\n}\n", "shared values may only be scalar buffers", true)
print("atomic rejections: passed")

let entry = "thread function worker(seed: Integer, unused: FrozenBytes, done: BytesChannel): Integer {\n    BODY\n}\nlet thread = startThread(worker, 1, freezeBytes(Bytes(0)), bytesChannel(0, 1))\nprint(joinThread(thread))\nMAIN\n"
function program(entry: Text, body: Text, main: Text): Text { return test.replace(test.replace(entry, "BODY", body), "MAIN", main) }

// Process-wide signal routing stays on main; a thread may not take it over.
frontend.sources = natives
fixtures.executes(frontend, "use \"system\" as system\n" + program(entry, "return seed", "print(system.ignoreBrokenPipes() >= 0)"), "1\ntrue\n", levels, 0, "", true)
frontend.sources = []
fixtures.rejects(frontend, "use \"system\" as system\n" + program(entry, "return system.shutdownSignalSocket()", ""), "unsafe thread effect in 'shutdownSignalSocket': native 'minyar_system_shutdownSignalSocket' 1(), reached from 'worker'", true)
// Unreviewed native code is rejected on threads and on main.
fixtures.rejects(frontend, "function secret(): Integer { native \"test\" }\n" + program(entry, "return secret()", ""), "unsafe thread effect in 'secret': native 'minyar_test_secret' 1(), reached from 'worker'", true)
fixtures.rejects(frontend, "function secret(): Integer { native \"test\" }\n" + program(entry, "return seed", "print(secret())"), "unsafe thread effect in 'secret': native 'minyar_test_secret' 1(), reached from 'main'", true)
// Closure bodies anywhere are checked when a thread can call closures.
fixtures.rejects(frontend, "use \"system\" as system\n" + program(entry, "let f = function(): Integer { return seed }\n    return f()", "let g = function(): Integer { return system.shutdownSignalSocket() }\nprint(g())"), "native 'minyar_system_shutdownSignalSocket' 1(), reached from 'worker' through 'callback'", true)
fixtures.rejects(frontend, "use \"system\" as system\nfunction signals(): Integer { return system.shutdownSignalSocket() }\nfunction pick(f: () -> Integer): Integer { return f() }\n" + program(entry, "return pick(signals)", ""), "native 'minyar_system_shutdownSignalSocket' 1(), reached from 'worker' through 'callback', 'signals'", true)
print("rejections: passed")
test.removeTree(frontend.compiler.directory)
print("Thread programs: passed")
