record Pair { first: Integer; second: Text }
record Packet { pair: Pair; spare: Integer }
choice Wrapper { Wrapped(value: Pair) }
choice Envelope { Present(value: Wrapper) }

let Pair(number, word) = Pair { first: 42; second: "moon" }
print(number)
print(word)
let Packet(Pair(Count, Name), _) = Packet { pair: Pair { first: 7; second: "days" }; spare: 99 }
print(Count)
print(Name)
let Wrapped(Pair(code, label)) = Wrapped(Pair { first: 8; second: "hours" })
print(code)
print(label)
let Present(Wrapped(Pair(depth, text))) = Present(Wrapped(Pair { first: 3; second: "layers" }))
print(depth)
print(text)
let Pair(_, TextValue) = Pair { first: 0; second: "uppercase" }
print(TextValue)

record Counter { calls: Integer }
function next(counter: Counter): Pair {
    counter.calls += 1
    return Pair { first: counter.calls; second: "once" }
}
let counter = Counter { calls: 0 }
let Pair(count, once) = next(counter)
print(count)
print(once)
print(counter.calls)

let old = 40
if true {
    let Pair(old, source) = Pair { first: old + 2; second: "outer" }
    print(old)
    print(source)
}
print(old)

record Outcome { result: Result<Nothing, Text> }
let Outcome(result) = Outcome { result: Ok() }
if result is Ok() { print("complete") }
