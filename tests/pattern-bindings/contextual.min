record Context { is: Integer }
function is(value: Integer): Integer { return value + 1 }
function echo(is: Integer): Integer { return is }
let context = Context { is: 41 }
print(is(context.is))
print(echo(42))
for is in [20, 22] { print(is) }
if Some(is(41)) is Some(number) { print(number) }
if Some(42) is Some(is) { print(is) }
let Context(is) = Context { is: 42 }
print(is)

function choose(is: Boolean): Text {
    if is { return "ordinary condition" }
    return "false"
}
print(choose(true))
function once(): Integer {
    let is = true
    let count = 0
    while is { count += 1; is = false }
    return count
}
print(once())
if Some(7) is Some(is) { print(is) }
print(is)

record Cursor { is: Integer }
function next(cursor: Cursor): Maybe<Integer> {
    cursor.is += 1
    if cursor.is > 2 { return None }
    return Some(cursor.is)
}
let cursor = Cursor { is: 0 }
while next(cursor) is Some(is) { print(is) }
print(is)
