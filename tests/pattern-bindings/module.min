public record Open { number: Integer; text: Text }
public record Account { label: Text; private secret: Text }
public record Generic<Item> { value: Item }
public choice Bag<Item> { Wrapped(value: Item) }

public function open(): Open { return Open { number: 7; text: "module" } }
public function account(): Account { return Account { label: "public"; secret: "private" } }
public function wrap<Item>(value: Item): Generic<Item> { return Generic { value: value } }
public function bag(): Bag<Open> { return Wrapped(open()) }
public function inside(): Text {
    let Account(_, secret) = account()
    return secret
}
