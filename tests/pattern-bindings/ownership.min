record Letter { text: Text; lines: List<Text> }
record Holder { value: Maybe<Letter> }
function fresh(label: Text): Holder {
    return Holder { value: Some(Letter { text: label; lines: [label] }) }
}

let holder = fresh("conditional")
if holder.value is Some(Letter(text, lines)) {
    holder.value = None
    for index in 0..100 { let scratch = Bytes(32); scratch[0] = index }
    print(text)
    print(lines[0])
}

function reader(holder: Holder): () -> Text {
    if holder.value is Some(Letter(text, _)) {
        holder.value = None
        return function() { return text }
    }
    return function() { return "lost" }
}
let read = reader(fresh("captured"))
print(read())

let original = Letter { text: "destructured"; lines: ["record kept"] }
let Letter(savedText, savedLines) = original
original = Letter { text: "changed"; lines: [] }
print(savedText)
print(savedLines[0])

choice Box { Wrapped(value: Letter) }
let box = Wrapped(Letter { text: "choice kept"; lines: ["list kept"] })
let Wrapped(Letter(boxText, boxLines)) = box
box = Wrapped(Letter { text: "changed"; lines: [] })
let saved: () -> Text = function() { return boxText }
print(saved())
print(boxLines[0])

record Stream { index: Integer }
function next(stream: Stream): Maybe<Letter> {
    stream.index += 1
    if stream.index > 3 { return None }
    return Some(Letter { text: Text(stream.index); lines: [Text(stream.index)] })
}
let stream = Stream { index: 0 }
while next(stream) is Some(Letter(text, lines)) {
    if text == "1" { continue }
    print(text)
    print(lines[0])
    break
}
function fromLoop(): () -> Text {
    let stream = Stream { index: 0 }
    while next(stream) is Some(Letter(text, _)) { return function() { return text } }
    return function() { return "lost" }
}
print(fromLoop()())

for index in 0..100 {
    let temporary = fresh("loop")
    if temporary.value is Some(Letter(text, _)) {
        temporary.value = None
        if text != "loop" { fail("lost a repeated condition binding") }
    }
}
print("clean")
