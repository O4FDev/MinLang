record Cursor { index: Integer; calls: Integer }
function next(cursor: Cursor): Maybe<Result<Text, Text>> {
    cursor.calls += 1
    if cursor.index >= 5 { return None }
    cursor.index += 1
    if cursor.index == 1 { return Some(Ok("one")) }
    if cursor.index == 2 { return Some(Err("skip")) }
    if cursor.index == 3 { return Some(Ok("three")) }
    if cursor.index == 4 { return Some(Ok("four")) }
    return Some(Ok("five"))
}

let cursor = Cursor { index: 0; calls: 0 }
while next(cursor) is Some(entry) {
    if entry is Err(_) { continue }
    if entry is Ok(word) {
        print(word)
        if word == "four" { break }
    }
}
print(cursor.calls)
print(cursor.index)

let stopped = Cursor { index: 0; calls: 0 }
while next(stopped) is Some(Ok(word)) { print(word) }
print(stopped.calls)

record Numbers { index: Integer; calls: Integer }
function take(numbers: Numbers): Maybe<Integer> {
    numbers.calls += 1
    if numbers.index >= 4 { return None }
    let value = numbers.index
    numbers.index += 1
    return Some(value)
}
let numbers = Numbers { index: 0; calls: 0 }
let total = 0
while take(numbers) is Some(number) {
    if number == 1 { continue }
    total += number
}
print(total)
print(numbers.calls)
while Some("held") is Some(word) { print(word); break }

function first(): Text {
    let cursor = Cursor { index: 0; calls: 0 }
    while next(cursor) is Some(Ok(word)) { return word }
    return "empty"
}
print(first())

function snapshot(numbers: Numbers): Numbers { numbers.calls += 1; return numbers }
let recordCursor = Numbers { index: 0; calls: 0 }
while snapshot(recordCursor) is Numbers(0, calls) {
    print(calls)
    recordCursor.index = 1
}
print(recordCursor.calls)
