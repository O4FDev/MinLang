choice Reading { Value(number: Integer); Missing }
record Counter { calls: Integer }
function observed(counter: Counter, value: Maybe<Result<Reading, Text>>): Maybe<Result<Reading, Text>> {
    counter.calls += 1
    return value
}

let counter = Counter { calls: 0 }
let input: Maybe<Result<Reading, Text>> = Some(Ok(Value(42)))
if observed(counter, input) is Some(Ok(Value(number))) { print(number) } else { fail("lost the nested match") }
print(counter.calls)
if input is Some(Err(error)) { print(error) } else { print("different case") }
if Some(1) is Some(2) {
    fail("matched a different literal")
} else if input is Some(Ok(Value(Value))) {
    print(Value)
} else {
    fail("lost the else-if bindings")
}

record Pair { first: Integer; second: Text }
let pair = Pair { first: 7; second: "days" }
if pair is Pair(7, word) { print(word) }
if pair is Pair(8, _) { fail("matched a different record field") } else { print("record fallback") }

let number = 99
if Some(42) is Some(number) { print(number) }
print(number)
if None<Integer>() is Some(number) { fail("matched absence") } else { print(number) }

function describe(value: Maybe<Result<Reading, Text>>): Text {
    if value is Some(Ok(Value(number))) { return Text(number) }
    else if value is Some(Err(error)) { return error }
    else { return "missing" }
}
print(describe(input))
print(describe(Some(Err("closed"))))
print(describe(None))

let complete: Result<Nothing, Text> = Ok()
if complete is Ok() { print("done") } else { fail("lost no-value success") }
if Some(false) is Some(false) { print("literal") }

function identity<Item>(value: Item): Item { return value }
let value = Some(42)
if match true {
    true { identity(value) }
    false { value }
} is Some(number) { print(number) }

if Pair { first: 7; second: "direct" } is Pair(number, word) { print(number); print(word) }
if true {
    let is = "ordinary is"
    print(is)
}
