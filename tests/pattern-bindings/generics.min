record Pair<First, Second> { first: First; second: Second }
choice Wrapper<Item> { Wrapped(value: Item) }

function swap<First, Second>(pair: Pair<First, Second>): Pair<Second, First> {
    let Pair(first, second) = pair
    return Pair { first: second; second: first }
}
let Pair(number, word) = Pair { first: 42; second: "generic" }
print(number)
print(word)
let Pair(swapped, original) = swap(Pair { first: 7; second: "days" })
print(swapped)
print(original)

function unwrap<Item>(value: Wrapper<Item>): Item {
    let Wrapped(Value) = value
    return Value
}
print(unwrap(Wrapped(42)))
print(unwrap(Wrapped("choice")))

let nested: Pair<Maybe<Integer>, Result<Text, Text>> = Pair { first: Some(7); second: Ok("nested") }
if nested is Pair(Some(Number), Ok(TextValue)) { print(Number); print(TextValue) }

function find<Item>(value: Maybe<Wrapper<Item>>, fallback: Item): Item {
    if value is Some(Wrapped(Value)) { return Value }
    return fallback
}
print(find(Some(Wrapped("found")), "missing"))
print(find(None<Wrapper<Text>>(), "fallback"))

function keep<Item>(value: Pair<Item, Integer>): Item {
    if value is Pair(Value, _) { return Value }
    fail("an ordinary record pattern is total")
}
print(keep(Pair { first: "record"; second: 0 }))
