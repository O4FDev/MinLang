// Fixed budget and seed: mutate headers, then ask the unchanged public
// wire parser for frame extents instead of duplicating the fast decoder.
function seededStreamCorpus(c: quic.Connection,now: Integer): Integer {
    if c.streams.length!=0 || c.closedStreams.length!=0 { return 137 }
    c.spaces[2].readFirst=-1
