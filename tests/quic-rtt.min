use "quic" as quic
use "errors" as errors
use "quiccrypto" as protection
use "quicwire" as wire
use "quicrecovery" as recovery
function number(data: Bytes,value: Integer) { data.addBytes(errors.bytesValue(wire.encode(value))) }
function inject(sender: quic.Connection,receiver: quic.Connection,frame: Bytes,now: Integer) {
    let space=sender.spaces[2];let header=Bytes();header.add(0x43);header.addBytes(sender.remote)
    for index in 0..4 { header.add((space.next>>((3-index)*8))&255) }
    let packet=errors.bytesValue(protection.protect(space.write,header,header.length-4,space.next,frame));space.next+=1
    quic.receive(receiver,packet,now)
}
function ack(sender: quic.Connection,receiver: quic.Connection,packet: Integer,now: Integer) {
    let frame=Bytes();frame.add(2);number(frame,packet);number(frame,0);number(frame,0);number(frame,0)
    inject(sender,receiver,frame,now)
}
function drive(c: quic.Connection,s: quic.Connection,now: Integer) {
    for packet in quic.poll(c,now) { quic.receive(s,packet,now) }
    for packet in quic.poll(s,now) { quic.receive(c,packet,now) }
}
function lateACK(c: quic.Connection,s: quic.Connection,now: Integer): Integer {
    if c.spaces[2].sent.length!=0 { return 60 }
    c.congestion.measured=true;c.congestion.smoothed=100;c.congestion.latest=100;c.congestion.minimum=100
    c.paceCredit=Float(c.congestion.window);c.paceAt=now
    let id=errors.integerValue(quic.openStream(c,false))
    let originalNumber=c.spaces[2].next
    quic.writeStream(c,id,Bytes("delayed"),true)
    for packet in quic.poll(c,now) { quic.receive(s,packet,now) }
    if c.spaces[2].sent.length!=1 { return 60 }
    let original=c.spaces[2].sent[0]
    for index in 1..4 {
        quic.ping(c)
        for packet in quic.poll(c,now+index) { quic.receive(s,packet,now+index) }
    }
    let newest=c.spaces[2].next-1
    ack(s,c,newest,now+4)
    c.paceCredit=0.0;c.paceAt=now+4
    quic.poll(c,now+4)
    if original.status!=2 || original.payload.length!=0 || c.pending.length==0 { return 60 }
    let before=c.flight
    ack(s,c,originalNumber,now+5)
    if c.streams[0].sendAcknowledged!=7 { print("late ACK lost stream delivery metadata");return 61 }
    if !c.streams[0].finalAcknowledged { return 62 }
    if c.flight!=before { return 63 }
    let next=c.spaces[2].next
    quic.poll(c,now+100)
    for packet in c.spaces[2].sent {
        if packet.number>=next {
            for frame in wire.frames(packet.payload).frames {
                if frame.type>=8 && frame.type<=15 && frame.stream==id { return 64 }
            }
        }
    }
    return 0
}
function queuedMixed(c: quic.Connection,s: quic.Connection,now: Integer): Integer {
    let id=errors.integerValue(quic.openStream(c,false));quic.writeStream(c,id,Bytes("queued"),true)
    let pending=c.pending[0]
    for packet in quic.poll(c,now) { quic.receive(s,packet,now) }
    let acknowledgements=quic.poll(s,now+1)
    pending.payload=pending.payload.slice(0,pending.payload.length)
    c.receiveMaxData+=65536;pending.payload.add(16);number(pending.payload,c.receiveMaxData)
    c.pending.add(pending)
    for packet in acknowledgements { quic.receive(c,packet,now+1) }
    if c.streams[0].sendAcknowledged!=6 || !c.streams[0].finalAcknowledged { return 65 }
    let first=c.spaces[2].next
    quic.poll(c,now+100)
    let controls=0
    for packet in c.spaces[2].sent {
        if packet.number>=first {
            for frame in wire.frames(packet.payload).frames {
                if frame.type>=8 && frame.type<=15 && frame.stream==id { print("queued retransmission ignored delivered bytes");return 66 }
                if frame.type==16 && frame.value==c.receiveMaxData { controls+=1 }
            }
        }
    }
    if controls!=1 { return 67 }
    return 0
}

function recoveredDelivery(c: quic.Connection,s: quic.Connection,now: Integer): Integer {
    let id=errors.integerValue(quic.openStream(c,false))
    for round in 0..4097 {
        let tick=now+round*50
        c.paceCredit=Float(c.congestion.window);c.paceAt=tick
        quic.writeStream(c,id,Bytes("x"),false)
        quic.poll(c,tick)
        if c.spaces[2].sent.length!=1 { print("recovery original "+Text(round)+" "+Text(c.spaces[2].sent.length));return 69 }
        let original=c.spaces[2].sent[0]
        for step in 1..4 {
            quic.ping(c)
            for packet in quic.poll(c,tick+step) { quic.receive(s,packet,tick+step) }
        }
        let frame=Bytes();frame.add(2);number(frame,c.spaces[2].next-1);number(frame,0);number(frame,0);number(frame,2)
        inject(s,c,frame,tick+4)
        c.paceCredit=0.0;c.paceAt=tick+4
        quic.poll(c,tick+4)
        if original.status!=2 || original.payload.length!=0 || c.pending.length!=1 { print("recovery loss phase "+Text(round));return 70 }
        for packet in quic.poll(c,tick+20) { quic.receive(s,packet,tick+20) }
        for packet in quic.poll(s,tick+21) { quic.receive(c,packet,tick+21) }
        if c.streams[0].sendAcknowledged!=round+1 { print("recovery ACK "+Text(round)+" "+Text(c.streams[0].sendAcknowledged));return 71 }
        if c.spaces[2].lostStreams.length-c.spaces[2].lostStreamsAt!=0 {
            print("acknowledged retransmission retained stale delivery metadata "+Text(round));return 72
        }
        if c.flight!=0 || c.spaces[2].sent.length!=0 || c.pending.length!=0 { return 73 }
    }
    return 0
}

function boundedLateDelivery(c: quic.Connection,s: quic.Connection,now: Integer,references: Integer): Integer {
    let id=errors.integerValue(quic.openStream(c,false))
    quic.writeStream(c,id,Bytes("x"),true)
    let encoded=c.pending[0].payload.slice(0,c.pending[0].payload.length)
    for copy in 1..references { c.pending[0].payload.addBytes(encoded) }
    let last=-1
    for round in 0..4097 {
        let tick=now+round*50
        // Isolate packet-threshold loss from an outstanding PTO deadline.
        c.spaces[2].probe=-1
        c.paceCredit=Float(c.congestion.window);c.paceAt=tick
        quic.poll(c,tick)
        if c.spaces[2].sent.length!=1 { print("bounded original "+Text(round)+" "+Text(c.spaces[2].sent.length));return 74 }
        let original=c.spaces[2].sent[0];last=original.number
        for step in 1..4 {
            quic.ping(c)
            for packet in quic.poll(c,tick+step) { quic.receive(s,packet,tick+step) }
        }
        let frame=Bytes();frame.add(2);number(frame,c.spaces[2].next-1);number(frame,0);number(frame,0);number(frame,2)
        inject(s,c,frame,tick+4)
        c.paceCredit=0.0;c.paceAt=tick+4
        quic.poll(c,tick+4)
        if original.status!=2 || original.payload.length!=0 || c.pending.length!=1 { print("bounded loss phase "+Text(round));return 75 }
        let space=c.spaces[2];let live=space.lostStreams.length-space.lostStreamsAt
        if live>4096 || space.lostStreams.length>8192 || space.lostReferences>4096 { print("bounded cache count "+Text(round)+" "+Text(live)+" "+Text(space.lostStreams.length));return 76 }
        for at in 0..space.lostStreamsAt { if space.lostStreams[at].streams.length!=0 { print("bounded expired refs "+Text(round));return 76 } }
        if round%256==0 || round==4096 {
            let actual=0
            for at in space.lostStreamsAt..space.lostStreams.length { actual+=space.lostStreams[at].streams.length }
            if actual!=space.lostReferences || actual>4096 { print("lost cache reference accounting "+Text(round)+" "+Text(actual)+" "+Text(space.lostReferences));return 88 }
        }
        if c.streams[0].sendAcknowledged!=0 || c.streams[0].finalAcknowledged { print("bounded premature delivery "+Text(round)+" "+Text(last));return 76 }
    }
    let before=c.flight
    ack(s,c,last,now+4097*50)
    if c.streams[0].sendAcknowledged!=1 || !c.streams[0].finalAcknowledged || c.flight!=before { return 77 }
    if c.spaces[2].lostStreams.length-c.spaces[2].lostStreamsAt!=0 {
        print("later lost retry ACK left earlier delivered metadata");return 78
    }
    quic.poll(c,now+4097*50+100)
    for sent in c.spaces[2].sent {
        for frame in wire.frames(sent.payload).frames { if frame.type>=8 && frame.type<=15 && frame.stream==id { return 79 } }
    }
    return 0
}

function delayedPersistent(c: quic.Connection,s: quic.Connection,now: Integer,late: Boolean,retried: Boolean): Integer {
    if c.spaces[2].sent.length!=0 || c.history.length!=0 { return 81 }
    c.congestion.smoothed=100;c.congestion.latest=100;c.congestion.minimum=100;c.congestion.variance=0;c.congestion.window=12000;c.congestion.measured=true
    c.emptySince=-1;c.paceCredit=12000.0;c.paceAt=now
    let id=errors.integerValue(quic.openStream(c,false));let original=c.spaces[2].next
    quic.writeStream(c,id,Bytes("a"),false)
    for packet in quic.poll(c,now) { quic.receive(s,packet,now) }
    c.spaces[2].probe=-1
    quic.writeStream(c,id,Bytes("b"),false)
    for packet in quic.poll(c,now+1000) { quic.receive(s,packet,now+1000) }
    quic.ping(c)
    for packet in quic.poll(c,now+1001) { quic.receive(s,packet,now+1001) }
    ack(s,c,c.spaces[2].next-1,now+1020)
    c.paceCredit=0.0;c.paceAt=now+1020
    quic.poll(c,now+1020)
    if c.lossFirst!=now || c.lossLast!=now || c.congestion.window<=2400 { print("persistent setup");return 82 }
    if retried {
        c.paceCredit=Float(c.congestion.window);c.paceAt=now+1022
        let retry=c.spaces[2].next
        for packet in quic.poll(c,now+1022) { quic.receive(s,packet,now+1022) }
        if c.spaces[2].next!=retry+1 { print("persistent retry setup");return 93 }
        ack(s,c,retry,now+1023)
        if c.streams[0].sendAcknowledged!=1 { return 93 }
    }
    if late {
        let flight=c.flight
        ack(s,c,original,now+1024)
        if c.streams[0].sendAcknowledged!=1 || c.flight!=flight { return 83 }
    }
    c.paceCredit=0.0;c.paceAt=now+1200;quic.poll(c,now+1200)
    if late && c.congestion.window<=2400 { print("delayed ACK left false persistent loss interval");return 84 }
    if !late && c.congestion.window!=2400 { print("persistent positive control");return 85 }
    return 0
}
function freshProbe(c: quic.Connection,s: quic.Connection,now: Integer): Integer {
    c.congestion.measured=true;c.congestion.smoothed=100;c.congestion.latest=100;c.congestion.minimum=100
    c.paceCredit=Float(c.congestion.window);c.paceAt=now
    let id=errors.integerValue(quic.openStream(c,false))
    quic.writeStream(c,id,Bytes("probe"),false);quic.poll(c,now)
    for step in 1..4 { quic.ping(c);for packet in quic.poll(c,now+step) { quic.receive(s,packet,now+step) } }
    let frame=Bytes();frame.add(2);number(frame,c.spaces[2].next-1);number(frame,0);number(frame,0);number(frame,2)
    inject(s,c,frame,now+4)
    c.paceCredit=0.0;c.paceAt=now+4;quic.poll(c,now+4)
    if c.spaces[2].sent.length!=0 || c.pending.length!=1 { return 86 }
    c.paceCredit=Float(c.congestion.window);c.paceAt=now+1000
    quic.poll(c,now+1000)
    if c.spaces[2].sent.length!=1 { return 86 }
    if c.spaces[2].probe<=now+1000 { print("new packet inherited an expired PTO deadline");return 87 }
    return 0
}

function lateReset(c: quic.Connection,s: quic.Connection,now: Integer): Integer {
    let id=errors.integerValue(quic.openStream(c,true));quic.cancelStream(c,id,73)
    let first=c.spaces[2].next
    for packet in quic.poll(c,now) { quic.receive(s,packet,now) }
    if c.spaces[2].sent.length!=1 { return 89 }
    let original=c.spaces[2].sent[0]
    for step in 1..4 { quic.ping(c);for packet in quic.poll(c,now+step) { quic.receive(s,packet,now+step) } }
    let frame=Bytes();frame.add(2);number(frame,c.spaces[2].next-1);number(frame,0);number(frame,0);number(frame,2)
    inject(s,c,frame,now+4)
    c.paceCredit=0.0;c.paceAt=now+4;quic.poll(c,now+4)
    if original.status!=2 || original.payload.length!=0 || c.pending.length!=1 { return 89 }
    let before=c.flight;ack(s,c,first,now+5)
    if !c.streams[0].resetAcknowledged || c.flight!=before { print("late reset ACK lost delivery");return 90 }
    quic.poll(c,now+100)
    for sent in c.spaces[2].sent {
        for frame in wire.frames(sent.payload).frames { if frame.type==4 && frame.stream==id { return 91 } }
    }
    return 0
}
function duplicateProbe(c: quic.Connection,s: quic.Connection,now: Integer): Integer {
    c.congestion.measured=true;c.congestion.smoothed=100;c.congestion.latest=100;c.congestion.minimum=100;c.congestion.variance=0
    c.paceCredit=Float(c.congestion.window);c.paceAt=now
    let original=c.spaces[2].next;quic.ping(c)
    for packet in quic.poll(c,now) { quic.receive(s,packet,now) }
    ack(s,c,original,now+10)
    let id=errors.integerValue(quic.openStream(c,false))
    quic.writeStream(c,id,Bytes("dropped"),false);quic.poll(c,now+20)
    if c.spaces[2].sent.length!=1 { return 94 }
    let deadline=c.spaces[2].probe;let first=c.spaces[2].next
    if deadline<=now+20 { return 94 }
    let tick=now+30
    while tick<deadline {
        ack(s,c,original,tick)
        if c.spaces[2].probe!=deadline { print("duplicate ACK postponed outstanding PTO");return 92 }
        quic.poll(c,tick);tick+=10
    }
    quic.poll(c,deadline)
    if c.congestion.probes!=1 || c.spaces[2].next<=first { print("outstanding probe did not retransmit");return 95 }
    return 0
}
function sendProgressProbe(c: quic.Connection,s: quic.Connection,now: Integer): Integer {
    c.congestion.measured=true;c.congestion.smoothed=100;c.congestion.latest=100;c.congestion.minimum=100;c.congestion.variance=0
    c.paceCredit=Float(c.congestion.window);c.paceAt=now
    let id=errors.integerValue(quic.openStream(c,false))
    quic.writeStream(c,id,Bytes("a"),false);quic.poll(c,now)
    quic.writeStream(c,id,Bytes("b"),false);quic.poll(c,now+20)
    if c.spaces[2].sent.length!=2 { return 94 }
    if c.spaces[2].probe!=now+20+recovery.pto(c.congestion,true) { print("new transmission did not advance PTO send time");return 96 }
    return 0
}
function main(): Integer {
    let root=readBytesFile(argument(0));let cert=readBytesFile(argument(1));let key=readBytesFile(argument(2));let client=readBytesFile(argument(3));let clientKey=readBytesFile(argument(4))
    for scenario in 0..13 {
        let candidate=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
        let peer=quic.server(randomBytes(80),"minyar-test",candidate.originalDestination,[cert],key,[root],true)
        for count in 0..200 { drive(candidate,peer,count*10) }
        if !candidate.confirmed || !peer.confirmed { return 68 }
        let result=0
        if scenario==0 { result=lateACK(candidate,peer,2000) } else if scenario==1 { result=queuedMixed(candidate,peer,2000) } else if scenario==2 { result=recoveredDelivery(candidate,peer,2000) } else if scenario==3 { result=boundedLateDelivery(candidate,peer,2000,1) } else if scenario==4 { result=freshProbe(candidate,peer,2000) } else if scenario==7 { result=boundedLateDelivery(candidate,peer,2000,3) } else if scenario==8 { result=lateReset(candidate,peer,2000) } else if scenario==11 { result=duplicateProbe(candidate,peer,2000) } else if scenario==12 { result=sendProgressProbe(candidate,peer,2000) } else { result=delayedPersistent(candidate,peer,2000,scenario==6 || scenario==9,scenario==9 || scenario==10) }
        if result!=0 { return result }
    }
    let c=quic.client("localhost",randomBytes(80),"minyar-test",[root],[client],clientKey)
    let s=quic.server(randomBytes(80),"minyar-test",c.originalDestination,[cert],key,[root],true);let now=0
    while now<10000 && (c.state != quic.ESTABLISHED || s.state != quic.ESTABLISHED) {
        for packet in quic.poll(c,now) { quic.receive(s,packet,now) }
        for packet in quic.poll(s,now) { quic.receive(c,packet,now) };now+=10
    }
    c.congestion=recovery.create(1200)
    let first=c.spaces[2].next;quic.ping(c);quic.poll(c,1000)
    let ping=Bytes();ping.add(1);inject(s,c,ping,1005);quic.poll(c,1005)
    let last=c.spaces[2].next-1
    if last<=first { return 1 }
    let ack=Bytes();ack.add(2);number(ack,last);number(ack,0);number(ack,0);number(ack,last-first)
    inject(s,c,ack,1105)
    if !c.congestion.measured || c.congestion.latest != 100 { print("RTT " + Text(c.congestion.measured) + " " + Text(c.congestion.latest));return 2 }
    let duplicate=ack.slice(0,ack.length);inject(s,c,duplicate,1205)
    if c.congestion.latest != 100 { return 3 }
    c.now=2000;c.emptySince=-1;c.congestion.epoch=2000;c.congestion.smoothed=1000;c.paceCredit=0.0;c.paceAt=2000
    let id=errors.integerValue(quic.openStream(c,false));quic.writeStream(c,id,Bytes(2000),false)
    quic.poll(c,2001);quic.poll(c,2100)
    if c.congestion.epoch != 2000 { print("paced backlog treated as idle " + Text(c.congestion.epoch));return 4 }
    print("QUIC RTT: largest newly acknowledged ACK-only packet supplies the sample; duplicate ACK does not resample")
    return 0
}
