// The outgoing factory emits ACK2. Stale ACK2/ACK3 candidates are pruned,
// then the authenticated piggyback ACK must govern read-key bookkeeping.
function ackMetadataCorpus(c: quic.Connection,s: quic.Connection,now: Integer): Integer {
    let cases=0;let space=c.spaces[2]
    for candidateType in 2..4 {
        for boundary in 0..3 {
            let at=now+cases
            c.pending=[];c.history=[];space.sent=[];space.probe=-1;c.flight=0
            space.ack=false;space.ackQueued=false;space.ackCount=0;space.ackDeadline=-1;space.ackPath=-1
            space.readAcknowledged=true
