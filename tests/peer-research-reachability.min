use "../tools/testing.min" as test
use "./compiler-port-support.min" as port

let names = ["test_value_return_inside_literal_true_loop", "test_conditional_return_with_continue_has_no_fallthrough", "test_inner_loop_break_does_not_exit_outer_loop", "test_unreachable_break_after_return_does_not_create_fallthrough", "test_diverging_value_functions_need_no_unreachable_return", "test_owned_return_from_literal_true_loop_keeps_its_value", "test_reachable_break_still_requires_return_after_the_loop", "test_reachable_break_can_reach_a_following_return", "test_while_marker_keeps_continue_after_a_reachable_break", "test_dead_nested_branches_and_loops_do_not_add_an_outer_exit", "test_nonconstant_condition_still_requires_return", "test_compound_true_condition_keeps_existing_conservative_behavior", "test_compound_condition_starting_with_true_can_still_fall_through", "test_unreachable_source_still_resolves_names_and_checks_types", "test_unreachable_source_keeps_its_diagnostic_location", "test_observable_effects_before_return_or_break_are_preserved", "test_loop_condition_still_requires_boolean"]
let family = "LiteralTrueLoopReachability"
let selectors = port.selectors(family, names)
let context = port.compiler()
let missing = "must return a value on every path"

if port.selected(selectors, family, "test_value_return_inside_literal_true_loop") {
    port.executes(context, "function value(): Integer {\n    while true { return 41 }\n}\nprint(value())\n", "41\n", 0, "")
}
if port.selected(selectors, family, "test_conditional_return_with_continue_has_no_fallthrough") {
    port.executes(context, "function value(): Integer {\n    let count = 0\n    while true {\n        count += 1\n        if count == 4 { return count }\n        continue\n    }\n}\nprint(value())\n", "4\n", 0, "")
}
if port.selected(selectors, family, "test_inner_loop_break_does_not_exit_outer_loop") {
    for loop in ["while true { break }", "for item in 0..1 { break }"] {
        port.executes(context, "function value(): Integer {\nwhile true {\n" + loop + "\nreturn 42\n}\n}\nprint(value())\n", "42\n", 0, "")
    }
}
if port.selected(selectors, family, "test_unreachable_break_after_return_does_not_create_fallthrough") {
    port.executes(context, "function value(): Integer {\n    while true {\n        return 43\n        break\n    }\n}\nprint(value())\n", "43\n", 0, "")
}
if port.selected(selectors, family, "test_diverging_value_functions_need_no_unreachable_return") {
    for body in ["", "continue", "continue\nbreak"] {
        port.executes(context, "function never(): Integer { while true {\n" + body + "\n} }\nprint(44)\n", "44\n", 0, "")
    }
}
if port.selected(selectors, family, "test_owned_return_from_literal_true_loop_keeps_its_value") {
    port.executes(context, "record Result { text: Text }\nfunction value(): Result {\n    while true {\n        let text = \"retained\" + \"!\"\n        return Result { text: text }\n    }\n}\nprint(value().text)\n", "retained!\n", 0, "")
}
if port.selected(selectors, family, "test_reachable_break_still_requires_return_after_the_loop") {
    for body in ["break", "if flag { break } else { return 1 }", "while true { break }\nif flag { break }\nreturn 1"] {
        port.rejects(context, "function value(flag: Boolean): Integer {\nwhile true {\n" + body + "\n}\n}\n", missing)
    }
}
if port.selected(selectors, family, "test_reachable_break_can_reach_a_following_return") {
    port.executes(context, "function value(flag: Boolean): Integer {\n    while true {\n        if flag { break }\n        return 45\n    }\n    return 46\n}\nprint(value(false))\nprint(value(true))\n", "45\n46\n", 0, "")
}
if port.selected(selectors, family, "test_while_marker_keeps_continue_after_a_reachable_break") {
    port.executes(context, "function value(takeBreak: Boolean, skipOnce: Boolean): Integer {\n    let visits = 0\n    while true {\n        visits += 1\n        if takeBreak { break }\n        if skipOnce && visits == 1 { continue }\n        return 7\n    }\n    return 8\n}\nprint(value(true, true))\nprint(value(false, true))\nprint(value(false, false))\n", "8\n7\n7\n", 0, "")
}
if port.selected(selectors, family, "test_dead_nested_branches_and_loops_do_not_add_an_outer_exit") {
    port.executes(context, "function value(flag: Boolean): Integer {\n    while true {\n        if flag { return 47 } else { return 48 }\n        if flag { break } else if !flag { break } else { continue }\n        while true { break }\n        for item in 0..1 { break }\n        break\n    }\n}\nprint(value(true))\nprint(value(false))\n", "47\n48\n", 0, "")
}
if port.selected(selectors, family, "test_nonconstant_condition_still_requires_return") {
    port.rejects(context, "function value(flag: Boolean): Integer {\nwhile flag { return 1 }\n}\n", missing)
}
if port.selected(selectors, family, "test_compound_true_condition_keeps_existing_conservative_behavior") {
    port.rejects(context, "function value(): Integer {\nwhile true || false { return 1 }\n}\n", missing)
}
if port.selected(selectors, family, "test_compound_condition_starting_with_true_can_still_fall_through") {
    for condition in ["true && flag", "true == flag"] {
        port.rejects(context, "function value(flag: Boolean): Integer {\nwhile " + condition + " { return 1 }\n}\n", missing)
    }
}
if port.selected(selectors, family, "test_unreachable_source_still_resolves_names_and_checks_types") {
    let statements = ["print(missingName)", "print(1 + true)", "while 1 { break }"]
    let diagnostics = ["can't find a value", "the two sides of '+' have different types (Integer and Boolean)", "a while condition must be Boolean"]
    for index in 0..statements.length {
        port.rejects(context, "function value(): Integer {\n    while true {\n        return 49\n        " + statements[index] + "\n    }\n}\n", diagnostics[index])
    }
}
if port.selected(selectors, family, "test_unreachable_source_keeps_its_diagnostic_location") {
    port.rejects(context, "function value(): Integer {\n    while true {\n        return 49\n        print(missingName)\n    }\n}\n", "line 4, column 15: I can't find a value named 'missingName'")
}
if port.selected(selectors, family, "test_observable_effects_before_return_or_break_are_preserved") {
    port.executes(context, "function value(effects: List<Integer>, takeBreak: Boolean): Integer {\n    while true {\n        effects.add(1)\n        if takeBreak { effects.add(2); break }\n        effects.add(3)\n        return 4\n    }\n    effects.add(5)\n    return 6\n}\nlet effects: List<Integer> = []\nprint(value(effects, false))\nprint(effects.length)\nprint(value(effects, true))\nprint(effects.length)\nfor effect in effects { print(effect) }\n", "4\n2\n6\n5\n1\n3\n1\n2\n5\n", 0, "")
}
if port.selected(selectors, family, "test_loop_condition_still_requires_boolean") {
    for value in ["1", "1.0", "\"true\"", "'t'"] {
        port.rejects(context, "function value(): Integer {\nwhile " + value + " { return 1 }\n}\n", "a while condition must be Boolean")
    }
}
test.removeTree(context.directory)
