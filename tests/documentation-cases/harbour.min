/// A little light, with a name to find it by.
public record Lantern {
    /// The place this light belongs to.
    name: Text
    /// How many windows it can brighten.
    light: Integer
}

/// A greeting for someone coming home.
///
/// Text preserves the little details, including accents and stars.
/// <script>alert("the sea")</script> is only text here.
///
/// ```minyar
/// print(api.welcome("Ada"))
/// ```
/// ```output
/// Hello, Ada. The light is on.
/// ```
public function welcome(name: Text): Text {
    return "Hello, \(name). The light is on."
}

/// Share the light equally. The original lantern stays bright.
///
/// `friends` must be positive. Each friend receives the same whole number
/// of lights; the remainder stays in the harbour.
///
/// ```minyar
/// let harbour = api.Lantern { name: "Home"; light: 84 }
/// print(harbour.share(2))
/// ```
/// ```output
/// 42
/// ```
public function Lantern.share(friends: Integer): Integer {
    return self.light / friends
}

/// A path can be a destination, or a moment of rest.
public choice Journey {
    /// Follow a familiar light.
    Harbour(name: Text)
    /// Stay a little longer.
    Rest
}

/// Keep the first thing, or offer something when the list is empty.
///
/// ```minyar
/// print(api.firstOr(["moon", "sea"], "silence"))
/// ```
/// ```output
/// moon
/// ```
public function firstOr<Item>(values: List<Item>, fallback: Item): Item {
    if values.length == 0 { return fallback }
    return values[0]
}
