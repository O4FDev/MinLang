use "quicdispatch" as dispatch
use "errors" as errors
use "crypto" as crypto
function identifier(value: Integer): Bytes {
    let key = Bytes(); key.add((value >> 24) & 255); key.add((value >> 16) & 255); key.add((value >> 8) & 255); key.add(value & 255); return key
}
function main(): Integer {
    // A single bucket deliberately makes every distinct key collide.
    let table = dispatch.table(128, 1, randomBytes(16))
    if argumentCount() > 0 {
        let expected = readBytesFile(argument(0)); if expected.length != 512 { return 15 }
        let key = Bytes(); for byte in 0..16 { key.add(byte) }
        let hashed = dispatch.table(1, 1, key); let input = Bytes()
        for length in 0..64 {
            let value = dispatch.keyHash(hashed, input); let encoded = Bytes()
            for byte in 0..8 { encoded.add((value >> (byte * 8)) & 255) }
            if crypto.hex(encoded) != crypto.hex(expected.slice(length * 8, (length + 1) * 8)) { return 16 }
            input.add(length)
        }
    }
    for index in 0..128 { if !errors.booleanOk(dispatch.insert(table, identifier(index), index)) { return 1 } }
    if errors.booleanOk(dispatch.insert(table, identifier(128), 128)) { return 2 }
    for index in 0..128 { if dispatch.lookup(table, identifier(index)) != index { return 3 } }
    if errors.booleanOk(dispatch.insert(table, identifier(1), 999)) || dispatch.lookup(table, identifier(1)) != 1 { return 4 }
    for index in 0..128 { if !dispatch.remove(table, identifier(index)) || dispatch.lookup(table, identifier(index)) != -1 { return 5 } }
    for index in 128..1128 { if !errors.booleanOk(dispatch.insert(table, identifier(index), index)) || !dispatch.remove(table, identifier(index)) { return 6 } }
    if table.count != 0 || table.entries.length > 128 { return 7 }
    let aliased = identifier(1); dispatch.insert(table, aliased, 123); aliased[0] = 1
    if dispatch.lookup(table, identifier(1)) != 123 || dispatch.lookup(table, aliased) != -1 { return 14 }
    dispatch.remove(table, identifier(1))
    if errors.booleanOk(dispatch.insert(table, Bytes(21), 0)) || errors.booleanOk(dispatch.insert(table, Bytes(), 0)) { return 8 }
    let heap = dispatch.timers(64); let oracle: List<Integer> = []
    for index in 0..64 { oracle.add(-1) }
    let random = 12345
    for trial in 0..5000 {
        random = (random * 1103515245 + 12345) & 0x7fffffff
        let id = random % 64; let deadline = (random >> 6) % 10000
        if random % 5 == 0 { dispatch.cancel(heap, id); oracle[id] = -1 }
        else { if !errors.booleanOk(dispatch.schedule(heap, id, deadline)) { return 9 }; oracle[id] = deadline }
        let first = -1; let minimum = 10001
        for index in 0..64 { if oracle[index] >= 0 && (oracle[index] < minimum || (oracle[index] == minimum && index < first)) { first = index; minimum = oracle[index] } }
        if dispatch.nextDeadline(heap) != minimum && !(first < 0 && dispatch.nextDeadline(heap) == -1) { return 10 }
        if trial % 7 == 0 && first >= 0 {
            if dispatch.takeDue(heap, minimum - 1) != -1 || dispatch.takeDue(heap, minimum) != first { return 11 }
            oracle[first] = -1
        }
        if heap.count > 64 || heap.nodes.length != 64 { return 12 }
    }
    if errors.booleanOk(dispatch.schedule(heap, 64, 1)) || errors.booleanOk(dispatch.schedule(heap, 0, -1)) { return 13 }
    print("QUIC dispatch: CID collisions/capacity/removal/reuse and indexed timers vs 5,000 independent scan-oracle operations passed")
    return 0
}
