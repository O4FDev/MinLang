// The production virtio block driver, transport and PCI scanner against the
// injected library/arch.min and library/machine.min, which replace only the
// hardware. One seed: a few reads at World-chosen sectors and sizes, each
// checked against the disk image. Exit 3 means the driver returned bytes the
// device never wrote correctly; a driver stop (exit 1) is a fail-closed refusal.
use "../../os/shared/virtio/block.min" as block
use "../../os/shared/pci.min" as pci
use "./library/model.min" as model
use "process" as processInfo

function decimal(text: Text): Integer {
    let value = 0
    for byte in Bytes(text) {
        if byte < 48 || byte > 57 { fail("arguments are decimal numbers") }
        value = value * 10 + byte - 48
    }
    return value
}

function main(): Integer {
    if processInfo.argumentCount() != 3 { fail("usage: driver SEED FAULTS READS") }
    let seed = decimal(processInfo.argument(0))
    model.reset(seed, decimal(processInfo.argument(1)))
    let reads = decimal(processInfo.argument(2))
    let drive = block.open(pci.scan())
    if drive.sectors != model.CAPACITY { fail("oracle: disk capacity") }
    for read in 0..reads {
        let count = 1 + model.choose(128)
        let sector = model.choose(model.CAPACITY - count)
        let bytes = block.read(drive, sector, count)
        if bytes.length != count * 512 { fail("oracle: read length") }
        for index in 0..bytes.length {
            if bytes[index] != model.diskByte(sector + index / 512, index % 512) {
                print("WRONG DATA seed " + Text(seed) + " read " + Text(read) + " sector " + Text(sector) + " byte " + Text(index))
                print(model.faultLog())
                return 3
            }
        }
    }
    print("VIRTIO PASS seed " + Text(seed) + ": " + Text(reads) + " reads, " + Text(model.completedCount()) + " completions")
    print(model.faultLog())
    return 0
}
