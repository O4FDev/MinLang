// Only architecture-owned PCI config access is substituted. The production
// os/shared/pci.min still scans, enables the card and decodes its real BAR.
use "./model.min" as model

public constant ASSIGN_PCI = false
public constant PCI_PREFETCH_START = 0x20000000
public constant PCI_PREFETCH_END = 0x20004000
public constant PCI_MEMORY_START = 0x20000000
public constant PCI_MEMORY_END = 0x20004000

public record PciConfig { private cookie: Integer }

public function pciConfig(): PciConfig { return PciConfig { cookie: 1 } }

public function pciRead32(config: PciConfig, bus: Integer, slot: Integer, function: Integer, offset: Integer): Integer {
    if config.cookie != 1 { fail("model: invalid PCI configuration owner") }
    return model.pciRead(bus, slot, function, offset)
}

public function pciWrite32(config: PciConfig, bus: Integer, slot: Integer, function: Integer, offset: Integer, value: Integer) {
    if config.cookie != 1 { fail("model: invalid PCI configuration owner") }
    model.pciWrite(bus, slot, function, offset, value)
}
