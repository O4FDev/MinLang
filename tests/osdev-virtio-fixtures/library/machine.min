// Injection boundary for the real library/device.min and virtio drivers. No privileged operation
// or arbitrary host dereference is delegated to the native machine module.
use "./model.min" as model

public function address(bytes: Bytes): Integer { return model.address(bytes) }
public function fence() { model.fence() }
public function copy(destination: Integer, source: Integer, count: Integer) { model.copy(destination, source, count) }
public function fill8(address: Integer, count: Integer, value: Integer) { model.fill(address, count, value) }
public function fill32(address: Integer, count: Integer, value: Integer) {
    if count < 0 || count > 536870911 { fail("model: invalid fill32 count") }
    for index in 0..count { model.write(address + index * 4, 4, value) }
}

public function load8(address: Integer): Integer { return model.read(address, 1) }
public function load16(address: Integer): Integer { return model.read(address, 2) }
public function load32(address: Integer): Integer { return model.read(address, 4) }
public function load64(address: Integer): Integer { return model.read(address, 8) }
public function store8(address: Integer, value: Integer) { model.write(address, 1, value) }
public function store16(address: Integer, value: Integer) { model.write(address, 2, value) }
public function store32(address: Integer, value: Integer) { model.write(address, 4, value) }
public function store64(address: Integer, value: Integer) { model.write(address, 8, value) }

public function read8(address: Integer): Integer { return model.read(address, 1) }
public function read16(address: Integer): Integer { return model.read(address, 2) }
public function read32(address: Integer): Integer { return model.read(address, 4) }
public function read64(address: Integer): Integer { return model.read(address, 8) }
public function write8(address: Integer, value: Integer) { model.write(address, 1, value) }
public function write16(address: Integer, value: Integer) { model.write(address, 2, value) }
public function write32(address: Integer, value: Integer) { model.write(address, 4, value) }
public function write64(address: Integer, value: Integer) { model.write(address, 8, value) }

public function in8(port: Integer): Integer { fail("model: privileged port input is forbidden"); return 0 }
public function in16(port: Integer): Integer { fail("model: privileged port input is forbidden"); return 0 }
public function in32(port: Integer): Integer { fail("model: privileged port input is forbidden"); return 0 }
public function out8(port: Integer, value: Integer) { fail("model: privileged port output is forbidden") }
public function out16(port: Integer, value: Integer) { fail("model: privileged port output is forbidden") }
public function out32(port: Integer, value: Integer) { fail("model: privileged port output is forbidden") }
public function halt() { fail("model: halt is forbidden") }
// The driver polls with pause(); each one lets simulated device time pass.
public function pause() { model.pause() }
public function enableInterrupts() { fail("model: interrupt control is forbidden") }
public function disableInterrupts() { fail("model: interrupt control is forbidden") }
public function waitForInterrupt() { fail("model: blocking for an interrupt is forbidden") }
