use "process" as processInfo
use "../tools/mutation-campaign.min" as campaign
use "../tools/testing.min" as test
use "../tools/test-toolchain.min" as toolchain
use "text" as text
use "errors" as errors
use "system" as system
use "files" as files
function integer(value: Text): Integer {
    let parsed = text.parseInteger(value)
    test.check(errors.integerOk(parsed), "invalid integer option")
    return errors.integerValue(parsed)
}
function absolute(root: Text, path: Text): Text {
    if Bytes(path).length > 0 && Bytes(path)[0] == 47 { return path }
    return root + "/" + path
}
if processInfo.argumentCount() > 0 && processInfo.argument(0) == "--worker" {
    test.check(processInfo.argumentCount() == 3, "expected worker configuration and index")
    campaign.publish(campaign.read(processInfo.argument(1)), integer(processInfo.argument(2)))
    exit(0)
}
let scratch = test.scratch()
let root = toolchain.absolute(".", scratch)
let source = root + "/build/compiler.min"
let baseline = root + "/build/minyarc"
let minimum = campaign.number(test.setting("MINYAR_MIN_MUTATION_SCORE", "85"))
let limit = integer(test.setting("MINYAR_MUTATION_LIMIT", "16"))
let index = 0
while index < processInfo.argumentCount() {
    test.check(index + 1 < processInfo.argumentCount(), "mutation option needs a value")
    let option = processInfo.argument(index)
    let value = processInfo.argument(index + 1)
    if option == "--limit" { limit = integer(value) }
    else if option == "--minimum-score" { minimum = campaign.number(value) }
    else if option == "--baseline-compiler" { baseline = absolute(root, value) }
    else if option == "--source" { source = absolute(root, value) }
    else { fail("unknown mutation option: " + option) }
    index += 2
}
test.check(limit >= 1, "mutation limit must be positive")
test.check(files.makeDirectory(root + "/build/mutation") == 0, "cannot create campaign directory")
let work = root + "/build/mutation/minyar-tests-" + Text(system.processId()) + "-" + Text(system.monotonicNanoseconds())
let clang = toolchain.pinned(test.setting("MINYAR_TEST_CLANG", "clang-23"), "clang", system.environment(), root, scratch)
let cxx = toolchain.pinned(test.setting("LLVM_CXX", "clang++-23"), "clang", system.environment(), root, scratch)
let linker = toolchain.pinned(test.setting("MINYAR_TEST_LINKER", "ld.lld-23"), "lld", system.environment(), root, scratch)
let cache = root + "/build/mutation/compiler-cache"
test.check(files.makeDirectory(cache) == 0, "cannot create exact mutation compiler cache")
let prefix = toolchain.wrap(root, scratch + "/wrappers", clang, cxx, linker, cache, scratch)
let config = campaign.Campaign { root: root; source: source; baseline: baseline; seed: root + "/build/stage0"; compilerRuntime: root + "/build/minyar-compiler-runtime.ll"; runtime: root + "/build/minyar-runtime.o"; clang: prefix + "/clang"; minimum: minimum; limit: limit; jobs: integer(test.setting("MINYAR_TEST_JOBS", "2")); timeout: 45; checks: campaign.checks(root); work: work; workerExecutable: root + "/build/tooling/tests/mutation-score" }
test.removeTree(scratch)
if !campaign.run(config) { exit(1) }
