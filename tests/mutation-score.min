use "../tools/mutation-campaign.min" as campaign
use "../tools/testing.min" as test
use "../tools/test-toolchain.min" as toolchain
use "text" as text
use "errors" as errors
use "system" as system
use "files" as files
function integer(value: Text): Integer {
    let parsed = text.parseInteger(value)
    test.check(errors.integerOk(parsed), "invalid integer option")
    return errors.integerValue(parsed)
}
function absolute(root: Text, path: Text): Text {
    if Bytes(path).length > 0 && Bytes(path)[0] == 47 { return path }
    return root + "/" + path
}
let scratch = test.scratch()
let root = toolchain.absolute(".", scratch)
let source = root + "/build/compiler.min"
let baseline = root + "/build/minyarc"
let minimum = campaign.number(test.setting("MINYAR_MIN_MUTATION_SCORE", "85"))
let limit = integer(test.setting("MINYAR_MUTATION_LIMIT", "16"))
let index = 0
while index < argumentCount() {
    test.check(index + 1 < argumentCount(), "mutation option needs a value")
    let option = argument(index)
    let value = argument(index + 1)
    if option == "--limit" { limit = integer(value) }
    else if option == "--minimum-score" { minimum = campaign.number(value) }
    else if option == "--baseline-compiler" { baseline = absolute(root, value) }
    else if option == "--source" { source = absolute(root, value) }
    else { fail("unknown mutation option: " + option) }
    index += 2
}
test.check(limit >= 1, "mutation limit must be positive")
test.check(files.makeDirectory(root + "/build/mutation") == 0, "cannot create campaign directory")
let work = root + "/build/mutation/minyar-tests-" + Text(system.processId()) + "-" + Text(system.monotonicNanoseconds())
let config = campaign.Campaign { root: root; source: source; baseline: baseline; seed: root + "/build/stage0"; compilerRuntime: root + "/build/minyar-compiler-runtime.ll"; runtime: root + "/build/minyar-runtime.o"; clang: test.setting("MINYAR_TEST_CLANG", "clang"); minimum: minimum; limit: limit; jobs: 1; timeout: 45; checks: campaign.checks(root); work: work }
test.removeTree(scratch)
if !campaign.run(config) { exit(1) }
