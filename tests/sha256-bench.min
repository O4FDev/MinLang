use "sha256" as sha
use "sha256test" as clock
use "machine" as machine

function number(text: Text): Integer {
    let out = 0
    for c in text {
        if c < '0' || c > '9' { fail("invalid benchmark number") }
        out = out * 10 + Integer(c) - Integer('0')
    }
    return out
}
let length = number(argument(0))
let iterations = number(argument(1))
let mode = argument(2)
if length < 0 || iterations < 1 { fail("invalid benchmark parameters") }
let data = Bytes(length)
for index in 0..length { data[index] = (index * 31 + 17) & 255 }
let address = machine.address(data)
let sum = 0
let start = clock.nanos()
for iteration in 0..iterations {
    if mode == "oneshot" {
        let out = sha.digestAddress(address, length)
        sum += out[0]
    } else {
        let state = sha.new()
        let prefix = length / 2
        if !sha.updateAddress(state, address, prefix) { fail("benchmark prefix") }
        let snapshot = sha.finalize(state)
        sum += snapshot[0]
        let branch = sha.clone(state)
        let offset = prefix
        while offset < length {
            let chunk = length - offset
            if chunk > 65536 { chunk = 65536 }
            if !sha.updateAddress(state, address + offset, chunk) { fail("benchmark suffix") }
            if !sha.updateAddress(branch, address + offset, chunk) { fail("benchmark branch") }
            offset += chunk
        }
        let out = sha.finalize(state)
        let fork = sha.finalize(branch)
        sum += out[0] + fork[0]
    }
}
let elapsed = clock.nanos() - start
print(Text(elapsed) + " " + Text(sum))
