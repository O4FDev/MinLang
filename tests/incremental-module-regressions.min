use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "./thread-port-support.min" as support
use "system" as system
use "files" as files

let sanitize = false
for index in 0..processInfo.argumentCount() {
    test.check(processInfo.argument(index) == "--sanitize", "unknown option: " + processInfo.argument(index))
    sanitize = true
}
let suffix = ""
if sanitize { suffix = "-sanitize" }
let work = test.scratch()
let root = test.lines(test.run(["pwd", "-P"], system.environment(), "", work + "/.root", 10).output)[0]
let driver = root + "/build/minyar-module-build" + suffix
let compiler = root + "/build/minyarc-modules" + suffix
let command = "'" + driver + "' '" + compiler + "' \"$entry_path\" \"$output_path\" '" + work + "/cache' \"$@\""
io.writeTextFile(work + "/compiler", "#!/bin/sh\nset -eu\nentry_path=$1\noutput_path=$2\nshift 2\n" + command + "\n" + command + "\n")
test.require(test.run(["chmod", "755", work + "/compiler"], system.environment(), "", work + "/.chmod", 10), "make compiler wrapper executable")
let environment = support.environment(system.environment(), ["MINYAR_TEST_COMPILER"], [work + "/compiler"])
if sanitize { environment = support.environment(environment, ["ASAN_OPTIONS", "MINYAR_TEST_RUNTIME", "MINYAR_TEST_LINK_FLAGS"], ["detect_leaks=0", root + "/build/ownership-runtime.o", "-fsanitize=address,undefined"]) }
for suite in ["regressions", "ownership", "recursive-data"] {
    if sanitize {
        let runtime = "ownership-runtime.o"
        if suite == "regressions" { runtime = "minyar-runtime-sanitize.o" }
        environment = support.environment(environment, ["MINYAR_TEST_RUNTIME"], [root + "/build/" + runtime])
    }
    let result = test.run([root + "/build/tooling/tests/" + suite], environment, "", work + "/" + suite, 3600)
    files.writeStandardOutput(result.output)
    test.check(result.status == 0, suite + " failed through cached module output (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
}
test.removeTree(work)
