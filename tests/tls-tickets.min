use "tlstickets" as tickets
use "crypto" as crypto

function main(): Integer {
    let psk = crypto.fromHex("4ecd0eb6ec3b4d87f5d6028f922ca4c5851a277fd41311c9e62d2c9492e1c4f3")
    let hash = crypto.fromHex("63224b2e4573f2d3454ca84b9d009a04f6be9e05711a8396473aefa01e924a14")
    if crypto.hex(tickets.binder(psk, hash)) != "3add4fb2d8fdf822a0ca3cf7678ef5e88dae990141c5924d57bb6fa31b9e5f9d" { return 1 }
    let store = tickets.store(randomBytes(16), 3600)
    let identity = crypto.sha256(Bytes("test identity"))
    let issued = tickets.issue(store, psk, 0x1301, "minyar-test", "localhost", identity, Bytes("test client chain"), 100000, 4096)
    if !issued.valid { return 2 }
    let opened = tickets.open(store, issued.ticket, "minyar-test", "localhost", identity, 100001)
    if !opened.valid || crypto.hex(opened.psk) != crypto.hex(psk) || opened.earlyLimit != 4096 { return 3 }
    if tickets.open(store, issued.ticket, "wrong protocol", "localhost", identity, 100001).valid ||
       tickets.open(store, issued.ticket, "minyar-test", "wrong host", identity, 100001).valid ||
       tickets.open(store, issued.ticket, "minyar-test", "localhost", crypto.sha256(Bytes("wrong identity")), 100001).valid ||
       tickets.open(store, issued.ticket, "minyar-test", "localhost", identity, 3700000).valid { return 4 }
    for at in 0..issued.ticket.length {
        let bad = issued.ticket.slice(0, issued.ticket.length); bad[at] = bad[at] ^ 1
        if tickets.open(store, bad, "minyar-test", "localhost", identity, 100001).valid { return 5 }
    }
    for length in 0..issued.ticket.length { if tickets.open(store, issued.ticket.slice(0, length), "minyar-test", "localhost", identity, 100001).valid { return 6 } }
    if !tickets.claimEarly(store, issued.ticket, opened.expires, 100001) || tickets.claimEarly(store, issued.ticket, opened.expires, 100001) { return 7 }
    if store.seen.length != 1 { return 8 }
    print("TLS tickets: RFC8448 binder, AEAD identity/host/ALPN/expiry binding, all tamper/prefixes and single-use early-data replay rejection passed")
    return 0
}
