use "tls" as tls
use "tlsserver" as server
use "tlstickets" as tickets

function exchange(c: tls.Session, s: server.Session) {
    server.receiveHandshake(s, tls.takeOutgoing(c), 0)
    tls.receiveHandshake(c, server.takeInitial(s), 0)
    tls.receiveHandshake(c, server.takeHandshake(s), 1)
    server.receiveHandshake(s, tls.takeOutgoing(c), 1)
    tls.receiveHandshake(c, server.takeApplication(s), 2)
}
function main(): Integer {
    let root = readBytesFile(argument(0)); let identity = readBytesFile(argument(1)); let key = readBytesFile(argument(2))
    let client = readBytesFile(argument(3)); let clientKey = readBytesFile(argument(4))
    let store = tickets.store(randomBytes(16), 3600)
    let c = tls.quicClient("localhost", randomBytes(64), "minyar-test", Bytes(), [root], [client], clientKey)
    let s = server.quicServerWithTickets(randomBytes(64), "minyar-test", Bytes(), [identity], key, [root], true, store)
    exchange(c, s)
    if c.state != tls.ESTABLISHED || s.state != server.ESTABLISHED || !s.authenticated { return 1 }
    let ticket = tls.takeTicket(c)
    if !ticket.valid { return 2 }
    let resumed = tls.quicClientResumed("localhost", randomBytes(64), "minyar-test", Bytes(), [root], [client], clientKey, ticket)
    let accepted = server.quicServerWithTickets(randomBytes(64), "minyar-test", Bytes(), [identity], key, [root], true, store)
    exchange(resumed, accepted)
    if resumed.state != tls.ESTABLISHED || accepted.state != server.ESTABLISHED || !resumed.resumed || !accepted.resumed || !accepted.authenticated { print(resumed.error); print(accepted.error); return 3 }
    if accepted.peerCertificate.length == 0 { return 4 }
    // Current device trust policy must still apply to a sealed old identity.
    // The disposable CA is absent from the OS roots of this new server.
    let changed=tls.quicClientResumed("localhost",randomBytes(64),"minyar-test",Bytes(),[root],[client],clientKey,ticket)
    let changedServer=server.quicServerWithTickets(randomBytes(64),"minyar-test",Bytes(),[identity],key,[],true,store)
    exchange(changed,changedServer)
    if changedServer.resumed || changedServer.authenticated || changedServer.state != server.FAILED || changedServer.peerCertificate.length != 0 { return 7 }
    // A valid ticket with a forged binder is a fatal authentication failure.
    let bad = tls.quicClientResumed("localhost", randomBytes(64), "minyar-test", Bytes(), [root], [client], clientKey, ticket)
    let hello = tls.takeOutgoing(bad); hello[hello.length - 1] = hello[hello.length - 1] ^ 1
    let rejected = server.quicServerWithTickets(randomBytes(64), "minyar-test", Bytes(), [identity], key, [root], true, store)
    server.receiveHandshake(rejected, hello, 0)
    if rejected.state != server.FAILED { return 5 }
    // Expired client tickets fall back to a full authenticated handshake.
    ticket.expires = 1
    let expired = tls.quicClientResumed("localhost", randomBytes(64), "minyar-test", Bytes(), [root], [client], clientKey, ticket)
    let fresh = server.quicServerWithTickets(randomBytes(64), "minyar-test", Bytes(), [identity], key, [root], true, store)
    exchange(expired, fresh)
    if expired.state != tls.ESTABLISHED || fresh.state != server.ESTABLISHED || expired.resumed || fresh.resumed { return 6 }
    print("TLS resumption: PSK-DHE authenticated mTLS identity, tickets, forged binders and expiry fallback passed")
    return 0
}
