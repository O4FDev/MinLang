// Parallel functions borrow Bytes and List views; a loop reads Bytes segments
// from a List<Bytes>, uses typed getters and passes whole buffers.
parallel function word(arena: Bytes, w: Integer): Integer { return arena.getInt64(w * 8) }

parallel function ones(x: Integer): Integer {
    let n = 0
    for bit in 0..64 { n += (x >> bit) & 1 }
    return n
}

parallel function countAnd(a: Bytes, b: Bytes, weights: List<Integer>): Integer {
    let total = 0
    for w in 0..a.length / 8 { total += ones(word(a, w) & word(b, w)) * weights[0] }
    return total
}

let segments: List<Bytes> = []
for c in 0..300 {
    let b = Bytes(64)
    for i in 0..64 { b[i] = (i * 7 + c) % 256 }
    segments.add(b)
}
let other = Bytes(64)
for i in 0..64 { other[i] = 255 - i }
let weights = [2]
let counts: List<Integer> = []
let scores: List<Float> = []
for c in 0..segments.length { counts.add(0); scores.add(0.0) }
parallel for c in 0..counts.length {
    counts[c] = countAnd(segments[c], other, weights) + segments[c][1] + segments[c].getInt32(4)
    scores[c] = Float(other.getUInt16(c % 32 * 2)) * 0.5
}
let serial = 0
let total = 0
let score = 0.0
for c in 0..segments.length {
    serial += countAnd(segments[c], other, weights) + segments[c][1] + segments[c].getInt32(4)
    total += counts[c]
    score += scores[c]
}
print(total)
print(total == serial)
print(score)
print(countAnd(other, other, weights))
print(countAnd(Bytes(16), other, [3]))
