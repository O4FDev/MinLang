use "machine" as machine
use "pixels" as pixelOps
use "../../os/shared/interrupts.min" as interrupts
use "../../os/kernel/system/processors.min" as processors
use "../../os/shared/graphics/glow.min" as glow

parallel function shade(index: Integer): Integer {
    let value = index % 251
    for pass in 0..1000 { value = (value * 73 + 19) % 251 }
    return value
}

function main(): Integer {
    let timer = interrupts.start()
    let cores = processors.start(timer)
    let pixels: List<Integer> = []
    for index in 0..5003 { pixels.add(0) }
    parallel for index in 0..pixels.length { pixels[index] = shade(index) }
    let total = 0
    parallel for index in 0..pixels.length reduce total { total += pixels[index] }
    let area = 0.0
    parallel for index in 0..pixels.length reduce area { area += Float(pixels[index]) }
    if total != 623386 || area != Float(total) { fail("parallel boot checksum differs") }
    let frame = Bytes(41 * 17 * 4)
    for index in 0..frame.length { frame[index] = index * 19 % 256 }
    pixelOps.blendBytes(frame, 0x4691F7, 147)
    let mask = Bytes(41 * 17)
    for index in 0..mask.length { mask[index] = index * 73 % 256 }
    pixelOps.maskBytes(frame, mask, 0xF7AC46, 199, 19, 236)
    let table = Bytes()
    for value in [107, 83, 39, 7, 7, 39, 83, 107] { table.add(value) }
    glow.draw(frame, 41, 17, 41 * 4, 1, 1, 40, 16, table, 0x4691F7, 147)
    let ink = 0
    parallel for index in 0..frame.length reduce ink { ink += frame[index] }
    if ink != 315453 { fail("parallel pixel checksum differs: " + Text(ink)) }
    print("SAFE PIXELS OK " + Text(ink))
    print("SAFE PARALLEL OK " + Text(total) + " on " + Text(cores.count) + " processors")
    machine.disableInterrupts()
    while true { machine.halt() }
}
