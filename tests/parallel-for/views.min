record Window native "c_packed" { data: Bytes[5003] }
let backing = Bytes(15009)
let first = cBytes(cView(Window, backing, 0))
let adjacent = cBytes(cView(Window, backing, 5003))
let again = cBytes(cView(Window, backing, 0))
parallel for index in 0..5003 {
    first[index] = index % 251
    again[index] = first[index]
    adjacent[index] = (index + 17) % 251
}
// Arbitrary indexed reads of an adjacent view share an owner, not bytes.
parallel for index in 0..5003 { first[index] = adjacent[5002 - index] }
let total = 0
parallel for index in 0..5003 reduce total { total += first[index] }
print(total)
let shifted = cBytes(cView(Window, backing, 1))
parallel for index in 3..1 { first[index] = shifted[index] }
print(first[5002])
