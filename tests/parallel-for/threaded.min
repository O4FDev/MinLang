function shade(output: List<Integer>, source: List<Integer>, scale: Float, bias: Integer, enabled: Boolean, letter: Character) {
    parallel for index in 0..output.length {
        let value = Integer(Float(source[index]) * scale) + bias + Integer(letter)
        if enabled { output[index] = value }
        else { output[index] = 0 }
    }
}
let source: List<Integer> = []
let output: List<Integer> = []
for index in 0..5003 { source.add(index); output.add(0) }
for round in 0..40 { shade(output, source, 2.0, 3, true, 'A') }
let total = 0
for index in 0..5003 {
    let expected = index * 2 + 68
    if output[index] != expected { fail("a parallel pixel was lost or written twice") }
    total += output[index]
}
print(total)
shade(output, output, 1.0, -1, true, Character(0))
for index in 0..5003 {
    if output[index] != index * 2 + 67 { fail("same-slot aliases changed meaning") }
}
print(output[5002])
// An environment inside an outer loop must reuse fixed stack storage.
let last = [0]
for round in 0..20000 {
    parallel for index in 0..1 { last[index] = round }
}
print(last[0])
