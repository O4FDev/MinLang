// A `parallel for` iteration creates its own Text, records and Lists on the
// worker's ownership domain and releases them before the iteration ends; only
// scalars leave through the loop's slots. The long loop crosses many chunks, so
// every worker enters and drains its frame repeatedly.
record Pair { key: Text; value: Integer }
record Row { label: Text; first: Integer; count: Integer }

let values = [3, 4, 5, 6]
let lengths = [0, 0, 0, 0]
let firsts = [0, 0, 0, 0]
let totals = [0, 0, 0, 0]
parallel for index in 0..values.length {
    let label = Text(values[index]) + "!"
    let pair = Pair { key: label; value: values[index] }
    let seen: List<Integer> = []
    for step in 0..values[index] { seen.add(step * index) }
    let row = Row { label: pair.key; first: seen[0]; count: seen.length }
    let parts: List<Text> = [row.label, Text(row.count)]
    let joined = joinText(parts)
    lengths[index] = row.label.length
    firsts[index] = row.first + row.count
    totals[index] = joined.length + row.count
}
print(lengths[3])
print(firsts[2])
print(totals[0])

// Thousands of iterations, each allocating and dropping its own values: the
// loop crosses many chunks, so every worker enters and drains a frame again.
let count = 600
let sizes: List<Integer> = []
let stamps: List<Integer> = []
for slot in 0..count { sizes.add(0); stamps.add(0) }
parallel for index in 0..count {
    let words: List<Text> = []
    for step in 0..((index % 5) + 1) { words.add(Text(index * step)) }
    let row = Row { label: joinText(words, ","); first: words.length; count: index }
    sizes[index] = row.label.length % 97
    stamps[index] = row.first * 2 + row.count % 7
}
let sums = 0
let stampSum = 0
for index in 0..count { sums += sizes[index]; stampSum += stamps[index] }
print(sums)
print(stampSum)
