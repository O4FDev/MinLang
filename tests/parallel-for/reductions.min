let total = 5
parallel for index in 0..5003 reduce total { total += index }
print(total)
let area = 0.0
parallel for index in 0..5003 reduce area { area += Float(index) / 2.0 }
print(area)
let balance = 42
parallel for index in -1000..1001 reduce balance { balance += index }
print(balance)
parallel for index in 5..2 reduce balance { balance += index }
print(balance)
let first = 1
parallel for index in -9223372036854775808..-9223372036854775807 reduce first { first += index }
print(first)
let last = 0
parallel for index in 9223372036854775806..9223372036854775807 reduce last { last += index }
print(last)
let samples: List<Float> = []
for index in 0..130 { samples.add(0.0) }
samples[0] = 10000000000000000.0
samples[127] = 1.0
samples[128] = -10000000000000000.0
samples[129] = 1.0
let grouped = 0.0
parallel for index in 0..samples.length reduce grouped { grouped += samples[index] }
print(grouped)
let quiet = -0.0
parallel for index in 2..2 reduce quiet { quiet += Float(index) }
print(quiet)
function add(values: List<Integer>, initial: Integer): Integer {
    parallel for index in 0..values.length reduce initial { initial += values[index] }
    return initial
}
print(add([20, 22], 1))
let reduce = 42
parallel for index in 0..4 reduce reduce { reduce += index }
print(reduce)
