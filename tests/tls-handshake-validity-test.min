use "./net-fixtures.min" as fixtures
use "../tools/testing.min" as test

let modes = ["control", "server-resumed-hello", "server-resumed-finished", "server-full-finished", "client-resumed-finished", "client-full-finished"]
fixtures.arguments(["--sanitize"], ["--mode"])
let selected = fixtures.option("--mode", "")
if selected != "" {
    let known = false
    for mode in modes { if mode == selected { known = true } }
    test.check(known, "invalid mode: " + selected)
}
let context = fixtures.context(fixtures.flag("--sanitize"))
let binary = context.work + "/validity"
fixtures.compileProgram(context, "tests/tls-handshake-validity.min", binary)
let failures: List<Text> = []
for mode in modes {
    if selected != "" && selected != mode { continue }
    let ca = fixtures.authority(context, context.work + "/" + mode)
    fixtures.root(ca, "root")
    let expires = fixtures.nowSeconds() + 6
    for name in ["server", "client"] {
        let options = fixtures.ec(name + "Auth")
        if fixtures.starts(mode, name) { options.start = expires - 3600; options.end = expires }
        fixtures.leaf(ca, name, "root", options)
    }
    let result = fixtures.run(context, [binary, fixtures.path(ca, "root", "der"), fixtures.path(ca, "server", "der"), fixtures.path(ca, "server", "pk8"),
        fixtures.path(ca, "client", "der"), fixtures.path(ca, "client", "pk8"), mode, Text(expires * 1000)], 16)
    print(mode + " " + Text(result.status) + " " + result.output + " " + result.errorOutput)
    if result.status != 0 { failures.add(mode) }
}
test.check(failures.length == 0, "handshake validity failures: " + joinText(failures))
fixtures.finish(context)
