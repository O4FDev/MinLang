use "io" as io
use "../tools/testing.min" as test
use "system" as system

let compiler = test.compiler()
let core = io.readTextFile(test.setting("MINYAR_TEST_SOURCE", "build/compiler.min"))
let main = core.find("\nfunction main(")
test.check(main >= 0, "compiler source entry point changed")
let probe = core.slice(0, main) + "\n" + io.readTextFile("tests/module-declaration-index-probe.min")
test.require(test.compile(compiler, probe), "compile selected module declaration index")
let llvm = compiler.directory + "/case" + Text(compiler.serial) + ".ll"
for optimization in ["-O0", "-O2"] {
    let executable = compiler.directory + "/module-declaration-index"
    let command = [compiler.clang, optimization]
    for flag in compiler.flags { command.add(flag) }
    for item in ["-Wno-override-module", llvm, compiler.runtime, "-lm", "-o", executable] { command.add(item) }
    test.require(test.run(command, system.environment(), "", compiler.directory + "/link", 120), "link module declaration index " + optimization)
    let run = test.run([executable], system.environment(), "", compiler.directory + "/run", 30)
    test.require(run, "execute module declaration index " + optimization)
    test.check(run.output == "module declaration index verified\n" && run.errorOutput == "", "module declaration index oracle")
    for mode in ["zero-kind", "wide-kind", "overflow-owner"] {
        let rejected = test.run([executable, mode], system.environment(), "", compiler.directory + "/reject", 30)
        test.check(rejected.status != 0 && test.contains(rejected.errorOutput + rejected.output, "invalid compiled module type table"), "invalid module declaration metadata rejected: " + mode)
    }
}
test.removeTree(compiler.directory)
print("Module declarations: empty, missing, duplicate, owner, kind, main, Unicode, collisions and table reload passed at O0/O2")
