use "process" as processInfo
use "../tools/testing.min" as test
use "system" as system

function setting(environment: List<Text>, name: Text, value: Text): List<Text> {
    let result: List<Text> = []
    let prefix = name + "="
    for entry in environment {
        let raw = Bytes(entry)
        if raw.length < prefix.byteLength || Text(raw.slice(0, prefix.byteLength)) != prefix { result.add(entry) }
    }
    result.add(prefix + value)
    return result
}

let sanitize = false
test.check(processInfo.argumentCount() <= 1, "unexpected nonblocking connect option")
if processInfo.argumentCount() == 1 {
    test.check(processInfo.argument(0) == "--sanitize", "unknown nonblocking connect option")
    sanitize = true
}
let environment = system.environment()
if sanitize {
    for name in ["MINYAR_CLANG_FLAGS", "MINYAR_NATIVE_FLAGS", "MINYAR_RUNTIME_FLAGS"] {
        environment = setting(environment, name, "-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer -Wno-override-module")
    }
    environment = setting(environment, "ASAN_OPTIONS", "detect_leaks=1")
    environment = setting(environment, "UBSAN_OPTIONS", "halt_on_error=1")
}
let work = test.scratch()
for mode in ["--debug", "--release"] {
    let output = work + "/connect"
    test.require(test.run(["./minyar", mode, "tests/net-connect.min", "-o", output], environment, "", work + "/build" + mode, 120), "nonblocking connect launcher compile")
    let result = test.run([output], environment, "", work + "/run" + mode, 10)
    test.check(result.status == 0 && result.output == "nonblocking connect and recoverable refusal verified\n", "nonblocking connect execution failed\n" + result.output + result.errorOutput)
}
test.removeTree(work)
print("Nonblocking connect API: numeric addresses, refusal, real I/O and EOF passed")
