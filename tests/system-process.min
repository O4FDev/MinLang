use "system" as system
function check(condition: Boolean, what: Text) { if !condition { fail("system process: " + what) } }
let path = argument(0)
let cwd = argument(1)
let child = system.spawn(path, ["custom name", "child-arguments", "", "with space", "quote\"slash\\", "trail\\", "λ☃", ";$HOME*"],
    ["EXPLICIT=λ=☃", "EMPTY="], "")
check(child > 0 && system.childProcessId(child) > 0, "spawn and PID")
let status = system.wait(child)
check(status.error == 0 && status.state == system.EXITED && status.exitCode == 0, "wait")
check(system.poll(child).error < 0, "consumed handle")
let changed = system.spawn(path, ["custom name", "child-cwd", cwd], [], cwd)
check(changed > 0 && system.wait(changed).exitCode == 0, "child cwd")
let empty = system.spawn(path, ["custom name", "child-empty"], [], "")
check(empty > 0 && system.wait(empty).exitCode == 0, "explicit empty environment")
check(system.spawn(path, [], [], "") == -22, "empty argv")
let nul = Text(Bytes(1))
check(system.spawn(path + nul, ["child"], [], "") == -22, "NUL executable")
check(system.spawn(path, ["child", nul], [], "") == -22, "NUL argv")
check(system.spawn(path, ["child"], ["KEY=x" + nul], "") == -22, "NUL envp")
check(system.spawnWithCredentials(path, ["child"], [], "", -2, -1, []) == -22, "invalid uid")
check(system.spawn("/minyar/no-such-executable", ["child"], [], "") == -2, "synchronous ENOENT")
let slow = system.spawn(path, ["custom name", "child-sleep"], [], "")
check(slow > 0 && system.poll(slow).state == system.PENDING, "poll")
check(system.wait(slow).exitCode == 37, "wait after poll")
print("system process language: passed")
