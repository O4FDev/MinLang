use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "../tools/check-runner.min" as runner
use "system" as system
use "files" as files
let work = test.scratch()
let driver = processInfo.argument(0)
let cacheTool = processInfo.argument(1)
let compiler = processInfo.argument(2)
let linker = processInfo.argument(3)
let real = work + "/compiler"
io.writeTextFile(real, "#!/bin/sh\nrecord=1\nfor arg in \"$@\"; do case \"$arg\" in -E|-print-runtime-dir) record=0;; esac; done\nif [ \"$record\" = 1 ]; then printf 'compile\\n' >> '" + work + "/calls'; printf '%s\\n' \"$@\" > '" + work + "/flags'; fi\nexec '" + compiler + "' \"$@\"\n")
test.require(test.run(["/bin/chmod", "+x", real], system.environment(), "", work + "/chmod", 10), "compiler fixture permissions")
io.writeTextFile(work + "/program.c", "#include <stdio.h>\nint main(void) { printf(\"native fixture\\n\"); return 0; }\n")
let command = [driver, cacheTool, work + "/cache", real, linker, "-O2", work + "/program.c", "-o", work + "/program"]
test.require(test.run(command, system.environment(), "", work + "/native", 30), "native C fixture compile")
test.check(!test.contains(io.readTextFile(work + "/flags"), "-flto") && !test.contains(io.readTextFile(work + "/flags"), "-disable-llvm-passes"), "native C retains the original optimization pipeline")
test.require(test.run(["/bin/cp", work + "/program", work + "/original"], system.environment(), "", work + "/copy", 10), "retain original executable")
test.check(files.remove(work + "/program") == 0, "remove private output before cache hit")
test.require(test.run(command, system.environment(), "", work + "/cached", 30), "runner uses exact whole C artifact cache")
test.check(io.readTextFile(work + "/calls") == "compile\n", "runner compiles the complete C fixture once")
test.require(test.run(["/usr/bin/cmp", "-s", work + "/program", work + "/original"], system.environment(), "", work + "/identity", 10), "runner reuses identical executable bytes")
let result = test.run([work + "/program"], system.environment(), "", work + "/run", 10)
test.require(result, "native C fixture execution")
test.check(result.output == "native fixture\n" && result.errorOutput == "", "native C output preserved")
let budget = runner.environment(system.environment(), "MINYAR_CHECK_LABEL", "check-budget")
test.require(test.run(command, budget, "", work + "/budget", 30), "budget fixture compile")
test.check(!test.contains(io.readTextFile(work + "/flags"), "-disable-llvm-passes"), "budget compile retains original pipeline")
test.check(test.lines(io.readTextFile(work + "/calls")).length == 2, "runner budget bypass performs the compiler work")
let sources = [
    "#include <stdlib.h>\n__attribute__((noinline)) int bad(void) { volatile int *p=malloc(sizeof(int)); if(!p) abort(); *p=7; free((void*)p); return *p; }\nint main(void) { return bad(); }\n",
    "__attribute__((noinline)) volatile int *bad(void) { volatile int value=7; return &value; }\nint main(void) { return *bad(); }\n",
    "char bytes[8]; __attribute__((noinline)) int bad(char *p) { volatile int index=8; return p[index]; } int main(void) { return bad(bytes); }\n",
    "#include <limits.h>\nint main(void) { volatile int value=INT_MAX; return value+1; }\n"
]
let expected = ["heap-use-after-free", "stack-use-after-return", "global-buffer-overflow", "signed integer overflow"]
let environment = runner.environment(system.environment(), "ASAN_OPTIONS", "detect_leaks=0:abort_on_error=0:detect_stack_use_after_return=1")
environment = runner.environment(environment, "UBSAN_OPTIONS", "halt_on_error=1:print_stacktrace=1")
for index in 0..sources.length {
    let path = work + "/bad" + Text(index)
    io.writeTextFile(path + ".c", sources[index])
    let sanitized = [driver, cacheTool, work + "/cache", real, linker, "-O1", "-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-Wno-return-stack-address", path + ".c", "-o", path]
    test.require(test.run(sanitized, system.environment(), "", path + ".compile", 30), "sanitizer negative fixture compile")
    test.check(!test.contains(io.readTextFile(work + "/flags"), "-disable-llvm-passes"), "sanitizer compile retains instrumentation pipeline")
    let failure = test.run([path], environment, "", path + ".run", 10)
    test.check(failure.status != 0 && test.contains(failure.errorOutput, expected[index]), "real sanitizer detects negative fixture: " + expected[index] + "\n" + failure.errorOutput)
}
test.removeTree(work)
print("native Clang controls: passed")
