// The Python socket peer owns framing; this probe exercises the public client.
use "http" as http
use "io" as io
use "process" as processInfo

let response = http.requestBoundedWithin(processInfo.argument(0), processInfo.argument(1), [], "", Integer(processInfo.argument(2)), Integer(processInfo.argument(3)))
io.writeBytesFile(processInfo.argument(4), response.body)
print(response.status)
print(response.error)
for header in response.headers { print(header) }
