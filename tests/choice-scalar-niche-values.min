// Signatures intentionally precede both wrapper and payload declarations.
function forwardIdentity(value: Forward): Forward { return value }
function forwardApply(work: (Forward) -> Forward, value: Forward): Forward { return work(value) }
choice Forward { Present(value: Phase); Absent }
choice ReverseEnum { Empty; Present(value: Phase) }
choice Phase { Low; Middle; High }
choice Flag<Item> { Raised; Lowered }
choice PresentBool { Value(value: Boolean); Absent }
choice EmptyBool { Missing; Value(value: Boolean) }
choice ReverseChar { Empty; Value(value: Character) }
choice Lone { Only(value: Boolean) }
choice Recursive { End; Next(value: Recursive) }
choice Unit { Only }
choice UnitFirst { Present(value: Unit); Empty }
choice UnitLast { Empty; Present(value: Unit) }
choice Three { Value(flag: Boolean); Missing; Deferred }
choice Two { Left(flag: Boolean); Right(flag: Boolean) }
function threeIdentity(value: Three): Three { return value }
function twoIdentity(value: Two): Two { return value }
type PhaseAlias = Phase
record Reading { value: Maybe<Phase> }
record Snapshot { reading: Reading; flag: Maybe<Boolean> }
record Header native "c" { flag: Maybe<Boolean>; letter: Maybe<Character>; phase: Maybe<Phase> }
global SELECTED: Maybe<Boolean> = Some(true)
function identity<Item>(value: Item): Item { return value }
function wrap<Item>(value: Item): Maybe<Item> { return Some(value) }
function boolCode(value: Maybe<Boolean>): Integer { return match value { Some(flag) { ifFlag(flag) } None { 2 } } }
function ifFlag(value: Boolean): Integer { if value { return 1 }; return 0 }
function phaseCode(value: Maybe<Phase>): Integer { return match value { Some(phase) { phase.code() } None { 3 } } }
function Phase.code(): Integer { return match self { Low { 0 } Middle { 1 } High { 2 } } }
function remember(value: Maybe<Phase>): (Maybe<Phase>) -> Maybe<Phase> {
    return function(other: Maybe<Phase>): Maybe<Phase> { if other == None { return value }; return other }
}
function echo(value: Maybe<Boolean>): Maybe<Boolean> { native "choice_scalar" }
function missing(): Maybe<Boolean> { native "choice_scalar" }
function headerFlag(value: Header): Maybe<Boolean> { native "choice_scalar" }
parallel function echoPhase(value: Maybe<Phase>): Maybe<Phase> { return value }
function fallible(good: Boolean): Result<Boolean, Text> { if good { return Ok(false) }; return Err("stopped") }
function propagate(good: Boolean): Result<Maybe<Boolean>, Text> { return Ok(Some(try fallible(good))) }
function boxedInner(value: Maybe<Maybe<Boolean>>): Maybe<Maybe<Boolean>> { return value }
function loneIdentity(value: Lone): Lone { return value }
function recursiveIdentity(value: Recursive): Recursive { return value }
function integerOptional(value: Maybe<Integer>): Maybe<Integer> { return value }
function floatOptional(value: Maybe<Float>): Maybe<Float> { return value }
function PresentBool.enabled(): Boolean { return match self { Value(flag) { flag } Absent { false } } }
function payload(): Boolean { print("payload evaluated"); return true }
print("boolean")
print(boolCode(Some(false)) == 0)
print(boolCode(Some(true)) == 1)
print(boolCode(None) == 2)
print(Some(false) != None<Boolean>())
print(Some(false) < Some(true))
print(Some(true) < None<Boolean>())
print(PresentBool.Value(false) < PresentBool.Value(true))
print(PresentBool.Value(true) < PresentBool.Absent)
print(EmptyBool.Missing < EmptyBool.Value(false))
print(EmptyBool.Value(false) < EmptyBool.Value(true))
print(match EmptyBool.Value(true) { Missing { false } Value(flag) { flag } })
print(match PresentBool.Value(false) { Value(flag) { !flag } Absent { false } })
print(boolCode(identity(Some(true))) == 1)
print(boolCode(wrap(false)) == 0)
print(boolCode(SELECTED) == 1)
let evaluated: Maybe<Boolean> = Some(payload())
print(boolCode(evaluated) == 1)
let statement: Maybe<Boolean> = Some(false)
match statement { Some(flag) { print(!flag) } None { print(false) } }
print("character")
print(match Some<Character>(Character(0)) { Some(letter) { Integer(letter) == 0 } None { false } })
print(match ReverseChar.Value(Character(0)) { Empty { false } Value(letter) { Integer(letter) == 0 } })
print(match Some<Character>(Character(55295)) { Some(letter) { Integer(letter) == 55295 } None { false } })
print(match ReverseChar.Value(Character(55295)) { Empty { false } Value(letter) { Integer(letter) == 55295 } })
print(match Some<Character>(Character(57344)) { Some(letter) { Integer(letter) == 57344 } None { false } })
print(match ReverseChar.Value(Character(57344)) { Empty { false } Value(letter) { Integer(letter) == 57344 } })
print(match Some<Character>(Character(1114111)) { Some(letter) { Integer(letter) == 1114111 } None { false } })
print(match ReverseChar.Value(Character(1114111)) { Empty { false } Value(letter) { Integer(letter) == 1114111 } })
print(Some(Character(0)) != None<Character>())
print(ReverseChar.Empty < ReverseChar.Value(Character(0)))
print(Some(Character(55295)) < Some(Character(57344)))
print(Some(Character(1114111)) < None<Character>())
print("enum")
print(match forwardIdentity(Forward.Present(Middle)) { Present(value) { value == Middle } Absent { false } })
print(match forwardApply(function(value: Forward): Forward { return value }, Forward.Present(High)) { Present(value) { value == High } Absent { false } })
print(Forward.Present(High) < Forward.Absent)
print(ReverseEnum.Empty < ReverseEnum.Present(Low))
print(ReverseEnum.Present(Low) < ReverseEnum.Present(High))
print(phaseCode(wrap(Middle)) == 1)
let aliased: Maybe<PhaseAlias> = Some(High)
print(phaseCode(aliased) == 2)
let generic: Maybe<Flag<Integer>> = Some(Flag<Integer>.Lowered)
print(match generic { Some(flag) { flag == Flag<Integer>.Lowered } None { false } })
print("nested")
let innerBoolean: Maybe<Maybe<Boolean>> = Some(None<Boolean>())
let outerBoolean: Maybe<Maybe<Boolean>> = None
print(innerBoolean != outerBoolean)
print(match innerBoolean { Some(inner) { inner == None<Boolean>() } None { false } })
let innerCharacter: Maybe<Maybe<Character>> = Some(None<Character>())
let outerCharacter: Maybe<Maybe<Character>> = None
print(innerCharacter != outerCharacter)
print(match innerCharacter { Some(inner) { inner == None<Character>() } None { false } })
let innerPhase: Maybe<Maybe<Phase>> = Some(None<Phase>())
let outerPhase: Maybe<Maybe<Phase>> = None
print(innerPhase != outerPhase)
print(match innerPhase { Some(inner) { inner == None<Phase>() } None { false } })
print(boxedInner(innerBoolean) != outerBoolean)
print(match loneIdentity(Only(false)) { Only(flag) { !flag } })
print(match recursiveIdentity(Next(End)) { Next(_) { true } End { false } })
print("collections")
let values: List<Maybe<Boolean>> = [None, Some(true), Some(false)]
values.sort()

print(boolCode(values[0]) == 0)
print(boolCode(values[1]) == 1)
print(boolCode(values[2]) == 2)
values[0] = Some(true)
values.add(Some(false))
let compare = function(left: Maybe<Boolean>, right: Maybe<Boolean>): Integer { if left < right { return -1 }; if left > right { return 1 }; return 0 }
values.sortBy(compare)
let sorted = values.sortedBy(compare)

print(boolCode(sorted[0]) == 0)
print(boolCode(sorted[1]) == 1)
print(boolCode(sorted[2]) == 1)
print(boolCode(sorted[3]) == 2)
let scalar: Map<Maybe<Phase>, Maybe<Boolean>> = Map()
scalar[Some(Low)] = Some(false)
scalar[None] = None
let same: Map<Maybe<Phase>, Maybe<Boolean>> = Map()
same[None] = None
same[Some(Low)] = Some(false)

print(scalar == same)
print(boolCode(scalar[Some(Low)]) == 0)
let seen: Set<Maybe<Boolean>> = Set()
seen.add(Some(false)); seen.add(Some(true)); seen.add(None); seen.add(Some(false))

print(seen.length == 3)
print(seen.contains(Some(false)))
print(seen.remove(None))
let table: Map<Reading, Maybe<Phase>> = Map()
table[Reading { value: Some(Low) }] = Some(High)
let tableCopy: Map<Reading, Maybe<Phase>> = Map()
tableCopy[Reading { value: Some(Low) }] = Some(High)
let outer: Map<Reading, Map<Reading, Maybe<Phase>>> = Map()
outer[Reading { value: None }] = table
let outerCopy: Map<Reading, Map<Reading, Maybe<Phase>>> = Map()
outerCopy[Reading { value: None }] = tableCopy

print(outer == outerCopy)
print(phaseCode(outer[Reading { value: None }][Reading { value: Some(Low) }]) == 2)
tableCopy[Reading { value: Some(Low) }] = None
print(outer != outerCopy)
let original = Reading { value: Some(Middle) }
let snapshot = Snapshot { reading: original; flag: Some(false) }
let snapshots: Map<Snapshot, Integer> = Map()
snapshots[snapshot] = 42
original.value = None

print(snapshots[Snapshot { reading: Reading { value: Some(Middle) }; flag: Some(false) }] == 42)
print(!snapshots.has(snapshot))
print(Reading { value: Some(Low) } < Reading { value: Some(High) })
for key in snapshots { key.reading.value = Some(High) }
print(snapshots[Snapshot { reading: Reading { value: Some(Middle) }; flag: Some(false) }] == 42)
print("abi")
print(boolCode(echo(Some(false))) == 0)
print(boolCode(echo(Some(true))) == 1)
print(boolCode(echo(None)) == 2)
print(boolCode(missing()) == 2)
let header = Header { flag: Some(true); letter: Some(Character(0)); phase: Some(High) }
print(boolCode(headerFlag(header)) == 1)
let recall = remember(Some(High))
print(phaseCode(recall(None)) == 2)
print(phaseCode(recall(Some(Low))) == 0)
let output: List<Maybe<Phase>> = [None, None, None, None]
let selected: Maybe<Phase> = Some(Middle)
parallel for index in 0..output.length { output[index] = echoPhase(selected) }
for value in output { print(phaseCode(value) == 1) }

print("methods")
let custom = PresentBool.Value(true)
print(custom.enabled())
let methodValue: Maybe<Boolean> = Some(false)
let methodNone: Maybe<Boolean> = None
print(methodValue.isSome())
print(methodNone.isNone())
print(methodValue.map(function(flag) { return !flag }).unwrap())
print(methodNone.unwrapOr(true))
print(methodNone.unwrapOrElse(function() { return true }))
print(methodValue.filter(function(flag) { return flag }).isNone())
print(methodNone.orElse(function() { return Some<Boolean>(false) }).isSome())
let converted = methodValue.map(function(flag) { if flag { return Phase.High }; return Phase.Low })
print(phaseCode(converted) == 0)
let chained = methodValue.andThen(function(flag) { return Some<Character>(Character(0)) })
print(match chained { Some(letter) { Integer(letter) == 0 } None { false } })
print(match methodValue.okOr("lost") { Ok(flag) { !flag } Err(_) { false } })
print("propagation")
print(match propagate(true) { Ok(value) { boolCode(value) == 0 } Err(_) { false } })
print(match propagate(false) { Ok(_) { false } Err(message) { message == "stopped" } })
let composed: Maybe<Result<Boolean, Text>> = Some(Ok(false))
print(match composed { Some(result) { match result { Ok(flag) { !flag } Err(_) { false } } } None { false } })

print("finite shape boundaries")
print(UnitFirst.Present(Unit.Only) != UnitFirst.Empty)
print(UnitFirst.Present(Unit.Only) < UnitFirst.Empty)
print(UnitLast.Empty != UnitLast.Present(Unit.Only))
print(UnitLast.Empty < UnitLast.Present(Unit.Only))
print(match UnitFirst.Present(Unit.Only) { Present(value) { value == Unit.Only } Empty { false } })
print(match UnitLast.Present(Unit.Only) { Empty { false } Present(value) { value == Unit.Only } })
print(match threeIdentity(Three.Value(true)) { Value(flag) { flag } Missing { false } Deferred { false } })
print(match twoIdentity(Two.Right(false)) { Left(flag) { flag } Right(flag) { !flag } })
