// Parallel functions use only scalar values, so they can run on any processor.
use "machine" as machine

parallel function square(index: Integer, results: Integer) {
    machine.store64(results + index * 8, index * index + next(index))
    machine.atomicAdd(results + 64, 1)
}

parallel function next(value: Integer): Integer {
    return value + 1
}

let results = Bytes(72)
let entry = parallelEntry(square)
for index in 0..8 {
    machine.callEntry(entry, index, machine.address(results))
}
print(results.getInt64(7 * 8))
print(results.getInt64(64))
