use "io" as io
use "../tools/testing.min" as test
use "./compiler-port-support.min" as port
use "../experiments/memory/study-support.min" as data
use "system" as system
use "files" as files
use "json" as json
public function quote(source: Text): Text {
    let raw = Bytes(source); let pieces: List<Text> = ["\""]; let start = 0; let hex = Bytes("0123456789abcdef")
    for index in 0..raw.length {
        let byte = raw[index]
        if byte == 34 || byte == 92 || byte < 32 {
            pieces.add(Text(raw.slice(start, index)))
            if byte == 34 { pieces.add("\\\"") } else if byte == 92 { pieces.add("\\\\") }
            else { pieces.add("\\u00" + Text(Character(hex[byte >> 4])) + Text(Character(hex[byte & 15]))) }
            start = index + 1
        }
    }
    pieces.add(Text(raw.slice(start, raw.length))); pieces.add("\""); return joinText(pieces)
}
public function serialize(value: json.Value): Text {
    if value.kind == json.STRING { return quote(value.text) }
    if value.kind == json.ARRAY { let pieces: List<Text> = ["["]; for index in 0..value.items.length { if index > 0 { pieces.add(",") }; pieces.add(serialize(value.items[index])) }; pieces.add("]"); return joinText(pieces) }
    if value.kind == json.OBJECT { let pieces: List<Text> = ["{"]; for index in 0..value.keys.length { if index > 0 { pieces.add(",") }; pieces.add(quote(value.keys[index]) + ":" + serialize(value.items[index])) }; pieces.add("}"); return joinText(pieces) }
    if value.kind == json.NULL { return "null" }
    return value.text
}
function base64(raw: Bytes): Text {
    let alphabet = Bytes("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"); let pieces: List<Text> = []
    let index = 0
    while index < raw.length {
        let remaining = raw.length - index; let bits = raw[index] << 16
        if remaining > 1 { bits = bits | (raw[index + 1] << 8) }; if remaining > 2 { bits = bits | raw[index + 2] }
        let encoded = Bytes(4); encoded[0] = alphabet[(bits >> 18) & 63]; encoded[1] = alphabet[(bits >> 12) & 63]
        encoded[2] = 61; encoded[3] = 61
        if remaining > 1 { encoded[2] = alphabet[(bits >> 6) & 63] }; if remaining > 2 { encoded[3] = alphabet[bits & 63] }
        pieces.add(Text(encoded)); index += 3
    }
    return joinText(pieces)
}
public record Context { path: Text; root: Text; compiler: test.Compiler; commands: List<json.Value>; inputs: json.Value; controls: json.Value; tools: json.Value; cacheKeys: List<Text>; cacheHashes: List<Text>; serial: Integer; closed: Boolean }
function metadata(context: Context, command: List<Text>, label: Text): Text {
    let result = test.run(command, system.environment(), "", context.path + "/metadata-" + label, 10)
    test.require(result, "test metadata " + label); return result.output
}
public function absolute(context: Context, path: Text): Text {
    let resolved = test.resolvePath(path); test.check(resolved != "", "test metadata realpath failed: " + path); return resolved
}
public function digest(context: Context, path: Text): Text {
    let words = test.words(metadata(context, ["/bin/sh", "-c", "if command -v sha256sum >/dev/null; then exec sha256sum -- \"$1\"; else exec shasum -a 256 -- \"$1\"; fi", "minyar", path], "sha256"))
    test.check(words.length > 0 && words[0].byteLength == 64, "test artifact SHA256"); return words[0]
}
function locate(context: Context, tool: Text): Text {
    let result = test.run(["/bin/sh", "-c", "command -v \"$1\"", "minyar", tool], system.environment(), context.root, context.path + "/metadata-tool", 10)
    if result.status != 0 || result.output == "" { return "" }
    return absolute(context, test.lines(result.output)[0])
}
function executableHash(context: Context, path: Text): Text {
    let stamp = metadata(context, ["/bin/sh", "-c", "stat -L -c '%s %y %i' -- \"$1\" 2>/dev/null || stat -L -f '%z %Fm %i' \"$1\"", "minyar", path], "stat")
    let key = path + "\n" + stamp
    for index in 0..context.cacheKeys.length { if context.cacheKeys[index] == key { return context.cacheHashes[index] } }
    let hash = digest(context, path); context.cacheKeys.add(key); context.cacheHashes.add(hash); data.set(context.tools, path, data.text(hash)); return hash
}
public function context(label: Text, name: Text, source: Text): Context {
    let compiler = port.compiler(); let location = test.run(["/bin/pwd", "-P"], system.environment(), "", compiler.directory + "/root", 10)
    test.require(location, "test repository root"); let root = test.lines(location.output)[0]
    let base = test.setting("MINYAR_TEST_EVIDENCE", root + "/build/test-evidence")
    test.require(test.run(["/bin/mkdir", "-p", "--", base], system.environment(), "", compiler.directory + "/base", 10), "test workspace parent")
    let path = base + "/minyar-tests-" + label + "-" + Text(system.processId()) + "-" + Text(system.monotonicNanoseconds())
    test.check(files.makeDirectory(path) == 0, "native test workspace")
    test.removeTree(compiler.directory); compiler.directory = path
    let controls = data.object(["test", "link_flags"], [data.text(name), data.strings(compiler.flags)])
    let result = Context { path: path; root: root; compiler: compiler; commands: []; inputs: data.object([], []); controls: controls; tools: data.object([], []); cacheKeys: []; cacheHashes: []; serial: 0; closed: false }
    for input in [compiler.executable, compiler.runtime, source, "tests/native-evidence.min", "tests/compiler-port-support.min", "tools/testing.min", "tools/testing-host.c"] {
        if files.pathSize(input) >= 0 { let file = absolute(result, input); data.set(result.inputs, file, data.text(digest(result, file))) }
    }
    return result
}
function retainedFiles(context: Context, directory: Text, relative: Text, result: json.Value) {
    for name in files.list(directory) {
        let file = directory + "/" + name; let item = name; if relative != "" { item = relative + "/" + name }
        let type = test.run(["/usr/bin/test", "-d", file], system.environment(), "", context.path + "/metadata-type", 10)
        if type.status == 0 { retainedFiles(context, file, item, result) }
        else {
            let link = test.run(["/usr/bin/test", "-L", file], system.environment(), "", context.path + "/metadata-link", 10)
            if link.status != 0 && !port.starts(name, "metadata-") && name != "evidence.json" { data.set(result, item, data.text(digest(context, file))) }
        }
    }
}
public function close(context: Context, failed: Boolean) {
    if context.closed { return }; context.closed = true
    if !failed { test.removeTree(context.path); return }
    let retained = data.object([], []); retainedFiles(context, context.path, "", retained)
    let versions = data.object([], [])
    for tool in context.tools.keys {
        let name = tool; let raw = Bytes(tool); for index in 0..raw.length { if raw[index] == 47 { name = Text(raw.slice(index + 1, raw.length)) } }
        if port.starts(name, "clang") || port.starts(name, "opt") || port.starts(name, "FileCheck") {
            let version = test.run([tool, "--version"], system.environment(), "", context.path + "/metadata-version", 5)
            data.set(versions, tool, data.text(version.output + version.errorOutput))
        }
    }
    let report = data.object(["schema_version", "status", "workspace", "inputs", "files", "tools", "tool_versions", "controls", "commands"], [data.integer(1), data.text("failed"), data.text(context.path), context.inputs, retained, context.tools, versions, context.controls, data.array(context.commands)])
    io.writeTextFile(context.path + "/evidence.json", serialize(report) + "\n")
    system.writeStandardError("Test failure workspace retained: " + context.path + "\n")
}
public function expect(context: Context, condition: Boolean, message: Text) { if !condition { close(context, true); fail(message) } }
public function run(context: Context, command: List<Text>, phase: Text, timeout: Integer, checked: Boolean): test.Result {
    context.serial += 1; let executable = locate(context, command[0]); let hash = data.nullValue()
    if executable != "" && files.pathSize(executable) >= 0 { hash = data.text(executableHash(context, executable)) }
    let environment = data.object([], [])
    for entry in system.environment() {
        let position = port.find(entry, "=", 0)
        if position >= 0 { let raw = Bytes(entry); let key = Text(raw.slice(0, position)); if port.starts(key, "MINYAR_") || key == "ASAN_OPTIONS" || key == "UBSAN_OPTIONS" || key == "MSYS2_ARG_CONV_EXCL" { data.set(environment, key, data.text(Text(raw.slice(position + 1, raw.length)))) } }
    }
    let row = data.object(["command", "cwd", "timeout", "phase", "stdout_captured", "stderr_captured", "stdin", "executable", "executable_sha256", "empty_environment", "environment", "removed_environment", "timed_out"], [data.strings(command), data.text(context.root), data.integer(timeout), data.text(phase), data.boolean(true), data.boolean(true), data.object(["mode"], [data.text("eof")]), data.text(executable), hash, data.boolean(false), environment, data.array([]), data.boolean(false)])
    context.commands.add(row)
    let actual = ["/bin/sh", "-c", "exec \"$@\" </dev/null", "minyar"]
    for item in command { actual.add(item) }
    let log = context.path + "/command" + Text(context.serial); let start = system.monotonicNanoseconds()
    let result = test.run(actual, system.environment(), context.root, log, timeout)
    data.set(row, "returncode", data.integer(result.status)); data.set(row, "stdout_base64", data.text(base64(io.readBytesFile(log)))); data.set(row, "stderr_base64", data.text(base64(io.readBytesFile(log + ".err"))))
    data.set(row, "elapsed_seconds", data.decimal(Float(system.monotonicNanoseconds() - start) / 1000000000.0))
    if result.status == 124 || result.status == 137 {
        data.set(row, "timed_out", data.boolean(true)); data.set(row, "exception", data.text("TimeoutExpired"))
        expect(context, false, "test command timed out after " + Text(timeout) + " seconds")
    }
    if checked && result.status != 0 { data.set(row, "exception", data.text("CalledProcessError")); expect(context, false, phase + " failed with status " + Text(result.status) + "\n" + result.errorOutput) }
    return result
}
public function compile(context: Context, source: Text): test.Result {
    context.compiler.serial += 1; let path = context.path + "/case" + Text(context.compiler.serial) + ".min"; io.writeTextFile(path, test.sourceModules(source))
    let output = context.path + "/case" + Text(context.compiler.serial) + ".ll"
    let result = run(context, [context.compiler.executable, path, output, "--library", "library"], "compile", context.compiler.compileTimeout, false)
    if result.status == 0 && test.addressEnabled(context.compiler.flags) { io.writeTextFile(output, test.instrument(io.readTextFile(output))) }
    return result
}
public function llvm(context: Context): Text { return context.path + "/case" + Text(context.compiler.serial) + ".ll" }
public function link(context: Context, source: Text, optimization: Text, executable: Text, timeout: Integer) {
    let command = [context.compiler.clang, optimization]
    for flag in context.compiler.flags { command.add(flag) }
    for item in ["-Wno-override-module", source, context.compiler.runtime, "-o", executable, "-lm"] { command.add(item) }
    run(context, command, "link", timeout, true)
}
public function rejects(context: Context, source: Text, diagnostic: Text) {
    let result = compile(context, source)
    expect(context, result.status == 1 && result.output == "" && test.containsDiagnostic(result.errorOutput, diagnostic) && !test.contains(result.errorOutput, "List position") && files.pathSize(llvm(context)) < 0, "compiler diagnostic contract changed: " + diagnostic + "\n" + result.errorOutput)
}
public record FileOutput { path: Text; contents: Bytes }
public function bytesEqual(left: Bytes, right: Bytes): Boolean { if left.length != right.length { return false }; for index in 0..left.length { if left[index] != right[index] { return false } }; return true }
public function executes(context: Context, source: Text, expected: Text, status: Integer, diagnostics: Text, arguments: List<Text>, outputs: List<FileOutput>): Text {
    let fileRows: List<json.Value> = []
    for index in 0..outputs.length {
        let output = outputs[index]; let reference = context.path + "/output-oracle" + Text(index); io.writeBytesFile(reference, output.contents)
        fileRows.add(data.object(["path", "bytes", "sha256"], [data.text(output.path), data.integer(output.contents.length), data.text(digest(context, reference))]))
    }
    let oracles = json.member(context.controls, "execution_oracles")
    if oracles.kind == json.NULL { oracles = data.array([]); data.set(context.controls, "execution_oracles", oracles) }
    oracles.items.add(data.object(["source", "stdout", "stderr", "status", "optimizations", "arguments", "file_outputs"], [data.text("case" + Text(context.compiler.serial + 1) + ".min"), data.text(expected), data.text(diagnostics), data.integer(status), data.strings(["-O0", "-O2"]), data.strings(arguments), data.array(fileRows)]))
    let result = compile(context, source); expect(context, result.status == 0, result.errorOutput)
    let sourceLLVM = llvm(context)
    for optimization in ["-O0", "-O2"] {
        let executable = sourceLLVM + "." + optimization; link(context, sourceLLVM, optimization, executable, context.compiler.linkTimeout)
        for output in outputs { if files.pathSize(output.path) >= 0 { expect(context, files.remove(output.path) == 0, "cannot clear file output before execution") } }
        let command = [executable]; for argument in arguments { command.add(argument) }
        let observed = run(context, command, "execute", context.compiler.runTimeout, false)
        expect(context, observed.status == status && observed.output == expected && test.sameDiagnostic(observed.errorOutput, diagnostics), "native output/status/stderr differs at " + optimization + "\n" + observed.output + observed.errorOutput)
        for output in outputs { expect(context, files.pathSize(output.path) >= 0 && bytesEqual(io.readBytesFile(output.path), output.contents), "native program file bytes differ: " + output.path) }
    }
    return io.readTextFile(sourceLLVM)
}
public function reference(context: Context, path: Text): Text {
    let endian = "little"; let system = "linux"
    for variant in [endian + "-endian", system, "default"] {
        let selected = path; if variant != "default" { selected += "." + variant }
        if files.pathSize(selected) >= 0 {
            let resolved = absolute(context, selected); let hash = digest(context, resolved); data.set(context.inputs, resolved, data.text(hash))
            let references = json.member(context.controls, "output_references"); if references.kind == json.NULL { references = data.array([]); data.set(context.controls, "output_references", references) }
            references.items.add(data.object(["default", "selected", "variant", "byte_order", "system", "size", "sha256"], [data.text(absolute(context, path)), data.text(resolved), data.text(variant), data.text(endian), data.text(system), data.nullValue(), data.text(hash)]))
            return Text(io.readBytesFile(resolved))
        }
    }
    expect(context, false, "No expected-output reference for " + path); return ""
}
