use "../tools/testing.min" as test
use "system" as system
use "files" as files
function starts(source: Text, prefix: Text): Boolean {
    let raw = Bytes(source)
    let pattern = Bytes(prefix)
    if raw.length < pattern.length { return false }
    for index in 0..pattern.length { if raw[index] != pattern[index] { return false } }
    return true
}
function selected(name: Text): Boolean {
    if argumentCount() == 0 { return true }
    for index in 0..argumentCount() { if argument(index) == name || argument(index) == "CheckedResults." + name { return true } }
    return false
}
function compile(compiler: test.Compiler, source: Text): test.Result {
    compiler.serial += 1
    let path = compiler.directory + "/case" + Text(compiler.serial)
    writeTextFile(path + ".min", source)
    let result = test.run([compiler.executable, path + ".min", path + ".ll", "--library", "library"], system.environment(), "", path + ".compile", compiler.compileTimeout)
    if result.status == 0 && test.addressEnabled(compiler.flags) { writeTextFile(path + ".ll", test.instrument(readTextFile(path + ".ll"))) }
    return result
}
function executes(compiler: test.Compiler, source: Text, expected: Text, status: Integer, diagnostic: Text): Text {
    test.require(compile(compiler, source), "compile checked result")
    let path = compiler.directory + "/case" + Text(compiler.serial)
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization]
        for flag in compiler.flags { command.add(flag) }
        for item in ["-Wno-override-module", path + ".ll", compiler.runtime, "-lm", "-o", path + ".exe"] { command.add(item) }
        test.require(test.run(command, system.environment(), "", path + ".link", compiler.linkTimeout), "link checked result " + optimization)
        let result = test.run([path + ".exe"], system.environment(), "", path + ".run", compiler.runTimeout)
        test.check(result.status == status && result.output == expected && result.errorOutput == diagnostic, "checked result " + optimization + "\n" + result.output + result.errorOutput)
    }
    return readTextFile(path + ".ll")
}
function rejects(compiler: test.Compiler, source: Text, diagnostic: Text) {
    let result = compile(compiler, source)
    test.check(result.status == 1 && result.output == "", "checked result rejection status/stdout")
    test.check(test.contains(result.errorOutput, diagnostic), "checked result rejection diagnostic\n" + result.errorOutput)
    test.check(files.pathSize(compiler.directory + "/case" + Text(compiler.serial) + ".ll") < 0, "checked result rejection emitted LLVM")
    test.check(!test.contains(result.errorOutput, "List position"), "checked result rejection internal List fault")
}
let compiler = test.compiler()
let allowed = ["test_g15_scale_failure_recovers", "test_original_g15_trap_is_unchanged", "test_signed_boundaries_and_random_pairs_against_python", "test_overflow_messages_and_error_codes_are_stable", "test_operands_evaluate_once_in_order", "test_failed_value_extraction_remains_fatal", "test_wrapping_operations_remain_compatible", "test_public_arguments_and_private_fields_are_checked", "test_scalar_intrinsic_signatures_are_checked"]
for index in 0..argumentCount() {
    let valid = false
    for name in allowed { if argument(index) == name || argument(index) == "CheckedResults." + name { valid = true } }
    test.check(valid, "unknown checked result case " + argument(index))
}
if selected("test_g15_scale_failure_recovers") {
    executes(compiler, readTextFile("tests/fixtures/g15-overflow-recovery.min"), "1000000000000000000\nfalse\ntrue\n100\nstill alive\n", 0, "")
}
if selected("test_original_g15_trap_is_unchanged") {
    executes(compiler, readTextFile("tests/fixtures/g15-overflow-trap.min"), "1000000000000000000\n", 1, "Minyar stopped: this Integer calculation is outside the supported range.\n")
}
