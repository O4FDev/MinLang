\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\nfalse\ntrue\n0\n", 0, "")
    for operation in ["sadd", "ssub", "smul"] { test.check(test.contains(ir, "call { i64, i1 } @llvm." + operation + ".with.overflow.i64"), "checked arithmetic overflow intrinsic " + operation) }
    let helpers = 0
    let inside = false
    let parts: List<Text> = []
    for line in test.lines(ir) {
        if starts(line, "define ") { inside = true; parts = [line + "\n"] }
        else if inside {
            parts.add(line + "\n")
            if line == "}" {
                inside = false
                let body = joinText(parts)
                if test.contains(body, "%integer.overflow.pair =") {
                    helpers += 1
                    test.check(test.contains(body, "extractvalue { i64, i1 } %integer.overflow.pair, 1"), "checked overflow flag extraction")
                    test.check(!test.contains(body, "@.minyar.integer.overflow.checked"), "checked helper retained fatal overflow")
                    test.check(!test.contains(body, "nsw"), "checked helper has undefined overflow")
                }
            }
        }
    }
    test.check(helpers == 3, "checked overflow helper count")
    test.check(!test.contains(ir, "minyar-native-library: integer_overflow"), "checked scalar intrinsic became native library")
}
if selected("test_overflow_messages_and_error_codes_are_stable") {
    executes(compiler, "use \"errors\" as errors\nlet a = errors.checkedAdd(9223372036854775807, 1)\nlet s = errors.checkedSubtract(-9223372036854775808, 1)\nlet m = errors.checkedMultiply(-9223372036854775808, -1)\nprint(errors.overflowCode())\nprint(errors.message(errors.integerError(a)))\nprint(errors.message(errors.integerError(s)))\nprint(errors.message(errors.integerError(m)))\nprint(errors.isWouldBlock(errors.integerError(a)))\nprint(errors.code(errors.integerError(errors.checkedAdd(-1, 1))))\n", "13\nInteger addition overflow\nInteger subtraction overflow\nInteger multiplication overflow\nfalse\n0\n", 0, "")
}
if selected("test_operands_evaluate_once_in_order") {
    executes(compiler, "use \"errors\" as errors\nfunction left(): Integer { print(11); return 9223372036854775807 }\nfunction right(): Integer { print(22); return 1 }\nprint(errors.integerOk(errors.checkedAdd(left(), right())))\nprint(errors.integerOk(errors.checkedSubtract(left(), right())))\nprint(errors.integerOk(errors.checkedMultiply(left(), right())))\nprint(33)\n", "11\n22\nfalse\n11\n22\ntrue\n11\n22\ntrue\n33\n", 0, "")
}
if selected("test_failed_value_extraction_remains_fatal") {
    executes(compiler, "use \"errors\" as errors\nerrors.integerValue(errors.checkedAdd(9223372036854775807, 1))\nprint(\"after\")\n", "", 1, "Minyar stopped: cannot read the value of a failed IntegerResult\n")
    executes(compiler, "use \"errors\" as errors\nerrors.integerValue(errors.checkedSubtract(-9223372036854775808, 1))\nprint(\"after\")\n", "", 1, "Minyar stopped: cannot read the value of a failed IntegerResult\n")
    executes(compiler, "use \"errors\" as errors\nerrors.integerValue(errors.checkedMultiply(-9223372036854775808, -1))\nprint(\"after\")\n", "", 1, "Minyar stopped: cannot read the value of a failed IntegerResult\n")
}
if selected("test_wrapping_operations_remain_compatible") {
    executes(compiler, "print(wrappingAdd(9223372036854775807, 1))\nprint(wrappingSubtract(-9223372036854775808, 1))\nprint(wrappingMultiply(-9223372036854775808, -1))\n", "-9223372036854775808\n9223372036854775807\n-9223372036854775808\n", 0, "")
}
if selected("test_public_arguments_and_private_fields_are_checked") {
    for operation in ["Add", "Subtract", "Multiply"] {
        rejects(compiler, "use \"errors\" as errors\nerrors.checked" + operation + "(1.0, 2)\n", "an argument passed to checked" + operation + " has the wrong type")
        rejects(compiler, "use \"errors\" as errors\nlet result = errors.checked" + operation + "(1, 2)\nresult.value = 9\n", "private")
    }
}
if selected("test_scalar_intrinsic_signatures_are_checked") {
    for name in ["addOverflows", "subtractOverflows", "multiplyOverflows"] {
        for signature in ["(a: Integer): Boolean", "(a: Float, b: Integer): Boolean", "(a: Integer, b: Integer): Integer", "(a: Integer, b: Integer, c: Integer): Boolean"] {
            rejects(compiler, "function " + name + signature + " { native \"integer_overflow\" }\n", "expects two Integer parameters and a Boolean return")
        }
    }
    rejects(compiler, "function unknown(a: Integer, b: Integer): Boolean { native \"integer_overflow\" }\n", "no intrinsic named")
}
test.removeTree(compiler.directory)
print("Checked integer results: passed")
