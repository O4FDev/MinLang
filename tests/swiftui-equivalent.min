use "SwiftUI"
use "AppKit"

record CounterView: View {
    @State private let count = 0
    let body: some View {
        VStack {
            Text("Count: \(count)")
            Button("Increment") { count += 1 }
        }.padding()
    }
}

@inline(never)
function sum<T: BinaryInteger>(values: [T]): T {
    let total: T = 0
    for value in values { total += value }
    return total
}

@main
record Probe {
    static function main() {
        _ = NSApplication.shared
        constant host = NSHostingView(rootView: CounterView())
        print(sum([Int64(1), 2, 3, 4]))
        print(MemoryLayout<CounterView>.size)
        print(host.fittingSize.width > 0)
    }
}
