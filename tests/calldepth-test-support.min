use "../tools/testing.min" as test
use "./compiler-port-support.min" as source
use "./sha256-support.min" as arguments
use "./tar-benchmark-support.min" as identity
use "system" as system
use "files" as files
use "json" as json

public record Context { root: Text; directory: Text; environment: List<Text>; commands: List<Text>; serial: List<Integer> }
public function digest(path: Text): Text { return identity.digest(path) }
public function quote(value: Text): Text { return identity.quote(value) }
public function strings(values: List<Text>): Text { return identity.strings(values) }
public function parsed(path: Text): json.Value { return identity.parsed(path) }
public function serialize(value: json.Value): Text { return identity.serialize(value) }
public function absolute(path: Text, work: Text): Text {
    let result = test.run(["readlink", "-m", "-z", "--", path], system.environment(), "", work + "/resolve", 10)
    test.require(result, "call-depth path resolution")
    let bytes = Bytes(result.output)
    test.check(bytes.length > 1 && bytes[bytes.length - 1] == 0, "invalid call-depth resolved path")
    return Text(bytes.slice(0, bytes.length - 1))
}
function executable(context: Context, command: Text): Text {
    let result = test.run(["/bin/sh", "-c", "command -v -- \"$1\"", "minyar", command], context.environment, context.root, context.directory + "/resolve-command", 10)
    test.require(result, "call-depth executable identity")
    let bytes = Bytes(result.output)
    test.check(bytes.length > 1 && bytes[bytes.length - 1] == 10, "call-depth executable identity is missing")
    return absolute(Text(bytes.slice(0, bytes.length - 1)), context.directory)
}
public function environmentJSON(environment: List<Text>): Text {
    let entries: List<Text> = []
    for name in ["ASAN_OPTIONS", "UBSAN_OPTIONS"] {
        for entry in environment {
            if source.starts(entry, name + "=") { entries.add(quote(name) + ":" + quote(Text(Bytes(entry).slice(name.byteLength + 1, entry.byteLength)))); break }
        }
    }
    return "{" + sourceJoin(entries) + "}"
}
function sourceJoin(entries: List<Text>): Text {
    let output = ""
    for index in 0..entries.length { if index > 0 { output += "," }; output += entries[index] }
    return output
}
public function commandLog(context: Context) { writeTextFile(context.directory + "/commands.json", "[" + sourceJoin(context.commands) + "]\n") }
public function run(context: Context, command: List<Text>, checkOutput: Boolean, expected: Text, status: Integer, diagnostics: Text, smallStack: Boolean): test.Result {
    context.serial[0] += 1
    let invocation = command
    if smallStack {
        invocation = ["/bin/sh", "-c", "ulimit -s 256 || exit; exec \"$@\"", "minyar"]
        for arg in command { invocation.add(arg) }
    }
    let result = test.run(invocation, context.environment, context.root, context.directory + "/operation-" + Text(context.serial[0]), 180)
    let path = executable(context, command[0])
    let stack = "null"
    if smallStack { stack = "262144" }
    context.commands.add("{\"argv\":" + strings(command) + ",\"status\":" + Text(result.status) + ",\"executable\":" + quote(path) + ",\"executable_sha256\":" + quote(digest(path)) + ",\"stdout\":" + quote(result.output) + ",\"stderr\":" + quote(result.errorOutput) + ",\"small_stack_bytes\":" + stack + ",\"sanitizer_environment\":" + environmentJSON(context.environment) + "}")
    commandLog(context)
    test.check(result.status == status && (!checkOutput || result.output == expected) && result.errorOutput == diagnostics, "call-depth bounded command differs\n" + context.commands[context.commands.length - 1])
    return result
}
public function success(context: Context, command: List<Text>): test.Result { return run(context, command, false, "", 0, "", false) }
public function graphSource(root: Text): Text {
    let engine = readTextFile(root + "/runtime/minyar_runtime.c")
    for header in ["minyar_rc.h", "minyar_collections.h"] {
        let replacement = "minyar_cycle_rc.h"
        if header == "minyar_collections.h" { replacement = "minyar_cycle_collections.h" }
        let directive = "#include \"" + header + "\""
        test.check(engine.byteLength - test.replace(engine, directive, "").byteLength == directive.byteLength, "cycle runtime requires exactly one " + directive)
        engine = test.replace(engine, directive, "#include \"" + replacement + "\"")
    }
    return "#define MINYAR_SORT_GRAPH 1\n#define MINYAR_MAP_CYCLE_RUNTIME 1\n#if defined(__GNUC__) || defined(__clang__)\n#define MINYAR_NOINLINE __attribute__((noinline))\n#else\n#define MINYAR_NOINLINE\n#endif\n" + engine + "\n#include \"minyar_callbacks.h\"\n"
}
public function joined(values: List<Text>): Text { return sourceJoin(values) }
public function fields(value: json.Value, key: Text): json.Value {
    let result = json.member(value, key)
    test.check(result.kind == json.OBJECT, "missing call-depth manifest object " + key)
    return result
}
public function number(value: json.Value, key: Text): Integer {
    let result = json.member(value, key)
    test.check(result.kind == json.NUMBER, "missing call-depth manifest number " + key)
    return Integer(result.text)
}
public function zeroLines(value: Text): List<Text> {
    let bytes = Bytes(value)
    let paths: List<Text> = []
    let start = 0
    for index in 0..bytes.length { if bytes[index] == 0 { paths.add(Text(bytes.slice(start, index))); start = index + 1 } }
    test.check(start == bytes.length, "unterminated call-depth file inventory")
    return paths
}
public function inventory(context: Context, directories: List<Text>, recursive: Boolean): List<Text> {
    context.serial[0] += 1
    let command: List<Text> = []
    if recursive {
        command = ["find"]
        for directory in directories { command.add(directory) }
        for flag in ["-type", "f", "-print0"] { command.add(flag) }
    } else {
        command = ["/bin/sh", "-c", "for directory do for path in \"$directory\"/*; do if [ -f \"$path\" ]; then printf '%s\\000' \"$path\"; fi; done; done", "minyar"]
        for directory in directories { command.add(directory) }
    }
    let result = test.run(command, context.environment, context.root, context.directory + "/inventory-" + Text(context.serial[0]), 30)
    test.require(result, "call-depth retained source inventory")
    return zeroLines(result.output)
}
public function hashes(paths: List<Text>, root: Text): Text {
    let entries: List<Text> = []
    for path in paths {
        let name = path
        if root != "" { test.check(source.starts(path, root + "/"), "call-depth identity escaped its retained root"); name = Text(Bytes(path).slice(root.byteLength + 1, path.byteLength)) }
        entries.add(quote(name) + ":" + quote(digest(path)))
    }
    return "{" + sourceJoin(entries) + "}"
}
