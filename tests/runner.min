use "../tools/testing.min" as test
use "../tools/check-runner.min" as runner
use "system" as system
use "files" as files
let source = "# Files\n\n.PHONY: check-parent check-first check-second\n\ncheck-parent: check-first check-second | artifact\n\t@true\n\ncheck-first: artifact\n\t@true\n\ncheck-second: artifact\n\t@true\n\nartifact:\n\t@true\n\n# files hash-table stats:\n"
let rules = runner.database(source)
test.check(rules.length == 4, "make database rule count")
test.check(rules[runner.findRule(rules, "check-parent")].prerequisites.length == 3, "order-only prerequisite")
test.check(rules[runner.findRule(rules, "check-first")].phony, "phony declaration")
let work = test.scratch()
writeTextFile(work + "/Makefile", ".PHONY: check-parent check-first check-second FORCE\ncheck-parent: check-first check-second\n\t@test $$(wc -l < runs) -eq 2\ncheck-first: artifact\n\t@echo first >> runs; sleep 0.1\ncheck-second: artifact\n\t@echo second >> runs; sleep 0.1\nartifact:\n\t@echo build >> builds; touch artifact\nFORCE:\n")
let plan = runner.plan(2, 5, 0)
let variant = runner.addVariant(plan, "", work, system.environment(), ["/usr/bin/make", "-j1"])
test.check(fileExists(work + "/build"), "cold variant creates its build lock directory")
let parent = runner.addCheck(plan, variant, "check-parent")
runner.addCheck(plan, variant, "check-first")
test.check(plan.checks.length == 3 && plan.goals.length == 1, "deduplicate shared check and goal")
test.check(runner.run(plan), "parallel checks complete")
test.check(readTextFile(work + "/builds") == "build\n", "build runs once")
test.check(test.lines(readTextFile(work + "/runs")).length == 2, "each child executes once")
writeTextFile(work + "/Makefile", ".PHONY: check-build-barrier check-after-build FORCE\ncheck-build-barrier: build/one build/two\n\t@test -f build/one && test -f build/two\ncheck-after-build:\n\t@test -f build/one && test -f build/two\nbuild/one build/two:\n\t@sleep 0.1; touch $@\nFORCE:\n")
let barrier = runner.plan(2, 5, 0)
let barrierVariant = runner.addVariant(barrier, "", work, system.environment(), ["/usr/bin/make", "-j1"])
runner.addCheck(barrier, barrierVariant, "check-build-barrier")
runner.addCheck(barrier, barrierVariant, "check-after-build")
test.check(runner.run(barrier), "checks wait for the complete shared build before reading artifacts")
writeTextFile(work + "/Makefile", ".PHONY: check-overlap FORCE\ncheck-overlap: build/base build/left build/right\n\t@test -f build/left && test -f build/right\nbuild/base:\n\t@test ! -e build/left.running && test ! -e build/right.running; sleep 0.2; touch $@\nbuild/left: build/base\n\t@touch build/left.running; i=0; while [ $$i -lt 50 ] && [ ! -e build/right.running ]; do sleep 0.1; i=$$((i+1)); done; test -e build/right.running; touch $@\nbuild/right: build/base\n\t@touch build/right.running; i=0; while [ $$i -lt 50 ] && [ ! -e build/left.running ]; do sleep 0.1; i=$$((i+1)); done; test -e build/left.running; touch $@\nFORCE:\n")
let overlap = runner.plan(2, 10, 0)
let overlapVariant = runner.addVariant(overlap, "", work, system.environment(), ["/usr/bin/make", "-j1"])
runner.addCheck(overlap, overlapVariant, "check-overlap")
test.check(overlap.goals.length == 3, "shared build goals")
test.check(runner.run(overlap), "independent shared builds overlap after their common prerequisite")
writeTextFile(work + "/Makefile", ".PHONY: check-resources check-net-udp-offload check-modules check-sanitize-modules FORCE\ncheck-resources: check-net-udp-offload check-modules check-sanitize-modules\ncheck-modules check-sanitize-modules:\n\t@mkdir module-output; sleep 0.1; rmdir module-output; echo ran >> module-runs\ncheck-net-udp-offload:\n\t@test ! -d module-output\nFORCE:\n")
let resources = runner.plan(2, 5, 0)
let resourceVariant = runner.addVariant(resources, "", work, system.environment(), ["/usr/bin/make", "-j1"])
runner.addCheck(resources, resourceVariant, "check-resources")
test.check(runner.run(resources), "fixed resources serialize and quiet checks exclude ordinary work")
test.check(readTextFile(work + "/module-runs") == "ran\nran\n", "split sanitizer module stage preserves both executions and excludes shared output races")
writeTextFile(work + "/Makefile", ".PHONY: check-retry check-flaky FORCE\ncheck-retry: check-flaky\n\t@test -f retried\ncheck-flaky:\n\t@if test -f retried; then exit 0; else touch retried; exit 1; fi\nFORCE:\n")
let retries = runner.plan(2, 5, 1)
let retryVariant = runner.addVariant(retries, "", work, system.environment(), ["/usr/bin/make", "-j1"])
runner.addCheck(retries, retryVariant, "check-retry")
test.check(runner.run(retries), "isolated retry reruns failed child and blocked aggregate")
writeTextFile(work + "/Makefile", ".PHONY: check-first-known check-second-known check-after-known FORCE\ncheck-first-known:\n\t@echo first >> known-order\ncheck-second-known:\n\t@echo second >> known-order\ncheck-after-known: check-first-known\n\t@echo after >> known-order\nFORCE:\n")
writeTextFile(work + "/durations", "check-after-known 9000\ncheck-first-known 10\ncheck-second-known 5000\n")
let known = runner.plan(1, 5, 0)
let knownVariant = runner.addVariant(known, "", work, system.environment(), ["/usr/bin/make", "-j1"])
runner.addCheck(known, knownVariant, "check-second-known")
runner.addCheck(known, knownVariant, "check-after-known")
runner.prioritize(known, work + "/durations")
test.check(runner.run(known), "history-ordered checks pass")
test.check(readTextFile(work + "/known-order") == "first\nafter\nsecond\n", "longest recorded chains start first")
runner.remember(known, work + "/durations")
let remembered = test.lines(readTextFile(work + "/durations"))
test.check(remembered.length == 3 && test.words(remembered[1])[0] == "check-first-known" && test.words(remembered[1])[1] != "10", "measured durations replace history")
test.removeTree(known.scratch)
writeTextFile(work + "/Makefile", ".PHONY: check-coverage check-maps FORCE\ncheck-coverage:\n\t@test \"$$MINYAR_TEST_JOBS\" -eq 2; touch coverage.running; i=0; while [ $$i -lt 50 ] && [ ! -e maps.running ]; do sleep 0.1; i=$$((i+1)); done; test -e maps.running\ncheck-maps:\n\t@test \"$$MINYAR_TEST_JOBS\" -eq 2; touch maps.running; i=0; while [ $$i -lt 50 ] && [ ! -e coverage.running ]; do sleep 0.1; i=$$((i+1)); done; test -e coverage.running\nFORCE:\n")
writeTextFile(work + "/demand", "check-coverage 1000 900\ncheck-maps 1000 900\n")
let demand = runner.plan(2, 10, 0)
let demandVariant = runner.addVariant(demand, "", work, system.environment(), ["/usr/bin/make", "-j1"])
runner.addCheck(demand, demandVariant, "check-coverage")
runner.addCheck(demand, demandVariant, "check-maps")
runner.prioritize(demand, work + "/demand")
test.check(runner.run(demand), "measured single-core demand admits wide checks side by side")
test.removeTree(demand.scratch)
writeTextFile(work + "/Makefile", ".PHONY: check-short-scratch check-failed-scratch FORCE\ncheck-short-scratch:\n\t@test $${#TMPDIR} -lt 60; test ! -L \"$$TMPDIR\"; test \"$$(cd \"$$TMPDIR\" && pwd -P)\" = \"$$TMPDIR\"; printf kept > \"$$TMPDIR/artifact\"; printf '%s' \"$$TMPDIR\" > alias\ncheck-failed-scratch:\n\t@printf failed > \"$$TMPDIR/artifact\"; printf '%s' \"$$TMPDIR\" > failed-alias; exit 1\nFORCE:\n")
let shortScratch = runner.plan(1, 5, 0)
let shortVariant = runner.addVariant(shortScratch, "", work, system.environment(), ["/usr/bin/make", "-j1"])
runner.addCheck(shortScratch, shortVariant, "check-short-scratch")
runner.addCheck(shortScratch, shortVariant, "check-failed-scratch")
test.check(!runner.run(shortScratch), "failing scratch fixture fails")
test.check(shortScratch.checks[0].state == 2, "short real scratch fits Unix socket paths")
test.check(!fileExists(readTextFile(work + "/alias")) && !fileExists(shortScratch.scratch + "/tmp-1"), "passing check scratch removed")
test.check(readTextFile(shortScratch.scratch + "/tmp-2/artifact") == "failed" && !fileExists(readTextFile(work + "/failed-alias")), "failed check scratch retained in the run")
test.removeTree(shortScratch.scratch)
for jobs in [1, 2, 4] {
    if fileExists(work + "/mutation-done") { test.check(files.remove(work + "/mutation-done") == 0, "reset worker reservation fixture") }
    writeTextFile(work + "/Makefile", ".PHONY: check-mutation-score check-after-mutation FORCE\ncheck-mutation-score:\n\t@test \"$$MINYAR_TEST_JOBS\" -eq " + Text(jobs) + "; sleep 0.1; touch mutation-done\ncheck-after-mutation:\n\t@test -f mutation-done\nFORCE:\n")
    let workerSlots = runner.plan(jobs, 5, 0)
    let workerVariant = runner.addVariant(workerSlots, "", work, system.environment(), ["/usr/bin/make", "-j1"])
    runner.addCheck(workerSlots, workerVariant, "check-mutation-score")
    runner.addCheck(workerSlots, workerVariant, "check-after-mutation")
    test.check(runner.run(workerSlots), "mutation workers reserve the complete configured process budget")
    test.removeTree(workerSlots.scratch)
}
for gate in ["check-peer-regressions-", "check-peer-optimizations-", "check-peer-sanitize-"] {
    for suite in ["regressions", "cpp-java-js", "rust-go-zig", "python-swift-ruby-lua"] {
        let target = gate + suite
        if fileExists(work + "/peer-done") { test.check(files.remove(work + "/peer-done") == 0, "reset peer reservation fixture") }
        writeTextFile(work + "/Makefile", ".PHONY: " + target + " check-after-peer FORCE\n" + target + ":\n\t@test \"$$MINYAR_TEST_JOBS\" -eq 4; sleep 0.1; touch peer-done\ncheck-after-peer:\n\t@test -f peer-done\nFORCE:\n")
        let peerSlots = runner.plan(4, 5, 0)
        let peerVariant = runner.addVariant(peerSlots, "", work, system.environment(), ["/usr/bin/make", "-j1"])
        runner.addCheck(peerSlots, peerVariant, target)
        runner.addCheck(peerSlots, peerVariant, "check-after-peer")
        test.check(runner.run(peerSlots), "peer shards reserve all worker slots and preserve the runner process budget")
        test.removeTree(peerSlots.scratch)
    }
}
let timed = test.monitoredStart(["/bin/sh", "-c", "sleep 30 & wait"], system.environment(), "", work + "/timeout", 1)
let result = test.finish(timed, work + "/timeout")
test.check(result.status == 124, "timeout distinguished from test failure")
test.check(files.pathSize(work + "/timeout.cpu") > 0, "timeout CPU accounting retained")
let interrupted = test.monitoredStart(["/bin/sh", "-c", "sleep 30 & wait"], system.environment(), "", work + "/interrupt", 30)
let settle = system.spawn("/usr/bin/sleep", ["sleep", "0.1"], system.environment(), "")
test.check(settle > 0 && system.wait(settle).exitCode == 0, "wait for process-group setup")
let cancellationStarted = system.monotonicNanoseconds()
test.check(system.sendSignal(system.childProcessId(interrupted), 15) == 0, "cancel monitored process")
test.check(test.finish(interrupted, work + "/interrupt").status == 143, "cancellation forwards and reaps process group")
test.check((system.monotonicNanoseconds() - cancellationStarted) < 3000000000, "cancellation must terminate descendants promptly")
test.check(files.pathSize(work + "/interrupt.cpu") > 0, "cancellation CPU accounting retained")
test.removeTree(plan.scratch)
test.removeTree(barrier.scratch)
test.removeTree(resources.scratch)
test.removeTree(retries.scratch)
test.removeTree(work)
print("Minyar runner: passed")
