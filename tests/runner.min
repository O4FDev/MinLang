use "../tools/testing.min" as test
use "../tools/check-runner.min" as runner
use "system" as system
use "files" as files
let source = "# Files\n\n.PHONY: check-parent check-first check-second\n\ncheck-parent: check-first check-second | artifact\n\t@true\n\ncheck-first: artifact\n\t@true\n\ncheck-second: artifact\n\t@true\n\nartifact:\n\t@true\n\n# files hash-table stats:\n"
let rules = runner.database(source)
test.check(rules.length == 4, "make database rule count")
test.check(rules[runner.findRule(rules, "check-parent")].prerequisites.length == 3, "order-only prerequisite")
test.check(rules[runner.findRule(rules, "check-first")].phony, "phony declaration")
let work = test.scratch()
writeTextFile(work + "/Makefile", ".PHONY: check-parent check-first check-second FORCE\ncheck-parent: check-first check-second\n\t@test $$(wc -l < runs) -eq 2\ncheck-first: artifact\n\t@echo first >> runs; sleep 0.1\ncheck-second: artifact\n\t@echo second >> runs; sleep 0.1\nartifact:\n\t@echo build >> builds; touch artifact\nFORCE:\n")
let plan = runner.plan(2, 5, 0)
let variant = runner.addVariant(plan, "", work, system.environment(), ["/usr/bin/make", "-j1"])
test.check(fileExists(work + "/build"), "cold variant creates its build lock directory")
let parent = runner.addCheck(plan, variant, "check-parent")
runner.addCheck(plan, variant, "check-first")
test.check(plan.checks.length == 3 && plan.goals.length == 1, "deduplicate shared check and goal")
test.check(runner.run(plan), "parallel checks complete")
test.check(readTextFile(work + "/builds") == "build\n", "build runs once")
test.check(test.lines(readTextFile(work + "/runs")).length == 2, "each child executes once")
writeTextFile(work + "/Makefile", ".PHONY: check-build-barrier check-after-build FORCE\ncheck-build-barrier: build/one build/two\n\t@test -f build/one && test -f build/two\ncheck-after-build:\n\t@test -f build/one && test -f build/two\nbuild/one build/two:\n\t@sleep 0.1; touch $@\nFORCE:\n")
let barrier = runner.plan(2, 5, 0)
let barrierVariant = runner.addVariant(barrier, "", work, system.environment(), ["/usr/bin/make", "-j1"])
runner.addCheck(barrier, barrierVariant, "check-build-barrier")
runner.addCheck(barrier, barrierVariant, "check-after-build")
test.check(runner.run(barrier), "checks wait for the complete shared build before reading artifacts")
writeTextFile(work + "/Makefile", ".PHONY: check-resources check-quic-rfc check-quic-rfc-sanitize check-net-udp-offload check-modules check-sanitize-modules FORCE\ncheck-resources: check-quic-rfc check-quic-rfc-sanitize check-net-udp-offload check-modules check-sanitize-modules\ncheck-quic-rfc check-quic-rfc-sanitize:\n\t@mkdir fixed-resource; sleep 0.1; rmdir fixed-resource\ncheck-modules check-sanitize-modules:\n\t@mkdir module-output; sleep 0.1; rmdir module-output; echo ran >> module-runs\ncheck-net-udp-offload:\n\t@test ! -d fixed-resource && test ! -d module-output\nFORCE:\n")
let resources = runner.plan(2, 5, 0)
let resourceVariant = runner.addVariant(resources, "", work, system.environment(), ["/usr/bin/make", "-j1"])
runner.addCheck(resources, resourceVariant, "check-resources")
test.check(runner.run(resources), "fixed resources serialize and quiet checks exclude ordinary work")
test.check(readTextFile(work + "/module-runs") == "ran\nran\n", "split sanitizer module stage preserves both executions and excludes shared output races")
writeTextFile(work + "/Makefile", ".PHONY: check-retry check-flaky FORCE\ncheck-retry: check-flaky\n\t@test -f retried\ncheck-flaky:\n\t@if test -f retried; then exit 0; else touch retried; exit 1; fi\nFORCE:\n")
let retries = runner.plan(2, 5, 1)
let retryVariant = runner.addVariant(retries, "", work, system.environment(), ["/usr/bin/make", "-j1"])
runner.addCheck(retries, retryVariant, "check-retry")
test.check(runner.run(retries), "isolated retry reruns failed child and blocked aggregate")
writeTextFile(work + "/Makefile", ".PHONY: check-short-scratch FORCE\ncheck-short-scratch:\n\t@test $${#TMPDIR} -lt 60; test -L \"$$TMPDIR\"; printf kept > \"$$TMPDIR/artifact\"; printf '%s' \"$$TMPDIR\" > alias\nFORCE:\n")
let shortScratch = runner.plan(1, 5, 0)
let shortVariant = runner.addVariant(shortScratch, "", work, system.environment(), ["/usr/bin/make", "-j1"])
runner.addCheck(shortScratch, shortVariant, "check-short-scratch")
test.check(runner.run(shortScratch), "scratch aliases fit Unix socket paths")
test.check(readTextFile(shortScratch.scratch + "/tmp-1/artifact") == "kept", "private scratch evidence remains in the retained run")
test.check(!fileExists(readTextFile(work + "/alias")), "completed scratch alias removed")
test.removeTree(shortScratch.scratch)
let timed = test.monitoredStart(["/bin/sh", "-c", "sleep 30 & wait"], system.environment(), "", work + "/timeout", 1)
let result = test.finish(timed, work + "/timeout")
test.check(result.status == 124, "timeout distinguished from test failure")
test.check(files.pathSize(work + "/timeout.cpu") > 0, "timeout CPU accounting retained")
let interrupted = test.monitoredStart(["/bin/sh", "-c", "sleep 30 & wait"], system.environment(), "", work + "/interrupt", 30)
let settle = system.spawn("/usr/bin/sleep", ["sleep", "0.1"], system.environment(), "")
test.check(settle > 0 && system.wait(settle).exitCode == 0, "wait for process-group setup")
let cancellationStarted = system.monotonicNanoseconds()
test.check(system.sendSignal(system.childProcessId(interrupted), 15) == 0, "cancel monitored process")
test.check(test.finish(interrupted, work + "/interrupt").status == 143, "cancellation forwards and reaps process group")
test.check((system.monotonicNanoseconds() - cancellationStarted) < 3000000000, "cancellation must terminate descendants promptly")
test.check(files.pathSize(work + "/interrupt.cpu") > 0, "cancellation CPU accounting retained")
test.removeTree(plan.scratch)
test.removeTree(barrier.scratch)
test.removeTree(resources.scratch)
test.removeTree(retries.scratch)
test.removeTree(work)
print("Minyar runner: passed")
