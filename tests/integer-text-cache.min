use "../tools/testing.min" as test
use "system" as system
function starts(source: Text, prefix: Text): Boolean {
    let raw = Bytes(source)
    let pattern = Bytes(prefix)
    if raw.length < pattern.length { return false }
    for index in 0..pattern.length { if raw[index] != pattern[index] { return false } }
    return true
}
function environment(): List<Text> {
    let values: List<Text> = []
    for entry in system.environment() {
        if !starts(entry, "ASAN_OPTIONS=") && !starts(entry, "UBSAN_OPTIONS=") { values.add(entry) }
    }
    values.add("ASAN_OPTIONS=detect_leaks=0:halt_on_error=1")
    values.add("UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=0")
    return values
}
function profile(name: Text): List<Text> {
    if name == "eager" { return [] }
    if name == "system" { return ["-DMINYAR_SYSTEM_HEAP=1"] }
    if name == "fixed" { return ["-DMINYAR_BOUNDED_HEAP=1"] }
    return ["-DMINYAR_BOUNDED_HEAP=1", "-DMINYAR_LAZY_HEAP=1"]
}
function checkCase(clang: Text, work: Text, name: Text, limit: Integer, sanitize: Boolean, minimum: Boolean) {
    let command = [clang, "-std=c11", "-O2"]
    for flag in profile(name) { command.add(flag) }
    if minimum { command.add("-DMINYAR_BOUNDED_HEAP_BYTES=4096") }
    command.add("-DMINYAR_INTEGER_TEXT_CACHE_LIMIT=" + Text(limit))
    command.add("-DEXPECTED_CACHE_LIMIT=" + Text(limit))
    if sanitize { command.add("-fsanitize=address,undefined") }
    let executable = work + "/case"
    for item in ["tests/integer-text-cache.c", "-lm", "-o", executable] { command.add(item) }
    test.require(test.run(command, system.environment(), "", work + "/build", 60), "build Integer Text cache " + name + " " + Text(limit))
    test.require(test.run([executable], environment(), "", work + "/run", 30), "Integer Text cache " + name + " " + Text(limit))
}
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let index = 0
while index < argumentCount() {
    let value = argument(index)
    if value == "--clang" {
        test.check(index + 1 < argumentCount(), "--clang needs a value")
        clang = argument(index + 1); index += 1
    } else if starts(value, "--clang=") { clang = Text(Bytes(value).slice(8, Bytes(value).length)) }
    else { fail("unknown integer cache option " + value) }
    index += 1
}
let work = test.scratch()
for limit in [0, 1, 42, 43, 256, 32768] {
    for name in ["eager", "system", "fixed", "lazy"] {
        for sanitize in [false, true] { checkCase(clang, work, name, limit, sanitize, false) }
    }
    print("cache limit " + Text(limit) + ": all four profiles passed natively and with sanitizers")
}
for name in ["fixed", "lazy"] {
    for sanitize in [false, true] { checkCase(clang, work, name, 0, sanitize, true) }
}
print("Zero-cache conversion also passed with 4 KiB fixed and lazy pools.")
for limit in [-1, 32769] {
    let result = test.run([clang, "-std=c11", "-DMINYAR_INTEGER_TEXT_CACHE_LIMIT=" + Text(limit), "-c", "runtime/minyar_runtime.c", "-o", work + "/invalid.o"], system.environment(), "", work + "/invalid", 60)
    test.check(result.status != 0 && test.contains(result.errorOutput, "static assertion failed"), "invalid cache limit was not statically rejected")
    test.check(test.contains(result.errorOutput, "Integer Text cache limit must be between"), "invalid cache limit diagnostic")
}
let zero = work + "/zero.o"
test.require(test.run([clang, "-O2", "-DMINYAR_INTEGER_TEXT_CACHE_LIMIT=0", "-c", "runtime/minyar_runtime.c", "-o", zero], system.environment(), "", work + "/zero-build", 60), "compile zero-cache runtime")
let symbols = test.run(["nm", zero], system.environment(), "", work + "/symbols", 30)
test.require(symbols, "list zero-cache symbols")
test.check(!test.contains(symbols.output, "integer_cache"), "zero limit retained the cache table")
test.removeTree(work)
print("Invalid limits rejected; zero limit has no cache table.")
