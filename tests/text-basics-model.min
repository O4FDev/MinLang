use "../tools/testing.min" as test
use "./text-basics-oracles.min" as oracle
use "system" as system

function engineSource(): Text {
    let engine = readTextFile("runtime/minyar_runtime.c")
    for header in ["minyar_rc.h", "minyar_collections.h"] {
        let replacement = "minyar_cycle_rc.h"
        if header == "minyar_collections.h" { replacement = "minyar_cycle_collections.h" }
        let directive = "#include \"" + header + "\""
        test.check(engine.byteLength - test.replace(engine, directive, "").byteLength == directive.byteLength, "managed graph runtime requires exactly one ownership header")
        engine = test.replace(engine, directive, "#include \"" + replacement + "\"")
    }
    return "#define MINYAR_SORT_GRAPH 1\n#define MINYAR_MAP_CYCLE_RUNTIME 1\n#if defined(__GNUC__) || defined(__clang__)\n#define MINYAR_NOINLINE __attribute__((noinline))\n#else\n#define MINYAR_NOINLINE\n#endif\n" + engine + "\n#include \"minyar_callbacks.h\"\n"
}

function setting(environment: List<Text>, name: Text, value: Text): List<Text> {
    let result: List<Text> = []
    let prefix = name + "="
    for entry in environment {
        let raw = Bytes(entry)
        if raw.length < prefix.byteLength || Text(raw.slice(0, prefix.byteLength)) != prefix { result.add(entry) }
    }
    result.add(prefix + value)
    return result
}

record Profile { name: Text; defines: List<Text> }
function check(executable: Text, environment: List<Text>, work: Text): Integer {
    let corpus = readTextFile("tests/text-basics-model-cases.tsv")
    let pairs = test.lines(corpus)
    test.check(pairs.length == 581, "seeded Text model corpus changed")
    writeTextFile(work + "/input", corpus)
    let result = test.run(["/bin/sh", "-c", "exec \"$1\" <\"$2\"", "minyar", executable, work + "/input"], environment, "", work + "/model", 30)
    test.require(result, "Text model stream")
    let actual = test.lines(result.output)
    test.check(actual.length == pairs.length, "Text model output row count changed")
    for index in 0..pairs.length {
        let operands = test.words(pairs[index])
        test.check(operands.length == 2, "invalid Text model corpus row")
        let expected = oracle.textModel(operands[0], operands[1])
        test.check(actual[index] == expected, "Text model disagreement at " + Text(index) + "\n" + actual[index] + "\n" + expected)
    }
    let valid = ["0", "-0", "+0", Text(oracle.fromHex("20090d0a0b0c2d34322009")), "00042", "-9223372036854775808", "9223372036854775807", "+9223372036854775807"]
    for source in valid {
        result = test.run([executable, "integer", oracle.hex(Bytes(source)), ""], environment, "", work + "/integer", 10)
        test.check(result.status == 0 && result.output == oracle.integerModel(Bytes(source)) + "\n", "valid Integer model failed\n" + result.errorOutput)
    }
    let invalid = ["", " ", "+", "-", "1x", "1 2", "0x2a", "1_000", "１２", Text(oracle.fromHex("c2a031")), Text(oracle.fromHex("3100")), "9223372036854775808", "-9223372036854775809"]
    let huge = ""
    for index in 0..100 { huge += "9" }
    invalid.add(huge)
    for source in invalid {
        result = test.run([executable, "integer", oracle.hex(Bytes(source)), ""], environment, "", work + "/integer", 10)
        test.check(result.status == 1 && test.contains(result.errorOutput, "Integer"), "invalid Integer model accepted\n" + result.errorOutput)
    }
    for bad in ["80", "c080", "eda080", "f4908080", "e282", "f0808080", "61ff"] {
        for operation in ["find", "starts", "ends", "split", "trim", "integer"] {
            let left = [bad]
            let right = [""]
            if operation != "trim" && operation != "integer" { left.add(""); right.add(bad); left.add("61"); right.add("6162" + bad) }
            for index in 0..left.length {
                result = test.run([executable, operation, left[index], right[index]], environment, "", work + "/malformed", 10)
                test.check(result.status == 1 && test.contains(result.errorOutput, "invalid UTF-8"), "malformed UTF-8 escaped " + operation + " validation\n" + result.errorOutput)
            }
        }
    }
    return pairs.length
}

let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let quick = false
let cycles = false
let budget = 32
let prebuilt = ""
let optionIndex = 0
while optionIndex < argumentCount() {
    let option = argument(optionIndex)
    if option == "--quick" { quick = true }
    else if option == "--cycles" { cycles = true }
    else if option == "--clang" || option == "--budget" || option == "--executable" {
        test.check(optionIndex + 1 < argumentCount(), "missing Text model option value")
        optionIndex += 1
        if option == "--clang" { clang = argument(optionIndex) } else if option == "--executable" { prebuilt = argument(optionIndex) } else { budget = Integer(argument(optionIndex)) }
    } else { fail("unknown Text model option: " + option) }
    optionIndex += 1
}
test.check(budget == 1 || budget == 32, "unsupported Text model poll budget")
let profiles = [
    Profile { name: "system"; defines: ["-DMINYAR_SYSTEM_HEAP=1"] },
    Profile { name: "eager"; defines: [] },
    Profile { name: "fixed"; defines: ["-DMINYAR_BOUNDED_HEAP=1"] },
    Profile { name: "lazy"; defines: ["-DMINYAR_BOUNDED_HEAP=1", "-DMINYAR_LAZY_HEAP=1"] },
    Profile { name: "arena"; defines: ["-DMINYAR_COMPILER_ARENA=1"] }
]
if quick { profiles = [profiles[0]] }
let environment = setting(system.environment(), "ASAN_OPTIONS", "detect_leaks=0:halt_on_error=1")
environment = setting(environment, "UBSAN_OPTIONS", "halt_on_error=1")
let work = test.scratch()
if prebuilt != "" {
    print(Text(check(prebuilt, environment, work)) + " models, parsing and malformed UTF-8 passed")
    test.removeTree(work)
    exit(0)
}
let engine = work + "/managed-graphs-engine.c"
if cycles { writeTextFile(engine, engineSource()) }
let source = work + "/text-basics.c"
let harness = test.replace(readTextFile("tests/text-basics.c"), "#include \"../runtime/minyar_runtime.c\"", "#include \"minyar_runtime.c\"")
harness = test.replace(harness, "#include \"../build/managed-graphs-engine.c\"", "#include \"" + engine + "\"")
writeTextFile(source, harness)
let modes = [false, true]
if quick { modes = [false] }
for profile in profiles {
    for sanitize in modes {
        let executable = work + "/" + profile.name + "-" + Text(sanitize)
        let command = [clang, "-std=c11", "-O1", "-Iruntime", "-DMINYAR_RC_POLL_BUDGET=" + Text(budget)]
        for define in profile.defines { command.add(define) }
        if cycles { command.add("-DTEXT_TEST_CYCLES=1") }
        if sanitize { command.add("-fsanitize=address,undefined") }
        for item in [source, "-o", executable, "-lm"] { command.add(item) }
        test.require(test.run(command, system.environment(), "", executable + ".build", 60), "Text model fixture compile")
        let count = check(executable, environment, work)
        print(profile.name + " sanitize=" + Text(sanitize) + " cycles=" + Text(cycles) + " budget=" + Text(budget) + ": " + Text(count) + " models, parsing, malformed UTF-8 and ownership passed")
    }
}
test.removeTree(work)
