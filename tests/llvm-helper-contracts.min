use "io" as io
use "../tools/testing.min" as test
use "system" as system

function body(llvm: Text, name: Text): Text {
    let active = false
    let result: List<Text> = []
    for line in test.lines(llvm) {
        if line.startsWith("define ") && test.contains(line, " @" + name + "(") { active = true }
        if active {
            result.add(line + "\n")
            if line == "}" { return joinText(result) }
        }
    }
    fail("missing LLVM helper: " + name)
}

// Loads of the first parameter's values pointer inside the loop: after the
// first loop block label in O2 layout order.
function loopValuesLoads(optimized: Text, name: Text): Integer {
    let loads = 0
    let looping = false
    for line in test.lines(body(optimized, ".minyar.fn." + name)) {
        if line.startsWith("for.body.") || line.startsWith("for.condition.") { looping = true }
        if looping && test.contains(line, " = load ptr, ptr %argument.0,") { loads += 1 }
    }
    return loads
}

let compiler = test.compiler()
let contract = test.replace(io.readTextFile("tests/memory-contracts-runtime.c"), "#include \"../runtime/minyar_runtime.c\"", io.readTextFile("runtime/minyar_runtime.c"))
io.writeTextFile(compiler.directory + "/runtime.c", contract)
compiler.runtime = compiler.directory + "/runtime.o"
let build = [compiler.clang, "-O1", "-DMINYAR_SYSTEM_HEAP=1", "-iquote", "runtime"]
for flag in compiler.flags { build.add(flag) }
for item in ["-c", compiler.directory + "/runtime.c", "-o", compiler.runtime] { build.add(item) }
test.require(test.run(build, system.environment(), "", compiler.directory + "/runtime", 120), "build helper ownership oracle")

// Headers stay live when empty. Length is mutable through another alias, and
// overlapping, shifted C-layout views retain the same backing bytes.
test.executes(compiler, #"""
function grow(bytes: Bytes, values: List<Integer>) { bytes.add(65); values.add(42) }
record Window native "c_packed" { data: Bytes[2] }
let bytes = Bytes(0)
let values: List<Integer> = []
print(bytes.length); print(values.length)
grow(bytes, values)
print(bytes.length); print(values.length); print(bytes[0]); print(values[0])
values[0] = 43; print(values[0])
let backing = Bytes(4)
let first = cBytes(cView(Window, backing, 0))
let shifted = cBytes(cView(Window, backing, 1))
first[1] = 77
print(shifted[0]); shifted[1] = 88; print(backing[2])
"""#, "0\n0\n1\n1\n65\n42\n43\n77\n88\n")
let path = compiler.directory + "/case" + Text(compiler.serial)
let llvm = io.readTextFile(path + ".ll")
for name in ["bytes", "list"] {
    let length = body(llvm, ".minyar." + name + ".length")
    for attribute in ["nonnull", "captures(none)", "dereferenceable(16)", "nofree", "nosync", "nounwind", "willreturn", "memory(argmem: read)"] {
        test.check(test.contains(length, attribute), name + " length missing contract: " + attribute)
    }
    test.check(!test.contains(length, "noalias") && !test.contains(length, "invariant.load"), "mutable headers must keep aliasing and mutation")
    test.check(test.contains(length, "!range !{i64 0, i64 -9223372036854775808}"), "length range must stay nonnegative")
}
for name in ["bytes.get.checked", "bytes.set.checked", "list.get.checked", "list.set.scalar.checked", "list.get.known", "list.set.scalar.known", "list.get.known.offset", "list.set.scalar.known.offset", "shift.checked", "character.checked", "float.integer.checked", "integer.absolute.checked", "clamp.integer.checked", "clamp.float.checked"] {
    let helper = body(llvm, ".minyar." + name)
    test.check(test.contains(helper, "label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}"), name + " must mark only the failure successor unlikely")
    // A reporting path may do I/O or terminate. Pure-reader attributes belong
    // only on the two call-free length functions.
    for attribute in ["memory(", "nofree", "nosync", "willreturn"] {
        test.check(!test.contains(helper, attribute), name + " overstates failure-path effects: " + attribute)
    }
}
for name in ["integer.overflow.checked", "integer.division.checked"] {
    test.check(test.contains(body(llvm, ".minyar." + name), "label %bad, label %good, !prof !{!\"branch_weights\", !\"expected\", i32 1, i32 2000}"), name + " has reversed trap successors")
}
let append = body(llvm, ".minyar.bytes.add.checked")
test.check(!test.contains(append, "!prof"), "ordinary append growth must not inherit a trap likelihood")
for name in ["bytes.get.checked", "bytes.set.checked", "list.get.checked", "list.set.scalar.checked"] {
    let helper = body(llvm, ".minyar." + name)
    let storage = "%data = load ptr, ptr %bytes, !nonnull !{}\n"
    if name.startsWith("list.") { storage = "%values = load ptr, ptr %list, !nonnull !{}, !tbaa " }
    test.check(test.contains(helper, "good:\n  " + storage), name + " must expose storage only in its successful block")
    test.check(!test.contains(helper, "dereferenceable(") && !test.contains(helper, "!alias.scope"), name + " must preserve native-view aliasing")
    // Bytes may be shifted native views and stay untagged. List headers, List
    // slots and record fields are distinct Minyar objects, tagged in their own
    // TBAA tree; runtime C uses another tree, which LLVM treats as may-alias.
    if name.startsWith("bytes.") { test.check(!test.contains(helper, "!tbaa"), name + " must not claim type-based aliasing") }
    else {
        test.check(test.contains(helper, "%length = load i64, ptr %length.pointer, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}"), name + " must tag the List length")
        test.check(test.contains(helper, "%values = load ptr, ptr %list, !nonnull !{}, !tbaa !{!{!\"minyar list header\""), name + " must tag the List values pointer")
        test.check(test.contains(helper, "ptr %slot, !tbaa !{!{!\"minyar list slot\", !{!\"minyar\"}, i64 0}"), name + " must tag the List slot")
    }
}
for name in ["record.get", "record.set.scalar"] {
    test.check(test.contains(body(llvm, ".minyar." + name), "ptr %slot, !tbaa !{!{!\"minyar record field\", !{!\"minyar\"}, i64 0}"), name + " must tag the record field")
}
test.check(test.contains(body(llvm, ".minyar.list.length"), "!tbaa !{!{!\"minyar list header\""), "List length must tag the header")

// The tags let O2 keep a List length across a record field or List slot store;
// a Bytes store (untagged) still forces the reload.
let alias = #"""
record P { x: Integer }
function field(p: P, xs: List<Integer>): Integer { let a = xs.length; p.x = 5; return a + xs.length }
function slot(xs: List<Integer>): Integer { let a = xs.length; xs[0] = 7; return a + xs.length }
function raw(b: Bytes): Integer { let a = b.length; b[0] = 7; return a + b.length }
print(field(P { x: 1 }, [1, 2])); print(slot([1, 2])); print(raw(Bytes(2)))
"""#
test.executes(compiler, alias, "4\n4\n4\n")
let aliasPath = compiler.directory + "/case" + Text(compiler.serial)
let optimize = [compiler.clang, "-O2", "-Wno-override-module", "-S", "-emit-llvm"]
for flag in compiler.flags { optimize.add(flag) }
for item in [aliasPath + ".ll", "-o", aliasPath + ".optimized.ll"] { optimize.add(item) }
test.require(test.run(optimize, system.environment(), "", aliasPath + ".optimize", compiler.linkTimeout), "optimize alias probe")
let optimized = io.readTextFile(aliasPath + ".optimized.ll")
// Sanitizer builds instrument every access, so only plain builds count loads.
if compiler.flags.length == 0 { for probe in [["field", "1"], ["slot", "1"], ["raw", "2"]] {
    let loads = 0
    for line in test.lines(body(optimized, ".minyar.fn." + probe[0])) { if test.contains(line, " = load i64, ptr ") { loads += 1 } }
    test.check(Text(loads) == probe[1], probe[0] + ": expected " + probe[1] + " length loads at O2, found " + Text(loads))
} }

// A parallel function cannot resize a buffer and its caller waits for it, so
// it loads each List parameter's length and values pointer once at entry and
// indexes through them. The ordinary function with the same body reloads the
// header inside the loop (negative control). A function without a loop keeps
// reading the header where it indexes. A failing index still reports the
// List's own position and length at O0 and O2.
let headers = #"""
parallel function pick(source: List<Integer>, out: List<Integer>, limit: Integer) {
    for k in 0..out.length {
        if source[k % 3] > limit { out[k] = source[k % 3] } else { out[k] = source[(k + 1) % 3] }
    }
}
function plainPick(source: List<Integer>, out: List<Integer>, limit: Integer) {
    for k in 0..out.length {
        if source[k % 3] > limit { out[k] = source[k % 3] } else { out[k] = source[(k + 1) % 3] }
    }
}
parallel function fetch(values: List<Integer>, position: Integer): Integer {
    let total = 0
    for k in 0..2 { total += values[position - k] }
    return total + values.length
}
parallel function first(values: List<Integer>): Integer { return values[0] }
let source = [5, 1, 9]
let out = [0, 0, 0, 0, 0]
let plain = [0, 0, 0, 0, 0]
pick(source, out, 4)
plainPick(source, plain, 4)
for k in 0..out.length { print(out[k] * 10 + plain[k]) }
print(fetch(source, 2))
print(first(source))
"""#
test.executes(compiler, headers, "55\n99\n99\n55\n99\n13\n5\n")
let headersPath = compiler.directory + "/case" + Text(compiler.serial)
let headersIr = io.readTextFile(headersPath + ".ll")
let picked = body(headersIr, ".minyar.fn.pick")
test.check(test.contains(picked, "%argument.0.length = load i64, ptr %argument.0.length.pointer, !tbaa ") && test.contains(picked, "%argument.0.values = load ptr, ptr %argument.0, !tbaa "), "a parallel function must load its List parameter's header at entry")
test.check(test.contains(picked, "@.minyar.list.get.known(ptr %argument.0, i64 %argument.0.length, ptr %argument.0.values, i64 ") && !test.contains(picked, "@.minyar.list.get.checked(ptr %argument.0,"), "a parallel function must index its List parameter through the loaded header")
test.check(test.contains(body(headersIr, ".minyar.fn.plainPick"), "@.minyar.list.get.checked(ptr %argument.0,"), "an ordinary function must keep reading the header at each index")
test.check(test.contains(body(headersIr, ".minyar.fn.fetch"), " = add i64 %argument.0.length, 0"), "a parallel function must measure its List parameter with the loaded length")
// Without a loop the header is read where it is used.
test.check(test.contains(body(headersIr, ".minyar.fn.first"), "@.minyar.list.get.checked(ptr %argument.0,"), "a loop-free parallel function must keep reading the header at its index")
let headersOptimize = [compiler.clang, "-O2", "-Wno-override-module", "-S", "-emit-llvm"]
for flag in compiler.flags { headersOptimize.add(flag) }
for item in [headersPath + ".ll", "-o", headersPath + ".optimized.ll"] { headersOptimize.add(item) }
test.require(test.run(headersOptimize, system.environment(), "", headersPath + ".optimize", compiler.linkTimeout), "optimize parallel header probe")
let headersOptimized = io.readTextFile(headersPath + ".optimized.ll")
if compiler.flags.length == 0 {
    let picks = loopValuesLoads(headersOptimized, "pick")
    test.check(picks == 0, "pick: expected no values-pointer load of its source inside the loop at O2, found " + Text(picks))
    let plainPicks = loopValuesLoads(headersOptimized, "plainPick")
    test.check(plainPicks > 0, "plainPick: the negative control no longer reloads its source header inside the loop; this probe needs a new control")
}
test.require(test.compile(compiler, "parallel function fetch(values: List<Integer>, position: Integer): Integer {\n    let total = 0\n    for k in 0..2 { total += values[position - k] }\n    return total\n}\nprint(fetch([7, 8, 9], 5))\n"), "compile failing parallel index")
test.check(test.contains(io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll"), "@.minyar.list.get.known(ptr %argument.0,"), "the failing parallel index must use the loaded header")
let failingPath = compiler.directory + "/case" + Text(compiler.serial)
for optimization in ["-O0", "-O2"] {
    let command = [compiler.clang, optimization, "-Wno-override-module"]
    for flag in compiler.flags { command.add(flag) }
    for item in [failingPath + ".ll", compiler.runtime, "-lm", "-o", failingPath + ".exe"] { command.add(item) }
    test.require(test.run(command, system.environment(), "", failingPath + ".link", compiler.linkTimeout), "link failing parallel index")
    let result = test.run([failingPath + ".exe"], system.environment(), "", failingPath + ".run", compiler.runTimeout)
    test.check(result.status == 1 && result.output == "", "failing parallel index must stop with status 1 at " + optimization)
    test.check(test.contains(result.errorOutput, "List position 5 is outside its length of 3."), "failing parallel index changed its diagnostic at " + optimization + "\n" + result.errorOutput)
}

// In such a function an index `base + c` or `base - c` (small constant c) used
// only by one access is summed without an overflow branch: an overflowing sum
// is outside every List, and the failure path tests the overflow again, so each
// error is reported as before. A sum used twice keeps its checked addition.
let offsets = #"""
parallel function shift(values: List<Integer>, out: List<Integer>, start: Integer) {
    for k in 0..out.length { out[k + 0] = values[start + k + 1] - values[start + k - 1] }
}
parallel function twice(values: List<Integer>, start: Integer): Integer {
    let total = 0
    for k in 0..1 { let at = start + 1; total += values[at] + at }
    return total
}
parallel function edge(values: List<Integer>, start: Integer, step: Integer): Integer {
    let total = 0
    for k in 0..1 { total += values[start + step] }
    return total
}
let values = [1, 4, 9, 16, 25]
let out = [0, 0, 0]
shift(values, out, 1)
print(out[0]); print(out[1]); print(out[2])
print(twice(values, 2))
print(edge(values, 1, 1))
"""#
test.executes(compiler, offsets, "8\n12\n16\n19\n9\n")
let offsetsIr = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
let shifted = body(offsetsIr, ".minyar.fn.shift")
test.check(test.contains(shifted, "@.minyar.list.get.known.offset(ptr %argument.0, i64 %argument.0.length, ptr %argument.0.values, i64 ") && test.contains(shifted, ", i64 1)") && test.contains(shifted, ", i64 -1)"), "an index plus or minus a constant must fuse into the known-header access")
test.check(test.contains(shifted, "@.minyar.list.set.scalar.known.offset(ptr %argument.1, i64 %argument.1.length, ptr %argument.1.values, i64 "), "a stored index plus a constant must fuse into the known-header store")
test.check(!test.contains(body(offsetsIr, ".minyar.fn.twice"), ".known.offset("), "a sum used twice must keep its checked addition")
test.check(!test.contains(body(offsetsIr, ".minyar.fn.edge"), ".known.offset("), "a sum of two variables must keep its checked addition")
// The three failures of a fused index, at O0 and O2: past the end, overflow
// upward, overflow downward.
for failure in [["print(probe([7, 8, 9], 2, 1))", "List position 3 is outside its length of 3."], ["print(probe([7, 8, 9], 9223372036854775807, 1))", "this Integer calculation is outside the supported range."], ["print(probe([7, 8, 9], -9223372036854775808, -1))", "this Integer calculation is outside the supported range."], ["print(probe([7, 8, 9], 0, -1))", "List position -1 is outside its length of 3."]] {
    let program = "parallel function probe(values: List<Integer>, start: Integer, sign: Integer): Integer {\n    let total = 0\n    for k in 0..1 { if sign > 0 { total += values[start + 1] } else { total += values[start - 1] } }\n    return total\n}\n" + failure[0] + "\n"
    test.require(test.compile(compiler, program), "compile fused index failure")
    let probePath = compiler.directory + "/case" + Text(compiler.serial)
    test.check(test.contains(io.readTextFile(probePath + ".ll"), ".known.offset("), "the failing index must be fused")
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization, "-Wno-override-module"]
        for flag in compiler.flags { command.add(flag) }
        for item in [probePath + ".ll", compiler.runtime, "-lm", "-o", probePath + ".exe"] { command.add(item) }
        test.require(test.run(command, system.environment(), "", probePath + ".link", compiler.linkTimeout), "link fused index failure")
        let result = test.run([probePath + ".exe"], system.environment(), "", probePath + ".run", compiler.runTimeout)
        test.check(result.status == 1 && result.output == "", "fused index failure must stop with status 1 at " + optimization)
        test.check(test.contains(result.errorOutput, failure[1]), "fused index failure changed its diagnostic at " + optimization + "\n" + result.errorOutput)
    }
}

// Verify the actual emitted module independently of execution and optimization.
test.require(test.run([compiler.clang, "-Wno-override-module", "-c", path + ".ll", "-o", path + ".verify.o"], system.environment(), "", path + ".verify", compiler.linkTimeout), "verify helper attributes and metadata")
test.removeTree(compiler.directory)
print("LLVM helper contracts: passed")
