function sample(source: Text, index: Integer): Maybe<Text> {
    if index % 2 == 0 { return Some(source) }
    return None
}
let source = "pre" + "allocated"
let values: List<Maybe<Text>> = []
for index in 0..10000 { values.add(sample(source, index)) }
source = "rebound"
let total = 0
for value in values { total += match value { Some(item) { item.length } None { 0 } } }
print(total)
