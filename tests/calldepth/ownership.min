use "calldepth" as depth
use "errors" as errors
record State { calls: Integer; text: Text }
record Box { text: Text; number: Integer }
function deep(): Integer { return deep() }
function deepText(): Text { return deepText() }
function deepBox(): Box { return deepBox() }
function deepList(): List<Text> { return deepList() }
function freshText(): Text { return "fresh" + " text" }
function sink(first: Integer, second: Integer): Integer { return first + second }
function later(state: State): Integer { state.calls = state.calls + 1; return 1 }
let state = State { calls: 0; text: freshText() }
let index = 0
while index < 20 {
    let argument = depth.run(10, function(): Integer { return sink(deep(), later(state)) })
    let list = depth.run(10, function(): Integer { let values = [freshText(), deepText()]; state.calls = 1; return values.length })
    let record = depth.run(10, function(): Integer { let box = Box { text: freshText(); number: deep() }; state.calls = 1; return box.number })
    let concat = depth.run(10, function(): Integer { let text = freshText() + deepText(); state.calls = 1; return text.length })
    let projection = depth.run(10, function(): Integer { return deepBox().number })
    let slice = depth.run(10, function(): Integer { return deepText().slice(0, 1).length })
    let appended = depth.run(10, function(): Integer { let words = [freshText()]; let copy = words.appended(deepText()); return copy.length })
    let indirect = depth.run(10, function(): Integer {
        let callback: Callback<Text> = function(): Text { return deepText() }
        let text = callback().slice(0, 1)
        return text.length
    })
    let borrowed = depth.run(10, function(): Integer {
        let saved = state.text
        let data = Bytes(128)
        let answer = deep()
        state.text = saved + Text(data)
        return answer
    })
    if errors.integerOk(argument) || errors.integerOk(list) || errors.integerOk(record) || errors.integerOk(concat) || errors.integerOk(projection) || errors.integerOk(slice) || errors.integerOk(appended) || errors.integerOk(indirect) || errors.integerOk(borrowed) { fail("recovery failure was lost") }
    index = index + 1
}
print(state.calls)
print(state.text)
let ok = depth.run(2, function(): Integer { let data = Bytes(3); return data.length })
print(errors.integerValue(ok))
