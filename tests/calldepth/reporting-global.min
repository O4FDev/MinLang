use "calldepth" as depth
use "errors" as errors
record State { ran: Integer; saved: errors.IntegerResult }
let state = State { ran: 0; saved: depth.run(0, function(): Integer { return 0 }) }
let outer = depth.run(100, function(): Integer {
    state.saved = depth.run(100, function(): Integer { state.ran = 1; return 99 })
    return 17
})
print(errors.depthTestCode(state.saved))
print(errors.depthTestValue(outer))
print(state.ran)
let good = depth.run(1, function(): Integer { return 42 })
print(errors.depthTestValue(good))
print("alive")
