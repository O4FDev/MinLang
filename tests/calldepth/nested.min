use "calldepth" as depth
use "errors" as errors
function recursive(): Integer { return recursive() }
let outer = depth.run(8, function(): Integer {
    let before = depth.remaining()
    let inner = depth.run(1000000, function(): Integer { return recursive() })
    if errors.integerOk(inner) { fail("parent cap was bypassed") }
    let after = depth.remaining()
    if before != after { fail("inner scope leaked depth") }
    let exact = depth.run(1, function(): Integer { return depth.remaining() })
    if errors.integerValue(exact) != 0 { fail("root callback was not counted") }
    return after
})
print(errors.integerValue(outer))
print(depth.remaining())
