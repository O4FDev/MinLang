use "calldepth" as depth
use "errors" as errors
record Counter { calls: Integer }
function deep(): Integer { return deep() }
function down(count: Integer): Integer {
    if count == 0 { return 0 }
    return down(count - 1)
}
function probe(limit: Integer): Integer {
    let attempt = depth.run(limit, function(): Integer { return LATE.length })
    if errors.integerOk(attempt) { return 1 }
    return 0
}
constant UNWOUND: Integer = probe(4)
constant REJECTED: Integer = probe(1)
constant LATE: List<Integer> = [down(20) + 5]
print(UNWOUND)
print(REJECTED)
print(LATE[0])
let counter = Counter { calls: 0 }
let values = [3, 1, 2]
let compare: Callback<Integer, Integer, Integer> = function(a: Integer, b: Integer): Integer { return a - b + deep() }
let copied = depth.run(8, function(): Integer {
    let copy = values.sortedBy(compare)
    counter.calls = counter.calls + 1
    return copy.length
})
let sorted = depth.run(8, function(): Integer {
    values.sortBy(compare)
    counter.calls = counter.calls + 1
    return values.length
})
print(errors.integerOk(copied))
print(errors.integerOk(sorted))
print(counter.calls)
let ordered = depth.run(8, function(): Integer {
    let ascending: Callback<Integer, Integer, Integer> = function(a: Integer, b: Integer): Integer { return down(2) + a - b }
    values.sortBy(ascending)
    return values[0]
})
print(errors.integerValue(ordered))
