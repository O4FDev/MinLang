use "calldepth" as depth
use "errors" as errors
record State { calls: Integer }
function value(): Integer { return 42 }
let state = State { calls: 0 }
print(depth.remaining())
let one = depth.run(1, function(): Integer { return depth.remaining() })
print(errors.integerValue(one))
let zero = depth.run(0, function(): Integer { state.calls = state.calls + 1; return 1 })
let negative = depth.run(-10, function(): Integer { state.calls = state.calls + 1; return 1 })
print(errors.code(errors.integerError(zero)))
print(errors.code(errors.integerError(negative)))
print(state.calls)
let tooSmall = depth.run(1, function(): Integer { return value() })
print(errors.integerOk(tooSmall))
let exact = depth.run(2, function(): Integer { return value() })
print(errors.integerValue(exact))
let index = 0
while index < 100 {
    let failed = depth.run(1, function(): Integer { return value() })
    if errors.integerOk(failed) { fail("limit failure was lost") }
    index = index + 1
}
print(depth.remaining())
