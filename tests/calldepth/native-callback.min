use "calldepth" as depth
use "errors" as errors
function deepNative(): Text { return deepNative() }
function bounce(): Text { native "depthtest" }
let failure = depth.run(5, function(): Integer { return bounce().slice(0, 1).length })
print(errors.integerOk(failure))
let success = depth.run(1, function(): Integer { return 42 })
print(errors.integerValue(success))
