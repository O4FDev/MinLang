use "calldepth" as depth
use "errors" as errors
record State { calls: Integer }
let state = State { calls: 0 }
let success = depth.run(1, function(): Integer {
    let inner = depth.run(100, function(): Integer { state.calls = 1; return 99 })
    // The parent has zero remaining frames. Inner failure reporting must not
    // poison that parent or consume its exhausted logical capacity.
    return 17
})
print(errors.integerValue(success))
print(state.calls)
print(depth.remaining())
