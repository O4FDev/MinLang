use "calldepth" as calldepth
use "errors" as errors

function nest(n: Integer): Integer {
    if n == 0 { return 0 }
    return 1 + nest(n - 1)
}

let failed = calldepth.run(1024, function(): Integer { return nest(1000000) })
if errors.code(errors.integerError(failed)) != 14 { fail("G14 must report call-depth error 14") }
print(errors.integerOk(failed))
let success = calldepth.run(1024, function(): Integer { return nest(1000) })
print(errors.integerOk(success))
print(errors.integerValue(success))
print("alive")
