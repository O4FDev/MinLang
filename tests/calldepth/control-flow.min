use "calldepth" as depth
use "errors" as errors
function recursive(): Boolean { return recursive() }
function yes(): Boolean { return true }
parallel function recurse(n: Integer): Integer {
    if n == 0 { return 0 }
    return 1 + recurse(n - 1)
}
let success = depth.run(3, function(): Integer {
    if (yes() && true) || recursive() { return 42 }
    return 0
})
print(errors.integerValue(success))
let failed = depth.run(3, function(): Integer {
    if false || (yes() && recursive()) { return 1 }
    return 2
})
print(errors.integerOk(failed))
let parallel = depth.run(12, function(): Integer { return recurse(1000000) })
print(errors.integerOk(parallel))
let good = depth.run(12, function(): Integer { return recurse(10) })
print(errors.integerValue(good))
