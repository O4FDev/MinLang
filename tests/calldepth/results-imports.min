use "calldepth" as depth
use "errors" as errors
use "./imported.min" as imported
function failure(): Result<Bytes, Text> { return Err<Bytes, Text>("failure" + " text") }
function result(): Result<Integer, Text> {
    let bytes = Bytes(20)
    let text = ["one" + " text", "two" + " text"]
    let payload = try failure()
    return Ok<Integer, Text>(payload.length)
}
function pending(): Result<Integer, Text> {
    return Ok<Integer, Text>(imported.deep())
}
function propagate(): Result<Integer, Text> {
    let value = try pending()
    return Ok<Integer, Text>(value)
}
let success = depth.run(10, function(): Integer {
    let answer = result()
    match answer { Ok(value) { return value } Err(error) { return error.length } }
})
print(errors.integerValue(success))
let failed = depth.run(10, function(): Integer {
    let value = propagate()
    match value { Ok(number) { return number } Err(error) { return error.length } }
})
print(errors.integerOk(failed))
