use "calldepth" as depth
use "errors" as errors
function unknown(): Integer { native "reporttest" }
function restore(): Integer { native "reporttest" }
record State { remaining: Integer; saved: errors.IntegerResult }
function near(n: Integer, state: State): Integer {
    if n > 0 { return near(n - 1, state) }
    state.remaining = depth.remaining()
    state.saved = depth.run(100, function(): Integer { return 99 })
    return 17
}
let state = State { remaining: 0; saved: depth.run(0, function(): Integer { return 0 }) }
let ignored = unknown()
let outer = depth.run(100, function(): Integer { return near(13, state) })
print(state.remaining)
print(errors.depthTestCode(state.saved))
print(errors.depthTestValue(outer))
let restored = restore()
let good = depth.run(1, function(): Integer { return 42 })
print(errors.depthTestValue(good))
print("alive")
