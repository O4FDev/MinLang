use "calldepth" as depth
use "errors" as errors
function nest(n: Integer): Integer {
    if n == 0 { return 0 }
    return 1 + nest(n - 1)
}
let failed = depth.run(1000000, function(): Integer { return nest(1000000) })
print(errors.integerOk(failed))
let success = depth.run(100, function(): Integer { return nest(10) })
print(errors.integerValue(success))
