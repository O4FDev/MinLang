record NumericLabel { text: Text; value: Float }
function label(value: Float): NumericLabel {
    return NumericLabel { text: Text(value); value: value }
}
function retainedText(value: Float): Text {
    let text = Text(value)
    return text
}
let labels = [label(-0.0), label(0.1 + 0.2), label(6.142758149716505e-238)]
let alias = labels
alias[0] = label(9007199254740991.0)
for item in labels {
    print(item.text)
    print(item.value)
}
let retained = retainedText(-0.0)
let pieces = [retained, retainedText(1.0e-7), retainedText(1.0e21)]
print(joinText(pieces))
print(retained)
