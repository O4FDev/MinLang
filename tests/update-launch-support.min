use "sha256" as sha256

public record Entry { kind: Text; path: Text; mode: Integer; data: Bytes }

public function entry(kind: Text, path: Text, mode: Integer, data: Bytes): Entry {
    return Entry { kind: kind; path: path; mode: mode; data: data }
}
public function bigEndian(value: Integer, width: Integer): Bytes {
    let result = Bytes(width)
    let remaining = value
    let index = width - 1
    while index >= 0 {
        result[index] = remaining & 255
        remaining = remaining >> 8
        index -= 1
    }
    return result
}
public function ones(width: Integer): Bytes {
    let result = Bytes(width)
    for index in 0..width { result[index] = 255 }
    return result
}
public function package(entries: List<Entry>, main: Text): Bytes {
    let name = Bytes(main)
    let result = Bytes("MINYAR-BUNDLE-1\n")
    result.addBytes(bigEndian(name.length, 4))
    result.addBytes(name)
    result.addBytes(bigEndian(entries.length, 4))
    for item in entries {
        let path = Bytes(item.path)
        result.add(Bytes(item.kind)[0])
        result.add(item.mode)
        result.addBytes(bigEndian(path.length, 4))
        result.addBytes(bigEndian(item.data.length, 8))
        result.addBytes(path)
        result.addBytes(item.data)
    }
    return result
}
public function infoPlist(version: Text): Bytes {
    return Bytes("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n\t<key>CFBundleExecutable</key>\n\t<string>main</string>\n\t<key>CFBundleIdentifier</key>\n\t<string>org.tolum.peer</string>\n\t<key>CFBundleName</key>\n\t<string>Owned Helper</string>\n\t<key>CFBundlePackageType</key>\n\t<string>APPL</string>\n\t<key>CFBundleVersion</key>\n\t<string>" + version + "</string>\n</dict>\n</plist>\n")
}
public function hex(data: Bytes): Text {
    let digits = Bytes("0123456789abcdef")
    let out = Bytes()
    for byte in data { out.add(digits[byte >> 4]); out.add(digits[byte & 15]) }
    return Text(out)
}
public function digest(data: Bytes): Text {
    return sha256.hex(sha256.digest(data))
}
public function cohort(device: Text): Integer {
    let value = sha256.digest(Bytes("MINYAR-UPDATE-COHORT-V1\norg.tolum.peer\nstable\n" + device))
    return (((value[0] * 256 + value[1]) * 256 + value[2]) * 256 + value[3]) % 100
}
public function metadata(target: Text, sequence: Integer, version: Text, rollout: Integer, data: Bytes): Bytes {
    let hash = digest(data)
    let fields = ["MINYAR-UPDATE-1", "org.tolum.peer", target, "stable", Text(sequence), version, "1799999990", "1800003600", Text(rollout),
        "https://updates.example/releases/" + hash + "/artifact", hash, Text(data.length)]
    let pieces: List<Text> = []
    for field in fields { pieces.add(field); pieces.add("\n") }
    return Bytes(joinText(pieces))
}
