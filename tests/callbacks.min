use "io" as io
use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "files" as files
let frontend = fixtures.fixture("MINYAR_CALLBACK_COMPILER", "./build/minyarc-callbacks")
fixtures.validate("Callbacks", ["test_native_loop_borrow_has_stable_identity_and_rejects_closed_dispatcher", "test_scalar_and_reference_captures_escape_creator", "test_no_capture_and_parameter_shadowing", "test_capture_environment_closes_reference_cycle", "test_reference_arguments_and_results_survive_indirect_call", "test_nested_callback_and_recursive_named_function", "test_cross_module_signature_and_capture_ownership", "test_wrong_signature_and_argument_types_are_rejected", "test_timer_callbacks_cancel_and_release_cyclic_captures", "test_generated_capture_values", "test_cancelled_batch_event_cannot_call_a_reused_slot", "test_udp_read_callback_keeps_empty_datagram_as_success", "test_socket_interest_updates_preserve_callback_and_generation", "test_captured_binding_reassignment_has_a_source_diagnostic", "test_nested_parameter_shadow_does_not_capture_outer_object", "test_module_record_types_in_anonymous_signature", "test_every_incomplete_callback_body_prefix_is_a_diagnostic", "test_list_and_nested_callback_signatures_preserve_owned_results", "test_feature_looking_names_do_not_rewrite_expression_tokens", "test_idle_cycle_debt_drains_before_the_loop_blocks"])
if fixtures.selected("Callbacks", "test_native_loop_borrow_has_stable_identity_and_rejects_closed_dispatcher") {
    frontend.helpers = ""; frontend.sources = []
    frontend.sources = ["runtime/native/net.c"]
    fixtures.executes(frontend, "use \"eventcallbacks\" as callbacks\nuse \"eventloop\" as eventloop\nuse \"errors\" as errors\nlet dispatcher = callbacks.value(callbacks.create())\nlet first = callbacks.nativeLoop(dispatcher)\nlet second = callbacks.nativeLoop(dispatcher)\nprint(errors.integerOk(first))\nprint(errors.integerValue(first) == errors.integerValue(second))\nlet ready = eventloop.timer(errors.integerValue(first), 0, 0, 7)\nprint(errors.integerOk(ready))\nprint(eventloop.events(eventloop.wait(errors.integerValue(first), 0, 8)).length)\nprint(errors.booleanOk(callbacks.close(dispatcher)))\nlet closed = callbacks.nativeLoop(dispatcher)\nprint(errors.integerOk(closed))\nprint(errors.code(errors.integerError(closed)) == errors.closedCode())\nprint(errors.integerOk(first))\n", "true\ntrue\ntrue\n1\ntrue\nfalse\ntrue\ntrue\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_scalar_and_reference_captures_escape_creator") {
    frontend.helpers = ""; frontend.sources = []
    fixtures.executes(frontend, "record Box { value: Integer }\nfunction make(box: Box): Callback<Integer, Integer> {\n    let offset = 40\n    return function(delta: Integer): Integer { return offset + box.value + delta }\n}\nlet box = Box { value: 1 }\nlet callback = make(box)\nbox.value = 2\nprint(callback(3))\n", "45\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_no_capture_and_parameter_shadowing") {
    frontend.helpers = ""; frontend.sources = []
    fixtures.executes(frontend, "let value = 999\nlet noCapture: Callback<Integer, Integer> = function(value: Integer): Integer { return value + 1 }\nprint(noCapture(41))\n", "42\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_capture_environment_closes_reference_cycle") {
    frontend.helpers = ""; frontend.sources = []
    fixtures.executes(frontend, "record Node { value: Integer; callbacks: List<Callback<Integer, Integer>> }\nlet node = Node { value: 40; callbacks: [] }\nlet callback = function(delta: Integer): Integer { return node.value + delta }\nnode.callbacks.add(callback)\nlet stored = node.callbacks[0]\nprint(stored(2))\n", "42\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_reference_arguments_and_results_survive_indirect_call") {
    frontend.helpers = ""; frontend.sources = []
    fixtures.executes(frontend, "record Box { value: Text }\nlet callback: Callback<Box, Box> = function(box: Box): Box { return Box { value: box.value + \"!\" } }\nlet result = callback(Box { value: \"alive\" })\nprint(result.value)\n", "alive!\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_nested_callback_and_recursive_named_function") {
    frontend.helpers = ""; frontend.sources = []
    fixtures.executes(frontend, "function factorial(n: Integer): Integer {\n    if n <= 1 { return 1 }\n    return n * factorial(n - 1)\n}\nfunction outer(offset: Integer): Callback<Integer, Callback<Integer, Integer>> {\n    return function(a: Integer): Callback<Integer, Integer> {\n        return function(b: Integer): Integer { return offset + a + factorial(b) }\n    }\n}\nlet make = outer(10)\nlet inner = make(2)\nprint(inner(3))\n", "18\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_cross_module_signature_and_capture_ownership") {
    frontend.helpers = ""; frontend.sources = []
    io.writeTextFile(frontend.compiler.directory + "/factory.min", test.sourceModules("public record Box { value: Text }\npublic function make(box: Box): Callback<Text, Text> {\n    return function(suffix: Text): Text { return box.value + suffix }\n}\n"))
    fixtures.executes(frontend, "use \"./factory.min\" as factory\nlet callback = factory.make(factory.Box { value: \"kept\" })\nprint(callback(\" alive\"))\n", "kept alive\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_wrong_signature_and_argument_types_are_rejected") {
    frontend.helpers = ""; frontend.sources = []
    fixtures.rejects(frontend, "let callback: Callback<Integer, Integer> = function(x: Text): Integer { return x.length }\n", "declared type", false)
    fixtures.rejects(frontend, "let callback = function(x: Integer): Integer { return x }\ncallback(\"bad\")\n", "callback argument", false)
    fixtures.rejects(frontend, "let callback = function(): Integer { return 1 }\ncallback(2)\n", "callback expects", false)
}
if fixtures.selected("Callbacks", "test_timer_callbacks_cancel_and_release_cyclic_captures") {
    frontend.helpers = ""; frontend.sources = []
    frontend.sources = ["runtime/native/net.c"]
    fixtures.executes(frontend, "use \"eventcallbacks\" as callbacks\nuse \"eventloop\" as eventloop\nuse \"errors\" as errors\nrecord State { calls: Integer; sum: Integer; cancelled: Integer }\nlet state = State { calls: 0; sum: 0; cancelled: 0 }\nlet dispatcher = callbacks.value(callbacks.create())\nlet later = errors.integerValue(callbacks.timer(dispatcher, 1000, 0, 999, function(event: eventloop.Event) { state.calls = state.calls + 100 }))\nstate.cancelled = later\nlet first = callbacks.timer(dispatcher, 0, 0, 40, function(event: eventloop.Event) {\n    state.calls = state.calls + 1\n    state.sum = state.sum + event.token\n    if !errors.booleanOk(callbacks.cancel(dispatcher, state.cancelled)) { fail(\"cancel failed\") }\n})\nif !errors.integerOk(first) { fail(\"timer failed\") }\nprint(errors.integerValue(callbacks.dispatch(dispatcher, 0, 8)))\nprint(state.calls)\nprint(state.sum)\nprint(errors.booleanOk(callbacks.cancel(dispatcher, errors.integerValue(first))))\nprint(errors.booleanValue(callbacks.close(dispatcher)))\nprint(errors.integerOk(callbacks.dispatch(dispatcher, 0, 8)))\n", "1\n1\n40\nfalse\ntrue\nfalse\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_generated_capture_values") {
    frontend.helpers = ""; frontend.sources = []
    for scalar in [-2147483648, -1, 0, 7, 2147483647] {
        let source = "record Box { value: Integer }\nfunction make(base: Integer): Callback<Integer, Integer> {\n    let box = Box { value: base }\n    return function(delta: Integer): Integer { return box.value + base + delta }\n}\nlet callback = make(" + Text(scalar) + ")\nprint(callback(11))\n"
        fixtures.executes(frontend, source, Text(scalar * 2 + 11) + "\n", ["-O2"], 0, "", true)
    }
}
if fixtures.selected("Callbacks", "test_cancelled_batch_event_cannot_call_a_reused_slot") {
    frontend.helpers = ""; frontend.sources = []
    frontend.sources = ["runtime/native/net.c"]
    fixtures.executes(frontend, "use \"eventcallbacks\" as callbacks\nuse \"eventloop\" as eventloop\nuse \"errors\" as errors\nrecord State { old: Integer; calls: Integer; replacement: Integer }\nlet state = State { old: 0; calls: 0; replacement: 0 }\nlet dispatcher = callbacks.value(callbacks.create())\ncallbacks.timer(dispatcher, 0, 0, 1, function(event: eventloop.Event) {\n    state.calls = state.calls + 1\n    if !errors.booleanOk(callbacks.cancel(dispatcher, state.old)) { fail(\"pending cancel failed\") }\n    state.replacement = errors.integerValue(callbacks.timer(dispatcher, 0, 0, 3, function(next: eventloop.Event) {\n        state.calls = state.calls + 100\n    }))\n})\nstate.old = errors.integerValue(callbacks.timer(dispatcher, 0, 0, 2, function(event: eventloop.Event) {\n    state.calls = state.calls + 10000\n}))\nprint(errors.integerValue(callbacks.dispatch(dispatcher, 0, 8)))\nprint(state.calls)\nprint(errors.integerValue(callbacks.dispatch(dispatcher, 0, 8)))\nprint(state.calls)\nprint(errors.booleanOk(callbacks.cancel(dispatcher, state.old)))\ncallbacks.close(dispatcher)\n", "1\n1\n1\n101\nfalse\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_udp_read_callback_keeps_empty_datagram_as_success") {
    frontend.helpers = ""; frontend.sources = []
    frontend.sources = ["runtime/native/net.c"]
    fixtures.executes(frontend, "use \"eventcallbacks\" as callbacks\nuse \"eventloop\" as eventloop\nuse \"errors\" as errors\nuse \"net\" as net\nrecord State { called: Integer; handle: Integer; status: Integer; length: Integer }\nlet state = State { called: 0; handle: 0; status: -1; length: -1 }\nlet server = net.udp(\"127.0.0.1\", 0)\nlet client = net.udp(\"127.0.0.1\", 0)\nif server < 0 || client < 0 { fail(\"UDP bind failed\") }\nif !net.udpConnect(client, \"127.0.0.1\", net.localPort(server)) { fail(\"UDP connect failed\") }\nlet dispatcher = callbacks.value(callbacks.create())\nstate.handle = errors.integerValue(callbacks.watch(dispatcher, server, eventloop.readableInterest(), 42, function(event: eventloop.Event) {\n    let read = net.receiveDatagram(server, 32)\n    state.called = state.called + 1\n    state.status = errors.bytesStatus(read)\n    state.length = errors.bytesValue(read).length\n    if event.token != 42 { fail(\"callback lost token\") }\n    if !errors.booleanOk(callbacks.cancel(dispatcher, state.handle)) { fail(\"self cancel failed\") }\n}))\nif !errors.integerOk(net.write(client, Bytes())) { fail(\"empty UDP write failed\") }\nprint(errors.integerValue(callbacks.dispatch(dispatcher, 1000, 8)))\nprint(state.called)\nprint(state.status)\nprint(state.length)\nprint(errors.integerValue(callbacks.dispatch(dispatcher, 0, 8)))\ncallbacks.close(dispatcher)\nnet.close(client)\nnet.close(server)\n", "1\n1\n0\n0\n0\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_socket_interest_updates_preserve_callback_and_generation") {
    frontend.helpers = ""; frontend.sources = []
    frontend.sources = ["runtime/native/net.c"]
    fixtures.executes(frontend, "use \"eventcallbacks\" as callbacks\nuse \"eventloop\" as loop\nuse \"errors\" as errors\nuse \"net\" as net\nrecord State { count: Integer; token: Integer }\nlet state = State { count: 0; token: 0 }\nlet socket = net.udp(\"127.0.0.1\",0); let sender = net.udp(\"127.0.0.1\",0)\nnet.udpConnect(sender,\"127.0.0.1\",net.localPort(socket))\nlet dispatcher = callbacks.value(callbacks.create())\nlet watched = errors.integerValue(callbacks.watch(dispatcher,socket,loop.readableInterest(),1,function(event: loop.Event) {\n    state.count += 1; state.token = event.token; net.receiveDatagram(socket,32)\n}))\nprint(errors.booleanOk(callbacks.update(dispatcher,watched,0,2)))\nnet.write(sender,Bytes(\"queued\"))\nprint(errors.integerValue(callbacks.dispatch(dispatcher,0,8)))\nprint(errors.booleanOk(callbacks.update(dispatcher,watched,loop.readableInterest(),77)))\nprint(errors.integerValue(callbacks.dispatch(dispatcher,1000,8)))\nprint(state.count); print(state.token)\ncallbacks.cancel(dispatcher,watched)\nprint(errors.booleanOk(callbacks.update(dispatcher,watched,loop.readableInterest(),88)))\ncallbacks.close(dispatcher); net.close(sender); net.close(socket)\n", "true\n0\ntrue\n1\n1\n77\nfalse\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_captured_binding_reassignment_has_a_source_diagnostic") {
    frontend.helpers = ""; frontend.sources = []
    fixtures.rejects(frontend, "let count = 0\nlet callback = function(): Integer { count = count + 1; return count }\nprint(callback())\n", "captured bindings cannot be reassigned", false)
}
if fixtures.selected("Callbacks", "test_nested_parameter_shadow_does_not_capture_outer_object") {
    frontend.helpers = ""; frontend.sources = []
    fixtures.executes(frontend, "record Box { value: Integer }\nlet box = Box { value: 999 }\nlet factory = function(): Callback<Box, Integer> {\n    return function(box: Box): Integer { return box.value }\n}\nlet callback = factory()\nprint(callback(Box { value: 42 }))\n", "42\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_module_record_types_in_anonymous_signature") {
    frontend.helpers = ""; frontend.sources = []
    io.writeTextFile(frontend.compiler.directory + "/factory.min", test.sourceModules("public record Box { value: Text }\npublic function make(): Callback<Box, Box> {\n    return function(box: Box): Box { return Box { value: box.value + \"!\" } }\n}\n"))
    fixtures.executes(frontend, "use \"./factory.min\" as factory\nlet callback = factory.make()\nlet result = callback(factory.Box { value: \"kept\" })\nprint(result.value)\n", "kept!\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_every_incomplete_callback_body_prefix_is_a_diagnostic") {
    frontend.helpers = ""; frontend.sources = []
    let source = "let callback: Callback<Integer, Integer> = function(value: Integer): Integer { return value + 1 }\n"
    for length in 44..97 {
        let result = fixtures.compile(frontend, Text(Bytes(source).slice(0, length)))
        test.check(result.status == 1, "incomplete callback prefix rejection status")
        test.check(files.pathSize(frontend.compiler.directory + "/case" + Text(frontend.compiler.serial) + ".ll") < 0, "incomplete callback prefix emitted LLVM")
        test.check(result.errorOutput != "", "incomplete callback prefix lost diagnostic")
        for internal in ["List position", "record position", "AddressSanitizer", "runtime error:", "Segmentation fault"] { test.check(!test.contains(result.errorOutput, internal), "incomplete callback prefix internal fault " + internal) }
    }
}
if fixtures.selected("Callbacks", "test_list_and_nested_callback_signatures_preserve_owned_results") {
    frontend.helpers = ""; frontend.sources = []
    fixtures.executes(frontend, "let factory: Callback<Callback<List<Text>, List<Text>>> = function(): Callback<List<Text>, List<Text>> {\n    return function(values: List<Text>): List<Text> { return values.appended(\"done\") }\n}\nlet callback = factory()\nlet result = callback([\"kept\"])\nprint(result[0])\nprint(result[1])\n", "kept\ndone\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_feature_looking_names_do_not_rewrite_expression_tokens") {
    frontend.helpers = ""; frontend.sources = []
    fixtures.executes(frontend, "let List = 1\nlet Callback = 1\nlet callback = function(): Integer { return 42 }\nprint(List < 2)\nprint(Callback < 2)\nprint(8 >> 1)\nprint(\">>\")\nprint(callback())\n", "true\ntrue\n4\n>>\n42\n", ["-O0", "-O2"], 0, "", true)
}
if fixtures.selected("Callbacks", "test_idle_cycle_debt_drains_before_the_loop_blocks") {
    frontend.helpers = ""; frontend.sources = []
    frontend.sources = ["runtime/native/net.c"]
    frontend.helpers = "\nlong long minyar_cycleidle_pendingNative(void) { return (long long)rc_pending_count; }\nlong long minyar_cycleidle_objectsNative(void) { return (long long)(rc_object_count - rc_immortal_object_count); }\nlong long minyar_cycleidle_nowNative(void) {\n#ifdef _WIN32\n    return (long long)GetTickCount64();\n#else\n    struct timespec time; clock_gettime(CLOCK_MONOTONIC, &time);\n    return (long long)time.tv_sec * 1000 + time.tv_nsec / 1000000;\n#endif\n}\n"
    fixtures.executes(frontend, "use \"eventcallbacks\" as callbacks\nuse \"errors\" as errors\nfunction pendingNative(): Integer { native \"cycleidle\" }\nfunction objectsNative(): Integer { native \"cycleidle\" }\nfunction nowNative(): Integer { native \"cycleidle\" }\nrecord Node { next: List<Node> }\nfunction garbage() {\n    let head = Node { next: [] }\n    let cursor = head\n    for i in 0..1024 {\n        let next = Node { next: [] }\n        cursor.next.add(next)\n        cursor = next\n    }\n    cursor.next.add(head)\n}\nlet dispatcher = callbacks.value(callbacks.create())\nlet baseline = objectsNative()\ngarbage()\nif pendingNative() == 0 || objectsNative() <= baseline { fail(\"fixture did not leave cyclic debt\") }\nif errors.integerOk(callbacks.dispatch(dispatcher, -2, 8)) { fail(\"cleanup hid an invalid timeout\") }\nlet firstWait = nowNative()\nif errors.integerValue(callbacks.dispatch(dispatcher, 400, 8)) != 0 { fail(\"unexpected event\") }\nif nowNative() - firstWait >= 200 { fail(\"loop blocked while cyclic debt remained\") }\nlet batches = 0\nwhile pendingNative() != 0 {\n    if errors.integerValue(callbacks.dispatch(dispatcher, 100, 8)) != 0 { fail(\"unexpected event\") }\n    batches = batches + 1\n    if batches > 10000 { fail(\"idle cleanup did not finish\") }\n}\nif objectsNative() != baseline { fail(\"idle loop retained cyclic garbage\") }\nlet start = nowNative()\nif errors.integerValue(callbacks.dispatch(dispatcher, 100, 8)) != 0 { fail(\"unexpected event\") }\nif nowNative() - start < 50 { fail(\"drained loop spun instead of blocking\") }\ncallbacks.close(dispatcher)\nprint(\"idle cycle reclaimed\")\n", "idle cycle reclaimed\n", ["-O0", "-O2"], 0, "", true)
}
test.removeTree(frontend.compiler.directory)
print("Callback captures, ownership, dispatch and diagnostics: passed")
