use "./quic-protocol-support.min" as protocol

global NAMES: List<Text> = [
    "client-policy",
    "server-policy",
    "server-ticket",
    "client-ticket",
    "unoffered",
    "chacha-update",
    "default-aes",
    "invalid-policy"]
global CODES: List<Integer> = [32, 42, 52, 62, 72, 32, 0, 0]
global MESSAGES: List<Text> = [
    "semantic failure: client ignored its restricted ChaCha cipher offer",
    "semantic failure: server ignored its restricted ChaCha cipher policy",
    "semantic failure: resumption restored an excluded ticket cipher over server policy",
    "semantic failure: client retained an AES ticket and 0-RTT under a ChaCha-only policy",
    "semantic failure: client accepted a ServerHello cipher excluded by its offer",
    "semantic failure: client ignored its restricted ChaCha cipher offer",
    "cipher policy authenticated",
    "invalid or late policy changes"]

protocol.baseline("minyar-quic-cipher-policy", "QUIC cipher policy cases", "tests/quic-cipher-policy-test.min", "tests/quic-cipher-policy.min", NAMES, CODES, MESSAGES)
