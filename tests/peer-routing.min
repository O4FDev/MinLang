use "quicdispatch" as dispatch
use "errors" as errors
function key(value: Integer): Bytes {
    let bytes=Bytes();for offset in 0..4 { bytes.add((value>>((3-offset)*8))&255) };return bytes
}
function main(): Integer {
    let salt=randomBytes(16)
    if dispatch.routes(0,65536,salt).valid || dispatch.routes(32769,65536,salt).valid || dispatch.table(131073,65536,salt).valid { return 1 }
    for maximum in [1,16384,16385,32768] {
        let routes=dispatch.routes(maximum,65536,salt)
        if !routes.valid || routes.maximum!=maximum || routes.tables.length!=(maximum+16383)/16384 { return 2 }
        let capacity=0
        for table in routes.tables { if !table.valid || table.maximum>131072 { return 3 };capacity+=table.maximum }
        if capacity!=maximum*8 { return 4 }
    }
    let routes=dispatch.routes(32768,65536,salt)
    for index in 0..262144 {
        if !errors.booleanOk(dispatch.insertRoute(routes,key(index),index/8)) { return 5 }
    }
    if dispatch.routeCount(routes)!=262144 || errors.booleanOk(dispatch.insertRoute(routes,key(300000),0)) { return 6 }
    if errors.booleanOk(dispatch.insertRoute(routes,key(0),16384)) || dispatch.lookupRoute(routes,key(0))!=0 { return 7 }
    if errors.booleanOk(dispatch.insertRoute(routes,key(300000),32768)) { return 8 }
    for index in 0..262144 { if dispatch.lookupRoute(routes,key(index))!=index/8 { return 9 } }
    // Free and reuse slots in both partitions; the entry pools cannot grow.
    for index in 0..262144 {
        if !dispatch.removeRoute(routes,key(index)) || dispatch.lookupRoute(routes,key(index))!=-1 { return 10 }
        if !errors.booleanOk(dispatch.insertRoute(routes,key(index+500000),index/8)) { return 11 }
    }
    for table in routes.tables { if table.entries.length!=131072 || table.count!=131072 { return 12 } }
    for index in 0..262144 { if !dispatch.removeRoute(routes,key(index+500000)) { return 13 } }
    if dispatch.routeCount(routes)!=0 || dispatch.removeRoute(routes,key(0)) { return 14 }
    print("bounded edge routing: 32768 peers, 262144 live IDs, cross-partition collisions, full pools, removal and reuse passed")
    return 0
}
