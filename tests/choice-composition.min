choice Tone { Soft; Clear }
record Note { tone: Tone; text: Text }
record Box<Item> { value: Item; note: Maybe<Note> }
choice Message {
    Idle
    Scalar(tone: Tone)
    Wrapped(tone: Tone, note: Maybe<Note>)
    Nested(note: Maybe<Maybe<Note>>)
    Combined(tone: Tone, note: Maybe<Note>, text: Text, number: Integer)
}

function toneName(tone: Tone): Text { return match tone { Soft { "soft" } Clear { "clear" } } }
function note(tone: Tone, text: Text): Note { return Note { tone: tone; text: text } }
function noteName(value: Maybe<Note>): Text {
    return match value { Some(item) { item.text + " " + toneName(item.tone) } None { "none" } }
}
function nestedName(value: Maybe<Maybe<Note>>): Text {
    return match value { Some(inner) { "some " + noteName(inner) } None { "outer none" } }
}
function messageName(value: Message): Text {
    return match value {
        Idle { "idle" }
        Scalar(tone) { "scalar " + toneName(tone) }
        Wrapped(tone, item) { "wrapped " + toneName(tone) + "|" + noteName(item) }
        Nested(item) { "nested " + nestedName(item) }
        Combined(tone, item, text, number) { "combined " + toneName(tone) + "|" + noteName(item) + "|" + text + "|" + Text(number) }
    }
}
function identity<Item>(value: Item): Item { return value }
function remember(tone: Tone): () -> Tone { return function() { return tone } }
parallel function echoTone(tone: Tone): Tone { return tone }
function decode(good: Boolean): Result<Integer, Text> {
    if good { return Ok(42) }
    return Err("stop" + "ped")
}
function combine(item: Maybe<Note>, good: Boolean): Result<Message, Text> {
    return Ok(Combined(Clear, item, "owned" + " text", try decode(good)))
}
function report(result: Result<Message, Text>): Text {
    return match result { Ok(value) { messageName(value) } Err(error) { "error " + error } }
}

print("collections")
let source = note(Clear, "first")
let key = Wrapped(Soft, Some(source))
print(key == Wrapped(Soft, Some(note(Clear, "first"))))
print(Nested(Some(None<Note>())) == Nested(None<Maybe<Note>>()))
let entries: Map<Message, Integer> = Map()
entries[key] = 7
entries[Nested(Some(None<Note>()))] = 11
entries[Nested(None<Maybe<Note>>())] = 13
source.tone = Soft
source.text = "changed"
print(entries[Wrapped(Soft, Some(note(Clear, "first")))])
print(entries.has(key))
for snapshot in entries {
    match snapshot {
        Wrapped(_, value) { match value { Some(item) { item.tone = Soft; item.text = "snapshot" } None {} } }
        else {}
    }
}
print(entries[Wrapped(Soft, Some(note(Clear, "first")))])
print(entries[Nested(Some(None<Note>()))])
print(entries[Nested(None<Maybe<Note>>())])
let seen: Set<Message> = Set()
seen.add(Wrapped(Soft, Some(note(Clear, "first"))))
seen.add(Wrapped(Soft, None))
seen.add(Wrapped(Soft, Some(note(Clear, "first"))))
print(seen.length)
print(seen.contains(Wrapped(Soft, Some(note(Clear, "first")))))
let ordered = [Scalar(Clear), Wrapped(Soft, None), Idle, Scalar(Soft), Wrapped(Soft, Some(note(Clear, "first")))]
ordered.sort()
for value in ordered { print(messageName(value)) }

print("abi")
let boxed = Box { value: identity(Soft); note: Some(note(Clear, "generic")) }
print(toneName(boxed.value))
print(noteName(boxed.note))
let read = remember(Clear)
print(toneName(read()))
let captured = Clear
let tones: List<Tone> = [Soft, Soft, Soft, Soft]
parallel for index in 0..tones.length { tones[index] = echoTone(captured) }
for tone in tones { print(toneName(tone)) }

print("propagation")
let borrowed: Maybe<Note> = Some(note(Soft, "borrowed"))
print(report(combine(borrowed, true)))
print(report(combine(borrowed, false)))
print(noteName(borrowed))
let successes = 0
let failures = 0
for index in 0..20 {
    match combine(borrowed, index % 2 == 0) {
        Ok(_) { successes += 1 }
        Err(_) { failures += 1 }
    }
}
print(successes)
print(failures)
