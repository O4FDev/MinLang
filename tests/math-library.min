use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures

// The math module binds hyperbolic, error, accurate-near-zero and cube-root
// functions to the C library, and rounds through 32-bit Floats.
let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, #"""
    use "math" as math
    function verify(condition: Boolean, message: Text) {
        if !condition { fail(message) }
    }
    function near(actual: Float, expected: Float, message: Text) {
        verify(abs(actual - expected) <= 1.0e-15 * max(1.0, abs(expected)), message + ": " + Text(actual))
    }
    function negativeZero(value: Float): Boolean { return value == 0.0 && 1.0 / value < 0.0 }
    let infinity = math.exp(1000.0)
    print(math.sinh(0.0))
    print(math.cosh(0.0))
    print(math.tanh(infinity))
    print(math.tanh(-infinity))
    print(math.asinh(0.0))
    print(math.acosh(1.0))
    print(math.atanh(0.0))
    print(math.atanh(1.0))
    print(math.erf(0.0))
    print(math.erfc(0.0))
    print(math.erf(infinity))
    print(math.erfc(infinity))
    print(math.expm1(0.0))
    print(math.log1p(0.0))
    print(math.log1p(-1.0))
    // The C library decides the last bit: glibc gives cbrt(27.0) = 3.0000000000000004.
    near(math.cbrt(27.0), 3.0, "cbrt of a cube")
    near(math.cbrt(-8.0), -2.0, "cbrt of a negative cube")
    let nan = math.acosh(0.5)
    verify(nan != nan, "acosh below one is NaN")
    let outside = math.atanh(2.0)
    verify(outside != outside, "atanh outside -1..1 is NaN")
    verify(negativeZero(math.sinh(-0.0)) && negativeZero(math.tanh(-0.0)) && negativeZero(math.asinh(-0.0)), "odd functions keep negative zero")
    verify(negativeZero(math.expm1(-0.0)) && negativeZero(math.log1p(-0.0)) && negativeZero(math.cbrt(-0.0)), "near-zero functions keep negative zero")
    near(math.sinh(1.0), (math.exp(1.0) - math.exp(-1.0)) / 2.0, "sinh identity")
    near(math.cosh(1.0), (math.exp(1.0) + math.exp(-1.0)) / 2.0, "cosh identity")
    near(math.tanh(0.5), math.sinh(0.5) / math.cosh(0.5), "tanh identity")
    near(math.sinh(math.asinh(3.25)), 3.25, "asinh inverts sinh")
    near(math.cosh(math.acosh(3.25)), 3.25, "acosh inverts cosh")
    near(math.tanh(math.atanh(0.25)), 0.25, "atanh inverts tanh")
    near(math.erf(0.5) + math.erfc(0.5), 1.0, "erf and erfc sum to one")
    verify(math.erfc(10.0) > 0.0 && math.erfc(10.0) < 1.0e-40, "erfc keeps tiny tails")
    verify(math.expm1(1.0e-20) == 1.0e-20 && math.log1p(1.0e-20) == 1.0e-20, "accurate near zero")
    verify(math.exp(1.0e-20) - 1.0 == 0.0, "exp minus one loses the tiny term")
    print(math.toFloat32(1.5))
    print(math.toFloat32(0.1))
    print(math.toFloat32(0.1) == 0.1)
    print(math.toFloat32(3.4028234663852886e38))
    print(math.toFloat32(1.0e39))
    print(math.toFloat32(1.0e-50))
    verify(negativeZero(math.toFloat32(-1.0e-50)), "toFloat32 keeps the sign of an underflow")
    let stored = Bytes()
    stored.addFloat32(0.7)
    verify(stored.getFloat32(0) == math.toFloat32(0.7), "toFloat32 matches Bytes Float32 storage")
    print("math library: passed")
    """#, "0.0\n1.0\n1.0\n-1.0\n0.0\n0.0\n0.0\nInfinity\n0.0\n1.0\n1.0\n0.0\n0.0\n0.0\n-Infinity\n1.5\n0.10000000149011612\nfalse\n3.4028234663852886e+38\nInfinity\n0.0\nmath library: passed\n", levels, 0, "", true)
print("Math library: passed")
