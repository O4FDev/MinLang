use "peerauth" as auth
use "errors" as errors

// Direct provider probe: the RFC 8037 fixture is not a Hearth grant.
function verify(data: Bytes, signature: Bytes, key: Bytes): Boolean { native "update" }
function number(text: Text): Integer {
    let value = 0
    for c in text { value = value * 10 + (Integer(c) - 48) }
    return value
}
function same(left: Bytes, right: Bytes): Boolean {
    if left.length != right.length { return false }
    for index in 0..left.length { if left[index] != right[index] { return false } }
    return true
}

let mode = argument(0)
if mode == "crypto" {
    if verify(readBytesFile(argument(1)), readBytesFile(argument(2)), readBytesFile(argument(3))) { print("OK") }
    else { print("ERROR") }
} else {
    let keys = auth.parseKeys(readBytesFile(argument(1)))
    if !auth.keysOk(keys) { print("KEY_ERROR " + Text(errors.code(auth.keysError(keys)))) }
    else {
        let source = readBytesFile(argument(2))
        let original = source.slice(0, source.length)
        let grant = auth.inspect(source, keys, argument(3), argument(4), argument(5), number(argument(6)), number(argument(7)))
        if mode == "trap" { print(auth.targetHost(grant)) }
        else if mode == "trap-token" { print(Text(auth.grantBytes(grant))) }
        else if mode == "forward" {
            if !auth.grantOk(grant) { fail("fixture grant was rejected") }
            source[0] = source[0] ^ 1
            let first = auth.grantBytes(grant)
            if !same(first, original) { fail("verified token aliases mutable input") }
            first[0] = first[0] ^ 1
            if !same(auth.grantBytes(grant), original) { fail("verified token aliases returned buffer") }
            print("FORWARDED " + Text(auth.grantBytes(grant)))
        }
        else if !auth.grantOk(grant) { print("GRANT_ERROR " + Text(errors.code(auth.grantError(grant)))) }
        else { print("OK " + auth.exitID(grant) + " " + auth.connID(grant) + " " + auth.targetHost(grant) + " " + auth.targetIP(grant) + " " + Text(auth.port(grant)) + " " + Text(auth.expires(grant))) }
    }
}
