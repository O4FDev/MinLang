public function decimal(value: Integer): Text {
    let magnitude = value; let negative = value < 0; if negative { magnitude = -value }
    let powers = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000, 10000000000, 100000000000, 1000000000000, 10000000000000, 100000000000000, 1000000000000000, 10000000000000000, 100000000000000000, 1000000000000000000]
    let index = 0
    while index + 1 < powers.length && powers[index + 1] <= magnitude { index += 1 }
    let raw = Bytes(); if negative { raw.add(45) }
    while index >= 0 {
        let digit = 0; let power = powers[index]
        while magnitude >= power { magnitude -= power; digit += 1 }
        raw.add(48 + digit); index -= 1
    }
    return Text(raw)
}
public function utf8(points: List<Integer>): Bytes {
    let raw = Bytes()
    for point in points {
        if point < 128 { raw.add(point) }
        else if point < 2048 { raw.add(192 | (point >> 6)); raw.add(128 | (point & 63)) }
        else if point < 65536 { raw.add(224 | (point >> 12)); raw.add(128 | ((point >> 6) & 63)); raw.add(128 | (point & 63)) }
        else { raw.add(240 | (point >> 18)); raw.add(128 | ((point >> 12) & 63)); raw.add(128 | ((point >> 6) & 63)); raw.add(128 | (point & 63)) }
    }
    return raw
}
public function literal(value: Text): Text {
    let raw = Bytes(value); let pieces: List<Text> = ["\""]; let start = 0
    for index in 0..raw.length {
        let byte = raw[index]
        if byte == 92 || byte == 34 || byte == 10 || byte == 13 || byte == 9 {
            pieces.add(Text(raw.slice(start, index)))
            if byte == 92 { pieces.add("\\\\") }; if byte == 34 { pieces.add("\\\"") }
            if byte == 10 { pieces.add("\\n") }; if byte == 13 { pieces.add("\\r") }; if byte == 9 { pieces.add("\\t") }
            start = index + 1
        }
    }
    pieces.add(Text(raw.slice(start, raw.length))); pieces.add("\""); return joinText(pieces)
}
public function slice(points: List<Integer>, start: Integer, end: Integer): Text {
    let values: List<Integer> = []
    for index in start..end { values.add(points[index]) }
    return Text(utf8(values))
}
public record Division { quotient: Integer; remainder: Integer }
public function division(left: Integer, right: Integer): Division {
    let numerator = left; if numerator < 0 { numerator = -numerator }
    let divisor = right; if divisor < 0 { divisor = -divisor }
    let shifted = divisor; let bit = 1; let quotient = 0; let remainder = numerator
    while shifted <= remainder - shifted { shifted = shifted << 1; bit = bit << 1 }
    while bit > 0 {
        if remainder >= shifted { remainder -= shifted; quotient += bit }
        shifted = shifted >> 1; bit = bit >> 1
    }
    if (left < 0) != (right < 0) { quotient = -quotient }
    if left < 0 { remainder = -remainder }
    return Division { quotient: quotient; remainder: remainder }
}
public function repeat(value: Text, count: Integer): Text { let pieces: List<Text> = []; for unused in 0..count { pieces.add(value) }; return joinText(pieces) }
