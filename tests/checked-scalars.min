use "../tools/testing.min" as test
use "system" as system
function traps(compiler: test.Compiler, source: Text, message: Text) {
    test.require(test.compile(compiler, source), "compile checked scalar")
    let path = compiler.directory + "/case" + Text(compiler.serial)
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization]
        for flag in compiler.flags { command.add(flag) }
        for item in ["-Wno-override-module", path + ".ll", compiler.runtime, "-lm", "-o", path + ".exe"] { command.add(item) }
        test.require(test.run(command, system.environment(), "", path + ".link", 30), "link checked scalar " + optimization)
        let result = test.run([path + ".exe"], system.environment(), "", path + ".run", compiler.runTimeout)
        test.check(result.status == 1, "scalar failure status " + optimization + "\n" + result.errorOutput)
        test.check(result.output == "11\n22\n", "scalar failure evaluation order " + optimization)
        test.check(result.errorOutput == "Minyar stopped: " + message + "\n", "scalar failure diagnostic " + optimization + "\n" + result.errorOutput)
    }
}
let compiler = test.compiler()
