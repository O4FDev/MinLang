    """#, "-9223372036854775808\n-9223372036854775808\n9221120237041090626\n0\n")
test.executes(compiler, #"""
    function shift(a: Integer,b: Integer): Integer { return a << b }
    function right(a: Integer,b: Integer): Integer { return a >> b }
    function character(a: Integer): Integer { return Integer(Character(a)) }
    function integer(a: Float): Integer { return Integer(a) }
    function amplitude(a: Integer): Integer { return abs(a) }
    print(shift(1,63))
    print(shift(-1,63))
    print(right(-9223372036854775808,63))
    print(shift(-9223372036854775808,0))
    print(character(0))
    print(character(55295))
    print(character(57344))
    print(character(1114111))
    print(integer(-9223372036854775808.0))
    print(integer(9223372036854774784.0))
    print(integer(-0.0))
    print(integer(-1.75))
    print(amplitude(-9223372036854775807))
    print(clamp(42,7,7))
    print(clamp(-1.0,0.0,2.0))
    print(clamp(0.0/0.0,0.0,2.0))

    """#, "-9223372036854775808\n-9223372036854775808\n-1\n-9223372036854775808\n0\n55295\n57344\n1114111\n-9223372036854775808\n9223372036854774784\n0\n-1\n9223372036854775807\n7\n0.0\n0.0\n")
for operator in ["<<", ">>"] {
    for count in [-9223372036854775808, -1, 64, 9223372036854775807] {
        traps(compiler, "function left(): Integer { print(11); return -1 }\nfunction right(): Integer { print(22); return " + Text(count) + " }\nprint(left() " + operator + " right())\n", "a shift count must be between 0 and 63.")
    }
}
for value in [-9223372036854775808, -1, 55296, 57343, 1114112, 9223372036854775807] {
    traps(compiler, "function value(): Integer { print(11); print(22); return " + Text(value) + " }\nprint(Character(value()))\n", "this Integer is not a Unicode scalar value.")
}
traps(compiler, #"""
    function value(): Float { print(11); print(22); return 0.0/0.0 }
    print(Integer(value()))

    """#, "NaN cannot be converted to an Integer.")
traps(compiler, #"""
    function value(): Float { print(11); print(22); return 9223372036854775808.0 }
    print(Integer(value()))

    """#, "this Float is outside the Integer range.")
traps(compiler, #"""
    function value(): Float { print(11); print(22); return -9223372036854777856.0 }
    print(Integer(value()))

    """#, "this Float is outside the Integer range.")
traps(compiler, #"""
    function value(): Float { print(11); print(22); return 1.0/0.0 }
    print(Integer(value()))

    """#, "this Float is outside the Integer range.")
traps(compiler, #"""
    function value(): Float { print(11); print(22); return -1.0/0.0 }
    print(Integer(value()))

    """#, "this Float is outside the Integer range.")
traps(compiler, #"""
    function value(): Integer { print(11); print(22); return -9223372036854775808 }
    print(abs(value()))

    """#, "the absolute value of this Integer is outside the supported range.")
traps(compiler, #"""
    function lower(): Integer { print(11); return 7 }
    function upper(): Integer { print(22); return 6 }
    print(clamp(0, lower(), upper()))

    """#, "clamp needs a lower bound that is not above its upper bound.")
traps(compiler, #"""
    function lower(): Float { print(11); return 7.0 }
    function upper(): Float { print(22); return 6.0 }
    print(clamp(0.0, lower(), upper()))

    """#, "clamp needs a lower bound that is not above its upper bound.")
traps(compiler, #"""
    function lower(): Float { print(11); return 0.0/0.0 }
    function upper(): Float { print(22); return 1.0 }
    print(clamp(0.0, lower(), upper()))

    """#, "clamp needs a lower bound that is not above its upper bound.")
traps(compiler, #"""
    function lower(): Float { print(11); return 0.0 }
    function upper(): Float { print(22); return 0.0/0.0 }
    print(clamp(0.0, lower(), upper()))

    """#, "clamp needs a lower bound that is not above its upper bound.")
test.require(test.compile(compiler, #"""
    print(Character(65))
    print(Integer(1.5))
    print(abs(-42))
    print(clamp(7,0,1))
    print(1<<7)

    """#), "compile scalar guards")
let ir = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
test.check(test.contains(ir, "@.minyar.shift.checked"), "missing scalar guard shift.checked")
test.check(test.contains(ir, "@.minyar.character.checked"), "missing scalar guard character.checked")
test.check(test.contains(ir, "@.minyar.float.integer.checked"), "missing scalar guard float.integer.checked")
test.check(test.contains(ir, "@.minyar.integer.absolute.checked"), "missing scalar guard integer.absolute.checked")
test.check(test.contains(ir, "@.minyar.clamp.integer.checked"), "missing scalar guard clamp.integer.checked")
test.check(test.contains(ir, "@.minyar.clamp.float.checked"), "missing scalar guard clamp.float.checked")
test.check(test.contains(ir, "fcmp oge double %value, -9.223372036854775808e18"), "scalar guard IR fcmp oge double %value, -9.223372036854775808e18")
test.check(test.contains(ir, "fcmp olt double %value, 9.223372036854775808e18"), "scalar guard IR fcmp olt double %value, 9.223372036854775808e18")
test.check(!test.contains(ir, "0xC3E0000000000000"), "scalar guard IR 0xC3E0000000000000")
test.check(!test.contains(ir, "0x43E0000000000000"), "scalar guard IR 0x43E0000000000000")
test.removeTree(compiler.directory)
print("Checked scalars: passed")
