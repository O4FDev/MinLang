traps(compiler, "function value(): Float { print(11); print(22); return 1.0/0.0 }\nprint(Integer(value()))\n", "this Float is outside the Integer range.")
traps(compiler, "function value(): Float { print(11); print(22); return -1.0/0.0 }\nprint(Integer(value()))\n", "this Float is outside the Integer range.")
traps(compiler, "function value(): Integer { print(11); print(22); return -9223372036854775808 }\nprint(abs(value()))\n", "the absolute value of this Integer is outside the supported range.")
traps(compiler, "function lower(): Integer { print(11); return 7 }\nfunction upper(): Integer { print(22); return 6 }\nprint(clamp(0, lower(), upper()))\n", "clamp needs a lower bound that is not above its upper bound.")
traps(compiler, "function lower(): Float { print(11); return 7.0 }\nfunction upper(): Float { print(22); return 6.0 }\nprint(clamp(0.0, lower(), upper()))\n", "clamp needs a lower bound that is not above its upper bound.")
traps(compiler, "function lower(): Float { print(11); return 0.0/0.0 }\nfunction upper(): Float { print(22); return 1.0 }\nprint(clamp(0.0, lower(), upper()))\n", "clamp needs a lower bound that is not above its upper bound.")
traps(compiler, "function lower(): Float { print(11); return 0.0 }\nfunction upper(): Float { print(22); return 0.0/0.0 }\nprint(clamp(0.0, lower(), upper()))\n", "clamp needs a lower bound that is not above its upper bound.")
test.require(test.compile(compiler, "print(Character(65))\nprint(Integer(1.5))\nprint(abs(-42))\nprint(clamp(7,0,1))\nprint(1<<7)\n"), "compile scalar guards")
let ir = readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
test.check(test.contains(ir, "@.minyar.shift.checked"), "missing scalar guard shift.checked")
test.check(test.contains(ir, "@.minyar.character.checked"), "missing scalar guard character.checked")
test.check(test.contains(ir, "@.minyar.float.integer.checked"), "missing scalar guard float.integer.checked")
test.check(test.contains(ir, "@.minyar.integer.absolute.checked"), "missing scalar guard integer.absolute.checked")
test.check(test.contains(ir, "@.minyar.clamp.integer.checked"), "missing scalar guard clamp.integer.checked")
test.check(test.contains(ir, "@.minyar.clamp.float.checked"), "missing scalar guard clamp.float.checked")
test.check(test.contains(ir, "fcmp oge double %value, -9.223372036854775808e18"), "scalar guard IR fcmp oge double %value, -9.223372036854775808e18")
test.check(test.contains(ir, "fcmp olt double %value, 9.223372036854775808e18"), "scalar guard IR fcmp olt double %value, 9.223372036854775808e18")
test.check(!test.contains(ir, "0xC3E0000000000000"), "scalar guard IR 0xC3E0000000000000")
test.check(!test.contains(ir, "0x43E0000000000000"), "scalar guard IR 0x43E0000000000000")
test.removeTree(compiler.directory)
print("Checked scalars: passed")
