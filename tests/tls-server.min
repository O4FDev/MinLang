use "net" as net
use "tlsserver" as tls

function main(): Integer {
    let session = tls.server(randomBytes(64), "http/1.1", [readBytesFile(argument(0))], readBytesFile(argument(1)), [readBytesFile(argument(2))], true)
    let listener = net.listen("127.0.0.1", 0, 16)
    if listener < 0 { print("listen failed"); return 2 }
    print("READY " + Text(net.localPort(listener)))
    if !net.ready(listener, 10000) { net.close(listener); return 3 }
    let connection = net.accept(listener); net.close(listener)
    if connection < 0 { return 4 }
    while session.state == tls.STARTING || session.state == tls.HANDSHAKE {
        if !net.ready(connection, 5000) { net.close(connection); return 5 }
        let data = net.receive(connection, 65536)
        if data.length == 0 { net.close(connection); return 6 }
        tls.receive(session, data)
        let reply = tls.takeOutgoing(session)
        if reply.length > 0 { net.send(connection, reply) }
    }
    if session.state != tls.ESTABLISHED { print(session.error); net.close(connection); return 1 }
    if !session.authenticated || session.peerCertificate.length == 0 { net.close(connection); return 7 }
    if tls.takeIncoming(session).length == 0 {
        if !net.ready(connection, 5000) { net.close(connection); return 8 }
        tls.receive(session, net.receive(connection, 65536))
    }
    tls.send(session, Bytes("pong"))
    tls.close(session)
    net.send(connection, tls.takeOutgoing(session))
    net.close(connection)
    print("verified client certificate")
    return 0
}
