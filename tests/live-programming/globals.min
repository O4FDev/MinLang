use "./global.min" as imported
record Counter { count: Integer }
global STATE: Counter = Counter { count: 1 }
function next(): Integer { STATE.count += 1; return STATE.count }
function shadow(STATE: Counter): Integer { return STATE.count }
print(next())
print(imported.next())
print(imported.next())
print(imported.shadow())
print(shadow(Counter { count: 9 }))
print(next())
