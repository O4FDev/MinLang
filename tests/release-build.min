use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "./release-support.min" as support
use "system" as system

function chosen(name: Text): Boolean {
    if processInfo.argumentCount() == 0 { return true }
    for index in 0..processInfo.argumentCount() { if processInfo.argument(index) == name || processInfo.argument(index) == "ReleaseBuild." + name { return true } }
    return false
}
function parent(path: Text): Text {
    let raw = Bytes(path)
    let ending = -1
    for index in 0..raw.length { if raw[index] == 47 { ending = index } }
    if ending <= 0 { return "/" }
    return Text(raw.slice(0, ending))
}
function basename(path: Text): Text {
    let raw = Bytes(path)
    let start = 0
    for index in 0..raw.length { if raw[index] == 47 { start = index + 1 } }
    return Text(raw.slice(start, raw.length))
}
function release(overrides: List<Text>): List<Text> {
    let result: List<Text> = []
    for entry in system.environment() {
        if !support.starts(entry, "MINYAR_CLANG_FLAGS=") { result.add(entry) }
    }
    return support.merge(result, overrides)
}
let names = ["test_release_and_custom_flags", "test_release_usage_errors", "test_release_preserves_runtime_checks"]
for index in 0..processInfo.argumentCount() {
    let valid = false
    for name in names { if processInfo.argument(index) == name || processInfo.argument(index) == "ReleaseBuild." + name { valid = true } }
    test.check(valid, "unknown release build case " + processInfo.argument(index))
}
let work = test.scratch()
let rootResult = test.run(["pwd", "-P"], system.environment(), "", work + "/root", 10)
test.require(rootResult, "resolve release build root")
let root = test.lines(rootResult.output)[0]
let cases = 0
if chosen("test_release_and_custom_flags") {
    let source = work + "/source with spaces.min"
    let output = work + "/program with spaces"
    io.writeTextFile(source, test.sourceModules("let values: List<Integer> = [19, 23]\nprint(values[0] + values[1])\n"))
    let log = work + "/clang-args.txt"
    let shim = work + "/clang-capture"
    let clang = test.lines(support.output(["/bin/sh", "-c", "command -v \"$1\"", "minyar", test.setting("MINYAR_TEST_CLANG", "clang")], work + "/which-clang"))[0]
    io.writeTextFile(shim, "#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$MINYAR_RELEASE_ARGUMENT_LOG\"\nexec '" + clang + "' \"$@\"\n")
    test.require(test.run(["chmod", "755", shim], system.environment(), "", work + "/shim-mode", 10), "release argument shim mode")
    let base = ["LIMITED=", "SANITIZER_LIMITED=", "MINYAR_CLANG=" + shim, "MINYAR_RELEASE_ARGUMENT_LOG=" + log]
    let expectations = ["-O2", "-O2", "-O1"]
    for index in 0..3 {
        let flags: List<Text> = []
        let overrides = support.copy(base)
        let lto = index > 0
        if lto { flags.add("--release") }
        if index == 2 { overrides.add("MINYAR_CLANG_FLAGS=-O1 -Wno-override-module") }
        let environment = release(overrides)
        let command = [root + "/minyar"]
        for flag in flags { command.add(flag) }
        for item in [source, "-o", output] { command.add(item) }
        let built = test.run(command, environment, work, work + "/build" + Text(index), 120)
        test.check(built.status == 0, "release build failed\n" + built.errorOutput)
        let arguments = test.lines(io.readTextFile(log))
        test.check(support.has(arguments, expectations[index]), "release build optimization " + expectations[index])
        let sawLto = false
        for argument in arguments { if support.starts(argument, "-flto") { sawLto = true } }
        test.check(sawLto == lto, "release build LTO selection " + Text(index))
        let runtimeName = "runtime.o"
        if lto { runtimeName = "runtime.ll" }
        let runtimePath = ""
        for argument in arguments { if runtimePath == "" && basename(argument) == runtimeName { runtimePath = argument } }
        test.check(runtimePath != "", "release build runtime argument " + runtimeName)
        test.check(support.starts(basename(parent(runtimePath)), "invocation."), "release runtime is invocation-local")
        test.check(parent(parent(runtimePath)) == root + "/build/programs", "release runtime lives in project programs")
        let ran = test.run([output], system.environment(), "", work + "/program" + Text(index), 10)
        test.check(ran.status == 0 && ran.output == "42\n", "release program output\n" + ran.output + ran.errorOutput)
    }
    cases += 1
}
if chosen("test_release_usage_errors") {
    let serial = 0
    for arguments in [["--release"], ["--release", "--release"], ["--release", "examples/hello.min", "--unknown"]] {
        serial += 1
        let command = [root + "/minyar"]
        for item in arguments { command.add(item) }
        let result = test.run(command, system.environment(), root, work + "/usage" + Text(serial), 10)
        test.check(result.status == 2, "release usage status " + Text(result.status))
        test.check(test.contains(result.errorOutput, "usage:"), "release usage diagnostic\n" + result.errorOutput)
    }
    cases += 1
}
if chosen("test_release_preserves_runtime_checks") {
    let source = work + "/checked.min"
    let output = work + "/checked"
    let environment = release(["LIMITED=", "SANITIZER_LIMITED="])
    let programs = ["let value = 9223372036854775807\nprint(value + 1)\n", "let values: List<Integer> = [42]\nprint(values[1])\n", "let divisor = 0\nprint(42 / divisor)\n"]
    let diagnostics = ["Integer calculation is outside", "outside its length", "Integer cannot be divided by zero"]
    for index in 0..3 {
        io.writeTextFile(source, test.sourceModules(programs[index]))
        let built = test.run([root + "/minyar", "--release", source, "-o", output], environment, work, work + "/checked-build" + Text(index), 120)
        test.check(built.status == 0, "release checked build failed\n" + built.errorOutput)
        let ran = test.run([output], system.environment(), "", work + "/checked-run" + Text(index), 10)
        test.check(ran.status != 0, "release keeps runtime check " + diagnostics[index])
        test.check(test.contains(ran.errorOutput, diagnostics[index]), "release runtime diagnostic\n" + ran.errorOutput)
    }
    cases += 1
}
test.removeTree(work)
print("Release build: " + Text(cases) + " cases passed")
