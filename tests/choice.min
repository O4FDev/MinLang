use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, io.readTextFile("tests/choice/shapes.min"), "12.0\n12.0\n0.0\nround\ndawn\nday\ndusk\n", levels, 0, "", true)
fixtures.executes(frontend, io.readTextFile("tests/choice/ownership.min"), "hello world\nhello world\n1\nbefore\nafter\n3\n", levels, 0, "", true)
fixtures.executes(frontend, io.readTextFile("tests/choice/composition.min"), "words\ntask\nok\nbytes\nmap\n1\n2\n2\n", levels, 0, "", true)
io.writeTextFile(frontend.compiler.directory + "/weather.min", io.readTextFile("tests/choice/module.min"))
fixtures.executes(frontend, "use \"./weather.min\" as weather\nfunction describe(value: weather.Weather): Integer { match value { Sun { return 0 } Rain(drops) { return drops } } }\nprint(describe(weather.today()))\nprint(describe(weather.Weather.Rain(42)))\nprint(describe(weather.tomorrow()))\n", "0\n42\n7\n", levels, 0, "", true)
let modulePath = frontend.compiler.directory + "/case" + Text(frontend.compiler.serial)
io.writeTextFile(modulePath + ".prior", "")
test.require(test.run([frontend.compiler.executable, modulePath + ".min", modulePath + ".module.ll", "--module-state", modulePath + ".prior", modulePath + ".state", modulePath + ".stats", "--library", "library"], frontend.environment, "", modulePath + ".module-build", 30), "compile choices through module-state fallback")
let moduleCode = io.readTextFile(modulePath + ".module.ll")
if test.addressEnabled(frontend.compiler.flags) { moduleCode = test.instrument(moduleCode) }
test.check(moduleCode == io.readTextFile(modulePath + ".ll"), "choice module-state LLVM differs from ordinary compilation")
fixtures.rejects(frontend, "use \"./weather.min\" as weather\nlet value = weather.Secret.Hidden\n", "is private to its module", true)
fixtures.rejects(frontend, "use \"./weather.min\" as weather\nlet value = Hidden\n", "I can't find a value named", true)
fixtures.rejects(frontend, "choice Shape { Circle(radius: Float); Empty; Square }\nmatch Circle(2.0) { Circle(radius) { print(radius) } }\n", "match is missing cases: Empty, Square", true)
fixtures.rejects(frontend, "choice Light { On; Off }\nmatch On { On {} On {} Off {} }\n", "duplicate match arm 'On'", true)
fixtures.rejects(frontend, "choice Light { On; Off }\nmatch On { else {} Off {} }\n", "else must be the last match arm", true)
fixtures.rejects(frontend, "choice Light { On; Off }\nmatch On { Other {} }\n", "unknown case 'Other'", true)
fixtures.rejects(frontend, "choice Light { On; On }\n", "duplicate choice case 'On'", true)
fixtures.rejects(frontend, "choice Light {}\n", "a choice needs at least one case", true)
fixtures.rejects(frontend, "choice Light { on }\n", "a choice case needs a capitalised name", true)
fixtures.rejects(frontend, "choice A { Same }\nchoice B { Same }\nlet value = Same\n", "ambiguous choice case 'Same'", true)
fixtures.executes(frontend, "choice A { Same }\nchoice B { Same }\nlet value: A = Same\nlet other = B.Same\nmatch value { Same { print(1) } }\nmatch other { Same { print(2) } }\n", "1\n2\n", levels, 0, "", true)
fixtures.rejects(frontend, "choice Box { Item(value: Integer) }\nlet value = Item(\"wrong\")\n", "choice payload has the wrong type", true)
fixtures.rejects(frontend, "choice Box { Item(value: Integer) }\nmatch Item(1) { Item() {} }\n", "expected a choice payload binding", true)
fixtures.rejects(frontend, "choice Box { Item(a: Integer, b: Integer) }\nmatch Item(1, 2) { Item(x, x) {} }\n", "duplicate choice payload binding 'x'", true)
fixtures.rejects(frontend, "choice Box { Item(value: Nothing) }\n", "Nothing", true)
fixtures.rejects(frontend, "choice Box { Item(value: Integer) }\nlet box = Box {}\n", "choice values require a case constructor", true)
fixtures.rejects(frontend, "choice Box { Item(value: Integer) }\nmatch Item(1) { Item(value) {} }\nprint(value)\n", "I can't find a value named 'value'", true)
fixtures.rejects(frontend, "choice Toggle { Value(value: Boolean); Empty }\nmatch Value(true) { Value(false) {} else {} }\n", "expected a choice payload binding", true)
fixtures.executes(frontend, io.readTextFile("examples/gallery/choice.min"), "the moon keeps a little light\n", levels, 0, "", true)
test.removeTree(frontend.compiler.directory)
print("Choices: passed")
