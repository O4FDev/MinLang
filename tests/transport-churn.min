use "transport" as transport
use "net" as net
use "errors" as errors
use "crypto" as crypto
function number(text: Text): Integer { let n=0;for digit in text { n=n*10+Integer(digit)-48 };return n }
function main(): Integer {
    let server=argument(0)=="server";let total=number(argument(5))
    let identity=readBytesFile(argument(2));let key=readBytesFile(argument(3));let root=readBytesFile(argument(4))
    let connection=transport.client("localhost",randomBytes(80),"minyar-test",[root],[identity],key);let socket=-1
    if server {
        let listener=net.listen("127.0.0.1",0,16);if listener<0 { return 1 };print("READY "+Text(net.localPort(listener)))
        if !net.ready(listener,10000) { return 2 };socket=net.accept(listener);net.close(listener)
        connection=transport.serverTCP(randomBytes(64),"minyar-test",[identity],key,[root],true,0)
    } else {
        socket=net.connect("127.0.0.1",number(argument(1)));transport.udpUnavailable(connection);transport.startTCP(connection,randomBytes(64),0)
    }
    if socket<0 || total<1 || total>4096 { return 3 }
    let started=net.monotonicMilliseconds();let completed=0;let id=-1;let previous=-1;let data=Bytes()
    while net.monotonicMilliseconds()-started<90000 {
        let now=net.monotonicMilliseconds()-started
        if connection.state==transport.TCP_READY {
            if id<0 && !server && completed<total {
                let opened=transport.openStream(connection)
                if !errors.integerOk(opened) { print("sequential RPC open failed at "+Text(completed+1));return 4 }
                id=errors.integerValue(opened)
                if previous>=0 && (id<=previous || errors.integerOk(transport.write(connection,previous,Bytes("stale"),false))) { return 12 }
                let payload=Bytes(1+(completed*7919)%32768);for at in 0..payload.length { payload[at]=completed%251 }
                if !errors.integerOk(transport.write(connection,id,payload,true)) { return 5 }
            }
            if server && id<0 {
                for candidate in transport.streamIds(connection) { if candidate>previous { id=candidate;break } }
            }
            while id>=0 {
                let received=transport.read(connection,id)
                if errors.bytesStatus(received)==errors.successStatus() { data.addBytes(errors.bytesValue(received)) }
                else if errors.bytesStatus(received)==errors.endOfStreamStatus() {
                    if data.length!=1+(completed*7919)%32768 { return 6 }
                    for byte in data { if byte!=completed%251 { return 7 } }
                    if server && !errors.integerOk(transport.write(connection,id,data,true)) { return 8 }
                    previous=id;id=-1;data=Bytes();completed+=1
                } else if errors.bytesStatus(received)!=errors.wouldBlockStatus() { print("read failed at "+Text(completed+1));return 13 }
                else { break }
            }
            if connection.mux.streams.length>128 || connection.mux.buffered>1048576 { return 14 }
        }
        let outgoing=transport.pollTCP(connection,now);let at=0
        while at<outgoing.length { let count=net.send(socket,outgoing.slice(at,min(outgoing.length,at+65536)));if count<=0 { return 9 };at+=count }
        if completed==total { transport.close(connection);net.send(socket,transport.pollTCP(connection,now));net.close(socket);print("Minyar TLS/yamux: "+Text(completed)+" sequential authenticated RPCs passed; slots "+Text(connection.mux.streams.length));return 0 }
        if connection.state==transport.FAILED { print(connection.error);return 10 }
        if net.ready(socket,1) {
            let incoming=net.receive(socket,65536);if incoming.length==0 { transport.endTCPInput(connection);print(connection.error);return 11 }
            transport.receiveTCP(connection,incoming,net.monotonicMilliseconds()-started)
        }
    }
    net.close(socket);print("sequential RPC timeout "+Text(completed));return 15
}
