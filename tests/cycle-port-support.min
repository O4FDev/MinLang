use "../tools/testing.min" as test
use "../tools/cycle-runtime.min" as cycle
use "./thread-port-support.min" as support
use "system" as system
use "files" as files
use "json" as json

public record Schedule { fixture: Text; name: Text; prefix: List<Text>; choices: List<Integer>; defaults: List<Integer>; fixedNodes: List<Integer>; legacyFlag: Text }
function numbers(values: List<Integer>): Text {
    let parts: List<Text> = []
    for value in values { parts.add(Text(value)) }
    return "[" + support.joined(parts, ", ") + "]"
}
function save(output: Text, passed: Boolean, sanitize: Boolean, legacy: Text, nodes: List<Integer>, inputs: List<Text>, cases: List<Text>) {
    writeTextFile(output + "/manifest.json", "{\n  \"passed\": " + Text(passed) + ",\n  \"sanitize\": " + Text(sanitize) + "," + legacy + "\n  \"nodes\": " + numbers(nodes) + ",\n  \"inputs\": {" + support.joined(inputs, ", ") + "},\n  \"cases\": [" + support.joined(cases, ", ") + "]\n}\n")
}
public function campaign(schedule: Schedule) {
    let sanitize = false
    let quick = false
    let legacy = false
    let nodes: List<Integer> = []
    let evidence = ""
    let index = 0
    while index < argumentCount() {
        let option = argument(index)
        if option == "--sanitize" { sanitize = true }
        else if option == "--quick" { quick = true }
        else if option == "--legacy-service" && schedule.legacyFlag != "" { legacy = true }
        else if option == "--evidence" {
            test.check(index + 1 < argumentCount(), "--evidence needs a value")
            evidence = argument(index + 1)
            index += 1
        } else if option == "--nodes" {
            while index + 1 < argumentCount() && !support.starts(argument(index + 1), "--") {
                let value = argument(index + 1)
                let found = false
                for choice in schedule.choices { if Text(choice) == value { found = true; nodes.add(choice) } }
                test.check(found, "invalid --nodes choice: " + value)
                index += 1
            }
            test.check(nodes.length > 0, "--nodes needs at least one value")
        } else { fail("unknown option: " + option) }
        index += 1
    }
    if nodes.length == 0 { nodes = schedule.defaults }
    let output = evidence
    if output == "" { output = "build/" + schedule.name }
    let logs = test.scratch()
    test.require(test.run(["mkdir", "-p", "--", output], system.environment(), "", logs + "/mkdir", 10), "create evidence directory")
    test.removeScratch(logs)
    test.check(files.makeDirectory("build") == 0, "cannot create build directory")
    cycle.publishEngine(".", "")
    let paths = ["tests/" + schedule.fixture, "tests/" + schedule.name + ".min", "tools/cycle-runtime.min", "runtime/minyar_runtime.c"]
    for path in support.treeFiles(["runtime"]) {
        let raw = Bytes(path)
        if raw.length > 10 && Text(raw.slice(raw.length - 2, raw.length)) == ".h" && support.find(Text(raw.slice(8, raw.length)), "/", 0) < 0 { paths.add(path) }
    }
    let inputs = support.digestMembers(paths)
    let cases: List<Text> = []
    let legacyField = ""
    if schedule.legacyFlag != "" { legacyField = "\n  \"legacy_service\": " + Text(legacy) + "," }
    save(output, false, sanitize, legacyField, nodes, inputs, cases)
    let flags = ["-O2"]
    if sanitize { flags = ["-O1", "-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"] }
    let environment = support.environment(system.environment(), ["ASAN_OPTIONS", "UBSAN_OPTIONS"], [support.asanLeakOptions() + ":halt_on_error=1", "halt_on_error=1:print_stacktrace=1"])
    let clang = test.setting("MINYAR_TEST_CLANG", "clang")
    let profiles = ["system", "fixed", "eager"]
    let options = ["-DMINYAR_SYSTEM_HEAP=1", "-DMINYAR_BOUNDED_HEAP=1", ""]
    for position in 0..profiles.length {
        let profile = profiles[position]
        let budgets = [1, 32, 1024]
        if quick { budgets = [1, 32] }
        if profile == "eager" { budgets = [32] }
        for budget in budgets {
            let label = profile + "-k" + Text(budget)
            let binary = output + "/" + label
            let command = [clang]
            for flag in flags { command.add(flag) }
            for item in ["-std=c11", "-Wall", "-Wextra", "-Werror", "-iquote", "runtime"] { command.add(item) }
            if options[position] != "" { command.add(options[position]) }
            command.add("-DMINYAR_BOUNDED_HEAP_BYTES=1048576")
            command.add("-DMINYAR_RC_POLL_BUDGET=" + Text(budget))
            if legacy { command.add(schedule.legacyFlag) }
            for item in ["tests/" + schedule.fixture, "-lm", "-o", binary] { command.add(item) }
            let phases = ["compile"]
            let commands = [command]
            let selected = nodes
            if profile == "fixed" && schedule.fixedNodes.length > 0 { selected = schedule.fixedNodes }
            for count in selected {
                phases.add("run-n" + Text(count))
                let argv = [binary]
                for item in schedule.prefix { argv.add(item) }
                argv.add(Text(count))
                commands.add(argv)
            }
            for step in 0..phases.length {
                let phase = phases[step]
                let result = test.run(commands[step], environment, "", output + "/." + label + "-" + phase, 120)
                files.remove(output + "/." + label + "-" + phase)
                files.remove(output + "/." + label + "-" + phase + ".err")
                writeTextFile(output + "/" + label + "-" + phase + ".stdout", result.output)
                writeTextFile(output + "/" + label + "-" + phase + ".stderr", result.errorOutput)
                let entry = "{\"profile\": " + json.quote(label) + ", \"phase\": " + json.quote(phase) + ", \"argv\": " + support.quotedList(commands[step]) + ", \"status\": " + Text(result.status) + ", \"stdout\": " + json.quote(result.output) + ", \"stderr\": " + json.quote(result.errorOutput)
                if files.pathSize(binary) >= 0 { entry = entry + ", \"binary_sha256\": " + json.quote(support.digest(binary)) }
                cases.add(entry + "}")
                if result.status != 0 {
                    save(output, false, sanitize, legacyField, nodes, inputs, cases)
                    fail(label + " " + phase + ": " + Text(result.status) + "\n" + result.output + result.errorOutput)
                }
                if phase != "compile" { print(label + " " + phase + ": " + trimmed(result.output)) }
            }
        }
    }
    save(output, true, sanitize, legacyField, nodes, inputs, cases)
}
public function trimmed(text: Text): Text {
    let raw = Bytes(text)
    let start = 0
    let end = raw.length
    while start < end && raw[start] <= 32 { start += 1 }
    while end > start && raw[end - 1] <= 32 { end -= 1 }
    return Text(raw.slice(start, end))
}
public record Phase { label: Text; argv: List<Text> }
public record Group { label: Text; binary: Text; phases: List<Phase> }
public record Outcome { cases: List<Text>; resources: List<Text>; failed: Text; digest: Text }
record Slot { group: Integer; phase: Integer; handle: Integer; started: Integer; total: Integer; idle: Integer; stopped: Boolean; maximum: Float }
public function testJobs(): Integer {
    let value = system.getenv("MINYAR_TEST_JOBS")
    if value == "" { return 2 }
    let parsed = 0
    for byte in Bytes(value) {
        test.check(byte >= 48 && byte <= 57, "MINYAR_TEST_JOBS must be a decimal Integer")
        parsed = parsed * 10 + byte - 48
    }
    return max(1, parsed)
}
public function cpuGuard(): Boolean {
    return support.host() == "Linux" && system.getenv("MINYAR_TEST_SHARED_HOST") == ""
}
function counters(): List<Integer> {
    let fields = test.words(test.lines(readTextFile("/proc/stat"))[0])
    let total = 0
    for index in 1..9 { total += parseInteger(fields[index]) }
    return [total, parseInteger(fields[4]) + parseInteger(fields[5])]
}
public function parseInteger(value: Text): Integer {
    let result = 0
    for byte in Bytes(value) {
        test.check(byte >= 48 && byte <= 57, "invalid decimal Integer: " + value)
        result = result * 10 + byte - 48
    }
    return result
}
function pause() {
    let handle = system.spawn("/bin/sleep", ["sleep", "0.25"], system.environment(), "")
    test.check(handle > 0, "cannot pause")
    system.wait(handle)
}
function seconds(started: Integer): Text {
    return Text(Float(system.monotonicNanoseconds() - started) / 1000000000.0)
}
public function runGroups(groups: List<Group>, environment: List<Text>, output: Text, jobs: Integer, guard: Boolean, progress: Boolean): List<Outcome> {
    let outcomes: List<Outcome> = []
    for unused in groups { outcomes.add(Outcome { cases: []; resources: []; failed: ""; digest: "" }) }
    let slots: List<Slot> = []
    let next = 0
    while next < groups.length || slots.length > 0 {
        while slots.length < jobs && next < groups.length {
            slots.add(launch(groups, next, 0, environment, output))
            next += 1
        }
        let remaining: List<Slot> = []
        for slot in slots {
            let group = groups[slot.group]
            let phase = group.phases[slot.phase]
            let log = output + "/" + group.label + "-" + phase.label
            let status = system.poll(slot.handle)
            if status.state == system.PENDING {
                if guard {
                    let current = counters()
                    let delta = current[0] - slot.total
                    let usage = 0.0
                    if delta != 0 { usage = 100.0 * (1.0 - Float(current[1] - slot.idle) / Float(delta)) }
                    if usage > slot.maximum { slot.maximum = usage }
                    slot.total = current[0]
                    slot.idle = current[1]
                    let pid = system.childProcessId(slot.handle)
                    if usage >= 75.0 && !slot.stopped {
                        system.sendSignal(-pid, 19)
                        slot.stopped = true
                        outcomes[slot.group].resources.add("{\"label\": " + json.quote(group.label + "-" + phase.label) + ", \"action\": \"pause\", \"aggregate_cpu_percent\": " + Text(usage) + "}")
                    } else if slot.stopped && usage < 60.0 {
                        system.sendSignal(-pid, 18)
                        slot.stopped = false
                        outcomes[slot.group].resources.add("{\"label\": " + json.quote(group.label + "-" + phase.label) + ", \"action\": \"resume\", \"aggregate_cpu_percent\": " + Text(usage) + "}")
                    }
                }
                remaining.add(slot)
                continue
            }
            test.check(status.error == 0 && (status.state == system.EXITED || status.state == system.SIGNALED), "process wait failed")
            let code = status.exitCode
            if status.state == system.SIGNALED { code = 128 + status.signal }
            let stdout = readTextFile(log + ".stdout")
            let stderr = readTextFile(log + ".stdout.err")
            files.remove(log + ".stdout.err")
            writeTextFile(log + ".stderr", stderr)
            if guard { outcomes[slot.group].resources.add("{\"label\": " + json.quote(group.label + "-" + phase.label) + ", \"maximum_aggregate_cpu_percent\": " + Text(slot.maximum) + "}") }
            else { outcomes[slot.group].resources.add("{\"label\": " + json.quote(group.label + "-" + phase.label) + ", \"cpu_guard\": false}") }
            let entry = "{\"label\": " + json.quote(group.label + "-" + phase.label) + ", \"status\": " + Text(code) + ", \"stdout\": " + json.quote(stdout) + ", \"stderr\": " + json.quote(stderr) + ", \"seconds\": " + seconds(slot.started) + ", \"argv\": " + support.quotedList(phase.argv)
            if files.pathSize(group.binary) >= 0 {
                if outcomes[slot.group].digest == "" { outcomes[slot.group].digest = support.digest(group.binary) }
                entry = entry + ", \"binary_sha256\": " + json.quote(outcomes[slot.group].digest)
            }
            outcomes[slot.group].cases.add(entry + "}")
            if progress { print(group.label + "-" + phase.label + ": " + Text(code) + " " + trimmed(stderr)) }
            if code != 0 {
                outcomes[slot.group].failed = group.label + "-" + phase.label
            } else if slot.phase + 1 < group.phases.length {
                remaining.add(launch(groups, slot.group, slot.phase + 1, environment, output))
            }
        }
        slots = remaining
        if slots.length > 0 { pause() }
    }
    return outcomes
}
function launch(groups: List<Group>, group: Integer, phase: Integer, environment: List<Text>, output: Text): Slot {
    let selected = groups[group]
    let log = output + "/" + selected.label + "-" + selected.phases[phase].label
    let handle = test.start(selected.phases[phase].argv, environment, "", log + ".stdout", 180)
    test.check(handle > 0, "process launch failed: " + Text(handle))
    let total = 0
    let idle = 0
    if files.pathSize("/proc/stat") >= 0 {
        let current = counters()
        total = current[0]
        idle = current[1]
    }
    return Slot { group: group; phase: phase; handle: handle; started: system.monotonicNanoseconds(); total: total; idle: idle; stopped: false; maximum: 0.0 }
}
