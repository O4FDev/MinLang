use "../tools/testing.min" as test
use "../tools/cycle-runtime.min" as cycle
use "./thread-port-support.min" as support
use "system" as system
use "files" as files
use "json" as json

public record Schedule { fixture: Text; name: Text; prefix: List<Text>; choices: List<Integer>; defaults: List<Integer>; fixedNodes: List<Integer>; legacyFlag: Text }
function numbers(values: List<Integer>): Text {
    let parts: List<Text> = []
    for value in values { parts.add(Text(value)) }
    return "[" + support.joined(parts, ", ") + "]"
}
function save(output: Text, passed: Boolean, sanitize: Boolean, legacy: Text, nodes: List<Integer>, inputs: List<Text>, cases: List<Text>) {
    writeTextFile(output + "/manifest.json", "{\n  \"passed\": " + Text(passed) + ",\n  \"sanitize\": " + Text(sanitize) + "," + legacy + "\n  \"nodes\": " + numbers(nodes) + ",\n  \"inputs\": {" + support.joined(inputs, ", ") + "},\n  \"cases\": [" + support.joined(cases, ", ") + "]\n}\n")
}
public function campaign(schedule: Schedule) {
    let sanitize = false
    let quick = false
    let legacy = false
    let nodes: List<Integer> = []
    let evidence = ""
    let index = 0
    while index < argumentCount() {
        let option = argument(index)
        if option == "--sanitize" { sanitize = true }
        else if option == "--quick" { quick = true }
        else if option == "--legacy-service" && schedule.legacyFlag != "" { legacy = true }
        else if option == "--evidence" {
            test.check(index + 1 < argumentCount(), "--evidence needs a value")
            evidence = argument(index + 1)
            index += 1
        } else if option == "--nodes" {
            while index + 1 < argumentCount() && !support.starts(argument(index + 1), "--") {
                let value = argument(index + 1)
                let found = false
                for choice in schedule.choices { if Text(choice) == value { found = true; nodes.add(choice) } }
                test.check(found, "invalid --nodes choice: " + value)
                index += 1
            }
            test.check(nodes.length > 0, "--nodes needs at least one value")
        } else { fail("unknown option: " + option) }
        index += 1
    }
    if nodes.length == 0 { nodes = schedule.defaults }
    let output = evidence
    if output == "" { output = "build/" + schedule.name }
    let logs = test.scratch()
    test.require(test.run(["mkdir", "-p", "--", output], system.environment(), "", logs + "/mkdir", 10), "create evidence directory")
    test.removeScratch(logs)
    test.check(files.makeDirectory("build") == 0, "cannot create build directory")
    cycle.publishEngine(".", "")
    let paths = ["tests/" + schedule.fixture, "tests/" + schedule.name + ".min", "tools/cycle-runtime.min", "runtime/minyar_runtime.c"]
    for path in support.treeFiles(["runtime"]) {
        let raw = Bytes(path)
        if raw.length > 10 && Text(raw.slice(raw.length - 2, raw.length)) == ".h" && support.find(Text(raw.slice(8, raw.length)), "/", 0) < 0 { paths.add(path) }
    }
    let inputs = support.digestMembers(paths)
    let cases: List<Text> = []
    let legacyField = ""
    if schedule.legacyFlag != "" { legacyField = "\n  \"legacy_service\": " + Text(legacy) + "," }
    save(output, false, sanitize, legacyField, nodes, inputs, cases)
    let flags = ["-O2"]
    if sanitize { flags = ["-O1", "-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer"] }
    let environment = support.environment(system.environment(), ["ASAN_OPTIONS", "UBSAN_OPTIONS"], [support.asanLeakOptions() + ":halt_on_error=1", "halt_on_error=1:print_stacktrace=1"])
    let clang = test.setting("MINYAR_TEST_CLANG", "clang")
    let profiles = ["system", "fixed", "eager"]
    let options = ["-DMINYAR_SYSTEM_HEAP=1", "-DMINYAR_BOUNDED_HEAP=1", ""]
    for position in 0..profiles.length {
        let profile = profiles[position]
        let budgets = [1, 32, 1024]
        if quick { budgets = [1, 32] }
        if profile == "eager" { budgets = [32] }
        for budget in budgets {
            let label = profile + "-k" + Text(budget)
            let binary = output + "/" + label
            let command = [clang]
            for flag in flags { command.add(flag) }
            for item in ["-std=c11", "-Wall", "-Wextra", "-Werror", "-iquote", "runtime"] { command.add(item) }
            if options[position] != "" { command.add(options[position]) }
            command.add("-DMINYAR_BOUNDED_HEAP_BYTES=1048576")
            command.add("-DMINYAR_RC_POLL_BUDGET=" + Text(budget))
            if legacy { command.add(schedule.legacyFlag) }
            for item in ["tests/" + schedule.fixture, "-lm", "-o", binary] { command.add(item) }
            let phases = ["compile"]
            let commands = [command]
            let selected = nodes
            if profile == "fixed" && schedule.fixedNodes.length > 0 { selected = schedule.fixedNodes }
            for count in selected {
                phases.add("run-n" + Text(count))
                let argv = [binary]
                for item in schedule.prefix { argv.add(item) }
                argv.add(Text(count))
                commands.add(argv)
            }
            for step in 0..phases.length {
                let phase = phases[step]
                let result = test.run(commands[step], environment, "", output + "/." + label + "-" + phase, 120)
                files.remove(output + "/." + label + "-" + phase)
                files.remove(output + "/." + label + "-" + phase + ".err")
                writeTextFile(output + "/" + label + "-" + phase + ".stdout", result.output)
                writeTextFile(output + "/" + label + "-" + phase + ".stderr", result.errorOutput)
                let entry = "{\"profile\": " + json.quote(label) + ", \"phase\": " + json.quote(phase) + ", \"argv\": " + support.quotedList(commands[step]) + ", \"status\": " + Text(result.status) + ", \"stdout\": " + json.quote(result.output) + ", \"stderr\": " + json.quote(result.errorOutput)
                if files.pathSize(binary) >= 0 { entry = entry + ", \"binary_sha256\": " + json.quote(support.digest(binary)) }
                cases.add(entry + "}")
                if result.status != 0 {
                    save(output, false, sanitize, legacyField, nodes, inputs, cases)
                    fail(label + " " + phase + ": " + Text(result.status) + "\n" + result.output + result.errorOutput)
                }
                if phase != "compile" { print(label + " " + phase + ": " + trimmed(result.output)) }
            }
        }
    }
    save(output, true, sanitize, legacyField, nodes, inputs, cases)
}
public function trimmed(text: Text): Text {
    let raw = Bytes(text)
    let start = 0
    let end = raw.length
    while start < end && raw[start] <= 32 { start += 1 }
    while end > start && raw[end - 1] <= 32 { end -= 1 }
    return Text(raw.slice(start, end))
}
