use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures

// Everyday collection and file operations at O0 and O2, under the exact
// allocation/ownership runtime: List insert/removeAt, Bytes.addRange and
// files status/hardLink.
let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
frontend.sources = ["runtime/native/files.c"]
let levels = ["-O0", "-O2"]

fixtures.executes(frontend, #"""
    record Lamp { name: Text; lit: Boolean }
    function show(values: List<Integer>): Text {
        let parts: List<Text> = []
        for value in values { parts.add(Text(value)) }
        return joinText(parts, ",")
    }
    let numbers = [1, 2, 3]
    numbers.insert(0, 0)
    numbers.insert(4, 4)
    numbers.insert(2, 9)
    print(show(numbers))
    print(numbers.removeAt(2))
    print(numbers.removeAt(0))
    print(numbers.removeAt(numbers.length - 1))
    print(show(numbers))
    let alias = numbers
    alias.insert(1, 7)
    print(show(numbers))
    let words: List<Text> = []
    words.insert(0, "harbour")
    words.insert(0, "the")
    words.insert(1, "quiet " + "old")
    let taken = words.removeAt(1)
    print(taken)
    print(joinText(words, " "))
    let lamps = [Lamp { name: "north"; lit: true }]
    lamps.insert(0, Lamp { name: "south"; lit: false })
    let lamp = lamps.removeAt(1)
    print(lamp.name)
    print(lamps[0].name)
    print(lamps.length)
    let nested: List<List<Integer>> = [[1]]
    nested.insert(1, [2, 3])
    print(nested.removeAt(0).length)
    print(nested[0][1])
    let packet = Bytes("head:")
    let body = Bytes("0123456789")
    packet.addRange(body, 2, 5)
    packet.addRange(body, 9, 9)
    packet.addRange(packet, 0, 4)
    print(packet.length)
    let check = Bytes()
    check.addRange(packet, 0, packet.length)
    print(check[5] == 50 && check[7] == 52 && check[8] == 104 && check[11] == 100)
    """#, "0,1,9,2,3,4\n9\n0\n4\n1,2,3\n1,7,2,3\nquiet old\nthe harbour\nnorth\nsouth\n1\n1\n3\n12\ntrue\n", levels, 0, "", true)

fixtures.executes(frontend, #"""
    use "files" as files
    use "errors" as errors
    let path = "everyday-status.txt"
    let file = files.open(path, files.WRITE | files.CREATE | files.TRUNCATE)
    if file < 0 { fail("cannot create the status file") }
    files.write(file, Bytes("seven b"), 0, 7)
    files.close(file)
    match files.status(path) {
        Ok(found) { print(found.kind == files.KIND_FILE); print(found.size) }
        Err(error) { print(errors.message(error)) }
    }
    files.makeDirectory("everyday-folder")
    match files.status("everyday-folder") {
        Ok(found) { print(found.kind == files.KIND_DIRECTORY) }
        Err(error) { print(errors.message(error)) }
    }
    match files.status("everyday-missing") {
        Ok(found) { print("unexpected") }
        Err(error) { print(errors.nativeCode(error)) }
    }
    files.remove("everyday-link.txt")
    match files.hardLink(path, "everyday-link.txt") {
        Ok() { print("linked") }
        Err(error) { print(errors.message(error)) }
    }
    files.remove(path)
    match files.status("everyday-link.txt") {
        Ok(found) { print(found.size) }
        Err(error) { print(errors.message(error)) }
    }
    print(files.link("everyday-missing", "everyday-other") == -2)
    match files.hardLink("everyday-link.txt", "everyday-folder") {
        Ok() { print("unexpected") }
        Err(error) { print(errors.nativeCode(error)) }
    }
    files.remove("everyday-link.txt")
    files.removeDirectory("everyday-folder")
    """#, "true\n7\ntrue\n2\nlinked\n7\ntrue\n17\n", levels, 0, "", true)

fixtures.executes(frontend, "let values = [1, 2]\nvalues.insert(3, 9)\n", "", levels, 1, "Minyar stopped: List position 3 is outside its length of 2.\n", false)
fixtures.executes(frontend, "let values = [1, 2]\nprint(values.removeAt(2))\n", "", levels, 1, "Minyar stopped: List position 2 is outside its length of 2.\n", false)
fixtures.executes(frontend, "let values = [1, 2]\nprint(values.removeAt(-1))\n", "", levels, 1, "Minyar stopped: List position -1 is outside its length of 2.\n", false)
fixtures.executes(frontend, "let packet = Bytes()\npacket.addRange(Bytes(\"ab\"), 1, 3)\n", "", levels, 1, "Minyar stopped: Bytes range 1 to 3 is outside its length of 2.\n", false)
fixtures.rejects(frontend, "let values = [1]\nvalues.insert(\"x\", 2)\n", "List.insert positions must be Integers", false)
fixtures.rejects(frontend, "let values = [1]\nvalues.insert(0, \"x\")\n", "the value added to a List has the wrong type", false)
fixtures.rejects(frontend, "let values = [1]\nprint(values.removeAt(\"x\"))\n", "List.removeAt positions must be Integers", false)
fixtures.rejects(frontend, "let packet = Bytes()\npacket.addRange(packet, 0)\n", "Bytes.addRange expects (Bytes, Integer, Integer)", false)
print("Everyday library operations: passed")
