use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "system" as system
use "text" as utf8

function startsWith(source: Text, prefix: Text): Boolean {
    let raw = Bytes(source)
    let pattern = Bytes(prefix)
    if raw.length < pattern.length { return false }
    return utf8.decodeOrStop(raw.slice(0, pattern.length)) == prefix
}
function after(source: Text, marker: Text): Text {
    let raw = Bytes(source)
    let pattern = Bytes(marker)
    for index in 0..(raw.length - pattern.length + 1) {
        if utf8.decodeOrStop(raw.slice(index, index + pattern.length)) == marker {
            return utf8.decodeOrStop(raw.slice(index + pattern.length, raw.length))
        }
    }
    fail("missing LLVM marker: " + marker)
}
function elementOwners(llvm: Text, name: Text): Integer {
    let body = after(llvm, "define i64 @.minyar.fn." + name + "(")
    body = utf8.decodeOrStop(Bytes(body).slice(0, body.find("\n}\n")))
    let owners = 0
    for line in test.lines(body) {
        if test.contains(line, "call void @minyar_rc_local(i64 ") && !test.contains(line, ", ptr null)") { owners += 1 }
    }
    return owners
}
function generated(compiler: test.Compiler): Text {
    return io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
}
function invalidAccess(compiler: test.Compiler, declaration: Text, length: Integer, position: Integer, operation: Text) {
    test.require(test.compile(compiler, declaration + "\n" + operation + "\n"), "invalid access compile")
    let path = compiler.directory + "/case" + Text(compiler.serial)
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization]
        for flag in compiler.flags { command.add(flag) }
        for item in ["-Wno-override-module", path + ".ll", compiler.runtime, "-o", path + ".exe", "-lm"] { command.add(item) }
        test.require(test.run(command, system.environment(), "", path + ".link", 30), "invalid access link")
        let result = test.run([path + ".exe"], system.environment(), "", path + ".run", compiler.runTimeout)
        test.check(result.status == 1, "invalid access did not exit with status 1\n" + result.errorOutput)
        test.check(result.output == "", "invalid access wrote standard output")
        test.check(test.contains(result.errorOutput, "List position " + Text(position) + " is outside its length of " + Text(length) + "."), "invalid access diagnostic changed\n" + result.errorOutput)
    }
}

function constructorReturns(compiler: test.Compiler, llvm: Text) {
    for name in ["bytes_new", "list_new", "record_new", "record_new_scalar"] {
        let parameters = "i64"
        let arguments = "i64 %size"
        if name == "list_new" { parameters = ""; arguments = "" }
        let signature = "ptr @minyar_" + name + "(" + parameters + ")"
        test.check(test.contains(llvm, "declare nonnull " + signature), "constructor return lacks nonnull: " + name)
        // Compare the same observable call with and without the return promise.
        for annotation in ["", "nonnull "] {
            let source = "declare " + annotation + signature + "\ndefine i1 @constructor_can_return_null(i64 %size) {\n  %fresh = call ptr @minyar_" + name + "(" + arguments + ")\n  %isnull = icmp eq ptr %fresh, null\n  ret i1 %isnull\n}\n"
            let prefix = compiler.directory + "/constructor-" + name
            let input = prefix + ".ll"
            let output = prefix + ".optimized.ll"
            io.writeTextFile(input, source)
            test.require(test.run([compiler.clang, "-O2", "-S", "-emit-llvm", "-Wno-override-module", input, "-o", output], system.environment(), "", prefix + ".optimize", 30), "optimize constructor return " + name)
            let optimized = io.readTextFile(output)
            let callRemains = false
            for line in test.lines(optimized) {
                if test.contains(line, "call ") && test.contains(line, "@minyar_" + name + "(") { callRemains = true }
            }
            test.check(callRemains, "nonnull removed observable constructor call " + name)
            if annotation == "" {
                test.check(test.contains(optimized, "icmp eq ptr") && !test.contains(optimized, "ret i1 false"), "nullable control lost comparison " + name)
            } else {
                test.check(!test.contains(optimized, "icmp eq ptr") && test.contains(optimized, "ret i1 false"), "nonnull did not remove impossible comparison " + name)
            }
        }
    }
}

let compiler = test.compiler()
test.check(processInfo.argumentCount() <= 1, "unexpected List access test selector")
if processInfo.argumentCount() == 1 { test.check(processInfo.argument(0) == "ListAccess.test_inline_access_helpers_preserve_checked_fallback", "unknown List access test selector") }
test.executes(compiler, "let values = [42]\nvalues[0] = 42\nprint(values[0])\nprint(values.length)\n", "42\n1\n")
let llvm = generated(compiler)
constructorReturns(compiler, llvm)
for expected in ["define internal i64 @.minyar.list.get.checked", "define internal void @.minyar.list.set.scalar.checked", "define internal i64 @.minyar.list.length", "%get.valid = icmp ult i64 %position, %length", "%set.valid = icmp ult i64 %position, %length", "call i64 @minyar_list_get(ptr %list, i64 %position)\n  unreachable", "call void @minyar_list_set(ptr %list, i64 %position, i64 %value)\n  unreachable"] {
    test.check(test.contains(llvm, expected), "missing checked List helper IR: " + expected)
}
let helpers: List<Text> = []
let active = false
let helper = ""
for line in test.lines(llvm) {
    if !active && startsWith(line, "define internal ") && test.contains(line, " @.minyar.list.") {
        active = true
        helper = ""
    }
    if active {
        helper += line + "\n"
        if startsWith(line, "}") { helpers.add(helper); active = false }
    }
}
test.check(helpers.length == 3, "expected exactly three internal List helpers")
for body in helpers {
    if test.contains(body, "@.minyar.list.get.checked(") {
        test.check(test.contains(body, "%get.valid = icmp ult i64 %position, %length"), "List getter lost its strict bounds predicate")
    }
    if test.contains(body, "@.minyar.list.set.scalar.checked(") {
        test.check(test.contains(body, "%set.valid = icmp ult i64 %position, %length"), "List setter lost its strict bounds predicate")
    }
    // A failed check reports through the runtime, which never returns.
    test.check(test.contains(body, "@.minyar.list.length(") || test.contains(body, "@minyar_list_get(ptr %list, i64 %position)\n  unreachable") || test.contains(body, "@minyar_list_set(ptr %list, i64 %position, i64 %value)\n  unreachable"), "checked List helper lost its runtime diagnostic")
    test.check(test.contains(body, "!range !{i64 0, i64 -9223372036854775808}"), "List length lost its nonnegative range fact")
    test.check(test.contains(body, "getelementptr inbounds { ptr, i64, i64 }, ptr %list"), "List header lost its allocation fact")
    if !test.contains(body, "@.minyar.list.length(") {
        test.check(test.contains(body, "getelementptr inbounds i64, ptr %values, i64 %position"), "checked List slot lost its allocation fact")
    }
}
test.check(!test.contains(llvm, "noalias"), "List IR incorrectly claims noalias")
if processInfo.argumentCount() == 0 {
test.executes(compiler, "let integers = [0]\nintegers[0] = -9223372036854775808\nprint(integers[0])\nlet floats = [1.0]\nfloats[0] = -0.0\nprint(floats[0])\nfloats[0] = 2.5\nfloats[0] *= 4.0\nprint(floats[0])\nlet booleans = [false]\nbooleans[0] = true\nprint(booleans[0])\nlet characters = ['a']\ncharacters[0] = '🙂'\nprint(characters[0])\n", "-9223372036854775808\n-0.0\n10.0\ntrue\n🙂\n")
for length in [0, 2] {
    let declaration = "let values: List<Integer> = []"
    if length == 2 { declaration = "let values = [7, 8]" }
    for position in [-9223372036854775808, -1, length, 9223372036854775807] {
        for operation in ["print(values[" + Text(position) + "])", "values[" + Text(position) + "] = 42"] {
            invalidAccess(compiler, declaration, length, position, operation)
        }
    }
}
test.executes(compiler, "function grow(values: List<Integer>, count: Integer): Integer {\nlet position = 0\nwhile position < count { values.add(position); position += 1 }\nreturn 0\n}\nfunction replacement(values: List<Integer>): Integer {\nlet ignored = grow(values, 2048)\nreturn values.length\n}\nlet values = [7]\nlet alias = values\nvalues[grow(alias, 2048)] = replacement(alias)\nprint(values[0])\nprint(values.length)\nprint(alias.length)\n", "4097\n4097\n4097\n")
test.executes(compiler, "record Holder { values: List<Integer> }\nfunction index(holder: Holder): Integer { holder.values = [6]; return 0 }\nfunction replacement(holder: Holder): Integer { holder.values = [7]; return 99 }\nlet holder = Holder { values: [5] }\nlet alias = holder.values\nholder.values[index(holder)] = replacement(holder)\nprint(alias[0])\nprint(holder.values[0])\nlet lonely = Holder { values: [8] }\nlonely.values[index(lonely)] = replacement(lonely)\nprint(lonely.values[0])\n", "99\n7\n7\n")
test.executes(compiler, "function replace(values: List<Text>): Text {\nvalues[0] = Text(456)\nlet position = 0\nwhile position < 512 { values.add(Text(position)); position += 1 }\nreturn \"-suffix\"\n}\nlet values = [Text(123)]\nvalues[0] += replace(values)\nprint(values[0])\nprint(values.length)\n", "123-suffix\n513\n")
let main = after(generated(compiler), "define i32 @main(")
test.check(!test.contains(main, "call void @.minyar.list.set.scalar.checked("), "reference assignment uses scalar setter")
test.check(test.contains(main, "call void @minyar_list_set_take("), "reference assignment lost ownership transfer")
// A `for` loop over a List reads its length inline on every iteration.
test.executes(compiler, "function total(values: List<Integer>): Integer { let sum = 0; for value in values { sum += value }; return sum }\nlet values = [4, 5]\nprint(total(values))\nprint(total([]))\n", "9\n0\n")
let looping = after(generated(compiler), "define i64 @.minyar.fn.total(")
looping = utf8.decodeOrStop(Bytes(looping).slice(0, looping.find("\n}\n")))
test.check(test.contains(looping, "call i64 @.minyar.list.length(") && !test.contains(looping, "@minyar_list_length("), "List for loop must read its length inline")
// A List loop whose body makes no calls and assigns only plain locals borrows
// its source and each element; an indexed store keeps the element's owner and
// reassigning the source keeps the loop's own count on the List.
test.executes(compiler, "record Point { x: Integer; y: Integer }\nfunction sum(points: List<Point>): Integer { let total = 0; for point in points { total += point.x + point.y }; return total }\nfunction churn(points: List<Point>): Integer { let total = 0; for point in points { points[0] = Point { x: 100; y: 0 }; total += point.x }; return total }\nfunction keep(points: List<Point>): Point { let last = points[0]; for point in points { last = point }; return last }\nfunction drop(): Integer { let items = [Point { x: 5; y: 0 }, Point { x: 6; y: 0 }]; let total = 0; for point in items { items = []; total += point.x }; return total }\nlet points = [Point { x: 1; y: 2 }, Point { x: 3; y: 4 }]\nprint(sum(points))\nprint(churn(points))\nprint(keep(points).x)\nprint(sum(points))\nprint(drop())\n", "10\n4\n3\n107\n11\n")
let walking = generated(compiler)
test.check(elementOwners(walking, "sum") == 0, "a call-free List loop must borrow its source and elements")
test.check(elementOwners(walking, "drop") >= 1, "a loop that reassigns its source must keep its own count on the List")
test.check(elementOwners(walking, "churn") == 2, "a List loop with an indexed store must keep each element's owner")
// Scalar field and element stores release nothing, so the loop still borrows;
// a path store that replaces a reference keeps the loop's owners.
test.executes(compiler, "record Point { x: Integer; y: Integer }\nrecord Holder { points: List<Point>; label: Text }\nfunction tally(points: List<Point>, totals: List<Integer>): Integer { let total = 0; for point in points { totals[point.x % 2] += point.y; point.y = 0; total += point.x }; return total }\nfunction clear(holder: Holder, points: List<Point>): Integer { let total = 0; for point in points { holder.points = []; total += point.x }; return total }\nfunction label(holder: Holder, points: List<Point>): Integer { let total = 0; for point in points { holder.label += \"!\"; total += point.x }; return total }\nlet totals = [0, 0]\nprint(tally([Point { x: 1; y: 2 }, Point { x: 2; y: 5 }, Point { x: 3; y: 4 }], totals))\nprint(totals[0])\nprint(totals[1])\nlet holder = Holder { points: [Point { x: 7; y: 0 }, Point { x: 8; y: 0 }]; label: \"a\" }\nprint(clear(holder, holder.points))\nholder.points = [Point { x: 1; y: 0 }]\nprint(label(holder, holder.points))\nprint(holder.label)\n", "6\n5\n6\n15\n1\na!\n")
let paths = generated(compiler)
test.check(elementOwners(paths, "tally") == 0, "a List loop with only scalar path stores must borrow its elements")
test.check(elementOwners(paths, "clear") >= 1, "a List loop that replaces a reference field must keep its owners")
test.check(elementOwners(paths, "label") >= 1, "a List loop that appends to a Text field must keep its owners")
// A loop body that assigns the loop name keeps each element's owner, so later
// moves out of that name never consume the List's own count.
test.executes(compiler, "record Point { x: Integer; y: Integer }\nrecord Marker { let: Integer }\nfunction shout(words: List<Text>) { for word in words { word = word + \"!\" } }\nfunction masked(words: List<Text>, marker: Marker) { for word in words { let ignored = marker.let; word = word + \"!\" } }\nfunction maskedLiteral(words: List<Text>) { for word in words { let marker = Marker { let: 0 }; word = word + \"!\" } }\nfunction dropMasked(): Integer { let words = [Text(10), Text(20)]; let marker = Marker { let: 0 }; let total = 0; for word in words { let ignored = marker.let; words = []; total += word.byteLength }; return total }\nfunction second(items: List<Text>): Text { let turn = 0; for item in items { if turn == 1 { return item }; item = \"x\"; turn = turn + 1 }; return \"\" }\nfunction swap(points: List<Point>) { for p in points { p = Point { x: p.y; y: p.x } } }\nlet words = [Text(10), Text(20)]\nshout(words)\nprint(words[1])\nlet maskedWords = [Text(10), Text(20)]\nmasked(maskedWords, Marker { let: 0 })\nprint(maskedWords[1])\nlet literalWords = [Text(30), Text(40)]\nmaskedLiteral(literalWords)\nprint(literalWords[1])\nprint(dropMasked())\nlet picked = second(words)\nprint(picked)\nprint(words[1])\nlet points = [Point { x: 1; y: 2 }, Point { x: 3; y: 4 }]\nswap(points)\nprint(points[1].x)\n", "20\n20\n40\n4\n20\n20\n3\n")
// User code without a call token (a capability operator) can replace the
// element or receiver, so those bodies and arguments keep their counts.
test.executes(compiler, "record Item { label: Text }\nrecord Probe { items: List<Item> }\nfunction Probe.equal(other: Probe): Boolean { self.items[0] = Item { label: Text(7) }; return true }\nconform Probe to Equatable\nfunction scan(items: List<Item>, probe: Probe): Integer { let total = 0; for item in items { if probe == probe { total = total + 1 }; total = total + item.label.byteLength }; return total }\nlet items = [Item { label: Text(12345) }]\nprint(scan(items, Probe { items: items }))\nprint(items[0].label)\n", "6\n7\n")
test.executes(compiler, "record Key { id: Integer; lists: List<List<Boolean>> }\nfunction Key.equal(other: Key): Boolean { self.lists[0] = [false]; return self.id == other.id }\nconform Key to Equatable\nlet lists: List<List<Boolean>> = [[true]]\nlet key = Key { id: 1; lists: lists }\nlists[0].add(key == key)\nprint(lists[0].length)\nprint(lists[0][0])\n", "1\nfalse\n")
test.executes(compiler, "record FlagHolder { flags: List<Boolean> }\nrecord FlagKey { holder: FlagHolder }\nfunction FlagKey.equal(other: FlagKey): Boolean { self.holder.flags = [false]; return true }\nconform FlagKey to Equatable\nfunction setFlag(holder: FlagHolder, value: Boolean) { holder.flags[0] = value }\nlet holder = FlagHolder { flags: [false] }\nlet key = FlagKey { holder: holder }\nholder.flags[0] = key == key\nprint(holder.flags[0])\nsetFlag(holder, true)\nprint(holder.flags[0])\n", "false\ntrue\n")
// An acyclic List receiver held by a field needs no temporary count when its
// appended argument makes no calls; a call that can replace the field keeps it.
test.executes(compiler, "record Holder { values: List<Integer>; names: List<Text> }\nfunction fill(holder: Holder) { let index = 0; while index < 4 { holder.values.add(index + holder.values.length); holder.names.add(\"n\"); index += 1 } }\nfunction replace(holder: Holder): Integer { holder.values = [9]; return 7 }\nfunction mixed(holder: Holder) { holder.values.add(replace(holder)) }\nlet holder = Holder { values: []; names: [] }\nfill(holder)\nprint(holder.values.length)\nprint(holder.values[3])\nprint(holder.names.length)\nmixed(holder)\nprint(holder.values.length)\nprint(holder.values[0])\n", "4\n6\n4\n1\n9\n")
let appended = generated(compiler)
let fill = after(appended, "define void @.minyar.fn.fill(")
fill = utf8.decodeOrStop(Bytes(fill).slice(0, fill.find("\n}\n")))
test.check(!test.contains(fill, "@minyar_rc_borrow(") && !test.contains(fill, "@minyar_rc_keep("), "call-free List appends kept a temporary owner")
let mixed = after(appended, "define void @.minyar.fn.mixed(")
mixed = utf8.decodeOrStop(Bytes(mixed).slice(0, mixed.find("\n}\n")))
test.check(test.contains(mixed, "call void @minyar_rc_borrow("), "a List append whose argument calls a function must keep its receiver owner")
// Element and field receivers of a nested store need no temporary count when
// the rest of the statement makes no calls; a call or capability operator that
// can replace the row keeps it alive until the store completes.
test.executes(compiler, "record Row { cells: List<Integer>; total: Integer }\nrecord Key { id: Integer; lists: List<List<Boolean>> }\nfunction Key.equal(other: Key): Boolean { self.lists[0] = [false]; return self.id == other.id }\nconform Key to Equatable\nfunction scale(grid: List<List<Float>>, rows: List<Row>, factor: Float) { for i in 0..grid.length { for j in 0..grid[i].length { grid[i][j] = grid[i][j] * factor }; rows[i].total = rows[i].total + 1; rows[i].cells[0] = 5 } }\nfunction shrink(grid: List<List<Float>>): Float { grid[0] = [0.0]; return 2.0 }\nfunction swap(grid: List<List<Float>>) { grid[0][0] = shrink(grid) }\nlet grid = [[1.0, 2.0], [3.0, 4.0]]\nlet rows = [Row { cells: [1]; total: 0 }, Row { cells: [2]; total: 0 }]\nscale(grid, rows, 2.0)\nprint(grid[1][1])\nprint(rows[1].total)\nprint(rows[0].cells[0])\nswap(grid)\nprint(grid[0][0])\nprint(grid[0].length)\nlet lists: List<List<Boolean>> = [[true, true]]\nlet key = Key { id: 1; lists: lists }\nlists[0][1] = key == key\nprint(lists[0].length)\n", "8.0\n1\n5\n0.0\n1\n1\n")
let nested = generated(compiler)
let scale = nested.slice(nested.find("scale(ptr %argument.0"), nested.length)
scale = scale.slice(0, scale.find("\n}\n"))
test.check(!test.contains(scale, "@minyar_rc_borrow(") && !test.contains(scale, "@minyar_rc_keep("), "call-free nested stores kept a temporary owner")
let swap = nested.slice(nested.find("swap(ptr %argument.0"), nested.length)
swap = swap.slice(0, swap.find("\n}\n"))
test.check(test.contains(swap, "call void @minyar_rc_borrow("), "a nested store whose value calls a function must keep its row owner")
// An ordered Text comparison keeps its left operand alive through a right
// operand that replaces its holder, and takes no extra count when it cannot.
test.executes(compiler, "record Box { label: Text }\nfunction swap(box: Box): Text { box.label = \"zz\" + Text(7); return \"m\" }\nfunction early(box: Box): Boolean { return box.label < swap(box) }\nfunction plain(a: Box, b: Box): Boolean { return a.label < b.label }\nlet box = Box { label: \"a\" + Text(1) }\nprint(early(box))\nprint(box.label)\nprint(plain(Box { label: \"b\" }, Box { label: \"c\" }))\n", "true\nzz7\ntrue\n")
let compared = generated(compiler)
let plain = compared.slice(compared.find("plain(ptr %argument.0"), compared.length)
plain = plain.slice(0, plain.find("\n}\n"))
let plainBorrows = 0
for line in test.lines(plain) { if test.contains(line, "call void @minyar_rc_borrow(") { plainBorrows += 1 } }
test.check(plainBorrows <= 2, "a call-free Text comparison borrowed its left operand twice")
// A call-free loop in a function with owners takes a service-free inner
// loop while the runtime is idle; a frame-free function needs no query, and a
// loop that calls the runtime keeps a service point on every iteration.
test.executes(compiler, "function pureSum(values: List<Integer>): Integer { let label = Text(values.length); let total = 0; for i in 0..values.length { if values[i] < 0 { continue }; if values[i] > 100 { break }; total += values[i] }; return total + label.length }\nfunction scalarSum(values: List<Integer>): Integer { let total = 0; for value in values { total += value }; return total }\nfunction busy(values: List<Integer>): Integer { let total = 0; for i in 0..values.length { total += Text(values[i]).length }; return total }\nfunction pureWhile(values: List<Integer>): Integer { let label = Text(values.length); let i = 0; let total = 0; while i < values.length { if values[i] < 0 { i += 1; continue }; if values[i] > 100 { break }; total += values[i]; i += 1 }; return total + label.length }\nlet values = [1, -2, 3, 200, 5]\nlet dropped = [Text(1), Text(2), Text(3)]\ndropped = []\nprint(pureSum(values))\nprint(scalarSum(values))\nprint(busy(values))\nprint(pureWhile(values))\nlet spin = 0\nfor round in 0..1000 { spin += values[round % 5] }\nprint(spin + dropped.length)\n", "5\n207\n8\n5\n41400\n")
let versioned = generated(compiler)
let pureBody = versioned.slice(versioned.find("pureSum(ptr %argument.0"), versioned.length)
pureBody = pureBody.slice(0, pureBody.find("\n}\n"))
test.check(test.contains(pureBody, "call i1 @minyar_rc_idle()") && test.contains(pureBody, "call void @minyar_rc_step()"), "a call-free loop with owners must test the runtime and keep its service point")
let whileBody = versioned.slice(versioned.find("pureWhile(ptr %argument.0"), versioned.length)
whileBody = whileBody.slice(0, whileBody.find("\n}\n"))
test.check(test.contains(whileBody, "call i1 @minyar_rc_idle()") && test.contains(whileBody, "while.strip."), "a call-free while loop with owners must test the runtime")
let scalarBody = versioned.slice(versioned.find("scalarSum(ptr %argument.0"), versioned.length)
scalarBody = scalarBody.slice(0, scalarBody.find("\n}\n"))
test.check(!test.contains(scalarBody, "@minyar_rc_idle(") && !test.contains(scalarBody, "@minyar_rc_step("), "a frame-free loop must not query or service the runtime")
let busyBody = versioned.slice(versioned.find("busy(ptr %argument.0"), versioned.length)
busyBody = busyBody.slice(0, busyBody.find("\n}\n"))
test.check(!test.contains(busyBody, "@minyar_rc_idle(") && test.contains(busyBody, "call void @minyar_rc_step()"), "a loop that calls the runtime must service every iteration")
// A Map operation with plain keys takes no count on its receiver or key; a key
// expression that can replace the holder keeps them.
test.executes(compiler, "record Holder { table: Map<Text, Integer> }\nfunction swap(holder: Holder): Text { holder.table = Map(); return \"b\" }\nfunction count(words: List<Text>): Integer { let counts: Map<Text, Integer> = Map(); for word in words { if counts.has(word) { counts[word] += 1 } else { counts[word] = 1 } }; return counts[\"a\"] * 10 + counts.length }\nlet holder = Holder { table: Map() }\nholder.table[\"a\"] = 1\nholder.table[\"b\"] = 2\nprint(holder.table.has(swap(holder)))\nholder.table[\"b\"] = 3\nprint(holder.table[swap(holder)] + holder.table.length)\nprint(count([\"a\", \"b\", \"a\", \"c\", \"a\"]))\n", "true\n3\n33\n")
let mapped = generated(compiler)
let counting = mapped.slice(mapped.find("count(ptr %argument.0"), mapped.length)
counting = counting.slice(0, counting.find("\n}\n"))
test.check(!test.contains(counting, "call void @minyar_rc_borrow("), "Map operations on plain keys took a temporary count")
// The borrowed parameter source keeps one loop count: Map stores may release it.
test.check(elementOwners(mapped, "count") == 1, "a List loop whose calls cannot release List slots must borrow its elements")
// An element or field value read inside a statement takes no count when the
// rest of the statement cannot release its holder; a later user call can.
test.executes(compiler, "record Holder { name: Text; parts: List<Text> }\nfunction rename(holder: Holder): Text { holder.name = \"z\" + Text(9); holder.parts = []; return \"!\" }\nfunction parse(fields: List<Text>): Integer { let total = Integer(fields[1]) + Integer(fields[2]); if fields[0] == \"add\" { total += 1 }; return total }\nlet holder = Holder { name: \"a\" + Text(1); parts: [\"p\" + Text(2)] }\nprint(parse([\"add\", \"40\", \"1\"]))\nprint(holder.name + rename(holder))\nholder.parts = [\"q\" + Text(3)]\nprint(holder.parts[0] + rename(holder))\nprint(holder.name)\n", "42\na1!\nq3!\nz9\n")
let deferred = generated(compiler)
// A match arm can replace the holder of its input while a payload binding is
// still in use, so a statement with nested statements keeps its counts.
test.executes(compiler, "choice Label { Named(text: Text)\n Empty }\nrecord Box { label: Label }\nfunction show(box: Box): Text { match box.label { Named(text) { box.label = Empty; return text + \"!\" } Empty { return \"none\" } } }\nlet box = Box { label: Named(\"a\" + Text(1)) }\nprint(show(box))\nprint(show(box))\n", "a1!\nnone\n")
let parsing = deferred.slice(deferred.find("parse(ptr %argument.0"), deferred.length)
parsing = parsing.slice(0, parsing.find("\n}\n"))
test.check(!test.contains(parsing, "call void @minyar_rc_borrow("), "element values passed to builtins took a temporary count")
// A count taken only when the statement settles is still released at the end
// of that statement (minyar_rc_step), not held to a later one or frame exit.
test.executes(compiler, "record Holder { name: Text; parts: List<Text> }\nfunction touch(holder: Holder): Integer { holder.name = \"y\" + Text(2); return 1 }\nfunction measure(name: Text, extra: Integer): Integer { return name.length + extra }\nfunction probe(holder: Holder): Integer { let n = measure(holder.name, touch(holder))\n let m = n + 1\n return m }\nlet holder = Holder { name: \"x\" + Text(1); parts: [] }\nprint(probe(holder))\nprint(holder.name)\n", "4\ny2\n")
let settledLate = generated(compiler)
let probing = settledLate.slice(settledLate.find("probe(ptr %argument.0"), settledLate.length)
probing = probing.slice(0, probing.find("\n}\n"))
test.check(test.contains(probing, "call void @minyar_rc_borrow("), "a field read before a user call that can replace it took no count")
let afterBorrow = probing.slice(probing.find("call void @minyar_rc_borrow("), probing.length)
test.check(test.contains(afterBorrow, "call void @minyar_rc_step()"), "a count taken when the statement settled was not released at the end of its statement")
// `let b = bodies[i]` borrows its element when the rest of its block cannot
// release it (a parallel function call cannot); a store that replaces the
// element makes the hidden guard keep it alive.
test.executes(compiler, "record Body { x: Float; v: Float }\nparallel function half(value: Float): Float { return value / 2.0 }\nfunction advance(bodies: List<Body>) { for i in 0..bodies.length { let b = bodies[i]; b.x = half(b.x) + b.v } }\nfunction swap(bodies: List<Body>): Float { let b = bodies[0]; bodies[0] = Body { x: 9.0; v: 0.0 }; return b.x }\nlet bodies = [Body { x: 4.0; v: 1.0 }, Body { x: 2.0; v: 1.0 }]\nadvance(bodies)\nprint(bodies[0].x)\nprint(swap(bodies))\nprint(bodies[0].x)\n", "3.0\n3.0\n9.0\n")
let guarded = generated(compiler)
let advancing = guarded.slice(guarded.find("advance(ptr %argument.0"), guarded.length)
advancing = advancing.slice(0, advancing.find("\n}\n"))
let advanceOwners = 0
for line in test.lines(advancing) { if test.contains(line, "call void @minyar_rc_local(i64 ") && !test.contains(line, ", ptr null)") { advanceOwners += 1 } }
test.check(advanceOwners == 0 && test.contains(advancing, "call i1 @minyar_rc_idle()"), "an unreleased element binding must borrow, and its loop must stay call-free")
let swapping = guarded.slice(guarded.find("swap(ptr %argument.0"), guarded.length)
swapping = swapping.slice(0, swapping.find("\n}\n"))
test.check(test.contains(swapping, "call void @minyar_rc_local(i64 "), "a binding whose element is replaced must keep a guard count")
// The same for field paths and Map values: `let x = h.f` borrows unless the
// rest of its block replaces a field, element or Map value on the path, or
// makes a user call.
test.executes(compiler, "record Row { label: Text; tags: Map<Text, Text> }\nrecord Holder { name: Text; rows: List<Row> }\nfunction total(rows: List<Row>): Integer { let sum = 0; for i in 0..rows.length { let label = rows[i].label; let tag = rows[i].tags[\"k\"]; sum += label.length + tag.length }; return sum }\nfunction rename(holder: Holder): Text { let name = holder.name; holder.name = \"z\" + Text(9); return name }\nfunction retag(row: Row): Text { let tag = row.tags[\"k\"]; row.tags[\"k\"] = \"q\" + Text(8); return tag }\nfunction clear(holder: Holder) { holder.rows = [] }\nfunction called(holder: Holder): Text { let label = holder.rows[0].label; clear(holder); return label }\nlet tags: Map<Text, Text> = Map()\ntags[\"k\"] = \"t\" + Text(3)\nlet holder = Holder { name: \"a\" + Text(1); rows: [Row { label: \"b\" + Text(2); tags: tags }] }\nprint(total(holder.rows))\nprint(rename(holder))\nprint(holder.name)\nprint(retag(holder.rows[0]))\nprint(holder.rows[0].tags[\"k\"])\nprint(called(holder))\nprint(holder.rows.length)\n", "4\na1\nz9\nt3\nq8\nb2\n0\n")
let fieldGuards = generated(compiler)
for item in [["total", "false"], ["rename", "true"], ["retag", "true"], ["called", "true"]] {
    let guardedBody = fieldGuards.slice(fieldGuards.find(" @.minyar.fn." + item[0] + "("), fieldGuards.length)
    guardedBody = guardedBody.slice(0, guardedBody.find("\n}\n"))
    let owners = 0
    for line in test.lines(guardedBody) { if test.contains(line, "call void @minyar_rc_local(i64 ") && !test.contains(line, ", ptr null)") { owners += 1 } }
    if item[1] == "true" { test.check(owners > 0, "a field or Map value binding whose holder can change must keep a guard count: " + item[0]) }
    else { test.check(owners == 0, "a field or Map value binding whose block cannot release it must borrow: " + item[0]) }
}
// Returning a field or element read gives its count to the caller: the
// function retains once, keeps no temporary and needs no frame. The caller's
// value survives later stores into the holder.
test.executes(compiler, "record Holder { name: Text; rows: List<Text> }\nfunction name(holder: Holder): Text { return holder.name }\nfunction row(holder: Holder, index: Integer): Text { if index < 0 { return holder.rows[0] }; return holder.rows[index] }\nlet holder = Holder { name: \"a\" + Text(1); rows: [\"r\" + Text(2)] }\nlet first = name(holder)\nlet second = row(holder, 0)\nholder.name = \"z\" + Text(9)\nholder.rows[0] = \"q\" + Text(8)\nprint(first)\nprint(second)\nprint(holder.name + holder.rows[0])\n", "a1\nr2\nz9q8\n")
let returnedReads = generated(compiler)
for name in ["name", "row"] {
    let returnedBody = returnedReads.slice(returnedReads.find(" @.minyar.fn." + name + "("), returnedReads.length)
    returnedBody = returnedBody.slice(0, returnedBody.find("\n}\n"))
    test.check(test.contains(returnedBody, "call void @minyar_rc_retain(") && !test.contains(returnedBody, "@minyar_rc_borrow(") && !test.contains(returnedBody, "@minyar_rc_enter(") && !test.contains(returnedBody, "@minyar_rc_leave("), "a returned field or element read must hand its count to the caller without a frame: " + name)
}
test.executes(compiler, "function sum(values: List<Integer>): Integer { let total = 0; let index = 0; while index < values.length { total += values[index]; index += 1 }; return total }\nprint(sum([1, 2, 3]))\n", "6\n")
let path = compiler.directory + "/case" + Text(compiler.serial)
// Keep this exact-count oracle on one scalar iteration; ordinary O0/O2
// execution above still uses normal loop unrolling and checks the result.
let optimize = [compiler.clang, "-O2", "-fno-unroll-loops", "-Wno-override-module", "-S", "-emit-llvm"]
for flag in compiler.flags { optimize.add(flag) }
for item in [path + ".ll", "-o", path + ".optimized.ll"] { optimize.add(item) }
test.require(test.run(optimize, system.environment(), "", path + ".optimize", compiler.linkTimeout), "optimize List loop IR")
let active = false
let additions = 0
let functions = 0
for line in test.lines(io.readTextFile(path + ".optimized.ll")) {
    if startsWith(line, "define ") && test.contains(line, " @.minyar.fn.sum(") { active = true; functions += 1 }
    if active {
        test.check(!test.contains(line, "@minyar_list_get("), "proven List loop retained its redundant bounds fallback")
        if test.contains(line, "call ") && test.contains(line, "@llvm.sadd.with.overflow.i64(") { additions += 1 }
        if line == "}" { active = false }
    }
}
test.check(functions == 1 && additions == 1, "List loop must check its sum and eliminate the proven index overflow check")
// A call-free loop that reads or writes Lists at its position enters an
// unchecked copy when one test before the loop shows every position is in
// range. The test itself never fails: a List it cannot reach sends the loop
// to the checked copy, which fails at the same access with the same message.
test.executes(compiler, "function scale(grid: List<List<Float>>, rows: List<List<Float>>, k: Integer, factor: Float) { for i in 0..grid.length { for j in 0..grid[i].length { grid[i][j] = grid[i][j] + factor * rows[k][j] } } }\nfunction total(values: List<Integer>): Integer { let label = Text(values.length); let sum = 0; for value in values { sum += value }; return sum + label.length }\nfunction never(rows: List<List<Integer>>, count: Integer): Integer { let sum = 0; for j in 0..count { if j > 100 { sum += rows[9][j] } }; return sum }\nfunction partial(values: List<Integer>, from: Integer, to: Integer): Integer { let sum = 0; for j in from..to { sum += values[j] }; return sum }\nfunction double(values: List<Integer>) { for i in 0..values.length { values[i] = values[i] * 2 } }\nlet grid = [[1.0, 2.0], [3.0, 4.0]]\nlet rows = [[0.5, 0.25], [10.0, 20.0]]\nscale(grid, rows, 1, 2.0)\nprint(grid[1][1])\nprint(grid[0][0])\nprint(total([4, 5, 6]))\nprint(never([[1]], 50))\nprint(partial([1, 2, 3, 4], 1, 4))\nprint(partial([1, 2, 3, 4], 3, 1))\nlet doubled = [1, 2, 3]\ndouble(doubled)\nprint(doubled[2])\n", "44.0\n21.0\n16\n0\n9\n0\n6\n")
let versionedPath = compiler.directory + "/case" + Text(compiler.serial)
let versionedChecks = generated(compiler)
// A loop that only reads Lists up to a List length (total) keeps one loop:
// LLVM already proves its checks. Stores or an unrelated bound version it.
for name in ["scale", "total", "never", "partial", "double"] {
    let versionedBody = versionedChecks.slice(versionedChecks.find(" @.minyar.fn." + name + "("), versionedChecks.length)
    versionedBody = versionedBody.slice(0, versionedBody.find("\n}\n"))
    test.check(test.contains(versionedBody, "for.guard.") == (name != "total"), "a call-free List loop was versioned wrongly: " + name)
}
let vectorize = [compiler.clang, "-O2", "-Wno-override-module", "-S", "-emit-llvm"]
for flag in compiler.flags { vectorize.add(flag) }
for item in [versionedPath + ".ll", "-o", versionedPath + ".optimized.ll"] { vectorize.add(item) }
test.require(test.run(vectorize, system.environment(), "", versionedPath + ".optimize", compiler.linkTimeout), "optimize versioned List loop IR")
let scaled = io.readTextFile(versionedPath + ".optimized.ll")
scaled = scaled.slice(scaled.find(" @.minyar.fn.scale("), scaled.length)
scaled = scaled.slice(0, scaled.find("\n}\n"))
test.check(test.contains(scaled, " x double>"), "the unchecked copy of a List loop was not vectorized")
for item in [["let values = [7, 8]\nlet copies = [0, 0, 0]", "for j in 0..3 { copies[j] = values[j] }", "2"], ["let values = [7, 8]\nlet sum = 0", "for j in -1..2 { sum += values[j] }", "-1"], ["let values = [7, 8, 9]\nlet copies = [0, 0]", "for j in 0..values.length { copies[j] = values[j] }", "2"], ["let values = [7, 8]\nlet sum = 0", "for j in 0..values.length { j = j + 1; sum += values[j] }", "2"]] {
    invalidAccess(compiler, item[0], 2, Integer(item[2]), item[1])
    if !test.contains(item[1], "j = j + 1") { test.check(test.contains(generated(compiler), "for.guard."), "a failing List loop was not versioned: " + item[1]) }
}
}
test.removeTree(compiler.directory)
print("list access: passed")
