use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "system" as system
function rejection(compiler: test.Compiler, source: Text, diagnostic: Text) {
    let result = test.compile(compiler, source)
    test.check(result.status == 1, "expected compiler rejection")
    test.check(result.output == "", "rejected source wrote standard output")
    test.check(test.contains(result.errorOutput, diagnostic), "missing rejection diagnostic")
    test.check(!test.contains(result.errorOutput, "List position"), "internal list diagnostic")
    test.check(!io.fileExists(compiler.directory + "/case" + Text(compiler.serial) + ".ll"), "rejected source emitted LLVM")
}
function fails(compiler: test.Compiler, source: Text, expected: Text, diagnostic: Text) {
    test.require(test.compile(compiler, source), "compile checked arithmetic")
    let path = compiler.directory + "/case" + Text(compiler.serial)
    for optimization in ["-O0", "-O2"] {
        let command = [compiler.clang, optimization, "-Wno-override-module"]
        for flag in compiler.flags { command.add(flag) }
        for item in [path + ".ll", compiler.runtime, "-lm", "-o", path + ".exe"] { command.add(item) }
        test.require(test.run(command, system.environment(), "", path + ".link", 30), "link checked arithmetic " + optimization)
        let result = test.run([path + ".exe"], system.environment(), "", path + ".run", compiler.runTimeout)
        test.check(result.status == 1, "failure status " + optimization)
        test.check(result.output == expected, "failure evaluation order " + optimization)
        test.check(result.errorOutput == "Minyar stopped: " + diagnostic + "\n", "failure diagnostic " + optimization + "\n" + result.errorOutput)
    }
}
function quotient(left: Integer, right: Integer): Integer {
    let negative = (left < 0) != (right < 0)
    if left < 0 { left = -left }
    if right < 0 { right = -right }
    let result = 0
    while left >= right {
        let magnitude = right
        let power = 1
        while magnitude <= left - magnitude { magnitude += magnitude; power += power }
        left -= magnitude
        result += power
    }
    if negative { return -result }
    return result
}
let compiler = test.compiler()
let inlineOnly = processInfo.argumentCount() == 1 && processInfo.argument(0) == "CheckedArithmetic.test_checks_are_visible_without_lto"
test.check(processInfo.argumentCount() == 0 || inlineOnly, "unknown checked arithmetic test selector")
if !inlineOnly {
    for name in ["overflow", "division"] {
        rejection(compiler, "function " + name + "() { native \"fail_integer\" }\n", "native symbol conflicts with a runtime function")
    }
}
test.executes(compiler, "function sum(left: Integer, right: Integer): Integer {\nreturn left + right\n}\nfunction quotient(left: Integer, right: Integer): Integer {\nreturn left / right\n}\nprint(sum(20, 22))\nprint(quotient(84, 2))\n", "42\n42\n")
let ir = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
test.check(test.contains(ir, "define internal void @.minyar.integer.overflow.checked"), "checked arithmetic IR define internal void @.minyar.integer.overflow.checked")
test.check(test.contains(ir, "define internal void @.minyar.integer.division.checked"), "checked arithmetic IR define internal void @.minyar.integer.division.checked")
test.check(!test.contains(ir, "noalias"), "checked arithmetic IR noalias")
test.check(!test.contains(ir, " fast "), "checked arithmetic IR  fast ")
if !inlineOnly {
let leftOperands = [-837101, -587744, 256842, -435030, -672524, 779951, -124420, -374487, 903213, -377427, 73642, -900904, -218256, 778422, 525576, -65114, 448050, -918727, -167398, -270949, 626622, -137165, -110776, 656935, 605132, -811968, -30080, 475909, -292295, -894515, 153846, 529878, 296778, -763587, -464643, -947579, 915292, -588163, -588456, 483258, 615646, -930952, 912116, 883417, 927432, -905232, -184112, -814177, -590386, -361890, -866886, 267417, -520199, -645996, 531240, -335380, 80766, -605360, 538579, 248545, -486162, -595135, -67789, 684852, 341837, -311835, 362706, 308738, -689805, -919069, -158961, 341200, 907630, 774794, -945396, 525255, 337563, 315703, -262730, 912109, -992851, 162152, 97847, -255171, 557736, -716293, -862083, -541404, -702584, -148486, 415979, -617309, 691811, -512510, 133573, -693023, -463225, -239752, 665895, -89037, -312664, -336399, 339956, -391106, 544345, 473470, 427537, 340520, 948159, -71733, -37642, 465854, 271382, -606119, 107997, -409087, -889213, -290960, -761302, -246813, 45434, -773974, 357722, 432544, 936827, -290749, 701723, -620353, -453440, -229075, 235112, -249077, -267190, 818020, 612894, 498266, -374528, -606812, -216562, -296060, -19594, 111371, 292821, 760706, -6636, 704069, -164174, -417133, 591052, 156510, 165741, 877913, -232565, 995792, 396709, 848471, 690410, 933711, 402886, -811090]
let rightOperands = [-915382, 715327, -798747, -785470, -464253, -438934, 749479, -222995, 299539, 522039, 23683, -152899, 98635, 712590, 799717, 905681, -180175, -897448, 851565, -960792, -175542, -911883, -154795, -323539, -118661, 433863, 167105, -273525, -100709, -399067, -154547, -128554, -480770, 749191, 125518, 743625, -220091, -475456, 397938, 837933, -276587, 566183, -488120, 141031, -938462, -906201, -625944, 561303, -807339, 520943, 398184, -180465, 545080, 526224, -262257, -843436, 878327, -564727, -964900, -914501, 798786, 344456, -84852, -533957, 473931, -538454, -949599, -960040, 388545, 101270, -141744, 228444, -909058, -65588, 418507, -348055, 821929, -812592, -79974, 577752, 717218, 661996, -124216, 266726, 693560, -904899, 262174, -691216, -274963, -730489, -702949, -649275, 431597, 352345, -619897, 834823, 246812, -436145, 815314, 196450, 858340, -509087, 820430, 662659, 359536, 826188, 1615, 613562, -158553, -680954, 421841, 146610, -738959, 174166, -295300, 616006, -371253, 474756, 841580, -790715, -923822, -291374, 298227, -396497, 218772, -654896, -814176, -706190, -49235, 118923, -629045, -381163, -255838, -211461, 714611, 713427, -628349, -26194, -799191, -631730, -20676, 564453, 158960, -632187, -140618, 601705, 454976, -406238, -955369, -807053, -713645, 918263, 510963, 883949, -304517, 345184, -929578, -114867, 747015, -944187]
let source: List<Text> = []
let expected: List<Text> = []
let operators = ["+", "-", "*", "/", "%"]
for index in 0..operators.length {
    let operator = operators[index]
    let name = "operation" + Text(index)
    source.add("function " + name + "(a: Integer, b: Integer): Integer { return a " + operator + " b }\n")
    for sample in 0..32 {
        let left = leftOperands[index * 32 + sample]
        let right = rightOperands[index * 32 + sample]
        let value = 0
        if index == 0 { value = left + right }
        else if index == 1 { value = left - right }
        else if index == 2 { value = left * right }
        else if index == 3 { value = quotient(left, right) }
        else { value = left - quotient(left, right) * right }
        source.add("print(" + name + "(" + Text(left) + ", " + Text(right) + "))\n")
        expected.add(Text(value) + "\n")
    }
}
test.executes(compiler, joinText(source), joinText(expected))
test.executes(compiler, "function add(a: Integer, b: Integer): Integer { return a + b }\nfunction subtract(a: Integer, b: Integer): Integer { return a - b }\nfunction multiply(a: Integer, b: Integer): Integer { return a * b }\nfunction divide(a: Integer, b: Integer): Integer { return a / b }\nfunction remainder(a: Integer, b: Integer): Integer { return a % b }\nprint(add(9223372036854775806, 1))\nprint(subtract(-9223372036854775807, 1))\nprint(multiply(-9223372036854775808, 1))\nprint(multiply(-4611686018427387904, 2))\nprint(divide(-9223372036854775808, 1))\nprint(remainder(-9223372036854775808, 1))\nprint(divide(-7, 3))\nprint(remainder(-7, 3))\nprint(divide(7, -3))\nprint(remainder(7, -3))\n", "9223372036854775807\n-9223372036854775808\n-9223372036854775808\n-9223372036854775808\n-9223372036854775808\n0\n-2\n-1\n-2\n1\n")
fails(compiler, "function left(): Integer { print(11); return 9223372036854775807 }\nfunction right(): Integer { print(22); return 1 }\nfunction operation(a: Integer, b: Integer): Integer { return a + b }\nprint(operation(left(), right()))\nprint(33)\n", "11\n22\n", "this Integer calculation is outside the supported range.")
fails(compiler, "function left(): Integer { print(11); return -9223372036854775808 }\nfunction right(): Integer { print(22); return 1 }\nfunction operation(a: Integer, b: Integer): Integer { return a - b }\nprint(operation(left(), right()))\nprint(33)\n", "11\n22\n", "this Integer calculation is outside the supported range.")
fails(compiler, "function left(): Integer { print(11); return -9223372036854775808 }\nfunction right(): Integer { print(22); return -1 }\nfunction operation(a: Integer, b: Integer): Integer { return a * b }\nprint(operation(left(), right()))\nprint(33)\n", "11\n22\n", "this Integer calculation is outside the supported range.")
fails(compiler, "function left(): Integer { print(11); return 3037000500 }\nfunction right(): Integer { print(22); return 3037000500 }\nfunction operation(a: Integer, b: Integer): Integer { return a * b }\nprint(operation(left(), right()))\nprint(33)\n", "11\n22\n", "this Integer calculation is outside the supported range.")
fails(compiler, "function left(): Integer { print(11); return 17 }\nfunction right(): Integer { print(22); return 0 }\nfunction operation(a: Integer, b: Integer): Integer { return a / b }\nprint(operation(left(), right()))\nprint(33)\n", "11\n22\n", "an Integer cannot be divided by zero.")
fails(compiler, "function left(): Integer { print(11); return -9223372036854775808 }\nfunction right(): Integer { print(22); return -1 }\nfunction operation(a: Integer, b: Integer): Integer { return a / b }\nprint(operation(left(), right()))\nprint(33)\n", "11\n22\n", "this Integer division is outside the supported range.")
fails(compiler, "function left(): Integer { print(11); return 17 }\nfunction right(): Integer { print(22); return 0 }\nfunction operation(a: Integer, b: Integer): Integer { return a % b }\nprint(operation(left(), right()))\nprint(33)\n", "11\n22\n", "an Integer cannot be divided by zero.")
fails(compiler, "function left(): Integer { print(11); return -9223372036854775808 }\nfunction right(): Integer { print(22); return -1 }\nfunction operation(a: Integer, b: Integer): Integer { return a % b }\nprint(operation(left(), right()))\nprint(33)\n", "11\n22\n", "this Integer division is outside the supported range.")
fails(compiler, "function negate(value: Integer): Integer { return -value }\nprint(negate(-9223372036854775808))\n", "", "this Integer calculation is outside the supported range.")
}
test.removeTree(compiler.directory)
print("Checked arithmetic: passed")
