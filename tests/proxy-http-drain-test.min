use "./net-fixtures.min" as fixtures
use "../tools/testing.min" as test

fixtures.arguments(["--sanitize"], [])
let context = fixtures.context(fixtures.flag("--sanitize"))
for mode in ["debug", "release"] {
    let program = context.work + "/drain-" + mode
    let compiled = fixtures.run(context, [context.root + "/minyar", "--" + mode, context.root + "/tests/proxy-http-drain.min", "-o", program], 120)
    test.check(compiled.status == 0, "compile drain " + mode + "\n" + compiled.output + compiled.errorOutput)
    let ran = fixtures.execute(context, [program], 15, "drain " + mode)
    test.check(ran.output == "HTTP server drain preserves admitted work and closes ingress\n" && ran.errorOutput == "", "drain output changed")
}
fixtures.finish(context)
