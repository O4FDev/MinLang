// Probe for the experimental ablation switches (tests/ablation/switches.sh):
// checked arithmetic, List positions, Text indexing and owned values.
let words = "alpha beta gamma delta".split(" ")
let counts: List<Integer> = []
for word in words { counts.add(word.length) }
let total = 0
let i = 0
while i < counts.length {
    total = total * 31 + counts[i] - i
    counts[i] = counts[i] + 1
    i += 1
}
let text = words[2]
print("\(total) \(counts[0]) \(text[1]) \(text.length) \(-total)")
