use "io" as io
use "./net-fixtures.min" as fixtures
use "./peer-edge-lab.min" as lab
use "../tools/testing.min" as test
use "system" as system
use "json" as json

function probe(state: lab.Lab, kind: Text, port: Integer, certificate: Text): Text {
    let result = fixtures.run(state.context, [lab.peerBinary(state), kind, "127.0.0.1:" + Text(port), fixtures.path(state.certs, "ca", "pem"),
        fixtures.path(state.certs, certificate, "pem"), fixtures.path(state.certs, certificate, "key")], 30)
    lab.require(state, result.status == 0, kind + " " + certificate + " (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
    return fixtures.strip(result.output)
}
function gateway(state: lab.Lab, certificate: Text, accepted: Boolean) {
    let outcome = probe(state, "h2-probe", state.gatewayPort, certificate)
    if accepted { lab.require(state, outcome == "ACCEPTED", "trusted gateway " + certificate + " was refused: " + outcome) }
    else { lab.require(state, fixtures.starts(outcome, "REJECTED "), "untrusted but registry-listed gateway " + certificate + " was admitted: " + outcome) }
}
function unknownDevice(state: lab.Lab, certificate: Text) {
    let outcome = probe(state, "device-probe", state.devicePort, certificate)
    lab.require(state, fixtures.starts(outcome, "REJECTED "), "untrusted device " + certificate + " was not rejected: " + outcome)
}
function refreshedGateways(state: lab.Lab) {
    let removed = lab.session(state, "gateway")
    let retained = lab.session(state, "gateway-next")
    let beforeRemoved = lab.call(state, removed, lab.signed(state, "refresh-before-removed"), "exit-a", "refresh-before-removed", 0, 1000)
    let beforeRetained = lab.call(state, retained, lab.signed(state, "refresh-before-retained"), "exit-a", "refresh-before-retained", 0, 1000)
    lab.require(state, lab.status(beforeRemoved) == "OK" && lab.status(beforeRetained) == "OK", "gateway refresh precondition failed")
    io.writeTextFile(state.directory + "/registry.ndjson", "{\"role\": \"device\", \"device_id\": \"device-a\", \"exit_id\": \"exit-a\", \"revoked\": false, \"paused\": false, \"quarantined\": false, \"max_concurrent\": 8}\n" +
        "{\"role\": \"gateway\", \"sha256\": " + json.quote(lab.digest(state.context, fixtures.path(state.certs, "gateway-next", "der"))) + "}\n")
    fixtures.pause("16")
    let afterRemoved = lab.call(state, removed, lab.signed(state, "refresh-after-removed"), "exit-a", "refresh-after-removed", 0, 1000)
    let afterRetained = lab.call(state, retained, lab.signed(state, "refresh-after-retained"), "exit-a", "refresh-after-retained", 0, 1000)
    lab.require(state, lab.status(afterRemoved) != "OK", "removed gateway fingerprint survived registry refresh: " + json.pretty(afterRemoved, ""))
    lab.require(state, lab.status(afterRetained) == "OK", "retained gateway fingerprint was disconnected: " + json.pretty(afterRetained, ""))
    lab.endSession(state, removed)
    lab.endSession(state, retained)
}
function malformedConfiguration(state: lab.Lab): Integer {
    let cases = 0
    let long = "\"" + lab.repeated("x", 4096) + "\""
    let many: List<Text> = []
    for index in 0..17 { many.add("\"root.der\"") }
    let values = ["[]", "[\"\"]", "[1]", "[false]", "[null]", "[{}]", "[[]]", "[" + lab.joined(many, ", ") + "]", "[" + long + "]", "[\"root.der\", \"bad\\u0000path\"]"]
    for name in ["certificate", "device_roots", "gateway_roots"] {
        for value in values {
            io.writeTextFile(state.directory + "/invalid-pki.json", lab.render(lab.replaced(state.settings, name, value)))
            let result = fixtures.run(state.context, [state.binary, state.directory + "/invalid-pki.json", "1000"], 3)
            lab.require(state, result.status == 2 && result.output == "invalid edge configuration\n" && result.errorOutput == "", name + " " + value + " (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
            cases += 1
        }
    }
    for name in ["device_roots", "gateway_roots"] {
        let current = lab.setting(state.settings, name)
        let first = fixtures.split(Text(Bytes(current).slice(1, current.byteLength - 1)), 44)[0]
        let repeated: List<Text> = []
        for index in 0..16 { repeated.add(fixtures.strip(first)) }
        let settings = lab.replaced(lab.replaced(lab.replaced(state.settings, name, "[" + lab.joined(repeated, ", ") + "]"), "device_port", "0"), "gateway_port", "0")
        io.writeTextFile(state.directory + "/bounded-pki.json", lab.render(settings))
        let result = fixtures.run(state.context, [state.binary, state.directory + "/bounded-pki.json", "1"], 3)
        lab.require(state, result.status == 0 && fixtures.starts(result.output, "READY ") && result.errorOutput == "", "sixteen " + name + " (" + Text(result.status) + ")\n" + result.output + result.errorOutput)
    }
    return cases
}
function absentEventually(state: lab.Lab) {
    let deadline = system.monotonicNanoseconds() + 5000000000
    while system.monotonicNanoseconds() < deadline {
        if lab.state(state).kind == 4 { return }
        fixtures.pause("0.02")
    }
    lab.require(state, false, "device live state remained after close")
}
function complete(context: fixtures.Context, directory: Text, binary: Text, sanitize: Boolean): Text {
    let setup = lab.options(binary, sanitize, 30000, 8)
    setup.pki = true
    let state = lab.create(context, directory, setup)
    let cases = malformedConfiguration(state)
    for certificate in ["gateway", "gateway-next"] { gateway(state, certificate, true) }
    gateway(state, "gateway-untrusted", false)
    gateway(state, "gateway-device-root", false)
    refreshedGateways(state)
    for certificate in ["device", "device-next"] {
        let device = lab.startDevice(state, certificate)
        let text = lab.waitState(state, 5000)
        lab.require(state, text != "" && lab.stateNumber(text, "capacity_weight") > 0.0 && json.string(json.parse(text), "edge_region") == "eu-west", "device " + certificate + " live state\n" + text)
        lab.send(state, device, "close")
        let closed = lab.finishDevice(state, device)
        lab.require(state, closed.status == 0, "device " + certificate + " exit " + Text(closed.status))
        absentEventually(state)
    }
    unknownDevice(state, "device-untrusted")
    unknownDevice(state, "device-gateway-root")
    lab.require(state, lab.state(state).kind == 4, "untrusted device published live state")
    lab.require(state, system.poll(state.edge.handle).state == system.PENDING, "edge exited\n" + lab.diagnostic(state))
    lab.require(state, lab.diagnostic(state) == "", lab.diagnostic(state))
    let values = lab.counts(lab.completed(state, 20000))
    lab.require(state, lab.count(values, "active") == 0 && lab.count(values, "retained_relays") == 0, "retained peers " + lab.describe(values))
    print("GREEN peer edge PKI: intermediate server chain, distinct old/new device and gateway roots, registry-refresh gateway revocation with retained gateway continuity, omitted/cross-role root rejection, " + Text(cases) + " malformed path-array controls")
    let built = state.binary
    lab.close(state)
    return built
}

fixtures.arguments(["--sanitize"], ["--binary"])
let sanitize = fixtures.flag("--sanitize")
let context = fixtures.context(sanitize)
let binary = complete(context, context.work + "/complete-chain", fixtures.option("--binary", ""), sanitize)
let setup = lab.options(binary, sanitize, 3000, 8)
setup.pki = true
setup.intermediate = false
let state = lab.create(context, context.work + "/missing-chain", setup)
let refused = probe(state, "chain-probe", state.gatewayPort, "gateway")
lab.require(state, fixtures.starts(refused, "VERIFY_FAILED "), "server was trusted without its required intermediate: " + refused)
lab.require(state, system.poll(state.edge.handle).state == system.PENDING, "edge exited\n" + lab.diagnostic(state))
lab.completed(state, 10000)
print("GREEN missing-intermediate control refused TLS authentication")
lab.close(state)
fixtures.finish(context)
