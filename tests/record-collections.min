use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, io.readTextFile("examples/gallery/seed-library.min"), "Our seed library has 2 promises.\nAster waits on the sunny windowsill.\nTake a seed. Bring a story.\n", levels, 0, "", true)
fixtures.executes(frontend, "record Point { x: Float; y: Integer }\nrecord Address { town: Text; point: Point }\nfunction address(): Address { return Address { town: \"A\" + \"da\"; point: Point { x: 0.0; y: 2 } } }\nlet key = address()\nlet entries: Map<Address, Text> = Map()\nentries[key] = \"home\"\nprint(entries[address()])\nkey.point.y = 3\nkey.town = \"Grace\"\nprint(entries.has(key))\nprint(entries.has(address()))\nentries[Address { town: \"Ada\"; point: Point { x: -0.0; y: 2 } }] = \"garden\"\nprint(entries.length)\nfor snapshot in entries { snapshot.point.y = 9; snapshot.town = \"changed\" }\nprint(entries[address()])\nprint(entries.remove(address()))\nprint(entries.length)\n", "home\nfalse\ntrue\n1\ngarden\ntrue\n0\n", levels, 0, "", true)
fixtures.executes(frontend, "record Key { value: Integer }\nlet entries: Map<Key, Integer> = Map()\nfor n in 0..100 { entries[Key { value: n }] = n * 2 }\nfor n in 0..100 { if entries[Key { value: n }] != n * 2 { fail(\"wrong value\") } }\nfor n in 0..50 { if !entries.remove(Key { value: n * 2 }) { fail(\"missing key\") } }\nfor n in 0..100 { if entries.has(Key { value: n }) != (n % 2 == 1) { fail(\"wrong presence\") } }\nprint(entries.length)\nlet alias = entries\nentries.clear()\nprint(alias.length)\nentries[Key { value: 42 }] = 84\nprint(alias[Key { value: 42 }])\n", "50\n0\n84\n", levels, 0, "", true)
fixtures.executes(frontend, "record Key { value: Integer }\nlet first = {Key { value: 1 }: \"one\", Key { value: 1 }: \"ONE\"}\nlet second: Map<Key, Text> = {Key { value: 1 }: \"ONE\"}\nprint(first.length)\nprint(first == second)\n", "1\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "record Key { value: Text }\nlet original = Key { value: \"Ada\" }\nlet names: Set<Key> = Set()\nlet alias = names\nnames.add(original)\nnames.add(Key { value: \"Ada\" })\nprint(names.length)\noriginal.value = \"Grace\"\nprint(names.contains(Key { value: \"Ada\" }))\nprint(names.contains(original))\nfor key in names { key.value = \"changed\" }\nprint(names.contains(Key { value: \"Ada\" }))\nprint(alias.remove(Key { value: \"Ada\" }))\nprint(names.length)\nnames.add(original)\nnames.clear()\nprint(alias.length)\n", "1\ntrue\nfalse\ntrue\ntrue\n0\n0\n", levels, 0, "", true)
fixtures.executes(frontend, "let integers = Set<Integer>()\nfor n in [3, 1, 3, 2] { integers.add(n) }\nlet total = 0\nfor n in integers { total += n }\nprint(total)\nprint(integers.contains(2))\nprint(integers.remove(2))\nprint(integers.remove(2))\nlet words: Set<Text> = Set()\nwords.add(\"hé\" + \"llo\")\nprint(words.contains(\"héllo\"))\nlet nested: List<Set<Text>> = [words]\nprint(nested[0].contains(\"héllo\"))\n", "6\ntrue\ntrue\nfalse\ntrue\ntrue\n", levels, 0, "", true)
for field in ["List<Integer>", "Bytes", "() -> Integer"] {
    fixtures.rejects(frontend, "record Key { value: " + field + " }\nlet keys: Map<Key, Integer> = Map()\n", "is not Hashable", true)
    fixtures.rejects(frontend, "record Key { value: " + field + " }\nlet keys: Set<Key> = Set()\n", "is not Hashable", true)
}
fixtures.rejects(frontend, "let keys: Set<List<Integer>> = Set()\n", "Set elements must be Hashable", true)
fixtures.rejects(frontend, "let keys: Set<Integer> = Set()\nkeys.add(\"wrong\")\n", "Set element has the wrong type", true)
fixtures.rejects(frontend, "let keys = Set()\n", "Set() needs a contextual Set<T> type", true)
fixtures.executes(frontend, "record Key { value: Float }\nlet keys: Map<Key, Integer> = Map()\nkeys[Key { value: 0.0 / 0.0 }] = 1\n", "", levels, 1, "Minyar stopped: NaN cannot be used as a Map key.\n", false)
fixtures.executes(frontend, "let first = Set<Integer>()\nlet second = Set<Integer>()\nfirst.add(1); first.add(2); second.add(2); second.add(1)\nprint(first == second)\nsecond.remove(1)\nprint(first != second)\nrecord Key { value: Integer }\nlet inner: Map<Key, Integer> = {Key { value: 42 }: 7}\nlet a: Map<Key, Map<Key, Integer>> = {Key { value: 1 }: inner}\nlet b: Map<Key, Map<Key, Integer>> = {Key { value: 1 }: {Key { value: 42 }: 7}}\nprint(a == b)\n", "true\ntrue\ntrue\n", levels, 0, "", true)
fixtures.executes(frontend, "record Empty {}\nlet emptyKeys: Map<Empty, Integer> = Map()\nemptyKeys[Empty {}] = 40; emptyKeys[Empty {}] = 42\nprint(emptyKeys.length); print(emptyKeys[Empty {}])\nrecord Wrapped { result: Result<Text, Text> }\nlet results: Map<Wrapped, Integer> = Map()\nresults[Wrapped { result: Ok(\"Ada\") }] = 1\nresults[Wrapped { result: Err(\"rain\") }] = 2\nprint(results[Wrapped { result: Ok(\"Ada\") }])\nprint(results[Wrapped { result: Err(\"rain\") }])\nlet statuses: Set<Result<Nothing, Text>> = Set()\nstatuses.add(Ok()); statuses.add(Ok()); statuses.add(Err(\"rain\"))\nprint(statuses.length)\nprint(statuses.contains(Ok()))\n", "1\n42\n1\n2\n2\ntrue\n", levels, 0, "", true)
io.writeTextFile(frontend.compiler.directory + "/keys.min", "public record Key { value: Integer }\npublic function names(): Map<Key, Text> { return {Key { value: 42 }: \"Ada\"} }\npublic function keys(): Set<Key> { let keys: Set<Key> = Set(); keys.add(Key { value: 42 }); return keys }\n")
fixtures.executes(frontend, "use \"./keys.min\" as library\nlet names = library.names()\nlet keys = library.keys()\nprint(names[library.Key { value: 42 }])\nprint(keys.contains(library.Key { value: 42 }))\n", "Ada\ntrue\n", levels, 0, "", true)
fixtures.rejects(frontend, "record Key { value: Bytes }\nfunction unused(keys: Map<Key, Integer>) {}\n", "is not Hashable", true)
fixtures.executes(frontend, "record Key { value: Integer }\nlet keys: Set<Key> = Set()\nlet count: () -> Integer = function() { return keys.length }\nkeys.add(Key { value: 42 })\nprint(count())\nlet read: (Set<Key>) -> Boolean = function(values) { return values.contains(Key { value: 42 }) }\nprint(read(keys))\n", "1\ntrue\n", levels, 0, "", true)
let cachedEntry = frontend.compiler.directory + "/cached.min"
io.writeTextFile(cachedEntry, "use \"./keys.min\" as keys\nlet names: Map<keys.Key, Text> = Map()\nnames[keys.Key { value: 42 }] = \"Ada\"\nprint(names == keys.names())\nlet values: Set<keys.Key> = Set()\nvalues.add(keys.Key { value: 42 })\nprint(values == keys.keys())\nfor key in values { print(key.value) }\n")
let prior = frontend.compiler.directory + "/empty.state"
io.writeTextFile(prior, "")
for pass in ["cold", "warm"] {
    let base = frontend.compiler.directory + "/" + pass
    test.require(test.run([frontend.compiler.executable, cachedEntry, base + ".ll", "--module-state", prior, base + ".state", base + ".stats", "--library", "library"], frontend.environment, "", base + ".compile", 30), "compile record collections in cached modules")
    if pass == "warm" {
        let stats = io.readTextFile(base + ".stats").trim().split(" ")
        test.check(stats[0] == "2" && stats[1] == "0" && stats[6] == "true", "record collection modules did not reuse their cached bodies")
    }
    if test.addressEnabled(frontend.compiler.flags) { io.writeTextFile(base + ".ll", test.instrument(io.readTextFile(base + ".ll"))) }
    for level in levels {
        let command = [frontend.compiler.clang, level, "-Wno-override-module", base + ".ll", frontend.compiler.runtime, "-lm", "-o", base + ".exe"]
        for flag in frontend.compiler.flags { command.add(flag) }
        test.require(test.run(command, frontend.environment, "", base + ".link", 30), "link record collections in cached modules")
        let result = test.run([base + ".exe"], frontend.environment, "", base + ".run", 30)
        test.require(result, "execute record collections in cached modules")
        test.check(result.output == "true\ntrue\n42\n" && result.errorOutput == "", "cached record collection output changed")
    }
    prior = base + ".state"
}
fixtures.executes(frontend, "function echo<Item>(value: Item): Item { return value }\nfunction single<Item>(value: Item): Set<Item> { let keys: Set<Item> = Set(); keys.add(value); return keys }\nfunction count<Item>(values: Set<Item>): Integer { return values.length }\nrecord Key { word: Text }\nlet keys = echo(Set<Key>())\nkeys.add(Key { word: \"Ada\" })\nprint(count(keys))\nfor key in keys { print(echo(key).word) }\nlet words = single(\"Grace\")\nprint(words.contains(\"Grace\"))\nlet empty = echo(Set<Text>())\nprint(count(empty))\nlet labels: Map<Key, Integer> = {Key { word: \"home\" }: 42}\nfor key in labels { print(echo(key).word) }\n", "1\nAda\ntrue\n0\nhome\n", levels, 0, "", true)
test.removeTree(frontend.compiler.directory)
print("Record collections: passed")
