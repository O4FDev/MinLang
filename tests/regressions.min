use "io" as io
use "../tools/testing.min" as test
use "./compiler-port-support.min" as port
use "./native-evidence.min" as evidence
use "./semantic-oracle.min" as oracle
use "../experiments/memory/study-support.min" as data
use "system" as system
use "files" as files
use "json" as json
function bytes(value: json.Value): Bytes { let raw = Bytes(); for byte in value.items { raw.add(Integer(byte.text)) }; return raw }
function program(context: evidence.Context, source: Text, suffix: Text): Text {
    let result = evidence.compile(context,source); evidence.expect(context,result.status == 0,result.errorOutput)
    let executable = evidence.llvm(context) + suffix; evidence.link(context,evidence.llvm(context),"-O2",executable,30); return executable
}
let names = ["test_calls_before_a_binding_do_not_shift_ownership_slots", "test_utf8_byte_order_mark_is_accepted", "test_non_ascii_identifier_has_actionable_diagnostic", "test_field_and_method_selectors_keep_their_receiver_namespace", "test_methods_reject_the_wrong_receiver_kind", "test_unicode_index_does_not_depend_on_length", "test_unicode_character_output", "test_unicode_properties", "test_invalid_utf8_files", "test_ascii_index_and_slice_validate_invalid_utf8_tail_first", "test_file_io_failures_stop_cleanly", "test_file_read_preserves_first_byte_and_empty_files", "test_closed_standard_output_is_reported", "test_integer_boundaries", "test_missing_return", "test_return_paths", "test_unreachable_code_preserves_return", "test_literal_true_loop_is_terminal", "test_main_signature", "test_nothing_is_only_a_return_type", "test_unicode_files_and_arguments", "test_unicode_paths_support_text_and_binary_file_operations", "test_write_text_file_writes_list_pieces_without_joining", "test_consuming_self_assignment_respects_parameters_and_later_reads", "test_invalid_arithmetic_and_ordering", "test_valid_operators", "test_builtin_arity", "test_builtin_types", "test_nonvalues_and_index_types"]
let selectors = port.selectors("Regressions", names)
if port.selected(selectors, "Regressions", "test_calls_before_a_binding_do_not_shift_ownership_slots") {
    let context = evidence.context("regression", "Regressions.test_calls_before_a_binding_do_not_shift_ownership_slots", "tests/regressions.min")
    let source = "record Box {\n    label: Text\n}\nfunction make(label: Text): Box { return Box { label: label } }\nlet box = make(\"box\")\nlet other = make(\"other\")\nprint(box.label + \" \" + other.label)\n"
    let result = evidence.compile(context, source); evidence.expect(context, result.status == 0, result.errorOutput)
    evidence.expect(context, !test.contains(io.readTextFile(evidence.llvm(context)), "@minyar_rc_local_take(i64 -"), "call count shifted ownership slot below zero")
    evidence.executes(context, source, "box other\n", 0, "", [], [])
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_utf8_byte_order_mark_is_accepted") {
    let context = evidence.context("regression", "Regressions.test_utf8_byte_order_mark_is_accepted", "tests/regressions.min")
    evidence.executes(context, "﻿print(42)\n", "42\n", 0, "", [], [])
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_non_ascii_identifier_has_actionable_diagnostic") {
    let context = evidence.context("regression", "Regressions.test_non_ascii_identifier_has_actionable_diagnostic", "tests/regressions.min")
    evidence.rejects(context, "let café = 42\nprint(café)\n", "line 1, column 8: names must use ASCII letters, digits, and '_'; found non-ASCII character 'é'")
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_field_and_method_selectors_keep_their_receiver_namespace") {
    let context = evidence.context("regression", "Regressions.test_field_and_method_selectors_keep_their_receiver_namespace", "tests/regressions.min")
    io.writeTextFile(context.path + "/tree.min", test.sourceModules("public record Node { text: Text }\npublic function leaf(): Node { return Node { text: \"alive\" } }\n"))
    evidence.executes(context, "use \"./tree.min\" as tree\nrecord Wrapper { tree: tree.Node }\nfunction slice(n: Integer): Integer { return n + 1 }\nlet boxes: List<Wrapper> = []\nboxes.add(Wrapper { tree: tree.leaf() })\nprint(boxes[0].tree.text)\nlet text = \"abc\"\nprint(text.slice(0, 2))\nprint(slice(1))\n", "alive\nab\n2\n", 0, "", [], [])
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_methods_reject_the_wrong_receiver_kind") {
    let context = evidence.context("regression", "Regressions.test_methods_reject_the_wrong_receiver_kind", "tests/regressions.min")
    evidence.rejects(context, "let text = \"value\"\ntext.add(1)\n", "2, column 6: this value has no method named 'add'")
    evidence.rejects(context, "let values = [1]\nvalues.slice(0)\n", "2, column 15: expected ','")
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_unicode_index_does_not_depend_on_length") {
    let context = evidence.context("regression", "Regressions.test_unicode_index_does_not_depend_on_length", "tests/regressions.min")
    evidence.executes(context, "let text = \"é🙂\"\nprint(Text(text[0]))\nprint(text.length)\nprint(Text(text[0]))\n", "é\n2\né\n", 0, "", [], [])
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_unicode_character_output") {
    let context = evidence.context("regression", "Regressions.test_unicode_character_output", "tests/regressions.min")
    evidence.executes(context, "let text = \"é🙂\"\nprint(text.length)\nprint(text[0])\nprint(text[1])\n", "2\né\n🙂\n", 0, "", [], [])
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_unicode_properties") {
    let context = evidence.context("regression", "Regressions.test_unicode_properties", "tests/regressions.min")
    let values = [data.integerArray([65]), data.integerArray([233]), data.integerArray([30028]), data.integerArray([128578]), data.integerArray([65,233,30028,128578]), data.integerArray([101,769])]
    for value in values {
        let points: List<Integer> = []; for point in value.items { points.add(Integer(point.text)) }
        let source: List<Text> = ["let text = " + oracle.literal(Text(oracle.utf8(points))) + " + \"\"\n"]
        let expected: List<Text> = []
        for index in 0..points.length {
            let position = oracle.decimal(index); let character = Text(oracle.utf8([points[index]]))
            source.add("print(text[" + position + "])\nprint(Text(text[" + position + "])[0])\nprint(text.slice(" + position + ", " + oracle.decimal(index + 1) + ") == Text(text[" + position + "]))\n")
            expected.add(character + "\n" + character + "\ntrue\n")
        }
        source.add("print(text.length)\nprint(text.byteLength)\n"); expected.add(oracle.decimal(points.length) + "\n" + oracle.decimal(oracle.utf8(points).length) + "\n")
        evidence.executes(context, joinText(source), joinText(expected), 0, "", [], [])
    }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_invalid_utf8_files") {
    let context = evidence.context("regression", "Regressions.test_invalid_utf8_files", "tests/regressions.min")
    let executable = program(context, "let text = io.readTextFile(processInfo.argument(0))\nprint(text.length)\n", ".exe")
    for values in [data.integerArray([192,175]), data.integerArray([237,160,128]), data.integerArray([244,144,128,128]), data.integerArray([226,130])] {
        let path = context.path + "/invalid-utf8.txt"; io.writeBytesFile(path, bytes(values))
        let observed = evidence.run(context, [executable,path], "execute", context.compiler.runTimeout, false)
        evidence.expect(context, observed.status == 1 && test.contains(observed.errorOutput,"invalid UTF-8"), "invalid UTF8 file accepted")
    }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_ascii_index_and_slice_validate_invalid_utf8_tail_first") {
    let context = evidence.context("regression", "Regressions.test_ascii_index_and_slice_validate_invalid_utf8_tail_first", "tests/regressions.min")
    let prefixes = [oracle.repeat("a",128), "﻿" + oracle.repeat("a",128), "é" + oracle.repeat("a",127)]
    let first = ["a","﻿","é"]; let operations = ["text[0]","text[65]","text.slice(64, 128)"]
    let tails = [data.integerArray([255]),data.integerArray([226,130]),data.integerArray([237,160,128]),data.integerArray([192,175])]
    let path = context.path + "/indexed-tail.txt"
    for operation in 0..operations.length {
        let result = evidence.compile(context,"let text = io.readTextFile(processInfo.argument(0))\nprint(" + operations[operation] + ")\nprint(\"after\")\n"); evidence.expect(context,result.status == 0,result.errorOutput)
        for optimization in ["-O0","-O2"] {
            let executable = evidence.llvm(context) + "." + optimization; evidence.link(context,evidence.llvm(context),optimization,executable,30)
            for prefix in 0..prefixes.length {
                io.writeTextFile(path,prefixes[prefix] + "🙂")
                let expected = first[prefix]; if operation == 1 { expected = "a" }; if operation == 2 { expected = oracle.repeat("a",64) }
                let observed = evidence.run(context,[executable,path],"execute-valid-tail",context.compiler.runTimeout,false)
                evidence.expect(context,observed.status == 0 && observed.output == expected + "\nafter\n" && observed.errorOutput == "", "valid requested ASCII tail oracle changed")
                for tail in tails {
                    let raw = Bytes(prefixes[prefix]); raw.addBytes(bytes(tail)); io.writeBytesFile(path,raw)
                    observed = evidence.run(context,[executable,path],"execute-invalid-tail",context.compiler.runTimeout,false)
                    evidence.expect(context,observed.status == 1 && observed.output == "" && test.sameDiagnostic(observed.errorOutput, "Minyar stopped: Text contained invalid UTF-8.\n"), "requested ASCII block bypassed invalidUTF8 tail validation")
                }
            }
        }
    }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_file_io_failures_stop_cleanly") {
    let context = evidence.context("regression", "Regressions.test_file_io_failures_stop_cleanly", "tests/regressions.min")
    let read = program(context,"print(io.readTextFile(processInfo.argument(0)))\n",".read")
    let observed = evidence.run(context,[read,context.path],"execute",context.compiler.runTimeout,false)
    evidence.expect(context,observed.status == 1 && (test.contains(observed.errorOutput,"could not be read") || test.contains(observed.errorOutput,"could not be opened")), "reading directory must stop cleanly")
    let write = program(context,"io.writeTextFile(processInfo.argument(0), \"contents\")\n",".write")
    for path in [context.path,context.path + "/missing/output.txt"] {
        observed = evidence.run(context,[write,path],"execute",context.compiler.runTimeout,false)
        evidence.expect(context,observed.status == 1 && test.contains(observed.errorOutput,"could not be created"), "file create failure must stop cleanly")
    }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_file_read_preserves_first_byte_and_empty_files") {
    let context = evidence.context("regression", "Regressions.test_file_read_preserves_first_byte_and_empty_files", "tests/regressions.min")
    let executable = program(context,"print(io.readTextFile(processInfo.argument(0)))\n",".exe")
    let path = context.path + "/contents.txt"
    for value in ["","A","é🙂","first\r\nsecond\n"] {
        io.writeTextFile(path,value); let observed = evidence.run(context,[executable,path],"execute",context.compiler.runTimeout,false)
        evidence.expect(context,observed.status == 0 && observed.output == value + "\n", "file first byte/empty/CRLF bytes changed")
    }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_closed_standard_output_is_reported") {
    let context = evidence.context("regression", "Regressions.test_closed_standard_output_is_reported", "tests/regressions.min")
    let executable = program(context,"print(\"unwritten\")\n",".closed-output")
    let observed = evidence.run(context,["/bin/sh","-c","exec 1>&-; exec \"$@\"","minyar",executable],"execute-closed-output",context.compiler.runTimeout,false)
    let row = context.commands[context.commands.length - 1]; data.set(row,"stdout_captured",data.boolean(false))
    evidence.expect(context,observed.status == 1 && test.sameDiagnostic(observed.errorOutput, "Minyar stopped: standard output could not be written.\n"), "closed child standard output must be reported")
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_integer_boundaries") {
    let context = evidence.context("regression", "Regressions.test_integer_boundaries", "tests/regressions.min")
    evidence.executes(context,"print(9223372036854775807)\nprint(-9223372036854775808)\nprint(42)\n","9223372036854775807\n-9223372036854775808\n42\n",0,"",[],[])
    for value in ["9223372036854775808","18446744073709551616","-9223372036854775809"] { evidence.rejects(context,"print(" + value + ")\n","Integer literal is outside the supported range") }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_missing_return") {
    let context = evidence.context("regression", "Regressions.test_missing_return", "tests/regressions.min")
    evidence.rejects(context,"function value(): Integer { return }\n","a returned value has the wrong type")
    for body in ["","if flag { return 42 }","while flag { return 42 }","while false { return 42 }"] { evidence.rejects(context,"function value(flag: Boolean): Integer {\n" + body + "\n}\n","must return a value on every path") }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_return_paths") {
    let context = evidence.context("regression", "Regressions.test_return_paths", "tests/regressions.min")
    evidence.executes(context, "function value(flag: Boolean): Integer {\nif flag { return 42 } else { return 7 }\n}\nprint(value(true))\nprint(value(false))\n", "42\n7\n", 0, "", [], [])
    evidence.executes(context, "function value(flag: Boolean): Integer {\nif flag { return 42 } else { fail(\"no value\") }\n}\nprint(value(true))\n", "42\n", 0, "", [], [])
    evidence.executes(context, "function stop() {\nreturn\n}\nstop()\nprint(\"done\")\n", "done\n", 0, "", [], [])
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_unreachable_code_preserves_return") {
    let context = evidence.context("regression", "Regressions.test_unreachable_code_preserves_return", "tests/regressions.min")
    evidence.executes(context, "function value(): Integer {\nreturn 42\nprint(true || false)\n}\nprint(value())\n", "42\n", 0, "", [], [])
    evidence.executes(context, "exit(7)\nprint(true && false)\n", "", 7, "", [], [])
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_literal_true_loop_is_terminal") {
    let context = evidence.context("regression", "Regressions.test_literal_true_loop_is_terminal", "tests/regressions.min")
    evidence.executes(context, "function scalar(): Integer {\nwhile true { return 1 }\nprint(\"unreachable\")\n}\nfunction owned(flag: Boolean): Text {\nlet prefix = \"retained\"\nwhile (true) {\nif flag { return prefix + \" yes\" } else { return prefix + \" no\" }\n}\n}\nfunction nested(): List<Integer> { while true { while true { return [4, 2] } } }\nfunction never(): Integer { while true { } }\nprint(scalar()); print(owned(true)); print(owned(false))\nlet values = nested(); print(values[0]); print(values[1])\n", "1\nretained yes\nretained no\n4\n2\n", 0, "", [], [])
    evidence.executes(context, "function stop(): Integer { while true { exit(7) } }\nprint(stop())\n", "", 7, "", [], [])
    evidence.executes(context, "function stop(): Integer { while true { fail(\"loop stopped\") } }\nprint(stop())\n", "", 1, "Minyar stopped: loop stopped\n", [], [])
    evidence.rejects(context, "function value(): Integer { while true { return 1 }; print(missing) }\n", "I can't find a value named 'missing'")
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_main_signature") {
    let context = evidence.context("regression", "Regressions.test_main_signature", "tests/regressions.min")
    evidence.rejects(context, "function main(value: Integer) {\nreturn value\n}\n", "main expects no parameters")
    evidence.rejects(context, "function main(): Text {\nreturn \"x\"\n}\n", "main must return Integer")
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_nothing_is_only_a_return_type") {
    let context = evidence.context("regression", "Regressions.test_nothing_is_only_a_return_type", "tests/regressions.min")
    for source in ["record R { value: Nothing }\n","function f(value: Nothing) {}\n","let values: List<Nothing> = []\n"] { evidence.rejects(context,source,"Nothing cannot be used as a value type") }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_unicode_files_and_arguments") {
    let context = evidence.context("regression", "Regressions.test_unicode_files_and_arguments", "tests/regressions.min")
    let path = context.path + "/unicode é🙂.txt"; io.writeTextFile(path,"é🙂")
    let executable = program(context,"let argumentText = processInfo.argument(0)\nlet fileText = io.readTextFile(processInfo.argument(1))\nprint(argumentText)\nprint(argumentText[0])\nprint(fileText[1])\n",".exe")
    for argument in ["é🙂","é🙂 with spaces","é🙂 \"quoted\" \\end\\"] {
        let observed = evidence.run(context,[executable,argument,path],"execute",context.compiler.runTimeout,false)
        evidence.expect(context,observed.status == 0 && observed.output == argument + "\né\n🙂\n", "Unicode/space/quote/backslash argument/path bytes changed")
    }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_unicode_paths_support_text_and_binary_file_operations") {
    let context = evidence.context("regression", "Regressions.test_unicode_paths_support_text_and_binary_file_operations", "tests/regressions.min")
    let textPath = context.path + "/text é🙂.txt"; let bytesPath = context.path + "/bytes é🙂.bin"; let raw = Bytes(3); raw[0] = 0; raw[1] = 255; raw[2] = 42
    evidence.executes(context,"let textPath = processInfo.argument(0)\nlet bytesPath = processInfo.argument(1)\nprint(io.fileExists(textPath))\nio.writeTextFile(textPath, \"é🙂\")\nprint(io.fileExists(textPath))\nprint(io.readTextFile(textPath))\nlet bytes = Bytes(3)\nbytes[0] = 0\nbytes[1] = 255\nbytes[2] = 42\nio.writeBytesFile(bytesPath, bytes)\nprint(io.fileExists(bytesPath))\nlet read = io.readBytesFile(bytesPath)\nprint(read[0])\nprint(read[1])\nprint(read[2])\n","false\ntrue\né🙂\ntrue\n0\n255\n42\n",0,"",[textPath,bytesPath],[evidence.FileOutput { path:textPath; contents:Bytes("é🙂") },evidence.FileOutput { path:bytesPath; contents:raw }])
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_write_text_file_writes_list_pieces_without_joining") {
    let context = evidence.context("regression", "Regressions.test_write_text_file_writes_list_pieces_without_joining", "tests/regressions.min")
    let path = context.path + "/pieces é.txt"; let pieces: List<Text> = ["é🙂\n"]
    for index in 0..40000 { pieces.add("line " + oracle.decimal(index) + "\n") }
    pieces.add(oracle.repeat("abcde",70000)); pieces.add("end"); let expected = joinText(pieces)
    evidence.executes(context,"let pieces: List<Text> = []\npieces.add(\"\")\npieces.add(\"é🙂\\n\")\nlet index = 0\nwhile index < 40000 {\n    pieces.add(\"line \")\n    pieces.add(Text(index))\n    pieces.add(\"\\n\")\n    index = index + 1\n}\nlet filler: List<Text> = []\nindex = 0\nwhile index < 70000 {\n    filler.add(\"abcde\")\n    index = index + 1\n}\npieces.add(joinText(filler))\npieces.add(\"end\")\nio.writeTextParts(processInfo.argument(0), pieces)\nlet written = io.readTextFile(processInfo.argument(0))\nprint(written == joinText(pieces))\nprint(written.byteLength)\n","true\n" + oracle.decimal(Bytes(expected).length) + "\n",0,"",[path],[evidence.FileOutput { path:path; contents:Bytes(expected) }])
    let source = "let pieces: List<Text> = []\npieces.add(\"x\")\nio.writeTextParts(processInfo.argument(0), pieces)\n"
    let result = evidence.compile(context,source); evidence.expect(context,result.status == 0,result.errorOutput)
    evidence.expect(context,test.contains(io.readTextFile(evidence.llvm(context)),"call void @minyar_runtime_writeTextPart("), "parts write bypassed buffered library operation")
    let executable = evidence.llvm(context) + ".exe"; evidence.link(context,evidence.llvm(context),"-O2",executable,30)
    let observed = evidence.run(context,[executable,context.path],"execute",context.compiler.runTimeout,false)
    evidence.expect(context,observed.status == 1 && test.contains(observed.errorOutput,"could not be created"), "parts write failure not reported")
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_consuming_self_assignment_respects_parameters_and_later_reads") {
    let context = evidence.context("regression", "Regressions.test_consuming_self_assignment_respects_parameters_and_later_reads", "tests/regressions.min")
    evidence.executes(context, "function growText(t: Text): Integer {\n    t = t + \"zz\"\n    return t.length\n}\nfunction growList(xs: List<Integer>): Integer {\n    xs = xs.appended(99)\n    return xs.length\n}\nfunction growInLoop(xs: List<Integer>): Integer {\n    let count = 0\n    while count < 3 {\n        xs = xs.appended(count)\n        count = count + 1\n    }\n    return xs.length\n}\nlet text = \"ab\" + \"cd\"\nprint(growText(text))\nprint(text)\nlet numbers = [1, 2, 3]\nprint(growList(numbers))\nprint(numbers.length)\nprint(numbers[0])\nprint(growInLoop(numbers))\nprint(numbers.length)\nprint(growList([4, 5]))\nlet repeated = \"a\" + \"b\"\nrepeated = repeated + \"!\" + repeated\nprint(repeated)\nlet values = [10, 20]\nvalues = values.appended(1).appended(values.length)\nprint(values[3])\n", "6\nabcd\n4\n3\n1\n6\n3\n3\nab!ab\n2\n", 0, "", [], [])
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_invalid_arithmetic_and_ordering") {
    let context = evidence.context("regression", "Regressions.test_invalid_arithmetic_and_ordering", "tests/regressions.min")
    for operator in ["+","-","*","/","%"] {
        for value in ["true","'a'","\"text\""] {
            if operator == "+" && value == "\"text\"" { continue }
            evidence.rejects(context,"print(" + value + " " + operator + " " + value + ")\n","needs Integer or Float operands")
        }
    }
    for value in ["[1]","Bytes(1)"] { evidence.rejects(context,"print(" + value + " < " + value + ")\n","ordered comparison needs two Ordered values") }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_valid_operators") {
    let context = evidence.context("regression", "Regressions.test_valid_operators", "tests/regressions.min")
    evidence.executes(context, "print(7 + 5)\nprint(7 - 5)\nprint(7 * 5)\nprint(7 / 5)\nprint(7 % 5)\nprint(true == false)\nprint(\"x\" == \"x\")\nprint('a' < 'b')\nprint(\"a\" + \"b\")\n", "12\n2\n35\n1\n2\nfalse\ntrue\ntrue\nab\n", 0, "", [], [])
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_builtin_arity") {
    let context = evidence.context("regression", "Regressions.test_builtin_arity", "tests/regressions.min")
    let names = ["print","Text","fail","exit","joinText","processInfo.argumentCount","processInfo.argument","io.readTextFile","io.writeTextFile"]
    let arguments = [data.strings(["","1, 2"]),data.strings(["","1, 2"]),data.strings(["","\"x\", \"y\""]),data.strings(["","0, 1"]),data.strings(["","[], []"]),data.strings(["0"]),data.strings(["","0, 1"]),data.strings(["","\"a\", \"b\""]),data.strings(["","\"a\"","\"a\", \"b\", \"c\""])]
    for index in 0..names.length {
        let selectors = names[index].split(".")
        let readable = selectors[selectors.length - 1]
        for argument in arguments[index].items { evidence.rejects(context,names[index] + "(" + argument.text + ")\n",readable + " expects") }
    }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_builtin_types") {
    let context = evidence.context("regression", "Regressions.test_builtin_types", "tests/regressions.min")
    for expression in ["fail(1)","exit(\"x\")","processInfo.argument(true)","io.readTextFile(42)","io.writeTextFile(\"x\", 1)","io.writeTextFile(1, \"x\")","io.writeTextParts(\"x\", [1, 2])","joinText(\"x\")","Text([])","print([])"] {
        let diagnostic = "expects"
        if expression.startsWith("io.") || expression.startsWith("processInfo.") { diagnostic = "wrong type" }
        if expression.startsWith("io.writeTextParts") { diagnostic = "all values in a List literal must have the same type" }
        evidence.rejects(context,expression + "\n",diagnostic)
    }
    evidence.close(context, false)
}
if port.selected(selectors, "Regressions", "test_nonvalues_and_index_types") {
    let context = evidence.context("regression", "Regressions.test_nonvalues_and_index_types", "tests/regressions.min")
    evidence.rejects(context, "let value = print(42)\n", "Nothing cannot be stored")
    evidence.rejects(context, "let values: List<Integer> = []\nvalues.add(1)\nvalues[true] = 2\n", "a position must be an Integer")
    evidence.rejects(context, "let value = 42\nprint(value[0])\n", "indexing needs Text, a List, or Bytes")
    evidence.close(context, false)
}
print("release regression controls passed")
