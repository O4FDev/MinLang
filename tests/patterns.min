use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.validate("Patterns", ["nested", "literals", "literal_edges", "guards", "coverage", "contextual", "ownership", "missing", "rejections", "gallery"])

if fixtures.selected("Patterns", "nested") {
    fixtures.executes(frontend, io.readTextFile("tests/patterns/nested.min"), "moonlight\npaper\nfolded\nstarlight\nbranch\nempty\nanswer\n7\nabsent\nclosed\nbroken\n42\ndone\nwhole\n", levels, 0, "", true)
}
if fixtures.selected("Patterns", "literals") {
    fixtures.executes(frontend, io.readTextFile("tests/patterns/literals.min"), "negative\nzero\nanswer\ninteger\nbelow\nstill\nabove\nfloat\nyes\nno\naccent\nsmile\nnewline\ncharacter\nempty\nlight\nunicode\npunctuation\nescaped\ntext\nnested integer\nnested float\nnested Boolean\nnested Character\nnested Text\nother\nstatement\n42\n", levels, 0, "", true)
}
if fixtures.selected("Patterns", "literal_edges") {
    fixtures.executes(frontend, io.readTextFile("tests/patterns/token-edges.min"), "Text true\nText false\nText minus\nText None\nText else\nText where\nText other\nnested true\nnested false\nnested minus\nnested None\nnested else\nnested where\nnested other\nabsent\nCharacter minus\nCharacter brace\nCharacter close\nCharacter other\nnested Character minus\nnested Character brace\nnested Character close\nInteger negative zero\nInteger hexadecimal zero\nInteger octal one\nFloat negative zero\nFloat exponent zero\nFloat leading one\nnested Integer zero\nnested Float zero\nminimum Integer\nnested minimum Integer\n42\n42\nuppercase\n", levels, 0, "", true)
    fixtures.rejects(frontend, "match 0 { 0x0 {} }\n", "for example: 1", true)
    fixtures.rejects(frontend, "match 0.0 { 0.0e0 {} }\n", "for example: 1.0", true)
    fixtures.rejects(frontend, "match Some(1) { Some value {} None {} }\n", "expected '('", true)
    fixtures.rejects(frontend, "match Some(Some(1)) { Some(Some(value) {} _ {} }\n", "expected ')'", true)
    fixtures.rejects(frontend, "match Some(1) { Some(", "error:", true)
    fixtures.rejects(frontend, "match Some(1) { Some(value", "expected ')'", true)
    fixtures.rejects(frontend, "match 0 { -", "error:", true)
    fixtures.rejects(frontend, "match Some(1) { Some(value) {", "error:", true)
}
if fixtures.selected("Patterns", "guards") {
    fixtures.executes(frontend, io.readTextFile("tests/patterns/guards.min"), "seven\n1\n1\nfirst\n2\n2\nbelow zero\n42\nunguarded\n5\nzero\npositive\nnegative\nabsent\n", levels, 0, "", true)
}
if fixtures.selected("Patterns", "coverage") {
    fixtures.executes(frontend, io.readTextFile("tests/patterns/coverage.min"), "0\n1\n2\n3\n4\n0\n1\n2\n3\n10\n11\n12\n13\n14\n0\n1\n2\n", levels, 0, "", true)
}
if fixtures.selected("Patterns", "contextual") {
    fixtures.executes(frontend, io.readTextFile("tests/patterns/contextual.min"), "20 moon\nboth waiting\n42\n42\n20\n22\n42\n42\n42\n", levels, 0, "", true)
}
if fixtures.selected("Patterns", "ownership") {
    fixtures.executes(frontend, io.readTextFile("tests/patterns/ownership.min"), "kept\nkept\nkept\nfrom guard\nafter false guard\nreturned\ncaptured\nresult kept\nclean\n", levels, 0, "", true)
}

if fixtures.selected("Patterns", "missing") {
    fixtures.rejects(frontend, #"""
        let value: Maybe<Maybe<Integer>> = Some(Some(1))
        match value { Some(Some(_)) {} None {} }
        """#, "for example: Some(None)", true)
    fixtures.rejects(frontend, #"""
        let value: Maybe<Boolean> = Some(true)
        match value { Some(true) {} None {} }
        """#, "for example: Some(false)", true)
    fixtures.rejects(frontend, #"""
        let value: Maybe<Integer> = Some(1)
        match value { Some(number) where number > 0 {} None {} }
        """#, "match is missing cases:", true)
    fixtures.rejects(frontend, #"""
        let value: Maybe<Boolean> = Some(true)
        match value { Some(true) where true {} Some(false) {} None {} }
        """#, "for example: Some(true)", true)
    fixtures.rejects(frontend, #"""
        choice Pair { Both(left: Boolean, right: Boolean) }
        match Both(true, true) { Both(false, _) {} Both(true, false) {} }
        """#, "for example: Both(true, true)", true)
    fixtures.rejects(frontend, #"""
        let value: Result<Maybe<Boolean>, Text> = Ok(Some(true))
        match value { Ok(Some(true)) {} Ok(None) {} Err(_) {} }
        """#, "for example: Ok(Some(false))", true)
    fixtures.rejects(frontend, "match 42 { 42 {} }\n", "missing", true)
    fixtures.rejects(frontend, "match true { true {} }\n", "for example: false", true)
}

if fixtures.selected("Patterns", "rejections") {
    fixtures.rejects(frontend, "match Some(42) { Some(\"wrong\") {} None {} }\n", "pattern has the wrong type", true)
    fixtures.rejects(frontend, "match Some(42) { Some(true) {} None {} }\n", "pattern has the wrong type", true)
    fixtures.rejects(frontend, "match Some(42) { Some(1.0) {} None {} }\n", "pattern has the wrong type", true)
    fixtures.rejects(frontend, "match Some(42) { Some('x') {} None {} }\n", "pattern has the wrong type", true)
    fixtures.rejects(frontend, "match true { 1 {} _ {} }\n", "pattern has the wrong type", true)
    fixtures.rejects(frontend, "match Some(42) { Some(number) where number {} _ {} }\n", "match guard must be Boolean", true)
    fixtures.rejects(frontend, #"""
        choice Pair { Both(left: Maybe<Integer>, right: Maybe<Integer>) }
        match Both(Some(1), Some(2)) { Both(Some(number), Some(number)) {} _ {} }
        """#, "duplicate pattern binding", true)
    fixtures.rejects(frontend, "match Some(Some(42)) { Some(Unknown(_)) {} _ {} }\n", "unknown case", true)
    fixtures.rejects(frontend, "match Some(Some(42)) { Some(Some()) {} _ {} }\n", "pattern", true)
    fixtures.rejects(frontend, "match Some(42) { Some(number, extra) {} _ {} }\n", "expected ')'", true)
    fixtures.rejects(frontend, "match Some(Some(42)) { Some(Some(number)) {} _ {} }\nprint(number)\n", "I can't find a value named 'number'", true)
    fixtures.rejects(frontend, "match Some(42) { Some(number) where number < 0 {} None {} _ { print(number) } }\n", "I can't find a value named 'number'", true)
    fixtures.rejects(frontend, "match 42 { else {} 42 {} }\n", "else must be the last match arm", true)
}

if fixtures.selected("Patterns", "gallery") {
    fixtures.executes(frontend, io.readTextFile("examples/gallery/patterns.min"), "the harbour keeps an amber light\na blue light answers the sea\na wick is waiting for a spark\na little warmth remembers the fire\nthe stars can take their turn\nan empty window, open to the moon\nwe will try again at dawn: the tide has taken the path\n", levels, 0, "", true)
}

test.removeTree(frontend.compiler.directory)
print("Patterns: passed")
