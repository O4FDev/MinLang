// Nested patterns compose with scalar, nullable and tagged choice layouts.
choice Tone { Low; High }
choice Bit { Present(value: Boolean); Absent }
choice Selected { Present(value: Tone); Absent }
choice Words { Present(value: Text); Absent }
choice Event { A(value: Integer); B(text: Text, flag: Boolean); C }

function toneName(value: Tone): Text {
    return match value { Low { "low" } High { "high" } }
}
function bitName(value: Bit): Text {
    return match value {
        Present(true) { "bit true" }
        Present(false) { "bit false" }
        Absent { "bit absent" }
    }
}
function selectedName(value: Selected): Text {
    return match value {
        Present(Low) { "selected low" }
        Present(High) { "selected high" }
        Absent { "not selected" }
    }
}
function rejectText(text: Text): Boolean {
    let temporary = text + " guard"
    return temporary.length == 0
}
function wordName(value: Words): Text {
    return match value {
        Present("") { "empty text" }
        Present(text) where rejectText(text) { "unexpected guard" }
        Present(text) { text }
        Absent { "no words" }
    }
}
function eventName(value: Event): Text {
    return match value {
        A(0) { "a zero" }
        A(number) { "a " + Text(number) }
        B("x", true) { "x true" }
        B(text, false) { "false " + text }
        B(text, true) { text }
        C { "c" }
    }
}
function listName(value: Maybe<Maybe<List<Integer>>>): Text {
    return match value {
        None { "outer none" }
        Some(None) { "inner none" }
        Some(Some(values)) where values.length == 0 { "empty list" }
        Some(Some(values)) { "list " + Text(values.length) }
    }
}

print("enum")
for value in [Tone.Low, Tone.High] { print(toneName(value)) }
print("boolean")
let bits: List<Bit> = [Bit.Present(true), Bit.Present(false), Bit.Absent]
for value in bits { print(bitName(value)) }
print("selected")
let selected: List<Selected> = [Selected.Present(Low), Selected.Present(High), Selected.Absent]
for value in selected { print(selectedName(value)) }
print("words")
print(wordName(Words.Present(""))); print(wordName(Words.Absent))
let words = wordName(Words.Present("retained" + " words"))
let event = eventName(Event.B("retained" + " event", true))
for index in 0..32 {
    let noise = Bytes("padding" + Text(index))
    if noise.length < 7 { fail("short allocation churn") }
}
print(words)
print("events")
let events: List<Event> = [Event.A(0), Event.A(7), Event.B("x", true), Event.B("x", false), Event.C]
for value in events { print(eventName(value)) }
print(event)
print("nullable lists")
let values: List<Maybe<Maybe<List<Integer>>>> = [None, Some(None<List<Integer>>()), Some(Some<List<Integer>>([])), Some(Some([7, 9]))]
for value in values { print(listName(value)) }
