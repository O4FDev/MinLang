// Fork-join and nested loops on the work-stealing pool (PAR-2): exact results at
// O0/O2 with ownership contracts, and the rejections that keep joins race-free.
use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.executes(frontend, io.readTextFile("tests/parallel-join/fork-join.min"), "196418\n59998899993\n59998899993\n200\n3141592\ntrue\n2182048\n75030\n", levels, 0, "", true)
print("fork-join: passed")

let pure = "parallel function one(n: Integer): Integer { return n }\n"
fixtures.rejects(frontend, pure + "function plain(n: Integer): Integer { return n }\nlet a, b = join(one(1), plain(2))\n", "join runs parallel functions; 'plain' is not a parallel function", true)
fixtures.rejects(frontend, pure + "parallel function many(n: Integer): Integer { return n }\nlet a, b = join(one(1), many(1, 2))\n", "'many' expects 1 arguments", true)
fixtures.rejects(frontend, pure + "parallel function flag(n: Integer) {}\nlet a, b = join(one(1), flag(2))\n", "join needs 'flag' to return Integer, Float, Boolean or Character", true)
fixtures.rejects(frontend, pure + "let a, b = join(one(1), 7)\n", "join runs two calls of parallel functions", true)
// Both branches may read a buffer, so a branch that writes it is rejected.
fixtures.rejects(frontend, pure + "parallel function scribble(data: Bytes): Integer {\n    data[0] = 1\n    return 0\n}\nlet data = Bytes(4)\nlet a, b = join(one(1), scribble(data))\n", "", true)
// Branches stay pure, as loop bodies do.
fixtures.rejects(frontend, "use \"machine\" as machine\nparallel function raw(n: Integer): Integer { return machine.load64(n) }\n" + pure + "let a, b = join(one(1), raw(8))\n", "'load64' must be a pure parallel function", true)
fixtures.rejects(frontend, "let a = minyar_join_second()\n", "join results are bound by let left, right = join(...)", true)
print("join rejections: passed")
test.removeTree(frontend.compiler.directory)
print("Parallel join: passed")
