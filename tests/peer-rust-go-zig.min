function diagnosticVectors(c: peer.Case, name: Text, count: Integer) {
    let fixture = c.suite.root + "/tests/" + name
    requireInput(c, fixture)
    let vectors = peer.load(fixture).items
    peer.equalInteger(c, vectors.length, count, name + " vector count")
    let ids: List<Text> = []
    for row in vectors { ids.add(peer.textField(row, "id")) }
    peer.equalInteger(c, distinctTexts(ids), count, name + " distinct ids")
    for row in vectors {
        rejectsExactly(c, peer.textField(row, "source"), peer.textField(row, "diagnostic"), peer.textField(row, "id"))
    }
}
