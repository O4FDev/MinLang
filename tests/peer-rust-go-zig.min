    expected.add(1024)
    expected.add(value.length)
    for byte in upper { expected.add(byte) }
    expected.add(value.length)
    expected.add(value.length)
    for byte in upper { expected.add(byte) }
    let pairs = lower.length
    if upper.length < pairs { pairs = upper.length }
    if value.length < pairs { pairs = value.length }
    for index in 0..pairs {
        expected.add(lower[index])
        expected.add(upper[index])
        expected.add(value[index])
    }
    expected.add(88)
    expected.add(89)
    peer.executes(c, source, peer.integers(expected))
}
