}
function test_deferred_primary_name_type_and_token_diagnostics(c: peer.Case) {
    let bom = peer.character(65279)
    let nul = peer.character(0)
    let sources = ["let x: Iter = 0\n", "while false {} else {}\n", "record Foo { a: Integer }\nfunction lol(b: Foo) { b.c }\n",
        "function main() { asdf }\n", "\n" + bom + " //BOM\n", "let foo: Character = '\\U1234'\n", "function foo(): boid {}\n",
        "return 1\n", "function a() { b() }\n", "print(-'a')\n",
        "record Value { boolean: Boolean; number: Integer }\nlet value: Boolean = Value { boolean: true; number: 123 }\n",
        "record Value { value: Boolean }\nlet value = Value { value: truefalse }\n", "let A = B\n",
        "let derp = 1234\nprint(derp + \"foo\")\n", "function dummy(value: Integer) {}\ndummy([1, 2])\n",
        "let cstr = \"Hat\"\ncstr[0] = 'W'\n", "let x = 0\nx = " + nul + "Q\n"]
    let diagnostics = ["line 1, column 8: unknown type 'Iter'", "line 1, column 16: unexpected 'else'; start the next statement on a new line",
        "record 'Foo' has no field named 'c'", "line 1, column 19: I can't find a value named 'asdf'",
        "line 2, column 1: names must use ASCII letters, digits, and '_'; found non-ASCII character '" + bom + "'",
        "line 1, column 22: Character literal must contain exactly one character and a closing quote", "line 1, column 17: unknown type 'boid'",
        "line 1, column 1: use exit(status) to finish a top-level program", "line 1, column 16: I can't find a function named 'b'",
        "line 1, column 11: negation needs an Integer or Float", "line 2, column 5: the value for 'value' does not match its declared type",
        "line 2, column 28: I can't find a value named 'truefalse'", "line 1, column 9: I can't find a value named 'B'",
        "line 2, column 12: the two sides of '+' have different types (Integer and Text)", "line 2, column 14: an argument passed to dummy has the wrong type",
        "line 2, column 5: indexed assignment needs a List or Bytes, not Text", "line 2, column 5: expected an expression, found '" + nul + "'"]
    peer.equalInteger(c, sources.length, diagnostics.length, "diagnostic case table")
    for index in 0..sources.length {
        rejectsExactly(c, sources[index], "Minyar stopped: " + diagnostics[index] + "\n", "diagnostic case " + Text(index))
    }
}
