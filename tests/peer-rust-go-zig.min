function equalTexts(c: peer.Case, actual: List<Text>, expected: List<Text>, label: Text) {
    peer.equalInteger(c, actual.length, expected.length, label + " length")
    for index in 0..expected.length { peer.equal(c, actual[index], expected[index], label + " item " + Text(index)) }
}
function equalIntegers(c: peer.Case, actual: List<Integer>, expected: List<Integer>, label: Text) {
    peer.equalInteger(c, actual.length, expected.length, label + " length")
    for index in 0..expected.length { peer.equalInteger(c, actual[index], expected[index], label + " item " + Text(index)) }
}
function distinctTexts(values: List<Text>): Integer {
    let seen = Map<Text, Boolean>()
    for value in values { seen[value] = true }
    return seen.length
}
function reversedBytes(c: peer.Case, value: Integer, width: Integer): Integer {
    peer.expect(c, value >= 0 && width >= 0 && width <= 8, "int.to_bytes cannot encode " + Text(value) + " in " + Text(width) + " bytes")
    if width < 8 { peer.expect(c, value >> (8 * width) == 0, "int.to_bytes value exceeds its byte width") }
    let result = 0
    for index in 0..width { result = result * 256 + ((value >> (8 * index)) & 255) }
    return result
}
function bitCount(value: Integer): Integer {
    let rest = value
    if rest < 0 { rest = -rest }
    let count = 0
    while rest > 0 {
        count += rest & 1
        rest = rest >> 1
    }
    return count
}
function test_positive_byte_reversal_population_and_checked_arithmetic(c: peer.Case) {
    let fixture = c.suite.root + "/tests/peer-rgz-integer-vectors.json"
    requireInput(c, fixture)
    let groups = peer.load(fixture).items
    peer.equalInteger(c, groups.length, 3, "integer vector groups")
    let targets: List<Text> = []
    let counts: List<Integer> = []
    for group in groups {
        targets.add(peer.textField(group, "target"))
        counts.add(json.member(group, "vectors").items.length)
    }
    equalTexts(c, targets, ["test/behavior/byteswap.zig", "test/behavior/popcount.zig", "test/behavior/wrapping_arithmetic.zig"], "integer vector targets")
    equalIntegers(c, counts, [6, 5, 25], "integer vector counts")
    let source = "function reverse(value: Integer, width: Integer): Integer {
let remaining = value
let result = 0
let i = 0
while i < width { result = result * 256 + remaining % 256; remaining = remaining / 256; i = i + 1 }
return result
}
function population(value: Integer): Integer {
let n = value
let count = 0
while n > 0 { count = count + n % 2; n = n / 2 }
return count
}
function add(a: Integer, b: Integer): Integer { return a + b }
function subtract(a: Integer, b: Integer): Integer { return a - b }
function multiply(a: Integer, b: Integer): Integer { return a * b }
"
    let expected: List<Integer> = []
    for vector in json.member(groups[0], "vectors").items {
        let value = peer.field(vector, "value")
        let width = peer.field(vector, "bytes")
        let oracle = reversedBytes(c, value, width)
        peer.equalInteger(c, oracle, peer.field(vector, "expected"), "byte reversal oracle")
        source += "print(reverse(" + Text(value) + ", " + Text(width) + "))\n"
        expected.add(oracle)
    }
    for vector in json.member(groups[1], "vectors").items {
        let value = peer.field(vector, "value")
        let oracle = bitCount(value)
        peer.equalInteger(c, oracle, peer.field(vector, "expected"), "population oracle")
        source += "print(population(" + Text(value) + "))\n"
        expected.add(oracle)
    }
    let vectors = json.member(groups[2], "vectors").items
    for index in 0..vectors.length {
        let vector = vectors[index]
        let a = peer.field(vector, "left")
        let b = peer.field(vector, "right")
        let symbol = peer.textField(vector, "operator")
        let oracle = 0
        let name = ""
        if symbol == "+" { oracle = a + b; name = "add" }
        else if symbol == "-" { oracle = a - b; name = "subtract" }
        else if symbol == "*" { oracle = a * b; name = "multiply" }
        else { peer.expect(c, false, "unknown wrapping operator " + symbol) }
        peer.equalInteger(c, oracle, peer.field(vector, "expected"), "wrapping arithmetic oracle " + Text(index))
        let tag = Text(index)
        source += "print(" + name + "(" + Text(a) + ", " + Text(b) + "))\nlet v" + tag + " = " + Text(a) + "\nv" + tag + " = v" + tag + " " + symbol + " (" + Text(b) + ")\nprint(v" + tag + ")\n"
        expected.add(oracle)
        expected.add(oracle)
    }
    peer.executes(c, source, peer.integers(expected))
}
