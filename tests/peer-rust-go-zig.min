function test_empty_program_links_without_elf_text_relocations(c: peer.Case) {
    if !peer.linux() {
        peer.skip(c, "ELF -z text linker contract requires Linux")
        return
    }
    let compiled = peer.compile(c, "")
    peer.observe(c, compiled.result, 0, "", "", "empty program compilation")
    for optimization in c.variants {
        let executable = peer.executable(compiled.base, optimization)
        let linked = peer.run(c, clangCommand(clangWith(c, [optimization], ["-Wno-override-module", "-Wl,-z,text", compiled.llvm, c.compiler.runtime, "-o", executable])), "link-elf-z-text", 30)
        requireSuccess(c, linked, "ELF -z text link at " + optimization)
        peer.observe(c, peer.run(c, [executable], "execute-elf-z-text", 30), 0, "", "", "empty program at " + optimization)
    }
}
function fieldValue(pairs: List<Integer>, key: Integer): Integer {
    let index = 0
    while index + 1 < pairs.length {
        if pairs[index] == key { return pairs[index + 1] }
        index += 2
    }
    return 0
}
