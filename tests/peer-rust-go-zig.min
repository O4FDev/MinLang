function zigDomain(c: peer.Case): json.Value {
    let artifact = c.suite.root + "/tests/data/peer/zig/log-int-generated-domain.json"
    let schema = c.suite.root + "/tools/peer-audit.min"
    requireInput(c, artifact)
    requireInput(c, schema)
    return peer.load(artifact)
}
function zigCohorts(c: peer.Case, domain: json.Value): audit.Cohorts {
    let cohorts = audit.zigValidateDomain(audit.newDomains(), domain)
    peer.expect(c, cohorts.error == "", cohorts.error)
    return cohorts
}
function cohortNamed(cohorts: audit.Cohorts, name: Text): json.Value {
    for index in 0..cohorts.ids.length { if cohorts.ids[index] == name { return cohorts.cohorts[index] } }
    fail("unknown Zig log cohort " + name)
}
function branchNumber(name: Text): Integer {
    if name == "one" { return 0 }
    if name == "below" { return 1 }
    if name == "at" { return 2 }
    fail("unknown Zig log branch " + name)
}
function test_log_integer_generated_boundary_domain(c: peer.Case) {
    let domain = zigDomain(c)
    let cohorts = zigCohorts(c, domain)
    let expected: List<Text> = []
    for instance in audit.zigInstances() {
        if instance.cohort != "boundary-representable" { continue }
        let parts = splitText(instance.identity, "/")
        let bits = Integer(removePrefix(parts[0], "bits"))
        let last = parts[parts.length - 1]
        let exponent = 0
        if last != "one" { exponent = Integer(removePrefix(parts[2], "power")) }
        let branch = branchNumber(last)
        expected.add(Text(bits) + "\n" + Text(instance.base) + "\n" + Text(exponent) + "\n" + Text(branch) + "\n" + audit.u64Text(instance.value) + "\n" + Text(instance.expected) + "\n")
    }
    peer.equalInteger(c, expected.length, 514804, "boundary-representable instances")
    let control = peer.jsonObject()
    peer.put(control, "domain_id", json.member(domain, "domain_id"))
    peer.put(control, "cohort", peer.jsonText("boundary-representable"))
    peer.put(control, "instances_per_configuration", peer.jsonInteger(expected.length))
    peer.put(control, "oracle_sha256", json.member(cohortNamed(cohorts, "boundary-representable"), "oracle_sha256"))
    peer.control(c, "source_domain", control)
    let rejected = peer.jsonObject()
    peer.put(rejected, "domain", peer.jsonText("boundary-outside-integer"))
    peer.put(rejected, "instances_per_configuration", peer.jsonInteger(210))
    peer.put(rejected, "reason", peer.jsonText("Pinned unsigned64 source inputs exceed signed64 Integer; separately rejected cohort with exact input/oracle hashes"))
    peer.put(control, "separately_rejected_cohorts", peer.jsonArray([rejected]))
    // This exhaustive correctness fixture prints six lines for each of 514,804 inputs.
    let previous = c.runTimeout
    c.runTimeout = 180
    peer.executes(c, "function logarithm(base: Integer, value: Integer): Integer {
let n = value; let exponent = 0
while n >= base { n = n / base; exponent = exponent + 1 }
return exponent
}
function observe(bits: Integer, base: Integer, exponent: Integer, branch: Integer, value: Integer) {
print(bits); print(base); print(exponent); print(branch); print(value); print(logarithm(base, value))
}
let bits = 2; let maximum = 3
while bits <= 64 {
let base = 2
while base <= maximum && base <= 1025 {
observe(bits, base, 0, 0, 1)
let power = 1; let exponent = 0
while power <= maximum / base {
power = power * base; exponent = exponent + 1
observe(bits, base, exponent, 1, power - 1); observe(bits, base, exponent, 2, power)
}
// Four source powers equal 2^63. Their predecessors remain representable;
// their at-power cases belong to the explicit 210-case rejected cohort.
if bits == 64 && (base == 2 || base == 8 || base == 128 || base == 512) {
observe(bits, base, exponent + 1, 1, 9223372036854775807)
}
base = base + 1
}
if bits < 63 { maximum = maximum * 2 + 1 }
bits = bits + 1
}
", joinText(expected))
    c.runTimeout = previous
}
function test_log_integer_generated_specialized_comparison_domains(c: peer.Case) {
