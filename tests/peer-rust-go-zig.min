function test_sort_nonzero_subrange_preserves_outside_cells(c: peer.Case) {
    peer.executes(c, "function get(values: List<Integer>, i: Integer, start: Integer, end: Integer): Integer {
if i < start || i >= end { fail(\"sort read escaped range\") }
return values[i]
}
function put(values: List<Integer>, i: Integer, value: Integer, start: Integer, end: Integer) {
if i < start || i >= end { fail(\"sort write escaped range\") }
values[i] = value
}
function sort(values: List<Integer>, start: Integer, end: Integer) {
let i = start + 1
while i < end {
let value = get(values, i, start, end)
let j = i
while j > start && get(values, j - 1, start, end) > value {
put(values, j, get(values, j - 1, start, end), start, end)
j = j - 1
}
put(values, j, value, start, end)
i = i + 1
}
}
let values: List<Integer> = []
let i = 0
while i < 2000 { values.add((i * 7) % 100); i = i + 1 }
sort(values, 1118, 1764)
i = 0
while i < values.length { print(values[i]); i = i + 1 }
", peer.integers(sortedSubrangeOracle()))
}
function sortedSubrangeOracle(): List<Integer> {
    let values: List<Integer> = []
    for i in 0..2000 { values.add(peer.modulo(i * 7, 100)) }
    let middle: List<Integer> = []
    for index in 1118..1764 { middle.add(values[index]) }
    let ordered = peer.sortIntegers(middle)
    for index in 0..ordered.length { values[1118 + index] = ordered[index] }
    return values
}
