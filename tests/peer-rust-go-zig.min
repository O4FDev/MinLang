function test_dynamic_text_literal_and_pair_dispatch(c: peer.Case) {
    let source = "function fresh(value: Text): Text { return (\"x\" + value).slice(1, value.length + 1) }
function one(value: Text, capture: Boolean): Text {
if value == \"a\" { return \"found a\" }
if value == \"b\" { return \"found b\" }
if capture { return \"not found (\" + value + \")\" }
return \"not found\"
}
function pair(first: Text, second: Text, capture: Boolean): Text {
if first == \"a\" && second == \"b\" { return \"found a,b\" }
if first == \"b\" && second == \"c\" { return \"found b,c\" }
if capture { return \"not found (\" + first + \", \" + second + \")\" }
return \"not found\"
}
"
    let expected: List<Text> = []
    for capture in [false, true] {
        for value in ["b", "c", "d"] {
            source += "print(one(fresh(\"" + value + "\"), " + peer.boolean(capture) + "))\n"
            if value == "b" { expected.add("found b") } else if capture { expected.add("not found (" + value + ")") } else { expected.add("not found") }
        }
    }
    let firsts = ["b", "c", "d"]
    let seconds = ["c", "d", "e"]
    for capture in [false, true] {
        for index in 0..firsts.length {
            let first = firsts[index]
            let second = seconds[index]
            source += "print(pair(fresh(\"" + first + "\"), fresh(\"" + second + "\"), " + peer.boolean(capture) + "))\n"
            if first == "b" { expected.add("found b,c") } else if capture { expected.add("not found (" + first + ", " + second + ")") } else { expected.add("not found") }
        }
    }
    peer.equalInteger(c, expected.length, 12, "dispatch oracle count")
    peer.executes(c, source, peer.joined(expected, "\n") + "\n")
}
function integerSquareRoot(value: Integer): Integer {
    let root = 0
    while (root + 1) * (root + 1) <= value { root += 1 }
    return root
}
