function test_truncated_utf8_source_and_invalid_import_paths(c: peer.Case) {
    let contents = Bytes("function f() {")
    contents.add(239)
    contents.add(239)
    let malformed = peer.writeBytes(c, "rgz-invalid-utf8.min", contents)
    let output = peer.path(c, "rgz-invalid-utf8.ll")
    let result = peer.run(c, [c.compiler.executable, malformed, output, "--library", "library"], "compile-invalid-utf8", c.compiler.compileTimeout)
    peer.equalInteger(c, result.status, 1, "truncated UTF-8 compiler status")
    peer.equal(c, result.output, "", "truncated UTF-8 compiler output")
    peer.expect(c, peer.contains(result.errorOutput, "invalid UTF-8"), "truncated UTF-8 diagnostic missing: " + result.errorOutput)
    peer.expect(c, absent(output), "truncated UTF-8 source left LLVM output behind")
    peer.writeFile(c, "rgz-valid.min", "public function get(): Integer { return 42 }\n")
    let nulSource = "use \"./rgz-valid.min" + peer.character(0) + "suffix\" as valid\nprint(valid.get())\n"
    let names = ["empty", "nul"]
    let sources = ["use \"\" as empty\n", nulSource]
    let diagnostics = ["Minyar stopped: the file 'library/.min' could not be opened.\n", "Minyar stopped: a file path cannot contain a zero byte.\n"]
    for index in 0..names.length { rejectsExactly(c, sources[index], diagnostics[index], "import path " + names[index]) }
    let shim = makeShim(c, "rgz-driver-tools")
    requireInput(c, shim)
    requireInput(c, c.suite.root + "/minyar")
    let environment = peer.withEnvironment(c.environment, "PATH", peer.path(c, "rgz-driver-tools") + ":" + system.getenv("PATH"))
    let driverDiagnostics = ["Minyar stopped: the file '" + c.suite.root + "/library/.min' could not be opened.\n", "Minyar stopped: a file path cannot contain a zero byte.\n"]
    for index in 0..names.length {
        let path = peer.writeFile(c, "rgz-driver-" + names[index] + ".min", sources[index])
        let executable = peer.path(c, "rgz-driver-" + names[index])
        let driven = peer.launch(c, [c.suite.root + "/minyar", path, "-o", executable], "driver-invalid-import-existing-artifacts", 30, environment, "", "")
        peer.observe(c, driven, 1, "", driverDiagnostics[index], "driver import path " + names[index])
        peer.expect(c, absent(executable), "driver import path " + names[index] + " produced an executable")
    }
}
