        if instance.cohort != "log2-comparison" && instance.cohort != "log10-comparison" { continue }
        let bits = Integer(removePrefix(splitText(instance.identity, "/")[0], "bits"))
        let result = Text(instance.expected)
        expected.add(Text(bits) + "\n" + Text(instance.base) + "\n" + audit.u64Text(instance.value) + "\n" + result + "\n" + result + "\n")
    }
    peer.equalInteger(c, expected.length, 65815 + 65899, "comparison instances")
    let selected = peer.jsonObject()
    for name in ["log2-comparison", "log10-comparison"] {
        let cohort = cohortNamed(cohorts, name)
        let summary = peer.jsonObject()
        for key in ["instances", "input_sha256", "oracle_sha256"] { peer.put(summary, key, json.member(cohort, key)) }
        peer.put(selected, name, summary)
