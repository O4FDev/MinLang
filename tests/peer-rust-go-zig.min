function byteValues(value: Text): List<Integer> {
    let result: List<Integer> = []
    for byte in Bytes(value) { result.add(byte) }
    return result
}
function asciiLowerBytes(data: Bytes): Bytes {
    let result = Bytes()
    for byte in data {
        if byte >= 65 && byte <= 90 { result.add(byte + 32) } else { result.add(byte) }
    }
    return result
}
function lastIndexOf(data: Bytes, value: Integer): Integer {
    let index = data.length - 1
    while index >= 0 {
        if data[index] == value { return index }
        index -= 1
    }
    return -1
}
