let i = count
while i > 0 { i = i - 1; values[destination + i] = values[origin + i] }
} else {
let i = 0
while i < count { values[destination + i] = values[origin + i]; i = i + 1 }
}
}
function show(values: List<Character>) {
let i = 0
while i < values.length { print(values[i]); i = i + 1 }
}
function buffer(count: Integer): List<Character> {
let values: List<Character> = []
let i = 0
while i < count { values.add('.'); i = i + 1 }
return values
}
let first = buffer(20)
let i = 0
while i < 20 { if i < 10 { first[i] = 'A' } else { first[i] = 'B' }; i = i + 1 }
show(first)
move(first, 10, 0, 10)
show(first)
let suffix = buffer(100)
suffix[95] = 'h'; suffix[96] = 'e'; suffix[97] = 'l'; suffix[98] = 'l'; suffix[99] = 'o'
show(suffix)
move(suffix, 92, 95, 5)
show(suffix)
move(suffix, 94, 92, 5)
show(suffix)
let small = buffer(8)
small[0] = 'h'; small[1] = 'e'; small[2] = 'l'; small[3] = 'l'; small[4] = 'o'
show(small)
move(small, 3, 0, 5)
show(small)
move(small, 2, 3, 5)
show(small)
"
    let states = [peer.repeat("A", 10) + peer.repeat("B", 10), peer.repeat("A", 20), peer.repeat(".", 95) + "hello",
        peer.repeat(".", 92) + "hellollo", peer.repeat(".", 92) + "hehelloo",
        "hello...", "helhello", "hehelloo"]
    let expected: List<Text> = []
    for state in states { for character in state { expected.add(Text(character) + "\n") } }
    peer.executes(c, source, joinText(expected))
}
function sortedPairs(bases: List<Integer>, exponents: List<Integer>): List<List<Integer>> {
    let result: List<List<Integer>> = []
    for index in 0..bases.length {
        let candidate = [bases[index], exponents[index]]
        let present = false
        for item in result { if item[0] == candidate[0] && item[1] == candidate[1] { present = true } }
        if present { continue }
        result.add(candidate)
        let position = result.length - 1
        while position > 0 && (result[position - 1][0] > result[position][0] || (result[position - 1][0] == result[position][0] && result[position - 1][1] > result[position][1])) {
            let previous = result[position - 1]
            result[position - 1] = result[position]
            result[position] = previous
            position -= 1
        }
    }
    return result
}
function test_checked_integer_power_source_vectors(c: peer.Case) {
    let fixture = c.suite.root + "/tests/peer-rgz-power-vectors.json"
    requireInput(c, fixture)
    let vectors = peer.load(fixture).items
    peer.equalInteger(c, vectors.length, 71, "power vector count")
    let ids: List<Text> = []
    for item in vectors { ids.add(peer.textField(item, "case_id")) }
    peer.equalInteger(c, distinctTexts(ids), 71, "distinct power case ids")
    let helper = "function power(base: Integer, exponent: Integer): Integer {
let result = 1
let factor = base
let remaining = exponent
while remaining > 0 {
if remaining % 2 == 1 { result = result * factor }
remaining = remaining / 2
if remaining > 0 { factor = factor * factor }
}
return result
}
"
    let source = helper
    let expected: List<Text> = []
    let overflowBases: List<Integer> = []
    let overflowExponents: List<Integer> = []
    for item in vectors {
        let parts = splitText(peer.textField(item, "case_id"), "/")
        peer.equalInteger(c, parts.length, 4, "power case id fields")
        let base = peer.field(item, "base")
        let exponent = peer.field(item, "exponent")
        peer.equalInteger(c, base, Integer(parts[2]), "power case base")
        peer.equalInteger(c, exponent, Integer(parts[3]), "power case exponent")
        peer.expect(c, exponent >= 0, "negative power exponent")
        let value = peer.big(1)
        for unused in 0..exponent { value = peer.bigMultiply(value, peer.big(base)) }
        if peer.bigFits(value) {
            source += "print(power(" + Text(base) + ", " + Text(exponent) + "))\n"
            expected.add(peer.bigText(value))
        } else {
            overflowBases.add(base)
            overflowExponents.add(exponent)
        }
    }
    let overflows = sortedPairs(overflowBases, overflowExponents)
    peer.equalInteger(c, expected.length, 56, "representable powers")
    peer.equalInteger(c, overflows.length, 15, "overflowing powers")
    peer.executes(c, source, peer.lines(expected))
    for pair in overflows {
        peer.executesStatus(c, helper + "print(power(" + Text(pair[0]) + ", " + Text(pair[1]) + "))\n", "", 1, peer.OVERFLOW)
    }
}
function isLeapYear(year: Integer): Boolean { return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) }
function civilFromDays(days: Integer): List<Integer> {
    let shifted = days + 719468
    let era = peer.floorDivide(shifted, 146097)
    let dayOfEra = shifted - era * 146097
    let yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    let year = yearOfEra + era * 400
    let dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    let shiftedMonth = (5 * dayOfYear + 2) / 153
    let day = dayOfYear - (153 * shiftedMonth + 2) / 5 + 1
    let month = shiftedMonth + 3
    if shiftedMonth >= 10 { month = shiftedMonth - 9 }
    if month <= 2 { year += 1 }
    return [year, month, day]
}
function ordinalDay(year: Integer, month: Integer, day: Integer): Integer {
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if isLeapYear(year) { lengths[1] = 29 }
    let total = day
    for index in 0..(month - 1) { total += lengths[index] }
    return total
}
function test_calendar_epoch_integer_decomposition(c: peer.Case) {
    let source = "record DateParts { year: Integer; yearDay: Integer; month: Integer; day: Integer; hour: Integer; minute: Integer; second: Integer }
function leap(year: Integer): Boolean { return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) }
function yearDays(year: Integer): Integer { if leap(year) { return 366 }; return 365 }
function monthDays(year: Integer, month: Integer): Integer {
if month == 2 { if leap(year) { return 29 }; return 28 }
if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
return 31
}
function decode(seconds: Integer): DateParts {
let days = seconds / 86400
let year = 1970
while days >= yearDays(year) { days = days - yearDays(year); year = year + 1 }
let yearDay = days
let month = 1
while days >= monthDays(year, month) { days = days - monthDays(year, month); month = month + 1 }
let time = seconds % 86400
return DateParts { year: year; yearDay: yearDay; month: month; day: days; hour: time / 3600; minute: (time % 3600) / 60; second: time % 60 }
}
function show(parts: DateParts) {
print(parts.year); print(parts.yearDay); print(parts.month); print(parts.day)
print(parts.hour); print(parts.minute); print(parts.second)
}
"
    let expected: List<Text> = []
    for year in [2095, 2096, 2100, 2400] {
        source += "print(leap(" + Text(year) + "))\n"
        expected.add(peer.boolean(isLeapYear(year)))
    }
    for seconds in [0, 31535999, 1622924906, 1625159473] {
        source += "show(decode(" + Text(seconds) + "))\n"
        let days = peer.floorDivide(seconds, 86400)
        let clock = seconds - days * 86400
        let date = civilFromDays(days)
        for value in [date[0], ordinalDay(date[0], date[1], date[2]) - 1, date[1], date[2] - 1, clock / 3600, clock % 3600 / 60, clock % 60] { expected.add(Text(value)) }
    }
    peer.executes(c, source, peer.joined(expected, "\n") + "\n")
}
