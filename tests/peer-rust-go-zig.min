function acceptsManagedGraph(c: peer.Case, source: Text) {
    let compiled = peer.compile(c, source)
    peer.expect(c, compiled.result.status == 0, "managed graph compilation failed\n" + compiled.result.errorOutput)
    peer.expect(c, !absent(compiled.llvm), "managed graph produced no LLVM")
    peer.expect(c, peer.contains(io.readTextFile(compiled.llvm), "; minyar-cycle-runtime: 1\n"), "managed graph LLVM lacks the cycle runtime marker")
}
function test_record_list_field_store_order_growth_and_types(c: peer.Case) {
    let source = "record Inner { values: List<Text> }
record Outer { child: Inner }
function index(trace: List<Text>): Integer { trace.add(\"I\"); return 1 }
function replacement(values: List<Text>, trace: List<Text>): Text {
trace.add(\"R\")
values[1] = \"temporary\" + Text(trace.length)
let i = 0
while i < 256 { values.add(\"item-\" + Text(i)); i = i + 1 }
return \"replacement-\" + Text(trace.length)
}
let outer = Outer { child: Inner { values: [\"left\", \"old-\" + Text(0)] } }
let alias = outer.child.values
let trace: List<Text> = []
outer.child.values[index(trace)] = replacement(alias, trace)
print(joinText(trace))
print(alias.length)
print(outer.child.values.length)
let i = 0
while i < alias.length { print(alias[i]); print(outer.child.values[i]); i = i + 1 }
"
    let values = ["left", "replacement-2"]
    for i in 0..256 { values.add("item-" + Text(i)) }
    let expected = ["IR\n258\n258\n"]
    for value in values { expected.add(value + "\n" + value + "\n") }
    peer.executes(c, source, joinText(expected))
    let prefix = "record Box { values: List<Text> }\nlet box = Box { values: [\"text\"] }\n"
    let sources = [prefix + "box.values[0] = 1\n", prefix + "box.values[true] = \"text\"\n",
        "record Box { value: Integer }\nlet box = Box { value: 1 }\nbox.value[0] = 2\n",
        "record Node { children: List<Node> }\nlet empty: List<Node> = []\nlet node = Node { children: empty }\nnode.children[0] = node\n"]
    let diagnostics = ["an indexed assignment needs Text, not Integer", "a position must be an Integer", "indexed assignment needs a List", "List position 0"]
    for index in 0..sources.length {
        if diagnostics[index] == "List position 0" { acceptsManagedGraph(c, sources[index]) } else { peer.rejects(c, sources[index], diagnostics[index]) }
    }
}
function test_mutual_recursion_accumulates_fibonacci_leaves(c: peer.Case) {
    let source = ""
    let functions = ["f", "g", "h", "k"]
    let calls: List<List<Text>> = [["g", "xm1", "xm2", "next", "h", "xm2", "next", "older"],
        ["k", "xm2", "next", "older", "h", "xm1", "xm2", "next"],
        ["k", "xm1", "xm2", "next", "f", "xm2", "next", "older"],
        ["f", "xm2", "next", "older", "g", "xm1", "xm2", "next"]]
    for index in 0..functions.length {
        source += "function " + functions[index] + "(x: Integer, xm1: Integer, xm2: Integer, total: List<Integer>) {\n"
        source += "let older = x - 4\nif x < 2 { total[0] = total[0] + x; return }\nlet next = x - 3\n"
        let row = calls[index]
        let position = 0
        while position < row.length {
            source += row[position] + "(" + row[position + 1] + ", " + row[position + 2] + ", " + row[position + 3] + ", total)\n"
            position += 4
        }
        source += "}\n"
    }
    let expected: List<Integer> = []
    for n in [12, 20] {
        source += "let sum" + Text(n) + " = [0]\nf(" + Text(n) + ", " + Text(n - 1) + ", " + Text(n - 2) + ", sum" + Text(n) + ")\nprint(sum" + Text(n) + "[0])\n"
        let a = 0
        let b = 1
        for unused in 0..n {
            let next = a + b
            a = b
            b = next
        }
        expected.add(a)
    }
    peer.executes(c, source, peer.integers(expected))
}
