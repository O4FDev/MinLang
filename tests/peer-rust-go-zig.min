            let end = needle.length - 1
            if end < 0 { end = 0 }
            let prefix = asciiLowerBytes(needle.slice(0, end))
            for code in 0..256 {
                let found = lastIndexOf(prefix, code)
                if found < 0 { expected.add(Text(needle.length)) } else { expected.add(Text(needle.length - 1 - found)) }
            }
        }
        expected.add(token(json.member(row, "minyar_index")))
    }
    source += "print(paths[0]); print(paths[1])\n"
