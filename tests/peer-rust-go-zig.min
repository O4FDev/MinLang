print(root.children[0].value)
print(root.children[0].children.length)
", "42\n1234\n1\n42\n0\n")
    peer.rejects(c, "use \"./rgz-library.min\" as library\nlibrary(0)\n", "I can't find a function named 'library'")
}
function upperText(value: Text): Text {
    let result = Bytes()
    for byte in Bytes(value) {
        if byte >= 97 && byte <= 122 { result.add(byte - 32) } else { result.add(byte) }
    }
    return Text(result)
}
function test_five_thousand_text_fields_and_accessors_compile(c: peer.Case) {
    let fields: List<Text> = []
    for i in 0..5000 { fields.add("H" + upperText(peer.hexadecimal(i, 6))) }
    peer.equalInteger(c, distinctTexts(fields), 5000, "distinct wide field names")
    let source: List<Text> = ["record Wide {\n"]
    for name in fields { source.add(name + ": Text\n") }
    source.add("}\n")
    for name in fields { source.add("function get" + name + "(value: Wide): Text { return value." + name + " }\n") }
    let compiled = peer.compile(c, joinText(source))
    requireSuccess(c, compiled.result, "wide record compilation")
    peer.equal(c, compiled.result.output, "", "wide record compiler output")
    peer.expect(c, !absent(compiled.llvm), "wide record compilation produced no LLVM")
    let emitted = Bytes(io.readTextFile(compiled.llvm))
    let accessors = Map<Text, Boolean>()
    let index = 0
    while index + 10 <= emitted.length {
        if emitted[index] == 103 && emitted[index + 1] == 101 && emitted[index + 2] == 116 { accessors[Text(emitted.slice(index + 3, index + 10))] = true }
        index += 1
    }
    for name in fields { peer.expect(c, accessors.has(name), "emitted LLVM lacks get" + name) }
    for optimization in c.variants {
        let executable = peer.executable(compiled.base, optimization)
        let linked = peer.run(c, clangCommand(clangWith(c, [optimization], ["-Wno-override-module", compiled.llvm, c.compiler.runtime, "-o", executable])), "link-wide-record-build", 30)
        requireSuccess(c, linked, "wide record link at " + optimization)
        peer.expect(c, !absent(executable), "wide record link produced no executable at " + optimization)
    }
}
function test_empty_import_driver_cold_warm_and_declaration_transitions(c: peer.Case) {
    let module = peer.path(c, "rgz-empty.min")
    let entry = peer.writeFile(c, "rgz-empty-main.min", "use \"./rgz-empty.min\" as empty\nprint(42)\n")
    let shim = makeShim(c, "rgz-empty-tools")
    for path in [shim, c.suite.root + "/minyar", c.suite.root + "/build/minyarc", c.suite.root + "/build/minyarc-modules",
        c.suite.root + "/build/minyar-module-build", c.suite.root + "/build/minyar-default-runtime.o"] { requireInput(c, path) }
    let environment = peer.withEnvironment(c.environment, "PATH", peer.path(c, "rgz-empty-tools") + ":" + system.getenv("PATH"))
    environment = peer.withEnvironment(environment, "MINYAR_MODULE_CACHE", peer.path(c, "rgz-empty-cache"))
    environment = peer.withEnvironment(environment, "MINYAR_CLANG_FLAGS", "-O2 -Wno-override-module")
    environment = peer.withoutEnvironment(environment, "MINYAR_CLANG")
    environment = peer.withoutEnvironment(environment, "MINYAR_RUNTIME_FLAGS")
    let stages = ["empty", "comments", "declaration", "removed"]
    let contents = ["", "// no declarations\n", "public function value(): Integer { return 7 }\n", ""]
    for index in 0..stages.length {
        let stage = stages[index]
        io.writeTextFile(module, test.sourceModules(contents[index]))
        let expression = "42"
        let expected = "42\n"
        if stage == "declaration" {
            expression = "empty.value()"
            expected = "7\n"
        }
        io.writeTextFile(entry, test.sourceModules("use \"./rgz-empty.min\" as empty\nprint(" + expression + ")\n"))
        peer.executes(c, io.readTextFile(entry), expected)
        for mode in ["direct", "incremental-first", "incremental-warm"] {
            let executable = peer.path(c, "rgz-empty-" + stage + "-" + mode)
            let command = [c.suite.root + "/minyar"]
            if mode != "direct" { command.add("--incremental") }
            peer.extend(command, [entry, "-o", executable])
            let built = peer.launch(c, command, "driver-empty-import-" + mode, 30, environment, "", "")
            peer.observe(c, built, 0, "built " + executable + "\n", "", "driver " + stage + " " + mode)
            let result = peer.run(c, [executable], "execute-empty-import-" + mode, 30)
            peer.observe(c, result, 0, expected, "", "driver program " + stage + " " + mode)
        }
    }
    io.writeTextFile(entry, test.sourceModules("use \"./rgz-empty.min\" as empty\nprint(empty.value())\n"))
    let missing = peer.path(c, "rgz-empty-missing")
    let result = peer.launch(c, [c.suite.root + "/minyar", "--incremental", entry, "-o", missing], "driver-empty-import-removed-declaration", 30, environment, "", "")
    peer.equalInteger(c, result.status, 1, "removed declaration driver status")
    peer.equal(c, result.output, "", "removed declaration driver output")
    peer.equal(c, result.errorOutput, "Minyar stopped: " + entry + ":2, column 7: module 'empty' has no function named 'value'\n", "removed declaration diagnostic")
    peer.expect(c, absent(missing), "removed declaration still produced " + missing)
}
function checkedOperation(symbol: Text, a: Integer, b: Integer): errors.IntegerResult {
    if symbol == "+" { return errors.checkedAdd(a, b) }
    if symbol == "-" { return errors.checkedSubtract(a, b) }
    return errors.checkedMultiply(a, b)
}
function test_full_signed64_constant_and_parameter_matrix(c: peer.Case) {
    let fixture = c.suite.root + "/tests/peer-rgz-signed64-values.json"
    requireInput(c, fixture)
    let data = peer.load(fixture)
    let values: List<Integer> = []
    for item in data.items { values.add(peer.number(item)) }
    peer.equalInteger(c, values.length, 33, "signed64 value count")
    peer.equalInteger(c, distinctTexts(peer.texts(values)), 33, "distinct signed64 values")
    let minimum = peer.MINIMUM
    let symbols = ["+", "-", "*", "/", "%"]
    let overflow = "Minyar stopped: this Integer calculation is outside the supported range.\n"
    let source: List<Text> = ["function value(index: Integer): Integer {\n"]
    for i in 0..values.length { source.add("if index == " + Text(i) + " { return " + Text(values[i]) + " }\n") }
    source.add("fail(\"invalid operand index\")\n}\n")
    source.add("function index(text: Text): Integer {\n")
    for i in 0..33 { source.add("if text == \"" + Text(i) + "\" { return " + Text(i) + " }\n") }
    source.add("fail(\"invalid matrix index\")\n}\n")
    for operation in 0..symbols.length {
        let symbol = symbols[operation]
        source.add("function dynamic" + Text(operation) + "(a: Integer, b: Integer): Integer { return a " + symbol + " b }\n")
        for side in ["left", "right"] {
            source.add("function " + side + Text(operation) + "(fixed: Integer, variable: Integer): Integer {\n")
            for i in 0..values.length {
                let n = values[i]
                if side == "right" && (symbol == "/" || symbol == "%") && n == 0 { continue }
                let expression = "(" + Text(n) + ") " + symbol + " variable"
                if side != "left" { expression = "variable " + symbol + " (" + Text(n) + ")" }
                source.add("if fixed == " + Text(i) + " { return " + expression + " }\n")
            }
            source.add("fail(\"excluded matrix operation\")\n}\n")
        }
    }
    source.add("function evaluate(op: Integer, placement: Integer, ai: Integer, bi: Integer): Integer {\n")
    for operation in 0..5 {
        let tag = Text(operation)
        source.add("if op == " + tag + " {\nif placement == 0 { return dynamic" + tag + "(value(ai), value(bi)) }\nif placement == 1 { return left" + tag + "(ai, value(bi)) }\nreturn right" + tag + "(bi, value(ai))\n}\n")
    }
    source.add("fail(\"invalid matrix operation\")\n}\n")
    let expected: List<Text> = []
    let failures: List<List<Text>> = []
    let masks: List<Text> = []
    for op in 0..symbols.length {
        let symbol = symbols[op]
        let mask: List<Text> = []
        for ai in 0..values.length {
            let a = values[ai]
            for bi in 0..values.length {
                let b = values[bi]
                if (symbol == "/" || symbol == "%") && (b == 0 || (a == minimum && b == -1)) {
                    mask.add("0")
                    continue
                }
                let fits = true
                let cell = 0
                if symbol == "/" || symbol == "%" {
                    let division = peer.division(a, b)
                    cell = division.quotient
                    if symbol == "%" { cell = division.remainder }
                } else {
                    let checked = checkedOperation(symbol, a, b)
                    fits = errors.integerOk(checked)
                    if fits { cell = errors.integerValue(checked) }
                }
                if fits { mask.add("1") } else { mask.add("0") }
                for placement in 0..3 {
                    if fits { expected.add(Text(cell)) } else { failures.add([Text(op), Text(placement), Text(ai), Text(bi)]) }
                }
            }
        }
        masks.add(joinText(mask))
    }
    peer.equalInteger(c, failures.length, 2310, "signed64 overflow cells")
    peer.equalInteger(c, expected.length, 13821, "signed64 safe cells")
    source.add("let mode = processInfo.argument(0)\nif mode == \"success\" {\n")
    for op in 0..masks.length {
        let tag = Text(op)
        source.add("let mask" + tag + " = \"" + masks[op] + "\"\nlet ai" + tag + " = 0\nwhile ai" + tag + " < 33 {\nlet bi" + tag + " = 0\nwhile bi" + tag + " < 33 {\n")
        source.add("if mask" + tag + "[ai" + tag + " * 33 + bi" + tag + "] == '1' {\n")
        for placement in 0..3 { source.add("print(evaluate(" + tag + ", " + Text(placement) + ", ai" + tag + ", bi" + tag + "))\n") }
        source.add("}\nbi" + tag + " = bi" + tag + " + 1\n}\nai" + tag + " = ai" + tag + " + 1\n}\n")
    }
    source.add("} else { print(evaluate(index(processInfo.argument(0)), index(processInfo.argument(1)), index(processInfo.argument(2)), index(processInfo.argument(3)))) }\n")
    let base = peer.executesWith(c, joinText(source), peer.lines(expected), 0, "", ["success"])
    let overflowCases: List<json.Value> = []
    for arguments in failures { overflowCases.add(peer.jsonTexts(arguments)) }
    let matrix = peer.jsonObject()
    peer.put(matrix, "values", data)
    peer.put(matrix, "success_instances", peer.jsonInteger(expected.length))
    peer.put(matrix, "overflow_instances", peer.jsonInteger(failures.length))
    peer.put(matrix, "placements", peer.jsonTexts(["var-var", "const-var", "var-const"]))
    peer.put(matrix, "excluded_divmod", peer.jsonText("denominator0 and MIN/-1 exactly as upstream; no other exclusion"))
    peer.put(matrix, "overflow_cases", peer.jsonArray(overflowCases))
    peer.control(c, "signed64_matrix", matrix)
    let normalOnly = system.getenv("MINYAR_RGZ_MATRIX_NORMAL_ONLY") == "1"
    peer.put(matrix, "normal_exit_only", peer.jsonBoolean(normalOnly))
    let coverage = peer.jsonObject()
    peer.put(coverage, "safe_cells_per_configuration", peer.jsonInteger(expected.length))
    peer.put(coverage, "overflow_cells_per_configuration", peer.jsonInteger(failures.length))
    peer.put(coverage, "overflow_processes_executed", peer.jsonInteger(0))
    peer.put(coverage, "configurations", peer.jsonTexts(c.variants))
    let domains = peer.jsonObject()
    peer.put(domains, "signed64_matrix", coverage)
    peer.control(c, "domain_coverage", domains)
    if normalOnly {
        let exclusion = peer.jsonObject()
        peer.put(exclusion, "domain", peer.jsonText("signed64 overflow and minimum-value negation"))
        peer.put(exclusion, "instances_per_configuration", peer.jsonInteger(failures.length + 1))
        peer.put(exclusion, "reason", peer.jsonText("MINYAR_RGZ_MATRIX_NORMAL_ONLY selects normal-exit ownership cases"))
        peer.control(c, "domain_exclusions", peer.jsonArray([exclusion]))
    }
    let executed = 0
    for optimization in c.variants {
        if normalOnly { continue }
        let program = peer.executable(base, optimization)
        for arguments in failures {
            let command = [program]
            peer.extend(command, arguments)
            let result = peer.run(c, command, "execute-matrix-overflow", 30)
            executed += 1
            peer.put(coverage, "overflow_processes_executed", peer.jsonInteger(executed))
            peer.observe(c, result, 1, "", overflow, "matrix overflow " + peer.joined(arguments, " ") + " at " + optimization)
        }
    }
    let unary = "function negate(value: Integer): Integer { return -value }\n"
    let calls: List<Text> = []
    let negations: List<Text> = []
    for n in values {
        if n != minimum {
            calls.add("print(negate(" + Text(n) + "))\n")
            negations.add(Text(-n) + "\n")
        }
    }
    peer.executes(c, unary + joinText(calls), joinText(negations))
    if !normalOnly { peer.executesStatus(c, unary + "print(negate(" + Text(minimum) + "))\n", "", 1, overflow) }
}
