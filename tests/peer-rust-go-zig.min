            source += "print((" + Text(a) + " " + symbol + " " + Text(b) + ") * n " + symbol + " (" + Text(b) + " * (" + Text(offset) + ")))\n"
            let sign = -1
            if symbol == "+" { sign = 1 }
            let value = a * 42 + sign * b * (42 + offset)
            expected.add(value)
            expected.add(value)
        }
