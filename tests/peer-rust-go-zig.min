    let bases: List<Integer> = []
    let values: List<Integer> = []
    for n in [1, 2, 0x72, 0xFFFFFF, 0x7FF0123456789ABC] { bases.add(2); values.add(n) }
    bases.add(9)
    values.add(59049)
    let source = "function root(value: Integer): Integer {
let low = 0
let high = value
let answer = 0
while low <= high {
let middle = low + (high - low) / 2
if middle == 0 { answer = 0; low = 1 } else {
if middle <= value / middle { answer = middle; low = middle + 1 } else { high = middle - 1 }
}
}
return answer
}
function logarithm(base: Integer, value: Integer): Integer {
let remaining = value
let result = 0
while remaining >= base { remaining = remaining / base; result = result + 1 }
return result
}
"
    let expected: List<Integer> = []
    for n in roots { expected.add(integerSquareRoot(n)) }
    for n in roots { source += "print(root(" + Text(n) + "))\n" }
    for index in 0..bases.length {
        let base = bases[index]
        let value = values[index]
        source += "print(logarithm(" + Text(base) + ", " + Text(value) + "))\n"
        let power = 1
        let exponent = 0
        while peer.bigCompare(peer.product(power, base), peer.big(value)) <= 0 {
            power *= base
            exponent += 1
        }
        expected.add(exponent)
    }
    peer.executes(c, source, peer.integers(expected))
}
function adler32(data: Bytes): Integer {
    let low = 1
    let high = 0
    for byte in data {
        low = (low + byte) % 65521
        high = (high + low) % 65521
    }
    return high * 65536 + low
}
function test_adler_checksum_streaming_integer_workload(c: peer.Case) {
    let ones1024 = Bytes()
    for unused in 0..1024 { ones1024.add(1) }
    let ones1025 = Bytes()
    for unused in 0..1025 { ones1025.add(1) }
    let ones5553 = Bytes()
    for unused in 0..5553 { ones5553.add(1) }
    let varied = Bytes()
    for i in 0..6000 { varied.add(i % 256) }
    let vectors = [Bytes("a"), Bytes("example"), ones1024, ones1025, ones5553, varied]
    let source = "function checksum(values: List<Integer>): Integer {
let low = 1
let high = 0
let i = 0
while i < values.length {
low = (low + values[i]) % 65521
high = (high + low) % 65521
 i = i + 1
}
return high * 65536 + low
}
function repeat(count: Integer, varied: Boolean): List<Integer> {
let values: List<Integer> = []
let i = 0
while i < count {
if varied { values.add(i % 256) } else { values.add(1) }
i = i + 1
}
return values
}
print(checksum([97]))
print(checksum([101, 120, 97, 109, 112, 108, 101]))
print(checksum(repeat(1024, false)))
print(checksum(repeat(1025, false)))
print(checksum(repeat(5553, false)))
print(checksum(repeat(6000, true)))
"
    let expected: List<Integer> = []
    for data in vectors { expected.add(adler32(data)) }
    equalIntegers(c, expected, [0x620062, 0xbc002ed, 0x06780401, 0x0a7a0402, 0x707f15b2, 0x5af38d6e], "adler32 vectors")
    peer.executes(c, source, peer.integers(expected))
}
function test_overlapping_character_list_moves_preserve_source(c: peer.Case) {
