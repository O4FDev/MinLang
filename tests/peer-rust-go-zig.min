function test_allocator_fail_ordinals_and_nonlast_move_accounting(c: peer.Case) {
    let fixture = c.suite.root + "/tests/peer-rgz-allocator-probe.c"
    let faultRuntime = c.suite.root + "/tests/allocation-fault-runtime.c"
    for path in [fixture, faultRuntime, c.suite.root + "/runtime/minyar_runtime.c"] { requireInput(c, path) }
    runtimeHeaders(c, "")
    let environment: List<Text> = []
    for entry in c.environment {
        if !peer.starts(entry, "MINYAR_FAIL_") && !peer.starts(entry, "MINYAR_FAULT_") { environment.add(entry) }
    }
    let source = "let first = [1, 2]
let second = [3, 4]
let alias = first
let next = 3
while next <= 40 { first.add(next); next = next + 1 }
print(first.length); print(alias.length)
let i = 0
while i < first.length { print(first[i]); print(alias[i]); i = i + 1 }
print(second[0]); print(second[1])
alias[0] = 99
print(first[0]); print(second[0])
"
    let compiled = peer.compile(c, source)
    peer.observe(c, compiled.result, 0, "", "", "moving list compilation")
    let expected = [40, 40]
    for n in 1..41 {
        expected.add(n)
        expected.add(n)
    }
    for value in [3, 4, 99, 3] { expected.add(value) }
    let modes = ["allocate", "resize", "move"]
    let variables = ["MINYAR_FAIL_ALLOCATION", "MINYAR_FAIL_RESIZE", ""]
    let settings = ["3", "2", ""]
    let oracles: List<List<Integer>> = [[3, 0, 0, 1, 0], [2, 3, 1, 2, 0], [2, 1, 1, 0, 0]]
    for optimization in c.variants {
        let tag = suffix(optimization)
        let probe = peer.path(c, "allocator-" + tag)
        let linked = peer.run(c, clangCommand(clangWith(c, ["-std=c11", optimization], [fixture, "-o", probe])), "link-allocator-probe", 30)
        requireSuccess(c, linked, "allocator probe link at " + optimization)
        for index in 0..modes.length {
            let reportPath = peer.path(c, modes[index] + "-" + tag + ".json")
            let probeEnvironment = environment
            if variables[index] != "" { probeEnvironment = peer.withEnvironment(environment, variables[index], settings[index]) }
            probeEnvironment = peer.withEnvironment(probeEnvironment, "MINYAR_ALLOCATION_REPORT", reportPath)
            let executed = peer.launch(c, [probe, modes[index]], "execute-allocator-probe", 30, probeEnvironment, "", "")
            peer.observe(c, executed, 0, "", "", "allocator probe " + modes[index] + " at " + optimization)
            let report = peer.load(reportPath)
            let actual: List<Integer> = []
            for key in ["allocations", "resizes", "moved", "fired", "live_bytes"] { actual.add(peer.field(report, key)) }
            equalIntegers(c, actual, oracles[index], "allocator probe " + modes[index] + " report at " + optimization)
        }
        let executable = peer.path(c, "moving-list-" + tag)
        let linkedList = peer.run(c, clangCommand(clangWith(c, ["-std=c11", optimization], ["-Wno-override-module", "-DMINYAR_FRAME_CACHE_BYTES=0", compiled.llvm, faultRuntime, "-o", executable])), "link-forced-moving-list", 30)
        requireSuccess(c, linkedList, "forced moving list link at " + optimization)
        let movingReport = peer.path(c, "moving-list-" + tag + ".json")
        let moving = peer.launch(c, [executable], "execute-forced-moving-list", 30, peer.withEnvironment(environment, "MINYAR_ALLOCATION_REPORT", movingReport), "", "")
        peer.observe(c, moving, 0, peer.integers(expected), "", "forced moving list at " + optimization)
        let report = peer.load(movingReport)
        peer.expect(c, peer.field(report, "storage_moves") >= 4, "forced moving list storage_moves below 4 at " + optimization)
        peer.expect(c, peer.field(report, "allocations") > 0, "forced moving list made no allocations at " + optimization)
        peer.equalInteger(c, peer.field(report, "moved"), peer.field(report, "resizes"), "forced moving list moved resizes at " + optimization)
        peer.equalInteger(c, peer.field(report, "frame_entries"), peer.field(report, "frame_leaves"), "forced moving list frames at " + optimization)
        peer.expect(c, peer.field(report, "released_objects") >= 2, "forced moving list released fewer than 2 objects at " + optimization)
        peer.equalInteger(c, peer.field(report, "fired"), 0, "forced moving list fired at " + optimization)
        peer.equalInteger(c, peer.field(report, "live_bytes"), 0, "forced moving list live bytes at " + optimization)
    }
}
function executesBinaryFileRoundtrip(c: peer.Case, source: Text, expected: Bytes, arguments: List<Text>, output: Text, payload: Bytes) {
    let oracle = peer.jsonObject()
    peer.put(oracle, "stdout_base64", peer.jsonText(base64(expected)))
    peer.put(oracle, "written_base64", peer.jsonText(base64(payload)))
    peer.put(oracle, "status", peer.jsonInteger(0))
    peer.put(oracle, "stderr", peer.jsonText(""))
    peer.appendControl(c, "binary_oracles", oracle)
    let compiled = peer.compile(c, source)
    peer.observe(c, compiled.result, 0, "", "", "binary roundtrip compilation")
    for optimization in c.variants {
        let executable = peer.executable(compiled.base, optimization)
        let linked = peer.run(c, clangCommand(clangWith(c, [optimization], ["-Wno-override-module", compiled.llvm, c.compiler.runtime, "-o", executable])), "link", 30)
        requireSuccess(c, linked, "binary roundtrip link at " + optimization)
        if !absent(output) { peer.expect(c, files.remove(output) == 0, "cannot clear " + output) }
        let command = [executable]
        peer.extend(command, arguments)
        let result = peer.run(c, command, "execute", c.runTimeout)
        peer.expect(c, result.status == 0 && peer.bytesEqual(Bytes(result.output), expected) && result.errorOutput == "",
            "binary roundtrip execution differs at " + optimization + ": status " + Text(result.status) + ", " + Text(Bytes(result.output).length) + " stdout bytes, expected " + Text(expected.length))
        peer.expect(c, !absent(output) && peer.bytesEqual(io.readBytesFile(output), payload), "binary roundtrip file bytes differ at " + optimization)
    }
}
