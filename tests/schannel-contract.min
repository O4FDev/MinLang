use "schannel" as tls
use "errors" as errors
let invalid = tls.client("embedded" + Text(Character(0)) + "nul")
if tls.clientOk(invalid) || errors.code(tls.clientError(invalid)) != errors.invalidDataCode() { fail("NUL hostname accepted") }
let absent: List<Bytes> = []
let emptyTrust = tls.clientWithTrust("localhost",absent)
if tls.clientOk(emptyTrust) || errors.code(tls.clientError(emptyTrust)) != errors.invalidDataCode() { fail("empty explicit roots silently used OS roots") }
let malformed: List<Bytes> = [Bytes("not DER")]
let invalidTrust = tls.clientWithTrust("localhost",malformed)
if tls.clientOk(invalidTrust) || errors.code(tls.clientError(invalidTrust)) != errors.invalidDataCode() { fail("invalid trust certificate accepted") }
let created = tls.client("localhost")
if !tls.clientOk(created) { fail("OS TLS initialization failed") }
let session = tls.clientValue(created)
let state = tls.state(session)
if !errors.integerOk(state) || errors.integerValue(state) != tls.handshaking() { fail("initial TLS state incorrect") }
let blocked = tls.write(session,Bytes("unverified application data"))
if errors.integerOk(blocked) || !errors.isWouldBlock(errors.integerError(blocked)) { fail("application write before authentication accepted") }
let outgoing = tls.takeOutgoing(session)
if !errors.bytesOk(outgoing) || errors.bytesValue(outgoing).length == 0 { fail("no client hello") }
let incoming = tls.takeIncoming(session)
if !errors.bytesOk(incoming) || errors.bytesValue(incoming).length != 0 { fail("unauthenticated plaintext") }
let truncated = tls.endInput(session)
if errors.integerOk(truncated) || errors.code(errors.integerError(truncated)) != errors.truncatedCode() { fail("missing close notification accepted") }
let closed = tls.close(session)
if !errors.integerOk(closed) { fail("TLS cleanup failed") }
let stale = tls.state(session)
if errors.integerOk(stale) || errors.code(errors.integerError(stale)) != errors.closedCode() { fail("stale TLS handle accepted") }
print("Windows SChannel result, trust, authentication and lifetime contracts verified")
