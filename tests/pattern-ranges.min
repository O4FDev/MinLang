use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures
use "io" as io

function patternSource(path: Text): Text {
    return test.replace(io.readTextFile(path), "__PATTERN_NUL__", Text(Character(0)))
}

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let levels = ["-O0", "-O2"]
fixtures.validate("PatternRanges", ["integers", "extremes", "correlations", "conditions", "text", "ownership", "missing", "rejections", "gallery"])

if fixtures.selected("PatternRanges", "integers") {
    fixtures.executes(frontend, patternSource("tests/pattern-ranges/integers.min"), "outside\nbelow\nbelow\nsingle digit\nsingle digit\nteens\nteens\noutside\nfirst\nfirst\nfirst\nsecond\nsecond\nother\ntrue\ntrue\nfalse\nnegative radix\nexclusive upper\nstatement\n", levels, 0, "", true)
}
if fixtures.selected("PatternRanges", "extremes") {
    fixtures.executes(frontend, patternSource("tests/pattern-ranges/extremes.min"), "negative\nnegative\nnegative\nnear zero\nnear zero\npositive\npositive\nmaximum\nfloor\nceiling neighbour\nhex floor\nhex ceiling\n1\n2\nsome\nlast\nnone\n", levels, 0, "", true)
}
if fixtures.selected("PatternRanges", "correlations") {
    fixtures.executes(frontend, patternSource("tests/pattern-ranges/correlations.min"), "0\n1\n2\n3\n4\n5\n6\n10\n10\n11\n12\n13\n14\n15\n16\nsmall lit\nsmall dark\nlarger\nabsent\nlit\nquiet\n", levels, 0, "", true)
}
if fixtures.selected("PatternRanges", "conditions") {
    fixtures.executes(frontend, patternSource("tests/pattern-ranges/conditions.min"), "record\nteens\n1\n2\n3\n4\n1\n2\n3\n2\n3\n3\n1\n", levels, 0, "", true)
}
if fixtures.selected("PatternRanges", "text") {
    fixtures.executes(frontend, patternSource("tests/pattern-ranges/text.min"), "empty\ndynamic\nrange text\nraw slash\nquote\nnewline\nzero byte\nzero tail\nother\nother\ncomposed\ndecomposed\nother\nnested raw\nnested zero\nnested quote\nnone\n", levels, 0, "", true)
}
if fixtures.selected("PatternRanges", "ownership") {
    fixtures.executes(frontend, patternSource("tests/pattern-ranges/ownership.min"), "kept\ntext kept\ndynamic\nliteral\n1\nclean\n", levels, 0, "", true)
}

if fixtures.selected("PatternRanges", "missing") {
    fixtures.rejects(frontend, "match 0 { -9223372036854775808..9223372036854775807 {} }\n", "for example: 9223372036854775807", true)
    fixtures.rejects(frontend, "match Some(0) { Some(-9223372036854775808..9223372036854775807) {} None {} }\n", "for example: Some(9223372036854775807)", true)
    fixtures.rejects(frontend, "match 0 { -9223372036854775808..0 {} 1..9223372036854775807 {} 9223372036854775807 {} }\n", "for example: 0", true)
    fixtures.rejects(frontend, #"""
        match 42 {
            -9223372036854775808..42 {}
            42..43 where true {}
            43..9223372036854775807 {}
            9223372036854775807 {}
        }
        """#, "for example: 42", true)
    fixtures.rejects(frontend, #"""
        choice Pair { Both(number: Integer, flag: Boolean); Empty }
        match Both(0, true) {
            Both(-9223372036854775808..0, _) {}
            Both(0..9223372036854775807, false) {}
            Both(1..9223372036854775807, true) {}
            Both(9223372036854775807, _) {}
            Empty {}
        }
        """#, "for example: Both(0, true)", true)
    fixtures.rejects(frontend, #"""
        record Pair { number: Integer; flag: Boolean }
        let value = Pair { number: 0; flag: true }
        match value {
            Pair(-9223372036854775808..0, _) {}
            Pair(0..9223372036854775807, false) {}
            Pair(1..9223372036854775807, true) {}
            Pair(9223372036854775807, _) {}
        }
        """#, "for example: Pair(0, true)", true)
    fixtures.rejects(frontend, #"""
        let value: Result<Maybe<Integer>, Text> = Ok(Some(0))
        match value {
            Ok(Some(-9223372036854775808..0)) {}
            Ok(Some(1..9223372036854775807)) {}
            Ok(Some(9223372036854775807)) {}
            Ok(None) {}
            Err(_) {}
        }
        """#, "for example: Ok(Some(0))", true)
    fixtures.rejects(frontend, "match \"mo\" + \"on\" { \"moon\" {} }\n", "for example: \"0\"", true)
    fixtures.rejects(frontend, "match Some(\"moon\") { Some(\"moon\") {} None {} }\n", "for example: Some(\"0\")", true)
    fixtures.rejects(frontend, #"""
        match #"a\b"# { #"a\b"# {} "quote\"only" {} "line\nonly" {} }
        """#, "for example: \"0\"", true)
    let nulSource = test.replace("match \"left__PATTERN_NUL__right\" { \"left__PATTERN_NUL__right\" {} }\n", "__PATTERN_NUL__", Text(Character(0)))
    fixtures.rejects(frontend, nulSource, "for example: \"0\"", true)
}

if fixtures.selected("PatternRanges", "rejections") {
    fixtures.rejects(frontend, "match 0 { 0..0 {} _ {} }\n", "range pattern must be increasing", true)
    fixtures.rejects(frontend, "match 1 { 2..1 {} _ {} }\n", "range pattern must be increasing", true)
    fixtures.rejects(frontend, "match -1 { -1..-1 {} _ {} }\n", "range pattern must be increasing", true)
    fixtures.rejects(frontend, "match -1 { -1..-2 {} _ {} }\n", "range pattern must be increasing", true)
    fixtures.rejects(frontend, "match 1.0 { 0..2 {} _ {} }\n", "pattern has the wrong type", true)
    fixtures.rejects(frontend, "match \"x\" { 0..2 {} _ {} }\n", "pattern has the wrong type", true)
    fixtures.rejects(frontend, "match true { 0..2 {} _ {} }\n", "pattern has the wrong type", true)
    fixtures.rejects(frontend, "match 'a' { 0..2 {} _ {} }\n", "pattern has the wrong type", true)
    fixtures.rejects(frontend, "match 1.0 { 0.0..2.0 {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "match \"m\" { \"a\"..\"z\" {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "match 1 { 0..2.0 {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "match 1 { 0..\"two\" {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "match 1 { 0..true {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "match 1 { 0..'z' {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "let end = 2\nmatch 1 { 0..end {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "let start = 0\nmatch 1 { start..2 {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "match 1 { 0..(2) {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "let end = 2\nmatch 1 { 0..-end {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "match 1 { 0..2+3 {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "match 1 { 0..2..3 {} _ {} }\n", "range pattern bounds must be Integer literals", true)
    fixtures.rejects(frontend, "match 0 { 0..9223372036854775808 {} _ {} }\n", "Integer literal is outside the supported range", true)
    fixtures.rejects(frontend, "match 0 { -9223372036854775809..0 {} _ {} }\n", "Integer literal is outside the supported range", true)
    fixtures.rejects(frontend, "match 0 { 0..0x8000000000000001 {} _ {} }\n", "Integer literal is outside the supported range", true)
    fixtures.rejects(frontend, #"""
        record Pair { number: Integer; text: Text }
        let Pair(0..10, word) = Pair { number: 7; text: "range" }
        """#, "let pattern can miss", true)
    fixtures.rejects(frontend, #"""
        record Pair { first: Integer; second: Integer }
        let Pair(-9223372036854775808..9223372036854775807, other) = Pair { first: 0; second: 0 }
        """#, "let pattern can miss Pair(9223372036854775807, 0)", true)
    fixtures.rejects(frontend, #"""
        choice Wrapper { Wrapped(value: Integer) }
        let Wrapped(-9223372036854775808..9223372036854775807) = Wrapped(0)
        """#, "let pattern can miss", true)
    fixtures.rejects(frontend, "match 0 { 0..", "range pattern bounds must be Integer literals", true)
}

if fixtures.selected("PatternRanges", "gallery") {
    fixtures.executes(frontend, patternSource("examples/gallery/pattern-ranges.min"), "the harbour borrows a little light\nmorning opens every window\nthe sea holds the colour of the sky\none by one, the lanterns answer\nthe clock is dreaming\n", levels, 0, "", true)
}

test.removeTree(frontend.compiler.directory)
print("Pattern ranges: passed")
