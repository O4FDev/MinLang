use "../tools/testing.min" as test
use "system" as system
let work = test.scratch()
let bootstrap = test.setting("MINYAR_TEST_BOOTSTRAP", "./build/stage0")
let clang = test.setting("MINYAR_TEST_CLANG", "clang")
let flags = test.words(test.setting("MINYAR_TEST_LINK_FLAGS", ""))
let source = work + "/records.min"
let llvm = work + "/records.ll"
writeTextFile(source, "record Coordinates { values: List<Integer>; title: Text; valid: Boolean; letter: Character; counter: Integer }\nfunction make(): Coordinates {\n    let values: List<Integer> = [40, 41]\n    return Coordinates { letter: 'Q', valid: true, title: \"source\", values: values, counter: 0 }\n}\nfunction read(location: Coordinates): Integer { return location.values[0] + 2 }\nfunction main(): Integer {\n    let location = make()\n    print(read(location))\n    print(location.title)\n    print(location.valid)\n    print(location.letter)\n    location.title = \"changed\"\n    location.valid = false\n    location.letter = 'Z'\n    location.counter = 42\n    print(location.title)\n    print(location.valid)\n    print(location.letter)\n    print(location.counter)\n    let bytes = Bytes(\"Aé🙂\")\n    print(bytes.length)\n    print(bytes[0])\n    print(bytes[1])\n    print(Bytes(3).length)\n    print(Text(Bytes(\"ABC\")))\n    let frames = Bytes(0)\n    frames.addInt64(-42)\n    print(frames.getInt64(0))\n    frames.setInt64(0, 42)\n    print(frames.getInt64(0))\n    print(\"first\nsecond\")\n    return 0\n}\n")
test.require(test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/compile", 120), "bootstrap records compile")
let command = [clang, "-O2"]
for flag in flags { command.add(flag) }
for item in ["-DMINYAR_COMPILER_ARENA", "-Wno-override-module", llvm, "runtime/minyar_runtime.c", "-lm", "-o", work + "/records"] { command.add(item) }
test.require(test.run(command, system.environment(), "", work + "/link", 120), "bootstrap records link")
let result = test.run([work + "/records"], system.environment(), "", work + "/run", 120)
test.check(result.status == 0, "bootstrap records execution status")
test.check(result.output == "42\nsource\ntrue\nQ\nchanged\nfalse\nZ\n42\n7\n65\n195\n3\nABC\n-42\n42\nfirst\nsecond\n", "bootstrap records output")
writeTextFile(source, "function main(): Integer { let text = \"first\nsecond\"\n    print(missing)\nreturn 0 }\n")
result = test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/reject", 120)
test.check(result.status != 0 && test.contains(result.errorOutput, ":3:11: error:"), "bootstrap rejection :3:11: error:")
writeTextFile(source, "function main(): Integer { let bytes = Bytes(0)\nprint(bytes == bytes)\nreturn 0 }\n")
result = test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/reject", 120)
test.check(result.status != 0 && test.contains(result.errorOutput, "Bytes cannot be compared"), "bootstrap rejection Bytes cannot be compared")
writeTextFile(source, "function main(): Integer { let bytes = Bytes(true)\nreturn 0 }\n")
result = test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/reject", 120)
test.check(result.status != 0 && test.contains(result.errorOutput, "Bytes expects one Integer or Text value"), "bootstrap rejection Bytes expects one Integer or Text value")
writeTextFile(source, "record Pair { value: Integer }\nfunction main(): Integer { let p = Pair { value: 1 }; p.value = \"bad\"\nreturn 0 }\n")
result = test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/reject", 120)
test.check(result.status != 0 && test.contains(result.errorOutput, "this field contains"), "bootstrap rejection this field contains")
writeTextFile(source, "record Pair { value: Integer; value: Text }\nfunction main(): Integer { return 0 }\n")
result = test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/reject", 120)
test.check(result.status != 0 && test.contains(result.errorOutput, "more than once"), "bootstrap rejection more than once")
writeTextFile(source, "record Pair { value: Integer }\nrecord Pair { value: Integer }\nfunction main(): Integer { return 0 }\n")
result = test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/reject", 120)
test.check(result.status != 0 && test.contains(result.errorOutput, "more than once"), "bootstrap rejection more than once")
writeTextFile(source, "record Pair { value: Integer }\nfunction main(): Integer { let p = Pair { value: \"bad\" }\nreturn 0 }\n")
result = test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/reject", 120)
test.check(result.status != 0 && test.contains(result.errorOutput, "different type"), "bootstrap rejection different type")
writeTextFile(source, "record Pair { left: Integer; right: Integer }\nfunction main(): Integer { let p = Pair { left: 1 }\nreturn 0 }\n")
result = test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/reject", 120)
test.check(result.status != 0 && test.contains(result.errorOutput, "missing field"), "bootstrap rejection missing field")
writeTextFile(source, "record Pair { value: Integer }\nfunction main(): Integer { let p = Pair { value: 1, value: 2 }\nreturn 0 }\n")
result = test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/reject", 120)
test.check(result.status != 0 && test.contains(result.errorOutput, "more than once"), "bootstrap rejection more than once")
writeTextFile(source, "record Pair { value: Integer }\nfunction main(): Integer { let p = Pair { other: 1 }\nreturn 0 }\n")
result = test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/reject", 120)
test.check(result.status != 0 && test.contains(result.errorOutput, "does not have a field"), "bootstrap rejection does not have a field")
writeTextFile(source, "record Pair { value: Integer }\nfunction main(): Integer { let p = Pair { value: 1 }\nprint(p.other)\nreturn 0 }\n")
result = test.run([bootstrap, source, "-o", llvm], system.environment(), "", work + "/reject", 120)
test.check(result.status != 0 && test.contains(result.errorOutput, "does not have a field"), "bootstrap rejection does not have a field")
test.removeTree(work)
print("bootstrap records: typed construction, reordered fields, field access and invalid declarations verified")
