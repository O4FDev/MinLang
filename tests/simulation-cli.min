use "../tools/testing.min" as test
use "../tools/driver-support.min" as host
use "io" as io
use "system" as system

// minyar sim: discovery, seed sharing across jobs, the first failing seed, its
// replay, one-seed runs, filters, option checks and the determinism proof.
let root = host.resolveName(".")
let launcher = test.setting("MINYAR_TEST_LAUNCHER", root + "/minyar")
let work = test.scratch()
let application = work + "/harbour project"
host.makeDirectories(application + "/src")
host.makeDirectories(application + "/sim")
io.writeTextFile(application + "/Minyar.toml", "[package]\nname = \"harbour\"\nversion = \"0.1.0\"\nkind = \"bin\"\n")
io.writeTextFile(application + "/src/main.min", "print(\"the harbour is home\")\n")
io.writeTextFile(application + "/sim/lanterns.min", #"""
    use "simulation" as sim

    // Every seventh universe from seed 3 loses its lantern.
    public function universe(seed: Integer): Text {
        let world = sim.create(seed)
        sim.advance(world, sim.choose(world, 10))
        if seed % 7 == 3 { return "lost the lantern at \(sim.now(world)) ms, seed \(seed)" }
        return ""
    }
    """#)
io.writeTextFile(application + "/sim/quiet.min", "public function universe(seed: Integer): Text { return \"\" }\n")

let environment = system.environment()
let both = test.run([launcher, "sim", "--seeds", "50", "--jobs", "3"], environment, application, work + "/both", 600)
test.check(both.status == 1, "a failing universe makes sim exit with status one\n" + both.output + both.errorOutput)
test.check(test.contains(both.output, "sim lanterns: 7 of 50 universes failed (seeds 0..49, 3 jobs, "), "failures across three jobs are counted once\n" + both.output)
test.check(test.contains(both.output, "  first: seed 3: lost the lantern at "), "the first failing seed is the lowest\n" + both.output)
test.check(test.contains(both.output, "  replayed seed 3 twice: same result\n  reproduce: minyar sim lanterns --seed 3\n"), "the first failure is replayed and reproducible\n" + both.output)
test.check(test.contains(both.output, "sim quiet: 50 universes passed (seeds 0..49, 3 jobs, "), "a passing scenario still runs after a failing one\n" + both.output)

let failing = test.run([launcher, "sim", "lanterns", "--seed", "10"], environment, application, work + "/failing", 600)
test.check(failing.status == 1 && test.contains(failing.output, "sim lanterns: seed 10 failed: lost the lantern at ") && test.contains(failing.output, "seed 10\n"), "one failing seed explains itself\n" + failing.output + failing.errorOutput)
let passing = test.run([launcher, "sim", "lanterns", "--seed", "11"], environment, application, work + "/passing", 600)
test.check(passing.status == 0 && passing.output == "sim lanterns: seed 11 passed\n", "one passing seed\n" + passing.output + passing.errorOutput)
let filtered = test.run([launcher, "sim", "quiet", "--seeds", "5", "--first", "100"], environment, application, work + "/filtered", 600)
test.check(filtered.status == 0 && test.contains(filtered.output, "sim quiet: 5 universes passed (seeds 100..104, 1 jobs, ") && !test.contains(filtered.output, "lanterns"), "filter and first seed\n" + filtered.output + filtered.errorOutput)

let unmatched = test.run([launcher, "sim", "no such scenario"], environment, application, work + "/unmatched", 60)
test.check(unmatched.status != 0 && test.contains(unmatched.errorOutput, "no simulation in sim/ matched no such scenario"), "unmatched filter\n" + unmatched.errorOutput)
let zero = test.run([launcher, "sim", "--seeds", "0"], environment, application, work + "/zero", 60)
test.check(zero.status != 0 && test.contains(zero.errorOutput, "--seeds and --jobs must be at least 1"), "zero seeds rejected\n" + zero.errorOutput)
let word = test.run([launcher, "sim", "--jobs", "many"], environment, application, work + "/word", 60)
test.check(word.status != 0 && test.contains(word.errorOutput, "--jobs requires a nonnegative integer"), "non-numeric jobs rejected\n" + word.errorOutput)
let misplaced = test.run([launcher, "build", "--seeds", "3"], environment, application, work + "/misplaced", 60)
test.check(misplaced.status != 0 && test.contains(misplaced.errorOutput, "--seeds is not supported by build"), "sim options belong to sim\n" + misplaced.errorOutput)

// A universe that reads the host clock never runs: the generated driver's
// deterministic wrapper makes it a compile error.
io.writeTextFile(application + "/sim/clock.min", "use \"system\" as system\npublic function universe(seed: Integer): Text { if system.monotonicNanoseconds() % 2 == 0 { return \"even\" }; return \"\" }\n")
let clock = test.run([launcher, "sim", "clock"], environment, application, work + "/clock", 600)
test.check(clock.status == 1 && test.contains(clock.errorOutput, "deterministic function 'attempt' can reach the host clock: attempt -> universe -> monotonicNanoseconds (native \"system\")") && !test.contains(clock.output, "universes"), "host clock rejected before any universe runs\n" + clock.output + clock.errorOutput)
test.removeTree(work)
print("Simulation CLI: passed")
