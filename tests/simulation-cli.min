use "../tools/testing.min" as test
use "../tools/driver-support.min" as host
use "io" as io
use "system" as system
use "process" as processInfo

// Piece selector: `--cases name[,name...]` limits the run to the named groups.
// With no --cases the harness runs every group, exactly as before.
let caseGroups = ["lanterns", "vault", "beacons", "options", "durable", "early"]
let requestedCases: List<Text> = []
let caseIndex = 0
while caseIndex < processInfo.argumentCount() {
    let caseOption = processInfo.argument(caseIndex)
    test.check(caseOption == "--cases" && caseIndex + 1 < processInfo.argumentCount(), "unknown simulation-cli option: " + caseOption)
    for caseName in test.words(test.replace(processInfo.argument(caseIndex + 1), ",", " ")) {
        let caseKnown = false
        for caseGroup in caseGroups { if caseGroup == caseName { caseKnown = true } }
        test.check(caseKnown, "unknown simulation-cli case group: " + caseName)
        requestedCases.add(caseName)
    }
    caseIndex += 2
}

function runsCases(requested: List<Text>, name: Text): Boolean {
    if requested.length == 0 { return true }
    for group in requested { if group == name { return true } }
    return false
}

// minyar sim: discovery, seed sharing across jobs, the first failing seed, its
// replay, one-seed runs, filters, option checks and the determinism proof.
let root = host.resolveName(".")
let launcher = test.setting("MINYAR_TEST_LAUNCHER", root + "/minyar")
let work = test.scratch()
let application = work + "/harbour project"
host.makeDirectories(application + "/src")
host.makeDirectories(application + "/sim")
io.writeTextFile(application + "/Minyar.toml", "[package]\nname = \"harbour\"\nversion = \"0.1.0\"\nkind = \"bin\"\n")
io.writeTextFile(application + "/src/main.min", "print(\"the harbour is home\")\n")
io.writeTextFile(application + "/sim/lanterns.min", #"""
    use "simulation" as sim

    // About one universe in seven loses its lantern.
    public function universe(world: sim.World): Text {
        sim.advance(world, sim.choose(world, 10))
        if sim.choose(world, 7) == 3 { return "lost the lantern at \(sim.now(world)) ms" }
        return ""
    }
    """#)
io.writeTextFile(application + "/sim/quiet.min", "use \"simulation\" as sim\npublic function universe(world: sim.World): Text { return \"\" }\n")
// The vault opens only after three rare moments in order; seeded runs almost
// never get there, while exploration forks from each recorded moment.
io.writeTextFile(application + "/sim/vault.min", #"""
    use "simulation" as sim

    public function universe(world: sim.World): Text {
        let stage = 0
        for step in 0..40 {
            let roll = sim.choose(world, 200)
            if stage == 0 && roll == 7 { stage = 1; sim.reached(world, "first tumbler") }
            else if stage == 1 && roll == 3 { stage = 2; sim.reached(world, "second tumbler") }
            else if stage == 2 && roll == 11 { stage = 3; sim.reached(world, "third tumbler") }
            else if stage == 3 && roll == 0 { return "the vault opened at step \(step)" }
        }
        return ""
    }
    """#)

// Three windows of one kind on one beacon at a common moment fail a run.
// Plain seeds rarely draw that; exploration mutates the declared windows of
// runs that reached the overlapping-pair moment.
io.writeTextFile(application + "/sim/beacons.min", #"""
    use "simulation" as sim

    public function universe(world: sim.World): Text {
        let windows = sim.windows(world, sim.WindowLimits { most: 4; kinds: 2; nodes: 3; horizon: 1000; shortest: 1; longest: 100 })
        for a in 0..windows.length {
            for b in a + 1..windows.length {
                let x = windows[a]
                let y = windows[b]
                if x.kind != y.kind || x.node != y.node || x.at >= y.at + y.length || y.at >= x.at + x.length { continue }
                sim.reached(world, "two dark windows overlap")
                for c in b + 1..windows.length {
                    let z = windows[c]
                    if z.kind == x.kind && z.node == x.node && max(max(x.at, y.at), z.at) < min(min(x.at + x.length, y.at + y.length), z.at + z.length) {
                        return "beacon \(x.node) was dark three times over"
                    }
                }
            }
        }
        return ""
    }
    """#)

// The text after `prefix` up to the end of its line.
function lineAfter(text: Text, prefix: Text): Text {
    let start = text.find(prefix)
    if start < 0 { return "" }
    let rest = text.slice(start + prefix.length, text.length)
    let end = rest.find("\n")
    if end < 0 { return rest }
    return rest.slice(0, end)
}

let environment = system.environment()
if runsCases(requestedCases, "lanterns") {
let both = test.run([launcher, "sim", "lanterns", "--seeds", "50", "--jobs", "3"], environment, application, work + "/both", 600)
test.check(both.status == 1, "a failing universe makes sim exit with status one\n" + both.output + both.errorOutput)
test.check(both.errorOutput == "", "sim writes its report to standard output\n" + both.errorOutput)
test.check(test.contains(both.output, "sim lanterns: ") && test.contains(both.output, " of 50 universes failed (seeds 0..49, 3 jobs, "), "failures across three jobs are counted once\n" + both.output)
let first = lineAfter(both.output, "  first: seed ")
let colon = first.find(": ")
test.check(colon > 0 && test.contains(first, "lost the lantern at "), "the first failure names its seed and message\n" + both.output)
let seed = first.slice(0, colon)
let message = first.slice(colon + 2, first.length)
test.check(test.contains(both.output, "  replayed its decisions twice: same result\n  reproduce: minyar sim lanterns --seed " + seed + "\n"), "the first failure is replayed and reproducible\n" + both.output)
let saved = lineAfter(both.output, "  decisions: ")
test.check(saved != "" && test.contains(both.output, "  replay: minyar sim lanterns --replay " + saved + "\n"), "the failing decisions are saved\n" + both.output)

test.check(test.contains(both.output, "  shrunk from ") && test.contains(both.output, " replays: lost the lantern at "), "the failure is shrunk\n" + both.output)
let shrunk = lineAfter(both.output, "  shrunk decisions: ")
let transcript = io.readTextFile(lineAfter(both.output, "  transcript: "))
test.check(test.contains(transcript, "guide ") == false && test.contains(transcript, "choose 10 ") && test.contains(transcript, "advance "), "the shrunk run's World transcript is saved\n" + transcript)
let shrunkRun = test.run([launcher, "sim", "lanterns", "--replay", shrunk], environment, application, work + "/shrunk", 600)
test.check(shrunkRun.status == 1 && test.contains(shrunkRun.output, "sim lanterns: the recorded run failed: lost the lantern at "), "shrunk decisions still fail\n" + shrunkRun.output + shrunkRun.errorOutput)
let failing = test.run([launcher, "sim", "lanterns", "--seed", seed], environment, application, work + "/failing", 600)
test.check(failing.status == 1 && failing.output == "sim lanterns: seed " + seed + " failed: " + message + "\n", "the reported seed fails again alone\n" + failing.output + failing.errorOutput)
let replayed = test.run([launcher, "sim", "lanterns", "--replay", saved], environment, application, work + "/replayed", 600)
test.check(replayed.status == 1 && replayed.output == "sim lanterns: the recorded run failed: " + message + "\n", "saved decisions fail again\n" + replayed.output + replayed.errorOutput)
}

if runsCases(requestedCases, "options") {
let filtered = test.run([launcher, "sim", "quiet", "--seeds", "5", "--first", "100"], environment, application, work + "/filtered", 600)
test.check(filtered.status == 0 && test.contains(filtered.output, "sim quiet: ran 5 universes, no failures (seeds 100..104, 1 jobs, ") && !test.contains(filtered.output, "lanterns"), "filter and first seed\n" + filtered.output + filtered.errorOutput)
}

if runsCases(requestedCases, "vault") {
let explored = test.run([launcher, "sim", "vault", "--explore", "--seeds", "3000"], environment, application, work + "/explored", 600)
test.check(explored.status == 1 && test.contains(explored.output, "sim vault: explored ") && test.contains(explored.output, "universes; one failed (") && test.contains(explored.output, "forked from recorded moments)"), "exploration reaches the vault\n" + explored.output + explored.errorOutput)
test.check(test.contains(explored.output, "  replayed its decisions twice: same result\n") && test.contains(explored.output, "  moments reached: first tumbler, second tumbler, third tumbler\n"), "explored failures replay and report their moments\n" + explored.output)
let vaultMessage = lineAfter(explored.output, "  first: seed ")
let vaultFile = lineAfter(explored.output, "  decisions: ")
let vaultReplay = test.run([launcher, "sim", "vault", "--replay", vaultFile], environment, application, work + "/vault-replay", 600)
let vaultOpened = vaultMessage.slice(vaultMessage.find(": ") + 2, vaultMessage.length)
test.check(vaultReplay.status == 1 && vaultReplay.output == "sim vault: the recorded run failed: " + vaultOpened + "\n", "an explored failure reproduces from its decisions\n" + vaultReplay.output + explored.output)
}

if runsCases(requestedCases, "beacons") {
let plainBeacons = test.run([launcher, "sim", "beacons", "--seeds", "3000"], environment, application, work + "/beacons-plain", 600)
test.check(plainBeacons.status == 0 && test.contains(plainBeacons.output, "sim beacons: ran 3000 universes, no failures"), "plain seeds miss the beacons\n" + plainBeacons.output + plainBeacons.errorOutput)
let beacons = test.run([launcher, "sim", "beacons", "--explore", "--seeds", "3000"], environment, application, work + "/beacons", 600)
test.check(beacons.status == 1 && test.contains(beacons.output, "universes; one failed (") && test.contains(beacons.output, " from mutated fault windows)") && test.contains(beacons.output, "was dark three times over"), "mutating declared fault windows finds the beacons\n" + beacons.output + beacons.errorOutput)
test.check(test.contains(beacons.output, "  replayed its decisions twice: same result\n"), "a mutated run replays from its decisions\n" + beacons.output)
let beaconsFile = lineAfter(beacons.output, "  decisions: ")
let beaconsReplay = test.run([launcher, "sim", "beacons", "--replay", beaconsFile], environment, application, work + "/beacons-replay", 600)
test.check(beaconsReplay.status == 1 && test.contains(beaconsReplay.output, "sim beacons: the recorded run failed: beacon "), "a mutated failure reproduces from its saved decisions\n" + beaconsReplay.output + beaconsReplay.errorOutput)
}

if runsCases(requestedCases, "options") {
let unmatched = test.run([launcher, "sim", "no such scenario"], environment, application, work + "/unmatched", 60)
test.check(unmatched.status != 0 && test.contains(unmatched.errorOutput, "no simulation in sim/ matched no such scenario"), "unmatched filter\n" + unmatched.errorOutput)
let zero = test.run([launcher, "sim", "--seeds", "0"], environment, application, work + "/zero", 60)
test.check(zero.status != 0 && test.contains(zero.errorOutput, "--seeds and --jobs must be at least 1"), "zero seeds rejected\n" + zero.errorOutput)
let word = test.run([launcher, "sim", "--jobs", "many"], environment, application, work + "/word", 60)
test.check(word.status != 0 && test.contains(word.errorOutput, "--jobs requires a nonnegative integer"), "non-numeric jobs rejected\n" + word.errorOutput)
let misplaced = test.run([launcher, "build", "--seeds", "3"], environment, application, work + "/misplaced", 60)
test.check(misplaced.status != 0 && test.contains(misplaced.errorOutput, "--seeds is not supported by build"), "sim options belong to sim\n" + misplaced.errorOutput)

// State kept in a module global leaks between universes in one process; the
// static proof allows it, so sim compares a seed run alone with the batch.
io.writeTextFile(application + "/sim/leaky.min", #"""
    use "simulation" as sim
    global SEEN: List<Integer> = []

    public function universe(world: sim.World): Text {
        SEEN.add(sim.choose(world, 10))
        if SEEN.length > 3 { sim.advance(world, sim.choose(world, 2)) }
        return ""
    }
    """#)
let leaky = test.run([launcher, "sim", "leaky", "--seeds", "20"], environment, application, work + "/leaky", 600)
test.check(leaky.status == 1 && test.contains(leaky.output, "sim leaky: seed 19 ran differently alone than after 19 earlier universes in one process; the universes share state through a module global"), "shared global state between universes is reported\n" + leaky.output + leaky.errorOutput)

// A universe that reads the host clock never runs: the generated driver's
// deterministic wrapper makes it a compile error.
io.writeTextFile(application + "/sim/clock.min", "use \"simulation\" as sim\nuse \"system\" as system\npublic function universe(world: sim.World): Text { if system.monotonicNanoseconds() % 2 == 0 { return \"even\" }; return \"\" }\n")
let clock = test.run([launcher, "sim", "clock"], environment, application, work + "/clock", 600)
test.check(clock.status == 1 && test.contains(clock.errorOutput, "deterministic function 'attempt' can reach the host clock: attempt -> universe -> monotonicNanoseconds (native \"system\")") && !test.contains(clock.output, "universes"), "host clock rejected before any universe runs\n" + clock.output + clock.errorOutput)
}

// The pinned production neo-db engine: random statements, a crash keeping
// part of the WAL, recovery checked against acknowledged commits.
// Run from a copy so concurrent checks never share the project's target directory.
function neodbProject(work: Text, root: Text, environment: List<Text>): Text {
    let neodbWork = work + "/neodb"
    host.makeDirectories(neodbWork + "/tests/fixtures")
    let copied = test.run(["cp", "-R", root + "/tests/neodb-sim", root + "/tests/fixtures/neodb-engine", neodbWork + "/tests/"], environment, root, work + "/neodb-copy", 60)
    test.require(copied, "copy the neo-db simulation project")
    let moved = test.run(["mv", neodbWork + "/tests/neodb-engine", neodbWork + "/tests/fixtures/neodb-engine"], environment, root, work + "/neodb-move", 60)
    test.require(moved, "place the engine fixture")
    return neodbWork + "/tests/neodb-sim"
}

if runsCases(requestedCases, "durable") {
let neodb = neodbProject(work, root, environment)
let durable = test.run([launcher, "sim", "--manifest-path", neodb, "durable", "--seeds", "500", "--jobs", "2"], environment, root, work + "/neodb-durable", 900)
test.check(durable.status == 0 && test.contains(durable.output, "sim durable: ran 500 universes, no failures (seeds 0..499, 2 jobs, ") && test.contains(durable.output, "crash cut a file's tail"), "neo-db recovers every acknowledged commit\n" + durable.output + durable.errorOutput)
}

if runsCases(requestedCases, "early") {
let neodb = neodbProject(work, root, environment)
let early = test.run([launcher, "sim", "--manifest-path", neodb, "early-ack", "--seeds", "100", "--jobs", "2"], environment, root, work + "/neodb-early", 900)
test.check(early.status == 1 && test.contains(early.output, " of 100 universes failed (") && test.contains(early.output, "instead of 0:1/0 ") && test.contains(early.output, "  replayed its decisions twice: same result\n"), "acknowledging before durability is caught and reproduced\n" + early.output + early.errorOutput)
}

test.removeTree(work)
print("Simulation CLI: passed")
