use "io" as io
use "process" as processInfo
use "../tools/testing.min" as test
use "./tar-test-support.min" as support
use "system" as system

let sanitize = false
let artifacts = ""
let optionIndex = 0
while optionIndex < processInfo.argumentCount() {
    let option = processInfo.argument(optionIndex)
    if option == "--sanitize" { sanitize = true }
    else if option == "--artifacts" { test.check(optionIndex + 1 < processInfo.argumentCount(), "missing tar review artifact directory"); optionIndex += 1; artifacts = processInfo.argument(optionIndex) }
    else { fail("unknown tar review option: " + option) }
    optionIndex += 1
}
test.check(artifacts != "", "--artifacts is required")
let scratch = test.scratch()
let context = support.context(scratch)
support.build(context, ["mkdir", "-p", "--", artifacts], 10)
let location = support.run(context, ["readlink", "-f", "--", artifacts], 10)
test.require(location, "tar review artifact directory")
context.directory = test.lines(location.output)[0]
support.review(context, sanitize)
io.writeTextFile(context.directory + "/results.json", "{\"sanitize\":" + Text(sanitize) + ",\"failures\":[]}\n")
test.removeTree(scratch)
