use "io" as io
use "../tools/testing.min" as test
use "./frontend-fixtures.min" as fixtures

function body(ir: Text, name: Text): Text {
    let found = false
    let complete = false
    let parts: List<Text> = []
    for line in test.lines(ir) {
        if !found && test.contains(line, "define ") && (test.contains(line, "@.minyar.fn." + name + "(") || test.moduleFunction(line, name)) { found = true }
        else if found {
            if line == "}" { complete = true; break }
            parts.add(line + "\n")
        }
    }
    test.check(found && complete, "missing try consumption function " + name)
    return joinText(parts)
}

function count(source: Text, needle: Text): Integer {
    let found = 0
    let rest = source
    let position = rest.find(needle)
    while position >= 0 {
        found += 1
        rest = rest.slice(position + needle.length, rest.length)
        position = rest.find(needle)
    }
    return found
}

let frontend = fixtures.fixture("MINYAR_TEST_COMPILER", "./build/minyarc")
let compiler = frontend.compiler
// Node's cycle runs through List<Node>, which grow mutates, so Node is traced
// and a Result carrying it is taken through the traced form.
let source = #"""
    record Node { name: Text; children: List<Node> }

    function word(index: Integer): Result<Text, Text> {
        if index < 0 { return Err("negative " + Text(index)) }
        return Ok("w" + Text(index))
    }
    function number(index: Integer): Result<Integer, Text> {
        if index > 5 { return Err("large " + Text(index)) }
        return Ok(index * 10)
    }
    function check(index: Integer): Result<Nothing, Text> {
        if index == 3 { return Err("three") }
        return Ok()
    }
    function joined(first: Integer, second: Integer): Result<Text, Text> {
        let left = try word(first)
        let right = try word(second)
        return Ok(left + "+" + right)
    }
    function total(first: Integer, second: Integer): Result<Integer, Text> {
        try check(first)
        return Ok((try number(first)) + (try number(second)))
    }
    function cached(store: List<Result<Text, Text>>, index: Integer): Result<Text, Text> {
        return store[index]
    }
    function shared(store: List<Result<Text, Text>>, index: Integer): Result<Integer, Text> {
        let text = try cached(store, index)
        return Ok(text.length)
    }
    function borrowed(index: Integer): Result<Text, Text> {
        let result = word(index)
        let text = try result
        return Ok(text + "!")
    }
    function grow(node: Node): Result<Node, Text> {
        node.children.add(Node { name: node.name + "'"; children: [] })
        return Ok(node)
    }
    function traced(node: Node): Result<Integer, Text> {
        let grown = try grow(node)
        return Ok(grown.children.length)
    }
    function show(result: Result<Text, Text>) {
        match result {
            Ok(value) { print("ok " + value) }
            Err(message) { print("err " + message) }
        }
    }
    function showNumber(result: Result<Integer, Text>) {
        match result {
            Ok(value) { print("ok " + Text(value)) }
            Err(message) { print("err " + message) }
        }
    }

    show(joined(1, 2))
    show(joined(1, -2))
    show(joined(-1, 2))
    showNumber(total(1, 2))
    showNumber(total(3, 2))
    showNumber(total(1, 7))
    let store: List<Result<Text, Text>> = [word(4), word(-4)]
    showNumber(shared(store, 0))
    showNumber(shared(store, 1))
    show(store[0])
    show(store[1])
    show(borrowed(5))
    show(borrowed(-5))
    let node = Node { name: "root" + "!"; children: [] }
    showNumber(traced(node))
    showNumber(traced(node))
    """#
let expected = "ok w1+w2\nerr negative -2\nerr negative -1\nok 30\nerr three\nerr large 7\nok 2\nerr negative -4\nok w4\nerr negative -4\nok w5!\nerr negative -5\nok 1\nok 2\n"

test.require(fixtures.compile(frontend, source), "compile try consumption IR")
let ir = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
// A fresh untraced Result is consumed by try: no temporary owner and one
// release on each failing return. Whole-program builds return these Results in
// two registers: a function whose returns all build their Result in place has a
// `NAME.r` body returning [tag, payload], its consumed tries call `.r` and take no
// record, only a failing branch rebuilds one, and `NAME` boxes for other callers.
let joinedBody = body(ir, "joined.r")
test.check(count(joinedBody, "call i64 @minyar_record_take_field(") == 0 && count(joinedBody, "call [2 x i64] @") == 2, "joined: each try takes its payload from the callee's registers")
test.check(count(joinedBody, "call ptr @minyar_result_box(") == 2 && count(joinedBody, "call void @minyar_rc_release(") == 2, "joined: each failing branch rebuilds and releases the failing Result")
test.check(count(joinedBody, "@minyar_record_new") == 0 && count(joinedBody, "ret [2 x i64] ") == 3, "joined: every return builds its Result in registers")
test.check(count(joinedBody, "@minyar_rc_keep(ptr %value.0)") == 0, "joined: a consumed Result is not a statement temporary")
let joinedWrapper = body(ir, "joined")
test.check(count(joinedWrapper, ".r(") == 1 && count(joinedWrapper, "call ptr @minyar_record_new") == 2 && count(joinedWrapper, "_box(") == 0, "joined: other callers get the Result boxed inline, one record per tag")
let totalBody = body(ir, "total.r")
test.check(count(totalBody, "call i64 @minyar_record_take_field(") == 0 && count(totalBody, "call [2 x i64] @") == 3, "total: scalar and payload-free successes come in registers")
test.check(count(totalBody, "@minyar_rc_keep(") == 0, "total: scalar and payload-free tries keep no temporaries")
// A returned stored Result keeps the record ABI; its caller takes at run time
// and the runtime keeps a shared Result intact.
test.check(count(ir, "cached.r(") == 0, "cached: a function returning a stored Result keeps its record")
test.check(count(body(ir, "shared.r"), "call i64 @minyar_record_take_field(") == 1, "shared: a returned Result is taken; the runtime keeps a shared one intact")
// A borrowed Result keeps the ordinary temporary.
test.check(count(body(ir, "borrowed.r"), "call i64 @minyar_record_take_field(") == 0 && count(body(ir, "borrowed.r"), "@minyar_rc_keep(") > 0, "borrowed: try on a local keeps its protecting count")
// A traced payload is taken through the collector-aware form: the payload is
// retained with a traced retain and the Result released, not freed in place.
let tracedBody = body(ir, "traced.r")
test.check(test.contains(ir, "; minyar-cycle-runtime: 1\n"), "traced: Node activates the cycle runtime")
test.check(count(ir, "grow.r(") == 0, "traced: a Result carrying a traced payload keeps its record")
test.check(count(tracedBody, "call i64 @minyar_record_take_field_traced(") == 1 && count(tracedBody, "call i64 @minyar_record_take_field(") == 0, "traced: a Result carrying a traced payload is taken through the traced form")
test.check(count(tracedBody, "@minyar_rc_keep(ptr %value.0)") == 0, "traced: the consumed Result is not a statement temporary")
test.check(count(joinedBody, "_traced(") == 0, "joined: untraced takes stay plain in a cycle program")
fixtures.executes(frontend, source, expected, ["-O0", "-O2"], 0, "", true)

// Tree could lie on a cycle through List<Tree>, but no code mutates such a
// List, so the cycle runtime never traces it: its Results are taken plainly.
let quiet = #"""
    record Tree { name: Text; kids: List<Tree> }

    function make(depth: Integer): Result<Tree, Text> {
        if depth < 0 { return Err("negative " + Text(depth)) }
        if depth == 0 { return Ok(Tree { name: "leaf" + "!"; kids: [] }) }
        let child = try make(depth - 1)
        let other = try make(depth - 1)
        return Ok(Tree { name: "node" + Text(depth); kids: [child, other] })
    }
    function size(tree: Tree): Integer {
        let total = tree.name.length
        for kid in tree.kids { total += size(kid) }
        return total
    }
    function measure(depth: Integer): Result<Integer, Text> {
        let tree = try make(depth)
        return Ok(size(tree))
    }
    function show(result: Result<Integer, Text>) {
        match result {
            Ok(value) { print("ok " + Text(value)) }
            Err(message) { print("err " + message) }
        }
    }

    show(measure(3))
    show(measure(-1))
    show(measure(0))
    """#
test.require(fixtures.compile(frontend, quiet), "compile untraced cycle-capable try IR")
let quietIR = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
test.check(!test.contains(quietIR, "; minyar-cycle-runtime: 1\n") && !test.contains(quietIR, "_traced("), "quiet: an unmutated cycle-capable type stays untraced")
// Untraced is only known at module end here, so these Results keep records.
test.check(count(body(quietIR, "make"), "call i64 @minyar_record_take_field(") == 2, "quiet: both tries take their payloads")
test.check(count(body(quietIR, "measure.r"), "call i64 @minyar_record_take_field(") == 1, "quiet: measure (returning an Integer Result in registers) takes its tree")
fixtures.executes(frontend, quiet, "ok 75\nerr negative -1\nok 5\n", ["-O0", "-O2"], 0, "", true)

// A fresh two-case Result or choice whose cases carry at most one untraced
// payload is consumed by a match of plain case arms or an `is` test: the arm
// or test takes the payload and disposes of the record when it starts, so a
// call of a function returning such a value in registers builds no record.
let pairs = #"""
    choice Two {
        Small(value: Integer)
        Named(name: Text)
    }
    choice Opt {
        Have(value: Integer)
        Gone
    }
    function two(n: Integer): Two {
        if n % 3 == 0 { return Two.Named("n" + Text(n)) }
        return Two.Small(n * 2)
    }
    function opt(n: Integer): Opt {
        if n % 2 == 0 { return Opt.Have(n) }
        return Opt.Gone
    }
    function check(n: Integer): Result<Integer, Text> {
        if n % 5 == 0 { return Err("five " + Text(n)) }
        return Ok(n + 1)
    }
    function describe(n: Integer): Text {
        return match two(n) {
            Small(value) { "small " + Text(value) }
            Named(name) { name + "!" }
        }
    }
    function firstNamed(limit: Integer): Text {
        let i = 0
        while i < limit {
            match two(i) {
                Small(_) { i += 1 }
                Named(name) {
                    if i > 4 { return name }
                    i += 1
                }
            }
        }
        return "none"
    }
    function score(n: Integer, texts: List<Text>): Integer {
        let total = 0
        match check(n) {
            Ok(v) { total += v }
            Err(message) { texts.add(message) }
        }
        match check(n) {
            Ok(_) { total += 1 }
            Err(_) { total += 2 }
        }
        if opt(n) is Have(v) { total += v }
        if opt(n) is Gone { total += 100 }
        if two(n) is Named(name) { texts.add(name) }
        if two(n) is Small(s) { total += s }
        return total
    }
    function kept(n: Integer): Integer {
        let value = two(n)
        return match value {
            Small(s) { s }
            Named(name) { name.length }
        }
    }

    let texts: List<Text> = []
    let total = 0
    for n in 0..12 { total += score(n, texts) + kept(n) }
    print(Text(total))
    print(firstNamed(20))
    for n in 0..4 { print(describe(n)) }
    for text in texts { print(text) }
    """#
test.require(fixtures.compile(frontend, pairs), "compile consumed pair choice IR")
let pairsIR = io.readTextFile(compiler.directory + "/case" + Text(compiler.serial) + ".ll")
test.check(count(body(pairsIR, "two.r"), "@minyar_record_new") == 0 && count(body(pairsIR, "opt.r"), "@minyar_record_new") == 0, "pairs: two-case choices return in registers")
test.check(count(body(pairsIR, "two"), "call ptr @minyar_record_new") == 2 && count(body(pairsIR, "two"), "_box(") == 0, "pairs: other callers get the choice boxed inline, one record per tag")
let scoreBody = body(pairsIR, "score")
test.check(count(scoreBody, "call [2 x i64] @") == 6 && count(scoreBody, "@minyar_record_take_field(") == 0 && count(scoreBody, "@.minyar.record.result.consume(") == 0, "pairs: consumed matches and is tests read the callee's registers")
test.check(count(body(pairsIR, "describe"), "call [2 x i64] @") == 1 && count(body(pairsIR, "firstNamed"), "call [2 x i64] @") == 1, "pairs: a returned or looping match consumes its input")
test.check(count(body(pairsIR, "kept"), "two.r(") == 0, "pairs: a match on a local keeps the record")
fixtures.executes(frontend, pairs, "905\nn6\nn0!\nsmall 2\nsmall 4\nn3!\nfive 0\nn0\nn3\nfive 5\nn6\nn9\nfive 10\n", ["-O0", "-O2"], 0, "", true)
test.removeTree(compiler.directory)
print("Result try consumption: passed")
