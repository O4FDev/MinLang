// Application-shaped fixture: four rolling shared snapshots and small updates.
// This is not an exchange/order-book implementation.
record EventRow { price: Integer; label: Text; history: List<Integer> }
record EventSnapshot { rows: List<EventRow>; sequence: Integer }

function rebuildSnapshot(old: EventSnapshot, width: Integer, sequence: Integer): EventSnapshot {
    let rows: List<EventRow> = []
    let i = 0
    while i < width {
        if old.rows.length > 0 && (i + sequence) % 4 == 0 {
            rows.add(old.rows[i])
        } else {
            let price = (sequence * 97 + i * 13) % 1000003
            rows.add(EventRow { price: price; label: Text(40000 + price); history: [price, price + 1, price + 2, price + 3] })
        }
        i = i + 1
    }
    return EventSnapshot { rows: rows; sequence: sequence }
}

function eventSetup(width: Integer): List<EventSnapshot> {
    let empty = EventSnapshot { rows: []; sequence: 0 }
    let snapshots: List<EventSnapshot> = []
    let i = 0
    while i < 4 {
        snapshots.add(rebuildSnapshot(empty, width, i))
        i = i + 1
    }
    return snapshots
}

function eventValues(): List<Integer> {
    let values: List<Integer> = []
    let i = 0
    while i < 257 { values.add(i); i = i + 1 }
    return values
}

// Five owners fit the K8 admission limit; eight fit K32 but not K8.
function eventOwners5(seed: Integer): Integer {
    let a = Text(40000 + seed)
    let b = Text(40001 + seed)
    let c = Text(40002 + seed)
    let d = Text(40003 + seed)
    let cut = a.slice(1, a.length)
    return a.length + b.length + c.length + d.length + cut.length
}

function eventOwners8(seed: Integer): Integer {
    let a = Text(40000 + seed)
    let b = Text(40001 + seed)
    let c = Text(40002 + seed)
    let d = Text(40003 + seed)
    let e = Text(40004 + seed)
    let f = Text(40005 + seed)
    let g = Text(40006 + seed)
    let h = Text(40007 + seed)
    return a.length + b.length + c.length + d.length + e.length + f.length + g.length + h.length
}

function eventApply(snapshots: List<EventSnapshot>, values: List<Integer>, width: Integer,
                    sequence: Integer, seed: Integer, shockEvery: Integer): Integer {
    let state = (seed * 17 + sequence * 23) % 1000003
    let slot = (sequence / shockEvery) % 4
    if sequence % shockEvery == 0 {
        snapshots[slot] = rebuildSnapshot(snapshots[slot], width, sequence + 4)
    }
    let index = state % values.length
    values[index] = (values[index] + state) % 1000003
    let row = snapshots[slot].rows[state % width]
    return (values[index] + row.price + row.history[0] + row.label.length + eventOwners5(state) + eventOwners8(state)) % 1000003
}
