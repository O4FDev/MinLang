record Node { value: Integer; children: List<Node> }
function chain(size: Integer): Node {
    let node = Node { value: 0; children: [] }
    let i = 1
    while i < size {
        node = Node { value: i; children: [node] }
        i = i + 1
    }
    return node
}
let total = 0
let i = 0
while i < 20 {
    let root = chain(5000)
    total = total + root.value
    i = i + 1
}
print(total)
