// Real application modules, bounded world, prepared headless computations.
use "../examples/craft/terrain.min" as terrain
use "../examples/craft/blocks.min" as blocks
use "../examples/craft/meshing.min" as meshing
use "../examples/craft/physics.min" as physics
use "../examples/craft/noise.min" as noise

function begin() { native "native_research" }
function extensions(): Integer { native "native_research" }

function smallWorld(): terrain.World {
    let dirty: List<Boolean> = []
    for chunk in 0..1024 { dirty.add(false) }
    let tops: List<Integer> = []
    for column in 0..1024 { tops.add(-1) }
    return terrain.World {
        blocks: Bytes(8192)
        sizeX: 32
        sizeZ: 32
        height: 8
        seed: 123
        dirty: dirty
        tops: tops
        torches: []
    }
}

let mode = argument(0)
let world = smallWorld()
if mode == "torch" {
    for repeat in 0..256 { terrain.set(world, 3, 3, 3, blocks.TORCH) }
    print(world.torches.length)
    print(world.torches[0])
    terrain.set(world, 4, 3, 3, blocks.TORCH)
    terrain.set(world, 5, 3, 3, blocks.TORCH)
    print(world.torches.length)
    terrain.set(world, 3, 3, 3, blocks.AIR)
    print(world.torches.length)
    terrain.set(world, 4, 3, 3, blocks.AIR)
    terrain.set(world, 5, 3, 3, blocks.AIR)
    print(world.torches.length)
    terrain.set(world, -1, 3, 3, blocks.TORCH)
    terrain.set(world, 32, 3, 3, blocks.TORCH)
    print(world.torches.length)
} else if mode == "mesh" {
    let solid = Bytes()
    let water = Bytes()
    terrain.set(world, 3, 1, 3, blocks.STONE)
    begin()
    meshing.buildChunk(world, 0, 0, solid, water)
    print(solid.length)
    print(water.length)
    print(extensions())
    if argumentCount() > 1 { writeBytesFile(argument(1), solid) }
    terrain.set(world, 4, 1, 3, blocks.STONE)
    begin()
    meshing.buildChunk(world, 0, 0, solid, water)
    print(solid.length)
    print(water.length)
    print(extensions())
    terrain.set(world, 3, 1, 3, blocks.WATER)
    terrain.set(world, 4, 1, 3, blocks.WATER)
    begin()
    meshing.buildChunk(world, 0, 0, solid, water)
    print(solid.length)
    print(water.length)
    print(extensions())
    terrain.set(world, 3, 1, 3, blocks.AIR)
    terrain.set(world, 4, 1, 3, blocks.AIR)
    for z in 0..16 { for x in 0..16 { terrain.set(world, x, 0, z, blocks.STONE) } }
    begin()
    meshing.buildChunk(world, 0, 0, solid, water)
    print(solid.length)
    print(water.length)
    print(extensions())
} else if mode == "noise" {
    print(noise.hash(0, 0, 123))
    print(noise.hash(-17, 19, -3))
    print(noise.hash(1000000, -2000000, 77))
    print(noise.valueNoise(-0.25, 1.75, 123))
    print(noise.fractalNoise(1.25, -2.75, 123, 4))
    let checksum = 0
    for z in -16..16 { for x in -16..16 { checksum += noise.hash(x, z, 123) } }
    print(checksum)
} else if mode == "physics" {
    terrain.set(world, 4, 2, 1, blocks.STONE)
    let player = physics.spawn(world)
    player.x = 4.5
    player.y = 1.0
    player.z = 4.5
    player.yaw = 0.0
    player.pitch = 0.0
    let hit = physics.aim(world, player, 4.0)
    print(hit.found)
    print(hit.x)
    print(hit.y)
    print(hit.z)
    print(hit.normalX)
    print(hit.normalY)
    print(hit.normalZ)
    print(physics.aim(world, player, 2.0).found)
} else {
    fail("unknown native research workload")
}
