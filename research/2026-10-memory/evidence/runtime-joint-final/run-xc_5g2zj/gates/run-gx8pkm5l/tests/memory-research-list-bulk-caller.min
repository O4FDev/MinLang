record Quote { sequence: Integer; label: Text }

function produce(state: List<Integer>, count: Integer): List<Integer> {
    state[0] = state[0] + 1
    state[2] = state[2] * 10 + 1
    let values: List<Integer> = []
    for i in 0..count { values.add(i * 37 + 11) }
    return values
}

function allocatingTail(state: List<Integer>): Integer {
    state[1] = state[1] + 1
    state[2] = state[2] * 10 + 2
    let noise: List<Text> = []
    for i in 0..128 { noise.add("tail" + Text(i)) }
    if noise[127] != "tail127" { return -1 }
    return 313
}

let state: List<Integer> = [0, 0, 0]
let original = produce(state, 3)
let alias = original
let extended = original.appended(allocatingTail(state))
print(state[2])
print(state[0])
print(state[1])
print(alias.length)
print(extended.length)
for value in alias { print(value) }
for value in extended { print(value) }
original[1] = 701
print(extended[1])
extended[2] = 907
print(alias[2])
for value in alias { print(value) }
for value in extended { print(value) }

state[0] = 0
state[1] = 0
state[2] = 0
let temporary = produce(state, 3).appended(allocatingTail(state))
print(state[2])
print(state[0])
print(state[1])
print(temporary.length)
print(temporary[0])
print(temporary[1])
print(temporary[2])
print(temporary[3])

state[0] = 0
state[1] = 0
state[2] = 0
let empty = produce(state, 0).appended(allocatingTail(state))
print(state[2])
print(state[0])
print(state[1])
print(empty.length)
print(empty[0])

let booleans: List<Boolean> = [true, false]
let booleanCopy = booleans.appended(true)
booleans[0] = false
print(booleans[0])
print(booleans[1])
print(booleanCopy[0])
print(booleanCopy[1])
print(booleanCopy[2])
let characters: List<Character> = [Character(233), Character(128578)]
let characterCopy = characters.appended(Character(65))
characters[0] = Character(66)
print(Integer(characters[0]))
print(Integer(characters[1]))
print(Integer(characterCopy[0]))
print(Integer(characterCopy[1]))
print(Integer(characterCopy[2]))
let floats: List<Float> = [0.5, 1.25]
let floatCopy = floats.appended(2.25)
floats[0] = 7.5
print(floats[0])
print(floats[1])
print(floatCopy[0])
print(floatCopy[1])
print(floatCopy[2])
let quote = Quote { sequence: 71; label: "quote" + "tail" }
let quotes: List<Quote> = [quote]
let quoteCopy = quotes.appended(quote)
quote.sequence = 73
print(quotes[0].sequence)
print(quoteCopy[0].sequence)
print(quoteCopy[1].sequence)
quotes[0] = Quote { sequence: 90; label: "new" + "member" }
print(quotes[0].sequence)
print(quoteCopy[0].sequence)
print(quoteCopy[1].sequence)
