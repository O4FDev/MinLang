// Original projection of compiler.min's escaped-literal piece assembly.
// Full lexer diagnostics, source maps and compiler execution are outside scope.
function pieces(source: Text): List<Text> {
    let result: List<Text> = []
    let position = 0
    let first = 0
    while position < source.length {
        if source[position] == '\\' && position + 1 < source.length {
            if first < position { result.add(source.slice(first, position)) }
            let escaped = source[position + 1]
            if escaped == 'n' { result.add(Text('\n')) }
            else if escaped == 'r' { result.add(Text('\r')) }
            else if escaped == 't' { result.add(Text('\t')) }
            else { result.add(Text(escaped)) }
            position += 2
            first = position
        } else { position += 1 }
    }
    if first < position { result.add(source.slice(first, position)) }
    return result
}

let mode = argument(0)
let input = "left\\ncenter\\tend"
if mode == "unicode" { input = "é\\n🙂\\éend" }
if mode == "empty" { input = "" }
if mode == "single" { input = "one" }
// Own the input before indexing so an immortal literal gains no permanent index.
let source = input + ""
let sourceAlias = source
let opaque = ""
if mode == "unknown" { opaque = readTextFile(argument(1)) }
print(-10001)
let fragments = pieces(source)
if mode == "unknown" { fragments.add(opaque) }
print(-10002)
let result = joinText(fragments)
print(-10003)
if mode != "no-query" {
    print(result.length)
    let sum = 0
    for character in result { sum += Integer(character) }
    print(sum)
}
print(-10004)
if mode != "no-query" {
    print(result.length)
    let sum = 0
    for character in result { sum += Integer(character) }
    print(sum)
}
print(-10005)
source = source + "!"
print(result)
print(result.byteLength)
print(sourceAlias)
print(source)
fragments = []
opaque = ""
source = ""
sourceAlias = ""
result = ""
print(-10006)
