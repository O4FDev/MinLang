// Actual terrain edits/remesh/upload with bytewise snapshots for an external oracle.
use "../examples/craft/terrain.min" as terrain
use "../examples/craft/meshing.min" as meshing

function open(): Integer { native "native_round2" }
function checkUpload(handle: Integer, vertices: Bytes) { native "native_round2" }
function finish(first: Integer, second: Integer) { native "native_round2" }
function startEvidence(path: Text) { native "native_round2" }
function emit(blocks: Bytes, metadata: Bytes, solid: Bytes, water: Bytes) { native "native_round2" }
function endEvidence() { native "native_round2" }

let dirty: List<Boolean> = []
for chunk in 0..1024 { dirty.add(false) }
let tops: List<Integer> = []
for column in 0..4096 { tops.add(-1) }
let world = terrain.World {
    blocks: Bytes(65536)
    sizeX: 64
    sizeZ: 64
    height: 16
    seed: 123
    dirty: dirty
    tops: tops
    torches: []
}
let events = readBytesFile(argument(0))
let solid = Bytes()
let water = Bytes()
let alias = solid
let metadata = Bytes()
let first = open()
let second = open()
startEvidence(argument(1))
let event = 0
while event * 24 < events.length {
    let offset = event * 24
    for chunk in 0..1024 { world.dirty[chunk] = false }
    terrain.set(world, events.getInt32(offset), events.getInt32(offset + 4), events.getInt32(offset + 8), events.getInt32(offset + 12))
    let chunkX = events.getInt32(offset + 16)
    let chunkZ = events.getInt32(offset + 20)
    meshing.buildChunk(world, chunkX, chunkZ, solid, water)
    checkUpload(first, alias)
    checkUpload(second, water)
    metadata.clear()
    metadata.addInt32(event)
    metadata.addInt32(chunkX)
    metadata.addInt32(chunkZ)
    for top in world.tops { metadata.addInt32(top) }
    for changed in world.dirty {
        if changed { metadata.add(1) } else { metadata.add(0) }
    }
    metadata.addInt32(world.torches.length)
    for torch in world.torches { metadata.addInt32(torch) }
    emit(world.blocks, metadata, alias, water)
    event += 1
}
endEvidence()
finish(first, second)
print(event)
