record Quote { sequence: Integer; symbol: Text }

function appendSequence(values: List<Integer>, sequence: Integer): List<Integer> {
    return values.appended(sequence)
}

let original: List<Integer> = []
let index = 0
while index < 1024 {
    original.add(index * 37)
    index = index + 1
}
let originalAlias = original
let current = original
index = 0
while index < 128 {
    current = appendSequence(current, index)
    index = index + 1
}
let total = 0
index = 0
while index < current.length {
    total = total + current[index]
    index = index + 1
}
print(originalAlias.length)
print(originalAlias[1023])
print(current.length)
print(current[1024])
print(current[1151])
print(total)

let quotes: List<Quote> = []
index = 0
while index < 257 {
    quotes.add(Quote { sequence: index; symbol: "MIN" + "YAR" })
    index = index + 1
}
let alias = quotes
let extended = quotes.appended(Quote { sequence: 999; symbol: "NEW" + "!" })
quotes = []
print(alias.length)
print(alias[256].sequence)
print(alias[256].symbol)
print(extended.length)
print(extended[0].symbol)
print(extended[257].symbol)
