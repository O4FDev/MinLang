# Swift's compiler uses LLVM style. Keep Minyar's existing four-space indents
# and Rust's 100-column ceiling; do not rewrite diagnostic or mutation fixtures.
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: InlineOnly
SortIncludes: Never
