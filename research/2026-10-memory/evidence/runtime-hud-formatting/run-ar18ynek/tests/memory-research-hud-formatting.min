// Original headless projection of Craft HUD's Integer formatting call mix.
// Coordinates are already floored; clock input is an integer minute counter.
function twoDigits(value: Integer): Text {
    if value < 10 { return "0" + Text(value) }
    return Text(value)
}
function hud(x: Integer, y: Integer, z: Integer, fps: Integer, minutes: Integer): Text {
    let status = "Minyarcraft  " + Text(fps) + " fps\n"
    status += "Position " + Text(x) + " " + Text(y) + " " + Text(z) + "  facing north\n"
    status += "Time " + twoDigits(minutes / 60) + ":" + twoDigits(minutes % 60)
    return status
}
function frames(mode: Integer, count: Integer): Text {
    let saved = ""
    for frame in 0..count {
        let x = 16 + frame % 16
        if mode == 1 { x = frame }
        if mode == 2 { x = 0 - frame - 1 }
        let status = hud(x, 64, -1, 60, (frame + 360) % 1440)
        if frame == 0 { saved = status }
        print(status)
        status = ""
    }
    return saved
}
let mode = 0
if argument(0) == "positive" { mode = 1 }
if argument(0) == "negative" { mode = 2 }
let count = 2048
if argument(1) == "pilot" { count = 16 }
let first = frames(mode, count)
print(1)
let second = frames(mode, count)
print(2)
print(first)
print(second)
first = ""
second = ""
print(3)
