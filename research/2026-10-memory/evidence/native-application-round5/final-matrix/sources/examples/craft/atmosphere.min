// Time of day: the sky colour, how bright the world is, the sun and moon, and
// clouds drifting overhead.

use "graphics" as graphics
use "./blocks.min" as blocks
use "./noise.min" as noise

constant DAY_SECONDS = 600.0
constant TAU = 6.283185307179586
constant CLOUD_HEIGHT = 108.0
constant CLOUD_CELL = 12.0
constant CLOUD_SPEED = 1.2
constant CLOUD_THICKNESS = 4.0
// The cloud grid covers 60 by 60 cells, from 20 cells before the origin.
constant CLOUD_CELLS = 60

// `time` runs from 0 to 1 over a day: 0 is sunrise, 0.25 noon, 0.5 sunset and
// 0.75 midnight.
public record Sky {
    time: Float
    red: Float
    green: Float
    blue: Float
    light: Float
    bodies: Integer
    clouds: Integer
    cloudDrift: Float
    cloudTimer: Float
    vertices: Bytes
}

public function create(time: Float): Sky {
    let sky = Sky {
        time: time
        red: 0.0
        green: 0.0
        blue: 0.0
        light: 1.0
        bodies: graphics.createMesh()
        clouds: graphics.createMesh()
        cloudDrift: 0.0
        cloudTimer: 0.0
        vertices: Bytes()
    }
    advance(sky, 0.0, 1.0)
    buildClouds(sky)
    return sky
}

function blend(from: Float, to: Float, amount: Float): Float {
    return from + (to - from) * amount
}

// Move time forward; `speed` multiplies how fast the day passes.
public function advance(sky: Sky, seconds: Float, speed: Float) {
    sky.time = (sky.time + seconds * speed / DAY_SECONDS) % 1.0
    let height = sin(sky.time * TAU)
    let day = clamp(height * 2.5 + 0.35, 0.0, 1.0)
    sky.light = 0.2 + 0.8 * day
    let glow = clamp(1.0 - abs(height) * 4.0, 0.0, 1.0) * 0.55
    sky.red = blend(blend(0.02, 0.53, day), 0.96, glow)
    sky.green = blend(blend(0.03, 0.72, day), 0.56, glow)
    sky.blue = blend(blend(0.09, 0.98, day), 0.36, glow)
    sky.cloudDrift += seconds * CLOUD_SPEED
    sky.cloudTimer += seconds
    if sky.cloudTimer > 0.25 {
        sky.cloudTimer = 0.0
        buildClouds(sky)
    }
}

// A square 400 blocks from the camera toward the unit direction (dx, dy, dz),
// drawn from both sides, with its edges level with the horizon as seen from
// the camera. `size` is half its width. Only the middle 12 pixels of the tile
// are used, so edges never sample the neighbouring tile.
function body(vertices: Bytes, cx: Float, cy: Float, cz: Float, dx: Float, dy: Float, dz: Float, size: Float, tile: Integer) {
    // Right is level and perpendicular to the direction; up completes the frame.
    let rightLength = sqrt(dx * dx + dz * dz)
    let rx = -dz / rightLength * size
    let rz = dx / rightLength * size
    let ux = -dy * dx / rightLength * size
    let uy = rightLength * size
    let uz = -dy * dz / rightLength * size
    let x = cx + dx * 400.0
    let y = cy + dy * 400.0
    let z = cz + dz * 400.0
    let margin = 2.0 / 256.0
    let u0 = Float(tile % 16) / 16.0 + margin
    let v0 = Float(tile / 16) / 16.0 + margin
    let u1 = u0 + 0.0625 - 2.0 * margin
    let v1 = v0 + 0.0625 - 2.0 * margin
    let ax = x - rx - ux
    let ay = y - uy
    let az = z - rz - uz
    let bx = x + rx - ux
    let by = y - uy
    let bz = z + rz - uz
    let ex = x + rx + ux
    let ey = y + uy
    let ez = z + rz + uz
    let fx = x - rx + ux
    let fy = y + uy
    let fz = z - rz + uz
    graphics.addVertex(vertices, ax, ay, az, u0, v1, 1.0, 1.0, 1.0)
    graphics.addVertex(vertices, bx, by, bz, u1, v1, 1.0, 1.0, 1.0)
    graphics.addVertex(vertices, ex, ey, ez, u1, v0, 1.0, 1.0, 1.0)
    graphics.addVertex(vertices, ax, ay, az, u0, v1, 1.0, 1.0, 1.0)
    graphics.addVertex(vertices, ex, ey, ez, u1, v0, 1.0, 1.0, 1.0)
    graphics.addVertex(vertices, fx, fy, fz, u0, v0, 1.0, 1.0, 1.0)
    graphics.addVertex(vertices, ax, ay, az, u0, v1, 1.0, 1.0, 1.0)
    graphics.addVertex(vertices, ex, ey, ez, u1, v0, 1.0, 1.0, 1.0)
    graphics.addVertex(vertices, bx, by, bz, u1, v1, 1.0, 1.0, 1.0)
    graphics.addVertex(vertices, ax, ay, az, u0, v1, 1.0, 1.0, 1.0)
    graphics.addVertex(vertices, fx, fy, fz, u0, v0, 1.0, 1.0, 1.0)
    graphics.addVertex(vertices, ex, ey, ez, u1, v0, 1.0, 1.0, 1.0)
}

// A soft round glow 410 blocks from the camera toward the unit direction
// (dx, dy, dz), behind a sun or moon. Its colour runs from `strength` of the
// way from the sky toward (red, green, blue) in the middle to exactly the sky
// colour at the rim, so it fades out without an edge.
function halo(sky: Sky, vertices: Bytes, cx: Float, cy: Float, cz: Float, dx: Float, dy: Float, dz: Float, radius: Float, red: Float, green: Float, blue: Float, strength: Float) {
    let rightLength = sqrt(dx * dx + dz * dz)
    let rx = -dz / rightLength
    let rz = dx / rightLength
    let ux = -dy * dx / rightLength
    let uy = rightLength
    let uz = -dy * dz / rightLength
    let x = cx + dx * 410.0
    let y = cy + dy * 410.0
    let z = cz + dz * 410.0
    let u = Float(blocks.TILE_CLOUD % 16) / 16.0 + 0.03
    let v = Float(blocks.TILE_CLOUD / 16) / 16.0 + 0.03
    let middleRed = blend(sky.red, red, strength)
    let middleGreen = blend(sky.green, green, strength)
    let middleBlue = blend(sky.blue, blue, strength)
    let segments = 24
    for segment in 0..segments {
        let a = Float(segment) * TAU / Float(segments)
        let b = Float(segment + 1) * TAU / Float(segments)
        let ax = x + (rx * cos(a) + ux * sin(a)) * radius
        let ay = y + uy * sin(a) * radius
        let az = z + (rz * cos(a) + uz * sin(a)) * radius
        let bx = x + (rx * cos(b) + ux * sin(b)) * radius
        let by = y + uy * sin(b) * radius
        let bz = z + (rz * cos(b) + uz * sin(b)) * radius
        graphics.addVertex(vertices, x, y, z, u, v, middleRed, middleGreen, middleBlue)
        graphics.addVertex(vertices, ax, ay, az, u, v, sky.red, sky.green, sky.blue)
        graphics.addVertex(vertices, bx, by, bz, u, v, sky.red, sky.green, sky.blue)
        graphics.addVertex(vertices, x, y, z, u, v, middleRed, middleGreen, middleBlue)
        graphics.addVertex(vertices, bx, by, bz, u, v, sky.red, sky.green, sky.blue)
        graphics.addVertex(vertices, ax, ay, az, u, v, sky.red, sky.green, sky.blue)
    }
}

function cloudFace(vertices: Bytes, ax: Float, ay: Float, az: Float, bx: Float, by: Float, bz: Float, cx: Float, cy: Float, cz: Float, dx: Float, dy: Float, dz: Float, shade: Float, u: Float, v: Float) {
    graphics.addVertex(vertices, ax, ay, az, u, v, shade, shade, shade)
    graphics.addVertex(vertices, bx, by, bz, u, v, shade, shade, shade)
    graphics.addVertex(vertices, cx, cy, cz, u, v, shade, shade, shade)
    graphics.addVertex(vertices, ax, ay, az, u, v, shade, shade, shade)
    graphics.addVertex(vertices, cx, cy, cz, u, v, shade, shade, shade)
    graphics.addVertex(vertices, dx, dy, dz, u, v, shade, shade, shade)
}

// Whether a cloud fills a cell of the grid built in buildClouds.
function cloudAt(filled: List<Boolean>, cellX: Integer, cellZ: Integer): Boolean {
    if cellX < 0 || cellZ < 0 || cellX >= CLOUD_CELLS || cellZ >= CLOUD_CELLS {
        return false
    }
    return filled[cellZ * CLOUD_CELLS + cellX]
}

// Clouds are slabs with sides, shaded like blocks, where neighbouring cells
// merge into one shape.
function buildClouds(sky: Sky) {
    let vertices = sky.vertices
    vertices.clear()
    let shift = Integer(floor(sky.cloudDrift / CLOUD_CELL))
    let offset = sky.cloudDrift - Float(shift) * CLOUD_CELL
    let u = Float(blocks.TILE_CLOUD % 16) / 16.0 + 0.03
    let v = Float(blocks.TILE_CLOUD / 16) / 16.0 + 0.03
    // Small ragged clumps, about twice as wide east to west as north to south.
    let filled: List<Boolean> = []
    for cellZ in 0..CLOUD_CELLS {
        for cellX in 0..CLOUD_CELLS {
            let density = noise.fractalNoise(Float(cellX - 20 + shift) / 3.5, Float(cellZ - 20) / 1.8, 31337, 3)
            filled.add(density > 0.6)
        }
    }
    let y0 = CLOUD_HEIGHT
    let y1 = CLOUD_HEIGHT + CLOUD_THICKNESS
    for cellZ in 0..CLOUD_CELLS {
        for cellX in 0..CLOUD_CELLS {
            if filled[cellZ * CLOUD_CELLS + cellX] {
                // Neighbouring cells compute shared edges the same way, so
                // they meet exactly, without cracks.
                let x0 = Float(cellX - 20) * CLOUD_CELL - offset
                let z0 = Float(cellZ - 20) * CLOUD_CELL
                let x1 = Float(cellX - 19) * CLOUD_CELL - offset
                let z1 = Float(cellZ - 19) * CLOUD_CELL
                cloudFace(vertices, x0, y1, z0, x0, y1, z1, x1, y1, z1, x1, y1, z0, 1.0, u, v)
                cloudFace(vertices, x0, y0, z0, x1, y0, z0, x1, y0, z1, x0, y0, z1, 0.72, u, v)
                if !cloudAt(filled, cellX + 1, cellZ) {
                    cloudFace(vertices, x1, y0, z0, x1, y1, z0, x1, y1, z1, x1, y0, z1, 0.88, u, v)
                }
                if !cloudAt(filled, cellX - 1, cellZ) {
                    cloudFace(vertices, x0, y0, z0, x0, y0, z1, x0, y1, z1, x0, y1, z0, 0.88, u, v)
                }
                if !cloudAt(filled, cellX, cellZ + 1) {
                    cloudFace(vertices, x0, y0, z1, x1, y0, z1, x1, y1, z1, x0, y1, z1, 0.8, u, v)
                }
                if !cloudAt(filled, cellX, cellZ - 1) {
                    cloudFace(vertices, x0, y0, z0, x0, y1, z0, x1, y1, z0, x1, y0, z0, 0.8, u, v)
                }
            }
        }
    }
    graphics.updateMesh(sky.clouds, vertices)
}

// Draw the sun and moon, with their glows, around a camera before anything else.
public function draw(sky: Sky, x: Float, y: Float, z: Float) {
    let angle = sky.time * TAU
    let dx = cos(angle)
    let dy = sin(angle)
    let dz = 0.3
    let length = sqrt(dx * dx + dy * dy + dz * dz)
    let vertices = sky.vertices
    vertices.clear()
    halo(sky, vertices, x, y, z, dx / length, dy / length, dz / length, 120.0, 1.0, 0.95, 0.7, 0.28)
    halo(sky, vertices, x, y, z, -dx / length, -dy / length, -dz / length, 80.0, 0.8, 0.85, 1.0, 0.14)
    body(vertices, x, y, z, dx / length, dy / length, dz / length, 45.0, blocks.TILE_SUN)
    body(vertices, x, y, z, -dx / length, -dy / length, -dz / length, 30.0, blocks.TILE_MOON)
    graphics.updateMesh(sky.bodies, vertices)
    graphics.setLight(1.0)
    graphics.setFog(sky.red, sky.green, sky.blue, 5000.0, 6000.0)
    graphics.drawMesh(sky.bodies)
}

// Draw the clouds as solid shapes, so only their nearest faces show. This
// changes the fog, which the caller restores for anything drawn afterwards.
public function drawClouds(sky: Sky) {
    graphics.setLight(sky.light)
    graphics.setFog(sky.red, sky.green, sky.blue, 160.0, 420.0)
    graphics.drawMesh(sky.clouds)
}
