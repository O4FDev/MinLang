function makeText(): Text {
    let text = "" + ""
    let index = 0
    while index < 4096 {
        text = text + "abcdefgh"
        index = index + 1
    }
    return text
}

// A temporary batch holds the caller's value as its final member. Its List
// becomes unreachable when this synchronous function returns.
function retiredBatch(value: Text): Integer {
    let batch: List<Text> = []
    let index = 0
    while index < 64 {
        batch.add("retired" + "!")
        index = index + 1
    }
    batch.add(value)
    return batch.length
}

let text = makeText()
let retired = retiredBatch(text)
text = text + "!"
print(retired)
print(text.length)
print(text[0])
print(text[32768])

let shared = makeText()
let alias = shared
let retiredShared = retiredBatch(shared)
shared = shared + "!"
print(retiredShared)
print(alias.length)
print(alias[32767])
print(shared.length)

let backing = makeText()
let view = backing.slice(0, 16384)
let retiredView = retiredBatch(backing)
backing = backing + "!"
print(retiredView)
print(view.length)
print(view[16383])
print(backing.length)

let doubled = makeText()
let retiredSelf = retiredBatch(doubled)
doubled = doubled + doubled
print(retiredSelf)
print(doubled.length)
print(doubled[32768])
