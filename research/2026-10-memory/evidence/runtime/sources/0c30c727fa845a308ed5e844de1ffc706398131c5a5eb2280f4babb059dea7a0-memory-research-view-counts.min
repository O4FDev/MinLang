let mode = argument(0)
let rootLength = 4097
let tokenLength = 512
let survivors = 32
if mode == "4096-small" { rootLength = 4096; tokenLength = 511; survivors = 1 }
if mode == "4096-many" { rootLength = 4096; tokenLength = 512 }
if mode == "4097-small" { tokenLength = 511; survivors = 1 }
if mode == "4097-view" { tokenLength = 513; survivors = 1 }
if mode == "4097-many-views" { tokenLength = 513 }
if mode == "8192-small" { rootLength = 8192; tokenLength = 1023; survivors = 1 }
if mode == "8192-many-copies" { rootLength = 8192; tokenLength = 1023 }
if mode == "8192-view" { rootLength = 8192; tokenLength = 1024; survivors = 1 }
if mode == "8192-many-views" { rootLength = 8192; tokenLength = 1024 }
let root = ""
let index = 0
while index < rootLength { root = root + "x"; index += 1 }
let tokens: List<Text> = []
index = 0
while index < survivors { tokens.add(root.slice(0, tokenLength)); index += 1 }
root = ""
print(tokens.length)
let sum = 0
for token in tokens {
    sum += token.length
    if token[0] != 'x' { fail("bad first character") }
    if token[token.length - 1] != 'x' { fail("bad last character") }
}
print(sum)
tokens = []
