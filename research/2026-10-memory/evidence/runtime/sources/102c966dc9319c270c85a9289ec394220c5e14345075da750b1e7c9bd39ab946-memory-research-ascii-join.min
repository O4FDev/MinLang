function appendAndCount(source: Text): Integer {
    let joined = source + "!"
    return joined.length
}

function appendWithoutIndex(source: Text): Integer {
    let joined = source + "!"
    return joined.byteLength
}

let mode = "known"
if argumentCount() > 0 { mode = argument(0) }
// The runner supplies an empty second argument. Argument conversion starts with
// an unknown count in both variants, so construction does not confound joins.
let text = argument(1)
if mode == "short" {
    text = "abcdefgh"
} else {
    let index = 0
    let iterations = 8192
    let piece = "abcdefgh"
    if mode == "unicode" {
        iterations = 128
        piece = "é🙂"
    }
    while index < iterations {
        text = text + piece
        index += 1
    }
}
let initial = 0
if mode != "unknown" { initial = text.length }
let total = 0
let iteration = 0
while iteration < 128 {
    if mode == "no-query" {
        total += appendWithoutIndex(text)
    } else {
        total += appendAndCount(text)
    }
    iteration += 1
}
print(initial)
print(total)
print(text.byteLength)
