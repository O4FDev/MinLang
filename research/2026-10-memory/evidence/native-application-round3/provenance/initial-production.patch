+    nearest: Float
+    second: Float
+    dx: Float
+    dy: Float
+}
+
+function cell(px: Integer, py: Integer, grid: Integer, seed: Integer): Cell {
+    let result = Cell {
+        index: 0
+        nearest: 99.0
+        second: 99.0
+        dx: 0.0
+        dy: 0.0
+    }
+    let spacing = 16.0 / Float(grid)
+    for index in 0..grid * grid {
+        let pointX = (Float(index % grid) + 0.2 + 0.6 * noise.random(index, 1, seed)) * spacing
+        let pointY = (Float(index / grid) + 0.2 + 0.6 * noise.random(index, 2, seed)) * spacing
+        let dx = Float(px) + 0.5 - pointX
+        let dy = Float(py) + 0.5 - pointY
+        if dx > 8.0 { dx -= 16.0 } else if dx < -8.0 { dx += 16.0 }
+        if dy > 8.0 { dy -= 16.0 } else if dy < -8.0 { dy += 16.0 }
+        let distance = sqrt(dx * dx + dy * dy)
+        if distance < result.nearest {
+            result.second = result.nearest
+            result.nearest = distance
+            result.index = index
+            result.dx = dx
+            result.dy = dy
+        } else if distance < result.second {
+            result.second = distance
+        }
+    }
+    return result
