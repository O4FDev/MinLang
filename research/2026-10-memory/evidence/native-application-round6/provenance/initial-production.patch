+// Put an opaque colour written as 0xRRGGBB.
+function paint(pixels: Bytes, tile: Integer, px: Integer, py: Integer, colour: Integer) {
+    put(pixels, tile, px, py, colour >> 16, (colour >> 8) & 255, colour & 255, 255)
