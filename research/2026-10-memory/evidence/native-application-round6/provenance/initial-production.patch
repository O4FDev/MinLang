+
+function wrap(value: Integer, period: Integer): Integer {
+    return (value % period + period) % period
+}
+
+// Smooth noise from 0 to 1 that repeats every tile, so textures meet without
+// seams. There are `cellsX` lattice cells across the tile and `cellsY` down it.
+function tiled(px: Integer, py: Integer, cellsX: Integer, cellsY: Integer, seed: Integer): Float {
+    let x = (Float(px) + 0.5) * Float(cellsX) / 16.0
+    let y = (Float(py) + 0.5) * Float(cellsY) / 16.0
+    let x0 = floor(x)
+    let y0 = floor(y)
+    let ix = Integer(x0)
+    let iy = Integer(y0)
+    let fx = x - x0
+    let fy = y - y0
+    fx = fx * fx * (3.0 - 2.0 * fx)
+    fy = fy * fy * (3.0 - 2.0 * fy)
+    let a = noise.random(wrap(ix, cellsX), wrap(iy, cellsY), seed)
+    let b = noise.random(wrap(ix + 1, cellsX), wrap(iy, cellsY), seed)
+    let c = noise.random(wrap(ix, cellsX), wrap(iy + 1, cellsY), seed)
+    let d = noise.random(wrap(ix + 1, cellsX), wrap(iy + 1, cellsY), seed)
+    let near = a + (b - a) * fx
+    let far = c + (d - c) * fx
+    return near + (far - near) * fy
+}
+
+// The nearest of a jittered grid of points scattered over a repeating tile,
+// for stones and cells. `dx` and `dy` run from the point to the pixel.
+record Cell {
+    index: Integer
+    nearest: Float
+    second: Float
+    dx: Float
+    dy: Float
+}
+
+function cell(px: Integer, py: Integer, grid: Integer, seed: Integer): Cell {
+    let result = Cell {
+        index: 0
+        nearest: 99.0
+        second: 99.0
+        dx: 0.0
+        dy: 0.0
+    }
+    let spacing = 16.0 / Float(grid)
+    for index in 0..grid * grid {
+        let pointX = (Float(index % grid) + 0.2 + 0.6 * noise.random(index, 1, seed)) * spacing
+        let pointY = (Float(index / grid) + 0.2 + 0.6 * noise.random(index, 2, seed)) * spacing
+        let dx = Float(px) + 0.5 - pointX
+        let dy = Float(py) + 0.5 - pointY
+        if dx > 8.0 { dx -= 16.0 } else if dx < -8.0 { dx += 16.0 }
+        if dy > 8.0 { dy -= 16.0 } else if dy < -8.0 { dy += 16.0 }
+        let distance = sqrt(dx * dx + dy * dy)
+        if distance < result.nearest {
+            result.second = result.nearest
+            result.nearest = distance
+            result.index = index
+            result.dx = dx
+            result.dy = dy
+        } else if distance < result.second {
+            result.second = distance
+        }
+    }
+    return result
