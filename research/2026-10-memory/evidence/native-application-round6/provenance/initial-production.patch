+
+// The first colour whose limit is above `value`, or the last colour.
+function pick(value: Float, colours: List<Integer>, limits: List<Float>): Integer {
+    for index in 0..limits.length {
+        if value < limits[index] {
+            return colours[index]
+        }
+    }
+    return colours[colours.length - 1]
