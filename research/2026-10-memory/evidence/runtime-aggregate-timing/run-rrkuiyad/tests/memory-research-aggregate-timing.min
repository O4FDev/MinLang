// Repeated lexer-fragment-like aggregate joins; input assembly is outside loop.
function pieces(source: Text): List<Text> {
    let result: List<Text> = []
    let position = 0
    let first = 0
    while position < source.length {
        if source[position] == '\\' && position + 1 < source.length {
            if first < position { result.add(source.slice(first, position)) }
            let escaped = source[position + 1]
            if escaped == 'n' { result.add(Text('\n')) }
            else if escaped == 't' { result.add(Text('\t')) }
            else { result.add(Text(escaped)) }
            position += 2
            first = position
        } else { position += 1 }
    }
    if first < position { result.add(source.slice(first, position)) }
    return result
}
let mode = argument(0)
let repetitions = 0
for digit in argument(1) { repetitions = repetitions * 10 + Integer(digit) - 48 }
if repetitions <= 0 || repetitions > 1000000 { fail("invalid repetition count") }
let source = readTextFile(argument(2))
if source.byteLength > 8192 { fail("input exceeds declared payload bound") }
let alias = source
let fragments = pieces(source)
let opaque = ""
if mode == "unknown" {
    opaque = readTextFile(argument(3))
    fragments.add(opaque)
}
let result = ""
let checksum = 0
let iteration = 0
while iteration < repetitions {
    result = joinText(fragments)
    if mode == "no-query" { checksum += result.byteLength }
    else { checksum += result.length }
    iteration += 1
}
if result.byteLength != 4096 && result.byteLength != 15 { fail("output size changed") }
print(checksum)
print(result.byteLength)
print(result)
print(alias == source)
