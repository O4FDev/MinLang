+// Native Minyar syntax and source coordinates for the compiler's syntax tree.
+// This adapter is used at compile time, including by Swift macro plugins.
+@_spi(RawSyntax) public import SwiftSyntax
+
+extension Parser.ExperimentalFeatures {
+  public static let minyarSyntax = Self(rawValue: 1 << 31)
+}
+
+struct MinyarTokenOrigin {
+  let wholeStart: Int
+  let textStart: Int
+  let textEnd: Int
+  let wholeEnd: Int
+}
+
+@_spi(Minyar)
+public struct MinyarSourceMap: Sendable {
+  struct Segment: Sendable {
+    let syntaxStart: Int
+    let syntaxEnd: Int
+    let sourceStart: Int
+    let sourceEnd: Int
+  }
+  let segments: [Segment]
+  let inverse: [Segment]
+
+  init(_ segments: [Segment]) {
+    self.segments = segments.sorted { $0.syntaxStart < $1.syntaxStart }
+    self.inverse = segments.sorted {
+      ($0.sourceStart, $0.syntaxStart) < ($1.sourceStart, $1.syntaxStart)
+    }
+  }
+
+  public func sourceOffset(forSyntaxOffset offset: Int) -> Int {
+    var lower = 0
+    var upper = segments.count
+    while lower < upper {
+      let middle = (lower + upper) / 2
+      if segments[middle].syntaxStart <= offset { lower = middle + 1 }
+      else { upper = middle }
+    }
+    guard lower > 0 else { return offset }
+    let entry = segments[lower - 1]
+    return entry.sourceStart + min(max(0, offset - entry.syntaxStart), entry.sourceEnd - entry.sourceStart)
+  }
+
+  public func syntaxOffset(forSourceOffset offset: Int) -> Int {
+    var lower = 0
+    var upper = inverse.count
+    while lower < upper {
+      let middle = (lower + upper) / 2
+      if inverse[middle].sourceStart <= offset { lower = middle + 1 }
+      else { upper = middle }
+    }
+    guard lower > 0 else { return offset }
+    let entry = inverse[lower - 1]
+    return entry.syntaxStart + min(max(0, offset - entry.sourceStart), entry.syntaxEnd - entry.syntaxStart)
+  }
+}
+
+extension Lexer.Lexeme {
+  var minyarKeyword: Keyword? {
+    guard minyarSyntax, rawTokenKind == .keyword || rawTokenKind == .identifier else { return nil }
+    switch tokenText {
+    case "function": return .func
+    case "record": return .struct
+    case "constant": return .let
+    case "let": return .var
+    case "use": return .import
+    default: return nil
+    }
+  }
+
+  var keyword: Keyword? { minyarKeyword ?? Keyword(tokenText) }
+
+  func classifiedForMinyar(_ enabled: Bool) -> Self {
+    guard enabled else { return self }
+    var result = self
+    result.minyarSyntax = true
+    if result.minyarKeyword != nil { result.rawTokenKind = .keyword }
+    return result
+  }
+}
+
+extension Parser {
+  mutating func recordMinyarOrigin(_ result: RawTokenSyntax, lexeme: Lexer.Lexeme) {
+    guard experimentalFeatures.contains(.minyarSyntax) else { return }
+    let start = lexemes.offsetToStart(lexeme)
+    minyarOrigins[result.raw.id] = MinyarTokenOrigin(
+      wholeStart: start,
+      textStart: start + lexeme.leadingTriviaByteLength,
+      textEnd: start + lexeme.leadingTriviaByteLength + lexeme.textByteLength,
+      wholeEnd: start + lexeme.byteLength
+    )
+  }
+
+  mutating func minyarToken(_ lexeme: Lexer.Lexeme) -> RawTokenSyntax {
+    let replacement: SyntaxText?
+    if lexeme.rawTokenKind == .keyword {
+      replacement = lexeme.minyarKeyword?.defaultText
+    } else if lexeme.minyarSyntax && lexeme.rawTokenKind == .arrow && lexeme.tokenText == ":" {
+      replacement = "->"
+    } else {
+      replacement = nil
+    }
+    let whole: SyntaxText
+    let textRange: Range<Int>
+    if let replacement {
+      let leading = String(syntaxText: SyntaxText(rebasing: lexeme.wholeText[..<lexeme.textRange.lowerBound]))
+      let trailing = String(syntaxText: SyntaxText(rebasing: lexeme.wholeText[lexeme.textRange.upperBound...]))
+      whole = arena.intern(leading + String(syntaxText: replacement) + trailing)
+      textRange = lexeme.textRange.lowerBound..<(lexeme.textRange.lowerBound + replacement.count)
+    } else {
+      whole = lexeme.wholeText
+      textRange = lexeme.textRange
+    }
+    let result = RawTokenSyntax(kind: lexeme.rawTokenKind, wholeText: whole,
+      textRange: textRange, presence: .present, tokenDiagnostic: lexeme.diagnostic, arena: arena)
+    recordMinyarOrigin(result, lexeme: lexeme)
+    return result
+  }
+
+  mutating func minyarArgumentWildcard(before name: RawTokenSyntax) -> RawTokenSyntax {
+    let token = RawTokenSyntax(kind: .wildcard, text: "_", trailingTriviaPieces: [.spaces(1)],
+                              presence: .present, arena: arena)
+    if let origin = minyarOrigins[name.raw.id] {
+      minyarOrigins[token.raw.id] = MinyarTokenOrigin(wholeStart: origin.wholeStart,
+        textStart: origin.wholeStart, textEnd: origin.wholeStart, wholeEnd: origin.wholeStart)
+    }
+    return token
+  }
+
+  private func minyarOrigin(for token: TokenSyntax) -> MinyarTokenOrigin? {
+    if let origin = minyarOrigins[token.raw.id] { return origin }
+    // Multiline literal parsing moves indentation into trivia and rebuilds
+    // tokens. Their text still references the original arena-owned buffer.
+    guard token.presence == .present,
+          let view = token.raw.tokenView,
+          let address = view.rawText.baseAddress,
+          let base = minyarSourceBuffer.baseAddress,
+          address >= base, address <= base + minyarSourceBuffer.count,
+          view.rawText.count <= (base + minyarSourceBuffer.count) - address else { return nil }
+    let start = address - base
+    let end = start + view.rawText.count
+    let wholeStart = start - view.leadingTriviaByteLength
+    let wholeEnd = end + view.trailingTriviaByteLength
+    guard wholeStart >= 0, wholeEnd <= minyarSourceBuffer.count else { return nil }
+    return MinyarTokenOrigin(wholeStart: wholeStart, textStart: start,
+                             textEnd: end, wholeEnd: wholeEnd)
+  }
+
+  @_spi(Minyar)
+  public func minyarSourceMap(for syntax: some SyntaxProtocol) -> MinyarSourceMap {
+    var entries: [MinyarSourceMap.Segment] = []
+    for token in syntax.tokens(viewMode: .all) {
+      guard let origin = minyarOrigin(for: token) else { continue }
+      entries.append(.init(syntaxStart: token.position.utf8Offset,
+        syntaxEnd: token.positionAfterSkippingLeadingTrivia.utf8Offset,
+        sourceStart: origin.wholeStart, sourceEnd: origin.textStart))
+      entries.append(.init(syntaxStart: token.positionAfterSkippingLeadingTrivia.utf8Offset,
+        syntaxEnd: token.endPositionBeforeTrailingTrivia.utf8Offset,
+        sourceStart: origin.textStart, sourceEnd: origin.textEnd))
+      entries.append(.init(syntaxStart: token.endPositionBeforeTrailingTrivia.utf8Offset,
+        syntaxEnd: token.endPosition.utf8Offset,
+        sourceStart: origin.textEnd, sourceEnd: origin.wholeEnd))
+    }
+    return MinyarSourceMap(entries)
+  }
+
+  mutating func parseMinyarImportPath() -> RawImportPathComponentListSyntax {
+    let literal = parseStringLiteral()
+    func invalidPath() -> RawImportPathComponentListSyntax {
+      let component = RawImportPathComponentSyntax(
+        RawUnexpectedNodesSyntax([literal], arena: arena),
+        name: RawTokenSyntax(missing: .identifier, arena: arena),
+        trailingPeriod: nil, arena: arena)
+      return RawImportPathComponentListSyntax(elements: [component], arena: arena)
+    }
+    guard !literal.hasError, literal.segments.elements.count == 1,
+          let segment = literal.segments.elements.first?.as(RawStringSegmentSyntax.self) else {
+      return invalidPath()
+    }
+    let text = String(syntaxText: segment.content.tokenText)
+    let parts = text.split(separator: ".", omittingEmptySubsequences: false)
+    guard parts.allSatisfy({ part in
+      guard let first = part.unicodeScalars.first,
+            first.isValidIdentifierStartCodePoint else { return false }
+      return part.unicodeScalars.dropFirst().allSatisfy { $0.isValidIdentifierContinuationCodePoint }
+    }) else { return invalidPath() }
+    var elements: [RawImportPathComponentSyntax] = []
+    let sourceOrigin = minyarOrigins[segment.content.raw.id]
+    var offset = 0
+    for (index, part) in parts.enumerated() {
+      let last = index == parts.count - 1
+      let name = RawTokenSyntax(kind: .identifier, text: arena.intern(String(part)),
+        leadingTriviaPieces: index == 0 ? literal.openingQuote.leadingTriviaPieces : [],
+        trailingTriviaPieces: last ? literal.closingQuote.trailingTriviaPieces : [],
+        presence: .present, arena: arena)
+      let period: RawTokenSyntax? = last ? nil : RawTokenSyntax(kind: .period, text: ".", presence: .present, arena: arena)
+      if let origin = sourceOrigin {
+        let start = origin.textStart + offset
+        minyarOrigins[name.raw.id] = MinyarTokenOrigin(wholeStart: start,
+          textStart: start, textEnd: start + part.utf8.count, wholeEnd: start + part.utf8.count)
+        if let period {
+          let at = start + part.utf8.count
+          minyarOrigins[period.raw.id] = MinyarTokenOrigin(wholeStart: at, textStart: at, textEnd: at + 1, wholeEnd: at + 1)
+        }
+      }
+      elements.append(RawImportPathComponentSyntax(name: name, trailingPeriod: period, arena: arena))
+      offset += part.utf8.count + 1
+    }
+    return RawImportPathComponentListSyntax(elements: elements, arena: arena)
+  }
+}
