+/// Diagnostic rendering needs a lossless tree of the original bytes, rather
+/// than the canonical Swift spellings sent to macro plugins. Parser recovery
+/// retains unfamiliar Minyar tokens; this tree is used only for presentation.
+struct DiagnosticSourceFile {
+  let buffer: UnsafeBufferPointer<UInt8>
+  let syntax: Syntax
+  let sourceLocationConverter: SourceLocationConverter
+
+  init(_ source: ExportedSourceFile) {
+    buffer = source.buffer
+    if source.minyarSourceMap != nil {
+      var features = source.parserFeatures
+      features.remove(.minyarSyntax)
+      var parser = Parser(buffer, swiftVersion: source.parserSwiftVersion,
+                          experimentalFeatures: features)
+      syntax = Syntax(SourceFileSyntax.parse(from: &parser))
+      assert(syntax.syntaxTextBytes.elementsEqual(buffer))
+      sourceLocationConverter = SourceLocationConverter(fileName: source.fileName, tree: syntax)
+    } else {
+      syntax = source.syntax
+      sourceLocationConverter = source.sourceLocationConverter
+    }
+  }
+
+  func position(of location: BridgedSourceLoc) -> AbsolutePosition? {
+    guard let address = location.getOpaquePointerValue(), let base = buffer.baseAddress else {
+      return nil
+    }
+    let offset = address - UnsafeRawPointer(base)
+    guard offset >= 0, offset <= buffer.count else { return nil }
+    return AbsolutePosition(utf8Offset: offset)
+  }
+}
