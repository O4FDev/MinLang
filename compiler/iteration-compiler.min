// Iterable records use concrete methods, with no erased cursor or item type.
function iterationMethodTarget(context: CompilerContext, receiverType: Integer, member: Text, location: Integer): Integer {
    if !isRecordType(receiverType) { failAtToken(context.tokenLines, location, "iteration needs a record cursor with advance(): Boolean and current(): Item") }
    let name = methodFunctionName(context.functionNames[receiverType - 1000], member)
    let target = findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, name)
    if target < 0 {
        target = findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, methodFunctionName(context.functionNames[receiverType - 1000], member + "$private"))
        if target >= 0 {
            let declaration = context.syntax.symbolNodes[target]
            if declaration < 0 || tokenPath(context.tokenLines, context.syntax.nodes[declaration].start) != tokenPath(context.tokenLines, location) {
                failAtToken(context.tokenLines, location, "iteration method '" + member + "' is private to its module")
            }
        }
    }
    if target < 0 { failAtToken(context.tokenLines, location, "iteration needs a method named '" + member + "'") }
    if context.functionParameterCounts[target] != 1 { failAtToken(context.tokenLines, location, "iteration method '" + member + "' must take no arguments") }
    let offset = functionParameterOffset(context.functionParameterCounts, target)
    if context.functionParameterTypes[offset] != receiverType { failAtToken(context.tokenLines, location, "iteration method '" + member + "' has the wrong receiver type") }
    return target
}

function emitIterationCall(context: CompilerContext, output: List<Text>, textState: List<Text>, state: List<Integer>, target: Integer, receiver: Text, receiverType: Integer): Text {
    let types: List<Integer> = [receiverType]
    let arguments: List<Text> = [receiver]
    borrowReference(output, state, receiver, receiverType, context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes)
    if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "call", context.functionNames[target], threadSignature(context.functionReturnTypes[target], types)) }
    context.callTargets.add(target)
    state[14] = state[14] + 1
    let value = emitCall(output, textState, state, context.functionReturnTypes[target], context.functionIRNames[target], arguments, types)
    recoveryCheckpoint(output, textState, state)
    return value
}

function compileIterationFor(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, returnType: Integer, name: Text, source: Text, sourceType: List<Integer>, location: Integer, firstLoopLocal: Integer, sequenceStages: List<Integer>) {
    let iterator = iterationMethodTarget(context, sourceType[0], "iterator", location)
    let cursorType = context.functionReturnTypes[iterator]
    let advance = iterationMethodTarget(context, cursorType, "advance", location)
    let current = iterationMethodTarget(context, cursorType, "current", location)
    if context.functionReturnTypes[advance] != 4 { failAtToken(context.tokenLines, location, "iteration method 'advance' must return Boolean") }
    let elementType = context.functionReturnTypes[current]
    if elementType == 5 { failAtToken(context.tokenLines, location, "iteration method 'current' must return an item, not Nothing") }
    let collection = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, " for source", sourceType[0], collection)
    assignReference(output, state, collection, source, sourceType, context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes)
    storeLocal(output, collection, sourceType[0], source)
    let cursor = emitIterationCall(context, output, textState, state, iterator, source, sourceType[0])
    let cursorResult: List<Integer> = [cursorType]
    ownResult(output, state, cursor, cursorResult)
    let cursorLocal = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, " for cursor", cursorType, cursorLocal)
    assignReference(output, state, cursorLocal, cursor, cursorResult, context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes)
    storeLocal(output, cursorLocal, cursorType, cursor)
    let loopLabel = newLabel(state)
    let bodyLabel = newLabel(state)
    let stepLabel = newLabel(state)
    let endLabel = newLabel(state)
    output.add("  ; minyar-iteration: concrete iterator, advance and current calls\n")
    output.add("  br label %for.condition." + Text(loopLabel) + "\n\nfor.condition." + Text(loopLabel) + ":\n")
    textState[0] = "for.condition." + Text(loopLabel)
    let continuing = emitIterationCall(context, output, textState, state, advance, cursor, cursorType)
    output.add("  br i1 " + continuing + ", label %for.body." + Text(bodyLabel) + ", label %for.end." + Text(endLabel) + "\n\nfor.body." + Text(bodyLabel) + ":\n")
    textState[0] = "for.body." + Text(bodyLabel)
    let element = emitIterationCall(context, output, textState, state, current, cursor, cursorType)
    let elementResult: List<Integer> = [elementType]
    ownResult(output, state, element, elementResult)
    element = emitSequenceStages(context, output, textState, state, sequenceStages, element, elementResult, stepLabel, location)
    elementType = elementResult[0]
    let variable = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, name, elementType, variable)
    assignReference(output, state, variable, element, elementResult, context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes)
    storeLocal(output, variable, elementType, element)
    addLocal(localNames, localTypes, localIds, localLengths, state, " loop", -2, loopLabel)
    let bodyReturns = compileBlock(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType)
    if !bodyReturns { output.add("  br label %for.step." + Text(stepLabel) + "\n") }
    output.add("\nfor.step." + Text(stepLabel) + ":\n")
    textState[0] = "for.step." + Text(stepLabel)
    output.add("  call void @minyar_rc_step()\n")
    output.add("  br label %for.condition." + Text(loopLabel) + "\n\nfor.end." + Text(endLabel) + ":\n")
    textState[0] = "for.end." + Text(endLabel)
    let scoped = firstLoopLocal
    while scoped < state[3] {
        rootLocal(output, state, localIds[scoped], "null", localTypes[scoped])
        scoped = scoped + 1
    }
    state[3] = firstLoopLocal
}

function genericIterationElement(program: GenericProgram, source: Integer): Integer {
    let iterator = genericMemberType(program, source, "iterator", true)
    if iterator == 0 || program.types[iterator].name != "Callback" { return 0 }
    let cursor = program.types[iterator].arguments
    if cursor.length != 1 { return 0 }
    let current = genericMemberType(program, cursor[0], "current", true)
    if current == 0 || program.types[current].name != "Callback" { return 0 }
    let item = program.types[current].arguments
    if item.length != 1 { return 0 }
    return item[0]
}
