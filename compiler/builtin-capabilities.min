// The compiler embeds these ordinary capability declarations during bootstrap.
// Scalar values and finite record shapes retain their implicit conformances.
capability Equatable {
    function equal(other: Self): Boolean
}

capability Ordered {
    function compare(other: Self): Integer
    function equal(other: Self): Boolean { return self.compare(other) == 0 }
}

capability Hashable {
    function equal(other: Self): Boolean
    function hash(): Integer
}
