// Register coordinates are declaration metadata. The shared constant
// normalizer folds expressions before this typed declaration adapter runs.
function isDeclarationOperandBuiltin(name: Text): Boolean {
    return isCLayoutTypeBuiltin(name) || isRegisterLayoutBuiltin(name)
}

function takeRegisterCoordinate(context: CompilerContext, cursor: List<Integer>): Integer {
    let kinds = context.tokenKinds
    let texts = context.tokenTexts
    let lines = context.tokenLines
    skipTerminators(kinds, cursor)
    let location = cursor[0]
    let literal = location
    if kinds[location] == 1 {
        let symbol = findCompiledSymbol(context.functionNames, context.symbolKinds, lines.symbolLookup, texts[location], 3)
        if symbol < 0 { failAtToken(lines, location, "register coordinates require compile-time Integer constants") }
        let node = context.syntax.symbolNodes[symbol]
        if context.syntax.nodes[node].kind != 3 || context.functionReturnTypes[symbol] != 1 || context.functionParameterCounts[symbol] < 0 {
            failAtToken(lines, location, "register coordinates require compile-time Integer constants")
        }
        literal = context.functionParameterCounts[symbol]
        cursor[0] = location + 1
    } else {
        if texts[literal] == "-" { literal = literal + 1 }
        if kinds[literal] != 2 { failAtToken(lines, location, "register coordinates require compile-time Integer constants") }
        cursor[0] = literal + 1
        literal = location
    }
    let negative = texts[literal] == "-"
    if negative { literal = literal + 1 }
    if kinds[literal] != 2 { failAtToken(lines, location, "register coordinates require compile-time Integer constants") }
    skipTerminators(kinds, cursor)
    let digits = checkedIntegerLiteral(texts[literal], negative, lines, literal)
    let value = 0
    let index = 0
    while index < digits.length {
        value = value * 10 - (Integer(digits[index]) - 48)
        index = index + 1
    }
    if negative { return value }
    return 0 - value
}
