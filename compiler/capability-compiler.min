// The three capabilities are derived for scalar values and finite record shapes.
// Lists, Bytes, callbacks and recursive shapes have no implicit structural meaning.
function capabilityTypeSupported(type: Integer, counts: List<Integer>, fields: List<Integer>, names: List<Text>, path: List<Integer>): Boolean {
    if type == 1 || type == 2 || type == 3 || type == 4 || type == 7 || isScalarChoiceType(type) { return true }
    if !isRecordType(type) || isCallbackType(type, names) { return false }
    let record = recordTypeIndex(type)
    let position = 0
    while position < path.length {
        if path[position] == type { return false }
        position = position + 1
    }
    let nested: List<Integer> = []
    position = 0
    while position < path.length { nested.add(path[position]); position = position + 1 }
    nested.add(type)
    let first = functionParameterOffset(counts, record)
    position = 0
    while position < counts[record] {
        if fields[first + position] != 5 && !capabilityTypeSupported(fields[first + position], counts, fields, names, nested) { return false }
        position = position + 1
    }
    return true
}

function recordCapabilityHasNative(context: CompilerContext, type: Integer): Boolean {
    if !isRecordType(type) || isScalarChoiceType(type) { return false }
    if isCRecord(context, type) { return true }
    let record = recordTypeIndex(type)
    let first = functionParameterOffset(context.functionParameterCounts, record)
    let position = 0
    while position < context.functionParameterCounts[record] {
        if recordCapabilityHasNative(context, context.functionParameterTypes[first + position]) { return true }
        position = position + 1
    }
    return false
}

function explicitRecordCapability(context: CompilerContext, type: Integer, capability: Text): Boolean {
    if context.tokenLines.features / 256 % 2 == 0 || !isRecordType(type) || isCallbackType(type, context.functionNames) { return false }
    let name = methodFunctionName(context.functionNames[recordTypeIndex(type)], "conforms$" + capability)
    return findIndexedSymbol(context.tokenLines.symbolLookup, context.functionNames, context.symbolKinds, name, 2) >= 0
}

function explicitRecordEquality(context: CompilerContext, type: Integer): Boolean {
    return explicitRecordCapability(context, type, "Equatable") || explicitRecordCapability(context, type, "Ordered") || explicitRecordCapability(context, type, "Hashable")
}

function recordCapabilityTarget(context: CompilerContext, type: Integer, operation: Text): Integer {
    let supported = false
    if operation == "equal" { supported = explicitRecordEquality(context, type) }
    if operation == "compare" { supported = explicitRecordCapability(context, type, "Ordered") }
    if operation == "hash" { supported = explicitRecordCapability(context, type, "Hashable") }
    if !supported { return -1 }
    let receiver = context.functionNames[recordTypeIndex(type)]
    let target = findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, methodFunctionName(receiver, operation))
    if target < 0 { target = findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, methodFunctionName(receiver, operation + "$private")) }
    return target
}

function collectCapabilityTargets(context: CompilerContext, type: Integer, operation: Text, visited: List<Integer>, targets: List<Integer>) {
    let seen = 0
    while seen < visited.length { if visited[seen] == type { return }; seen = seen + 1 }
    visited.add(type)
    let target = recordCapabilityTarget(context, type, operation)
    if target >= 0 { targets.add(target); return }
    if isRecordType(type) && !isCallbackType(type, context.functionNames) && !isCRecord(context, type) {
        let record = recordTypeIndex(type)
        let offset = functionParameterOffset(context.functionParameterCounts, record)
        let field = 0
        while field < context.functionParameterCounts[record] {
            collectCapabilityTargets(context, context.functionParameterTypes[offset + field], operation, visited, targets)
            field = field + 1
        }
    }
    if operation == "equal" && (isMapType(type) || isSetType(type)) {
        let key = mapKeyType(type)
        if isSetType(type) { key = setElementType(type) }
        collectCapabilityTargets(context, key, "equal", visited, targets)
        if isMapType(type) { collectCapabilityTargets(context, mapValueType(type), "equal", visited, targets) }
    }
}

function capabilityTargets(context: CompilerContext, type: Integer, operation: Text): List<Integer> {
    let visited: List<Integer> = []
    let targets: List<Integer> = []
    collectCapabilityTargets(context, type, operation, visited, targets)
    return targets
}

function noteCapabilityCalls(context: CompilerContext, type: Integer, operation: Text, state: List<Integer>, textState: List<Text>, output: List<Text>): Boolean {
    if context.tokenLines.features / 256 % 2 == 0 { return false }
    let targets = capabilityTargets(context, type, operation)
    let index = 0
    while index < targets.length {
        let target = targets[index]
        context.callTargets.add(target)
        state[14] = state[14] + 1
        if state[15] / 4 % 2 != 0 {
            let types: List<Integer> = []
            let offset = functionParameterOffset(context.functionParameterCounts, target)
            let parameter = 0
            while parameter < context.functionParameterCounts[target] { types.add(context.functionParameterTypes[offset + parameter]); parameter = parameter + 1 }
            threadNote(output, textState[1], "call", context.functionNames[target], threadSignature(context.functionReturnTypes[target], types))
        }
        index = index + 1
    }
    return targets.length > 0
}

function noteHashableCalls(context: CompilerContext, type: Integer, state: List<Integer>, textState: List<Text>, output: List<Text>): Boolean {
    let hash = noteCapabilityCalls(context, type, "hash", state, textState, output)
    let equal = noteCapabilityCalls(context, type, "equal", state, textState, output)
    return hash || equal
}

function visitTypeCapability(context: CompilerContext, type: Integer, capability: Text, path: List<Integer>): Boolean {
    if type == 1 || type == 2 || type == 3 || type == 4 || type == 7 || isScalarChoiceType(type) { return true }
    if explicitRecordCapability(context, type, capability) || (capability == "Equatable" && explicitRecordEquality(context, type)) { return true }
    // A custom equality cannot inherit a field-wise hash or a different order.
    if (capability == "Hashable" || capability == "Ordered") && explicitRecordEquality(context, type) { return false }
    if capability == "Equatable" && isSetType(type) { return visitTypeCapability(context, setElementType(type), "Hashable", path) }
    if capability == "Equatable" && isMapType(type) {
        while isMapType(type) {
            if !visitTypeCapability(context, mapKeyType(type), "Hashable", path) { return false }
            type = mapValueType(type)
        }
        if isSetType(type) { return visitTypeCapability(context, setElementType(type), "Hashable", path) }
        return type == 1 || type == 2 || type == 3 || type == 4 || type == 7 || isScalarChoiceType(type)
    }
    if !isRecordType(type) || isCallbackType(type, context.functionNames) || isCRecord(context, type) { return false }
    let index = 0
    let nested: List<Integer> = []
    while index < path.length {
        if path[index] == type { return false }
        nested.add(path[index])
        index = index + 1
    }
    nested.add(type)
    let record = recordTypeIndex(type)
    let first = functionParameterOffset(context.functionParameterCounts, record)
    index = 0
    while index < context.functionParameterCounts[record] {
        let field = context.functionParameterTypes[first + index]
        if field != 5 && !visitTypeCapability(context, field, capability, nested) { return false }
        index = index + 1
    }
    return true
}

function typeSupportsCapability(context: CompilerContext, type: Integer, capability: Text): Boolean {
    if capability == "Iterable" || capability == "Iterator" { return iterationSupportsCapability(context, type, capability) }
    if capability != "Equatable" && capability != "Ordered" && capability != "Hashable" { return false }
    let path: List<Integer> = []
    return visitTypeCapability(context, type, capability, path)
}

function requireRecordCapability(context: CompilerContext, type: Integer, capability: Text, location: Integer) {
    if !typeSupportsCapability(context, type, capability) {
        if explicitRecordEquality(context, type) && (capability == "Hashable" || capability == "Ordered") { failAtToken(context.tokenLines, location, "record '" + readableDeclarationName(context.functionNames[recordTypeIndex(type)]) + "' is not " + capability + "; its custom equality needs an explicit " + capability + " conformance") }
        failCompiler(describeLocation(tokenLocation(context.tokenLines, location)) + ": record '" + readableDeclarationName(context.functionNames[recordTypeIndex(type)]) + "' is not " + capability + "; every field must be " + capability + " and the record shape must be finite; Lists, Bytes, callbacks, native records and recursive shapes need an explicit operation")
    }
}

function derivedRecordName(context: CompilerContext, type: Integer, operation: Text): Text {
    return "@\".minyar.derived." + operation + "|" + Text(type) + "|" + escapeLLVMText(tokenPath(context.tokenLines, 0)) + "\""
}

function derivedEnumFunction(name: Text, operation: Text, globals: List<Text>): Text {
    let resultType = "i64"
    if operation == "equal" { resultType = "zeroext i1" }
    let code = "define internal " + resultType + " " + name + "(i64 %left"
    if operation == "equal" || operation == "compare" { code = code + ", i64 %right" }
    code = code + ") {\nentry:\n"
    if operation == "equal" { code = code + "  %equal = icmp eq i64 %left, %right\n  ret i1 %equal\n" }
    if operation == "compare" {
        code = code + "  %greater = icmp sgt i64 %left, %right\n  %less = icmp slt i64 %left, %right\n  %positive = zext i1 %greater to i64\n  %negative = zext i1 %less to i64\n  %order = sub i64 %positive, %negative\n  ret i64 %order\n"
    }
    if operation == "hash" {
        let declaration = "declare i64 @minyar_hash_slot(i64, i64)\n"
        if findText(globals, declaration) < 0 { globals.add(declaration) }
        code = code + "  %hash = call i64 @minyar_hash_slot(i64 1, i64 %left)\n  ret i64 %hash\n"
    }
    if operation == "copy" { code = code + "  ret i64 %left\n" }
    globals.add(code + "}\n")
    return name
}

function derivedRecordFunction(context: CompilerContext, type: Integer, operation: Text, globals: List<Text>): Text {
    let name = derivedRecordName(context, type, operation)
    let marker = "; derived record " + name + "\n"
    if findText(globals, marker) >= 0 { return name }
    globals.add(marker)
    if isScalarChoiceType(type) { return derivedEnumFunction(name, operation, globals) }
    if choiceNicheType(context, type) != 0 { return derivedNicheChoice(context, type, operation, globals, name) }
    let resultType = "zeroext i1"
    if operation == "compare" || operation == "hash" { resultType = "i64" }
    if operation == "copy" { resultType = "ptr" }
    let code: List<Text> = []
    code.add("define internal " + resultType + " " + name + "(ptr %left")
    if operation == "equal" || operation == "compare" { code.add(", ptr %right") }
    code.add(") {\nentry:\n")
    code.add("  %left.absent = icmp eq ptr %left, null\n")
    if operation == "equal" || operation == "compare" {
        code.add("  %right.absent = icmp eq ptr %right, null\n  %either.absent = or i1 %left.absent, %right.absent\n  br i1 %either.absent, label %absent, label %present\nabsent:\n")
        if operation == "equal" { code.add("  %both.absent = and i1 %left.absent, %right.absent\n  ret i1 %both.absent\n") } else {
            code.add("  %left.zero = zext i1 %left.absent to i64\n  %right.zero = zext i1 %right.absent to i64\n  %absent.order = sub i64 %right.zero, %left.zero\n  ret i64 %absent.order\n")
        }
    } else {
        code.add("  br i1 %left.absent, label %absent, label %present\nabsent:\n")
        if operation == "copy" { code.add("  ret ptr null\n") } else { code.add("  ret i64 0\n") }
    }
    code.add("present:\n")
    let target = recordCapabilityTarget(context, type, operation)
    if target >= 0 {
        code.add("  %custom = call " + resultType + " @" + context.functionIRNames[target] + "(ptr %left")
        if operation == "equal" || operation == "compare" { code.add(", ptr %right") }
        code.add(")\n  ret " + llvmType(context.functionReturnTypes[target]) + " %custom\n}\n")
        globals.add(joinText(code))
        return name
    }
    let counts = context.functionParameterCounts
    let fields = context.functionParameterTypes
    let record = recordTypeIndex(type)
    let first = functionParameterOffset(counts, record)
    let result = "true"
    if operation == "compare" { result = "0" }
    if operation == "hash" { result = "1469598103934665603" }
    if operation == "copy" {
        result = "%copy"
        let storage = counts[record]
        if choiceCases(context, type).length > 0 { storage = choiceStorageCount(context, type) }
        code.add("  %copy = call ptr @minyar_record_new(i64 " + Text(storage) + ")\n")
    }
    let cases = choiceCases(context, type)
    let block = "present"
    let position = 0
    while position < counts[record] {
        let field = fields[first + position]
        let kind = field
        if isScalarChoiceType(kind) { kind = 1 }
        let id = Text(position)
        let slot = Text(choiceStorageField(context, type, position))
        let left = "%left." + id
        let right = "%right." + id
        let value = "%field." + id
        let previous = result
        let fieldBlock = "choice.active." + id
        let payload = cases.length > 0 && position > 0
        if payload {
            let parts = context.functionParameterNames[first + position].split("|")
            let variant = findText(cases, parts[1]) - 1
            code.add("  %active." + id + " = icmp eq i64 %left.0, " + Text(variant) + "\n")
            code.add("  br i1 %active." + id + ", label %choice.active." + id + ", label %choice.next." + id + "\nchoice.active." + id + ":\n")
        }
        code.add("  " + left + " = call i64 @minyar_record_get(ptr %left, i64 " + slot + ")\n")
        if operation == "equal" || operation == "compare" { code.add("  " + right + " = call i64 @minyar_record_get(ptr %right, i64 " + slot + ")\n") }
        if operation == "copy" {
            if isRecordType(field) && !isScalarChoiceType(field) {
                let child = derivedRecordFunction(context, field, operation, globals)
                code.add("  %pointer." + id + " = inttoptr i64 " + left + " to ptr\n")
                code.add("  " + value + " = call ptr " + child + "(ptr %pointer." + id + ")\n")
                code.add("  %slot." + id + " = ptrtoint ptr " + value + " to i64\n")
                code.add("  call void @minyar_record_set_take(ptr %copy, i64 " + slot + ", i64 %slot." + id + ")\n")
            } else {
                let setter = "minyar_record_set"
                if field == 2 { setter = "minyar_record_set_reference" }
                code.add("  call void @" + setter + "(ptr %copy, i64 " + slot + ", i64 " + left + ")\n")
            }
        } else {
            if isRecordType(field) && !isScalarChoiceType(field) {
                let child = derivedRecordFunction(context, field, operation, globals)
                code.add("  %left.pointer." + id + " = inttoptr i64 " + left + " to ptr\n")
                if operation != "hash" { code.add("  %right.pointer." + id + " = inttoptr i64 " + right + " to ptr\n") }
                code.add("  " + value + " = call " + resultType + " " + child + "(ptr %left.pointer." + id)
                if operation != "hash" { code.add(", ptr %right.pointer." + id) }
                code.add(")\n")
            } else {
                if operation == "equal" {
                    if isMapType(field) || isSetType(field) {
                        declareMapRuntime(globals)
                        let declaration = "declare zeroext i1 @minyar_maps_are_equal(ptr, ptr, i64)\n"
                        if findText(globals, declaration) < 0 { globals.add(declaration) }
                        let valueType = mapValueType(field)
                        if isSetType(field) { valueType = 4 }
                        code.add("  %left.pointer." + id + " = inttoptr i64 " + left + " to ptr\n")
                        code.add("  %right.pointer." + id + " = inttoptr i64 " + right + " to ptr\n")
                        code.add("  " + value + " = call zeroext i1 @minyar_maps_are_equal(ptr %left.pointer." + id + ", ptr %right.pointer." + id + ", i64 " + Text(valueType) + ")\n")
                    } else {
                    if field == 2 {
                        let declaration = "declare zeroext i1 @minyar_equal_slots(i64, i64, i64)\n"
                        if findText(globals, declaration) < 0 { globals.add(declaration) }
                        code.add("  " + value + " = call zeroext i1 @minyar_equal_slots(i64 2, i64 " + left + ", i64 " + right + ")\n")
                    } else {
                        if field == 7 {
                            code.add("  %left.float." + id + " = bitcast i64 " + left + " to double\n")
                            code.add("  %right.float." + id + " = bitcast i64 " + right + " to double\n")
                            code.add("  " + value + " = fcmp oeq double %left.float." + id + ", %right.float." + id + "\n")
                        } else { code.add("  " + value + " = icmp eq i64 " + left + ", " + right + "\n") }
                    }
                    }
                } else {
                    if operation == "compare" {
                        if position == 0 && field == 4 && resultTypeName(type, context.functionNames) {
                            code.add("  " + value + " = call i64 @minyar_compare_slots(i64 4, i64 " + right + ", i64 " + left + ")\n")
                        } else { code.add("  " + value + " = call i64 @minyar_compare_slots(i64 " + Text(kind) + ", i64 " + left + ", i64 " + right + ")\n") }
                    }
                    if operation == "hash" { code.add("  " + value + " = call i64 @minyar_hash_slot(i64 " + Text(kind) + ", i64 " + left + ")\n") }
                }
            }
            if context.tokenLines.features / 8 % 2 != 0 && capabilityTargets(context, field, operation).length > 0 {
                code.add("  %pending." + id + " = call i32 @minyar_recovery_pending()\n  %failed." + id + " = icmp ne i32 %pending." + id + ", 0\n  br i1 %failed." + id + ", label %capability.unwind." + id + ", label %capability.ready." + id + "\ncapability.unwind." + id + ":\n")
                if operation == "equal" { code.add("  ret i1 false\n") } else { code.add("  ret i64 0\n") }
                code.add("capability.ready." + id + ":\n")
                fieldBlock = "capability.ready." + id
                if !payload { block = fieldBlock }
            }
            if operation == "equal" { code.add("  %result." + id + " = and i1 " + result + ", " + value + "\n") }
            if operation == "compare" {
                code.add("  %undecided." + id + " = icmp eq i64 " + result + ", 0\n")
                code.add("  %result." + id + " = select i1 %undecided." + id + ", i64 " + value + ", i64 " + result + "\n")
            }
            if operation == "hash" {
                code.add("  %mixed." + id + " = xor i64 " + result + ", " + value + "\n")
                code.add("  %result." + id + " = mul i64 %mixed." + id + ", 1099511628211\n")
            }
            result = "%result." + id
        }
        if payload {
            code.add("  br label %choice.next." + id + "\nchoice.next." + id + ":\n")
            if operation != "copy" {
                let phiType = "i64"
                if operation == "equal" { phiType = "i1" }
                code.add("  %choice.result." + id + " = phi " + phiType + " [ " + previous + ", %" + block + " ], [ " + result + ", %" + fieldBlock + " ]\n")
                result = "%choice.result." + id
            }
            block = "choice.next." + id
        }
        if cases.length > 0 && position == 0 && (operation == "equal" || operation == "compare") {
            let same = result
            if operation == "compare" {
                same = "%same.case"
                code.add("  %same.case = icmp eq i64 " + result + ", 0\n")
            }
            code.add("  br i1 " + same + ", label %choice.same, label %choice.different\nchoice.different:\n")
            if operation == "equal" { code.add("  ret i1 false\n") } else { code.add("  ret i64 " + result + "\n") }
            code.add("choice.same:\n")
            block = "choice.same"
        }
        position = position + 1
    }
    if operation == "equal" { code.add("  ret i1 " + result + "\n}\n") } else { code.add("  ret " + resultType + " " + result + "\n}\n") }
    globals.add(joinText(code))
    return name
}

function derivedRecordSort(context: CompilerContext, type: Integer, globals: List<Text>, location: Integer): Text {
    requireRecordCapability(context, type, "Ordered", location)
    let compare = derivedRecordFunction(context, type, "compare", globals)
    let declaration = "declare i64 @minyar_compare_slots(i64, i64, i64)\n"
    if findText(globals, declaration) < 0 { globals.add(declaration) }
    let thunk = derivedRecordName(context, type, "sort")
    let code = "define internal i64 " + thunk + "(ptr %unused, i64 %a, i64 %b) {\nentry:\n  %left = inttoptr i64 %a to ptr\n  %right = inttoptr i64 %b to ptr\n  %result = call i64 " + compare + "(ptr %left, ptr %right)\n  ret i64 %result\n}\n"
    if isScalarChoiceType(type) { code = "define internal i64 " + thunk + "(ptr %unused, i64 %a, i64 %b) {\nentry:\n  %result = call i64 " + compare + "(i64 %a, i64 %b)\n  ret i64 %result\n}\n" }
    if findText(globals, code) < 0 { globals.add(code) }
    return thunk
}
