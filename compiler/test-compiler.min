// Tests are ordinary private functions after this module-local transformation.
// Unspellable internal names keep test support out of the language namespace.
function testBlockAt(kinds: List<Integer>, texts: List<Text>, position: Integer): Boolean {
    return position + 2 < kinds.length && kinds[position] == 1 && texts[position] == "test" && kinds[position + 1] == 3
}

function testSourceOffset(source: Text, lines: SourceMap, token: Integer): Integer {
    let wanted = lines.coordinates[token * 2]
    let position = 0
    let line = 1
    while position < source.length && line < wanted {
        if source[position] == '\n' { line = line + 1 }
        position = position + 1
    }
    return position + lines.coordinates[token * 2 + 1] - 1
}

function testQuoted(value: Text): Text {
    let parts: List<Text> = ["\""]
    let position = 0
    while position < value.length {
        let character = value[position]
        if character == '"' || character == '\\' { parts.add("\\") }
        if character == '\n' { parts.add("\\n") }
        else if character == '\r' { parts.add("\\r") }
        else if character == '\t' { parts.add("\\t") }
        else { parts.add(Text(character)) }
        position = position + 1
    }
    parts.add("\"")
    return joinText(parts)
}

function testCopy(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, sourceKinds: List<Integer>, sourceTexts: List<Text>, sourceLines: SourceMap, first: Integer, after: Integer) {
    let position = first
    while position < after {
        copyModuleToken(kinds, texts, lines, sourceKinds[position], sourceTexts[position], sourceLines, position, 0)
        position = position + 1
    }
}

function testSynthetic(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, kind: Integer, text: Text, source: SourceMap, origin: Integer) {
    copyModuleToken(kinds, texts, lines, kind, text, source, origin, 0)
}

function testClosing(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, opening: Integer): Integer {
    let depth = 1
    let position = opening + 1
    while position < kinds.length && kinds[position] != 0 {
        if kinds[position] == 4 {
            if texts[position] == texts[opening] { depth = depth + 1 }
            if (texts[opening] == "{" && texts[position] == "}") || (texts[opening] == "(" && texts[position] == ")") { depth = depth - 1 }
            if depth == 0 { return position }
        }
        position = position + 1
    }
    failAtToken(lines, opening, "this test is missing its closing delimiter")
    return opening
}

// Only split a comparison which is the entire condition. Boolean expressions
// keep their ordinary short-circuit behavior and report their original source.
function testComparison(kinds: List<Integer>, texts: List<Text>, first: Integer, after: Integer): Integer {
    let depth = 0
    let found = -1
    let position = first
    while position < after {
        if kinds[position] == 4 {
            let word = texts[position]
            if depth == 0 {
                if word == "&&" || word == "||" || word == "," { return -1 }
                if word == "==" || word == "!=" || isOrderedOperator(word) {
                    if found >= 0 { return -1 }
                    found = position
                }
            }
            if word == "(" || word == "[" || word == "{" { depth = depth + 1 }
            if word == ")" || word == "]" || word == "}" { depth = depth - 1 }
        }
        position = position + 1
    }
    return found
}

function testCallbackShadowsExpectation(kinds: List<Integer>, texts: List<Text>, first: Integer, after: Integer): Boolean {
    let depth = 0
    let previous = ""
    let position = first
    while position < after {
        if kinds[position] != 6 {
            let word = texts[position]
            if depth == 0 && kinds[position] == 1 && word == "expect" && previous != ":" && previous != "." && previous != "->" { return true }
            if kinds[position] == 4 {
                if word == "(" || word == "[" || word == "<" { depth = depth + 1 }
                if word == ")" || word == "]" || word == ">" { depth = depth - 1 }
                if word == ">>" { depth = depth - 2 }
            }
            previous = word
        }
        position = position + 1
    }
    return false
}

function testBody(source: Text, path: Text, sourceKinds: List<Integer>, sourceTexts: List<Text>, sourceLines: SourceMap, first: Integer, after: Integer, kinds: List<Integer>, texts: List<Text>, lines: SourceMap) {
    // A user binding wins over the contextual assertion name. Module functions
    // and locals retain their ordinary meaning inside a test too.
    let shadowed = false
    let scan = 0
    let depth = 0
    while scan + 1 < sourceKinds.length {
        if depth == 0 && sourceKinds[scan] == 1 && (sourceTexts[scan] == "function" || sourceTexts[scan] == "global" || sourceTexts[scan] == "constant") && sourceKinds[scan + 1] == 1 && sourceTexts[scan + 1] == "expect" { shadowed = true }
        if sourceKinds[scan] == 4 && sourceTexts[scan] == "{" { depth = depth + 1 }
        if sourceKinds[scan] == 4 && sourceTexts[scan] == "}" { depth = depth - 1 }
        scan = scan + 1
    }
    let shadows: List<Boolean> = []
    let parameterShadow = -1
    depth = 0
    let position = first
    while position < after {
        // Assertion lowering precedes closure checking and capture discovery.
        // Keep a callback parameter's value name intact throughout its body.
        if sourceKinds[position] == 1 && sourceTexts[position] == "function" && position + 1 < after && sourceTexts[position + 1] == "(" {
            let closing = testClosing(sourceKinds, sourceTexts, sourceLines, position + 1)
            if testCallbackShadowsExpectation(sourceKinds, sourceTexts, position + 2, closing) {
                let opening = closing + 1
                while opening < after && !(sourceKinds[opening] == 4 && sourceTexts[opening] == "{") { opening = opening + 1 }
                parameterShadow = opening
            }
        }
        if sourceKinds[position] == 4 && sourceTexts[position] == "{" {
            if depth < shadows.length { shadows[depth] = shadowed } else { shadows.add(shadowed) }
            depth = depth + 1
            if position == parameterShadow { shadowed = true; parameterShadow = -1 }
        }
        if sourceKinds[position] == 4 && sourceTexts[position] == "}" && depth > 0 { depth = depth - 1; shadowed = shadows[depth] }
        if sourceKinds[position] == 1 && (sourceTexts[position] == "let" || sourceTexts[position] == "constant") && position + 1 < after && sourceTexts[position + 1] == "expect" { shadowed = true }
        if !shadowed && sourceKinds[position] == 1 && sourceTexts[position] == "expect" && position + 1 < after && sourceTexts[position + 1] == "(" && !(position > first && sourceTexts[position - 1] == ".") {
            let closing = testClosing(sourceKinds, sourceTexts, sourceLines, position + 1)
            let expressionFirst = position + 2
            let expressionAfter = closing
            while expressionFirst < expressionAfter && sourceKinds[expressionFirst] == 4 && sourceTexts[expressionFirst] == "(" && testClosing(sourceKinds, sourceTexts, sourceLines, expressionFirst) == expressionAfter - 1 {
                expressionFirst = expressionFirst + 1
                expressionAfter = expressionAfter - 1
            }
            let comparison = testComparison(sourceKinds, sourceTexts, expressionFirst, expressionAfter)
            let name = "test expectation"
            if comparison >= 0 { name = name + " " + sourceTexts[comparison] }
            testSynthetic(kinds, texts, lines, 1, name, sourceLines, position)
            testCopy(kinds, texts, lines, sourceKinds, sourceTexts, sourceLines, position + 1, position + 2)
            if comparison >= 0 {
                testCopy(kinds, texts, lines, sourceKinds, sourceTexts, sourceLines, expressionFirst, comparison)
                testSynthetic(kinds, texts, lines, 4, ",", sourceLines, comparison)
                testCopy(kinds, texts, lines, sourceKinds, sourceTexts, sourceLines, comparison + 1, expressionAfter)
            } else { testCopy(kinds, texts, lines, sourceKinds, sourceTexts, sourceLines, position + 2, closing) }
            testSynthetic(kinds, texts, lines, 4, ",", sourceLines, position)
            let expression = source.slice(testSourceOffset(source, sourceLines, position + 2), testSourceOffset(source, sourceLines, closing))
            let location = path + ":" + Text(sourceLines.coordinates[position * 2]) + ":" + Text(sourceLines.coordinates[position * 2 + 1])
            testSynthetic(kinds, texts, lines, 3, location + ": expectation failed\n  expect(" + expression + ")", sourceLines, position)
            testCopy(kinds, texts, lines, sourceKinds, sourceTexts, sourceLines, closing, closing + 1)
            position = closing + 1
        } else {
            testCopy(kinds, texts, lines, sourceKinds, sourceTexts, sourceLines, position, position + 1)
            position = position + 1
        }
    }
}

function scanModuleTests(rawKinds: List<Integer>, rawTexts: List<Text>, rawLines: SourceMap, names: List<Text>, starts: List<Integer>, ends: List<Integer>) {
    let position = 0
    let cursor: List<Integer> = [0]
    while rawKinds[position] != 0 {
        if testBlockAt(rawKinds, rawTexts, position) {
            let opening = position + 2
            while rawKinds[opening] == 6 { opening = opening + 1 }
            if rawKinds[opening] != 4 || rawTexts[opening] != "{" { failAtToken(rawLines, opening, "a named test needs a body in braces") }
            let closing = testClosing(rawKinds, rawTexts, rawLines, opening)
            if findText(names, rawTexts[position + 1]) >= 0 { failAtToken(rawLines, position + 1, "this module already has a test with that name") }
            if rawTexts[position + 1] == "" { failAtToken(rawLines, position + 1, "a test needs a nonempty name") }
            names.add(rawTexts[position + 1])
            starts.add(position)
            ends.add(closing + 1)
            position = closing + 1
        } else {
            cursor[0] = position
            if rawKinds[position] == 6 { cursor[0] = cursor[0] + 1 }
            else {
                let declaration = position
                if rawTexts[declaration] == "public" { declaration = declaration + 1 }
                cursor[0] = declaration
                if rawTexts[declaration] == "function" || rawTexts[declaration] == "record" || choiceDeclarationAt(rawKinds, rawTexts, declaration) { skipDeclaration(rawKinds, rawTexts, cursor) }
                else if isTypeAliasDeclaration(rawKinds, rawTexts, cursor) { skipTypeAliasDeclaration(rawKinds, rawTexts, rawLines, cursor) }
                else { cursor[0] = position; skipTopLevelStatement(rawKinds, rawTexts, cursor) }
            }
            position = cursor[0]
        }
    }
}

function moduleTestListing(path: Text): Text {
    let kinds: List<Integer> = []
    let texts: List<Text> = []
    let lines = newSourceMap()
    lines.inputPath = path
    tokenize(compilerReadSource(path), kinds, texts, lines)
    let names: List<Text> = []
    let starts: List<Integer> = []
    let ends: List<Integer> = []
    scanModuleTests(kinds, texts, lines, names, starts, ends)
    let output: List<Text> = []
    let index = 0
    while index < names.length {
        output.add(Text(index) + "\t" + compilerJSONText(names[index]) + "\n")
        index = index + 1
    }
    return joinText(output)
}

function compilerJSONText(value: Text): Text {
    let output: List<Text> = ["\""]
    let start = 0
    let position = 0
    let digits = "0123456789abcdef"
    while position < value.length {
        let byte = Integer(value[position])
        if byte < 32 || byte == 34 || byte == 92 {
            if position > start { output.add(value.slice(start, position)) }
            if byte < 32 { output.add("\\u00" + Text(digits[byte / 16]) + Text(digits[byte % 16])) }
            else { output.add("\\" + Text(Character(byte))) }
            start = position + 1
        }
        position = position + 1
    }
    if position > start { output.add(value.slice(start, position)) }
    output.add("\"")
    return joinText(output)
}

function tokenizeModule(source: Text, path: Text, testing: Boolean, kinds: List<Integer>, texts: List<Text>, lines: SourceMap) {
    let rawKinds: List<Integer> = []
    let rawTexts: List<Text> = []
    let rawLines = newSourceMap()
    rawLines.inputPath = path
    tokenize(source, rawKinds, rawTexts, rawLines)
    let names: List<Text> = []
    let starts: List<Integer> = []
    let ends: List<Integer> = []
    scanModuleTests(rawKinds, rawTexts, rawLines, names, starts, ends)
    let position = 0
    let cursor: List<Integer> = [0]
    if !testing {
        if names.length == 0 { testCopy(kinds, texts, lines, rawKinds, rawTexts, rawLines, 0, rawKinds.length); lines.features = testMergedFeatures(lines.features, rawLines.features); return }
        // Relex the retained source, so excluded tests cannot enable runtime
        // features, leave literal constants, or affect ownership analysis.
        let pieces: List<Text> = []
        let start = 0
        let index = 0
        while index < starts.length {
            let first = testSourceOffset(source, rawLines, starts[index])
            let after = testSourceOffset(source, rawLines, ends[index] - 1) + 1
            pieces.add(source.slice(start, first))
            let blank: List<Text> = []
            while first < after { if source[first] == '\n' { blank.add("\n") } else { blank.add(" ") }; first = first + 1 }
            pieces.add(joinText(blank))
            start = after
            index = index + 1
        }
        pieces.add(source.slice(start, source.length))
        tokenize(joinText(pieces), kinds, texts, lines)
        return
    }
    lines.features = testMergedFeatures(lines.features, rawLines.features)
    position = 0
    let index = 0
    while rawKinds[position] != 0 {
        if index < starts.length && position == starts[index] {
            let opening = position + 2
            while rawKinds[opening] == 6 { opening = opening + 1 }
            testSynthetic(kinds, texts, lines, 1, "function", rawLines, position)
            testSynthetic(kinds, texts, lines, 1, "minyar$test$" + Text(index), rawLines, position + 1)
            testSynthetic(kinds, texts, lines, 4, "(", rawLines, position)
            testSynthetic(kinds, texts, lines, 4, ")", rawLines, position)
            testBody(source, path, rawKinds, rawTexts, rawLines, opening, ends[index], kinds, texts, lines)
            position = ends[index]
            index = index + 1
        } else {
            cursor[0] = position
            let declaration = position
            if rawTexts[declaration] == "public" { declaration = declaration + 1 }
            if rawKinds[position] == 6 { cursor[0] = cursor[0] + 1 }
            else if isTypeAliasDeclaration(rawKinds, rawTexts, [declaration]) { cursor[0] = declaration; skipTypeAliasDeclaration(rawKinds, rawTexts, rawLines, cursor) }
            else if rawTexts[declaration] == "use" || rawTexts[declaration] == "constant" || rawTexts[declaration] == "global" { skipTopLevelStatement(rawKinds, rawTexts, cursor) }
            else if rawTexts[declaration] == "function" || rawTexts[declaration] == "record" || choiceDeclarationAt(rawKinds, rawTexts, declaration) { cursor[0] = declaration; skipDeclaration(rawKinds, rawTexts, cursor) }
            else { skipTopLevelStatement(rawKinds, rawTexts, cursor) }
            let applicationEntry = rawTexts[declaration] == "function" && rawTexts[declaration + 1] == "main"
            if !applicationEntry && (rawKinds[position] == 6 || rawTexts[declaration] == "use" || rawTexts[declaration] == "constant" || rawTexts[declaration] == "global" || rawTexts[declaration] == "function" || rawTexts[declaration] == "record" || choiceDeclarationAt(rawKinds, rawTexts, declaration) || isTypeAliasDeclaration(rawKinds, rawTexts, [declaration])) {
                testCopy(kinds, texts, lines, rawKinds, rawTexts, rawLines, position, cursor[0])
            }
            position = cursor[0]
        }
    }
    let runner: List<Text> = ["\nuse \"process\" as minyar_test_process\nfunction main() {\nlet selected = \"\"\nif minyar_test_process.argumentCount() > 0 { selected = minyar_test_process.argument(0) }\nif selected == \"--list\" {\n"]
    index = 0
    while index < names.length { runner.add("print(" + testQuoted(Text(index) + "\t" + names[index]) + ")\n"); index = index + 1 }
    runner.add("} else {\n")
    index = 0
    while index < names.length {
        runner.add("if selected == \"\" || selected == " + testQuoted(Text(index)) + " { minyar_test_case_" + Text(index) + "() }\n")
        index = index + 1
    }
    runner.add("}\n}\n")
    let runnerKinds: List<Integer> = []
    let runnerTexts: List<Text> = []
    let runnerLines = newSourceMap()
    tokenize(joinText(runner), runnerKinds, runnerTexts, runnerLines)
    index = 0
    while index < runnerKinds.length {
        let word = runnerTexts[index]
        if runnerKinds[index] == 1 && resultPrefix(word, "minyar_test_case_") { word = "minyar$test$" + word.slice(17, word.length) }
        if runnerKinds[index] == 1 && word == "minyar_test_process" { word = "minyar$test$process" }
        testSynthetic(kinds, texts, lines, runnerKinds[index], word, rawLines, position)
        index = index + 1
    }
}

function isTestExpectation(name: Text): Boolean { return name == "test expectation" || resultPrefix(name, "test expectation ") }

// Callback parameters and loop bindings are resolved by the checker. Restore
// their ordinary call before parsing arguments, including its type context.
function restoreShadowedExpectation(context: CompilerContext, position: Integer): Integer {
    let kinds = context.tokenKinds
    let texts = context.tokenTexts
    let name = texts[position]
    let closing = testClosing(kinds, texts, context.tokenLines, position + 1)
    let metadata = closing - 2
    let comparison = -1
    if name != "test expectation" {
        let scan = position + 2
        let depth = 0
        let found = false
        while scan < metadata && !found {
            if kinds[scan] == 4 {
                let word = texts[scan]
                if word == "," && depth == 0 { texts[scan] = name.slice(17, name.length); found = true; comparison = scan }
                if word == "(" || word == "[" || word == "{" { depth = depth + 1 }
                if word == ")" || word == "]" || word == "}" { depth = depth - 1 }
            }
            scan = scan + 1
        }
    }
    return comparison
}

function testLiteral(globals: List<Text>, value: Text): Text {
    let id = globals.length
    appendLiteralDeclarations(globals, [3], [value], "test.failure." + Text(id), false)
    return "getelementptr (i8, ptr @\"minyar.literal|test.failure." + Text(id) + "|value|0\", i64 8)"
}

function testJoin(output: List<Text>, textState: List<Text>, state: List<Integer>, left: Text, right: Text): Text {
    return emitInstruction(output, textState, state, "call ptr @minyar_join_text(ptr " + left + ", ptr " + right + ")")
}

function testRender(context: CompilerContext, globals: List<Text>, output: List<Text>, textState: List<Text>, state: List<Integer>, value: Text, type: Integer): Text {
    if choiceCases(context, type).length > 0 { return testRenderChoice(context, globals, output, textState, state, value, type) }
    if type == 2 { return testJoin(output, textState, state, testJoin(output, textState, state, testLiteral(globals, "\""), value), testLiteral(globals, "\"")) }
    let suffix = "integer"
    if type == 3 { suffix = "character" }
    if type == 4 { suffix = "boolean" }
    if type == 7 { suffix = "float" }
    if type == 1 || type == 3 || type == 4 || type == 7 { return emitInstruction(output, textState, state, "call ptr @minyar_" + suffix + "_text(" + argumentPrefix(type) + value + ")") }
    if isRecordType(type) && !isCallbackType(type, context.functionNames) {
        let record = recordTypeIndex(type)
        let result = testLiteral(globals, readableDeclarationName(context.functionNames[record]) + " { ")
        let first = functionParameterOffset(context.functionParameterCounts, record)
        let field = 0
        while field < context.functionParameterCounts[record] {
            let fieldType = context.functionParameterTypes[first + field]
            if fieldType != 5 {
                let prefix = ""
                if field > 0 { prefix = ", " }
                result = testJoin(output, textState, state, result, testLiteral(globals, prefix + declaredFieldName(context.functionParameterNames[first + field]) + ": "))
                let raw = emitInstruction(output, textState, state, "call i64 @minyar_record_get(ptr " + value + ", i64 " + Text(field) + ")")
                let member = slotAsValue(output, textState, state, raw, fieldType)
                result = testJoin(output, textState, state, result, testRender(context, globals, output, textState, state, member, fieldType))
            }
            field = field + 1
        }
        return testJoin(output, textState, state, result, testLiteral(globals, " }"))
    }
    return testLiteral(globals, "<" + describeType(type) + ">")
}

function emitTestExpectation(context: CompilerContext, globals: List<Text>, output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, values: List<Text>, types: List<Integer>, resultType: List<Integer>, location: Integer): Text {
    let comparison = name != "test expectation"
    let expected = 2
    if comparison { expected = 3 }
    if values.length != expected { failAtToken(context.tokenLines, location, "expect needs one Boolean condition") }
    let condition = values[0]
    if comparison {
        if isMapType(types[0]) || isSetType(types[0]) {
            let declaration = "declare zeroext i1 @minyar_maps_are_equal(ptr, ptr, i64)\n"
            if findText(globals, declaration) < 0 { globals.add(declaration) }
        }
        condition = emitBinary(context, globals, output, textState, state, name.slice(17, name.length), values[0], types[0], -1, values[1], types[1], resultType, context.tokenLines, location)
    } else if types[0] != 4 { failAtToken(context.tokenLines, location, "expect needs a Boolean condition") }
    let label = Text(newLabel(state))
    output.add("  br i1 " + condition + ", label %expect.pass." + label + ", label %expect.fail." + label + "\nexpect.fail." + label + ":\n")
    textState[0] = "expect.fail." + label
    let message = values[expected - 1]
    if comparison {
        message = testJoin(output, textState, state, message, testLiteral(globals, "\n  expected "))
        message = testJoin(output, textState, state, message, testRender(context, globals, output, textState, state, values[1], types[1]))
        message = testJoin(output, textState, state, message, testLiteral(globals, ", got "))
        message = testJoin(output, textState, state, message, testRender(context, globals, output, textState, state, values[0], types[0]))
    }
    output.add("  call void @minyar_fail(ptr " + message + ")\n  unreachable\nexpect.pass." + label + ":\n")
    textState[0] = "expect.pass." + label
    setType(resultType, 5)
    return ""
}

function testRenderChoice(context: CompilerContext, globals: List<Text>, output: List<Text>, textState: List<Text>, state: List<Integer>, value: Text, type: Integer): Text {
    let cases = choiceCases(context, type)
    let tag = readChoiceMatchTag(context, output, textState, state, value, type)
    let end = "test.render.end." + Text(newLabel(state))
    let values: List<Text> = []
    let blocks: List<Text> = []
    let first = functionParameterOffset(context.functionParameterCounts, recordTypeIndex(type))
    let index = 1
    while index < cases.length {
        let label = Text(newLabel(state))
        let active = emitInstruction(output, textState, state, "icmp eq i64 " + tag + ", " + Text(index - 1))
        output.add("  br i1 " + active + ", label %test.render.case." + label + ", label %test.render.next." + label + "\ntest.render.case." + label + ":\n")
        textState[0] = "test.render.case." + label
        let fields = choicePayloadFields(context, type, cases[index])
        let result = testLiteral(globals, cases[index])
        if fields.length > 0 { result = testJoin(output, textState, state, result, testLiteral(globals, "(")) }
        let field = 0
        while field < fields.length {
            if field > 0 { result = testJoin(output, textState, state, result, testLiteral(globals, ", ")) }
            let fieldType = context.functionParameterTypes[first + fields[field]]
            let member = readChoiceMatchPayload(context, output, textState, state, value, type, fields[field], fieldType)
            result = testJoin(output, textState, state, result, testRender(context, globals, output, textState, state, member, fieldType))
            field = field + 1
        }
        if fields.length > 0 { result = testJoin(output, textState, state, result, testLiteral(globals, ")")) }
        values.add(result)
        blocks.add(textState[0])
        output.add("  br label %" + end + "\ntest.render.next." + label + ":\n")
        textState[0] = "test.render.next." + label
        index = index + 1
    }
    values.add(testLiteral(globals, "<invalid choice>"))
    blocks.add(textState[0])
    output.add("  br label %" + end + "\n" + end + ":\n")
    textState[0] = end
    let incoming: List<Text> = []
    index = 0
    while index < values.length {
        if index > 0 { incoming.add(", ") }
        incoming.add("[ " + values[index] + ", %" + blocks[index] + " ]")
        index = index + 1
    }
    return emitInstruction(output, textState, state, "phi ptr " + joinText(incoming))
}

function testMergedFeatures(left: Integer, right: Integer): Integer {
    let result = 0
    let bit = 1
    while left > 0 || right > 0 {
        if left % 2 != 0 || right % 2 != 0 { result = result + bit }
        left = left / 2
        right = right / 2
        bit = bit * 2
    }
    return result
}
