// Choices use the ordinary record ownership graph. The first field's compiler-only
// name carries the case names; remaining fields carry their case and payload name.
function choiceCopy(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, kind: Integer, text: Text, source: SourceMap, position: Integer) {
    copyModuleToken(kinds, texts, lines, kind, text, source, position, sourcePath(lines, tokenPath(source, position)))
}

function choiceDeclarationAt(kinds: List<Integer>, texts: List<Text>, position: Integer): Boolean {
    if position < 0 || position + 2 >= kinds.length { return false }
    if kinds[position] != 1 || texts[position] != "choice" || kinds[position + 1] != 1 { return false }
    if kinds[position + 2] != 4 || (texts[position + 2] != "{" && texts[position + 2] != "<") { return false }
    if position == 0 { return true }
    let previous = position - 1
    return kinds[previous] == 0 || kinds[previous] == 6 || texts[previous] == "}" || texts[previous] == "public"
}

function normalizeChoiceTypes(kinds: List<Integer>, texts: List<Text>, lines: SourceMap): ResultTokenSet {
    let outputKinds: List<Integer> = []
    let outputTexts: List<Text> = []
    let outputLines = newSourceMap()
    outputLines.features = lines.features
    let position = 0
    let scopeDepth = 0
    while position < kinds.length {
        if scopeDepth == 0 && choiceDeclarationAt(kinds, texts, position) {
            let location = position
            let cursor: List<Integer> = [position + 1]
            if kinds[cursor[0]] != 1 { failAtToken(lines, cursor[0], "expected a name after choice") }
            let name = texts[cursor[0]]
            cursor[0] = cursor[0] + 1
            let headerStart = cursor[0]
            if tokenIs(kinds, texts, cursor, "<") {
                let depth = 0
                let scanning = true
                while kinds[cursor[0]] != 0 && scanning {
                    if texts[cursor[0]] == "<" { depth = depth + 1 }
                    if texts[cursor[0]] == ">" { depth = depth - 1 }
                    if texts[cursor[0]] == ">>" { depth = depth - 2 }
                    cursor[0] = cursor[0] + 1
                    if depth <= 0 { scanning = false }
                }
                if outputLines.features / 256 % 2 == 0 { outputLines.features = outputLines.features + 256 }
            }
            let headerEnd = cursor[0]
            expectToken(kinds, texts, lines, cursor, "{")
            skipTerminators(kinds, cursor)
            let cases: List<Text> = []
            let payloadKinds: List<Integer> = []
            let payloadTexts: List<Text> = []
            let payloadLines = newSourceMap()
            let marker = "minyar_choice_tag"
            while !tokenIs(kinds, texts, cursor, "}") {
                let caseLocation = cursor[0]
                let caseName = texts[caseLocation]
                if kinds[caseLocation] != 1 || caseName.length == 0 || caseName[0] < 'A' || caseName[0] > 'Z' {
                    failAtToken(lines, caseLocation, "a choice case needs a capitalised name")
                }
                if findText(cases, caseName) >= 0 { failAtToken(lines, caseLocation, "duplicate choice case '" + caseName + "'") }
                cases.add(caseName)
                marker = marker + "|" + caseName
                cursor[0] = cursor[0] + 1
                if tokenIs(kinds, texts, cursor, "(") {
                    cursor[0] = cursor[0] + 1
                    let payloadNames: List<Text> = []
                    while !tokenIs(kinds, texts, cursor, ")") {
                        let payloadLocation = cursor[0]
                        if kinds[payloadLocation] != 1 { failAtToken(lines, payloadLocation, "expected a choice payload name") }
                        let payloadName = texts[payloadLocation]
                        if findText(payloadNames, payloadName) >= 0 { failAtToken(lines, payloadLocation, "duplicate choice payload '" + payloadName + "'") }
                        payloadNames.add(payloadName)
                        choiceCopy(payloadKinds, payloadTexts, payloadLines, 1, "minyar_choice_payload|" + caseName + "|" + payloadName, lines, payloadLocation)
                        cursor[0] = cursor[0] + 1
                        expectToken(kinds, texts, lines, cursor, ":")
                        choiceCopy(payloadKinds, payloadTexts, payloadLines, 4, ":", lines, payloadLocation)
                        let typeStart = cursor[0]
                        let depth = 0
                        while kinds[cursor[0]] != 0 && !(depth == 0 && (tokenIs(kinds, texts, cursor, ",") || tokenIs(kinds, texts, cursor, ")"))) {
                            let token = texts[cursor[0]]
                            if token == "<" || token == "(" { depth = depth + 1 }
                            if token == ">" || token == ")" { depth = depth - 1 }
                            if token == ">>" { depth = depth - 2 }
                            choiceCopy(payloadKinds, payloadTexts, payloadLines, kinds[cursor[0]], token, lines, cursor[0])
                            cursor[0] = cursor[0] + 1
                        }
                        if cursor[0] == typeStart { failAtToken(lines, typeStart, "expected a choice payload type") }
                        choiceCopy(payloadKinds, payloadTexts, payloadLines, 6, ";", lines, payloadLocation)
                        if !tokenIs(kinds, texts, cursor, ")") { expectToken(kinds, texts, lines, cursor, ",") }
                    }
                    cursor[0] = cursor[0] + 1
                }
                if tokenIs(kinds, texts, cursor, ",") { cursor[0] = cursor[0] + 1 }
                skipTerminators(kinds, cursor)
            }
            if cases.length == 0 { failAtToken(lines, location, "a choice needs at least one case") }
            choiceCopy(outputKinds, outputTexts, outputLines, 1, "record", lines, location)
            choiceCopy(outputKinds, outputTexts, outputLines, 1, name, lines, location + 1)
            let header = headerStart
            while header < headerEnd {
                choiceCopy(outputKinds, outputTexts, outputLines, kinds[header], texts[header], lines, header)
                header = header + 1
            }
            choiceCopy(outputKinds, outputTexts, outputLines, 4, "{", lines, location)
            choiceCopy(outputKinds, outputTexts, outputLines, 1, marker, lines, location)
            choiceCopy(outputKinds, outputTexts, outputLines, 4, ":", lines, location)
            choiceCopy(outputKinds, outputTexts, outputLines, 1, "Integer", lines, location)
            choiceCopy(outputKinds, outputTexts, outputLines, 6, ";", lines, location)
            let payload = 0
            while payload < payloadKinds.length {
                choiceCopy(outputKinds, outputTexts, outputLines, payloadKinds[payload], payloadTexts[payload], payloadLines, payload)
                payload = payload + 1
            }
            choiceCopy(outputKinds, outputTexts, outputLines, 4, "}", lines, cursor[0])
            position = cursor[0] + 1
        } else {
            if kinds[position] == 4 && texts[position] == "{" { scopeDepth = scopeDepth + 1 }
            if kinds[position] == 4 && texts[position] == "}" { scopeDepth = scopeDepth - 1 }
            choiceCopy(outputKinds, outputTexts, outputLines, kinds[position], texts[position], lines, position)
            position = position + 1
        }
    }
    return ResultTokenSet { kinds: outputKinds; texts: outputTexts; lines: outputLines }
}

function choiceCases(context: CompilerContext, type: Integer): List<Text> {
    let empty: List<Text> = []
    if !isRecordType(type) { return empty }
    let record = type - 1000
    if context.functionParameterCounts[record] == 0 { return empty }
    let marker = context.functionParameterNames[functionParameterOffset(context.functionParameterCounts, record)]
    if !resultPrefix(marker, "minyar_choice_tag|") { return empty }
    return marker.split("|")
}

function choicePayloadFields(context: CompilerContext, type: Integer, name: Text): List<Integer> {
    let fields: List<Integer> = []
    let record = type - 1000
    let first = functionParameterOffset(context.functionParameterCounts, record)
    let prefix = "minyar_choice_payload|" + name + "|"
    let field = 1
    while field < context.functionParameterCounts[record] {
        if resultPrefix(context.functionParameterNames[first + field], prefix) { fields.add(field) }
        field = field + 1
    }
    return fields
}

function choiceLocalType(context: CompilerContext, type: Integer, location: Integer): Boolean {
    let position = 0
    let name = context.functionNames[type - 1000]
    while position + 1 < context.tokenKinds.length {
        if context.tokenKinds[position] == 1 && context.tokenTexts[position] == "record" && context.tokenTexts[position + 1] == name {
            return tokenPath(context.tokenLines, position) == tokenPath(context.tokenLines, location)
        }
        position = position + 1
    }
    return false
}

function choiceConstructorType(context: CompilerContext, localNames: List<Text>, localLengths: List<Integer>, state: List<Integer>, expected: Integer): Integer {
    let location = state[0]
    let name = context.tokenTexts[location]
    if context.tokenKinds[location] != 1 { return 0 }
    let record = findCompiledSymbol(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, name, 2)
    if record >= 0 && context.tokenTexts[location + 1] == "{" && choiceCases(context, 1000 + record).length == 0 { return 0 }
    if record >= 0 && context.tokenTexts[location + 1] == "." && choiceCases(context, 1000 + record).length > 0 { return 1000 + record }
    if (name == "Ok" || name == "Err") && resultTypeName(expected, context.functionNames) { return 0 }
    if isBuiltinName(name) { return 0 }
    if findLocal(localNames, localLengths, state, name) >= 0 || findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, name) >= 0 || findCompiledSymbol(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, name, 3) >= 0 { return 0 }
    if findText(choiceCases(context, expected), name) > 0 { return expected }
    if choiceCases(context, expected).length > 0 && name.length > 0 && name[0] >= 'A' && name[0] <= 'Z' { return expected }
    let found = 0
    record = 0
    while record < context.functionNames.length {
        if context.symbolKinds[record] == 2 && findText(choiceCases(context, 1000 + record), name) > 0 && choiceLocalType(context, 1000 + record, location) {
            if found != 0 { failAtToken(context.tokenLines, location, "ambiguous choice case '" + name + "'; qualify it with its choice type") }
            found = 1000 + record
        }
        record = record + 1
    }
    return found
}

function failChoicePayloadCount(context: CompilerContext, position: Integer, type: Integer, name: Text, fields: List<Integer>, extra: Boolean) {
    let first = functionParameterOffset(context.functionParameterCounts, type - 1000)
    let signature: List<Text> = [name + "("]
    let index = 0
    while index < fields.length {
        if index > 0 { signature.add(", ") }
        let fieldName = declaredFieldName(context.functionParameterNames[first + fields[index]])
        let prefix = "minyar_choice_payload|" + name + "|"
        if resultPrefix(fieldName, prefix) { fieldName = fieldName.slice(prefix.length, fieldName.length) }
        signature.add(fieldName + ": " + diagnosticType(context, context.functionParameterTypes[first + fields[index]]))
        index = index + 1
    }
    signature.add(")")
    let problem = "fewer were provided"
    if extra { problem = "more were provided" }
    let noun = " payload values"
    if fields.length == 1 { noun = " payload value" }
    let help = "supply each value in declaration order: " + joinText(signature)
    if fields.length == 0 { help = "this case has no payload; remove the values inside its parentheses" }
    failDiagnostic(sourceSpan(context.tokenLines, context.tokenLines.inputPath, position, position + 1), "choice case '" + name + "' expects " + Text(fields.length) + noun + ", but " + problem, "", help)
}

function parseChoiceConstructor(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>, type: Integer): Text {
    let location = state[0]
    if context.tokenTexts[location + 1] == "." { state[0] = state[0] + 2 }
    let name = context.tokenTexts[state[0]]
    let cases = choiceCases(context, type)
    let tag = findText(cases, name)
    if tag < 1 { failUnknownChoice(context, state[0], type, name, "choice '" + readableDeclarationName(context.functionNames[type - 1000]) + "' has no case '" + name + "'") }
    state[0] = state[0] + 1
    let fields = choicePayloadFields(context, type, name)
    let record = type - 1000
    let first = functionParameterOffset(context.functionParameterCounts, record)
    let value = valueName(textState, newTemporary(state))
    noteCycleFixup(output, context.functionReturnTypes, context.functionParameterCounts, context.functionParameterTypes, output.length, type, 0)
    output.add("  " + value + " = call ptr @minyar_record_new(i64 " + Text(context.functionParameterCounts[record]) + ")\n")
    output.add("  call void @minyar_record_set(ptr " + value + ", i64 0, i64 " + Text(tag - 1) + ")\n")
    let owned: List<Integer> = [type]
    ownResult(output, state, value, owned)
    if fields.length > 0 || tokenIs(context.tokenKinds, context.tokenTexts, state, "(") {
        expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, "(")
        let index = 0
        while index < fields.length {
            if tokenIs(context.tokenKinds, context.tokenTexts, state, ")") { failChoicePayloadCount(context, state[0], type, name, fields, false) }
            if index > 0 { expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ",") }
            if tokenIs(context.tokenKinds, context.tokenTexts, state, ")") { failChoicePayloadCount(context, state[0], type, name, fields, false) }
            let field = fields[index]
            let expected = context.functionParameterTypes[first + field]
            let payloadType: List<Integer> = [expected]
            let payloadLocation = state[0]
            let payload = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, payloadType)
            requireContextType(context, payloadLocation, payloadType[0], expected, "choice payload has the wrong type")
            let slot = valueAsListSlot(output, textState, state, payload, expected)
            let setter = "minyar_record_set"
            if isReferenceType(expected) {
                setter = "minyar_record_set_reference"
                if takeResult(output, state, payload, payloadType) { setter = "minyar_record_set_take" }
            }
            noteCycleFixup(output, context.functionReturnTypes, context.functionParameterCounts, context.functionParameterTypes, output.length, type, expected)
            output.add("  call void @" + setter + "(ptr " + value + ", i64 " + Text(field) + ", i64 " + slot + ")\n")
            index = index + 1
        }
        if fields.length > 0 && tokenIs(context.tokenKinds, context.tokenTexts, state, ",") { state[0] = state[0] + 1 }
        if context.tokenKinds[state[0]] != 0 && context.tokenKinds[state[0]] != 6 && !tokenIs(context.tokenKinds, context.tokenTexts, state, ")") && !tokenIs(context.tokenKinds, context.tokenTexts, state, "}") {
            failChoicePayloadCount(context, state[0], type, name, fields, true)
        }
        expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ")")
    }
    setType(resultType, type)
    if owned.length > 1 { markOwner(resultType, owned[1]) }
    return value
}

function choiceMatchCases(context: CompilerContext, type: Integer): List<Text> {
    if resultTypeName(type, context.functionNames) {
        let cases: List<Text> = ["result", "Err", "Ok"]
        return cases
    }
    return choiceCases(context, type)
}

function choiceMatchFields(context: CompilerContext, type: Integer, name: Text): List<Integer> {
    if resultTypeName(type, context.functionNames) {
        let fields: List<Integer> = []
        let first = functionParameterOffset(context.functionParameterCounts, type - 1000)
        if name == "Err" { fields.add(2) }
        if name == "Ok" && context.functionParameterTypes[first + 1] != 5 { fields.add(1) }
        return fields
    }
    return choicePayloadFields(context, type, name)
}

function parseMatchExpression(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let location = state[0]
    state[0] = state[0] + 1
    let inputType: List<Integer> = [0]
    let input = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, inputType)
    if choiceMatchCases(context, inputType[0]).length == 0 { failCompiler(describeLocation(tokenLocation(context.tokenLines, location)) + ": match needs a Result or choice") }
    let values: List<Text> = []
    let terminal = compileChoiceMatchInput(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, context.activeReturnType, input, inputType, location, resultType, values)
    return values[0]
}

function compileChoiceMatchInput(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, returnType: Integer, input: Text, inputType: List<Integer>, location: Integer, expressionType: List<Integer>, expressionValue: List<Text>): Boolean {
    let kinds = context.tokenKinds
    let texts = context.tokenTexts
    let lines = context.tokenLines
    let counts = context.functionParameterCounts
    let types = context.functionParameterTypes
    let returns = context.functionReturnTypes
    let cases = choiceMatchCases(context, inputType[0])
    let seen: List<Integer> = []
    let seenIndex = 0
    while seenIndex < cases.length { seen.add(0); seenIndex = seenIndex + 1 }
    let expression = expressionType.length > 0
    let valueId = -1
    if expression { valueId = nextLocal(state) }
    let outerScope = state[3]
    let owner = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, " choice match", inputType[0], owner)
    assignReference(output, state, owner, input, inputType, counts, types, returns)
    storeLocal(output, owner, inputType[0], input)
    let tag = readRecordField(output, textState, state, input, 0, 1)
    let endLabel = "choice.match.end." + Text(newLabel(state))
    let allReturn = true
    let seenElse = false
    expectToken(kinds, texts, lines, state, "{")
    skipTerminators(kinds, state)
    while !tokenIs(kinds, texts, state, "}") {
        let armLocation = state[0]
        let name = texts[armLocation]
        if seenElse { failAtToken(lines, armLocation, "else must be the last match arm") }
        let fallback = name == "else" && kinds[armLocation] == 1
        let variant = findText(cases, name)
        if resultTypeName(inputType[0], context.functionNames) {
            if !fallback && (kinds[armLocation] != 1 || variant < 1) { failUnknownChoice(context, armLocation, inputType[0], name, "expected Ok or Err in result match") }
            if !fallback && seen[variant] != 0 { failAtToken(lines, armLocation, "duplicate result arm " + name) }
        }
        if !fallback && (kinds[armLocation] != 1 || variant < 1) { failUnknownChoice(context, armLocation, inputType[0], name, "unknown case '" + name + "' in choice match") }
        if !fallback && seen[variant] != 0 { failAtToken(lines, armLocation, "duplicate match arm '" + name + "'") }
        state[0] = state[0] + 1
        let fields: List<Integer> = []
        if fallback { seenElse = true } else { seen[variant] = 1; fields = choiceMatchFields(context, inputType[0], name) }
        let bindings: List<Text> = []
        if fields.length > 0 || tokenIs(kinds, texts, state, "(") {
            expectToken(kinds, texts, lines, state, "(")
            let index = 0
            while index < fields.length {
                if index > 0 { expectToken(kinds, texts, lines, state, ",") }
                if kinds[state[0]] != 1 || texts[state[0]] == "true" || texts[state[0]] == "false" { failAtToken(lines, state[0], "expected a choice payload binding") }
                let binding = texts[state[0]]
                if binding != "_" && findText(bindings, binding) >= 0 { failAtToken(lines, state[0], "duplicate choice payload binding '" + binding + "'") }
                bindings.add(binding)
                state[0] = state[0] + 1
                index = index + 1
            }
            expectToken(kinds, texts, lines, state, ")")
        }
        let armLabel = "choice.match.arm." + Text(newLabel(state))
        let nextLabel = "choice.match.next." + Text(newLabel(state))
        if fallback { output.add("  br label %" + armLabel + "\n") } else {
            let condition = valueName(textState, newTemporary(state))
            output.add("  " + condition + " = icmp eq i64 " + tag + ", " + Text(variant - 1) + "\n")
            output.add(conditionalBranch(condition, armLabel, nextLabel))
        }
        output.add("\n" + armLabel + ":\n")
        textState[0] = armLabel
        let scope = state[3]
        let bindingIds: List<Integer> = []
        let first = functionParameterOffset(counts, inputType[0] - 1000)
        let index = 0
        while index < fields.length {
            let field = fields[index]
            let type = types[first + field]
            let id = -1
            if bindings[index] != "_" {
                let payload = readRecordField(output, textState, state, input, field, type)
                id = nextLocal(state)
                addLocal(localNames, localTypes, localIds, localLengths, state, bindings[index], type, id)
                let payloadType: List<Integer> = [type]
                assignReference(output, state, id, payload, payloadType, counts, types, returns)
                storeLocal(output, id, type, payload)
            }
            bindingIds.add(id)
            index = index + 1
        }
        let terminal = false
        if expression {
            expectToken(kinds, texts, lines, state, "{")
            skipTerminators(kinds, state)
            let armType: List<Integer> = [expressionType[0]]
            let value = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, armType)
            if armType[0] == 5 || armType[0] == 6 { failCompiler(describeLocation(tokenLocation(lines, armLocation)) + ": a match expression arm must produce a value") }
            if expressionType[0] == 0 { setType(expressionType, armType[0]) }
            if armType[0] != expressionType[0] { failCompiler(describeLocation(tokenLocation(lines, armLocation)) + ": match expression arms must have the same type") }
            assignReference(output, state, valueId, value, armType, counts, types, returns)
            storeLocal(output, valueId, armType[0], value)
            skipTerminators(kinds, state)
            expectToken(kinds, texts, lines, state, "}")
        } else {
            terminal = compileBlock(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType)
        }
        if !terminal {
            index = 0
            while index < fields.length {
                if bindingIds[index] >= 0 { rootLocal(output, state, bindingIds[index], "null", types[first + fields[index]]) }
                index = index + 1
            }
            output.add("  br label %" + endLabel + "\n")
            allReturn = false
        }
        state[3] = scope
        if !fallback {
            output.add("\n" + nextLabel + ":\n")
            textState[0] = nextLabel
        }
        skipTerminators(kinds, state)
    }
    expectToken(kinds, texts, lines, state, "}")
    let missing: List<Text> = []
    let variant = 1
    while variant < cases.length {
        if seen[variant] == 0 {
            if missing.length > 0 { missing.add(", ") }
            missing.add(cases[variant])
        }
        variant = variant + 1
    }
    if !seenElse && missing.length > 0 && resultTypeName(inputType[0], context.functionNames) {
        let names: List<Text> = []
        variant = 1
        while variant < cases.length { if seen[variant] == 0 { names.add(cases[variant]) }; variant = variant + 1 }
        failAtToken(lines, location, "match must handle both Ok and Err; missing cases: " + diagnosticNameList(names))
    }
    if !seenElse && missing.length > 0 { failAtToken(lines, location, "match is missing cases: " + joinText(missing)) }
    if !seenElse { output.add("  unreachable\n") }
    if !allReturn {
        output.add("\n" + endLabel + ":\n")
        textState[0] = endLabel
        if expression {
            let value = loadLocal(output, textState, state, valueId, expressionType[0])
            setType(expressionType, expressionType[0])
            borrowReference(output, state, value, expressionType[0], counts, types, returns)
            rootLocal(output, state, valueId, "null", expressionType[0])
            expressionValue.add(value)
        }
        rootLocal(output, state, owner, "null", inputType[0])
        if !expression { output.add("  call void @minyar_rc_step()\n") }
    }
    state[3] = outerScope
    return allReturn
}
