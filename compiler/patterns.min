// Patterns are flat, token-addressed trees. Binding installation happens only
// after every structural test succeeds, so a failed test owns no payload roots.
record MatchPattern {
    kind: Integer
    type: Integer
    location: Integer
    after: Integer
    name: Text
    children: List<Integer>
}

record PatternRow { values: List<Integer> }
record PatternWitness { missing: Boolean; values: List<Text> }

function matchInputType(context: CompilerContext, type: Integer): Boolean {
    return (type >= 1 && type <= 4) || type == 7 || choiceMatchCases(context, type).length > 0 || matchProductType(context, type)
}

function matchLiteralAt(context: CompilerContext, position: Integer): Boolean {
    let kind = context.tokenKinds[position]
    let name = context.tokenTexts[position]
    return kind == 2 || kind == 3 || kind == 5 || kind == 7 || (kind == 1 && (name == "true" || name == "false")) || (kind == 4 && name == "-" && (context.tokenKinds[position + 1] == 2 || context.tokenKinds[position + 1] == 7))
}

function parseMatchPattern(context: CompilerContext, state: List<Integer>, type: Integer, nodes: List<MatchPattern>, bindings: List<Text>, depth: Integer): Integer {
    let location = state[0]
    if depth > 128 { failAtToken(context.tokenLines, location, "this pattern is too deeply nested; split it into another match") }
    let name = context.tokenTexts[location]
    let kind = 0
    let children: List<Integer> = []
    if matchLiteralAt(context, location) {
        kind = 2
        let literalType = 1
        let literal = location
        if context.tokenKinds[location] == 4 && name == "-" { literal = literal + 1; name = "-" + context.tokenTexts[literal] }
        if context.tokenKinds[literal] == 3 { literalType = 2 }
        if context.tokenKinds[literal] == 5 { literalType = 3 }
        if context.tokenKinds[literal] == 7 { literalType = 7 }
        if context.tokenKinds[literal] == 1 && (name == "true" || name == "false") { literalType = 4 }
        requireContextType(context, location, literalType, type, "pattern has the wrong type")
        state[0] = literal + 1
    } else {
        if context.tokenKinds[location] != 1 { failAtToken(context.tokenLines, location, "expected a choice payload binding or pattern") }
        let cases = matchPatternCases(context, type)
        let variant = findText(cases, name)
        if matchProductType(context, type) {
            variant = -1
            let declaration = findText(context.functionNames, name)
            if name == context.functionNames[type - 1000] || (declaration < 0 && patternShortName(name) == patternShortName(cases[1])) { variant = 1; name = cases[1] }
        }
        if variant > 0 {
            kind = 1
            if matchProductType(context, type) {
                kind = 3
                if isCRecord(context, type) { failAtToken(context.tokenLines, location, "record patterns do not yet support native C layouts; bind the record and read its fields") }
            }
            state[0] = state[0] + 1
            let fields = matchPatternFields(context, type, name)
            let first = functionParameterOffset(context.functionParameterCounts, recordTypeIndex(type))
            if fields.length > 0 || tokenIs(context.tokenKinds, context.tokenTexts, state, "(") {
                expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, "(")
                let field = 0
                while field < fields.length {
                    if field > 0 { expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ",") }
                    let child = parseMatchPattern(context, state, context.functionParameterTypes[first + fields[field]], nodes, bindings, depth + 1)
                    if kind == 3 && (nodes[child].kind != 0 || nodes[child].name != "_") { checkFieldAccess(context.tokenLines, context.functionParameterNames[first + fields[field]], context.functionNames[type - 1000], nodes[child].location) }
                    children.add(child)
                    field = field + 1
                }
                expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ")")
            }
        } else {
            if name != "_" && name.length > 0 && name[0] >= 'A' && name[0] <= 'Z' && (depth == 0 || context.tokenTexts[location + 1] == "(") {
                failUnknownChoice(context, location, type, name, "unknown case '" + name + "' in choice match")
            }
            if name != "_" {
                if findText(bindings, name) >= 0 { failAtToken(context.tokenLines, location, "duplicate pattern binding '" + name + "'") }
                bindings.add(name)
            }
            state[0] = state[0] + 1
        }
    }
    let id = nodes.length
    nodes.add(MatchPattern { kind: kind; type: type; location: location; after: state[0]; name: name; children: children })
    return id
}

function matchPatternBranch(output: List<Text>, textState: List<Text>, state: List<Integer>, condition: Text, failure: Text) {
    let success = "pattern.pass." + Text(newLabel(state))
    output.add(conditionalBranch(condition, success, failure))
    output.add("\n" + success + ":\n")
    textState[0] = success
}

function emitMatchPattern(context: CompilerContext, nodes: List<MatchPattern>, node: Integer, input: Text, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, failure: Text, bindingNodes: List<Integer>, bindingValues: List<Text>) {
    let pattern = nodes[node]
    if pattern.kind == 0 {
        if pattern.name != "_" { bindingNodes.add(node); bindingValues.add(input) }
        return
    }
    if pattern.kind == 2 {
        let after = state[0]
        state[0] = pattern.location
        let literalType: List<Integer> = [pattern.type]
        let literal = parseUnary(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, literalType)
        state[0] = after
        let comparison: List<Integer> = [4]
        let condition = emitBinary(context, globals, output, textState, state, "==", input, pattern.type, -1, literal, literalType[0], comparison, context.tokenLines, pattern.location)
        matchPatternBranch(output, textState, state, condition, failure)
        return
    }
    if pattern.kind == 1 {
        let cases = choiceMatchCases(context, pattern.type)
        let tag = readChoiceMatchTag(context, output, textState, state, input, pattern.type)
        let condition = emitInstruction(output, textState, state, "icmp eq i64 " + tag + ", " + Text(findText(cases, pattern.name) - 1))
        matchPatternBranch(output, textState, state, condition, failure)
    }
    let fields = matchPatternFields(context, pattern.type, pattern.name)
    let field = 0
    while field < fields.length {
        let child = pattern.children[field]
        if nodes[child].kind != 0 || nodes[child].name != "_" {
            let value = ""
            if pattern.kind == 3 { value = readRecordField(output, textState, state, input, fields[field], nodes[child].type) } else { value = readChoiceMatchPayload(context, output, textState, state, input, pattern.type, fields[field], nodes[child].type) }
            emitMatchPattern(context, nodes, child, value, localNames, localTypes, localIds, localLengths, state, textState, output, globals, failure, bindingNodes, bindingValues)
        }
        field = field + 1
    }
}

function matchPatternWildcard(nodes: List<MatchPattern>, node: Integer): Boolean {
    if node < 0 { return true }
    return nodes[node].kind == 0
}

function matchPatternIrrefutable(context: CompilerContext, nodes: List<MatchPattern>, node: Integer): Boolean {
    if matchPatternWildcard(nodes, node) { return true }
    let pattern = nodes[node]
    if (pattern.kind != 1 && pattern.kind != 3) || matchPatternCases(context, pattern.type).length != 2 { return false }
    let index = 0
    while index < pattern.children.length {
        if !matchPatternIrrefutable(context, nodes, pattern.children[index]) { return false }
        index = index + 1
    }
    return true
}

function matchPatternTotalCase(context: CompilerContext, nodes: List<MatchPattern>, node: Integer): Boolean {
    let pattern = nodes[node]
    if pattern.kind != 1 { return false }
    let index = 0
    while index < pattern.children.length {
        if !matchPatternIrrefutable(context, nodes, pattern.children[index]) { return false }
        index = index + 1
    }
    return true
}

function matchPatternExample(context: CompilerContext, type: Integer, depth: Integer): Text {
    if type == 1 { return "0" }
    if type == 2 { return "\"\"" }
    if type == 3 { return "'a'" }
    if type == 4 { return "false" }
    if type == 7 { return "0.0" }
    let cases = matchPatternCases(context, type)
    if cases.length == 0 || depth > 12 { return "_" }
    let best = 1
    let index = 2
    while index < cases.length {
        if matchPatternFields(context, type, cases[index]).length < matchPatternFields(context, type, cases[best]).length { best = index }
        index = index + 1
    }
    let fields = matchPatternFields(context, type, cases[best])
    let result = cases[best]
    if fields.length > 0 {
        result = result + "("
        let first = functionParameterOffset(context.functionParameterCounts, recordTypeIndex(type))
        index = 0
        while index < fields.length {
            if index > 0 { result = result + ", " }
            result = result + matchPatternExample(context, context.functionParameterTypes[first + fields[index]], depth + 1)
            index = index + 1
        }
        result = result + ")"
    }
    return result
}

// Integer witness candidates are small and exact as Floats. Exclude a
// conservative one-unit envelope around each nonzero decimal, so equivalent
// spellings and decimal-to-binary rounding cannot produce a covered example.
function matchFloatMayEqualInteger(context: CompilerContext, pattern: MatchPattern, candidate: Integer): Boolean {
    let location = pattern.location
    let negative = context.tokenKinds[location] == 4
    if negative { location = location + 1 }
    let canonical = checkedFloatLiteral(context.tokenTexts[location], context.tokenLines, location)
    if canonical == "0.0" { return candidate == 0 }
    if negative { return false }
    let exponent = canonical.find("e")
    let order = Integer(canonical.slice(exponent + 1, canonical.length))
    if order < 0 { return candidate == 0 || candidate == 1 }
    let whole = 0
    let digit = 0
    let position = 0
    while digit <= order {
        if whole > candidate { return false }
        if position < exponent && canonical[position] == '.' { position = position + 1 }
        let value = 0
        if position < exponent { value = findCharacter("0123456789", canonical[position]); position = position + 1 }
        whole = whole * 10 + value
        digit = digit + 1
    }
    return whole == candidate || whole + 1 == candidate
}

function missingMatchCase(context: CompilerContext, nodes: List<MatchPattern>, rows: List<PatternRow>, type: Integer, name: Text, fuel: List<Integer>, location: Integer): Boolean {
    let fields = matchPatternFields(context, type, name)
    let types: List<Integer> = []
    let first = functionParameterOffset(context.functionParameterCounts, recordTypeIndex(type))
    let index = 0
    while index < fields.length { types.add(context.functionParameterTypes[first + fields[index]]); index = index + 1 }
    let specialized: List<PatternRow> = []
    let rowIndex = 0
    while rowIndex < rows.length {
        let node = rows[rowIndex].values[0]
        let wildcard = matchPatternWildcard(nodes, node)
        let matches = wildcard
        if !wildcard { matches = nodes[node].kind == 1 && nodes[node].name == name }
        if matches {
            let values: List<Integer> = []
            index = 0
            while index < fields.length {
                if wildcard { values.add(-1) } else { values.add(nodes[node].children[index]) }
                index = index + 1
            }
            specialized.add(PatternRow { values: values })
        }
        rowIndex = rowIndex + 1
    }
    return missingMatchPatterns(context, nodes, specialized, types, fuel, location).missing
}

// Specialize one matrix column at a time. Wildcards expand to constructor
// payloads; guards never enter this matrix. This preserves correlations between
// payloads (covering each field separately would incorrectly accept holes).
function missingMatchPatterns(context: CompilerContext, nodes: List<MatchPattern>, rows: List<PatternRow>, types: List<Integer>, fuel: List<Integer>, location: Integer): PatternWitness {
    fuel[0] = fuel[0] - 1
    if fuel[0] < 0 { failAtToken(context.tokenLines, location, "pattern coverage is too complex; add an else arm") }
    let empty: List<Text> = []
    let rowIndex = 0
    while rowIndex < rows.length {
        let row = rows[rowIndex].values
        let total = true
        let column = 0
        while column < row.length {
            if !matchPatternWildcard(nodes, row[column]) { total = false }
            column = column + 1
        }
        if total { return PatternWitness { missing: false; values: empty } }
        rowIndex = rowIndex + 1
    }
    if rows.length == 0 {
        let values: List<Text> = []
        let index = 0
        while index < types.length { values.add(matchPatternExample(context, types[index], 0)); index = index + 1 }
        return PatternWitness { missing: true; values: values }
    }
    let type = types[0]
    let cases = matchPatternCases(context, type)
    let constructors: List<Text> = []
    let index = 1
    while index < cases.length { constructors.add(cases[index]); index = index + 1 }
    if type == 4 { constructors.add("false"); constructors.add("true") }
    let concrete = false
    rowIndex = 0
    while rowIndex < rows.length {
        if !matchPatternWildcard(nodes, rows[rowIndex].values[0]) { concrete = true }
        rowIndex = rowIndex + 1
    }
    if constructors.length == 0 || !concrete {
        let defaults: List<PatternRow> = []
        rowIndex = 0
        while rowIndex < rows.length {
            let row = rows[rowIndex].values
            if matchPatternWildcard(nodes, row[0]) {
                let tail: List<Integer> = []
                index = 1
                while index < row.length { tail.add(row[index]); index = index + 1 }
                defaults.add(PatternRow { values: tail })
            }
            rowIndex = rowIndex + 1
        }
        let tailTypes: List<Integer> = []
        index = 1
        while index < types.length { tailTypes.add(types[index]); index = index + 1 }
        let witness = missingMatchPatterns(context, nodes, defaults, tailTypes, fuel, location)
        if !witness.missing { return witness }
        let example = matchPatternExample(context, type, 0)
        // Pick an actual scalar outside the explicitly listed literals.
        if constructors.length == 0 && concrete {
            let serial = 0
            let found = false
            while !found {
                if type == 1 { example = Text(serial) }
                if type == 7 { example = Text(serial) + ".0" }
                if type == 2 { example = diagnosticJsonText(Text(serial)) }
                if type == 3 {
                    let code = 97 + serial
                    if serial >= 26 { code = 161 + serial - 26 }
                    if code >= 55296 { code = code + 2048 }
                    if code > 1114111 { failAtToken(context.tokenLines, location, "pattern coverage is too complex; add an else arm") }
                    example = "'" + Text(Character(code)) + "'"
                }
                found = true
                rowIndex = 0
                while rowIndex < rows.length {
                    let node = rows[rowIndex].values[0]
                    if !matchPatternWildcard(nodes, node) {
                        let literal = nodes[node].name
                        if type == 1 { literal = Text(Integer(literal)) }
                        if type == 2 { literal = diagnosticJsonText(literal) }
                        if type == 3 { literal = "'" + literal + "'" }
                        if literal == example { found = false }
                        if type == 7 && matchFloatMayEqualInteger(context, nodes[node], serial) { found = false }
                    }
                    rowIndex = rowIndex + 1
                }
                serial = serial + 1
            }
        }
        let values: List<Text> = [example]
        index = 0
        while index < witness.values.length { values.add(witness.values[index]); index = index + 1 }
        return PatternWitness { missing: true; values: values }
    }
    let constructor = 0
    while constructor < constructors.length {
        let name = constructors[constructor]
        let fields: List<Integer> = []
        if cases.length > 0 { fields = matchPatternFields(context, type, name) }
        let specializedTypes: List<Integer> = []
        if fields.length > 0 {
            let first = functionParameterOffset(context.functionParameterCounts, recordTypeIndex(type))
            index = 0
            while index < fields.length { specializedTypes.add(context.functionParameterTypes[first + fields[index]]); index = index + 1 }
        }
        index = 1
        while index < types.length { specializedTypes.add(types[index]); index = index + 1 }
        let specialized: List<PatternRow> = []
        rowIndex = 0
        while rowIndex < rows.length {
            let row = rows[rowIndex].values
            let node = row[0]
            let wildcard = matchPatternWildcard(nodes, node)
            let matches = wildcard
            if !wildcard { matches = nodes[node].name == name }
            if matches {
                let values: List<Integer> = []
                index = 0
                while index < fields.length {
                    if wildcard { values.add(-1) } else { values.add(nodes[node].children[index]) }
                    index = index + 1
                }
                index = 1
                while index < row.length { values.add(row[index]); index = index + 1 }
                specialized.add(PatternRow { values: values })
            }
            rowIndex = rowIndex + 1
        }
        let witness = missingMatchPatterns(context, nodes, specialized, specializedTypes, fuel, location)
        if witness.missing {
            let example = name
            if fields.length > 0 {
                example = example + "("
                index = 0
                while index < fields.length {
                    if index > 0 { example = example + ", " }
                    example = example + witness.values[index]
                    index = index + 1
                }
                example = example + ")"
            }
            let values: List<Text> = [example]
            index = fields.length
            while index < witness.values.length { values.add(witness.values[index]); index = index + 1 }
            return PatternWitness { missing: true; values: values }
        }
        constructor = constructor + 1
    }
    return PatternWitness { missing: false; values: empty }
}
