function ownershipLimitForBudget(text: Text): Integer {
    let budget = 0
    let position = 0
    let digits = "0123456789"
    while position < text.length {
        let digit = 0
        while digit < 10 && text[position] != digits[digit] { digit = digit + 1 }
        if digit == 10 { fail("cleanup budget must be a positive decimal integer") }
        if budget < 9 {
            budget = budget * 10 + digit
            if budget > 9 { budget = 9 }
        }
        position = position + 1
    }
    if budget == 0 { fail("cleanup budget must be a positive decimal integer") }
    return budget - 1
}

function freestandingModule(llvm: Text): Text {
    let pieces: List<Text> = []
    let start = 0
    let position = 0
    let length = llvm.length
    while position < length {
        if llvm[position] == '\n' {
            if position > start + 8 && llvm[start] == 'd' && llvm[position - 1] == '{' && llvm.slice(start, start + 7) == "define " {
                pieces.add(llvm.slice(start, position - 1))
                pieces.add("noredzone {\n")
            } else {
                pieces.add(llvm.slice(start, position + 1))
            }
            start = position + 1
        }
        position = position + 1
    }
    pieces.add(llvm.slice(start, length))
    return joinText(pieces)
}

function main() {
    if processInfo.argumentCount() == 0 {
        print("Minyar compiler bootstrap is ready")
        print(characterIsLetter('M'))
        print(characterIsDigit('x'))
    } else {
        let stackOwnerLimit = 0
        let library = ""
        let freestanding = false
        let testing = false
        let listTests = false
        let options = 2
        let moduleState = processInfo.argumentCount() > 2 && processInfo.argument(2) == "--module-state"
        if moduleState {
            if processInfo.argumentCount() < 6 { fail("invalid module compiler arguments") }
            options = 6
        }
        while options < processInfo.argumentCount() {
            let option = processInfo.argument(options)
            if option == "--list-tests" {
                listTests = true
            } else if option == "--test-mode" {
                testing = true
            } else if option == "--freestanding" {
                freestanding = true
            } else {
                if option == "--bounded-owners" {
                    stackOwnerLimit = 8
                    if options + 1 < processInfo.argumentCount() && processInfo.argument(options + 1) != "--library" && processInfo.argument(options + 1) != "--bounded-owners" && processInfo.argument(options + 1) != "--freestanding" && processInfo.argument(options + 1) != "--test-mode" && processInfo.argument(options + 1) != "--list-tests" {
                        stackOwnerLimit = ownershipLimitForBudget(processInfo.argument(options + 1))
                        options = options + 1
                    }
                } else {
                    if option == "--library" && options + 1 < processInfo.argumentCount() {
                        if library != "" { library = library + "\n" }
                        library = library + processInfo.argument(options + 1)
                        options = options + 1
                    } else {
                        fail("usage: compiler SOURCE OUTPUT [--bounded-owners [BUDGET]] [--library DIRECTORY] [--freestanding]")
                    }
                }
            }
            options = options + 1
        }
        let pieces: List<Text> = []
        if listTests {
            pieces.add(moduleTestListing(processInfo.argument(0)))
        } else if testing {
            if moduleState { fail("test mode requires a whole-module build") }
            pieces = compileEntryConfigured(processInfo.argument(0), stackOwnerLimit, library, true)
        } else if moduleState {
            pieces.add(compileModuleEntry(processInfo.argument(0), processInfo.argument(3), processInfo.argument(4), processInfo.argument(5), stackOwnerLimit, library))
        } else {
            pieces = compileEntryWithLibrary(processInfo.argument(0), stackOwnerLimit, library)
        }
        if freestanding {
            let module: List<Text> = []
            module.add(freestandingModule(joinText(pieces)))
            pieces = module
        }
        if processInfo.argumentCount() == 1 { print(joinText(pieces)) } else { io.writeTextParts(processInfo.argument(1), pieces) }
    }
}
