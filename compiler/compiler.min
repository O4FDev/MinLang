function ownershipLimitForBudget(text: Text): Integer {
    let budget = 0
    let position = 0
    let digits = "0123456789"
    while position < text.length {
        let digit = 0
        while digit < 10 && text[position] != digits[digit] { digit = digit + 1 }
        if digit == 10 { fail("cleanup budget must be a positive decimal integer") }
        if budget < 9 {
            budget = budget * 10 + digit
            if budget > 9 { budget = 9 }
        }
        position = position + 1
    }
    if budget == 0 { fail("cleanup budget must be a positive decimal integer") }
    return budget - 1
}

// Freestanding programs run with interrupts that arrive on the current stack,
// so no function may keep data in the 128 bytes below the stack pointer.
function freestandingModule(llvm: Text): Text {
    let pieces: List<Text> = []
    let start = 0
    let position = 0
    let length = llvm.length
    while position < length {
        if llvm[position] == '\n' {
            if position > start + 8 && llvm[start] == 'd' && llvm[position - 1] == '{' && llvm.slice(start, start + 7) == "define " {
                pieces.add(llvm.slice(start, position - 1))
                pieces.add("noredzone {\n")
            } else {
                pieces.add(llvm.slice(start, position + 1))
            }
            start = position + 1
        }
        position = position + 1
    }
    pieces.add(llvm.slice(start, length))
    return joinText(pieces)
}

function main() {
    if argumentCount() == 0 {
        print("Minyar compiler bootstrap is ready")
        print(characterIsLetter('M'))
        print(characterIsDigit('x'))
    } else {
        let stackOwnerLimit = 0
        let library = ""
        let freestanding = false
        let position = 2
        while position < argumentCount() {
            if argument(position) == "--freestanding" {
                freestanding = true
            } else {
            if argument(position) == "--bounded-owners" {
                stackOwnerLimit = 8
                if position + 1 < argumentCount() && argument(position + 1) != "--library" && argument(position + 1) != "--bounded-owners" && argument(position + 1) != "--freestanding" {
                    stackOwnerLimit = ownershipLimitForBudget(argument(position + 1))
                    position = position + 1
                }
            } else {
                if argument(position) == "--library" && position + 1 < argumentCount() {
                    if library != "" { library = library + "\n" }
                    library = library + argument(position + 1)
                    position = position + 1
                } else {
                    fail("usage: compiler SOURCE OUTPUT [--bounded-owners [BUDGET]] [--library DIRECTORY] [--freestanding]")
                }
            }
            }
            position = position + 1
        }
        let pieces = compileEntryWithLibrary(argument(0), stackOwnerLimit, library)
        if freestanding {
            let module: List<Text> = []
            module.add(freestandingModule(joinText(pieces)))
            pieces = module
        }
        if argumentCount() == 1 {
            print(joinText(pieces))
        } else {
            writeTextFile(argument(1), pieces)
        }
    }
}
