// Token positions stay numeric until a diagnostic or persisted interface needs Text.
// Coordinates are full-width line/column pairs. Default source paths need no index.
record SourceMap {
    coordinates: List<Integer>
    paths: List<Text>
    origins: List<Text>
    pathIndices: List<Integer>
}

function newSourceMap(): SourceMap {
    let coordinates: List<Integer> = []
    let paths: List<Text> = []
    let origins: List<Text> = []
    let pathIndices: List<Integer> = []
    paths.add("")
    return SourceMap { coordinates: coordinates, paths: paths, origins: origins, pathIndices: pathIndices }
}

function sourcePath(locations: SourceMap, path: Text): Integer {
    let paths = locations.paths
    let index = findText(paths, path)
    if index < 0 {
        index = paths.length
        paths.add(path)
    }
    return index
}

function tokenPath(locations: SourceMap, position: Integer): Text {
    let indices = locations.pathIndices
    if position < indices.length { return locations.paths[indices[position]] }
    return locations.paths[0]
}

// A private record field is stored as its name, a space and the path of the
// module that declares it, so symbol tables and cached interfaces carry its
// visibility unchanged. Names never contain spaces.
function declaredFieldName(stored: Text): Text {
    let position = 0
    while position < stored.length {
        if stored[position] == ' ' { return stored.slice(0, position) }
        position = position + 1
    }
    return stored
}

function isFieldNamed(stored: Text, name: Text): Boolean {
    if stored == name { return true }
    return stored.length > name.length && stored[name.length] == ' ' && stored.slice(0, name.length) == name
}

// Only code in the declaring module may read, assign or initialize a private field.
function checkFieldAccess(locations: SourceMap, stored: Text, recordName: Text, position: Integer) {
    let name = declaredFieldName(stored)
    if stored.length > name.length && stored.slice(name.length + 1, stored.length) != tokenPath(locations, position) {
        fail(describeLocation(tokenLocation(locations, position)) + ": field '" + name + "' of record '" + readableDeclarationName(recordName) + "' is private to its module")
    }
}

function setTokenPath(locations: SourceMap, position: Integer, path: Integer) {
    let indices = locations.pathIndices
    if path != 0 || position < indices.length {
        while indices.length <= position { indices.add(0) }
        indices[position] = path
    }
}

function tokenLocation(locations: SourceMap, position: Integer): Text {
    let coordinates = locations.coordinates
    let line = coordinates[position * 2]
    let indices = locations.pathIndices
    let pathIndex = 0
    if position < indices.length { pathIndex = indices[position] }
    let path = locations.paths[pathIndex]
    if line == 0 { return path }
    let result = ""
    if line == -1 {
        result = locations.origins[position]
    } else {
        result = sourceLocation(line, coordinates[position * 2 + 1])
    }
    if path != "" { return path + ":" + result }
    return result
}

// Cached interface origins retain their existing wire format. Only summaries
// use this sparse override; normal source tokens allocate no origin strings.
function setTokenOrigin(locations: SourceMap, position: Integer, origin: Text) {
    let origins = locations.origins
    while origins.length <= position { origins.add("") }
    origins[position] = origin
    locations.coordinates[position * 2] = -1
}

function copyModuleToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, locations: SourceMap, kind: Integer, text: Text, source: SourceMap, position: Integer, origin: Integer) {
    let target = tokenKinds.length
    tokenKinds.add(kind)
    tokenTexts.add(text)
    let from = source.coordinates
    let to = locations.coordinates
    to.add(from[position * 2])
    to.add(from[position * 2 + 1])
    setTokenPath(locations, target, origin)
    if from[position * 2] == -1 { setTokenOrigin(locations, target, source.origins[position]) }
}

function addEndToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, locations: SourceMap, description: Text) {
    let target = tokenKinds.length
    tokenKinds.add(0)
    tokenTexts.add("")
    let coordinates = locations.coordinates
    coordinates.add(0)
    coordinates.add(0)
    setTokenPath(locations, target, sourcePath(locations, description))
}

function characterIsDigit(character: Character): Boolean {
    return character >= '0' && character <= '9'
}

function characterIsHexDigit(character: Character): Boolean {
    return characterIsDigit(character) || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F')
}

function hexDigitValue(character: Character): Integer {
    let digits = "0123456789abcdef"
    let lower = character
    if character >= 'A' && character <= 'F' {
        lower = digits[10 + findCharacter("ABCDEF", character)]
    }
    return findCharacter(digits, lower)
}

function findCharacter(text: Text, wanted: Character): Integer {
    let position = 0
    while position < text.length {
        if text[position] == wanted {
            return position
        }
        position = position + 1
    }
    return -1
}

function characterIsLetter(character: Character): Boolean {
    let lowercase = character >= 'a' && character <= 'z'
    let uppercase = character >= 'A' && character <= 'Z'
    return lowercase || uppercase
}

function characterIsWhitespace(character: Character): Boolean {
    return character == ' ' || character == '\n' || character == '\r' || character == '\t'
}

function sourceLocation(line: Integer, column: Integer): Text {
    return Text(line) + ", column " + Text(column)
}

function addToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, coordinates: List<Integer>, kind: Integer, text: Text, line: Integer, column: Integer) {
    tokenKinds.add(kind)
    tokenTexts.add(text)
    coordinates.add(line)
    coordinates.add(column)
}

function lineCanEndStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>): Boolean {
    let result = false
    if tokenKinds.length > 0 {
        let last = tokenKinds.length - 1
        let kind = tokenKinds[last]
        if kind == 1 || kind == 2 || kind == 3 || kind == 5 || kind == 7 {
            result = true
        } else {
            if kind == 4 {
                let text = tokenTexts[last]
                result = text == ")" || text == "]" || text == "}"
            }
        }
    }
    return result
}

function tokenize(source: Text, tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap) {
    let firstToken = tokenKinds.length
    let coordinates = tokenLines.coordinates
    let position = 0
    let line = 1
    let lineStart = 0
    let length = source.length
    let roundDepth = 0
    let squareDepth = 0
    // UTF-8 permits a leading byte-order mark. Treat it as an encoding marker,
    // never as an invisible punctuation token in a later diagnostic.
    if length > 0 && source[0] == Character(65279) {
        position = 1
    }

    while position < length {
        let character = source[position]

        if character == ' ' || character == '\n' || character == '\r' || character == '\t' {
            if character == '\n' {
                if roundDepth == 0 && squareDepth == 0 && lineCanEndStatement(tokenKinds, tokenTexts) {
                    addToken(tokenKinds, tokenTexts, coordinates, 6, "end of line", line, position - lineStart + 1)
                }
                line = line + 1
                lineStart = position + 1
            }
            position = position + 1
        } else {
            if character == '/' && position + 1 < length && source[position + 1] == '/' {
                position = position + 2
                while position < length && source[position] != '\n' {
                    position = position + 1
                }
            } else {
                if character == '/' && position + 1 < length && source[position + 1] == '*' {
                    let commentLine = line
                    let commentColumn = position - lineStart + 1
                    position = position + 2
                    while position + 1 < length && !(source[position] == '*' && source[position + 1] == '/') {
                        if source[position] == '\n' {
                            line = line + 1
                            lineStart = position + 1
                        }
                        position = position + 1
                    }
                    if position + 1 >= length {
                        fail("line " + sourceLocation(commentLine, commentColumn) + ": block comment is missing its closing */")
                    }
                    position = position + 2
                } else {
                    if (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_' {
                        let start = position
                        let tokenLine = line
                        let tokenColumn = position - lineStart + 1
                        // The outer loop already classified the first character.
                        // Read each continuation once, including one delimiter peek.
                        position = position + 1
                        let inName = true
                        while position < length && inName {
                            let next = source[position]
                            inName = (next >= 'a' && next <= 'z') || (next >= 'A' && next <= 'Z') || (next >= '0' && next <= '9') || next == '_'
                            if inName { position = position + 1 }
                        }
                        let name = source.slice(start, position)
                        addToken(tokenKinds, tokenTexts, coordinates, 1, name, tokenLine, tokenColumn)
                    } else {
                        if character >= '0' && character <= '9' {
                            let start = position
                            let tokenLine = line
                            let tokenColumn = position - lineStart + 1
                            while position < length && characterIsDigit(source[position]) {
                                position = position + 1
                            }
                            let numberKind = 2
                            let hexValue = -1
                            let hexMinimum = false
                            if character == '0' && position == start + 1 && position + 1 < length && source[position] == 'x' && characterIsHexDigit(source[position + 1]) {
                                position = position + 1
                                hexValue = 0
                                while position < length && characterIsHexDigit(source[position]) {
                                    let digit = hexDigitValue(source[position])
                                    if hexValue > (9223372036854775807 - digit) / 16 {
                                        // Preserve exactly 2^63 as a magnitude
                                        // token; unary minus, rather than lexical
                                        // context, decides whether it is legal.
                                        if hexValue == 576460752303423488 && digit == 0 && (position + 1 == length || !characterIsHexDigit(source[position + 1])) {
                                            hexMinimum = true
                                        } else {
                                            fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Integer literal is outside the supported range")
                                        }
                                    }
                                    if !hexMinimum { hexValue = hexValue * 16 + digit }
                                    position = position + 1
                                }
                            }
                            if hexValue >= 0 && position + 1 < length && source[position] == '.' && characterIsDigit(source[position + 1]) {
                                fail("line " + sourceLocation(tokenLine, tokenColumn) + ": hexadecimal literals are Integers and cannot have a decimal point")
                            }
                            // A Float needs digits on both sides of its point, so
                            // ranges such as 0..count remain two Integer tokens.
                            if numberKind == 2 && position + 1 < length && source[position] == '.' && characterIsDigit(source[position + 1]) {
                                numberKind = 7
                                position = position + 1
                                while position < length && characterIsDigit(source[position]) {
                                    position = position + 1
                                }
                                if position < length && (source[position] == 'e' || source[position] == 'E') {
                                    position = position + 1
                                    if position < length && (source[position] == '+' || source[position] == '-') {
                                        position = position + 1
                                    }
                                    if position >= length || !characterIsDigit(source[position]) {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": a Float exponent needs digits, as in 1.5e3")
                                    }
                                    while position < length && characterIsDigit(source[position]) {
                                        position = position + 1
                                    }
                                }
                            }
                            let digits = source.slice(start, position)
                            if hexValue >= 0 {
                                if hexMinimum { digits = "9223372036854775808" } else { digits = Text(hexValue) }
                            }
                            addToken(tokenKinds, tokenTexts, coordinates, numberKind, digits, tokenLine, tokenColumn)
                        } else {
                            if character == '"' {
                                let tokenLine = line
                                let tokenColumn = position - lineStart + 1
                                position = position + 1
                                let chunkStart = position
                                while position < length && source[position] != '"' && source[position] != '\\' {
                                    if source[position] == '\n' {
                                        line = line + 1
                                        lineStart = position + 1
                                    }
                                    position = position + 1
                                }
                                if position >= length {
                                    fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Text literal is missing its closing quote")
                                }
                                let text = ""
                                if position < length && source[position] == '\\' {
                                    let pieces: List<Text> = []
                                    while position < length && source[position] != '"' {
                                        if source[position] == '\\' && position + 1 < length {
                                            if chunkStart < position {
                                                pieces.add(source.slice(chunkStart, position))
                                            }
                                            let escape = source[position + 1]
                                            if escape == '\n' {
                                                line = line + 1
                                                lineStart = position + 2
                                            }
                                            if escape == 'n' {
                                                pieces.add(Text('\n'))
                                            } else {
                                                if escape == 'r' {
                                                    pieces.add(Text('\r'))
                                                } else {
                                                    if escape == 't' {
                                                        pieces.add(Text('\t'))
                                                    } else {
                                                        pieces.add(Text(escape))
                                                    }
                                                }
                                            }
                                            position = position + 2
                                            chunkStart = position
                                        } else {
                                            if source[position] == '\n' {
                                                line = line + 1
                                                lineStart = position + 1
                                            }
                                            position = position + 1
                                        }
                                    }
                                    if position >= length {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Text literal is missing its closing quote")
                                    }
                                    if chunkStart < position {
                                        pieces.add(source.slice(chunkStart, position))
                                    }
                                    text = joinText(pieces)
                                } else {
                                    text = source.slice(chunkStart, position)
                                }
                                position = position + 1
                                addToken(tokenKinds, tokenTexts, coordinates, 3, text, tokenLine, tokenColumn)
                            } else {
                                if character > '~' {
                                    fail("line " + Text(line) + ", column " + Text(position - lineStart + 1) + ": names must use ASCII letters, digits, and '_'; found non-ASCII character '" + Text(character) + "'")
                                }
                                if character == '\'' {
                                    let tokenLine = line
                                    let tokenColumn = position - lineStart + 1
                                    position = position + 1
                                    if position >= length {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Character literal is missing its value and closing quote")
                                    }
                                    let value = source[position]
                                    if value == '\\' {
                                        position = position + 1
                                        if position >= length {
                                            fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Character literal has an unfinished escape")
                                        }
                                        let escape = source[position]
                                        if escape == 'n' {
                                            value = '\n'
                                        } else {
                                            if escape == 'r' {
                                                value = '\r'
                                            } else {
                                                if escape == 't' {
                                                    value = '\t'
                                                } else {
                                                    value = escape
                                                }
                                            }
                                        }
                                    }
                                    if source[position] == '\n' {
                                        line = line + 1
                                        lineStart = position + 1
                                    }
                                    position = position + 1
                                    if position >= length || source[position] != '\'' {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Character literal must contain exactly one character and a closing quote")
                                    }
                                    position = position + 1
                                    addToken(tokenKinds, tokenTexts, coordinates, 5, Text(value), tokenLine, tokenColumn)
                                } else {
                                    let punctuationColumn = position - lineStart + 1
                                    let punctuation = Text(character)
                                    if position + 1 < length {
                                        let next = source[position + 1]
                                        let doubled = false
                                        if next == '=' {
                                            doubled = character == '=' || character == '!' || character == '<' || character == '>' || character == '+' || character == '-' || character == '*' || character == '/' || character == '%'
                                        } else {
                                            doubled = (character == '&' && next == '&') || (character == '|' && next == '|') || (character == '<' && next == '<') || (character == '>' && next == '>') || (character == '.' && next == '.')
                                        }
                                        if doubled {
                                            punctuation = punctuation + Text(next)
                                            position = position + 1
                                        }
                                    }
                                    let punctuationKind = 4
                                    if punctuation == "(" { roundDepth = roundDepth + 1 }
                                    if punctuation == ")" && roundDepth > 0 { roundDepth = roundDepth - 1 }
                                    if punctuation == "[" { squareDepth = squareDepth + 1 }
                                    if punctuation == "]" && squareDepth > 0 { squareDepth = squareDepth - 1 }
                                    if punctuation == ";" {
                                        punctuationKind = 6
                                    }
                                    addToken(tokenKinds, tokenTexts, coordinates, punctuationKind, punctuation, line, punctuationColumn)
                                    position = position + 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    addToken(tokenKinds, tokenTexts, coordinates, 0, "", line, position - lineStart + 1)
    // `parallel function` declares a function that may run on any processor.
    // The modifier becomes a line break whose text still reads "parallel":
    // every pass treats it as whitespace, and compileTokens recovers it.
    let scan = firstToken
    while scan + 1 < tokenKinds.length {
        // `public parallel function` becomes `parallel public function`, so
        // the modifier always comes first and `public function` stays intact.
        if scan + 2 < tokenKinds.length && tokenKinds[scan] == 1 && tokenTexts[scan] == "public" && tokenKinds[scan + 1] == 1 && tokenTexts[scan + 1] == "parallel" && tokenKinds[scan + 2] == 1 && tokenTexts[scan + 2] == "function" {
            tokenKinds[scan] = 6
            tokenTexts[scan] = "parallel"
            tokenTexts[scan + 1] = "public"
        }
        if tokenKinds[scan] == 1 && tokenTexts[scan] == "parallel" && tokenKinds[scan + 1] == 1 && tokenTexts[scan + 1] == "function" {
            tokenKinds[scan] = 6
        }
        scan = scan + 1
    }
}

function describeLocation(location: Text): Text {
    if location.length > 0 && location[0] >= '0' && location[0] <= '9' {
        return "line " + location
    }
    return location
}

function escapeLLVMText(text: Text): Text {
    let pieces: List<Text> = []
    let chunkStart = 0
    let changed = false
    let position = 0
    while position < text.length {
        let character = text[position]
        let replacement = ""
        if character == '\n' {
            replacement = "\\0A"
        } else {
            if character == '\r' {
                replacement = "\\0D"
            } else {
                if character == '\t' {
                    replacement = "\\09"
                } else {
                    if character == '"' {
                        replacement = "\\22"
                    } else {
                        if character == '\\' {
                            replacement = "\\5C"
                        }
                    }
                }
            }
        }
        if replacement != "" {
            if chunkStart < position {
                pieces.add(text.slice(chunkStart, position))
            }
            pieces.add(replacement)
            changed = true
            chunkStart = position + 1
        }
        position = position + 1
    }
    if !changed {
        return text
    }
    if chunkStart < position {
        pieces.add(text.slice(chunkStart, position))
    }
    return joinText(pieces)
}

function tokenIs(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: List<Integer>, expected: Text): Boolean {
    let kind = tokenKinds[cursor[0]]
    return kind != 2 && kind != 3 && kind != 5 && kind != 7 && tokenTexts[cursor[0]] == expected
}

function expectToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>, expected: Text) {
    if !tokenIs(tokenKinds, tokenTexts, cursor, expected) {
        fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": expected '" + expected + "', found '" + tokenTexts[cursor[0]] + "'")
    }
    cursor[0] = cursor[0] + 1
}

function skipTerminators(tokenKinds: List<Integer>, cursor: List<Integer>) {
    while tokenKinds[cursor[0]] == 6 {
        cursor[0] = cursor[0] + 1
    }
}

function finishStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>) {
    if tokenKinds[cursor[0]] == 6 {
        skipTerminators(tokenKinds, cursor)
    } else {
        if tokenKinds[cursor[0]] != 0 && !tokenIs(tokenKinds, tokenTexts, cursor, "}") {
            fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": unexpected '" + tokenTexts[cursor[0]] + "'; start the next statement on a new line")
        }
    }
}

function simpleTypeCode(name: Text): Integer {
    let code = 0
    if name == "Integer" {
        code = 1
    } else {
        if name == "Text" {
            code = 2
        } else {
            if name == "Character" {
                code = 3
            } else {
                if name == "Boolean" {
                    code = 4
                } else {
                    if name == "Nothing" {
                        code = 5
                    }
                    if name == "Float" {
                        code = 7
                    }
                    if name == "Bytes" {
                        code = 8
                    }
                }
            }
        }
    }
    return code
}

function findSymbol(symbolNames: List<Text>, symbolKinds: List<Integer>, name: Text, kind: Integer): Integer {
    let position = 0
    let found = -1
    while position < symbolNames.length && found == -1 {
        if symbolKinds[position] == kind && symbolNames[position] == name {
            found = position
        }
        position = position + 1
    }
    return found
}

function compareText(left: Text, right: Text): Integer {
    let shared = left.length
    if right.length < shared {
        shared = right.length
    }
    let position = 0
    while position < shared && left[position] == right[position] {
        position = position + 1
    }
    if position < shared {
        if left[position] < right[position] {
            return -1
        }
        return 1
    }
    if left.length < right.length {
        return -1
    }
    if left.length > right.length {
        return 1
    }
    return 0
}

function compareSymbol(symbolNames: List<Text>, symbolKinds: List<Integer>, left: Integer, right: Integer): Integer {
    let order = compareText(symbolNames[left], symbolNames[right])
    if order == 0 {
        if symbolKinds[left] < symbolKinds[right] {
            order = -1
        } else {
            if symbolKinds[left] > symbolKinds[right] {
                order = 1
            }
        }
    }
    return order
}

function siftSymbolLookup(lookup: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, start: Integer, count: Integer) {
    let root = start
    let searching = true
    while searching {
        let child = root * 2 + 1
        if child >= count {
            searching = false
        } else {
            let selected = child
            if child + 1 < count && compareSymbol(symbolNames, symbolKinds, lookup[child], lookup[child + 1]) < 0 {
                selected = child + 1
            }
            if compareSymbol(symbolNames, symbolKinds, lookup[root], lookup[selected]) < 0 {
                let held = lookup[root]
                lookup[root] = lookup[selected]
                lookup[selected] = held
                root = selected
            } else {
                searching = false
            }
        }
    }
}

function buildSymbolLookup(symbolNames: List<Text>, symbolKinds: List<Integer>): List<Integer> {
    let lookup: List<Integer> = []
    let position = 0
    while position < symbolNames.length {
        lookup.add(position)
        position = position + 1
    }
    let start = lookup.length / 2
    while start > 0 {
        start = start - 1
        siftSymbolLookup(lookup, symbolNames, symbolKinds, start, lookup.length)
    }
    let end = lookup.length
    while end > 1 {
        end = end - 1
        let held = lookup[0]
        lookup[0] = lookup[end]
        lookup[end] = held
        siftSymbolLookup(lookup, symbolNames, symbolKinds, 0, end)
    }
    return lookup
}

function requireUniqueSymbols(lookup: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>) {
    let position = 1
    while position < lookup.length {
        let previous = lookup[position - 1]
        let current = lookup[position]
        if symbolKinds[previous] == symbolKinds[current] && symbolNames[previous] == symbolNames[current] {
            let duplicate = current
            if previous > current { duplicate = previous }
            fail(describeLocation(symbolLocations[duplicate]) + ": module declares '" + readableDeclarationName(symbolNames[current]) + "' more than once")
        }
        position = position + 1
    }
}

function findIndexedSymbol(lookup: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, name: Text, kind: Integer): Integer {
    let low = 0
    let high = lookup.length
    while low < high {
        let middle = low + (high - low) / 2
        let symbol = lookup[middle]
        let order = compareText(symbolNames[symbol], name)
        if order == 0 {
            if symbolKinds[symbol] < kind {
                order = -1
            } else {
                if symbolKinds[symbol] > kind {
                    order = 1
                }
            }
        }
        if order < 0 {
            low = middle + 1
        } else {
            high = middle
        }
    }
    if low < lookup.length {
        let symbol = lookup[low]
        if symbolKinds[symbol] == kind && symbolNames[symbol] == name {
            return symbol
        }
    }
    return -1
}

function findCompiledSymbol(symbolNames: List<Text>, symbolKinds: List<Integer>, symbolReturnTypes: List<Integer>, name: Text, kind: Integer): Integer {
    let count = symbolNames.length
    let low = 0
    let high = count
    while low < high {
        let middle = low + (high - low) / 2
        let symbol = symbolReturnTypes[count + middle]
        let order = compareText(symbolNames[symbol], name)
        if order == 0 {
            if symbolKinds[symbol] < kind {
                order = -1
            } else {
                if symbolKinds[symbol] > kind {
                    order = 1
                }
            }
        }
        if order < 0 {
            low = middle + 1
        } else {
            high = middle
        }
    }
    if low < count {
        let symbol = symbolReturnTypes[count + low]
        if symbolKinds[symbol] == kind && symbolNames[symbol] == name {
            return symbol
        }
    }
    return -1
}

function takeType(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>): Integer {
    let name = tokenTexts[cursor[0]]
    let code = simpleTypeCode(name)
    if name == "List" {
        // Take every nested opener first: one '>>' token can close two Lists.
        let depth = 0
        while tokenKinds[cursor[0]] == 1 && tokenTexts[cursor[0]] == "List" {
            cursor[0] = cursor[0] + 1
            expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "<")
            depth = depth + 1
        }
        code = depth * 100000 + takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
        while depth > 0 {
            if depth >= 2 && tokenIs(tokenKinds, tokenTexts, cursor, ">>") {
                cursor[0] = cursor[0] + 1
                depth = depth - 2
            } else {
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ">")
                depth = depth - 1
            }
        }
    } else {
        if code == 0 {
            let record = findSymbol(symbolNames, symbolKinds, name, 2)
            if record < 0 {
                fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": unknown type '" + name + "'")
            }
            code = 1000 + record
        }
        cursor[0] = cursor[0] + 1
    }
    return code
}

function takeValueType(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>): Integer {
    let type = takeType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
    if type == 5 {
        fail("Nothing cannot be used as a value type")
    }
    return type
}

function skipDeclaration(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: List<Integer>) {
    let position = cursor[0]
    let kind = tokenKinds[position]
    while kind != 0 && !(kind == 4 && tokenTexts[position] == "{") {
        position = position + 1
        kind = tokenKinds[position]
    }
    if kind == 0 {
        fail("a declaration is missing its '{ ... }' body")
    }
    position = position + 1
    let depth = 1
    kind = tokenKinds[position]
    while depth > 0 && kind != 0 {
        if kind == 4 {
            let token = tokenTexts[position]
            if token == "{" {
                depth = depth + 1
            }
            if token == "}" {
                depth = depth - 1
            }
        }
        position = position + 1
        kind = tokenKinds[position]
    }
    cursor[0] = position
    if depth > 0 {
        fail("a declaration is missing its closing '}'")
    }
}

function skipTopLevelStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: List<Integer>) {
    let roundDepth = 0
    let squareDepth = 0
    let curlyDepth = 0
    let position = cursor[0]
    let kind = tokenKinds[position]
    while kind != 0 && !(kind == 6 && roundDepth == 0 && squareDepth == 0 && curlyDepth == 0) {
        if kind == 4 {
            let token = tokenTexts[position]
            if token == "(" {
                roundDepth = roundDepth + 1
            }
            if token == ")" {
                roundDepth = roundDepth - 1
            }
            if token == "[" {
                squareDepth = squareDepth + 1
            }
            if token == "]" {
                squareDepth = squareDepth - 1
            }
            if token == "{" {
                curlyDepth = curlyDepth + 1
            }
            if token == "}" {
                curlyDepth = curlyDepth - 1
            }
        }
        position = position + 1
        kind = tokenKinds[position]
    }
    cursor[0] = position
    skipTerminators(tokenKinds, cursor)
}

function discoverRecordNames(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>, declarationEnds: List<Integer>): Boolean {
    let cursor: List<Integer> = []
    cursor.add(0)
    let topLevelStatements = false
    skipTerminators(tokenKinds, cursor)
    while tokenKinds[cursor[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
            let name = tokenTexts[cursor[0] + 1]
            let index = symbolNames.length
            symbolNames.add(name)
            symbolKinds.add(2)
            symbolLocations.add(tokenLocation(tokenLines, cursor[0] + 1))
            symbolReturnTypes.add(1000 + index)
            symbolParameterCounts.add(0)
        }
        if tokenIs(tokenKinds, tokenTexts, cursor, "constant") {
            addConstantSymbol(tokenTexts, tokenLines, cursor[0], symbolNames, symbolKinds, symbolLocations, symbolReturnTypes, symbolParameterCounts)
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            declarationEnds.add(cursor[0])
        } else {
        if tokenIs(tokenKinds, tokenTexts, cursor, "record") || tokenIs(tokenKinds, tokenTexts, cursor, "function") {
            skipDeclaration(tokenKinds, tokenTexts, cursor)
            declarationEnds.add(cursor[0])
        } else {
            topLevelStatements = true
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
        }
        }
        skipTerminators(tokenKinds, cursor)
    }
    return topLevelStatements
}

function recordScannedDeclarations(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, scannedStarts: List<Integer>, scannedEnds: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>, declarationEnds: List<Integer>): Boolean {
    let topLevelStatements = false
    let scanned = 0
    let declaration = 0
    let cursor: List<Integer> = []
    cursor.add(0)
    while scanned < scannedStarts.length {
        let start = scannedStarts[scanned]
        if start < 0 {
            topLevelStatements = true
        } else {
            cursor[0] = start
            if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
                let index = symbolNames.length
                symbolNames.add(tokenTexts[start + 1])
                symbolKinds.add(2)
                symbolLocations.add(tokenLocation(tokenLines, start + 1))
                symbolReturnTypes.add(1000 + index)
                symbolParameterCounts.add(0)
            }
            if tokenIs(tokenKinds, tokenTexts, cursor, "constant") {
                addConstantSymbol(tokenTexts, tokenLines, start, symbolNames, symbolKinds, symbolLocations, symbolReturnTypes, symbolParameterCounts)
            }
            declarationEnds.add(scannedEnds[declaration])
            declaration = declaration + 1
        }
        scanned = scanned + 1
    }
    return topLevelStatements
}

// Constants are symbols of kind 3. discoverDeclarations fills in the type and
// stores the literal's token position where functions keep a parameter count.
function addConstantSymbol(tokenTexts: List<Text>, tokenLines: SourceMap, start: Integer, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>) {
    symbolNames.add(tokenTexts[start + 1])
    symbolKinds.add(3)
    symbolLocations.add(tokenLocation(tokenLines, start + 1))
    symbolReturnTypes.add(0)
    symbolParameterCounts.add(0)
}

// A constant's value is one literal, optionally negated. Its type comes from
// the literal and must match an optional annotation.
function takeConstant(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLookup: List<Integer>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>) {
    expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "constant")
    let name = tokenTexts[cursor[0]]
    let location = cursor[0]
    if tokenKinds[cursor[0]] != 1 {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": expected a name after constant")
    }
    let constant = findIndexedSymbol(symbolLookup, symbolNames, symbolKinds, name, 3)
    cursor[0] = cursor[0] + 1
    let declared = 0
    if tokenIs(tokenKinds, tokenTexts, cursor, ":") {
        cursor[0] = cursor[0] + 1
        declared = takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "=")
    let valueStart = cursor[0]
    let literal = cursor[0]
    if tokenIs(tokenKinds, tokenTexts, cursor, "-") {
        literal = literal + 1
    }
    let kind = tokenKinds[literal]
    let type = 0
    if kind == 2 { type = 1 }
    if kind == 7 { type = 7 }
    if literal == valueStart {
        if kind == 3 { type = 2 }
        if kind == 5 { type = 3 }
        if kind == 1 && (tokenTexts[literal] == "true" || tokenTexts[literal] == "false") { type = 4 }
    }
    if type == 0 || (tokenKinds[literal + 1] != 6 && tokenKinds[literal + 1] != 0) {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": a constant needs one literal value, such as 16, -2.5, \"text\", 'c', or true")
    }
    if declared != 0 && declared != type {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": the value for constant '" + readableDeclarationName(name) + "' is " + describeType(type) + ", not " + describeType(declared))
    }
    // Declarations are checked even when no expression uses their value.
    if type == 1 {
        checkedIntegerLiteral(tokenTexts[literal], literal != valueStart, tokenLines, literal)
    }
    if type == 7 {
        checkedFloatLiteral(tokenTexts[literal], tokenLines, literal)
    }
    symbolReturnTypes[constant] = type
    symbolParameterCounts[constant] = valueStart
    cursor[0] = literal + 1
}

function discoverDeclarations(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolLookup: List<Integer>, symbolParameterCounts: List<Integer>, symbolParameterNames: List<Text>, symbolParameterTypes: List<Integer>, parameterStarts: List<Integer>, declarationEnds: List<Integer>) {
    let cursor: List<Integer> = []
    cursor.add(0)
    let declaration = 0
    skipTerminators(tokenKinds, cursor)
    while tokenKinds[cursor[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, cursor, "constant") {
            declaration = declaration + 1
            takeConstant(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds, symbolLookup, symbolReturnTypes, symbolParameterCounts)
        } else {
        if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
            declaration = declaration + 1
            cursor[0] = cursor[0] + 1
            if tokenKinds[cursor[0]] != 1 {
                fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": expected a name after record")
            }
            let record = findIndexedSymbol(symbolLookup, symbolNames, symbolKinds, tokenTexts[cursor[0]], 2)
            cursor[0] = cursor[0] + 1
            expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "{")
            skipTerminators(tokenKinds, cursor)
            let count = 0
            let first = symbolParameterNames.length
            parameterStarts[record] = first
            while !tokenIs(tokenKinds, tokenTexts, cursor, "}") {
                // `private name: Type`; a field may itself be named private.
                let visibility = ""
                if tokenTexts[cursor[0]] == "private" && tokenKinds[cursor[0]] == 1 && tokenKinds[cursor[0] + 1] == 1 {
                    visibility = " " + tokenPath(tokenLines, cursor[0])
                    cursor[0] = cursor[0] + 1
                }
                if tokenKinds[cursor[0]] != 1 {
                    fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": expected a record field name")
                }
                let fieldName = tokenTexts[cursor[0]]
                let previous = 0
                let duplicate = false
                while previous < count {
                    if isFieldNamed(symbolParameterNames[first + previous], fieldName) {
                        duplicate = true
                    }
                    previous = previous + 1
                }
                if duplicate {
                    fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": record '" + symbolNames[record] + "' declares '" + fieldName + "' twice")
                }
                symbolParameterNames.add(fieldName + visibility)
                cursor[0] = cursor[0] + 1
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ":")
                symbolParameterTypes.add(takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds))
                count = count + 1
                if tokenIs(tokenKinds, tokenTexts, cursor, ",") {
                    cursor[0] = cursor[0] + 1
                }
                skipTerminators(tokenKinds, cursor)
            }
            symbolParameterCounts[record] = count
            cursor[0] = cursor[0] + 1
        } else {
            if tokenIs(tokenKinds, tokenTexts, cursor, "function") {
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "function")
                if tokenKinds[cursor[0]] != 1 {
                    fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": expected a name after function")
                }
                let functionName = tokenTexts[cursor[0]]
                if isBuiltinName(readableDeclarationName(functionName)) {
                    fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": '" + readableDeclarationName(functionName) + "' is a built-in function; choose another name")
                }
                symbolNames.add(functionName)
                symbolKinds.add(1)
                symbolLocations.add(tokenLocation(tokenLines, cursor[0]))
                parameterStarts.add(symbolParameterNames.length)
                cursor[0] = cursor[0] + 1
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "(")

                let parameterCount = 0
                let firstParameter = symbolParameterNames.length
                while !tokenIs(tokenKinds, tokenTexts, cursor, ")") {
                    if tokenKinds[cursor[0]] != 1 {
                        fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": expected a parameter name")
                    }
                    let parameterName = tokenTexts[cursor[0]]
                    let previous = firstParameter
                    while previous < symbolParameterNames.length {
                        if symbolParameterNames[previous] == parameterName {
                            fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": function '" + readableDeclarationName(functionName) + "' declares parameter '" + parameterName + "' twice")
                        }
                        previous = previous + 1
                    }
                    symbolParameterNames.add(parameterName)
                    cursor[0] = cursor[0] + 1
                    expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ":")
                    symbolParameterTypes.add(takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds))
                    parameterCount = parameterCount + 1
                    if tokenIs(tokenKinds, tokenTexts, cursor, ",") {
                        cursor[0] = cursor[0] + 1
                    }
                }
                symbolParameterCounts.add(parameterCount)
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ")")

                let returnType = 5
                if functionName == "main" {
                    returnType = 1
                }
                if tokenIs(tokenKinds, tokenTexts, cursor, ":") {
                    cursor[0] = cursor[0] + 1
                    returnType = takeType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
                }
                if functionName == "main" {
                    if parameterCount != 0 {
                        fail("main expects no parameters; use argument() to read program arguments")
                    }
                    if returnType != 1 {
                        fail("main must return Integer")
                    }
                }
                symbolReturnTypes.add(returnType)

                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "{")
                cursor[0] = declarationEnds[declaration]
                declaration = declaration + 1
            } else {
                skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            }
        }
        }
        skipTerminators(tokenKinds, cursor)
    }
}

// Scalar stores cannot own references. Load List storage only after the index
// and RHS have finished: either may grow an alias and replace its buffer.
function appendRuntimeHelpers(output: List<Text>) {
    output.add("\n")
    output.add("; Checked inline List accesses. ABI: { values pointer, length, capacity }.\n")
    output.add("define internal i64 @.minyar.list.get.checked(ptr %list, i64 %position) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %length.pointer = getelementptr { ptr, i64, i64 }, ptr %list, i32 0, i32 1\n")
    output.add("  %length = load i64, ptr %length.pointer\n")
    output.add("  %get.valid = icmp ult i64 %position, %length\n")
    output.add("  br i1 %get.valid, label %good, label %bad\n")
    output.add("good:\n")
    output.add("  %values = load ptr, ptr %list\n")
    output.add("  %slot = getelementptr i64, ptr %values, i64 %position\n")
    output.add("  %value = load i64, ptr %slot\n")
    output.add("  ret i64 %value\n")
    output.add("bad:\n")
    output.add("  %fallback = call i64 @minyar_list_get(ptr %list, i64 %position)\n")
    output.add("  ret i64 %fallback\n")
    output.add("}\n")
    output.add("define internal void @.minyar.list.set.scalar.checked(ptr %list, i64 %position, i64 %value) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %length.pointer = getelementptr { ptr, i64, i64 }, ptr %list, i32 0, i32 1\n")
    output.add("  %length = load i64, ptr %length.pointer\n")
    output.add("  %set.valid = icmp ult i64 %position, %length\n")
    output.add("  br i1 %set.valid, label %good, label %bad\n")
    output.add("good:\n")
    output.add("  %values = load ptr, ptr %list\n")
    output.add("  %slot = getelementptr i64, ptr %values, i64 %position\n")
    output.add("  store i64 %value, ptr %slot\n")
    output.add("  ret void\n")
    output.add("bad:\n")
    output.add("  call void @minyar_list_set(ptr %list, i64 %position, i64 %value)\n")
    output.add("  ret void\n")
    output.add("}\n")
    output.add("\n")
    output.add("define internal i64 @.minyar.list.length(ptr %list) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %pointer = getelementptr { ptr, i64, i64 }, ptr %list, i32 0, i32 1\n")
    output.add("  %length = load i64, ptr %pointer\n")
    output.add("  ret i64 %length\n")
    output.add("}\n")
    output.add("\n")
    output.add("define internal void @.minyar.integer.overflow.checked(i1 %overflow) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  br i1 %overflow, label %bad, label %good\n")
    output.add("bad:\n")
    output.add("  call void @minyar_fail_integer_overflow()\n")
    output.add("  unreachable\n")
    output.add("good:\n")
    output.add("  ret void\n")
    output.add("}\n")
    output.add("define internal void @.minyar.integer.division.checked(i64 %left, i64 %right) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %zero = icmp eq i64 %right, 0\n")
    output.add("  %minimum = icmp eq i64 %left, -9223372036854775808\n")
    output.add("  %negative.one = icmp eq i64 %right, -1\n")
    output.add("  %overflow = and i1 %minimum, %negative.one\n")
    output.add("  %invalid = or i1 %zero, %overflow\n")
    output.add("  br i1 %invalid, label %bad, label %good\n")
    output.add("bad:\n")
    output.add("  call void @minyar_fail_integer_division(i64 %right)\n")
    output.add("  unreachable\n")
    output.add("good:\n")
    output.add("  ret void\n")
    output.add("}\n")

    // Keep argument evaluation at each call site; only the already evaluated
    // scalar values enter these helpers. The good arms never call the runtime;
    // the bad arms preserve its checked ABI and exact existing diagnostics.
    output.add("\n")
    output.add("define internal void @.minyar.shift.checked(i64 %count) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %valid = icmp ult i64 %count, 64\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  call void @minyar_check_shift(i64 %count)\n")
    output.add("  ret void\n")
    output.add("good:\n")
    output.add("  ret void\n")
    output.add("}\n")
    output.add("define internal i32 @.minyar.character.checked(i64 %value) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %range = icmp ult i64 %value, 1114112\n")
    output.add("  %below = icmp ult i64 %value, 55296\n")
    output.add("  %above = icmp ugt i64 %value, 57343\n")
    output.add("  %scalar = or i1 %below, %above\n")
    output.add("  %valid = and i1 %range, %scalar\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  %fallback = call i32 @minyar_integer_character(i64 %value)\n")
    output.add("  ret i32 %fallback\n")
    output.add("good:\n")
    output.add("  %result = trunc i64 %value to i32\n")
    output.add("  ret i32 %result\n")
    output.add("}\n")
    output.add("define internal i64 @.minyar.float.integer.checked(double %value) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %above.minimum = fcmp oge double %value, -9.223372036854775808e18\n")
    output.add("  %below.maximum = fcmp olt double %value, 9.223372036854775808e18\n")
    output.add("  %valid = and i1 %above.minimum, %below.maximum\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  %fallback = call i64 @minyar_float_integer(double %value)\n")
    output.add("  ret i64 %fallback\n")
    output.add("good:\n")
    output.add("  %result = fptosi double %value to i64\n")
    output.add("  ret i64 %result\n")
    output.add("}\n")
    output.add("define internal i64 @.minyar.integer.absolute.checked(i64 %value) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %valid = icmp ne i64 %value, -9223372036854775808\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  %fallback = call i64 @minyar_integer_absolute(i64 %value)\n")
    output.add("  ret i64 %fallback\n")
    output.add("good:\n")
    output.add("  %negative = icmp slt i64 %value, 0\n")
    output.add("  %negated = sub i64 0, %value\n")
    output.add("  %result = select i1 %negative, i64 %negated, i64 %value\n")
    output.add("  ret i64 %result\n")
    output.add("}\n")
    output.add("define internal void @.minyar.clamp.integer.checked(i64 %lower, i64 %upper) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %valid = icmp sle i64 %lower, %upper\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  call void @minyar_check_clamp_integer(i64 %lower, i64 %upper)\n")
    output.add("  ret void\n")
    output.add("good:\n")
    output.add("  ret void\n")
    output.add("}\n")
    output.add("define internal void @.minyar.clamp.float.checked(double %lower, double %upper) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %valid = fcmp ole double %lower, %upper\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  call void @minyar_check_clamp_float(double %lower, double %upper)\n")
    output.add("  ret void\n")
    output.add("good:\n")
    output.add("  ret void\n")
    output.add("}\n")

}

function readableDeclarationName(name: Text): Text {
    let prefix = "minyar_module_"
    let matches = name.length > prefix.length
    let position = 0
    while position < prefix.length && matches {
        if name[position] != prefix[position] {
            matches = false
        }
        position = position + 1
    }
    if matches {
        while position < name.length && name[position] != '_' {
            position = position + 1
        }
        if position < name.length {
            position = position + 1
            let readable = ""
            while position < name.length {
                readable = readable + Text(name[position])
                position = position + 1
            }
            return readable
        }
    }
    return name
}

function isListType(type: Integer): Boolean {
    return type >= 100000
}

function isRecordType(type: Integer): Boolean {
    return type >= 1000 && type < 100000
}

function listElementType(type: Integer): Integer {
    return type - 100000
}

function isReferenceType(type: Integer): Boolean {
    return type == 2 || type == 8 || type >= 1000
}

function llvmType(type: Integer): Text {
    let result = "void"
    if type == 1 {
        result = "i64"
    } else {
        if isReferenceType(type) {
            result = "ptr"
        } else {
            if type == 3 {
                result = "i32"
            } else {
                if type == 4 {
                    result = "i1"
                }
                if type == 7 {
                    result = "double"
                }
            }
        }
    }
    return result
}

function valueName(textState: List<Text>, temporary: Integer): Text {
    let slot = temporary + 2
    while textState.length <= slot {
        textState.add("%value." + Text(textState.length - 2))
    }
    return textState[slot]
}

function newTemporary(state: List<Integer>): Integer {
    let temporary = state[1]
    state[1] = temporary + 1
    return temporary
}

function newLabel(state: List<Integer>): Integer {
    let label = state[2]
    state[2] = label + 1
    return label
}

function setType(resultType: List<Integer>, type: Integer) {
    resultType[0] = type
    if resultType.length > 1 {
        resultType[1] = -1
    }
}

function findLocal(localNames: List<Text>, localLengths: List<Integer>, state: List<Integer>, name: Text): Integer {
    let position = state[3] - 1
    let length = name.byteLength
    let found = -1
    while position >= 0 && found == -1 {
        if localLengths[position] == length && localNames[position] == name {
            found = position
        }
        position = position - 1
    }
    return found
}

function addLocal(localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, name: Text, type: Integer, id: Integer) {
    let position = state[3]
    if position < localNames.length {
        localNames[position] = name
        localTypes[position] = type
        localIds[position] = id
        localLengths[position] = name.byteLength
    } else {
        localNames.add(name)
        localTypes.add(type)
        localIds.add(id)
        localLengths.add(name.byteLength)
    }
    state[3] = position + 1
}

function findFunction(functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, name: Text): Integer {
    return findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, name, 1)
}

function functionParameterOffset(functionParameterCounts: List<Integer>, functionIndex: Integer): Integer {
    return functionParameterCounts[functionParameterCounts.length / 2 + functionIndex]
}

function appendParameterOffsets(functionParameterCounts: List<Integer>, parameterStarts: List<Integer>) {
    let position = 0
    while position < parameterStarts.length {
        functionParameterCounts.add(parameterStarts[position])
        position = position + 1
    }
}

function findRecordField(functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, recordType: Integer, fieldName: Text): Integer {
    let record = recordType - 1000
    let first = functionParameterOffset(functionParameterCounts, record)
    let position = 0
    let found = -1
    while position < functionParameterCounts[record] && found == -1 {
        if isFieldNamed(functionParameterNames[first + position], fieldName) {
            found = first + position
        }
        position = position + 1
    }
    return found
}

// New records and List literals cannot refer to themselves before construction
// finishes. A first heap cycle therefore needs a mutable List edge L -> T with
// an existing path T -> L. Reject exactly the mutations whose declared types
// permit that return path; immutable recursive construction remains legal.
// The first two symbol-count blocks of returnTypes hold return types and the
// lookup index. Its tail caches proven-safe List types for this compilation.
function checkListMutation(listType: Integer, counts: List<Integer>, fields: List<Integer>, returnTypes: List<Integer>) {
    let base = listElementType(listType)
    while isListType(base) {
        base = listElementType(base)
    }
    if !isRecordType(base) {
        return
    }
    let recordCount = counts.length / 2
    let cached = recordCount * 2
    while cached < returnTypes.length {
        if returnTypes[cached] == listType {
            return
        }
        cached = cached + 1
    }
    let visited: List<Boolean> = []
    let index = 0
    while index < recordCount {
        visited.add(false)
        index = index + 1
    }
    let pending: List<Integer> = []
    pending.add(listElementType(listType))
    index = 0
    while index < pending.length {
        let type = pending[index]
        index = index + 1
        while isListType(type) {
            if type == listType {
                fail("this List mutation could create a reference cycle; construct a new List instead")
            }
            type = listElementType(type)
        }
        if isRecordType(type) {
            let record = type - 1000
            if !visited[record] {
                visited[record] = true
                let first = functionParameterOffset(counts, record)
                let field = 0
                while field < counts[record] {
                    pending.add(fields[first + field])
                    field = field + 1
                }
            }
        }
    }
    returnTypes.add(listType)
}

function requireType(tokenLines: SourceMap, state: List<Integer>, actual: Integer, expected: Integer, explanation: Text) {
    if actual != expected {
        fail(describeLocation(tokenLocation(tokenLines, state[0])) + ": " + explanation)
    }
}

function valueAsListSlot(output: List<Text>, textState: List<Text>, state: List<Integer>, value: Text, type: Integer): Text {
    let result = value
    if type != 1 {
        let temporary = newTemporary(state)
        if isReferenceType(type) {
            output.add("  %value.")
            output.add(Text(temporary))
            output.add(" = ptrtoint ptr ")
            output.add(value)
            output.add(" to i64\n")
        } else {
            output.add("  %value.")
            output.add(Text(temporary))
            if type == 7 {
                output.add(" = bitcast double ")
            } else {
                output.add(" = zext ")
                output.add(llvmType(type))
                output.add(" ")
            }
            output.add(value)
            output.add(" to i64\n")
        }
        result = valueName(textState, temporary)
    }
    return result
}

// List elements and record fields are stored in i64 slots. Recover the typed
// SSA value that valueAsListSlot encoded.
function slotAsValue(output: List<Text>, textState: List<Text>, state: List<Integer>, raw: Text, type: Integer): Text {
    if type == 1 {
        return raw
    }
    let value = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(value)
    if isReferenceType(type) {
        output.add(" = inttoptr i64 ")
        output.add(raw)
        output.add(" to ptr\n")
    } else {
        if type == 7 {
            output.add(" = bitcast i64 ")
            output.add(raw)
            output.add(" to double\n")
        } else {
            output.add(" = trunc i64 ")
            output.add(raw)
            output.add(" to ")
            output.add(llvmType(type))
            output.add("\n")
        }
    }
    return value
}

function keepReference(output: List<Text>, state: List<Integer>, value: Text, type: Integer): Integer {
    let owner = -1
    if isReferenceType(type) {
        owner = output.length
        state[6] = 1
        state[7] = state[7] + 1
        output.add("  call void @minyar_rc_keep(ptr ")
        output.add(value)
        output.add(")\n")
    }
    return owner
}

function markOwner(resultType: List<Integer>, owner: Integer) {
    if resultType.length == 1 {
        resultType.add(owner)
    } else {
        resultType[1] = owner
    }
}

function ownResult(output: List<Text>, state: List<Integer>, value: Text, resultType: List<Integer>) {
    if isReferenceType(resultType[0]) {
        markOwner(resultType, keepReference(output, state, value, resultType[0]))
    }
}

// A producer returns one owned reference. A consuming destination can take
// that exact reference, eliminating temporary registration and a retain/drop
// pair. Borrowed values never carry this token. No heap uniqueness is assumed.
function takeResult(output: List<Text>, state: List<Integer>, value: Text, resultType: List<Integer>): Boolean {
    if isReferenceType(resultType[0]) && resultType.length > 1 {
        let owner = resultType[1]
        if takeOwner(output, state, value, owner) {
            resultType[1] = -1
            return true
        }
    }
    return false
}

function takeOwner(output: List<Text>, state: List<Integer>, value: Text, owner: Integer): Boolean {
    if owner == -1 { return false }
    if output[owner] == "  ; minyar-owned-local-transfer\n" {
        // Delay clearing the slot until after the right operand has run. This
        // preserves expressions such as x = x + x while still handing the
        // left ownership count to the consuming join.
        output.add("  call void @minyar_rc_local_move(i64 ")
        output.add(output[owner + 1])
        output.add(")\n")
        output[owner] = ""
        output[owner + 1] = ""
        return true
    }
    if output[owner] == "  call void @minyar_rc_keep(ptr " && output[owner + 1] == value {
        output[owner] = ""
        output[owner + 1] = ""
        output[owner + 2] = ""
        state[7] = state[7] - 1
        return true
    }
    return false
}

// LLVM local identifiers and runtime ownership slots are independent. Only
// bindings that acquire an owner need a slot. Generation tags reuse the map
// between functions without clearing its high-water capacity each time.
// The first 14 entries hold compiler state, including reachability at index 13.
function ownershipSlot(state: List<Integer>, id: Integer): Integer {
    let entry = 14 + id * 2
    while state.length <= entry + 1 {
        state.add(-1)
    }
    if state[entry] != state[9] {
        state[entry] = state[9]
        state[entry + 1] = state[8]
        state[8] = state[8] + 1
    }
    return state[entry + 1]
}

// Negative ownership-map values identify scalar-replaced records. Their
// initializer SSA values are kept in harmless output comments, just as owned
// expression tokens identify editable output pieces elsewhere in this emitter.
function scalarRecordValues(state: List<Integer>, id: Integer): Integer {
    if id < 0 { return -1 }
    let entry = 14 + id * 2
    if entry + 1 < state.length && state[entry] == state[9] && state[entry + 1] < -1 {
        return -2 - state[entry + 1]
    }
    return -1
}

function markScalarRecord(state: List<Integer>, id: Integer, values: Integer) {
    let entry = 14 + id * 2
    while state.length <= entry + 1 { state.add(-1) }
    state[entry] = state[9]
    state[entry + 1] = -2 - values
}

// A let-bound scalar record can be replaced only when every occurrence of its
// name in the remaining lexical scope is a field projection. Reject aliases,
// assignments, argument passing, returns of the object, and shadowing. This is
// deliberately conservative and does not infer anything from return types.
function prepareScalarRecord(tokenKinds: List<Integer>, tokenTexts: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, counts: List<Integer>, fields: List<Integer>, state: List<Integer>, name: Text) {
    let record = findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, tokenTexts[state[0]], 2)
    if record < 0 { return }
    let cost = counts[record] * 8
    if cost == 0 { cost = 8 }
    if cost > 512 - state[11] { return }
    let first = functionParameterOffset(counts, record)
    let field = 0
    while field < counts[record] {
        if isReferenceType(fields[first + field]) { return }
        field = field + 1
    }
    // Charge rejected proofs too, so at most 64 suffix scans run per body.
    state[11] = state[11] + cost
    let cursor: List<Integer> = []
    cursor.add(state[0])
    skipDeclaration(tokenKinds, tokenTexts, cursor)
    let position = cursor[0]
    if tokenKinds[position] != 0 && tokenKinds[position] != 6 && tokenTexts[position] != "}" { return }
    let depth = 0
    let done = false
    while tokenKinds[position] != 0 && !done {
        if tokenKinds[position] == 1 && tokenTexts[position] == name {
            if position + 1 >= tokenTexts.length || tokenTexts[position + 1] != "." { return }
            if position + 3 < tokenTexts.length && tokenKinds[position + 3] == 4 && isAssignmentOperator(tokenTexts[position + 3]) { return }
        }
        if tokenKinds[position] == 4 {
            if tokenTexts[position] == "{" { depth = depth + 1 }
            if tokenTexts[position] == "}" {
                if depth == 0 { done = true } else { depth = depth - 1 }
            }
        }
        position = position + 1
    }
    state[10] = state[4]
}

function rootLocal(output: List<Text>, state: List<Integer>, id: Integer, value: Text, type: Integer) {
    if isReferenceType(type) {
        let owner = ownershipSlot(state, id)
        if owner < 0 { return }
        state[6] = 1
        output.add("  call void @minyar_rc_local(i64 ")
        output.add(Text(owner))
        output.add(", ptr ")
        output.add(value)
        output.add(")\n")
    }
}

function assignReference(output: List<Text>, state: List<Integer>, id: Integer, value: Text, resultType: List<Integer>) {
    if takeResult(output, state, value, resultType) {
        state[6] = 1
        output.add("  call void @minyar_rc_local_take(i64 ")
        output.add(Text(ownershipSlot(state, id)))
        output.add(", ptr ")
        output.add(value)
        output.add(")\n")
    } else {
        rootLocal(output, state, id, value, resultType[0])
    }
}
function borrowReference(output: List<Text>, state: List<Integer>, value: Text, type: Integer) {
    if isReferenceType(type) {
        state[6] = 1
        state[7] = state[7] + 1
        output.add("  call void @minyar_rc_borrow(ptr ")
        output.add(value)
        output.add(")\n")
    }
}

function finishStackOwnership(output: List<Text>, slot: Integer, owners: Integer) {
    let stackEntry = "  call void @minyar_stack_enter()\n"
    let prefix = stackEntry + "  call void @minyar_rc_enter(i64 " + Text(owners) + ")\n"
    let entry = stackEntry + "  %rc.stack.header = alloca [64 x i8], align 8\n"
    entry = entry + "  %rc.stack.owners = alloca [" + Text(owners * 2) + " x i64], align 8\n"
    entry = entry + "  call void @minyar_rc_enter_stack_v1(ptr %rc.stack.header, ptr %rc.stack.owners, i64 " + Text(owners) + ")\n"
    output[slot] = entry + output[slot].slice(prefix.length, output[slot].length)
    output[slot - 1] = ") noinline {\nentry:\n"
    let piece = slot + 1
    while piece < output.length {
        if output[piece] == "  call void @minyar_rc_leave()\n" {
            output[piece] = "  call void @minyar_rc_leave_stack_v1(ptr %rc.stack.header)\n"
        }
        piece = piece + 1
    }
}

function finishFunctionEntry(output: List<Text>, slot: Integer, locals: Integer, parameters: Integer, owners: Integer, references: Boolean) {
    let entry: List<Text> = []
    entry.add("  call void @minyar_stack_enter()\n")
    if references {
        entry.add("  call void @minyar_rc_enter(i64 ")
        entry.add(Text(owners))
        entry.add(")\n")
    } else {
        let piece = slot + 1
        while piece < output.length {
            if output[piece] == "  call void @minyar_rc_step()\n" || output[piece] == "  call void @minyar_rc_leave()\n" {
                output[piece] = ""
            }
            piece = piece + 1
        }
    }
    let local = parameters
    while local < locals {
        entry.add("  %local.")
        entry.add(Text(local))
        entry.add(" = alloca i64\n")
        local = local + 1
    }
    output[slot] = joinText(entry)
}

function describeType(type: Integer): Text {
    if type == 1 { return "Integer" }
    if type == 2 { return "Text" }
    if type == 3 { return "Character" }
    if type == 4 { return "Boolean" }
    if type == 5 || type == 6 { return "Nothing" }
    if type == 7 { return "Float" }
    if type == 8 { return "Bytes" }
    if isListType(type) { return "List<" + describeType(listElementType(type)) + ">" }
    if isRecordType(type) { return "a record" }
    return "an unknown type"
}

function isArithmeticOperator(operator: Text): Boolean {
    return operator == "+" || operator == "-" || operator == "*" || operator == "/" || operator == "%"
}

function isBitwiseOperator(operator: Text): Boolean {
    return operator == "&" || operator == "|" || operator == "^" || operator == "<<" || operator == ">>"
}

function comparisonCondition(operator: Text, type: Integer): Text {
    if type == 7 {
        // Ordered comparisons are false for NaN; != is its exact opposite.
        if operator == "==" { return "oeq" }
        if operator == "!=" { return "une" }
        if operator == "<" { return "olt" }
        if operator == ">" { return "ogt" }
        if operator == "<=" { return "ole" }
        return "oge"
    }
    if operator == "==" { return "eq" }
    if operator == "!=" { return "ne" }
    if operator == "<" { return "slt" }
    if operator == ">" { return "sgt" }
    if operator == "<=" { return "sle" }
    return "sge"
}

function emitBinary(output: List<Text>, textState: List<Text>, state: List<Integer>, operator: Text, left: Text, leftType: Integer, leftOwner: Integer, right: Text, rightType: Integer, resultType: List<Integer>, locations: SourceMap, location: Integer): Text {
    if leftType != rightType {
        let hint = ""
        if (leftType == 1 && rightType == 7) || (leftType == 7 && rightType == 1) {
            hint = "; convert one side with Float(value) or Integer(value)"
        }
        fail(describeLocation(tokenLocation(locations, location)) + ": " + "the two sides of '" + operator + "' have different types (" + describeType(leftType) + " and " + describeType(rightType) + ")" + hint)
    }
    if (operator == "==" || operator == "!=") && (isRecordType(leftType) || isListType(leftType) || leftType == 8) {
        fail(describeLocation(tokenLocation(locations, location)) + ": " + "records, Lists, and Bytes do not yet support equality")
    }
    if isArithmeticOperator(operator) {
        if leftType != 1 && leftType != 7 && !(operator == "+" && leftType == 2) {
            fail(describeLocation(tokenLocation(locations, location)) + ": " + "'" + operator + "' needs Integer or Float operands, not " + describeType(leftType))
        }
    } else {
        if isBitwiseOperator(operator) {
            if leftType != 1 {
                let hint = ""
                if leftType == 4 && (operator == "&" || operator == "|") {
                    hint = "; use " + operator + operator + " for Boolean logic"
                }
                fail(describeLocation(tokenLocation(locations, location)) + ": " + "'" + operator + "' needs Integer operands, not " + describeType(leftType) + hint)
            }
        } else {
            if operator == "==" || operator == "!=" {
                if (leftType < 1 || leftType > 4) && leftType != 7 {
                    fail(describeLocation(tokenLocation(locations, location)) + ": " + "equality needs two values")
                }
            } else {
                if leftType != 1 && leftType != 3 && leftType != 7 {
                    fail(describeLocation(tokenLocation(locations, location)) + ": " + "ordered comparison needs Integer, Float, or Character operands")
                }
            }
        }
    }
    let temporary = newTemporary(state)
    let result = valueName(textState, temporary)

    if operator == "+" && leftType == 2 {
        let runtimeName = "minyar_join_text"
        if takeOwner(output, state, left, leftOwner) {
            runtimeName = "minyar_join_text_take_left"
        }
        output.add("  ")
        output.add(result)
        output.add(" = call ptr @")
        output.add(runtimeName)
        output.add("(ptr ")
        output.add(left)
        output.add(", ptr ")
        output.add(right)
        output.add(")\n")
        setType(resultType, 2)
    } else {
        if (operator == "==" || operator == "!=") && leftType == 2 {
            output.add("  ")
            output.add(result)
            output.add(" = call zeroext i1 @minyar_texts_are_equal(ptr ")
            output.add(left)
            output.add(", ptr ")
            output.add(right)
            output.add(")\n")
            if operator == "!=" {
                let opposite = newTemporary(state)
                output.add("  %value.")
                output.add(Text(opposite))
                output.add(" = xor i1 ")
                output.add(result)
                output.add(", true\n")
                result = valueName(textState, opposite)
            }
            setType(resultType, 4)
        } else {
            if leftType == 7 && isArithmeticOperator(operator) {
                // IEEE 754 arithmetic: overflow gives infinity rather than stopping.
                let instruction = "fadd"
                if operator == "-" { instruction = "fsub" }
                if operator == "*" { instruction = "fmul" }
                if operator == "/" { instruction = "fdiv" }
                if operator == "%" { instruction = "frem" }
                output.add("  ")
                output.add(result)
                output.add(" = ")
                output.add(instruction)
                output.add(" double ")
                output.add(left)
                output.add(", ")
                output.add(right)
                output.add("\n")
                setType(resultType, 7)
            } else {
            if operator == "+" || operator == "-" || operator == "*" {
                let operation = "sadd"
                if operator == "-" {
                    operation = "ssub"
                }
                if operator == "*" {
                    operation = "smul"
                }
                output.add("  %checked.")
                output.add(Text(temporary))
                output.add(" = call { i64, i1 } @llvm.")
                output.add(operation)
                output.add(".with.overflow.i64(i64 ")
                output.add(left)
                output.add(", i64 ")
                output.add(right)
                output.add(")\n")
                output.add("  ")
                output.add(result)
                output.add(" = extractvalue { i64, i1 } %checked.")
                output.add(Text(temporary))
                output.add(", 0\n")
                output.add("  %overflow.")
                output.add(Text(temporary))
                output.add(" = extractvalue { i64, i1 } %checked.")
                output.add(Text(temporary))
                output.add(", 1\n")
                output.add("  call void @.minyar.integer.overflow.checked(i1 %overflow.")
                output.add(Text(temporary))
                output.add(")\n")
                setType(resultType, 1)
            } else {
                if operator == "/" || operator == "%" {
                    output.add("  call void @.minyar.integer.division.checked(i64 ")
                    output.add(left)
                    output.add(", i64 ")
                    output.add(right)
                    output.add(")\n")
                    let instruction = "sdiv"
                    if operator == "%" {
                        instruction = "srem"
                    }
                    output.add("  ")
                    output.add(result)
                    output.add(" = ")
                    output.add(instruction)
                    output.add(" i64 ")
                    output.add(left)
                    output.add(", ")
                    output.add(right)
                    output.add("\n")
                    setType(resultType, 1)
                } else {
                    if isBitwiseOperator(operator) {
                        let instruction = "and"
                        if operator == "|" { instruction = "or" }
                        if operator == "^" { instruction = "xor" }
                        if operator == "<<" || operator == ">>" {
                            // Shift counts outside 0..63 have no defined result.
                            output.add("  call void @.minyar.shift.checked(i64 ")
                            output.add(right)
                            output.add(")\n")
                            instruction = "shl"
                            if operator == ">>" { instruction = "ashr" }
                        }
                        output.add("  ")
                        output.add(result)
                        output.add(" = ")
                        output.add(instruction)
                        output.add(" i64 ")
                        output.add(left)
                        output.add(", ")
                        output.add(right)
                        output.add("\n")
                        setType(resultType, 1)
                    } else {
                        output.add("  ")
                        output.add(result)
                        if leftType == 7 {
                            output.add(" = fcmp ")
                        } else {
                            output.add(" = icmp ")
                        }
                        output.add(comparisonCondition(operator, leftType))
                        output.add(" ")
                        output.add(llvmType(leftType))
                        output.add(" ")
                        output.add(left)
                        output.add(", ")
                        output.add(right)
                        output.add("\n")
                        setType(resultType, 4)
                    }
                }
            }
            }
        }
    }
    ownResult(output, state, result, resultType)
    return result
}

function parseExpression(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let left = parseAnd(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    while tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "||") {
        state[0] = state[0] + 1
        requireType(tokenLines, state, resultType[0], 4, "the left side of || must be Boolean")
        let rightLabel = newLabel(state)
        let endLabel = newLabel(state)
        let leftBlock = textState[0]
        output.add("  br i1 ")
        output.add(left)
        output.add(", label %logical.end.")
        output.add(Text(endLabel))
        output.add(", label %logical.right.")
        output.add(Text(rightLabel))
        output.add("\n\n")
        output.add("logical.right.")
        output.add(Text(rightLabel))
        output.add(":\n")
        textState[0] = "logical.right." + Text(rightLabel)
        let rightType: List<Integer> = []
        rightType.add(0)
        let right = parseAnd(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, rightType)
        requireType(tokenLines, state, rightType[0], 4, "the right side of || must be Boolean")
        let rightBlock = textState[0]
        output.add("  br label %logical.end.")
        output.add(Text(endLabel))
        output.add("\n\nlogical.end.")
        output.add(Text(endLabel))
        output.add(":\n")
        textState[0] = "logical.end." + Text(endLabel)
        let temporary = newTemporary(state)
        left = valueName(textState, temporary)
        output.add("  ")
        output.add(left)
        output.add(" = phi i1 [ true, %")
        output.add(leftBlock)
        output.add(" ], [ ")
        output.add(right)
        output.add(", %")
        output.add(rightBlock)
        output.add(" ]\n")
        resultType[0] = 4
    }
    return left
}

function parseAnd(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let left = parseBinary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType, 1)
    while tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "&&") {
        state[0] = state[0] + 1
        requireType(tokenLines, state, resultType[0], 4, "the left side of && must be Boolean")
        let rightLabel = newLabel(state)
        let endLabel = newLabel(state)
        let leftBlock = textState[0]
        output.add("  br i1 ")
        output.add(left)
        output.add(", label %logical.right.")
        output.add(Text(rightLabel))
        output.add(", label %logical.end.")
        output.add(Text(endLabel))
        output.add("\n\n")
        output.add("logical.right.")
        output.add(Text(rightLabel))
        output.add(":\n")
        textState[0] = "logical.right." + Text(rightLabel)
        let rightType: List<Integer> = []
        rightType.add(0)
        let right = parseBinary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, rightType, 1)
        requireType(tokenLines, state, rightType[0], 4, "the right side of && must be Boolean")
        let rightBlock = textState[0]
        output.add("  br label %logical.end.")
        output.add(Text(endLabel))
        output.add("\n\nlogical.end.")
        output.add(Text(endLabel))
        output.add(":\n")
        textState[0] = "logical.end." + Text(endLabel)
        let temporary = newTemporary(state)
        left = valueName(textState, temporary)
        output.add("  ")
        output.add(left)
        output.add(" = phi i1 [ false, %")
        output.add(leftBlock)
        output.add(" ], [ ")
        output.add(right)
        output.add(", %")
        output.add(rightBlock)
        output.add(" ]\n")
        resultType[0] = 4
    }
    return left
}

function operatorLevel(tokenKinds: List<Integer>, tokenTexts: List<Text>, state: List<Integer>): Integer {
    let level = 0
    if tokenKinds[state[0]] == 4 {
        let token = tokenTexts[state[0]]
        if token == "*" || token == "/" || token == "%" || token == "<<" || token == ">>" || token == "&" {
            level = 4
        } else {
            if token == "+" || token == "-" || token == "|" || token == "^" {
                level = 3
            } else {
                if token == "<" || token == ">" || token == "<=" || token == ">=" {
                    level = 2
                } else {
                    if token == "==" || token == "!=" {
                        level = 1
                    }
                }
            }
        }
    }
    return level
}

function parseBinary(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>, minimumLevel: Integer): Text {
    let left = parseUnary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    let level = operatorLevel(tokenKinds, tokenTexts, state)
    while level >= minimumLevel && level > 0 {
        let operator = tokenTexts[state[0]]
        let operatorLocation = state[0]
        state[0] = state[0] + 1
        let leftType = resultType[0]
        let leftOwner = -1
        if resultType.length > 1 {
            leftOwner = resultType[1]
        }
        setType(resultType, 0)
        let right = parseBinary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType, level + 1)
        left = emitBinary(output, textState, state, operator, left, leftType, leftOwner, right, resultType[0], resultType, tokenLines, operatorLocation)
        level = operatorLevel(tokenKinds, tokenTexts, state)
    }
    return left
}

function checkedIntegerLiteral(digits: Text, negative: Boolean, locations: SourceMap, location: Integer): Text {
    let first = 0
    while first + 1 < digits.length && digits[first] == '0' {
        first = first + 1
    }
    let canonical = digits
    if first > 0 {
        canonical = digits.slice(first, digits.length)
    }
    let limit = "9223372036854775807"
    if negative {
        limit = "9223372036854775808"
    }
    if canonical.length > 19 || (canonical.length == 19 && compareText(canonical, limit) > 0) {
        fail(describeLocation(tokenLocation(locations, location)) + ": Integer literal is outside the supported range")
    }
    return canonical
}

// Compare positive decimal significands at the same order, padding with zero.
function compareFloatSignificand(literal: Text, end: Integer, boundary: Text): Integer {
    let digit = 0
    while literal[digit] == '0' || literal[digit] == '.' { digit = digit + 1 }
    let index = 0
    while index < boundary.length || digit < end {
        if digit < end && literal[digit] == '.' { digit = digit + 1 }
        let left = '0'
        let right = '0'
        if digit < end { left = literal[digit] }
        if index < boundary.length { right = boundary[index] }
        if left < right { return -1 }
        if left > right { return 1 }
        digit = digit + 1
        index = index + 1
    }
    return 0
}

// LLVM rounds decimal double constants correctly. Reject magnitudes at the
// exact round-to-nearest overflow midpoint, 2^1024 - 2^970, before publishing IR.
function checkedFloatLiteral(literal: Text, locations: SourceMap, location: Integer): Text {
    let position = 0
    let significant = false
    let integerDigits = 0
    while position < literal.length && literal[position] != '.' {
        if significant || literal[position] != '0' {
            significant = true
            integerDigits = integerDigits + 1
        }
        position = position + 1
    }
    let decimalPoint = position
    position = position + 1
    let fractionZeros = 0
    while position < literal.length && literal[position] != 'e' && literal[position] != 'E' {
        if !significant {
            if literal[position] == '0' {
                fractionZeros = fractionZeros + 1
            } else {
                significant = true
            }
        }
        position = position + 1
    }
    let mantissaEnd = position
    let exponent = 0
    // Any exponent large enough to exceed the whole mantissa length plus
    // the Float range can be saturated without changing range decisions.
    let exponentLimit = literal.length + 325
    let negativeExponent = false
    if position < literal.length {
        position = position + 1
        if literal[position] == '-' || literal[position] == '+' {
            negativeExponent = literal[position] == '-'
            position = position + 1
        }
        while position < literal.length {
            if exponent < exponentLimit {
                let digit = findCharacter("0123456789", literal[position])
                if exponent > (exponentLimit - digit) / 10 {
                    exponent = exponentLimit
                } else {
                    exponent = exponent * 10 + digit
                }
            }
            position = position + 1
        }
    }
    if negativeExponent {
        exponent = -exponent
    }
    if significant {
        let order = exponent - fractionZeros - 1
        if integerDigits > 0 {
            order = exponent + integerDigits - 1
        }
        if order > 308 {
            fail(describeLocation(tokenLocation(locations, location)) + ": Float literal is larger than the largest Float")
        }
        if order == 308 {
            let midpoint = ""
            if compareFloatSignificand(literal, mantissaEnd, midpoint) >= 0 {
                fail(describeLocation(tokenLocation(locations, location)) + ": Float literal is larger than the largest Float")
            }
        }
        // LLVM 23 rejects decimal constants that round to zero. Round at the
        // exact half-minimum boundary (2^-1075), with ties going to even zero.
        // Unary negation preserves the sign when this emits zero.
        if order < -324 { return "0.0" }
        if order == -324 {
            let midpoint = ""
            if compareFloatSignificand(literal, mantissaEnd, midpoint) <= 0 { return "0.0" }
        }
        // LLVM's decimal reader can underflow a very long fractional mantissa
        // before its exponent compensates. Emit an equivalent scientific form
        // with leading/trailing zero digits removed, retaining every other digit.
        let first = 0
        while literal[first] == '0' || literal[first] == '.' { first = first + 1 }
        let end = mantissaEnd
        while end > first + 1 && (literal[end - 1] == '0' || literal[end - 1] == '.') {
            end = end - 1
        }
        let tail = ""
        if decimalPoint >= first + 1 && decimalPoint < end {
            tail = literal.slice(first + 1, decimalPoint) + literal.slice(decimalPoint + 1, end)
        } else {
            tail = literal.slice(first + 1, end)
        }
        if tail.length == 0 { tail = "0" }
        return literal.slice(first, first + 1) + "." + tail + "e" + Text(order)
    }
    return "0.0"
}

function parseUnary(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let value = ""
    if tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "!" || tokenTexts[state[0]] == "-" || tokenTexts[state[0]] == "~") {
        let operator = tokenTexts[state[0]]
        state[0] = state[0] + 1
        if operator == "-" && tokenKinds[state[0]] == 2 {
            let digits = checkedIntegerLiteral(tokenTexts[state[0]], true, tokenLines, state[0])
            state[0] = state[0] + 1
            setType(resultType, 1)
            return "-" + digits
        }
        if operator == "-" && tokenKinds[state[0]] == 7 {
            let literal = checkedFloatLiteral(tokenTexts[state[0]], tokenLines, state[0])
            state[0] = state[0] + 1
            setType(resultType, 7)
            return "-" + literal
        }
        let rightType: List<Integer> = []
        rightType.add(0)
        let right = parseUnary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, rightType)
        let temporary = newTemporary(state)
        value = valueName(textState, temporary)
        if operator == "!" {
            requireType(tokenLines, state, rightType[0], 4, "logical not needs a Boolean")
            output.add("  ")
            output.add(value)
            output.add(" = xor i1 ")
            output.add(right)
            output.add(", true\n")
            setType(resultType, 4)
        } else {
        if operator == "~" {
            requireType(tokenLines, state, rightType[0], 1, "bitwise not needs an Integer")
            output.add("  ")
            output.add(value)
            output.add(" = xor i64 ")
            output.add(right)
            output.add(", -1\n")
            setType(resultType, 1)
        } else {
        if rightType[0] == 7 {
            output.add("  ")
            output.add(value)
            output.add(" = fneg double ")
            output.add(right)
            output.add("\n")
            setType(resultType, 7)
        } else {
            requireType(tokenLines, state, rightType[0], 1, "negation needs an Integer or Float")
            output.add("  %checked.")
            output.add(Text(temporary))
            output.add(" = call { i64, i1 } @llvm.ssub.with.overflow.i64(i64 0, i64 ")
            output.add(right)
            output.add(")\n")
            output.add("  ")
            output.add(value)
            output.add(" = extractvalue { i64, i1 } %checked.")
            output.add(Text(temporary))
            output.add(", 0\n")
            output.add("  %overflow.")
            output.add(Text(temporary))
            output.add(" = extractvalue { i64, i1 } %checked.")
            output.add(Text(temporary))
            output.add(", 1\n")
            output.add("  call void @.minyar.integer.overflow.checked(i1 %overflow.")
            output.add(Text(temporary))
            output.add(")\n")
            setType(resultType, 1)
        }
        }
        }
    } else {
        value = parsePrimary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    }
    return value
}

// Bytes methods map one-to-one onto runtime functions. Typed accessors use a
// byte offset and little-endian order; `kinds` lists the supported widths.
function bytesKindSuffix(kind: Text): Text {
    if kind == "Int16" { return "int16" }
    if kind == "UInt16" { return "uint16" }
    if kind == "Int32" { return "int32" }
    if kind == "UInt32" { return "uint32" }
    if kind == "Int64" { return "int64" }
    if kind == "Float32" { return "float32" }
    if kind == "Float64" { return "float64" }
    return ""
}

function parseBytesMethod(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, member: Text, memberLocation: Integer, resultType: List<Integer>): Text {
    let values: List<Text> = []
    values.add(receiver)
    let types: List<Integer> = []
    types.add(8)
    while !tokenIs(tokenKinds, tokenTexts, state, ")") {
        let argumentType: List<Integer> = []
        argumentType.add(0)
        values.add(parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType))
        types.add(argumentType[0])
        if tokenIs(tokenKinds, tokenTexts, state, ",") {
            state[0] = state[0] + 1
        }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    let expected: List<Integer> = []
    expected.add(8)
    let callee = ""
    let returnType = 5
    if member == "add" {
        callee = "minyar_bytes_add"
        expected.add(1)
    }
    if member == "addBytes" {
        callee = "minyar_bytes_append"
        expected.add(8)
    }
    if member == "clear" {
        callee = "minyar_bytes_clear"
    }
    if member == "resize" {
        callee = "minyar_bytes_resize"
        expected.add(1)
    }
    if member == "slice" {
        callee = "minyar_bytes_slice"
        expected.add(1)
        expected.add(1)
        returnType = 8
    }
    if callee == "" && member.length > 3 {
        let verb = member.slice(0, 3)
        let suffix = bytesKindSuffix(member.slice(3, member.length))
        let valueType = 1
        if member[3] == 'F' {
            valueType = 7
        }
        if suffix != "" && (verb == "add" || verb == "get" || verb == "set") {
            callee = "minyar_bytes_" + verb + "_" + suffix
            if verb == "add" {
                expected.add(valueType)
            }
            if verb == "get" {
                expected.add(1)
                returnType = valueType
            }
            if verb == "set" {
                expected.add(1)
                expected.add(valueType)
            }
        }
    }
    if callee == "" {
        fail(describeLocation(tokenLocation(tokenLines, memberLocation)) + ": Bytes has no method named '" + member + "'")
    }
    let matches = values.length == expected.length
    let position = 1
    while matches && position < values.length {
        if types[position] != expected[position] {
            matches = false
        }
        position = position + 1
    }
    if !matches {
        let wanted = ""
        position = 1
        while position < expected.length {
            if position > 1 {
                wanted = wanted + ", "
            }
            wanted = wanted + describeType(expected[position])
            position = position + 1
        }
        fail(describeLocation(tokenLocation(tokenLines, memberLocation)) + ": Bytes." + member + " expects (" + wanted + ")")
    }
    setType(resultType, returnType)
    return emitCall(output, textState, state, returnType, callee, values, types)
}

// Whether the tokens at `position` are `[ ... ]` with no call inside, so
// evaluating the position cannot run code that replaces the indexed value.
function indexWithoutCalls(tokenKinds: List<Integer>, tokenTexts: List<Text>, position: Integer): Boolean {
    if tokenKinds[position] != 4 || tokenTexts[position] != "[" {
        return false
    }
    let depth = 0
    let cursor = position
    while tokenKinds[cursor] != 0 {
        if tokenKinds[cursor] == 1 && tokenKinds[cursor + 1] == 4 && tokenTexts[cursor + 1] == "(" {
            return false
        }
        if tokenKinds[cursor] == 4 {
            if tokenTexts[cursor] == "[" {
                depth = depth + 1
            }
            if tokenTexts[cursor] == "]" {
                depth = depth - 1
                if depth == 0 {
                    return true
                }
            }
        }
        cursor = cursor + 1
    }
    return false
}

function parsePrimary(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let atom = state[0]
    let scalarValues = -1
    let value = parseAtom(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    if isRecordType(resultType[0]) && tokenKinds[atom] == 1 && atom + 1 < tokenTexts.length && tokenTexts[atom + 1] == "." {
        let local = findLocal(localNames, localLengths, state, tokenTexts[atom])
        if local >= 0 { scalarValues = scalarRecordValues(state, localIds[local]) }
    }
    if (tokenKinds[atom] == 1 && tokenTexts[atom + 1] == "(") || (tokenKinds[atom] == 4 && tokenTexts[atom] == "[") {
        ownResult(output, state, value, resultType)
    }

    while tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "." || tokenTexts[state[0]] == "[") {
        let ownsResult = false
        if tokenTexts[state[0]] == "." {
            let receiver = value
            let receiverType = resultType[0]
            state[0] = state[0] + 1
            if tokenKinds[state[0]] != 1 {
                fail("expected a field or method name after '.'")
            }
            let member = tokenTexts[state[0]]
            let memberLocation = state[0]
            state[0] = state[0] + 1
            if tokenIs(tokenKinds, tokenTexts, state, "(") {
                state[0] = state[0] + 1
                if receiverType == 8 {
                    value = parseBytesMethod(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, member, memberLocation, resultType)
                    ownsResult = resultType[0] == 8
                } else {
                let argumentType: List<Integer> = []
                argumentType.add(0)
                if (member == "add" || member == "appended") && isListType(receiverType) {
                    argumentType[0] = listElementType(receiverType)
                }
                let argument = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType)
                if receiverType == 2 && member == "slice" {
                    ownsResult = true
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
                    let endType: List<Integer> = []
                    endType.add(0)
                    let end = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, endType)
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    if argumentType[0] != 1 || endType[0] != 1 {
                        fail("Text.slice positions must be Integers")
                    }
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    output.add("  ")
                    output.add(value)
                    output.add(" = call ptr @minyar_text_slice(ptr ")
                    output.add(receiver)
                    output.add(", i64 ")
                    output.add(argument)
                    output.add(", i64 ")
                    output.add(end)
                    output.add(")\n")
                    setType(resultType, 2)
                } else {
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    if member == "appended" && isListType(receiverType) {
                        if argumentType[0] != listElementType(receiverType) {
                            fail("the value appended to a List has the wrong type")
                        }
                        let slot = valueAsListSlot(output, textState, state, argument, argumentType[0])
                        let transfers = takeResult(output, state, argument, argumentType)
                        let temporary = newTemporary(state)
                        value = valueName(textState, temporary)
                        output.add("  ")
                        output.add(value)
                        output.add(" = call ptr @minyar_list_appended(ptr ")
                        output.add(receiver)
                        output.add(", i64 ")
                        output.add(slot)
                        output.add(", i64 ")
                        if isReferenceType(argumentType[0]) {
                            output.add("1")
                        } else {
                            output.add("0")
                        }
                        output.add(", i64 ")
                        if transfers {
                            output.add("1")
                        } else {
                            output.add("0")
                        }
                        output.add(")\n")
                        ownsResult = true
                        setType(resultType, receiverType)
                    } else {
                    if member != "add" || !isListType(resultType[0]) {
                        fail(describeLocation(tokenLocation(tokenLines, memberLocation)) + ": this value has no method named '" + member + "'")
                    }
                    if argumentType[0] != listElementType(resultType[0]) {
                        fail("the value added to a List has the wrong type")
                    }
                    checkListMutation(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    let slot = valueAsListSlot(output, textState, state, argument, argumentType[0])
                    if takeResult(output, state, argument, argumentType) {
                        output.add("  call void @minyar_list_add_take(ptr ")
                    } else {
                        output.add("  call void @minyar_list_add(ptr ")
                    }
                    output.add(value)
                    output.add(", i64 ")
                    output.add(slot)
                    output.add(")\n")
                    value = ""
                    setType(resultType, 5)
                    }
                }
                }
            } else {
                if isRecordType(receiverType) {
                    let field = findRecordField(functionParameterCounts, functionParameterNames, receiverType, member)
                    if field < 0 {
                        fail("record '" + readableDeclarationName(functionNames[receiverType - 1000]) + "' has no field named '" + member + "'")
                    }
                    checkFieldAccess(tokenLines, functionParameterNames[field], functionNames[receiverType - 1000], memberLocation)
                    let first = functionParameterOffset(functionParameterCounts, receiverType - 1000)
                    let fieldType = functionParameterTypes[field]
                    let temporary = newTemporary(state)
                    let raw = valueName(textState, temporary)
                    if scalarValues >= 0 {
                        raw = output[scalarValues + (field - first) * 3 + 1]
                    } else {
                        output.add("  ")
                        output.add(raw)
                        output.add(" = call i64 @minyar_record_get(ptr ")
                        output.add(receiver)
                        output.add(", i64 ")
                        output.add(Text(field - first))
                        output.add(")\n")
                    }
                    scalarValues = -1
                    value = slotAsValue(output, textState, state, raw, fieldType)
                    setType(resultType, fieldType)
                } else {
                    if receiverType != 2 && receiverType != 8 && !isListType(receiverType) {
                        fail("this value does not provide a field named '" + member + "'")
                    }
                    if member != "length" && !(receiverType == 2 && member == "byteLength") {
                        fail("this value does not provide a field named '" + member + "'")
                    }
                    let temporary = newTemporary(state)
                    let operation = "list_length"
                    if receiverType == 2 {
                        operation = "text_length"
                        if member == "byteLength" {
                            operation = "text_byte_length"
                        }
                    }
                    if receiverType == 8 {
                        operation = "bytes_length"
                    }
                    value = valueName(textState, temporary)
                    output.add("  ")
                    output.add(value)
                    if operation == "list_length" {
                        output.add(" = call i64 @.minyar.list.length")
                    } else {
                        output.add(" = call i64 @minyar_")
                        output.add(operation)
                    }
                    output.add("(ptr ")
                    output.add(receiver)
                    output.add(")\n")
                    setType(resultType, 1)
                }
            }
        } else {
            let collection = value
            let collectionType = resultType[0]
            state[0] = state[0] + 1
            let positionType: List<Integer> = []
            positionType.add(0)
            let position = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, positionType)
            expectToken(tokenKinds, tokenTexts, tokenLines, state, "]")
            requireType(tokenLines, state, positionType[0], 1, "a position must be an Integer")
            let temporary = newTemporary(state)
            if collectionType == 2 {
                value = valueName(textState, temporary)
                output.add("  ")
                output.add(value)
                output.add(" = call i32 @minyar_text_character_at(ptr ")
                output.add(collection)
                output.add(", i64 ")
                output.add(position)
                output.add(")\n")
                setType(resultType, 3)
            } else {
                if collectionType == 8 {
                    value = emitBytesRead(output, textState, state, collection, position)
                    setType(resultType, 1)
                } else {
                if !isListType(collectionType) {
                    fail("indexing needs Text, a List, or Bytes")
                }
                let raw = valueName(textState, temporary)
                output.add("  ")
                output.add(raw)
                output.add(" = call i64 @.minyar.list.get.checked(ptr ")
                output.add(collection)
                output.add(", i64 ")
                output.add(position)
                output.add(")\n")
                let elementType = listElementType(collectionType)
                value = slotAsValue(output, textState, state, raw, elementType)
                setType(resultType, elementType)
                }
            }
        }
        if ownsResult {
            ownResult(output, state, value, resultType)
        } else {
            // A following field read cannot change the receiver's owner, and
            // neither can an index whose expression makes no calls. Other
            // calls and indexed expressions can, so keep those receivers alive.
            let fieldRead = tokenIs(tokenKinds, tokenTexts, state, ".") && state[0] + 2 < tokenTexts.length && tokenTexts[state[0] + 2] != "("
            if !fieldRead && !indexWithoutCalls(tokenKinds, tokenTexts, state[0]) {
                borrowReference(output, state, value, resultType[0])
            }
        }
    }
    return value
}

function parseRecord(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let name = tokenTexts[state[0]]
    let record = findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, name, 2)
    if record < 0 {
        fail("I can't find a record named '" + readableDeclarationName(name) + "'")
    }
    let hidden = 0
    while hidden < functionParameterCounts[record] {
        let stored = functionParameterNames[functionParameterOffset(functionParameterCounts, record) + hidden]
        let declared = declaredFieldName(stored)
        if stored.length > declared.length && stored.slice(declared.length + 1, stored.length) != tokenPath(tokenLines, state[0]) {
            fail(describeLocation(tokenLocation(tokenLines, state[0])) + ": record '" + readableDeclarationName(name) + "' has private fields, so only its own module can create one")
        }
        hidden = hidden + 1
    }
    state[0] = state[0] + 1
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "{")
    skipTerminators(tokenKinds, state)
    let temporary = newTemporary(state)
    let value = valueName(textState, temporary)
    let fieldCount = functionParameterCounts[record]
    let first = functionParameterOffset(functionParameterCounts, record)
    let scalarLocal = state[10]
    state[10] = -1
    let scalarValues = -1
    let scalar = true
    let inspect = 0
    while inspect < fieldCount {
        if isReferenceType(functionParameterTypes[first + inspect]) {
            scalar = false
        }
        inspect = inspect + 1
    }
    let owner = -1
    if scalarLocal >= 0 {
        value = "null"
        output.add("; scalar record " + Text(scalarLocal) + "\n")
        scalarValues = output.length
        let field = 0
        while field < fieldCount {
            output.add("; ")
            output.add("")
            output.add("\n")
            field = field + 1
        }
        markScalarRecord(state, scalarLocal, scalarValues)
    } else {
        output.add("  ")
        output.add(value)
        if scalar {
            output.add(" = call ptr @minyar_record_new_scalar(i64 ")
        } else {
            output.add(" = call ptr @minyar_record_new(i64 ")
        }
        output.add(Text(fieldCount))
        output.add(")\n")
        owner = keepReference(output, state, value, 1000 + record)
    }
    let seen: List<Boolean> = []
    let position = 0
    while position < fieldCount {
        seen.add(false)
        position = position + 1
    }
    while !tokenIs(tokenKinds, tokenTexts, state, "}") {
        let fieldName = tokenTexts[state[0]]
        let fieldLocation = state[0]
        state[0] = state[0] + 1
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ":")
        let field = findRecordField(functionParameterCounts, functionParameterNames, 1000 + record, fieldName)
        if field < 0 {
            fail(describeLocation(tokenLocation(tokenLines, fieldLocation)) + ": record '" + readableDeclarationName(name) + "' has no field named '" + fieldName + "'")
        }
        let fieldPosition = field - first
        if seen[fieldPosition] {
            fail(describeLocation(tokenLocation(tokenLines, fieldLocation)) + ": record field '" + fieldName + "' was provided twice")
        }
        let fieldType: List<Integer> = []
        fieldType.add(functionParameterTypes[field])
        let valueLocation = state[0]
        let fieldValue = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, fieldType)
        if fieldType[0] != functionParameterTypes[field] {
            fail(describeLocation(tokenLocation(tokenLines, valueLocation)) + ": record field '" + fieldName + "' has the wrong type")
        }
        let slot = valueAsListSlot(output, textState, state, fieldValue, fieldType[0])
        if scalarValues >= 0 {
            output[scalarValues + fieldPosition * 3 + 1] = slot
        } else {
        if isReferenceType(fieldType[0]) {
            if takeResult(output, state, fieldValue, fieldType) {
                output.add("  call void @minyar_record_set_take(ptr ")
            } else {
                output.add("  call void @minyar_record_set_reference(ptr ")
            }
        } else {
            if scalar {
                output.add("  call void @minyar_record_set_scalar(ptr ")
            } else {
                output.add("  call void @minyar_record_set(ptr ")
            }
        }
        output.add(value)
        output.add(", i64 ")
        output.add(Text(fieldPosition))
        output.add(", i64 ")
        output.add(slot)
        output.add(")\n")
        }
        seen[fieldPosition] = true
        if tokenIs(tokenKinds, tokenTexts, state, ",") {
            state[0] = state[0] + 1
        }
        skipTerminators(tokenKinds, state)
    }
    let closingLocation = state[0]
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "}")
    position = 0
    while position < fieldCount {
        if !seen[position] {
            fail(describeLocation(tokenLocation(tokenLines, closingLocation)) + ": record '" + readableDeclarationName(name) + "' is missing field '" + declaredFieldName(functionParameterNames[first + position]) + "'")
        }
        position = position + 1
    }
    setType(resultType, 1000 + record)
    markOwner(resultType, owner)
    return value
}

function integerListItemEnd(tokenKinds: List<Integer>, tokenTexts: List<Text>, position: Integer): Integer {
    if tokenKinds[position] == 4 && tokenTexts[position] == "-" { position = position + 1 }
    if tokenKinds[position] != 2 { return 0 }
    position = position + 1
    while tokenKinds[position] == 6 { position = position + 1 }
    if tokenKinds[position] == 4 && (tokenTexts[position] == "," || tokenTexts[position] == "]") { return position }
    return 0
}

function appendIntegerListRun(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, value: Text) {
    let first = state[0]
    let constants: List<Text> = []
    let end = integerListItemEnd(tokenKinds, tokenTexts, state[0])
    while end > 0 {
        let negative = tokenKinds[state[0]] == 4
        if negative { state[0] = state[0] + 1 }
        let digits = checkedIntegerLiteral(tokenTexts[state[0]], negative, tokenLines, state[0])
        if negative { digits = "-" + digits }
        constants.add(digits)
        state[0] = end
        end = 0
        if tokenTexts[state[0]] == "," {
            let next = state[0] + 1
            while tokenKinds[next] == 6 { next = next + 1 }
            end = integerListItemEnd(tokenKinds, tokenTexts, next)
            if end > 0 { state[0] = next }
        }
    }
    if constants.length == 1 {
        output.add("  call void @minyar_list_add(ptr " + value + ", i64 " + constants[0] + ")\n")
    } else {
        let name = "@.list." + Text(first)
        globals.add(name + " = private unnamed_addr constant [" + Text(constants.length) + " x i64] [")
        let position = 0
        while position < constants.length {
            if position > 0 { globals.add(", ") }
            globals.add("i64 ")
            globals.add(constants[position])
            position = position + 1
        }
        globals.add("], align 8\n")
        output.add("  call void @minyar_list_append_scalars(ptr " + value + ", ptr " + name + ", i64 " + Text(constants.length) + ")\n")
    }
}

// Literal conditions have one possible edge. Preserve both parsed bodies for
// diagnostics, but do not leave LLVM to analyse impossible deeply nested CFGs.
function conditionalBranch(condition: Text, thenTarget: Text, elseTarget: Text): Text {
    if condition == "true" { return "  br label %" + thenTarget + "\n" }
    if condition == "false" { return "  br label %" + elseTarget + "\n" }
    return "  br i1 " + condition + ", label %" + thenTarget + ", label %" + elseTarget + "\n"
}

function prepareStatementFrame(frames: List<Integer>, conditions: List<Text>, depth: Integer, kind: Integer) {
    let frame = depth * 8
    while frames.length < frame + 8 { frames.add(0) }
    while conditions.length <= depth { conditions.add("") }
    frames[frame] = kind
}

function compileStatementSequence(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, returnType: Integer, startsBlock: Boolean): Boolean {
    let frames: List<Integer> = []
    let conditions: List<Text> = []
    let depth = 0
    // Mode 0 enters a block; 1 reads its next statement; 2 resumes its
    // caller with the just-completed statement/block's termination result.
    let mode = 1
    if startsBlock { mode = 0 }
    let returns = false
    let done = false
    while !done {
        if mode == 0 {
            expectToken(tokenKinds, tokenTexts, tokenLines, state, "{")
            skipTerminators(tokenKinds, state)
            prepareStatementFrame(frames, conditions, depth, 1)
            let frame = depth * 8
            frames[frame + 1] = state[3]
            frames[frame + 2] = 0
            frames[frame + 3] = 0
            frames[frame + 7] = state[13]
            depth = depth + 1
            mode = 1
        } else {
            if mode == 1 {
                let inBlock = false
                let frame = 0
                if depth > 0 {
                    frame = (depth - 1) * 8
                    inBlock = frames[frame] == 1
                }
                if inBlock && tokenIs(tokenKinds, tokenTexts, state, "}") {
                    returns = frames[frame + 2] != 0
                    if returns && frames[frame + 3] == 0 { output.add("  unreachable\n") }
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, "}")
                    let firstScopedLocal = frames[frame + 1]
                    if !returns {
                        let local = firstScopedLocal
                        while local < state[3] {
                            rootLocal(output, state, localIds[local], "null", localTypes[local])
                            local = local + 1
                        }
                    }
                    state[13] = frames[frame + 7]
                    state[3] = firstScopedLocal
                    depth = depth - 1
                    mode = 2
                } else {
                    if inBlock && frames[frame + 3] != 0 {
                        textState[0] = "dead." + Text(newLabel(state))
                        output.add("\n" + textState[0] + ":\n")
                    }
                    if tokenIs(tokenKinds, tokenTexts, state, "if") {
                        let referenceEffects = state[7]
                        state[0] = state[0] + 1
                        let conditionType: List<Integer> = []
                        conditionType.add(0)
                        let condition = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, conditionType)
                        requireType(tokenLines, state, conditionType[0], 4, "an if condition must be Boolean")
                        let thenLabel = newLabel(state)
                        let elseLabel = newLabel(state)
                        let endLabel = newLabel(state)
                        let branchSlot = output.length
                        output.add("")
                        textState[0] = "if.then." + Text(thenLabel)
                        prepareStatementFrame(frames, conditions, depth, 2)
                        frame = depth * 8
                        frames[frame + 1] = referenceEffects
                        frames[frame + 2] = thenLabel
                        frames[frame + 3] = elseLabel
                        frames[frame + 4] = endLabel
                        frames[frame + 5] = branchSlot
                        conditions[depth] = condition
                        depth = depth + 1
                        mode = 0
                    } else {
                        if tokenIs(tokenKinds, tokenTexts, state, "while") {
                            let referenceEffects = state[7]
                            state[0] = state[0] + 1
                            let conditionLabel = newLabel(state)
                            let bodyLabel = newLabel(state)
                            let endLabel = newLabel(state)
                            output.add("  br label %while.condition.")
                            output.add(Text(conditionLabel))
                            output.add("\n\nwhile.condition.")
                            output.add(Text(conditionLabel))
                            output.add(":\n")
                            textState[0] = "while.condition." + Text(conditionLabel)
                            let conditionType: List<Integer> = []
                            conditionType.add(0)
                            let condition = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, conditionType)
                            requireType(tokenLines, state, conditionType[0], 4, "a while condition must be Boolean")
                            output.add(conditionalBranch(condition, "while.body." + Text(bodyLabel), "while.end." + Text(endLabel)))
                            output.add("\nwhile.body.")
                            output.add(Text(bodyLabel))
                            output.add(":\n")
                            textState[0] = "while.body." + Text(bodyLabel)
                            prepareStatementFrame(frames, conditions, depth, 4)
                            frame = depth * 8
                            frames[frame + 1] = referenceEffects
                            frames[frame + 2] = conditionLabel
                            frames[frame + 4] = endLabel
                            frames[frame + 6] = 0
                            if condition == "true" { frames[frame + 6] = 1 }
                            frames[frame + 7] = state[3]
                            addLocal(localNames, localTypes, localIds, localLengths, state, " loop", -1, conditionLabel)
                            depth = depth + 1
                            mode = 0
                        } else {
                            returns = compileAtomicStatement(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType)
                            mode = 2
                        }
                    }
                }
            } else {
                if depth == 0 {
                    done = true
                } else {
                    let frame = (depth - 1) * 8
                    let kind = frames[frame]
                    if kind == 1 {
                        frames[frame + 3] = 0
                        if returns {
                            state[13] = 1
                            frames[frame + 2] = 1
                            frames[frame + 3] = 1
                        }
                        finishStatement(tokenKinds, tokenTexts, tokenLines, state)
                        mode = 1
                    } else {
                        let endLabel = frames[frame + 4]
                        let referenceEffects = frames[frame + 1]
                        let statementComplete = true
                        if kind == 2 {
                            if !returns {
                                output.add("  br label %if.end.")
                                output.add(Text(endLabel))
                                output.add("\n")
                            }
                            let continuation = state[0]
                            while tokenKinds[continuation] == 6 && tokenTexts[continuation] == "end of line" { continuation = continuation + 1 }
                            let hasElse = tokenKinds[continuation] == 1 && tokenTexts[continuation] == "else"
                            if hasElse { state[0] = continuation }
                            let thenLabel = frames[frame + 2]
                            let elseLabel = frames[frame + 3]
                            let falseTarget = "if.end." + Text(endLabel)
                            if hasElse { falseTarget = "if.else." + Text(elseLabel) }
                            output[frames[frame + 5]] = conditionalBranch(conditions[depth - 1], "if.then." + Text(thenLabel), falseTarget) + "\nif.then." + Text(thenLabel) + ":\n"
                            conditions[depth - 1] = ""
                            if hasElse {
                                frames[frame] = 3
                                frames[frame + 6] = 0
                                if returns { frames[frame + 6] = 1 }
                                state[0] = state[0] + 1
                                output.add("\nif.else.")
                                output.add(Text(elseLabel))
                                output.add(":\n")
                                textState[0] = "if.else." + Text(elseLabel)
                                statementComplete = false
                                mode = 0
                                if tokenIs(tokenKinds, tokenTexts, state, "if") { mode = 1 }
                            } else {
                                returns = false
                            }
                        } else {
                            if kind == 3 {
                                if !returns {
                                    output.add("  br label %if.end.")
                                    output.add(Text(endLabel))
                                    output.add("\n")
                                }
                                returns = returns && frames[frame + 6] != 0
                            } else {
                                if !returns {
                                    // Scalar loops must service preceding cleanup debt.
                                    // Scalar-only functions erase this call later.
                                    output.add("  call void @minyar_rc_step()\n")
                                    output.add("  br label %while.condition.")
                                    output.add(Text(frames[frame + 2]))
                                    output.add("\n")
                                }
                                output.add("\nwhile.end.")
                                output.add(Text(endLabel))
                                output.add(":\n")
                                textState[0] = "while.end." + Text(endLabel)
                                // A reachable break permits a literal-true loop to fall through.
                                let markerScope = frames[frame + 7]
                                let canBreak = localTypes[markerScope] == -3
                                state[3] = markerScope
                                returns = frames[frame + 6] != 0 && !canBreak
                                if returns { output.add("  unreachable\n") }
                            }
                        }
                        if statementComplete {
                            if kind != 4 && !returns {
                                output.add("\nif.end.")
                                output.add(Text(endLabel))
                                output.add(":\n")
                                textState[0] = "if.end." + Text(endLabel)
                            }
                            if !returns && state[7] != referenceEffects { output.add("  call void @minyar_rc_step()\n") }
                            depth = depth - 1
                        }
                    }
                }
            }
        }
    }
    return returns
}

function lowerIntegerDispatch(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, start: Integer, end: Integer, parameter: Text, output: List<Text>, globals: List<Text>, bodySlot: Integer, table: Text): Boolean {
    let cursor: List<Integer> = []
    cursor.add(start + 1)
    let cases: List<Text> = []
    let results: List<Text> = []
    skipTerminators(tokenKinds, cursor)
    while cursor[0] < end && tokenIs(tokenKinds, tokenTexts, cursor, "if") {
        let position = cursor[0]
        if position + 5 >= end { return false }
        if tokenKinds[position + 1] != 1 || tokenTexts[position + 1] != parameter || tokenTexts[position + 2] != "==" || tokenKinds[position + 3] != 2 || tokenTexts[position + 4] != "{" { return false }
        let value = checkedIntegerLiteral(tokenTexts[position + 3], false, tokenLines, position + 3)
        if cases.length > 0 {
            let prior = cases[cases.length - 1]
            if prior.length > value.length || (prior.length == value.length && compareText(prior, value) >= 0) { return false }
        }
        cursor[0] = position + 5
        skipTerminators(tokenKinds, cursor)
        position = cursor[0]
        if position + 2 >= end || tokenTexts[position] != "return" || tokenKinds[position + 1] != 2 { return false }
        let result = checkedIntegerLiteral(tokenTexts[position + 1], false, tokenLines, position + 1)
        cursor[0] = position + 2
        skipTerminators(tokenKinds, cursor)
        position = cursor[0]
        if position + 2 >= end || tokenTexts[position] != "}" || tokenTexts[position + 1] != "else" || tokenTexts[position + 2] != "{" { return false }
        cursor[0] = position + 3
        skipTerminators(tokenKinds, cursor)
        cases.add(value)
        results.add(result)
    }
    let position = cursor[0]
    if cases.length == 0 || position + 2 >= end || tokenTexts[position] != "return" || tokenKinds[position + 1] != 2 { return false }
    let fallback = checkedIntegerLiteral(tokenTexts[position + 1], false, tokenLines, position + 1)
    cursor[0] = position + 2
    skipTerminators(tokenKinds, cursor)
    let closing = 0
    while closing <= cases.length {
        if cursor[0] >= end || !tokenIs(tokenKinds, tokenTexts, cursor, "}") { return false }
        cursor[0] = cursor[0] + 1
        // The outer function's closing brace ends this exact body span.
        if closing < cases.length { skipTerminators(tokenKinds, cursor) }
        closing = closing + 1
    }
    if cursor[0] != end { return false }
    // A sorted constant table avoids both quadratic CFG simplification and
    // giant return PHIs. Normal compilation above has already checked every
    // branch. Binary search only reorders pure comparisons of one stable value.
    position = bodySlot
    while position < output.length {
        output[position] = ""
        position = position + 1
    }
    let count = Text(cases.length)
    globals.add(table + " = private unnamed_addr constant [" + count + " x { i64, i64 }] [\n")
    position = 0
    while position < cases.length {
        if position > 0 { globals.add(",\n") }
        globals.add("  { i64, i64 } { i64 " + cases[position] + ", i64 " + results[position] + " }")
        position = position + 1
    }
    globals.add("\n]\n")
    output.add("  br label %dispatch.search\n\ndispatch.search:\n  %dispatch.low = phi i64 [ 0, %entry ], [ %dispatch.next, %dispatch.upper ], [ %dispatch.low, %dispatch.lower ]\n  %dispatch.high = phi i64 [ " + count + ", %entry ], [ %dispatch.high, %dispatch.upper ], [ %dispatch.mid, %dispatch.lower ]\n  %dispatch.more = icmp ult i64 %dispatch.low, %dispatch.high\n  br i1 %dispatch.more, label %dispatch.probe, label %dispatch.default\n")
    output.add("\ndispatch.probe:\n  %dispatch.span = sub i64 %dispatch.high, %dispatch.low\n  %dispatch.half = lshr i64 %dispatch.span, 1\n  %dispatch.mid = add i64 %dispatch.low, %dispatch.half\n  %dispatch.key.ptr = getelementptr [" + count + " x { i64, i64 }], ptr " + table + ", i64 0, i64 %dispatch.mid, i32 0\n  %dispatch.key = load i64, ptr %dispatch.key.ptr\n  %dispatch.match = icmp eq i64 %argument.0, %dispatch.key\n  br i1 %dispatch.match, label %dispatch.found, label %dispatch.compare\n")
    output.add("\ndispatch.compare:\n  %dispatch.less = icmp slt i64 %argument.0, %dispatch.key\n  br i1 %dispatch.less, label %dispatch.lower, label %dispatch.upper\n\ndispatch.lower:\n  br label %dispatch.search\n\ndispatch.upper:\n  %dispatch.next = add i64 %dispatch.mid, 1\n  br label %dispatch.search\n")
    output.add("\ndispatch.found:\n  %dispatch.result.ptr = getelementptr [" + count + " x { i64, i64 }], ptr " + table + ", i64 0, i64 %dispatch.mid, i32 1\n  %dispatch.result = load i64, ptr %dispatch.result.ptr\n  call void @minyar_stack_leave()\n  ret i64 %dispatch.result\n\ndispatch.default:\n  call void @minyar_stack_leave()\n  ret i64 " + fallback + "\n")
    return true
}

function parseListLiteral(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    state[0] = state[0] + 1
    let elementType = 0
    if isListType(resultType[0]) {
        elementType = listElementType(resultType[0])
    }
    let temporary = newTemporary(state)
    let value = valueName(textState, temporary)
    output.add("  ")
    output.add(value)
    output.add(" = call ptr @minyar_list_new()\n")
    let references = false
    if isReferenceType(elementType) {
        output.add("  call void @minyar_list_references(ptr ")
        output.add(value)
        output.add(")\n")
        references = true
    }
    skipTerminators(tokenKinds, state)
    while !tokenIs(tokenKinds, tokenTexts, state, "]") {
        if (elementType == 0 || elementType == 1) && integerListItemEnd(tokenKinds, tokenTexts, state[0]) > 0 {
            elementType = 1
            appendIntegerListRun(tokenKinds, tokenTexts, tokenLines, state, textState, output, globals, value)
        } else {
        let itemType: List<Integer> = []
        itemType.add(elementType)
        let item = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, itemType)
        if itemType[0] == 5 || itemType[0] == 6 {
            fail("Nothing cannot be stored in a List")
        }
        if itemType[0] == 100000 {
            fail("an empty List needs a type, such as List<Text>")
        }
        if elementType == 0 {
            elementType = itemType[0]
        }
        if itemType[0] != elementType {
            fail("all values in a List literal must have the same type")
        }
        if isReferenceType(elementType) && !references {
            output.add("  call void @minyar_list_references(ptr ")
            output.add(value)
            output.add(")\n")
            references = true
        }
        let slot = valueAsListSlot(output, textState, state, item, elementType)
        if takeResult(output, state, item, itemType) {
            output.add("  call void @minyar_list_add_take(ptr ")
        } else {
            output.add("  call void @minyar_list_add(ptr ")
        }
        output.add(value)
        output.add(", i64 ")
        output.add(slot)
        output.add(")\n")
        }
        skipTerminators(tokenKinds, state)
        if !tokenIs(tokenKinds, tokenTexts, state, "]") {
            expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
            skipTerminators(tokenKinds, state)
        }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "]")
    setType(resultType, 100000 + elementType)
    return value
}

function parseAtom(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let tokenIndex = state[0]
    let kind = tokenKinds[tokenIndex]
    let token = tokenTexts[tokenIndex]
    let value = ""

    if kind == 1 {
        if token == "true" || token == "false" {
            value = token
            state[0] = tokenIndex + 1
            setType(resultType, 4)
        } else {
            if tokenTexts[tokenIndex + 1] == "(" {
                value = parseCall(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
            } else {
                if tokenKinds[tokenIndex + 1] == 4 && tokenTexts[tokenIndex + 1] == "{" && findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, token, 2) >= 0 {
                    value = parseRecord(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
                } else {
                    let local = findLocal(localNames, localLengths, state, token)
                    let constant = -1
                    if local < 0 {
                        constant = findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, token, 3)
                        if constant < 0 {
                            fail(describeLocation(tokenLocation(tokenLines, tokenIndex)) + ": I can't find a value named '" + readableDeclarationName(token) + "'")
                        }
                    }
                    if constant >= 0 {
                        // Evaluate the declaration's literal in place of the name.
                        state[0] = functionParameterCounts[constant]
                        value = parseUnary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
                        state[0] = tokenIndex + 1
                    } else {
                    state[0] = tokenIndex + 1
                    let id = localIds[local]
                    if id < 0 {
                        value = output[-id - 1]
                    } else {
                        let temporary = newTemporary(state)
                        value = valueName(textState, temporary)
                        output.add("  ")
                        output.add(value)
                        output.add(" = load ")
                        output.add(llvmType(localTypes[local]))
                        output.add(", ptr %local.")
                        output.add(Text(id))
                        output.add("\n")
                    }
                    setType(resultType, localTypes[local])
                    if id >= 0 && resultType.length > 3 && resultType[2] == id && resultType[3] == tokenIndex {
                        let owner = output.length
                        output.add("  ; minyar-owned-local-transfer\n")
                        output.add(Text(ownershipSlot(state, id)))
                        markOwner(resultType, owner)
                    }
                    }
                }
            }
        }
    } else {
        if kind == 2 {
            value = checkedIntegerLiteral(token, false, tokenLines, tokenIndex)
            state[0] = tokenIndex + 1
            setType(resultType, 1)
        } else {
        if kind == 7 {
            value = checkedFloatLiteral(token, tokenLines, tokenIndex)
            state[0] = tokenIndex + 1
            setType(resultType, 7)
        } else {
            if kind == 3 {
                value = "getelementptr (i8, ptr @.text." + Text(tokenIndex) + ", i64 8)"
                state[0] = tokenIndex + 1
                setType(resultType, 2)
            } else {
                if kind == 5 {
                    state[0] = tokenIndex + 1
                    value = Text(Integer(token[0]))
                    setType(resultType, 3)
                } else {
                    if token == "(" {
                        state[0] = tokenIndex + 1
                        value = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
                        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    } else {
                        if token == "[" {
                            value = parseListLiteral(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
                        } else {
                            fail(describeLocation(tokenLocation(tokenLines, tokenIndex)) + ": expected an expression, found '" + token + "'")
                        }
                    }
                }
            }
        }
        }
    }
    return value
}

function checkBuiltinArguments(name: Text, types: List<Integer>) {
    let count = -1
    if name == "print" || name == "Text" || name == "fail" || name == "exit" || name == "joinText" || name == "argument" || name == "readTextFile" {
        count = 1
    }
    if name == "argumentCount" {
        count = 0
    }
    if name == "writeTextFile" {
        count = 2
    }
    if count >= 0 {
        if types.length != count {
            fail(name + " expects " + Text(count) + " arguments, but received " + Text(types.length))
        }
        if count > 0 {
            let type = types[0]
            if name == "print" && (type < 1 || type > 4) && type != 7 {
                fail(name + " expects one Integer, Float, Text, Character, or Boolean value")
            }
            if name == "Text" && (type < 1 || type > 4) && type != 7 && type != 8 {
                fail(name + " expects one Integer, Float, Text, Character, Boolean, or Bytes value")
            }
            if (name == "fail" || name == "readTextFile") && type != 2 {
                fail(name + " expects one Text argument")
            }
            if (name == "exit" || name == "argument") && type != 1 {
                fail(name + " expects one Integer argument")
            }
            if name == "joinText" && type != 100002 {
                fail("joinText expects one List<Text> argument")
            }
            if name == "writeTextFile" && (type != 2 || types[1] != 2) {
                fail("writeTextFile expects two Text arguments")
            }
        }
    }
}

function isNumericBuiltin(name: Text): Boolean {
    return name == "Bytes" || name == "randomBytes" || name == "readBytesFile" || name == "writeBytesFile" || name == "fileExists" || name == "Float" || name == "Integer" || name == "Character" || isFloatFunction(name) || name == "atan2" || name == "pow" || name == "abs" || name == "min" || name == "max" || name == "clamp" || name == "wrappingAdd" || name == "wrappingSubtract" || name == "wrappingMultiply"
}

function isFloatFunction(name: Text): Boolean {
    return name == "sqrt" || name == "sin" || name == "cos" || name == "tan" || name == "asin" || name == "acos" || name == "atan" || name == "exp" || name == "log" || name == "floor" || name == "ceil" || name == "round"
}

function isBuiltinName(name: Text): Boolean {
    return isNumericBuiltin(name) || name == "parallelEntry" || name == "print" || name == "Text" || name == "fail" || name == "exit" || name == "joinText" || name == "argument" || name == "argumentCount" || name == "readTextFile" || name == "writeTextFile"
}

function requireBuiltinArguments(name: Text, types: List<Integer>, count: Integer, type: Integer) {
    let matches = types.length == count
    let position = 0
    while matches && position < types.length {
        if types[position] != type {
            matches = false
        }
        position = position + 1
    }
    if !matches {
        let noun = describeType(type)
        if count == 1 {
            fail(name + " expects one " + noun + " argument")
        }
        fail(name + " expects " + Text(count) + " " + noun + " arguments")
    }
}

function emitCall(output: List<Text>, textState: List<Text>, state: List<Integer>, returnType: Integer, callee: Text, values: List<Text>, types: List<Integer>): Text {
    let value = ""
    output.add("  ")
    if returnType != 5 {
        value = valueName(textState, newTemporary(state))
        output.add(value)
        output.add(" = ")
    }
    output.add("call ")
    if returnType == 4 {
        output.add("zeroext ")
    }
    output.add(llvmType(returnType))
    output.add(" @")
    output.add(callee)
    output.add("(")
    let position = 0
    while position < values.length {
        if position > 0 {
            output.add(", ")
        }
        output.add(llvmType(types[position]))
        output.add(" ")
        output.add(values[position])
        position = position + 1
    }
    output.add(")\n")
    return value
}

function pairOf(first: Text, second: Text): List<Text> {
    let pair: List<Text> = []
    pair.add(first)
    pair.add(second)
    return pair
}

function typePairOf(type: Integer): List<Integer> {
    let pair: List<Integer> = []
    pair.add(type)
    pair.add(type)
    return pair
}

function emitInstruction(output: List<Text>, textState: List<Text>, state: List<Integer>, instruction: Text): Text {
    let value = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(value)
    output.add(" = ")
    output.add(instruction)
    output.add("\n")
    return value
}

// Conversions and arithmetic helpers. Float math follows IEEE 754; Integer
// helpers keep the checked-overflow rule unless their name says otherwise.
function emitNumericBuiltin(output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, values: List<Text>, types: List<Integer>, resultType: List<Integer>): Text {
    if name == "Bytes" {
        if types.length == 0 {
            values.add("0")
            types.add(1)
        }
        // Bytes(text) is the text's UTF-8 encoding.
        if types.length == 1 && types[0] == 2 {
            setType(resultType, 8)
            return emitCall(output, textState, state, 8, "minyar_text_bytes", values, types)
        }
        requireBuiltinArguments(name, types, 1, 1)
        setType(resultType, 8)
        return emitCall(output, textState, state, 8, "minyar_bytes_new", values, types)
    }
    if name == "randomBytes" {
        // Bytes from the platform's cryptographically secure generator.
        requireBuiltinArguments(name, types, 1, 1)
        setType(resultType, 8)
        return emitCall(output, textState, state, 8, "minyar_random_bytes", values, types)
    }
    if name == "fileExists" {
        requireBuiltinArguments(name, types, 1, 2)
        setType(resultType, 4)
        return emitCall(output, textState, state, 4, "minyar_file_exists", values, types)
    }
    if name == "readBytesFile" {
        requireBuiltinArguments(name, types, 1, 2)
        setType(resultType, 8)
        return emitCall(output, textState, state, 8, "minyar_read_bytes_file", values, types)
    }
    if name == "writeBytesFile" {
        if types.length != 2 || types[0] != 2 || types[1] != 8 {
            fail("writeBytesFile expects a Text path and Bytes")
        }
        setType(resultType, 5)
        return emitCall(output, textState, state, 5, "minyar_write_bytes_file", values, types)
    }
    if isFloatFunction(name) {
        requireBuiltinArguments(name, types, 1, 7)
        let callee = "llvm." + name + ".f64"
        if name == "tan" || name == "asin" || name == "acos" || name == "atan" {
            callee = "minyar_" + name
        }
        setType(resultType, 7)
        return emitCall(output, textState, state, 7, callee, values, types)
    }
    if name == "atan2" || name == "pow" {
        requireBuiltinArguments(name, types, 2, 7)
        let callee = "llvm.pow.f64"
        if name == "atan2" {
            callee = "minyar_atan2"
        }
        setType(resultType, 7)
        return emitCall(output, textState, state, 7, callee, values, types)
    }
    if name == "wrappingAdd" || name == "wrappingSubtract" || name == "wrappingMultiply" {
        requireBuiltinArguments(name, types, 2, 1)
        let instruction = "add"
        if name == "wrappingSubtract" { instruction = "sub" }
        if name == "wrappingMultiply" { instruction = "mul" }
        setType(resultType, 1)
        return emitInstruction(output, textState, state, instruction + " i64 " + values[0] + ", " + values[1])
    }
    if name == "abs" {
        if types.length == 1 && types[0] == 7 {
            setType(resultType, 7)
            return emitCall(output, textState, state, 7, "llvm.fabs.f64", values, types)
        }
        requireBuiltinArguments(name, types, 1, 1)
        setType(resultType, 1)
        return emitCall(output, textState, state, 1, ".minyar.integer.absolute.checked", values, types)
    }
    if name == "min" || name == "max" || name == "clamp" {
        let count = 2
        if name == "clamp" { count = 3 }
        let type = 1
        if types.length > 0 && types[0] == 7 { type = 7 }
        if types.length != count || (type != 1 && type != 7) {
            fail(name + " expects " + Text(count) + " Integer or " + Text(count) + " Float arguments")
        }
        requireBuiltinArguments(name, types, count, type)
        setType(resultType, type)
        if name == "clamp" {
            let pairTypes = typePairOf(type)
            let checkName = ".minyar.clamp.integer.checked"
            if type == 7 { checkName = ".minyar.clamp.float.checked" }
            emitCall(output, textState, state, 5, checkName, pairOf(values[1], values[2]), pairTypes)
            let raised = emitMinimumOrMaximum(output, textState, state, "max", type, pairOf(values[0], values[1]), pairTypes)
            return emitMinimumOrMaximum(output, textState, state, "min", type, pairOf(raised, values[2]), pairTypes)
        }
        return emitMinimumOrMaximum(output, textState, state, name, type, values, types)
    }
    if name == "Float" {
        if types.length == 1 && types[0] == 7 {
            setType(resultType, 7)
            return values[0]
        }
        requireBuiltinArguments(name, types, 1, 1)
        setType(resultType, 7)
        return emitInstruction(output, textState, state, "sitofp i64 " + values[0] + " to double")
    }
    if name == "Integer" {
        setType(resultType, 1)
        if types.length == 1 && types[0] == 1 {
            return values[0]
        }
        if types.length == 1 && types[0] == 3 {
            return emitInstruction(output, textState, state, "zext i32 " + values[0] + " to i64")
        }
        if types.length != 1 || types[0] != 7 {
            fail("Integer expects one Integer, Float, or Character argument")
        }
        return emitCall(output, textState, state, 1, ".minyar.float.integer.checked", values, types)
    }
    requireBuiltinArguments(name, types, 1, 1)
    setType(resultType, 3)
    return emitCall(output, textState, state, 3, ".minyar.character.checked", values, types)
}

function emitMinimumOrMaximum(output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, type: Integer, values: List<Text>, types: List<Integer>): Text {
    if type == 7 {
        let callee = "llvm.minnum.f64"
        if name == "max" { callee = "llvm.maxnum.f64" }
        return emitCall(output, textState, state, 7, callee, values, types)
    }
    let condition = "slt"
    if name == "max" { condition = "sgt" }
    let chooseLeft = emitInstruction(output, textState, state, "icmp " + condition + " i64 " + values[0] + ", " + values[1])
    return emitInstruction(output, textState, state, "select i1 " + chooseLeft + ", i64 " + values[0] + ", i64 " + values[1])
}

function parseCall(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let name = tokenTexts[state[0]]
    let callLocation = state[0]
    state[0] = state[0] + 1
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "(")
    if name == "parallelEntry" {
        // The address of a parallel function, for starting it on other processors.
        if tokenKinds[state[0]] != 1 {
            fail(describeLocation(tokenLocation(tokenLines, callLocation)) + ": parallelEntry expects the name of a parallel function")
        }
        let target = tokenTexts[state[0]]
        let function = findFunction(functionNames, symbolKinds, functionReturnTypes, target)
        if function < 0 {
            fail(describeLocation(tokenLocation(tokenLines, callLocation)) + ": I can't find a function named '" + readableDeclarationName(target) + "'")
        }
        state[0] = state[0] + 1
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        globals.add("; minyar-parallel-entry: " + target + "\n")
        let temporary = newTemporary(state)
        let entry = valueName(textState, temporary)
        output.add("  " + entry + " = ptrtoint ptr @.minyar.fn." + target + " to i64\n")
        setType(resultType, 1)
        return entry
    }
    let argumentValues: List<Text> = []
    let argumentTypes: List<Integer> = []
    let argumentType: List<Integer> = []
    argumentType.add(0)
    while !tokenIs(tokenKinds, tokenTexts, state, ")") {
        setType(argumentType, 0)
        // Only literals (possibly parenthesized) need an expected type here.
        // Resolve before parsing so a nested call cannot replace this context.
        if tokenIs(tokenKinds, tokenTexts, state, "[") || tokenIs(tokenKinds, tokenTexts, state, "(") {
            let contextFunction = findFunction(functionNames, symbolKinds, functionReturnTypes, name)
            if contextFunction >= 0 && argumentValues.length < functionParameterCounts[contextFunction] {
                let first = functionParameterOffset(functionParameterCounts, contextFunction)
                argumentType[0] = functionParameterTypes[first + argumentValues.length]
            }
            if name == "joinText" && argumentValues.length == 0 {
                argumentType[0] = 100002
            }
        }
        argumentValues.add(parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType))
        argumentTypes.add(argumentType[0])
        if tokenIs(tokenKinds, tokenTexts, state, ",") {
            state[0] = state[0] + 1
        }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    checkBuiltinArguments(name, argumentTypes)

    let value = ""
    if name == "print" {
        // checkBuiltinArguments has already established the single argument.
        if argumentTypes[0] > 4 && argumentTypes[0] != 7 {
            fail("print expects one Integer, Float, Text, Character, or Boolean value")
        }
        let suffix = "text"
        if argumentTypes[0] == 1 {
            suffix = "integer"
        }
        if argumentTypes[0] == 7 {
            suffix = "float"
        }
        if argumentTypes[0] == 3 {
            suffix = "character"
        }
        if argumentTypes[0] == 4 {
            suffix = "boolean"
        }
        output.add("  call void @minyar_print_")
        output.add(suffix)
        output.add("(")
        output.add(nativeType(argumentTypes[0]))
        output.add(" ")
        output.add(argumentValues[0])
        output.add(")\n")
        setType(resultType, 5)
    } else {
        if name == "fail" {
            output.add("  call void @minyar_fail(ptr ")
            output.add(argumentValues[0])
            output.add(")\n")
            setType(resultType, 6)
        } else {
            if name == "exit" {
                if argumentValues.length != 1 || argumentTypes[0] != 1 {
                    fail("exit expects one Integer status")
                }
                output.add("  call void @minyar_exit(i64 ")
                output.add(argumentValues[0])
                output.add(")\n")
                setType(resultType, 6)
            } else {
            if name == "Text" {
                if argumentTypes[0] == 2 {
                    value = argumentValues[0]
                    output.add("  call void @minyar_rc_retain(ptr ")
                    output.add(value)
                    output.add(")\n")
                } else {
                    let suffix = "boolean"
                    if argumentTypes[0] == 1 {
                        suffix = "integer"
                    }
                    if argumentTypes[0] == 7 {
                        suffix = "float"
                    }
                    if argumentTypes[0] == 3 {
                        suffix = "character"
                    }
                    // Text(bytes) reads the bytes as UTF-8.
                    if argumentTypes[0] == 8 {
                        suffix = "bytes"
                    }
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    output.add("  ")
                    output.add(value)
                    output.add(" = call ptr @minyar_")
                    output.add(suffix)
                    output.add("_text(")
                    output.add(nativeType(argumentTypes[0]))
                    output.add(" ")
                    output.add(argumentValues[0])
                    output.add(")\n")
                }
                setType(resultType, 2)
            } else {
                if name == "joinText" {
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    output.add("  ")
                    output.add(value)
                    output.add(" = call ptr @minyar_join_texts(ptr ")
                    output.add(argumentValues[0])
                    output.add(")\n")
                    setType(resultType, 2)
                } else {
                    if name == "argumentCount" {
                        let temporary = newTemporary(state)
                        value = valueName(textState, temporary)
                        output.add("  ")
                        output.add(value)
                        output.add(" = call i64 @minyar_argument_count()\n")
                        setType(resultType, 1)
                    } else {
                        if name == "argument" || name == "readTextFile" {
                            let temporary = newTemporary(state)
                            value = valueName(textState, temporary)
                            let runtimeName = "argument"
                            if name == "readTextFile" {
                                runtimeName = "read_text_file"
                            }
                            output.add("  ")
                            output.add(value)
                            output.add(" = call ptr @minyar_")
                            output.add(runtimeName)
                            output.add("(")
                            output.add(nativeType(argumentTypes[0]))
                            output.add(" ")
                            output.add(argumentValues[0])
                            output.add(")\n")
                            setType(resultType, 2)
                        } else {
                            if name == "writeTextFile" {
                                output.add("  call void @minyar_write_text_file(ptr ")
                                output.add(argumentValues[0])
                                output.add(", ptr ")
                                output.add(argumentValues[1])
                                output.add(")\n")
                                setType(resultType, 5)
                            } else {
                                if isNumericBuiltin(name) {
                                    value = emitNumericBuiltin(output, textState, state, name, argumentValues, argumentTypes, resultType)
                                } else {
                                    let functionIndex = state[5]
                                    if functionIndex < 0 || functionNames[functionIndex] != name {
                                        functionIndex = findFunction(functionNames, symbolKinds, functionReturnTypes, name)
                                        state[5] = functionIndex
                                    }
                                    if functionIndex < 0 {
                                        fail(describeLocation(tokenLocation(tokenLines, callLocation)) + ": I can't find a function named '" + readableDeclarationName(name) + "'")
                                    }
                                    if name == "main" {
                                        fail("the executable entry main cannot be called; use a separate function for shared work")
                                    }
                                    if argumentValues.length != functionParameterCounts[functionIndex] {
                                        fail(readableDeclarationName(name) + " expects " + Text(functionParameterCounts[functionIndex]) + " arguments, but received " + Text(argumentValues.length) + " near " + describeLocation(tokenLocation(tokenLines, state[0])))
                                    }
                                    let parameterOffset = functionParameterOffset(functionParameterCounts, functionIndex)
                                    let argumentIndex = 0
                                    while argumentIndex < argumentValues.length {
                                        if argumentTypes[argumentIndex] != functionParameterTypes[parameterOffset + argumentIndex] {
                                            fail(describeLocation(tokenLocation(tokenLines, state[0])) + ": an argument passed to " + readableDeclarationName(name) + " has the wrong type")
                                        }
                                        argumentIndex = argumentIndex + 1
                                    }
                                    let returnType = functionReturnTypes[functionIndex]
                                    output.add("  ")
                                    if returnType != 5 {
                                        let temporary = newTemporary(state)
                                        value = valueName(textState, temporary)
                                        output.add(value)
                                        output.add(" = ")
                                    }
                                    output.add("call ")
                                    output.add(llvmType(returnType))
                                    if name == "main" || name[0] == '"' {
                                        output.add(" @")
                                    } else {
                                        output.add(" @.minyar.fn.")
                                    }
                                    output.add(name)
                                    output.add("(")
                                    argumentIndex = 0
                                    while argumentIndex < argumentValues.length {
                                        if argumentIndex > 0 {
                                            output.add(", ")
                                        }
                                        output.add(llvmType(argumentTypes[argumentIndex]))
                                        output.add(" ")
                                        output.add(argumentValues[argumentIndex])
                                        argumentIndex = argumentIndex + 1
                                    }
                                    output.add(")\n")
                                    setType(resultType, returnType)
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }
    return value
}

function nextLocal(state: List<Integer>): Integer {
    let id = state[4]
    state[4] = id + 1
    return id
}

function isAssignmentOperator(token: Text): Boolean {
    return token == "=" || token == "+=" || token == "-=" || token == "*=" || token == "/=" || token == "%="
}

// Find the operator of `name(.field | [position])* op= value`, or -1 when the
// statement is not an assignment.
function assignmentOperatorPosition(tokenKinds: List<Integer>, tokenTexts: List<Text>, start: Integer): Integer {
    if tokenKinds[start] != 1 {
        return -1
    }
    let position = start + 1
    let searching = true
    while searching {
        if tokenKinds[position] == 4 && tokenTexts[position] == "." && tokenKinds[position + 1] == 1 {
            position = position + 2
        } else {
            if tokenKinds[position] == 4 && tokenTexts[position] == "[" {
                let depth = 1
                position = position + 1
                while depth > 0 && tokenKinds[position] != 0 {
                    if tokenKinds[position] == 4 && tokenTexts[position] == "[" {
                        depth = depth + 1
                    }
                    if tokenKinds[position] == 4 && tokenTexts[position] == "]" {
                        depth = depth - 1
                    }
                    position = position + 1
                }
                if depth > 0 {
                    return -1
                }
            } else {
                searching = false
            }
        }
    }
    if tokenKinds[position] == 4 && isAssignmentOperator(tokenTexts[position]) {
        return position
    }
    return -1
}

function loadLocal(output: List<Text>, textState: List<Text>, state: List<Integer>, id: Integer, type: Integer): Text {
    if id < 0 {
        return output[-id - 1]
    }
    let value = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(value)
    output.add(" = load ")
    output.add(llvmType(type))
    output.add(", ptr %local.")
    output.add(Text(id))
    output.add("\n")
    return value
}

function storeLocal(output: List<Text>, id: Integer, type: Integer, value: Text) {
    output.add("  store ")
    output.add(llvmType(type))
    output.add(" ")
    output.add(value)
    output.add(", ptr %local.")
    output.add(Text(id))
    output.add("\n")
}

function readRecordField(output: List<Text>, textState: List<Text>, state: List<Integer>, record: Text, field: Integer, type: Integer): Text {
    let raw = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(raw)
    output.add(" = call i64 @minyar_record_get(ptr ")
    output.add(record)
    output.add(", i64 ")
    output.add(Text(field))
    output.add(")\n")
    return slotAsValue(output, textState, state, raw, type)
}

function readListElement(output: List<Text>, textState: List<Text>, state: List<Integer>, list: Text, position: Text, type: Integer): Text {
    let raw = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(raw)
    output.add(" = call i64 @.minyar.list.get.checked(ptr ")
    output.add(list)
    output.add(", i64 ")
    output.add(position)
    output.add(")\n")
    return slotAsValue(output, textState, state, raw, type)
}

// Adding an edge R -> F can close a first cycle only when a value reachable
// from F can itself be an R. Mirror checkListMutation for record fields.
function checkFieldMutation(recordType: Integer, fieldType: Integer, counts: List<Integer>, fields: List<Integer>, locations: SourceMap, location: Integer) {
    let recordCount = counts.length / 2
    let visited: List<Boolean> = []
    let index = 0
    while index < recordCount {
        visited.add(false)
        index = index + 1
    }
    let pending: List<Integer> = []
    pending.add(fieldType)
    index = 0
    while index < pending.length {
        let type = pending[index]
        index = index + 1
        while isListType(type) {
            type = listElementType(type)
        }
        if isRecordType(type) {
            if type == recordType {
                fail(describeLocation(tokenLocation(locations, location)) + ": assigning this field could create a reference cycle; construct a new record instead")
            }
            let record = type - 1000
            if !visited[record] {
                visited[record] = true
                let first = functionParameterOffset(counts, record)
                let field = 0
                while field < counts[record] {
                    pending.add(fields[first + field])
                    field = field + 1
                }
            }
        }
    }
}

// Parse the right side of `target op= value`. A compound operator combines the
// current value with the right side exactly as the binary operator would.
function assignedValue(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, binary: Text, current: Text, type: Integer, valueType: List<Integer>, location: Integer): Text {
    setType(valueType, type)
    if binary == "" {
        return parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, valueType)
    }
    let rightType: List<Integer> = []
    rightType.add(type)
    let right = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, rightType)
    setType(valueType, 0)
    return emitBinary(output, textState, state, binary, current, type, -1, right, rightType[0], valueType, tokenLines, location)
}

// Assign through a local, record fields, and List positions. Plain `local = v`
// keeps its dedicated path in compileStatement for Text append ownership.
function compileAssignment(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, operatorPosition: Integer) {
    let operator = tokenTexts[operatorPosition]
    let operatorLocation = operatorPosition
    let binary = ""
    if operator != "=" {
        binary = operator.slice(0, 1)
    }
    let name = tokenTexts[state[0]]
    let local = findLocal(localNames, localLengths, state, name)
    if local < 0 {
        fail(describeLocation(tokenLocation(tokenLines, state[0])) + ": I can't find a value named '" + name + "'")
    }
    let receiverType = localTypes[local]
    let receiver = loadLocal(output, textState, state, localIds[local], receiverType)
    state[0] = state[0] + 1
    let valueType: List<Integer> = []
    valueType.add(0)
    if state[0] == operatorPosition {
        state[0] = operatorPosition + 1
        let value = assignedValue(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, binary, receiver, receiverType, valueType, operatorLocation)
        if valueType[0] != receiverType {
            fail(describeLocation(tokenLocation(tokenLines, operatorLocation)) + ": an assignment to '" + name + "' has the wrong type")
        }
        assignReference(output, state, localIds[local], value, valueType)
        storeLocal(output, localIds[local], receiverType, value)
        return
    }
    let done = false
    while !done {
        if tokenTexts[state[0]] == "." {
            let member = tokenTexts[state[0] + 1]
            let memberLocation = state[0] + 1
            state[0] = state[0] + 2
            if !isRecordType(receiverType) {
                fail(describeLocation(tokenLocation(tokenLines, memberLocation)) + ": only record fields can be assigned, and " + describeType(receiverType) + " has no field named '" + member + "'")
            }
            let field = findRecordField(functionParameterCounts, functionParameterNames, receiverType, member)
            if field < 0 {
                fail(describeLocation(tokenLocation(tokenLines, memberLocation)) + ": record '" + readableDeclarationName(functionNames[receiverType - 1000]) + "' has no field named '" + member + "'")
            }
            checkFieldAccess(tokenLines, functionParameterNames[field], functionNames[receiverType - 1000], memberLocation)
            let fieldType = functionParameterTypes[field]
            let fieldIndex = field - functionParameterOffset(functionParameterCounts, receiverType - 1000)
            if state[0] == operatorPosition {
                state[0] = operatorPosition + 1
                if isReferenceType(fieldType) {
                    checkFieldMutation(receiverType, fieldType, functionParameterCounts, functionParameterTypes, tokenLines, memberLocation)
                }
                let current = ""
                if binary != "" {
                    current = readRecordField(output, textState, state, receiver, fieldIndex, fieldType)
                    borrowReference(output, state, current, fieldType)
                }
                let value = assignedValue(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, binary, current, fieldType, valueType, operatorLocation)
                if valueType[0] != fieldType {
                    fail(describeLocation(tokenLocation(tokenLines, operatorLocation)) + ": record field '" + member + "' needs " + describeType(fieldType) + ", not " + describeType(valueType[0]))
                }
                let slot = valueAsListSlot(output, textState, state, value, fieldType)
                if isReferenceType(fieldType) {
                    let transfers = "0"
                    if takeResult(output, state, value, valueType) {
                        transfers = "1"
                    }
                    output.add("  call void @minyar_record_replace(ptr ")
                    output.add(receiver)
                    output.add(", i64 ")
                    output.add(Text(fieldIndex))
                    output.add(", i64 ")
                    output.add(slot)
                    output.add(", i64 ")
                    output.add(transfers)
                    output.add(")\n")
                } else {
                    output.add("  call void @minyar_record_set_scalar(ptr ")
                    output.add(receiver)
                    output.add(", i64 ")
                    output.add(Text(fieldIndex))
                    output.add(", i64 ")
                    output.add(slot)
                    output.add(")\n")
                }
                done = true
            } else {
                receiver = readRecordField(output, textState, state, receiver, fieldIndex, fieldType)
                receiverType = fieldType
                borrowReference(output, state, receiver, receiverType)
            }
        } else {
            let bracketLocation = state[0]
            state[0] = state[0] + 1
            let positionType: List<Integer> = []
            positionType.add(0)
            let position = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, positionType)
            expectToken(tokenKinds, tokenTexts, tokenLines, state, "]")
            requireType(tokenLines, state, positionType[0], 1, "a position must be an Integer")
            if !isListType(receiverType) && receiverType != 8 {
                fail(describeLocation(tokenLocation(tokenLines, bracketLocation)) + ": indexed assignment needs a List or Bytes, not " + describeType(receiverType))
            }
            let elementType = 1
            if isListType(receiverType) {
                elementType = listElementType(receiverType)
            }
            if state[0] == operatorPosition {
                state[0] = operatorPosition + 1
                let current = ""
                if receiverType == 8 {
                    if binary != "" {
                        current = emitBytesRead(output, textState, state, receiver, position)
                    }
                    let value = assignedValue(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, binary, current, 1, valueType, operatorLocation)
                    requireType(tokenLines, state, valueType[0], 1, "a byte must be an Integer")
                    output.add("  call void @minyar_bytes_set(ptr ")
                    output.add(receiver)
                    output.add(", i64 ")
                    output.add(position)
                    output.add(", i64 ")
                    output.add(value)
                    output.add(")\n")
                } else {
                    checkListMutation(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    if binary != "" {
                        current = readListElement(output, textState, state, receiver, position, elementType)
                        borrowReference(output, state, current, elementType)
                    }
                    let value = assignedValue(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, binary, current, elementType, valueType, operatorLocation)
                    if valueType[0] != elementType {
                        fail(describeLocation(tokenLocation(tokenLines, operatorLocation)) + ": an indexed assignment needs " + describeType(elementType) + ", not " + describeType(valueType[0]))
                    }
                    let slot = valueAsListSlot(output, textState, state, value, elementType)
                    if takeResult(output, state, value, valueType) {
                        output.add("  call void @minyar_list_set_take(ptr ")
                    } else {
                        if isReferenceType(elementType) {
                            output.add("  call void @minyar_list_set(ptr ")
                        } else {
                            output.add("  call void @.minyar.list.set.scalar.checked(ptr ")
                        }
                    }
                    output.add(receiver)
                    output.add(", i64 ")
                    output.add(position)
                    output.add(", i64 ")
                    output.add(slot)
                    output.add(")\n")
                }
                done = true
            } else {
                if receiverType == 8 {
                    fail(describeLocation(tokenLocation(tokenLines, bracketLocation)) + ": a byte has no fields or positions to assign")
                }
                receiver = readListElement(output, textState, state, receiver, position, elementType)
                receiverType = elementType
                borrowReference(output, state, receiver, receiverType)
            }
        }
    }
}

function emitBytesRead(output: List<Text>, textState: List<Text>, state: List<Integer>, bytes: Text, position: Text): Text {
    let value = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(value)
    output.add(" = call i64 @minyar_bytes_get(ptr ")
    output.add(bytes)
    output.add(", i64 ")
    output.add(position)
    output.add(")\n")
    return value
}

// Loops push a marker into the lexical scope so break and continue find the
// innermost loop. Its name cannot be written in source; its type is -1 for
// while (-3 after a reachable break) and -2 for for; its id is the first label.
function findLoopMarker(localNames: List<Text>, localLengths: List<Integer>, state: List<Integer>): Integer {
    return findLocal(localNames, localLengths, state, " loop")
}

function compileLoopJump(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>) {
    let keyword = tokenTexts[state[0]]
    let marker = findLoopMarker(localNames, localLengths, state)
    if marker < 0 {
        fail(describeLocation(tokenLocation(tokenLines, state[0])) + ": '" + keyword + "' can only be used inside a loop")
    }
    state[0] = state[0] + 1
    let label = localIds[marker]
    if localTypes[marker] == -1 || localTypes[marker] == -3 {
        if keyword == "continue" {
            output.add("  call void @minyar_rc_step()\n")
            output.add("  br label %while.condition." + Text(label) + "\n")
        } else {
            if state[13] == 0 { localTypes[marker] = -3 }
            output.add("  br label %while.end." + Text(label + 2) + "\n")
        }
    } else {
        if keyword == "continue" {
            output.add("  br label %for.step." + Text(label + 2) + "\n")
        } else {
            output.add("  br label %for.end." + Text(label + 3) + "\n")
        }
    }
}

// for name in start..end iterates Integers; for name in collection visits each
// List element or Text character. Bounds and the collection are evaluated once;
// the loop variable is a fresh binding for each iteration.
function compileFor(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, returnType: Integer) {
    state[0] = state[0] + 1
    if tokenKinds[state[0]] != 1 {
        fail(describeLocation(tokenLocation(tokenLines, state[0])) + ": expected a name after for")
    }
    let name = tokenTexts[state[0]]
    state[0] = state[0] + 1
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "in")
    let firstLoopLocal = state[3]
    let sourceLocation = state[0]
    let sourceType: List<Integer> = []
    sourceType.add(0)
    let source = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, sourceType)
    let loopLabel = newLabel(state)
    let bodyLabel = newLabel(state)
    let stepLabel = newLabel(state)
    let endLabel = newLabel(state)
    let counter = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, " for counter", 1, counter)
    let limit = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, " for limit", 1, limit)
    let collection = -1
    let elementType = 1
    if tokenIs(tokenKinds, tokenTexts, state, "..") {
        requireType(tokenLines, state, sourceType[0], 1, "a range starts with an Integer")
        state[0] = state[0] + 1
        let endType: List<Integer> = []
        endType.add(0)
        let end = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, endType)
        requireType(tokenLines, state, endType[0], 1, "a range ends with an Integer")
        storeLocal(output, counter, 1, source)
        storeLocal(output, limit, 1, end)
    } else {
        if isListType(sourceType[0]) {
            elementType = listElementType(sourceType[0])
        } else {
            if sourceType[0] == 2 {
                elementType = 3
            } else {
                if sourceType[0] == 8 {
                    elementType = 1
                } else {
                    fail(describeLocation(tokenLocation(tokenLines, sourceLocation)) + ": for needs a range such as 0..count, a List, Text, or Bytes, not " + describeType(sourceType[0]))
                }
            }
        }
        collection = nextLocal(state)
        addLocal(localNames, localTypes, localIds, localLengths, state, " for collection", sourceType[0], collection)
        assignReference(output, state, collection, source, sourceType)
        storeLocal(output, collection, sourceType[0], source)
        storeLocal(output, counter, 1, "0")
    }
    output.add("  br label %for.condition." + Text(loopLabel) + "\n\nfor.condition." + Text(loopLabel) + ":\n")
    textState[0] = "for.condition." + Text(loopLabel)
    let position = loadLocal(output, textState, state, counter, 1)
    let bound = ""
    if collection < 0 {
        bound = loadLocal(output, textState, state, limit, 1)
    } else {
        let items = loadLocal(output, textState, state, collection, sourceType[0])
        let lengthFunction = "minyar_list_length"
        if sourceType[0] == 2 {
            lengthFunction = "minyar_text_length"
        }
        if sourceType[0] == 8 {
            lengthFunction = "minyar_bytes_length"
        }
        let arguments: List<Text> = []
        arguments.add(items)
        let argumentTypes: List<Integer> = []
        argumentTypes.add(sourceType[0])
        bound = emitCall(output, textState, state, 1, lengthFunction, arguments, argumentTypes)
    }
    let continuing = emitInstruction(output, textState, state, "icmp slt i64 " + position + ", " + bound)
    output.add("  br i1 " + continuing + ", label %for.body." + Text(bodyLabel) + ", label %for.end." + Text(endLabel) + "\n\nfor.body." + Text(bodyLabel) + ":\n")
    textState[0] = "for.body." + Text(bodyLabel)
    let element = position
    if collection >= 0 {
        let items = loadLocal(output, textState, state, collection, sourceType[0])
        if isListType(sourceType[0]) {
            element = readListElement(output, textState, state, items, position, elementType)
        } else {
            if sourceType[0] == 8 {
                element = emitBytesRead(output, textState, state, items, position)
            } else {
                element = valueName(textState, newTemporary(state))
                output.add("  " + element + " = call i32 @minyar_text_character_at(ptr " + items + ", i64 " + position + ")\n")
            }
        }
    }
    let variable = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, name, elementType, variable)
    let elementResult: List<Integer> = []
    elementResult.add(elementType)
    assignReference(output, state, variable, element, elementResult)
    storeLocal(output, variable, elementType, element)
    addLocal(localNames, localTypes, localIds, localLengths, state, " loop", -2, loopLabel)
    let bodyReturns = compileBlock(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType)
    if !bodyReturns {
        output.add("  br label %for.step." + Text(stepLabel) + "\n")
    }
    output.add("\nfor.step." + Text(stepLabel) + ":\n")
    textState[0] = "for.step." + Text(stepLabel)
    let current = loadLocal(output, textState, state, counter, 1)
    // The condition proved current < bound, so this increment cannot overflow.
    let next = emitInstruction(output, textState, state, "add nsw i64 " + current + ", 1")
    storeLocal(output, counter, 1, next)
    output.add("  call void @minyar_rc_step()\n")
    output.add("  br label %for.condition." + Text(loopLabel) + "\n\nfor.end." + Text(endLabel) + ":\n")
    textState[0] = "for.end." + Text(endLabel)
    let scoped = firstLoopLocal
    while scoped < state[3] {
        rootLocal(output, state, localIds[scoped], "null", localTypes[scoped])
        scoped = scoped + 1
    }
    state[3] = firstLoopLocal
}

function isNativeType(type: Integer): Boolean {
    return type == 1 || type == 2 || type == 3 || type == 4 || type == 7 || type == 8
}

function nativeType(type: Integer): Text {
    if type == 4 {
        return "i1 zeroext"
    }
    return llvmType(type)
}

// `native "library"` is the whole body of a standard library function. It
// forwards the parameters to the C function minyar_<library>_<name>, which
// borrows Text and Bytes arguments and returns owned references. The marker
// comment lets compileTokens declare the symbol and name the library to link.
function compileNative(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, returnType: Integer) {
    let location = state[0]
    let name = textState[1]
    if name == "top level" || name == "main" {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": native can only provide the body of a library function")
    }
    let library = tokenTexts[state[0] + 1]
    let after: List<Integer> = []
    after.add(state[0] + 2)
    skipTerminators(tokenKinds, after)
    if state[0] != state[12] || !tokenIs(tokenKinds, tokenTexts, after, "}") {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": native must be the only statement in its function")
    }
    let letter = 0
    let validLibrary = library.length > 0
    while letter < library.length {
        let character = library[letter]
        if !characterIsLetter(character) && !characterIsDigit(character) && character != '_' {
            validLibrary = false
        }
        letter = letter + 1
    }
    if !validLibrary {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": native library names must use ASCII letters, digits, and '_'")
    }
    state[0] = state[0] + 2
    let function = findFunction(functionNames, symbolKinds, functionReturnTypes, name)
    let count = functionParameterCounts[function]
    if state[3] != count {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": native must be the only statement in its function")
    }
    if library == "machine" || library == "machine_arm64" {
        let intrinsic = ""
        if library == "machine" {
            intrinsic = machineIntrinsic(readableDeclarationName(name))
        } else {
            intrinsic = machineIntrinsicArm64(readableDeclarationName(name))
        }
        if intrinsic == "" {
            fail(describeLocation(tokenLocation(tokenLines, location)) + ": the machine package has no intrinsic named '" + readableDeclarationName(name) + "'")
        }
        let split = findCharacter(intrinsic, '\n') + 1
        if intrinsic[2] == ';' {
            // A declaration marker must be its own piece for appendNativeDeclarations.
            output.add(intrinsic.slice(0, split))
            output.add(intrinsic.slice(split, intrinsic.length))
        } else {
            output.add(intrinsic)
        }
        return
    }
    let callee = "minyar_" + library + "_" + readableDeclarationName(name)
    let signature = ""
    let arguments = ""
    let parameter = 0
    while parameter < count {
        let type = localTypes[parameter]
        if !isNativeType(type) {
            fail(describeLocation(tokenLocation(tokenLines, location)) + ": native functions accept Integer, Float, Boolean, Character, Text, and Bytes, not " + describeType(type))
        }
        if parameter > 0 {
            signature = signature + ", "
            arguments = arguments + ", "
        }
        signature = signature + nativeType(type)
        arguments = arguments + nativeType(type) + " %argument." + Text(parameter)
        parameter = parameter + 1
    }
    if returnType != 5 && !isNativeType(returnType) {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": native functions return Nothing, Integer, Float, Boolean, Character, Text, or Bytes")
    }
    let result = llvmType(returnType)
    if returnType == 4 {
        result = "zeroext i1"
    }
    output.add("  ; minyar-native: " + library + "|declare " + result + " @" + callee + "(" + signature + ")\n")
    if returnType == 5 {
        output.add("  call void @" + callee + "(" + arguments + ")\n")
    } else {
        output.add("  %native.result = call " + result + " @" + callee + "(" + arguments + ")\n")
    }
    output.add("  call void @minyar_rc_leave()\n")
    output.add("  call void @minyar_stack_leave()\n")
    if returnType == 5 {
        output.add("  ret void\n")
    } else {
        output.add("  ret " + llvmType(returnType) + " %native.result\n")
    }
}

// The `machine` package gives freestanding programs direct access to memory,
// I/O ports and the processor. Its functions compile to these inline bodies,
// with no prologue, so each use costs the same as the instructions themselves.
// Arguments arrive as %argument.N; Integers are i64 and Bytes are pointers.
function machineIntrinsic(name: Text): Text {
    let result = machineMemoryIntrinsic(name, "8")
    if result == "" { result = machineMemoryIntrinsic(name, "16") }
    if result == "" { result = machineMemoryIntrinsic(name, "32") }
    if result == "" { result = machineMemoryIntrinsic(name, "64") }
    if result == "" { result = machinePortIntrinsic(name, "8", "al", "b") }
    if result == "" { result = machinePortIntrinsic(name, "16", "ax", "w") }
    if result == "" { result = machinePortIntrinsic(name, "32", "eax", "l") }
    if result == "" { result = machineInstruction(name, "pause", "pause") }
    if result == "" { result = machineInstruction(name, "halt", "hlt") }
    if result == "" { result = machineInstruction(name, "enableInterrupts", "sti") }
    if result == "" { result = machineInstruction(name, "disableInterrupts", "cli") }
    if result == "" { result = machineInstruction(name, "waitForInterrupt", "sti; hlt") }
    if result != "" { return result }
    let pointer = "  %address = inttoptr i64 %argument.0 to ptr\n"
    let clobbers = "~{dirflag},~{fpsr},~{flags}"
    if name == "fill8" {
        let declaration = "  ; minyar-native: machine|declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n"
        return declaration + pointer + "  %byte = trunc i64 %argument.2 to i8\n  call void @llvm.memset.p0.i64(ptr %address, i8 %byte, i64 %argument.1, i1 false)\n  ret void\n"
    }
    if name == "fill32" {
        let head = pointer + "  %word = trunc i64 %argument.2 to i32\n  %any = icmp sgt i64 %argument.1, 0\n  br i1 %any, label %fill, label %done\n"
        let loop = "fill:\n  %index = phi i64 [ 0, %entry ], [ %next, %fill ]\n  %slot = getelementptr i32, ptr %address, i64 %index\n"
        let tail = "  store i32 %word, ptr %slot, align 4\n  %next = add nuw nsw i64 %index, 1\n  %more = icmp slt i64 %next, %argument.1\n  br i1 %more, label %fill, label %done\ndone:\n  ret void\n"
        return head + loop + tail
    }
    if name == "copy" {
        let declaration = "  ; minyar-native: machine|declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)\n"
        let pointers = "  %destination = inttoptr i64 %argument.0 to ptr\n  %source = inttoptr i64 %argument.1 to ptr\n"
        return declaration + pointers + "  call void @llvm.memmove.p0.p0.i64(ptr %destination, ptr %source, i64 %argument.2, i1 false)\n  ret void\n"
    }
    if name == "address" {
        return "  %storage = load ptr, ptr %argument.0, align 8\n  %value = ptrtoint ptr %storage to i64\n  ret i64 %value\n"
    }
    if name == "fence" {
        return "  fence seq_cst\n  ret void\n"
    }
    if name == "timestamp" {
        return "  %value = call i64 asm sideeffect \"rdtsc; shlq $$32, %rdx; orq %rdx, %rax\", \"={rax},~{rdx}," + clobbers + "\"()\n  ret i64 %value\n"
    }
    if name == "loadInterruptTable" {
        let descriptor = "  %descriptor = alloca [16 x i8], align 8\n  %limit = trunc i64 %argument.1 to i16\n  store i16 %limit, ptr %descriptor, align 8\n"
        let base = "  %base = getelementptr i8, ptr %descriptor, i64 2\n  store i64 %argument.0, ptr %base, align 1\n"
        return descriptor + base + "  call void asm sideeffect \"lidt ($0)\", \"r,~{memory}," + clobbers + "\"(ptr %descriptor)\n  ret void\n"
    }
    if name == "interruptHandler" || name == "interruptCount" {
        let table = "minyar_interrupt_handlers"
        let load = "load i64"
        if name == "interruptCount" {
            table = "minyar_interrupt_counts"
            load = "load volatile i64"
        }
        let address = "  %table = call ptr asm \"leaq " + table + "(%rip), $0\", \"=r\"()\n  %slot = getelementptr i64, ptr %table, i64 %argument.0\n"
        return address + "  %value = " + load + ", ptr %slot, align 8\n  ret i64 %value\n"
    }
    if name == "blendSpan" {
        return machineBlendSpan()
    }
    if name == "blendMask" {
        return machineBlendMask()
    }
    if name == "coverage" {
        return machineCoverage()
    }
    if name == "atomicAdd" {
        return pointer + "  %old = atomicrmw add ptr %address, i64 %argument.1 seq_cst, align 8\n  ret i64 %old\n"
    }
    if name == "callEntry" {
        return "  %target = inttoptr i64 %argument.0 to ptr\n  call void %target(i64 %argument.1, i64 %argument.2)\n  ret void\n"
    }
    if name == "symbol" {
        let address = "  %table = call ptr asm \"leaq minyar_machine_symbols(%rip), $0\", \"=r\"()\n  %slot = getelementptr i64, ptr %table, i64 %argument.0\n"
        return address + "  %value = load i64, ptr %slot, align 8\n  ret i64 %value\n"
    }
    if name == "jump" {
        return "  %target = inttoptr i64 %argument.0 to ptr\n  call void %target(i64 %argument.1)\n  ret void\n"
    }
    if name == "hypervisorCall" {
        let inputs = "  %magic = add i32 1447909480, 0\n  %parameter = trunc i64 %argument.1 to i32\n  %command = trunc i64 %argument.0 to i32\n"
        let constraints = "\"={eax},={ebx},={ecx},={edx},{eax},{ebx},{ecx},{edx},~{memory}," + clobbers + "\""
        let call = "  %registers = call { i32, i32, i32, i32 } asm sideeffect \"inl %dx, %eax\", " + constraints + "(i32 %magic, i32 %parameter, i32 %command, i32 22104)\n"
        let stores = storeRegister(0) + storeRegister(1) + storeRegister(2) + storeRegister(3)
        return inputs + call + "  %results = inttoptr i64 %argument.2 to ptr\n" + stores + "  ret void\n"
    }
    return ""
}

// The same package for 64-bit Arm (library/arch/arm64/machine.min). Memory,
// atomics and pixel loops are the portable bodies above; processor
// instructions are Arm's. I/O ports, the x86 interrupt table and the VMware
// hypervisor call do not exist there: they compile, so portable packages that
// offer them still build, but stop the processor if they are ever reached.
function machineIntrinsicArm64(name: Text): Text {
    let barrier = "~{memory}"
    if name == "pause" { return armInstruction("yield") }
    if name == "halt" { return armInstruction("wfi") }
    if name == "enableInterrupts" { return armInstruction("msr daifclr, #2") }
    if name == "disableInterrupts" { return armInstruction("msr daifset, #2") }
    // Wait with interrupts masked (a pending one still wakes the processor),
    // then unmask so its handler runs: like x86's `sti; hlt`.
    if name == "waitForInterrupt" { return armInstruction("wfi; msr daifclr, #2") }
    if name == "timestamp" {
        return "  %value = call i64 asm sideeffect \"isb; mrs $0, cntvct_el0\", \"=r," + barrier + "\"()\n  ret i64 %value\n"
    }
    if name == "timerFrequency" {
        return "  %value = call i64 asm \"mrs $0, cntfrq_el0\", \"=r\"()\n  ret i64 %value\n"
    }
    if name == "interruptCount" { return armTableLoad("minyar_interrupt_counts", "load volatile i64") }
    if name == "symbol" { return armTableLoad("minyar_machine_symbols", "load i64") }
    if name == "firmwareCall" {
        // SMCCC through HVC: function in x0, arguments in x1-x3, result in x0.
        let clobbers = "~{x4},~{x5},~{x6},~{x7},~{x8},~{x9},~{x10},~{x11},~{x12},~{x13},~{x14},~{x15},~{x16},~{x17},~{memory}"
        let call = "  %registers = call { i64, i64, i64, i64 } asm sideeffect \"hvc #0\", \"={x0},={x1},={x2},={x3},0,1,2,3," + clobbers + "\"(i64 %argument.0, i64 %argument.1, i64 %argument.2, i64 %argument.3)\n"
        return call + "  %value = extractvalue { i64, i64, i64, i64 } %registers, 0\n  ret i64 %value\n"
    }
    if name == "loadInterruptTable" || name == "interruptHandler" || name == "hypervisorCall" || armPortIntrinsic(name) {
        return "  ; minyar-native: machine|declare void @llvm.trap()\n  call void @llvm.trap()\n  unreachable\n"
    }
    if name == "jump" || name == "callEntry" || name == "atomicAdd" || name == "fence" || name == "address" || name == "copy" || name == "fill8" || name == "fill32" || name == "blendSpan" || name == "blendMask" || name == "coverage" {
        return machineIntrinsic(name)
    }
    let memory = machineMemoryIntrinsic(name, "8")
    if memory == "" { memory = machineMemoryIntrinsic(name, "16") }
    if memory == "" { memory = machineMemoryIntrinsic(name, "32") }
    if memory == "" { memory = machineMemoryIntrinsic(name, "64") }
    return memory
}

function armInstruction(instruction: Text): Text {
    return "  call void asm sideeffect \"" + instruction + "\", \"~{memory}\"()\n  ret void\n"
}

function armPortIntrinsic(name: Text): Boolean {
    return name == "in8" || name == "in16" || name == "in32" || name == "out8" || name == "out16" || name == "out32"
}

// A word of a table the boot code defines, such as the interrupt counts.
function armTableLoad(table: Text, load: Text): Text {
    let address = "  %table = call ptr asm \"adrp $0, " + table + "\\0A\\09add $0, $0, :lo12:" + table + "\", \"=r\"()\n"
    return address + "  %slot = getelementptr i64, ptr %table, i64 %argument.0\n  %value = " + load + ", ptr %slot, align 8\n  ret i64 %value\n"
}

// Pixel blending loops, written without overflow checks so LLVM can
// vectorize them. Pixels are 0x00RRGGBB; red and blue blend in one 32-bit
// multiply and green in another, with opacities scaled to 0-256.
function blendPixel(pixel: Text, opacity: Text, colorRedBlue: Text, colorGreen: Text, out: Text): Text {
    let keep = "  %keep." + out + " = sub i32 256, " + opacity + "\n"
    let redBlue = "  %rb." + out + " = and i32 " + pixel + ", 16711935\n  %rbk." + out + " = mul i32 %rb." + out + ", %keep." + out + "\n"
    let redBlueColor = "  %rbc." + out + " = mul i32 " + colorRedBlue + ", " + opacity + "\n  %rbs." + out + " = add i32 %rbk." + out + ", %rbc." + out + "\n"
    let redBlueOut = "  %rbo." + out + " = lshr i32 %rbs." + out + ", 8\n  %rbm." + out + " = and i32 %rbo." + out + ", 16711935\n"
    let green = "  %g." + out + " = and i32 " + pixel + ", 65280\n  %gk." + out + " = mul i32 %g." + out + ", %keep." + out + "\n"
    let greenColor = "  %gc." + out + " = mul i32 " + colorGreen + ", " + opacity + "\n  %gs." + out + " = add i32 %gk." + out + ", %gc." + out + "\n"
    let greenOut = "  %go." + out + " = lshr i32 %gs." + out + ", 8\n  %gm." + out + " = and i32 %go." + out + ", 65280\n"
    return keep + redBlue + redBlueColor + redBlueOut + green + greenColor + greenOut + "  %" + out + " = or i32 %rbm." + out + ", %gm." + out + "\n"
}

// blendSpan(address, count, color, opacity): blend `count` pixels toward one
// color, opacity from 0 to 256.
function machineBlendSpan(): Text {
    let head = "  %base = inttoptr i64 %argument.0 to ptr\n  %color = trunc i64 %argument.2 to i32\n  %opacity = trunc i64 %argument.3 to i32\n"
    let colors = "  %crb = and i32 %color, 16711935\n  %cg = and i32 %color, 65280\n  %any = icmp sgt i64 %argument.1, 0\n  br i1 %any, label %blend, label %done\n"
    let loop = "blend:\n  %index = phi i64 [ 0, %entry ], [ %next, %blend ]\n  %slot = getelementptr i32, ptr %base, i64 %index\n  %pixel = load i32, ptr %slot, align 4\n"
    let tail = "  store i32 %result, ptr %slot, align 4\n  %next = add i64 %index, 1\n  %more = icmp slt i64 %next, %argument.1\n  br i1 %more, label %blend, label %done\ndone:\n  ret void\n"
    return head + colors + loop + blendPixel("%pixel", "%opacity", "%crb", "%cg", "result") + tail
}

// blendMask(address, count, mask, color, scale, bias, limit): blend `count`
// pixels toward `color`, each through the byte at the same place in `mask`:
// opacity = min(mask + bias, limit) * scale / 256, so a coverage mask uses
// bias 0 and limit 255, and scale 256 for full strength.
function machineBlendMask(): Text {
    let head = "  %base = inttoptr i64 %argument.0 to ptr\n  %mask = inttoptr i64 %argument.2 to ptr\n  %color = trunc i64 %argument.3 to i32\n"
    let parameters = "  %scale = trunc i64 %argument.4 to i32\n  %bias = trunc i64 %argument.5 to i32\n  %limit = trunc i64 %argument.6 to i32\n"
    let colors = "  %crb = and i32 %color, 16711935\n  %cg = and i32 %color, 65280\n  %any = icmp sgt i64 %argument.1, 0\n  br i1 %any, label %blend, label %done\n"
    let loop = "blend:\n  %index = phi i64 [ 0, %entry ], [ %next, %blend ]\n  %slot = getelementptr i32, ptr %base, i64 %index\n  %pixel = load i32, ptr %slot, align 4\n"
    let cover = "  %coverSlot = getelementptr i8, ptr %mask, i64 %index\n  %cover8 = load i8, ptr %coverSlot, align 1\n  %cover = zext i8 %cover8 to i32\n"
    let opacity = "  %biased = add i32 %cover, %bias\n  %capped = call i32 @llvm.umin.i32(i32 %biased, i32 %limit)\n  %scaled = mul i32 %capped, %scale\n  %raw = lshr i32 %scaled, 8\n  %round = lshr i32 %raw, 7\n  %opacity = add i32 %raw, %round\n"
    let tail = "  store i32 %result, ptr %slot, align 4\n  %next = add i64 %index, 1\n  %more = icmp slt i64 %next, %argument.1\n  br i1 %more, label %blend, label %done\ndone:\n  ret void\n"
    let declaration = "  ; minyar-native: machine|declare i32 @llvm.umin.i32(i32, i32)\n"
    return declaration + head + parameters + colors + loop + cover + opacity + blendPixel("%pixel", "%opacity", "%crb", "%cg", "result") + tail
}

// coverage(source, target, count): the running sum of `count` float32 signed
// areas at `source`, as coverage bytes 0-255 at `target` (the last step of
// filling an outline).
function machineCoverage(): Text {
    let head = "  %source = inttoptr i64 %argument.0 to ptr\n  %target = inttoptr i64 %argument.1 to ptr\n  %any = icmp sgt i64 %argument.2, 0\n  br i1 %any, label %cover, label %done\n"
    let loop = "cover:\n  %index = phi i64 [ 0, %entry ], [ %next, %cover ]\n  %sum = phi double [ 0.0, %entry ], [ %total, %cover ]\n"
    let add = "  %slot = getelementptr float, ptr %source, i64 %index\n  %narrow = load float, ptr %slot, align 4\n  %delta = fpext float %narrow to double\n  %total = fadd double %sum, %delta\n"
    let magnitude = "  %negated = fneg double %total\n  %below = fcmp olt double %total, 0.0\n  %magnitude = select i1 %below, double %negated, double %total\n"
    let scale = magnitude + "  %over = fcmp ogt double %magnitude, 1.0\n  %capped = select i1 %over, double 1.0, double %magnitude\n  %scaled = fmul double %capped, 255.0\n  %rounded = fadd double %scaled, 0.5\n  %byte = fptoui double %rounded to i8\n"
    let tail = "  %out = getelementptr i8, ptr %target, i64 %index\n  store i8 %byte, ptr %out, align 1\n  %next = add i64 %index, 1\n  %more = icmp slt i64 %next, %argument.2\n  br i1 %more, label %cover, label %done\ndone:\n  ret void\n"
    return head + loop + add + scale + tail
}

function machineMemoryIntrinsic(name: Text, width: Text): Text {
    let type = "i" + width
    let pointer = "  %address = inttoptr i64 %argument.0 to ptr\n"
    let extend = "  %value = zext " + type + " %loaded to i64\n"
    let narrow = "  %narrow = trunc i64 %argument.1 to " + type + "\n"
    if width == "64" {
        extend = "  %value = add i64 %loaded, 0\n"
        narrow = "  %narrow = add i64 %argument.1, 0\n"
    }
    if name == "load" + width {
        return pointer + "  %loaded = load " + type + ", ptr %address, align 1\n" + extend + "  ret i64 %value\n"
    }
    if name == "read" + width {
        return pointer + "  %loaded = load volatile " + type + ", ptr %address, align 1\n" + extend + "  ret i64 %value\n"
    }
    if name == "store" + width {
        return pointer + narrow + "  store " + type + " %narrow, ptr %address, align 1\n  ret void\n"
    }
    if name == "write" + width {
        return pointer + narrow + "  store volatile " + type + " %narrow, ptr %address, align 1\n  ret void\n"
    }
    return ""
}

function machinePortIntrinsic(name: Text, width: Text, register: Text, suffix: Text): Text {
    let type = "i" + width
    let clobbers = "~{dirflag},~{fpsr},~{flags}"
    if name == "in" + width {
        let call = "  %loaded = call " + type + " asm sideeffect \"in" + suffix + " $1, $0\", \"={" + register + "},{dx}," + clobbers + "\"(i16 %port)\n"
        return "  %port = trunc i64 %argument.0 to i16\n" + call + "  %value = zext " + type + " %loaded to i64\n  ret i64 %value\n"
    }
    if name == "out" + width {
        let values = "  %port = trunc i64 %argument.0 to i16\n  %narrow = trunc i64 %argument.1 to " + type + "\n"
        return values + "  call void asm sideeffect \"out" + suffix + " $0, $1\", \"{" + register + "},{dx}," + clobbers + "\"(" + type + " %narrow, i16 %port)\n  ret void\n"
    }
    return ""
}

function machineInstruction(name: Text, expected: Text, instruction: Text): Text {
    if name != expected { return "" }
    return "  call void asm sideeffect \"" + instruction + "\", \"~{memory},~{dirflag},~{fpsr},~{flags}\"()\n  ret void\n"
}

function storeRegister(index: Integer): Text {
    let number = Text(index)
    let extract = "  %register." + number + " = extractvalue { i32, i32, i32, i32 } %registers, " + number + "\n"
    let widen = "  %wide." + number + " = zext i32 %register." + number + " to i64\n"
    let slot = "  %slot." + number + " = getelementptr i64, ptr %results, i64 " + number + "\n"
    return extract + widen + slot + "  store i64 %wide." + number + ", ptr %slot." + number + ", align 8\n"
}

// A parallel function may run on any processor at the same time as others, so
// it must not touch the single-threaded runtime: no reference values, no
// call-depth or ownership frames, and calls only to other parallel functions,
// machine intrinsics, checked-arithmetic helpers and mathematics. Its frames
// are removed here; its calls are recorded for checkParallelCalls.
function finishParallelFunction(output: List<Text>, globals: List<Text>, entrySlot: Integer, bodySlot: Integer, name: Text, references: Boolean) {
    if references {
        fail("parallel function '" + readableDeclarationName(name) + "' may use only Integer, Float, Boolean and Character values")
    }
    let entry = output[entrySlot]
    let enter = "  call void @minyar_stack_enter()\n"
    if entry.length >= enter.length && entry.slice(0, enter.length) == enter {
        output[entrySlot] = entry.slice(enter.length, entry.length)
    }
    let body: List<Text> = []
    let piece = bodySlot
    while piece < output.length {
        let text = output[piece]
        if text == "  call void @minyar_stack_leave()\n" || text == "  call void @minyar_rc_leave()\n" || text == "  call void @minyar_rc_step()\n" {
            output[piece] = ""
        } else {
            body.add(text)
        }
        piece = piece + 1
    }
    // Instructions are emitted in pieces; scan the whole body as one text.
    let text = joinText(body)
    let position = 0
    while position + 8 < text.length {
        if text[position] == '@' && text.slice(position, position + 8) == "@minyar_" {
            let end = position + 8
            while end < text.length && text[end] != '(' && text[end] != ' ' { end = end + 1 }
            let callee = text.slice(position + 1, end)
            if !parallelRuntimeAllowed(callee) {
                fail("parallel function '" + readableDeclarationName(name) + "' cannot use the runtime ('" + callee + "')")
            }
        }
        if text[position] == '@' && position + 12 < text.length && text.slice(position, position + 12) == "@.minyar.fn." {
            let end = position + 12
            while end < text.length && text[end] != '(' && text[end] != ' ' { end = end + 1 }
            globals.add("; minyar-parallel-call: " + name + "|" + text.slice(position + 12, end) + "\n")
        }
        position = position + 1
    }
}

// Runtime functions that are safe on any processor: failures that stop the
// machine, and pure mathematics.
function parallelRuntimeAllowed(callee: Text): Boolean {
    if callee.length > 11 && callee.slice(0, 11) == "minyar_fail" { return true }
    return callee == "minyar_tan" || callee == "minyar_asin" || callee == "minyar_acos" || callee == "minyar_atan" || callee == "minyar_atan2"
}

function markerValue(marker: Text, prefix: Text): Text {
    return marker.slice(prefix.length, marker.length - 1)
}

// Every function a parallel function calls must itself be parallel or a
// machine intrinsic; every parallelEntry must name a parallel function.
function checkParallelCalls(globals: List<Text>) {
    let callPrefix = "; minyar-parallel-call: "
    let entryPrefix = "; minyar-parallel-entry: "
    let index = 0
    while index < globals.length {
        let marker = globals[index]
        let callee = ""
        let caller = ""
        if marker.length > callPrefix.length && marker.slice(0, callPrefix.length) == callPrefix {
            let pair = markerValue(marker, callPrefix)
            let separator = findCharacter(pair, '|')
            caller = pair.slice(0, separator)
            callee = pair.slice(separator + 1, pair.length)
        }
        if marker.length > entryPrefix.length && marker.slice(0, entryPrefix.length) == entryPrefix {
            callee = markerValue(marker, entryPrefix)
        }
        if callee != "" {
            let parallel = findText(globals, "; minyar-parallel: " + callee + "\n") >= 0
            let machine = findText(globals, "; minyar-machine: " + callee + "\n") >= 0
            if !parallel && !(machine && caller != "") {
                if caller == "" {
                    fail("parallelEntry needs a parallel function, and '" + readableDeclarationName(callee) + "' is not one")
                }
                fail("parallel function '" + readableDeclarationName(caller) + "' can only call parallel functions, not '" + readableDeclarationName(callee) + "'")
            }
        }
        index = index + 1
    }
}

function appendNativeDeclarations(output: List<Text>) {
    let marker = "  ; minyar-native: "
    let libraries: List<Text> = []
    let declarations: List<Text> = []
    let symbols: List<Text> = []
    let runtimeSymbols: List<Text> = []
    let count = output.length
    let piece = 0
    while piece < count {
        let text = output[piece]
        // Read the emitted ABI catalog, including the newline before its first
        // declaration and bounded-owner declarations appended after bodies.
        let start = 0
        while start < text.length && text[start] == '\n' { start = start + 1 }
        if text.length >= start + 8 && text[start] == 'd' && text.slice(start, start + 8) == "declare " {
            runtimeSymbols.add(text.slice(findCharacter(text, '@') + 1, findCharacter(text, '(')))
        }
        if text.length > marker.length && text[2] == ';' && text.slice(0, marker.length) == marker {
            let body = text.slice(marker.length, text.length - 1)
            let separator = findCharacter(body, '|')
            let library = body.slice(0, separator)
            let declaration = body.slice(separator + 1, body.length)
            let symbol = declaration.slice(findCharacter(declaration, '@') + 1, findCharacter(declaration, '('))
            let existing = findText(symbols, symbol)
            if existing >= 0 && declarations[existing] != declaration {
                fail("native symbol has conflicting function signatures: '" + symbol + "'")
            }
            if findText(libraries, library) < 0 {
                libraries.add(library)
            }
            if findText(declarations, declaration) < 0 {
                declarations.add(declaration)
                symbols.add(symbol)
            }
        }
        piece = piece + 1
    }
    piece = 0
    while piece < declarations.length {
        if findText(runtimeSymbols, symbols[piece]) >= 0 {
            fail("native symbol conflicts with a runtime function: '" + symbols[piece] + "'")
        }
        output.add(declarations[piece] + "\n")
        piece = piece + 1
    }
    piece = 0
    while piece < libraries.length {
        output.add("; minyar-native-library: " + libraries[piece] + "\n")
        piece = piece + 1
    }
}

function compileBlock(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, returnType: Integer): Boolean {
    return compileStatementSequence(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType, true)
}

function compileStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, returnType: Integer): Boolean {
    if tokenIs(tokenKinds, tokenTexts, state, "if") || tokenIs(tokenKinds, tokenTexts, state, "while") {
        return compileStatementSequence(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType, false)
    }
    return compileAtomicStatement(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType)
}

function compileAtomicStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, returnType: Integer): Boolean {
    let returns = false
    let referenceEffects = state[7]
    if tokenIs(tokenKinds, tokenTexts, state, "else") {
        fail(describeLocation(tokenLocation(tokenLines, state[0])) + ": 'else' needs a preceding if branch")
    }
    if tokenIs(tokenKinds, tokenTexts, state, "native") && tokenKinds[state[0] + 1] == 3 {
        compileNative(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, returnType)
        return true
    }
    if tokenIs(tokenKinds, tokenTexts, state, "let") {
        state[0] = state[0] + 1
        if tokenKinds[state[0]] != 1 {
            fail(describeLocation(tokenLocation(tokenLines, state[0])) + ": expected a name after let")
        }
        let name = tokenTexts[state[0]]
        let nameLocation = state[0]
        state[0] = state[0] + 1
        let declaredType = 0
        if tokenIs(tokenKinds, tokenTexts, state, ":") {
            state[0] = state[0] + 1
            declaredType = takeType(tokenKinds, tokenTexts, tokenLines, state, functionNames, symbolKinds)
        }
        expectToken(tokenKinds, tokenTexts, tokenLines, state, "=")
        if tokenKinds[state[0]] == 1 && state[0] + 1 < tokenTexts.length && tokenTexts[state[0] + 1] == "{" {
            prepareScalarRecord(tokenKinds, tokenTexts, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterTypes, state, name)
        }
        let valueType: List<Integer> = []
        valueType.add(declaredType)
        let value = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, valueType)
        if valueType[0] == 100000 {
            if !isListType(declaredType) {
                fail("an empty List needs a type, such as List<Text>")
            }
            valueType[0] = declaredType
            if isReferenceType(listElementType(declaredType)) {
                output.add("  call void @minyar_list_references(ptr ")
                output.add(value)
                output.add(")\n")
            }
        }
        if declaredType != 0 && declaredType != valueType[0] {
            fail(describeLocation(tokenLocation(tokenLines, nameLocation)) + ": the value for '" + name + "' does not match its declared type")
        }
        let type = valueType[0]
        if type == 5 || type == 6 {
            fail("Nothing cannot be stored in a binding")
        }
        let id = nextLocal(state)
        addLocal(localNames, localTypes, localIds, localLengths, state, name, type, id)
        assignReference(output, state, id, value, valueType)
        output.add("  store ")
        output.add(llvmType(type))
        output.add(" ")
        output.add(value)
        output.add(", ptr %local.")
        output.add(Text(id))
        output.add("\n")
    } else {
        if tokenIs(tokenKinds, tokenTexts, state, "return") {
            if textState[1] == "top level" {
                fail(describeLocation(tokenLocation(tokenLines, state[0])) + ": use exit(status) to finish a top-level program")
            }
            state[0] = state[0] + 1
            let valueType: List<Integer> = []
            valueType.add(returnType)
            let value = ""
            if tokenKinds[state[0]] != 6 && !tokenIs(tokenKinds, tokenTexts, state, "}") {
                value = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, valueType)
            } else {
                setType(valueType, 5)
            }
            if valueType[0] != returnType {
                fail("a returned value has the wrong type")
            }
            if isReferenceType(valueType[0]) && !takeResult(output, state, value, valueType) {
                output.add("  call void @minyar_rc_retain(ptr ")
                output.add(value)
                output.add(")\n")
            }
            output.add("  call void @minyar_rc_leave()\n")
            output.add("  call void @minyar_stack_leave()\n")
            if textState[1] == "main" {
                let temporary = newTemporary(state)
                output.add("  %value.")
                output.add(Text(temporary))
                output.add(" = trunc i64 ")
                output.add(value)
                output.add(" to i32\n")
                output.add("  ret i32 %value.")
                output.add(Text(temporary))
                output.add("\n")
            } else {
                output.add("  ret ")
                output.add(llvmType(valueType[0]))
                output.add(" ")
                output.add(value)
                output.add("\n")
            }
            returns = true
        } else {

                if tokenIs(tokenKinds, tokenTexts, state, "for") && tokenKinds[state[0] + 1] == 1 && tokenTexts[state[0] + 2] == "in" {
                    compileFor(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType)
                } else {
                if (tokenIs(tokenKinds, tokenTexts, state, "break") || tokenIs(tokenKinds, tokenTexts, state, "continue")) && (tokenKinds[state[0] + 1] == 6 || tokenTexts[state[0] + 1] == "}") {
                    compileLoopJump(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output)
                    returns = true
                } else {

                    if tokenKinds[state[0]] == 1 && tokenTexts[state[0] + 1] == "=" {
                        let name = tokenTexts[state[0]]
                        let local = findLocal(localNames, localLengths, state, name)
                        if local < 0 {
                            fail("I can't find a value named '" + name + "'")
                        }
                        state[0] = state[0] + 2
                        let valueType: List<Integer> = []
                        valueType.add(localTypes[local])
                        // For x = x + e, transfer x's local owner into the
                        // consuming Text join. Runtime uniqueness still guards
                        // in-place growth; aliases take the copying fallback.
                        if localTypes[local] == 2 && tokenKinds[state[0]] == 1 && tokenTexts[state[0]] == name && tokenTexts[state[0] + 1] == "+" {
                            valueType.add(-1)
                            valueType.add(localIds[local])
                            valueType.add(state[0])
                        }
                        let value = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, valueType)
                        if valueType[0] != localTypes[local] {
                            fail("an assignment to '" + name + "' has the wrong type")
                        }
                        assignReference(output, state, localIds[local], value, valueType)
                        output.add("  store ")
                        output.add(llvmType(valueType[0]))
                        output.add(" ")
                        output.add(value)
                        output.add(", ptr %local.")
                        output.add(Text(localIds[local]))
                        output.add("\n")
                    } else {
                        let assignmentOperator = assignmentOperatorPosition(tokenKinds, tokenTexts, state[0])
                        if assignmentOperator >= 0 {
                            compileAssignment(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, assignmentOperator)
                        } else {
                            let ignoredType: List<Integer> = []
                            ignoredType.add(0)
                            let ignored = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, ignoredType)
                            if ignoredType[0] == 6 {
                                output.add("  unreachable\n")
                                returns = true
                            }
                        }
                        }

                    }
                }

        }
    }
    if !returns && state[7] != referenceEffects {
        output.add("  call void @minyar_rc_step()\n")
    }
    return returns
}

// Parameter bindings that are never assigned retain their incoming SSA value.
// Scan the body once; same-name assignments in nested scopes conservatively
// disable replacement. List element writes do not change the binding itself.
// Limit name matching to 64 parameters so extra analysis remains linear.
function markAssignedParameters(tokenKinds: List<Integer>, tokenTexts: List<Text>, start: Integer, names: List<Text>, types: List<Integer>) {
    let count = names.length
    let parameter = 0
    while parameter < count {
        if count > 64 { types.add(1) } else { types.add(0) }
        parameter = parameter + 1
    }
    if count == 0 || count > 64 { return }
    let position = start
    let depth = 0
    let done = false
    while tokenKinds[position] != 0 && !done {
        if tokenKinds[position] == 1 && tokenKinds[position + 1] == 4 && isAssignmentOperator(tokenTexts[position + 1]) {
            parameter = 0
            while parameter < count {
                if tokenTexts[position] == names[parameter] { types[count + parameter] = 1 }
                parameter = parameter + 1
            }
        }
        if tokenKinds[position] == 4 {
            if tokenTexts[position] == "{" { depth = depth + 1 }
            if tokenTexts[position] == "}" {
                depth = depth - 1
                if depth == 0 { done = true }
            }
        }
        position = position + 1
    }
}

function compileFunctions(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, output: List<Text>, globals: List<Text>, stackOwnerLimit: Integer): Boolean {
    let state: List<Integer> = []
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(-1)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(1)
    state.add(-1)
    state.add(0)
    state.add(-1)
    state.add(0)
    let hasNative = false
    let textState: List<Text> = []
    textState.add("entry")
    textState.add("")

    skipTerminators(tokenKinds, state)
    while tokenKinds[state[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, state, "record") {
            skipDeclaration(tokenKinds, tokenTexts, state)
        } else {
        if tokenIs(tokenKinds, tokenTexts, state, "function") {
        expectToken(tokenKinds, tokenTexts, tokenLines, state, "function")
        let name = tokenTexts[state[0]]
        state[0] = state[0] + 1
        textState[1] = name
        expectToken(tokenKinds, tokenTexts, tokenLines, state, "(")
        let parameterNames: List<Text> = []
        let parameterTypes: List<Integer> = []
        while !tokenIs(tokenKinds, tokenTexts, state, ")") {
            parameterNames.add(tokenTexts[state[0]])
            state[0] = state[0] + 1
            expectToken(tokenKinds, tokenTexts, tokenLines, state, ":")
            parameterTypes.add(takeType(tokenKinds, tokenTexts, tokenLines, state, functionNames, symbolKinds))
            if tokenIs(tokenKinds, tokenTexts, state, ",") {
                state[0] = state[0] + 1
            }
        }
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        let returnType = 5
        if name == "main" {
            returnType = 1
        }
        if tokenIs(tokenKinds, tokenTexts, state, ":") {
            state[0] = state[0] + 1
            returnType = takeType(tokenKinds, tokenTexts, tokenLines, state, functionNames, symbolKinds)
        }

        markAssignedParameters(tokenKinds, tokenTexts, state[0], parameterNames, parameterTypes)
        // Remember the exact first statement for native whole-body validation.
        state[12] = state[0] + 1
        while tokenKinds[state[12]] == 6 { state[12] = state[12] + 1 }
        let machineIntrinsic = false
        if tokenKinds[state[12]] == 1 && tokenTexts[state[12]] == "native" && tokenKinds[state[12] + 1] == 3 {
            hasNative = true
            machineIntrinsic = tokenTexts[state[12] + 1] == "machine" || tokenTexts[state[12] + 1] == "machine_arm64"
        }
        if machineIntrinsic {
            globals.add("; minyar-machine: " + name + "\n")
        }
        let parallel = findText(globals, "; minyar-parallel: " + name + "\n") >= 0
        state[1] = 0
        state[2] = 0
        state[3] = 0
        state[4] = parameterNames.length
        state[6] = 0
        state[7] = 0
        state[8] = 0
        state[9] = state[9] + 1
        state[10] = -1
        state[11] = 0
        state[13] = 0
        // Only parseCall writes a resolved user-function index into this cache.
        // Reset it per body in bounded mode: -1 at finish proves no user call.
        // Ordinary mode retains its existing cross-body cache behavior.
        if stackOwnerLimit > 0 { state[5] = -1 }
        textState[0] = "entry"
        let localNames: List<Text> = []
        let localTypes: List<Integer> = []
        let localIds: List<Integer> = []
        let localLengths: List<Integer> = []

        let emittedReturn = llvmType(returnType)
        if name == "main" {
            emittedReturn = "i32"
        }
        let defineSlot = output.length
        output.add("define ")
        output.add(emittedReturn)
        if name == "main" || name[0] == '"' {
            output.add(" @")
        } else {
            output.add(" @.minyar.fn.")
        }
        output.add(name)
        output.add("(")
        if name == "main" {
            output.add("i32 %minyar.argument.count, ptr %minyar.argument.values")
        } else {
            let parameter = 0
            while parameter < parameterNames.length {
                if parameter > 0 {
                    output.add(", ")
                }
                output.add(llvmType(parameterTypes[parameter]))
                output.add(" ")
                let id = parameter
                if parameterTypes[parameterNames.length + parameter] == 0 {
                    id = -output.length - 1
                }
                parameterTypes[parameterNames.length + parameter] = id
                output.add("%argument." + Text(parameter))
                parameter = parameter + 1
            }
        }
        let definitionTailSlot = output.length
        output.add(") {\nentry:\n")
        let entrySlot = output.length
        output.add("")
        if name == "main" {
            output.add("  call void @minyar_initialize_arguments(i32 %minyar.argument.count, ptr %minyar.argument.values)\n")
        }
        let parameter = 0
        while parameter < parameterNames.length {
            let id = parameterTypes[parameterNames.length + parameter]
            addLocal(localNames, localTypes, localIds, localLengths, state, parameterNames[parameter], parameterTypes[parameter], id)
            if id >= 0 {
            // Synchronous calls borrow arguments protected by the caller. The
            // ownership slot starts null; assignment establishes a local owner.
            output.add("  %local.")
            output.add(Text(parameter))
            output.add(" = alloca ")
            output.add(llvmType(parameterTypes[parameter]))
            output.add("\n")
            output.add("  store ")
            output.add(llvmType(parameterTypes[parameter]))
            output.add(" %argument.")
            output.add(Text(parameter))
            output.add(", ptr %local.")
            output.add(Text(parameter))
            output.add("\n")
            }
            parameter = parameter + 1
        }
        let bodyStart = state[0]
        let bodySlot = output.length
        let returns = compileBlock(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType)
        if !returns {
            output.add("  call void @minyar_rc_leave()\n")
            output.add("  call void @minyar_stack_leave()\n")
            if name == "main" {
                output.add("  ret i32 0\n")
            } else {
                if returnType == 5 {
                    output.add("  ret void\n")
                } else {
                    fail("function '" + readableDeclarationName(name) + "' must return a value on every path")
                }
            }
        }
        // A label budget bounds LLVM's constant-call cloning cost. It counts
        // reserved labels too; ordinary functions remain inline-eligible.
        if state[2] >= 4096 {
            output[definitionTailSlot] = ") noinline {\nentry:\n"
            if returnType == 1 && parameterNames.length == 1 && parameterTypes[0] == 1 && parameterTypes[1] < 0 {
                let dispatchTable = "@.dispatch." + Text(bodyStart)
                lowerIntegerDispatch(tokenKinds, tokenTexts, tokenLines, bodyStart, state[0], parameterNames[0], output, globals, bodySlot, dispatchTable)
            }
        }
        finishFunctionEntry(output, entrySlot, state[4], parameterNames.length, state[8], state[6] == 1)
        if parallel {
            finishParallelFunction(output, globals, entrySlot, bodySlot, name, state[6] == 1)
        }
        if machineIntrinsic {
            // Intrinsic bodies are bare instructions: no call-depth or ownership frame.
            output[entrySlot] = ""
            output[defineSlot] = "define internal "
            output[definitionTailSlot] = ") alwaysinline {\nentry:\n"
        }
        if stackOwnerLimit > 0 && name != "main" && state[5] == -1 && state[6] == 1 && state[8] >= 1 && state[8] <= stackOwnerLimit {
            finishStackOwnership(output, entrySlot, state[8])
        }
        output.add("}\n\n")
        } else {
            skipTopLevelStatement(tokenKinds, tokenTexts, state)
        }
        }
        skipTerminators(tokenKinds, state)
    }
    return hasNative
}

function compileTopLevel(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, output: List<Text>, globals: List<Text>) {
    let state: List<Integer> = []
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(-1)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(1)
    state.add(-1)
    state.add(0)
    state.add(-1)
    state.add(0)
    let textState: List<Text> = []
    textState.add("entry")
    textState.add("top level")
    let localNames: List<Text> = []
    let localTypes: List<Integer> = []
    let localIds: List<Integer> = []
    let localLengths: List<Integer> = []

    output.add("define i32 @main(i32 %minyar.argument.count, ptr %minyar.argument.values) {\nentry:\n")
    let entrySlot = output.length
    output.add("")
    output.add("  call void @minyar_initialize_arguments(i32 %minyar.argument.count, ptr %minyar.argument.values)\n")

    skipTerminators(tokenKinds, state)
    let terminated = false
    while tokenKinds[state[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, state, "record") || tokenIs(tokenKinds, tokenTexts, state, "function") {
            skipDeclaration(tokenKinds, tokenTexts, state)
        } else {
            if tokenIs(tokenKinds, tokenTexts, state, "constant") {
                skipTopLevelStatement(tokenKinds, tokenTexts, state)
            } else {
            if terminated {
                textState[0] = "dead." + Text(newLabel(state))
            output.add("\n" + textState[0] + ":\n")
            }
            terminated = compileStatement(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, globals, 1)
            if terminated { state[13] = 1 }
            finishStatement(tokenKinds, tokenTexts, tokenLines, state)
            }
        }
        skipTerminators(tokenKinds, state)
    }
    if !terminated {
        output.add("  call void @minyar_rc_leave()\n")
        output.add("  call void @minyar_stack_leave()\n")
        output.add("  ret i32 0\n")
    }
    finishFunctionEntry(output, entrySlot, state[4], 0, state[8], state[6] == 1)
    output.add("}\n\n")
}

function compileTokens(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, scannedStarts: List<Integer>, scannedEnds: List<Integer>, stackOwnerLimit: Integer): Text {
    // `parallel function` marks a function that may run on any processor. The
    // modifier becomes a line break so every later pass sees an ordinary
    // function; the names travel to compileFunctions as markers in `globals`.
    let parallelMarkers: List<Text> = []
    let scan = 0
    while scan + 2 < tokenKinds.length {
        if tokenKinds[scan] == 6 && tokenTexts[scan] == "parallel" && tokenKinds[scan + 1] == 1 && tokenTexts[scan + 1] == "function" {
            parallelMarkers.add("; minyar-parallel: " + tokenTexts[scan + 2] + "\n")
        }
        if scan + 3 < tokenKinds.length && tokenKinds[scan] == 6 && tokenTexts[scan] == "parallel" && tokenTexts[scan + 1] == "public" && tokenTexts[scan + 2] == "function" {
            parallelMarkers.add("; minyar-parallel: " + tokenTexts[scan + 3] + "\n")
        }
        scan = scan + 1
    }
    let functionNames: List<Text> = []
    let symbolKinds: List<Integer> = []
    let symbolLocations: List<Text> = []
    let functionReturnTypes: List<Integer> = []
    let functionParameterCounts: List<Integer> = []
    let functionParameterNames: List<Text> = []
    let functionParameterTypes: List<Integer> = []
    let declarationEnds: List<Integer> = []
    let topLevelStatements = false
    if scannedStarts.length > 0 {
        topLevelStatements = recordScannedDeclarations(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds, functionNames, symbolKinds, symbolLocations, functionReturnTypes, functionParameterCounts, declarationEnds)
    } else {
        topLevelStatements = discoverRecordNames(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, symbolLocations, functionReturnTypes, functionParameterCounts, declarationEnds)
    }
    let symbolLookup = buildSymbolLookup(functionNames, symbolKinds)
    requireUniqueSymbols(symbolLookup, functionNames, symbolKinds, symbolLocations)
    let parameterStarts: List<Integer> = []
    let recordIndex = 0
    while recordIndex < functionNames.length {
        parameterStarts.add(0)
        recordIndex = recordIndex + 1
    }
    discoverDeclarations(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, symbolLocations, functionReturnTypes, symbolLookup, functionParameterCounts, functionParameterNames, functionParameterTypes, parameterStarts, declarationEnds)
    appendParameterOffsets(functionParameterCounts, parameterStarts)
    symbolLookup = buildSymbolLookup(functionNames, symbolKinds)
    requireUniqueSymbols(symbolLookup, functionNames, symbolKinds, symbolLocations)
    let lookupPosition = 0
    while lookupPosition < symbolLookup.length {
        functionReturnTypes.add(symbolLookup[lookupPosition])
        lookupPosition = lookupPosition + 1
    }

    let output: List<Text> = []
    let globals: List<Text> = []
    let marker = 0
    while marker < parallelMarkers.length {
        globals.add(parallelMarkers[marker])
        marker = marker + 1
    }
    output.add("; Generated by the compiler written in Minyar.\n\n")
    let position = 0
    while position < tokenKinds.length {
        if tokenKinds[position] == 3 || tokenKinds[position] == 5 {
            let literal = tokenTexts[position]
            output.add("@.text.data.")
            output.add(Text(position))
            output.add(" = private unnamed_addr constant [")
            output.add(Text(literal.byteLength + 1))
            output.add(" x i8] c\"")
            output.add(escapeLLVMText(literal))
            output.add("\\00\"\n")
            if literal.length == literal.byteLength {
                output.add("@.text.")
                output.add(Text(position))
                output.add(" = private constant { i64, ptr, i64, i64, ptr, ptr } { i64 0, ptr @.text.data.")
                output.add(Text(position))
                output.add(", i64 ")
                output.add(Text(literal.byteLength))
                output.add(", i64 ")
                output.add(Text(literal.byteLength))
                output.add(", ptr null, ptr null }\n")
            } else {
                output.add("@.text.")
                output.add(Text(position))
                output.add(" = private global { i64, ptr, i64, i64, ptr, ptr } { i64 0, ptr @.text.data.")
                output.add(Text(position))
                output.add(", i64 ")
                output.add(Text(literal.byteLength))
                output.add(", i64 -1, ptr null, ptr null }\n")
            }
        }
        position = position + 1
    }

    output.add("\ndeclare void @minyar_rc_enter(i64)\n")
    output.add("declare void @minyar_rc_leave()\n")
    output.add("declare void @minyar_stack_enter()\n")
    output.add("declare void @minyar_stack_leave()\n")
    output.add("declare void @minyar_rc_keep(ptr)\n")
    output.add("declare void @minyar_rc_borrow(ptr)\n")
    output.add("declare void @minyar_rc_retain(ptr)\n")
    output.add("declare void @minyar_rc_local(i64, ptr)\n")
    output.add("declare void @minyar_rc_local_take(i64, ptr)\n")
    output.add("declare void @minyar_rc_local_move(i64)\n")
    output.add("declare void @minyar_rc_step()\n")
    output.add("declare void @minyar_print_integer(i64)\n")
    output.add("declare void @minyar_print_text(ptr)\n")
    output.add("declare void @minyar_print_character(i32)\n")
    output.add("declare void @minyar_print_boolean(i1 zeroext)\n")
    output.add("declare void @minyar_fail(ptr)\n")
    output.add("declare void @minyar_exit(i64)\n")
    output.add("declare void @minyar_print_float(double)\n")
    output.add("declare void @minyar_record_replace(ptr, i64, i64, i64)\n")
    output.add("declare i64 @minyar_bytes_get(ptr, i64)\n")
    output.add("declare void @minyar_bytes_set(ptr, i64, i64)\n")
    output.add("declare i64 @minyar_bytes_length(ptr)\n")
    output.add("declare zeroext i1 @minyar_file_exists(ptr)\n")
    output.add("declare ptr @minyar_bytes_new(i64)\n")
    output.add("declare ptr @minyar_text_bytes(ptr)\n")
    output.add("declare ptr @minyar_random_bytes(i64)\n")
    output.add("declare ptr @minyar_bytes_text(ptr)\n")
    output.add("declare void @minyar_bytes_resize(ptr, i64)\n")
    output.add("declare void @minyar_bytes_clear(ptr)\n")
    output.add("declare void @minyar_bytes_add(ptr, i64)\n")
    output.add("declare void @minyar_bytes_append(ptr, ptr)\n")
    output.add("declare ptr @minyar_bytes_slice(ptr, i64, i64)\n")
    output.add("declare ptr @minyar_read_bytes_file(ptr)\n")
    output.add("declare void @minyar_write_bytes_file(ptr, ptr)\n")
    output.add("declare void @minyar_bytes_add_int16(ptr, i64)\n")
    output.add("declare void @minyar_bytes_set_int16(ptr, i64, i64)\n")
    output.add("declare i64 @minyar_bytes_get_int16(ptr, i64)\n")
    output.add("declare void @minyar_bytes_add_uint16(ptr, i64)\n")
    output.add("declare void @minyar_bytes_set_uint16(ptr, i64, i64)\n")
    output.add("declare i64 @minyar_bytes_get_uint16(ptr, i64)\n")
    output.add("declare void @minyar_bytes_add_int32(ptr, i64)\n")
    output.add("declare void @minyar_bytes_set_int32(ptr, i64, i64)\n")
    output.add("declare i64 @minyar_bytes_get_int32(ptr, i64)\n")
    output.add("declare void @minyar_bytes_add_uint32(ptr, i64)\n")
    output.add("declare void @minyar_bytes_set_uint32(ptr, i64, i64)\n")
    output.add("declare i64 @minyar_bytes_get_uint32(ptr, i64)\n")
    output.add("declare void @minyar_bytes_add_int64(ptr, i64)\n")
    output.add("declare void @minyar_bytes_set_int64(ptr, i64, i64)\n")
    output.add("declare i64 @minyar_bytes_get_int64(ptr, i64)\n")
    output.add("declare void @minyar_bytes_add_float32(ptr, double)\n")
    output.add("declare void @minyar_bytes_set_float32(ptr, i64, double)\n")
    output.add("declare double @minyar_bytes_get_float32(ptr, i64)\n")
    output.add("declare void @minyar_bytes_add_float64(ptr, double)\n")
    output.add("declare void @minyar_bytes_set_float64(ptr, i64, double)\n")
    output.add("declare double @minyar_bytes_get_float64(ptr, i64)\n")
    output.add("declare ptr @minyar_float_text(double)\n")
    output.add("declare i64 @minyar_float_integer(double)\n")
    output.add("declare i32 @minyar_integer_character(i64)\n")
    output.add("declare i64 @minyar_integer_absolute(i64)\n")
    output.add("declare void @minyar_check_clamp_integer(i64, i64)\n")
    output.add("declare void @minyar_check_clamp_float(double, double)\n")
    output.add("declare void @minyar_check_shift(i64)\n")
    output.add("declare double @minyar_tan(double)\n")
    output.add("declare double @minyar_asin(double)\n")
    output.add("declare double @minyar_acos(double)\n")
    output.add("declare double @minyar_atan(double)\n")
    output.add("declare double @minyar_atan2(double, double)\n")
    output.add("declare double @llvm.sqrt.f64(double)\n")
    output.add("declare double @llvm.sin.f64(double)\n")
    output.add("declare double @llvm.cos.f64(double)\n")
    output.add("declare double @llvm.exp.f64(double)\n")
    output.add("declare double @llvm.log.f64(double)\n")
    output.add("declare double @llvm.floor.f64(double)\n")
    output.add("declare double @llvm.ceil.f64(double)\n")
    output.add("declare double @llvm.round.f64(double)\n")
    output.add("declare double @llvm.fabs.f64(double)\n")
    output.add("declare double @llvm.pow.f64(double, double)\n")
    output.add("declare double @llvm.minnum.f64(double, double)\n")
    output.add("declare double @llvm.maxnum.f64(double, double)\n")
    output.add("declare zeroext i1 @minyar_texts_are_equal(ptr, ptr)\n")
    output.add("declare ptr @minyar_join_text(ptr, ptr)\n")
    output.add("declare ptr @minyar_join_text_take_left(ptr, ptr)\n")
    output.add("declare ptr @minyar_join_texts(ptr)\n")
    output.add("declare i64 @minyar_text_length(ptr)\n")
    output.add("declare i64 @minyar_text_byte_length(ptr)\n")
    output.add("declare i32 @minyar_text_character_at(ptr, i64)\n")
    output.add("declare ptr @minyar_text_slice(ptr, i64, i64)\n")
    output.add("declare ptr @minyar_integer_text(i64)\n")
    output.add("declare ptr @minyar_character_text(i32)\n")
    output.add("declare ptr @minyar_boolean_text(i1 zeroext)\n")
    output.add("declare void @minyar_initialize_arguments(i32, ptr)\n")
    output.add("declare i64 @minyar_argument_count()\n")
    output.add("declare ptr @minyar_argument(i64)\n")
    output.add("declare ptr @minyar_read_text_file(ptr)\n")
    output.add("declare void @minyar_write_text_file(ptr, ptr)\n")
    output.add("declare ptr @minyar_list_new()\n")
    output.add("declare void @minyar_list_references(ptr)\n")
    output.add("declare void @minyar_list_add(ptr, i64)\n")
    output.add("declare void @minyar_list_append_scalars(ptr, ptr, i64)\n")
    output.add("declare void @minyar_list_add_take(ptr, i64)\n")
    output.add("declare i64 @minyar_list_length(ptr)\n")
    output.add("declare i64 @minyar_list_get(ptr, i64)\n")
    output.add("declare void @minyar_list_set(ptr, i64, i64)\n")
    output.add("declare void @minyar_list_set_take(ptr, i64, i64)\n")
    output.add("declare ptr @minyar_list_appended(ptr, i64, i64, i64)\n")
    output.add("declare ptr @minyar_record_new(i64)\n")
    output.add("declare ptr @minyar_record_new_scalar(i64)\n")
    output.add("declare i64 @minyar_record_get(ptr, i64)\n")
    output.add("declare void @minyar_record_set(ptr, i64, i64)\n")
    output.add("declare void @minyar_record_set_scalar(ptr, i64, i64)\n")
    output.add("declare void @minyar_record_set_reference(ptr, i64, i64)\n")
    output.add("declare void @minyar_record_set_take(ptr, i64, i64)\n")
    output.add("declare void @minyar_check_integer_overflow(i1)\n")
    output.add("declare void @minyar_check_integer_division(i64, i64)\n")
    output.add("declare void @minyar_fail_integer_overflow() cold noreturn\n")
    output.add("declare void @minyar_fail_integer_division(i64) cold noreturn\n")
    output.add("declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)\n")
    output.add("declare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)\n")
    output.add("declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)\n\n")
    appendRuntimeHelpers(output)
    let mainFunction = findIndexedSymbol(symbolLookup, functionNames, symbolKinds, "main", 1)
    if topLevelStatements && mainFunction >= 0 {
        fail(describeLocation(symbolLocations[mainFunction]) + ": a program cannot combine top-level statements with function main()")
    }
    let hasNative = compileFunctions(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, output, globals, stackOwnerLimit)
    if mainFunction < 0 {
        compileTopLevel(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, output, globals)
    }
    checkParallelCalls(globals)
    if stackOwnerLimit > 0 {
        output.add("declare void @minyar_rc_enter_stack_v1(ptr, ptr, i64)\n")
        output.add("declare void @minyar_rc_leave_stack_v1(ptr)\n")
    }
    if hasNative { appendNativeDeclarations(output) }
    if globals.length == 0 { return joinText(output) }
    return joinText(globals) + joinText(output)
}

function compileProgram(source: Text): Text {
    let tokenKinds: List<Integer> = []
    let tokenTexts: List<Text> = []
    let tokenLines = newSourceMap()
    tokenize(source, tokenKinds, tokenTexts, tokenLines)
    let scannedStarts: List<Integer> = []
    let scannedEnds: List<Integer> = []
    return compileTokens(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds, 0)
}

function pathCharacterIsSeparator(character: Character): Boolean {
    return character == '/' || character == '\\'
}

function normalizePath(path: Text): Text {
    let parts: List<Text> = []
    let activeParts = 0
    let position = 0
    let absolute = false
    let drive = ""

    if path.length >= 2 && path[1] == ':' {
        drive = Text(path[0]) + ":"
        position = 2
        if position < path.length && pathCharacterIsSeparator(path[position]) {
            absolute = true
            position = position + 1
        }
    } else {
        if path.length > 0 && pathCharacterIsSeparator(path[0]) {
            absolute = true
            position = 1
        }
    }

    let part = ""
    while position <= path.length {
        let atEnd = position == path.length
        if atEnd || pathCharacterIsSeparator(path[position]) {
            if part == ".." {
                if activeParts > 0 && parts[activeParts - 1] != ".." {
                    activeParts = activeParts - 1
                } else {
                    if !absolute {
                        if activeParts < parts.length {
                            parts[activeParts] = part
                        } else {
                            parts.add(part)
                        }
                        activeParts = activeParts + 1
                    }
                }
            } else {
                if part != "" && part != "." {
                    if activeParts < parts.length {
                        parts[activeParts] = part
                    } else {
                        parts.add(part)
                    }
                    activeParts = activeParts + 1
                }
            }
            part = ""
        } else {
            part = part + Text(path[position])
        }
        position = position + 1
    }

    let result = drive
    if absolute {
        result = result + "/"
    }
    position = 0
    while position < activeParts {
        if result.length > 0 && result[result.length - 1] != '/' {
            result = result + "/"
        }
        result = result + parts[position]
        position = position + 1
    }
    if result == "" {
        result = "."
    }
    return result
}

function directoryOfPath(path: Text): Text {
    let normalized = normalizePath(path)
    let lastSeparator = -1
    let position = 0
    while position < normalized.length {
        if normalized[position] == '/' {
            lastSeparator = position
        }
        position = position + 1
    }
    let directory = ""
    position = 0
    while position < lastSeparator {
        directory = directory + Text(normalized[position])
        position = position + 1
    }
    if lastSeparator == 0 {
        directory = "/"
    }
    return directory
}

function resolveModulePath(importer: Text, specifier: Text): Text {
    let relative = false
    if specifier.length >= 2 && specifier[0] == '.' && pathCharacterIsSeparator(specifier[1]) {
        relative = true
    }
    if specifier.length >= 3 && specifier[0] == '.' && specifier[1] == '.' && pathCharacterIsSeparator(specifier[2]) {
        relative = true
    }
    if !relative {
        fail("package module '" + specifier + "' is not available yet; local modules begin with './' or '../'")
    }
    let directory = directoryOfPath(importer)
    if directory == "" {
        return normalizePath(specifier)
    }
    return normalizePath(directory + "/" + specifier)
}

// Names without ./ or ../ are standard library packages, found in the
// directories passed to the compiler with --library. `library` holds them one
// per line; the first that has the package wins, so a directory such as
// library/arch/arm64 listed first can replace a package for one processor.
function resolveImport(importer: Text, specifier: Text, library: Text): Text {
    let relative = specifier.length >= 2 && specifier[0] == '.' && (pathCharacterIsSeparator(specifier[1]) || specifier[1] == '.')
    if relative || library == "" {
        return resolveModulePath(importer, specifier)
    }
    let split = findCharacter(library, '\n')
    if split >= 0 {
        let first = library.slice(0, split)
        let candidate = resolveImport(importer, specifier, first)
        if fileExists(candidate) { return candidate }
        return resolveImport(importer, specifier, library.slice(split + 1, library.length))
    }
    let position = 0
    while position < specifier.length {
        let character = specifier[position]
        if !characterIsLetter(character) && !characterIsDigit(character) && character != '-' && character != '_' {
            fail("package names use letters, digits, '-', and '_'; found '" + specifier + "'")
        }
        position = position + 1
    }
    return normalizePath(library + "/" + specifier + ".min")
}

function findText(values: List<Text>, wanted: Text): Integer {
    let position = 0
    let found = -1
    while position < values.length && found < 0 {
        if values[position] == wanted {
            found = position
        }
        position = position + 1
    }
    return found
}

function findModuleImport(importOwners: List<Integer>, importAliases: List<Text>, owner: Integer, alias: Text): Integer {
    let position = 0
    let found = -1
    while position < importOwners.length && found < 0 {
        if importOwners[position] == owner && importAliases[position] == alias {
            found = position
        }
        position = position + 1
    }
    return found
}

function loadModule(library: Text, path: Text, isEntry: Boolean, modulePaths: List<Text>, moduleSources: List<Text>, moduleStates: List<Integer>, modulePublic: List<Integer>, moduleTokenStarts: List<Integer>, allTokenKinds: List<Integer>, allTokenTexts: List<Text>, allTokenLines: SourceMap, importOwners: List<Integer>, importAliases: List<Text>, importTargets: List<Integer>, declarationStarts: List<Integer>, declarationEnds: List<Integer>): Integer {
    let canonicalPath = normalizePath(path)
    let existing = findText(modulePaths, canonicalPath)
    if existing >= 0 {
        if moduleStates[existing] == 1 {
            let cycle = ""
            let position = 0
            while position < modulePaths.length {
                if moduleStates[position] == 1 {
                    if cycle != "" {
                        cycle = cycle + " -> "
                    }
                    cycle = cycle + modulePaths[position]
                }
                position = position + 1
            }
            fail("module import cycle: " + cycle + " -> " + canonicalPath)
        }
        return existing
    }

    let module = modulePaths.length
    modulePaths.add(canonicalPath)
    moduleSources.add(readTextFile(canonicalPath))
    moduleStates.add(1)
    modulePublic.add(0)

    moduleTokenStarts.add(allTokenKinds.length)
    tokenize(moduleSources[module], allTokenKinds, allTokenTexts, allTokenLines)
    let cursor: List<Integer> = []
    cursor.add(moduleTokenStarts[module])
    skipTerminators(allTokenKinds, cursor)
    while allTokenKinds[cursor[0]] != 0 {
        if tokenIs(allTokenKinds, allTokenTexts, cursor, "use") {
            let importLine = cursor[0]
            cursor[0] = cursor[0] + 1
            if allTokenKinds[cursor[0]] != 3 {
                fail(canonicalPath + ":" + tokenLocation(allTokenLines, importLine) + ": use expects a quoted module name")
            }
            let specifier = allTokenTexts[cursor[0]]
            cursor[0] = cursor[0] + 1
            if !tokenIs(allTokenKinds, allTokenTexts, cursor, "as") {
                fail(canonicalPath + ":" + tokenLocation(allTokenLines, importLine) + ": use expects 'as' after the module name")
            }
            cursor[0] = cursor[0] + 1
            if allTokenKinds[cursor[0]] != 1 {
                fail(canonicalPath + ":" + tokenLocation(allTokenLines, importLine) + ": use expects a module alias after 'as'")
            }
            let alias = allTokenTexts[cursor[0]]
            cursor[0] = cursor[0] + 1
            if findModuleImport(importOwners, importAliases, module, alias) >= 0 {
                fail(canonicalPath + ":" + tokenLocation(allTokenLines, importLine) + ": module alias '" + alias + "' is already used")
            }
            finishStatement(allTokenKinds, allTokenTexts, allTokenLines, cursor)
            let targetPath = resolveImport(canonicalPath, specifier, library)
            let target = loadModule(library, targetPath, false, modulePaths, moduleSources, moduleStates, modulePublic, moduleTokenStarts, allTokenKinds, allTokenTexts, allTokenLines, importOwners, importAliases, importTargets, declarationStarts, declarationEnds)
            importOwners.add(module)
            importAliases.add(alias)
            importTargets.add(target)
        } else {
            let declarationCursor = cursor[0]
            let hasPublic = false
            if tokenIs(allTokenKinds, allTokenTexts, cursor, "public") {
                hasPublic = true
                modulePublic[module] = 1
                declarationCursor = declarationCursor + 1
            }
            let marker: List<Integer> = []
            marker.add(declarationCursor)
            if tokenIs(allTokenKinds, allTokenTexts, marker, "constant") {
                declarationStarts.add(declarationCursor)
                skipTopLevelStatement(allTokenKinds, allTokenTexts, marker)
                declarationEnds.add(marker[0])
                cursor[0] = marker[0]
            } else {
            if tokenIs(allTokenKinds, allTokenTexts, marker, "record") || tokenIs(allTokenKinds, allTokenTexts, marker, "function") {
                declarationStarts.add(declarationCursor)
                skipDeclaration(allTokenKinds, allTokenTexts, marker)
                declarationEnds.add(marker[0])
                cursor[0] = marker[0]
            } else {
                if hasPublic {
                    fail(canonicalPath + ":" + tokenLocation(allTokenLines, cursor[0]) + ": public must describe a function, record, or constant declaration")
                }
                if !isEntry {
                    fail(canonicalPath + ":" + tokenLocation(allTokenLines, cursor[0]) + ": imported modules may contain declarations but not executable top-level statements")
                }
                declarationStarts.add(-1)
                skipTopLevelStatement(allTokenKinds, allTokenTexts, cursor)
            }
            }
        }
        skipTerminators(allTokenKinds, cursor)
    }
    moduleStates[module] = 2
    return module
}

function qualifiedDeclarationName(module: Integer, name: Text): Text {
    let qualified = "minyar_module_" + Text(module) + "_" + name
    if module == 0 && name == "main" {
        qualified = "main"
    }
    return qualified
}

function findModuleDeclaration(declarationOwners: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, owner: Integer, name: Text, kind: Integer): Integer {
    let position = 0
    let found = -1
    while position < declarationOwners.length && found < 0 {
        if declarationOwners[position] == owner && declarationNames[position] == name && declarationKinds[position] == kind {
            found = position
        }
        position = position + 1
    }
    return found
}

function findIndexedModuleDeclaration(declarationLookup: List<Integer>, declarationQualifiedNames: List<Text>, declarationKinds: List<Integer>, owner: Integer, name: Text, kind: Integer): Integer {
    return findIndexedSymbol(declarationLookup, declarationQualifiedNames, declarationKinds, qualifiedDeclarationName(owner, name), kind)
}

function requireUniqueModuleDeclarations(declarationLookup: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, declarationQualifiedNames: List<Text>, declarationLocations: List<Text>) {
    let position = 1
    while position < declarationLookup.length {
        let previous = declarationLookup[position - 1]
        let current = declarationLookup[position]
        if declarationKinds[previous] == declarationKinds[current] && declarationQualifiedNames[previous] == declarationQualifiedNames[current] {
            let duplicate = current
            if previous > current { duplicate = previous }
            fail(describeLocation(declarationLocations[duplicate]) + ": module declares '" + declarationNames[current] + "' more than once")
        }
        position = position + 1
    }
}

function collectModuleDeclarations(module: Integer, modulePath: Text, tokenStart: Integer, tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, declarationOwners: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, declarationPublic: List<Integer>, declarationQualifiedNames: List<Text>, declarationLocations: List<Text>) {
    let cursor: List<Integer> = []
    cursor.add(tokenStart)
    skipTerminators(tokenKinds, cursor)
    while tokenKinds[cursor[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, cursor, "use") {
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
        } else {
            let isPublic = 0
            if tokenIs(tokenKinds, tokenTexts, cursor, "public") {
                isPublic = 1
                cursor[0] = cursor[0] + 1
            }
            let kind = 0
            if tokenIs(tokenKinds, tokenTexts, cursor, "function") {
                kind = 1
            }
            if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
                kind = 2
            }
            if tokenIs(tokenKinds, tokenTexts, cursor, "constant") {
                kind = 3
            }
            if kind > 0 {
                let name = tokenTexts[cursor[0] + 1]
                declarationOwners.add(module)
                declarationNames.add(name)
                declarationKinds.add(kind)
                declarationPublic.add(isPublic)
                declarationQualifiedNames.add(qualifiedDeclarationName(module, name))
                declarationLocations.add(modulePath + ":" + tokenLocation(tokenLines, cursor[0] + 1))
                if kind == 3 {
                    skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
                } else {
                    skipDeclaration(tokenKinds, tokenTexts, cursor)
                }
            } else {
                if isPublic == 1 {
                    fail("public must describe a function, record, or constant declaration")
                }
                skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            }
        }
        skipTerminators(tokenKinds, cursor)
    }
}

function importedDeclarationName(module: Integer, alias: Text, name: Text, kind: Integer, modulePath: Text, tokenLines: SourceMap, location: Integer, importOwners: List<Integer>, importAliases: List<Text>, importTargets: List<Integer>, declarationLookup: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, declarationPublic: List<Integer>, declarationQualifiedNames: List<Text>): Text {
    let imported = findModuleImport(importOwners, importAliases, module, alias)
    if imported < 0 {
        fail(describeLocation(modulePath + ":" + tokenLocation(tokenLines, location)) + ": I can't find an imported module named '" + alias + "'")
    }
    let declaration = findIndexedModuleDeclaration(declarationLookup, declarationQualifiedNames, declarationKinds, importTargets[imported], name, kind)
    if declaration < 0 {
        let declarationKind = "record"
        if kind == 1 {
            declarationKind = "function"
        }
        if kind == 3 {
            declarationKind = "constant"
        }
        fail(describeLocation(modulePath + ":" + tokenLocation(tokenLines, location)) + ": module '" + alias + "' has no " + declarationKind + " named '" + name + "'")
    }
    if declarationPublic[declaration] == 0 {
        fail(describeLocation(modulePath + ":" + tokenLocation(tokenLines, location)) + ": '" + alias + "." + name + "' is private to its module")
    }
    return declarationQualifiedNames[declaration]
}

function appendModuleTokens(module: Integer, modulePath: Text, tokenStart: Integer, tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, importOwners: List<Integer>, importAliases: List<Text>, importTargets: List<Integer>, declarationLookup: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, declarationPublic: List<Integer>, declarationQualifiedNames: List<Text>, outputKinds: List<Integer>, outputTexts: List<Text>, outputLines: SourceMap) {
    let origin = sourcePath(outputLines, modulePath)
    let position = tokenStart
    let declarationMode = 0
    let declarationDepth = 0
    let functionHeader = false
    let letDeclaration = false
    let typeMode = false
    let genericDepth = 0

    while tokenKinds[position] != 0 {
        if declarationMode == 0 && tokenKinds[position] == 1 && tokenTexts[position] == "use" {
            let cursor: List<Integer> = []
            cursor.add(position)
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            // Keep the line breaks after the import, including a `parallel`
            // modifier the lexer turned into one.
            while cursor[0] > position + 1 && tokenKinds[cursor[0] - 1] == 6 {
                cursor[0] = cursor[0] - 1
            }
            position = cursor[0]
        } else {
            if declarationMode == 0 && tokenKinds[position] == 1 && tokenTexts[position] == "public" {
                position = position + 1
            } else {
                let token = tokenTexts[position]
                let kind = tokenKinds[position]
                let rewritten = token
                // A field/method selector belongs to its receiver. Matching an
                // import alias or local declaration name must not rewrite it.
                let memberSelector = position > tokenStart && tokenTexts[position - 1] == "."

                if declarationMode == 0 && kind == 1 && (token == "record" || token == "function") {
                    if token == "record" {
                        declarationMode = 1
                    } else {
                        declarationMode = 2
                        functionHeader = true
                    }
                } else {
                    if kind == 1 && token == "let" {
                        letDeclaration = true
                    }
                }

                if kind == 4 && token == ":" && (declarationMode == 1 || functionHeader || letDeclaration) {
                    typeMode = true
                    genericDepth = 0
                }

                if kind == 1 && !memberSelector && position + 2 < tokenKinds.length && tokenTexts[position + 1] == "." {
                    let imported = findModuleImport(importOwners, importAliases, module, token)
                    if imported >= 0 {
                        let wantedKind = 2
                        if position + 3 < tokenKinds.length && tokenTexts[position + 3] == "(" {
                            wantedKind = 1
                        } else {
                            let importedConstant = findIndexedModuleDeclaration(declarationLookup, declarationQualifiedNames, declarationKinds, importTargets[imported], tokenTexts[position + 2], 3)
                            if !typeMode && importedConstant >= 0 {
                                wantedKind = 3
                            }
                        }
                        rewritten = importedDeclarationName(module, token, tokenTexts[position + 2], wantedKind, modulePath, tokenLines, position, importOwners, importAliases, importTargets, declarationLookup, declarationNames, declarationKinds, declarationPublic, declarationQualifiedNames)
                        copyModuleToken(outputKinds, outputTexts, outputLines, 1, rewritten, tokenLines, position, origin)
                        position = position + 3
                        if typeMode && genericDepth == 0 {
                            typeMode = false
                        }
                    } else {
                        copyModuleToken(outputKinds, outputTexts, outputLines, kind, rewritten, tokenLines, position, origin)
                        position = position + 1
                    }
                } else {
                    if kind == 1 && !memberSelector {
                        let declarationKind = 0
                        if position > 0 && tokenTexts[position - 1] == "function" {
                            declarationKind = 1
                        }
                        if position > 0 && tokenTexts[position - 1] == "record" {
                            declarationKind = 2
                        }
                        if declarationKind == 0 && position + 1 < tokenKinds.length && tokenTexts[position + 1] == "(" {
                            declarationKind = 1
                        }
                        // parallelEntry(name) names a function without calling it.
                        if declarationKind == 0 && position >= 2 && tokenTexts[position - 2] == "parallelEntry" && tokenTexts[position - 1] == "(" {
                            declarationKind = 1
                        }
                        if declarationKind == 0 && position + 1 < tokenKinds.length && tokenTexts[position + 1] == "{" {
                            declarationKind = 2
                        }
                        if declarationKind == 0 && typeMode {
                            declarationKind = 2
                        }
                        if position > 0 && tokenTexts[position - 1] == "constant" {
                            declarationKind = 3
                        }
                        // Locals and parameters share a constant's rewritten
                        // spelling, so parsePrimary can still prefer a local.
                        // Record field names remain in their receiver namespace.
                        if declarationKind == 0 && ((position > 0 && (tokenTexts[position - 1] == "let" || tokenTexts[position - 1] == "for")) || (functionHeader && position + 1 < tokenKinds.length && tokenTexts[position + 1] == ":")) {
                            declarationKind = 3
                        }
                        // Other bare names may use a constant of this module;
                        // a following ':' names a field or parameter instead.
                        if declarationKind == 0 && !(position + 1 < tokenKinds.length && tokenTexts[position + 1] == ":") {
                            declarationKind = 3
                        }
                        // `NAME {` is a record literal unless NAME is a constant, as in `if x == NAME {`.
                        if declarationKind == 2 && !typeMode && !(position > 0 && tokenTexts[position - 1] == "record") {
                            let blockConstant = findIndexedModuleDeclaration(declarationLookup, declarationQualifiedNames, declarationKinds, module, token, 3)
                            if blockConstant >= 0 {
                                declarationKind = 3
                            }
                        }
                        if declarationKind > 0 {
                            let declaration = findIndexedModuleDeclaration(declarationLookup, declarationQualifiedNames, declarationKinds, module, token, declarationKind)
                            if declaration >= 0 {
                                rewritten = declarationQualifiedNames[declaration]
                            }
                        }
                    }
                    copyModuleToken(outputKinds, outputTexts, outputLines, kind, rewritten, tokenLines, position, origin)

                    if typeMode && kind == 1 && token != "List" && genericDepth == 0 {
                        typeMode = false
                    }
                    if kind == 4 && token == "<" && typeMode {
                        genericDepth = genericDepth + 1
                    }
                    if kind == 4 && token == ">" && genericDepth > 0 {
                        genericDepth = genericDepth - 1
                        if genericDepth == 0 {
                            typeMode = false
                        }
                    }
                    if kind == 4 && token == ">>" && genericDepth > 0 {
                        genericDepth = genericDepth - 2
                        if genericDepth <= 0 {
                            genericDepth = 0
                            typeMode = false
                        }
                    }
                    if kind == 4 && token == "=" || kind == 6 {
                        letDeclaration = false
                    }
                    if kind == 4 && token == "{" && declarationMode > 0 {
                        declarationDepth = declarationDepth + 1
                        if declarationMode == 2 && declarationDepth == 1 {
                            functionHeader = false
                        }
                    }
                    if kind == 4 && token == "}" && declarationMode > 0 {
                        declarationDepth = declarationDepth - 1
                        if declarationDepth == 0 {
                            declarationMode = 0
                            functionHeader = false
                            letDeclaration = false
                        }
                    }
                    position = position + 1
                }
            }
        }
    }
    copyModuleToken(outputKinds, outputTexts, outputLines, 6, "end of module", tokenLines, position, origin)
}

function compileEntry(path: Text, stackOwnerLimit: Integer): Text {
    return compileEntryWithLibrary(path, stackOwnerLimit, "")
}

function compileEntryWithLibrary(path: Text, stackOwnerLimit: Integer, library: Text): Text {
    let modulePaths: List<Text> = []
    let moduleSources: List<Text> = []
    let moduleStates: List<Integer> = []
    let modulePublic: List<Integer> = []
    let moduleTokenStarts: List<Integer> = []
    let moduleTokenKinds: List<Integer> = []
    let moduleTokenTexts: List<Text> = []
    let moduleTokenLines = newSourceMap()
    let importOwners: List<Integer> = []
    let importAliases: List<Text> = []
    let importTargets: List<Integer> = []
    let declarationStarts: List<Integer> = []
    let declarationEnds: List<Integer> = []
    let entry = loadModule(library, path, true, modulePaths, moduleSources, moduleStates, modulePublic, moduleTokenStarts, moduleTokenKinds, moduleTokenTexts, moduleTokenLines, importOwners, importAliases, importTargets, declarationStarts, declarationEnds)
    if modulePaths.length == 1 && modulePublic[0] == 0 {
        return compileTokens(moduleTokenKinds, moduleTokenTexts, moduleTokenLines, declarationStarts, declarationEnds, stackOwnerLimit)
    }

    let declarationOwners: List<Integer> = []
    let declarationNames: List<Text> = []
    let declarationKinds: List<Integer> = []
    let declarationPublic: List<Integer> = []
    let declarationQualifiedNames: List<Text> = []
    let declarationLocations: List<Text> = []
    let module = 0
    while module < modulePaths.length {
        collectModuleDeclarations(module, modulePaths[module], moduleTokenStarts[module], moduleTokenKinds, moduleTokenTexts, moduleTokenLines, declarationOwners, declarationNames, declarationKinds, declarationPublic, declarationQualifiedNames, declarationLocations)
        module = module + 1
    }
    let declarationLookup = buildSymbolLookup(declarationQualifiedNames, declarationKinds)
    requireUniqueModuleDeclarations(declarationLookup, declarationNames, declarationKinds, declarationQualifiedNames, declarationLocations)

    let tokenKinds: List<Integer> = []
    let tokenTexts: List<Text> = []
    let tokenLines = newSourceMap()
    module = 0
    while module < modulePaths.length {
        appendModuleTokens(module, modulePaths[module], moduleTokenStarts[module], moduleTokenKinds, moduleTokenTexts, moduleTokenLines, importOwners, importAliases, importTargets, declarationLookup, declarationNames, declarationKinds, declarationPublic, declarationQualifiedNames, tokenKinds, tokenTexts, tokenLines)
        module = module + 1
    }
    addEndToken(tokenKinds, tokenTexts, tokenLines, "end of program")
    let scannedStarts: List<Integer> = []
    let scannedEnds: List<Integer> = []
    return compileTokens(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds, stackOwnerLimit)
}

function ownershipLimitForBudget(text: Text): Integer {
    let budget = 0
    let position = 0
    let digits = "0123456789"
    while position < text.length {
        let digit = 0
        while digit < 10 && text[position] != digits[digit] { digit = digit + 1 }
        if digit == 10 { fail("cleanup budget must be a positive decimal integer") }
        if budget < 9 {
            budget = budget * 10 + digit
            if budget > 9 { budget = 9 }
        }
        position = position + 1
    }
    if budget == 0 { fail("cleanup budget must be a positive decimal integer") }
    return budget - 1
}

// Freestanding programs run with interrupts that arrive on the current stack,
// so no function may keep data in the 128 bytes below the stack pointer.
function freestandingModule(llvm: Text): Text {
    let pieces: List<Text> = []
    let start = 0
    let position = 0
    let length = llvm.length
    while position < length {
        if llvm[position] == '\n' {
            if position > start + 8 && llvm[start] == 'd' && llvm[position - 1] == '{' && llvm.slice(start, start + 7) == "define " {
                pieces.add(llvm.slice(start, position - 1))
                pieces.add("noredzone {\n")
            } else {
                pieces.add(llvm.slice(start, position + 1))
            }
            start = position + 1
        }
        position = position + 1
    }
    pieces.add(llvm.slice(start, length))
    return joinText(pieces)
}

function main() {
    if argumentCount() == 0 {
        print("Minyar compiler bootstrap is ready")
        print(characterIsLetter('M'))
        print(characterIsDigit('x'))
    } else {
        let stackOwnerLimit = 0
        let library = ""
        let freestanding = false
        let position = 2
        while position < argumentCount() {
            if argument(position) == "--freestanding" {
                freestanding = true
            } else {
            if argument(position) == "--bounded-owners" {
                stackOwnerLimit = 8
                if position + 1 < argumentCount() && argument(position + 1) != "--library" && argument(position + 1) != "--bounded-owners" && argument(position + 1) != "--freestanding" {
                    stackOwnerLimit = ownershipLimitForBudget(argument(position + 1))
                    position = position + 1
                }
            } else {
                if argument(position) == "--library" && position + 1 < argumentCount() {
                    if library != "" { library = library + "\n" }
                    library = library + argument(position + 1)
                    position = position + 1
                } else {
                    fail("usage: compiler SOURCE OUTPUT [--bounded-owners [BUDGET]] [--library DIRECTORY] [--freestanding]")
                }
            }
            }
            position = position + 1
        }
        let llvm = compileEntryWithLibrary(argument(0), stackOwnerLimit, library)
        if freestanding {
            llvm = freestandingModule(llvm)
        }
        if argumentCount() == 1 {
            print(llvm)
        } else {
            writeTextFile(argument(1), llvm)
        }
    }
}
