// `let left, right = join(f(...), g(...))` runs two parallel function calls as a
// fork-join on the work-stealing pool. The token stage rewrites it into two
// ordinary bindings, so every later stage sees one name per `let`:
//   let left = minyar_join_pair(f(...), g(...))
//   let right = minyar_join_second()
function joinBindingAt(kinds: List<Integer>, texts: List<Text>, position: Integer): Boolean {
    return position + 7 < texts.length && kinds[position] == 1 && texts[position] == "let" && kinds[position + 1] == 1 && texts[position + 2] == "," && kinds[position + 3] == 1 && texts[position + 4] == "=" && kinds[position + 5] == 1 && texts[position + 5] == "join" && texts[position + 6] == "("
}

function hasJoinBindings(kinds: List<Integer>, texts: List<Text>): Boolean {
    let position = 0
    while position < texts.length {
        if texts[position] == "join" && position >= 5 && joinBindingAt(kinds, texts, position - 5) { return true }
        position = position + 1
    }
    return false
}

function normalizeJoinBindings(kinds: List<Integer>, texts: List<Text>, lines: SourceMap): ResultTokenSet {
    let outputKinds: List<Integer> = []
    let outputTexts: List<Text> = []
    let outputLines = newSourceMap()
    outputLines.features = lines.features
    let run = 0
    let position = 0
    while position < kinds.length {
        if joinBindingAt(kinds, texts, position) {
            let close = position + 6
            let depth = 0
            let scanning = true
            while scanning && close < kinds.length {
                let text = texts[close]
                if kinds[close] == 4 && (text == "(" || text == "[" || text == "{") { depth = depth + 1 }
                if kinds[close] == 4 && (text == ")" || text == "]" || text == "}") {
                    depth = depth - 1
                    if depth == 0 { scanning = false }
                }
                if scanning { close = close + 1 }
            }
            if close >= kinds.length { failAtToken(lines, position + 5, "join needs a closing ')'") }
            copyTokenRun(outputKinds, outputTexts, outputLines, kinds, texts, lines, run, position + 2, true)
            choiceCopy(outputKinds, outputTexts, outputLines, 4, "=", lines, position + 4)
            choiceCopy(outputKinds, outputTexts, outputLines, 1, "minyar_join_pair", lines, position + 5)
            copyTokenRun(outputKinds, outputTexts, outputLines, kinds, texts, lines, position + 6, close + 1, true)
            choiceCopy(outputKinds, outputTexts, outputLines, 6, "end of line", lines, close)
            choiceCopy(outputKinds, outputTexts, outputLines, 1, "let", lines, position)
            choiceCopy(outputKinds, outputTexts, outputLines, 1, texts[position + 3], lines, position + 3)
            choiceCopy(outputKinds, outputTexts, outputLines, 4, "=", lines, position + 4)
            choiceCopy(outputKinds, outputTexts, outputLines, 1, "minyar_join_second", lines, position + 5)
            choiceCopy(outputKinds, outputTexts, outputLines, 4, "(", lines, close)
            choiceCopy(outputKinds, outputTexts, outputLines, 4, ")", lines, close)
            run = close + 1
            position = close + 1
        } else {
            position = position + 1
        }
    }
    copyTokenRun(outputKinds, outputTexts, outputLines, kinds, texts, lines, run, kinds.length, true)
    return ResultTokenSet { kinds: outputKinds; texts: outputTexts; lines: outputLines }
}

// The callee named by the call that starts at `position`: the last name before
// its '(' (so `module.name(...)` gives `name`), or "" when it is not a call.
function joinCalleeAt(kinds: List<Integer>, texts: List<Text>, position: Integer): Text {
    let at = position
    let name = ""
    while at < texts.length && kinds[at] == 1 {
        name = texts[at]
        if at + 1 < texts.length && texts[at + 1] == "." { at = at + 2 } else { at = texts.length }
    }
    return name
}

// Whether some join in the program calls a function not declared `parallel
// function`: such a join runs ordinary code on pool workers, so the program
// needs the thread runtime. Decided from tokens before any declaration is read.
function joinNeedsThreads(kinds: List<Integer>, texts: List<Text>): Boolean {
    let parallels: List<Text> = []
    let position = 0
    while position + 2 < texts.length {
        if texts[position] == "parallel" && texts[position + 1] == "function" { parallels.add(texts[position + 2]) }
        if position + 3 < texts.length && texts[position] == "parallel" && texts[position + 1] == "public" && texts[position + 2] == "function" { parallels.add(texts[position + 3]) }
        position = position + 1
    }
    position = 0
    while position < texts.length {
        if texts[position] == "join" && position >= 5 && joinBindingAt(kinds, texts, position - 5) {
            let leftName = joinCalleeAt(kinds, texts, position + 2)
            if leftName == "" || findText(parallels, leftName) < 0 { return true }
            let at = position + 2
            let depth = 0
            let scanning = true
            while scanning && at < texts.length {
                let text = texts[at]
                if kinds[at] == 4 && (text == "(" || text == "[" || text == "{") { depth = depth + 1 }
                if kinds[at] == 4 && (text == ")" || text == "]" || text == "}") {
                    depth = depth - 1
                    if depth < 0 { scanning = false }
                }
                if scanning && depth == 0 && text == "," { scanning = false }
                if scanning { at = at + 1 }
            }
            if at + 1 >= texts.length || texts[at] != "," { return true }
            let rightName = joinCalleeAt(kinds, texts, at + 1)
            if rightName == "" || findText(parallels, rightName) < 0 { return true }
        }
        position = position + 1
    }
    return false
}

function isJoinBuiltin(name: Text): Boolean {
    return name == "minyar_join_pair" || name == "minyar_join_second"
}

function joinParallelFunction(globals: List<Text>, resolved: Text, name: Text): Boolean {
    return findText(globals, "; minyar-parallel: " + resolved + "\n") >= 0 || findText(globals, "; minyar-parallel: " + name + "\n") >= 0
}

// One branch: `name(arguments)`. Returns the function index; argument values,
// types and source locations are appended. Which join runs it (scalar or
// managed) is decided once both branches are known.
function parseJoinBranch(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, values: List<Text>, types: List<Integer>, locations: List<Integer>): Integer {
    let location = state[0]
    if context.tokenKinds[location] != 1 || context.tokenTexts[location + 1] != "(" { failAtToken(context.tokenLines, location, "join runs two function calls, such as join(left(n - 1), right(n - 2))") }
    let name = context.tokenTexts[location]
    let function = findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, name)
    if function < 0 { failUnknownFunction(context, location, name) }
    let resolved = context.functionNames[function]
    state[0] = location + 2
    let count = context.functionParameterCounts[function]
    let first = functionParameterOffset(context.functionParameterCounts, function)
    let argument = 0
    while !tokenIs(context.tokenKinds, context.tokenTexts, state, ")") {
        if argument > 0 { expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ",") }
        if argument >= count { failAtToken(context.tokenLines, location, "'" + readableDeclarationName(resolved) + "' expects " + Text(count) + " arguments") }
        let wanted = context.functionParameterTypes[first + argument]
        let argumentLocation = state[0]
        let argumentType: List<Integer> = [wanted]
        let value = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType)
        requireContextType(context, argumentLocation, argumentType[0], wanted, "an argument passed to " + readableDeclarationName(resolved) + " has the wrong type")
        values.add(value)
        types.add(wanted)
        locations.add(argumentLocation)
        argument = argument + 1
    }
    if argument != count { failAtToken(context.tokenLines, location, "'" + readableDeclarationName(resolved) + "' expects " + Text(count) + " arguments") }
    state[0] = state[0] + 1
    context.callTargets.add(function)
    if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "call", resolved, "join") }
    locations.add(location)
    return function
}

// A scalar join: two pure parallel functions with scalar results, whose
// arguments are scalars or scalar buffers that both calls may read.
function joinScalarBranch(context: CompilerContext, globals: List<Text>, function: Integer, types: List<Integer>): Boolean {
    let resolved = context.functionNames[function]
    if !joinParallelFunction(globals, resolved, readableDeclarationName(resolved)) || !parallelScalar(context.functionReturnTypes[function]) { return false }
    let k = 0
    while k < types.length {
        if !parallelScalar(types[k]) && !parallelBuffer(types[k]) { return false }
        k = k + 1
    }
    return true
}

function noteScalarJoinBranch(context: CompilerContext, globals: List<Text>, function: Integer, types: List<Integer>, locations: List<Integer>) {
    let resolved = context.functionNames[function]
    let k = 0
    while k < types.length {
        // Both branches may read a buffer at once, so neither may write it.
        if parallelBuffer(types[k]) { globals.add("; minyar-parallel-readonly: " + resolved + "|" + Text(k) + "|" + Text(locations[k]) + "|\n") }
        k = k + 1
    }
    globals.add("; minyar-safe-parallel: " + resolved + "\n")
    globals.add("; minyar-safe-location: " + resolved + "|" + Text(locations[locations.length - 1]) + "\n")
}

// A managed join branch may be any function with sendable parameters and a
// sendable result; it runs in the domain of whichever thread takes it.
function joinTaskDescriptors(context: CompilerContext, function: Integer, location: Integer, descriptors: List<Text>) {
    let resolved = readableDeclarationName(context.functionNames[function])
    let result = context.functionReturnTypes[function]
    if result == 5 || result == 6 { failAtToken(context.tokenLines, location, "join needs '" + resolved + "' to return a value") }
    let visiting: List<Integer> = []
    descriptors.add(threadDescriptor(context, result, visiting, "the result of join branch '" + resolved + "'"))
    let count = context.functionParameterCounts[function]
    let first = functionParameterOffset(context.functionParameterCounts, function)
    let tuple = "r" + Text(count) + "."
    let managed = false
    let k = 0
    while k < count {
        let parameterVisits: List<Integer> = []
        let parameter = readableDeclarationName(context.functionParameterNames[first + k])
        let descriptor = threadDescriptor(context, context.functionParameterTypes[first + k], parameterVisits, "join branch '" + resolved + "' parameter '" + parameter + "'")
        if descriptor != "i" { managed = true }
        tuple = tuple + descriptor
        k = k + 1
    }
    if !managed { tuple = "" }
    descriptors.add(tuple)
}

function joinSlotConversion(value: Text, raw: Text, type: Integer): Text {
    if type == 4 { return "  " + value + " = trunc i64 " + raw + " to i1\n" }
    if type == 3 { return "  " + value + " = trunc i64 " + raw + " to i32\n" }
    if type == 7 { return "  " + value + " = bitcast i64 " + raw + " to double\n" }
    if isReferenceType(type) { return "  " + value + " = inttoptr i64 " + raw + " to ptr\n" }
    return "  " + value + " = add i64 " + raw + ", 0\n"
}

function joinValueSlot(slot: Text, value: Text, type: Integer): Text {
    if type == 4 || type == 3 { return "  " + slot + " = zext " + llvmType(type) + " " + value + " to i64\n" }
    if type == 7 { return "  " + slot + " = bitcast double " + value + " to i64\n" }
    if isReferenceType(type) { return "  " + slot + " = ptrtoint ptr " + value + " to i64\n" }
    return "  " + slot + " = add i64 " + value + ", 0\n"
}

// A thunk reads one branch's arguments from its environment, calls the parallel
// function and stores the result after them.
function joinThunk(context: CompilerContext, globals: List<Text>, name: Text, function: Integer) {
    let count = context.functionParameterCounts[function]
    let first = functionParameterOffset(context.functionParameterCounts, function)
    let pieces: List<Text> = ["define internal void @" + name + "(ptr %environment) uwtable {\nentry:\n"]
    let call = ""
    let k = 0
    while k < count {
        let type = context.functionParameterTypes[first + k]
        let slot = "%argument." + Text(k)
        pieces.add("  " + slot + ".address = getelementptr inbounds i64, ptr %environment, i64 " + Text(k) + "\n")
        pieces.add("  " + slot + ".slot = load i64, ptr " + slot + ".address, align 8\n")
        pieces.add(joinSlotConversion(slot, slot + ".slot", type))
        if k > 0 { call = call + ", " }
        call = call + argumentPrefix(type) + slot
        k = k + 1
    }
    let result = context.functionReturnTypes[function]
    pieces.add("  %result" + callPrefix(result) + context.functionIRNames[function] + "(" + call + ")\n")
    pieces.add(joinValueSlot("%result.slot", "%result", result))
    pieces.add("  %result.address = getelementptr inbounds i64, ptr %environment, i64 " + Text(count) + "\n")
    pieces.add("  store i64 %result.slot, ptr %result.address, align 8\n  ret void\n}\n")
    globals.add(joinText(pieces))
}

function joinEnvironment(output: List<Text>, textState: List<Text>, state: List<Integer>, values: List<Text>, types: List<Integer>): Text {
    let environment = "%join.environment." + Text(newLabel(state))
    output.add("  " + environment + " = alloca [" + Text(values.length + 1) + " x i64], align 8\n")
    let k = 0
    while k < values.length {
        let slot = valueAsListSlot(output, textState, state, values[k], types[k])
        let address = valueName(textState, newTemporary(state))
        output.add("  " + address + " = getelementptr inbounds i64, ptr " + environment + ", i64 " + Text(k) + "\n")
        output.add("  store i64 " + slot + ", ptr " + address + ", align 8\n")
        k = k + 1
    }
    return environment
}

function joinResult(output: List<Text>, textState: List<Text>, state: List<Integer>, environment: Text, index: Integer, type: Integer): Text {
    let address = valueName(textState, newTemporary(state))
    output.add("  " + address + " = getelementptr inbounds i64, ptr " + environment + ", i64 " + Text(index) + "\n")
    let raw = valueName(textState, newTemporary(state))
    output.add("  " + raw + " = load i64, ptr " + address + ", align 8\n")
    return slotAsValue(output, textState, state, raw, type)
}

// One managed branch: its slots, then a MinyarJoinTask (runtime/minyar_join_tasks.h)
// that starts with five words: thunk, slots, count, argument descriptor and
// result descriptor. The runtime owns the rest of its 24 words.
function joinTask(output: List<Text>, textState: List<Text>, state: List<Integer>, globals: List<Text>, thunk: Text, environment: Text, count: Integer, descriptors: List<Text>): Text {
    let task = "%join.task." + Text(newLabel(state))
    output.add("  " + task + " = alloca [24 x i64], align 8\n")
    output.add("  store ptr @" + thunk + ", ptr " + task + ", align 8\n")
    let words: List<Text> = ["ptr " + environment, "i64 " + Text(count), "ptr null", "ptr " + threadDescriptorGlobal(globals, descriptors[0])]
    if descriptors[1] != "" { words[2] = "ptr " + threadDescriptorGlobal(globals, descriptors[1]) }
    let k = 0
    while k < words.length {
        let address = valueName(textState, newTemporary(state))
        output.add("  " + address + " = getelementptr inbounds i64, ptr " + task + ", i64 " + Text(k + 1) + "\n")
        output.add("  store " + words[k] + ", ptr " + address + ", align 8\n")
        k = k + 1
    }
    return task
}

function joinTaskResult(output: List<Text>, textState: List<Text>, state: List<Integer>, task: Text, type: Integer): Text {
    let raw = valueName(textState, newTemporary(state))
    output.add("  " + raw + " = call i64 @minyar_join_task_result(ptr " + task + ")\n")
    return slotAsValue(output, textState, state, raw, type)
}

function addJoinDeclarations(globals: List<Text>, declarations: List<Text>) {
    let declaration = 0
    while declaration < declarations.length {
        if findText(globals, declarations[declaration]) < 0 { globals.add(declarations[declaration]) }
        declaration = declaration + 1
    }
}

function parseParallelJoin(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>, location: Integer): Text {
    let leftValues: List<Text> = []
    let leftTypes: List<Integer> = []
    let leftLocations: List<Integer> = []
    let left = parseJoinBranch(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, leftValues, leftTypes, leftLocations)
    expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ",")
    let rightValues: List<Text> = []
    let rightTypes: List<Integer> = []
    let rightLocations: List<Integer> = []
    let right = parseJoinBranch(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, rightValues, rightTypes, rightLocations)
    expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ")")
    let leftType = context.functionReturnTypes[left]
    let rightType = context.functionReturnTypes[right]
    let scalar = joinScalarBranch(context, globals, left, leftTypes) && joinScalarBranch(context, globals, right, rightTypes)
    let leftDescriptors: List<Text> = []
    let rightDescriptors: List<Text> = []
    if scalar {
        noteScalarJoinBranch(context, globals, left, leftTypes, leftLocations)
        noteScalarJoinBranch(context, globals, right, rightTypes, rightLocations)
    } else {
        let plainBranch = left
        if joinParallelFunction(globals, context.functionNames[left], readableDeclarationName(context.functionNames[left])) { plainBranch = right }
        if joinParallelFunction(globals, textState[1], readableDeclarationName(textState[1])) {
            failAtToken(context.tokenLines, location, "a join in parallel function '" + readableDeclarationName(textState[1]) + "' runs parallel functions with scalar results; '" + readableDeclarationName(context.functionNames[plainBranch]) + "' is not one")
        }
        joinTaskDescriptors(context, left, leftLocations[leftLocations.length - 1], leftDescriptors)
        joinTaskDescriptors(context, right, rightLocations[rightLocations.length - 1], rightDescriptors)
        if !threadMode(globals) {
            failAtToken(context.tokenLines, location, "join of ordinary functions such as '" + readableDeclarationName(context.functionNames[plainBranch]) + "' needs the thread runtime; name both callees directly in join(...)")
        }
        globals.add("; minyar-join-task: " + context.functionNames[left] + "\n")
        globals.add("; minyar-join-task: " + context.functionNames[right] + "\n")
    }
    let first = ""
    let second = ""
    if recoveryEnabled(state) {
        // Recoverable execution keeps one thread, as parallel for does.
        first = emitCall(output, textState, state, leftType, context.functionIRNames[left], leftValues, leftTypes)
        second = emitCall(output, textState, state, rightType, context.functionIRNames[right], rightValues, rightTypes)
    } else {
        let site = Text(newLabel(state))
        let owner = textState[1]
        if owner == "top level" { owner = "top.level" }
        let leftThunk = derivedSymbol(".minyar.join." + site + ".left.", owner)
        let rightThunk = derivedSymbol(".minyar.join." + site + ".right.", owner)
        joinThunk(context, globals, leftThunk, left)
        joinThunk(context, globals, rightThunk, right)
        let declarations: List<Text> = ["declare ptr @llvm.stacksave.p0()\n", "declare void @llvm.stackrestore.p0(ptr)\n"]
        if scalar { declarations.add("declare void @minyar_parallel_join(ptr, ptr, ptr, ptr)\n") }
        else {
            declarations.add("declare void @minyar_join_tasks(ptr, ptr)\n")
            declarations.add("declare i64 @minyar_join_task_result(ptr)\n")
        }
        addJoinDeclarations(globals, declarations)
        let saved = valueName(textState, newTemporary(state))
        output.add("  " + saved + " = call ptr @llvm.stacksave.p0()\n")
        let leftEnvironment = joinEnvironment(output, textState, state, leftValues, leftTypes)
        let rightEnvironment = joinEnvironment(output, textState, state, rightValues, rightTypes)
        if scalar {
            output.add("  call void @minyar_parallel_join(ptr @" + leftThunk + ", ptr " + leftEnvironment + ", ptr @" + rightThunk + ", ptr " + rightEnvironment + ")\n")
            first = joinResult(output, textState, state, leftEnvironment, leftValues.length, leftType)
            second = joinResult(output, textState, state, rightEnvironment, rightValues.length, rightType)
        } else {
            let leftTask = joinTask(output, textState, state, globals, leftThunk, leftEnvironment, leftValues.length, leftDescriptors)
            let rightTask = joinTask(output, textState, state, globals, rightThunk, rightEnvironment, rightValues.length, rightDescriptors)
            if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "runtime", "minyar_join_tasks", "5(2,2)") }
            output.add("  call void @minyar_join_tasks(ptr " + leftTask + ", ptr " + rightTask + ")\n")
            first = joinTaskResult(output, textState, state, leftTask, leftType)
            second = joinTaskResult(output, textState, state, rightTask, rightType)
        }
        output.add("  call void @llvm.stackrestore.p0(ptr " + saved + ")\n")
    }
    globals.add("; minyar-join-second: " + second + "|" + Text(rightType) + "\n")
    setType(resultType, leftType)
    return first
}

// The second binding of the `let left, right = join(...)` just compiled.
function parseJoinSecond(context: CompilerContext, state: List<Integer>, globals: List<Text>, resultType: List<Integer>, location: Integer): Text {
    expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ")")
    let prefix = "; minyar-join-second: "
    let index = globals.length - 1
    while index >= 0 && !globals[index].startsWith(prefix) { index = index - 1 }
    if index < 0 { failAtToken(context.tokenLines, location, "join results are bound by let left, right = join(...)") }
    let fields = markerValue(globals[index], prefix).split("|")
    globals[index] = ""
    setType(resultType, Integer(fields[1]))
    return fields[0]
}
