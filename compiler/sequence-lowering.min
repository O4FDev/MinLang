// Lazy recipes keep only their source. Named transforms are concrete symbols.
function sequenceRecipeKind(context: CompilerContext, type: Integer): Integer {
    if !isRecordType(type) || !isReferenceType(type) { return 0 }
    let name = context.functionNames[recordTypeIndex(type)]
    if resultPrefix(name, "minyar_sequence_map_") { return 1 }
    if resultPrefix(name, "minyar_sequence_filter_") { return 2 }
    return 0
}

function prepareSequenceSource(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, source: Text, sourceType: List<Integer>, stages: List<Integer>, location: Integer): Text {
    if sequenceRecipeKind(context, sourceType[0]) == 0 { return source }
    let recipe = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, " for recipe", sourceType[0], recipe)
    assignReference(output, state, recipe, source, sourceType, context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes)
    storeLocal(output, recipe, sourceType[0], source)
    while sequenceRecipeKind(context, sourceType[0]) != 0 {
        if stages.length >= 64 { failAtToken(context.tokenLines, location, "a lazy sequence supports at most 64 map and filter stages") }
        let record = recordTypeIndex(sourceType[0])
        let kind = sequenceRecipeKind(context, sourceType[0])
        if context.functionParameterCounts[record] != 1 { failAtToken(context.tokenLines, location, "invalid compiler-generated sequence recipe") }
        let first = functionParameterOffset(context.functionParameterCounts, record)
        let marker = context.functionParameterNames[first]
        let prefix = "minyar_sequence_map|"
        if kind == 2 { prefix = "minyar_sequence_filter|" }
        if !resultPrefix(marker, prefix) { failAtToken(context.tokenLines, location, "invalid compiler-generated sequence transform") }
        let target = sequenceNamedTransform(context, sourceType[0])
        if target < 0 { failAtToken(context.tokenLines, location, "a lazy sequence transform is unavailable") }
        let stage = target
        if kind == 2 { stage = -1 - target }
        stages.add(stage)
        let innerType = context.functionParameterTypes[first]
        source = readRecordField(output, textState, state, source, 0, innerType)
        setType(sourceType, innerType)
    }
    return source
}

function emitSequenceStages(context: CompilerContext, output: List<Text>, textState: List<Text>, state: List<Integer>, stages: List<Integer>, value: Text, resultType: List<Integer>, stepLabel: Integer, location: Integer): Text {
    if stages.length == 0 { return value }
    output.add("  ; minyar-sequence: fused map/filter stages, direct calls\n")
    let position = stages.length - 1
    let filtered = false
    while position >= 0 {
        let target = stages[position]
        let filter = target < 0
        if filter { target = -1 - target }
        let offset = functionParameterOffset(context.functionParameterCounts, target)
        if context.functionParameterCounts[target] != 1 || context.functionParameterTypes[offset] != resultType[0] { failAtToken(context.tokenLines, location, "a sequence transform has the wrong item type") }
        let types: List<Integer> = [resultType[0]]
        let arguments: List<Text> = [value]
        borrowReference(output, state, value, resultType[0], context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes)
        if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "call", context.functionNames[target], threadSignature(context.functionReturnTypes[target], types)) }
        context.callTargets.add(target)
        state[14] = state[14] + 1
        let transformed = emitCall(output, textState, state, context.functionReturnTypes[target], context.functionIRNames[target], arguments, types)
        recoveryCheckpoint(output, textState, state)
        if filter {
            filtered = true
            if context.functionReturnTypes[target] != 4 { failAtToken(context.tokenLines, location, "a sequence filter must return Boolean") }
            let keep = "sequence.keep." + Text(newLabel(state))
            output.add("  br i1 " + transformed + ", label %" + keep + ", label %for.step." + Text(stepLabel) + "\n\n" + keep + ":\n")
            textState[0] = keep
        } else {
            value = transformed
            setType(resultType, context.functionReturnTypes[target])
            ownResult(output, state, value, resultType)
        }
        position = position - 1
    }
    // A rejected item skips assignment. Preserve its temporary owner on that
    // branch instead of moving the keep into the accepted loop-local store.
    if filtered { markOwner(resultType, -1) }
    return value
}

// Decode only the existing one-source named recipe schema.
function sequenceNamedTransform(context: CompilerContext, type: Integer): Integer {
    let kind = sequenceRecipeKind(context, type)
    if kind == 0 { return -1 }
    let record = type - 1000
    if context.functionParameterCounts[record] != 1 { return -1 }
    let first = functionParameterOffset(context.functionParameterCounts, record)
    let prefix = "minyar_sequence_map|"
    if kind == 2 { prefix = "minyar_sequence_filter|" }
    let marker = context.functionParameterNames[first]
    if !resultPrefix(marker, prefix) { return -1 }
    return findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, marker.slice(prefix.length, marker.length))
}

// Unknown or modified factory bodies use the ordinary expression path.
function sequencePureFactory(context: CompilerContext, position: Integer, localNames: List<Text>, localLengths: List<Integer>, state: List<Integer>): Integer {
    if context.tokenKinds[position] != 1 || context.tokenKinds[position + 1] != 4 || context.tokenTexts[position + 1] != "(" { return -1 }
    let name = context.tokenTexts[position]
    if findLocal(localNames, localLengths, state, name) >= 0 { return -1 }
    if findCompiledSymbol(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, name, 3) >= 0 { return -1 }
    let target = findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, name)
    if target < 0 || context.functionParameterCounts[target] != 1 { return -1 }
    let recipe = context.functionReturnTypes[target]
    if sequenceNamedTransform(context, recipe) < 0 { return -1 }
    let record = recipe - 1000
    if name != context.functionNames[record] + "_make" { return -1 }
    let field = functionParameterOffset(context.functionParameterCounts, record)
    let parameter = functionParameterOffset(context.functionParameterCounts, target)
    if context.functionParameterTypes[parameter] != context.functionParameterTypes[field] { return -1 }
    let declaration = context.syntax.symbolNodes[target]
    if declaration < 0 { return -1 }
    let body = context.syntax.nodes[declaration].body
    let end = context.syntax.nodes[declaration].end
    if body < 0 || body + 8 >= end { return -1 }
    let cursor: List<Integer> = [body + 1, 0]
    skipTerminators(context.tokenKinds, cursor)
    let at = cursor[0]
    if at + 7 >= end { return -1 }
    if context.tokenKinds[at] != 1 || context.tokenKinds[at + 1] != 1 || context.tokenKinds[at + 2] != 4 || context.tokenKinds[at + 3] != 1 || context.tokenKinds[at + 4] != 4 || context.tokenKinds[at + 5] != 1 || context.tokenKinds[at + 6] != 4 { return -1 }
    if context.tokenTexts[at] != "return" || context.tokenTexts[at + 1] != context.functionNames[record] || context.tokenTexts[at + 2] != "{" || context.tokenTexts[at + 3] != context.functionParameterNames[field] || context.tokenTexts[at + 4] != ":" || context.tokenTexts[at + 5] != context.functionParameterNames[parameter] || context.tokenTexts[at + 6] != "}" { return -1 }
    cursor[0] = at + 7
    skipTerminators(context.tokenKinds, cursor)
    if cursor[0] + 1 != end || context.tokenTexts[cursor[0]] != "}" { return -1 }
    return target
}

function sequenceFactoryClosing(context: CompilerContext, position: Integer): Integer {
    let round = 0
    let square = 0
    let curly = 0
    let cursor = position + 1
    while context.tokenKinds[cursor] != 0 {
        if context.tokenKinds[cursor] == 4 {
            let token = context.tokenTexts[cursor]
            if token == "(" { round = round + 1 }
            if token == "[" { square = square + 1 }
            if token == "{" { curly = curly + 1 }
            if token == "]" { square = square - 1 }
            if token == "}" { curly = curly - 1 }
            if square < 0 || curly < 0 { return -1 }
            if token == "," && round == 1 && square == 0 && curly == 0 { return -1 }
            if token == ")" {
                round = round - 1
                if round == 0 {
                    if square != 0 || curly != 0 { return -1 }
                    return cursor
                }
            }
        }
        cursor = cursor + 1
    }
    return -1
}

function parseForSequenceSource(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, sourceType: List<Integer>, stages: List<Integer>, allowImmediate: Boolean): Text {
    if !allowImmediate || (state[15] / 4 % 2) != 0 { return parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, sourceType) }
    let factories: List<Integer> = []
    let starts: List<Integer> = []
    let closings: List<Integer> = []
    let cursor = state[0]
    let enclosing = -1
    let scanning = true
    while scanning {
        let factory = sequencePureFactory(context, cursor, localNames, localLengths, state)
        let closing = -1
        if factory >= 0 { closing = sequenceFactoryClosing(context, cursor) }
        if factory < 0 || closing <= cursor + 2 { scanning = false }
        else {
            let whole = enclosing < 0 && context.tokenKinds[closing + 1] == 4 && context.tokenTexts[closing + 1] == "{"
            if enclosing >= 0 { whole = closing + 1 == enclosing }
            if !whole { scanning = false }
            else {
                if factories.length >= 64 { failAtToken(context.tokenLines, cursor, "a lazy sequence supports at most 64 map and filter stages") }
                factories.add(factory)
                starts.add(cursor)
                closings.add(closing)
                enclosing = closing
                cursor = cursor + 2
            }
        }
    }
    if factories.length == 0 { return parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, sourceType) }
    let nodes: List<Integer> = []
    let stage = 0
    while stage < factories.length {
        nodes.add(beginSyntaxNode(context.syntax, 209, starts[stage]))
        let recipe = context.functionReturnTypes[factories[stage]]
        let target = sequenceNamedTransform(context, recipe)
        if sequenceRecipeKind(context, recipe) == 2 { target = -1 - target }
        stages.add(target)
        stage = stage + 1
    }
    state[0] = cursor
    let parameter = functionParameterOffset(context.functionParameterCounts, factories[factories.length - 1])
    setType(sourceType, context.functionParameterTypes[parameter])
    let value = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, sourceType)
    let expressionType = sourceType[0]
    stage = factories.length - 1
    while stage >= 0 {
        let factory = factories[stage]
        let first = functionParameterOffset(context.functionParameterCounts, factory)
        requireContextType(context, starts[stage] + 2, expressionType, context.functionParameterTypes[first], "an argument passed to " + readableDeclarationName(context.functionNames[factory]) + " has the wrong type")
        if state[0] != closings[stage] { failAtToken(context.tokenLines, state[0], "expected ')' after a sequence source") }
        expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ")")
        expressionType = context.functionReturnTypes[factory]
        endSyntaxNode(context.syntax, nodes[stage], state[0], expressionType)
        stage = stage - 1
    }
    output.add("  ; minyar-sequence: immediate named recipe setup removed\n")
    return value
}
