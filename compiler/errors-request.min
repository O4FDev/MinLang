function requestTypeClose(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, cursor: List<Integer>) {
    if cursor[1] > 0 { cursor[1] = cursor[1] - 1; return }
    if kinds[cursor[0]] == 4 && texts[cursor[0]] == ">>" {
        cursor[0] = cursor[0] + 1
        cursor[1] = 1
        return
    }
    expectToken(kinds, texts, lines, cursor, ">")
}
function requestReadType(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, cursor: List<Integer>): Boolean {
    if cursor[2] >= 64 { fail("Result type nesting exceeds 64") }
    if cursor[1] != 0 || kinds[cursor[0]] != 1 { fail("expected a Result payload type") }
    let name = texts[cursor[0]]
    cursor[0] = cursor[0] + 1
    if name != "Result" && name != "List" && name != "Map" && name != "Callback" { return false }
    if kinds[cursor[0]] != 4 || texts[cursor[0]] != "<" { return false }
    expectToken(kinds, texts, lines, cursor, "<")
    cursor[2] = cursor[2] + 1
    let found = requestReadType(kinds, texts, lines, cursor)
    if name == "Result" || name == "Map" {
        expectToken(kinds, texts, lines, cursor, ",")
        let second = requestReadType(kinds, texts, lines, cursor)
        found = found || second || name == "Result"
    } else {
        if name == "Callback" {
            while cursor[1] == 0 && kinds[cursor[0]] == 4 && texts[cursor[0]] == "," {
                cursor[0] = cursor[0] + 1
                let nested = requestReadType(kinds, texts, lines, cursor)
                if nested { found = true }
            }
        }
    }
    requestTypeClose(kinds, texts, lines, cursor)
    cursor[2] = cursor[2] - 1
    return found
}
function requestResultType(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, cursor: List<Integer>) {
    let position = cursor[0]
    if kinds[position] != 1 || position + 1 >= kinds.length { return }
    let name = texts[position]
    if name != "Result" && name != "List" && name != "Map" && name != "Callback" { return }
    if kinds[position + 1] != 4 || texts[position + 1] != "<" { return }
    let header: List<Integer> = [position, 0, 0]
    let found = requestReadType(kinds, texts, lines, header)
    if header[1] != 0 { fail("unexpected extra type closing delimiter") }
    if found { exit(87) }
}
function requestResultConstructor(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, cursor: List<Integer>) {
    let header: List<Integer> = [cursor[0] + 2, 0, 0]
    requestReadType(kinds, texts, lines, header)
    expectToken(kinds, texts, lines, header, ",")
    requestReadType(kinds, texts, lines, header)
    requestTypeClose(kinds, texts, lines, header)
    if header[1] != 0 { fail("unexpected extra constructor type closing delimiter") }
    expectToken(kinds, texts, lines, header, "(")
    exit(87)
}
