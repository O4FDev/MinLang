function parallelCaptureUsed(context: CompilerContext, first: Integer, after: Integer, name: Text): Boolean {
    let token = first
    while token < after {
        if context.tokenKinds[token] == 1 && context.tokenTexts[token] == name && context.tokenTexts[token - 1] != "." && context.tokenTexts[token + 1] != ":" { return true }
        token = token + 1
    }
    return false
}

function parallelCaptureCast(output: List<Text>, value: Text, raw: Text, type: Integer) {
    let cast = "add i64 " + raw + ", 0"
    if type == 7 { cast = "bitcast i64 " + raw + " to double" }
    if type == 4 { cast = "trunc i64 " + raw + " to i1" }
    if type == 3 { cast = "trunc i64 " + raw + " to i32" }
    if isReferenceType(type) { cast = "inttoptr i64 " + raw + " to ptr" }
    output.add("  " + value + " = " + cast + "\n")
}

function parallelByteCalls(text: Text): Text {
    let result: List<Text> = []
    let first = 0
    let cursor = 0
    let prefix = "@minyar_bytes_"
    while cursor + prefix.length < text.length {
        if text.slice(cursor, cursor + prefix.length) == prefix {
            let after = cursor + prefix.length
            while after < text.length && text[after] != '(' && text[after] != ' ' { after = after + 1 }
            let name = text.slice(cursor + prefix.length, after)
            if name == "get" || name == "set" || name == "length" {
                result.add(text.slice(first, cursor))
                result.add("@.minyar.bytes.parallel." + name)
                first = after
            }
            cursor = after
        } else { cursor = cursor + 1 }
    }
    result.add(text.slice(first, text.length))
    return joinText(result)
}

function parallelByteHelpers(): Text {
    return "define internal i64 @.minyar.bytes.parallel.length(ptr %bytes) alwaysinline {
entry:
  %length.pointer = getelementptr { ptr, i64 }, ptr %bytes, i32 0, i32 1
  %length = load i64, ptr %length.pointer
  ret i64 %length
}
define internal i64 @.minyar.bytes.parallel.get(ptr %bytes, i64 %position) alwaysinline {
entry:
  %length = call i64 @.minyar.bytes.parallel.length(ptr %bytes)
  %valid = icmp ult i64 %position, %length
  br i1 %valid, label %good, label %bad
good:
  %data = load ptr, ptr %bytes
  %slot = getelementptr i8, ptr %data, i64 %position
  %byte = load i8, ptr %slot
  %value = zext i8 %byte to i64
  ret i64 %value
bad:
  %fallback = call i64 @minyar_bytes_get(ptr %bytes, i64 %position)
  ret i64 %fallback
}
define internal void @.minyar.bytes.parallel.set(ptr %bytes, i64 %position, i64 %value) alwaysinline {
entry:
  %length = call i64 @.minyar.bytes.parallel.length(ptr %bytes)
  %position.valid = icmp ult i64 %position, %length
  %value.valid = icmp ult i64 %value, 256
  %valid = and i1 %position.valid, %value.valid
  br i1 %valid, label %good, label %bad
good:
  %data = load ptr, ptr %bytes
  %slot = getelementptr i8, ptr %data, i64 %position
  %byte = trunc i64 %value to i8
  store i8 %byte, ptr %slot
  ret void
bad:
  call void @minyar_bytes_set(ptr %bytes, i64 %position, i64 %value)
  ret void
}
"
}

function parallelWorkerBody(text: Text): Text {
    let result: List<Text> = []
    let first = 0
    let cursor = 0
    while cursor < text.length {
        if text[cursor] == '\n' {
            let line = text.slice(first, cursor + 1)
            // The type/effect proof rules out owned producers and reference
            // locals. Remaining ownership calls only protect caller borrows;
            // the synchronous dispatch already keeps their owners alive.
            if recoveryTextPosition(line, "@minyar_rc_") < 0 { result.add(line) }
            first = cursor + 1
        }
        cursor = cursor + 1
    }
    result.add(text.slice(first, text.length))
    return parallelByteCalls(joinText(result))
}

function outlineParallelFor(context: CompilerContext, captures: List<Text>, types: List<Integer>, ids: List<Integer>, firstLocal: Integer, start: Integer, body: Integer, parts: List<Integer>, guards: List<Integer>, parentBlock: Text, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>) {
    let bytesMarker = "; minyar-data-parallel-bytes: 1\n"
    if findText(globals, bytesMarker) < 0 { globals.add(bytesMarker); globals.add(parallelByteHelpers()) }
    let loopEnd = output.length
    textState[0] = parentBlock
    emitParallelAliasGuards(types, ids, guards, parts, state, textState, output, globals)
    let used: List<Integer> = []
    let index = context.tokenTexts[start + 2]
    let reduction = ""
    if parts[8] >= 0 { reduction = context.tokenTexts[parts[8]] }
    let capture = 0
    while capture < captures.length {
        if captures[capture] != index && captures[capture] != reduction && parallelCaptureUsed(context, body, state[0], captures[capture]) {
            if !parallelScalar(types[capture]) && !parallelBuffer(types[capture]) { parallelRace(context, body, "only scalars and scalar buffers can be captured") }
            used.add(capture)
        }
        capture = capture + 1
    }
    if used.length > 64 { parallelRace(context, start, "this loop captures more than 64 values; split the work into smaller loops") }
    let workerName = "@.minyar.parallel." + Text(start)
    let worker: List<Text> = []
    let parentTypes = context.debugTypes
    let workerTypes: List<Integer> = []
    context.debugTypes = workerTypes
    let returned = "void"
    if parts[6] >= 0 { returned = "i64" }
    recordRuntimeTrace(context, ".minyar.parallel." + Text(start), "parallel loop", start, false)
    emitDebugOrigin(worker, context.tokenLines, start, "function")
    worker.add("define internal " + returned + " " + workerName + "(i64 %parallel.first, i64 %parallel.after, ptr %parallel.environment) uwtable {\nentry:\n")
    let debugType = 0
    while debugType < parentTypes.length {
        emitDebugType(context, worker, parentTypes[debugType])
        debugType = debugType + 1
    }
    if parts[6] >= 0 { worker.add("  %local." + Text(parts[6]) + " = alloca i64\n") }
    let local = firstLocal
    while local < state[4] {
        worker.add("  %local." + Text(local) + " = alloca i64\n")
        local = local + 1
    }
    let position = 0
    while position < used.length {
        capture = used[position]
        let id = ids[capture]
        let type = types[capture]
        let number = Text(position)
        if id >= 0 { worker.add("  %local." + Text(id) + " = alloca i64\n") }
        worker.add("  %parallel.slot." + number + " = getelementptr i64, ptr %parallel.environment, i64 " + number + "\n")
        let raw = "%parallel.raw." + number
        worker.add("  " + raw + " = load i64, ptr %parallel.slot." + number + "\n")
        let value = "%parallel.capture." + number
        if id < 0 { value = output[-id - 1] }
        if value.length > 0 && value[0] == '%' {
            parallelCaptureCast(worker, value, raw, type)
            if id >= 0 {
                storeLocal(worker, id, type, value)
                emitDebugBinding(context, worker, start, captures[capture], type, "ptr %local." + Text(id), 0, true)
            } else {
                emitDebugBinding(context, worker, start, captures[capture], type, llvmType(type) + " " + value, 0, false)
            }
        }
        position = position + 1
    }
    storeLocal(worker, parts[1], 1, "%parallel.first")
    storeLocal(worker, parts[2], 1, "%parallel.after")
    if parts[6] >= 0 {
        let zero = "0"
        if parts[7] == 7 { zero = "0.0" }
        storeLocal(worker, parts[6], parts[7], zero)
        if parts[8] >= 0 && reduction != "" { emitDebugBinding(context, worker, parts[8], reduction, parts[7], "ptr %local." + Text(parts[6]), 0, true) }
    }
    let loop: List<Text> = []
    let piece = parts[0]
    while piece < loopEnd {
        loop.add(output[piece])
        output[piece] = ""
        piece = piece + 1
    }
    worker.add(parallelWorkerBody(joinText(loop)))
    if parts[6] >= 0 {
        let value = loadLocal(worker, textState, state, parts[6], parts[7])
        let raw = valueAsListSlot(worker, textState, state, value, parts[7])
        worker.add("  ret i64 " + raw + "\n}\n\n")
    } else { worker.add("  ret void\n}\n\n") }
    context.debugTypes = parentTypes
    globals.add(joinText(worker))
    let declaration = "declare void @minyar_parallel_run(ptr, i64, i64, ptr)\n"
    if parts[6] >= 0 { declaration = "declare i64 @minyar_parallel_reduce(ptr, i64, i64, ptr, i64, i64)\n" }
    if findText(globals, declaration) < 0 { globals.add(declaration) }
    let marker = "; minyar-data-parallel-runtime: 1\n"
    if findText(globals, marker) < 0 { globals.add(marker) }
    textState[0] = parentBlock
    let environment = "null"
    if used.length > 0 {
        environment = "%parallel.environment." + Text(newLabel(state))
        // finishFunctionEntry moves this to the entry block, so an enclosing
        // serial loop cannot grow the native stack on each dispatch.
        output.add("  " + environment + " = alloca [" + Text(used.length) + " x i64], align 8\n")
        position = 0
        while position < used.length {
            capture = used[position]
            let value = loadLocal(output, textState, state, ids[capture], types[capture])
            let raw = valueAsListSlot(output, textState, state, value, types[capture])
            let slot = emitInstruction(output, textState, state, "getelementptr i64, ptr " + environment + ", i64 " + Text(position))
            output.add("  store i64 " + raw + ", ptr " + slot + "\n")
            position = position + 1
        }
    }
    let first = loadLocal(output, textState, state, parts[1], 1)
    let after = loadLocal(output, textState, state, parts[2], 1)
    if parts[6] >= 0 {
        let initial = loadLocal(output, textState, state, parts[6], parts[7])
        let bits = valueAsListSlot(output, textState, state, initial, parts[7])
        let raw = emitInstruction(output, textState, state, "call i64 @minyar_parallel_reduce(ptr " + workerName + ", i64 " + first + ", i64 " + after + ", ptr " + environment + ", i64 " + Text(parts[7]) + ", i64 " + bits + ")")
        let value = slotAsValue(output, textState, state, raw, parts[7])
        storeLocal(output, parts[6], parts[7], value)
    } else {
        output.add("  call void @minyar_parallel_run(ptr " + workerName + ", i64 " + first + ", i64 " + after + ", ptr " + environment + ")\n")
    }
}

function hoistParallelStorage(output: List<Text>, slot: Integer, entry: List<Text>) {
    let prefix = "  %parallel.environment."
    let piece = slot + 1
    while piece < output.length {
        let text = output[piece]
        if text.length > prefix.length && text.slice(0, prefix.length) == prefix && recoveryTextPosition(text, " = alloca [") >= 0 {
            entry.add(text)
            output[piece] = ""
        }
        piece = piece + 1
    }
}
