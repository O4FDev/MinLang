// `deterministic function` promises that a call's behavior depends only on its
// arguments. The audit proves that no host clock, randomness, file, network,
// process, environment, thread or unclassified native code is reachable from
// the function in the final module. Safe `parallel for` loops are allowed:
// their results do not depend on the schedule. It reads the same LLVM text that is
// compiled, so generic instantiations, closures, contract helpers and global
// initializers are covered without a separate effect type system. It adds no
// runtime code. Module contents that code outside the function mutates and
// resource exhaustion (memory, stack) are outside this proof.
function isDeterministicFunctionAt(kinds: List<Integer>, texts: List<Text>, position: Integer): Boolean {
    if position < 1 || kinds[position] != 1 || texts[position] != "function" { return false }
    let previous = position - 1
    if texts[previous] == "public" { previous = previous - 1 }
    return previous >= 0 && kinds[previous] == 6 && texts[previous] == "deterministic"
}

function collectDeterministicRoots(context: CompilerContext, roots: List<Integer>, origins: List<Integer>) {
    let kinds = context.tokenKinds
    let texts = context.tokenTexts
    let lines = context.tokenLines
    let position = 1
    while position + 2 < kinds.length {
        if texts[position] == "function" && isDeterministicFunctionAt(kinds, texts, position) {
            if kinds[position + 1] != 1 || texts[position + 1] == "(" { failAtToken(lines, position, "a deterministic function needs a name") }
            let symbol = findCompiledSymbol(context.functionNames, context.symbolKinds, lines.symbolLookup, texts[position + 1], 1)
            if symbol < 0 { failAtToken(lines, position + 1, "a deterministic function needs its own ordinary function declaration") }
            if determinismNativeLibrary(context, symbol) != "" { failAtToken(lines, position + 1, "a native function cannot be deterministic; mark the Minyar function that calls it") }
            roots.add(symbol)
            origins.add(position + 1)
        }
        position = position + 1
    }
}

// The final module as bytes. LLVM text is ASCII outside c"..." constants, so
// byte offsets are positions; inlined Bytes reads keep the scan linear and cheap.
// Byte values: '\n' 10, ' ' 32, '"' 34, '%' 37, '(' 40, ')' 41, ',' 44,
// '<' 60, '>' 62, '@' 64, '[' 91, ']' 93, 'c' 99, '{' 123, '}' 125.
record DeterminismModule {
    code: Bytes
    text: Text
    ascii: Boolean
    names: List<Text>
    kinds: List<Integer>
    nameStarts: List<Integer>
    nameEnds: List<Integer>
    starts: List<Integer>
    ends: List<Integer>
    signatures: List<Text>
    addressTaken: List<Boolean>
    addressReady: Boolean
    collectionCallbacks: List<Integer>
    collectionReady: Boolean
    buckets: List<Integer>
    sourceSymbols: List<Integer>
}

function determinismNameByte(byte: Integer): Boolean {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 46 || byte == 95 || byte == 36 || byte == 45
}

// The position after the symbol that starts at code[at] == '@'.
function determinismNameEnd(code: Bytes, at: Integer): Integer {
    let position = at + 1
    if position < code.length && code[position] == 34 {
        position = position + 1
        while position < code.length && code[position] != 34 && code[position] != 10 { position = position + 1 }
        return position + 1
    }
    while position < code.length && determinismNameByte(code[position]) { position = position + 1 }
    return position
}

// The symbol's characters without '@' or quotes.
function determinismNameFirst(code: Bytes, at: Integer, end: Integer): Integer {
    if at + 1 < end && code[at + 1] == 34 { return at + 2 }
    return at + 1
}

function determinismNameLast(code: Bytes, at: Integer, end: Integer): Integer {
    if at + 1 < end && code[at + 1] == 34 { return end - 1 }
    return end
}

// LLVM text is normally ASCII, where byte offsets are character offsets.
function determinismText(module: DeterminismModule, first: Integer, last: Integer): Text {
    if module.ascii { return module.text.slice(first, last) }
    let parts: List<Text> = []
    let position = first
    while position < last {
        parts.add(Text(Character(module.code[position])))
        position = position + 1
    }
    return joinText(parts)
}

// Skip a c"..." constant so source text kept for traces is never read as code.
function determinismSkipString(code: Bytes, position: Integer): Integer {
    if code[position] == 99 && position + 1 < code.length && code[position + 1] == 34 {
        let end = position + 2
        while end < code.length && code[end] != 34 && code[end] != 10 { end = end + 1 }
        return end + 1
    }
    return position
}

function determinismLineEnd(code: Bytes, position: Integer): Integer {
    let end = position
    while end < code.length && code[end] != 10 { end = end + 1 }
    return end
}

function determinismStartsWith(code: Bytes, position: Integer, prefix: Text): Boolean {
    if position + prefix.length > code.length { return false }
    let index = 0
    while index < prefix.length {
        if code[position + index] != Integer(prefix[index]) { return false }
        index = index + 1
    }
    return true
}

function determinismFindByte(code: Bytes, start: Integer, end: Integer, wanted: Integer): Integer {
    let position = start
    while position < end {
        if code[position] == wanted { return position }
        position = position + 1
    }
    return -1
}

// The end of the definition whose header line ends at `lineEnd`: the first
// following line that holds only '}'.
function determinismDefinitionEnd(code: Bytes, lineEnd: Integer): Integer {
    let position = lineEnd
    while position + 2 < code.length {
        if code[position] == 10 && code[position + 1] == 125 && code[position + 2] == 10 { return position + 2 }
        position = position + 1
    }
    return code.length
}

// The last word before `end`: the result type of `define T @f` or `call T @f`.
function determinismWordBefore(module: DeterminismModule, end: Integer): Text {
    let code = module.code
    let last = end
    while last > 0 && code[last - 1] == 32 { last = last - 1 }
    let first = last
    while first > 0 && code[first - 1] != 32 { first = first - 1 }
    return determinismText(module, first, last)
}

// Argument or parameter types inside code[open] == '(' .. its ')': the first
// word of each top-level comma-separated item.
function determinismTypes(module: DeterminismModule, open: Integer): Text {
    let code = module.code
    let parts: List<Text> = []
    let depth = 0
    let position = open + 1
    let itemStart = position
    let done = false
    while position < code.length && !done {
        let byte = code[position]
        if byte == 40 || byte == 123 || byte == 91 || byte == 60 { depth = depth + 1 }
        if (byte == 41 || byte == 125 || byte == 93 || byte == 62) && depth > 0 {
            depth = depth - 1
        } else {
            if (byte == 44 && depth == 0) || byte == 41 {
                let first = itemStart
                while first < position && code[first] == 32 { first = first + 1 }
                let last = first
                while last < position && code[last] != 32 { last = last + 1 }
                if last > first {
                    if parts.length > 0 { parts.add(",") }
                    parts.add(determinismText(module, first, last))
                }
                itemStart = position + 1
                if byte == 41 { done = true }
            }
        }
        position = position + 1
    }
    return joinText(parts)
}

function determinismHash(code: Bytes, first: Integer, last: Integer): Integer {
    let hash = 5381
    let position = first
    while position < last {
        hash = (hash * 65599 + code[position]) % 2147483647
        position = position + 1
    }
    return hash
}

// The symbol spelled by code[first..last), or -1.
function determinismLookup(module: DeterminismModule, first: Integer, last: Integer): Integer {
    let code = module.code
    let capacity = module.buckets.length
    let bucket = determinismHash(code, first, last) % capacity
    let symbol = module.buckets[bucket]
    while symbol >= 0 {
        let start = module.nameStarts[symbol]
        if module.nameEnds[symbol] - start == last - first {
            let same = true
            let offset = 0
            while same && offset < last - first {
                if code[start + offset] != code[first + offset] { same = false }
                offset = offset + 1
            }
            if same { return symbol }
        }
        bucket = (bucket + 1) % capacity
        symbol = module.buckets[bucket]
    }
    return -1
}

function determinismLookupName(module: DeterminismModule, name: Text): Integer {
    let wanted = Bytes(name)
    let capacity = module.buckets.length
    let bucket = determinismHash(wanted, 0, wanted.length) % capacity
    let symbol = module.buckets[bucket]
    while symbol >= 0 {
        if module.names[symbol] == name { return symbol }
        bucket = (bucket + 1) % capacity
        symbol = module.buckets[bucket]
    }
    return -1
}

function parseDeterminismModule(context: CompilerContext, output: List<Text>): DeterminismModule {
    let text = joinText(output)
    let code = Bytes(text)
    let module = DeterminismModule { code: code, text: text, ascii: code.length == text.length, names: [], kinds: [], nameStarts: [], nameEnds: [], starts: [], ends: [], signatures: [], addressTaken: [], addressReady: false, collectionCallbacks: [], collectionReady: false, buckets: [], sourceSymbols: [] }
    let position = 0
    while position < code.length {
        let lineEnd = determinismLineEnd(code, position)
        let kind = 0
        let at = -1
        if code[position] == 64 { kind = 2; at = position }
        if code[position] == 100 && determinismStartsWith(code, position, "define ") { kind = 1 }
        if code[position] == 100 && determinismStartsWith(code, position, "declare ") { kind = 3 }
        if kind == 1 || kind == 3 { at = determinismFindByte(code, position, lineEnd, 64) }
        if at >= 0 {
            let nameEnd = determinismNameEnd(code, at)
            let first = determinismNameFirst(code, at, nameEnd)
            let last = determinismNameLast(code, at, nameEnd)
            module.names.add(determinismText(module, first, last))
            module.nameStarts.add(first)
            module.nameEnds.add(last)
            module.kinds.add(kind)
            let signature = ""
            if kind != 2 && nameEnd < lineEnd && code[nameEnd] == 40 { signature = determinismWordBefore(module, at) + "(" + determinismTypes(module, nameEnd) }
            module.signatures.add(signature)
            module.addressTaken.add(false)
            module.sourceSymbols.add(-1)
            module.starts.add(position)
            let end = lineEnd
            if kind == 1 { end = determinismDefinitionEnd(code, lineEnd) }
            module.ends.add(end)
            position = end
        }
        position = determinismLineEnd(code, position) + 1
    }
    let capacity = 8
    while capacity < module.names.length * 2 { capacity = capacity * 2 }
    let bucket = 0
    while bucket < capacity { module.buckets.add(-1); bucket = bucket + 1 }
    let index = 0
    while index < module.names.length {
        if determinismLookup(module, module.nameStarts[index], module.nameEnds[index]) < 0 {
            bucket = determinismHash(code, module.nameStarts[index], module.nameEnds[index]) % capacity
            while module.buckets[bucket] >= 0 { bucket = (bucket + 1) % capacity }
            module.buckets[bucket] = index
        }
        index = index + 1
    }
    // Map final symbols back to source declarations for readable names and
    // native classification.
    let symbol = 0
    while symbol < context.functionIRNames.length {
        if context.symbolKinds[symbol] == 1 {
            let found = determinismLookupName(module, context.functionIRNames[symbol])
            if found >= 0 { module.sourceSymbols[found] = symbol }
        }
        symbol = symbol + 1
    }
    return module
}

// A Map stores its key's hash, equality and copy functions when it is created,
// possibly by the caller, and the runtime calls them during every operation.
// Any reachable Map operation therefore may reach every registered callback.
function determinismCollectionCallbacks(module: DeterminismModule): List<Integer> {
    if module.collectionReady { return module.collectionCallbacks }
    module.collectionReady = true
    let code = module.code
    let index = 0
    while index < module.names.length {
        if module.kinds[index] == 1 {
            let scan = determinismLineEnd(code, module.starts[index])
            while scan < module.ends[index] {
                if code[scan] == 64 && determinismStartsWith(code, scan, "@minyar_map_new_record(") {
                    // Quoted callback names can contain ')', so stop only outside names.
                    let close = determinismLineEnd(code, scan)
                    let argument = scan + 23
                    while argument < close {
                        if code[argument] == 41 {
                            close = argument
                        } else if code[argument] == 64 {
                            let end = determinismNameEnd(code, argument)
                            let target = determinismLookup(module, determinismNameFirst(code, argument, end), determinismNameLast(code, argument, end))
                            if target >= 0 && module.kinds[target] == 1 { module.collectionCallbacks.add(target) }
                            argument = end
                        } else {
                            argument = argument + 1
                        }
                    }
                    scan = close
                } else {
                    scan = scan + 1
                }
            }
        }
        index = index + 1
    }
    return module.collectionCallbacks
}

// A function whose address is taken anywhere may be the target of any
// indirect call with its signature. Computed once, on the first indirect call.
function determinismAddressTaken(module: DeterminismModule) {
    if module.addressReady { return }
    module.addressReady = true
    let code = module.code
    let index = 0
    while index < module.names.length {
        if module.kinds[index] != 3 {
            let scan = module.starts[index]
            if module.kinds[index] == 1 { scan = determinismLineEnd(code, scan) }
            while scan < module.ends[index] {
                let skipped = determinismSkipString(code, scan)
                if skipped != scan { scan = skipped } else if code[scan] == 64 {
                    let end = determinismNameEnd(code, scan)
                    let target = determinismLookup(module, determinismNameFirst(code, scan, end), determinismNameLast(code, scan, end))
                    if target >= 0 && module.kinds[target] == 1 && !(end < code.length && code[end] == 40) { module.addressTaken[target] = true }
                    scan = end
                } else {
                    scan = scan + 1
                }
            }
        }
        index = index + 1
    }
}


// The library of a function declared with a `native "library"` body, or "".
function determinismNativeLibrary(context: CompilerContext, symbol: Integer): Text {
    if symbol < 0 || symbol >= context.syntax.symbolNodes.length || context.symbolKinds[symbol] != 1 { return "" }
    let declaration = context.syntax.symbolNodes[symbol]
    if declaration < 0 { return "" }
    let body = context.syntax.nodes[declaration].body
    if body < 0 { return "" }
    while body < context.tokenKinds.length && (context.tokenKinds[body] == 6 || (context.tokenKinds[body] == 4 && context.tokenTexts[body] == "{")) { body = body + 1 }
    if body + 1 < context.tokenKinds.length && context.tokenKinds[body] == 1 && context.tokenTexts[body] == "native" && context.tokenKinds[body + 1] == 3 {
        return context.tokenTexts[body + 1]
    }
    return ""
}

// A native's Minyar declaration, such as "unicode.graphemeCount(Text): Integer".
function determinismNativeSignature(context: CompilerContext, symbol: Integer, library: Text): Text {
    let parts: List<Text> = [library, ".", readableDeclarationName(context.functionNames[symbol]), "("]
    let first = functionParameterOffset(context.functionParameterCounts, symbol)
    let index = 0
    while index < context.functionParameterCounts[symbol] {
        if index > 0 { parts.add(", ") }
        parts.add(describeType(context.functionParameterTypes[first + index]))
        index = index + 1
    }
    parts.add("): ")
    parts.add(describeType(context.functionReturnTypes[symbol]))
    return joinText(parts)
}

// Pure computations over their arguments, by exact library, name and
// declaration: a native redeclared with another signature (for example one
// returning a pointer as an Integer) stays outside the proof, as does
// everything not listed here.
function determinismNativeAllowed(signature: Text): Boolean {
    let unary = ["sqrt", "sin", "cos", "tan", "asin", "acos", "atan", "exp", "log", "floor", "ceil", "round"]
    let index = 0
    while index < unary.length {
        if signature == "runtime." + unary[index] + "(Float): Float" { return true }
        index = index + 1
    }
    let allowed = [
        "runtime.atan2(Float, Float): Float", "runtime.pow(Float, Float): Float", "runtime.jsonNumber(Text): Float",
        // text.decode's check: Bytes to Maybe<Text> (described as a record).
        "runtime.utf8Text(Bytes): a record", "runtime.decodeOrStop(Bytes): Text",
        "unicode.unicodeVersion(): Text", "unicode.unicodeBoundaries(Text): Bytes", "unicode.graphemeCount(Text): Integer",
        "unicode.normalized(Text): Text", "unicode.caseFold(Text): Text", "unicode.uppercased(Text): Text", "unicode.lowercased(Text): Text",
        "aes.encrypt(Bytes, Bytes, Bytes, Bytes): Bytes", "aes.decrypt(Bytes, Bytes, Bytes, Bytes): Bytes", "aes.block(Bytes, Bytes): Bytes",
        "securecrypto.x25519(Bytes, Bytes): Bytes", "securecrypto.chacha20(Bytes, Integer, Bytes, Bytes): Bytes",
        "securecrypto.poly1305(Bytes, Bytes): Bytes", "securecrypto.seal(Bytes, Bytes, Bytes, Bytes): Bytes",
        "securecrypto.open(Bytes, Bytes, Bytes, Bytes): Bytes", "securecrypto.equal(Bytes, Bytes): Boolean",
        "integer_overflow.addOverflows(Integer, Integer): Boolean", "integer_overflow.subtractOverflows(Integer, Integer): Boolean",
        "integer_overflow.multiplyOverflows(Integer, Integer): Boolean"
    ]
    return findText(allowed, signature) >= 0
}

function determinismNativeEffect(library: Text, name: Text): Text {
    if name == "wallClockMicroseconds" || name == "monotonicNanoseconds" { return "the host clock" }
    if library == "runtime" && name == "bytes" { return "host randomness" }
    if name == "argument" || name == "argumentCount" { return "the program's arguments" }
    if name == "getenv" || name == "environmentEntries" { return "the process environment" }
    if name == "processId" { return "the process ID" }
    if name == "sleepNanoseconds" { return "real time" }
    if library == "runtime" || library == "files" { return "host files" }
    if library == "net" || library == "http" || library == "quicinteropio" || library == "tlsverify" || library == "schannel" { return "the network" }
    if library == "workers" || library == "completionio" || library == "callbackruntime" || library == "protocol" || library == "protocol_completion" { return "host threads and I/O completions" }
    if library == "system" { return "the operating system" }
    if library == "machine" || library == "machine_arm64" || library == "dma" || library == "dma_model" || library == "dma_queue" || library == "dma_pending" || library == "dma_cpu" { return "machine hardware" }
    if library == "calldepth" { return "the host stack size" }
    return "native code"
}

function determinismRuntimeEffect(name: Text): Text {
    if resultPrefix(name, "minyar_thread_") || resultPrefix(name, "minyar_native_thread_") || resultPrefix(name, "minyar_frozen_") || resultPrefix(name, "minyar_bytes_channel_") { return "threads" }
    if resultPrefix(name, "minyar_native_region") || resultPrefix(name, "minyar_machine_") || resultPrefix(name, "minyar_interrupt") || resultPrefix(name, "minyar_irq") || resultPrefix(name, "minyar_dma") { return "machine hardware" }
    if name == "minyar_initialize_arguments" { return "the program's arguments" }
    if resultPrefix(name, "minyar_calldepth_") { return "the host stack size" }
    if name == "minyar_compiler_try" { return "native code" }
    if name == "minyar_c_record_at" { return "raw memory addresses" }
    if determinismRuntimePure(name) { return "" }
    return "an unclassified runtime function"
}

// Runtime families that compute only from their arguments and managed memory.
// Anything not listed fails closed until it is classified here;
// tests/determinism-runtime.py fails when the compiler can emit a runtime
// function that neither list classifies.
function determinismRuntimePure(name: Text): Boolean {
    let families = ["minyar_rc_", "minyar_list_", "minyar_bytes_", "minyar_text_", "minyar_texts_", "minyar_join_text", "minyar_record_", "minyar_map_", "minyar_maps_", "minyar_integer_", "minyar_float_", "minyar_character_", "minyar_boolean_", "minyar_print_", "minyar_check_", "minyar_fail", "minyar_c_record_", "minyar_trace_", "minyar_recovery_", "minyar_boundary_", "minyar_sort"]
    let index = 0
    while index < families.length {
        if resultPrefix(name, families[index]) { return true }
        index = index + 1
    }
    // Safe parallel loops give the same result on every schedule and thread
    // count: each iteration writes only its own index, captures are snapshots,
    // and reductions combine per-chunk results in chunk order; the alias and
    // window checks depend only on which buffers alias. The loop body is
    // passed by address, so the audit reaches and checks it like any callee.
    let names = ["minyar_parallel_run", "minyar_parallel_reduce", "minyar_parallel_no_alias", "minyar_parallel_bytes_no_overlap", "minyar_parallel_bytes_list_no_overlap", "minyar_parallel_record_list_guard", "minyar_parallel_window_stop", "minyar_interpolate", "minyar_exit", "minyar_stack_enter", "minyar_stack_leave", "minyar_callback_check", "minyar_callback_check_environment", "minyar_callback_domain", "minyar_compare_slots", "minyar_equal_slots", "minyar_hash_slot", "minyar_constant_initialization_fail"]
    return findText(names, name) >= 0
}

function determinismExternalEffect(name: Text): Text {
    if resultPrefix(name, "minyar_") { return determinismRuntimeEffect(name) }
    if resultPrefix(name, "llvm.") {
        if resultPrefix(name, "llvm.readcyclecounter") || resultPrefix(name, "llvm.readsteadycounter") || resultPrefix(name, "llvm.x86.rdtsc") { return "the processor's cycle counter" }
        if resultPrefix(name, "llvm.x86.rdrand") || resultPrefix(name, "llvm.x86.rdseed") || resultPrefix(name, "llvm.aarch64.rndr") { return "hardware randomness" }
        if resultPrefix(name, "llvm.read_register") || resultPrefix(name, "llvm.read_volatile_register") || resultPrefix(name, "llvm.thread.pointer") { return "machine registers" }
        return ""
    }
    // _setjmp: the jump target of boundary.run, saving only registers.
    if name == "memcpy" || name == "memmove" || name == "memset" || name == "memcmp" || name == "malloc" || name == "calloc" || name == "realloc" || name == "free" || name == "abort" || name == "_setjmp" { return "" }
    return "native code"
}

function determinismHelp(effect: Text): Text {
    if effect == "the host clock" || effect == "real time" { return "use the simulation World's virtual time (simulation.now or simulation.wallTime) and pass the World in" }
    if effect == "host randomness" || effect == "hardware randomness" { return "draw choices from the simulation World with simulation.choose, so a seed reproduces them" }
    if effect == "host files" { return "route storage through the simulation World (simulation.openFile, submitWrite, submitSync) or another facade passed in as a parameter" }
    if effect == "the network" { return "send messages through the simulation World (simulation.submitPacket) instead of host sockets" }
    if effect == "the program's arguments" || effect == "the process environment" || effect == "the process ID" { return "read it in the caller and pass the value in as a parameter" }
    if effect == "raw memory addresses" { return "addresses change from run to run; keep cAddress, cAt and parallelEntry in the caller" }
    if effect == "threads" || effect == "host threads and I/O completions" { return "keep scheduling inside the function, for example with simulation.choose; run independent universes in separate calls or processes" }
    return "keep this call in the caller, or move a pure Minyar version of it inside the deterministic boundary"
}


// Methods are compiled as Record$method or Record$method$private.
function determinismMethodName(name: Text): Text {
    let readable = name
    let suffix = "$private"
    if readable.length > suffix.length && readable.slice(readable.length - suffix.length, readable.length) == suffix { readable = readable.slice(0, readable.length - suffix.length) }
    let dollar = findCharacter(readable, '$')
    if dollar > 0 { return readable.slice(0, dollar) + "." + readable.slice(dollar + 1, readable.length) }
    return readable
}

function determinismReadable(context: CompilerContext, module: DeterminismModule, index: Integer): Text {
    let symbol = module.sourceSymbols[index]
    if symbol >= 0 { return determinismMethodName(readableDeclarationName(context.functionNames[symbol])) }
    let name = module.names[index]
    if resultPrefix(name, ".minyar.closure.") || resultPrefix(name, "\".minyar.closure.") { return "an anonymous function" }
    // A named function passed as a value forwards through `.minyar.value|<callee>`.
    let forward = ".minyar.value|"
    if resultPrefix(name, forward) {
        let target = determinismLookupName(module, name.slice(forward.length, name.length))
        if target >= 0 && target != index { return determinismReadable(context, module, target) }
    }
    if resultPrefix(name, ".minyar.derived.hash") { return "a Map key's hash" }
    if resultPrefix(name, ".minyar.derived.equal") { return "a Map key's equality" }
    if resultPrefix(name, ".minyar.derived.copy") { return "a Map key's copy" }
    if resultPrefix(name, ".minyar.derived.compare|") {
        // `.minyar.derived.compare|<type>|...`: the record whose order is compared.
        let first = ".minyar.derived.compare|".length
        let end = first
        while end < name.length && name[end] != '|' { end = end + 1 }
        let type = 0
        let digit = first
        while digit < end { type = type * 10 + findCharacter("0123456789", name[digit]); digit = digit + 1 }
        if isRecordType(type) && recordTypeIndex(type) < context.functionNames.length { return "the ordering of " + readableDeclarationName(context.functionNames[recordTypeIndex(type)]) }
        return "an ordering"
    }
    let constant = "minyar.constant|"
    if resultPrefix(name, constant) {
        let end = constant.length
        while end < name.length && name[end] != '|' { end = end + 1 }
        return "global " + readableDeclarationName(name.slice(constant.length, end))
    }
    return name
}

record DeterminismSearch {
    parents: List<Integer>
    indirectEdges: List<Boolean>
    queue: List<Integer>
    indirect: List<Text>
    collections: Boolean
    effect: Text
    detail: Text
    at: Integer
}

function determinismReach(search: DeterminismSearch, target: Integer, from: Integer, indirect: Boolean) {
    if search.parents[target] != -2 { return }
    search.parents[target] = from
    search.indirectEdges[target] = indirect
    search.queue.add(target)
}

function determinismViolation(search: DeterminismSearch, effect: Text, detail: Text, at: Integer) {
    if search.effect != "" { return }
    search.effect = effect
    search.detail = detail
    search.at = at
}

// "called from NAME (path:line, column N); " for whatever makes the offending
// call: a source function with its declaration, or a global initializer or
// anonymous function by name.
function determinismWhere(context: CompilerContext, module: DeterminismModule, search: DeterminismSearch): Text {
    let step = search.at
    if search.detail != "" && search.detail[0] == '(' && step >= 0 { step = search.parents[step] }
    if step < 0 { return "" }
    let readable = determinismReadable(context, module, step)
    let symbol = module.sourceSymbols[step]
    if symbol < 0 || symbol >= context.syntax.symbolNodes.length || context.syntax.symbolNodes[symbol] < 0 { return "called from " + readable + "; " }
    let token = context.syntax.nodes[context.syntax.symbolNodes[symbol]].start + 1
    return "called from " + readable + " (" + tokenLocation(context.tokenLines, token) + "); "
}

// A call through a `deterministic (A) -> B` value: the compiler writes the
// line `  ; minyar-deterministic-call` just before it. Every such value was
// proved where it was made (auditDeterministicRoots), so the call adds nothing.
function determinismTrustedCall(code: Bytes, position: Integer): Boolean {
    let lineStart = position
    while lineStart > 0 && code[lineStart - 1] != 10 { lineStart = lineStart - 1 }
    if lineStart < 2 { return false }
    let previous = lineStart - 1
    while previous > 0 && code[previous - 1] != 10 { previous = previous - 1 }
    return determinismStartsWith(code, previous, "  ; minyar-deterministic-call\n")
}

// An indirect call `call T %callee(types...)` may reach every address-taken
// function with the same result and parameter types.
function determinismIndirectCall(module: DeterminismModule, search: DeterminismSearch, index: Integer, position: Integer) {
    let code = module.code
    let open = determinismFindByte(code, position, determinismLineEnd(code, position), 40)
    if open <= 0 { return }
    let callee = determinismWordBefore(module, open)
    if callee.length == 0 || callee[0] != '%' { return }
    if determinismTrustedCall(code, position) { return }
    let signature = determinismWordBefore(module, open - callee.length) + "(" + determinismTypes(module, open)
    if findText(search.indirect, signature) >= 0 { return }
    search.indirect.add(signature)
    determinismAddressTaken(module)
    let candidate = 0
    while candidate < module.names.length {
        if module.addressTaken[candidate] && module.signatures[candidate] == signature { determinismReach(search, candidate, index, true) }
        candidate = candidate + 1
    }
}

// Scan one reachable definition or global initializer.
function determinismScan(context: CompilerContext, module: DeterminismModule, search: DeterminismSearch, index: Integer) {
    let code = module.code
    let symbol = module.sourceSymbols[index]
    let library = determinismNativeLibrary(context, symbol)
    // boundary.run/runWith are generated Minyar code (minyar_boundary_* runtime
    // calls, _setjmp and the indirect call to the body): scan them like any
    // function. Whether a body stops depends only on the program.
    if library != "" && library != "boundary" {
        let name = readableDeclarationName(context.functionNames[symbol])
        if !determinismNativeAllowed(determinismNativeSignature(context, symbol, library)) {
            determinismViolation(search, determinismNativeEffect(library, name), "(native \"" + library + "\")", index)
        }
        return
    }
    let position = module.starts[index]
    let end = module.ends[index]
    let definition = module.kinds[index] == 1
    if definition { position = determinismLineEnd(code, position) }
    while position < end && search.effect == "" {
        let byte = code[position]
        let skipped = determinismSkipString(code, position)
        if skipped != position { position = skipped } else if byte == 64 {
            let nameEnd = determinismNameEnd(code, position)
            let target = determinismLookup(module, determinismNameFirst(code, position, nameEnd), determinismNameLast(code, position, nameEnd))
            if target >= 0 {
                if module.kinds[target] == 3 {
                    let effect = determinismExternalEffect(module.names[target])
                    let detail = module.names[target]
                    if detail == "minyar_c_record_at" { detail = "cAt" }
                    if effect != "" { determinismViolation(search, effect, detail, index) }
                    if !search.collections && resultPrefix(module.names[target], "minyar_map") {
                        search.collections = true
                        let callbacks = determinismCollectionCallbacks(module)
                        let callback = 0
                        while callback < callbacks.length {
                            determinismReach(search, callbacks[callback], index, true)
                            callback = callback + 1
                        }
                    }
                } else {
                    determinismReach(search, target, index, false)
                }
            }
            position = nameEnd
        } else {
            // Instruction words follow a space: `asm `, `volatile `, `call `.
            // The compiler marks operations that turn an address into an Integer.
            if definition && byte == 59 && determinismStartsWith(code, position, "; minyar-raw-address: ") {
                let lineEnd = determinismLineEnd(code, position)
                determinismViolation(search, "raw memory addresses", determinismText(module, position + 22, lineEnd), index)
            }
            if definition && position > 0 && code[position - 1] == 32 {
                if byte == 97 && determinismStartsWith(code, position, "asm ") { determinismViolation(search, "machine hardware", "inline assembly", index) }
                if byte == 118 && determinismStartsWith(code, position, "volatile ") { determinismViolation(search, "machine hardware", "a volatile memory access", index) }
                if byte == 99 && determinismStartsWith(code, position, "call ") { determinismIndirectCall(module, search, index, position) }
            }
            position = position + 1
        }
    }
}

// Proves one body from its final symbol `start`; reports `subject can reach ...`.
function determinismProve(context: CompilerContext, module: DeterminismModule, start: Integer, span: SourceSpan, subject: Text): Boolean {
    let parents: List<Integer> = []
    let indirectEdges: List<Boolean> = []
    let index = 0
    while index < module.names.length { parents.add(-2); indirectEdges.add(false); index = index + 1 }
    let search = DeterminismSearch { parents: parents, indirectEdges: indirectEdges, queue: [], indirect: [], collections: false, effect: "", detail: "", at: -1 }
    determinismReach(search, start, -1, false)
    let next = 0
    while next < search.queue.length && search.effect == "" {
        determinismScan(context, module, search, search.queue[next])
        next = next + 1
    }
    if search.effect != "" {
        let chain: List<Text> = []
        let step = search.at
        while step >= 0 {
            // A named function passed as a value forwards through its own
            // `.minyar.value|` function; the chain shows the function once.
            if resultPrefix(module.names[step], ".minyar.value|") && chain.length > 0 {
                if search.indirectEdges[step] { chain[chain.length - 1] = "a callback that may be " + chain[chain.length - 1] }
            } else {
                let readable = determinismReadable(context, module, step)
                if search.indirectEdges[step] { readable = "a callback that may be " + readable }
                chain.add(readable)
            }
            step = search.parents[step]
        }
        let path: List<Text> = []
        let position = chain.length - 1
        while position >= 0 {
            path.add(chain[position])
            if position > 0 { path.add(" -> ") }
            position = position - 1
        }
        if search.detail != "" && search.detail[0] == '(' { path.add(" " + search.detail) } else { path.add(" -> " + search.detail) }
        failDiagnostic(span, subject + " can reach " + search.effect + ": " + joinText(path), "", determinismWhere(context, module, search) + determinismHelp(search.effect))
        return false
    }
    return true
}

function auditDeterministicRoots(context: CompilerContext, output: List<Text>, roots: List<Integer>, origins: List<Integer>) {
    let values = context.deterministicValues
    if roots.length == 0 && values.symbols.length == 0 { return }
    let module = parseDeterminismModule(context, output)
    // Instances of one generic function share its declaration: report the first failure.
    let failedOrigins: List<Text> = []
    let root = 0
    while root < roots.length {
        let name = determinismMethodName(readableDeclarationName(context.functionNames[roots[root]]))
        let span = sourceSpan(context.tokenLines, context.tokenLines.inputPath, origins[root], origins[root] + 1)
        let start = determinismLookupName(module, context.functionIRNames[roots[root]])
        // Fail closed: an unproved function must never pass silently.
        if start < 0 || module.kinds[start] != 1 { failDiagnostic(span, "a deterministic function must compile to its own code; '" + name + "' was not found in the final module", "", "") }
        let origin = tokenLocation(context.tokenLines, origins[root])
        if start >= 0 && module.kinds[start] == 1 && findText(failedOrigins, origin) < 0 {
            if !determinismProve(context, module, start, span, "deterministic function '" + name + "'") { failedOrigins.add(origin) }
        }
        root = root + 1
    }
    // Bodies passed where a `deterministic (A) -> B` is needed.
    let value = 0
    while value < values.symbols.length {
        let span = sourceSpan(context.tokenLines, context.tokenLines.inputPath, values.origins[value], values.origins[value] + 1)
        let start = determinismLookupName(module, values.symbols[value])
        if start < 0 || module.kinds[start] != 1 { failDiagnostic(span, values.labels[value] + " must compile to its own code, but it was not found in the final module", "", "") }
        if start >= 0 && module.kinds[start] == 1 { determinismProve(context, module, start, span, values.labels[value]) }
        value = value + 1
    }
    diagnosticFinish()
}
