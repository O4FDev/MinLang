function parallelReductionHeader(context: CompilerContext, names: List<Text>, types: List<Integer>, ids: List<Integer>, lengths: List<Integer>, state: List<Integer>, parts: List<Integer>, index: Text) {
    if !tokenIs(context.tokenKinds, context.tokenTexts, state, "reduce") { return }
    let keyword = state[0]
    state[0] = keyword + 1
    let position = state[0]
    if context.tokenKinds[position] != 1 { parallelRace(context, position, "reduce needs a mutable Integer or Float binding") }
    let name = context.tokenTexts[position]
    let local = findLocal(names, lengths, state, name)
    if local < 0 { parallelRace(context, position, "reduce needs a mutable local binding named '" + name + "'") }
    if lengths[local] < 0 || ids[local] < 0 || (types[local] != 1 && types[local] != 7) || name == index {
        parallelRace(context, position, "reduce needs a mutable Integer or Float binding different from the loop index")
    }
    if recoveryEnabled(state) { parallelRace(context, keyword, "reductions cannot cross a recoverable frame yet") }
    parts[6] = ids[local]
    parts[7] = types[local]
    parts[8] = position
    context.syntax.nodes[context.syntax.active].operator = keyword
    context.syntax.nodes[context.syntax.active].symbol = ids[local]
    state[0] = position + 1
}

function parallelReductionTarget(context: CompilerContext, node: Integer, name: Text): Boolean {
    if name == "" { return false }
    let target = context.syntax.nodes[node]
    if context.tokenTexts[target.start] != name { return false }
    let parent = context.syntax.nodes[target.parent]
    if target.end != target.start + 1 || parent.operator < 0 {
        parallelRace(context, target.start, "update the reduction binding '" + name + "' only with +=")
    }
    if context.tokenTexts[parent.operator] != "+=" {
        parallelRace(context, target.start, "update the reduction binding '" + name + "' only with +=")
    }
    return true
}
