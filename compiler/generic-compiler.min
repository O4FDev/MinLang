// Demand-driven monomorphisation. The inference reader records only type shapes;
// the ordinary compiler checks and emits the resulting concrete program.
record GenericIndex { keys: List<Text>; values: List<Integer>; kinds: List<Integer>; slots: List<Integer> }
record GenericType { name: Text; arguments: List<Integer>; spelling: Text }
record GenericDeclaration {
    name: Text; kind: Integer; start: Integer; parametersStart: Integer; body: Integer; end: Integer
    variables: List<Text>; constraints: List<Text>
    names: List<Text>; types: List<Integer>; result: Integer
}
record GenericInstance { declaration: Integer; arguments: List<Integer>; name: Text }
record GenericStream {
    kinds: List<Integer>; texts: List<Text>; lines: SourceMap
    replacements: List<Text>; ends: List<Integer>
}
record GenericConstraint { type: Integer; capability: Text; variable: Text; stream: GenericStream; position: Integer }
record GenericProgram {
    source: GenericStream; declarations: List<GenericDeclaration>; declarationIndex: GenericIndex
    typePositions: List<Boolean>
    types: List<GenericType>; typeIndex: GenericIndex
    instances: List<GenericInstance>; instanceIndex: GenericIndex
    constraints: List<GenericConstraint>; constraintIndex: GenericIndex
    aliases: GenericIndex; aliasPositions: List<Integer>
}
record GenericScope { names: List<Text>; types: List<Integer>; active: Integer; result: Integer }

function newGenericIndex(): GenericIndex {
    let keys: List<Text> = []
    let values: List<Integer> = []
    let kinds: List<Integer> = []
    return GenericIndex { keys: keys; values: values; kinds: kinds; slots: buildDeclarationIndex(keys, kinds) }
}

function genericIndexGet(index: GenericIndex, key: Text): Integer {
    let entry = findIndexedSymbol(index.slots, index.keys, index.kinds, key, 0)
    if entry < 0 { return -1 }
    return index.values[entry]
}

function genericIndexPut(index: GenericIndex, key: Text, value: Integer) {
    let entry = findIndexedSymbol(index.slots, index.keys, index.kinds, key, 0)
    if entry >= 0 { index.values[entry] = value; return }
    entry = index.keys.length
    index.keys.add(key)
    index.values.add(value)
    index.kinds.add(0)
    let capacity = index.slots.length - 1
    if index.keys.length * 2 > capacity {
        index.slots = buildDeclarationIndex(index.keys, index.kinds)
        return
    }
    let bucket = declarationHash(key, 0) % capacity
    while index.slots[1 + bucket] >= 0 { bucket = (bucket + 1) % capacity }
    index.slots[1 + bucket] = entry
    index.slots[0] = index.keys.length
}

function newGenericStream(kinds: List<Integer>, texts: List<Text>, lines: SourceMap): GenericStream {
    let replacements: List<Text> = []
    let ends: List<Integer> = []
    let position = 0
    let loopEnd4 = kinds.length
    while position < loopEnd4 { replacements.add(""); ends.add(0)
        position = position + 1
    }
    return GenericStream { kinds: kinds; texts: texts; lines: lines; replacements: replacements; ends: ends }
}

function genericType(program: GenericProgram, name: Text, arguments: List<Integer>): Integer {
    let pieces: List<Text> = [name]
    if arguments.length > 0 {
        pieces.add("<")
        let position = 0
        let loopEnd5 = arguments.length
        while position < loopEnd5 {
            if position > 0 { pieces.add(",") }
            pieces.add(program.types[arguments[position]].spelling)

            position = position + 1
        }
        pieces.add(">")
    }
    let spelling = joinText(pieces)
    let found = genericIndexGet(program.typeIndex, spelling)
    if found >= 0 { return found }
    let type = program.types.length
    program.types.add(GenericType { name: name; arguments: arguments; spelling: spelling })
    genericIndexPut(program.typeIndex, spelling, type)
    return type
}

function genericNamedType(program: GenericProgram, name: Text): Integer {
    let arguments: List<Integer> = []
    return genericType(program, name, arguments)
}

function genericDeclaration(program: GenericProgram, name: Text, kind: Integer): Integer {
    return genericIndexGet(program.declarationIndex, Text(kind) + ":" + name)
}

function genericError(stream: GenericStream, position: Integer, message: Text) {
    fail(describeLocation(tokenLocation(stream.lines, position)) + ": " + message)
}

function genericReadType(program: GenericProgram, stream: GenericStream, cursor: List<Integer>, depth: Integer): Integer {
    if depth >= 64 { genericError(stream, cursor[0], "generic type nesting exceeds 64") }
    let name = stream.texts[cursor[0]]
    let arguments: List<Integer> = []
    if cursor[1] == 0 && name == "(" {
        cursor[0] = cursor[0] + 1
        while !tokenIs(stream.kinds, stream.texts, cursor, ")") {
            arguments.add(genericReadType(program, stream, cursor, depth + 1))
            if !tokenIs(stream.kinds, stream.texts, cursor, ")") { expectToken(stream.kinds, stream.texts, stream.lines, cursor, ",") }
        }
        cursor[0] = cursor[0] + 1
        expectToken(stream.kinds, stream.texts, stream.lines, cursor, "->")
        arguments.add(genericReadType(program, stream, cursor, depth + 1))
        return genericType(program, "Callback", arguments)
    }
    if cursor[1] != 0 || stream.kinds[cursor[0]] != 1 { genericError(stream, cursor[0], "expected a type") }
    cursor[0] = cursor[0] + 1
    if name == "Bytes" && tokenIs(stream.kinds, stream.texts, cursor, "[") {
        cursor[0] = cursor[0] + 1
        if stream.kinds[cursor[0]] != 2 { genericError(stream, cursor[0], "a C-layout byte array needs a constant positive length") }
        let length = stream.texts[cursor[0]]
        cursor[0] = cursor[0] + 1
        expectToken(stream.kinds, stream.texts, stream.lines, cursor, "]")
        return genericNamedType(program, "Bytes[" + length + "]")
    }
    if tokenIs(stream.kinds, stream.texts, cursor, "<") {
        cursor[0] = cursor[0] + 1
        arguments.add(genericReadType(program, stream, cursor, depth + 1))
        while cursor[1] == 0 && tokenIs(stream.kinds, stream.texts, cursor, ",") {
            cursor[0] = cursor[0] + 1
            arguments.add(genericReadType(program, stream, cursor, depth + 1))
        }
        resultClose(stream.kinds, stream.texts, stream.lines, cursor)
    }
    return genericType(program, name, arguments)
}

function genericSubstitute(program: GenericProgram, type: Integer, variables: List<Text>, bindings: List<Integer>, depth: Integer): Integer {
    if type == 0 { return 0 }
    if depth >= 64 { fail("generic substitution nesting exceeds 64") }
    let shape = program.types[type]
    let variable = findText(variables, shape.name)
    if variable >= 0 && shape.arguments.length == 0 { return bindings[variable] }
    if shape.arguments.length == 0 { return type }
    let arguments: List<Integer> = []
    let loopItems6 = shape.arguments
    let loopPosition6 = 0
    while loopPosition6 < loopItems6.length {
        let child = loopItems6[loopPosition6]
        arguments.add(genericSubstitute(program, child, variables, bindings, depth + 1))
        loopPosition6 = loopPosition6 + 1
    }
    return genericType(program, shape.name, arguments)
}

function genericMergeBinding(program: GenericProgram, stream: GenericStream, position: Integer, left: Integer, right: Integer, variable: Text, depth: Integer): Integer {
    if left == 0 { return right }
    if right == 0 || left == right { return left }
    if depth >= 64 { genericError(stream, position, "generic inference nesting exceeds 64") }
    let first = program.types[left]
    let second = program.types[right]
    if first.name != second.name || first.arguments.length != second.arguments.length {
        genericError(stream, position, "type argument '" + variable + "' is used inconsistently: " + first.spelling + " and " + second.spelling)
    }
    let arguments: List<Integer> = []
    let child = 0
    while child < first.arguments.length {
        arguments.add(genericMergeBinding(program, stream, position, first.arguments[child], second.arguments[child], variable, depth + 1))
        child = child + 1
    }
    return genericType(program, first.name, arguments)
}

function genericUnify(program: GenericProgram, stream: GenericStream, position: Integer, pattern: Integer, actual: Integer, variables: List<Text>, bindings: List<Integer>, depth: Integer) {
    if pattern == 0 || actual == 0 { return }
    if depth >= 64 { genericError(stream, position, "generic inference nesting exceeds 64") }
    let wanted = program.types[pattern]
    let received = program.types[actual]
    let variable = findText(variables, wanted.name)
    if variable >= 0 && wanted.arguments.length == 0 {
        if bindings[variable] == 0 { bindings[variable] = actual; return }
        bindings[variable] = genericMergeBinding(program, stream, position, bindings[variable], actual, variables[variable], 0)
        return
    }
    if wanted.name != received.name || wanted.arguments.length != received.arguments.length { return }
    let child = 0
    let loopEnd7 = wanted.arguments.length
    while child < loopEnd7 {
        genericUnify(program, stream, position, wanted.arguments[child], received.arguments[child], variables, bindings, depth + 1)

        child = child + 1
    }
}

function genericBindings(declaration: GenericDeclaration): List<Integer> {
    let bindings: List<Integer> = []
    let loopItems8 = declaration.variables
    let loopPosition8 = 0
    while loopPosition8 < loopItems8.length {
        let variable = loopItems8[loopPosition8]
        bindings.add(0)
        loopPosition8 = loopPosition8 + 1
    }
    return bindings
}

function genericConcreteType(program: GenericProgram, type: Integer): Boolean {
    if type == 0 { return false }
    let loopItems9 = program.types[type].arguments
    let loopPosition9 = 0
    while loopPosition9 < loopItems9.length {
        let argument = loopItems9[loopPosition9]
        if !genericConcreteType(program, argument) { return false }
        loopPosition9 = loopPosition9 + 1
    }
    return true
}

function genericRequireCapability(program: GenericProgram, stream: GenericStream, position: Integer, type: Integer, capability: Text, variable: Text) {
    let shape = program.types[type]
    let record = genericDeclaration(program, shape.name, 2)
    let structural = shape.name == "Result" || ((shape.name == "Map" || shape.name == "Set") && capability == "Equatable")
    if record < 0 && !structural { genericError(stream, position, "type '" + shape.spelling + "' does not satisfy " + capability + " for type argument '" + variable + "'") }
    let key = capability + ":" + Text(type)
    if genericIndexGet(program.constraintIndex, key) >= 0 { return }
    genericIndexPut(program.constraintIndex, key, program.constraints.length)
    program.constraints.add(GenericConstraint { type: type; capability: capability; variable: variable; stream: stream; position: position })
}

function genericValidateConstraints(context: CompilerContext) {
    let prefix = "minyar_generic_constraint_"
    let record = 0
    while record < context.functionNames.length {
        let name = context.functionNames[record]
        if context.symbolKinds[record] == 2 && resultPrefix(name, prefix) {
            let end = prefix.length
            while end < name.length && name[end] != '_' { end = end + 1 }
            let capability = name.slice(prefix.length, end)
            let field = functionParameterOffset(context.functionParameterCounts, record)
            let type = context.functionParameterTypes[field]
            let supported = typeSupportsCapability(context, type, capability)
            if !supported {
                let description = describeType(type)
                if isRecordType(type) { description = readableDeclarationName(context.functionNames[type - 1000]) }
                fail(describeLocation(tokenLocation(context.tokenLines, context.syntax.nodes[context.syntax.symbolNodes[record]].start + 1)) + ": type '" + description + "' does not satisfy " + capability + " for type argument '" + declaredFieldName(context.functionParameterNames[field]) + "'")
            }
        }
        record = record + 1
    }
}

function genericInstantiate(program: GenericProgram, stream: GenericStream, position: Integer, declaration: Integer, arguments: List<Integer>): Text {
    let template = program.declarations[declaration]
    if arguments.length != template.variables.length {
        let noun = "type arguments"
        if template.variables.length == 1 { noun = "type argument" }
        genericError(stream, position, "'" + readableDeclarationName(template.name) + "' expects " + Text(template.variables.length) + " " + noun + ", but received " + Text(arguments.length))
    }
    let key = Text(declaration)
    let argument = 0
    let loopEnd10 = arguments.length
    while argument < loopEnd10 {
        if !genericConcreteType(program, arguments[argument]) {
            genericError(stream, position, "I can't infer type argument '" + template.variables[argument] + "' for '" + readableDeclarationName(template.name) + "'; supply explicit type arguments")
        }
        let constraint = template.constraints[argument]
        if constraint != "" {
            let shape = program.types[arguments[argument]]
            let builtin = shape.arguments.length == 0 && (shape.name == "Integer" || shape.name == "Float" || shape.name == "Text" || shape.name == "Character" || shape.name == "Boolean")
            if !builtin { genericRequireCapability(program, stream, position, arguments[argument], constraint, template.variables[argument]) }
        }
        key = key + ":" + Text(arguments[argument])

        argument = argument + 1
    }
    let found = genericIndexGet(program.instanceIndex, key)
    if found >= 0 { return program.instances[found].name }
    if program.instances.length >= 4096 { genericError(stream, position, "generic expansion exceeds 4096 instantiations; check for a recursive call that changes its type arguments") }
    let name = "minyar_generic_function_" + Text(program.instances.length)
    if template.kind == 2 { name = "minyar_generic_record_" + Text(program.instances.length) }
    name = name + "_" + readableDeclarationName(template.name)
    let index = program.instances.length
    program.instances.add(GenericInstance { declaration: declaration; arguments: arguments; name: name })
    genericIndexPut(program.instanceIndex, key, index)
    return name
}

function genericEmitType(program: GenericProgram, stream: GenericStream, position: Integer, type: Integer, depth: Integer): Text {
    if type == 0 { return "" }
    if depth >= 64 { genericError(stream, position, "generic type nesting exceeds 64") }
    let shape = program.types[type]
    let declaration = genericDeclaration(program, shape.name, 2)
    if declaration >= 0 && program.declarations[declaration].variables.length > 0 {
        return genericInstantiate(program, stream, position, declaration, shape.arguments)
    }
    let pieces: List<Text> = [shape.name]
    if shape.arguments.length > 0 {
        pieces.add("<")
        let child = 0
        let loopEnd11 = shape.arguments.length
        while child < loopEnd11 {
            if child > 0 { pieces.add(",") }
            pieces.add(genericEmitType(program, stream, position, shape.arguments[child], depth + 1))

            child = child + 1
        }
        pieces.add(">")
    }
    return joinText(pieces)
}

function isTypeAliasAt(kinds: List<Integer>, texts: List<Text>, position: Integer): Boolean {
    return position + 2 < kinds.length && kinds[position] == 1 && texts[position] == "type" && kinds[position + 1] == 1 && kinds[position + 2] == 4 && (texts[position + 2] == "=" || texts[position + 2] == "<")
}

function isTypeAliasDeclaration(kinds: List<Integer>, texts: List<Text>, cursor: List<Integer>): Boolean {
    return isTypeAliasAt(kinds, texts, cursor[0])
}

function genericCanonicalType(program: GenericProgram, stream: GenericStream, position: Integer, type: Integer, variables: List<Text>, depth: Integer): Integer {
    if type == 0 || program.aliases.keys.length == 0 { return type }
    if depth >= 64 { genericError(stream, position, "type alias nesting exceeds 64; check for a recursive alias") }
    let shape = program.types[type]
    if findText(variables, shape.name) < 0 {
        let alias = genericIndexGet(program.aliases, shape.name)
        if alias >= 0 {
            if shape.arguments.length != 0 { genericError(stream, position, "type alias '" + readableDeclarationName(shape.name) + "' does not take type arguments") }
            return genericCanonicalType(program, stream, position, alias, variables, depth + 1)
        }
    }
    if shape.arguments.length == 0 { return type }
    let arguments: List<Integer> = []
    let child = 0
    while child < shape.arguments.length {
        arguments.add(genericCanonicalType(program, stream, position, shape.arguments[child], variables, depth + 1))
        child = child + 1
    }
    return genericType(program, shape.name, arguments)
}

function genericCollectAlias(program: GenericProgram, stream: GenericStream, cursor: List<Integer>) {
    let start = cursor[0]
    let name = stream.texts[start + 1]
    if stream.kinds[start + 1] != 1 { genericError(stream, start + 1, "expected a name after type") }
    let readable = readableDeclarationName(name)
    if simpleTypeCode(readable) != 0 || readable == "List" || readable == "Map" || readable == "Set" || readable == "Result" || readable == "Callback" || readable == "Maybe" {
        genericError(stream, start + 1, "a type alias cannot replace built-in type '" + readable + "'")
    }
    if resultPrefix(name, "minyar_generic_") || resultPrefix(readable, "minyar_generic_") { genericError(stream, start + 1, "reserved generic compiler name") }
    if genericIndexGet(program.aliases, name) >= 0 || genericDeclaration(program, name, 2) >= 0 { genericError(stream, start + 1, "module declares type '" + readable + "' more than once") }
    cursor[0] = start + 2
    expectToken(stream.kinds, stream.texts, stream.lines, cursor, "=")
    let target = genericReadType(program, stream, cursor, 0)
    if cursor[1] != 0 { genericError(stream, cursor[0], "unexpected extra '>' after a type alias") }
    if stream.kinds[cursor[0]] != 0 && stream.kinds[cursor[0]] != 6 && stream.lines.coordinates[cursor[0] * 2] == stream.lines.coordinates[(cursor[0] - 1) * 2] { genericError(stream, cursor[0], "a type alias needs one complete type") }
    genericIndexPut(program.aliases, name, target)
    program.aliasPositions.add(start)
    stream.ends[start] = cursor[0]
}

function genericResolveAliases(program: GenericProgram) {
    if program.aliases.keys.length == 0 { return }
    let source = program.source
    let declaration = 0
    while declaration < program.declarations.length {
        let signature = program.declarations[declaration]
        if signature.kind == 1 && signature.names.length > 0 && signature.names[0] == "self" && findCharacter(signature.name, '$') >= 0 {
            let receiver = program.types[signature.types[0]]
            if genericIndexGet(program.aliases, receiver.name) >= 0 {
                let variables: List<Text> = []
                let target = genericCanonicalType(program, source, signature.start, signature.types[0], variables, 0)
                let shape = program.types[target]
                let record = genericDeclaration(program, shape.name, 2)
                if record < 0 { genericError(source, signature.start, "methods need a record declared in their own module") }
                if tokenPath(source.lines, program.declarations[record].start) != tokenPath(source.lines, signature.start) { genericError(source, signature.start, "methods must be declared in the module that declares their record") }
                let readable = readableDeclarationName(signature.name)
                let member = readable.slice(findCharacter(readable, '$') + 1, readable.length)
                let name = methodFunctionName(genericEmitType(program, source, signature.start, target, 0), member)
                let previous = genericDeclaration(program, name, 1)
                if previous >= 0 && previous != declaration { genericError(source, signature.start, "the same record method is declared more than once through type aliases") }
                genericIndexPut(program.declarationIndex, "1:" + name, declaration)
                signature.name = name
                source.texts[signature.start + 1] = name
            }
        }
        let parameter = 0
        while parameter < signature.types.length {
            signature.types[parameter] = genericCanonicalType(program, source, signature.start, signature.types[parameter], signature.variables, 0)
            parameter = parameter + 1
        }
        signature.result = genericCanonicalType(program, source, signature.start, signature.result, signature.variables, 0)
        declaration = declaration + 1
    }
    let alias = 0
    while alias < program.aliases.keys.length {
        let name = program.aliases.keys[alias]
        let position = program.aliasPositions[alias]
        let variables: List<Text> = []
        let target = genericCanonicalType(program, source, position, program.aliases.values[alias], variables, 0)
        program.aliases.values[alias] = target
        let shape = program.types[target]
        let record = genericDeclaration(program, shape.name, 2)
        if record >= 0 {
            let template = program.declarations[record]
            genericEmitType(program, source, position, target, 0)
            let fields: List<Integer> = []
            let field = 0
            while field < template.types.length {
                fields.add(genericSubstitute(program, template.types[field], template.variables, shape.arguments, 0))
                field = field + 1
            }
            let constraints: List<Text> = []
            let facade = GenericDeclaration { name: name; kind: 2; start: position; parametersStart: position; body: position; end: position; variables: variables; constraints: constraints; names: template.names; types: fields; result: genericNamedType(program, "Nothing") }
            genericIndexPut(program.declarationIndex, "2:" + name, program.declarations.length)
            program.declarations.add(facade)
        }
        alias = alias + 1
    }
}

function genericAppendAliasChecks(program: GenericProgram, kinds: List<Integer>, texts: List<Text>, lines: SourceMap) {
    let alias = 0
    while alias < program.aliases.keys.length {
        let target = program.aliases.values[alias]
        let shape = program.types[target]
        if shape.name != "Nothing" || shape.arguments.length != 0 {
            let position = program.aliasPositions[alias]
            let declaration = "record minyar_generic_alias_check_" + Text(alias) + " { value: " + genericEmitType(program, program.source, position, target, 0) + " }\n"
            genericAppendReplacement(kinds, texts, lines, declaration, program.source, position)
        }
        alias = alias + 1
    }
}

function skipAliasType(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, cursor: List<Integer>, depth: Integer) {
    if depth >= 64 { fail("type alias nesting exceeds 64") }
    if texts[cursor[0]] == "(" {
        cursor[0] = cursor[0] + 1
        while texts[cursor[0]] != ")" {
            skipAliasType(kinds, texts, lines, cursor, depth + 1)
            if texts[cursor[0]] != ")" { expectToken(kinds, texts, lines, cursor, ",") }
        }
        cursor[0] = cursor[0] + 1
        expectToken(kinds, texts, lines, cursor, "->")
        skipAliasType(kinds, texts, lines, cursor, depth + 1)
        return
    }
    if kinds[cursor[0]] != 1 || cursor[1] != 0 { fail(describeLocation(tokenLocation(lines, cursor[0])) + ": expected a type name in a type alias") }
    cursor[0] = cursor[0] + 1
    if texts[cursor[0]] == "." {
        cursor[0] = cursor[0] + 1
        if kinds[cursor[0]] != 1 { fail(describeLocation(tokenLocation(lines, cursor[0])) + ": expected a type name after the module name") }
        cursor[0] = cursor[0] + 1
    }
    if texts[cursor[0]] == "<" {
        cursor[0] = cursor[0] + 1
        skipAliasType(kinds, texts, lines, cursor, depth + 1)
        while cursor[1] == 0 && texts[cursor[0]] == "," {
            cursor[0] = cursor[0] + 1
            skipAliasType(kinds, texts, lines, cursor, depth + 1)
        }
        resultClose(kinds, texts, lines, cursor)
    }
}

function skipTypeAliasDeclaration(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, cursor: List<Integer>) {
    cursor[0] = cursor[0] + 1
    if kinds[cursor[0]] != 1 { fail(describeLocation(tokenLocation(lines, cursor[0])) + ": expected a name after type") }
    cursor[0] = cursor[0] + 1
    expectToken(kinds, texts, lines, cursor, "=")
    if cursor.length < 2 { cursor.add(0) }
    skipAliasType(kinds, texts, lines, cursor, 0)
    if cursor[1] != 0 { fail(describeLocation(tokenLocation(lines, cursor[0] - 1)) + ": unexpected extra '>' after a type alias") }
    if kinds[cursor[0]] != 0 && kinds[cursor[0]] != 6 && lines.coordinates[cursor[0] * 2] == lines.coordinates[(cursor[0] - 1) * 2] { fail(describeLocation(tokenLocation(lines, cursor[0])) + ": a type alias needs one complete type") }
    skipTerminators(kinds, cursor)
}

function genericReadAnnotation(program: GenericProgram, stream: GenericStream, cursor: List<Integer>): Integer {
    let start = cursor[0]
    let type = genericReadType(program, stream, cursor, 0)
    let variables: List<Text> = []
    type = genericCanonicalType(program, stream, start, type, variables, 0)
    stream.replacements[start] = genericEmitType(program, stream, start, type, 0)
    stream.ends[start] = cursor[0]
    if cursor[1] != 0 { genericError(stream, start, "unexpected extra '>' after a type") }
    return type
}

function genericCollectDeclaration(program: GenericProgram, stream: GenericStream, start: Integer, end: Integer): GenericDeclaration {
    let kind = 1
    if stream.texts[start] == "record" { kind = 2 }
    let name = stream.texts[start + 1]
    let cursor: List<Integer> = [start + 2, 0]
    let variables: List<Text> = []
    let constraints: List<Text> = []
    if tokenIs(stream.kinds, stream.texts, cursor, "<") {
        cursor[0] = cursor[0] + 1
        while !tokenIs(stream.kinds, stream.texts, cursor, ">") {
            if stream.kinds[cursor[0]] != 1 { genericError(stream, cursor[0], "expected a type parameter name") }
            let variable = stream.texts[cursor[0]]
            if findText(variables, variable) >= 0 { genericError(stream, cursor[0], "type parameter '" + variable + "' is declared twice") }
            if simpleTypeCode(variable) != 0 || variable == "List" || variable == "Map" || variable == "Set" || variable == "Result" || variable == "Callback" {
                genericError(stream, cursor[0], "type parameter '" + variable + "' needs its own name, such as Item")
            }
            variables.add(variable)
            cursor[0] = cursor[0] + 1
            let constraint = ""
            if tokenIs(stream.kinds, stream.texts, cursor, ":") {
                cursor[0] = cursor[0] + 1
                if stream.kinds[cursor[0]] != 1 { genericError(stream, cursor[0], "expected a capability name after ':'") }
                constraint = stream.texts[cursor[0]]
                cursor[0] = cursor[0] + 1
                if constraint != "Equatable" && constraint != "Ordered" && constraint != "Hashable" { genericError(stream, cursor[0] - 1, "unknown capability '" + constraint + "'") }
            }
            constraints.add(constraint)
            if !tokenIs(stream.kinds, stream.texts, cursor, ">") { expectToken(stream.kinds, stream.texts, stream.lines, cursor, ",") }
        }
        cursor[0] = cursor[0] + 1
        if variables.length == 0 { genericError(stream, start, "a generic declaration needs at least one type parameter") }
    }
    let parametersStart = cursor[0]
    let names: List<Text> = []
    let types: List<Integer> = []
    let result = genericNamedType(program, "Nothing")
    if name == "main" { result = genericNamedType(program, "Integer") }
    if kind == 1 { expectToken(stream.kinds, stream.texts, stream.lines, cursor, "(") } else {
        if tokenIs(stream.kinds, stream.texts, cursor, "native") { cursor[0] = cursor[0] + 2 }
        expectToken(stream.kinds, stream.texts, stream.lines, cursor, "{")
        skipTerminators(stream.kinds, cursor)
    }
    let closing = ")"
    if kind == 2 { closing = "}" }
    while !tokenIs(stream.kinds, stream.texts, cursor, closing) {
        if tokenIs(stream.kinds, stream.texts, cursor, "private") && stream.kinds[cursor[0] + 1] == 1 { cursor[0] = cursor[0] + 1 }
        names.add(stream.texts[cursor[0]])
        cursor[0] = cursor[0] + 1
        expectToken(stream.kinds, stream.texts, stream.lines, cursor, ":")
        let type = genericReadType(program, stream, cursor, 0)
        if kind == 2 && stream.texts[parametersStart] == "native" {
            let fieldName = program.types[type].name
            let scalar = cScalarKind(fieldName)
            if scalar > 0 {
                let valueName = "Integer"
                if scalar == 9 || scalar == 10 { valueName = "Float" }
                if scalar == 11 { valueName = "Boolean" }
                if scalar == 12 { valueName = "Character" }
                type = genericNamedType(program, valueName)
            }
            if resultPrefix(fieldName, "Bytes[") { type = genericNamedType(program, "Bytes") }
        }
        types.add(type)
        if cursor[1] != 0 { genericError(stream, cursor[0], "unexpected extra '>' after a type") }
        if tokenIs(stream.kinds, stream.texts, cursor, ",") { cursor[0] = cursor[0] + 1 }
        skipTerminators(stream.kinds, cursor)
    }
    cursor[0] = cursor[0] + 1
    if kind == 1 && tokenIs(stream.kinds, stream.texts, cursor, ":") { cursor[0] = cursor[0] + 1; result = genericReadType(program, stream, cursor, 0) }
    if kind == 1 && !tokenIs(stream.kinds, stream.texts, cursor, "{") { genericError(stream, cursor[0], "expected a function body") }
    return GenericDeclaration { name: name; kind: kind; start: start; parametersStart: parametersStart; body: cursor[0]; end: end; variables: variables; constraints: constraints; names: names; types: types; result: result }
}

function genericScopeAdd(scope: GenericScope, name: Text, type: Integer) {
    if scope.active < scope.names.length { scope.names[scope.active] = name; scope.types[scope.active] = type } else {
        scope.names.add(name); scope.types.add(type)
    }
    scope.active = scope.active + 1
}

function genericScopeType(program: GenericProgram, scope: GenericScope, name: Text): Integer {
    let index = scope.active
    while index > 0 { index = index - 1; if scope.names[index] == name { return scope.types[index] } }
    let type = genericIndexGet(program.declarationIndex, "3:" + name) + 1
    if type == 0 || program.aliases.keys.length == 0 { return type }
    let variables: List<Text> = []
    return genericCanonicalType(program, program.source, 0, type, variables, 0)
}

// Only a complete type-argument header followed by a call/construction opens
// generic syntax. A local comparison may share its name with a declaration.
function genericHeaderFollows(kinds: List<Integer>, texts: List<Text>, start: Integer, following: Text): Boolean {
    if texts[start + 1] != "<" { return false }
    let position = start + 1
    let depth = 0
    while position + 1 < kinds.length && kinds[position] != 0 && kinds[position] != 6 {
        let token = texts[position]
        if kinds[position] == 4 {
            if token == "<" { depth = depth + 1; if depth > 64 { return false } } else {
                if token == ">" { depth = depth - 1 } else {
                    if token == ">>" { depth = depth - 2 } else {
                        if token != "," && token != "." && token != "(" && token != ")" && token != "->" { return false }
                    }
                }
            }
            if depth <= 0 { return depth == 0 && texts[position + 1] == following }
        } else { if kinds[position] != 1 { return false } }
        position = position + 1
    }
    return false
}

function genericArgumentTypes(program: GenericProgram, stream: GenericStream, cursor: List<Integer>): List<Integer> {
    let arguments: List<Integer> = []
    expectToken(stream.kinds, stream.texts, stream.lines, cursor, "<")
    arguments.add(genericReadType(program, stream, cursor, 0))
    while cursor[1] == 0 && tokenIs(stream.kinds, stream.texts, cursor, ",") { cursor[0] = cursor[0] + 1; arguments.add(genericReadType(program, stream, cursor, 0)) }
    resultClose(stream.kinds, stream.texts, stream.lines, cursor)
    if cursor[1] != 0 { genericError(stream, cursor[0] - 1, "unexpected extra '>' after type arguments") }
    let variables: List<Text> = []
    let argument = 0
    while argument < arguments.length { arguments[argument] = genericCanonicalType(program, stream, cursor[0] - 1, arguments[argument], variables, 0); argument = argument + 1 }
    return arguments
}

function genericCall(program: GenericProgram, stream: GenericStream, cursor: List<Integer>, scope: GenericScope, expected: Integer, depth: Integer): Integer {
    let position = cursor[0]
    let name = stream.texts[position]
    if isCLayoutTypeBuiltin(name) {
        cursor[0] = cursor[0] + 1
        expectToken(stream.kinds, stream.texts, stream.lines, cursor, "(")
        let type = genericReadAnnotation(program, stream, cursor)
        while !tokenIs(stream.kinds, stream.texts, cursor, ")") {
            expectToken(stream.kinds, stream.texts, stream.lines, cursor, ",")
            genericExpression(program, stream, cursor, scope, 0, 0, depth + 1)
        }
        cursor[0] = cursor[0] + 1
        if name == "cView" || name == "cAt" { return type }
        return genericNamedType(program, "Integer")
    }
    let declaration = genericDeclaration(program, name, 1)
    let localCallable = genericScopeType(program, scope, name)
    if localCallable > 0 && program.types[localCallable].name == "Callback" { declaration = -1 }
    cursor[0] = cursor[0] + 1
    let bindings: List<Integer> = []
    let variables: List<Text> = []
    let parameterTypes: List<Integer> = []
    let result = 0
    if declaration < 0 && localCallable > 0 && program.types[localCallable].name == "Callback" {
        let signature = program.types[localCallable].arguments
        let parameter = 0
        while parameter + 1 < signature.length { parameterTypes.add(signature[parameter]); parameter = parameter + 1 }
    }
    if declaration >= 0 {
        let signature = program.declarations[declaration]
        variables = signature.variables
        bindings = genericBindings(signature)
        parameterTypes = signature.types
        result = signature.result
        if variables.length > 0 {
            if tokenIs(stream.kinds, stream.texts, cursor, "<") {
                bindings = genericArgumentTypes(program, stream, cursor)
                if bindings.length != variables.length { genericInstantiate(program, stream, position, declaration, bindings) }
            }
            genericUnify(program, stream, position, result, expected, variables, bindings, 0)
        }
    }
    let nameEnd = cursor[0]
    expectToken(stream.kinds, stream.texts, stream.lines, cursor, "(")
    let arguments: List<Integer> = []
    while !tokenIs(stream.kinds, stream.texts, cursor, ")") {
        let wanted = 0
        if arguments.length < parameterTypes.length { wanted = genericSubstitute(program, parameterTypes[arguments.length], variables, bindings, 0) }
        if name == "joinText" { wanted = genericType(program, "List", [genericNamedType(program, "Text")]) }
        let actual = genericExpression(program, stream, cursor, scope, wanted, 0, depth + 1)
        if variables.length > 0 && arguments.length < parameterTypes.length {
            genericUnify(program, stream, position, parameterTypes[arguments.length], actual, variables, bindings, 0)
        }
        arguments.add(actual)
        if !tokenIs(stream.kinds, stream.texts, cursor, ")") { expectToken(stream.kinds, stream.texts, stream.lines, cursor, ",") }
    }
    cursor[0] = cursor[0] + 1
    if variables.length > 0 {
        if arguments.length != parameterTypes.length { genericError(stream, position, "'" + readableDeclarationName(name) + "' expects " + Text(parameterTypes.length) + " arguments, but received " + Text(arguments.length)) }
        let instance = genericInstantiate(program, stream, position, declaration, bindings)
        stream.replacements[position] = instance
        stream.ends[position] = nameEnd
        return genericSubstitute(program, result, variables, bindings, 0)
    }
    if declaration >= 0 { return result }
    if name == "Text" || name == "joinText" || isInterpolationConversion(name) || isInterpolationJoin(name) { return genericNamedType(program, "Text") }
    if simpleTypeCode(name) != 0 { return genericNamedType(program, name) }
    if name == "print" || name == "exit" || name == "fail" { return genericNamedType(program, "Nothing") }
    if name == "abs" || name == "min" || name == "max" || name == "clamp" { if arguments.length > 0 { return arguments[0] } }
    if name == "wrappingAdd" || name == "wrappingSubtract" || name == "wrappingMultiply" { return genericNamedType(program, "Integer") }
    if name == "cBytes" { return genericNamedType(program, "Bytes") }
    if name == "cAddress" { return genericNamedType(program, "Integer") }
    if name == "Ok" || name == "Err" { return expected }
    let callable = genericScopeType(program, scope, name)
    if callable > 0 && program.types[callable].name == "Callback" {
        let signature = program.types[callable].arguments
        if signature.length > 0 { return signature[signature.length - 1] }
    }
    return 0
}

function genericRecord(program: GenericProgram, stream: GenericStream, cursor: List<Integer>, scope: GenericScope, expected: Integer, depth: Integer): Integer {
    let position = cursor[0]
    let name = stream.texts[position]
    let declaration = genericDeclaration(program, name, 2)
    let signature = program.declarations[declaration]
    let bindings = genericBindings(signature)
    cursor[0] = cursor[0] + 1
    if tokenIs(stream.kinds, stream.texts, cursor, "<") {
        bindings = genericArgumentTypes(program, stream, cursor)
        if bindings.length != signature.variables.length { genericInstantiate(program, stream, position, declaration, bindings) }
    }
    if expected > 0 && program.types[expected].name == name {
        genericUnify(program, stream, position, genericType(program, name, bindings), expected, signature.variables, bindings, 0)
        let contextual = program.types[expected].arguments
        if contextual.length == bindings.length {
            let index = 0
            let loopEnd12 = bindings.length
            while index < loopEnd12 { if bindings[index] == 0 { bindings[index] = contextual[index] }
                index = index + 1
            }
        }
    }
    let nameEnd = cursor[0]
    expectToken(stream.kinds, stream.texts, stream.lines, cursor, "{")
    skipTerminators(stream.kinds, cursor)
    while !tokenIs(stream.kinds, stream.texts, cursor, "}") {
        let field = findText(signature.names, stream.texts[cursor[0]])
        cursor[0] = cursor[0] + 1
        expectToken(stream.kinds, stream.texts, stream.lines, cursor, ":")
        let wanted = 0
        if field >= 0 { wanted = genericSubstitute(program, signature.types[field], signature.variables, bindings, 0) }
        let actual = genericExpression(program, stream, cursor, scope, wanted, 0, depth + 1)
        if field >= 0 { genericUnify(program, stream, position, signature.types[field], actual, signature.variables, bindings, 0) }
        if tokenIs(stream.kinds, stream.texts, cursor, ",") { cursor[0] = cursor[0] + 1 }
        skipTerminators(stream.kinds, cursor)
    }
    cursor[0] = cursor[0] + 1
    let variables: List<Text> = []
    let type = genericCanonicalType(program, stream, position, genericType(program, name, bindings), variables, 0)
    if signature.variables.length > 0 || genericIndexGet(program.aliases, name) >= 0 {
        stream.replacements[position] = genericEmitType(program, stream, position, type, 0)
        stream.ends[position] = nameEnd
    }
    return type
}

function genericMemberType(program: GenericProgram, type: Integer, member: Text, call: Boolean): Integer {
    if type == 0 { return 0 }
    let shape = program.types[type]
    if member == "length" || member == "byteLength" { return genericNamedType(program, "Integer") }
    let record = genericDeclaration(program, shape.name, 2)
    if record >= 0 {
        let declaration = program.declarations[record]
        let field = findText(declaration.names, member)
        if field >= 0 && !call { return genericSubstitute(program, declaration.types[field], declaration.variables, shape.arguments, 0) }
        let recordName = shape.name
        if shape.arguments.length > 0 { recordName = genericEmitType(program, program.source, 0, type, 0) }
        let method = genericDeclaration(program, methodFunctionName(recordName, member), 1)
        if method < 0 { method = genericDeclaration(program, methodFunctionName(recordName, member + "$private"), 1) }
        if call && method >= 0 {
            let signature = program.declarations[method]
            let arguments: List<Integer> = []
            let parameter = 1
            while parameter < signature.types.length { arguments.add(signature.types[parameter]); parameter = parameter + 1 }
            arguments.add(signature.result)
            return genericType(program, "Callback", arguments)
        }
        if field >= 0 { return genericSubstitute(program, declaration.types[field], declaration.variables, shape.arguments, 0) }
    }
    if member == "slice" || member == "appended" || member == "sorted" || member == "sortedBy" || member == "trim" { return type }
    if member == "split" { return genericType(program, "List", [genericNamedType(program, "Text")]) }
    if member == "startsWith" || member == "endsWith" || member == "contains" || member == "has" || member == "remove" { return genericNamedType(program, "Boolean") }
    if member == "pop" && shape.arguments.length > 0 { return shape.arguments[0] }
    if member == "get" && shape.name == "Map" && shape.arguments.length == 2 { return shape.arguments[1] }
    if member == "find" || resultPrefix(member, "getInt") || member == "getFloat32" || member == "getFloat64" {
        if member == "getFloat32" || member == "getFloat64" { return genericNamedType(program, "Float") }
        return genericNamedType(program, "Integer")
    }
    return 0
}

function genericMap(program: GenericProgram, stream: GenericStream, cursor: List<Integer>, scope: GenericScope, expected: Integer, depth: Integer): Integer {
    let type = expected
    if tokenIs(stream.kinds, stream.texts, cursor, "Map") {
        if stream.texts[cursor[0] + 1] == "<" { type = genericReadAnnotation(program, stream, cursor) } else { cursor[0] = cursor[0] + 1 }
        if tokenIs(stream.kinds, stream.texts, cursor, "(") {
            cursor[0] = cursor[0] + 1
            expectToken(stream.kinds, stream.texts, stream.lines, cursor, ")")
            return type
        }
    }
    let key = 0
    let value = 0
    if type > 0 && program.types[type].name == "Map" {
        let arguments = program.types[type].arguments
        if arguments.length == 2 { key = arguments[0]; value = arguments[1] }
    }
    expectToken(stream.kinds, stream.texts, stream.lines, cursor, "{")
    skipTerminators(stream.kinds, cursor)
    while !tokenIs(stream.kinds, stream.texts, cursor, "}") {
        let actualKey = genericExpression(program, stream, cursor, scope, key, 0, depth + 1)
        if key == 0 { key = actualKey }
        expectToken(stream.kinds, stream.texts, stream.lines, cursor, ":")
        let actualValue = genericExpression(program, stream, cursor, scope, value, 0, depth + 1)
        if value == 0 { value = actualValue }
        skipTerminators(stream.kinds, cursor)
        if !tokenIs(stream.kinds, stream.texts, cursor, "}") { expectToken(stream.kinds, stream.texts, stream.lines, cursor, ",") }
        skipTerminators(stream.kinds, cursor)
    }
    cursor[0] = cursor[0] + 1
    return genericType(program, "Map", [key, value])
}

function genericResultConstructor(program: GenericProgram, stream: GenericStream, cursor: List<Integer>, scope: GenericScope, expected: Integer, depth: Integer): Integer {
    let position = cursor[0]
    let name = stream.texts[position]
    cursor[0] = cursor[0] + 1
    let arguments: List<Integer> = [0, 0]
    if expected > 0 && program.types[expected].name == "Result" { arguments = program.types[expected].arguments }
    if tokenIs(stream.kinds, stream.texts, cursor, "<") {
        arguments = genericArgumentTypes(program, stream, cursor)
        if arguments.length != 2 { genericError(stream, position, name + " expects two type arguments") }
        stream.replacements[position] = name + "<" + genericEmitType(program, stream, position, arguments[0], 0) + "," + genericEmitType(program, stream, position, arguments[1], 0) + ">"
        stream.ends[position] = cursor[0]
    }
    expectToken(stream.kinds, stream.texts, stream.lines, cursor, "(")
    let payload = 0
    if name == "Err" { payload = 1 }
    let actual = genericNamedType(program, "Nothing")
    if !tokenIs(stream.kinds, stream.texts, cursor, ")") { actual = genericExpression(program, stream, cursor, scope, arguments[payload], 0, depth + 1) }
    expectToken(stream.kinds, stream.texts, stream.lines, cursor, ")")
    let inferred: List<Integer> = [arguments[0], arguments[1]]
    if inferred[payload] == 0 { inferred[payload] = actual }
    return genericType(program, "Result", inferred)
}

function genericPostfix(program: GenericProgram, stream: GenericStream, cursor: List<Integer>, scope: GenericScope, type: Integer, depth: Integer): Integer {
    while tokenIs(stream.kinds, stream.texts, cursor, ".") || tokenIs(stream.kinds, stream.texts, cursor, "[") || tokenIs(stream.kinds, stream.texts, cursor, "(") {
        let token = stream.texts[cursor[0]]
        cursor[0] = cursor[0] + 1
        if token == "." {
            let member = stream.texts[cursor[0]]
            cursor[0] = cursor[0] + 1
            let called = genericChoiceMemberCall(program, stream, cursor, scope, type, member, depth + 1)
            if called >= 0 { type = called } else { type = genericMemberType(program, type, member, tokenIs(stream.kinds, stream.texts, cursor, "(")) }
        } else {
        if token == "[" {
            let keyType = genericNamedType(program, "Integer")
            if type > 0 && program.types[type].name == "Map" && program.types[type].arguments.length == 2 { keyType = program.types[type].arguments[0] }
            genericExpression(program, stream, cursor, scope, keyType, 0, depth + 1)
            expectToken(stream.kinds, stream.texts, stream.lines, cursor, "]")
            if type > 0 {
                let shape = program.types[type]
                if shape.name == "Text" { type = genericNamedType(program, "Character") } else {
                    if shape.name == "Bytes" { type = genericNamedType(program, "Integer") } else {
                        if shape.arguments.length > 0 { type = shape.arguments[shape.arguments.length - 1] } else { type = 0 }
                    }
                }
            }
        } else {
            let callSignature: List<Integer> = []
            if type > 0 && program.types[type].name == "Callback" { callSignature = program.types[type].arguments }
            let argument = 0
            while !tokenIs(stream.kinds, stream.texts, cursor, ")") {
                let expected = 0
                if argument + 1 < callSignature.length { expected = callSignature[argument] }
                genericExpression(program, stream, cursor, scope, expected, 0, depth + 1)
                if !tokenIs(stream.kinds, stream.texts, cursor, ")") { expectToken(stream.kinds, stream.texts, stream.lines, cursor, ",") }
                argument = argument + 1
            }
            cursor[0] = cursor[0] + 1
            if callSignature.length > 0 { type = callSignature[callSignature.length - 1] }
        }
        }
    }
    return type
}

function genericPrimary(program: GenericProgram, stream: GenericStream, cursor: List<Integer>, scope: GenericScope, expected: Integer, depth: Integer): Integer {
    if depth >= 256 { genericError(stream, cursor[0], "generic inference expression nesting exceeds 256") }
    let position = cursor[0]
    let token = stream.texts[position]
    let kind = stream.kinds[position]
    let type = 0
    if kind == 2 || kind == 3 || kind == 5 || kind == 7 {
        cursor[0] = cursor[0] + 1
        let name = "Integer"
        if kind == 3 { name = "Text" }
        if kind == 5 { name = "Character" }
        if kind == 7 { name = "Float" }
        return genericPostfix(program, stream, cursor, scope, genericNamedType(program, name), depth)
    }
    if token == "Set" && (stream.texts[position + 1] == "<" || stream.texts[position + 1] == "(") {
        if stream.texts[position + 1] == "<" { type = genericReadAnnotation(program, stream, cursor) } else {
            cursor[0] = cursor[0] + 1
            if expected > 0 && program.types[expected].name == "Set" { type = expected }
        }
        expectToken(stream.kinds, stream.texts, stream.lines, cursor, "(")
        expectToken(stream.kinds, stream.texts, stream.lines, cursor, ")")
        return genericPostfix(program, stream, cursor, scope, type, depth)
    }
    if kind == 1 && token == "match" {
        type = genericChoiceMatch(program, stream, cursor, scope, expected, depth + 1, true)
        return genericPostfix(program, stream, cursor, scope, type, depth)
    }
    let choiceType = genericChoiceConstructor(program, stream, cursor, scope, expected, depth + 1)
    if choiceType >= 0 { return genericPostfix(program, stream, cursor, scope, choiceType, depth) }

    if token == "{" || (token == "Map" && (stream.texts[position + 1] == "<" || stream.texts[position + 1] == "(" || stream.texts[position + 1] == "{")) {
        type = genericMap(program, stream, cursor, scope, expected, depth + 1)
        return genericPostfix(program, stream, cursor, scope, type, depth)
    }
    if (token == "Ok" || token == "Err") && genericDeclaration(program, token, 1) < 0 && genericScopeType(program, scope, token) == 0 && (stream.texts[position + 1] == "(" || stream.texts[position + 1] == "<") {
        type = genericResultConstructor(program, stream, cursor, scope, expected, depth + 1)
        return genericPostfix(program, stream, cursor, scope, type, depth)
    }
    if token == "-" || token == "!" || token == "~" || token == "try" {
        cursor[0] = cursor[0] + 1
        type = genericPrimary(program, stream, cursor, scope, expected, depth + 1)
        if token == "!" { return genericNamedType(program, "Boolean") }
        if token == "try" && type > 0 && program.types[type].name == "Result" {
            if tokenIs(stream.kinds, stream.texts, cursor, "else") {
                cursor[0] = cursor[0] + 1
                genericPrimary(program, stream, cursor, scope, genericNamedType(program, "Text"), depth + 1)
            }
            return program.types[type].arguments[0]
        }
        return type
    }
    if token == "(" {
        cursor[0] = cursor[0] + 1
        type = genericExpression(program, stream, cursor, scope, expected, 0, depth + 1)
        expectToken(stream.kinds, stream.texts, stream.lines, cursor, ")")
    } else {
    if token == "[" {
        cursor[0] = cursor[0] + 1
        let element = 0
        if expected > 0 && program.types[expected].name == "List" { element = program.types[expected].arguments[0] }
        skipTerminators(stream.kinds, cursor)
        while !tokenIs(stream.kinds, stream.texts, cursor, "]") {
            let actual = genericExpression(program, stream, cursor, scope, element, 0, depth + 1)
            if element == 0 { element = actual }
            if !tokenIs(stream.kinds, stream.texts, cursor, "]") { expectToken(stream.kinds, stream.texts, stream.lines, cursor, ",") }
            skipTerminators(stream.kinds, cursor)
        }
        cursor[0] = cursor[0] + 1
        type = genericType(program, "List", [element])
    } else {
    if token == "function" && stream.texts[position + 1] == "(" {
        cursor[0] = cursor[0] + 2
        let closure = GenericScope { names: scope.names; types: scope.types; active: scope.active; result: genericNamedType(program, "Nothing") }
        let arguments: List<Integer> = []
        let contextual: List<Integer> = []
        if expected > 0 && program.types[expected].name == "Callback" { contextual = program.types[expected].arguments }
        while !tokenIs(stream.kinds, stream.texts, cursor, ")") {
            let name = stream.texts[cursor[0]]
            cursor[0] = cursor[0] + 1
            let parameterType = 0
            if arguments.length + 1 < contextual.length { parameterType = contextual[arguments.length] }
            if tokenIs(stream.kinds, stream.texts, cursor, ":") { cursor[0] = cursor[0] + 1; parameterType = genericReadAnnotation(program, stream, cursor) }
            genericScopeAdd(closure, name, parameterType)
            arguments.add(parameterType)
            if !tokenIs(stream.kinds, stream.texts, cursor, ")") { expectToken(stream.kinds, stream.texts, stream.lines, cursor, ",") }
        }
        cursor[0] = cursor[0] + 1
        if contextual.length > 0 { closure.result = contextual[contextual.length - 1] }
        if tokenIs(stream.kinds, stream.texts, cursor, ":") { cursor[0] = cursor[0] + 1; closure.result = genericReadAnnotation(program, stream, cursor) }
        genericBlock(program, stream, cursor, closure, depth + 1)
        arguments.add(closure.result)
        type = genericType(program, "Callback", arguments)
    } else {
    if kind == 1 && genericDeclaration(program, token, 2) >= 0 && (stream.texts[position + 1] == "{" || genericHeaderFollows(stream.kinds, stream.texts, position, "{")) {
        type = genericRecord(program, stream, cursor, scope, expected, depth + 1)
    } else {
    if kind == 1 && (stream.texts[position + 1] == "(" || (stream.texts[position + 1] == "<" && genericDeclaration(program, token, 1) >= 0 && genericHeaderFollows(stream.kinds, stream.texts, position, "("))) {
        type = genericCall(program, stream, cursor, scope, expected, depth + 1)
    } else {
        cursor[0] = cursor[0] + 1
        if kind == 2 { type = genericNamedType(program, "Integer") }
        if kind == 3 { type = genericNamedType(program, "Text") }
        if kind == 5 { type = genericNamedType(program, "Character") }
        if kind == 7 { type = genericNamedType(program, "Float") }
        if kind == 1 { type = genericScopeType(program, scope, token) }
        if token == "true" || token == "false" { type = genericNamedType(program, "Boolean") }
    }
    }
    }
    }
    }
    return genericPostfix(program, stream, cursor, scope, type, depth)
}

function genericPrecedence(token: Text): Integer {
    if token == ".." || token == "..<" { return 1 }
    if token == "||" { return 2 }
    if token == "&&" { return 3 }
    if token == "==" || token == "!=" { return 4 }
    if token == "<" || token == ">" || token == "<=" || token == ">=" { return 5 }
    if token == "|" { return 6 }
    if token == "^" { return 7 }
    if token == "&" { return 8 }
    if token == "<<" || token == ">>" { return 9 }
    if token == "+" || token == "-" { return 10 }
    if token == "*" || token == "/" || token == "%" { return 11 }
    return 0
}

function genericExpectedContext(program: GenericProgram, stream: GenericStream, cursor: List<Integer>, expected: Integer): Integer {
    if expected == 0 || program.types[expected].name != "Boolean" { return expected }
    let start = cursor[0]
    let position = start
    let nested = 0
    let matching = stream.kinds[start] == 1 && stream.texts[start] == "match"
    while stream.kinds[position] != 0 && stream.kinds[position] != 6 {
        if stream.kinds[position] == 4 {
            let token = stream.texts[position]
            if token == "(" || token == "[" { nested = nested + 1 } else {
            if token == "{" {
                if nested == 0 && !matching { return expected }
                nested = nested + 1
            } else {
            if token == ")" || token == "]" || token == "}" {
                if nested == 0 { return expected }
                nested = nested - 1
            } else {
            if nested == 0 {
                if token == "," { return expected }
                let precedence = genericPrecedence(token)
                if precedence > 0 && !(position == start && token == "-") {
                    if token == "&&" || token == "||" { return expected }
                    return 0
                }
            }
            }
            }
            }
        }
        position = position + 1
    }
    return expected
}

function genericExpression(program: GenericProgram, stream: GenericStream, cursor: List<Integer>, scope: GenericScope, expected: Integer, minimum: Integer, depth: Integer): Integer {
    expected = genericExpectedContext(program, stream, cursor, expected)
    let type = genericPrimary(program, stream, cursor, scope, expected, depth + 1)
    let precedence = 0
    if stream.kinds[cursor[0]] == 4 { precedence = genericPrecedence(stream.texts[cursor[0]]) }
    while precedence > minimum {
        let token = stream.texts[cursor[0]]
        cursor[0] = cursor[0] + 1
        let right = genericExpression(program, stream, cursor, scope, type, precedence, depth + 1)
        if precedence >= 2 && precedence <= 5 { type = genericNamedType(program, "Boolean") }
        if type == 0 { type = right }
        precedence = 0
        if stream.kinds[cursor[0]] == 4 { precedence = genericPrecedence(stream.texts[cursor[0]]) }
    }
    return type
}

function genericStatement(program: GenericProgram, stream: GenericStream, cursor: List<Integer>, scope: GenericScope, depth: Integer) {
    let token = stream.texts[cursor[0]]
    let kind = stream.kinds[cursor[0]]
    if kind == 2 || kind == 3 || kind == 5 || kind == 7 {
        genericExpression(program, stream, cursor, scope, 0, 0, depth + 1)
        return
    }
    if tokenIs(stream.kinds, stream.texts, cursor, "match") {
        let result = genericChoiceMatch(program, stream, cursor, scope, 0, depth + 1, false)
        return
    }
    if (token == "let" || (scope.result == 0 && (token == "constant" || token == "global"))) && stream.kinds[cursor[0] + 1] == 1 {
        cursor[0] = cursor[0] + 1
        let name = stream.texts[cursor[0]]
        cursor[0] = cursor[0] + 1
        let declared = 0
        if tokenIs(stream.kinds, stream.texts, cursor, ":") { cursor[0] = cursor[0] + 1; declared = genericReadAnnotation(program, stream, cursor) }
        expectToken(stream.kinds, stream.texts, stream.lines, cursor, "=")
        let actual = genericExpression(program, stream, cursor, scope, declared, 0, depth + 1)
        if declared != 0 { actual = declared }
        genericScopeAdd(scope, name, actual)
        return
    }
    if token == "if" || token == "while" {
        cursor[0] = cursor[0] + 1
        genericExpression(program, stream, cursor, scope, genericNamedType(program, "Boolean"), 0, depth + 1)
        genericBlock(program, stream, cursor, scope, depth + 1)
        return
    }
    if token == "else" {
        cursor[0] = cursor[0] + 1
        if tokenIs(stream.kinds, stream.texts, cursor, "if") { genericStatement(program, stream, cursor, scope, depth + 1) } else { genericBlock(program, stream, cursor, scope, depth + 1) }
        return
    }
    if token == "for" {
        let name = stream.texts[cursor[0] + 1]
        cursor[0] = cursor[0] + 3
        let collection = genericExpression(program, stream, cursor, scope, 0, 0, depth + 1)
        let type = genericNamedType(program, "Integer")
        if collection > 0 {
            let shape = program.types[collection]
            if shape.name == "Text" { type = genericNamedType(program, "Character") }
            if shape.name == "List" || shape.name == "Set" || shape.name == "Map" { type = shape.arguments[0] }
        }
        let active = scope.active
        genericScopeAdd(scope, name, type)
        genericBlock(program, stream, cursor, scope, depth + 1)
        scope.active = active
        return
    }
    if token == "return" {
        cursor[0] = cursor[0] + 1
        if stream.kinds[cursor[0]] != 6 && !tokenIs(stream.kinds, stream.texts, cursor, "}") { genericExpression(program, stream, cursor, scope, scope.result, 0, depth + 1) }
        return
    }
    if token == "{" { genericBlock(program, stream, cursor, scope, depth + 1); return }
    let before = cursor[0]
    let assigned = genericExpression(program, stream, cursor, scope, 0, 0, depth + 1)
    if cursor[0] == before { cursor[0] = cursor[0] + 1 }
    if stream.kinds[cursor[0]] == 4 && isAssignmentOperator(stream.texts[cursor[0]]) {
        cursor[0] = cursor[0] + 1
        genericExpression(program, stream, cursor, scope, assigned, 0, depth + 1)
    }
}

function genericBlock(program: GenericProgram, stream: GenericStream, cursor: List<Integer>, scope: GenericScope, depth: Integer) {
    if depth >= 256 { genericError(stream, cursor[0], "generic inference block nesting exceeds 256") }
    expectToken(stream.kinds, stream.texts, stream.lines, cursor, "{")
    let active = scope.active
    skipTerminators(stream.kinds, cursor)
    while stream.kinds[cursor[0]] != 0 && !tokenIs(stream.kinds, stream.texts, cursor, "}") {
        genericStatement(program, stream, cursor, scope, depth + 1)
        skipTerminators(stream.kinds, cursor)
    }
    expectToken(stream.kinds, stream.texts, stream.lines, cursor, "}")
    scope.active = active
}

function genericProcessDeclaration(program: GenericProgram, stream: GenericStream, declaration: GenericDeclaration) {
    let cursor: List<Integer> = [declaration.parametersStart, 0]
    let scope = GenericScope { names: []; types: []; active: 0; result: declaration.result }
    if declaration.kind == 2 && tokenIs(stream.kinds, stream.texts, cursor, "native") { cursor[0] = cursor[0] + 2 }
    cursor[0] = cursor[0] + 1
    skipTerminators(stream.kinds, cursor)
    let closing = ")"
    if declaration.kind == 2 { closing = "}" }
    while !tokenIs(stream.kinds, stream.texts, cursor, closing) {
        if tokenIs(stream.kinds, stream.texts, cursor, "private") && stream.kinds[cursor[0] + 1] == 1 { cursor[0] = cursor[0] + 1 }
        let name = stream.texts[cursor[0]]
        cursor[0] = cursor[0] + 2
        genericScopeAdd(scope, name, genericReadAnnotation(program, stream, cursor))
        if tokenIs(stream.kinds, stream.texts, cursor, ",") { cursor[0] = cursor[0] + 1 }
        skipTerminators(stream.kinds, cursor)
    }
    cursor[0] = cursor[0] + 1
    if declaration.kind == 1 {
        if tokenIs(stream.kinds, stream.texts, cursor, ":") { cursor[0] = cursor[0] + 1; scope.result = genericReadAnnotation(program, stream, cursor) }
        genericBlock(program, stream, cursor, scope, 0)
    }
}

function genericAppendReplacement(outputKinds: List<Integer>, outputTexts: List<Text>, outputLines: SourceMap, replacement: Text, stream: GenericStream, position: Integer) {
    let kinds: List<Integer> = []
    let texts: List<Text> = []
    let lines = newSourceMap()
    tokenize(replacement, kinds, texts, lines)
    let origin = sourcePath(outputLines, tokenPath(stream.lines, position))
    let token = 0
    let loopEnd13 = kinds.length - 1
    while token < loopEnd13 {
        copyModuleToken(outputKinds, outputTexts, outputLines, kinds[token], texts[token], stream.lines, position, origin)

        token = token + 1
    }
    // Adjacent closing angles must remain separate for the ordinary type reader.
}

function genericAppendStream(stream: GenericStream, outputKinds: List<Integer>, outputTexts: List<Text>, outputLines: SourceMap) {
    let position = 0
    while stream.kinds[position] != 0 {
        if stream.ends[position] > position {
            if stream.replacements[position] != "" { genericAppendReplacement(outputKinds, outputTexts, outputLines, stream.replacements[position], stream, position) }
            position = stream.ends[position]
        } else {
            copyModuleToken(outputKinds, outputTexts, outputLines, stream.kinds[position], stream.texts[position], stream.lines, position, sourcePath(outputLines, tokenPath(stream.lines, position)))
            position = position + 1
        }
    }
    let remaining = stream.lines.features
    let feature = 1
    while remaining > 0 {
        if remaining % 2 != 0 && outputLines.features / feature % 2 == 0 { outputLines.features = outputLines.features + feature }
        remaining = remaining / 2
        feature = feature * 2
    }
    copyModuleToken(outputKinds, outputTexts, outputLines, 6, "end of generic declaration", stream.lines, position, sourcePath(outputLines, tokenPath(stream.lines, position)))
}

function genericInstanceStream(program: GenericProgram, instance: GenericInstance): GenericStream {
    let declaration = program.declarations[instance.declaration]
    let source = program.source
    let kinds: List<Integer> = []
    let texts: List<Text> = []
    let lines = newSourceMap()
    lines.features = source.lines.features
    if declaration.kind == 2 && source.texts[declaration.parametersStart] == "native" && lines.features / 32 % 2 == 0 { lines.features = lines.features + 32 }
    let typePositions = program.typePositions
    let position = declaration.start
    let angleDepth = 0
    while position < declaration.end {
        if position == declaration.start + 1 {
            copyModuleToken(kinds, texts, lines, 1, instance.name, source.lines, position, sourcePath(lines, tokenPath(source.lines, position)))
            position = declaration.parametersStart
        } else {
            let token = source.texts[position]
            if source.kinds[position] == 4 && token == "<" && position > declaration.start && (typePositions[position] || angleDepth > 0 || genericHeaderFollows(source.kinds, source.texts, position - 1, "(") || genericHeaderFollows(source.kinds, source.texts, position - 1, "{")) { angleDepth = angleDepth + 1 }
            let variable = findText(declaration.variables, token)
            let substitute = variable >= 0 && source.kinds[position] == 1 && (typePositions[position] || angleDepth > 0) && source.texts[position + 1] != ":" && source.texts[position - 1] != "."
            if substitute {
                genericAppendReplacement(kinds, texts, lines, program.types[instance.arguments[variable]].spelling, source, position)
            } else {
                copyModuleToken(kinds, texts, lines, source.kinds[position], token, source.lines, position, sourcePath(lines, tokenPath(source.lines, position)))
            }
            if token == ">" && angleDepth > 0 { angleDepth = angleDepth - 1 }
            if token == ">>" && angleDepth > 0 { angleDepth = angleDepth - 2; if angleDepth < 0 { angleDepth = 0 } }
            position = position + 1
        }
    }
    addEndToken(kinds, texts, lines, "end of generic instantiation")
    return newGenericStream(kinds, texts, lines)
}

function normalizeGenericTokens(kinds: List<Integer>, texts: List<Text>, lines: SourceMap): CallbackTokens {
    let source = newGenericStream(kinds, texts, lines)
    let declarations: List<GenericDeclaration> = []
    let types: List<GenericType> = []
    let instances: List<GenericInstance> = []
    let program = GenericProgram { source: source; typePositions: callbackTypePositions(kinds, texts); declarations: declarations; declarationIndex: newGenericIndex(); types: types; typeIndex: newGenericIndex(); instances: instances; instanceIndex: newGenericIndex(); constraints: []; constraintIndex: newGenericIndex(); aliases: newGenericIndex(); aliasPositions: [] }
    genericNamedType(program, "?")
    let cursor: List<Integer> = [0, 0]
    skipTerminators(kinds, cursor)
    while kinds[cursor[0]] != 0 {
        let start = cursor[0]
        if isTypeAliasDeclaration(kinds, texts, cursor) {
            genericCollectAlias(program, source, cursor)
        } else {
        if kinds[start] == 1 && (texts[start] == "function" || texts[start] == "record") {
            skipDeclaration(kinds, texts, cursor)
            let declaration = genericCollectDeclaration(program, source, start, cursor[0])
            if resultPrefix(declaration.name, "minyar_generic_") || resultPrefix(readableDeclarationName(declaration.name), "minyar_generic_") { genericError(source, start + 1, "reserved generic compiler name") }
            if declaration.kind == 1 && isBuiltinName(readableDeclarationName(declaration.name)) { genericError(source, start + 1, "function '" + readableDeclarationName(declaration.name) + "' uses a reserved built-in name; rename this function") }
            if declaration.name == "main" && declaration.variables.length > 0 { genericError(source, start + 1, "main cannot have type parameters") }
            let key = Text(declaration.kind) + ":" + declaration.name
            if genericIndexGet(program.declarationIndex, key) >= 0 || (declaration.kind == 2 && genericIndexGet(program.aliases, declaration.name) >= 0) { genericError(source, start + 1, "module declares '" + readableDeclarationName(declaration.name) + "' more than once") }
            genericIndexPut(program.declarationIndex, key, declarations.length)
            declarations.add(declaration)
        } else {
            if kinds[start] == 1 && (texts[start] == "constant" || texts[start] == "global") {
                let marker: List<Integer> = [start + 2, 0]
                let type = 0
                if texts[marker[0]] == ":" { marker[0] = marker[0] + 1; type = genericReadType(program, source, marker, 0) } else {
                    let literal = marker[0] + 1
                    if texts[literal] == "-" { literal = literal + 1 }
                    if kinds[literal] == 2 { type = genericNamedType(program, "Integer") }
                    if kinds[literal] == 3 { type = genericNamedType(program, "Text") }
                    if kinds[literal] == 5 { type = genericNamedType(program, "Character") }
                    if kinds[literal] == 7 { type = genericNamedType(program, "Float") }
                    if texts[literal] == "true" || texts[literal] == "false" { type = genericNamedType(program, "Boolean") }
                }
                genericIndexPut(program.declarationIndex, "3:" + texts[start + 1], type - 1)
            }
            skipTopLevelStatement(kinds, texts, cursor)
        }
        }
        skipTerminators(kinds, cursor)
    }
    genericResolveAliases(program)
    let scope = GenericScope { names: []; types: []; active: 0; result: 0 }
    cursor[0] = 0
    skipTerminators(kinds, cursor)
    while kinds[cursor[0]] != 0 {
        let start = cursor[0]
        if isTypeAliasDeclaration(kinds, texts, cursor) {
            cursor[0] = source.ends[start]
        } else {
        if kinds[start] == 1 && (texts[start] == "function" || texts[start] == "record") {
            let kind = 1
            if texts[start] == "record" { kind = 2 }
            let declaration = declarations[genericDeclaration(program, texts[start + 1], kind)]
            if declaration.variables.length == 0 { genericProcessDeclaration(program, source, declaration) } else {
                source.ends[start] = declaration.end
            }
            cursor[0] = declaration.end
        } else { genericStatement(program, source, cursor, scope, 0) }
        }
        skipTerminators(kinds, cursor)
    }
    let outputKinds: List<Integer> = []
    let outputTexts: List<Text> = []
    let outputLines = newSourceMap()
    genericAppendStream(source, outputKinds, outputTexts, outputLines)
    genericAppendAliasChecks(program, outputKinds, outputTexts, outputLines)
    let instance = 0
    let constraint = 0
    while instance < instances.length || constraint < program.constraints.length {
        if instance < instances.length {
        let stream = genericInstanceStream(program, instances[instance])
        let declaration = genericCollectDeclaration(program, stream, 0, stream.kinds.length - 1)
        genericProcessDeclaration(program, stream, declaration)
        genericAppendStream(stream, outputKinds, outputTexts, outputLines)
        instance = instance + 1
        } else {
            let bound = program.constraints[constraint]
            let declaration = "record minyar_generic_constraint_" + bound.capability + "_" + Text(constraint) + " { " + bound.variable + ": " + genericEmitType(program, bound.stream, bound.position, bound.type, 0) + " }\n"
            genericAppendReplacement(outputKinds, outputTexts, outputLines, declaration, bound.stream, bound.position)
            constraint = constraint + 1
        }
    }
    addEndToken(outputKinds, outputTexts, outputLines, "end of generic program")
    return CallbackTokens { kinds: outputKinds; texts: outputTexts; lines: outputLines }
}
