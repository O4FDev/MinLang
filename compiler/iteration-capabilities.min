// These capabilities infer their cursor and item types from concrete methods.
function iterationShapeMethod(context: CompilerContext, type: Integer, member: Text): Integer {
    if !isRecordType(type) { return -1 }
    let name = context.functionNames[type - 1000]
    let target = findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, methodFunctionName(name, member))
    if target < 0 { target = findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, methodFunctionName(name, member + "$private")) }
    if target < 0 || context.functionParameterCounts[target] != 1 { return -1 }
    let offset = functionParameterOffset(context.functionParameterCounts, target)
    if context.functionParameterTypes[offset] != type { return -1 }
    return target
}

function iterationCursorElement(context: CompilerContext, type: Integer): Integer {
    let advance = iterationShapeMethod(context, type, "advance")
    let current = iterationShapeMethod(context, type, "current")
    if advance < 0 || current < 0 { return 0 }
    if context.functionReturnTypes[advance] != 4 || context.functionReturnTypes[current] == 5 { return 0 }
    return context.functionReturnTypes[current]
}

function iterationSupportsCapability(context: CompilerContext, type: Integer, capability: Text): Boolean {
    if capability == "Iterator" { return iterationCursorElement(context, type) != 0 }
    if isListType(type) || isMapType(type) || isSetType(type) || type == 2 || type == 8 { return true }
    if sequenceRecipeKind(context, type) != 0 { return true }
    let iterator = iterationShapeMethod(context, type, "iterator")
    if iterator < 0 { return false }
    return iterationCursorElement(context, context.functionReturnTypes[iterator]) != 0
}
