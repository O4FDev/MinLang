function isThreadType(type: Integer): Boolean {
    return type >= 9 && type <= 18
}

function isThreadBuiltin(name: Text): Boolean {
    if name == "nativeThreadSetup" || name == "mapNativeRegion" || name == "tryMapNativeRegion" || name == "shareNativeRegions" || name == "nativeRegionAddress" || name == "threadKernelKick" || name == "threadEventfd" || name == "threadEventfdRead" || name == "threadEventfdNotify" { return true }
    return name == "freezeBytes" || name == "freezeBytesTake" || name == "copyFrozenBytes" || name == "bytesChannel" || name == "trySendBytes" || name == "sendBytes" || name == "tryReceiveBytes" || name == "receiveBytes" || name == "closeBytesChannel" || name == "startThread" || name == "joinThread" || name == "startThreadResult" || name == "joinThreadResult" || name == "frozenBytesChannel" || name == "trySendFrozen" || name == "sendFrozen" || name == "tryReceiveFrozen" || name == "receiveFrozen" || name == "closeFrozenChannel" || name == "threadProcessId" || name == "threadSleepNanoseconds" || name == "threadFsync" || name == "threadKernelRun"
}

function threadProgram(kinds: List<Integer>, texts: List<Text>): Boolean {
    let i = 0
    while i < kinds.length {
        if (kinds[i] == 1 || kinds[i] == 6) && (texts[i] == "thread" || isThreadType(simpleTypeCode(texts[i])) || isThreadBuiltin(texts[i])) { return true }
        i = i + 1
    }
    return false
}

function threadMode(globals: List<Text>): Boolean {
    return findText(globals, "; minyar-thread-runtime: 1\n") >= 0
}

function threadEntry(globals: List<Text>, name: Text): Boolean {
    return findText(globals, "; minyar-thread-entry: " + name + "\n") >= 0
}

function threadSignature(result: Integer, types: List<Integer>): Text {
    let signature = Text(result) + "("
    let i = 0
    while i < types.length {
        if i > 0 { signature = signature + "," }
        signature = signature + Text(types[i])
        i = i + 1
    }
    return signature + ")"
}

function threadField(value: Text): Text { return Text(value.length) + ":" + value }

function threadNote(output: List<Text>, caller: Text, kind: Text, name: Text, signature: Text) {
    if caller == "top level" { caller = "main" }
    output.add("  ; minyar-thread-effect: " + threadField(caller) + threadField(kind) + threadField(name) + threadField(signature) + "\n")
}

function threadReadField(text: Text, cursor: List<Integer>): Text {
    let length = 0
    while cursor[0] < text.length && text[cursor[0]] >= '0' && text[cursor[0]] <= '9' {
        length = length * 10 + Integer(text[cursor[0]]) - Integer('0')
        cursor[0] = cursor[0] + 1
    }
    if cursor[0] >= text.length || text[cursor[0]] != ':' { fail("invalid thread effect metadata") }
    cursor[0] = cursor[0] + 1
    let start = cursor[0]
    cursor[0] = start + length
    if cursor[0] > text.length { fail("invalid thread effect metadata") }
    return text.slice(start, cursor[0])
}

function threadParameters(name: Text, actual: List<Integer>, expected: List<Integer>) {
    let correct = actual.length == expected.length
    let i = 0
    while correct && i < actual.length {
        correct = actual[i] == expected[i]
        i = i + 1
    }
    if !correct { fail(name + " has the wrong thread boundary argument types") }
}

function threadBuiltin(output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, values: List<Text>, types: List<Integer>, target: Text, inputType: Integer, channelType: Integer, resultType: List<Integer>): Text {
    let expected: List<Integer> = []
    let result = 5
    let callee = ""
    if name == "nativeThreadSetup" { callee = "minyar_native_thread_setup" }
    if name == "mapNativeRegion" || name == "tryMapNativeRegion" {
        expected = [1, 1, 1, 1, 1]; result = 16; callee = "minyar_native_region_map"
        if name == "tryMapNativeRegion" { result = 18; callee = "minyar_native_region_try_map" }
    }
    if name == "shareNativeRegions" { expected.add(100016); result = 17; callee = "minyar_native_regions_share" }
    if name == "nativeRegionAddress" { expected.add(16); result = 1; callee = "minyar_native_region_address" }
    if name == "threadKernelKick" { expected = [11, 16]; result = 1; callee = "minyar_thread_kernel_kick" }
    if name == "threadEventfd" { expected.add(1); result = 1; callee = "minyar_thread_eventfd" }
    if name == "threadEventfdRead" { expected.add(1); result = 1; callee = "minyar_thread_eventfd_read" }
    if name == "threadEventfdNotify" { expected = [1, 1]; result = 1; callee = "minyar_thread_eventfd_notify" }
    if name == "freezeBytes" { expected.add(8); result = 9; callee = "minyar_frozen_bytes_copy" }
    if name == "freezeBytesTake" { expected.add(8); result = 9; callee = "minyar_frozen_bytes_take" }
    if name == "copyFrozenBytes" { expected.add(9); result = 8; callee = "minyar_frozen_bytes_local_copy" }
    if name == "bytesChannel" { expected.add(1); expected.add(1); result = 10; callee = "minyar_bytes_channel_new" }
    if name == "trySendBytes" || name == "sendBytes" {
        expected.add(10); expected.add(8); result = 4; callee = "minyar_bytes_channel_try_send"
        if name == "sendBytes" { callee = "minyar_bytes_channel_send" }
    }
    if name == "tryReceiveBytes" || name == "receiveBytes" {
        expected.add(10); expected.add(8); result = 1; callee = "minyar_bytes_channel_try_receive"
        if name == "receiveBytes" { result = 4; callee = "minyar_bytes_channel_receive" }
    }
    if name == "closeBytesChannel" { expected.add(10); callee = "minyar_bytes_channel_close" }
    if name == "joinThread" { expected.add(11); result = 1; callee = "minyar_thread_join" }
    if name == "joinThreadResult" { expected.add(11); result = 13; callee = "minyar_thread_join_result" }
    if name == "frozenBytesChannel" { expected.add(1); expected.add(1); result = 14; callee = "minyar_frozen_channel_new" }
    if name == "trySendFrozen" || name == "sendFrozen" {
        expected.add(14); expected.add(9); result = 4; callee = "minyar_frozen_channel_try_send"
        if name == "sendFrozen" { callee = "minyar_frozen_channel_send" }
    }
    if name == "tryReceiveFrozen" || name == "receiveFrozen" {
        expected.add(14); result = 15; callee = "minyar_frozen_channel_try_receive"
        if name == "receiveFrozen" { callee = "minyar_frozen_channel_receive" }
    }
    if name == "closeFrozenChannel" { expected.add(14); callee = "minyar_frozen_channel_close" }
    if name == "threadProcessId" { result = 1; callee = "minyar_thread_process_id" }
    if name == "threadSleepNanoseconds" { expected.add(1); result = 1; callee = "minyar_thread_sleep_ns" }
    if name == "threadFsync" { expected.add(1); result = 1; callee = "minyar_thread_fsync" }
    if name == "threadKernelRun" { expected.add(1); result = 1; callee = "minyar_thread_kernel_run" }
    if name == "startThread" || name == "startThreadResult" {
        expected.add(1); expected.add(inputType); expected.add(channelType); result = 11; callee = "minyar_thread_spawn"
        if name == "startThreadResult" { result = 12; callee = "minyar_thread_spawn_result" }
    }
    threadParameters(name, types, expected)
    if name == "startThread" || name == "startThreadResult" {
        let bridgeValues: List<Text> = ["@.minyar.thread.bridge." + target, values[0], values[1], values[2]]
        let bridgeTypes: List<Integer> = [9, 1, inputType, channelType]
        if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "spawn", target, "1(1,9,10)") }
        setType(resultType, result)
        return emitCall(output, textState, state, result, callee, bridgeValues, bridgeTypes)
    }
    if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "builtin", name, threadSignature(result, types)) }
    setType(resultType, result)
    return emitCall(output, textState, state, result, callee, values, types)
}

function threadFrozenMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, member: Text, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    if member != "getUInt8" && member != "getInt64" { fail("FrozenBytes exposes only immutable readers") }
    let positionType: List<Integer> = [0]
    let position = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, positionType)
    requireType(tokenLines, state, positionType[0], 1, "FrozenBytes position must be Integer")
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    let callee = "minyar_frozen_bytes_get_uint8"
    if member == "getInt64" { callee = "minyar_frozen_bytes_get_int64" }
    let types: List<Integer> = [9, 1]
    setType(resultType, 1)
    return emitCall(output, textState, state, 1, callee, pairOf(receiver, position), types)
}

function threadRegionMember(output: List<Text>, textState: List<Text>, state: List<Integer>, receiver: Text, type: Integer, member: Text, resultType: List<Integer>): Text {
    let callee = "minyar_native_region_length"
    if type == 17 { callee = "minyar_native_regions_length" }
    if member == "address" && type == 16 {
        callee = "minyar_native_region_address"
        threadNote(output, textState[1], "builtin", "nativeRegionAddress", "1(16)")
    } else if member != "length" { fail("a native region exposes only length and main-only address") }
    setType(resultType, 1)
    let types: List<Integer> = [type]
    let values: List<Text> = [receiver]
    return emitCall(output, textState, state, 1, callee, values, types)
}

function threadRegionMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, type: Integer, member: Text, resultType: List<Integer>): Text {
    let expected: List<Integer> = [1]
    let result = 1
    let callee = ""
    if type == 17 {
        if member != "get" { fail("NativeRegions exposes only checked get") }
        result = 16; callee = "minyar_native_regions_get"
    } else {
        if member == "getUInt8" { callee = "minyar_native_region_get_uint8" }
        if member == "getUInt16" { callee = "minyar_native_region_get_uint16" }
        if member == "getUInt32" { callee = "minyar_native_region_get_uint32" }
        if member == "getInt64" { callee = "minyar_native_region_get_int64" }
        if member == "setUInt8" { callee = "minyar_native_region_set_uint8"; expected.add(1); result = 5 }
        if member == "setUInt16" { callee = "minyar_native_region_set_uint16"; expected.add(1); result = 5 }
        if member == "setUInt32" { callee = "minyar_native_region_set_uint32"; expected.add(1); result = 5 }
        if member == "setInt64" { callee = "minyar_native_region_set_int64"; expected.add(1); result = 5 }
        if member == "loadAcquireUInt8" { callee = "minyar_native_region_load_u8" }
        if member == "storeReleaseUInt8" { callee = "minyar_native_region_store_u8"; expected.add(1); result = 5 }
        if member == "loadAcquireUInt32" { callee = "minyar_native_region_load_u32" }
        if member == "storeReleaseUInt32" { callee = "minyar_native_region_store_u32"; expected.add(1); result = 5 }
        if member == "compareExchangeUInt32" { callee = "minyar_native_region_cas_u32"; expected.add(1); expected.add(1) }
        if member == "loadAcquireInt64" { callee = "minyar_native_region_load_i64" }
        if member == "storeReleaseInt64" { callee = "minyar_native_region_store_i64"; expected.add(1); result = 5 }
        if member == "atomicAddInt64" { callee = "minyar_native_region_add_i64"; expected.add(1) }
        if member == "copyFromBytes" { callee = "minyar_native_region_copy_from"; expected.add(8); result = 5 }
        if member == "copyToBytes" { callee = "minyar_native_region_copy_to"; expected.add(1); result = 8 }
        if member == "kernelRun" { callee = "minyar_native_region_kernel_run" }
        if callee == "" { fail("unknown checked native region method") }
    }
    let values: List<Text> = [receiver]
    let types: List<Integer> = [type]
    let i = 0
    while i < expected.length {
        if i > 0 { expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ",") }
        let argumentType: List<Integer> = [expected[i]]
        values.add(parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType))
        requireType(context.tokenLines, state, argumentType[0], expected[i], "wrong checked native region argument type")
        types.add(argumentType[0])
        i = i + 1
    }
    expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ")")
    setType(resultType, result)
    return emitCall(output, textState, state, result, callee, values, types)
}

function threadValidateEntries(globals: List<Text>, names: List<Text>, kinds: List<Integer>, results: List<Integer>, counts: List<Integer>, parameters: List<Integer>) {
    let prefix = "; minyar-thread-entry: "
    let i = 0
    while i < globals.length {
        let marker = globals[i]
        if marker.length > prefix.length && marker.slice(0, prefix.length) == prefix {
            let name = markerValue(marker, prefix)
            let function = findFunction(names, kinds, results, name)
            let valid = function >= 0 && name != "main" && name[0] != '"'
            if valid {
                valid = counts[function] == 3 && (results[function] == 1 || results[function] == 5)
                if valid {
                    let first = functionParameterOffset(counts, function)
                    valid = parameters[first] == 1 && (parameters[first + 1] == 9 || parameters[first + 1] == 16 || parameters[first + 1] == 17) && (parameters[first + 2] == 10 || parameters[first + 2] == 14)
                }
            }
            if !valid { fail("thread entry '" + readableDeclarationName(name) + "' requires (Integer, FrozenBytes or native region capability, BytesChannel or FrozenBytesChannel) and Integer or Nothing result") }
        }
        i = i + 1
    }
}

function threadNativeAllowed(name: Text, signature: Text): Boolean { return false }

function threadNativeSetupAllowed(name: Text, signature: Text): Boolean {
    if name == "minyar_zstd_rawCreateDCtx" { return signature == "1()" }
    if name == "minyar_zstd_rawCloseDCtx" { return signature == "5(1)" }
    if name == "minyar_zstd_bufferDecompress" { return signature == "1(1,8,8)" }
    if name == "minyar_machine_address" { return signature == "1(8)" }
    if name == "minyar_machine_syscall" { return signature == "1(1,1,1,1,1,1,1)" }
    if name == "minyar_machine_load8" || name == "minyar_machine_load16" || name == "minyar_machine_load32" || name == "minyar_machine_load64" || name == "minyar_machine_read8" || name == "minyar_machine_read16" || name == "minyar_machine_read32" || name == "minyar_machine_read64" || name == "minyar_machine_loadAcquire32" || name == "minyar_machine_loadAcquire64" { return signature == "1(1)" }
    if name == "minyar_machine_store8" || name == "minyar_machine_store16" || name == "minyar_machine_store32" || name == "minyar_machine_store64" || name == "minyar_machine_write8" || name == "minyar_machine_write16" || name == "minyar_machine_write32" || name == "minyar_machine_write64" || name == "minyar_machine_storeRelease32" || name == "minyar_machine_storeRelease64" { return signature == "5(1,1)" }
    if name == "minyar_machine_copy" || name == "minyar_machine_fill8" || name == "minyar_machine_fill32" { return signature == "5(1,1,1)" }
    if name == "minyar_machine_atomicAdd" { return signature == "1(1,1)" }
    if name == "minyar_machine_compareExchange32" || name == "minyar_machine_compareExchange64" { return signature == "1(1,1,1)" }
    return false
}

function threadNativeSetupEnabled(callers: List<Text>, kinds: List<Text>, names: List<Text>): Boolean {
    let pending: List<Text> = ["main"]
    let seen: List<Text> = []
    let cursor = 0
    while cursor < pending.length {
        let caller = pending[cursor]
        cursor = cursor + 1
        if findText(seen, caller) < 0 {
            seen.add(caller)
            let i = 0
            while i < callers.length {
                if callers[i] == caller {
                    if kinds[i] == "builtin" && names[i] == "nativeThreadSetup" { return true }
                    if kinds[i] == "call" { pending.add(names[i]) }
                }
                i = i + 1
            }
        }
    }
    return false
}

function threadBuiltinAllowed(name: Text): Boolean {
    return isThreadBuiltin(name) || isFloatFunction(name) || name == "atan2" || name == "pow" || name == "abs" || name == "min" || name == "max" || name == "clamp" || name == "wrappingAdd" || name == "wrappingSubtract" || name == "wrappingMultiply" || name == "Bytes" || name == "Text" || name == "Float" || name == "Integer" || name == "Character" || name == "print" || name == "fail" || name == "joinText" || name == "argument" || name == "argumentCount"
}

function threadManagedGetter(name: Text, metadata: List<Text>): Boolean {
    let prefix = "\"minyar.constant|"
    if name.length <= prefix.length || name.slice(0, prefix.length) != prefix { return false }
    let tail = name.slice(prefix.length, name.length)
    let separator = findCharacter(tail, '|')
    if separator < 0 { fail("unreviewed module constant getter") }
    let resolved = tail.slice(0, separator)
    let scalar = "; minyar-module-constant: " + resolved + "|scalar\n"
    let managed = "; minyar-module-constant: " + resolved + "|managed\n"
    if findText(metadata, scalar) >= 0 { return false }
    if findText(metadata, managed) >= 0 { return true }
    fail("unreviewed module constant getter '" + resolved + "'")
    return true
}

function threadConstantIdentity(name: Text): Text {
    let prefix = "\"minyar.constant|"
    if name.length <= prefix.length || name.slice(0, prefix.length) != prefix { return "" }
    let tail = name.slice(prefix.length, name.length)
    let separator = findCharacter(tail, '|')
    if separator < 0 { fail("unreviewed module constant getter") }
    return tail.slice(0, separator)
}

function threadCheckGraph(output: List<Text>, globals: List<Text>) {
    if !threadMode(globals) { return }
    let callers: List<Text> = []
    let kinds: List<Text> = []
    let names: List<Text> = []
    let signatures: List<Text> = []
    let metadata: List<Text> = []
    let i = 0
    while i < globals.length { metadata.add(globals[i]); i = i + 1 }
    let prefix = "  ; minyar-thread-effect: "
    i = 0
    while i < output.length {
        let piece = output[i]
        metadata.add(piece)
        if piece.length > prefix.length && piece.slice(0, prefix.length) == prefix {
            let cursor: List<Integer> = [prefix.length]
            callers.add(threadReadField(piece, cursor)); kinds.add(threadReadField(piece, cursor))
            names.add(threadReadField(piece, cursor)); signatures.add(threadReadField(piece, cursor))
        }
        i = i + 1
    }
    let nativeSetup = threadNativeSetupEnabled(callers, kinds, names)
    let pass = 0
    while pass < 2 {
        let pending: List<Text> = []
        if pass == 0 { pending.add("main") }
        if pass == 0 {
            let constantPrefix = "; minyar-module-constant: "
            let constantIndex = 0
            while constantIndex < metadata.length {
                let marker = metadata[constantIndex]
                if marker.length > constantPrefix.length && marker.slice(0, constantPrefix.length) == constantPrefix {
                    let value = markerValue(marker, constantPrefix)
                    let separator = findCharacter(value, '|')
                    if separator < 0 { fail("invalid module constant effect metadata") }
                    pending.add("constant " + value.slice(0, separator))
                }
                constantIndex = constantIndex + 1
            }
        }
        i = 0
        let entryPrefix = "; minyar-thread-entry: "
        while i < globals.length {
            let marker = globals[i]
            if marker.length > entryPrefix.length && marker.slice(0, entryPrefix.length) == entryPrefix { pending.add(markerValue(marker, entryPrefix)) }
            i = i + 1
        }
        let seen: List<Text> = []
        let cursor = 0
        while cursor < pending.length {
            let caller = pending[cursor]
            cursor = cursor + 1
            if findText(seen, caller) < 0 {
                seen.add(caller)
                i = 0
                while i < callers.length {
                    if callers[i] == caller {
                        let kind = kinds[i]
                        let name = names[i]
                        let allowed = true
                        if kind == "call" || kind == "spawn" {
                            if threadManagedGetter(name, metadata) && pass == 1 { allowed = false }
                            pending.add(name)
                        } else if kind == "recovery" {
                            allowed = pass == 0
                        } else if kind == "indirect" && (name == "closure creation" || name == "callback call") {
                            allowed = pass == 0
                            pending.add("callback")
                        } else if kind == "native" {
                            allowed = threadNativeAllowed(name, signatures[i])
                            if pass == 0 && nativeSetup { allowed = threadNativeSetupAllowed(name, signatures[i]) }
                        } else if kind == "builtin" {
                            allowed = threadBuiltinAllowed(name)
                            if pass == 0 && nativeSetup && name == "exit" && signatures[i] == "0(1)" { allowed = true }
                            if pass == 1 && (name == "nativeThreadSetup" || name == "nativeRegionAddress") { allowed = false }
                        } else if kind == "constant" {
                            let managed = "; minyar-module-constant: " + name + "|managed\n"
                            if pass == 1 && findText(metadata, managed) >= 0 { allowed = false }
                        } else if kind == "runtime" {
                            allowed = true
                            if threadConstantIdentity(name) != "" {
                                if threadManagedGetter(name, metadata) && pass == 1 { allowed = false }
                            }
                        } else { allowed = false }
                        if !allowed { fail("unsafe thread effect in '" + readableDeclarationName(caller) + "': " + kind + " '" + name + "' " + signatures[i]) }
                    }
                    i = i + 1
                }
            }
        }
        pass = pass + 1
    }
}

function threadAppendABI(output: List<Text>, globals: List<Text>, names: List<Text>, kinds: List<Integer>, results: List<Integer>, recoverable: Boolean) {
    if !threadMode(globals) { return }
    let declarations: List<Text> = [
        "declare void @minyar_native_thread_setup()",
        "declare ptr @minyar_native_region_map(i64, i64, i64, i64, i64)",
        "declare ptr @minyar_native_region_try_map(i64, i64, i64, i64, i64)",
        "declare ptr @minyar_native_region_result_value(ptr)",
        "declare i64 @minyar_native_region_length(ptr)",
        "declare i64 @minyar_native_region_address(ptr)",
        "declare ptr @minyar_native_regions_share(ptr)",
        "declare i64 @minyar_native_regions_length(ptr)",
        "declare ptr @minyar_native_regions_get(ptr, i64)",
        "declare i64 @minyar_native_region_get_uint8(ptr, i64)",
        "declare i64 @minyar_native_region_get_uint16(ptr, i64)",
        "declare i64 @minyar_native_region_get_uint32(ptr, i64)",
        "declare i64 @minyar_native_region_get_int64(ptr, i64)",
        "declare void @minyar_native_region_set_uint8(ptr, i64, i64)",
        "declare void @minyar_native_region_set_uint16(ptr, i64, i64)",
        "declare void @minyar_native_region_set_uint32(ptr, i64, i64)",
        "declare void @minyar_native_region_set_int64(ptr, i64, i64)",
        "declare i64 @minyar_native_region_load_u8(ptr, i64)",
        "declare void @minyar_native_region_store_u8(ptr, i64, i64)",
        "declare i64 @minyar_native_region_load_u32(ptr, i64)",
        "declare void @minyar_native_region_store_u32(ptr, i64, i64)",
        "declare i64 @minyar_native_region_cas_u32(ptr, i64, i64, i64)",
        "declare i64 @minyar_native_region_load_i64(ptr, i64)",
        "declare void @minyar_native_region_store_i64(ptr, i64, i64)",
        "declare i64 @minyar_native_region_add_i64(ptr, i64, i64)",
        "declare void @minyar_native_region_copy_from(ptr, i64, ptr)",
        "declare ptr @minyar_native_region_copy_to(ptr, i64, i64)",
        "declare i64 @minyar_native_region_kernel_run(ptr, i64)",
        "declare i64 @minyar_thread_kernel_kick(ptr, ptr)",
        "declare i64 @minyar_thread_eventfd(i64)",
        "declare i64 @minyar_thread_eventfd_read(i64)",
        "declare i64 @minyar_thread_eventfd_notify(i64, i64)",
        "declare ptr @minyar_frozen_bytes_copy(ptr)",
        "declare ptr @minyar_frozen_bytes_take(ptr)",
        "declare ptr @minyar_frozen_bytes_local_copy(ptr)",
        "declare i64 @minyar_frozen_bytes_length(ptr)",
        "declare i64 @minyar_frozen_bytes_get_uint8(ptr, i64)",
        "declare i64 @minyar_frozen_bytes_get_int64(ptr, i64)",
        "declare ptr @minyar_bytes_channel_new(i64, i64)",
        "declare zeroext i1 @minyar_bytes_channel_try_send(ptr, ptr)",
        "declare zeroext i1 @minyar_bytes_channel_send(ptr, ptr)",
        "declare i64 @minyar_bytes_channel_try_receive(ptr, ptr)",
        "declare zeroext i1 @minyar_bytes_channel_receive(ptr, ptr)",
        "declare void @minyar_bytes_channel_close(ptr)",
        "declare ptr @minyar_thread_spawn(ptr, i64, ptr, ptr)",
        "declare i64 @minyar_thread_join(ptr)",
        "declare void @minyar_thread_join_children()",
        "declare ptr @minyar_thread_text_literal(ptr)",
        "declare ptr @minyar_thread_spawn_result(ptr, i64, ptr, ptr)",
        "declare ptr @minyar_thread_join_result(ptr)",
        "declare i64 @minyar_thread_result_code(ptr)",
        "declare ptr @minyar_thread_start_result_value(ptr)",
        "declare i64 @minyar_thread_join_result_value(ptr)",
        "declare ptr @minyar_frozen_channel_new(i64, i64)",
        "declare zeroext i1 @minyar_frozen_channel_try_send(ptr, ptr)",
        "declare zeroext i1 @minyar_frozen_channel_send(ptr, ptr)",
        "declare ptr @minyar_frozen_channel_try_receive(ptr)",
        "declare ptr @minyar_frozen_channel_receive(ptr)",
        "declare void @minyar_frozen_channel_close(ptr)",
        "declare i64 @minyar_frozen_result_code(ptr)",
        "declare ptr @minyar_frozen_result_value(ptr)",
        "declare i64 @minyar_thread_process_id()",
        "declare i64 @minyar_thread_sleep_ns(i64)",
        "declare i64 @minyar_thread_fsync(i64)",
        "declare i64 @minyar_thread_kernel_run(i64)"
    ]
    let declaration = 0
    while declaration < declarations.length {
        output.add(declarations[declaration] + "\n")
        declaration = declaration + 1
    }
    let prefix = "; minyar-thread-entry: "
    let i = 0
    while i < globals.length {
        let marker = globals[i]
        if marker.length > prefix.length && marker.slice(0, prefix.length) == prefix {
            let name = markerValue(marker, prefix)
            let function = findFunction(names, kinds, results, name)
            threadAppendBridge(output, name, results[function], recoverable)
        }
        i = i + 1
    }
}

function threadAppendBridge(output: List<Text>, name: Text, result: Integer, recovery: Boolean) {
    output.add("define internal i64 @.minyar.thread.bridge." + name + "(i64 %seed, ptr %frozen.local, ptr %channel.local) {\nentry:\n")
    if recovery {
        output.add("  %thread.accepted = call i32 @minyar_recovery_enter()\n")
        output.add("  %thread.allowed = icmp ne i32 %thread.accepted, 0\n")
        output.add("  br i1 %thread.allowed, label %thread.body, label %thread.reject\n")
        output.add("thread.reject:\n  ret i64 0\nthread.body:\n")
    } else {
        output.add("  call void @minyar_stack_enter()\n")
    }
    if result == 1 {
        output.add("  %result = call i64 @.minyar.fn." + name + "(i64 %seed, ptr %frozen.local, ptr %channel.local)\n")
    } else {
        output.add("  call void @.minyar.fn." + name + "(i64 %seed, ptr %frozen.local, ptr %channel.local)\n")
    }
    if recovery {
        output.add("  %thread.pending = call i32 @minyar_recovery_pending()\n")
        output.add("  %thread.failed = icmp ne i32 %thread.pending, 0\n")
        output.add("  br i1 %thread.failed, label %thread.unwind, label %thread.success\nthread.success:\n")
    }
    output.add("  call void @minyar_stack_leave()\n")
    if result == 1 { output.add("  ret i64 %result\n") }
    else { output.add("  ret i64 0\n") }
    if recovery {
        output.add("thread.unwind:\n  call void @minyar_stack_leave()\n  ret i64 0\n")
    }
    output.add("}\n")
}

function threadJoinOnReturn(output: List<Text>, globals: List<Text>, caller: Text) {
    if threadMode(globals) && (caller == "main" || caller == "top level" || threadEntry(globals, caller)) {
        output.add("  call void @minyar_thread_join_children()\n")
    }
}

function threadResultMember(output: List<Text>, textState: List<Text>, state: List<Integer>, receiver: Text, type: Integer, member: Text, resultType: List<Integer>): Text {
    let types: List<Integer> = [type]
    let values: List<Text> = [receiver]
    if member == "code" || member == "ok" {
        let callee = "minyar_thread_result_code"
        if type == 15 { callee = "minyar_frozen_result_code" }
        let code = emitCall(output, textState, state, 1, callee, values, types)
        if member == "ok" {
            setType(resultType, 4)
            return emitInstruction(output, textState, state, "icmp eq i64 " + code + ", 0")
        }
        setType(resultType, 1)
        return code
    }
    let result = 1
    let callee = "minyar_thread_join_result_value"
    if type == 12 && member == "thread" { result = 11; callee = "minyar_thread_start_result_value" }
    else if type == 15 && member == "value" { result = 9; callee = "minyar_frozen_result_value" }
    else if type == 18 && member == "region" { result = 16; callee = "minyar_native_region_result_value" }
    else if type != 13 || member != "value" { fail("opaque thread result exposes only ok, code and its checked successful payload") }
    setType(resultType, result)
    return emitCall(output, textState, state, result, callee, values, types)
}

function threadFeatureName(name: Text): Boolean {
    let length = name.length
    if length < 6 || length > 22 { return false }
    let first = name[0]
    if first >= 'A' && first <= 'Z' {
        return name == "FrozenBytes" || name == "BytesChannel" || name == "Thread" || name == "ThreadStartResult" || name == "ThreadJoinResult" || name == "FrozenBytesChannel" || name == "FrozenBytesResult" || name == "NativeRegion" || name == "NativeRegions" || name == "NativeRegionResult"
    }
    if length < 9 { return false }
    let second = name[1]
    let plausible = false
    if first == 'm' || first == 'n' { plausible = true }
    if first == 'f' && second == 'r' { plausible = true }
    if first == 'c' && ((second == 'l' && name[2] == 'o') || (second == 'o' && name[2] == 'p')) { plausible = true }
    if first == 'b' && second == 'y' { plausible = true }
    if first == 't' && (second == 'r' || second == 'h') { plausible = true }
    if first == 's' && (second == 'e' || second == 't') { plausible = true }
    if first == 'j' && second == 'o' { plausible = true }
    if first == 'r' && second == 'e' && name[2] == 'c' { plausible = true }
    return plausible && isThreadBuiltin(name)
}
