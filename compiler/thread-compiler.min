function isThreadType(type: Integer): Boolean {
    return type >= 9 && type <= 21
}

// AtomicInteger (20) and AtomicBoolean (21): shared 64-bit cells.
function isAtomicType(type: Integer): Boolean { return type == 20 || type == 21 }

function isAtomicBuiltin(name: Text): Boolean {
    if name.length < 11 || name[0] != 'a' { return false }
    return name == "atomicInteger" || name == "atomicBoolean" || name == "atomicFence" || name == "atomicFenceAcquire" || name == "atomicFenceRelease" || name == "atomicFenceAcquireRelease"
}

// The LLVM ordering a method suffix names; "" when the suffix is not an ordering.
function atomicOrdering(suffix: Text): Text {
    if suffix == "" { return "seq_cst" }
    if suffix == "Relaxed" { return "monotonic" }
    if suffix == "Acquire" { return "acquire" }
    if suffix == "Release" { return "release" }
    if suffix == "AcquireRelease" { return "acq_rel" }
    return ""
}

function threadAtomicBuiltin(context: CompilerContext, output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, values: List<Text>, types: List<Integer>, resultType: List<Integer>): Text {
    if name == "atomicInteger" || name == "atomicBoolean" {
        let cell = 20
        let wanted = 1
        if name == "atomicBoolean" { cell = 21; wanted = 4 }
        if types.length != 1 { failCompiler(name + " expects one initial value") }
        requireType(context.tokenLines, state, types[0], wanted, name + " initial value")
        let slot = valueAsListSlot(output, textState, state, values[0], types[0])
        let slotValues: List<Text> = [slot]
        let slotTypes: List<Integer> = [1]
        setType(resultType, cell)
        return emitCall(output, textState, state, cell, "minyar_atomic_new", slotValues, slotTypes)
    }
    if types.length != 0 { failCompiler(name + " takes no arguments") }
    let ordering = atomicOrdering(name.slice(11, name.length))
    if ordering == "monotonic" || ordering == "" { failCompiler("unknown fence ordering") }
    output.add("  fence " + ordering + "\n")
    setType(resultType, 5)
    return ""
}

// cell.load(), cell.storeRelease(v), cell.fetchAddRelaxed(1), ... : the operation
// name, then an optional ordering suffix (none means sequentially consistent).
function threadAtomicMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, type: Integer, member: Text, resultType: List<Integer>): Text {
    let operations: List<Text> = ["compareExchangeWeak", "compareExchange", "notifyOne", "notifyAll", "waitFor", "fetchAdd", "fetchSub", "fetchAnd", "fetchOr", "fetchXor", "fetchMin", "fetchMax", "load", "store", "swap", "wait"]
    let operation = ""
    let k = 0
    while k < operations.length && operation == "" {
        if member.startsWith(operations[k]) { operation = operations[k] }
        k = k + 1
    }
    let suffix = member.slice(operation.byteLength, member.byteLength)
    let ordering = atomicOrdering(suffix)
    let readable = "AtomicInteger"
    let value = 1
    if type == 21 { readable = "AtomicBoolean"; value = 4 }
    if operation == "" || ordering == "" { failCompiler(readable + " has no method '" + member + "'") }
    if (operation == "wait" || operation == "waitFor" || operation == "notifyOne" || operation == "notifyAll") && suffix != "" { failCompiler(readable + " has no method '" + member + "'; waits and wakes have no ordering") }
    if operation == "load" && (ordering == "release" || ordering == "acq_rel") { failCompiler("a load cannot have " + suffix + " ordering; use load, loadAcquire or loadRelaxed") }
    if operation == "store" && (ordering == "acquire" || ordering == "acq_rel") { failCompiler("a store cannot have " + suffix + " ordering; use store, storeRelease or storeRelaxed") }
    if type == 21 && (operation == "fetchAdd" || operation == "fetchSub" || operation == "fetchMin" || operation == "fetchMax") { failCompiler("AtomicBoolean has no method '" + member + "'; use fetchAnd, fetchOr or fetchXor") }
    let arguments: List<Text> = []
    let wanted: List<Integer> = []
    if operation == "store" || operation == "swap" || operation.startsWith("fetch") || operation == "wait" { wanted.add(value) }
    if operation == "compareExchange" || operation == "compareExchangeWeak" { wanted.add(value); wanted.add(value) }
    if operation == "waitFor" { wanted.add(value); wanted.add(1) }
    let i = 0
    while i < wanted.length {
        if i > 0 { expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ",") }
        let argumentType: List<Integer> = [wanted[i]]
        let argument = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType)
        requireType(context.tokenLines, state, argumentType[0], wanted[i], readable + "." + member + " argument")
        if wanted[i] == 4 { argument = valueAsListSlot(output, textState, state, argument, 4) }
        arguments.add(argument)
        i = i + 1
    }
    expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ")")
    if operation == "wait" || operation == "waitFor" || operation == "notifyOne" || operation == "notifyAll" {
        if operation == "notifyOne" || operation == "notifyAll" {
            let all = "false"
            if operation == "notifyAll" { all = "true" }
            let notifyValues: List<Text> = [receiver, all]
            let notifyTypes: List<Integer> = [type, 4]
            setType(resultType, 5)
            return emitCall(output, textState, state, 5, "minyar_atomic_notify", notifyValues, notifyTypes)
        }
        let limit = "-1"
        if operation == "waitFor" { limit = arguments[1] }
        let waitValues: List<Text> = [receiver, arguments[0], limit]
        let waitTypes: List<Integer> = [type, 1, 1]
        setType(resultType, 4)
        let changed = emitCall(output, textState, state, 4, "minyar_atomic_wait", waitValues, waitTypes)
        if operation == "wait" { setType(resultType, 5); return "" }
        return changed
    }
    let control = emitInstruction(output, textState, state, "load ptr, ptr " + receiver + ", align 8")
    let cell = emitInstruction(output, textState, state, "getelementptr inbounds i8, ptr " + control + ", i64 16")
    let raw = ""
    if operation == "load" {
        raw = emitInstruction(output, textState, state, "load atomic i64, ptr " + cell + " " + ordering + ", align 8")
    } else if operation == "store" {
        output.add("  store atomic i64 " + arguments[0] + ", ptr " + cell + " " + ordering + ", align 8\n")
        setType(resultType, 5)
        return ""
    } else if operation == "compareExchange" || operation == "compareExchangeWeak" {
        let failure = ordering
        if ordering == "acq_rel" { failure = "acquire" }
        if ordering == "release" { failure = "monotonic" }
        let weak = ""
        if operation == "compareExchangeWeak" { weak = "weak " }
        let pair = emitInstruction(output, textState, state, "cmpxchg " + weak + "ptr " + cell + ", i64 " + arguments[0] + ", i64 " + arguments[1] + " " + ordering + " " + failure + ", align 8")
        if operation == "compareExchangeWeak" {
            setType(resultType, 4)
            return emitInstruction(output, textState, state, "extractvalue { i64, i1 } " + pair + ", 1")
        }
        raw = emitInstruction(output, textState, state, "extractvalue { i64, i1 } " + pair + ", 0")
    } else {
        let rmw = "xchg"
        if operation == "fetchAdd" { rmw = "add" }
        if operation == "fetchSub" { rmw = "sub" }
        if operation == "fetchAnd" { rmw = "and" }
        if operation == "fetchOr" { rmw = "or" }
        if operation == "fetchXor" { rmw = "xor" }
        if operation == "fetchMin" { rmw = "min" }
        if operation == "fetchMax" { rmw = "max" }
        raw = emitInstruction(output, textState, state, "atomicrmw " + rmw + " ptr " + cell + ", i64 " + arguments[0] + " " + ordering + ", align 8")
    }
    setType(resultType, value)
    if value == 4 { return emitInstruction(output, textState, state, "icmp ne i64 " + raw + ", 0") }
    return raw
}

// Intrinsics behind the typed `channels` library: a ValueQueue moves copies of
// sendable values between threads (minyar_thread_transfer.h).
function isQueueBuiltin(name: Text): Boolean {
    if name.length < 11 || name[0] != 'm' || name[6] != 'Q' { return false }
    return name == "minyarQueue" || name == "minyarQueueSend" || name == "minyarQueueTrySend" || name == "minyarQueueReceive" || name == "minyarQueueTryReceive" || name == "minyarQueueReceiveFor" || name == "minyarQueueClose" || name == "minyarQueueLength" || name == "minyarQueueClosed" || name == "minyarQueueSelect" || name == "minyarQueueWakeSocket"
}

// A plain record: not a choice, callback, C layout or library Result.
function threadPlainRecord(context: CompilerContext, type: Integer): Boolean {
    if !isRecordType(type) || isScalarChoiceType(type) || isCallbackType(type, context.functionNames) || isCRecord(context, type) { return false }
    if choiceCases(context, type).length > 0 { return false }
    return !resultPrefix(context.functionNames[recordTypeIndex(type)], "minyar_result_type_")
}

// The transfer descriptor of a sendable type (see minyar_thread_transfer.h), or a
// compile error naming the part that cannot cross threads.
function threadDescriptor(context: CompilerContext, type: Integer, visiting: List<Integer>, what: Text): Text {
    if type == 1 || type == 3 || type == 4 || type == 7 || isScalarChoiceType(type) { return "i" }
    if type == 2 { return "t" }
    if type == 8 { return "b" }
    if type == 9 || type == 10 || type == 14 || type == 19 || isAtomicType(type) { return "h" }
    if isListType(type) { return "l" + threadDescriptor(context, listElementType(type), visiting, what) }
    if threadPlainRecord(context, type) {
        let name = readableDeclarationName(context.functionNames[recordTypeIndex(type)])
        let k = 0
        while k < visiting.length {
            if visiting[k] == type { failCompiler(what + " cannot cross threads: record '" + name + "' contains itself; send a List of plain records instead") }
            k = k + 1
        }
        let mark = visiting.length
        visiting.add(type)
        let record = recordTypeIndex(type)
        let count = context.functionParameterCounts[record]
        let first = functionParameterOffset(context.functionParameterCounts, record)
        let descriptor = "r" + Text(count) + "."
        let field = 0
        while field < count {
            descriptor = descriptor + threadDescriptor(context, context.functionParameterTypes[first + field], visiting, what)
            field = field + 1
        }
        visiting[mark] = 0
        return descriptor
    }
    let shown = describeType(type)
    if isRecordType(type) { shown = "'" + readableDeclarationName(context.functionNames[recordTypeIndex(type)]) + "'" }
    failCompiler(what + " cannot cross threads: " + shown + " is not sendable; send Integer, Float, Boolean, Character, Text, Bytes, Lists, plain records of those, FrozenBytes or channels")
    return ""
}

// A private constant holding the descriptor; returns its LLVM name.
function threadDescriptorGlobal(globals: List<Text>, descriptor: Text): Text {
    let name = "@\".minyar.transfer." + descriptor + "\""
    let line = name + " = private unnamed_addr constant [" + Text(descriptor.byteLength + 1) + " x i8] c\"" + descriptor + "\\00\"\n"
    if findText(globals, line) < 0 { globals.add(line) }
    return name
}

function threadQueueBuiltin(context: CompilerContext, output: List<Text>, textState: List<Text>, state: List<Integer>, globals: List<Text>, name: Text, values: List<Text>, types: List<Integer>, resultType: List<Integer>): Text {
    let arity = 1
    if name == "minyarQueue" { arity = 1 }
    if name == "minyarQueueSend" || name == "minyarQueueTrySend" || name == "minyarQueueReceive" || name == "minyarQueueTryReceive" || name == "minyarQueueSelect" { arity = 2 }
    if name == "minyarQueueReceiveFor" { arity = 3 }
    if types.length != arity { failCompiler(name + " expects " + Text(arity) + " arguments") }
    if name == "minyarQueue" {
        requireType(context.tokenLines, state, types[0], 1, "minyarQueue capacity must be Integer")
        setType(resultType, 19)
        return emitCall(output, textState, state, 19, "minyar_queue_new", values, types)
    }
    if name == "minyarQueueSelect" {
        requireType(context.tokenLines, state, types[0], makeListType(19), "minyarQueueSelect needs a List of ValueQueue")
        requireType(context.tokenLines, state, types[1], 1, "minyarQueueSelect timeout must be Integer milliseconds")
        setType(resultType, 1)
        return emitCall(output, textState, state, 1, "minyar_queue_select", values, types)
    }
    requireType(context.tokenLines, state, types[0], 19, name + " needs a ValueQueue")
    let queue: List<Text> = [values[0]]
    let queueTypes: List<Integer> = [19]
    if name == "minyarQueueClose" {
        setType(resultType, 5)
        return emitCall(output, textState, state, 5, "minyar_queue_close", queue, queueTypes)
    }
    if name == "minyarQueueLength" || name == "minyarQueueWakeSocket" || name == "minyarQueueClosed" {
        let callee = "minyar_queue_length"
        let result = 1
        if name == "minyarQueueWakeSocket" { callee = "minyar_queue_wake_socket" }
        if name == "minyarQueueClosed" { callee = "minyar_queue_closed"; result = 4 }
        setType(resultType, result)
        return emitCall(output, textState, state, result, callee, queue, queueTypes)
    }
    let visiting: List<Integer> = []
    if name == "minyarQueueSend" || name == "minyarQueueTrySend" {
        let descriptor = threadDescriptorGlobal(globals, threadDescriptor(context, types[1], visiting, "a channel value"))
        let slot = valueAsListSlot(output, textState, state, values[1], types[1])
        let callValues: List<Text> = [values[0], slot, descriptor]
        let callTypes: List<Integer> = [19, 1, 2]
        let result = 1
        let callee = "minyar_queue_try_send"
        if name == "minyarQueueSend" { result = 4; callee = "minyar_queue_send" }
        setType(resultType, result)
        return emitCall(output, textState, state, result, callee, callValues, callTypes)
    }
    if !isListType(types[1]) { failCompiler(name + " receives into a List") }
    let descriptor = threadDescriptorGlobal(globals, threadDescriptor(context, listElementType(types[1]), visiting, "a channel value"))
    let callValues: List<Text> = [values[0], values[1], descriptor]
    let callTypes: List<Integer> = [19, types[1], 2]
    let result = 1
    let callee = "minyar_queue_try_receive"
    if name == "minyarQueueReceive" { result = 4; callee = "minyar_queue_receive" }
    if name == "minyarQueueReceiveFor" {
        requireType(context.tokenLines, state, types[2], 1, "minyarQueueReceiveFor timeout must be Integer milliseconds")
        callValues.add(values[2]); callTypes.add(1); callee = "minyar_queue_receive_for"
    }
    setType(resultType, result)
    return emitCall(output, textState, state, result, callee, callValues, callTypes)
}

function isThreadBuiltin(name: Text): Boolean {
    if name == "nativeThreadSetup" || name == "mapNativeRegion" || name == "tryMapNativeRegion" || name == "shareNativeRegions" || name == "nativeRegionAddress" || name == "threadKernelKick" || name == "threadEventfd" || name == "threadEventfdRead" || name == "threadEventfdNotify" { return true }
    if isQueueBuiltin(name) || isAtomicBuiltin(name) { return true }
    return name == "freezeBytes" || name == "freezeBytesTake" || name == "copyFrozenBytes" || name == "bytesChannel" || name == "trySendBytes" || name == "sendBytes" || name == "tryReceiveBytes" || name == "receiveBytes" || name == "closeBytesChannel" || name == "startThread" || name == "joinThread" || name == "startThreadResult" || name == "joinThreadResult" || name == "frozenBytesChannel" || name == "trySendFrozen" || name == "sendFrozen" || name == "tryReceiveFrozen" || name == "receiveFrozen" || name == "closeFrozenChannel" || name == "threadKernelRun"
}

function threadProgram(kinds: List<Integer>, texts: List<Text>): Boolean {
    let i = 0
    while i < kinds.length {
        if (kinds[i] == 1 || kinds[i] == 6) && (texts[i] == "thread" || isThreadType(simpleTypeCode(texts[i])) || isThreadBuiltin(texts[i])) { return true }
        i = i + 1
    }
    return false
}

function threadMode(globals: List<Text>): Boolean {
    return findText(globals, "; minyar-thread-runtime: 1\n") >= 0
}

function threadEntry(globals: List<Text>, name: Text): Boolean {
    return findText(globals, "; minyar-thread-entry: " + name + "\n") >= 0
}

function threadSignature(result: Integer, types: List<Integer>): Text {
    let signature = Text(result) + "("
    let i = 0
    while i < types.length {
        if i > 0 { signature = signature + "," }
        signature = signature + Text(types[i])
        i = i + 1
    }
    return signature + ")"
}

function threadField(value: Text): Text { return Text(value.length) + ":" + value }

function threadNote(output: List<Text>, caller: Text, kind: Text, name: Text, signature: Text) {
    if caller == "top level" { caller = "main" }
    output.add("  ; minyar-thread-effect: " + threadField(caller) + threadField(kind) + threadField(name) + threadField(signature) + "\n")
}

function threadReadField(text: Text, cursor: List<Integer>): Text {
    let length = 0
    while cursor[0] < text.length && text[cursor[0]] >= '0' && text[cursor[0]] <= '9' {
        length = length * 10 + Integer(text[cursor[0]]) - Integer('0')
        cursor[0] = cursor[0] + 1
    }
    if cursor[0] >= text.length || text[cursor[0]] != ':' { failCompiler("invalid thread effect metadata") }
    cursor[0] = cursor[0] + 1
    let start = cursor[0]
    cursor[0] = start + length
    if cursor[0] > text.length { failCompiler("invalid thread effect metadata") }
    return text.slice(start, cursor[0])
}

function threadParameters(name: Text, actual: List<Integer>, expected: List<Integer>) {
    let correct = actual.length == expected.length
    let i = 0
    while correct && i < actual.length {
        correct = actual[i] == expected[i]
        i = i + 1
    }
    if !correct { failCompiler(name + " has the wrong thread boundary argument types") }
}

function threadBuiltin(output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, values: List<Text>, types: List<Integer>, target: Text, inputType: Integer, channelType: Integer, resultType: List<Integer>): Text {
    let expected: List<Integer> = []
    let result = 5
    let callee = ""
    if name == "nativeThreadSetup" { callee = "minyar_native_thread_setup" }
    if name == "mapNativeRegion" || name == "tryMapNativeRegion" {
        expected = [1, 1, 1, 1, 1]; result = 16; callee = "minyar_native_region_map"
        if name == "tryMapNativeRegion" { result = 18; callee = "minyar_native_region_try_map" }
    }
    if name == "shareNativeRegions" { expected.add(100016); result = 17; callee = "minyar_native_regions_share" }
    if name == "nativeRegionAddress" { expected.add(16); result = 1; callee = "minyar_native_region_address" }
    if name == "threadKernelKick" { expected = [11, 16]; result = 1; callee = "minyar_thread_kernel_kick" }
    if name == "threadEventfd" { expected.add(1); result = 1; callee = "minyar_thread_eventfd" }
    if name == "threadEventfdRead" { expected.add(1); result = 1; callee = "minyar_thread_eventfd_read" }
    if name == "threadEventfdNotify" { expected = [1, 1]; result = 1; callee = "minyar_thread_eventfd_notify" }
    if name == "freezeBytes" { expected.add(8); result = 9; callee = "minyar_frozen_bytes_copy" }
    if name == "freezeBytesTake" { expected.add(8); result = 9; callee = "minyar_frozen_bytes_take" }
    if name == "copyFrozenBytes" { expected.add(9); result = 8; callee = "minyar_frozen_bytes_local_copy" }
    if name == "bytesChannel" { expected.add(1); expected.add(1); result = 10; callee = "minyar_bytes_channel_new" }
    if name == "trySendBytes" || name == "sendBytes" {
        expected.add(10); expected.add(8); result = 4; callee = "minyar_bytes_channel_try_send"
        if name == "sendBytes" { callee = "minyar_bytes_channel_send" }
    }
    if name == "tryReceiveBytes" || name == "receiveBytes" {
        expected.add(10); expected.add(8); result = 1; callee = "minyar_bytes_channel_try_receive"
        if name == "receiveBytes" { result = 4; callee = "minyar_bytes_channel_receive" }
    }
    if name == "closeBytesChannel" { expected.add(10); callee = "minyar_bytes_channel_close" }
    if name == "joinThread" { expected.add(11); result = 1; callee = "minyar_thread_join" }
    if name == "joinThreadResult" { expected.add(11); result = 13; callee = "minyar_thread_join_result" }
    if name == "frozenBytesChannel" { expected.add(1); expected.add(1); result = 14; callee = "minyar_frozen_channel_new" }
    if name == "trySendFrozen" || name == "sendFrozen" {
        expected.add(14); expected.add(9); result = 4; callee = "minyar_frozen_channel_try_send"
        if name == "sendFrozen" { callee = "minyar_frozen_channel_send" }
    }
    if name == "tryReceiveFrozen" || name == "receiveFrozen" {
        expected.add(14); result = 15; callee = "minyar_frozen_channel_try_receive"
        if name == "receiveFrozen" { callee = "minyar_frozen_channel_receive" }
    }
    if name == "closeFrozenChannel" { expected.add(14); callee = "minyar_frozen_channel_close" }
    if name == "threadKernelRun" { expected.add(1); result = 1; callee = "minyar_thread_kernel_run" }
    if name == "startThread" || name == "startThreadResult" {
        expected.add(1); expected.add(inputType); expected.add(channelType); result = 11; callee = "minyar_thread_spawn"
        if name == "startThreadResult" { result = 12; callee = "minyar_thread_spawn_result" }
    }
    threadParameters(name, types, expected)
    if name == "startThread" || name == "startThreadResult" {
        let bridgeValues: List<Text> = ["@" + derivedSymbol(".minyar.thread.bridge.", target), values[0], values[1], values[2]]
        let bridgeTypes: List<Integer> = [9, 1, inputType, channelType]
        if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "spawn", target, "1(1,9,10)") }
        setType(resultType, result)
        return emitCall(output, textState, state, result, callee, bridgeValues, bridgeTypes)
    }
    if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "builtin", name, threadSignature(result, types)) }
    setType(resultType, result)
    return emitCall(output, textState, state, result, callee, values, types)
}

function threadFrozenMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, member: Text, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    if member != "getUInt8" && member != "getInt64" { failCompiler("FrozenBytes exposes only immutable readers") }
    let positionType: List<Integer> = [0]
    let position = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, positionType)
    requireType(tokenLines, state, positionType[0], 1, "FrozenBytes position must be Integer")
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    let callee = "minyar_frozen_bytes_get_uint8"
    if member == "getInt64" { callee = "minyar_frozen_bytes_get_int64" }
    let types: List<Integer> = [9, 1]
    setType(resultType, 1)
    return emitCall(output, textState, state, 1, callee, pairOf(receiver, position), types)
}

function threadRegionMember(output: List<Text>, textState: List<Text>, state: List<Integer>, receiver: Text, type: Integer, member: Text, resultType: List<Integer>): Text {
    let callee = "minyar_native_region_length"
    if type == 17 { callee = "minyar_native_regions_length" }
    if member == "address" && type == 16 {
        callee = "minyar_native_region_address"
        threadNote(output, textState[1], "builtin", "nativeRegionAddress", "1(16)")
    } else if member != "length" { failCompiler("a native region exposes only length and main-only address") }
    setType(resultType, 1)
    let types: List<Integer> = [type]
    let values: List<Text> = [receiver]
    return emitCall(output, textState, state, 1, callee, values, types)
}

function threadRegionMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, type: Integer, member: Text, resultType: List<Integer>): Text {
    let expected: List<Integer> = [1]
    let result = 1
    let callee = ""
    if type == 17 {
        if member != "get" { failCompiler("NativeRegions exposes only checked get") }
        result = 16; callee = "minyar_native_regions_get"
    } else {
        if member == "getUInt8" { callee = "minyar_native_region_get_uint8" }
        if member == "getUInt16" { callee = "minyar_native_region_get_uint16" }
        if member == "getUInt32" { callee = "minyar_native_region_get_uint32" }
        if member == "getInt64" { callee = "minyar_native_region_get_int64" }
        if member == "setUInt8" { callee = "minyar_native_region_set_uint8"; expected.add(1); result = 5 }
        if member == "setUInt16" { callee = "minyar_native_region_set_uint16"; expected.add(1); result = 5 }
        if member == "setUInt32" { callee = "minyar_native_region_set_uint32"; expected.add(1); result = 5 }
        if member == "setInt64" { callee = "minyar_native_region_set_int64"; expected.add(1); result = 5 }
        if member == "loadAcquireUInt8" { callee = "minyar_native_region_load_u8" }
        if member == "storeReleaseUInt8" { callee = "minyar_native_region_store_u8"; expected.add(1); result = 5 }
        if member == "loadAcquireUInt32" { callee = "minyar_native_region_load_u32" }
        if member == "storeReleaseUInt32" { callee = "minyar_native_region_store_u32"; expected.add(1); result = 5 }
        if member == "compareExchangeUInt32" { callee = "minyar_native_region_cas_u32"; expected.add(1); expected.add(1) }
        if member == "loadAcquireInt64" { callee = "minyar_native_region_load_i64" }
        if member == "storeReleaseInt64" { callee = "minyar_native_region_store_i64"; expected.add(1); result = 5 }
        if member == "atomicAddInt64" { callee = "minyar_native_region_add_i64"; expected.add(1) }
        if member == "copyFromBytes" { callee = "minyar_native_region_copy_from"; expected.add(8); result = 5 }
        if member == "copyToBytes" { callee = "minyar_native_region_copy_to"; expected.add(1); result = 8 }
        if member == "kernelRun" { callee = "minyar_native_region_kernel_run" }
        if callee == "" { failCompiler("unknown checked native region method") }
    }
    let values: List<Text> = [receiver]
    let types: List<Integer> = [type]
    let i = 0
    while i < expected.length {
        if i > 0 { expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ",") }
        let argumentType: List<Integer> = [expected[i]]
        values.add(parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType))
        requireType(context.tokenLines, state, argumentType[0], expected[i], "wrong checked native region argument type")
        types.add(argumentType[0])
        i = i + 1
    }
    expectToken(context.tokenKinds, context.tokenTexts, context.tokenLines, state, ")")
    setType(resultType, result)
    return emitCall(output, textState, state, result, callee, values, types)
}

// The original entry shape: (Integer, FrozenBytes or native region capability,
// BytesChannel or FrozenBytesChannel). It keeps its direct bridge.
function threadLegacyEntry(counts: List<Integer>, parameters: List<Integer>, function: Integer): Boolean {
    if counts[function] != 3 { return false }
    let first = functionParameterOffset(counts, function)
    return parameters[first] == 1 && (parameters[first + 1] == 9 || parameters[first + 1] == 16 || parameters[first + 1] == 17) && (parameters[first + 2] == 10 || parameters[first + 2] == 14)
}

// Every other entry receives its arguments as one packet: the tuple descriptor
// of its parameters, each of which must be sendable.
function threadEntryDescriptor(context: CompilerContext, function: Integer): Text {
    let counts = context.functionParameterCounts
    let first = functionParameterOffset(counts, function)
    let descriptor = "r" + Text(counts[function]) + "."
    let position = 0
    while position < counts[function] {
        let visiting: List<Integer> = []
        let parameter = readableDeclarationName(context.functionParameterNames[first + position])
        descriptor = descriptor + threadDescriptor(context, context.functionParameterTypes[first + position], visiting, "thread entry '" + readableDeclarationName(context.functionNames[function]) + "' parameter '" + parameter + "'")
        position = position + 1
    }
    return descriptor
}

function threadValidateEntries(context: CompilerContext, globals: List<Text>) {
    let names = context.functionNames
    let results = context.functionReturnTypes
    let prefix = "; minyar-thread-entry: "
    let i = 0
    while i < globals.length {
        let marker = globals[i]
        if marker.length > prefix.length && marker.slice(0, prefix.length) == prefix {
            let name = markerValue(marker, prefix)
            let function = findFunction(names, context.symbolKinds, context.tokenLines.symbolLookup, name)
            let valid = function >= 0 && name != "main" && name[0] != '"'
            if valid { valid = results[function] == 1 || results[function] == 5 }
            if !valid { failCompiler("thread entry '" + readableDeclarationName(name) + "' must be a named function returning Integer or Nothing") }
            if !threadLegacyEntry(context.functionParameterCounts, context.functionParameterTypes, function) { threadEntryDescriptor(context, function) }
        }
        i = i + 1
    }
}

// startThread(entry, arguments...) for a packet entry: copy every argument into
// one packet, then start the thread on the entry's packet bridge.
function threadPacketSpawn(context: CompilerContext, output: List<Text>, textState: List<Text>, state: List<Integer>, globals: List<Text>, name: Text, target: Text, values: List<Text>, types: List<Integer>, resultType: List<Integer>): Text {
    let function = findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, target)
    let counts = context.functionParameterCounts
    let first = functionParameterOffset(counts, function)
    let readable = readableDeclarationName(target)
    if values.length != counts[function] { failCompiler(name + " for '" + readable + "' expects " + Text(counts[function]) + " arguments after the entry, but received " + Text(values.length)) }
    let position = 0
    while position < values.length {
        requireType(context.tokenLines, state, types[position], context.functionParameterTypes[first + position], "argument " + Text(position + 1) + " of thread entry '" + readable + "'")
        position = position + 1
    }
    let descriptor = threadDescriptorGlobal(globals, threadEntryDescriptor(context, function))
    let begin: List<Text> = [descriptor]
    let beginTypes: List<Integer> = [2]
    let packet = emitCall(output, textState, state, 16, "minyar_transfer_begin", begin, beginTypes)
    position = 0
    while position < values.length {
        let slot = valueAsListSlot(output, textState, state, values[position], types[position])
        output.add("  call void @minyar_transfer_put(ptr " + packet + ", i64 " + slot + ")\n")
        position = position + 1
    }
    let result = 11
    let callee = "minyar_thread_spawn_packet"
    if name == "startThreadResult" { result = 12; callee = "minyar_thread_spawn_packet_result" }
    if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "spawn", target, "1(packet)") }
    let spawnValues: List<Text> = ["@" + derivedSymbol(".minyar.thread.bridge.", target), packet]
    let spawnTypes: List<Integer> = [2, 2]
    setType(resultType, result)
    return emitCall(output, textState, state, result, callee, spawnValues, spawnTypes)
}

function runtimeMathAllowed(name: Text): Boolean {
    return name == "minyar_runtime_sqrt" || name == "minyar_runtime_sin" || name == "minyar_runtime_cos" || name == "minyar_runtime_tan" || name == "minyar_runtime_asin" || name == "minyar_runtime_acos" || name == "minyar_runtime_atan" || name == "minyar_runtime_exp" || name == "minyar_runtime_log" || name == "minyar_runtime_floor" || name == "minyar_runtime_ceil" || name == "minyar_runtime_round" || name == "minyar_runtime_atan2" || name == "minyar_runtime_pow" || name == "minyar_runtime_sinh" || name == "minyar_runtime_cosh" || name == "minyar_runtime_tanh" || name == "minyar_runtime_asinh" || name == "minyar_runtime_acosh" || name == "minyar_runtime_atanh" || name == "minyar_runtime_erf" || name == "minyar_runtime_erfc" || name == "minyar_runtime_expm1" || name == "minyar_runtime_log1p" || name == "minyar_runtime_cbrt" || name == "minyar_runtime_toFloat32"
}

// Runtime natives that only read a borrowed Bytes range and return a scalar.
// Parallel functions may declare them with Bytes parameters and call them.
function runtimeViewReaderAllowed(name: Text): Boolean {
    return name == "minyar_runtime_crc32c"
}

function threadNativeAllowed(name: Text, signature: Text): Boolean {
    if runtimeMathAllowed(name) {
        if name == "minyar_runtime_atan2" || name == "minyar_runtime_pow" { return signature == "7(7,7)" }
        return signature == "7(7)"
    }
    if name == "minyar_runtime_processId" { return signature == "1()" }
    if name == "minyar_runtime_sleepNanoseconds" || name == "minyar_runtime_sync" { return signature == "1(1)" }
    if name == "minyar_runtime_argumentCount" { return signature == "1()" }
    if name == "minyar_runtime_argument" { return signature == "2(1)" }
    // Exact JSON number rounding reads a borrowed Text into fixed stack storage.
    if name == "minyar_runtime_jsonNumber" { return signature == "7(2)" }
    // JSON scanners read a borrowed Text and return a scalar position.
    if name == "minyar_runtime_jsonSpaceEnd" || name == "minyar_runtime_jsonStringEnd" || name == "minyar_runtime_jsonNumberEnd" { return signature == "1(2,1)" }
    // text.decode copies Bytes into a new Text or returns None (a Maybe<Text>,
    // whose type number differs per program).
    if name == "minyar_runtime_utf8Text" { return signature.endsWith("(8)") }
    // text.decodeOrStop copies valid UTF-8 Bytes into a new Text or stops.
    if name == "minyar_runtime_decodeOrStop" { return signature == "2(8)" }
    return false
}

// Library modules whose C state is per thread (MINYAR_NATIVE_THREAD_LOCAL) or
// immutable: each thread owns the sockets, files, event loops, syncers and child
// processes it opens. Handles are Integers; another thread's loop, syncer or child
// handle is simply not found there.
function threadNativeModuleAllowed(name: Text, main: Boolean): Boolean {
    if name.startsWith("minyar_runtime_") { return name != "minyar_runtime_setParallelScheduler" }
    if name.startsWith("minyar_system_") {
        // Signal routing and broken-pipe disposition are process-wide: main only.
        if name == "minyar_system_shutdownSignalSocket" || name == "minyar_system_drainShutdownSignals" || name == "minyar_system_ignoreBrokenPipes" || name == "minyar_system_raiseOpenFileLimit" || name == "minyar_system_setResourceLimit" { return main }
        return true
    }
    return name.startsWith("minyar_net_") || name.startsWith("minyar_files_") || name.startsWith("minyar_unicode_") || name.startsWith("minyar_sha256_") || name.startsWith("minyar_deflate_") || name.startsWith("minyar_aes_") || name.startsWith("minyar_securecrypto_") || name.startsWith("minyar_completionio_") || name.startsWith("minyar_integer_overflow_")
}

function threadNativeSetupAllowed(name: Text, signature: Text): Boolean {
    if name == "minyar_erofs_directoryStatus" { return signature == "8(2,2,1,1,1)" }
    if name == "minyar_erofs_layersStatus" { return signature == "8(8,2,1,1,1)" }
    if name == "minyar_zstd_rawCreateDCtx" { return signature == "1()" }
    if name == "minyar_zstd_rawCloseDCtx" { return signature == "5(1)" }
    if name == "minyar_zstd_bufferDecompress" { return signature == "1(1,8,8)" }
    if name == "minyar_machine_address" { return signature == "1(8)" }
    if name == "minyar_machine_syscall" { return signature == "1(1,1,1,1,1,1,1)" }
    if name == "minyar_machine_pause" || name == "minyar_machine_fence" { return signature == "5()" }
    if name == "minyar_machine_out8" { return signature == "5(1,1)" }
    if name == "minyar_machine_load8" || name == "minyar_machine_load16" || name == "minyar_machine_load32" || name == "minyar_machine_load64" || name == "minyar_machine_read8" || name == "minyar_machine_read16" || name == "minyar_machine_read32" || name == "minyar_machine_read64" || name == "minyar_machine_loadAcquire32" || name == "minyar_machine_loadAcquire64" { return signature == "1(1)" }
    if name == "minyar_machine_store8" || name == "minyar_machine_store16" || name == "minyar_machine_store32" || name == "minyar_machine_store64" || name == "minyar_machine_write8" || name == "minyar_machine_write16" || name == "minyar_machine_write32" || name == "minyar_machine_write64" || name == "minyar_machine_storeRelease32" || name == "minyar_machine_storeRelease64" { return signature == "5(1,1)" }
    if name == "minyar_machine_copy" || name == "minyar_machine_fill8" || name == "minyar_machine_fill32" { return signature == "5(1,1,1)" }
    if name == "minyar_machine_atomicAdd" { return signature == "1(1,1)" }
    if name == "minyar_machine_compareExchange32" || name == "minyar_machine_compareExchange64" { return signature == "1(1,1,1)" }
    return false
}

function threadNativeSetupEnabled(callers: List<Text>, kinds: List<Text>, names: List<Text>): Boolean {
    let pending: List<Text> = ["main"]
    let seen: List<Text> = []
    let cursor = 0
    while cursor < pending.length {
        let caller = pending[cursor]
        cursor = cursor + 1
        if findText(seen, caller) < 0 {
            seen.add(caller)
            let i = 0
            while i < callers.length {
                if callers[i] == caller {
                    if kinds[i] == "builtin" && names[i] == "nativeThreadSetup" { return true }
                    if kinds[i] == "call" { pending.add(names[i]) }
                }
                i = i + 1
            }
        }
    }
    return false
}

function threadBuiltinAllowed(name: Text): Boolean {
    return isThreadBuiltin(name) || isRegisterLayoutBuiltin(name) || name == "abs" || name == "min" || name == "max" || name == "clamp" || name == "wrappingAdd" || name == "wrappingSubtract" || name == "wrappingMultiply" || name == "Bytes" || name == "Text" || name == "Float" || name == "Integer" || name == "Character" || name == "print" || name == "fail" || name == "joinText"
}

function threadManagedGetter(name: Text, metadata: List<Text>): Boolean {
    let prefix = "\"minyar.constant|"
    if name.length <= prefix.length || name.slice(0, prefix.length) != prefix { return false }
    let tail = name.slice(prefix.length, name.length)
    let separator = findCharacter(tail, '|')
    if separator < 0 { failCompiler("unreviewed module constant getter") }
    let resolved = tail.slice(0, separator)
    let scalar = "; minyar-module-constant: " + resolved + "|scalar\n"
    let managed = "; minyar-module-constant: " + resolved + "|managed\n"
    if findText(metadata, scalar) >= 0 { return false }
    if findText(metadata, managed) >= 0 { return true }
    failCompiler("unreviewed module constant getter '" + resolved + "'")
    return true
}

function threadConstantIdentity(name: Text): Text {
    let prefix = "\"minyar.constant|"
    if name.length <= prefix.length || name.slice(0, prefix.length) != prefix { return "" }
    let tail = name.slice(prefix.length, name.length)
    let separator = findCharacter(tail, '|')
    if separator < 0 { failCompiler("unreviewed module constant getter") }
    return tail.slice(0, separator)
}

function threadCheckGraph(output: List<Text>, globals: List<Text>) {
    if !threadMode(globals) { return }
    let callers: List<Text> = []
    let kinds: List<Text> = []
    let names: List<Text> = []
    let signatures: List<Text> = []
    let metadata: List<Text> = []
    let i = 0
    while i < globals.length { metadata.add(globals[i]); i = i + 1 }
    let prefix = "  ; minyar-thread-effect: "
    i = 0
    while i < output.length {
        let piece = output[i]
        metadata.add(piece)
        if piece.length > prefix.length && piece.slice(0, prefix.length) == prefix {
            let cursor: List<Integer> = [prefix.length]
            callers.add(threadReadField(piece, cursor)); kinds.add(threadReadField(piece, cursor))
            names.add(threadReadField(piece, cursor)); signatures.add(threadReadField(piece, cursor))
        }
        i = i + 1
    }
    let nativeSetup = threadNativeSetupEnabled(callers, kinds, names)
    let pass = 0
    while pass < 2 {
        let pending: List<Text> = []
        if pass == 0 { pending.add("main") }
        if pass == 0 {
            let constantPrefix = "; minyar-module-constant: "
            let constantIndex = 0
            while constantIndex < metadata.length {
                let marker = metadata[constantIndex]
                if marker.length > constantPrefix.length && marker.slice(0, constantPrefix.length) == constantPrefix {
                    let value = markerValue(marker, constantPrefix)
                    let separator = findCharacter(value, '|')
                    if separator < 0 { failCompiler("invalid module constant effect metadata") }
                    pending.add("constant " + value.slice(0, separator))
                }
                constantIndex = constantIndex + 1
            }
        }
        i = 0
        let entryPrefix = "; minyar-thread-entry: "
        while i < globals.length {
            let marker = globals[i]
            if marker.length > entryPrefix.length && marker.slice(0, entryPrefix.length) == entryPrefix { pending.add(markerValue(marker, entryPrefix)) }
            i = i + 1
        }
        let seen: List<Text> = []
        // parents[k] is the pending index that reached pending[k], or -1 for a root.
        let parents: List<Integer> = []
        while parents.length < pending.length { parents.add(-1) }
        let cursor = 0
        while cursor < pending.length {
            let caller = pending[cursor]
            let current = cursor
            cursor = cursor + 1
            if findText(seen, caller) < 0 {
                seen.add(caller)
                i = 0
                while i < callers.length {
                    if callers[i] == caller {
                        let kind = kinds[i]
                        let name = names[i]
                        let allowed = true
                        if kind == "call" || kind == "spawn" {
                            if threadManagedGetter(name, metadata) && pass == 1 { allowed = false }
                            pending.add(name); parents.add(current)
                        } else if kind == "recovery" {
                            allowed = pass == 0
                        } else if kind == "indirect" && (name == "closure creation" || name == "callback call" || name == "function value") {
                            // Every closure body and function value is checked as "callback",
                            // under the rules of the pass that reached it.
                            pending.add("callback"); parents.add(current)
                        } else if kind == "native" {
                            allowed = threadNativeAllowed(name, signatures[i]) || threadNativeModuleAllowed(name, pass == 0)
                            if pass == 0 && nativeSetup { allowed = allowed || threadNativeSetupAllowed(name, signatures[i]) }
                        } else if kind == "builtin" {
                            allowed = threadBuiltinAllowed(name)
                            if pass == 0 && nativeSetup && name == "exit" && signatures[i] == "0(1)" { allowed = true }
                            if pass == 1 && (name == "nativeThreadSetup" || name == "nativeRegionAddress") { allowed = false }
                        } else if kind == "constant" {
                            let managed = "; minyar-module-constant: " + name + "|managed\n"
                            if pass == 1 && findText(metadata, managed) >= 0 { allowed = false }
                        } else if kind == "runtime" {
                            allowed = true
                            if threadConstantIdentity(name) != "" {
                                if threadManagedGetter(name, metadata) && pass == 1 { allowed = false }
                            }
                        } else { allowed = false }
                        if !allowed && kind == "native" && name.length > 11 && name.slice(0, 11) == "minyar_dma_" {
                            failCompiler("serialized boot-CPU DMA cannot be reached from thread or parallel execution: '" + readableDeclarationName(caller) + "' uses " + name)
                        }
                        if !allowed { failCompiler("unsafe thread effect in '" + readableDeclarationName(caller) + "': " + kind + " '" + name + "' " + signatures[i] + threadEffectPath(pending, parents, current)) }
                    }
                    i = i + 1
                }
            }
        }
        pass = pass + 1
    }
}

// ", reached from thread 'worker' through 'a', 'b'" for a finding below a root.
function threadEffectPath(pending: List<Text>, parents: List<Integer>, index: Integer): Text {
    if parents[index] < 0 { return "" }
    let chain: List<Text> = []
    let at = parents[index]
    while at >= 0 { chain.add(pending[at]); at = parents[at] }
    let root = readableDeclarationName(chain[chain.length - 1])
    let path = ", reached from '" + root + "'"
    if chain.length > 1 {
        path = path + " through"
        let k = chain.length - 2
        while k >= 0 {
            path = path + " '" + readableDeclarationName(chain[k]) + "'"
            if k > 0 { path = path + "," }
            k = k - 1
        }
    }
    return path
}

function threadAppendABI(context: CompilerContext, output: List<Text>, globals: List<Text>, recoverable: Boolean) {
    let names = context.functionNames
    let kinds = context.symbolKinds
    let results = context.functionReturnTypes
    let lookup = context.tokenLines.symbolLookup
    if !threadMode(globals) { return }
    let declarations: List<Text> = [
        "declare void @minyar_native_thread_setup()",
        "declare ptr @minyar_native_region_map(i64, i64, i64, i64, i64)",
        "declare ptr @minyar_native_region_try_map(i64, i64, i64, i64, i64)",
        "declare ptr @minyar_native_region_result_value(ptr)",
        "declare i64 @minyar_native_region_length(ptr)",
        "declare i64 @minyar_native_region_address(ptr)",
        "declare ptr @minyar_native_regions_share(ptr)",
        "declare i64 @minyar_native_regions_length(ptr)",
        "declare ptr @minyar_native_regions_get(ptr, i64)",
        "declare i64 @minyar_native_region_get_uint8(ptr, i64)",
        "declare i64 @minyar_native_region_get_uint16(ptr, i64)",
        "declare i64 @minyar_native_region_get_uint32(ptr, i64)",
        "declare i64 @minyar_native_region_get_int64(ptr, i64)",
        "declare void @minyar_native_region_set_uint8(ptr, i64, i64)",
        "declare void @minyar_native_region_set_uint16(ptr, i64, i64)",
        "declare void @minyar_native_region_set_uint32(ptr, i64, i64)",
        "declare void @minyar_native_region_set_int64(ptr, i64, i64)",
        "declare i64 @minyar_native_region_load_u8(ptr, i64)",
        "declare void @minyar_native_region_store_u8(ptr, i64, i64)",
        "declare i64 @minyar_native_region_load_u32(ptr, i64)",
        "declare void @minyar_native_region_store_u32(ptr, i64, i64)",
        "declare i64 @minyar_native_region_cas_u32(ptr, i64, i64, i64)",
        "declare i64 @minyar_native_region_load_i64(ptr, i64)",
        "declare void @minyar_native_region_store_i64(ptr, i64, i64)",
        "declare i64 @minyar_native_region_add_i64(ptr, i64, i64)",
        "declare void @minyar_native_region_copy_from(ptr, i64, ptr)",
        "declare ptr @minyar_native_region_copy_to(ptr, i64, i64)",
        "declare i64 @minyar_native_region_kernel_run(ptr, i64)",
        "declare i64 @minyar_thread_kernel_kick(ptr, ptr)",
        "declare i64 @minyar_thread_eventfd(i64)",
        "declare i64 @minyar_thread_eventfd_read(i64)",
        "declare i64 @minyar_thread_eventfd_notify(i64, i64)",
        "declare ptr @minyar_frozen_bytes_copy(ptr)",
        "declare ptr @minyar_frozen_bytes_take(ptr)",
        "declare ptr @minyar_frozen_bytes_local_copy(ptr)",
        "declare i64 @minyar_frozen_bytes_length(ptr)",
        "declare i64 @minyar_frozen_bytes_get_uint8(ptr, i64)",
        "declare i64 @minyar_frozen_bytes_get_int64(ptr, i64)",
        "declare ptr @minyar_bytes_channel_new(i64, i64)",
        "declare zeroext i1 @minyar_bytes_channel_try_send(ptr, ptr)",
        "declare zeroext i1 @minyar_bytes_channel_send(ptr, ptr)",
        "declare i64 @minyar_bytes_channel_try_receive(ptr, ptr)",
        "declare zeroext i1 @minyar_bytes_channel_receive(ptr, ptr)",
        "declare void @minyar_bytes_channel_close(ptr)",
        "declare ptr @minyar_thread_spawn(ptr, i64, ptr, ptr)",
        "declare i64 @minyar_thread_join(ptr)",
        "declare void @minyar_thread_join_children()",
        "declare ptr @minyar_thread_text_literal(ptr)",
        "declare ptr @minyar_thread_spawn_result(ptr, i64, ptr, ptr)",
        "declare ptr @minyar_thread_join_result(ptr)",
        "declare i64 @minyar_thread_result_code(ptr)",
        "declare ptr @minyar_thread_start_result_value(ptr)",
        "declare i64 @minyar_thread_join_result_value(ptr)",
        "declare ptr @minyar_frozen_channel_new(i64, i64)",
        "declare zeroext i1 @minyar_frozen_channel_try_send(ptr, ptr)",
        "declare zeroext i1 @minyar_frozen_channel_send(ptr, ptr)",
        "declare ptr @minyar_frozen_channel_try_receive(ptr)",
        "declare ptr @minyar_frozen_channel_receive(ptr)",
        "declare void @minyar_frozen_channel_close(ptr)",
        "declare i64 @minyar_frozen_result_code(ptr)",
        "declare ptr @minyar_frozen_result_value(ptr)",
        "declare i64 @minyar_thread_process_id()",
        "declare i64 @minyar_thread_sleep_ns(i64)",
        "declare i64 @minyar_thread_fsync(i64)",
        "declare i64 @minyar_thread_kernel_run(i64)",
        "declare ptr @minyar_transfer_begin(ptr)",
        "declare void @minyar_transfer_put(ptr, i64)",
        "declare ptr @minyar_thread_spawn_packet(ptr, ptr)",
        "declare ptr @minyar_thread_spawn_packet_result(ptr, ptr)",
        "declare ptr @minyar_queue_new(i64)",
        "declare zeroext i1 @minyar_queue_send(ptr, i64, ptr)",
        "declare i64 @minyar_queue_try_send(ptr, i64, ptr)",
        "declare zeroext i1 @minyar_queue_receive(ptr, ptr, ptr)",
        "declare i64 @minyar_queue_try_receive(ptr, ptr, ptr)",
        "declare i64 @minyar_queue_receive_for(ptr, ptr, ptr, i64)",
        "declare void @minyar_queue_close(ptr)",
        "declare i64 @minyar_queue_length(ptr)",
        "declare zeroext i1 @minyar_queue_closed(ptr)",
        "declare i64 @minyar_queue_select(ptr, i64)",
        "declare i64 @minyar_queue_wake_socket(ptr)",
        "declare ptr @minyar_atomic_new(i64)",
        "declare zeroext i1 @minyar_atomic_wait(ptr, i64, i64)",
        "declare void @minyar_atomic_notify(ptr, i1 zeroext)"
    ]
    let declaration = 0
    while declaration < declarations.length {
        output.add(declarations[declaration] + "\n")
        declaration = declaration + 1
    }
    let prefix = "; minyar-thread-entry: "
    let i = 0
    while i < globals.length {
        let marker = globals[i]
        if marker.length > prefix.length && marker.slice(0, prefix.length) == prefix {
            let name = markerValue(marker, prefix)
            let function = findFunction(names, kinds, lookup, name)
            if threadLegacyEntry(context.functionParameterCounts, context.functionParameterTypes, function) {
                threadAppendBridge(output, name, results[function], recoverable)
            } else {
                let parameters: List<Integer> = []
                let first = functionParameterOffset(context.functionParameterCounts, function)
                let k = 0
                while k < context.functionParameterCounts[function] { parameters.add(context.functionParameterTypes[first + k]); k = k + 1 }
                threadAppendPacketBridge(output, name, results[function], recoverable, parameters)
            }
        }
        i = i + 1
    }
}

function threadAppendBridge(output: List<Text>, name: Text, result: Integer, recovery: Boolean) {
    output.add("define internal i64 @" + derivedSymbol(".minyar.thread.bridge.", name) + "(i64 %seed, ptr %frozen.local, ptr %channel.local) uwtable {\nentry:\n")
    if recovery {
        output.add("  %thread.accepted = call i32 @minyar_recovery_enter()\n")
        output.add("  %thread.allowed = icmp ne i32 %thread.accepted, 0\n")
        output.add("  br i1 %thread.allowed, label %thread.body, label %thread.reject\n")
        output.add("thread.reject:\n  ret i64 0\nthread.body:\n")
    } else {
        output.add("  call void @minyar_stack_enter()\n")
    }
    if result == 1 {
        output.add("  %result = call i64 @" + languageSymbol(name) + "(i64 %seed, ptr %frozen.local, ptr %channel.local)\n")
    } else {
        output.add("  call void @" + languageSymbol(name) + "(i64 %seed, ptr %frozen.local, ptr %channel.local)\n")
    }
    if recovery {
        output.add("  %thread.pending = call i32 @minyar_recovery_pending()\n")
        output.add("  %thread.failed = icmp ne i32 %thread.pending, 0\n")
        output.add("  br i1 %thread.failed, label %thread.unwind, label %thread.success\nthread.success:\n")
    }
    output.add("  call void @minyar_stack_leave()\n")
    if result == 1 { output.add("  ret i64 %result\n") }
    else { output.add("  ret i64 0\n") }
    if recovery {
        output.add("thread.unwind:\n  call void @minyar_stack_leave()\n  ret i64 0\n")
    }
    output.add("}\n")
}

// The packet bridge reads each argument's language slot and calls the entry.
function threadAppendPacketBridge(output: List<Text>, name: Text, result: Integer, recovery: Boolean, parameters: List<Integer>) {
    output.add("define internal i64 @" + derivedSymbol(".minyar.thread.bridge.", name) + "(ptr %arguments) uwtable {\nentry:\n")
    if recovery {
        output.add("  %thread.accepted = call i32 @minyar_recovery_enter()\n")
        output.add("  %thread.allowed = icmp ne i32 %thread.accepted, 0\n")
        output.add("  br i1 %thread.allowed, label %thread.body, label %thread.reject\n")
        output.add("thread.reject:\n  ret i64 0\nthread.body:\n")
    } else {
        output.add("  call void @minyar_stack_enter()\n")
    }
    let call = ""
    let k = 0
    while k < parameters.length {
        let type = parameters[k]
        let slot = "%argument." + Text(k)
        output.add("  " + slot + ".address = getelementptr inbounds i64, ptr %arguments, i64 " + Text(k) + "\n")
        output.add("  " + slot + ".slot = load i64, ptr " + slot + ".address, align 8\n")
        let value = slot + ".slot"
        if type == 4 { output.add("  " + slot + " = trunc i64 " + slot + ".slot to i1\n"); value = slot }
        if type == 3 { output.add("  " + slot + " = trunc i64 " + slot + ".slot to i32\n"); value = slot }
        if type == 7 { output.add("  " + slot + " = bitcast i64 " + slot + ".slot to double\n"); value = slot }
        if isReferenceType(type) { output.add("  " + slot + " = inttoptr i64 " + slot + ".slot to ptr\n"); value = slot }
        if k > 0 { call = call + ", " }
        call = call + argumentPrefix(type) + value
        k = k + 1
    }
    if result == 1 {
        output.add("  %result = call i64 @" + languageSymbol(name) + "(" + call + ")\n")
    } else {
        output.add("  call void @" + languageSymbol(name) + "(" + call + ")\n")
    }
    if recovery {
        output.add("  %thread.pending = call i32 @minyar_recovery_pending()\n")
        output.add("  %thread.failed = icmp ne i32 %thread.pending, 0\n")
        output.add("  br i1 %thread.failed, label %thread.unwind, label %thread.success\nthread.success:\n")
    }
    output.add("  call void @minyar_stack_leave()\n")
    if result == 1 { output.add("  ret i64 %result\n") }
    else { output.add("  ret i64 0\n") }
    if recovery {
        output.add("thread.unwind:\n  call void @minyar_stack_leave()\n  ret i64 0\n")
    }
    output.add("}\n")
}

function threadJoinOnReturn(output: List<Text>, globals: List<Text>, caller: Text) {
    if threadMode(globals) && (caller == "main" || caller == "top level" || threadEntry(globals, caller)) {
        output.add("  call void @minyar_thread_join_children()\n")
    }
}

function threadResultMember(output: List<Text>, textState: List<Text>, state: List<Integer>, receiver: Text, type: Integer, member: Text, resultType: List<Integer>): Text {
    let types: List<Integer> = [type]
    let values: List<Text> = [receiver]
    if member == "code" || member == "ok" {
        let callee = "minyar_thread_result_code"
        if type == 15 { callee = "minyar_frozen_result_code" }
        let code = emitCall(output, textState, state, 1, callee, values, types)
        if member == "ok" {
            setType(resultType, 4)
            return emitInstruction(output, textState, state, "icmp eq i64 " + code + ", 0")
        }
        setType(resultType, 1)
        return code
    }
    let result = 1
    let callee = "minyar_thread_join_result_value"
    if type == 12 && member == "thread" { result = 11; callee = "minyar_thread_start_result_value" }
    else if type == 15 && member == "value" { result = 9; callee = "minyar_frozen_result_value" }
    else if type == 18 && member == "region" { result = 16; callee = "minyar_native_region_result_value" }
    else if type != 13 || member != "value" { failCompiler("opaque thread result exposes only ok, code and its checked successful payload") }
    setType(resultType, result)
    return emitCall(output, textState, state, result, callee, values, types)
}

function threadFeatureName(name: Text): Boolean {
    let length = name.length
    if length < 6 || length > 22 { return false }
    let first = name[0]
    if first >= 'A' && first <= 'Z' {
        return name == "ValueQueue" || name == "AtomicInteger" || name == "AtomicBoolean" || name == "FrozenBytes" || name == "BytesChannel" || name == "Thread" || name == "ThreadStartResult" || name == "ThreadJoinResult" || name == "FrozenBytesChannel" || name == "FrozenBytesResult" || name == "NativeRegion" || name == "NativeRegions" || name == "NativeRegionResult"
    }
    if length < 9 { return false }
    let second = name[1]
    let plausible = false
    if first == 'm' || first == 'n' || first == 'a' { plausible = true }
    if first == 'f' && second == 'r' { plausible = true }
    if first == 'c' && ((second == 'l' && name[2] == 'o') || (second == 'o' && name[2] == 'p')) { plausible = true }
    if first == 'b' && second == 'y' { plausible = true }
    if first == 't' && (second == 'r' || second == 'h') { plausible = true }
    if first == 's' && (second == 'e' || second == 't') { plausible = true }
    if first == 'j' && second == 'o' { plausible = true }
    if first == 'r' && second == 'e' && name[2] == 'c' { plausible = true }
    return plausible && isThreadBuiltin(name)
}
