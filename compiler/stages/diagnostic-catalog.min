// Error codes describe a problem family, never a particular spelling or type.
// Keep published codes stable. Legacy callers are classified here while their
// messages move toward explicit, contextual diagnostics. Only failures use it.
function diagnosticBegins(message: Text, prefix: Text): Boolean {
    return message.length >= prefix.length && message.slice(0, prefix.length) == prefix
}

function diagnosticEnds(message: Text, suffix: Text): Boolean {
    return message.length >= suffix.length && message.slice(message.length - suffix.length, message.length) == suffix
}

function diagnosticCode(message: Text): Text {
    if message == "a declaration is missing its '{ ... }' body" || message == "callback is missing its body" { return "E0202" }
    if message == "a declaration is missing its closing '}'" || message == "callback body is missing its closing brace" { return "E0202" }
    if message == "Text contained invalid UTF-8." { return "E0102" }
    if diagnosticBegins(message, "the file '") || message == "a requested text file could not be read." || message == "a file path cannot contain a zero byte." { return "E0101" }
    if diagnosticBegins(message, "names must use ASCII") || diagnosticBegins(message, "native library names must use ASCII") || diagnosticBegins(message, "package names use") { return "E0103" }
    if diagnosticBegins(message, "Integer literal") || diagnosticBegins(message, "Text literal") || diagnosticBegins(message, "Character literal") || diagnosticBegins(message, "binary Integer literals") { return "E0104" }
    if diagnosticBegins(message, "raw Text") || diagnosticBegins(message, "multi-line Text") || diagnosticBegins(message, "block comment") || diagnosticBegins(message, "number separators") { return "E0104" }
    if diagnosticBegins(message, "Float literal") || diagnosticBegins(message, "an octal Integer literal") || diagnosticBegins(message, "decimal Integer literals") || diagnosticBegins(message, "octal literals") || diagnosticBegins(message, "hexadecimal literals") || diagnosticBegins(message, "a Float exponent") { return "E0104" }
    if diagnosticBegins(message, "I can't find a value named") { return "E0301" }
    if diagnosticBegins(message, "I can't find a function named") || (diagnosticBegins(message, "module '") && message.find("has no function named") >= 0) { return "E0302" }
    if diagnosticBegins(message, "unknown type") || diagnosticBegins(message, "I can't find a record named") || (diagnosticBegins(message, "module '") && message.find("has no record named") >= 0) { return "E0303" }
    if message.find("private to its module") >= 0 { return "E0307" }
    if diagnosticBegins(message, "record '") && diagnosticEnds(message, "' has private fields, so only its own module can create one") { return "E0307" }
    if message.find("has no field named") >= 0 { return "E0304" }
    if message.find("has no method named") >= 0 { return "E0305" }
    if diagnosticBegins(message, "unknown case") || (diagnosticBegins(message, "choice '") && message.find("has no case") >= 0) { return "E0306" }
    if diagnosticBegins(message, "match is missing cases") || diagnosticBegins(message, "match must handle") { return "E0601" }
    if diagnosticBegins(message, "duplicate match arm") { return "E0501" }
    if diagnosticBegins(message, "a choice needs") || diagnosticBegins(message, "a choice case needs") { return "E0602" }
    if diagnosticBegins(message, "choice case '") && message.find("expects") >= 0 { return "E0603" }
    if message.find("uses a reserved built-in name") >= 0 { return "E0502" }
    if message.find("declares '") >= 0 || message.find("declares parameter") >= 0 || message.find("was provided twice") >= 0 || diagnosticBegins(message, "duplicate ") { return "E0501" }
    if diagnosticBegins(message, "type parameter '") && diagnosticEnds(message, "' is declared twice") { return "E0501" }
    if diagnosticBegins(message, "module declares type '") && diagnosticEnds(message, "' more than once") { return "E0501" }
    if message == "this module already has a test with that name" { return "E0501" }
    if diagnosticBegins(message, "text interpolation") { return "E0408" }
    if diagnosticBegins(message, "an if condition") || diagnosticBegins(message, "a while condition") { return "E0402" }
    if message.find("must return a value on every path") >= 0 { return "E0403" }
    if message.find("expects ") >= 0 && (message.find("arguments, but received") >= 0 || message.find("argument, but received") >= 0) { return "E0404" }
    if diagnosticBegins(message, "callback expects ") || (diagnosticBegins(message, "method '") && (message.find("' expects ") >= 0 || message.find("' received too many arguments") >= 0)) { return "E0404" }
    // These builtins check their argument count before reporting a type expectation.
    if diagnosticBegins(message, "print expects one ") || diagnosticBegins(message, "Text expects one ") || diagnosticBegins(message, "fail expects one ") || diagnosticBegins(message, "exit expects one ") || diagnosticBegins(message, "joinText expects one ") { return "E0401" }
    // Numeric count failures use diagnosticArgumentCount above; these are type failures.
    if diagnosticBegins(message, "Bytes expects one Integer or Text argument; found ") || diagnosticBegins(message, "Float expects one Integer or Float argument; found ") || diagnosticBegins(message, "abs expects one Integer or Float argument; found ") { return "E0401" }
    if diagnosticBegins(message, "Integer expects one Integer, Float, Character, or Text argument; found ") || diagnosticBegins(message, "Character expects one Integer argument; found ") { return "E0401" }
    if diagnosticBegins(message, "wrappingAdd expects 2 Integer arguments; found ") || diagnosticBegins(message, "wrappingSubtract expects 2 Integer arguments; found ") || diagnosticBegins(message, "wrappingMultiply expects 2 Integer arguments; found ") { return "E0401" }
    if diagnosticBegins(message, "min expects 2 Integer arguments; found ") || diagnosticBegins(message, "min expects 2 Float arguments; found ") || diagnosticBegins(message, "min expects 2 Integer or 2 Float arguments; found ") { return "E0401" }
    if diagnosticBegins(message, "max expects 2 Integer arguments; found ") || diagnosticBegins(message, "max expects 2 Float arguments; found ") || diagnosticBegins(message, "max expects 2 Integer or 2 Float arguments; found ") { return "E0401" }
    if diagnosticBegins(message, "clamp expects 3 Integer arguments; found ") || diagnosticBegins(message, "clamp expects 3 Float arguments; found ") || diagnosticBegins(message, "clamp expects 3 Integer or 3 Float arguments; found ") { return "E0401" }
    if diagnosticBegins(message, "an empty List") || diagnosticBegins(message, "all values in a List literal") { return "E0405" }
    if diagnosticBegins(message, "Nothing cannot be stored") { return "E0409" }
    if diagnosticBegins(message, "for needs") || diagnosticBegins(message, "a position must be") { return "E0410" }
    if diagnosticBegins(message, "Text.slice positions must be Integers; expected Integer, found ") || diagnosticBegins(message, "List.slice positions must be Integers; expected Integer, found ") || diagnosticBegins(message, "List.truncate positions must be Integers; expected Integer, found ") { return "E0410" }
    if diagnosticBegins(message, "Lists and Bytes are not Equatable") { return "E0411" }
    if message.find("cannot be reassigned") >= 0 { return "E0407" }
    if diagnosticBegins(message, "'break'") || diagnosticBegins(message, "'continue'") || diagnosticBegins(message, "'else'") || diagnosticBegins(message, "use exit(status)") { return "E0204" }
    if diagnosticBegins(message, "the left side of && must be Boolean") || diagnosticBegins(message, "the right side of && must be Boolean") || diagnosticBegins(message, "the left side of || must be Boolean") || diagnosticBegins(message, "the right side of || must be Boolean") { return "E0406" }
    if diagnosticBegins(message, "the two sides of") || diagnosticBegins(message, "bitwise not needs") || diagnosticBegins(message, "logical not needs") || diagnosticBegins(message, "negation needs") || diagnosticBegins(message, "ordered comparison needs") || diagnosticBegins(message, "Map equality needs") || (diagnosticBegins(message, "'") && message.find("' needs ") >= 0) { return "E0406" }
    if diagnosticBegins(message, "record '") && message.find("is missing field") >= 0 { return "E0701" }
    if message.find("wrong type") >= 0 || message.find("does not match its declared type") >= 0 || diagnosticBegins(message, "an indexed assignment needs") || (diagnosticBegins(message, "record field '") && message.find("needs ") >= 0) { return "E0401" }
    if diagnosticBegins(message, "type argument '") && message.find("' is used inconsistently: ") >= 0 { return "E0401" }
    if diagnosticBegins(message, "the value for constant '") && message.find("' is ") >= 0 && message.find(", not ") >= 0 { return "E0401" }
    if message == "try requires a Result-returning function" || diagnosticBegins(message, "try requires a Result-returning function; found ") { return "E0401" }
    if diagnosticBegins(message, "try needs a Result; found ") || diagnosticBegins(message, "try error type must match the enclosing Result error type; expected ") { return "E0401" }
    if diagnosticBegins(message, "try context needs an error type with a public withContext(Text) method returning the same error type; found ") || diagnosticBegins(message, "try context needs an error type with a public withContext(Text) method returning the same error type; expected (Text) -> ") { return "E0401" }
    if diagnosticBegins(message, "try context must be Text; expected Text, found ") { return "E0401" }
    if diagnosticBegins(message, "expected an expression") { return "E0201" }
    if diagnosticBegins(message, "unexpected '") && message.find("start the next statement") >= 0 { return "E0203" }
    if diagnosticBegins(message, "expected ") { return "E0202" }
    if diagnosticBegins(message, "native ") { return "E0205" }
    if diagnosticBegins(message, "a program cannot combine") { return "E0206" }
    return "E0001"
}

function diagnosticArgumentCount(name: Text, expected: Integer, received: Integer): Text {
    let noun = " arguments"
    if expected == 1 { noun = " argument" }
    return name + " expects " + Text(expected) + noun + ", but received " + Text(received)
}

function diagnosticCodes(): List<Text> {
    return ["E0001", "E0101", "E0102", "E0103", "E0104", "E0201", "E0202", "E0203", "E0204", "E0205", "E0206", "E0301", "E0302", "E0303", "E0304", "E0305", "E0306", "E0307", "E0401", "E0402", "E0403", "E0404", "E0405", "E0406", "E0407", "E0408", "E0409", "E0410", "E0411", "E0501", "E0502", "E0601", "E0602", "E0603", "E0701"]
}

function diagnosticTitle(code: Text): Text {
    if code == "E0001" { return "The compiler could not accept this program" }
    if code == "E0101" { return "A source file could not be read" }
    if code == "E0102" { return "The source is not valid UTF-8" }
    if code == "E0103" { return "A name contains an unsupported character" }
    if code == "E0104" { return "A literal or comment is incomplete or invalid" }
    if code == "E0201" { return "An expression is missing" }
    if code == "E0202" { return "A piece of syntax is missing" }
    if code == "E0203" { return "Two statements need a separator" }
    if code == "E0204" { return "A control-flow statement is in the wrong place" }
    if code == "E0205" { return "A native function body is invalid" }
    if code == "E0206" { return "The program has two entry points" }
    if code == "E0301" { return "A value name could not be found" }
    if code == "E0302" { return "A function name could not be found" }
    if code == "E0303" { return "A type name could not be found" }
    if code == "E0304" { return "A record field could not be found" }
    if code == "E0305" { return "A method could not be found" }
    if code == "E0306" { return "A choice case could not be found" }
    if code == "E0307" { return "A member is private to another module" }
    if code == "E0401" { return "A value has a different type than required" }
    if code == "E0402" { return "A condition needs a Boolean value" }
    if code == "E0403" { return "A function can finish without returning a value" }
    if code == "E0404" { return "A function received the wrong number of arguments" }
    if code == "E0405" { return "A List needs one known element type" }
    if code == "E0406" { return "An operator received incompatible values" }
    if code == "E0407" { return "A constant cannot be changed" }
    if code == "E0408" { return "Text interpolation needs a printable value" }
    if code == "E0409" { return "Nothing cannot be stored in a binding" }
    if code == "E0410" { return "Iteration or indexing needs a supported value" }
    if code == "E0411" { return "These collections cannot be compared with == or !=" }
    if code == "E0501" { return "A name is declared more than once" }
    if code == "E0502" { return "A function name is reserved" }
    if code == "E0601" { return "A match leaves some cases unhandled" }
    if code == "E0602" { return "A choice declaration needs a named case" }
    if code == "E0603" { return "A choice case received the wrong number of values" }
    if code == "E0701" { return "A record is missing a required field" }
    return ""
}

function diagnosticRepair(code: Text, message: Text): Text {
    if message == "try requires a Result-returning function" || diagnosticBegins(message, "try requires a Result-returning function; found ") { return "use try inside a function returning Result, or handle this Result with match" }
    if diagnosticBegins(message, "try needs a Result; found ") { return "pass a Result value to try; use an ordinary value directly without try" }
    if diagnosticBegins(message, "try error type must match the enclosing Result error type; expected ") { return "handle the Result with match and convert its error to the enclosing error type" }
    if diagnosticBegins(message, "try context needs an error type with a public withContext(Text) method returning the same error type; found ") || diagnosticBegins(message, "try context needs an error type with a public withContext(Text) method returning the same error type; expected (Text) -> ") { return "provide a public withContext(Text) method returning the same error type, or handle the Result with match" }
    if diagnosticBegins(message, "try context must be Text; expected Text, found ") { return "use a Text expression after else, such as \"reading the configuration\"" }
    if diagnosticBegins(message, "Text.slice positions must be Integers; expected Integer, found ") { return "use Integer positions, such as text.slice(0, text.length)" }
    if diagnosticBegins(message, "List.slice positions must be Integers; expected Integer, found ") { return "use Integer positions, such as values.slice(0, values.length)" }
    if diagnosticBegins(message, "List.truncate positions must be Integers; expected Integer, found ") { return "use an Integer length, such as values.truncate(0)" }
    if diagnosticBegins(message, "type argument '") && message.find("' is used inconsistently: ") >= 0 { return "use the same type for every value bound to this type parameter" }
    if diagnosticBegins(message, "the value for constant '") && message.find("' is ") >= 0 && message.find(", not ") >= 0 { return "change the initializer or the constant's declared type so they agree" }
    if diagnosticBegins(message, "record '") && diagnosticEnds(message, "' has private fields, so only its own module can create one") { return "call a public factory function from the module that declares this record" }
    if diagnosticBegins(message, "type parameter '") && diagnosticEnds(message, "' is declared twice") { return "give each type parameter a distinct name, or remove the repeated parameter" }
    if diagnosticBegins(message, "module declares type '") && diagnosticEnds(message, "' more than once") { return "use one declaration for this type name, or rename one of the declarations" }
    if message == "this module already has a test with that name" { return "give each test in this module a different name, or remove the repeated test" }
    if message == "a declaration is missing its '{ ... }' body" || message == "callback is missing its body" { return "add { ... } after this declaration's header" }
    if message == "a declaration is missing its closing '}'" || message == "callback body is missing its closing brace" { return "add '}' to close the body that starts here" }
    if diagnosticBegins(message, "binary Integer literals") { return "write this value in decimal, or use a supported prefix such as 0xFF or 0o755" }
    if diagnosticBegins(message, "number separators") { return "remove the underscores; write 1000 instead of 1_000" }
    if diagnosticBegins(message, "Integer literal is outside") { return "use an Integer from -9223372036854775808 through 9223372036854775807" }
    if diagnosticBegins(message, "Text literal is missing") { return "add a closing double quote at the end of this Text literal" }
    if diagnosticBegins(message, "Character literal") { return "put exactly one character between single quotes, such as 'A'" }
    if diagnosticBegins(message, "block comment") { return "add */ to close this block comment" }
    if diagnosticBegins(message, "raw Text is missing") { return "close this raw Text with a double quote and the same number of '#' characters used to open it" }
    if diagnosticBegins(message, "multi-line Text must begin") { return "start the content on the line after the opening triple quotes" }
    if diagnosticBegins(message, "'break'") { return "move break inside a for or while loop, or remove it" }
    if diagnosticBegins(message, "'continue'") { return "move continue inside a for or while loop, or remove it" }
    if diagnosticBegins(message, "'else'") { return "put this else directly after the closing brace of an if branch" }
    if diagnosticBegins(message, "use exit(status)") { return "use exit(0) to finish successfully at top level, or move this return into a function" }
    if diagnosticBegins(message, "duplicate match arm") { return "remove the repeated arm, or use an unhandled case name from this choice" }
    if diagnosticBegins(message, "record field '") && message.find("was provided twice") >= 0 { return "supply this field once in the record literal; remove the repeated field and its value" }
    if code == "E0101" { return "check that this path names a readable file and that its parent directories are accessible" }
    if code == "E0102" { return "save this source file as UTF-8, then compile it again" }
    if code == "E0103" { return "use ASCII letters, digits, and '_' in this name; keep other characters inside Text" }
    if code == "E0104" { return "check this literal's spelling and closing delimiter; see the valid examples in the explanation" }
    if code == "E0201" { return "put a value or a function call here; check that each operator has a value on both sides" }
    if code == "E0202" { return "add the expected token here; check the matching parentheses, braces, and separators" }
    if code == "E0203" { return "put the next statement on a new line, or separate the statements with ';'" }
    if code == "E0204" { return "put break and continue inside a loop, else after if, and return inside a function" }
    if code == "E0205" { return "use native as the entire body of a library function, with a valid native library name" }
    if code == "E0206" { return "choose top-level statements or function main(), and move all startup code into that entry point" }
    if code == "E0301" { return "check the spelling, or declare this value before using it in the current scope" }
    if code == "E0302" { return "check the function's spelling and its module alias; imported functions must be public" }
    if code == "E0303" { return "check the type's spelling and module alias, or declare the record or choice in this module" }
    if code == "E0304" { return "use a field from this record's declaration, or add the missing field to the record" }
    if code == "E0305" { return "check the method's spelling and receiver type; imported methods must be public" }
    if code == "E0306" { return "use one of the cases declared by this choice, with the same capitalisation" }
    if code == "E0307" { return "use the module's public API, or mark this declaration public in the module that owns it" }
    if code == "E0401" { return "change this value to the expected type, or change the declaration if it should accept the found type" }
    if code == "E0402" { return "write a comparison such as count > 0, or use a Boolean value such as true or false" }
    if code == "E0403" { return "return a value of the declared type on every branch, including the final path through the function" }
    if code == "E0404" { return "pass one value for each parameter in the function's declaration, in the same order" }
    if code == "E0405" { return "give an empty List a type such as List<Text>, and keep every element the same type" }
    if code == "E0406" { return "use operands of the types this operator accepts; convert values explicitly when needed" }
    if code == "E0407" { return "use let instead of constant if this binding needs to change" }
    if code == "E0408" { return "put a printable expression inside \\( ); for a record, choose a field or a method that returns Text" }
    if code == "E0409" { return "call this function as a statement, or make it return a value before assigning its result" }
    if code == "E0410" { return "iterate over a range or a supported collection; use an Integer for its position" }
    if code == "E0411" { return "compare lengths and corresponding elements explicitly, using == on the element values" }
    if code == "E0501" { return "remove the repeated declaration, or give the two values different names" }
    if code == "E0502" { return "choose a different function name, such as printLocal instead of print" }
    if code == "E0601" { return "add an arm for each missing case, or an else arm to handle all remaining cases" }
    if code == "E0602" { return "give this choice at least one case, and start every case name with a capital letter" }
    if code == "E0603" { return "pass one value for each payload in this case's declaration, in the same order" }
    if code == "E0701" { return "include every field from the record's declaration when constructing this value" }
    return "follow the specific correction in this message, then compile again to check the remaining code"
}

function diagnosticLesson(code: Text): Text {
    if code == "E0101" { return "The compiler needs the file itself, rather than a directory. Relative paths start at the working directory. Check spelling, permissions, and whether a generated source file has been created.\n\nA source file can contain:\n```minyar\nprint(\"The window is lit.\")\n```" }
    if code == "E0102" { return "Minyar source files use UTF-8. A byte from a different encoding cannot be read as a character. Ask your editor to save as UTF-8; do not replace valid accented letters or emoji inside Text.\n\n```minyar\nprint(\"A cafe: café. A light: 🌟.\")\n```" }
    if code == "E0103" { return "Names use ASCII letters, digits, and underscores. A name cannot start with a digit. Text can contain Unicode characters, so keep the human-readable spelling in the value.\n\n```minyar\nlet cafe = \"café\"\nprint(cafe)\n```" }
    if code == "E0104" { return "A literal needs a valid spelling and its closing delimiter. Character uses single quotes around exactly one character. Text uses double quotes. A block comment ends with */. Integer supports decimal, hexadecimal 0x, and octal 0o; binary prefixes and digit separators are not supported. Float supports finite decimal values such as 1.5e3.\n\n```minyar\nlet light = \"a warm window\"\nlet initial = 'L'\nlet count = 1000\nlet distance = 1.5e3\nlet mask = 0xff\nprint(light)\n```" }
    if code == "E0201" { return "An expression produces a value. A closing parenthesis or an operator on its own cannot stand in for one. Fill in the missing value rather than adding another delimiter.\n\n```minyar\nlet stars = 3 + 2\nprint(stars)\n```" }
    if code == "E0202" { return "The compiler reached a place where a particular token is required. Start at the underline, then check the opening delimiter or declaration immediately before it. Parentheses enclose arguments; braces enclose bodies.\n\n```minyar\nfunction greet(name: Text): Text {\n    return \"Hello, \" + name\n}\nprint(greet(\"Ada\"))\n```" }
    if code == "E0203" { return "Each statement ends at a new line or a semicolon. Two calls on one line need a separator between them.\n\n```minyar\nprint(\"Dawn\")\nprint(\"The light returns.\")\n```" }
    if code == "E0204" { return "Control-flow words act on the surrounding structure. break and continue need a loop; else follows an if branch; return leaves a function. A top-level program can finish with exit(status).\n\n```minyar\nfor index in 0..3 {\n    if index == 2 { break }\n    print(index)\n}\n```" }
    if code == "E0205" { return "A native declaration links a library function to its host implementation. Its body contains only native and the library name. It cannot be the program's main function. The host must supply the corresponding symbol.\n\n```minyar\npublic function clockTicks(): Integer { native \"clock\" }\n```" }
    if code == "E0206" { return "A program starts in one place: either its top-level statements or function main(). Move the top-level work into main, or remove main and keep the top-level form.\n\n```minyar\nfunction main() {\n    print(\"The harbour wakes.\")\n}\n```" }
    if code == "E0301" { return "A value is visible only in its scope, after its local declaration. Check the spelling first. A name declared inside a function or a branch is not available outside that body.\n\n```minyar\nlet lantern = \"a warm light\"\nprint(lantern)\n```" }
    if code == "E0302" { return "Check the function name and the module alias before it. An imported function must be declared public in its own module. Functions can be declared later in the same module.\n\n```minyar\nfunction portrait(name: Text): Text { return \"A portrait of \" + name }\nprint(portrait(\"Ada\"))\n```" }
    if code == "E0303" { return "A type names a kind of value, such as Integer, Text, a record, or a choice. Use the exact spelling and capitalisation. Imported types use their module alias and must be public.\n\n```minyar\nrecord Window { title: Text }\nlet window: Window = Window { title: \"Dawn\" }\nprint(window.title)\n```" }
    if code == "E0304" { return "A record has only the fields in its declaration. Read or assign the intended field by its exact name. Adding a new field also means supplying it wherever the record is constructed.\n\n```minyar\nrecord Window { light: Integer }\nlet window = Window { light: 3 }\nprint(window.light)\n```" }
    if code == "E0305" { return "A method belongs to its receiver type. Check the name and the type of the value before the dot. Declare a method in the module that owns its record; imported methods must be public.\n\n```minyar\nrecord Lens { strength: Integer }\nfunction Lens.focus(): Integer { return self.strength }\nlet lens = Lens { strength: 3 }\nprint(lens.focus())\n```" }
    if code == "E0306" { return "A choice value and its match arms use case names from that choice's declaration. Case names begin with a capital letter and keep the same spelling everywhere.\n\n```minyar\nchoice Weather { Clear; Rain(drops: Integer) }\nlet weather: Weather = Rain(3)\nmatch weather {\n    Clear { print(\"Clear\") }\n    Rain(drops) { print(drops) }\n}\n```" }
    if code == "E0307" { return "Declarations are private to their module unless marked public. Prefer an existing public function when it provides the operation you need. Otherwise, expose the declaration in the module that owns it.\n\nIn the library module:\n```minyar\npublic function light(): Text { return \"a warm window\" }\n```" }
    if code == "E0401" { return "The expected type comes from a declaration, parameter, field, or return type. The found type describes the expression you supplied. Change the expression or the declaration so they agree; conversions are explicit.\n\n```minyar\nlet stars: Integer = 3\nlet description: Text = Text(stars)\nprint(description)\n```" }
    if code == "E0402" { return "if and while decide between true and false, so their condition must be Boolean. An Integer is not implicitly a Boolean. Write the comparison that expresses your intention.\n\n```minyar\nlet count = 3\nif count > 0 { print(\"There is light.\") }\n```" }
    if code == "E0403" { return "A function with a result type promises a value on every path that finishes normally. Returning only inside if leaves the other path open. Add the other return or a final return after the branch.\n\n```minyar\nfunction brightness(lit: Boolean): Integer {\n    if lit { return 3 }\n    return 0\n}\nprint(brightness(true))\n```" }
    if code == "E0404" { return "Every declared parameter needs one argument. The diagnostic shows how many values were expected and received. Keep them in declaration order, with commas between them.\n\n```minyar\nfunction lantern(name: Text, light: Integer): Text {\n    return name + \": \" + Text(light)\n}\nprint(lantern(\"Harbour\", 3))\n```" }
    if code == "E0405" { return "Every value in a List has the same type. A nonempty literal can infer that type from its elements. An empty literal needs a declared element type, or a parameter that supplies one.\n\n```minyar\nlet windows: List<Text> = []\nwindows.add(\"Dawn\")\nwindows.add(\"Harbour\")\nprint(windows.length)\n```" }
    if code == "E0406" { return "Each operator accepts particular types. Arithmetic needs compatible numbers; Boolean logic uses &&, ||, and !; bitwise operations need Integer. Convert values explicitly rather than relying on implicit coercion.\n\n```minyar\nlet count = 3\nprint(count + 2)\nprint(\"Stars: \" + Text(count))\n```" }
    if code == "E0407" { return "constant gives a binding a value that cannot be reassigned. Use let when the value should change, or compute a new value under a different name.\n\n```minyar\nlet light = 1\nlight = 2\nprint(light)\n```" }
    if code == "E0408" { return "Interpolation places a printable expression inside \\(expression). Integer, Float, Boolean, Character, and Text are printable. For a record or collection, choose a field or write a method that returns Text. Empty interpolation needs an expression.\n\n```minyar\nlet stars = 3\nprint(\"The sky has \\(stars) stars.\")\n```" }
    if code == "E0409" { return "A function without a result type returns Nothing. Such a call performs an action rather than producing a stored value. Call it directly as a statement, or return a meaningful value from the function.\n\n```minyar\nfunction lightWindow() { print(\"A warm light.\") }\nlightWindow()\n```" }
    if code == "E0410" { return "A for loop needs an iterable value, such as a range or a collection. A collection position needs an Integer. Check whether you intended to use the collection itself, its length, or one element.\n\n```minyar\nlet windows = [\"Dawn\", \"Harbour\"]\nfor index in 0..windows.length { print(windows[index]) }\n```" }
    if code == "E0411" { return "Lists and Bytes do not provide == or !=. Comparing their stored addresses would not compare their contents. Compare their lengths first, then corresponding elements.\n\n```minyar\nfunction same(left: List<Integer>, right: List<Integer>): Boolean {\n    if left.length != right.length { return false }\n    for index in 0..left.length {\n        if left[index] != right[index] { return false }\n    }\n    return true\n}\nprint(same([1, 2], [1, 2]))\n```" }
    if code == "E0501" { return "Two declarations in the same namespace need different names. A record literal supplies each field once; a choice match handles each case once. Remove the repeated item or rename it to express a different role.\n\n```minyar\nrecord Window { title: Text; light: Integer }\nlet window = Window { title: \"Dawn\"; light: 3 }\nprint(window.title)\n```" }
    if code == "E0502" { return "Some function names belong to built-in operations. Choose a descriptive name for your own function so calls have one clear meaning. A local binding may still use an ordinary contextual name.\n\n```minyar\nfunction printLocal(message: Text) { print(message) }\nprintLocal(\"The harbour is home.\")\n```" }
    if code == "E0601" { return "A match must handle every possible case. Add the missing named arms when each case needs its own behavior, or an else arm when all remaining cases share one behavior. Result needs both Ok and Err.\n\n```minyar\nchoice Weather { Clear; Rain(drops: Integer) }\nlet weather: Weather = Rain(3)\nmatch weather {\n    Clear { print(\"The stars are out.\") }\n    Rain(drops) { print(drops) }\n}\n```" }
    if code == "E0602" { return "A choice lists the possible shapes of a value. It needs at least one case, and each case name begins with a capital letter. Payload names and types go inside parentheses.\n\n```minyar\nchoice Weather {\n    Clear\n    Rain(drops: Integer)\n}\n```" }
    if code == "E0603" { return "A case constructor takes exactly the payload values declared for that case, in the same order. Check the case declaration rather than adding or removing parentheses at random.\n\n```minyar\nchoice Weather { Clear; Rain(drops: Integer) }\nlet weather: Weather = Rain(3)\n```" }
    if code == "E0701" { return "A record literal supplies every declared field. Minyar does not invent a default value for a missing field. Add the named field with a value of its declared type.\n\n```minyar\nrecord Window { title: Text; light: Integer }\nlet window = Window { title: \"Dawn\"; light: 3 }\nprint(window.title)\n```" }
    return "Read the specific message together with the underlined source. A correction earlier on the same line can resolve a later error. Fix the first independent problem, then compile again. This general code also covers compiler options and checks that do not yet have a dedicated family.\n\nA complete program can be as small as:\n```minyar\nprint(\"The harbour is home.\")\n```"
}

function diagnosticExplainCommand() {
    if processInfo.argumentCount() != 2 {
        diagnosticWrite("usage: minyar explain CODE\n")
        exit(2)
    }
    let code = processInfo.argument(1)
    if code == "--help" || code == "-h" { print("usage: minyar explain CODE\n       minyar explain --list"); return }
    if code == "--list" {
        let codes = diagnosticCodes()
        let index = 0
        while index < codes.length {
            let item = codes[index]
            print(item + "  " + diagnosticTitle(item))
            index = index + 1
        }
        return
    }
    let title = diagnosticTitle(code)
    if title == "" {
        diagnosticWrite("unknown error code: " + diagnosticTerminalText(code) + "\nUse minyar explain --list to list the available codes.\n")
        exit(2)
    }
    print(code + ": " + title + "\n\n" + diagnosticLesson(code))
}
