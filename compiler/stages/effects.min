function finishParallelFunction(output: List<Text>, globals: List<Text>, entrySlot: Integer, bodySlot: Integer, name: Text, references: Boolean, recoverable: Boolean) {
    if references {
        failCompiler("parallel function '" + readableDeclarationName(name) + "' may use only Integer, Float, Boolean and Character values")
    }
    if !recoverable { dropCallDepthFrame(output, entrySlot, bodySlot) }
    let body: List<Text> = []
    let piece = bodySlot
    while piece < output.length {
        let text = output[piece]
        if text == "  call void @minyar_rc_leave()\n" || text == "  call void @minyar_rc_step()\n" {
            output[piece] = ""
        } else {
            body.add(text)
        }
        piece = piece + 1
    }
    recordSafeParallelEffects(output, globals, bodySlot, name)
    let text = joinText(body)
    let position = 0
    while position + 8 < text.length {
        if text[position] == '@' && text.slice(position, position + 8) == "@minyar_" {
            let end = position + 8
            while end < text.length && text[end] != '(' && text[end] != ' ' { end = end + 1 }
            let callee = text.slice(position + 1, end)
            if !parallelRuntimeAllowed(callee) {
                failCompiler("parallel function '" + readableDeclarationName(name) + "' cannot use the runtime ('" + callee + "')")
            }
        }
        if text[position] == '@' && position + 12 < text.length && text.slice(position, position + 12) == "@.minyar.fn." {
            let end = position + 12
            while end < text.length && text[end] != '(' && text[end] != ' ' { end = end + 1 }
            globals.add("; minyar-parallel-call: " + name + "|" + text.slice(position + 12, end) + "\n")
        }
        // Module names are quoted; the program tables spell them with their quotes.
        if text[position] == '@' && position + 13 < text.length && text.slice(position, position + 13) == "@\".minyar.fn." {
            let end = position + 13
            while end < text.length && text[end] != '"' { end = end + 1 }
            globals.add("; minyar-parallel-call: " + name + "|" + text.slice(position + 1, end + 1) + "\n")
        }
        position = position + 1
    }
}

// A parallel function cannot resize a buffer, and its caller waits for it to
// return, so the length and values pointer of each List parameter stay fixed
// for the whole call. Load them once at entry; every index of that List then
// tests the loaded length and reads through the loaded pointer, so LLVM need
// not reload them after a slot store or inside a conditional block. A failing
// index still calls the runtime with the List itself, which reports the same
// error. Runs after the body is complete, so every call is on one line.
function hoistParallelListHeaders(output: List<Text>, entrySlot: Integer, bodySlot: Integer) {
    let pieces: List<Text> = []
    let piece = bodySlot
    while piece < output.length {
        pieces.add(output[piece])
        piece = piece + 1
    }
    let text = joinText(pieces)
    // Without a loop each header is read about as often as it would be here,
    // and loading every one at entry costs a short recursive function more.
    if text.find("\nfor.condition.") < 0 && text.find("\nwhile.condition.") < 0 { return }
    let lines = text.split("\n")
    let lists: List<Text> = []
    let index = 0
    while index < lines.length {
        let line = lines[index]
        line = parallelKnownHeader(line, "@.minyar.list.get.checked(", "@.minyar.list.get.known(", lists)
        line = parallelKnownHeader(line, "@.minyar.list.set.scalar.checked(", "@.minyar.list.set.scalar.known(", lists)
        let call = " = call i64 @.minyar.list.length(ptr "
        let length = line.find(call + "%argument.")
        if length > 2 && line.endsWith(")") {
            let list = line.slice(length + call.length, line.length - 1)
            if parallelArgumentName(list) {
                if loopNamed(lists, list) < 0 { lists.add(list) }
                line = line.slice(0, length) + " = add i64 " + list + ".length, 0"
            }
        }
        lines[index] = line
        index = index + 1
    }
    if lists.length == 0 { return }
    fuseKnownIndexOffsets(lines)
    output[bodySlot] = joinText(joinLines(lines))
    piece = bodySlot + 1
    while piece < output.length {
        output[piece] = ""
        piece = piece + 1
    }
    let loads: List<Text> = [output[entrySlot]]
    index = 0
    while index < lists.length {
        let list = lists[index]
        loads.add("  " + list + ".length.pointer = getelementptr inbounds { ptr, i64, i64 }, ptr " + list + ", i32 0, i32 1\n  " + list + ".length = load i64, ptr " + list + ".length.pointer, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}, !range !{i64 0, i64 -9223372036854775808}\n  " + list + ".values = load ptr, ptr " + list + ", !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}\n")
        index = index + 1
    }
    output[entrySlot] = joinText(loads)
}

// An index `base + c` (or `base - c`) with a small constant c that is used only
// by one known-header access: compute the sum without an overflow branch and
// let the access test it. A sum that overflows upward wraps to a negative
// position, and one that overflows downward to at least 2^63 - 2^31, both at or
// past any List length (below 2^61), so the bounds test fails exactly when the
// sum overflows or is outside the List; the failure path then tests the
// overflow again and reports whichever error the checked code would have.
function fuseKnownIndexOffsets(lines: List<Text>) {
    let index = 0
    while index + 3 < lines.length {
        let line = lines[index]
        let operation = ""
        if line.find(" = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 ") > 0 { operation = "sadd" }
        if line.find(" = call { i64, i1 } @llvm.ssub.with.overflow.i64(i64 ") > 0 { operation = "ssub" }
        if operation != "" && line.startsWith("  %checked.") && line.endsWith(")") {
            let checked = line.slice(2, line.find(" = "))
            let operands = line.slice(line.find("(i64 ") + 5, line.length - 1).split(", i64 ")
            let result = lines[index + 1]
            let equals = result.find(" = extractvalue { i64, i1 } " + checked + ", 0")
            let flag = lines[index + 2]
            let flagEquals = flag.find(" = extractvalue { i64, i1 } " + checked + ", 1")
            if operands.length == 2 && equals > 2 && result.startsWith("  %") && flagEquals > 2 && flag.startsWith("  %") {
                let value = result.slice(2, equals)
                let overflow = flag.slice(2, flagEquals)
                let base = operands[0]
                let offset = ""
                if operation == "sadd" {
                    if smallIndexOffset(operands[1]) { offset = operands[1] } else if smallIndexOffset(operands[0]) { base = operands[1]; offset = operands[0] }
                } else if smallIndexOffset(operands[1]) {
                    offset = "-" + operands[1]
                    if operands[1].startsWith("-") { offset = operands[1].slice(1, operands[1].length) }
                }
                let use = -1
                if offset != "" && lines[index + 3] == "  call void @.minyar.integer.overflow.checked(i1 " + overflow + ")" { use = singleKnownIndexUse(lines, index, value) }
                if use >= 0 {
                    let access = lines[use]
                    let known = access.find(".known(ptr ")
                    let tail = ", i64 " + value + ")"
                    if access.endsWith(tail) {
                        lines[use] = access.slice(0, known) + ".known.offset(ptr " + access.slice(known + 11, access.length - tail.length) + ", i64 " + base + ", i64 " + offset + ")"
                    } else {
                        let middle = ", i64 " + value + ", i64 "
                        let at = access.find(middle)
                        lines[use] = access.slice(0, known) + ".known.offset(ptr " + access.slice(known + 11, at) + ", i64 " + base + ", i64 " + offset + ", i64 " + access.slice(at + middle.length, access.length)
                    }
                    lines[index] = ""
                    lines[index + 1] = ""
                    lines[index + 2] = ""
                    lines[index + 3] = ""
                    index = index + 3
                }
            }
        }
        index = index + 1
    }
}

// A literal of one to nine digits, optionally negative: within 2^31.
function smallIndexOffset(operand: Text): Boolean {
    let start = 0
    if operand.startsWith("-") { start = 1 }
    if operand.length <= start || operand.length - start > 9 { return false }
    let at = start
    while at < operand.length {
        if operand[at] < '0' || operand[at] > '9' { return false }
        at = at + 1
    }
    return true
}

// The line of the one use of `value`, defined by the four lines at
// `definition`, if that use is the position of a known-header List access;
// otherwise -1. Uses are searched everywhere: a phi may precede a definition.
function singleKnownIndexUse(lines: List<Text>, definition: Integer, value: Text): Integer {
    let found = -1
    let index = 0
    while index < lines.length {
        let line = lines[index]
        if index >= definition && index < definition + 4 { line = "" }
        let at = line.find(value)
        while at >= 0 {
            let end = at + value.length
            if end >= line.length || !loopNameCharacter(line[end]) {
                if found >= 0 { return -1 }
                found = index
            }
            let rest = line.slice(end, line.length)
            let next = rest.find(value)
            if next < 0 { at = -1 } else { at = end + next }
        }
        index = index + 1
    }
    if found < 0 { return -1 }
    let line = lines[found]
    if line.find("@.minyar.list.get.known(") >= 0 && line.endsWith(", i64 " + value + ")") { return found }
    if line.startsWith("  call void @.minyar.list.set.scalar.known(") && line.find(".values, i64 " + value + ", i64 ") >= 0 && !line.endsWith(", i64 " + value + ")") { return found }
    return -1
}

// `%argument.N` and nothing else.
function parallelArgumentName(name: Text): Boolean {
    if name.length < 11 || !name.startsWith("%argument.") { return false }
    let index = 10
    while index < name.length {
        if name[index] < '0' || name[index] > '9' { return false }
        index = index + 1
    }
    return true
}

// Rewrites a call of `checked` on a List parameter to `known`, which takes the
// parameter's loaded length and values pointer after the List itself.
function parallelKnownHeader(line: Text, checked: Text, known: Text, lists: List<Text>): Text {
    let at = line.find(checked + "ptr %argument.")
    if at < 0 { return line }
    let start = at + checked.length + 4
    let rest = line.slice(start, line.length)
    let comma = rest.find(", ")
    if comma < 0 { return line }
    let list = rest.slice(0, comma)
    if !parallelArgumentName(list) { return line }
    if loopNamed(lists, list) < 0 { lists.add(list) }
    return line.slice(0, at) + known + "ptr " + list + ", i64 " + list + ".length, ptr " + list + ".values" + rest.slice(comma, rest.length)
}

// The lines with their line breaks restored.
function joinLines(lines: List<Text>): List<Text> {
    let result: List<Text> = []
    let index = 0
    while index < lines.length {
        result.add(lines[index])
        if index + 1 < lines.length { result.add("\n") }
        index = index + 1
    }
    return result
}

function dropCallDepthFrame(output: List<Text>, entrySlot: Integer, bodySlot: Integer) {
    let enter = "  call void @minyar_stack_enter()\n"
    let entry = output[entrySlot]
    if entry.length >= enter.length && entry.slice(0, enter.length) == enter {
        output[entrySlot] = entry.slice(enter.length, entry.length)
    }
    let piece = bodySlot
    while piece < output.length {
        if output[piece] == "  call void @minyar_stack_leave()\n" {
            output[piece] = ""
        }
        piece = piece + 1
    }
}

function dropCallDepthFrameBetween(output: List<Text>, entrySlot: Integer, bodySlot: Integer, endSlot: Integer) {
    let enter = "  call void @minyar_stack_enter()\n"
    let entry = output[entrySlot]
    if entry.length >= enter.length && entry.slice(0, enter.length) == enter {
        output[entrySlot] = entry.slice(enter.length, entry.length)
    }
    let piece = bodySlot
    while piece < endSlot {
        if output[piece] == "  call void @minyar_stack_leave()\n" {
            output[piece] = ""
        }
        piece = piece + 1
    }
}

function dropTreeGuards(output: List<Text>, functionCount: Integer, treeFunctions: List<Integer>, treeKinds: List<Integer>, callTargets: List<Integer>, treeCallStarts: List<Integer>, treeCallEnds: List<Integer>, treeSlots: List<Integer>) {
    let recordOf: List<Integer> = []
    let index = 0
    while index < functionCount {
        recordOf.add(-1)
        index = index + 1
    }
    let record = 0
    while record < treeFunctions.length {
        if treeFunctions[record] >= 0 { recordOf[treeFunctions[record]] = record }
        record = record + 1
    }
    let calleeStarts: List<Integer> = []
    let callees: List<Integer> = []
    record = 0
    while record < treeFunctions.length {
        calleeStarts.add(callees.length)
        if treeKinds[record] == 1 {
            let call = treeCallStarts[record]
            let end = treeCallEnds[record]
            while call < end {
                let callee = callTargets[call]
                if callee < 0 || recordOf[callee] < 0 {
                    treeKinds[record] = 9
                    call = end
                } else {
                    callees.add(recordOf[callee])
                }
                call = call + 1
            }
        }
        record = record + 1
    }
    calleeStarts.add(callees.length)
    let level = 2
    while level <= 3 {
        record = 0
        while record < treeFunctions.length {
            if treeKinds[record] == 1 {
                let free = true
                let position = calleeStarts[record]
                while free && position < calleeStarts[record + 1] {
                    let callee = callees[position]
                    if callee == record || treeKinds[callee] == 1 || treeKinds[callee] >= level {
                        free = false
                    }
                    position = position + 1
                }
                if free { treeKinds[record] = level }
            }
            record = record + 1
        }
        level = level + 1
    }
    record = 0
    while record < treeFunctions.length {
        if treeKinds[record] == 2 || treeKinds[record] == 3 {
            dropCallDepthFrameBetween(output, treeSlots[record * 3], treeSlots[record * 3 + 1], treeSlots[record * 3 + 2])
        }
        record = record + 1
    }
    // One entry per program symbol; a module build runs this for every module.
    recordOf.clear()
}

function parallelRuntimeAllowed(callee: Text): Boolean {
    if callee == "minyar_recovery_pending" || callee == "minyar_stack_leave" { return true }
    if parallelViewRuntime(callee) || runtimeViewReaderAllowed(callee) { return true }
    if callee == "minyar_fail_integer_overflow" || callee == "minyar_fail_integer_division" { return true }
    // Nested parallel for, reductions and join run on the same work-stealing pool.
    if callee == "minyar_parallel_run" || callee == "minyar_parallel_reduce" || callee == "minyar_parallel_join" || callee == "minyar_parallel_window_stop" { return true }
    if callee == "minyar_parallel_parts_disjoint" || callee == "minyar_parallel_span_stop" { return true }
    if callee == "minyar_parallel_no_alias" || callee == "minyar_parallel_bytes_no_overlap" || callee == "minyar_parallel_bytes_list_no_overlap" || callee == "minyar_parallel_record_list_guard" { return true }
    return runtimeMathAllowed(callee)
}

function markerValue(marker: Text, prefix: Text): Text {
    return marker.slice(prefix.length, marker.length - 1)
}

function checkParallelCalls(globals: List<Text>) {
    let callPrefix = "; minyar-parallel-call: "
    let entryPrefix = "; minyar-parallel-entry: "
    let index = 0
    while index < globals.length {
        let marker = globals[index]
        let callee = ""
        let caller = ""
        if marker.length > callPrefix.length && marker.slice(0, callPrefix.length) == callPrefix {
            let pair = markerValue(marker, callPrefix)
            let separator = findCharacter(pair, '|')
            caller = pair.slice(0, separator)
            callee = pair.slice(separator + 1, pair.length)
        }
        if marker.length > entryPrefix.length && marker.slice(0, entryPrefix.length) == entryPrefix {
            callee = markerValue(marker, entryPrefix)
        }
        if callee != "" {
            let parallel = findText(globals, "; minyar-parallel: " + callee + "\n") >= 0
            let machine = findText(globals, "; minyar-machine: " + callee + "\n") >= 0
            if caller == "" && findText(globals, "; minyar-parallel-views: " + callee + "\n") >= 0 {
                failCompiler("parallel function '" + readableDeclarationName(callee) + "' may use only Integer, Float, Boolean and Character values when parallelEntry starts it; borrowed Bytes and Lists need a safe parallel for")
            }
            if !parallel && !(machine && caller != "") {
                if caller == "" {
                    failCompiler("parallelEntry needs a parallel function, and '" + readableDeclarationName(callee) + "' is not one")
                }
                failCompiler("parallel function '" + readableDeclarationName(caller) + "' can only call parallel functions, not '" + readableDeclarationName(callee) + "'")
            }
        }
        index = index + 1
    }
}

// Unlike ordinary parallel code, interrupt contexts admit only a proved scalar
// call graph. Audit the final module and publish separately checked clones.
function finishInterruptContexts(context: CompilerContext, output: List<Text>, globals: List<Text>, roots: List<Integer>, vectors: List<Integer>, origins: List<Integer>) {
    checkDmaOwnership(context)
    let clones = interruptAuditAndClone(context, output, globals, roots, vectors, origins)
    let clone = 0
    while clone < clones.length {
        output.add(clones[clone])
        clone = clone + 1
    }
    let target = "x86_64"
    if compilerKernelTarget() == 2 { target = "arm64" }
    let index = 0
    while index < roots.length {
        output.add("; minyar-interrupt: vector=" + Text(vectors[index]) + " root=" + Text(roots[index]) + " clone=" + interruptCloneName(roots[index]) + " target=" + target + "\n")
        if compilerKernelTarget() == 1 { output.add(x86InterruptEntry(roots[index], vectors[index])) }
        index = index + 1
    }
    if compilerKernelTarget() == 1 && roots.length > 0 { output.add("@minyar_interrupt_counts = external global [48 x i64]\n") }
    if compilerKernelTarget() == 2 && roots.length > 0 { output.add(armInterruptDispatch(roots, vectors)) }
}

// Arm64's GIC entry in os/arch/arm64/head.S counts, rearms the timer and
// sends the EOI itself; it calls this ordinary-ABI dispatcher, when linked,
// for IDs 16..1019 after saving every general register the call may change.
function armInterruptDispatch(roots: List<Integer>, vectors: List<Integer>): Text {
    let code: List<Text> = []
    code.add("define void @minyar_irq_dispatch(i64 %id) noredzone noimplicitfloat" + interruptTargetAttributes() + " {\nentry:\n  switch i64 %id, label %done [")
    let index = 0
    while index < roots.length {
        code.add(" i64 " + Text(vectors[index]) + ", label %vector." + Text(index))
        index = index + 1
    }
    code.add(" ]\n")
    index = 0
    while index < roots.length {
        code.add("vector." + Text(index) + ":\n  call void @" + interruptCloneName(roots[index]) + "(i64 " + Text(vectors[index]) + ")\n  br label %done\n")
        index = index + 1
    }
    code.add("done:\n  ret void\n}\n")
    return joinText(code)
}

// The hardware entry for one bound PIC vector. It replaces the weak stub of the
// same name in os/arch/x86_64/boot/entry.S and keeps its contract: count the
// interrupt, run the checked handler, then acknowledge the slave PIC for
// vectors 40..47 and the master PIC. x86_intrcc saves every register it uses
// and returns with iretq; the backend clears DF before the handler runs.
function x86InterruptEntry(root: Integer, vector: Integer): Text {
    let code: List<Text> = []
    code.add("define x86_intrcc void @irq_" + Text(vector) + "(ptr byval([5 x i64]) align 8 %frame) noredzone noimplicitfloat" + interruptTargetAttributes() + " {\nentry:\n")
    code.add("  %count = getelementptr inbounds [48 x i64], ptr @minyar_interrupt_counts, i64 0, i64 " + Text(vector) + "\n")
    code.add("  %previous = atomicrmw add ptr %count, i64 1 monotonic, align 8\n")
    code.add("  call void @" + interruptCloneName(root) + "(i64 " + Text(vector) + ")\n")
    if vector >= 40 { code.add("  call void asm sideeffect \"outb %al, $$0xA0\", \"{al},~{memory}\"(i8 32)\n") }
    code.add("  call void asm sideeffect \"outb %al, $$0x20\", \"{al},~{memory}\"(i8 32)\n  ret void\n}\n")
    return joinText(code)
}

function appendNativeDeclarations(context: CompilerContext, output: List<Text>, runtimeDeclarations: List<Text>) {
    let libraries: List<Text> = []
    let declarations: List<Text> = []
    let symbols: List<Text> = []
    let runtimeSymbols: List<Text> = []
    let piece = 0
    while piece < runtimeDeclarations.length {
        let declaration = runtimeDeclarations[piece]
        runtimeSymbols.add(declaration.slice(findCharacter(declaration, '@') + 1, findCharacter(declaration, '(')))
        piece = piece + 1
    }
    piece = 0
    let nativeLibraries = context.nativeLibraries
    let nativePrototypes = context.nativePrototypes
    while piece < nativePrototypes.length {
        let library = nativeLibraries[piece]
        let declaration = nativePrototypes[piece]
        let symbol = declaration.slice(findCharacter(declaration, '@') + 1, findCharacter(declaration, '('))
        let existing = findText(symbols, symbol)
        if existing >= 0 && declarations[existing] != declaration {
            failCompiler("native symbol has conflicting function signatures: '" + symbol + "'")
        }
        if findText(libraries, library) < 0 { libraries.add(library) }
        if findText(declarations, declaration) < 0 {
            declarations.add(declaration)
            symbols.add(symbol)
        }
        piece = piece + 1
    }
    piece = 0
    while piece < declarations.length {
        if findText(runtimeSymbols, symbols[piece]) >= 0 {
            failCompiler("native symbol conflicts with a runtime function: '" + symbols[piece] + "'")
        }
        output.add(declarations[piece] + "\n")
        piece = piece + 1
    }
    piece = 0
    while piece < libraries.length {
        output.add("; minyar-native-library: " + libraries[piece] + "\n")
        piece = piece + 1
    }
}
