function finishParallelFunction(output: List<Text>, globals: List<Text>, entrySlot: Integer, bodySlot: Integer, name: Text, references: Boolean, recoverable: Boolean) {
    if references {
        failCompiler("parallel function '" + readableDeclarationName(name) + "' may use only Integer, Float, Boolean and Character values")
    }
    if !recoverable { dropCallDepthFrame(output, entrySlot, bodySlot) }
    let body: List<Text> = []
    let piece = bodySlot
    while piece < output.length {
        let text = output[piece]
        if text == "  call void @minyar_rc_leave()\n" || text == "  call void @minyar_rc_step()\n" {
            output[piece] = ""
        } else {
            body.add(text)
        }
        piece = piece + 1
    }
    recordSafeParallelEffects(output, globals, bodySlot, name)
    let text = joinText(body)
    let position = 0
    while position + 8 < text.length {
        if text[position] == '@' && text.slice(position, position + 8) == "@minyar_" {
            let end = position + 8
            while end < text.length && text[end] != '(' && text[end] != ' ' { end = end + 1 }
            let callee = text.slice(position + 1, end)
            if !parallelRuntimeAllowed(callee) {
                failCompiler("parallel function '" + readableDeclarationName(name) + "' cannot use the runtime ('" + callee + "')")
            }
        }
        if text[position] == '@' && position + 12 < text.length && text.slice(position, position + 12) == "@.minyar.fn." {
            let end = position + 12
            while end < text.length && text[end] != '(' && text[end] != ' ' { end = end + 1 }
            globals.add("; minyar-parallel-call: " + name + "|" + text.slice(position + 12, end) + "\n")
        }
        position = position + 1
    }
}

function dropCallDepthFrame(output: List<Text>, entrySlot: Integer, bodySlot: Integer) {
    let enter = "  call void @minyar_stack_enter()\n"
    let entry = output[entrySlot]
    if entry.length >= enter.length && entry.slice(0, enter.length) == enter {
        output[entrySlot] = entry.slice(enter.length, entry.length)
    }
    let piece = bodySlot
    while piece < output.length {
        if output[piece] == "  call void @minyar_stack_leave()\n" {
            output[piece] = ""
        }
        piece = piece + 1
    }
}

function dropCallDepthFrameBetween(output: List<Text>, entrySlot: Integer, bodySlot: Integer, endSlot: Integer) {
    let enter = "  call void @minyar_stack_enter()\n"
    let entry = output[entrySlot]
    if entry.length >= enter.length && entry.slice(0, enter.length) == enter {
        output[entrySlot] = entry.slice(enter.length, entry.length)
    }
    let piece = bodySlot
    while piece < endSlot {
        if output[piece] == "  call void @minyar_stack_leave()\n" {
            output[piece] = ""
        }
        piece = piece + 1
    }
}

function dropTreeGuards(output: List<Text>, functionCount: Integer, treeFunctions: List<Integer>, treeKinds: List<Integer>, callTargets: List<Integer>, treeCallStarts: List<Integer>, treeCallEnds: List<Integer>, treeSlots: List<Integer>) {
    let recordOf: List<Integer> = []
    let index = 0
    while index < functionCount {
        recordOf.add(-1)
        index = index + 1
    }
    let record = 0
    while record < treeFunctions.length {
        if treeFunctions[record] >= 0 { recordOf[treeFunctions[record]] = record }
        record = record + 1
    }
    let calleeStarts: List<Integer> = []
    let callees: List<Integer> = []
    record = 0
    while record < treeFunctions.length {
        calleeStarts.add(callees.length)
        if treeKinds[record] == 1 {
            let call = treeCallStarts[record]
            let end = treeCallEnds[record]
            while call < end {
                let callee = callTargets[call]
                if callee < 0 || recordOf[callee] < 0 {
                    treeKinds[record] = 9
                    call = end
                } else {
                    callees.add(recordOf[callee])
                }
                call = call + 1
            }
        }
        record = record + 1
    }
    calleeStarts.add(callees.length)
    let level = 2
    while level <= 3 {
        record = 0
        while record < treeFunctions.length {
            if treeKinds[record] == 1 {
                let free = true
                let position = calleeStarts[record]
                while free && position < calleeStarts[record + 1] {
                    let callee = callees[position]
                    if callee == record || treeKinds[callee] == 1 || treeKinds[callee] >= level {
                        free = false
                    }
                    position = position + 1
                }
                if free { treeKinds[record] = level }
            }
            record = record + 1
        }
        level = level + 1
    }
    record = 0
    while record < treeFunctions.length {
        if treeKinds[record] == 2 || treeKinds[record] == 3 {
            dropCallDepthFrameBetween(output, treeSlots[record * 3], treeSlots[record * 3 + 1], treeSlots[record * 3 + 2])
        }
        record = record + 1
    }
}

function parallelRuntimeAllowed(callee: Text): Boolean {
    if callee == "minyar_recovery_pending" || callee == "minyar_stack_leave" { return true }
    if callee == "minyar_fail_integer_overflow" || callee == "minyar_fail_integer_division" { return true }
    return runtimeMathAllowed(callee)
}

function markerValue(marker: Text, prefix: Text): Text {
    return marker.slice(prefix.length, marker.length - 1)
}

function checkParallelCalls(globals: List<Text>) {
    let callPrefix = "; minyar-parallel-call: "
    let entryPrefix = "; minyar-parallel-entry: "
    let index = 0
    while index < globals.length {
        let marker = globals[index]
        let callee = ""
        let caller = ""
        if marker.length > callPrefix.length && marker.slice(0, callPrefix.length) == callPrefix {
            let pair = markerValue(marker, callPrefix)
            let separator = findCharacter(pair, '|')
            caller = pair.slice(0, separator)
            callee = pair.slice(separator + 1, pair.length)
        }
        if marker.length > entryPrefix.length && marker.slice(0, entryPrefix.length) == entryPrefix {
            callee = markerValue(marker, entryPrefix)
        }
        if callee != "" {
            let parallel = findText(globals, "; minyar-parallel: " + callee + "\n") >= 0
            let machine = findText(globals, "; minyar-machine: " + callee + "\n") >= 0
            if !parallel && !(machine && caller != "") {
                if caller == "" {
                    failCompiler("parallelEntry needs a parallel function, and '" + readableDeclarationName(callee) + "' is not one")
                }
                failCompiler("parallel function '" + readableDeclarationName(caller) + "' can only call parallel functions, not '" + readableDeclarationName(callee) + "'")
            }
        }
        index = index + 1
    }
}

// Unlike ordinary parallel code, interrupt contexts admit only a proved scalar
// call graph. Audit the final module and publish separately checked clones.
function finishInterruptContexts(context: CompilerContext, output: List<Text>, globals: List<Text>, roots: List<Integer>, vectors: List<Integer>, origins: List<Integer>) {
    checkDmaOwnership(context)
    let clones = interruptAuditAndClone(context, output, globals, roots, vectors, origins)
    let clone = 0
    while clone < clones.length {
        output.add(clones[clone])
        clone = clone + 1
    }
    let target = "x86_64"
    if compilerKernelTarget() == 2 { target = "arm64" }
    let index = 0
    while index < roots.length {
        output.add("; minyar-interrupt: vector=" + Text(vectors[index]) + " root=" + Text(roots[index]) + " clone=" + interruptCloneName(roots[index]) + " target=" + target + "\n")
        index = index + 1
    }
}

function appendNativeDeclarations(context: CompilerContext, output: List<Text>, runtimeDeclarations: List<Text>) {
    let libraries: List<Text> = []
    let declarations: List<Text> = []
    let symbols: List<Text> = []
    let runtimeSymbols: List<Text> = []
    let piece = 0
    while piece < runtimeDeclarations.length {
        let declaration = runtimeDeclarations[piece]
        runtimeSymbols.add(declaration.slice(findCharacter(declaration, '@') + 1, findCharacter(declaration, '(')))
        piece = piece + 1
    }
    piece = 0
    let nativeLibraries = context.nativeLibraries
    let nativePrototypes = context.nativePrototypes
    while piece < nativePrototypes.length {
        let library = nativeLibraries[piece]
        let declaration = nativePrototypes[piece]
        let symbol = declaration.slice(findCharacter(declaration, '@') + 1, findCharacter(declaration, '('))
        let existing = findText(symbols, symbol)
        if existing >= 0 && declarations[existing] != declaration {
            failCompiler("native symbol has conflicting function signatures: '" + symbol + "'")
        }
        if findText(libraries, library) < 0 { libraries.add(library) }
        if findText(declarations, declaration) < 0 {
            declarations.add(declaration)
            symbols.add(symbol)
        }
        piece = piece + 1
    }
    piece = 0
    while piece < declarations.length {
        if findText(runtimeSymbols, symbols[piece]) >= 0 {
            failCompiler("native symbol conflicts with a runtime function: '" + symbols[piece] + "'")
        }
        output.add(declarations[piece] + "\n")
        piece = piece + 1
    }
    piece = 0
    while piece < libraries.length {
        output.add("; minyar-native-library: " + libraries[piece] + "\n")
        piece = piece + 1
    }
}
