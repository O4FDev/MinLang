// This optional final lowering runs after owner transfers and cycle fixups.
// Each temporary has one initialized-null cell. Walk its control-flow paths
// to the first cleanup on each path, so branches never lose a condition owner
// and unrelated temporaries are not scanned at every statement.
record ScopeOwnershipBody {
    lines: List<Text>
    operations: List<Integer>
    slots: List<Integer>
    values: List<Text>
    targets: List<List<Integer>>
    cleanups: List<List<Integer>>
    producers: List<Integer>
    owners: Integer
    entry: Integer
}

function scopeStarts(text: Text, prefix: Text): Boolean {
    return text.byteLength >= prefix.byteLength && text.slice(0, prefix.byteLength) == prefix
}

function scopeOperation(line: Text): Integer {
    let prefix = "  call void @minyar_rc_"
    if !scopeStarts(line, prefix) { return 0 }
    let end = line.find("(")
    if end < 0 { return 0 }
    let name = line.slice(prefix.length, end)
    if name == "enter" { return 1 }
    if name == "leave" { return 2 }
    if name == "step" { return 3 }
    if name == "keep" { return 4 }
    if name == "borrow" { return 5 }
    if name == "local" { return 6 }
    if name == "local_take" { return 7 }
    if name == "local_move" { return 8 }
    if name == "local_move_owner" { return 9 }
    if name == "borrow_traced" { return 10 }
    if name == "local_traced" { return 11 }
    return 0
}

function scopeBody(lines: List<Text>): ScopeOwnershipBody {
    let body = ScopeOwnershipBody { lines: lines; operations: []; slots: []; values: []; targets: []; cleanups: []; producers: []; owners: 0; entry: -1 }
    let labels: List<Text> = []
    let labelKinds: List<Integer> = []
    let labelLines: List<Integer> = []
    let index = 0
    while index < lines.length {
        let line = lines[index]
        if line.length > 0 && line[0] != ' ' && line[line.length - 1] == ':' {
            labels.add(line.slice(0, line.length - 1))
            labelKinds.add(1)
            labelLines.add(index)
        }
        let operation = scopeOperation(line)
        body.operations.add(operation)
        body.slots.add(-1)
        body.values.add("")
        let targets: List<Integer> = []
        let cleanups: List<Integer> = []
        body.targets.add(targets)
        body.cleanups.add(cleanups)
        if operation == 1 {
            let prefix = "  call void @minyar_rc_enter(i64 "
            body.owners = Integer(line.slice(prefix.length, line.length - 1))
            body.entry = index
        }
        if operation == 4 || operation == 5 || operation == 10 {
            body.slots[index] = body.producers.length
            body.producers.add(index)
            let start = line.find("(ptr ") + 5
            body.values[index] = line.slice(start, line.length - 1)
        }
        if operation >= 6 && operation <= 9 || operation == 11 {
            let start = line.find("(i64 ") + 5
            let end = line.find(", ptr ")
            if end < 0 { end = line.length - 1 }
            body.slots[index] = Integer(line.slice(start, end))
            if end < line.length - 1 { body.values[index] = line.slice(end + 6, line.length - 1) }
        }
        index = index + 1
    }
    let labelLookup = buildDeclarationIndex(labels, labelKinds)
    index = 0
    while index < lines.length {
        let line = lines[index]
        if scopeStarts(line, "  br ") || scopeStarts(line, "  switch ") {
            let last = index + 1
            if scopeStarts(line, "  switch ") {
                while last < lines.length && lines[last - 1].find("]") < 0 { last = last + 1 }
            }
            let cursor = index
            while cursor < last {
                let parts = lines[cursor].split("label %")
                let part = 1
                while part < parts.length {
                    let name = parts[part]
                    let end = 0
                    while end < name.length && name[end] != ',' && name[end] != ' ' && name[end] != ']' { end = end + 1 }
                    let label = findIndexedSymbol(labelLookup, labels, labelKinds, name.slice(0, end), 1)
                    if label < 0 { body.entry = -1 } else { body.targets[index].add(labelLines[label]) }
                    part = part + 1
                }
                cursor = cursor + 1
            }
        }
        index = index + 1
    }
    return body
}

// A plain borrow immediately followed by a lasting owner needs no separate
// temporary count. Keep the local/return retain, including its overflow check.
// No call or control-flow edge can occur before that retaining consumer.
function scopeCoalesceBorrows(body: ScopeOwnershipBody) {
    let index = 0
    while index + 3 < body.lines.length {
        if body.operations[index] == 5 {
            let value = body.values[index]
            let local = body.operations[index + 1] == 6 && body.values[index + 1] == value
            local = local && scopeStarts(body.lines[index + 2], "  store ptr " + value + ", ptr %local.") && body.operations[index + 3] == 3
            let returned = body.lines[index + 1] == "  call void @minyar_rc_retain(ptr " + value + ")" && body.operations[index + 2] == 2
            let result = index + 3
            if body.lines[result] == "  call void @minyar_stack_leave()" { result = result + 1 }
            returned = returned && result < body.lines.length && body.lines[result] == "  ret ptr " + value
            if local || returned {
                body.operations[index] = 12
                if returned {
                    // A return that loses its temporary drop still services
                    // pending cycle/incremental work before unlinking roots.
                    body.operations[index + 2] = 13
                }
            }
        }
        index = index + 1
    }
    let producers: List<Integer> = []
    index = 0
    while index < body.producers.length {
        let producer = body.producers[index]
        if body.operations[producer] != 12 {
            body.slots[producer] = producers.length
            producers.add(producer)
        }
        index = index + 1
    }
    body.producers = producers
}

function scopeCleanupPaths(body: ScopeOwnershipBody): Boolean {
    let visited: List<Integer> = []
    let index = 0
    while index < body.lines.length { visited.add(-1); index = index + 1 }
    let temporary = 0
    while temporary < body.producers.length {
        let producer = body.producers[temporary]
        let pending: List<Integer> = [producer + 1]
        let cursor = 0
        while cursor < pending.length {
            let line = pending[cursor]
            cursor = cursor + 1
            let done = false
            while line < body.lines.length && !done {
                if visited[line] == temporary { done = true } else {
                    visited[line] = temporary
                    let operation = body.operations[line]
                    if line == producer { return false }
                    if operation == 2 || operation == 3 || operation == 13 {
                        body.cleanups[line].add(body.owners + temporary)
                        done = true
                    } else if body.targets[line].length > 0 {
                        let target = 0
                        while target < body.targets[line].length {
                            pending.add(body.targets[line][target])
                            target = target + 1
                        }
                        done = true
                    } else if scopeStarts(body.lines[line], "  ret ") || body.lines[line] == "  unreachable" {
                        done = true
                    }
                    line = line + 1
                }
            }
        }
        temporary = temporary + 1
    }
    return true
}

function scopeCell(slot: Integer): Text {
    return "%rc.scope.slot." + Text(slot)
}

function scopeDrop(output: List<Text>, line: Integer, slot: Integer) {
    let value = "%rc.scope.drop." + Text(line) + "." + Text(slot)
    let cell = scopeCell(slot)
    output.add("  " + value + " = load ptr, ptr " + cell + "\n")
    output.add("  store ptr null, ptr " + cell + "\n")
    output.add("  call void @minyar_rc_scope_release_v1(ptr " + value + ")\n")
}

function lowerScopeBody(lines: List<Text>): Text {
    let body = scopeBody(lines)
    let count = body.owners + body.producers.length
    if body.entry >= 0 && count <= 256 {
        scopeCoalesceBorrows(body)
        count = body.owners + body.producers.length
    }
    if body.entry < 0 || count > 256 || !scopeCleanupPaths(body) {
        let original: List<Text> = []
        let index = 0
        while index < lines.length { original.add(lines[index] + "\n"); index = index + 1 }
        return joinText(original)
    }
    let output: List<Text> = []
    let index = 0
    while index < lines.length {
        let operation = body.operations[index]
        let slot = body.slots[index]
        let value = body.values[index]
        if operation == 0 { output.add(lines[index] + "\n") } else if operation == 1 {
            output.add("  %rc.scope.header = alloca [24 x i8], align 8\n")
            output.add("  %rc.scope.cells = alloca [" + Text(count) + " x ptr], align 8\n")
            let owner = 0
            while owner < count {
                output.add("  " + scopeCell(owner) + " = getelementptr [" + Text(count) + " x ptr], ptr %rc.scope.cells, i64 0, i64 " + Text(owner) + "\n")
                output.add("  store ptr null, ptr " + scopeCell(owner) + "\n")
                owner = owner + 1
            }
            output.add("  call void @minyar_rc_scope_enter_v1(ptr %rc.scope.header, ptr %rc.scope.cells, i64 " + Text(count) + ")\n")
        } else if operation == 2 || operation == 3 || operation == 13 {
            let temporary = body.cleanups[index].length
            while temporary > 0 {
                temporary = temporary - 1
                scopeDrop(output, index, body.cleanups[index][temporary])
            }
            if operation != 3 {
                let owner = 0
                while owner < body.owners { scopeDrop(output, index, owner); owner = owner + 1 }
                if operation == 13 { output.add("  call void @minyar_rc_scope_poll_v1()\n") }
                output.add("  call void @minyar_rc_scope_leave_v1(ptr %rc.scope.header)\n")
            } else { output.add("  call void @minyar_rc_scope_poll_v1()\n") }
        } else if operation == 4 || operation == 5 || operation == 10 {
            if operation != 4 {
                let suffix = ""
                if operation == 10 { suffix = "_traced" }
                output.add("  call void @minyar_rc_retain" + suffix + "(ptr " + value + ")\n")
            }
            output.add("  store ptr " + value + ", ptr " + scopeCell(body.owners + slot) + "\n")
        } else if operation == 8 {
            output.add("  store ptr null, ptr " + scopeCell(slot) + "\n")
        } else if operation == 9 {
            output.add("  call void @minyar_rc_scope_move_v1(ptr " + scopeCell(slot) + ", ptr " + value + ")\n")
        } else if operation != 12 {
            if operation != 7 {
                let suffix = ""
                if operation == 11 { suffix = "_traced" }
                output.add("  call void @minyar_rc_retain" + suffix + "(ptr " + value + ")\n")
            }
            let previous = "%rc.scope.old." + Text(index)
            output.add("  " + previous + " = load ptr, ptr " + scopeCell(slot) + "\n")
            output.add("  store ptr " + value + ", ptr " + scopeCell(slot) + "\n")
            output.add("  call void @minyar_rc_scope_release_v1(ptr " + previous + ")\n")
        }
        index = index + 1
    }
    return joinText(output)
}

function lowerScopeOwnership(llvm: Text): Text {
    let output: List<Text> = []
    let body: List<Text> = []
    let inFunction = false
    let lines = llvm.split("\n")
    let index = 0
    let names = ["enter", "leave", "move", "poll", "release"]
    while index < lines.length {
        let line = lines[index]
        let ending = "\n"
        if index == lines.length - 1 { ending = "" }
        if scopeStarts(line, "declare ") {
            let name = 0
            while name < names.length {
                let symbol = "minyar_rc_scope_" + names[name] + "_v1"
                if line.find("@" + symbol + "(") >= 0 { failCompiler("native symbol conflicts with scope ownership: '" + symbol + "'") }
                name = name + 1
            }
        }
        if scopeStarts(line, "define ") { inFunction = true }
        if inFunction {
            body.add(line + ending)
            if line == "}" {
                // Parsing uses lines without terminators; emission keeps the
                // original pieces for operations that are left unchanged.
                let parsed: List<Text> = []
                let itemIndex = 0
                while itemIndex < body.length {
                    let item = body[itemIndex]
                    if item.length > 0 && item[item.length - 1] == '\n' { parsed.add(item.slice(0, item.length - 1)) } else { parsed.add(item) }
                    itemIndex = itemIndex + 1
                }
                if joinText(body).find("  call void @minyar_rc_enter(") < 0 {
                    output.add(joinText(body))
                } else { output.add(lowerScopeBody(parsed)) }
                let nextBody: List<Text> = []
                body = nextBody
                inFunction = false
            }
        } else { output.add(line + ending) }
        index = index + 1
    }
    output.add("declare void @minyar_rc_scope_enter_v1(ptr, ptr, i64)\n")
    output.add("declare void @minyar_rc_scope_leave_v1(ptr)\n")
    output.add("declare void @minyar_rc_scope_move_v1(ptr, ptr)\n")
    output.add("declare void @minyar_rc_scope_poll_v1()\n")
    output.add("declare void @minyar_rc_scope_release_v1(ptr)\n")
    return joinText(output)
}
