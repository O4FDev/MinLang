function declarationBodyStart(tokenKinds: List<Integer>, tokenTexts: List<Text>, start: Integer, after: Integer): Integer {
    let position = start
    let roundDepth = 0
    let squareDepth = 0
    while position < after && tokenKinds[position] != 0 {
        if tokenKinds[position] == 4 {
            let token = tokenTexts[position]
            if token == "{" && roundDepth == 0 && squareDepth == 0 { return position }
            if token == "(" { roundDepth = roundDepth + 1 }
            if token == ")" { roundDepth = roundDepth - 1 }
            if token == "[" { squareDepth = squareDepth + 1 }
            if token == "]" { squareDepth = squareDepth - 1 }
        }
        position = position + 1
    }
    return position
}

function skipDeclaration(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>) {
    let declaration = cursor[0]
    let position = declarationBodyStart(tokenKinds, tokenTexts, declaration, tokenKinds.length)
    let kind = tokenKinds[position]
    if kind == 0 {
        failAtToken(tokenLines, declaration, "a declaration is missing its '{ ... }' body")
    }
    let opening = position
    position = position + 1
    let depth = 1
    kind = tokenKinds[position]
    while depth > 0 && kind != 0 {
        if kind == 4 {
            let token = tokenTexts[position]
            if token == "{" {
                depth = depth + 1
            }
            if token == "}" {
                depth = depth - 1
            }
        }
        position = position + 1
        kind = tokenKinds[position]
    }
    cursor[0] = position
    if depth > 0 {
        failAtToken(tokenLines, opening, "a declaration is missing its closing '}'")
    }
}

function skipTopLevelStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: List<Integer>) {
    let roundDepth = 0
    let squareDepth = 0
    let curlyDepth = 0
    let position = cursor[0]
    let kind = tokenKinds[position]
    while kind != 0 && !(kind == 6 && roundDepth == 0 && squareDepth == 0 && curlyDepth == 0) {
        if kind == 4 {
            let token = tokenTexts[position]
            if token == "(" {
                roundDepth = roundDepth + 1
            }
            if token == ")" {
                roundDepth = roundDepth - 1
            }
            if token == "[" {
                squareDepth = squareDepth + 1
            }
            if token == "]" {
                squareDepth = squareDepth - 1
            }
            if token == "{" {
                curlyDepth = curlyDepth + 1
            }
            if token == "}" {
                curlyDepth = curlyDepth - 1
            }
        }
        position = position + 1
        kind = tokenKinds[position]
    }
    cursor[0] = position
    skipTerminators(tokenKinds, cursor)
}

function discoverSyntaxSymbols(tree: SyntaxTree, tokenTexts: List<Text>, tokenLines: SourceMap, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>, declarationEnds: List<Integer>) {
    let declaration = 0
    while declaration < tree.declarations.length {
        let node = tree.declarations[declaration]
        let kind = tree.nodes[node].kind
        if kind == 2 || kind == 3 || kind == 4 {
            let name = tokenTexts[tree.nodes[node].start + 1]
            let type = 0
            if kind == 2 {
                if isThreadType(simpleTypeCode(readableDeclarationName(name))) { failCompiler("reserved thread type name") }
                let start = tree.nodes[node].start
                if tokenTexts[start + 2] == "native" && registerLayoutWidth(tokenTexts[start + 3]) > 0 {
                    kind = registerLayoutSymbolKind()
                } else {
                    if symbolNames.length >= 99000 { failCompiler("nominal type index exceeds the supported limit") }
                    type = 1000 + symbolNames.length
                    let token = tree.nodes[node].body + 1
                    let fields = 0
                    let choice = false
                    while token < tree.nodes[node].end {
                        if tokenTexts[token] == ":" { fields = fields + 1 }
                        if resultPrefix(tokenTexts[token], "minyar_choice_tag|") { choice = true }
                        token = token + 1
                    }
                    if choice && fields == 1 { type = 1000000000 + symbolNames.length }
                }
            } else { kind = 3 }
            tokenLines.nominalTypes.add(type)
            symbolNames.add(name)
            symbolKinds.add(kind)
            symbolLocations.add(tokenLocation(tokenLines, tree.nodes[node].start + 1))
            symbolReturnTypes.add(type)
            symbolParameterCounts.add(0)
        }
        declarationEnds.add(tree.nodes[node].end)
        declaration = declaration + 1
    }
}

// Register every nominal symbol first, then freeze finite scalar layouts before
// callback signatures or takeType can capture an ID. Only payload-free enum
// domains seed this pass: nested scalar niches deliberately remain boxed.
function discoverScalarChoiceTypes(tree: SyntaxTree, texts: List<Text>, lines: SourceMap, names: List<Text>, kinds: List<Integer>, returns: List<Integer>) {
    let domains: List<Integer> = []
    let payloads: List<Integer> = []
    let index = 0
    while index < names.length {
        domains.add(-1)
        payloads.add(-1)
        index = index + 1
    }
    let declaration = 0
    while declaration < tree.declarations.length {
        let node = tree.declarations[declaration]
        if tree.nodes[node].kind == 2 {
            let symbol = findIndexedSymbol(lines.symbolLookup, names, kinds, texts[tree.nodes[node].start + 1], 2)
            let token = tree.nodes[node].body + 1
            let fields = 0
            let marker = ""
            let payload = -1
            while token < tree.nodes[node].end {
                if texts[token] == ":" { fields = fields + 1 }
                if resultPrefix(texts[token], "minyar_choice_tag|") { marker = texts[token] }
                if resultPrefix(texts[token], "minyar_choice_payload|") { payload = token }
                token = token + 1
            }
            if marker != "" {
                let cases = marker.split("|")
                if fields == 1 { domains[symbol] = cases.length - 2 }
                if fields == 2 && cases.length == 3 && payload >= 0 {
                    let parts = texts[payload].split("|")
                    // A concrete scalar payload is one normalized type token.
                    if parts.length == 3 && findText(cases, parts[1]) > 0 && texts[payload + 1] == ":" && (texts[payload + 3] == ";" || texts[payload + 3] == "}") {
                        payloads[symbol] = payload + 2
                    }
                }
            }
        }
        declaration = declaration + 1
    }
    index = 0
    while index < names.length {
        if payloads[index] >= 0 {
            let name = texts[payloads[index]]
            let primitive = simpleTypeCode(name)
            let finite = primitive == 4 || primitive == 3
            if primitive == 0 {
                let payload = findIndexedSymbol(lines.symbolLookup, names, kinds, name, 2)
                if payload >= 0 { finite = domains[payload] >= 0 }
            }
            if finite {
                returns[index] = 1000000000 + index
                lines.nominalTypes[index] = returns[index]
            }
        }
        index = index + 1
    }
}

function takeConstant(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLookup: List<Integer>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>) {
    let runtime = tokenIs(tokenKinds, tokenTexts, cursor, "global")
    cursor[0] = cursor[0] + 1
    let name = tokenTexts[cursor[0]]
    let location = cursor[0]
    if tokenKinds[cursor[0]] != 1 {
        failAtToken(tokenLines, location, "expected a name after constant")
    }
    let constant = findIndexedSymbol(symbolLookup, symbolNames, symbolKinds, name, 3)
    cursor[0] = cursor[0] + 1
    let declared = 0
    if tokenIs(tokenKinds, tokenTexts, cursor, ":") {
        cursor[0] = cursor[0] + 1
        declared = takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "=")
    let valueStart = cursor[0]
    if !runtime && tokenKinds[valueStart] == 4 && tokenTexts[valueStart] == "[" {
        if declared != 0 { failAtToken(tokenLines, location, "a compile-time table has no type annotation; use global NAME: List<Integer> for a mutable List") }
        // Integer is private dispatch metadata, never a first-class table value.
        symbolReturnTypes[constant] = 1
        symbolParameterCounts[constant] = valueStart
        skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
        return
    }
    let literal = cursor[0]
    if tokenIs(tokenKinds, tokenTexts, cursor, "-") {
        literal = literal + 1
    }
    let kind = tokenKinds[literal]
    let type = 0
    if kind == 2 { type = 1 }
    if kind == 7 { type = 7 }
    if literal == valueStart {
        if kind == 3 { type = 2 }
        if kind == 5 { type = 3 }
        if kind == 1 && (tokenTexts[literal] == "true" || tokenTexts[literal] == "false") { type = 4 }
    }
    if type == 0 || (tokenKinds[literal + 1] != 6 && tokenKinds[literal + 1] != 0) {
        if !runtime {
            failAtToken(tokenLines, location, "a module constant needs a literal initializer; use global NAME: Type = expression for runtime initialization")
        }
        if declared == 0 {
            failAtToken(tokenLines, location, "a nonliteral global needs a type annotation, such as global TABLE: List<Integer> = makeTable()")
        }
        symbolReturnTypes[constant] = declared
        symbolParameterCounts[constant] = -1 - valueStart
        skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
        return
    }
    if declared != 0 && declared != type {
        failAtToken(tokenLines, location, "the value for constant '" + readableDeclarationName(name) + "' is " + describeType(type) + ", not " + describeType(declared))
    }
    if type == 1 {
        checkedIntegerLiteral(tokenTexts[literal], literal != valueStart, tokenLines, literal)
    }
    if type == 7 {
        checkedFloatLiteral(tokenTexts[literal], tokenLines, literal)
    }
    symbolReturnTypes[constant] = type
    symbolParameterCounts[constant] = valueStart
    cursor[0] = literal + 1
}

function discoverDeclarations(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolLookup: List<Integer>, symbolParameterCounts: List<Integer>, symbolParameterNames: List<Text>, symbolParameterTypes: List<Integer>, parameterStarts: List<Integer>, declarationEnds: List<Integer>) {
    let cursor: List<Integer> = [0]
    let declaration = 0
    skipTerminators(tokenKinds, cursor)
    while tokenKinds[cursor[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, cursor, "constant") || tokenIs(tokenKinds, tokenTexts, cursor, "global") {
            declaration = declaration + 1
            takeConstant(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds, symbolLookup, symbolReturnTypes, symbolParameterCounts)
        } else {
        if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
            declaration = declaration + 1
            let registerWidth = registerLayoutWidthAt(tokenKinds, tokenTexts, cursor[0])
            cursor[0] = cursor[0] + 1
            if tokenKinds[cursor[0]] != 1 {
                failAtToken(tokenLines, cursor[0], "expected a name after record")
            }
            let recordKind = 2
            if registerWidth > 0 { recordKind = registerLayoutSymbolKind() }
            let record = findIndexedSymbol(symbolLookup, symbolNames, symbolKinds, tokenTexts[cursor[0]], recordKind)
            cursor[0] = cursor[0] + 1
            let cLayout = false
            let dmaLayout = false
            let completionLayout = false
            if tokenIs(tokenKinds, tokenTexts, cursor, "native") {
                cursor[0] = cursor[0] + 1
                dmaLayout = dmaMarkerKind(tokenTexts[cursor[0]]) > 0
                completionLayout = dmaMarkerKind(tokenTexts[cursor[0]]) == 4
                if tokenKinds[cursor[0]] != 3 || (registerWidth == 0 && !dmaLayout && tokenTexts[cursor[0]] != "c" && tokenTexts[cursor[0]] != "c_packed") { failCompiler("record native layout must be c, c_packed, register8/16/32/64, or an opaque DMA handle") }
                cLayout = registerWidth == 0 && !dmaLayout
                cursor[0] = cursor[0] + 1
            }
            expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "{")
            skipTerminators(tokenKinds, cursor)
            let count = 0
            let first = symbolParameterNames.length
            parameterStarts[record] = first
            while !tokenIs(tokenKinds, tokenTexts, cursor, "}") {
                let visibility = ""
                if tokenTexts[cursor[0]] == "private" && tokenKinds[cursor[0]] == 1 && tokenKinds[cursor[0] + 1] == 1 {
                    visibility = " " + tokenPath(tokenLines, cursor[0])
                    cursor[0] = cursor[0] + 1
                }
                if tokenKinds[cursor[0]] != 1 {
                    failAtToken(tokenLines, cursor[0], "expected a record field name")
                }
                let fieldName = tokenTexts[cursor[0]]
                let previous = 0
                let duplicate = false
                while previous < count {
                    if isFieldNamed(symbolParameterNames[first + previous], fieldName) {
                        duplicate = true
                    }
                    previous = previous + 1
                }
                if duplicate {
                    failAtToken(tokenLines, cursor[0], "record '" + symbolNames[record] + "' declares '" + fieldName + "' twice")
                }
                symbolParameterNames.add(fieldName + visibility)
                cursor[0] = cursor[0] + 1
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ":")
                if cLayout { symbolParameterTypes.add(takeCValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)) } else {
                    if resultPrefix(symbolNames[record], "minyar_result_type_") && fieldName == "value" {
                        symbolParameterTypes.add(takeType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds))
                    } else {
                        symbolParameterTypes.add(takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds))
                    }
                }
                if registerWidth > 0 {
                    if symbolParameterTypes[symbolParameterTypes.length - 1] != 1 { failAtToken(tokenLines, cursor[0], "register fields need Integer values") }
                    skipRegisterFieldAnnotation(tokenKinds, tokenTexts, tokenLines, cursor)
                }
                count = count + 1
                if tokenIs(tokenKinds, tokenTexts, cursor, ",") {
                    cursor[0] = cursor[0] + 1
                }
                skipTerminators(tokenKinds, cursor)
            }
            symbolParameterCounts[record] = count
            if dmaLayout && count != 0 {
                if completionLayout { failAtToken(tokenLines, cursor[0], "opaque protocol completion declarations must have no fields") }
                failAtToken(tokenLines, cursor[0], "opaque DMA handle declarations must have no fields")
            }
            if registerWidth > 0 && count == 0 { failAtToken(tokenLines, cursor[0], "register layouts need at least one field") }
            cursor[0] = cursor[0] + 1
        } else {
            if tokenIs(tokenKinds, tokenTexts, cursor, "function") {
                let interruptFunction = isInterruptFunctionAt(tokenKinds, tokenTexts, cursor[0])
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "function")
                if tokenKinds[cursor[0]] != 1 {
                    failAtToken(tokenLines, cursor[0], "expected a name after function")
                }
                let functionName = tokenTexts[cursor[0]]
                if isBuiltinName(readableDeclarationName(functionName)) || (tokenLines.features / 32 % 2 != 0 && isCLayoutBuiltin(readableDeclarationName(functionName))) {
                    let reserved = readableDeclarationName(functionName)
                    failAtToken(tokenLines, cursor[0], "function '" + reserved + "' uses a reserved built-in name; rename this function (for example, '" + reserved + "Local'); see Reserved function names in docs/language.md")
                }
                symbolNames.add(functionName)
                symbolKinds.add(1)
                symbolLocations.add(tokenLocation(tokenLines, cursor[0]))
                parameterStarts.add(symbolParameterNames.length)
                cursor[0] = cursor[0] + 1
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "(")

                let parameterCount = 0
                let firstParameter = symbolParameterNames.length
                while !tokenIs(tokenKinds, tokenTexts, cursor, ")") {
                    if tokenKinds[cursor[0]] != 1 {
                        failAtToken(tokenLines, cursor[0], "expected a parameter name")
                    }
                    let parameterName = tokenTexts[cursor[0]]
                    let previous = firstParameter
                    while previous < symbolParameterNames.length {
                        if symbolParameterNames[previous] == parameterName {
                            failAtToken(tokenLines, cursor[0], "function '" + readableDeclarationName(functionName) + "' declares parameter '" + parameterName + "' twice")
                        }
                        previous = previous + 1
                    }
                    symbolParameterNames.add(parameterName)
                    cursor[0] = cursor[0] + 1
                    expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ":")
                    symbolParameterTypes.add(takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds))
                    parameterCount = parameterCount + 1
                    if tokenIs(tokenKinds, tokenTexts, cursor, ",") {
                        cursor[0] = cursor[0] + 1
                    }
                }
                symbolParameterCounts.add(parameterCount)
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ")")

                let returnType = 5
                if functionName == "main" {
                    returnType = 1
                }
                if tokenIs(tokenKinds, tokenTexts, cursor, ":") {
                    cursor[0] = cursor[0] + 1
                    returnType = takeType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
                }
                if functionName == "main" {
                    if parameterCount != 0 {
                        failCompiler("main expects no parameters; use process.argument() to read program arguments")
                    }
                    if returnType != 1 {
                        failCompiler("main must return Integer")
                    }
                }
                symbolReturnTypes.add(returnType)

                if interruptFunction { skipInterruptBinding(tokenKinds, tokenTexts, tokenLines, cursor) }
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "{")
                cursor[0] = declarationEnds[declaration]
                declaration = declaration + 1
            } else {
                skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            }
        }
        }
        skipTerminators(tokenKinds, cursor)
    }
}
