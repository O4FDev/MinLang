function skipDeclaration(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: List<Integer>) {
    let position = cursor[0]
    let kind = tokenKinds[position]
    while kind != 0 && !(kind == 4 && tokenTexts[position] == "{") {
        position = position + 1
        kind = tokenKinds[position]
    }
    if kind == 0 {
        fail("a declaration is missing its '{ ... }' body")
    }
    position = position + 1
    let depth = 1
    kind = tokenKinds[position]
    while depth > 0 && kind != 0 {
        if kind == 4 {
            let token = tokenTexts[position]
            if token == "{" {
                depth = depth + 1
            }
            if token == "}" {
                depth = depth - 1
            }
        }
        position = position + 1
        kind = tokenKinds[position]
    }
    cursor[0] = position
    if depth > 0 {
        fail("a declaration is missing its closing '}'")
    }
}

function skipTopLevelStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: List<Integer>) {
    let roundDepth = 0
    let squareDepth = 0
    let curlyDepth = 0
    let position = cursor[0]
    let kind = tokenKinds[position]
    while kind != 0 && !(kind == 6 && roundDepth == 0 && squareDepth == 0 && curlyDepth == 0) {
        if kind == 4 {
            let token = tokenTexts[position]
            if token == "(" {
                roundDepth = roundDepth + 1
            }
            if token == ")" {
                roundDepth = roundDepth - 1
            }
            if token == "[" {
                squareDepth = squareDepth + 1
            }
            if token == "]" {
                squareDepth = squareDepth - 1
            }
            if token == "{" {
                curlyDepth = curlyDepth + 1
            }
            if token == "}" {
                curlyDepth = curlyDepth - 1
            }
        }
        position = position + 1
        kind = tokenKinds[position]
    }
    cursor[0] = position
    skipTerminators(tokenKinds, cursor)
}

function discoverRecordNames(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>, declarationEnds: List<Integer>): Boolean {
    let cursor: List<Integer> = [0]
    let topLevelStatements = false
    skipTerminators(tokenKinds, cursor)
    while tokenKinds[cursor[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
            let name = tokenTexts[cursor[0] + 1]
            if isThreadType(simpleTypeCode(readableDeclarationName(name))) { fail("reserved thread type name") }
            let index = symbolNames.length
            symbolNames.add(name)
            symbolKinds.add(2)
            symbolLocations.add(tokenLocation(tokenLines, cursor[0] + 1))
            symbolReturnTypes.add(1000 + index)
            symbolParameterCounts.add(0)
        }
        if tokenIs(tokenKinds, tokenTexts, cursor, "constant") {
            addConstantSymbol(tokenTexts, tokenLines, cursor[0], symbolNames, symbolKinds, symbolLocations, symbolReturnTypes, symbolParameterCounts)
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            declarationEnds.add(cursor[0])
        } else {
        if tokenIs(tokenKinds, tokenTexts, cursor, "record") || tokenIs(tokenKinds, tokenTexts, cursor, "function") {
            skipDeclaration(tokenKinds, tokenTexts, cursor)
            declarationEnds.add(cursor[0])
        } else {
            topLevelStatements = true
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
        }
        }
        skipTerminators(tokenKinds, cursor)
    }
    return topLevelStatements
}

function recordScannedDeclarations(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, scannedStarts: List<Integer>, scannedEnds: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>, declarationEnds: List<Integer>): Boolean {
    let topLevelStatements = false
    let scanned = 0
    let declaration = 0
    let cursor: List<Integer> = [0]
    while scanned < scannedStarts.length {
        let start = scannedStarts[scanned]
        if start < 0 {
            topLevelStatements = true
        } else {
            cursor[0] = start
            if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
                let name = tokenTexts[start + 1]
                if isThreadType(simpleTypeCode(readableDeclarationName(name))) { fail("reserved thread type name") }
                let index = symbolNames.length
                symbolNames.add(name)
                symbolKinds.add(2)
                symbolLocations.add(tokenLocation(tokenLines, start + 1))
                symbolReturnTypes.add(1000 + index)
                symbolParameterCounts.add(0)
            }
            if tokenIs(tokenKinds, tokenTexts, cursor, "constant") {
                addConstantSymbol(tokenTexts, tokenLines, start, symbolNames, symbolKinds, symbolLocations, symbolReturnTypes, symbolParameterCounts)
            }
            declarationEnds.add(scannedEnds[declaration])
            declaration = declaration + 1
        }
        scanned = scanned + 1
    }
    return topLevelStatements
}

function addConstantSymbol(tokenTexts: List<Text>, tokenLines: SourceMap, start: Integer, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>) {
    symbolNames.add(tokenTexts[start + 1])
    symbolKinds.add(3)
    symbolLocations.add(tokenLocation(tokenLines, start + 1))
    symbolReturnTypes.add(0)
    symbolParameterCounts.add(0)
}

function takeConstant(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLookup: List<Integer>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>) {
    expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "constant")
    let name = tokenTexts[cursor[0]]
    let location = cursor[0]
    if tokenKinds[cursor[0]] != 1 {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": expected a name after constant")
    }
    let constant = findIndexedSymbol(symbolLookup, symbolNames, symbolKinds, name, 3)
    cursor[0] = cursor[0] + 1
    let declared = 0
    if tokenIs(tokenKinds, tokenTexts, cursor, ":") {
        cursor[0] = cursor[0] + 1
        declared = takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "=")
    let valueStart = cursor[0]
    let literal = cursor[0]
    if tokenIs(tokenKinds, tokenTexts, cursor, "-") {
        literal = literal + 1
    }
    let kind = tokenKinds[literal]
    let type = 0
    if kind == 2 { type = 1 }
    if kind == 7 { type = 7 }
    if literal == valueStart {
        if kind == 3 { type = 2 }
        if kind == 5 { type = 3 }
        if kind == 1 && (tokenTexts[literal] == "true" || tokenTexts[literal] == "false") { type = 4 }
    }
    if type == 0 || (tokenKinds[literal + 1] != 6 && tokenKinds[literal + 1] != 0) {
        if declared == 0 {
            fail(describeLocation(tokenLocation(tokenLines, location)) + ": a nonliteral constant needs a type annotation, such as constant TABLE: List<Integer> = makeTable()")
        }
        symbolReturnTypes[constant] = declared
        symbolParameterCounts[constant] = -1 - valueStart
        skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
        return
    }
    if declared != 0 && declared != type {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": the value for constant '" + readableDeclarationName(name) + "' is " + describeType(type) + ", not " + describeType(declared))
    }
    if type == 1 {
        checkedIntegerLiteral(tokenTexts[literal], literal != valueStart, tokenLines, literal)
    }
    if type == 7 {
        checkedFloatLiteral(tokenTexts[literal], tokenLines, literal)
    }
    symbolReturnTypes[constant] = type
    symbolParameterCounts[constant] = valueStart
    cursor[0] = literal + 1
}

function discoverDeclarations(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolLookup: List<Integer>, symbolParameterCounts: List<Integer>, symbolParameterNames: List<Text>, symbolParameterTypes: List<Integer>, parameterStarts: List<Integer>, declarationEnds: List<Integer>) {
    let cursor: List<Integer> = [0]
    let declaration = 0
    skipTerminators(tokenKinds, cursor)
    while tokenKinds[cursor[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, cursor, "constant") {
            declaration = declaration + 1
            takeConstant(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds, symbolLookup, symbolReturnTypes, symbolParameterCounts)
        } else {
        if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
            declaration = declaration + 1
            cursor[0] = cursor[0] + 1
            if tokenKinds[cursor[0]] != 1 {
                fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": expected a name after record")
            }
            let record = findIndexedSymbol(symbolLookup, symbolNames, symbolKinds, tokenTexts[cursor[0]], 2)
            cursor[0] = cursor[0] + 1
            expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "{")
            skipTerminators(tokenKinds, cursor)
            let count = 0
            let first = symbolParameterNames.length
            parameterStarts[record] = first
            while !tokenIs(tokenKinds, tokenTexts, cursor, "}") {
                let visibility = ""
                if tokenTexts[cursor[0]] == "private" && tokenKinds[cursor[0]] == 1 && tokenKinds[cursor[0] + 1] == 1 {
                    visibility = " " + tokenPath(tokenLines, cursor[0])
                    cursor[0] = cursor[0] + 1
                }
                if tokenKinds[cursor[0]] != 1 {
                    fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": expected a record field name")
                }
                let fieldName = tokenTexts[cursor[0]]
                let previous = 0
                let duplicate = false
                while previous < count {
                    if isFieldNamed(symbolParameterNames[first + previous], fieldName) {
                        duplicate = true
                    }
                    previous = previous + 1
                }
                if duplicate {
                    fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": record '" + symbolNames[record] + "' declares '" + fieldName + "' twice")
                }
                symbolParameterNames.add(fieldName + visibility)
                cursor[0] = cursor[0] + 1
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ":")
                symbolParameterTypes.add(takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds))
                count = count + 1
                if tokenIs(tokenKinds, tokenTexts, cursor, ",") {
                    cursor[0] = cursor[0] + 1
                }
                skipTerminators(tokenKinds, cursor)
            }
            symbolParameterCounts[record] = count
            cursor[0] = cursor[0] + 1
        } else {
            if tokenIs(tokenKinds, tokenTexts, cursor, "function") {
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "function")
                if tokenKinds[cursor[0]] != 1 {
                    fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": expected a name after function")
                }
                let functionName = tokenTexts[cursor[0]]
                if isBuiltinName(readableDeclarationName(functionName)) {
                    let reserved = readableDeclarationName(functionName)
                    fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": function '" + reserved + "' uses a reserved built-in name; rename this function (for example, '" + reserved + "Local'); see Reserved function names in docs/language.md")
                }
                symbolNames.add(functionName)
                symbolKinds.add(1)
                symbolLocations.add(tokenLocation(tokenLines, cursor[0]))
                parameterStarts.add(symbolParameterNames.length)
                cursor[0] = cursor[0] + 1
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "(")

                let parameterCount = 0
                let firstParameter = symbolParameterNames.length
                while !tokenIs(tokenKinds, tokenTexts, cursor, ")") {
                    if tokenKinds[cursor[0]] != 1 {
                        fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": expected a parameter name")
                    }
                    let parameterName = tokenTexts[cursor[0]]
                    let previous = firstParameter
                    while previous < symbolParameterNames.length {
                        if symbolParameterNames[previous] == parameterName {
                            fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": function '" + readableDeclarationName(functionName) + "' declares parameter '" + parameterName + "' twice")
                        }
                        previous = previous + 1
                    }
                    symbolParameterNames.add(parameterName)
                    cursor[0] = cursor[0] + 1
                    expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ":")
                    symbolParameterTypes.add(takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds))
                    parameterCount = parameterCount + 1
                    if tokenIs(tokenKinds, tokenTexts, cursor, ",") {
                        cursor[0] = cursor[0] + 1
                    }
                }
                symbolParameterCounts.add(parameterCount)
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ")")

                let returnType = 5
                if functionName == "main" {
                    returnType = 1
                }
                if tokenIs(tokenKinds, tokenTexts, cursor, ":") {
                    cursor[0] = cursor[0] + 1
                    returnType = takeType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
                }
                if functionName == "main" {
                    if parameterCount != 0 {
                        fail("main expects no parameters; use argument() to read program arguments")
                    }
                    if returnType != 1 {
                        fail("main must return Integer")
                    }
                }
                symbolReturnTypes.add(returnType)

                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "{")
                cursor[0] = declarationEnds[declaration]
                declaration = declaration + 1
            } else {
                skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            }
        }
        }
        skipTerminators(tokenKinds, cursor)
    }
}
