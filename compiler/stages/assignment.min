function nextLocal(state: List<Integer>): Integer {
    let id = state[4]
    state[4] = id + 1
    return id
}

function isAssignmentOperator(token: Text): Boolean {
    return token == "=" || token == "+=" || token == "-=" || token == "*=" || token == "/=" || token == "%="
}

// Decide from this assignment's statement prefix, rather than carrying a
// declaration flag across arbitrary identifiers named `let` in expressions.
function loopAssignmentDeclaresLocal(tokenKinds: List<Integer>, tokenTexts: List<Text>, position: Integer): Boolean {
    let start = position - 1
    while start > 0 && tokenKinds[start - 1] != 6 && !(tokenKinds[start - 1] == 4 && (tokenTexts[start - 1] == "{" || tokenTexts[start - 1] == "}")) {
        start = start - 1
    }
    return tokenKinds[start] == 1 && tokenTexts[start] == "let"
}

// A parallel function uses only scalars and read-only borrowed buffers and
// never calls the runtime's ownership operations, so a call to one cannot
// release a managed object or create cleanup debt.
function noteParallelFunctions(context: CompilerContext) {
    let borrows = context.valueBorrows
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    while borrows.parallelFunctions.length < context.functionNames.length { borrows.parallelFunctions.add(false) }
    let scan = 0
    while scan + 3 < tokenKinds.length {
        if tokenKinds[scan] == 6 && tokenTexts[scan] == "parallel" {
            let name = scan + 2
            if tokenTexts[scan + 1] == "public" { name = scan + 3 }
            if tokenTexts[name - 1] == "function" && tokenKinds[name] == 1 {
                let index = findFunction(context.functionNames, context.symbolKinds, context.tokenLines.symbolLookup, tokenTexts[name])
                if index >= 0 && index < context.functionIRNames.length {
                    borrows.parallelFunctions[index] = true
                    borrows.parallelCallees.add("@" + context.functionIRNames[index] + "(")
                }
            }
        }
        scan = scan + 1
    }
}

function parallelCallee(context: CompilerContext, callee: Text): Boolean {
    let callees = context.valueBorrows.parallelCallees
    let index = 0
    while index < callees.length {
        if callee.startsWith(callees[index]) { return true }
        index = index + 1
    }
    return false
}

// Whether a call target other than a parallel function was recorded since.
function userCallsSince(context: CompilerContext, calls: Integer): Boolean {
    let parallel = context.valueBorrows.parallelFunctions
    let index = calls
    while index < context.callTargets.length {
        let target = context.callTargets[index]
        if target < 0 || target >= parallel.length || !parallel[target] { return true }
        index = index + 1
    }
    return false
}

// Checked accessors and arithmetic helpers whose only runtime call stops the
// program; none allocates, releases or runs user code.
function pureLoopCallee(callee: Text): Boolean {
    if callee.startsWith("@llvm.") || callee.startsWith("@.minyar.bytes.get.") || callee.startsWith("@.minyar.bytes.set.") || callee.startsWith("@.minyar.integer.") || callee.startsWith("@.minyar.clamp.") { return true }
    return callee.startsWith("@.minyar.list.get.checked(") || callee.startsWith("@.minyar.list.set.scalar.checked(") || callee.startsWith("@.minyar.list.length(") || callee.startsWith("@.minyar.record.get(") || callee.startsWith("@.minyar.record.set.scalar(") || callee.startsWith("@.minyar.bytes.length(") || callee.startsWith("@.minyar.character.checked(") || callee.startsWith("@.minyar.float.integer.checked(") || callee.startsWith("@.minyar.shift.checked(")
}

// Loop code that calls only those helpers cannot release, allocate or run
// user code, so it creates no cleanup debt.
function pureLoopCode(context: CompilerContext, output: List<Text>, start: Integer, end: Integer): Boolean {
    // One call can span several output pieces, so scan the joined code. Large
    // bodies are not candidates, keeping deeply nested loops linear.
    if end - start > 2000 { return false }
    let pieces: List<Text> = []
    let index = start
    while index < end {
        pieces.add(output[index])
        index = index + 1
    }
    let rest = joinText(pieces)
    if rest.find("invoke ") >= 0 { return false }
    let call = rest.find("call ")
    while call >= 0 {
        rest = rest.slice(call + 5, rest.length)
        // Return types contain no @ or %, so the first one names the callee;
        // an indirect call through % may run any code.
        let at = rest.find("@")
        let indirect = rest.find("%")
        if at < 0 || (indirect >= 0 && indirect < at) || !(pureLoopCallee(rest.slice(at, rest.length)) || parallelCallee(context, rest.slice(at, rest.length))) { return false }
        call = rest.find("call ")
    }
    return true
}

// A pure loop cannot add cleanup debt, so when the runtime is idle at entry
// its service points have nothing to do: run every remaining iteration as one
// call-free inner loop, which lets LLVM hoist invariant List and record loads.
// Otherwise each iteration is its own strip, serviced exactly as before. The
// service and idle pieces stay separate so a frame-free function can drop them.
function versionPureLoop(output: List<Text>, entryPiece: Integer, testPiece: Integer, stepPiece: Integer, loopLabel: Integer, bodyLabel: Integer, endLabel: Integer, strip: Integer, continuing: Text, position: Text) {
    let loop = Text(loopLabel)
    let slot = "ptr %local." + Text(strip)
    output[entryPiece] = "  %loop.idle." + loop + " = call i1 @minyar_rc_idle()\n"
    output[entryPiece + 1] = "  %loop.strip." + loop + " = select i1 %loop.idle." + loop + ", i64 9223372036854775807, i64 -9223372036854775808\n  store i64 %loop.strip." + loop + ", " + slot + "\n  br label %for.outer." + loop + "\n\nfor.outer." + loop + ":\n"
    output[testPiece] = "  br i1 " + continuing + ", label %for.strip." + loop + ", label %for.end." + Text(endLabel) + "\n\nfor.strip." + loop + ":\n  %loop.limit." + loop + " = load i64, " + slot + "\n  %loop.within." + loop + " = icmp slt i64 " + position + ", %loop.limit." + loop + "\n  br i1 %loop.within." + loop + ", label %for.body." + Text(bodyLabel) + ", label %for.service." + loop + "\n\nfor.service." + loop + ":\n"
    output[testPiece + 1] = "  call void @minyar_rc_step()\n"
    output[testPiece + 2] = "  %loop.again." + loop + " = call i1 @minyar_rc_idle()\n"
    output[testPiece + 3] = "  %loop.following." + loop + " = add nsw i64 " + position + ", 1\n  %loop.renewed." + loop + " = select i1 %loop.again." + loop + ", i64 9223372036854775807, i64 %loop.following." + loop + "\n  store i64 %loop.renewed." + loop + ", " + slot + "\n  br label %for.outer." + loop + "\n\nfor.body." + Text(bodyLabel) + ":\n"
    output[stepPiece] = ""
}

// The same for a while loop, whose strips count iterations in a local at the
// top of the body. After a service the condition is evaluated again (it is
// pure), which counts one more pass, so the next strip ends two counts later.
function versionPureWhile(output: List<Text>, entryPiece: Integer, branchPiece: Integer, stepPiece: Integer, conditionLabel: Integer, bodyLabel: Integer, endLabel: Integer, first: Integer, condition: Text) {
    let loop = Text(conditionLabel)
    let counter = "ptr %local." + Text(first)
    let slot = "ptr %local." + Text(first + 1)
    output[entryPiece] = "  %loop.idle." + loop + " = call i1 @minyar_rc_idle()\n"
    output[entryPiece + 1] = "  %loop.strip." + loop + " = select i1 %loop.idle." + loop + ", i64 9223372036854775807, i64 -9223372036854775808\n  store i64 %loop.strip." + loop + ", " + slot + "\n  store i64 0, " + counter + "\n  br label %while.outer." + loop + "\n\nwhile.outer." + loop + ":\n"
    output[branchPiece] = "  br i1 " + condition + ", label %while.strip." + loop + ", label %while.end." + Text(endLabel) + "\n\nwhile.strip." + loop + ":\n  %loop.count." + loop + " = load i64, " + counter + "\n  %loop.counted." + loop + " = add i64 %loop.count." + loop + ", 1\n  store i64 %loop.counted." + loop + ", " + counter + "\n  %loop.limit." + loop + " = load i64, " + slot + "\n  %loop.within." + loop + " = icmp slt i64 %loop.count." + loop + ", %loop.limit." + loop + "\n  br i1 %loop.within." + loop + ", label %while.body." + Text(bodyLabel) + ", label %while.service." + loop + "\n\nwhile.service." + loop + ":\n"
    output[branchPiece + 1] = "  call void @minyar_rc_step()\n"
    output[branchPiece + 2] = "  %loop.again." + loop + " = call i1 @minyar_rc_idle()\n"
    output[branchPiece + 3] = "  %loop.following." + loop + " = add i64 %loop.count." + loop + ", 2\n  %loop.renewed." + loop + " = select i1 %loop.again." + loop + ", i64 9223372036854775807, i64 %loop.following." + loop + "\n  store i64 %loop.renewed." + loop + ", " + slot + "\n  br label %while.outer." + loop + "\n"
    output[stepPiece] = ""
}

// A frame-free function has no cleanup to service: its pure loops always take
// the call-free inner loop.
function settleIdleQueries(output: List<Text>, start: Integer) {
    settleIdleQueriesIn(output, start, output.length)
}

function settleIdleQueriesIn(output: List<Text>, start: Integer, end: Integer) {
    let query = "call i1 @minyar_rc_idle()\n"
    let compare = " = icmp slt i64 %loop.count."
    let index = start
    while index < end {
        let text = output[index]
        if text.startsWith("  %loop.") && text.endsWith(query) { output[index] = text.slice(0, text.length - query.length) + "or i1 true, true\n" }
        // A while strip compares a counter LLVM cannot bound; make it constant
        // so the counter is dead.
        let found = text.find(compare)
        if found >= 0 {
            let rest = text.slice(found, text.length)
            output[index] = text.slice(0, found) + " = or i1 true, true" + rest.slice(rest.find("\n"), rest.length)
        }
        index = index + 1
    }
}

// A field or element store such as `totals[key] += 1` or `row.count = 0`.
function loopAssignmentHasPath(tokenKinds: List<Integer>, tokenTexts: List<Text>, position: Integer): Boolean {
    let start = position - 1
    while start > 0 && tokenKinds[start - 1] != 6 && !(tokenKinds[start - 1] == 4 && (tokenTexts[start - 1] == "{" || tokenTexts[start - 1] == "}")) {
        start = start - 1
    }
    return tokenKinds[start] == 1 && assignmentOperatorPosition(tokenKinds, tokenTexts, start) == position
}

// Runtime operations that run no user code and never release a List slot, so
// a walked List keeps every element. Leaving the frame ends every use of a
// borrowed value; a returned one is retained before the frame is left. With `containers`, also exclude stores
// that can release a record field or Map value, which may hold a borrowed
// source such as a parameter.
function loopBodyCallee(callee: Text, containers: Boolean): Boolean {
    if pureLoopCallee(callee) || callee.startsWith("@.minyar.list.set.scalar.checked(") || callee.startsWith("@.minyar.record.") { return true }
    if callee.startsWith("@minyar_rc_keep(") || callee.startsWith("@minyar_rc_borrow(") || callee.startsWith("@minyar_rc_borrow_traced(") || callee.startsWith("@minyar_rc_step(") || callee.startsWith("@minyar_rc_idle(") || callee.startsWith("@minyar_rc_leave(") || callee.startsWith("@minyar_rc_leave_stack_v1(") || callee.startsWith("@minyar_stack_leave(") || callee.startsWith("@minyar_rc_retain(") || callee.startsWith("@minyar_rc_retain_traced(") { return true }
    if callee.startsWith("@minyar_rc_local(") || callee.startsWith("@minyar_rc_local_traced(") || callee.startsWith("@minyar_rc_local_take(") || callee.startsWith("@minyar_rc_local_move(") || callee.startsWith("@minyar_rc_local_move_owner(") { return true }
    if callee.startsWith("@minyar_text_") || callee.startsWith("@minyar_texts_are_equal(") || callee.startsWith("@minyar_join_text") || callee.startsWith("@minyar_interpolate(") || callee.startsWith("@minyar_print_") || callee.startsWith("@minyar_bytes_") { return true }
    if callee.startsWith("@minyar_integer_text(") || callee.startsWith("@minyar_float_text(") || callee.startsWith("@minyar_character_text(") || callee.startsWith("@minyar_boolean_text(") || callee.startsWith("@minyar_integer_character(") || callee.startsWith("@minyar_float_integer(") { return true }
    if callee.startsWith("@minyar_compare_slots(") || callee.startsWith("@minyar_equal_slots(") || callee.startsWith("@minyar_hash_slot(") || callee.startsWith("@minyar_check_") || callee.startsWith("@minyar_fail") { return true }
    if callee.startsWith("@minyar_list_new(") || callee.startsWith("@minyar_list_add(") || callee.startsWith("@minyar_list_add_take(") || callee.startsWith("@minyar_list_references(") || callee.startsWith("@minyar_list_length(") || callee.startsWith("@minyar_list_slice(") { return true }
    if callee.startsWith("@minyar_record_new(") || callee.startsWith("@minyar_record_new_scalar(") || callee.startsWith("@minyar_record_set_scalar(") || callee.startsWith("@minyar_map_new(") || callee.startsWith("@minyar_map_has(") || callee.startsWith("@minyar_map_get(") || callee.startsWith("@minyar_map_length(") { return true }
    if containers { return false }
    return callee.startsWith("@minyar_record_set(") || callee.startsWith("@minyar_record_set_take(") || callee.startsWith("@minyar_record_set_reference(") || callee.startsWith("@minyar_record_replace(") || callee.startsWith("@minyar_record_append_text(") || callee.startsWith("@minyar_map_set(") || callee.startsWith("@minyar_map_remove(")
}

// An element, field or Map value read inside a statement stays alive while
// its holder keeps it. Its count is reserved here and taken at the end of the
// statement only if code after the read could release a holder: a user call,
// or a runtime operation outside the strict loopBodyCallee set.
function reserveValueBorrow(context: CompilerContext, output: List<Text>, value: Text, type: Integer) {
    let borrows = context.valueBorrows
    if borrows.count == borrows.pieces.length {
        borrows.pieces.add(0)
        borrows.values.add("")
        borrows.types.add(0)
        borrows.calls.add(0)
    }
    borrows.pieces[borrows.count] = output.length
    borrows.values[borrows.count] = value
    borrows.types[borrows.count] = type
    borrows.calls[borrows.count] = context.callTargets.length
    borrows.count = borrows.count + 1
    output.add("")
}

// A pattern condition may bind a value that the body keeps using, so its
// reserved borrows are always taken.
function settleValueBorrows(context: CompilerContext, output: List<Text>, state: List<Integer>, mark: Integer, always: Boolean) {
    let borrows = context.valueBorrows
    let index = borrows.count - 1
    while index >= mark {
        let piece = borrows.pieces[index]
        if always || userCallsSince(context, borrows.calls[index]) || !loopBodyCallsAllowed(context, output, piece, true) {
            state[6] = 1
            state[7] = state[7] + 1
            noteCycleFixup(output, context.functionReturnTypes, context.functionParameterCounts, context.functionParameterTypes, piece, borrows.types[index], 0)
            output[piece] = "  call void @minyar_rc_borrow(ptr " + borrows.values[index] + ")\n"
        }
        index = index - 1
    }
    borrows.count = mark
}

// `root` followed by one or more `.field`, `[index]` or `[key]` steps, with no
// method call; index and key expressions are arbitrary.
function bindingPath(tokenKinds: List<Integer>, tokenTexts: List<Text>, start: Integer, end: Integer): Boolean {
    if tokenKinds[start] != 1 || end - start < 3 { return false }
    let position = start + 1
    while position < end {
        if tokenKinds[position] == 4 && tokenTexts[position] == "." && position + 1 < end && tokenKinds[position + 1] == 1 && !(position + 2 < end && tokenTexts[position + 2] == "(") {
            position = position + 2
        } else if tokenKinds[position] == 4 && tokenTexts[position] == "[" {
            let depth = 0
            let closed = false
            while position < end && !closed {
                if tokenKinds[position] == 4 && tokenTexts[position] == "[" { depth = depth + 1 }
                if tokenKinds[position] == 4 && tokenTexts[position] == "]" {
                    depth = depth - 1
                    closed = depth == 0
                }
                position = position + 1
            }
            if !closed { return false }
        } else {
            return false
        }
    }
    return true
}

// `let name = root[index]`, `let name = root.field` or a longer path of fields,
// List elements and Map values in a block, where `root` is a local the block
// never reassigns, can borrow its value: the binding never owns it. A hidden
// guard local reserved here takes a count only if code in the rest of the
// block can release the value, such as a user call or a store that replaces a
// field, element or Map value on the path (settleBindingGuards).
// The initializer's read and the binding ask about the same binding; the
// answer is kept for its tokens and type, so its block is scanned once.
function guardableElementBinding(context: CompilerContext, localNames: List<Text>, localLengths: List<Integer>, state: List<Integer>, start: Integer, end: Integer, name: Text, resultType: List<Integer>): Boolean {
    let borrows = context.valueBorrows
    if borrows.guardStart == start && borrows.guardEnd == end && borrows.guardType == resultType[0] { return borrows.guardable }
    let guardable = guardableBinding(context, localNames, localLengths, state, start, end, name, resultType)
    borrows.guardStart = start
    borrows.guardEnd = end
    borrows.guardType = resultType[0]
    borrows.guardable = guardable
    return guardable
}

function guardableBinding(context: CompilerContext, localNames: List<Text>, localLengths: List<Integer>, state: List<Integer>, start: Integer, end: Integer, name: Text, resultType: List<Integer>): Boolean {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let borrows = context.valueBorrows
    if !borrows.enabled || borrows.blocks == 0 || recoveryEnabled(state) { return false }
    if !isReferenceType(resultType[0]) || possibleCycleType(resultType[0], context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes) { return false }
    if !bindingPath(tokenKinds, tokenTexts, start, end) { return false }
    let root = tokenTexts[start]
    if findLocal(localNames, localLengths, state, root) < 0 { return false }
    return !blockAssignsEither(tokenKinds, tokenTexts, end, root, name)
}

function reserveBindingGuard(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, output: List<Text>, value: Text, type: Integer) {
    let guard = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, " guard", type, guard)
    let guards = context.valueBorrows.guards
    if guards.count == guards.pieces.length {
        guards.pieces.add(0)
        guards.slots.add(0)
        guards.values.add("")
        guards.calls.add(0)
        guards.levels.add(0)
    }
    guards.pieces[guards.count] = output.length
    guards.slots[guards.count] = ownershipSlot(state, guard)
    guards.values[guards.count] = value
    guards.calls[guards.count] = context.callTargets.length
    guards.levels[guards.count] = context.valueBorrows.blocks
    guards.count = guards.count + 1
    state[6] = 1
    output.add("")
}

// At the end of a block: a guard whose block made a user call or a releasing
// runtime call takes its count; otherwise its piece and its clears are removed.
function settleBindingGuards(context: CompilerContext, output: List<Text>) {
    let guards = context.valueBorrows.guards
    while guards.count > 0 && guards.levels[guards.count - 1] >= context.valueBorrows.blocks {
        let index = guards.count - 1
        let piece = guards.pieces[index]
        let slot = Text(guards.slots[index])
        if userCallsSince(context, guards.calls[index]) || !loopBodyCallsAllowed(context, output, piece + 1, true) {
            output[piece] = "  call void @minyar_rc_local(i64 " + slot + ", ptr " + guards.values[index] + ")\n"
        } else {
            let cursor = piece
            while cursor + 4 < output.length {
                if output[cursor] == "  call void @minyar_rc_local(i64 " && output[cursor + 1] == slot && output[cursor + 2] == ", ptr " && output[cursor + 3] == "null" && output[cursor + 4] == ")\n" {
                    output[cursor] = ""
                    output[cursor + 1] = ""
                    output[cursor + 2] = ""
                    output[cursor + 3] = ""
                    output[cursor + 4] = ""
                }
                cursor = cursor + 1
            }
        }
        guards.count = index
    }
}

// Whether every call in the compiled body is a loopBodyCallee.
function loopBodyCallsAllowed(context: CompilerContext, output: List<Text>, start: Integer, containers: Boolean): Boolean {
    if output.length - start > 2000 { return false }
    let pieces: List<Text> = []
    let index = start
    while index < output.length {
        pieces.add(output[index])
        index = index + 1
    }
    let rest = joinText(pieces)
    if rest.find("invoke ") >= 0 { return false }
    let call = rest.find("call ")
    while call >= 0 {
        rest = rest.slice(call + 5, rest.length)
        let at = rest.find("@")
        let indirect = rest.find("%")
        if at < 0 || (indirect >= 0 && indirect < at) || !(loopBodyCallee(rest.slice(at, rest.length), containers) || parallelCallee(context, rest.slice(at, rest.length))) { return false }
        call = rest.find("call ")
    }
    return true
}

// When a loop body assigns only plain local names, other than the loop name
// and the source name, or field and element paths, it can release the
// collection it walks or its elements only through code its compiled form
// shows: user calls, or runtime operations outside loopBodyCallsAllowed. The
// loop lowering reserves both owners and fills them when that code appears.
function loopBodyKeepsElements(tokenKinds: List<Integer>, tokenTexts: List<Text>, position: Integer, source: Text, loopName: Text): Boolean {
    if tokenKinds[position] != 4 || tokenTexts[position] != "{" { return false }
    let cursor = position + 1
    let depth = 0
    while tokenKinds[cursor] != 0 {
        let text = tokenTexts[cursor]
        if tokenKinds[cursor] == 4 {
            if text == "{" || text == "(" || text == "[" { depth = depth + 1 }
            if text == "}" || text == ")" || text == "]" {
                if depth == 0 { return true }
                depth = depth - 1
            }
            if isAssignmentOperator(text) && !loopAssignmentDeclaresLocal(tokenKinds, tokenTexts, cursor) {
                let previous = tokenKinds[cursor - 2]
                let boundary = previous == 6 || (previous == 4 && (tokenTexts[cursor - 2] == "{" || tokenTexts[cursor - 2] == "}"))
                if tokenKinds[cursor - 1] == 1 && boundary {
                    if tokenTexts[cursor - 1] == source || tokenTexts[cursor - 1] == loopName { return false }
                } else {
                    if !loopAssignmentHasPath(tokenKinds, tokenTexts, cursor) { return false }
                }
            }
        }
        cursor = cursor + 1
    }
    return false
}

function assignmentOperatorPosition(tokenKinds: List<Integer>, tokenTexts: List<Text>, start: Integer): Integer {
    if tokenKinds[start] != 1 {
        return -1
    }
    let position = start + 1
    let searching = true
    while searching {
        if tokenKinds[position] == 4 && tokenTexts[position] == "." && tokenKinds[position + 1] == 1 {
            position = position + 2
        } else {
            if tokenKinds[position] == 4 && tokenTexts[position] == "[" {
                let depth = 1
                position = position + 1
                while depth > 0 && tokenKinds[position] != 0 {
                    if tokenKinds[position] == 4 && tokenTexts[position] == "[" {
                        depth = depth + 1
                    }
                    if tokenKinds[position] == 4 && tokenTexts[position] == "]" {
                        depth = depth - 1
                    }
                    position = position + 1
                }
                if depth > 0 {
                    return -1
                }
            } else {
                searching = false
            }
        }
    }
    if tokenKinds[position] == 4 && isAssignmentOperator(tokenTexts[position]) {
        return position
    }
    return -1
}

function loadLocal(output: List<Text>, textState: List<Text>, state: List<Integer>, id: Integer, type: Integer): Text {
    if id < 0 {
        return output[-id - 1]
    }
    let value = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(value)
    output.add(" = load ")
    output.add(llvmType(type))
    output.add(", ptr %local.")
    output.add(Text(id))
    output.add("\n")
    return value
}

function loadScalarSlot(output: List<Text>, textState: List<Text>, state: List<Integer>, address: Text): Text {
    let value = valueName(textState, newTemporary(state))
    output.add("  " + value + " = load i64, ptr " + address + "\n")
    return value
}

function storeScalarSlot(output: List<Text>, address: Text, value: Text) {
    output.add("  store i64 " + value + ", ptr " + address + "\n")
}

function storeLocal(output: List<Text>, id: Integer, type: Integer, value: Text) {
    output.add("  store ")
    output.add(llvmType(type))
    output.add(" ")
    output.add(value)
    output.add(", ptr %local.")
    output.add(Text(id))
    output.add("\n")
}

function readRecordField(output: List<Text>, textState: List<Text>, state: List<Integer>, record: Text, field: Integer, type: Integer): Text {
    let raw = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(raw)
    output.add(" = call i64 @.minyar.record.get(ptr ")
    output.add(record)
    output.add(", i64 ")
    output.add(Text(field))
    output.add(")\n")
    return slotAsValue(output, textState, state, raw, type)
}

function readListElement(output: List<Text>, textState: List<Text>, state: List<Integer>, list: Text, position: Text, type: Integer): Text {
    let raw = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(raw)
    output.add(" = call i64 @.minyar.list.get.checked(ptr ")
    output.add(list)
    output.add(", i64 ")
    output.add(position)
    output.add(")\n")
    return slotAsValue(output, textState, state, raw, type)
}

function checkMapMutation(mapType: Integer, counts: List<Integer>, fields: List<Integer>) {
    let visited: List<Boolean> = []
    let index = 0
    while index < counts.length / 2 {
        visited.add(false)
        index = index + 1
    }
    let pending: List<Integer> = [mapValueType(mapType)]
    index = 0
    while index < pending.length {
        let type = pending[index]
        index = index + 1
        while isContainerType(type) {
            if type == mapType { failCompiler("Map mutation could create a reference cycle") }
            type = containerValueType(type)
        }
        if isRecordType(type) && !visited[recordTypeIndex(type)] {
            let record = recordTypeIndex(type)
            visited[record] = true
            let first = functionParameterOffset(counts, record)
            let field = 0
            while field < counts[record] {
                pending.add(fields[first + field])
                field = field + 1
            }
        }
    }
}

function checkFieldMutation(recordType: Integer, fieldType: Integer, counts: List<Integer>, fields: List<Integer>, locations: SourceMap, location: Integer, returnTypes: List<Integer>) {
    let element = fieldType
    while isContainerType(element) { element = containerValueType(element) }
    if isRecordType(element) { activateCycleType(returnTypes, recordType, counts.length) }
}

function assignedValue(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, binary: Text, current: Text, type: Integer, valueType: List<Integer>, location: Integer): Text {
    let tokenLines = context.tokenLines
    setType(valueType, type)
    if binary == "" {
        return parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, valueType)
    }
    let rightType: List<Integer> = [type]
    let right = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, rightType)
    setType(valueType, 0)
    return emitBinary(context, globals, output, textState, state, binary, current, type, -1, right, rightType[0], valueType, tokenLines, location)
}

function compileAssignment(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, operatorPosition: Integer) {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let functionNames = context.functionNames
    let symbolKinds = context.symbolKinds
    let functionReturnTypes = context.functionReturnTypes
    let functionParameterCounts = context.functionParameterCounts
    let functionParameterNames = context.functionParameterNames
    let functionParameterTypes = context.functionParameterTypes
    let operator = tokenTexts[operatorPosition]
    let operatorLocation = operatorPosition
    let binary = ""
    if operator != "=" {
        binary = operator.slice(0, 1)
    }
    let start = state[0]
    context.syntax.nodes[context.syntax.active].kind = 111
    context.syntax.nodes[context.syntax.active].operator = operatorPosition
    let syntaxTarget = beginSyntaxNode(context.syntax, 214, start)
    let name = tokenTexts[start]
    let local = findLocal(localNames, localLengths, state, name)
    let scalarValues = -1
    let receiverType = 0
    let receiver = ""
    if local >= 0 {
        noteLocalRead(context, localIds[local], syntaxTarget)
        receiverType = localTypes[local]
        scalarValues = scalarRecordValues(state, localIds[local])
        receiver = loadLocal(output, textState, state, localIds[local], receiverType)
        state[0] = state[0] + 1
    } else {
        let constant = findCompiledSymbol(functionNames, symbolKinds, context.tokenLines.symbolLookup, name, 3)
        if constant < 0 {
            failUnknownValue(context, localNames, localLengths, state, start, name)
        }
        if isStaticIntegerTable(context, constant) { failAtToken(tokenLines, start, "compile-time table '" + readableDeclarationName(name) + "' cannot be changed") }
        if start + 1 == operatorPosition {
            failAtToken(tokenLines, start, "constant '" + readableDeclarationName(name) + "' cannot be reassigned")
        }
        let type: List<Integer> = [0]
        receiver = parseAtom(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, type)
        receiverType = type[0]
    }
    let valueType: List<Integer> = [0]
    if state[0] == operatorPosition {
        if localLengths[local] < 0 {
            failAtToken(tokenLines, operatorLocation, "constant '" + name + "' cannot be reassigned")
        }
        if localIds[local] < 0 {
            failAtToken(tokenLines, operatorLocation, "captured bindings cannot be reassigned; capture a mutable record field")
        }
        endSyntaxNode(context.syntax, syntaxTarget, operatorPosition, receiverType)
        state[0] = operatorPosition + 1
        let value = assignedValue(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, binary, receiver, receiverType, valueType, operatorLocation)
        if valueType[0] != receiverType {
            failAtToken(tokenLines, operatorLocation, "an assignment to '" + name + "' has the wrong type")
        }
        assignReference(output, state, localIds[local], value, valueType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
        storeLocal(output, localIds[local], receiverType, value)
        return
    }
    let done = false
    let deferredPieces: List<Integer> = []
    let deferredValues: List<Text> = []
    let deferredTypes: List<Integer> = []
    let deferredCalls: List<Integer> = []
    while !done {
        if tokenTexts[state[0]] == "." {
            let member = tokenTexts[state[0] + 1]
            let memberLocation = state[0] + 1
            state[0] = state[0] + 2
            if !isRecordType(receiverType) {
                failAtToken(tokenLines, memberLocation, "only record fields can be assigned, and " + describeType(receiverType) + " has no field named '" + member + "'")
            }
            let field = findRecordField(functionParameterCounts, functionParameterNames, receiverType, member)
            if field < 0 {
                failUnknownField(context, memberLocation, receiverType, member)
            }
            checkFieldAccess(tokenLines, functionParameterNames[field], functionNames[recordTypeIndex(receiverType)], memberLocation)
            let fieldType = functionParameterTypes[field]
            let fieldIndex = field - functionParameterOffset(functionParameterCounts, recordTypeIndex(receiverType))
            if state[0] == operatorPosition {
                let scalarField = ""
                if scalarValues >= 0 && operatorPosition == start + 3 {
                    if output[scalarValues] != "; mutable scalar field " { failCompiler("scalar record write needs mutable field storage") }
                    scalarField = output[scalarValues + fieldIndex * 3 + 1]
                }
                endSyntaxNode(context.syntax, syntaxTarget, operatorPosition, fieldType)
                state[0] = operatorPosition + 1
                let next = state[0]
                if binary == "" && fieldType == 2 && operatorPosition == start + 3 && tokenKinds[next] == 1 && tokenTexts[next] == name && tokenKinds[next + 1] == 4 && tokenTexts[next + 1] == "." && tokenKinds[next + 2] == 1 && tokenTexts[next + 2] == member && tokenKinds[next + 3] == 4 && tokenTexts[next + 3] == "+" {
                    binary = "+"
                    state[0] = next + 4
                }
                if isReferenceType(fieldType) {
                    checkFieldMutation(receiverType, fieldType, functionParameterCounts, functionParameterTypes, tokenLines, memberLocation, functionReturnTypes)
                }
                let current = ""
                if binary != "" {
                    if scalarField != "" { current = slotAsValue(output, textState, state, loadScalarSlot(output, textState, state, scalarField), fieldType) } else {
                    if state[15] / 32 % 2 != 0 && isCRecord(context, receiverType) { current = readCField(context, output, textState, state, receiver, field) } else {
                        current = readRecordField(output, textState, state, receiver, fieldIndex, fieldType)
                    }
                    }
                    borrowReference(output, state, current, fieldType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                }
                let value = ""
                if binary == "+" && fieldType == 2 {
                    let rightType: List<Integer> = [2]
                    let right = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, rightType)
                    if rightType[0] == 2 {
                        settleBorrows(context, output, state, deferredPieces, deferredValues, deferredTypes, deferredCalls)
                        output.add("  call void @minyar_record_append_text(ptr ")
                        output.add(receiver)
                        output.add(", i64 ")
                        output.add(Text(fieldIndex))
                        output.add(", ptr ")
                        output.add(current)
                        output.add(", ptr ")
                        output.add(right)
                        output.add(")\n")
                        return
                    }
                    setType(valueType, 0)
                    value = emitBinary(context, globals, output, textState, state, binary, current, fieldType, -1, right, rightType[0], valueType, tokenLines, operatorLocation)
                } else {
                    value = assignedValue(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, binary, current, fieldType, valueType, operatorLocation)
                }
                if valueType[0] != fieldType {
                    failAtToken(tokenLines, operatorPosition + 1, "record field '" + member + "' needs " + describeType(fieldType) + ", not " + describeType(valueType[0]))
                }
                if scalarField != "" { storeScalarSlot(output, scalarField, valueAsListSlot(output, textState, state, value, fieldType)) } else {
                if state[15] / 32 % 2 != 0 && isCRecord(context, receiverType) { writeCField(context, output, textState, state, receiver, field, value) } else {
                let slot = valueAsListSlot(output, textState, state, value, fieldType)
                if isReferenceType(fieldType) {
                    if possibleCycleType(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes) && cycleTypeReaches(fieldType, receiverType, functionParameterCounts, functionParameterTypes) {
                        output.add("  call void @minyar_rc_enable_cycles()\n")
                    }
                    let transfers = "0"
                    if takeResult(output, state, value, valueType) {
                        transfers = "1"
                    }
                    noteCycleFixup(output, functionReturnTypes, functionParameterCounts, functionParameterTypes, output.length, receiverType, fieldType)
                    output.add("  call void @minyar_record_replace(ptr ")
                    output.add(receiver)
                    output.add(", i64 ")
                    output.add(Text(fieldIndex))
                    output.add(", i64 ")
                    output.add(slot)
                    output.add(", i64 ")
                    output.add(transfers)
                    output.add(")\n")
                } else {
                    context.valueBorrows.scalarStores = context.valueBorrows.scalarStores + 1
                    output.add("  call void @.minyar.record.set.scalar(ptr ")
                    output.add(receiver)
                    output.add(", i64 ")
                    output.add(Text(fieldIndex))
                    output.add(", i64 ")
                    output.add(slot)
                    output.add(")\n")
                }
                }
                }
                done = true
            } else {
                scalarValues = -1
                if state[15] / 32 % 2 != 0 && isCRecord(context, receiverType) { receiver = readCField(context, output, textState, state, receiver, field) } else {
                    receiver = readRecordField(output, textState, state, receiver, fieldIndex, fieldType)
                }
                receiverType = fieldType
                if possibleCycleType(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes) || !(tokenTexts[state[0]] == "[" && statementWithoutCalls(tokenKinds, tokenTexts, state[0])) {
                    borrowReference(output, state, receiver, receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                } else {
                    deferBorrow(context, output, receiver, receiverType, deferredPieces, deferredValues, deferredTypes, deferredCalls)
                }
            }
        } else {
            let bracketLocation = state[0]
            state[0] = state[0] + 1
            let keyPiece = -1
            let keyValue = ""
            let keyCalls = 0
            let positionType: List<Integer> = [0]
            if isMapType(receiverType) { positionType[0] = mapKeyType(receiverType) }
            let position = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, positionType)
            expectToken(tokenKinds, tokenTexts, tokenLines, state, "]")
            if isMapType(receiverType) {
                declareMapRuntime(globals)
                requireType(tokenLines, state, positionType[0], mapKeyType(receiverType), "Map key has the wrong type")
                keyPiece = output.length
                output.add("")
                keyValue = position
                keyCalls = context.callTargets.length
                position = valueAsListSlot(output, textState, state, position, positionType[0])
            } else { requireType(tokenLines, state, positionType[0], 1, "a position must be an Integer") }
            if (!isContainerType(receiverType) || isSetType(receiverType)) && receiverType != 8 {
                failAtToken(tokenLines, bracketLocation, "indexed assignment needs a List or Bytes, not " + describeType(receiverType))
            }
            let elementType = 1
            if isListType(receiverType) {
                elementType = listElementType(receiverType)
            }
            if isMapType(receiverType) { elementType = mapValueType(receiverType) }
            if state[0] == operatorPosition {
                endSyntaxNode(context.syntax, syntaxTarget, operatorPosition, elementType)
                state[0] = operatorPosition + 1
                let current = ""
                if isMapType(receiverType) {
                    functionReturnTypes.add(-5)
                    functionReturnTypes.add(receiverType)
                    checkMapMutation(receiverType, functionParameterCounts, functionParameterTypes)
                    if binary != "" {
                        current = readMapElement(context, output, textState, state, receiver, position, elementType, mapKeyType(receiverType))
                        borrowReference(output, state, current, elementType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    }
                    let value = assignedValue(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, binary, current, elementType, valueType, operatorLocation)
                    requireType(tokenLines, state, valueType[0], elementType, "Map value has the wrong type")
                    let slot = valueAsListSlot(output, textState, state, value, elementType)
                    let custom = noteHashableCalls(context, mapKeyType(receiverType), state, textState, output)
                    output.add("  call void @minyar_map_set(ptr " + receiver + ", i64 " + position + ", i64 " + slot + ")\n")
                    settleMapBorrow(context, output, state, keyPiece, keyValue, mapKeyType(receiverType), keyCalls, tokensMakeCall(tokenKinds, tokenTexts, operatorPosition + 1, state[0]))
                    if custom { recoveryCheckpoint(output, textState, state) }
                } else {
                if receiverType == 8 {
                    if binary != "" {
                        current = emitBytesRead(output, textState, state, receiver, position)
                    }
                    let value = assignedValue(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, binary, current, 1, valueType, operatorLocation)
                    requireType(tokenLines, state, valueType[0], 1, "a byte must be an Integer")
                    context.valueBorrows.scalarStores = context.valueBorrows.scalarStores + 1
                    output.add("  call void @.minyar.bytes.set.checked(ptr ")
                    output.add(receiver)
                    output.add(", i64 ")
                    output.add(position)
                    output.add(", i64 ")
                    output.add(value)
                    output.add(")\n")
                } else {
                    checkListMutation(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    if binary != "" {
                        current = readListElement(output, textState, state, receiver, position, elementType)
                        borrowReference(output, state, current, elementType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    }
                    let value = assignedValue(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, binary, current, elementType, valueType, operatorLocation)
                    if valueType[0] != elementType {
                        failAtToken(tokenLines, operatorPosition + 1, "an indexed assignment needs " + describeType(elementType) + ", not " + describeType(valueType[0]))
                    }
                    if possibleCycleType(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes) {
                        output.add("  call void @minyar_rc_enable_cycles()\n")
                    }
                    let slot = valueAsListSlot(output, textState, state, value, elementType)
                    let transfers = takeResult(output, state, value, valueType)
                    if !transfers && binary == "" { reserveLocalTake(context, state, output, value, context.syntax.lastValue) }
                    noteCycleFixup(output, functionReturnTypes, functionParameterCounts, functionParameterTypes, output.length, receiverType, elementType)
                    if transfers {
                        output.add("  call void @minyar_list_set_take(ptr ")
                    } else {
                        if isReferenceType(elementType) {
                            output.add("  call void @minyar_list_set(ptr ")
                        } else {
                            context.valueBorrows.scalarStores = context.valueBorrows.scalarStores + 1
                            output.add("  call void @.minyar.list.set.scalar.checked(ptr ")
                        }
                    }
                    output.add(receiver)
                    output.add(", i64 ")
                    output.add(position)
                    output.add(", i64 ")
                    output.add(slot)
                    output.add(")\n")
                }
                }
                done = true
            } else {
                if receiverType == 8 {
                    failAtToken(tokenLines, bracketLocation, "a byte has no fields or positions to assign")
                }
                let fromMap = isMapType(receiverType)
                if fromMap { receiver = readMapElement(context, output, textState, state, receiver, position, elementType, mapKeyType(receiverType)) } else {
                    receiver = readListElement(output, textState, state, receiver, position, elementType)
                }
                receiverType = elementType
                let next = tokenTexts[state[0]]
                if fromMap || possibleCycleType(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes) || !((next == "[" || next == ".") && statementWithoutCalls(tokenKinds, tokenTexts, state[0])) {
                    borrowReference(output, state, receiver, receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                } else {
                    deferBorrow(context, output, receiver, receiverType, deferredPieces, deferredValues, deferredTypes, deferredCalls)
                }
            }
        }
    }
    settleBorrows(context, output, state, deferredPieces, deferredValues, deferredTypes, deferredCalls)
}

// A Map operation runs user code only through key hash or equality methods,
// and noteHashableCalls records those as call targets. A borrowed receiver or
// key therefore needs a count only if a call target was recorded since its
// reserved piece, or the code in between has a call token (a builtin method
// may release what holds it).
function settleMapBorrow(context: CompilerContext, output: List<Text>, state: List<Integer>, piece: Integer, value: Text, type: Integer, calls: Integer, callTokens: Boolean) {
    if piece < 0 || !isReferenceType(type) || (context.callTargets.length == calls && !callTokens) { return }
    state[6] = 1
    state[7] = state[7] + 1
    noteCycleFixup(output, context.functionReturnTypes, context.functionParameterCounts, context.functionParameterTypes, piece, type, 0)
    output[piece] = "  call void @minyar_rc_borrow(ptr " + value + ")\n"
}

// An element or field receiver that the rest of the statement cannot replace
// without a call needs no count. Reserve a piece; settleBorrows fills it if
// compiling the rest of the statement ran user code after all.
function deferBorrow(context: CompilerContext, output: List<Text>, receiver: Text, type: Integer, pieces: List<Integer>, values: List<Text>, types: List<Integer>, calls: List<Integer>) {
    pieces.add(output.length)
    output.add("")
    values.add(receiver)
    types.add(type)
    calls.add(context.callTargets.length)
}

function settleBorrows(context: CompilerContext, output: List<Text>, state: List<Integer>, pieces: List<Integer>, values: List<Text>, types: List<Integer>, calls: List<Integer>) {
    let index = 0
    while index < pieces.length {
        settleBorrow(context, output, state, pieces[index], values[index], types[index], calls[index])
        index = index + 1
    }
}

function emitBytesRead(output: List<Text>, textState: List<Text>, state: List<Integer>, bytes: Text, position: Text): Text {
    let value = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(value)
    output.add(" = call i64 @.minyar.bytes.get.checked(ptr ")
    output.add(bytes)
    output.add(", i64 ")
    output.add(position)
    output.add(")\n")
    return value
}

function findLoopMarker(localNames: List<Text>, localLengths: List<Integer>, state: List<Integer>): Integer {
    return findLocal(localNames, localLengths, state, " loop")
}

function compileLoopJump(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>) {
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let keyword = tokenTexts[state[0]]
    let marker = findLoopMarker(localNames, localLengths, state)
    if marker < 0 {
        failAtToken(tokenLines, state[0], "'" + keyword + "' can only be used inside a loop")
    }
    state[0] = state[0] + 1
    let label = localIds[marker]
    let local = marker + 1
    while local < state[3] {
        rootLocal(output, state, localIds[local], "null", localTypes[local])
        local = local + 1
    }
    if localTypes[marker] == -1 || localTypes[marker] == -3 {
        if keyword == "continue" {
            // The loop's back-edge block services cleanup once for every path.
            output.add("  br label %while.next." + Text(label) + "\n")
        } else {
            if state[13] == 0 { localTypes[marker] = -3 }
            output.add("  br label %while.end." + Text(label + 2) + "\n")
        }
    } else {
        if keyword == "continue" {
            output.add("  br label %for.step." + Text(label + 2) + "\n")
        } else {
            output.add("  br label %for.end." + Text(label + 3) + "\n")
        }
    }
}

function compileFor(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, returnType: Integer) {
    let parts: List<Integer> = []
    let blocks: List<Text> = []
    compileForParts(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType, parts, blocks)
}

function compileForParts(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, returnType: Integer, parts: List<Integer>, blocks: List<Text>) {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let functionReturnTypes = context.functionReturnTypes
    let functionParameterCounts = context.functionParameterCounts
    let functionParameterTypes = context.functionParameterTypes
    let forLocation = state[0]
    state[0] = state[0] + 1
    if tokenKinds[state[0]] != 1 {
        failAtToken(tokenLines, state[0], "expected a name after for")
    }
    let name = tokenTexts[state[0]]
    let nameLocation = state[0]
    state[0] = state[0] + 1
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "in")
    let firstLoopLocal = state[3]
    let sourceLocation = state[0]
    let sourceType: List<Integer> = [0]
    let sequenceStages: List<Integer> = []
    let source = parseForSequenceSource(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, sourceType, sequenceStages, parts.length == 0)
    source = prepareSequenceSource(context, localNames, localTypes, localIds, localLengths, state, textState, output, source, sourceType, sequenceStages, sourceLocation)
    // A plain variable source already owns the collection for the whole loop.
    let sourceName = ""
    if tokenKinds[sourceLocation] == 1 && sourceLocation + 1 == state[0] && sequenceStages.length == 0 && !isMapType(sourceType[0]) && !isSetType(sourceType[0]) { sourceName = tokenTexts[sourceLocation] }
    let walkKept = sequenceStages.length == 0 && parts.length == 0 && loopBodyKeepsElements(tokenKinds, tokenTexts, state[0], sourceName, name)
    // A stable root (readonly parameter, capture, constant or never-reassigned
    // binding) keeps its List alive for the whole loop, even across user code.
    let stableSource = sourceName != "" && isListType(sourceType[0]) && stableBorrowRoot(context, localNames, localIds, localLengths, state, sourceName)
    let collectionPiece = -1
    let elementPiece = -1
    if parts.length > 0 && sequenceStages.length > 0 { failAtToken(tokenLines, sourceLocation, "parallel for needs an Integer range; use an ordinary for for a lazy sequence") }
    if isMapType(sourceType[0]) || isSetType(sourceType[0]) {
        let keyType = mapKeyType(sourceType[0])
        if isSetType(sourceType[0]) { keyType = setElementType(sourceType[0]) }
        declareMapRuntime(globals)
        let declaration = "declare ptr @minyar_map_keys(ptr)\n"
        if findText(globals, declaration) < 0 { globals.add(declaration) }
        let keys = valueName(textState, newTemporary(state))
        output.add("  " + keys + " = call ptr @minyar_map_keys(ptr " + source + ")\n")
        setType(sourceType, makeListType(keyType))
        source = keys
        ownResult(output, state, source, sourceType)
    }
    if isRecordType(sourceType[0]) && !tokenIs(tokenKinds, tokenTexts, state, "..") {
        if parts.length > 0 { failAtToken(tokenLines, sourceLocation, "parallel for needs an Integer range; use an ordinary for for an iterable record") }
        compileIterationFor(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType, name, source, sourceType, sourceLocation, firstLoopLocal, sequenceStages)
        return
    }
    let loopLabel = newLabel(state)
    let bodyLabel = newLabel(state)
    let stepLabel = newLabel(state)
    let endLabel = newLabel(state)
    let counter = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, " for counter", 1, counter)
    let limit = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, " for limit", 1, limit)
    let collection = -1
    let elementType = 1
    let lengthBound = false
    if tokenIs(tokenKinds, tokenTexts, state, "..") {
        requireType(tokenLines, state, sourceType[0], 1, "a range starts with an Integer")
        state[0] = state[0] + 1
        let endType: List<Integer> = [0]
        let endStart = state[0]
        let end = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, endType)
        lengthBound = state[0] == endStart + 3 && tokenKinds[endStart] == 1 && tokenTexts[endStart + 1] == "." && tokenTexts[endStart + 2] == "length"
        requireType(tokenLines, state, endType[0], 1, "a range ends with an Integer")
        if parts.length > 0 { parallelReductionHeader(context, localNames, localTypes, localIds, localLengths, state, parts, name) }
        storeLocal(output, counter, 1, source)
        storeLocal(output, limit, 1, end)
    } else {
        if isListType(sourceType[0]) {
            elementType = listElementType(sourceType[0])
        } else {
            if sourceType[0] == 2 {
                elementType = 3
            } else {
                if sourceType[0] == 8 {
                    elementType = 1
                } else {
                    failAtToken(tokenLines, sourceLocation, "for needs a range such as 0..count, a List, Map, Text, or Bytes, not " + describeType(sourceType[0]))
                }
            }
        }
        collection = nextLocal(state)
        addLocal(localNames, localTypes, localIds, localLengths, state, " for collection", sourceType[0], collection)
        if walkKept && sourceName != "" && !stableSource {
            collectionPiece = output.length
            output.add("")
        } else if !stableSource {
            assignReference(output, state, collection, source, sourceType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
        }
        storeLocal(output, collection, sourceType[0], source)
        storeLocal(output, counter, 1, "0")
    }
    if parts.length > 0 {
        parts[0] = output.length
        parts[1] = counter
        parts[2] = limit
        parts[3] = collection
        blocks.add(textState[0])
    }
    // A loop whose compiled body makes no calls can create no cleanup debt.
    // These pieces stay empty unless that holds; see versionPureLoop.
    let pure = parts.length == 0 && sequenceStages.length == 0
    let strip = -1
    if pure { strip = nextLocal(state) }
    let entryPiece = output.length
    output.add("")
    output.add("")
    output.add("  br label %for.condition." + Text(loopLabel) + "\n\nfor.condition." + Text(loopLabel) + ":\n")
    textState[0] = "for.condition." + Text(loopLabel)
    let position = loadLocal(output, textState, state, counter, 1)
    let bound = ""
    if collection < 0 {
        bound = loadLocal(output, textState, state, limit, 1)
    } else {
        let items = loadLocal(output, textState, state, collection, sourceType[0])
        let lengthFunction = "minyar_list_length"
        if isListType(sourceType[0]) {
            lengthFunction = ".minyar.list.length"
        }
        if sourceType[0] == 2 {
            lengthFunction = "minyar_text_length"
        }
        if sourceType[0] == 8 {
            lengthFunction = ".minyar.bytes.length"
        }
        let arguments: List<Text> = []
        arguments.add(items)
        let argumentTypes: List<Integer> = [sourceType[0]]
        bound = emitCall(output, textState, state, 1, lengthFunction, arguments, argumentTypes)
    }
    let continuing = emitInstruction(output, textState, state, "icmp slt i64 " + position + ", " + bound)
    let testPiece = output.length
    output.add("  br i1 " + continuing + ", label %for.body." + Text(bodyLabel) + ", label %for.end." + Text(endLabel) + "\n\nfor.body." + Text(bodyLabel) + ":\n")
    output.add("")
    output.add("")
    output.add("")
    textState[0] = "for.body." + Text(bodyLabel)
    let element = position
    if collection >= 0 {
        let items = loadLocal(output, textState, state, collection, sourceType[0])
        if isListType(sourceType[0]) {
            element = readListElement(output, textState, state, items, position, elementType)
        } else {
            if sourceType[0] == 8 {
                element = emitBytesRead(output, textState, state, items, position)
            } else {
                element = valueName(textState, newTemporary(state))
                output.add("  " + element + " = call i32 @minyar_text_character_at(ptr " + items + ", i64 " + position + ")\n")
            }
        }
    }
    let elementResult: List<Integer> = [elementType]
    element = emitSequenceStages(context, output, textState, state, sequenceStages, element, elementResult, stepLabel, sourceLocation)
    elementType = elementResult[0]
    emitDebugOrigin(output, tokenLines, forLocation, "line")
    output.add("; minyar-debug-scope: begin\n")
    let variable = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, name, elementType, variable)
    if walkKept && collection >= 0 && isListType(sourceType[0]) {
        elementPiece = output.length
        output.add("")
    } else {
        assignReference(output, state, variable, element, elementResult, functionParameterCounts, functionParameterTypes, functionReturnTypes)
    }
    storeLocal(output, variable, elementType, element)
    emitDebugBinding(context, output, nameLocation, name, elementType, "ptr %local." + Text(variable), 0, true)
    addLocal(localNames, localTypes, localIds, localLengths, state, " loop", -2, loopLabel)
    if parts.length > 0 { parts[4] = context.callTargets.length; parts[5] = state[0] }
    let callsBefore = context.callTargets.length
    let storesBefore = context.valueBorrows.scalarStores
    let bodyStart = output.length
    let bodyReturns = compileBlock(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, returnType)
    if collectionPiece >= 0 || elementPiece >= 0 {
        let userCode = userCallsSince(context, callsBefore)
        let slots = userCode || !loopBodyCallsAllowed(context, output, bodyStart, false)
        if collectionPiece >= 0 && (slots || !loopBodyCallsAllowed(context, output, bodyStart, true)) { rootLocalAt(context, output, state, collectionPiece, collection, source, sourceType[0]) }
        if elementPiece >= 0 && slots { rootLocalAt(context, output, state, elementPiece, variable, element, elementType) }
    }
    output.add("; minyar-debug-scope: end\n")
    if !bodyReturns {
        output.add("  br label %for.step." + Text(stepLabel) + "\n")
    }
    output.add("\nfor.step." + Text(stepLabel) + ":\n")
    textState[0] = "for.step." + Text(stepLabel)
    let current = loadLocal(output, textState, state, counter, 1)
    let next = emitInstruction(output, textState, state, "add nsw i64 " + current + ", 1")
    storeLocal(output, counter, 1, next)
    let stepPiece = output.length
    output.add("  call void @minyar_rc_step()\n")
    output.add("  br label %for.condition." + Text(loopLabel) + "\n\nfor.end." + Text(endLabel) + ":\n")
    if pure && pureLoopCode(context, output, entryPiece + 2, stepPiece) {
        versionPureLoop(output, entryPiece, testPiece, stepPiece, loopLabel, bodyLabel, endLabel, strip, continuing, position)
    }
    // LLVM already removes the checks of a loop that only reads Lists when its
    // bound is a List length (a List walk or `0..list.length`): nothing in the
    // loop can change that length. A scalar store may, as far as LLVM knows,
    // and an unrelated bound proves nothing, so only those loops are versioned.
    if pure && output[stepPiece] == "" && ((collection < 0 && !lengthBound) || context.valueBorrows.scalarStores != storesBefore) {
        let condition: List<Text> = ["for.condition." + Text(loopLabel) + ":\n"]
        let piece = entryPiece + 3
        while piece < testPiece {
            condition.add(output[piece])
            piece = piece + 1
        }
        condition.add("  br i1 " + continuing + ", label %for.body." + Text(bodyLabel) + ", label %for.end." + Text(endLabel) + "\n\nfor.body." + Text(bodyLabel) + ":\n")
        piece = testPiece + 4
        while piece < stepPiece {
            condition.add(output[piece])
            piece = piece + 1
        }
        condition.add("  br label %for.condition." + Text(loopLabel) + "\n")
        let ignored = versionCheckedLoop(output, entryPiece, joinText(condition), loopLabel, counter, variable, position, bound)
    }
    textState[0] = "for.end." + Text(endLabel)
    let scoped = firstLoopLocal
    while scoped < state[3] {
        if hasOwnershipSlot(state, localIds[scoped]) { rootLocal(output, state, localIds[scoped], "null", localTypes[scoped]) }
        scoped = scoped + 1
    }
    state[3] = firstLoopLocal
}
