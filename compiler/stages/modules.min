function pathCharacterIsSeparator(character: Character): Boolean {
    return character == '/' || character == '\\'
}

function normalizePath(path: Text): Text {
    let parts: List<Text> = []
    let activeParts = 0
    let position = 0
    let absolute = false
    let drive = ""

    if path.length >= 2 && path[1] == ':' {
        drive = Text(path[0]) + ":"
        position = 2
        if position < path.length && pathCharacterIsSeparator(path[position]) {
            absolute = true
            position = position + 1
        }
    } else {
        if path.length > 0 && pathCharacterIsSeparator(path[0]) {
            absolute = true
            position = 1
        }
    }

    let part = ""
    while position <= path.length {
        let atEnd = position == path.length
        if atEnd || pathCharacterIsSeparator(path[position]) {
            if part == ".." {
                if activeParts > 0 && parts[activeParts - 1] != ".." {
                    activeParts = activeParts - 1
                } else {
                    if !absolute {
                        if activeParts < parts.length {
                            parts[activeParts] = part
                        } else {
                            parts.add(part)
                        }
                        activeParts = activeParts + 1
                    }
                }
            } else {
                if part != "" && part != "." {
                    if activeParts < parts.length {
                        parts[activeParts] = part
                    } else {
                        parts.add(part)
                    }
                    activeParts = activeParts + 1
                }
            }
            part = ""
        } else {
            part = part + Text(path[position])
        }
        position = position + 1
    }

    let result = drive
    if absolute {
        result = result + "/"
    }
    position = 0
    while position < activeParts {
        if result.length > 0 && result[result.length - 1] != '/' {
            result = result + "/"
        }
        result = result + parts[position]
        position = position + 1
    }
    if result == "" {
        result = "."
    }
    return result
}

function directoryOfPath(path: Text): Text {
    let normalized = normalizePath(path)
    let lastSeparator = -1
    let position = 0
    while position < normalized.length {
        if normalized[position] == '/' {
            lastSeparator = position
        }
        position = position + 1
    }
    let directory = ""
    position = 0
    while position < lastSeparator {
        directory = directory + Text(normalized[position])
        position = position + 1
    }
    if lastSeparator == 0 {
        directory = "/"
    }
    return directory
}

function resolveModulePath(importer: Text, specifier: Text): Text {
    let relative = false
    if specifier.length >= 2 && specifier[0] == '.' && pathCharacterIsSeparator(specifier[1]) {
        relative = true
    }
    if specifier.length >= 3 && specifier[0] == '.' && specifier[1] == '.' && pathCharacterIsSeparator(specifier[2]) {
        relative = true
    }
    if !relative {
        failCompiler("package module '" + specifier + "' is not available yet; local modules begin with './' or '../'")
    }
    let directory = directoryOfPath(importer)
    if directory == "" {
        return normalizePath(specifier)
    }
    return normalizePath(directory + "/" + specifier)
}

function resolveImport(importer: Text, specifier: Text, library: Text): Text {
    let relative = specifier.length >= 2 && specifier[0] == '.' && (pathCharacterIsSeparator(specifier[1]) || specifier[1] == '.')
    if relative || library == "" {
        return resolveModulePath(importer, specifier)
    }
    let split = findCharacter(library, '\n')
    if split >= 0 {
        let first = library.slice(0, split)
        let candidate = resolveImport(importer, specifier, first)
        if io.fileExists(candidate) { return candidate }
        return resolveImport(importer, specifier, library.slice(split + 1, library.length))
    }
    let position = 0
    while position < specifier.length {
        let character = specifier[position]
        if !characterIsLetter(character) && !characterIsDigit(character) && character != '-' && character != '_' {
            failCompiler("package names use letters, digits, '-', and '_'; found '" + specifier + "'")
        }
        position = position + 1
    }
    return normalizePath(library + "/" + specifier + ".min")
}

function findText(values: List<Text>, wanted: Text): Integer {
    let position = 0
    let found = -1
    while position < values.length && found < 0 {
        if values[position] == wanted {
            found = position
        }
        position = position + 1
    }
    return found
}

function findModuleImport(importOwners: List<Integer>, importAliases: List<Text>, owner: Integer, alias: Text): Integer {
    let position = 0
    let found = -1
    while position < importOwners.length && found < 0 {
        if importOwners[position] == owner && importAliases[position] == alias {
            found = position
        }
        position = position + 1
    }
    return found
}

function loadModule(library: Text, path: Text, isEntry: Boolean, modulePaths: List<Text>, moduleSources: List<Text>, moduleStates: List<Integer>, modulePublic: List<Integer>, moduleTokenStarts: List<Integer>, allTokenKinds: List<Integer>, allTokenTexts: List<Text>, allTokenLines: SourceMap, importOwners: List<Integer>, importAliases: List<Text>, importTargets: List<Integer>, declarationStarts: List<Integer>, declarationEnds: List<Integer>, mode: Integer): Integer {
    let canonicalPath = normalizePath(path)
    let existing = findText(modulePaths, canonicalPath)
    if existing >= 0 {
        if moduleStates[existing] == 1 {
            let cycle = ""
            let position = 0
            while position < modulePaths.length {
                if moduleStates[position] == 1 {
                    if cycle != "" {
                        cycle = cycle + " -> "
                    }
                    cycle = cycle + modulePaths[position]
                }
                position = position + 1
            }
            failCompiler("module import cycle: " + cycle + " -> " + canonicalPath)
        }
        return existing
    }

    let module = modulePaths.length
    modulePaths.add(canonicalPath)
    moduleSources.add(compilerReadSource(canonicalPath))
    moduleStates.add(1)
    modulePublic.add(0)

    moduleTokenStarts.add(allTokenKinds.length)
    allTokenLines.diagnosticPath = canonicalPath
    let moduleMode = 0
    if isEntry { moduleMode = mode }
    tokenizeModuleMode(moduleSources[module], canonicalPath, moduleMode, allTokenKinds, allTokenTexts, allTokenLines)
    let cursor: List<Integer> = [moduleTokenStarts[module]]
    skipTerminators(allTokenKinds, cursor)
    while allTokenKinds[cursor[0]] != 0 {
        if tokenIs(allTokenKinds, allTokenTexts, cursor, "use") {
            let importLine = cursor[0]
            cursor[0] = cursor[0] + 1
            if allTokenKinds[cursor[0]] != 3 {
                failCompiler(canonicalPath + ":" + tokenLocation(allTokenLines, importLine) + ": use expects a quoted module name")
            }
            let specifier = allTokenTexts[cursor[0]]
            cursor[0] = cursor[0] + 1
            if !tokenIs(allTokenKinds, allTokenTexts, cursor, "as") {
                failCompiler(canonicalPath + ":" + tokenLocation(allTokenLines, importLine) + ": use expects 'as' after the module name")
            }
            cursor[0] = cursor[0] + 1
            if allTokenKinds[cursor[0]] != 1 {
                failCompiler(canonicalPath + ":" + tokenLocation(allTokenLines, importLine) + ": use expects a module alias after 'as'")
            }
            let alias = allTokenTexts[cursor[0]]
            cursor[0] = cursor[0] + 1
            if findModuleImport(importOwners, importAliases, module, alias) >= 0 {
                failCompiler(canonicalPath + ":" + tokenLocation(allTokenLines, importLine) + ": module alias '" + alias + "' is already used")
            }
            finishStatement(allTokenKinds, allTokenTexts, allTokenLines, cursor)
            let targetPath = resolveImport(canonicalPath, specifier, library)
            let target = loadModule(library, targetPath, false, modulePaths, moduleSources, moduleStates, modulePublic, moduleTokenStarts, allTokenKinds, allTokenTexts, allTokenLines, importOwners, importAliases, importTargets, declarationStarts, declarationEnds, 0)
            importOwners.add(module)
            importAliases.add(alias)
            importTargets.add(target)
        } else {
            let declarationCursor = cursor[0]
            let hasPublic = false
            if tokenIs(allTokenKinds, allTokenTexts, cursor, "public") {
                hasPublic = true
                modulePublic[module] = 1
                declarationCursor = declarationCursor + 1
            }
            let marker: List<Integer> = [declarationCursor]
            if tokenIs(allTokenKinds, allTokenTexts, marker, "constant") || tokenIs(allTokenKinds, allTokenTexts, marker, "global") || isTypeAliasDeclaration(allTokenKinds, allTokenTexts, marker) || conformanceToAt(allTokenKinds, allTokenTexts, marker[0]) >= 0 {
                declarationStarts.add(declarationCursor)
                if isTypeAliasDeclaration(allTokenKinds, allTokenTexts, marker) { skipTypeAliasDeclaration(allTokenKinds, allTokenTexts, allTokenLines, marker) } else { skipTopLevelStatement(allTokenKinds, allTokenTexts, marker) }
                declarationEnds.add(marker[0])
                cursor[0] = marker[0]
            } else {
            if tokenIs(allTokenKinds, allTokenTexts, marker, "record") || choiceDeclarationAt(allTokenKinds, allTokenTexts, marker[0]) || capabilityDeclarationAt(allTokenKinds, allTokenTexts, marker[0]) || tokenIs(allTokenKinds, allTokenTexts, marker, "function") {
                declarationStarts.add(declarationCursor)
                skipDeclaration(allTokenKinds, allTokenTexts, allTokenLines, marker)
                declarationEnds.add(marker[0])
                cursor[0] = marker[0]
            } else {
                if hasPublic {
                    failCompiler(canonicalPath + ":" + tokenLocation(allTokenLines, cursor[0]) + ": public must describe a function, record, or constant declaration")
                }
                if !isEntry {
                    failCompiler(canonicalPath + ":" + tokenLocation(allTokenLines, cursor[0]) + ": imported modules may contain declarations but not executable top-level statements")
                }
                declarationStarts.add(-1)
                skipTopLevelStatement(allTokenKinds, allTokenTexts, cursor)
            }
            }
        }
        skipTerminators(allTokenKinds, cursor)
    }
    moduleStates[module] = 2
    return module
}

// A whole program's module tag: `minyar_module_` and a digest of the module's
// identity. Token passes read whole-program names as identifiers, so the
// quoted names of module builds cannot be used here.
function wholeProgramModuleTag(identity: Text): Text {
    return "minyar_module_" + genericInstanceDigest(identity)
}

function qualifiedDeclarationName(module: Integer, name: Text, identities: List<Text>): Text {
    let qualified = "minyar_module_" + Text(module) + "_" + name
    // Whole programs tag modules with identifiers (see wholeProgramModuleTag);
    // module builds quote their escaped path identities, which start "nim.".
    if identities.length > 0 && identities[module].startsWith("minyar_module_") { qualified = identities[module] + "_" + name }
    else if identities.length > 0 {
        qualified = "\".minyar.fn.minyar.module|" + name + "|" + identities[module] + "\""
    }
    if module == 0 && name == "main" {
        qualified = "main"
    }
    return qualified
}

function findModuleDeclaration(declarationOwners: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, owner: Integer, name: Text, kind: Integer): Integer {
    let position = 0
    let found = -1
    while position < declarationOwners.length && found < 0 {
        if declarationOwners[position] == owner && declarationNames[position] == name && declarationKinds[position] == kind {
            found = position
        }
        position = position + 1
    }
    return found
}

// kinds holds owner * 4 + kind; owners holds owner * 4, indexing names by owner alone.
record ModuleDeclarationIndex { names: List<Text>; kinds: List<Integer>; slots: List<Integer>; owners: List<Integer>; ownerSlots: List<Integer> }

function buildModuleDeclarationIndex(owners: List<Integer>, names: List<Text>, kinds: List<Integer>): ModuleDeclarationIndex {
    let identities: List<Integer> = []
    let position = 0
    while position < names.length {
        // Cache naturals are smaller still; keep composite hashing within Integer.
        if owners[position] < 0 || owners[position] > 2147483647 || kinds[position] < 1 || kinds[position] > 3 { failCompiler("invalid compiled module type table") }
        identities.add(owners[position] * 4 + kinds[position])
        position = position + 1
    }
    let ownerKeys: List<Integer> = []
    position = 0
    while position < names.length {
        ownerKeys.add(owners[position] * 4)
        position = position + 1
    }
    return ModuleDeclarationIndex { names: names; kinds: identities; slots: buildDeclarationIndex(names, identities); owners: ownerKeys; ownerSlots: buildDeclarationIndex(names, ownerKeys) }
}

// Whether owner declares name as any kind. An index without an owner table
// answers true, so callers fall back to their full lookups.
function moduleDeclaresName(index: ModuleDeclarationIndex, owner: Integer, name: Text): Boolean {
    if index.ownerSlots.length == 0 || owner < 0 || owner > 2147483647 { return true }
    return findIndexedSymbol(index.ownerSlots, index.names, index.owners, name, owner * 4) >= 0
}

function findIndexedModuleDeclaration(index: ModuleDeclarationIndex, owner: Integer, name: Text, kind: Integer): Integer {
    if owner < 0 || owner > 2147483647 || kind < 1 || kind > 3 { return -1 }
    return findIndexedSymbol(index.slots, index.names, index.kinds, name, owner * 4 + kind)
}

function requireUniqueModuleDeclarations(index: ModuleDeclarationIndex, declarationLocations: List<Text>) {
    let position = 0
    while position < index.names.length {
        if findIndexedSymbol(index.slots, index.names, index.kinds, index.names[position], index.kinds[position]) != position {
            failAtLocation("", declarationLocations[position], "module declares '" + index.names[position] + "' more than once")
        }
        position = position + 1
    }
}

function collectModuleDeclarations(module: Integer, modulePath: Text, tokenStart: Integer, tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, declarationOwners: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, declarationPublic: List<Integer>, declarationQualifiedNames: List<Text>, declarationLocations: List<Text>, identities: List<Text>) {
    let cursor: List<Integer> = [tokenStart]
    skipTerminators(tokenKinds, cursor)
    while tokenKinds[cursor[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, cursor, "use") {
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
        } else {
            let isPublic = 0
            if tokenIs(tokenKinds, tokenTexts, cursor, "public") {
                isPublic = 1
                cursor[0] = cursor[0] + 1
            }
            let kind = 0
            if tokenIs(tokenKinds, tokenTexts, cursor, "function") {
                kind = 1
            }
            if tokenIs(tokenKinds, tokenTexts, cursor, "record") || choiceDeclarationAt(tokenKinds, tokenTexts, cursor[0]) || isTypeAliasDeclaration(tokenKinds, tokenTexts, cursor) || capabilityDeclarationAt(tokenKinds, tokenTexts, cursor[0]) {
                kind = 2
            }
            if tokenIs(tokenKinds, tokenTexts, cursor, "constant") || tokenIs(tokenKinds, tokenTexts, cursor, "global") {
                kind = 3
            }
            if kind > 0 {
                let name = tokenTexts[cursor[0] + 1]
                if kind == 1 && tokenTexts[cursor[0] + 2] == "." {
                    name = methodFunctionName(name, tokenTexts[cursor[0] + 3])
                }
                declarationOwners.add(module)
                declarationNames.add(name)
                declarationKinds.add(kind)
                declarationPublic.add(isPublic)
                declarationQualifiedNames.add(qualifiedDeclarationName(module, name, identities))
                declarationLocations.add(modulePath + ":" + tokenLocation(tokenLines, cursor[0] + 1))
                if kind == 3 || isTypeAliasDeclaration(tokenKinds, tokenTexts, cursor) {
                    if isTypeAliasDeclaration(tokenKinds, tokenTexts, cursor) { skipTypeAliasDeclaration(tokenKinds, tokenTexts, tokenLines, cursor) } else { skipTopLevelStatement(tokenKinds, tokenTexts, cursor) }
                } else {
                    skipDeclaration(tokenKinds, tokenTexts, tokenLines, cursor)
                }
            } else {
                if isPublic == 1 {
                    failCompiler("public must describe a function, record, or constant declaration")
                }
                skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            }
        }
        skipTerminators(tokenKinds, cursor)
    }
}

function importedDeclarationName(module: Integer, alias: Text, name: Text, kind: Integer, modulePath: Text, tokenLines: SourceMap, location: Integer, importOwners: List<Integer>, importAliases: List<Text>, importTargets: List<Integer>, declarationLookup: ModuleDeclarationIndex, declarationNames: List<Text>, declarationKinds: List<Integer>, declarationPublic: List<Integer>, declarationQualifiedNames: List<Text>, identities: List<Text>): Text {
    let imported = findModuleImport(importOwners, importAliases, module, alias)
    if imported < 0 {
        let candidates: List<Text> = []
        let index = 0
        while index < importAliases.length {
            if importOwners[index] == module { candidates.add(importAliases[index]) }
            index = index + 1
        }
        failDiagnostic(spanAtLocation(modulePath, tokenLocation(tokenLines, location)), "I can't find an imported module named '" + alias + "'", "", diagnosticSuggestion(alias, candidates))
    }
    let declaration = findIndexedModuleDeclaration(declarationLookup, importTargets[imported], name, kind)
    if declaration < 0 {
        let declarationKind = "record"
        if kind == 1 {
            declarationKind = "function"
        }
        if kind == 3 {
            declarationKind = "constant"
        }
        let candidates: List<Text> = []
        let index = 0
        while index < declarationNames.length {
            if declarationKinds[index] == kind && declarationPublic[index] != 0 && declarationQualifiedNames[index] == qualifiedDeclarationName(importTargets[imported], declarationNames[index], identities) { candidates.add(declarationNames[index]) }
            index = index + 1
        }
        failDiagnostic(spanAtLocation(modulePath, tokenLocation(tokenLines, location + 2)), "module '" + alias + "' has no " + declarationKind + " named '" + name + "'", "", diagnosticSuggestion(name, candidates))
    }
    if declarationPublic[declaration] == 0 {
        failCompiler(describeLocation(modulePath + ":" + tokenLocation(tokenLines, location)) + ": '" + alias + "." + name + "' is private to its module")
    }
    return declarationQualifiedNames[declaration]
}

function appendModuleTokens(module: Integer, modulePath: Text, tokenStart: Integer, tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, importOwners: List<Integer>, importAliases: List<Text>, importTargets: List<Integer>, declarationLookup: ModuleDeclarationIndex, declarationNames: List<Text>, declarationKinds: List<Integer>, declarationPublic: List<Integer>, declarationQualifiedNames: List<Text>, outputKinds: List<Integer>, outputTexts: List<Text>, outputLines: SourceMap, identities: List<Text>) {
    // Bit 128 survives from earlier modules: some module reads a function as a value.
    let functionValues = outputLines.features / 128 % 2 == 1
    outputLines.features = tokenLines.features
    let origin = sourcePath(outputLines, modulePath)
    let position = tokenStart
    // A name this module declares as a function, read as a value outside the
    // scope of a binding with that name, asks compileTokens to prepare
    // function values. Bindings are tracked only for such names; a binding
    // missed here can only cost a scan, and resolution itself stays with the
    // emitting parser.
    let valueShadows: List<Text> = []
    let valueShadowDepths: List<Integer> = [0]
    let valuePendingName = ""
    let valuePendingDepth = -1
    let declarationMode = 0
    let declarationDepth = 0
    let registerLayoutDeclaration = false
    let interruptDeclaration = false
    let functionHeader = false
    let letDeclaration = false
    let typeMode = false
    let genericDepth = 0
    let callableDepth = 0
    let scopeDepth = 0
    let typeAlias = false
    let typeAliasEnd = 0
    let conformanceType = -1
    let conformanceCapability = -1
    let typeVariables: List<Text> = []
    let typeVariableStart = 0
    let typeVariableEnd = 0

    while tokenKinds[position] != 0 {
        if declarationMode == 0 && tokenKinds[position] == 1 && tokenTexts[position] == "use" {
            let cursor: List<Integer> = [position]
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            while cursor[0] > position + 1 && tokenKinds[cursor[0] - 1] == 6 {
                cursor[0] = cursor[0] - 1
            }
            position = cursor[0]
        } else {
            if declarationMode == 0 && tokenKinds[position] == 1 && tokenTexts[position] == "public" {
                position = position + 1
            } else {
                let token = tokenTexts[position]
                let kind = tokenKinds[position]
                if kind == 6 && valuePendingDepth == scopeDepth {
                    functionValueBinder(valueShadows, valueShadowDepths, valuePendingName, scopeDepth)
                    valuePendingDepth = -1
                }
                if typeAlias && position >= typeAliasEnd { typeAlias = false; typeMode = false; genericDepth = 0 }
                if declarationMode == 0 && scopeDepth == 0 && isTypeAliasAt(tokenKinds, tokenTexts, position) { typeAlias = true; let aliasCursor: List<Integer> = [position]; skipTypeAliasDeclaration(tokenKinds, tokenTexts, tokenLines, aliasCursor); typeAliasEnd = aliasCursor[0] }
                if typeAlias && token == "=" { typeMode = true; genericDepth = 0 }
                if declarationMode == 0 && scopeDepth == 0 && conformanceToAt(tokenKinds, tokenTexts, position) >= 0 {
                    conformanceType = position + 1
                    conformanceCapability = conformanceToAt(tokenKinds, tokenTexts, position) + 1
                }
                if position == conformanceType || position == conformanceCapability { typeMode = true; genericDepth = 0 }
                if declarationMode == 0 && scopeDepth == 0 && capabilityDeclarationAt(tokenKinds, tokenTexts, position) { declarationMode = 3 }
                if declarationMode == 0 && token == "function" && tokenTexts[position + 2] == "." {
                    if isInterruptFunctionAt(tokenKinds, tokenTexts, position) { failAtToken(tokenLines, position, "interrupt handlers cannot be record methods") }
                    let recordName = tokenTexts[position + 1]
                    let record = findIndexedModuleDeclaration(declarationLookup, module, recordName, 2)
                    if record < 0 { failCompiler(describeLocation(modulePath + ":" + tokenLocation(tokenLines, position)) + ": methods must be declared in the module that declares their record") }
                    let member = tokenTexts[position + 3]
                    if tokenKinds[position + 3] != 1 || tokenTexts[position + 4] != "(" { failCompiler("a method declaration uses function Record.method(parameters)") }
                    let method = findIndexedModuleDeclaration(declarationLookup, module, methodFunctionName(recordName, member), 1)
                    let qualified = declarationQualifiedNames[method]
                    if declarationPublic[method] == 0 { qualified = methodFunctionName(declarationQualifiedNames[record], member + "$private") }
                    copyModuleToken(outputKinds, outputTexts, outputLines, 1, "function", tokenLines, position, origin)
                    copyModuleToken(outputKinds, outputTexts, outputLines, 1, qualified, tokenLines, position + 1, origin)
                    copyModuleToken(outputKinds, outputTexts, outputLines, 4, "(", tokenLines, position + 4, origin)
                    copyModuleToken(outputKinds, outputTexts, outputLines, 1, "self", tokenLines, position + 1, origin)
                    copyModuleToken(outputKinds, outputTexts, outputLines, 4, ":", tokenLines, position + 1, origin)
                    copyModuleToken(outputKinds, outputTexts, outputLines, 1, declarationQualifiedNames[record], tokenLines, position + 1, origin)
                    if tokenTexts[position + 5] != ")" { copyModuleToken(outputKinds, outputTexts, outputLines, 4, ",", tokenLines, position + 4, origin) }
                    position = position + 5
                    declarationMode = 2
                    functionHeader = true
                    token = tokenTexts[position]
                    kind = tokenKinds[position]
                }
                if token == "function" && (tokenTexts[position + 1] == "(" || declarationMode == 3) { functionHeader = true }
                if token == "{" && functionHeader { functionHeader = false }
                let rewritten = token
                let memberSelector = position > tokenStart && tokenTexts[position - 1] == "."

                if declarationMode == 0 && kind == 1 && (token == "record" || (scopeDepth == 0 && choiceDeclarationAt(tokenKinds, tokenTexts, position)) || (token == "function" && tokenTexts[position + 1] != "(")) {
                    typeVariables.clear()
                    typeVariableStart = 0
                    typeVariableEnd = 0
                    if position + 2 < tokenKinds.length && tokenTexts[position + 2] == "<" {
                        typeVariableStart = position + 3
                        typeVariableEnd = typeVariableStart
                        while tokenKinds[typeVariableEnd] != 0 && tokenTexts[typeVariableEnd] != ">" {
                            if tokenKinds[typeVariableEnd] == 1 && (tokenTexts[typeVariableEnd - 1] == "<" || tokenTexts[typeVariableEnd - 1] == ",") { typeVariables.add(tokenTexts[typeVariableEnd]) }
                            typeVariableEnd = typeVariableEnd + 1
                        }
                    }
                    if token == "record" || (scopeDepth == 0 && choiceDeclarationAt(tokenKinds, tokenTexts, position)) {
                        declarationMode = 1
                        registerLayoutDeclaration = registerLayoutWidthAt(tokenKinds, tokenTexts, position) > 0
                    } else {
                        declarationMode = 2
                        interruptDeclaration = isInterruptFunctionAt(tokenKinds, tokenTexts, position)
                        functionHeader = true
                    }
                } else {
                    if kind == 1 && (token == "let" || token == "constant" || token == "global") {
                        letDeclaration = true
                    }
                }

                if kind == 1 && (token == "Map" || token == "Set") && tokenTexts[position + 1] == "<" && !typeMode {
                    typeMode = true
                    genericDepth = 0
                }
                if kind == 1 && (token == "Ok" || token == "Err" || token == "Some" || token == "None" || token == "Maybe") && tokenTexts[position + 1] == "<" && (typeMode || genericHeaderFollows(tokenKinds, tokenTexts, position, "(") || genericHeaderFollows(tokenKinds, tokenTexts, position, ".")) { if !typeMode { genericDepth = 0 }; typeMode = true }
                if kind == 4 && token == ":" && (declarationMode == 1 || functionHeader || letDeclaration) {
                    typeMode = true
                    genericDepth = 0
                }
                if kind == 4 && token == "(" && typeMode { callableDepth = callableDepth + 1 }
                if kind == 4 && token == ")" && callableDepth > 0 { callableDepth = callableDepth - 1 }
                if kind == 4 && token == "->" { typeMode = true }

                if kind == 1 && !memberSelector && position + 2 < tokenKinds.length && tokenTexts[position + 1] == "." {
                    let imported = findModuleImport(importOwners, importAliases, module, token)
                    if imported >= 0 {
                        let wantedKind = 2
                        if position + 3 < tokenKinds.length && tokenTexts[position + 3] == "<" && genericHeaderFollows(tokenKinds, tokenTexts, position + 2, "(") && findIndexedModuleDeclaration(declarationLookup, importTargets[imported], tokenTexts[position + 2], 1) >= 0 {
                            wantedKind = 1
                        }
                        if (position + 3 < tokenKinds.length && tokenTexts[position + 3] == "(") || (position >= 2 && (tokenTexts[position - 2] == "startThread" || tokenTexts[position - 2] == "startThreadResult") && tokenTexts[position - 1] == "(") || sequenceNamedArgumentAt(tokenKinds, tokenTexts, position) {
                            wantedKind = 1
                            let importedFunction = findIndexedModuleDeclaration(declarationLookup, importTargets[imported], tokenTexts[position + 2], 1)
                            let importedConstant = findIndexedModuleDeclaration(declarationLookup, importTargets[imported], tokenTexts[position + 2], 3)
                            if importedFunction < 0 && importedConstant >= 0 { wantedKind = 3 }
                        } else {
                            let importedConstant = findIndexedModuleDeclaration(declarationLookup, importTargets[imported], tokenTexts[position + 2], 3)
                            if !typeMode && importedConstant >= 0 {
                                wantedKind = 3
                            }
                            // `alias.name` read as a value names an imported function.
                            if !typeMode && importedConstant < 0 && findIndexedModuleDeclaration(declarationLookup, importTargets[imported], tokenTexts[position + 2], 2) < 0 && findIndexedModuleDeclaration(declarationLookup, importTargets[imported], tokenTexts[position + 2], 1) >= 0 {
                                wantedKind = 1
                                functionValues = true
                            }
                        }
                        rewritten = importedDeclarationName(module, token, tokenTexts[position + 2], wantedKind, modulePath, tokenLines, position, importOwners, importAliases, importTargets, declarationLookup, declarationNames, declarationKinds, declarationPublic, declarationQualifiedNames, identities)
                        copyModuleToken(outputKinds, outputTexts, outputLines, 1, rewritten, tokenLines, position, origin)
                        position = position + 3
                        if tokenTexts[position] == "<" { if !typeMode { genericDepth = 0 }; typeMode = true }
                        if typeMode && genericDepth == 0 && tokenTexts[position] != "<" {
                            typeMode = false
                        }
                    } else {
                        let localChoice = findIndexedModuleDeclaration(declarationLookup, module, token, 2)
                        if localChoice >= 0 { rewritten = declarationQualifiedNames[localChoice] }
                        else if !typeMode {
                            let localValue = findIndexedModuleDeclaration(declarationLookup, module, token, 3)
                            if localValue >= 0 { rewritten = declarationQualifiedNames[localValue] }
                        }
                        copyModuleToken(outputKinds, outputTexts, outputLines, kind, rewritten, tokenLines, position, origin)
                        position = position + 1
                    }
                } else {
                    let registerFieldAnnotation = registerLayoutDeclaration && declarationDepth == 1 && kind == 1 && token == "at" && tokenTexts[position + 1] == "(" && position > 0 && tokenTexts[position - 1] == "Integer"
                    let interruptBinding = interruptDeclaration && functionHeader && kind == 1 && token == "handles" && tokenTexts[position + 1] == "("
                    // Only names this module declares are renamed or switch to type syntax.
                    if kind == 1 && !memberSelector && !registerFieldAnnotation && !interruptBinding && moduleDeclaresName(declarationLookup, module, token) {
                        let declarationKind = 0
                        if position > 0 && tokenTexts[position - 1] == "function" && declarationMode != 3 {
                            declarationKind = 1
                        }
                        if position > 0 && (tokenTexts[position - 1] == "record" || (scopeDepth == 0 && choiceDeclarationAt(tokenKinds, tokenTexts, position - 1)) || (scopeDepth == 0 && isTypeAliasAt(tokenKinds, tokenTexts, position - 1)) || (declarationMode == 3 && capabilityDeclarationAt(tokenKinds, tokenTexts, position - 1))) {
                            declarationKind = 2
                        }
                        if declarationKind == 0 && position + 1 < tokenKinds.length && tokenTexts[position + 1] == "(" {
                            declarationKind = 1
                        }
                        if declarationKind == 0 && position + 1 < tokenKinds.length && tokenTexts[position + 1] == "<" && (typeMode || genericHeaderFollows(tokenKinds, tokenTexts, position, "(") || genericHeaderFollows(tokenKinds, tokenTexts, position, "{") || genericHeaderFollows(tokenKinds, tokenTexts, position, ".")) {
                            if findIndexedModuleDeclaration(declarationLookup, module, token, 1) >= 0 { declarationKind = 1 } else {
                                if findIndexedModuleDeclaration(declarationLookup, module, token, 2) >= 0 { declarationKind = 2 }
                            }
                            if declarationKind > 0 { if !typeMode { genericDepth = 0 }; typeMode = true }
                        }
                        if declarationKind == 0 && position >= 2 && (tokenTexts[position - 2] == "parallelEntry" || tokenTexts[position - 2] == "startThread" || tokenTexts[position - 2] == "startThreadResult") && tokenTexts[position - 1] == "(" {
                            declarationKind = 1
                        }
                        if declarationKind == 0 && position >= 2 && isDeclarationOperandBuiltin(tokenTexts[position - 2]) && tokenTexts[position - 1] == "(" { declarationKind = 2 }
                        if declarationKind == 0 && position + 1 < tokenKinds.length && tokenTexts[position + 1] == "{" {
                            declarationKind = 2
                        }
                        if declarationKind == 0 && typeMode {
                            declarationKind = 2
                        }
                        if position > 0 && (tokenTexts[position - 1] == "constant" || tokenTexts[position - 1] == "global") {
                            declarationKind = 3
                        }
                        if declarationKind == 0 && ((position > 0 && (tokenTexts[position - 1] == "let" || tokenTexts[position - 1] == "for")) || (functionHeader && position + 1 < tokenKinds.length && tokenTexts[position + 1] == ":")) {
                            declarationKind = 3
                        }
                        if declarationKind == 0 && !(position + 1 < tokenKinds.length && tokenTexts[position + 1] == ":") {
                            declarationKind = 3
                        }
                        if declarationKind == 2 && !typeMode && !(position > 0 && (tokenTexts[position - 1] == "record" || (scopeDepth == 0 && choiceDeclarationAt(tokenKinds, tokenTexts, position - 1)))) {
                            let blockConstant = findIndexedModuleDeclaration(declarationLookup, module, token, 3)
                            if blockConstant >= 0 {
                                declarationKind = 3
                            }
                        }
                        if declarationKind == 1 && position + 1 < tokenKinds.length && tokenTexts[position + 1] == "(" {
                            let functionDeclaration = findIndexedModuleDeclaration(declarationLookup, module, token, 1)
                            let constantDeclaration = findIndexedModuleDeclaration(declarationLookup, module, token, 3)
                            if functionDeclaration < 0 && constantDeclaration >= 0 { declarationKind = 3 }
                        }
                        if (position >= typeVariableStart && position < typeVariableEnd && (tokenTexts[position - 1] == "<" || tokenTexts[position - 1] == ",")) || (declarationKind == 2 && findText(typeVariables, token) >= 0) { declarationKind = 0 }
                        if builtinCapability(token) && ((position >= typeVariableStart && position < typeVariableEnd && tokenTexts[position - 1] == ":") || position == conformanceCapability) { declarationKind = 0 }
                        if declarationMode == 3 && ((position > 0 && tokenTexts[position - 1] == "function") || token == "Self") { declarationKind = 0 }
                        if declarationKind > 0 {
                            let declaration = findIndexedModuleDeclaration(declarationLookup, module, token, declarationKind)
                            if declaration >= 0 {
                                rewritten = declarationQualifiedNames[declaration]
                            } else if declarationKind == 3 && !typeMode && !functionValues && findIndexedModuleDeclaration(declarationLookup, module, token, 1) >= 0 {
                                let previous = tokenTexts[position - 1]
                                let next = tokenTexts[position + 1]
                                if previous == "let" || previous == "constant" {
                                    valuePendingName = token
                                    valuePendingDepth = scopeDepth
                                } else if previous == "for" || (functionHeader && (previous == "(" || previous == ",") && (next == ":" || next == "," || next == ")")) {
                                    functionValueBinder(valueShadows, valueShadowDepths, token, scopeDepth + 1)
                                } else if functionValuePatternAt(tokenKinds, tokenTexts, position) {
                                    functionValueBinder(valueShadows, valueShadowDepths, token, scopeDepth + 1)
                                } else if previous != "global" && previous != "as" && next != ":" && tokenKinds[position + 1] != 1 && tokenKinds[position + 1] != 3 && !functionValueShadowed(valueShadows, valueShadowDepths, token, declarationMode == 2) {
                                    functionValues = true
                                }
                            }
                        }
                    }
                    copyModuleToken(outputKinds, outputTexts, outputLines, kind, rewritten, tokenLines, position, origin)

                    if typeMode && kind == 1 && token != "Ok" && token != "Err" && token != "Some" && token != "None" && token != "List" && token != "Map" && token != "Set" && token != "Result" && !(token == "deterministic" && tokenTexts[position + 1] == "(") && tokenTexts[position + 1] != "<" && genericDepth == 0 && callableDepth == 0 {
                        typeMode = false
                    }
                    if kind == 4 && token == "<" && typeMode {
                        genericDepth = genericDepth + 1
                    }
                    if kind == 4 && token == ">" && genericDepth > 0 {
                        genericDepth = genericDepth - 1
                        if genericDepth == 0 && callableDepth == 0 {
                            typeMode = false
                        }
                    }
                    if kind == 4 && token == ">>" && genericDepth > 0 {
                        genericDepth = genericDepth - 2
                        if genericDepth <= 0 {
                            genericDepth = 0
                            if callableDepth == 0 { typeMode = false }
                        }
                    }
                    if kind == 6 { typeAlias = false }
                    if kind == 4 && token == "=" || kind == 6 {
                        letDeclaration = false
                    }
                    if kind == 4 && token == "{" && declarationMode > 0 {
                        declarationDepth = declarationDepth + 1
                        if declarationMode == 2 && declarationDepth == 1 {
                            functionHeader = false
                        }
                    }
                    if kind == 4 && token == "}" && declarationMode > 0 {
                        declarationDepth = declarationDepth - 1
                        if declarationDepth == 0 {
                            typeVariables.clear()
                            typeVariableStart = 0
                            typeVariableEnd = 0
                            declarationMode = 0
                            registerLayoutDeclaration = false
                            interruptDeclaration = false
                            functionHeader = false
                            letDeclaration = false
                        }
                    }
                    if kind == 4 && token == "{" { scopeDepth = scopeDepth + 1 }
                    if kind == 4 && token == "}" {
                        while valueShadowDepths[0] > 0 && valueShadowDepths[valueShadowDepths[0]] >= scopeDepth { valueShadowDepths[0] = valueShadowDepths[0] - 1 }
                        if valuePendingDepth >= scopeDepth { valuePendingDepth = -1 }
                        scopeDepth = scopeDepth - 1
                    }
                    position = position + 1
                }
            }
        }
    }
    copyModuleToken(outputKinds, outputTexts, outputLines, 6, "end of module", tokenLines, position, origin)
    if functionValues && outputLines.features / 128 % 2 == 0 { outputLines.features = outputLines.features + 128 }
}


function compileEntry(path: Text, stackOwnerLimit: Integer): Text {
    let functionPieces: List<Integer> = []
    return joinText(compileEntryMode(path, stackOwnerLimit, "", 0, false, functionPieces))
}

// A whole-program build defines imported modules' functions internal unless the
// caller binds to them by symbol (live images; see --export-modules), so clang
// drops the unused ones and optimizes the rest without keeping an exported copy.
// The entry module keeps external linkage for test adapters that bind to it.
// functionPieces receives the piece ranges of the returned module's functions.
function compileEntryMode(path: Text, stackOwnerLimit: Integer, library: Text, mode: Integer, internalImports: Boolean, functionPieces: List<Integer>): List<Text> {
    let identities: List<Text> = []
    let modulePaths: List<Text> = []
    let moduleSources: List<Text> = []
    let moduleStates: List<Integer> = []
    let modulePublic: List<Integer> = []
    let moduleTokenStarts: List<Integer> = []
    let moduleTokenKinds: List<Integer> = []
    let moduleTokenTexts: List<Text> = []
    let moduleTokenLines = newSourceMap()
    moduleTokenLines.inputPath = path
    let importOwners: List<Integer> = []
    let importAliases: List<Text> = []
    let importTargets: List<Integer> = []
    let declarationStarts: List<Integer> = []
    let declarationEnds: List<Integer> = []
    let entry = loadModule(library, path, true, modulePaths, moduleSources, moduleStates, modulePublic, moduleTokenStarts, moduleTokenKinds, moduleTokenTexts, moduleTokenLines, importOwners, importAliases, importTargets, declarationStarts, declarationEnds, mode)
    if modulePaths.length == 1 && modulePublic[0] == 0 && !hasMethodDeclarations(moduleTokenKinds, moduleTokenTexts) {
        // Hand the only module's tokens over; compileTokens may release them.
        moduleTokenLines.stage = 2
        let soleModule = newGenericIndex()
        if internalImports { genericIndexPutKind(soleModule, "whole-program", 7, 1) }
        return compileTokens(moduleTokenKinds, moduleTokenTexts, moduleTokenLines, declarationStarts, declarationEnds, stackOwnerLimit, soleModule, functionPieces)
    }
    // Each module is tagged by its module build identity (stableModuleIdentity: its path from the entry's
    // directory, otherwise its whole path), never by import order or package root order: adding an import or a
    // package keeps every other name, so a live patch sees only the code that changed.
    let identityRoot = directoryOfPath(modulePaths[entry])
    if identityRoot != "" && identityRoot != "/" { identityRoot = identityRoot + "/" }
    let internalModules = newGenericIndex()
    let tagged = newGenericIndex()
    let identity = 0
    while identity < modulePaths.length {
        let tag = wholeProgramModuleTag(stableModuleIdentity(modulePaths[identity], identityRoot))
        if genericIndexGet(tagged, tag) >= 0 { failCompiler("modules " + modulePaths[genericIndexGet(tagged, tag)] + " and " + modulePaths[identity] + " hash to the same name; rename one of them") }
        genericIndexPut(tagged, tag, identity)
        identities.add(tag)
        if internalImports && identity != entry { genericIndexPut(internalModules, tag, 1) }
        identity = identity + 1
    }
    // Marks a whole-program build for analyses over every compiled function
    // (its own kind, so no module tag lookup can match it).
    if internalImports { genericIndexPutKind(internalModules, "whole-program", 7, 1) }

    let declarationOwners: List<Integer> = []
    let declarationNames: List<Text> = []
    let declarationKinds: List<Integer> = []
    let declarationPublic: List<Integer> = []
    let declarationQualifiedNames: List<Text> = []
    let declarationLocations: List<Text> = []
    let module = 0
    while module < modulePaths.length {
        collectModuleDeclarations(module, modulePaths[module], moduleTokenStarts[module], moduleTokenKinds, moduleTokenTexts, moduleTokenLines, declarationOwners, declarationNames, declarationKinds, declarationPublic, declarationQualifiedNames, declarationLocations, identities)
        module = module + 1
    }
    let declarationLookup = buildModuleDeclarationIndex(declarationOwners, declarationNames, declarationKinds)
    requireUniqueModuleDeclarations(declarationLookup, declarationLocations)

    let tokenKinds: List<Integer> = []
    let tokenTexts: List<Text> = []
    let tokenLines = newSourceMap()
    module = 0
    while module < modulePaths.length {
        appendModuleTokens(module, modulePaths[module], moduleTokenStarts[module], moduleTokenKinds, moduleTokenTexts, moduleTokenLines, importOwners, importAliases, importTargets, declarationLookup, declarationNames, declarationKinds, declarationPublic, declarationQualifiedNames, tokenKinds, tokenTexts, tokenLines, identities)
        module = module + 1
    }
    addEndToken(tokenKinds, tokenTexts, tokenLines, "end of program")
    // The module pass looked for function values (bit 128 if it found one).
    if tokenLines.features / 512 % 2 == 0 { tokenLines.features = tokenLines.features + 512 }
    releaseTokens(moduleTokenKinds, moduleTokenTexts, moduleTokenLines)
    tokenLines.stage = 2
    let scannedStarts: List<Integer> = []
    let scannedEnds: List<Integer> = []
    return compileTokens(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds, stackOwnerLimit, internalModules, functionPieces)
}
