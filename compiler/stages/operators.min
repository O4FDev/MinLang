function describeType(type: Integer): Text {
    if type == 1 { return "Integer" }
    if type == 2 { return "Text" }
    if type == 3 { return "Character" }
    if type == 4 { return "Boolean" }
    if type == 5 || type == 6 { return "Nothing" }
    if type == 7 { return "Float" }
    if type == 8 { return "Bytes" }
    if isMapType(type) { return "Map<" + describeType(mapKeyType(type)) + ", " + describeType(mapValueType(type)) + ">" }
    if type == 9 { return "FrozenBytes" }
    if type == 10 { return "BytesChannel" }
    if type == 11 { return "Thread" }
    if type == 12 { return "ThreadStartResult" }
    if type == 13 { return "ThreadJoinResult" }
    if type == 14 { return "FrozenBytesChannel" }
    if type == 15 { return "FrozenBytesResult" }
    if type == 16 { return "NativeRegion" }
    if type == 17 { return "NativeRegions" }
    if type == 18 { return "NativeRegionResult" }
    if isListType(type) { return "List<" + describeType(listElementType(type)) + ">" }
    if isRecordType(type) { return "a record" }
    return "an unknown type"
}

function isArithmeticOperator(operator: Text): Boolean {
    return operator == "+" || operator == "-" || operator == "*" || operator == "/" || operator == "%"
}

function isBitwiseOperator(operator: Text): Boolean {
    return operator == "&" || operator == "|" || operator == "^" || operator == "<<" || operator == ">>"
}

function comparisonCondition(operator: Text, type: Integer): Text {
    if type == 7 {
        if operator == "==" { return "oeq" }
        if operator == "!=" { return "une" }
        if operator == "<" { return "olt" }
        if operator == ">" { return "ogt" }
        if operator == "<=" { return "ole" }
        return "oge"
    }
    if operator == "==" { return "eq" }
    if operator == "!=" { return "ne" }
    if operator == "<" { return "slt" }
    if operator == ">" { return "sgt" }
    if operator == "<=" { return "sle" }
    return "sge"
}

function emitBinary(context: CompilerContext, globals: List<Text>, output: List<Text>, textState: List<Text>, state: List<Integer>, operator: Text, left: Text, leftType: Integer, leftOwner: Integer, right: Text, rightType: Integer, resultType: List<Integer>, locations: SourceMap, location: Integer): Text {
    if leftType != rightType {
        let hint = ""
        if (leftType == 1 && rightType == 7) || (leftType == 7 && rightType == 1) {
            hint = "; convert one side with Float(value) or Integer(value)"
        }
        fail(describeLocation(tokenLocation(locations, location)) + ": " + "the two sides of '" + operator + "' have different types (" + describeType(leftType) + " and " + describeType(rightType) + ")" + hint)
    }
    if isRecordType(leftType) && (operator == "==" || operator == "!=" || operator == "<" || operator == ">" || operator == "<=" || operator == ">=") {
        let capability = "Equatable"
        let operation = "equal"
        if operator != "==" && operator != "!=" { capability = "Ordered"; operation = "compare" }
        requireRecordCapability(context, leftType, capability, location)
        let callee = derivedRecordFunction(context, leftType, operation, globals)
        let value = valueName(textState, newTemporary(state))
        if operation == "equal" {
            output.add("  " + value + " = call zeroext i1 " + callee + "(ptr " + left + ", ptr " + right + ")\n")
            if operator == "!=" { value = emitInstruction(output, textState, state, "xor i1 " + value + ", true") }
        } else {
            let declaration = "declare i64 @minyar_compare_slots(i64, i64, i64)\n"
            if findText(globals, declaration) < 0 { globals.add(declaration) }
            output.add("  " + value + " = call i64 " + callee + "(ptr " + left + ", ptr " + right + ")\n")
            value = emitInstruction(output, textState, state, "icmp " + comparisonCondition(operator, 1) + " i64 " + value + ", 0")
        }
        setType(resultType, 4)
        return value
    }
    if (operator == "==" || operator == "!=") && isMapType(leftType) {
        let comparable = mapValueType(leftType)
        while isMapType(comparable) { comparable = mapValueType(comparable) }
        if comparable != 1 && comparable != 2 && comparable != 3 && comparable != 4 && comparable != 7 {
            fail(describeLocation(tokenLocation(locations, location)) + ": Map equality needs comparable values: Integer, Text, Character, Boolean, Float, or Map")
        }
        let result = valueName(textState, newTemporary(state))
        output.add("  " + result + " = call zeroext i1 @minyar_maps_are_equal(ptr " + left + ", ptr " + right + ", i64 " + Text(mapValueType(leftType)) + ")\n")
        if operator == "!=" { result = emitInstruction(output, textState, state, "xor i1 " + result + ", true") }
        setType(resultType, 4)
        return result
    }
    if (operator == "==" || operator == "!=") && (isRecordType(leftType) || isContainerType(leftType) || leftType == 8) {
        fail(describeLocation(tokenLocation(locations, location)) + ": " + "records, Lists, and Bytes do not yet support equality")
    }
    if isArithmeticOperator(operator) {
        if leftType != 1 && leftType != 7 && !(operator == "+" && leftType == 2) {
            fail(describeLocation(tokenLocation(locations, location)) + ": " + "'" + operator + "' needs Integer or Float operands, not " + describeType(leftType))
        }
    } else {
        if isBitwiseOperator(operator) {
            if leftType != 1 {
                let hint = ""
                if leftType == 4 && (operator == "&" || operator == "|") {
                    hint = "; use " + operator + operator + " for Boolean logic"
                }
                fail(describeLocation(tokenLocation(locations, location)) + ": " + "'" + operator + "' needs Integer operands, not " + describeType(leftType) + hint)
            }
        } else {
            if operator == "==" || operator == "!=" {
                if (leftType < 1 || leftType > 4) && leftType != 7 {
                    fail(describeLocation(tokenLocation(locations, location)) + ": " + "equality needs two values")
                }
            } else {
                if leftType != 1 && leftType != 3 && leftType != 7 {
                    fail(describeLocation(tokenLocation(locations, location)) + ": " + "ordered comparison needs Integer, Float, or Character operands")
                }
            }
        }
    }
    let temporary = newTemporary(state)
    let result = valueName(textState, temporary)

    if operator == "+" && leftType == 2 {
        let runtimeName = "minyar_join_text"
        if takeOwner(output, state, left, leftOwner) {
            runtimeName = "minyar_join_text_take_left"
        }
        output.add("  ")
        output.add(result)
        output.add(" = call ptr @")
        output.add(runtimeName)
        output.add("(ptr ")
        output.add(left)
        output.add(", ptr ")
        output.add(right)
        output.add(")\n")
        setType(resultType, 2)
    } else {
        if (operator == "==" || operator == "!=") && leftType == 2 {
            output.add("  ")
            output.add(result)
            output.add(" = call zeroext i1 @minyar_texts_are_equal(ptr ")
            output.add(left)
            output.add(", ptr ")
            output.add(right)
            output.add(")\n")
            if operator == "!=" {
                let opposite = newTemporary(state)
                output.add("  %value.")
                output.add(Text(opposite))
                output.add(" = xor i1 ")
                output.add(result)
                output.add(", true\n")
                result = valueName(textState, opposite)
            }
            setType(resultType, 4)
        } else {
            if leftType == 7 && isArithmeticOperator(operator) {
                let instruction = "fadd"
                if operator == "-" { instruction = "fsub" }
                if operator == "*" { instruction = "fmul" }
                if operator == "/" { instruction = "fdiv" }
                if operator == "%" { instruction = "frem" }
                output.add("  ")
                output.add(result)
                output.add(" = ")
                output.add(instruction)
                output.add(" double ")
                output.add(left)
                output.add(", ")
                output.add(right)
                output.add("\n")
                setType(resultType, 7)
            } else {
            if operator == "+" || operator == "-" || operator == "*" {
                let operation = "sadd"
                if operator == "-" {
                    operation = "ssub"
                }
                if operator == "*" {
                    operation = "smul"
                }
                let number = Text(temporary)
                output.add("  %checked.")
                output.add(number)
                output.add(" = call { i64, i1 } @llvm.")
                output.add(operation)
                output.add(".with.overflow.i64(i64 ")
                output.add(left)
                output.add(", i64 ")
                output.add(right)
                output.add(")\n")
                output.add("  ")
                output.add(result)
                output.add(" = extractvalue { i64, i1 } %checked.")
                output.add(number)
                output.add(", 0\n")
                output.add("  %overflow.")
                output.add(number)
                output.add(" = extractvalue { i64, i1 } %checked.")
                output.add(number)
                output.add(", 1\n")
                output.add("  call void @.minyar.integer.overflow.checked(i1 %overflow.")
                output.add(number)
                output.add(")\n")
                setType(resultType, 1)
            } else {
                if operator == "/" || operator == "%" {
                    output.add("  call void @.minyar.integer.division.checked(i64 ")
                    output.add(left)
                    output.add(", i64 ")
                    output.add(right)
                    output.add(")\n")
                    let instruction = "sdiv"
                    if operator == "%" {
                        instruction = "srem"
                    }
                    output.add("  ")
                    output.add(result)
                    output.add(" = ")
                    output.add(instruction)
                    output.add(" i64 ")
                    output.add(left)
                    output.add(", ")
                    output.add(right)
                    output.add("\n")
                    setType(resultType, 1)
                } else {
                    if isBitwiseOperator(operator) {
                        let instruction = "and"
                        if operator == "|" { instruction = "or" }
                        if operator == "^" { instruction = "xor" }
                        if operator == "<<" || operator == ">>" {
                            output.add("  call void @.minyar.shift.checked(i64 ")
                            output.add(right)
                            output.add(")\n")
                            instruction = "shl"
                            if operator == ">>" { instruction = "ashr" }
                        }
                        output.add("  ")
                        output.add(result)
                        output.add(" = ")
                        output.add(instruction)
                        output.add(" i64 ")
                        output.add(left)
                        output.add(", ")
                        output.add(right)
                        output.add("\n")
                        setType(resultType, 1)
                    } else {
                        output.add("  ")
                        output.add(result)
                        if leftType == 7 {
                            output.add(" = fcmp ")
                        } else {
                            output.add(" = icmp ")
                        }
                        output.add(comparisonCondition(operator, leftType))
                        output.add(" ")
                        output.add(llvmType(leftType))
                        output.add(" ")
                        output.add(left)
                        output.add(", ")
                        output.add(right)
                        output.add("\n")
                        setType(resultType, 4)
                    }
                }
            }
            }
        }
    }
    ownResult(output, state, result, resultType)
    return result
}

function parseExpression(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let position = state[0]
    let kind = tokenKinds[position]
    if kind == 1 || kind == 2 || kind == 3 || kind == 5 || kind == 7 {
        let nextKind = tokenKinds[position + 1]
        let boundary = nextKind == 0 || nextKind == 6
        if nextKind == 4 {
            let next = tokenTexts[position + 1]
            boundary = next == "," || next == ")" || next == "]" || next == "}"
        }
        if boundary { return parsePrimary(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType) }
    }
    let left = parseAnd(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    while tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "||") {
        state[0] = state[0] + 1
        requireType(tokenLines, state, resultType[0], 4, "the left side of || must be Boolean")
        let rightLabel = newLabel(state)
        let endLabel = newLabel(state)
        let leftBlock = textState[0]
        output.add("  br i1 ")
        output.add(left)
        output.add(", label %logical.end.")
        output.add(Text(endLabel))
        output.add(", label %logical.right.")
        output.add(Text(rightLabel))
        output.add("\n\n")
        output.add("logical.right.")
        output.add(Text(rightLabel))
        output.add(":\n")
        textState[0] = "logical.right." + Text(rightLabel)
        let rightType: List<Integer> = [0]
        let right = parseAnd(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, rightType)
        requireType(tokenLines, state, rightType[0], 4, "the right side of || must be Boolean")
        let rightBlock = textState[0]
        output.add("  br label %logical.end.")
        output.add(Text(endLabel))
        output.add("\n\nlogical.end.")
        output.add(Text(endLabel))
        output.add(":\n")
        textState[0] = "logical.end." + Text(endLabel)
        let temporary = newTemporary(state)
        left = valueName(textState, temporary)
        output.add("  ")
        output.add(left)
        output.add(" = phi i1 [ true, %")
        output.add(leftBlock)
        output.add(" ], [ ")
        output.add(right)
        output.add(", %")
        output.add(rightBlock)
        output.add(" ]\n")
        resultType[0] = 4
    }
    return left
}

function parseAnd(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let left = parseBinary(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType, 1)
    while tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "&&") {
        state[0] = state[0] + 1
        requireType(tokenLines, state, resultType[0], 4, "the left side of && must be Boolean")
        let rightLabel = newLabel(state)
        let endLabel = newLabel(state)
        let leftBlock = textState[0]
        output.add("  br i1 ")
        output.add(left)
        output.add(", label %logical.right.")
        output.add(Text(rightLabel))
        output.add(", label %logical.end.")
        output.add(Text(endLabel))
        output.add("\n\n")
        output.add("logical.right.")
        output.add(Text(rightLabel))
        output.add(":\n")
        textState[0] = "logical.right." + Text(rightLabel)
        let rightType: List<Integer> = [0]
        let right = parseBinary(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, rightType, 1)
        requireType(tokenLines, state, rightType[0], 4, "the right side of && must be Boolean")
        let rightBlock = textState[0]
        output.add("  br label %logical.end.")
        output.add(Text(endLabel))
        output.add("\n\nlogical.end.")
        output.add(Text(endLabel))
        output.add(":\n")
        textState[0] = "logical.end." + Text(endLabel)
        let temporary = newTemporary(state)
        left = valueName(textState, temporary)
        output.add("  ")
        output.add(left)
        output.add(" = phi i1 [ false, %")
        output.add(leftBlock)
        output.add(" ], [ ")
        output.add(right)
        output.add(", %")
        output.add(rightBlock)
        output.add(" ]\n")
        resultType[0] = 4
    }
    return left
}

function operatorLevel(tokenKinds: List<Integer>, tokenTexts: List<Text>, state: List<Integer>): Integer {
    let level = 0
    if tokenKinds[state[0]] == 4 {
        let token = tokenTexts[state[0]]
        if token == "*" || token == "/" || token == "%" {
            level = 8
        } else {
            if token == "+" || token == "-" {
                level = 7
            } else {
                if token == "<<" || token == ">>" { level = 6 } else {
                if token == "&" { level = 5 } else {
                if token == "^" { level = 4 } else {
                if token == "|" { level = 3 } else {
                if token == "<" || token == ">" || token == "<=" || token == ">=" { level = 2 } else {
                    if token == "==" || token == "!=" { level = 1 }
                }
                }
                }
                }
                }
            }
        }
    }
    return level
}

function parseBinary(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>, minimumLevel: Integer): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let left = parseUnary(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    let level = operatorLevel(tokenKinds, tokenTexts, state)
    while level >= minimumLevel && level > 0 {
        let operator = tokenTexts[state[0]]
        let operatorLocation = state[0]
        state[0] = state[0] + 1
        let leftType = resultType[0]
        let leftOwner = -1
        if resultType.length > 1 {
            leftOwner = resultType[1]
        }
        if isRecordType(leftType) { borrowReference(output, state, left, leftType, context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes) }
        if isMapType(leftType) {
            let declaration = "declare zeroext i1 @minyar_maps_are_equal(ptr, ptr, i64)\n"
            if findText(globals, declaration) < 0 { globals.add(declaration) }
            borrowReference(output, state, left, leftType, context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes)
        }
        setType(resultType, 0)
        let right = parseBinary(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType, level + 1)
        left = emitBinary(context, globals, output, textState, state, operator, left, leftType, leftOwner, right, resultType[0], resultType, tokenLines, operatorLocation)
        level = operatorLevel(tokenKinds, tokenTexts, state)
    }
    return left
}

function checkedIntegerLiteral(digits: Text, negative: Boolean, locations: SourceMap, location: Integer): Text {
    let first = 0
    while first + 1 < digits.length && digits[first] == '0' {
        first = first + 1
    }
    let canonical = digits
    if first > 0 {
        canonical = digits.slice(first, digits.length)
    }
    let limit = "9223372036854775807"
    if negative {
        limit = "9223372036854775808"
    }
    if canonical.length > 19 || (canonical.length == 19 && compareText(canonical, limit) > 0) {
        fail(describeLocation(tokenLocation(locations, location)) + ": Integer literal is outside the supported range")
    }
    return canonical
}

function compareFloatSignificand(literal: Text, end: Integer, boundary: Text): Integer {
    let digit = 0
    while literal[digit] == '0' || literal[digit] == '.' { digit = digit + 1 }
    let index = 0
    while index < boundary.length || digit < end {
        if digit < end && literal[digit] == '.' { digit = digit + 1 }
        let left = '0'
        let right = '0'
        if digit < end { left = literal[digit] }
        if index < boundary.length { right = boundary[index] }
        if left < right { return -1 }
        if left > right { return 1 }
        digit = digit + 1
        index = index + 1
    }
    return 0
}

function checkedFloatLiteral(literal: Text, locations: SourceMap, location: Integer): Text {
    let position = 0
    let significant = false
    let integerDigits = 0
    while position < literal.length && literal[position] != '.' {
        if significant || literal[position] != '0' {
            significant = true
            integerDigits = integerDigits + 1
        }
        position = position + 1
    }
    let decimalPoint = position
    position = position + 1
    let fractionZeros = 0
    while position < literal.length && literal[position] != 'e' && literal[position] != 'E' {
        if !significant {
            if literal[position] == '0' {
                fractionZeros = fractionZeros + 1
            } else {
                significant = true
            }
        }
        position = position + 1
    }
    let mantissaEnd = position
    let exponent = 0
    let exponentLimit = literal.length + 325
    let negativeExponent = false
    if position < literal.length {
        position = position + 1
        if literal[position] == '-' || literal[position] == '+' {
            negativeExponent = literal[position] == '-'
            position = position + 1
        }
        while position < literal.length {
            if exponent < exponentLimit {
                let digit = findCharacter("0123456789", literal[position])
                if exponent > (exponentLimit - digit) / 10 {
                    exponent = exponentLimit
                } else {
                    exponent = exponent * 10 + digit
                }
            }
            position = position + 1
        }
    }
    if negativeExponent {
        exponent = -exponent
    }
    if significant {
        let order = exponent - fractionZeros - 1
        if integerDigits > 0 {
            order = exponent + integerDigits - 1
        }
        if order > 308 {
            fail(describeLocation(tokenLocation(locations, location)) + ": Float literal is larger than the largest Float")
        }
        if order == 308 {
            let midpoint = ""
            if compareFloatSignificand(literal, mantissaEnd, midpoint) >= 0 {
                fail(describeLocation(tokenLocation(locations, location)) + ": Float literal is larger than the largest Float")
            }
        }
        if order < -324 { return "0.0" }
        if order == -324 {
            let midpoint = ""
            if compareFloatSignificand(literal, mantissaEnd, midpoint) <= 0 { return "0.0" }
        }
        let first = 0
        while literal[first] == '0' || literal[first] == '.' { first = first + 1 }
        let end = mantissaEnd
        while end > first + 1 && (literal[end - 1] == '0' || literal[end - 1] == '.') {
            end = end - 1
        }
        let tail = ""
        if decimalPoint >= first + 1 && decimalPoint < end {
            tail = literal.slice(first + 1, decimalPoint) + literal.slice(decimalPoint + 1, end)
        } else {
            tail = literal.slice(first + 1, end)
        }
        if tail.length == 0 { tail = "0" }
        return literal.slice(first, first + 1) + "." + tail + "e" + Text(order)
    }
    return "0.0"
}

function parseUnary(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let value = ""
    if tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "!" || tokenTexts[state[0]] == "-" || tokenTexts[state[0]] == "~") {
        let operator = tokenTexts[state[0]]
        state[0] = state[0] + 1
        if operator == "-" && tokenKinds[state[0]] == 2 {
            let digits = checkedIntegerLiteral(tokenTexts[state[0]], true, tokenLines, state[0])
            state[0] = state[0] + 1
            setType(resultType, 1)
            return "-" + digits
        }
        if operator == "-" && tokenKinds[state[0]] == 7 {
            let literal = checkedFloatLiteral(tokenTexts[state[0]], tokenLines, state[0])
            state[0] = state[0] + 1
            setType(resultType, 7)
            return "-" + literal
        }
        let rightType: List<Integer> = [0]
        let right = parseUnary(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, rightType)
        let temporary = newTemporary(state)
        value = valueName(textState, temporary)
        if operator == "!" {
            requireType(tokenLines, state, rightType[0], 4, "logical not needs a Boolean")
            output.add("  ")
            output.add(value)
            output.add(" = xor i1 ")
            output.add(right)
            output.add(", true\n")
            setType(resultType, 4)
        } else {
        if operator == "~" {
            requireType(tokenLines, state, rightType[0], 1, "bitwise not needs an Integer")
            output.add("  ")
            output.add(value)
            output.add(" = xor i64 ")
            output.add(right)
            output.add(", -1\n")
            setType(resultType, 1)
        } else {
        if rightType[0] == 7 {
            output.add("  ")
            output.add(value)
            output.add(" = fneg double ")
            output.add(right)
            output.add("\n")
            setType(resultType, 7)
        } else {
            requireType(tokenLines, state, rightType[0], 1, "negation needs an Integer or Float")
            let number = Text(temporary)
            output.add("  %checked.")
            output.add(number)
            output.add(" = call { i64, i1 } @llvm.ssub.with.overflow.i64(i64 0, i64 ")
            output.add(right)
            output.add(")\n")
            output.add("  ")
            output.add(value)
            output.add(" = extractvalue { i64, i1 } %checked.")
            output.add(number)
            output.add(", 0\n")
            output.add("  %overflow.")
            output.add(number)
            output.add(" = extractvalue { i64, i1 } %checked.")
            output.add(number)
            output.add(", 1\n")
            output.add("  call void @.minyar.integer.overflow.checked(i1 %overflow.")
            output.add(number)
            output.add(")\n")
            setType(resultType, 1)
        }
        }
        }
    } else {
        value = parsePrimary(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    }
    return value
}

function bytesKindSuffix(kind: Text): Text {
    if kind == "Int16" { return "int16" }
    if kind == "UInt16" { return "uint16" }
    if kind == "Int32" { return "int32" }
    if kind == "UInt32" { return "uint32" }
    if kind == "Int64" { return "int64" }
    if kind == "Float32" { return "float32" }
    if kind == "Float64" { return "float64" }
    return ""
}

function parseBytesMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, member: Text, memberLocation: Integer, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let values: List<Text> = []
    values.add(receiver)
    let types: List<Integer> = [8]
    while !tokenIs(tokenKinds, tokenTexts, state, ")") {
        let argumentType: List<Integer> = [0]
        values.add(parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType))
        types.add(argumentType[0])
        if tokenIs(tokenKinds, tokenTexts, state, ",") {
            state[0] = state[0] + 1
        }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    let expected: List<Integer> = [8]
    let callee = ""
    let returnType = 5
    if member == "add" {
        callee = "minyar_bytes_add"
        expected.add(1)
    }
    if member == "addBytes" {
        callee = "minyar_bytes_append"
        expected.add(8)
    }
    if member == "clear" {
        callee = "minyar_bytes_clear"
    }
    if member == "resize" {
        callee = "minyar_bytes_resize"
        expected.add(1)
    }
    if member == "slice" {
        callee = "minyar_bytes_slice"
        expected.add(1)
        expected.add(1)
        returnType = 8
    }
    if callee == "" && member.length > 3 {
        let verb = member.slice(0, 3)
        let suffix = bytesKindSuffix(member.slice(3, member.length))
        let valueType = 1
        if member[3] == 'F' {
            valueType = 7
        }
        if suffix != "" && (verb == "add" || verb == "get" || verb == "set") {
            callee = "minyar_bytes_" + verb + "_" + suffix
            if verb == "add" {
                expected.add(valueType)
            }
            if verb == "get" {
                expected.add(1)
                returnType = valueType
            }
            if verb == "set" {
                expected.add(1)
                expected.add(valueType)
            }
        }
    }
    if callee == "" {
        fail(describeLocation(tokenLocation(tokenLines, memberLocation)) + ": Bytes has no method named '" + member + "'")
    }
    let matches = values.length == expected.length
    let position = 1
    while matches && position < values.length {
        if types[position] != expected[position] {
            matches = false
        }
        position = position + 1
    }
    if !matches {
        let wanted = ""
        position = 1
        while position < expected.length {
            if position > 1 {
                wanted = wanted + ", "
            }
            wanted = wanted + describeType(expected[position])
            position = position + 1
        }
        fail(describeLocation(tokenLocation(tokenLines, memberLocation)) + ": Bytes." + member + " expects (" + wanted + ")")
    }
    setType(resultType, returnType)
    return emitCall(output, textState, state, returnType, callee, values, types)
}

function callAt(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: Integer): Boolean {
    if tokenKinds[cursor + 1] != 4 || tokenTexts[cursor + 1] != "(" { return false }
    if tokenKinds[cursor] == 1 { return true }
    return tokenKinds[cursor] == 4 && (tokenTexts[cursor] == ")" || tokenTexts[cursor] == "]" || tokenTexts[cursor] == "}")
}

function statementWithoutCalls(tokenKinds: List<Integer>, tokenTexts: List<Text>, position: Integer): Boolean {
    let cursor = position
    let depth = 0
    while tokenKinds[cursor] != 0 && (tokenKinds[cursor] != 6 || depth > 0) {
        if callAt(tokenKinds, tokenTexts, cursor) {
            return false
        }
        if tokenKinds[cursor] == 4 {
            let text = tokenTexts[cursor]
            if text == "(" || text == "[" || text == "{" {
                depth = depth + 1
            }
            if text == ")" || text == "]" || text == "}" {
                if depth == 0 {
                    return true
                }
                depth = depth - 1
            }
        }
        cursor = cursor + 1
    }
    return true
}
