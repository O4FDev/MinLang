function simpleTypeCode(name: Text): Integer {
    let code = 0
    if name == "Integer" {
        code = 1
    } else {
        if name == "Text" {
            code = 2
        } else {
            if name == "Character" {
                code = 3
            } else {
                if name == "Boolean" {
                    code = 4
                } else {
                    if name == "Nothing" {
                        code = 5
                    }
                    if name == "Float" {
                        code = 7
                    }
                    if name == "Bytes" {
                        code = 8
                    }
                }
            }
        }
    }
    if code != 0 { return code }
    if name == "FrozenBytes" { code = 9 }
    if name == "BytesChannel" { code = 10 }
    if name == "Thread" { code = 11 }
    if name == "ThreadStartResult" { code = 12 }
    if name == "ThreadJoinResult" { code = 13 }
    if name == "FrozenBytesChannel" { code = 14 }
    if name == "FrozenBytesResult" { code = 15 }
    if name == "NativeRegion" { code = 16 }
    if name == "NativeRegions" { code = 17 }
    if name == "NativeRegionResult" { code = 18 }
    return code
}

function findSymbol(symbolNames: List<Text>, symbolKinds: List<Integer>, name: Text, kind: Integer): Integer {
    let position = 0
    let found = -1
    while position < symbolNames.length && found == -1 {
        if symbolKinds[position] == kind && symbolNames[position] == name {
            found = position
        }
        position = position + 1
    }
    return found
}

function compareText(left: Text, right: Text): Integer {
    let shared = left.length
    if right.length < shared {
        shared = right.length
    }
    let position = 0
    while position < shared && left[position] == right[position] {
        position = position + 1
    }
    if position < shared {
        if left[position] < right[position] {
            return -1
        }
        return 1
    }
    if left.length < right.length {
        return -1
    }
    if left.length > right.length {
        return 1
    }
    return 0
}

function compareSymbolName(left: Text, right: Text): Integer {
    let leftBytes = left.byteLength
    let rightBytes = right.byteLength
    if leftBytes != rightBytes {
        if leftBytes < rightBytes { return -1 }
        return 1
    }
    let position = left.length
    let rightLength = right.length
    if position != rightLength {
        if position < rightLength { return -1 }
        return 1
    }
    while position > 0 {
        position = position - 1
        let leftCharacter = left[position]
        let rightCharacter = right[position]
        if leftCharacter != rightCharacter {
            if leftCharacter < rightCharacter { return -1 }
            return 1
        }
    }
    return 0
}

function compareSymbol(symbolNames: List<Text>, symbolKinds: List<Integer>, left: Integer, right: Integer): Integer {
    let order = compareSymbolName(symbolNames[left], symbolNames[right])
    if order == 0 {
        if symbolKinds[left] < symbolKinds[right] {
            order = -1
        } else {
            if symbolKinds[left] > symbolKinds[right] {
                order = 1
            }
        }
    }
    return order
}

function siftSymbolLookup(lookup: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, start: Integer, count: Integer) {
    let root = start
    let searching = true
    while searching {
        let child = root * 2 + 1
        if child >= count {
            searching = false
        } else {
            let selected = child
            if child + 1 < count && compareSymbol(symbolNames, symbolKinds, lookup[child], lookup[child + 1]) < 0 {
                selected = child + 1
            }
            if compareSymbol(symbolNames, symbolKinds, lookup[root], lookup[selected]) < 0 {
                let held = lookup[root]
                lookup[root] = lookup[selected]
                lookup[selected] = held
                root = selected
            } else {
                searching = false
            }
        }
    }
}

function buildSymbolLookup(symbolNames: List<Text>, symbolKinds: List<Integer>): List<Integer> {
    let lookup: List<Integer> = []
    let position = 0
    while position < symbolNames.length {
        lookup.add(position)
        position = position + 1
    }
    let start = lookup.length / 2
    while start > 0 {
        start = start - 1
        siftSymbolLookup(lookup, symbolNames, symbolKinds, start, lookup.length)
    }
    let end = lookup.length
    while end > 1 {
        end = end - 1
        let held = lookup[0]
        lookup[0] = lookup[end]
        lookup[end] = held
        siftSymbolLookup(lookup, symbolNames, symbolKinds, 0, end)
    }
    return lookup
}

// The first slot records the indexed declaration count. Remaining slots form
// an open-addressed table at at most half load; -1 marks an unused bucket.
// Symbol IDs never depend on bucket order, including after a cache reload.
function declarationHash(name: Text, kind: Integer): Integer {
    let hash = 5381 + kind
    let position = 0
    while position < name.length {
        hash = (hash * 65599 + Integer(name[position])) % 2147483647
        position = position + 1
    }
    return hash
}

function appendDeclarationIndex(lookup: List<Integer>, names: List<Text>, kinds: List<Integer>) {
    let capacity = 8
    while capacity < names.length * 2 { capacity = capacity * 2 }
    lookup.add(names.length)
    let position = 0
    while position < capacity { lookup.add(-1); position = position + 1 }
    position = 0
    while position < names.length {
        let bucket = declarationHash(names[position], kinds[position]) % capacity
        let symbol = lookup[1 + bucket]
        while symbol >= 0 && !(kinds[symbol] == kinds[position] && names[symbol] == names[position]) {
            bucket = (bucket + 1) % capacity
            symbol = lookup[1 + bucket]
        }
        if symbol < 0 { lookup[1 + bucket] = position }
        position = position + 1
    }
}

function buildDeclarationIndex(names: List<Text>, kinds: List<Integer>): List<Integer> {
    let lookup: List<Integer> = []
    appendDeclarationIndex(lookup, names, kinds)
    return lookup
}

function findIndexedSymbol(lookup: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, name: Text, kind: Integer): Integer {
    if lookup.length == 0 { return -1 }
    let capacity = lookup.length - 1
    let bucket = declarationHash(name, kind) % capacity
    let symbol = lookup[1 + bucket]
    while symbol >= 0 {
        if symbolKinds[symbol] == kind && symbolNames[symbol] == name { return symbol }
        bucket = (bucket + 1) % capacity
        symbol = lookup[1 + bucket]
    }
    return -1
}

function requireUniqueSymbols(sources: SourceMap, lookup: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>) {
    let position = 0
    while position < symbolNames.length {
        if findIndexedSymbol(lookup, symbolNames, symbolKinds, symbolNames[position], symbolKinds[position]) != position {
            failAtLocation(sources.inputPath, symbolLocations[position], "module declares '" + readableDeclarationName(symbolNames[position]) + "' more than once")
        }
        position = position + 1
    }
}

function findCompiledSymbol(symbolNames: List<Text>, symbolKinds: List<Integer>, lookup: List<Integer>, name: Text, kind: Integer): Integer {
    return findIndexedSymbol(lookup, symbolNames, symbolKinds, name, kind)
}

function structuralType(tag: Integer, child: Integer): Integer {
    if child > 576460752303423487 || child < -576460752303423487 {
        fail("generic type nesting exceeds the supported limit")
    }
    let payload = child * 2
    if child < 0 { payload = -child * 2 - 1 }
    return -(payload * 8 + tag)
}

function makeListType(child: Integer): Integer {
    if child < 0 { return structuralType(0, child) }
    if child > 9223372036854675807 { fail("generic type nesting exceeds the supported limit") }
    return 100000 + child
}

function structuralChild(type: Integer): Integer {
    let payload = -type / 8
    if payload % 2 == 0 { return payload / 2 }
    return -(payload / 2) - 1
}

function isMapType(type: Integer): Boolean {
    return type < -8 && (-type % 8) != 0 && (-type % 8) != 6
}

function isSetType(type: Integer): Boolean { return type < -8 && (-type % 8) == 6 }
function setElementType(type: Integer): Integer { return structuralChild(type) }
function makeSetType(element: Integer): Integer { return structuralType(6, element) }

function makeMapType(key: Integer, value: Integer): Integer {
    if !isRecordType(key) { return structuralType(key, value) }
    if value > 576460752303423487 || value < -576460752303423487 { fail("generic type nesting exceeds the supported limit") }
    let payload = value * 2
    if value < 0 { payload = -value * 2 - 1 }
    if payload < 0 || payload > (1152921504606846975 - key) / 100000 { fail("generic type nesting exceeds the supported limit") }
    return -((payload * 100000 + key) * 8 + 5)
}

function mapKeyType(type: Integer): Integer {
    if (-type % 8) == 5 { return (-type / 8) % 100000 }
    return -type % 8
}

function mapValueType(type: Integer): Integer {
    if (-type % 8) != 5 { return structuralChild(type) }
    let payload = -type / 8 / 100000
    if payload % 2 == 0 { return payload / 2 }
    return -(payload / 2) - 1
}

function isContainerType(type: Integer): Boolean { return isListType(type) || isMapType(type) || isSetType(type) }

function containerValueType(type: Integer): Integer {
    if isMapType(type) { return mapValueType(type) }
    if isSetType(type) { return setElementType(type) }
    return listElementType(type)
}

function takeContainerType(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, cursor: List<Integer>, names: List<Text>, symbols: List<Integer>): Integer {
    let frames: List<Integer> = []
    let depth = 0
    let closing = 0
    let needType = true
    let code = 0
    while needType || depth > 0 {
        if needType {
            if closing != 0 { fail("expected a value type") }
            let name = texts[cursor[0]]
            if name == "List" || name == "Map" || name == "Set" {
                cursor[0] = cursor[0] + 1
                expectToken(kinds, texts, lines, cursor, "<")
                while frames.length < (depth + 1) * 3 { frames.add(0) }
                frames[depth * 3] = 0
                if name == "Map" { frames[depth * 3] = 1 }
                if name == "Set" { frames[depth * 3] = 2 }
                frames[depth * 3 + 1] = 0
                depth = depth + 1
            } else {
                code = takeValueType(kinds, texts, lines, cursor, names, symbols)
                needType = false
            }
        } else {
            let frame = (depth - 1) * 3
            if frames[frame] == 1 && frames[frame + 1] == 0 {
                if code != 1 && code != 2 && code != 3 && code != 4 && code != 7 && !isRecordType(code) {
                    fail("Map keys must be Hashable: Integer, Text, Character, Boolean, Float, or a finite Hashable record")
                }
                frames[frame + 2] = code
                frames[frame + 1] = 1
                expectToken(kinds, texts, lines, cursor, ",")
                needType = true
            } else {
                if closing > 0 { closing = closing - 1 } else {
                    if tokenIs(kinds, texts, cursor, ">>") {
                        cursor[0] = cursor[0] + 1
                        closing = 1
                    } else { expectToken(kinds, texts, lines, cursor, ">") }
                }
                if frames[frame] == 0 { code = makeListType(code) } else {
                    if frames[frame] == 2 { code = makeSetType(code) } else { code = makeMapType(frames[frame + 2], code) }
                }
                depth = depth - 1
            }
        }
    }
    if closing != 0 { fail("unexpected extra '>' after a generic type") }
    return code
}

function takeType(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>): Integer {
    let name = tokenTexts[cursor[0]]
    if name == "Callback" && tokenTexts[cursor[0] + 1] == "<" {
        return takeCallbackType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds, false)
    }
    let code = simpleTypeCode(name)
    if name == "List" || name == "Map" || name == "Set" {
        code = takeContainerType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
    } else {
        if code == 0 {
            let record = findIndexedSymbol(tokenLines.symbolLookup, symbolNames, symbolKinds, name, 2)
            if record < 0 {
                fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": unknown type '" + name + "'")
            }
            code = 1000 + record
        }
        cursor[0] = cursor[0] + 1
    }
    return code
}

function takeValueType(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>): Integer {
    let type = takeType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
    if type == 5 {
        fail("Nothing cannot be used as a value type")
    }
    return type
}
