function parseListLiteral(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let functionReturnTypes = context.functionReturnTypes
    let functionParameterCounts = context.functionParameterCounts
    let functionParameterTypes = context.functionParameterTypes
    state[0] = state[0] + 1
    let elementType = 0
    if isListType(resultType[0]) {
        elementType = listElementType(resultType[0])
    }
    let temporary = newTemporary(state)
    let value = valueName(textState, temporary)
    output.add("  ")
    output.add(value)
    let constructor = output.length
    output.add(" = call ptr @minyar_list_new()\n")
    let constructionOwner = -1
    if recoveryEnabled(state) { constructionOwner = keepReference(output, state, value, 100001) }
    let references = false
    if isReferenceType(elementType) {
        noteCycleFixup(output, functionReturnTypes, functionParameterCounts, functionParameterTypes, constructor, makeListType(elementType), 0)
        output.add("  call void @minyar_list_references(ptr ")
        output.add(value)
        output.add(")\n")
        references = true
    }
    skipTerminators(tokenKinds, state)
    while !tokenIs(tokenKinds, tokenTexts, state, "]") {
        if (elementType == 0 || elementType == 1) && integerListItemEnd(tokenKinds, tokenTexts, state[0]) > 0 {
            elementType = 1
            appendIntegerListRun(tokenKinds, tokenTexts, tokenLines, state, textState, output, globals, value)
        } else {
        let itemType: List<Integer> = [elementType]
        let item = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, itemType)
        if itemType[0] == 5 || itemType[0] == 6 {
            fail("Nothing cannot be stored in a List")
        }
        if itemType[0] == 100000 {
            fail("an empty List needs a type, such as List<Text>")
        }
        if elementType == 0 {
            elementType = itemType[0]
        }
        if itemType[0] != elementType {
            fail("all values in a List literal must have the same type")
        }
        if isReferenceType(elementType) && !references {
            noteCycleFixup(output, functionReturnTypes, functionParameterCounts, functionParameterTypes, constructor, makeListType(elementType), 0)
            output.add("  call void @minyar_list_references(ptr ")
            output.add(value)
            output.add(")\n")
            references = true
        }
        let slot = valueAsListSlot(output, textState, state, item, elementType)
        noteCycleFixup(output, functionReturnTypes, functionParameterCounts, functionParameterTypes, output.length, makeListType(elementType), elementType)
        if takeResult(output, state, item, itemType) {
            output.add("  call void @minyar_list_add_take(ptr ")
        } else {
            output.add("  call void @minyar_list_add(ptr ")
        }
        output.add(value)
        output.add(", i64 ")
        output.add(slot)
        output.add(")\n")
        }
        skipTerminators(tokenKinds, state)
        if !tokenIs(tokenKinds, tokenTexts, state, "]") {
            expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
            skipTerminators(tokenKinds, state)
        }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "]")
    setType(resultType, makeListType(elementType))
    if recoveryEnabled(state) { markOwner(resultType, constructionOwner) }
    return value
}

function parseAtom(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let functionNames = context.functionNames
    let symbolKinds = context.symbolKinds
    let functionReturnTypes = context.functionReturnTypes
    let functionParameterCounts = context.functionParameterCounts
    let functionParameterTypes = context.functionParameterTypes
    let tokenIndex = state[0]
    let kind = tokenKinds[tokenIndex]
    let token = tokenTexts[tokenIndex]
    let value = ""

    if token == "function" && tokenTexts[tokenIndex + 1] == "(" {
        return parseClosure(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    }

    if kind == 1 && token == "try" { fail("try is only supported as a binding initializer") }
    if state[15] / 2 % 2 != 0 && kind == 1 && (resultPrefix(token, "minyar_result_ok_") || resultPrefix(token, "minyar_result_err_")) {
        return parseResultConstructor(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    }
    if kind == 1 {
        if token == "Map" && (tokenTexts[tokenIndex + 1] == "<" || tokenTexts[tokenIndex + 1] == "(") {
            declareMapRuntime(globals)
            let type = resultType[0]
            if tokenTexts[tokenIndex + 1] == "<" {
                type = takeType(tokenKinds, tokenTexts, tokenLines, state, functionNames, symbolKinds)
            } else { state[0] = tokenIndex + 1 }
            if !isMapType(type) { fail("Map() needs a contextual Map<K, V> type") }
            expectToken(tokenKinds, tokenTexts, tokenLines, state, "(")
            expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
            value = valueName(textState, newTemporary(state))
            let references = "0"
            if isReferenceType(mapValueType(type)) { references = "1" }
            output.add("  " + value + " = call ptr @minyar_map_new(i64 " + Text(mapKeyType(type)) + ", i64 " + references + ")\n")
            setType(resultType, type)
            if tokenTexts[tokenIndex + 1] == "<" { ownResult(output, state, value, resultType) }
            return value
        }
        if token == "true" || token == "false" {
            value = token
            state[0] = tokenIndex + 1
            setType(resultType, 4)
        } else {
            if tokenTexts[tokenIndex + 1] == "(" {
                value = parseCall(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
            } else {
                if tokenKinds[tokenIndex + 1] == 4 && tokenTexts[tokenIndex + 1] == "{" && findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, token, 2) >= 0 {
                    value = parseRecord(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
                } else {
                    let local = findLocal(localNames, localLengths, state, token)
                    let constant = -1
                    if local < 0 {
                        constant = findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, token, 3)
                        if constant < 0 {
                            fail(describeLocation(tokenLocation(tokenLines, tokenIndex)) + ": I can't find a value named '" + readableDeclarationName(token) + "'")
                        }
                    }
                    if constant >= 0 {
                        if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "constant", functionNames[constant], Text(functionReturnTypes[constant])) }
                        if functionParameterCounts[constant] < 0 {
                            let values: List<Text> = []
                            let types: List<Integer> = []
                            let type = functionReturnTypes[constant]
                            value = emitCall(output, textState, state, type, constantIRName(token, "load"), values, types)
                            context.callTargets.add(-1)
                            state[14] = state[14] + 1
                            recoveryCheckpoint(output, textState, state)
                            setType(resultType, type)
                            borrowReference(output, state, value, type, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                        } else {
                            state[0] = functionParameterCounts[constant]
                            value = parseUnary(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
                        }
                        state[0] = tokenIndex + 1
                    } else {
                    state[0] = tokenIndex + 1
                    let id = localIds[local]
                    if id < 0 {
                        value = output[-id - 1]
                    } else {
                        let temporary = newTemporary(state)
                        value = valueName(textState, temporary)
                        output.add("  ")
                        output.add(value)
                        output.add(" = load ")
                        output.add(llvmType(localTypes[local]))
                        output.add(", ptr %local.")
                        output.add(Text(id))
                        output.add("\n")
                    }
                    setType(resultType, localTypes[local])
                    if !recoveryEnabled(state) && id >= 0 && resultType.length > 3 && resultType[2] == id && resultType[3] == tokenIndex {
                        let owner = output.length
                        output.add("  ; minyar-owned-local-transfer\n")
                        output.add(Text(ownershipSlot(state, id)))
                        markOwner(resultType, owner)
                    }
                    }
                }
            }
        }
    } else {
        if kind == 2 {
            value = checkedIntegerLiteral(token, false, tokenLines, tokenIndex)
            state[0] = tokenIndex + 1
            setType(resultType, 1)
        } else {
        if kind == 7 {
            value = checkedFloatLiteral(token, tokenLines, tokenIndex)
            state[0] = tokenIndex + 1
            setType(resultType, 7)
        } else {
            if kind == 3 {
                if textState[2] == "" {
                    value = "getelementptr (i8, ptr @.text." + Text(tokenIndex) + ", i64 8)"
                } else {
                    value = "getelementptr (i8, ptr @" + literalName(textState[2], tokenIndex, false) + ", i64 8)"
                }
                state[0] = tokenIndex + 1
                if (state[15] / 4 % 2) != 0 {
                    let values: List<Text> = [value]
                    let types: List<Integer> = [2]
                    value = emitCall(output, textState, state, 2, "minyar_thread_text_literal", values, types)
                }
                setType(resultType, 2)
            } else {
                if kind == 5 {
                    state[0] = tokenIndex + 1
                    value = Text(Integer(token[0]))
                    setType(resultType, 3)
                } else {
                    if token == "(" {
                        state[0] = tokenIndex + 1
                        value = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
                        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    } else {
                        if token == "[" {
                            value = parseListLiteral(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
                        } else {
                            fail(describeLocation(tokenLocation(tokenLines, tokenIndex)) + ": expected an expression, found '" + token + "'")
                        }
                    }
                }
            }
        }
        }
    }
    return value
}
