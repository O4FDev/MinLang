// Formatting and source reads happen only when a diagnostic is reported.
function diagnosticWrite(text: Text) { native "runtime" }
function diagnosticSource(path: Text): Text { native "runtime" }
function diagnosticSetJSON(enabled: Boolean) { native "runtime" }
function diagnosticJSON(): Boolean { native "runtime" }

function diagnosticRepeat(text: Text, count: Integer): Text {
    let pieces: List<Text> = []
    let index = 0
    while index < count { pieces.add(text); index = index + 1 }
    return joinText(pieces)
}

function diagnosticLine(source: Text, wanted: Integer): Text {
    let line = 1
    let start = 0
    let position = 0
    while position < source.length {
        if source[position] == '\n' {
            if line == wanted {
                let end = position
                if end > start && source[end - 1] == '\r' { end = end - 1 }
                return source.slice(start, end)
            }
            line = line + 1
            start = position + 1
        }
        position = position + 1
    }
    if line == wanted { return source.slice(start, position) }
    return ""
}

// Columns are Unicode scalars, just as in the lexer. Tabs expand to four
// spaces in both the excerpt and underline. Control bytes cannot affect a TTY.
function diagnosticDisplay(text: Text): Text {
    let pieces: List<Text> = []
    let position = 0
    while position < text.length {
        let character = text[position]
        if character == '\t' { pieces.add("    ") }
        else if Integer(character) < 32 || Integer(character) == 127 { pieces.add("�") }
        else { pieces.add(Text(character)) }
        position = position + 1
    }
    return joinText(pieces)
}

function diagnosticTokenWidth(line: Text, column: Integer): Integer {
    let start = column - 1
    if start < 0 || start >= line.length { return 1 }
    let character = line[start]
    let end = start + 1
    if characterIsLetter(character) || characterIsDigit(character) || character == '_' {
        while end < line.length && (characterIsLetter(line[end]) || characterIsDigit(line[end]) || line[end] == '_') { end = end + 1 }
    } else if character == '"' || character == '\'' {
        while end < line.length && line[end] != character {
            if line[end] == '\\' && end + 1 < line.length { end = end + 1 }
            end = end + 1
        }
        if end < line.length { end = end + 1 }
    } else if end < line.length {
        let pair = line.slice(start, end + 1)
        if pair == "==" || pair == "!=" || pair == "<=" || pair == ">=" || pair == "&&" || pair == "||" || pair == "<<" || pair == ">>" || pair == ".." || pair == "->" || pair == "+=" || pair == "-=" || pair == "*=" || pair == "/=" || pair == "%=" { end = end + 1 }
    }
    return end - start
}

function renderDiagnostic(span: SourceSpan, source: Text, message: Text, label: Text, help: Text): Text {
    let line = diagnosticLine(source, span.line)
    let number = Text(span.line)
    let margin = diagnosticRepeat(" ", number.length + 2)
    let pieces: List<Text> = ["error: " + message + "\n", "  --> " + describeSpan(span) + "\n"]
    if source != "" {
        let start = span.column - 1
        if start > line.length { start = line.length }
        let width = diagnosticTokenWidth(line, span.column)
        let before = diagnosticDisplay(line.slice(0, start))
        let under = "^"
        if start < line.length {
            let end = start + width
            if end > line.length { end = line.length }
            under = diagnosticRepeat("^", diagnosticDisplay(line.slice(start, end)).length)
        }
        pieces.add(margin + "|\n")
        pieces.add(" " + number + " | " + diagnosticDisplay(line) + "\n")
        pieces.add(margin + "| " + diagnosticRepeat(" ", before.length) + under)
        if label != "" { pieces.add(" " + label) }
        pieces.add("\n")
    }
    if help != "" { pieces.add(margin + "= help: " + help + "\n") }
    return joinText(pieces)
}

function failDiagnostic(span: SourceSpan, message: Text, label: Text, help: Text) {
    diagnosticWrite(formatDiagnostic(span, diagnosticSource(span.file), message, label, help))
    diagnosticRaise()
}

// Cached declaration interfaces retain legacy origins. Decode them only on
// failure, using the same full-width span decoder as ordinary syntax nodes.
function spanAtLocation(file: Text, location: Text): SourceSpan {
    let sources = newSourceMap()
    sources.coordinates.add(-1)
    sources.coordinates.add(0)
    sources.origins.add(location)
    return sourceSpan(sources, file, 0, 1)
}

function failAtLocation(file: Text, location: Text, message: Text) {
    failDiagnostic(spanAtLocation(file, location), message, "", "")
}

function failAtSource(sources: SourceMap, source: Text, line: Integer, column: Integer, message: Text) {
    let file = sources.diagnosticPath
    if file == "" { file = sources.inputPath }
    if file == "" { file = "<source>" }
    let span = SourceSpan { file: file, line: line, column: column, firstToken: -1, afterToken: -1 }
    diagnosticWrite(formatDiagnostic(span, source, message, "", ""))
    diagnosticRaise()
}

function diagnosticJsonText(value: Text): Text {
    let pieces: List<Text> = ["\""]
    let hex = "0123456789abcdef"
    let index = 0
    while index < value.length {
        let character = value[index]
        let code = Integer(character)
        if character == '"' { pieces.add("\\\"") }
        else if character == '\\' { pieces.add("\\\\") }
        else if character == '\n' { pieces.add("\\n") }
        else if character == '\r' { pieces.add("\\r") }
        else if character == '\t' { pieces.add("\\t") }
        else if code < 32 { pieces.add("\\u00" + Text(hex[code / 16]) + Text(hex[code % 16])) }
        else { pieces.add(Text(character)) }
        index = index + 1
    }
    pieces.add("\"")
    return joinText(pieces)
}

function renderJSONDiagnostic(span: SourceSpan, source: Text, message: Text, label: Text, help: Text): Text {
    let line = diagnosticLine(source, span.line)
    let end = span.column + diagnosticTokenWidth(line, span.column)
    if span.column > line.length { end = span.column }
    let notes = "[]"
    if help != "" { notes = "[" + diagnosticJsonText(help) + "]" }
    return "{\"version\":1,\"severity\":\"error\",\"message\":" + diagnosticJsonText(message) + ",\"file\":" + diagnosticJsonText(span.file) + ",\"line\":" + Text(span.line) + ",\"column\":" + Text(span.column) + ",\"endLine\":" + Text(span.line) + ",\"endColumn\":" + Text(end) + ",\"sourceLine\":" + diagnosticJsonText(line) + ",\"label\":" + diagnosticJsonText(label) + ",\"help\":" + notes + "}\n"
}

function formatDiagnostic(span: SourceSpan, source: Text, message: Text, label: Text, help: Text): Text {
    if diagnosticJSON() { return renderJSONDiagnostic(span, source, message, label, help) }
    return renderDiagnostic(span, source, message, label, help)
}

// Old callers still carry their original location inside the message. Decode
// that location here while callers move to explicit spans.
function failCompiler(message: Text) {
    let file = "<source>"
    if processInfo.argumentCount() > 0 { file = processInfo.argument(0) }
    let span = SourceSpan { file: file, line: 1, column: 1, firstToken: -1, afterToken: -1 }
    if diagnosticHasJob() {
        let job = diagnosticCurrentJob()
        span = sourceSpan(job.context.tokenLines, job.context.tokenLines.inputPath, job.state[0], job.state[0] + 1)
    }
    let column = message.find(", column ")
    if column >= 0 {
        let end = column + 9
        while end < message.length && characterIsDigit(message[end]) { end = end + 1 }
        if end + 1 < message.length && message[end] == ':' && message[end + 1] == ' ' {
            let start = 0
            if message.length >= 5 && message.slice(0, 5) == "line " { start = 5 }
            span = spanAtLocation(file, message.slice(start, end))
            message = message.slice(end + 2, message.length)
        }
    }
    failDiagnostic(span, message, "", "")
}


// A reusable job keeps recovery at a complete declaration or top-level
// statement. Mutations before a failure can never reach the output file.
record DiagnosticJob {
    mode: Integer
    node: Integer
    context: CompilerContext
    output: List<Text>
    globals: List<Text>
    state: List<Integer>
    textState: List<Text>
    stackOwnerLimit: Integer
    bodyStats: List<Integer>
    flags: List<Integer>
    treeFunctions: List<Integer>
    treeKinds: List<Integer>
    treeCallStarts: List<Integer>
    treeCallEnds: List<Integer>
    treeSlots: List<Integer>
    localNames: List<Text>
    localTypes: List<Integer>
    localIds: List<Integer>
    localLengths: List<Integer>
    poisoned: List<Text>
}
function diagnosticRun(job: DiagnosticJob): Boolean { native "diagnostics" }
function diagnosticHasJob(): Boolean { native "runtime" }
function diagnosticCurrentJob(): DiagnosticJob { native "runtime" }
function diagnosticErrorCount(): Integer { native "runtime" }
function diagnosticRaise() { native "runtime" }
function diagnosticDiscard() { native "runtime" }

function diagnosticCompileJob(job: DiagnosticJob) {
    if job.mode == 0 { compileFunctionDiagnosticJob(job) }
    else {
        job.flags[0] = 0
        if compileStatement(job.context, job.localNames, job.localTypes, job.localIds, job.localLengths, job.state, job.textState, job.output, job.globals, 1) { job.flags[0] = 1 }
        finishStatement(job.context.tokenKinds, job.context.tokenTexts, job.context.tokenLines, job.state)
    }
}

function diagnosticFinish() { if diagnosticErrorCount() > 0 { exit(1) } }

function diagnosticSkipStatement(kinds: List<Integer>, texts: List<Text>, state: List<Integer>, start: Integer) {
    state[0] = start
    skipTopLevelStatement(kinds, texts, state)
    skipTerminators(kinds, state)
    while tokenIs(kinds, texts, state, "else") {
        skipTopLevelStatement(kinds, texts, state)
        skipTerminators(kinds, state)
    }
}

function diagnosticBindingName(kinds: List<Integer>, texts: List<Text>, start: Integer): Text {
    if kinds[start] == 1 && (texts[start] == "let" || texts[start] == "constant") && kinds[start + 1] == 1 { return texts[start + 1] }
    return ""
}

// Suppress only an actually unresolved poisoned value. Field names, method
// names and successful shadowing remain independent and are still checked.
function diagnosticSuppressDependent(wanted: Text) {
    if diagnosticHasJob() {
        let job = diagnosticCurrentJob()
        if job.mode == 1 && findText(job.poisoned, wanted) >= 0 { diagnosticDiscard() }
    }
}
