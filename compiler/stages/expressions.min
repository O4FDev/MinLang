                        failCompiler("the value added to a List has the wrong type")
                    }
                    checkListMutation(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    if possibleCycleType(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes) {
                        output.add("  call void @minyar_rc_enable_cycles()\n")
                    }
                    let slot = valueAsListSlot(output, textState, state, argument, argumentType[0])
                    let transfers = takeResult(output, state, argument, argumentType)
                    if !transfers { reserveLocalTake(context, state, output, argument, argumentNode) }
                    if member == "insert" {
