                    value = parseJoinSpan(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, memberLocation, resultType)
                    viewResult = true
                } else if isMapType(receiverType) || isSetType(receiverType) {
                    if isSetType(receiverType) {
                        value = parseSetMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, resultType)
                    } else { value = parseMapMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, resultType) }
                } else {
                if receiverType == 8 || receiverType == 9 || receiverType == 16 || receiverType == 17 || receiverType == 20 || receiverType == 21 {
                    if receiverType == 20 || receiverType == 21 {
                        value = threadAtomicMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, resultType)
                    } else if receiverType == 16 || receiverType == 17 {
                        value = threadRegionMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, resultType)
                    } else if receiverType == 9 {
                        value = threadFrozenMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, member, resultType)
                    } else {
                    value = parseBytesMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, member, memberLocation, resultType)
                    }
                    ownsResult = isReferenceType(resultType[0])
                } else {
                if isListType(receiverType) && (member == "slice" || member == "truncate" || member == "pop" || member == "removeAt") {
                    value = parseListBasicMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, resultType)
                    ownsResult = isReferenceType(resultType[0])
                } else {
                if receiverType == 2 && member == "trim" && tokenIs(tokenKinds, tokenTexts, state, ")") && takeOwner(output, state, receiver, receiverOwner) {
                    // An owned receiver, such as a fresh slice, is consumed:
                    // a view only this expression holds is trimmed in place.
                    state[0] = state[0] + 1
                    appendTextRuntimeDeclaration(globals, "minyar_text_trim_take", 2, [2])
                    value = emitCall(output, textState, state, 2, "minyar_text_trim_take", [receiver], [2])
                    setType(resultType, 2)
                    ownsResult = true
                } else if (receiverType == 2 && member != "slice" && isTextBasicMethod(member)) || (member.byteLength == 5 && member == "clear" && isListType(receiverType)) {
                    value = parseTextBasicMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, resultType)
                    ownsResult = isReferenceType(resultType[0])
                } else {
                let argumentType: List<Integer> = [0]
                // list.insert(position, value) is list.add(value) after a
                // position check, followed by moving that slot to `position`.
                let insertPosition = ""
                if member == "insert" && isListType(receiverType) {
                    let positionType: List<Integer> = [1]
                    let positionLocation = state[0]
                    insertPosition = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, positionType)
                    requireContextType(context, positionLocation, positionType[0], 1, "List.insert positions must be Integers")
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
                }
                if (member == "add" || member == "appended" || member == "insert") && isListType(receiverType) {
                    argumentType[0] = listElementType(receiverType)
                }
                if member == "addAll" && isListType(receiverType) { argumentType[0] = receiverType }
                let argumentLocation = state[0]
                let argument = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType)
                let argumentNode = context.syntax.lastValue
                if receiverType == 2 && member == "slice" {
                    ownsResult = true
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
                    let endType: List<Integer> = [0]
                    let endLocation = state[0]
                    let end = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, endType)
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    if argumentType[0] != 1 { requireContextType(context, argumentLocation, argumentType[0], 1, "Text.slice positions must be Integers") }
                    if endType[0] != 1 { requireContextType(context, endLocation, endType[0], 1, "Text.slice positions must be Integers") }
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    output.add("  ")
                    output.add(value)
                    output.add(" = call ptr @minyar_text_slice(ptr ")
                    output.add(receiver)
                    output.add(", i64 ")
                    output.add(argument)
                    output.add(", i64 ")
                    output.add(end)
                    output.add(")\n")
                    setType(resultType, 2)
                } else {
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    if member == "appended" && isListType(receiverType) {
                        if argumentType[0] != listElementType(receiverType) {
                            failCompiler("the value appended to a List has the wrong type")
                        }
                        let slot = valueAsListSlot(output, textState, state, argument, argumentType[0])
                        let transfers = takeResult(output, state, argument, argumentType)
                        let runtimeName = "minyar_list_appended"
                        if takeOwner(output, state, receiver, receiverOwner) {
                            runtimeName = "minyar_list_appended_take"
                        }
                        let transferPiece = -1
                        if runtimeName == "minyar_list_appended" && !recoveryEnabled(state) {
                            transferPiece = output.length
                            output.add("")
                        }
                        let temporary = newTemporary(state)
                        value = valueName(textState, temporary)
                        output.add("  ")
                        output.add(value)
                        output.add(" = call ptr @")
                        if transferPiece >= 0 { noteTerminalReuse(context, syntaxNode, transferPiece, output.length, receiver) }
                        noteCycleFixup(output, functionReturnTypes, functionParameterCounts, functionParameterTypes, output.length, receiverType, argumentType[0])
                        output.add(runtimeName)
                        output.add("(ptr ")
                        output.add(receiver)
                        output.add(", i64 ")
                        output.add(slot)
                        output.add(", i64 ")
                        if isReferenceType(argumentType[0]) {
                            output.add("1")
                        } else {
                            output.add("0")
                        }
                        output.add(", i64 ")
                        if transfers {
                            output.add("1")
                        } else {
                            output.add("0")
                        }
                        output.add(")\n")
                        ownsResult = true
                        setType(resultType, receiverType)
                    } else if member == "addAll" && isListType(receiverType) {
                        // Appends every element in order. An owned or last-use
                        // argument that nothing else references gives up its
                        // elements without changing their counts.
