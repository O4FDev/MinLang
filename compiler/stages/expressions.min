function nameInStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, position: Integer, name: Text): Boolean {
    let cursor = position
    let depth = 0
    while tokenKinds[cursor] != 0 && (tokenKinds[cursor] != 6 || depth > 0) {
        if tokenKinds[cursor] == 1 && tokenTexts[cursor] == name && tokenTexts[cursor - 1] != "." && tokenTexts[cursor + 1] != ":" {
            return true
        }
        if tokenKinds[cursor] == 4 {
            let text = tokenTexts[cursor]
            if text == "(" || text == "[" || text == "{" {
                depth = depth + 1
            }
            if text == ")" || text == "]" || text == "}" {
                if depth == 0 {
                    return false
                }
                depth = depth - 1
            }
        }
        cursor = cursor + 1
    }
    return false
}

function sortRuntimeDeclarations(globals: List<Text>) {
    let declaration = "declare void @minyar_list_sort(ptr, i64)\n" + "declare ptr @minyar_list_sorted(ptr, i64, i64)\n" + "declare void @minyar_list_sort_by(ptr, ptr, ptr, i64)\n" + "declare ptr @minyar_list_sorted_by(ptr, ptr, ptr, i64)\n"
    let i = 0
    while i < globals.length {
        if globals[i] == declaration { return }
        i = i + 1
    }
    globals.add(declaration)
}

function sortBorrowReference(output: List<Text>, state: List<Integer>, value: Text, type: Integer, counts: List<Integer>, fields: List<Integer>, returns: List<Integer>) {
    borrowReference(output, state, value, type, counts, fields, returns)
}

function sortComparatorThunk(names: List<Text>, type: Integer, element: Integer, globals: List<Text>): Text {
    return closureSortComparatorThunk(names, type, element, globals)
}

function appendTextRuntimeDeclaration(globals: List<Text>, name: Text, returnType: Integer, types: List<Integer>) {
    let declaration = "declare "
    if returnType == 4 { declaration = declaration + "zeroext " }
    declaration = declaration + llvmType(returnType) + " @" + name + "("
    let index = 0
    while index < types.length {
        if index > 0 { declaration = declaration + ", " }
        declaration = declaration + llvmType(types[index])
        index = index + 1
    }
    declaration = declaration + ")\n"
    let position = 0
    while position < globals.length {
        if globals[position] == declaration { return }
        position = position + 1
    }
    globals.add(declaration)
}

function isTextBasicMethod(member: Text): Boolean {
    return member == "find" || member == "split" || member == "startsWith" || member == "endsWith" || member == "trim" || member == "contains" || member == "replace" || member == "repeat" || member == "padStart" || member == "padEnd" || member == "asciiLowercased" || member == "asciiUppercased"
}

// Argument types of a built-in Text method, after the receiver. `find` also
// accepts an optional Integer start position, handled by its caller.
function textMethodParameters(member: Text): List<Integer> {
    if member == "trim" || member == "asciiLowercased" || member == "asciiUppercased" { return [] }
    if member == "replace" { return [2, 2] }
    if member == "repeat" { return [1] }
    if member == "padStart" || member == "padEnd" { return [1, 2] }
    return [2]
}

function textMethodSignature(member: Text): Text {
    if member == "replace" { return "two Text arguments" }
    if member == "repeat" { return "one Integer count" }
    if member == "padStart" || member == "padEnd" { return "an Integer length and a Text pad" }
    return "one Text argument"
}

function parseTextBasicMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, receiverType: Integer, member: Text, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let values: List<Text> = []
    let types: List<Integer> = []
    values.add(receiver)
    types.add(receiverType)
    let runtimeName = "minyar_list_clear"
    let returnType = 5
    if receiverType == 2 {
        let parameters = textMethodParameters(member)
        let index = 0
        while index < parameters.length {
            if index > 0 { expectToken(tokenKinds, tokenTexts, tokenLines, state, ",") }
            let argumentType: List<Integer> = [0]
            if parameters[index] == 1 { argumentType[0] = 1 }
            let argumentLocation = state[0]
            let argument = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType)
            requireContextType(context, argumentLocation, argumentType[0], parameters[index], "Text." + member + " expects " + textMethodSignature(member))
            values.add(argument)
            types.add(parameters[index])
            index = index + 1
        }
        runtimeName = "minyar_text_trim"
        returnType = 2
        if member == "find" {
            runtimeName = "minyar_text_find"
            returnType = 1
            if tokenIs(tokenKinds, tokenTexts, state, ",") {
                expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
                let startType: List<Integer> = [1]
                let startLocation = state[0]
                let start = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, startType)
                if startType[0] != 1 { requireContextType(context, startLocation, startType[0], 1, "Text.find start positions must be Integers") }
                values.add(start)
                types.add(1)
                runtimeName = "minyar_text_find_from"
            }
        }
        if member == "split" {
            runtimeName = "minyar_text_split"
            returnType = 100002
        }
        if member == "startsWith" {
            runtimeName = "minyar_text_starts_with"
            returnType = 4
        }
        if member == "endsWith" {
            runtimeName = "minyar_text_ends_with"
            returnType = 4
        }
        if member == "contains" {
            runtimeName = "minyar_text_contains"
            returnType = 4
        }
        if member == "replace" { runtimeName = "minyar_text_replace" }
        if member == "repeat" { runtimeName = "minyar_text_repeat" }
        if member == "padStart" { runtimeName = "minyar_text_pad_start" }
        if member == "padEnd" { runtimeName = "minyar_text_pad_end" }
        if member == "asciiLowercased" { runtimeName = "minyar_text_ascii_lowercased" }
        if member == "asciiUppercased" { runtimeName = "minyar_text_ascii_uppercased" }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    setType(resultType, returnType)
    appendTextRuntimeDeclaration(globals, runtimeName, returnType, types)
    return emitCall(output, textState, state, returnType, runtimeName, values, types)
}

function parseListBasicMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, receiverType: Integer, member: Text, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let declaration = "declare void @minyar_list_truncate(ptr, i64)\n" + "declare i64 @minyar_list_pop(ptr)\n" + "declare ptr @minyar_list_slice(ptr, i64, i64, i64)\n"
    if findText(globals, declaration) < 0 { globals.add(declaration) }
    borrowReference(output, state, receiver, receiverType, context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes)
    if member == "pop" {
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        let raw = valueName(textState, newTemporary(state))
        output.add("  " + raw + " = call i64 @minyar_list_pop(ptr " + receiver + ")\n")
        setType(resultType, listElementType(receiverType))
        return slotAsValue(output, textState, state, raw, resultType[0])
    }
    let startType: List<Integer> = [0]
    let startLocation = state[0]
    let start = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, startType)
    if startType[0] != 1 { requireContextType(context, startLocation, startType[0], 1, "List." + member + " positions must be Integers") }
    if member == "truncate" {
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        output.add("  call void @minyar_list_truncate(ptr " + receiver + ", i64 " + start + ")\n")
        setType(resultType, 5)
        return ""
    }
    if member == "removeAt" {
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        appendTextRuntimeDeclaration(globals, "minyar_list_remove_at", 1, [receiverType, 1])
        let removed = valueName(textState, newTemporary(state))
        output.add("  " + removed + " = call i64 @minyar_list_remove_at(ptr " + receiver + ", i64 " + start + ")\n")
        setType(resultType, listElementType(receiverType))
        return slotAsValue(output, textState, state, removed, resultType[0])
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
    let endType: List<Integer> = [0]
    let endLocation = state[0]
    let end = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, endType)
    if endType[0] != 1 { requireContextType(context, endLocation, endType[0], 1, "List.slice positions must be Integers") }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    let value = valueName(textState, newTemporary(state))
    let references = "0"
    if isReferenceType(listElementType(receiverType)) { references = "1" }
    output.add("  " + value + " = call ptr @minyar_list_slice(ptr " + receiver + ", i64 " + start + ", i64 " + end + ", i64 " + references + ")\n")
    setType(resultType, receiverType)
    return value
}

function startsDeclaration(text: Text): Boolean {
    return text.byteLength >= 8 && text[0] == 'd' && text.length >= 8 && text.slice(0, 8) == "declare "
}

function collectRuntimeDeclarations(output: List<Text>, declarations: List<Text>, start: Integer, end: Integer) {
    let pieceIndex = start
    while pieceIndex >= 0 && pieceIndex < end {
        let piece = output[pieceIndex]
        deduplicateGlobalDeclarations(piece, declarations)
        pieceIndex = pieceIndex + 1
    }
}

function hasGlobalDeclarations(globals: List<Text>): Boolean {
    let pieceIndex = 0
    while pieceIndex < globals.length {
        let piece = globals[pieceIndex]
        if startsDeclaration(piece) { return true }
        if piece.byteLength > 0 && piece[0] != '@' && !(piece.byteLength >= 7 && piece[0] == 'd' && piece.slice(0, 7) == "define ") {
        let position = 0
        let scan = true
        while position < piece.length && scan {
            let end = position
            while end < piece.length && piece[end] != '\n' { end = end + 1 }
            let line = piece.slice(position, end)
            if startsDeclaration(line) { return true }
            if line.byteLength > 0 && line[0] != ';' { scan = false }
            position = end + 1
        }
        }
        pieceIndex = pieceIndex + 1
    }
    return false
}

function deduplicateGlobalDeclarations(code: Text, seen: List<Text>): Text {
    let pieces: List<Text> = []
    let position = 0
    while position < code.length {
        let end = position
        while end < code.length && code[end] != '\n' { end = end + 1 }
        if end < code.length { end = end + 1 }
        let line = code.slice(position, end)
        if startsDeclaration(line) {
            if findText(seen, line) < 0 {
                seen.add(line)
                pieces.add(line)
            }
        } else { pieces.add(line) }
        position = end
    }
    return joinText(pieces)
}

function declareMapRuntime(globals: List<Text>) {
    let marker = "; minyar-maps: 1\n"
    if findText(globals, marker) >= 0 { return }
    globals.add(marker)
    globals.add("declare ptr @minyar_map_new(i64, i64)\n")
    globals.add("declare i64 @minyar_map_get(ptr, i64)\n")
    globals.add("declare i64 @minyar_map_get_or(ptr, i64, i64)\n")
    globals.add("declare void @minyar_map_set(ptr, i64, i64)\n")
    globals.add("declare zeroext i1 @minyar_map_has(ptr, i64)\n")
    globals.add("declare zeroext i1 @minyar_map_remove(ptr, i64)\n")
    globals.add("declare i64 @minyar_map_length(ptr)\n")
    globals.add("declare void @minyar_map_clear(ptr)\n")
}

function parseMapMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, receiverType: Integer, member: Text, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    declareMapRuntime(globals)
    if member == "clear" {
        borrowReference(output, state, receiver, receiverType, context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes)
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        output.add("  call void @minyar_map_clear(ptr " + receiver + ")\n")
        setType(resultType, 5)
        return ""
    }
    if member == "getOr" {
        // One probe returning the stored value or the fallback, borrowed like map[key].
        let mapPiece = output.length
        output.add("")
        let mapCalls = context.callTargets.length
        let argumentsStart = state[0]
        let lookupType: List<Integer> = [mapKeyType(receiverType)]
        let lookupKey = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, lookupType)
        requireType(tokenLines, state, lookupType[0], mapKeyType(receiverType), "Map key has the wrong type")
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
        let fallbackType: List<Integer> = [mapValueType(receiverType)]
        let fallbackLocation = state[0]
        let fallback = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, fallbackType)
        requireContextType(context, fallbackLocation, fallbackType[0], mapValueType(receiverType), "Map.getOr needs a fallback of the Map's value type")
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        let lookupSlot = valueAsListSlot(output, textState, state, lookupKey, lookupType[0])
        let fallbackSlot = valueAsListSlot(output, textState, state, fallback, fallbackType[0])
        let hashing = noteHashableCalls(context, lookupType[0], state, textState, output)
        let found = valueName(textState, newTemporary(state))
        output.add("  " + found + " = call i64 @minyar_map_get_or(ptr " + receiver + ", i64 " + lookupSlot + ", i64 " + fallbackSlot + ")\n")
        settleMapBorrow(context, output, state, mapPiece, receiver, receiverType, mapCalls, tokensMakeCall(tokenKinds, tokenTexts, argumentsStart, state[0]))
        if hashing { recoveryCheckpoint(output, textState, state) }
        setType(resultType, mapValueType(receiverType))
        return slotAsValue(output, textState, state, found, resultType[0])
    }
    if member != "has" && member != "remove" { failCompiler("this Map has no method named '" + member + "'") }
    let receiverPiece = output.length
    output.add("")
    let receiverCalls = context.callTargets.length
    let keyStart = state[0]
    let keyType: List<Integer> = [mapKeyType(receiverType)]
    let key = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, keyType)
    requireType(tokenLines, state, keyType[0], mapKeyType(receiverType), "Map key has the wrong type")
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    let slot = valueAsListSlot(output, textState, state, key, keyType[0])
    let custom = noteHashableCalls(context, keyType[0], state, textState, output)
    let value = valueName(textState, newTemporary(state))
    output.add("  " + value + " = call zeroext i1 @minyar_map_" + member + "(ptr " + receiver + ", i64 " + slot + ")\n")
    settleMapBorrow(context, output, state, receiverPiece, receiver, receiverType, receiverCalls, tokensMakeCall(tokenKinds, tokenTexts, keyStart, state[0]))
    if custom { recoveryCheckpoint(output, textState, state) }
    setType(resultType, 4)
    return value
}

function readMapElement(context: CompilerContext, output: List<Text>, textState: List<Text>, state: List<Integer>, map: Text, key: Text, type: Integer, keyType: Integer): Text {
    let custom = noteHashableCalls(context, keyType, state, textState, output)
    let raw = valueName(textState, newTemporary(state))
    output.add("  " + raw + " = call i64 @minyar_map_get(ptr " + map + ", i64 " + key + ")\n")
    if custom { recoveryCheckpoint(output, textState, state) }
    return slotAsValue(output, textState, state, raw, type)
}

// A borrowed value that becomes a whole local binding, assignment, return
// value or List append argument, or the receiver of a Text or List join, hands
// its protecting count to that consumer, which needs a count anyway.
function transfersBorrow(tokenKinds: List<Integer>, tokenTexts: List<Text>, atom: Integer, end: Integer, type: Integer, guardable: Boolean): Boolean {
    if tokenKinds[end] == 4 && tokenTexts[end] == "+" && (type == 2 || isListType(type)) { return true }
    if tokenTexts[end] == "." && tokenTexts[end + 1] == "appended" && tokenTexts[end + 2] == "(" { return true }
    if atom == 0 { return false }
    if atom >= 3 && tokenTexts[atom - 1] == "(" && tokenTexts[atom - 2] == "add" && tokenTexts[atom - 3] == "." && tokenTexts[end] == ")" { return true }
    let whole = tokenKinds[end] == 0 || tokenKinds[end] == 6 || (tokenKinds[end] == 4 && tokenTexts[end] == "}")
    // `let name = local[index]` may borrow through a binding guard instead, as
    // may a guardable `let name = local.field…` path (guardableElementBinding).
    if whole && atom >= 3 && tokenTexts[atom - 1] == "=" && tokenTexts[atom - 3] == "let" && (guardable || (tokenKinds[atom] == 1 && tokenTexts[atom + 1] == "[" && tokenTexts[end - 1] == "]")) { return false }
    return whole && (tokenTexts[atom - 1] == "=" || tokenTexts[atom - 1] == "return")
}

function parsePrimary(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let functionNames = context.functionNames
    let functionReturnTypes = context.functionReturnTypes
    let functionParameterCounts = context.functionParameterCounts
    let functionParameterNames = context.functionParameterNames
    let functionParameterTypes = context.functionParameterTypes
    let atom = state[0]
    let syntaxNode = beginSyntaxNode(context.syntax, syntaxPrimaryKind(tokenKinds, tokenTexts, atom), atom)
    if context.syntax.nodes[syntaxNode].kind == 220 { context.syntax.nodes[syntaxNode].operator = atom }
    let scalarValues = -1
    let value = parseAtom(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    if context.syntax.nodes[syntaxNode].kind == 210 && state[0] == atom + 1 { context.syntax.nodes[syntaxNode].kind = 200 }
    if isRecordType(resultType[0]) && tokenKinds[atom] == 1 && atom + 1 < tokenTexts.length && tokenTexts[atom + 1] == "." {
        let local = findLocal(localNames, localLengths, state, tokenTexts[atom])
        if local >= 0 { scalarValues = scalarRecordValues(state, localIds[local]) }
    }
    if ((state[15] / 4 % 2) != 0 && tokenKinds[atom] == 3 && tokenTexts[atom].length != tokenTexts[atom].byteLength) || (tokenTexts[atom] != "function" && tokenTexts[atom] != "match" && tokenTexts[atom] != "try" && ((tokenKinds[atom] == 1 && tokenTexts[atom + 1] == "(") || (tokenKinds[atom] == 4 && tokenTexts[atom] == "["))) {
        if context.tokenLines.features / 4096 % 2 == 0 || choiceCases(context, resultType[0]).length == 0 || resultType.length == 1 || resultType[1] < 0 {
            ownResult(output, state, value, resultType)
        }
    }

    // A receiver whose method arguments look call-free reserves its temporary
    // count; settleBorrow fills it if compiling those arguments ran user code.
    let deferredPiece = -1
    let deferredValue = ""
    let deferredType = 0
    let deferredCalls = 0
    // A field path from a stable root needs no temporary owner while it stays stable.
    let stablePath = tokenKinds[atom] == 1 && state[0] == atom + 1 && tokenTexts[state[0]] == "." && stableBorrowRoot(context, localNames, localIds, localLengths, state, tokenTexts[atom])
    while tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "." || tokenTexts[state[0]] == "[" || tokenTexts[state[0]] == "(") {
        endSyntaxNode(context.syntax, syntaxNode, state[0], resultType[0])
        let stableStep = false
        let syntaxKind = 212
        if tokenTexts[state[0]] == "[" { syntaxKind = 213 }
        if tokenTexts[state[0]] == "(" { syntaxKind = 209 }
        syntaxNode = wrapSyntaxOperand(context.syntax, syntaxKind, state[0])
        let ownsResult = false
        // A join span is a stack view over a buffer the caller owns; it has no count.
        let viewResult = false
        if tokenTexts[state[0]] == "(" {
            if !isCallbackType(resultType[0], functionNames) {
                failAtToken(tokenLines, state[0], "only Callback values can be called")
            }
            let callbackType = resultType[0]
            value = parseCallbackCall(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType, value, callbackType)
            ownsResult = true
        } else {
        if tokenTexts[state[0]] == "." {
            let receiver = value
            let receiverType = resultType[0]
            let receiverOwner = -1
            if resultType.length > 1 { receiverOwner = resultType[1] }
            state[0] = state[0] + 1
            if tokenKinds[state[0]] != 1 {
                failCompiler("expected a field or method name after '.'")
            }
            let member = tokenTexts[state[0]]
            let memberLocation = state[0]
            state[0] = state[0] + 1
            if tokenIs(tokenKinds, tokenTexts, state, "(") && isRecordType(receiverType) && (findRecordField(functionParameterCounts, functionParameterNames, receiverType, member) < 0 || recordHasMethod(context, receiverType, member)) {
                value = parseRecordMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, memberLocation, resultType)
                ownsResult = true
            } else {
            if tokenIs(tokenKinds, tokenTexts, state, "(") && !isRecordType(receiverType) {
                state[0] = state[0] + 1
                if member.byteLength >= 4 && isListType(receiverType) && member[0] == 's' && (member == "sort" || member == "sorted" || member == "sortBy" || member == "sortedBy") {
                    sortRuntimeDeclarations(globals)
                    sortBorrowReference(output, state, receiver, receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    let element = listElementType(receiverType)
                    let copying = member == "sorted" || member == "sortedBy"
                    let by = member == "sortBy" || member == "sortedBy"
                    let compare = ""
                    let thunk = ""
                    if by {
                        let compareType: List<Integer> = [0]
                        compare = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, compareType)
                        thunk = sortComparatorThunk(functionNames, compareType[0], element, globals)
                        sortBorrowReference(output, state, compare, compareType[0], functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    } else {
                        if isRecordType(element) && !isScalarChoiceType(element) {
                            noteCapabilityCalls(context, element, "compare", state, textState, output)
                            thunk = derivedRecordSort(context, element, globals, memberLocation)
                            compare = "null"
                            by = true
                        } else {
                        if element != 1 && element != 2 && element != 3 && element != 4 && element != 7 && !isScalarChoiceType(element) {
                            failCompiler("this List element type has no natural order; use sortBy or sortedBy with Callback<T, T, Integer>")
                        }
                        }
                    }
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    value = ""
                    let operation = "sort"
                    if copying {
                        operation = "sorted"
                        value = valueName(textState, newTemporary(state))
                    }
                    if by { operation = operation + "_by" }
                    output.add("  ")
                    if copying { output.add(value + " = call ptr @minyar_list_") } else { output.add("call void @minyar_list_") }
                    output.add(operation + "(ptr " + receiver)
                    if by {
                        output.add(", ptr " + compare + ", ptr " + thunk)
                    } else {
                        let kind = element
                        if isScalarChoiceType(kind) { kind = 1 }
                        output.add(", i64 " + Text(kind))
                    }
                    if by || copying {
                        if isReferenceType(element) { output.add(", i64 1") } else { output.add(", i64 0") }
                    }
                    output.add(")\n")
                    if by && recoveryEnabled(state) {
                        context.callTargets.add(-1)
                        state[14] = state[14] + 1
                        if copying { recoveryOwnedCheckpoint(output, textState, state, value) } else { recoveryCheckpoint(output, textState, state) }
                    }
                    if copying {
                        setType(resultType, receiverType)
                        ownsResult = true
                    } else {
                        setType(resultType, 5)
