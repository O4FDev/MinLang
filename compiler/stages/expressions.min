        let fieldName = tokenTexts[state[0]]
        let fieldLocation = state[0]
        state[0] = state[0] + 1
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ":")
        let field = findRecordField(functionParameterCounts, functionParameterNames, typeForSymbol(context, record), fieldName)
        if field < 0 {
            failUnknownField(context, fieldLocation, typeForSymbol(context, record), fieldName)
        }
        let fieldPosition = field - first
        if seen[fieldPosition] {
            failAtToken(tokenLines, fieldLocation, "record field '" + fieldName + "' was provided twice")
        }
        let fieldType: List<Integer> = [functionParameterTypes[field]]
        let valueLocation = state[0]
        let fieldValue = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, fieldType)
        if fieldType[0] != functionParameterTypes[field] {
            failAtToken(tokenLines, valueLocation, "record field '" + fieldName + "' has the wrong type; expected " + diagnosticType(context, functionParameterTypes[field]) + ", found " + diagnosticType(context, fieldType[0]))
        }
