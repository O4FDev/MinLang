function nameInStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, position: Integer, name: Text): Boolean {
    let cursor = position
    let depth = 0
    while tokenKinds[cursor] != 0 && (tokenKinds[cursor] != 6 || depth > 0) {
        if tokenKinds[cursor] == 1 && tokenTexts[cursor] == name && tokenTexts[cursor - 1] != "." && tokenTexts[cursor + 1] != ":" {
            return true
        }
        if tokenKinds[cursor] == 4 {
            let text = tokenTexts[cursor]
            if text == "(" || text == "[" || text == "{" {
                depth = depth + 1
            }
            if text == ")" || text == "]" || text == "}" {
                if depth == 0 {
                    return false
                }
                depth = depth - 1
            }
        }
        cursor = cursor + 1
    }
    return false
}

function sortRuntimeDeclarations(globals: List<Text>) {
    let declaration = "declare void @minyar_list_sort(ptr, i64)\n" + "declare ptr @minyar_list_sorted(ptr, i64, i64)\n" + "declare void @minyar_list_sort_by(ptr, ptr, ptr, i64)\n" + "declare ptr @minyar_list_sorted_by(ptr, ptr, ptr, i64)\n"
    let i = 0
    while i < globals.length {
        if globals[i] == declaration { return }
        i = i + 1
    }
    globals.add(declaration)
}

function sortBorrowReference(output: List<Text>, state: List<Integer>, value: Text, type: Integer, counts: List<Integer>, fields: List<Integer>, returns: List<Integer>) {
    borrowReference(output, state, value, type, counts, fields, returns)
}

function sortComparatorThunk(names: List<Text>, type: Integer, element: Integer, globals: List<Text>): Text {
    return closureSortComparatorThunk(names, type, element, globals)
}

function appendTextRuntimeDeclaration(globals: List<Text>, name: Text, returnType: Integer, count: Integer) {
    let declaration = "declare "
    if returnType == 4 { declaration = declaration + "zeroext " }
    declaration = declaration + llvmType(returnType) + " @" + name + "(ptr"
    if count == 2 { declaration = declaration + ", ptr" }
    declaration = declaration + ")\n"
    let position = 0
    while position < globals.length {
        if globals[position] == declaration { return }
        position = position + 1
    }
    globals.add(declaration)
}

function isTextBasicMethod(member: Text): Boolean {
    return member == "find" || member == "split" || member == "startsWith" || member == "endsWith" || member == "trim"
}

function parseTextBasicMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, receiverType: Integer, member: Text, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let values: List<Text> = []
    let types: List<Integer> = []
    values.add(receiver)
    types.add(receiverType)
    let runtimeName = "minyar_list_clear"
    let returnType = 5
    if receiverType == 2 {
        runtimeName = "minyar_text_trim"
        returnType = 2
        if member != "trim" {
            let argumentType: List<Integer> = [0]
            let argument = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType)
            if argumentType[0] != 2 { failCompiler("Text." + member + " expects one Text argument") }
            values.add(argument)
            types.add(2)
            runtimeName = "minyar_text_find"
            returnType = 1
            if member == "split" {
                runtimeName = "minyar_text_split"
                returnType = 100002
            }
            if member == "startsWith" {
                runtimeName = "minyar_text_starts_with"
                returnType = 4
            }
            if member == "endsWith" {
                runtimeName = "minyar_text_ends_with"
                returnType = 4
            }
        }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    setType(resultType, returnType)
    appendTextRuntimeDeclaration(globals, runtimeName, returnType, values.length)
    return emitCall(output, textState, state, returnType, runtimeName, values, types)
}

function parseListBasicMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, receiverType: Integer, member: Text, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let declaration = "declare void @minyar_list_truncate(ptr, i64)\n" + "declare i64 @minyar_list_pop(ptr)\n" + "declare ptr @minyar_list_slice(ptr, i64, i64, i64)\n"
    if findText(globals, declaration) < 0 { globals.add(declaration) }
    borrowReference(output, state, receiver, receiverType, context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes)
    if member == "pop" {
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        let raw = valueName(textState, newTemporary(state))
        output.add("  " + raw + " = call i64 @minyar_list_pop(ptr " + receiver + ")\n")
        setType(resultType, listElementType(receiverType))
        return slotAsValue(output, textState, state, raw, resultType[0])
    }
    let startType: List<Integer> = [0]
    let start = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, startType)
    requireType(tokenLines, state, startType[0], 1, "List." + member + " positions must be Integers")
    if member == "truncate" {
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        output.add("  call void @minyar_list_truncate(ptr " + receiver + ", i64 " + start + ")\n")
        setType(resultType, 5)
        return ""
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
    let endType: List<Integer> = [0]
    let end = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, endType)
    requireType(tokenLines, state, endType[0], 1, "List.slice positions must be Integers")
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    let value = valueName(textState, newTemporary(state))
    let references = "0"
    if isReferenceType(listElementType(receiverType)) { references = "1" }
    output.add("  " + value + " = call ptr @minyar_list_slice(ptr " + receiver + ", i64 " + start + ", i64 " + end + ", i64 " + references + ")\n")
    setType(resultType, receiverType)
    return value
}

function startsDeclaration(text: Text): Boolean {
    return text.byteLength >= 8 && text[0] == 'd' && text.length >= 8 && text.slice(0, 8) == "declare "
}

function collectRuntimeDeclarations(output: List<Text>, declarations: List<Text>, start: Integer, end: Integer) {
    let pieceIndex = start
    while pieceIndex >= 0 && pieceIndex < end {
        let piece = output[pieceIndex]
        deduplicateGlobalDeclarations(piece, declarations)
        pieceIndex = pieceIndex + 1
    }
}

function hasGlobalDeclarations(globals: List<Text>): Boolean {
    let pieceIndex = 0
    while pieceIndex < globals.length {
        let piece = globals[pieceIndex]
        if startsDeclaration(piece) { return true }
        if piece.byteLength > 0 && piece[0] != '@' && !(piece.byteLength >= 7 && piece[0] == 'd' && piece.slice(0, 7) == "define ") {
        let position = 0
        let scan = true
        while position < piece.length && scan {
            let end = position
            while end < piece.length && piece[end] != '\n' { end = end + 1 }
            let line = piece.slice(position, end)
            if startsDeclaration(line) { return true }
            if line.byteLength > 0 && line[0] != ';' { scan = false }
            position = end + 1
        }
        }
        pieceIndex = pieceIndex + 1
    }
    return false
}

function deduplicateGlobalDeclarations(code: Text, seen: List<Text>): Text {
    let pieces: List<Text> = []
    let position = 0
    while position < code.length {
        let end = position
        while end < code.length && code[end] != '\n' { end = end + 1 }
        if end < code.length { end = end + 1 }
        let line = code.slice(position, end)
        if startsDeclaration(line) {
            if findText(seen, line) < 0 {
                seen.add(line)
                pieces.add(line)
            }
        } else { pieces.add(line) }
        position = end
    }
    return joinText(pieces)
}

function declareMapRuntime(globals: List<Text>) {
    let marker = "; minyar-maps: 1\n"
    if findText(globals, marker) >= 0 { return }
    globals.add(marker)
    globals.add("declare ptr @minyar_map_new(i64, i64)\n")
    globals.add("declare i64 @minyar_map_get(ptr, i64)\n")
    globals.add("declare void @minyar_map_set(ptr, i64, i64)\n")
    globals.add("declare zeroext i1 @minyar_map_has(ptr, i64)\n")
    globals.add("declare zeroext i1 @minyar_map_remove(ptr, i64)\n")
    globals.add("declare i64 @minyar_map_length(ptr)\n")
    globals.add("declare void @minyar_map_clear(ptr)\n")
}

function parseMapMethod(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, receiver: Text, receiverType: Integer, member: Text, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    declareMapRuntime(globals)
    borrowReference(output, state, receiver, receiverType, context.functionParameterCounts, context.functionParameterTypes, context.functionReturnTypes)
    if member == "clear" {
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        output.add("  call void @minyar_map_clear(ptr " + receiver + ")\n")
        setType(resultType, 5)
        return ""
    }
    if member != "has" && member != "remove" { failCompiler("this Map has no method named '" + member + "'") }
    let keyType: List<Integer> = [mapKeyType(receiverType)]
    let key = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, keyType)
    requireType(tokenLines, state, keyType[0], mapKeyType(receiverType), "Map key has the wrong type")
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    let slot = valueAsListSlot(output, textState, state, key, keyType[0])
    let value = valueName(textState, newTemporary(state))
    output.add("  " + value + " = call zeroext i1 @minyar_map_" + member + "(ptr " + receiver + ", i64 " + slot + ")\n")
    setType(resultType, 4)
    return value
}

function readMapElement(output: List<Text>, textState: List<Text>, state: List<Integer>, map: Text, key: Text, type: Integer): Text {
    let raw = valueName(textState, newTemporary(state))
    output.add("  " + raw + " = call i64 @minyar_map_get(ptr " + map + ", i64 " + key + ")\n")
    return slotAsValue(output, textState, state, raw, type)
}

function parsePrimary(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let functionNames = context.functionNames
    let functionReturnTypes = context.functionReturnTypes
    let functionParameterCounts = context.functionParameterCounts
    let functionParameterNames = context.functionParameterNames
    let functionParameterTypes = context.functionParameterTypes
    let atom = state[0]
    let syntaxNode = beginSyntaxNode(context.syntax, syntaxPrimaryKind(tokenKinds, tokenTexts, atom), atom)
    if context.syntax.nodes[syntaxNode].kind == 220 { context.syntax.nodes[syntaxNode].operator = atom }
    let scalarValues = -1
    let value = parseAtom(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    if context.syntax.nodes[syntaxNode].kind == 210 && state[0] == atom + 1 { context.syntax.nodes[syntaxNode].kind = 200 }
    if isRecordType(resultType[0]) && tokenKinds[atom] == 1 && atom + 1 < tokenTexts.length && tokenTexts[atom + 1] == "." {
        let local = findLocal(localNames, localLengths, state, tokenTexts[atom])
        if local >= 0 { scalarValues = scalarRecordValues(state, localIds[local]) }
    }
    if ((state[15] / 4 % 2) != 0 && tokenKinds[atom] == 3) || (tokenTexts[atom] != "function" && tokenTexts[atom] != "match" && tokenTexts[atom] != "try" && ((tokenKinds[atom] == 1 && tokenTexts[atom + 1] == "(") || (tokenKinds[atom] == 4 && tokenTexts[atom] == "["))) {
        if context.tokenLines.features / 4096 % 2 == 0 || choiceCases(context, resultType[0]).length == 0 || resultType.length == 1 || resultType[1] < 0 {
            ownResult(output, state, value, resultType)
        }
    }

    while tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "." || tokenTexts[state[0]] == "[" || tokenTexts[state[0]] == "(") {
        endSyntaxNode(context.syntax, syntaxNode, state[0], resultType[0])
        let syntaxKind = 212
        if tokenTexts[state[0]] == "[" { syntaxKind = 213 }
        if tokenTexts[state[0]] == "(" { syntaxKind = 209 }
        syntaxNode = wrapSyntaxOperand(context.syntax, syntaxKind, state[0])
        let ownsResult = false
        if tokenTexts[state[0]] == "(" {
            if !isCallbackType(resultType[0], functionNames) {
                failAtToken(tokenLines, state[0], "only Callback values can be called")
            }
            let callbackType = resultType[0]
            value = parseCallbackCall(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType, value, callbackType)
            ownsResult = true
        } else {
        if tokenTexts[state[0]] == "." {
            let receiver = value
            let receiverType = resultType[0]
            let receiverOwner = -1
            if resultType.length > 1 { receiverOwner = resultType[1] }
            state[0] = state[0] + 1
            if tokenKinds[state[0]] != 1 {
                failCompiler("expected a field or method name after '.'")
            }
            let member = tokenTexts[state[0]]
            let memberLocation = state[0]
            state[0] = state[0] + 1
            if tokenIs(tokenKinds, tokenTexts, state, "(") && isRecordType(receiverType) && (findRecordField(functionParameterCounts, functionParameterNames, receiverType, member) < 0 || recordHasMethod(context, receiverType, member)) {
                value = parseRecordMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, memberLocation, resultType)
                ownsResult = true
            } else {
            if tokenIs(tokenKinds, tokenTexts, state, "(") && !isRecordType(receiverType) {
                state[0] = state[0] + 1
                if member.byteLength >= 4 && isListType(receiverType) && member[0] == 's' && (member == "sort" || member == "sorted" || member == "sortBy" || member == "sortedBy") {
                    sortRuntimeDeclarations(globals)
                    sortBorrowReference(output, state, receiver, receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    let element = listElementType(receiverType)
                    let copying = member == "sorted" || member == "sortedBy"
                    let by = member == "sortBy" || member == "sortedBy"
                    let compare = ""
                    let thunk = ""
                    if by {
                        let compareType: List<Integer> = [0]
                        compare = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, compareType)
                        thunk = sortComparatorThunk(functionNames, compareType[0], element, globals)
                        sortBorrowReference(output, state, compare, compareType[0], functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    } else {
                        if isRecordType(element) {
                            thunk = derivedRecordSort(context, element, globals, memberLocation)
                            compare = "null"
                            by = true
                        } else {
                        if element != 1 && element != 2 && element != 3 && element != 4 && element != 7 {
                            failCompiler("this List element type has no natural order; use sortBy or sortedBy with Callback<T, T, Integer>")
                        }
                        }
                    }
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    value = ""
                    let operation = "sort"
                    if copying {
                        operation = "sorted"
                        value = valueName(textState, newTemporary(state))
                    }
                    if by { operation = operation + "_by" }
                    output.add("  ")
                    if copying { output.add(value + " = call ptr @minyar_list_") } else { output.add("call void @minyar_list_") }
                    output.add(operation + "(ptr " + receiver)
                    if by {
                        output.add(", ptr " + compare + ", ptr " + thunk)
                    } else {
                        output.add(", i64 " + Text(element))
                    }
                    if by || copying {
                        if isReferenceType(element) { output.add(", i64 1") } else { output.add(", i64 0") }
                    }
                    output.add(")\n")
                    if by && recoveryEnabled(state) {
                        context.callTargets.add(-1)
                        state[14] = state[14] + 1
                        if copying { recoveryOwnedCheckpoint(output, textState, state, value) } else { recoveryCheckpoint(output, textState, state) }
                    }
                    if copying {
                        setType(resultType, receiverType)
                        ownsResult = true
                    } else {
                        setType(resultType, 5)
                    }
                } else {
                if isMapType(receiverType) || isSetType(receiverType) {
                    if isSetType(receiverType) {
                        value = parseSetMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, resultType)
                    } else { value = parseMapMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, resultType) }
                } else {
                if receiverType == 8 || receiverType == 9 || receiverType == 16 || receiverType == 17 {
                    if receiverType == 16 || receiverType == 17 {
                        value = threadRegionMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, resultType)
                    } else if receiverType == 9 {
                        value = threadFrozenMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, member, resultType)
                    } else {
                    value = parseBytesMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, member, memberLocation, resultType)
                    }
                    ownsResult = isReferenceType(resultType[0])
                } else {
                if isListType(receiverType) && (member == "slice" || member == "truncate" || member == "pop") {
                    value = parseListBasicMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, resultType)
                    ownsResult = isReferenceType(resultType[0])
                } else {
                if (receiverType == 2 && member != "slice" && isTextBasicMethod(member)) || (member.byteLength == 5 && member == "clear" && isListType(receiverType)) {
                    value = parseTextBasicMethod(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, receiver, receiverType, member, resultType)
                    ownsResult = isReferenceType(resultType[0])
                } else {
                let argumentType: List<Integer> = [0]
                if (member == "add" || member == "appended") && isListType(receiverType) {
                    argumentType[0] = listElementType(receiverType)
                }
                let argument = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType)
                if receiverType == 2 && member == "slice" {
                    ownsResult = true
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
                    let endType: List<Integer> = [0]
                    let end = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, endType)
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    if argumentType[0] != 1 || endType[0] != 1 {
                        failCompiler("Text.slice positions must be Integers")
                    }
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    output.add("  ")
                    output.add(value)
                    output.add(" = call ptr @minyar_text_slice(ptr ")
                    output.add(receiver)
                    output.add(", i64 ")
                    output.add(argument)
                    output.add(", i64 ")
                    output.add(end)
                    output.add(")\n")
                    setType(resultType, 2)
                } else {
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    if member == "appended" && isListType(receiverType) {
                        if argumentType[0] != listElementType(receiverType) {
                            failCompiler("the value appended to a List has the wrong type")
                        }
                        let slot = valueAsListSlot(output, textState, state, argument, argumentType[0])
                        let transfers = takeResult(output, state, argument, argumentType)
                        let runtimeName = "minyar_list_appended"
                        if takeOwner(output, state, receiver, receiverOwner) {
                            runtimeName = "minyar_list_appended_take"
                        }
                        let transferPiece = -1
                        if runtimeName == "minyar_list_appended" && !recoveryEnabled(state) {
                            transferPiece = output.length
                            output.add("")
                        }
                        let temporary = newTemporary(state)
                        value = valueName(textState, temporary)
                        output.add("  ")
                        output.add(value)
                        output.add(" = call ptr @")
                        if transferPiece >= 0 { noteTerminalReuse(context, syntaxNode, transferPiece, output.length, receiver) }
                        noteCycleFixup(output, functionReturnTypes, functionParameterCounts, functionParameterTypes, output.length, receiverType, argumentType[0])
                        output.add(runtimeName)
                        output.add("(ptr ")
                        output.add(receiver)
                        output.add(", i64 ")
                        output.add(slot)
                        output.add(", i64 ")
                        if isReferenceType(argumentType[0]) {
                            output.add("1")
                        } else {
                            output.add("0")
                        }
                        output.add(", i64 ")
                        if transfers {
                            output.add("1")
                        } else {
                            output.add("0")
                        }
                        output.add(")\n")
                        ownsResult = true
                        setType(resultType, receiverType)
                    } else {
                    if member != "add" || !isListType(resultType[0]) {
                        failAtToken(tokenLines, memberLocation, "this value has no method named '" + member + "'")
                    }
                    if argumentType[0] != listElementType(resultType[0]) {
                        failCompiler("the value added to a List has the wrong type")
                    }
                    checkListMutation(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    if possibleCycleType(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes) {
                        output.add("  call void @minyar_rc_enable_cycles()\n")
                    }
                    let slot = valueAsListSlot(output, textState, state, argument, argumentType[0])
                    noteCycleFixup(output, functionReturnTypes, functionParameterCounts, functionParameterTypes, output.length, receiverType, argumentType[0])
                    if takeResult(output, state, argument, argumentType) {
                        output.add("  call void @minyar_list_add_take(ptr ")
                    } else {
                        output.add("  call void @minyar_list_add(ptr ")
                    }
                    output.add(value)
                    output.add(", i64 ")
                    output.add(slot)
                    output.add(")\n")
                    value = ""
                    setType(resultType, 5)
                    }
                }
                }
                }
                }
                }
                }
            } else {
                if receiverType == 16 || receiverType == 17 {
                    value = threadRegionMember(output, textState, state, receiver, receiverType, member, resultType)
                } else if receiverType == 12 || receiverType == 13 || receiverType == 15 || receiverType == 18 {
                    value = threadResultMember(output, textState, state, receiver, receiverType, member, resultType)
                    ownsResult = isReferenceType(resultType[0])
                } else if isRecordType(receiverType) {
                    let field = findRecordField(functionParameterCounts, functionParameterNames, receiverType, member)
                    if field < 0 {
                        failUnknownField(context, memberLocation, receiverType, member)
                    }
                    checkFieldAccess(tokenLines, functionParameterNames[field], functionNames[receiverType - 1000], memberLocation)
                    let first = functionParameterOffset(functionParameterCounts, receiverType - 1000)
                    let fieldType = functionParameterTypes[field]
                    if state[15] / 32 % 2 != 0 && isCRecord(context, receiverType) {
                        value = readCField(context, output, textState, state, receiver, field)
                    } else {
                    let temporary = newTemporary(state)
                    let raw = valueName(textState, temporary)
                    if scalarValues >= 0 {
                        raw = output[scalarValues + (field - first) * 3 + 1]
                        if output[scalarValues] == "; mutable scalar field " { raw = loadScalarSlot(output, textState, state, raw) }
                    } else {
                        output.add("  ")
                        output.add(raw)
                        output.add(" = call i64 @minyar_record_get(ptr ")
                        output.add(receiver)
                        output.add(", i64 ")
                        output.add(Text(field - first))
                        output.add(")\n")
                    }
                    scalarValues = -1
                    value = slotAsValue(output, textState, state, raw, fieldType)
                    }
                    setType(resultType, fieldType)
                } else {
                    if receiverType != 2 && receiverType != 8 && receiverType != 9 && !isContainerType(receiverType) {
                        failCompiler("this value does not provide a field named '" + member + "'")
                    }
                    if member != "length" && !(receiverType == 2 && member == "byteLength") {
                        failCompiler("this value does not provide a field named '" + member + "'")
                    }
                    let temporary = newTemporary(state)
                    let operation = "list_length"
                    if isMapType(receiverType) || isSetType(receiverType) {
                        declareMapRuntime(globals)
                        operation = "map_length"
                    }
                    if receiverType == 2 {
                        operation = "text_length"
                        if member == "byteLength" {
                            operation = "text_byte_length"
                        }
                    }
                    if receiverType == 8 { operation = "bytes_length" }
                    if receiverType == 9 { operation = "frozen_bytes_length" }
                    value = valueName(textState, temporary)
                    output.add("  ")
                    output.add(value)
                    if operation == "list_length" {
                        output.add(" = call i64 @.minyar.list.length")
                    } else {
                        if operation == "bytes_length" {
                            output.add(" = call i64 @.minyar.bytes.length")
                        } else {
                        output.add(" = call i64 @minyar_")
                        output.add(operation)
                        }
                    }
                    output.add("(ptr ")
                    output.add(receiver)
                    output.add(")\n")
                    setType(resultType, 1)
                }
            }
            }
        } else {
            let collection = value
            let collectionType = resultType[0]
            if isMapType(collectionType) { borrowReference(output, state, collection, collectionType, functionParameterCounts, functionParameterTypes, functionReturnTypes) }
            state[0] = state[0] + 1
            let positionLocation = state[0]
            let positionType: List<Integer> = [0]
            if isMapType(collectionType) { positionType[0] = mapKeyType(collectionType) }
            let position = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, positionType)
            expectToken(tokenKinds, tokenTexts, tokenLines, state, "]")
            if isMapType(collectionType) {
                declareMapRuntime(globals)
                requireTypeAt(tokenLines, positionLocation, positionType[0], mapKeyType(collectionType), "Map key has the wrong type")
                let slot = valueAsListSlot(output, textState, state, position, positionType[0])
                value = readMapElement(output, textState, state, collection, slot, mapValueType(collectionType))
                setType(resultType, mapValueType(collectionType))
            } else {
            requireTypeAt(tokenLines, positionLocation, positionType[0], 1, "a position must be an Integer")
            let temporary = newTemporary(state)
            if collectionType == 2 {
                value = valueName(textState, temporary)
                output.add("  ")
                output.add(value)
                output.add(" = call i32 @minyar_text_character_at(ptr ")
                output.add(collection)
                output.add(", i64 ")
                output.add(position)
                output.add(")\n")
                setType(resultType, 3)
            } else {
                if collectionType == 8 || collectionType == 9 {
                    if collectionType == 9 {
                        let types: List<Integer> = [9, 1]
                        value = emitCall(output, textState, state, 1, "minyar_frozen_bytes_get_uint8", pairOf(collection, position), types)
                    } else {
                        value = emitBytesRead(output, textState, state, collection, position)
                    }
                    setType(resultType, 1)
                } else {
                if !isListType(collectionType) {
                    failCompiler("indexing needs Text, a List, or Bytes")
                }
                let raw = valueName(textState, temporary)
                output.add("  ")
                output.add(raw)
                output.add(" = call i64 @.minyar.list.get.checked(ptr ")
                output.add(collection)
                output.add(", i64 ")
                output.add(position)
                output.add(")\n")
                let elementType = listElementType(collectionType)
                value = slotAsValue(output, textState, state, raw, elementType)
                setType(resultType, elementType)
                }
            }
            }
        }
        }
        if ownsResult {
            ownResult(output, state, value, resultType)
        } else {
            let fieldRead = tokenIs(tokenKinds, tokenTexts, state, ".") && state[0] + 2 < tokenTexts.length && tokenTexts[state[0] + 2] != "("
            if !fieldRead && !syntaxIndexHasNoCalls(context.syntax, state[0]) {
                borrowReference(output, state, value, resultType[0], functionParameterCounts, functionParameterTypes, functionReturnTypes)
            }
        }
    }
    endSyntaxNode(context.syntax, syntaxNode, state[0], resultType[0])
    return value
}

function parseRecord(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let functionNames = context.functionNames
    let symbolKinds = context.symbolKinds
    let functionReturnTypes = context.functionReturnTypes
    let functionParameterCounts = context.functionParameterCounts
    let functionParameterNames = context.functionParameterNames
    let functionParameterTypes = context.functionParameterTypes
    if resultPrefix(tokenTexts[state[0]], "minyar_result_type_") {
        failCompiler("Result values require Ok or Err constructors")
    }
    let name = tokenTexts[state[0]]
    let record = findCompiledSymbol(functionNames, symbolKinds, context.tokenLines.symbolLookup, name, 2)
    if record < 0 {
        failUnknownRecord(context, state[0], name)
    }
    if context.tokenLines.features / 4096 % 2 != 0 && choiceCases(context, 1000 + record).length > 0 { failCompiler("choice values require a case constructor") }
    let hidden = 0
    while hidden < functionParameterCounts[record] {
        let stored = functionParameterNames[functionParameterOffset(functionParameterCounts, record) + hidden]
        let declared = declaredFieldName(stored)
        if stored.length > declared.length && stored.slice(declared.length + 1, stored.length) != tokenPath(tokenLines, state[0]) {
            failAtToken(tokenLines, state[0], "record '" + readableDeclarationName(name) + "' has private fields, so only its own module can create one")
        }
        hidden = hidden + 1
    }
    state[0] = state[0] + 1
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "{")
    skipTerminators(tokenKinds, state)
    let temporary = newTemporary(state)
    let value = valueName(textState, temporary)
    let fieldCount = functionParameterCounts[record]
    let first = functionParameterOffset(functionParameterCounts, record)
    let cLayout = false
    if state[15] / 32 % 2 != 0 { cLayout = isCRecord(context, 1000 + record) }
    let scalarLocal = state[10]
    state[10] = -1
    let mutableScalar = scalarLocal >= 0 && context.mutableScalarRecord
    context.mutableScalarRecord = false
    let scalarValues = -1
    let scalar = true
    let inspect = 0
    while inspect < fieldCount {
        if isReferenceType(functionParameterTypes[first + inspect]) {
            scalar = false
        }
        inspect = inspect + 1
    }
    let owner = -1
    if scalarLocal >= 0 {
        value = "null"
        output.add("; scalar record " + Text(scalarLocal) + "\n")
        scalarValues = output.length
        let field = 0
        while field < fieldCount {
            if mutableScalar {
                output.add("; mutable scalar field ")
                output.add("%local." + Text(nextLocal(state)))
            } else {
                output.add("; ")
                output.add("")
            }
            output.add("\n")
            field = field + 1
        }
        markScalarRecord(state, scalarLocal, scalarValues)
    } else {
        output.add("  ")
        output.add(value)
        if cLayout {
            output.add(" = call ptr @minyar_c_record_new(i64 ")
        } else {
        if scalar {
            output.add(" = call ptr @minyar_record_new_scalar(i64 ")
        } else {
            noteCycleFixup(output, functionReturnTypes, functionParameterCounts, functionParameterTypes, output.length, 1000 + record, 0)
            output.add(" = call ptr @minyar_record_new(i64 ")
        }
        }
        let allocation = fieldCount
        if cLayout { allocation = cRecordSize(context, 1000 + record) }
        output.add(Text(allocation))
        output.add(")\n")
        owner = keepReference(output, state, value, 1000 + record)
    }
    let seen: List<Boolean> = []
    let position = 0
    while position < fieldCount {
        seen.add(false)
        position = position + 1
    }
    while !tokenIs(tokenKinds, tokenTexts, state, "}") {
        let fieldName = tokenTexts[state[0]]
        let fieldLocation = state[0]
        state[0] = state[0] + 1
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ":")
        let field = findRecordField(functionParameterCounts, functionParameterNames, 1000 + record, fieldName)
        if field < 0 {
            failUnknownField(context, fieldLocation, 1000 + record, fieldName)
        }
        let fieldPosition = field - first
        if seen[fieldPosition] {
            failAtToken(tokenLines, fieldLocation, "record field '" + fieldName + "' was provided twice")
        }
        let fieldType: List<Integer> = [functionParameterTypes[field]]
        let valueLocation = state[0]
        let fieldValue = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, fieldType)
        if fieldType[0] != functionParameterTypes[field] {
            failAtToken(tokenLines, valueLocation, "record field '" + fieldName + "' has the wrong type; expected " + diagnosticType(context, functionParameterTypes[field]) + ", found " + diagnosticType(context, fieldType[0]))
        }
        if cLayout {
            writeCField(context, output, textState, state, value, field, fieldValue)
        } else {
        let slot = valueAsListSlot(output, textState, state, fieldValue, fieldType[0])
        if scalarValues >= 0 {
            if mutableScalar { storeScalarSlot(output, output[scalarValues + fieldPosition * 3 + 1], slot) }
            else { output[scalarValues + fieldPosition * 3 + 1] = slot }
        } else {
        noteCycleFixup(output, functionReturnTypes, functionParameterCounts, functionParameterTypes, output.length, 1000 + record, fieldType[0])
        if isReferenceType(fieldType[0]) {
            if takeResult(output, state, fieldValue, fieldType) {
                output.add("  call void @minyar_record_set_take(ptr ")
            } else {
                output.add("  call void @minyar_record_set_reference(ptr ")
            }
        } else {
            if scalar {
                output.add("  call void @minyar_record_set_scalar(ptr ")
            } else {
                output.add("  call void @minyar_record_set(ptr ")
            }
        }
        output.add(value)
        output.add(", i64 ")
        output.add(Text(fieldPosition))
        output.add(", i64 ")
        output.add(slot)
        output.add(")\n")
        }
        }
        seen[fieldPosition] = true
        if tokenIs(tokenKinds, tokenTexts, state, ",") {
            state[0] = state[0] + 1
        }
        skipTerminators(tokenKinds, state)
    }
    let closingLocation = state[0]
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "}")
    position = 0
    while position < fieldCount {
        if !seen[position] {
            failAtToken(tokenLines, closingLocation, "record '" + readableDeclarationName(name) + "' is missing field '" + declaredFieldName(functionParameterNames[first + position]) + "'")
        }
        position = position + 1
    }
    setType(resultType, 1000 + record)
    markOwner(resultType, owner)
    return value
}

function integerListItemEnd(tokenKinds: List<Integer>, tokenTexts: List<Text>, position: Integer): Integer {
    if tokenKinds[position] == 4 && tokenTexts[position] == "-" { position = position + 1 }
    if tokenKinds[position] != 2 { return 0 }
    position = position + 1
    while tokenKinds[position] == 6 { position = position + 1 }
    if tokenKinds[position] == 4 && (tokenTexts[position] == "," || tokenTexts[position] == "]") { return position }
    return 0
}

function appendIntegerListRun(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, value: Text, syntax: SyntaxTree) {
    let first = state[0]
    let constants: List<Text> = []
    let end = integerListItemEnd(tokenKinds, tokenTexts, state[0])
    while end > 0 {
        let syntaxStart = state[0]
        let negative = tokenKinds[state[0]] == 4
        if negative { state[0] = state[0] + 1 }
        let digits = checkedIntegerLiteral(tokenTexts[state[0]], negative, tokenLines, state[0])
        if negative { digits = "-" + digits }
        constants.add(digits)
        appendSyntaxNode(syntax, 201, syntaxStart, state[0] + 1, syntax.active, 1, -1)
        state[0] = end
        end = 0
        if tokenTexts[state[0]] == "," {
            let next = state[0] + 1
            while tokenKinds[next] == 6 { next = next + 1 }
            end = integerListItemEnd(tokenKinds, tokenTexts, next)
            if end > 0 { state[0] = next }
        }
    }
    if constants.length == 1 {
        output.add("  call void @minyar_list_add(ptr " + value + ", i64 " + constants[0] + ")\n")
    } else {
        let name = "@.list." + Text(first)
        if textState[2] != "" { name = "@\"minyar.literal|" + textState[2] + "|list|" + Text(first) + "\"" }
        globals.add(name + " = private unnamed_addr constant [" + Text(constants.length) + " x i64] [")
        let position = 0
        while position < constants.length {
            if position > 0 { globals.add(", ") }
            globals.add("i64 ")
            globals.add(constants[position])
            position = position + 1
        }
        globals.add("], align 8\n")
        output.add("  call void @minyar_list_append_scalars(ptr " + value + ", ptr " + name + ", i64 " + Text(constants.length) + ")\n")
    }
}
