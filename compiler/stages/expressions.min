            writeCField(context, output, textState, state, value, field, fieldValue)
        } else {
        let slot = valueAsListSlot(output, textState, state, fieldValue, fieldType[0])
        if scalarValues >= 0 {
            if mutableScalar { storeScalarSlot(output, output[scalarValues + fieldPosition * 3 + 1], slot) }
            else { output[scalarValues + fieldPosition * 3 + 1] = slot }
        } else {
        if reusable { context.recordReuse.stores.add(output.length) }
        noteCycleFixup(output, functionReturnTypes, functionParameterCounts, functionParameterTypes, output.length, typeForSymbol(context, record), fieldType[0])
        if isReferenceType(fieldType[0]) {
            if takeResult(output, state, fieldValue, fieldType) {
                output.add("  call void @minyar_record_set_take(ptr ")
            } else {
                output.add("  call void @minyar_record_set_reference(ptr ")
            }
        } else {
            if scalar {
                context.valueBorrows.scalarStores = context.valueBorrows.scalarStores + 1
                output.add("  call void @.minyar.record.set.scalar(ptr ")
            } else {
                output.add("  call void @minyar_record_set(ptr ")
            }
        }
        output.add(value)
        output.add(", i64 ")
        output.add(Text(fieldPosition))
        output.add(", i64 ")
        output.add(slot)
        output.add(")\n")
        if reusable { context.recordReuse.stores.add(output.length) }
        }
        }
        seen[fieldPosition] = true
        if tokenIs(tokenKinds, tokenTexts, state, ",") {
            state[0] = state[0] + 1
        }
        skipTerminators(tokenKinds, state)
    }
    let closingLocation = state[0]
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "}")
    position = 0
    while position < fieldCount {
        if !seen[position] {
            failAtToken(tokenLines, closingLocation, "record '" + readableDeclarationName(name) + "' is missing field '" + declaredFieldName(functionParameterNames[first + position]) + "'")
        }
        position = position + 1
    }
    setType(resultType, typeForSymbol(context, record))
    markOwner(resultType, owner)
    if reusable {
        context.recordReuse.latePiece = output.length
        output.add("")
    }
    return value
}

function integerListItemEnd(tokenKinds: List<Integer>, tokenTexts: List<Text>, position: Integer): Integer {
    if tokenKinds[position] == 4 && tokenTexts[position] == "-" { position = position + 1 }
    if tokenKinds[position] != 2 { return 0 }
    position = position + 1
    while tokenKinds[position] == 6 { position = position + 1 }
    if tokenKinds[position] == 4 && (tokenTexts[position] == "," || tokenTexts[position] == "]") { return position }
    return 0
}

function appendIntegerListRun(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, value: Text, context: CompilerContext) {
    let syntax = context.syntax
    let first = state[0]
    let constants: List<Text> = []
    let end = integerListItemEnd(tokenKinds, tokenTexts, state[0])
    while end > 0 {
        let syntaxStart = state[0]
        let negative = tokenKinds[state[0]] == 4
        if negative { state[0] = state[0] + 1 }
        let digits = checkedIntegerLiteral(tokenTexts[state[0]], negative, tokenLines, state[0])
        if negative { digits = "-" + digits }
        constants.add(digits)
        appendSyntaxNode(syntax, 201, syntaxStart, state[0] + 1, syntax.active, 1, -1)
        state[0] = end
        end = 0
        if tokenTexts[state[0]] == "," {
            let next = state[0] + 1
            while tokenKinds[next] == 6 { next = next + 1 }
            end = integerListItemEnd(tokenKinds, tokenTexts, next)
            if end > 0 { state[0] = next }
        }
    }
    if constants.length == 1 {
        output.add("  call void @minyar_list_add(ptr " + value + ", i64 " + constants[0] + ")\n")
    } else {
        let parts: List<Text> = []
        let part = 0
        while part < constants.length {
            if part > 0 { parts.add(",") }
            parts.add(constants[part])
            part = part + 1
        }
        let content = joinText(parts)
        let digest = genericInstanceDigest(content)
        let name = "@.list." + digest
        if textState[2] != "" { name = "@\"minyar.literal|" + textState[2] + "|list|" + digest + "\"" }
        if newConstantName(context.constantNames, context.constantContents, digest, content) {
            globals.add(name + " = private unnamed_addr constant [" + Text(constants.length) + " x i64] [")
            let position = 0
            while position < constants.length {
                if position > 0 { globals.add(", ") }
                globals.add("i64 ")
                globals.add(constants[position])
                position = position + 1
            }
            globals.add("], align 8\n")
        }
        output.add("  call void @minyar_list_append_scalars(ptr " + value + ", ptr " + name + ", i64 " + Text(constants.length) + ")\n")
    }
}
