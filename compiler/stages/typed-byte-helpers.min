// Checked inline 32-bit Bytes accesses. Bytes length shares the common
// helper's nonnegative range metadata. Typed access stays little-endian and
// accepts unaligned C-layout views. A failed check calls the runtime accessor,
// which reports the error and never returns.
function appendTypedBytePosition(output: List<Text>) {
    output.add("entry:
  %length = call i64 @.minyar.bytes.length(ptr %bytes)
  %last.start = sub i64 %length, 4
  %nonnegative = icmp sge i64 %position, 0
  %fits = icmp sle i64 %position, %last.start
  %position.valid = and i1 %nonnegative, %fits
")
}

function appendTypedByteGetter(output: List<Text>, signed: Boolean) {
    let kind = "uint32"
    let extension = "zext"
    if signed { kind = "int32"; extension = "sext" }
    output.add("define internal i64 @.minyar.bytes.get." + kind + ".checked(ptr %bytes, i64 %position) alwaysinline {\n")
    appendTypedBytePosition(output)
    output.add("  br i1 %position.valid, label %good, label %bad
good:
  %data = load ptr, ptr %bytes
  %slot.0 = getelementptr inbounds i8, ptr %data, i64 %position
")
    let byte = 0
    while byte < 4 {
        let number = Text(byte)
        if byte > 0 {
            output.add("  %slot." + number + " = getelementptr inbounds i8, ptr %slot.0, i64 " + number + "\n")
        }
        output.add("  %byte." + number + " = load i8, ptr %slot." + number + ", align 1\n")
        output.add("  %part." + number + " = zext i8 %byte." + number + " to i32\n")
        if byte > 0 {
            output.add("  %shift." + number + " = shl i32 %part." + number + ", " + Text(byte * 8) + "\n")
            let previous = "%part.0"
            if byte > 1 { previous = "%word." + Text(byte - 1) }
            output.add("  %word." + number + " = or i32 " + previous + ", %shift." + number + "\n")
        }
        byte = byte + 1
    }
    output.add("  %result = " + extension + " i32 %word.3 to i64\n  ret i64 %result\nbad:\n")
    output.add("  call i64 @minyar_bytes_get_" + kind + "(ptr %bytes, i64 %position)\n")
    output.add("  unreachable\n}\n")
}

function appendTypedByteSetter(output: List<Text>, signed: Boolean) {
    let kind = "uint32"
    if signed { kind = "int32" }
    output.add("define internal void @.minyar.bytes.set." + kind + ".checked(ptr %bytes, i64 %position, i64 %value) alwaysinline {\n")
    appendTypedBytePosition(output)
    output.add("  %narrow = trunc i64 %value to i32\n")
    if signed {
        output.add("  %roundtrip = sext i32 %narrow to i64
  %value.valid = icmp eq i64 %value, %roundtrip
")
    } else {
        output.add("  %value.valid = icmp ult i64 %value, 4294967296\n")
    }
    output.add("  %valid = and i1 %position.valid, %value.valid
  br i1 %valid, label %good, label %bad
good:
  %data = load ptr, ptr %bytes
  %slot.0 = getelementptr inbounds i8, ptr %data, i64 %position
")
    let byte = 0
    while byte < 4 {
        let number = Text(byte)
        let word = "%narrow"
        if byte > 0 {
            output.add("  %slot." + number + " = getelementptr inbounds i8, ptr %slot.0, i64 " + number + "\n")
            output.add("  %shift." + number + " = lshr i32 %narrow, " + Text(byte * 8) + "\n")
            word = "%shift." + number
        }
        output.add("  %byte." + number + " = trunc i32 " + word + " to i8\n")
        output.add("  store i8 %byte." + number + ", ptr %slot." + number + ", align 1\n")
        byte = byte + 1
    }
    output.add("  ret void\nbad:\n")
    output.add("  call void @minyar_bytes_set_" + kind + "(ptr %bytes, i64 %position, i64 %value)\n")
    output.add("  unreachable\n}\n")
}

function appendTypedByteHelpers(output: List<Text>) {
    output.add("\n; Checked inline 32-bit Bytes accesses; four explicit little-endian bytes.\n")
    appendTypedByteGetter(output, true)
    appendTypedByteGetter(output, false)
    appendTypedByteSetter(output, true)
    appendTypedByteSetter(output, false)
}
