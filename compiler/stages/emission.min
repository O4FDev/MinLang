record EmitContext {
    block: Text
    caller: Text
    literalPrefix: Text
    bindings: List<Text>
    temporaries: List<Text>
}

function newEmitContext(block: Text, caller: Text, literalPrefix: Text): EmitContext {
    let bindings: List<Text> = []
    let temporaries: List<Text> = []
    return EmitContext { block: block, caller: caller, literalPrefix: literalPrefix, bindings: bindings, temporaries: temporaries }
}

function immutableBindingRange(kinds: List<Integer>, texts: List<Text>, flags: List<Boolean>, start: Integer, end: Integer) {
    let assigned: List<Text> = []
    let position = start
    while position + 1 < end {
        if kinds[position] == 1 && kinds[position + 1] == 4 && isAssignmentOperator(texts[position + 1]) {
            let declaration = position > 0 && texts[position - 1] == "let"
            let member = position > 0 && texts[position - 1] == "."
            if !declaration && !member && findText(assigned, texts[position]) < 0 { assigned.add(texts[position]) }
        }
        position = position + 1
    }
    position = start
    while position + 1 < end {
        if kinds[position] == 1 && texts[position] == "let" && kinds[position + 1] == 1 {
            flags[position + 1] = findText(assigned, texts[position + 1]) < 0
        }
        position = position + 1
    }
}

function prepareImmutableBindings(kinds: List<Integer>, texts: List<Text>, locations: SourceMap) {
    let flags = locations.immutableBindings
    if flags.length == kinds.length { return }
    let position = 0
    while position < kinds.length { flags.add(false); position = position + 1 }
    immutableBindingRange(kinds, texts, flags, 0, kinds.length)
    position = 0
    while position + 1 < kinds.length {
        if kinds[position] == 1 && texts[position] == "function" && texts[position + 1] != "(" {
            let cursor: List<Integer> = [position]
            skipDeclaration(kinds, texts, cursor)
            immutableBindingRange(kinds, texts, flags, position, cursor[0])
            position = cursor[0]
        } else { position = position + 1 }
    }
}

function setImmutableBinding(context: EmitContext, id: Integer, value: Text) {
    let values = context.bindings
    while values.length <= id { values.add("") }
    values[id] = value
}
