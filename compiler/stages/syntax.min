// Stable IDs keep links flat and traversals iterative. Node records are
// cheaper than repeated column-list accesses; see docs/compiler-syntax.md.
record SyntaxNode {
    kind: Integer
    type: Integer
    start: Integer
    end: Integer
    parent: Integer
    firstChild: Integer
    lastChild: Integer
    nextSibling: Integer
    previousSibling: Integer
    symbol: Integer
    body: Integer
    operator: Integer
    documentation: Text
}

record SyntaxTree {
    nodes: List<SyntaxNode>
    declarations: List<Integer>
    symbolNodes: List<Integer>
    callFreeIndexes: List<Boolean>
    sources: SourceMap
    file: Text
    active: Integer
    lastValue: Integer
    topLevel: Boolean
}

record SourceSpan {
    file: Text
    line: Integer
    column: Integer
    firstToken: Integer
    afterToken: Integer
}

record RuntimeTraces {
    symbols: List<Text>
    names: List<Text>
    files: List<Text>
    lines: List<Integer>
    columns: List<Integer>
    entries: List<Integer>
    sourceFiles: List<Text>
    sourceTexts: List<Text>
}

record TerminalReuseSite {
    remarks: List<Text>
    explain: Boolean
    node: Integer
    transferPiece: Integer
    calleePiece: Integer
    receiver: Text
}

record RecordReuseSite {
    target: Integer
    type: Integer
    statement: Integer
    node: Integer
    value: Text
    fields: Integer
    allocationStart: Integer
    allocationEnd: Integer
    owner: Integer
    latePiece: Integer
    stores: List<Integer>
}

// Logical source bindings are independent of LLVM owner slots and immutable
// parameter substitutions. Empty kind tables keep ordinary compilations cheap.
record DmaCompilerFacts {
    kinds: List<Integer>
    bindings: List<Integer>
    callees: List<Integer>
    lexical: List<Integer>
    rules: List<Integer>
}

record CompilerContext {
    activeReturnType: Integer
    mutableScalarRecord: Boolean
    terminalReuse: TerminalReuseSite
    recordReuse: RecordReuseSite
    dma: DmaCompilerFacts
    traces: RuntimeTraces
    tokenKinds: List<Integer>
    tokenTexts: List<Text>
    tokenLines: SourceMap
    syntax: SyntaxTree
    functionNames: List<Text>
    symbolKinds: List<Integer>
    functionReturnTypes: List<Integer>
    functionParameterCounts: List<Integer>
    functionParameterNames: List<Text>
    functionParameterTypes: List<Integer>
    callTargets: List<Integer>
    functionIRNames: List<Text>
    nativeLibraries: List<Text>
    nativePrototypes: List<Text>
    cLayouts: List<Integer>
    cFields: List<Integer>
    debugTypes: List<Integer>
    registerWidths: List<Integer>
    registerFields: List<Integer>
    registerLiteralTokens: List<Integer>
}

function newCompilerContext(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, syntax: SyntaxTree): CompilerContext {
    if tokenLines.symbolLookup.length == 0 { tokenLines.symbolLookup = buildDeclarationIndex(functionNames, symbolKinds) }
    if tokenLines.symbolLookup[0] != functionNames.length { tokenLines.symbolLookup = buildDeclarationIndex(functionNames, symbolKinds) }
    attachNominalTypes(tokenLines, symbolKinds, functionReturnTypes)
    bindSyntaxDeclarations(syntax, tokenKinds, tokenTexts, functionNames, symbolKinds, tokenLines.symbolLookup, functionReturnTypes, functionParameterCounts, functionParameterTypes)
    let callTargets: List<Integer> = []
    let functionIRNames: List<Text> = []
    let nativeLibraries: List<Text> = []
    let nativePrototypes: List<Text> = []
    let index = 0
    while index < functionNames.length {
        let name = functionNames[index]
        if symbolKinds[index] == 1 && name[0] != '"' { name = ".minyar.fn." + name }
        functionIRNames.add(name)
        index = index + 1
    }
    let cLayouts: List<Integer> = []
    let cFields: List<Integer> = []
    let debugTypes: List<Integer> = []
    let registerWidths: List<Integer> = []
    let registerFields: List<Integer> = []
    let registerLiteralTokens: List<Integer> = []
    if tokenLines.features / 32 % 2 != 0 { discoverCLayouts(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterTypes, cLayouts, cFields) }
    let terminalReuse = TerminalReuseSite { remarks: []; explain: ownershipRemarksRequested(); node: -1; transferPiece: -1; calleePiece: -1; receiver: "" }
    let recordReuse = RecordReuseSite { target: -1; type: 0; statement: -1; node: -1; value: ""; fields: 0; allocationStart: -1; allocationEnd: -1; owner: -1; latePiece: -1; stores: [] }
    let context = CompilerContext { dma: newDmaCompilerFacts(), debugTypes: debugTypes, recordReuse: recordReuse, mutableScalarRecord: false, terminalReuse: terminalReuse, traces: newRuntimeTraces(), activeReturnType: 0, syntax: syntax, cLayouts: cLayouts, cFields: cFields, registerWidths: registerWidths, registerFields: registerFields, registerLiteralTokens: registerLiteralTokens, nativeLibraries: nativeLibraries, nativePrototypes: nativePrototypes, functionIRNames: functionIRNames, callTargets: callTargets, tokenKinds: tokenKinds, tokenTexts: tokenTexts, tokenLines: tokenLines, functionNames: functionNames, symbolKinds: symbolKinds, functionReturnTypes: functionReturnTypes, functionParameterCounts: functionParameterCounts, functionParameterNames: functionParameterNames, functionParameterTypes: functionParameterTypes }
    discoverDmaDeclarations(context)
    if tokenLines.features / 32 % 2 != 0 { discoverRegisterLayouts(context) }
    index = 0
    while index < functionNames.length { validateCollectionTypeCapabilities(context, functionReturnTypes[index]); index = index + 1 }
    index = 0
    while index < functionParameterTypes.length { validateCollectionTypeCapabilities(context, functionParameterTypes[index]); index = index + 1 }
    return context
}

function appendSyntaxNode(tree: SyntaxTree, kind: Integer, start: Integer, end: Integer, parent: Integer, type: Integer, symbol: Integer): Integer {
    let node = tree.nodes.length
    let previous = -1
    if parent >= 0 { previous = tree.nodes[parent].lastChild }
    let documentation = ""
    if kind != 0 && start < tree.sources.documentation.length { documentation = tree.sources.documentation[start] }
    tree.nodes.add(SyntaxNode { documentation: documentation, kind: kind, type: type, start: start, end: end, parent: parent, firstChild: -1, lastChild: -1, nextSibling: -1, previousSibling: previous, symbol: symbol, body: -1, operator: -1 })
    if parent >= 0 {
        if previous < 0 { tree.nodes[parent].firstChild = node }
        else { tree.nodes[previous].nextSibling = node }
        tree.nodes[parent].lastChild = node
    }
    return node
}

function newSyntaxTree(sources: SourceMap, file: Text, tokenCount: Integer): SyntaxTree {
    let nodes: List<SyntaxNode> = []
    let declarations: List<Integer> = []
    let symbolNodes: List<Integer> = []
    let callFreeIndexes: List<Boolean> = []
    let tree = SyntaxTree { nodes: nodes, declarations: declarations, symbolNodes: symbolNodes, callFreeIndexes: callFreeIndexes, sources: sources, file: file, active: 0, lastValue: -1, topLevel: false }
    appendSyntaxNode(tree, 0, 0, tokenCount, -1, 5, -1)
    return tree
}

function beginSyntaxNode(tree: SyntaxTree, kind: Integer, start: Integer): Integer {
    let node = appendSyntaxNode(tree, kind, start, start, tree.active, 0, -1)
    tree.active = node
    return node
}

function endSyntaxNode(tree: SyntaxTree, node: Integer, end: Integer, type: Integer) {
    if tree.active != node { failCompiler("unbalanced syntax node") }
    tree.nodes[node].end = end
    tree.nodes[node].type = type
    tree.active = tree.nodes[node].parent
    tree.lastValue = node
}

// Replace the last completed operand by an operator node in constant time.
// The right operand will be parsed as its next child. This preserves the
// parser's precedence and associativity without parsing expressions again.
function wrapSyntaxOperand(tree: SyntaxTree, kind: Integer, operator: Integer): Integer {
    let left = tree.lastValue
    if left < 0 { failCompiler("missing syntax operand") }
    let parent = tree.nodes[left].parent
    if parent != tree.active || tree.nodes[left].nextSibling >= 0 { failCompiler("syntax operand is not the final child") }
    let previous = tree.nodes[left].previousSibling
    let node = appendSyntaxNode(tree, kind, tree.nodes[left].start, tree.nodes[left].end, -1, 0, -1)
    tree.nodes[node].parent = parent
    tree.nodes[node].previousSibling = previous
    if previous < 0 { tree.nodes[parent].firstChild = node }
    else { tree.nodes[previous].nextSibling = node }
    tree.nodes[parent].lastChild = node
    tree.nodes[left].parent = node
    tree.nodes[left].previousSibling = -1
    tree.nodes[left].nextSibling = -1
    tree.nodes[node].firstChild = left
    tree.nodes[node].lastChild = left
    tree.nodes[node].operator = operator
    tree.active = node
    return node
}

function syntaxDeclarationKind(kinds: List<Integer>, texts: List<Text>, position: Integer): Integer {
    if kinds[position] != 1 { return 0 }
    let word = texts[position]
    if word == "function" { return 1 }
    if word == "record" { return 2 }
    if word == "constant" { return 3 }
    if word == "global" { return 4 }
    return 0
}

function addSyntaxDeclaration(tree: SyntaxTree, kinds: List<Integer>, texts: List<Text>, start: Integer, end: Integer) {
    let kind = syntaxDeclarationKind(kinds, texts, start)
    if kind == 0 { tree.topLevel = true; return }
    let node = appendSyntaxNode(tree, kind, start, end, 0, 0, -1)
    if kind == 1 || kind == 2 {
        let body = declarationBodyStart(kinds, texts, start, end)
        tree.nodes[node].body = body
    }
    tree.declarations.add(node)
}

function bindSyntaxDeclarations(tree: SyntaxTree, tokens: List<Integer>, texts: List<Text>, names: List<Text>, kinds: List<Integer>, lookup: List<Integer>, returns: List<Integer>, counts: List<Integer>, parameterTypes: List<Integer>) {
    let position = 0
    while position < names.length { tree.symbolNodes.add(-1); position = position + 1 }
    position = 0
    while position < tree.declarations.length {
        let node = tree.declarations[position]
        let kind = tree.nodes[node].kind
        if kind == 4 { kind = 3 }
        if kind == 2 && registerLayoutWidthAt(tokens, texts, tree.nodes[node].start) > 0 { kind = registerLayoutSymbolKind() }
        let symbol = findIndexedSymbol(lookup, names, kinds, texts[tree.nodes[node].start + 1], kind)
        if symbol < 0 { failCompiler("syntax declaration is missing its symbol") }
        tree.nodes[node].symbol = symbol
        tree.symbolNodes[symbol] = node
        tree.nodes[node].type = returns[symbol]
        if kind == 1 || kind == 2 || kind == registerLayoutSymbolKind() {
            let first = functionParameterOffset(counts, symbol)
            let field = 0
            let token = tree.nodes[node].start + 2
            let limit = tree.nodes[node].body
            let bindingKind = 6
            if kind == 2 || kind == registerLayoutSymbolKind() {
                bindingKind = 5
                token = tree.nodes[node].body + 1
                limit = tree.nodes[node].end
            }
            while token + 1 < limit {
                if tokens[token] == 1 && texts[token + 1] == ":" && field < counts[symbol] {
                    appendSyntaxNode(tree, bindingKind, token, token + 1, node, parameterTypes[first + field], first + field)
                    field = field + 1
                }
                token = token + 1
            }
            if field != counts[symbol] { failCompiler("syntax header is missing a binding") }
        }
        if kind == 3 {
            let value = tree.nodes[node].start
            while value < tree.nodes[node].end && !(tokens[value] == 4 && texts[value] == "=") { value = value + 1 }
            value = value + 1
            tree.nodes[node].body = value
            if counts[symbol] >= 0 {
                let literal = value
                if texts[literal] == "-" { literal = literal + 1 }
                appendSyntaxNode(tree, syntaxPrimaryKind(tokens, texts, literal), value, literal + 1, node, returns[symbol], -1)
            }
        }
        position = position + 1
    }
}

// Record lexical ownership lookahead once, before the emitting parser needs it.
// A closing ']' followed by '(' counts as a call, matching callAt's contract.
function prepareSyntaxIndexes(tree: SyntaxTree, kinds: List<Integer>, texts: List<Text>) {
    let openings: List<Integer> = []
    let callStarts: List<Integer> = []
    let depth = 0
    let calls = 0
    let position = 0
    while position < kinds.length {
        tree.callFreeIndexes.add(false)
        if position + 1 < kinds.length && callAt(kinds, texts, position) { calls = calls + 1 }
        if kinds[position] == 4 {
            if texts[position] == "[" {
                if depth == openings.length { openings.add(position); callStarts.add(calls) }
                else { openings[depth] = position; callStarts[depth] = calls }
                depth = depth + 1
            }
            if texts[position] == "]" && depth > 0 {
                depth = depth - 1
                tree.callFreeIndexes[openings[depth]] = calls == callStarts[depth]
            }
        }
        position = position + 1
    }
}

function syntaxIndexHasNoCalls(tree: SyntaxTree, position: Integer): Boolean {
    return position >= 0 && position < tree.callFreeIndexes.length && tree.callFreeIndexes[position]
}

function parseSyntaxDeclarations(kinds: List<Integer>, texts: List<Text>, sources: SourceMap, file: Text, starts: List<Integer>, ends: List<Integer>): SyntaxTree {
    let tree = newSyntaxTree(sources, file, kinds.length - 1)
    prepareSyntaxIndexes(tree, kinds, texts)
    if starts.length > 0 {
        let scanned = 0
        let declaration = 0
        while scanned < starts.length {
            let start = starts[scanned]
            if start < 0 { tree.topLevel = true } else {
                addSyntaxDeclaration(tree, kinds, texts, start, ends[declaration])
                declaration = declaration + 1
            }
            scanned = scanned + 1
        }
        return tree
    }
    let cursor: List<Integer> = [0]
    skipTerminators(kinds, cursor)
    while kinds[cursor[0]] != 0 {
        let start = cursor[0]
        let kind = syntaxDeclarationKind(kinds, texts, start)
        if kind == 1 || kind == 2 { skipDeclaration(kinds, texts, sources, cursor) }
        else { skipTopLevelStatement(kinds, texts, cursor) }
        addSyntaxDeclaration(tree, kinds, texts, start, cursor[0])
        skipTerminators(kinds, cursor)
    }
    return tree
}

function syntaxStatementKind(kinds: List<Integer>, texts: List<Text>, position: Integer): Integer {
    if kinds[position] != 1 { return 110 }
    let word = texts[position]
    if word == "if" { return 101 }
    if word == "while" { return 102 }
    if parallelForAt(kinds, texts, position) { return 103 }
    if word == "for" && position + 2 < texts.length && kinds[position + 1] == 1 && texts[position + 2] == "in" { return 103 }
    if word == "let" || word == "constant" { return 104 }
    if word == "return" { return 105 }
    if word == "break" { return 106 }
    if word == "continue" { return 107 }
    if word == "match" { return 108 }
    if word == "native" && position + 1 < kinds.length && kinds[position + 1] == 3 { return 109 }
    return 110
}

function syntaxPrimaryKind(kinds: List<Integer>, texts: List<Text>, position: Integer): Integer {
    let kind = kinds[position]
    if kind == 2 { return 201 }
    if kind == 3 { return 202 }
    if kind == 5 { return 203 }
    if kind == 7 { return 204 }
    let word = texts[position]
    if word == "true" || word == "false" { return 205 }
    if word == "[" { return 206 }
    if word == "(" { return 207 }
    if word == "function" && position + 1 < texts.length && texts[position + 1] == "(" { return 208 }
    if word == "try" { return 220 }
    if word == "{" { return 211 }
    if word == "Map" && position + 1 < texts.length && (texts[position + 1] == "<" || texts[position + 1] == "(" || texts[position + 1] == "{") { return 211 }
    if word == "Set" && position + 1 < texts.length && (texts[position + 1] == "<" || texts[position + 1] == "(") { return 215 }
    if position + 1 < texts.length && texts[position + 1] == "(" { return 209 }
    if position + 1 < texts.length && texts[position + 1] == "{" { return 210 }
    return 200
}

function spanNatural(text: Text, start: Integer, end: Integer): Integer {
    let value = 0
    let position = start
    while position < end {
        let digit = Integer(text[position]) - 48
        if digit < 0 || digit > 9 || value > 922337203685477580 || (value == 922337203685477580 && digit > 7) { return 0 }
        value = value * 10 + digit
        position = position + 1
    }
    return value
}

function sourceSpan(sources: SourceMap, file: Text, start: Integer, end: Integer): SourceSpan {
    let line = 1
    let column = 1
    if start >= 0 && start * 2 + 1 < sources.coordinates.length {
        let path = tokenPath(sources, start)
        line = sources.coordinates[start * 2]
        if path != "" && line != 0 { file = path }
        column = sources.coordinates[start * 2 + 1]
        if line == -1 {
            let origin = sources.origins[start]
            let comma = origin.length - 1
            while comma >= 0 && origin[comma] != ',' { comma = comma - 1 }
            let first = 0
            let position = 0
            while position < comma {
                if origin[position] == ':' { first = position + 1 }
                position = position + 1
            }
            if first > 0 && path == "" { file = origin.slice(0, first - 1) }
            if comma >= 0 && comma + 9 <= origin.length {
                line = spanNatural(origin, first, comma)
                column = spanNatural(origin, comma + 9, origin.length)
            }
        }
    }
    if file == "" { file = "<source>" }
    if line < 1 { line = 1 }
    if column < 1 { column = 1 }
    return SourceSpan { file: file, line: line, column: column, firstToken: start, afterToken: end }
}

function syntaxSpan(tree: SyntaxTree, node: Integer): SourceSpan {
    return sourceSpan(tree.sources, tree.file, tree.nodes[node].start, tree.nodes[node].end)
}

function describeSpan(span: SourceSpan): Text {
    return span.file + ":" + Text(span.line) + ":" + Text(span.column)
}

function failAtSyntax(tree: SyntaxTree, node: Integer, message: Text) {
    failDiagnostic(syntaxSpan(tree, node), message, "", "")
}

function failAtToken(sources: SourceMap, position: Integer, message: Text) {
    failDiagnostic(sourceSpan(sources, sources.inputPath, position, position + 1), message, "", "")
}

function syntaxKindName(kind: Integer): Text {
    if kind == 0 { return "module" }
    if kind == 1 { return "function" }
    if kind == 2 { return "record" }
    if kind == 3 { return "constant" }
    if kind == 4 { return "global" }
    if kind == 5 { return "field" }
    if kind == 6 { return "parameter" }
    if kind == 7 { return "choice" }
    if kind == 8 { return "type alias" }
    if kind == 9 { return "test" }
    if kind == 10 { return "capability" }
    if kind == 100 { return "block" }
    if kind == 101 { return "if" }
    if kind == 102 { return "while" }
    if kind == 103 { return "for" }
    if kind == 104 { return "binding" }
    if kind == 105 { return "return" }
    if kind == 106 { return "break" }
    if kind == 107 { return "continue" }
    if kind == 108 { return "match" }
    if kind == 109 { return "native" }
    if kind == 110 { return "expression statement" }
    if kind == 111 { return "assignment" }
    if kind == 200 { return "name" }
    if kind == 201 { return "integer" }
    if kind == 202 { return "text" }
    if kind == 203 { return "character" }
    if kind == 204 { return "float" }
    if kind == 205 { return "boolean" }
    if kind == 206 { return "list" }
    if kind == 207 { return "group" }
    if kind == 208 { return "closure" }
    if kind == 209 { return "call" }
    if kind == 210 { return "record literal" }
    if kind == 211 { return "map" }
    if kind == 212 { return "member" }
    if kind == 213 { return "index" }
    if kind == 214 { return "assignment target" }
    if kind == 215 { return "set" }
    if kind == 220 { return "unary" }
    if kind == 221 { return "binary" }
    return "unknown"
}
