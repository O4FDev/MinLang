function checkBuiltinArguments(context: CompilerContext, callLocation: Integer, argumentLocation: Integer, name: Text, types: List<Integer>) {
    let tokenLines = context.tokenLines
    let count = -1
    if name == "print" || name == "Text" || name == "fail" || name == "exit" || name == "joinText" {
        count = 1
    }
    // joinText(parts, separator) places the separator between the parts.
    if name == "joinText" && types.length == 2 {
        count = 2
        if types[1] != 2 { failAtToken(tokenLines, argumentLocation, "joinText expects a Text separator; found " + diagnosticType(context, types[1])) }
    }
    if count >= 0 {
        if types.length != count {
            failAtToken(tokenLines, callLocation, diagnosticArgumentCount(name, count, types.length))
        }
        if count > 0 {
            let type = types[0]
            if name == "print" && (type < 1 || type > 4) && type != 7 {
                failAtToken(tokenLines, argumentLocation, name + " expects one Integer, Float, Text, Character, or Boolean value" + "; found " + diagnosticType(context, type))
            }
            if name == "Text" && type == 8 {
                // Bytes may hold anything; the conversion that can fail returns a Result.
                let span = sourceSpan(tokenLines, tokenLines.inputPath, argumentLocation, argumentLocation + 1)
                failDiagnostic(span, "Text expects one Integer, Float, Text, Character, or Boolean value; found Bytes", "these Bytes may not be UTF-8 text", "use text.decode(bytes), which returns Result<Text, errors.Error>; for Bytes this program built from Text, text.decodeOrStop(bytes) stops on invalid UTF-8")
            }
            if name == "Text" && (type < 1 || type > 4) && type != 7 {
                failAtToken(tokenLines, argumentLocation, name + " expects one Integer, Float, Text, Character, or Boolean value" + "; found " + diagnosticType(context, type))
            }
            if name == "fail" && type != 2 {
                failAtToken(tokenLines, argumentLocation, name + " expects one Text argument" + "; found " + diagnosticType(context, type))
            }
            if name == "exit" && type != 1 {
                failAtToken(tokenLines, argumentLocation, name + " expects one Integer argument" + "; found " + diagnosticType(context, type))
            }
            if name == "joinText" && type != 100002 {
                failAtToken(tokenLines, argumentLocation, "joinText expects one List<Text> argument" + "; found " + diagnosticType(context, type))
            }
        }
    }
}

function isNumericBuiltin(name: Text): Boolean {
    return name == "Bytes" || name == "Float" || name == "Integer" || name == "Character" || name == "abs" || name == "min" || name == "max" || name == "clamp" || name == "wrappingAdd" || name == "wrappingSubtract" || name == "wrappingMultiply"
}

function isBuiltinName(name: Text): Boolean {
    return isContractCheck(name) || isTestExpectation(name) || isInterpolationConversion(name) || isInterpolationJoin(name) || threadFeatureName(name) || isNumericBuiltin(name) || name == "parallelEntry" || name == "print" || name == "Text" || name == "Map" || name == "Set" || name == "fail" || name == "exit" || name == "joinText"
}

function requireBuiltinArguments(context: CompilerContext, callLocation: Integer, name: Text, types: List<Integer>, count: Integer, type: Integer) {
    let matches = types.length == count
    let position = 0
    while matches && position < types.length {
        if types[position] != type {
            matches = false
        }
        position = position + 1
    }
    if !matches {
        if types.length != count {
            failAtToken(context.tokenLines, callLocation, diagnosticArgumentCount(name, count, types.length))
        }
        let noun = describeType(type)
        if name == "Bytes" { noun = "Integer or Text" }
        if name == "Float" || name == "abs" { noun = "Integer or Float" }
        if position == 1 && (name == "min" || name == "max" || name == "clamp") { noun = "Integer or " + Text(count) + " Float" }
        let actual = diagnosticType(context, types[position - 1])
        let location = diagnosticArgumentLocation(context, position - 1, callLocation)
        if count == 1 {
            failAtToken(context.tokenLines, location, name + " expects one " + noun + " argument; found " + actual)
        }
        failAtToken(context.tokenLines, location, name + " expects " + Text(count) + " " + noun + " arguments; found " + actual)
    }
}

function callPrefix(type: Integer): Text {
    if type == 5 { return "call void @" }
    if type == 1 || isScalarChoiceType(type) { return " = call i64 @" }
    if type == 3 { return " = call i32 @" }
    if type == 4 { return " = call zeroext i1 @" }
    if type == 7 { return " = call double @" }
    return " = call ptr @"
}

function argumentPrefix(type: Integer): Text {
    if type == 1 || isScalarChoiceType(type) { return "i64 " }
    if type == 3 { return "i32 " }
    if type == 4 { return "i1 " }
    if type == 7 { return "double " }
    return "ptr "
}

function emitCall(output: List<Text>, textState: List<Text>, state: List<Integer>, returnType: Integer, callee: Text, values: List<Text>, types: List<Integer>): Text {
    if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "runtime", callee, threadSignature(returnType, types)) }
    let value = ""
    output.add("  ")
    if returnType != 5 {
        value = valueName(textState, newTemporary(state))
        output.add(value)
    }
    output.add(callPrefix(returnType))
    output.add(callee)
    output.add("(")
    let position = 0
    while position < values.length {
        if position > 0 {
            output.add(", ")
        }
        output.add(argumentPrefix(types[position]))
        output.add(values[position])
        position = position + 1
    }
    output.add(")\n")
    return value
}

function pairOf(first: Text, second: Text): List<Text> {
    let pair: List<Text> = []
    pair.add(first)
    pair.add(second)
    return pair
}

function typePairOf(type: Integer): List<Integer> {
    let pair: List<Integer> = [type, type]
    return pair
}

function emitInstruction(output: List<Text>, textState: List<Text>, state: List<Integer>, instruction: Text): Text {
    let value = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(value)
    output.add(" = ")
    output.add(instruction)
    output.add("\n")
    return value
}

function emitNumericBuiltin(context: CompilerContext, callLocation: Integer, output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, values: List<Text>, types: List<Integer>, resultType: List<Integer>): Text {
    if name == "Bytes" {
        if types.length == 0 {
            values.add("0")
            types.add(1)
        }
        if types.length == 1 && types[0] == 2 {
            setType(resultType, 8)
            return emitCall(output, textState, state, 8, "minyar_text_bytes", values, types)
        }
        requireBuiltinArguments(context, callLocation, name, types, 1, 1)
        setType(resultType, 8)
        return emitCall(output, textState, state, 8, "minyar_bytes_new", values, types)
    }
    if name == "wrappingAdd" || name == "wrappingSubtract" || name == "wrappingMultiply" {
        requireBuiltinArguments(context, callLocation, name, types, 2, 1)
        let instruction = "add"
        if name == "wrappingSubtract" { instruction = "sub" }
        if name == "wrappingMultiply" { instruction = "mul" }
        setType(resultType, 1)
        return emitInstruction(output, textState, state, instruction + " i64 " + values[0] + ", " + values[1])
    }
    if name == "abs" {
        if types.length == 1 && types[0] == 7 {
            setType(resultType, 7)
            return emitCall(output, textState, state, 7, "llvm.fabs.f64", values, types)
        }
        requireBuiltinArguments(context, callLocation, name, types, 1, 1)
        setType(resultType, 1)
        return emitCall(output, textState, state, 1, ".minyar.integer.absolute.checked", values, types)
    }
    if name == "min" || name == "max" || name == "clamp" {
        let count = 2
        if name == "clamp" { count = 3 }
        let type = 1
        if types.length > 0 && types[0] == 7 { type = 7 }
        if types.length != count || (type != 1 && type != 7) {
            if types.length != count {
                failAtToken(context.tokenLines, callLocation, diagnosticArgumentCount(name, count, types.length))
            }
            failCompiler(name + " expects " + Text(count) + " Integer or " + Text(count) + " Float arguments")
        }
        requireBuiltinArguments(context, callLocation, name, types, count, type)
        setType(resultType, type)
        if name == "clamp" {
            let pairTypes = typePairOf(type)
            let checkName = ".minyar.clamp.integer.checked"
            if type == 7 { checkName = ".minyar.clamp.float.checked" }
            emitCall(output, textState, state, 5, checkName, pairOf(values[1], values[2]), pairTypes)
            let raised = emitMinimumOrMaximum(output, textState, state, "max", type, pairOf(values[0], values[1]), pairTypes)
            return emitMinimumOrMaximum(output, textState, state, "min", type, pairOf(raised, values[2]), pairTypes)
        }
        return emitMinimumOrMaximum(output, textState, state, name, type, values, types)
    }
    if name == "Float" {
        if types.length == 1 && types[0] == 7 {
            setType(resultType, 7)
            return values[0]
        }
        requireBuiltinArguments(context, callLocation, name, types, 1, 1)
        setType(resultType, 7)
        return emitInstruction(output, textState, state, "sitofp i64 " + values[0] + " to double")
    }
    if name == "Integer" {
        setType(resultType, 1)
        if types.length == 1 && types[0] == 1 {
            return values[0]
        }
        if types.length == 1 && types[0] == 3 {
            return emitInstruction(output, textState, state, "zext i32 " + values[0] + " to i64")
        }
        if types.length == 1 && types[0] == 2 {
            return emitCall(output, textState, state, 1, "minyar_text_integer", values, types)
        }
        if types.length != 1 || types[0] != 7 {
            if types.length != 1 {
                failAtToken(context.tokenLines, callLocation, diagnosticArgumentCount(name, 1, types.length))
            }
            failAtToken(context.tokenLines, diagnosticArgumentLocation(context, 0, callLocation), "Integer expects one Integer, Float, Character, or Text argument; found " + diagnosticType(context, types[0]))
        }
        return emitCall(output, textState, state, 1, ".minyar.float.integer.checked", values, types)
    }
    requireBuiltinArguments(context, callLocation, name, types, 1, 1)
    setType(resultType, 3)
    return emitCall(output, textState, state, 3, ".minyar.character.checked", values, types)
}

function emitMinimumOrMaximum(output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, type: Integer, values: List<Text>, types: List<Integer>): Text {
    if type == 7 {
        let callee = "llvm.minnum.f64"
        if name == "max" { callee = "llvm.maxnum.f64" }
        return emitCall(output, textState, state, 7, callee, values, types)
    }
    let condition = "slt"
    if name == "max" { condition = "sgt" }
    let chooseLeft = emitInstruction(output, textState, state, "icmp " + condition + " i64 " + values[0] + ", " + values[1])
    return emitInstruction(output, textState, state, "select i1 " + chooseLeft + ", i64 " + values[0] + ", i64 " + values[1])
}

// One interpolation is one runtime call over its parts. Integer, Boolean and
// Character parts are formatted straight into the exactly sized result, so
// they need no temporary Text or parts List. A Text part is borrowed; it gets
// a count only if a later part runs user code that could replace its holder.
function compileInterpolation(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "[")
    let arguments: List<Text> = []
    let pieces: List<Integer> = []
    let values: List<Text> = []
    let calls: List<Integer> = []
    while !tokenIs(tokenKinds, tokenTexts, state, "]") {
        let partType: List<Integer> = [2]
        let callLocation = state[0]
        let converted = tokenKinds[callLocation] == 1 && isInterpolationConversion(tokenTexts[callLocation])
        if converted {
            state[0] = state[0] + 1
            expectToken(tokenKinds, tokenTexts, tokenLines, state, "(")
            if tokenIs(tokenKinds, tokenTexts, state, ")") {
                let span = sourceSpan(tokenLines, tokenLines.inputPath, callLocation + 2, callLocation + 3)
                failDiagnostic(span, "text interpolation is missing a value", "", "put a value between \\( and ), such as \\(name)")
            }
            setType(partType, 0)
        }
        let value = parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, partType)
        let type = partType[0]
        if converted {
            if !((type >= 1 && type <= 4) || type == 7) || !tokenIs(tokenKinds, tokenTexts, state, ")") {
                failAtToken(tokenLines, callLocation + 2, "text interpolation needs Integer, Float, Boolean, Character, or Text; convert this value to Text explicitly")
            }
            state[0] = state[0] + 1
        } else {
            requireType(tokenLines, state, type, 2, "an interpolated Text part must be Text")
        }
        if type == 2 {
            pieces.add(output.length)
            output.add("")
            values.add(value)
            calls.add(context.callTargets.length)
        }
        arguments.add(Text(type))
        arguments.add(valueAsListSlot(output, textState, state, value, type))
        if tokenIs(tokenKinds, tokenTexts, state, ",") { state[0] = state[0] + 1 }
    }
    state[0] = state[0] + 1
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    let index = 0
    while index < pieces.length {
        settleBorrow(context, output, state, pieces[index], values[index], 2, calls[index])
        index = index + 1
    }
    let value = valueName(textState, newTemporary(state))
    output.add("  " + value + " = call ptr (i64, ...) @minyar_interpolate(i64 " + Text(arguments.length / 2))
    index = 0
    while index < arguments.length {
        output.add(", i64 " + arguments[index])
        index = index + 1
    }
    output.add(")\n")
    setType(resultType, 2)
    return value
}

function parseCall(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let syntaxCall = context.syntax.active
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let functionNames = context.functionNames
    let symbolKinds = context.symbolKinds
    let functionReturnTypes = context.functionReturnTypes
    let functionParameterCounts = context.functionParameterCounts
    let functionParameterTypes = context.functionParameterTypes
    let name = tokenTexts[state[0]]
    if isTestExpectation(name) && findLocal(localNames, localLengths, state, "expect") >= 0 {
        let position = state[0]
        let closing = testClosing(tokenKinds, tokenTexts, tokenLines, position + 1)
        let comparison = restoreShadowedExpectation(context, position)
        tokenTexts[position] = "expect"
        tokenTexts[closing - 2] = ")"
        let value = parseCall(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
        tokenTexts[position] = name
        tokenTexts[closing - 2] = ","
        if comparison >= 0 { tokenTexts[comparison] = "," }
        state[0] = closing + 1
        return value
    }
    if isRegisterLayoutBuiltin(name) && findLocal(localNames, localLengths, state, name) < 0 && findFunction(functionNames, symbolKinds, tokenLines.symbolLookup, name) < 0 && findCompiledSymbol(functionNames, symbolKinds, tokenLines.symbolLookup, name, 3) < 0 {
        return parseRegisterLayoutBuiltin(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    }
    if isInterruptSignalBuiltin(name) && findLocal(localNames, localLengths, state, name) < 0 && findFunction(functionNames, symbolKinds, tokenLines.symbolLookup, name) < 0 && findCompiledSymbol(functionNames, symbolKinds, tokenLines.symbolLookup, name, 3) < 0 {
        return parseInterruptSignalBuiltin(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType)
    }
    if state[15] / 32 % 2 != 0 && isCLayoutBuiltin(name) { return parseCLayoutBuiltin(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType) }
    let callbackLocal = -1
    if state[15] % 2 != 0 { callbackLocal = findLocal(localNames, localLengths, state, name) }
    if callbackLocal >= 0 && isCallbackType(localTypes[callbackLocal], functionNames) {
        let callback = loadLocal(output, textState, state, localIds[callbackLocal], localTypes[callbackLocal])
        state[0] = state[0] + 1
        return parseCallbackCall(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType, callback, localTypes[callbackLocal])
    }
    if state[15] % 2 != 0 && callbackLocal < 0 {
        let constant = findCompiledSymbol(functionNames, symbolKinds, context.tokenLines.symbolLookup, name, 3)
        if constant >= 0 && isCallbackType(functionReturnTypes[constant], functionNames) {
            if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "constant", functionNames[constant], Text(functionReturnTypes[constant])) }
            let values: List<Text> = []
            let types: List<Integer> = []
            let callbackType = functionReturnTypes[constant]
            let callback = emitCall(output, textState, state, callbackType, constantIRName(name, "load"), values, types)
            context.callTargets.add(-1)
            state[14] = state[14] + 1
            recoveryCheckpoint(output, textState, state)
            state[0] = state[0] + 1
            return parseCallbackCall(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType, callback, callbackType)
        }
    }
    let callLocation = state[0]
    state[0] = state[0] + 1
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "(")
    if isContractCheck(name) { return parseContractCheck(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType, name, callLocation) }
    if isInterpolationJoin(name) { return compileInterpolation(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType) }
    if (state[15] / 4 % 2) != 0 && isThreadType(simpleTypeCode(name)) { failCompiler("opaque thread types cannot be constructed") }
    let threadTarget = ""
    let threadChannelType = 10
    let threadInputType = 9
    let threadPacketTarget = -1
    if name == "startThread" || name == "startThreadResult" {
        if tokenKinds[state[0]] != 1 { failCompiler("startThread requires a named thread entry") }
        threadTarget = tokenTexts[state[0]]
        if findLocal(localNames, localLengths, state, threadTarget) >= 0 || findLocal(localNames, localLengths, state, readableDeclarationName(threadTarget)) >= 0 || !threadEntry(globals, threadTarget) { failCompiler("startThread requires a named thread entry") }
        let targetIndex = findFunction(functionNames, symbolKinds, context.tokenLines.symbolLookup, threadTarget)
        state[0] = state[0] + 1
        if threadLegacyEntry(functionParameterCounts, functionParameterTypes, targetIndex) {
            threadChannelType = functionParameterTypes[functionParameterOffset(functionParameterCounts, targetIndex) + 2]
            threadInputType = functionParameterTypes[functionParameterOffset(functionParameterCounts, targetIndex) + 1]
            if !tokenIs(tokenKinds, tokenTexts, state, ",") { failCompiler("startThread requires a named thread entry followed by seed, FrozenBytes, BytesChannel") }
            state[0] = state[0] + 1
        } else {
            threadPacketTarget = targetIndex
            if tokenIs(tokenKinds, tokenTexts, state, ",") { state[0] = state[0] + 1 }
            else if !tokenIs(tokenKinds, tokenTexts, state, ")") { failCompiler("startThread requires a named thread entry followed by its arguments") }
        }
    }
    if name == "parallelEntry" {
        if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "indirect", "parallelEntry", "unreviewed raw function address") }
        if tokenKinds[state[0]] != 1 {
            failAtToken(tokenLines, callLocation, "parallelEntry expects the name of a parallel function")
        }
        let target = tokenTexts[state[0]]
        let function = findFunction(functionNames, symbolKinds, context.tokenLines.symbolLookup, target)
        if function < 0 {
            failUnknownFunction(context, callLocation, target)
        }
        state[0] = state[0] + 1
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        globals.add("; minyar-parallel-entry: " + target + "\n")
        let temporary = newTemporary(state)
        let entry = valueName(textState, temporary)
        output.add("  ; minyar-raw-address: parallelEntry\n")
        output.add("  " + entry + " = ptrtoint ptr @" + languageSymbol(target) + " to i64\n")
        setType(resultType, 1)
        return entry
    }
    let argumentValues: List<Text> = []
    let argumentTypes: List<Integer> = []
    let argumentType: List<Integer> = [0]
    let firstArgumentLocation = state[0]
    while !tokenIs(tokenKinds, tokenTexts, state, ")") {
        setType(argumentType, 0)
        if true {
            let contextFunction = findFunction(functionNames, symbolKinds, context.tokenLines.symbolLookup, name)
            if contextFunction >= 0 && argumentValues.length < functionParameterCounts[contextFunction] {
                let first = functionParameterOffset(functionParameterCounts, contextFunction)
                argumentType[0] = functionParameterTypes[first + argumentValues.length]
            }
            if name == "joinText" && argumentValues.length == 0 {
                argumentType[0] = 100002
            }
            if name == "joinText" && argumentValues.length == 1 {
                argumentType[0] = 2
            }
            if threadPacketTarget >= 0 && argumentValues.length < functionParameterCounts[threadPacketTarget] {
                argumentType[0] = functionParameterTypes[functionParameterOffset(functionParameterCounts, threadPacketTarget) + argumentValues.length]
            }
        }
        argumentValues.add(parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType))
        argumentTypes.add(argumentType[0])
        if isTestExpectation(name) && isReferenceType(argumentType[0]) {
            borrowReference(output, state, argumentValues[argumentValues.length - 1], argumentType[0], functionParameterCounts, functionParameterTypes, functionReturnTypes)
        }
        if tokenIs(tokenKinds, tokenTexts, state, ",") {
            state[0] = state[0] + 1
        }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    if isTestExpectation(name) { return emitTestExpectation(context, globals, output, textState, state, name, argumentValues, argumentTypes, resultType, callLocation) }
    if isInterpolationConversion(name) {
        if argumentTypes.length == 0 {
            let span = sourceSpan(tokenLines, tokenLines.inputPath, callLocation + 2, callLocation + 3)
            failDiagnostic(span, "text interpolation is missing a value", "", "put a value between \\( and ), such as \\(name)")
        }
        let printable = false
        if argumentTypes.length == 1 {
            let type = argumentTypes[0]
            printable = (type >= 1 && type <= 4) || type == 7
        }
        if !printable {
            failAtToken(tokenLines, callLocation + 2, "text interpolation needs Integer, Float, Boolean, Character, or Text; convert this value to Text explicitly")
        }
        name = "Text"
    }
    if (state[15] / 4 % 2) != 0 && threadPacketTarget >= 0 { return threadPacketSpawn(context, output, textState, state, globals, name, threadTarget, argumentValues, argumentTypes, resultType) }
    if (state[15] / 4 % 2) != 0 && isAtomicBuiltin(name) { return threadAtomicBuiltin(context, output, textState, state, name, argumentValues, argumentTypes, resultType) }
    if (state[15] / 4 % 2) != 0 && isQueueBuiltin(name) { return threadQueueBuiltin(context, output, textState, state, globals, name, argumentValues, argumentTypes, resultType) }
    if (state[15] / 4 % 2) != 0 && isThreadBuiltin(name) { return threadBuiltin(output, textState, state, name, argumentValues, argumentTypes, threadTarget, threadInputType, threadChannelType, resultType) }
    if (state[15] / 4 % 2) != 0 {
    let effectKind = "call"
    if isBuiltinName(name) { effectKind = "builtin" }
    let effectResult = 0
    if effectKind == "call" {
        let resolvedEffect = findFunction(functionNames, symbolKinds, context.tokenLines.symbolLookup, name)
        if resolvedEffect >= 0 { effectResult = functionReturnTypes[resolvedEffect] }
    }
    if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], effectKind, name, threadSignature(effectResult, argumentTypes)) }
    }
    checkBuiltinArguments(context, callLocation, firstArgumentLocation, name, argumentTypes)

    let value = ""
    if name == "print" {
        if argumentTypes[0] > 4 && argumentTypes[0] != 7 {
            failCompiler("print expects one Integer, Float, Text, Character, or Boolean value")
        }
        let suffix = "text"
        if argumentTypes[0] == 1 {
            suffix = "integer"
        }
        if argumentTypes[0] == 7 {
            suffix = "float"
        }
        if argumentTypes[0] == 3 {
            suffix = "character"
        }
        if argumentTypes[0] == 4 {
            suffix = "boolean"
        }
        output.add("  call void @minyar_print_")
        output.add(suffix)
        output.add("(")
        output.add(nativeType(argumentTypes[0]))
        output.add(" ")
        output.add(argumentValues[0])
        output.add(")\n")
        setType(resultType, 5)
    } else {
        if name == "fail" {
            output.add("  call void @minyar_fail(ptr ")
            output.add(argumentValues[0])
            output.add(")\n")
            setType(resultType, 6)
        } else {
            if name == "exit" {
                if argumentValues.length != 1 || argumentTypes[0] != 1 {
                    failCompiler("exit expects one Integer status")
                }
                if threadMode(globals) { output.add("  call void @minyar_thread_join_children()\n") }
                output.add("  call void @minyar_exit(i64 ")
                output.add(argumentValues[0])
                output.add(")\n")
                setType(resultType, 6)
            } else {
            if name == "Text" {
                if argumentTypes[0] == 2 {
                    value = argumentValues[0]
                    output.add("  call void @minyar_rc_retain(ptr ")
                    output.add(value)
                    output.add(")\n")
                } else {
                    let suffix = "boolean"
                    if argumentTypes[0] == 1 {
                        suffix = "integer"
                    }
                    if argumentTypes[0] == 7 {
                        suffix = "float"
                    }
                    if argumentTypes[0] == 3 {
                        suffix = "character"
                    }
                    if argumentTypes[0] == 8 {
                        suffix = "bytes"
                    }
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    output.add("  ")
                    output.add(value)
                    output.add(" = call ptr @minyar_")
                    output.add(suffix)
                    output.add("_text(")
                    output.add(nativeType(argumentTypes[0]))
                    output.add(" ")
                    output.add(argumentValues[0])
                    output.add(")\n")
                }
                setType(resultType, 2)
            } else {
                if name == "joinText" {
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    output.add("  ")
                    output.add(value)
                    if argumentValues.length == 2 {
                        appendTextRuntimeDeclaration(globals, "minyar_join_texts_with", 2, [100002, 2])
                        output.add(" = call ptr @minyar_join_texts_with(ptr ")
                        output.add(argumentValues[0])
                        output.add(", ptr ")
                        output.add(argumentValues[1])
                    } else {
                        output.add(" = call ptr @minyar_join_texts(ptr ")
                        output.add(argumentValues[0])
                    }
                    output.add(")\n")
                    setType(resultType, 2)
                } else {
                if isNumericBuiltin(name) {
                    value = emitNumericBuiltin(context, callLocation, output, textState, state, name, argumentValues, argumentTypes, resultType)
                    if name == "Integer" && argumentTypes.length == 1 && argumentTypes[0] == 2 {
                        appendTextRuntimeDeclaration(globals, "minyar_text_integer", 1, [2])
                    }
                } else {
                    let functionIndex = state[5]
                    if functionIndex < 0 || functionNames[functionIndex] != name {
                        functionIndex = findFunction(functionNames, symbolKinds, context.tokenLines.symbolLookup, name)
                        state[5] = functionIndex
                    }
                    if functionIndex < 0 {
                        failUnknownFunction(context, callLocation, name)
                    }
                    if name == "main" {
                        failCompiler("the executable entry main cannot be called; use a separate function for shared work")
                    }
                    if argumentValues.length != functionParameterCounts[functionIndex] {
                        failAtToken(tokenLines, callLocation, diagnosticArgumentCount(readableDeclarationName(name), functionParameterCounts[functionIndex], argumentValues.length))
                    }
                    let parameterOffset = functionParameterOffset(functionParameterCounts, functionIndex)
                    let argumentIndex = 0
                    while argumentIndex < argumentValues.length {
                        if argumentTypes[argumentIndex] != functionParameterTypes[parameterOffset + argumentIndex] {
                            requireContextType(context, diagnosticArgumentLocation(context, argumentIndex, callLocation), argumentTypes[argumentIndex], functionParameterTypes[parameterOffset + argumentIndex], "an argument passed to " + readableDeclarationName(name) + " has the wrong type")
                        }
                        argumentIndex = argumentIndex + 1
                    }
                    let returnType = functionReturnTypes[functionIndex]
                    dmaRecordCall(context, syntaxCall, functionIndex)
                    if functionIndex < context.valueBorrows.parallelFunctions.length && context.valueBorrows.parallelFunctions[functionIndex] { noteParallelArguments(context, globals, syntaxCall, functionIndex, argumentTypes) }
                    context.callTargets.add(functionIndex)
                    state[14] = state[14] + 1
                    let callee = context.functionIRNames[functionIndex]
                    value = emitCall(output, textState, state, returnType, callee, argumentValues, argumentTypes)
                    recoveryCheckpoint(output, textState, state)
                    setType(resultType, returnType)
                }
                }
            }
            }
        }
    }
    return value
}
