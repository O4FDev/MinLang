function checkBuiltinArguments(name: Text, types: List<Integer>) {
    let count = -1
    if name == "print" || name == "Text" || name == "fail" || name == "exit" || name == "joinText" {
        count = 1
    }
    if count >= 0 {
        if types.length != count {
            fail(name + " expects " + Text(count) + " arguments, but received " + Text(types.length))
        }
        if count > 0 {
            let type = types[0]
            if name == "print" && (type < 1 || type > 4) && type != 7 {
                fail(name + " expects one Integer, Float, Text, Character, or Boolean value")
            }
            if name == "Text" && (type < 1 || type > 4) && type != 7 && type != 8 {
                fail(name + " expects one Integer, Float, Text, Character, Boolean, or Bytes value")
            }
            if name == "fail" && type != 2 {
                fail(name + " expects one Text argument")
            }
            if name == "exit" && type != 1 {
                fail(name + " expects one Integer argument")
            }
            if name == "joinText" && type != 100002 {
                fail("joinText expects one List<Text> argument")
            }
        }
    }
}

function isNumericBuiltin(name: Text): Boolean {
    return name == "Bytes" || name == "Float" || name == "Integer" || name == "Character" || name == "abs" || name == "min" || name == "max" || name == "clamp" || name == "wrappingAdd" || name == "wrappingSubtract" || name == "wrappingMultiply"
}

function isBuiltinName(name: Text): Boolean {
    return threadFeatureName(name) || isNumericBuiltin(name) || name == "parallelEntry" || name == "print" || name == "Text" || name == "Map" || name == "fail" || name == "exit" || name == "joinText"
}

function requireBuiltinArguments(name: Text, types: List<Integer>, count: Integer, type: Integer) {
    let matches = types.length == count
    let position = 0
    while matches && position < types.length {
        if types[position] != type {
            matches = false
        }
        position = position + 1
    }
    if !matches {
        let noun = describeType(type)
        if count == 1 {
            fail(name + " expects one " + noun + " argument")
        }
        fail(name + " expects " + Text(count) + " " + noun + " arguments")
    }
}

function callPrefix(type: Integer): Text {
    if type == 5 { return "call void @" }
    if type == 1 { return " = call i64 @" }
    if type == 3 { return " = call i32 @" }
    if type == 4 { return " = call zeroext i1 @" }
    if type == 7 { return " = call double @" }
    return " = call ptr @"
}

function argumentPrefix(type: Integer): Text {
    if type == 1 { return "i64 " }
    if type == 3 { return "i32 " }
    if type == 4 { return "i1 " }
    if type == 7 { return "double " }
    return "ptr "
}

function emitCall(output: List<Text>, textState: List<Text>, state: List<Integer>, returnType: Integer, callee: Text, values: List<Text>, types: List<Integer>): Text {
    if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "runtime", callee, threadSignature(returnType, types)) }
    let value = ""
    output.add("  ")
    if returnType != 5 {
        value = valueName(textState, newTemporary(state))
        output.add(value)
    }
    output.add(callPrefix(returnType))
    output.add(callee)
    output.add("(")
    let position = 0
    while position < values.length {
        if position > 0 {
            output.add(", ")
        }
        output.add(argumentPrefix(types[position]))
        output.add(values[position])
        position = position + 1
    }
    output.add(")\n")
    return value
}

function pairOf(first: Text, second: Text): List<Text> {
    let pair: List<Text> = []
    pair.add(first)
    pair.add(second)
    return pair
}

function typePairOf(type: Integer): List<Integer> {
    let pair: List<Integer> = [type, type]
    return pair
}

function emitInstruction(output: List<Text>, textState: List<Text>, state: List<Integer>, instruction: Text): Text {
    let value = valueName(textState, newTemporary(state))
    output.add("  ")
    output.add(value)
    output.add(" = ")
    output.add(instruction)
    output.add("\n")
    return value
}

function emitNumericBuiltin(output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, values: List<Text>, types: List<Integer>, resultType: List<Integer>): Text {
    if name == "Bytes" {
        if types.length == 0 {
            values.add("0")
            types.add(1)
        }
        if types.length == 1 && types[0] == 2 {
            setType(resultType, 8)
            return emitCall(output, textState, state, 8, "minyar_text_bytes", values, types)
        }
        requireBuiltinArguments(name, types, 1, 1)
        setType(resultType, 8)
        return emitCall(output, textState, state, 8, "minyar_bytes_new", values, types)
    }
    if name == "wrappingAdd" || name == "wrappingSubtract" || name == "wrappingMultiply" {
        requireBuiltinArguments(name, types, 2, 1)
        let instruction = "add"
        if name == "wrappingSubtract" { instruction = "sub" }
        if name == "wrappingMultiply" { instruction = "mul" }
        setType(resultType, 1)
        return emitInstruction(output, textState, state, instruction + " i64 " + values[0] + ", " + values[1])
    }
    if name == "abs" {
        if types.length == 1 && types[0] == 7 {
            setType(resultType, 7)
            return emitCall(output, textState, state, 7, "llvm.fabs.f64", values, types)
        }
        requireBuiltinArguments(name, types, 1, 1)
        setType(resultType, 1)
        return emitCall(output, textState, state, 1, ".minyar.integer.absolute.checked", values, types)
    }
    if name == "min" || name == "max" || name == "clamp" {
        let count = 2
        if name == "clamp" { count = 3 }
        let type = 1
        if types.length > 0 && types[0] == 7 { type = 7 }
        if types.length != count || (type != 1 && type != 7) {
            fail(name + " expects " + Text(count) + " Integer or " + Text(count) + " Float arguments")
        }
        requireBuiltinArguments(name, types, count, type)
        setType(resultType, type)
        if name == "clamp" {
            let pairTypes = typePairOf(type)
            let checkName = ".minyar.clamp.integer.checked"
            if type == 7 { checkName = ".minyar.clamp.float.checked" }
            emitCall(output, textState, state, 5, checkName, pairOf(values[1], values[2]), pairTypes)
            let raised = emitMinimumOrMaximum(output, textState, state, "max", type, pairOf(values[0], values[1]), pairTypes)
            return emitMinimumOrMaximum(output, textState, state, "min", type, pairOf(raised, values[2]), pairTypes)
        }
        return emitMinimumOrMaximum(output, textState, state, name, type, values, types)
    }
    if name == "Float" {
        if types.length == 1 && types[0] == 7 {
            setType(resultType, 7)
            return values[0]
        }
        requireBuiltinArguments(name, types, 1, 1)
        setType(resultType, 7)
        return emitInstruction(output, textState, state, "sitofp i64 " + values[0] + " to double")
    }
    if name == "Integer" {
        setType(resultType, 1)
        if types.length == 1 && types[0] == 1 {
            return values[0]
        }
        if types.length == 1 && types[0] == 3 {
            return emitInstruction(output, textState, state, "zext i32 " + values[0] + " to i64")
        }
        if types.length == 1 && types[0] == 2 {
            return emitCall(output, textState, state, 1, "minyar_text_integer", values, types)
        }
        if types.length != 1 || types[0] != 7 {
            fail("Integer expects one Integer, Float, Character, or Text argument")
        }
        return emitCall(output, textState, state, 1, ".minyar.float.integer.checked", values, types)
    }
    requireBuiltinArguments(name, types, 1, 1)
    setType(resultType, 3)
    return emitCall(output, textState, state, 3, ".minyar.character.checked", values, types)
}

function emitMinimumOrMaximum(output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, type: Integer, values: List<Text>, types: List<Integer>): Text {
    if type == 7 {
        let callee = "llvm.minnum.f64"
        if name == "max" { callee = "llvm.maxnum.f64" }
        return emitCall(output, textState, state, 7, callee, values, types)
    }
    let condition = "slt"
    if name == "max" { condition = "sgt" }
    let chooseLeft = emitInstruction(output, textState, state, "icmp " + condition + " i64 " + values[0] + ", " + values[1])
    return emitInstruction(output, textState, state, "select i1 " + chooseLeft + ", i64 " + values[0] + ", i64 " + values[1])
}

function parseCall(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, globals: List<Text>, resultType: List<Integer>): Text {
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    let tokenLines = context.tokenLines
    let functionNames = context.functionNames
    let symbolKinds = context.symbolKinds
    let functionReturnTypes = context.functionReturnTypes
    let functionParameterCounts = context.functionParameterCounts
    let functionParameterTypes = context.functionParameterTypes
    let name = tokenTexts[state[0]]
    if state[15] / 32 % 2 != 0 && isCLayoutBuiltin(name) { return parseCLayoutBuiltin(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType) }
    let callbackLocal = -1
    if state[15] % 2 != 0 { callbackLocal = findLocal(localNames, localLengths, state, name) }
    if callbackLocal >= 0 && isCallbackType(localTypes[callbackLocal], functionNames) {
        let callback = loadLocal(output, textState, state, localIds[callbackLocal], localTypes[callbackLocal])
        state[0] = state[0] + 1
        return parseCallbackCall(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType, callback, localTypes[callbackLocal])
    }
    if state[15] % 2 != 0 && callbackLocal < 0 {
        let constant = findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, name, 3)
        if constant >= 0 && isCallbackType(functionReturnTypes[constant], functionNames) {
            if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "constant", functionNames[constant], Text(functionReturnTypes[constant])) }
            let values: List<Text> = []
            let types: List<Integer> = []
            let callbackType = functionReturnTypes[constant]
            let callback = emitCall(output, textState, state, callbackType, constantIRName(name, "load"), values, types)
            context.callTargets.add(-1)
            state[14] = state[14] + 1
            recoveryCheckpoint(output, textState, state)
            state[0] = state[0] + 1
            return parseCallbackCall(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, resultType, callback, callbackType)
        }
    }
    let callLocation = state[0]
    state[0] = state[0] + 1
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "(")
    if (state[15] / 4 % 2) != 0 && isThreadType(simpleTypeCode(name)) { fail("opaque thread types cannot be constructed") }
    let threadTarget = ""
    let threadChannelType = 10
    let threadInputType = 9
    if name == "startThread" || name == "startThreadResult" {
        if tokenKinds[state[0]] != 1 { fail("startThread requires a named thread entry") }
        threadTarget = tokenTexts[state[0]]
        if findLocal(localNames, localLengths, state, threadTarget) >= 0 || findLocal(localNames, localLengths, state, readableDeclarationName(threadTarget)) >= 0 || !threadEntry(globals, threadTarget) { fail("startThread requires a named thread entry") }
        let targetIndex = findFunction(functionNames, symbolKinds, functionReturnTypes, threadTarget)
        threadChannelType = functionParameterTypes[functionParameterOffset(functionParameterCounts, targetIndex) + 2]
        threadInputType = functionParameterTypes[functionParameterOffset(functionParameterCounts, targetIndex) + 1]
        state[0] = state[0] + 1
        if !tokenIs(tokenKinds, tokenTexts, state, ",") { fail("startThread requires a named thread entry followed by seed, FrozenBytes, BytesChannel") }
        state[0] = state[0] + 1
    }
    if name == "parallelEntry" {
        if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], "indirect", "parallelEntry", "unreviewed raw function address") }
        if tokenKinds[state[0]] != 1 {
            fail(describeLocation(tokenLocation(tokenLines, callLocation)) + ": parallelEntry expects the name of a parallel function")
        }
        let target = tokenTexts[state[0]]
        let function = findFunction(functionNames, symbolKinds, functionReturnTypes, target)
        if function < 0 {
            fail(describeLocation(tokenLocation(tokenLines, callLocation)) + ": I can't find a function named '" + readableDeclarationName(target) + "'")
        }
        state[0] = state[0] + 1
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        globals.add("; minyar-parallel-entry: " + target + "\n")
        let temporary = newTemporary(state)
        let entry = valueName(textState, temporary)
        output.add("  " + entry + " = ptrtoint ptr @.minyar.fn." + target + " to i64\n")
        setType(resultType, 1)
        return entry
    }
    let argumentValues: List<Text> = []
    let argumentTypes: List<Integer> = []
    let argumentType: List<Integer> = [0]
    while !tokenIs(tokenKinds, tokenTexts, state, ")") {
        setType(argumentType, 0)
        if true {
            let contextFunction = findFunction(functionNames, symbolKinds, functionReturnTypes, name)
            if contextFunction >= 0 && argumentValues.length < functionParameterCounts[contextFunction] {
                let first = functionParameterOffset(functionParameterCounts, contextFunction)
                argumentType[0] = functionParameterTypes[first + argumentValues.length]
            }
            if name == "joinText" && argumentValues.length == 0 {
                argumentType[0] = 100002
            }
        }
        argumentValues.add(parseExpression(context, localNames, localTypes, localIds, localLengths, state, textState, output, globals, argumentType))
        argumentTypes.add(argumentType[0])
        if tokenIs(tokenKinds, tokenTexts, state, ",") {
            state[0] = state[0] + 1
        }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    if (state[15] / 4 % 2) != 0 && isThreadBuiltin(name) { return threadBuiltin(output, textState, state, name, argumentValues, argumentTypes, threadTarget, threadInputType, threadChannelType, resultType) }
    if (state[15] / 4 % 2) != 0 {
    let effectKind = "call"
    if isBuiltinName(name) { effectKind = "builtin" }
    let effectResult = 0
    if effectKind == "call" {
        let resolvedEffect = findFunction(functionNames, symbolKinds, functionReturnTypes, name)
        if resolvedEffect >= 0 { effectResult = functionReturnTypes[resolvedEffect] }
    }
    if (state[15] / 4 % 2) != 0 { threadNote(output, textState[1], effectKind, name, threadSignature(effectResult, argumentTypes)) }
    }
    checkBuiltinArguments(name, argumentTypes)

    let value = ""
    if name == "print" {
        if argumentTypes[0] > 4 && argumentTypes[0] != 7 {
            fail("print expects one Integer, Float, Text, Character, or Boolean value")
        }
        let suffix = "text"
        if argumentTypes[0] == 1 {
            suffix = "integer"
        }
        if argumentTypes[0] == 7 {
            suffix = "float"
        }
        if argumentTypes[0] == 3 {
            suffix = "character"
        }
        if argumentTypes[0] == 4 {
            suffix = "boolean"
        }
        output.add("  call void @minyar_print_")
        output.add(suffix)
        output.add("(")
        output.add(nativeType(argumentTypes[0]))
        output.add(" ")
        output.add(argumentValues[0])
        output.add(")\n")
        setType(resultType, 5)
    } else {
        if name == "fail" {
            output.add("  call void @minyar_fail(ptr ")
            output.add(argumentValues[0])
            output.add(")\n")
            setType(resultType, 6)
        } else {
            if name == "exit" {
                if argumentValues.length != 1 || argumentTypes[0] != 1 {
                    fail("exit expects one Integer status")
                }
                if threadMode(globals) { output.add("  call void @minyar_thread_join_children()\n") }
                output.add("  call void @minyar_exit(i64 ")
                output.add(argumentValues[0])
                output.add(")\n")
                setType(resultType, 6)
            } else {
            if name == "Text" {
                if argumentTypes[0] == 2 {
                    value = argumentValues[0]
                    output.add("  call void @minyar_rc_retain(ptr ")
                    output.add(value)
                    output.add(")\n")
                } else {
                    let suffix = "boolean"
                    if argumentTypes[0] == 1 {
                        suffix = "integer"
                    }
                    if argumentTypes[0] == 7 {
                        suffix = "float"
                    }
                    if argumentTypes[0] == 3 {
                        suffix = "character"
                    }
                    if argumentTypes[0] == 8 {
                        suffix = "bytes"
                    }
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    output.add("  ")
                    output.add(value)
                    output.add(" = call ptr @minyar_")
                    output.add(suffix)
                    output.add("_text(")
                    output.add(nativeType(argumentTypes[0]))
                    output.add(" ")
                    output.add(argumentValues[0])
                    output.add(")\n")
                }
                setType(resultType, 2)
            } else {
                if name == "joinText" {
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    output.add("  ")
                    output.add(value)
                    output.add(" = call ptr @minyar_join_texts(ptr ")
                    output.add(argumentValues[0])
                    output.add(")\n")
                    setType(resultType, 2)
                } else {
                if isNumericBuiltin(name) {
                    value = emitNumericBuiltin(output, textState, state, name, argumentValues, argumentTypes, resultType)
                    if name == "Integer" && argumentTypes.length == 1 && argumentTypes[0] == 2 {
                        appendTextRuntimeDeclaration(globals, "minyar_text_integer", 1, 1)
                    }
                } else {
                    let functionIndex = state[5]
                    if functionIndex < 0 || functionNames[functionIndex] != name {
                        functionIndex = findFunction(functionNames, symbolKinds, functionReturnTypes, name)
                        state[5] = functionIndex
                    }
                    if functionIndex < 0 {
                        fail(describeLocation(tokenLocation(tokenLines, callLocation)) + ": I can't find a function named '" + readableDeclarationName(name) + "'")
                    }
                    if name == "main" {
                        fail("the executable entry main cannot be called; use a separate function for shared work")
                    }
                    if argumentValues.length != functionParameterCounts[functionIndex] {
                        fail(readableDeclarationName(name) + " expects " + Text(functionParameterCounts[functionIndex]) + " arguments, but received " + Text(argumentValues.length) + " near " + describeLocation(tokenLocation(tokenLines, state[0])))
                    }
                    let parameterOffset = functionParameterOffset(functionParameterCounts, functionIndex)
                    let argumentIndex = 0
                    while argumentIndex < argumentValues.length {
                        if argumentTypes[argumentIndex] != functionParameterTypes[parameterOffset + argumentIndex] {
                            fail(describeLocation(tokenLocation(tokenLines, state[0])) + ": an argument passed to " + readableDeclarationName(name) + " has the wrong type")
                        }
                        argumentIndex = argumentIndex + 1
                    }
                    let returnType = functionReturnTypes[functionIndex]
                    context.callTargets.add(functionIndex)
                    state[14] = state[14] + 1
                    let callee = context.functionIRNames[functionIndex]
                    value = emitCall(output, textState, state, returnType, callee, argumentValues, argumentTypes)
                    recoveryCheckpoint(output, textState, state)
                    setType(resultType, returnType)
                }
                }
            }
            }
        }
    }
    return value
}
