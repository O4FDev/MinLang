// Standalone opt-in remarks describe this proof, never runtime alias counts.
function ownershipRemarksRequested(): Boolean {
    let position = 2
    if processInfo.argumentCount() > 2 && processInfo.argument(2) == "--module-state" { position = 6 }
    while position < processInfo.argumentCount() {
        let argument = processInfo.argument(position)
        if argument == "--library" || argument == "--error-format" || argument == "--kernel-target" { position = position + 1 } else if argument == "--explain-ownership" { return true }
        position = position + 1
    }
    return false
}

function terminalOwnershipRemark(context: CompilerContext, node: Integer, decision: Text, reason: Text) {
    let site = context.terminalReuse
    if !site.explain { return }
    let span = syntaxSpan(context.syntax, node)
    site.remarks.add("{\"version\":1,\"severity\":\"remark\",\"pass\":\"terminal-ownership\",\"file\":" + diagnosticJsonText(span.file) + ",\"line\":" + Text(span.line) + ",\"column\":" + Text(span.column) + ",\"decision\":" + diagnosticJsonText(decision) + ",\"reason\":" + diagnosticJsonText(reason) + "}\n")
}

function finishOwnershipRemarks(context: CompilerContext) {
    if context.terminalReuse.explain {
        let index = 0
        while index < context.terminalReuse.remarks.length {
            diagnosticWrite(context.terminalReuse.remarks[index])
            index = index + 1
        }
    }
}

function keepReference(output: List<Text>, state: List<Integer>, value: Text, type: Integer): Integer {
    let owner = -1
    if isReferenceType(type) {
        owner = output.length
        state[6] = 1
        state[7] = state[7] + 1
        output.add("  call void @minyar_rc_keep(ptr ")
        output.add(value)
        output.add(")\n")
    }
    return owner
}

function markOwner(resultType: List<Integer>, owner: Integer) {
    if resultType.length == 1 {
        resultType.add(owner)
    } else {
        resultType[1] = owner
    }
}

function ownResult(output: List<Text>, state: List<Integer>, value: Text, resultType: List<Integer>) {
    if recoveryEnabled(state) && resultType.length > 1 && resultType[1] >= 0 { return }
    if isReferenceType(resultType[0]) {
        markOwner(resultType, keepReference(output, state, value, resultType[0]))
    }
}

function takeResult(output: List<Text>, state: List<Integer>, value: Text, resultType: List<Integer>): Boolean {
    if isReferenceType(resultType[0]) && resultType.length > 1 {
        let owner = resultType[1]
        if takeOwner(output, state, value, owner) {
            resultType[1] = -1
            return true
        }
    }
    return false
}

// In frame lowering, a protecting borrow of the returned value is its count for
// the caller when nothing ran after the read: `return holder.name` retains once
// and keeps no temporary. A borrow that later code relied on stays in the
// frame, and the return publishes a separate count. Scope lowering keeps the
// borrow, whose scope poll is the return's cleanup progress point.
function takeReturnedResult(output: List<Text>, state: List<Integer>, value: Text, resultType: List<Integer>, handOff: Boolean): Boolean {
    if isReferenceType(resultType[0]) && resultType.length > 1 {
        let owner = resultType[1]
        if owner >= 0 && owner < output.length {
            if output[owner] == "  call void @minyar_rc_borrow(ptr " + value + ")\n" { return false }
            if handOff && output[owner] == "  call void @minyar_rc_borrow(ptr " && !piecesRunCode(output, owner + 3) { return takeResult(output, state, value, resultType) }
            if output[owner] == "  call void @minyar_rc_borrow(ptr " { return false }
        }
    }
    return takeResult(output, state, value, resultType)
}

function piecesRunCode(output: List<Text>, start: Integer): Boolean {
    let piece = start
    while piece < output.length {
        if output[piece].find("call ") >= 0 || output[piece].find("invoke ") >= 0 { return true }
        piece = piece + 1
    }
    return false
}

// Whether the body keeps temporaries or uses local owner slots. A function
// that only hands counts to its caller or to consumers owns nothing.
function bodyUsesFrame(output: List<Text>, start: Integer): Boolean {
    let piece = start
    while piece < output.length {
        let text = output[piece]
        let at = text.find("@minyar_rc_")
        if at >= 0 {
            let rest = text.slice(at + 11, text.length)
            if rest.startsWith("keep") || rest.startsWith("borrow") || rest.startsWith("local") || rest.startsWith("scope") || rest.startsWith("enter_stack") || rest.startsWith("leave_stack") { return true }
        }
        if text.find("minyar-owned-local-transfer") >= 0 { return true }
        piece = piece + 1
    }
    return false
}

// A Result propagation or another expression-level early return can leave
// before a later consumer. Counts produced before that branch must remain in
// the temporary frame so the failing path releases them.
function ownerCrossesReturn(output: List<Text>, owner: Integer): Boolean {
    let piece = owner + 1
    while piece < output.length {
        if output[piece].find("  ret ") >= 0 { return true }
        piece = piece + 1
    }
    return false
}

function takeOwner(output: List<Text>, state: List<Integer>, value: Text, owner: Integer): Boolean {
    if recoveryEnabled(state) { return false }
    if owner == -1 { return false }
    if output[owner] == "  ; minyar-owned-local-transfer\n" {
        output.add("  call void @minyar_rc_local_move_owner(i64 ")
        output.add(output[owner + 1])
        output.add(", ptr ")
        output.add(value)
        output.add(")\n")
        output[owner] = ""
        output[owner + 1] = ""
        return true
    }
    if ownerCrossesReturn(output, owner) { return false }
    if output[owner] == "  call void @minyar_rc_keep(ptr " && output[owner + 1] == value {
        output[owner] = ""
        output[owner + 1] = ""
        output[owner + 2] = ""
        state[7] = state[7] - 1
        return true
    }
    // A protecting borrow already retained the value for this expression.
    // Give that count to the consumer instead of keeping it as a temporary.
    if output[owner] == "  call void @minyar_rc_borrow(ptr " && output[owner + 1] == value {
        output[owner] = "  call void @minyar_rc_retain(ptr "
        state[7] = state[7] - 1
        return true
    }
    let borrow = "  call void @minyar_rc_borrow(ptr " + value + ")\n"
    if output[owner] == borrow {
        output[owner] = "  call void @minyar_rc_retain(ptr " + value + ")\n"
        state[7] = state[7] - 1
        return true
    }
    return false
}

function ungroupOwnershipNode(tree: SyntaxTree, node: Integer): Integer {
    while node >= 0 && tree.nodes[node].kind == 207 {
        let child = tree.nodes[node].firstChild
        if child < 0 || tree.nodes[child].nextSibling >= 0 { return -1 }
        node = child
    }
    return node
}

function directOwnershipName(context: CompilerContext, node: Integer): Boolean {
    if node < 0 { return false }
    let expression = context.syntax.nodes[node]
    return expression.kind == 200 && expression.firstChild < 0 && expression.end == expression.start + 1 && context.tokenKinds[expression.start] == 1
}

function beginLocalMoves(context: CompilerContext, state: List<Integer>, threadEntryFunction: Boolean) {
    let analysis = context.localMoves
    analysis.enabled = !recoveryEnabled(state) && state[15] % 2 == 0 && !threadEntryFunction
    analysis.budget = 65536
    analysis.reads.clear()
    analysis.loops.clear()
    analysis.sites.clear()
    analysis.values.clear()
}

function localMoveStorage(analysis: LocalMoveAnalysis, id: Integer): Boolean {
    if !analysis.enabled || id < 0 || id >= 4096 { return false }
    while analysis.reads.length <= id { analysis.reads.add(-1); analysis.loops.add(-2) }
    return true
}

// Reads are recorded in evaluation order, not syntax-node allocation order.
// Assignment receivers also call this: their final field type may be scalar.
function noteLocalRead(context: CompilerContext, id: Integer, node: Integer) {
    let analysis = context.localMoves
    if !analysis.enabled || id < 0 || id >= analysis.loops.length { return }
    if analysis.loops[id] < -1 { return }
    context.syntax.nodes[node].symbol = id
    analysis.reads[id] = node
}

function localMoveLoop(context: CompilerContext, node: Integer): Integer {
    let analysis = context.localMoves
    let depth = 0
    while node >= 0 {
        if analysis.budget <= 0 || depth >= 256 { analysis.enabled = false; return -2 }
        analysis.budget = analysis.budget - 1
        let kind = context.syntax.nodes[node].kind
        if kind == 102 || kind == 103 { return node }
        node = context.syntax.nodes[node].parent
        depth = depth + 1
    }
    return -1
}

function noteMoveBinding(context: CompilerContext, id: Integer, type: Integer) {
    if !isReferenceType(type) { return }
    let analysis = context.localMoves
    if !localMoveStorage(analysis, id) { return }
    analysis.loops[id] = localMoveLoop(context, context.syntax.active)
}

// Reserve a separate fragment immediately before the actual runtime call.
// Cycle fixups must continue to point at the callee, never at this move.
function reserveLocalTake(context: CompilerContext, state: List<Integer>, output: List<Text>, value: Text, root: Integer) {
    let analysis = context.localMoves
    if !analysis.enabled { return }
    let node = ungroupOwnershipNode(context.syntax, root)
    if !directOwnershipName(context, node) { return }
    let expression = context.syntax.nodes[node]
    if !isReferenceType(expression.type) { return }
    let id = expression.symbol
    if id < 0 || id >= analysis.reads.length { return }
    if analysis.reads[id] != node || analysis.loops[id] < -1 || scalarRecordValues(state, id) >= 0 { return }
    let loop = localMoveLoop(context, node)
    if !analysis.enabled || loop != analysis.loops[id] { return }
    if analysis.values.length >= 8192 { analysis.enabled = false; return }
    analysis.sites.add(id)
    analysis.sites.add(node)
    analysis.sites.add(output.length)
    analysis.values.add(value)
    output.add("")
}

function finishLocalMoves(context: CompilerContext, state: List<Integer>, output: List<Text>) {
    let analysis = context.localMoves
    if !analysis.enabled { return }
    let site = 0
    while site < analysis.values.length {
        let first = site * 3
        let id = analysis.sites[first]
        let node = analysis.sites[first + 1]
        let move = analysis.sites[first + 2]
        if analysis.reads[id] == node {
            let callee = output[move + 1]
            let consuming = ""
            if callee == "  call void @minyar_list_add(ptr " { consuming = "  call void @minyar_list_add_take(ptr " }
            if callee == "  call void @minyar_list_set(ptr " { consuming = "  call void @minyar_list_set_take(ptr " }
            if callee == "  call void @minyar_list_add_all(ptr " { consuming = "  call void @minyar_list_add_all_take(ptr " }
            // A record field store retains its value where a move from the same
            // local gives it that local's count instead: one call replacing the
            // retain, and the cell's own release becomes a release of nothing.
            let referenceStore = "  call void @minyar_record_set_reference(ptr "
            if callee.startsWith(referenceStore) { consuming = "  call void @minyar_record_set_take(ptr " + callee.slice(referenceStore.length, callee.length) }
            if consuming != "" {
                output[move] = "  call void @minyar_rc_local_move_owner(i64 " + Text(ownershipSlot(state, id)) + ", ptr " + analysis.values[site] + ")\n"
                output[move + 1] = consuming
                state[6] = 1
            }
        }
        site = site + 1
    }
    analysis.enabled = false
}

// Keep only the most recent consumer site. A complete expression root emits after
// its arguments, so exact node identity suffices; inner/stale sites cannot match.
function noteTerminalReuse(context: CompilerContext, node: Integer, transferPiece: Integer, calleePiece: Integer, receiver: Text) {
    let site = context.terminalReuse
    site.node = node
    site.transferPiece = transferPiece
    site.calleePiece = calleePiece
    site.receiver = receiver
}

function takeTerminalReuse(context: CompilerContext, localNames: List<Text>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, output: List<Text>, target: Integer) {
    if recoveryEnabled(state) { return }
    let tree = context.syntax
    let node = ungroupOwnershipNode(tree, tree.nodes[tree.active].lastChild)
    let site = context.terminalReuse
    if node < 0 || site.node != node { return }
    let callee = output[site.calleePiece]
    if callee != "minyar_join_text" && callee != "minyar_list_appended" { return }
    let receiver = ungroupOwnershipNode(tree, tree.nodes[node].firstChild)
    if !directOwnershipName(context, receiver) {
        terminalOwnershipRemark(context, node, "retain", "the receiver is not a direct local binding; this proof preserves its ownership")
        return
    }
    let local = findLocal(localNames, localLengths, state, context.tokenTexts[tree.nodes[receiver].start])
    // A binding that never owned a value has no count to give the consumer.
    if local < 0 || localIds[local] < 0 || !ownershipSlotAllocated(state, localIds[local]) {
        terminalOwnershipRemark(context, node, "retain", "the receiver has no transferable local owner; this proof preserves its ownership")
        return
    }
    // Assignment ends this owner's lifetime only when replacing that binding.
    // A return passes -1 because every local ends on its completed path.
    if target >= 0 && localIds[local] != target {
        terminalOwnershipRemark(context, node, "retain", "the assignment replaces a different binding, so the receiver remains live")
        return
    }
    state[6] = 1
    let slot = ownershipSlot(state, localIds[local])
    // The reserved fragment follows all argument evaluation. Keep the local
    // rooted until then; the consuming runtime operation checks actual aliases.
    output[site.transferPiece] = "  call void @minyar_rc_local_move_owner(i64 " + Text(slot) + ", ptr " + site.receiver + ")\n"
    if callee == "minyar_join_text" { output[site.calleePiece] = "minyar_join_text_take_left" }
    else { output[site.calleePiece] = "minyar_list_appended_take" }
    terminalOwnershipRemark(context, node, "transfer", "the local owner can transfer after argument evaluation; runtime uniqueness still decides storage reuse")
    site.node = -1
}

function prepareRecordReuse(context: CompilerContext, state: List<Integer>, target: Integer, type: Integer) {
    let site = context.recordReuse
    site.target = -1
    site.node = -1
    if recoveryEnabled(state) || state[15] / 1 % 2 != 0 { return }
    if target < 0 || !isRecordType(type) || !isReferenceType(type) { return }
    if scalarRecordValues(state, target) >= 0 { return }
    if state[15] / 32 % 2 != 0 && isCRecord(context, type) { return }
    if state[15] / 4096 % 2 != 0 && choiceCases(context, type).length > 0 { return }
    let record = recordTypeIndex(type)
    let count = context.functionParameterCounts[record]
    if count > 16 { return }
    let first = functionParameterOffset(context.functionParameterCounts, record)
    let field = 0
    while field < count {
        let kind = context.functionParameterTypes[first + field]
        if kind != 1 && kind != 3 && kind != 4 && kind != 7 { return }
        field = field + 1
    }
    site.target = target
    site.type = type
    site.statement = context.syntax.active
}

function recordReuseCandidate(context: CompilerContext, node: Integer, type: Integer): Boolean {
    let site = context.recordReuse
    if site.target < 0 || site.type != type { return false }
    let tree = context.syntax
    let parent = tree.nodes[node].parent
    while parent >= 0 && tree.nodes[parent].kind == 207 { parent = tree.nodes[parent].parent }
    return parent == site.statement
}

function takeRecordReconstruction(context: CompilerContext, state: List<Integer>, textState: List<Text>, output: List<Text>, target: Integer, resultType: List<Integer>) {
    let site = context.recordReuse
    if recoveryEnabled(state) || site.target != target || site.node < 0 { return }
    let tree = context.syntax
    let node = ungroupOwnershipNode(tree, tree.nodes[tree.active].lastChild)
    if node != site.node || tree.nodes[node].kind != 210 || resultType[0] != site.type { return }
    if resultType.length < 2 || resultType[1] != site.owner { return }
    if output[site.owner] != "  call void @minyar_rc_keep(ptr " || output[site.owner + 1] != site.value { return }
    let previous = valueName(textState, newTemporary(state))
    output[site.latePiece] = "  " + previous + " = load ptr, ptr %local." + Text(target) + "\n  call void @minyar_rc_local_move_owner(i64 " + Text(ownershipSlot(state, target)) + ", ptr " + previous + ")\n  " + site.value + " = call ptr @minyar_record_reuse_scalar_take(ptr " + previous + ", i64 " + Text(site.fields) + ")\n"
    // Initializers already captured every scalar value. Neither allocation nor
    // a field store may precede those reads, calls or early propagation paths.
    let piece = site.allocationStart
    while piece < site.allocationEnd { output[piece] = ""; piece = piece + 1 }
    state[7] = state[7] - 1
    markOwner(resultType, keepReference(output, state, site.value, site.type))
    let stored = 0
    while stored < site.stores.length {
        let fieldPiece = site.stores[stored]
        while fieldPiece < site.stores[stored + 1] {
            output.add(output[fieldPiece])
            output[fieldPiece] = ""
            fieldPiece = fieldPiece + 1
        }
        stored = stored + 2
    }
    site.target = -1
    site.node = -1
}

// A direct local return is the binding's last use on this control-flow path.
// Inspect the checked expression, so fields, calls and operators cannot be
// mistaken for a return of their receiver. Shared heap values remain shared.
function takeReturnedLocal(context: CompilerContext, localNames: List<Text>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, output: List<Text>, value: Text): Boolean {
    if recoveryEnabled(state) { return false }
    let tree = context.syntax
    let node = ungroupOwnershipNode(tree, tree.nodes[tree.active].lastChild)
    if !directOwnershipName(context, node) { return false }
    if !isReferenceType(tree.nodes[node].type) { return false }
    let local = findLocal(localNames, localLengths, state, context.tokenTexts[tree.nodes[node].start])
    if local < 0 || localIds[local] < 0 || !ownershipSlotAllocated(state, localIds[local]) { return false }
    state[6] = 1
    output.add("  call void @minyar_rc_local_move_owner(i64 ")
    output.add(Text(ownershipSlot(state, localIds[local])))
    output.add(", ptr ")
    output.add(value)
    output.add(")\n")
    return true
}

function ownershipSlot(state: List<Integer>, id: Integer): Integer {
    let entry = 16 + id * 2
    while state.length <= entry + 1 {
        state.add(-1)
    }
    if state[entry] != state[9] {
        state[entry] = state[9]
        state[entry + 1] = state[8]
        state[8] = state[8] + 1
    }
    return state[entry + 1]
}

// Token scans cannot see every way an expression runs user code: capability
// operators such as == on Equatable records, Map key callbacks and record
// iteration have no call token. Codegen records each user call target, and a
// Map operation may call key callbacks, so either one counts.
function ranUserCode(context: CompilerContext, output: List<Text>, start: Integer, calls: Integer): Boolean {
    if context.callTargets.length != calls { return true }
    let index = start
    while index < output.length {
        if output[index].find("@minyar_map_") >= 0 { return true }
        index = index + 1
    }
    return false
}

// A provisional temporary count reserved an empty piece before code that might
// replace its value's container. Fill it if that code ran user code after all.
function settleBorrow(context: CompilerContext, output: List<Text>, state: List<Integer>, piece: Integer, value: Text, type: Integer, calls: Integer) {
    if !ranUserCode(context, output, piece, calls) || !isReferenceType(type) { return }
    state[6] = 1
    state[7] = state[7] + 1
    noteCycleFixup(output, context.functionReturnTypes, context.functionParameterCounts, context.functionParameterTypes, piece, type, 0)
    output[piece] = "  call void @minyar_rc_borrow(ptr " + value + ")\n"
}

// The same for a provisional local owner, as rootLocal would have emitted it.
function rootLocalAt(context: CompilerContext, output: List<Text>, state: List<Integer>, piece: Integer, id: Integer, value: Text, type: Integer) {
    if !isReferenceType(type) { return }
    let owner = ownershipSlot(state, id)
    if owner < 0 { return }
    state[6] = 1
    output[piece] = "  call void @minyar_rc_local(i64 " + Text(owner) + ", ptr " + value + ")\n"
    noteCycleFixup(output, context.functionReturnTypes, context.functionParameterCounts, context.functionParameterTypes, piece, type, 0)
}

// A local that never received an owner slot in this function holds nothing to release.
function hasOwnershipSlot(state: List<Integer>, id: Integer): Boolean {
    let entry = 16 + id * 2
    return entry + 1 < state.length && state[entry] == state[9] && state[entry + 1] >= 0
}

function scalarRecordValues(state: List<Integer>, id: Integer): Integer {
    if id < 0 { return -1 }
    let entry = 16 + id * 2
    if entry + 1 < state.length && state[entry] == state[9] && state[entry + 1] < -1 {
        return -2 - state[entry + 1]
    }
    return -1
}

function markScalarRecord(state: List<Integer>, id: Integer, values: Integer) {
    let entry = 16 + id * 2
    while state.length <= entry + 1 { state.add(-1) }
    state[entry] = state[9]
    state[entry + 1] = -2 - values
}

function prepareScalarRecord(tokenKinds: List<Integer>, tokenTexts: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, symbolLookup: List<Integer>, counts: List<Integer>, fields: List<Integer>, state: List<Integer>, name: Text, context: CompilerContext) {
    context.mutableScalarRecord = false
    if (state[15] / 1 % 2) != 0 || state[15] / 32 % 2 != 0 { return }
    let record = findCompiledSymbol(functionNames, symbolKinds, symbolLookup, tokenTexts[state[0]], 2)
    if record < 0 { return }
    let cost = counts[record] * 8
    if cost == 0 { cost = 8 }
    if cost > 512 - state[11] { return }
    let first = functionParameterOffset(counts, record)
    let field = 0
    while field < counts[record] {
        if isReferenceType(fields[first + field]) { return }
        field = field + 1
    }
    state[11] = state[11] + cost
    let cursor: List<Integer> = [state[0]]
    skipDeclaration(tokenKinds, tokenTexts, context.tokenLines, cursor)
    let position = cursor[0]
    if tokenKinds[position] != 0 && tokenKinds[position] != 6 && tokenTexts[position] != "}" { return }
    let depth = 0
    let done = false
    let writable = false
    while tokenKinds[position] != 0 && !done {
        if tokenKinds[position] == 1 && tokenTexts[position] == name {
            if position + 1 >= tokenTexts.length || tokenTexts[position + 1] != "." { return }
            if position + 3 < tokenTexts.length && tokenTexts[position + 3] == "(" { return }
            if position + 3 < tokenTexts.length && tokenKinds[position + 3] == 4 && isAssignmentOperator(tokenTexts[position + 3]) { writable = true }
        }
        if tokenKinds[position] == 4 {
            if tokenTexts[position] == "{" { depth = depth + 1 }
            if tokenTexts[position] == "}" {
                if depth == 0 { done = true } else { depth = depth - 1 }
            }
        }
        position = position + 1
    }
    state[10] = state[4]
    context.mutableScalarRecord = writable
}

function ownershipSlotAllocated(state: List<Integer>, id: Integer): Boolean {
    let entry = 16 + id * 2
    return entry + 1 < state.length && state[entry] == state[9]
}

function plainRecordType(context: CompilerContext, type: Integer): Boolean {
    if !isRecordType(type) || isScalarChoiceType(type) || isCRecord(context, type) { return false }
    let record = recordTypeIndex(type)
    let counts = context.functionParameterCounts
    return counts[record] == 0 || !resultPrefix(context.functionParameterNames[functionParameterOffset(counts, record)], "minyar_choice_tag|")
}

// A type outside every reference cycle never becomes traced, so its values
// need no collector shading when a binding borrows them.
function untracedBorrowType(context: CompilerContext, type: Integer): Boolean {
    let known = 0
    while known < context.untracedTypes.length {
        if context.untracedTypes[known] == type { return context.untracedResults[known] }
        known = known + 1
    }
    let result = true
    let base = type
    while isContainerType(base) { base = containerValueType(base) }
    if isRecordType(base) && !isScalarChoiceType(base) {
        let counts = context.functionParameterCounts
        let fields = context.functionParameterTypes
        if !plainRecordType(context, base) { result = false } else {
            if isContainerType(type) { result = !cycleTypeReaches(containerValueType(type), type, counts, fields) } else {
                let record = recordTypeIndex(type)
                let first = functionParameterOffset(counts, record)
                let field = 0
                while field < counts[record] && result {
                    if cycleTypeReaches(fields[first + field], type, counts, fields) { result = false }
                    field = field + 1
                }
            }
        }
    }
    context.untracedTypes.add(type)
    context.untracedResults.add(result)
    return result
}

// A choice or Result value can become traced only through a reference cycle
// whose types include a List or an ordinary record: activation needs a List
// or field mutation inside that cycle, and choice payloads are never
// reassigned. A cycle made only of choices and Results is built by
// construction alone, so such a value is never traced. A two-case choice whose
// payload is the value itself (a niche) is traced as that payload.
function untracedValueType(context: CompilerContext, type: Integer): Boolean {
    if untracedBorrowType(context, type) { return true }
    if !isRecordType(type) || isScalarChoiceType(type) || isCRecord(context, type) { return false }
    let physical = choiceOwnershipType(context, type)
    if physical != type { return untracedValueType(context, physical) }
    if choiceMatchCases(context, type).length == 0 { return false }
    let known = 0
    while known < context.untracedChoiceTypes.length {
        if context.untracedChoiceTypes[known] == type { return context.untracedChoiceResults[known] }
        known = known + 1
    }
    let counts = context.functionParameterCounts
    let fields = context.functionParameterTypes
    let visited: List<Boolean> = []
    while visited.length < counts.length / 2 { visited.add(false) }
    visited[recordTypeIndex(type)] = true
    let pending: List<Integer> = []
    let first = functionParameterOffset(counts, recordTypeIndex(type))
    let field = 0
    while field < counts[recordTypeIndex(type)] { pending.add(fields[first + field]); field = field + 1 }
    let result = true
    let position = 0
    while position < pending.length && result {
        let member = pending[position]
        position = position + 1
        while isContainerType(member) && result {
            if cycleTypeReaches(member, type, counts, fields) { result = false }
            member = containerValueType(member)
        }
        if result && isRecordType(member) && !isScalarChoiceType(member) && !visited[recordTypeIndex(member)] {
            visited[recordTypeIndex(member)] = true
            if cycleTypeReaches(member, type, counts, fields) && (isCRecord(context, member) || choiceMatchCases(context, member).length == 0) { result = false }
            let start = functionParameterOffset(counts, recordTypeIndex(member))
            field = 0
            while field < counts[recordTypeIndex(member)] { pending.add(fields[start + field]); field = field + 1 }
        }
    }
    context.untracedChoiceTypes.add(type)
    context.untracedChoiceResults.add(result)
    return result
}

// Reserve the binding's owner slot (so every exit clears it) and an empty
// owner piece; finishProvisionalBorrows decides at module end.
function provisionalBorrow(context: CompilerContext, output: List<Text>, state: List<Integer>, id: Integer, value: Text, type: Integer) {
    let borrows = context.provisionalBorrows
    let slot = ownershipSlot(state, id)
    state[6] = 1
    noteCycleFixup(output, context.functionReturnTypes, context.functionParameterCounts, context.functionParameterTypes, output.length, type, 0)
    borrows.pieces.add(output.length)
    borrows.slots.add(slot)
    borrows.values.add(value)
    borrows.types.add(type)
    borrows.functions.add(borrows.current)
    borrows.bodyStarts.add(-1)
    borrows.bodyEnds.add(-1)
    borrows.strictBodies.add(false)
    output.add("")
}

// A `for` element's owner, needed only because the loop body (pieces
// bodyStart..bodyEnd) calls user code: reserve its slot and leave its owner
// piece empty; finishProvisionalBorrows fills it unless every call there is
// release-free.
function provisionalElementOwner(context: CompilerContext, output: List<Text>, state: List<Integer>, piece: Integer, id: Integer, value: Text, type: Integer, bodyStart: Integer, bodyEnd: Integer) {
    let borrows = context.provisionalBorrows
    let slot = ownershipSlot(state, id)
    if slot < 0 { return }
    state[6] = 1
    noteCycleFixup(output, context.functionReturnTypes, context.functionParameterCounts, context.functionParameterTypes, piece, type, 0)
    borrows.pieces.add(piece)
    borrows.slots.add(slot)
    borrows.values.add(value)
    borrows.types.add(type)
    borrows.functions.add(borrows.current)
    borrows.bodyStarts.add(bodyStart)
    borrows.bodyEnds.add(bodyEnd)
    borrows.strictBodies.add(false)
}

// A guarded binding's owner, needed only because code after it (pieces
// bodyStart..bodyEnd) makes user calls: finishProvisionalBorrows fills the
// piece unless every one of those calls is release-free.
function provisionalGuardBorrow(context: CompilerContext, output: List<Text>, piece: Integer, slot: Integer, value: Text, type: Integer, bodyStart: Integer, bodyEnd: Integer) {
    if slot < 0 || !context.provisionalBorrows.enabled { return }
    let borrows = context.provisionalBorrows
    noteCycleFixup(output, context.functionReturnTypes, context.functionParameterCounts, context.functionParameterTypes, piece, type, 0)
    borrows.pieces.add(piece)
    borrows.slots.add(slot)
    borrows.values.add(value)
    borrows.types.add(type)
    borrows.functions.add(borrows.current)
    borrows.bodyStarts.add(bodyStart)
    borrows.bodyEnds.add(bodyEnd)
    borrows.strictBodies.add(true)
}

// A statement temporary's count, needed only because the rest of the
// statement (pieces bodyStart..bodyEnd) makes user calls: the module end fills
// the piece with a protecting borrow unless every one of those calls is
// release-free.
function provisionalValueBorrow(context: CompilerContext, piece: Integer, value: Text, type: Integer, bodyStart: Integer, bodyEnd: Integer) {
    if !context.provisionalBorrows.enabled { return }
    let borrows = context.provisionalBorrows
    borrows.pieces.add(piece)
    borrows.slots.add(-1)
    borrows.values.add(value)
    borrows.types.add(type)
    borrows.functions.add(borrows.current)
    borrows.bodyStarts.add(bodyStart)
    borrows.bodyEnds.add(bodyEnd)
    borrows.strictBodies.add(true)
}

// Releasing an owner or temporary of one's own, or taking a field of a record
// one owns, drops only counts the running function holds.
function ownCountCallee(callee: Text): Boolean {
    return callee.startsWith("@minyar_rc_release(") || callee.startsWith("@minyar_rc_enter(") || callee.startsWith("@minyar_record_take_field(")
}

// A field store into a record this code created (the store's record is the
// value of a record_new call in the same code) fills a record no one else
// holds yet: it can release only a count this code added.
function freshRecordStore(code: Text, callee: Text): Boolean {
    if !(callee.startsWith("@minyar_record_set(ptr %") || callee.startsWith("@minyar_record_set_take(ptr %") || callee.startsWith("@minyar_record_set_reference(ptr %")) { return false }
    let open = callee.find("(ptr ")
    let rest = callee.slice(open + 5, callee.length)
    let comma = rest.find(",")
    if comma < 0 { return false }
    let record = rest.slice(0, comma)
    return code.find(" " + record + " = call ptr @minyar_record_new(") >= 0 || code.find(" " + record + " = call ptr @minyar_record_new_scalar(") >= 0
}

// Whether code in pieces start..end calls only runtime operations in the
// loop-body set (with `strict`, without container stores, plus releases of its
// own counts) and internal functions that are release-free themselves. Such
// calls cannot release a List slot, record field or Map value that a caller's
// borrowed element depends on. memo, per provisional function: 0 unknown,
// 1 being decided (a call cycle assumes free), 2 free, 3 not free; touched
// lists those set to 1 or 2 by this query, for the caller to reset on failure.
function releaseFreeCalls(context: CompilerContext, output: List<Text>, start: Integer, end: Integer, strict: Boolean, lookup: GenericIndex, memo: List<Integer>, touched: List<Integer>): Boolean {
    let pieces: List<Text> = []
    let index = start
    while index < end {
        pieces.add(output[index])
        index = index + 1
    }
    let code = joinText(pieces)
    if code.find("invoke ") >= 0 { return false }
    // Each part after the first starts right after a "call " and holds its callee.
    let parts = code.split("call ")
    let part = 1
    while part < parts.length {
        let rest = parts[part]
        let at = rest.find("@")
        let indirect = rest.find("%")
        if at < 0 || (indirect >= 0 && indirect < at) { return false }
        let callee = rest.slice(at, rest.length)
        if callee.startsWith("@.minyar.fn.") {
            let open = callee.find("(")
            if open < 0 { return false }
            let function = genericIndexGet(lookup, callee.slice(1, open))
            if function < 0 || !releaseFreeFunction(context, output, function, lookup, memo, touched) { return false }
        } else if !(loopBodyCallee(callee, strict) || (strict && (ownCountCallee(callee) || freshRecordStore(code, callee))) || parallelCallee(context, callee)) { return false }
        part = part + 1
    }
    return true
}

function releaseFreeFunction(context: CompilerContext, output: List<Text>, function: Integer, lookup: GenericIndex, memo: List<Integer>, touched: List<Integer>): Boolean {
    let borrows = context.provisionalBorrows
    if memo[function] == 1 || memo[function] == 2 { return true }
    if memo[function] == 3 { return false }
    if borrows.ends[function] < 0 {
        memo[function] = 3
        return false
    }
    memo[function] = 1
    touched.add(function)
    if releaseFreeCalls(context, output, borrows.starts[function] + 1, borrows.ends[function], true, lookup, memo, touched) {
        memo[function] = 2
        return true
    }
    memo[function] = 3
    return false
}

// The owner slot an rc_local family call at this piece names, or -1.
function provisionalSlotAt(output: List<Text>, piece: Integer): Integer {
    let text = output[piece]
    if !text.startsWith("  call void @minyar_rc_local") { return -1 }
    let open = text.find("(i64 ")
    if open < 0 { return -1 }
    if open + 5 == text.length {
        if piece + 1 >= output.length { return -1 }
        return decimalOrMinusOne(output[piece + 1])
    }
    let rest = text.slice(open + 5, text.length)
    let comma = rest.find(",")
    if comma < 0 { comma = rest.find(")") }
    if comma < 0 { return -1 }
    return decimalOrMinusOne(rest.slice(0, comma))
}

function decimalOrMinusOne(text: Text): Integer {
    if text.length == 0 || text.length > 18 { return -1 }
    let digits = "0123456789"
    let value = 0
    let position = 0
    while position < text.length {
        let digit = 0
        while digit < 10 && text[position] != digits[digit] { digit = digit + 1 }
        if digit == 10 { return -1 }
        value = value * 10 + digit
        position = position + 1
    }
    return value
}

function nullClearAt(output: List<Text>, piece: Integer): Boolean {
    return piece + 4 < output.length && output[piece] == "  call void @minyar_rc_local(i64 " && output[piece + 2] == ", ptr " && output[piece + 3] == "null" && output[piece + 4] == ")\n"
}

function rangeUsesFrame(output: List<Text>, start: Integer, end: Integer): Boolean {
    let piece = start
    while piece < end {
        let text = output[piece]
        let at = text.find("@minyar_rc_")
        if at >= 0 {
            let rest = text.slice(at + 11, text.length)
            if rest.startsWith("keep") || rest.startsWith("borrow") || rest.startsWith("local") || rest.startsWith("scope") || rest.startsWith("enter_stack") || rest.startsWith("leave_stack") { return true }
        }
        if text.find("minyar-owned-local-transfer") >= 0 { return true }
        piece = piece + 1
    }
    return false
}

// The activated cycle roots, as finishCycleFixups computes them.
function activeCycleRoots(returnTypes: List<Integer>, counts: List<Integer>, fields: List<Integer>): List<Integer> {
    let roots: List<Integer> = []
    let position = counts.length
    while position + 1 < returnTypes.length {
        if returnTypes[position] == -3 {
            let root = -1 - returnTypes[position + 1]
            let duplicate = false
            let index = 0
            while index < roots.length {
                if roots[index] == root { duplicate = true }
                index = index + 1
            }
            if !duplicate && possibleCycleType(root, counts, fields, returnTypes) { roots.add(root) }
            position = position + 2
        } else {
            if returnTypes[position] == -2 { position = position + 4 } else { position = position + 1 }
        }
    }
    return roots
}

// Runs before finishCycleFixups, which then marks filled owners as traced.
function finishProvisionalBorrows(context: CompilerContext, output: List<Text>, returnTypes: List<Integer>, counts: List<Integer>, fields: List<Integer>) {
    let borrows = context.provisionalBorrows
    if borrows.pieces.length == 0 { return }
    let roots = activeCycleRoots(returnTypes, counts, fields)
    let seenTypes: List<Integer> = []
    let activeTypes: List<Integer> = []
    let kept: List<Boolean> = []
    while kept.length < borrows.starts.length { kept.add(false) }
    let lookup = newGenericIndex()
    let memo: List<Integer> = []
    while memo.length < borrows.starts.length {
        if borrows.names[memo.length] != "" { genericIndexPut(lookup, borrows.names[memo.length], memo.length) }
        if borrows.natives[memo.length] { memo.add(2) } else { memo.add(0) }
    }
    let borrowed: List<Boolean> = []
    while borrowed.length < borrows.starts.length { borrowed.add(false) }
    let index = 0
    while index < borrows.pieces.length {
        let function = borrows.functions[index]
        let slot = borrows.slots[index]
        let type = choiceOwnershipType(context, borrows.types[index])
        let keep = roots.length > 0 && cycleTypeActive(type, roots, counts, fields, seenTypes, activeTypes)
        if !keep && borrows.bodyStarts[index] >= 0 {
            let touched: List<Integer> = []
            keep = !releaseFreeCalls(context, output, borrows.bodyStarts[index], borrows.bodyEnds[index], borrows.strictBodies[index], lookup, memo, touched)
            if keep {
                // Answers that assumed a function still being decided was free.
                let reset = 0
                while reset < touched.length {
                    if memo[touched[reset]] != 3 { memo[touched[reset]] = 0 }
                    reset = reset + 1
                }
            }
        }
        if keep {
            if slot >= 0 {
                output[borrows.pieces[index]] = "  call void @minyar_rc_local(i64 " + Text(slot) + ", ptr " + borrows.values[index] + ")\n"
                kept[function] = true
            } else {
                // A temporary borrow needs no owner slot: a frame-free function
                // can still turn it into a retain and a release below.
                output[borrows.pieces[index]] = "  call void @minyar_rc_borrow(ptr " + borrows.values[index] + ")\n"
                borrowed[function] = true
            }
        } else {
            // The slot now starts empty. Its clears go too, unless code that
            // reassigns or moves the binding still writes the slot.
            let end = borrows.ends[function]
            let written = false
            let clears: List<Integer> = []
            let piece = borrows.starts[function] + 1
            while piece < end {
                if provisionalSlotAt(output, piece) == slot {
                    if nullClearAt(output, piece) { clears.add(piece) } else { written = true }
                }
                piece = piece + 1
            }
            if written { kept[function] = true } else {
                let clear = 0
                while clear < clears.length {
                    let at = clears[clear]
                    output[at] = ""
                    output[at + 1] = ""
                    output[at + 2] = ""
                    output[at + 3] = ""
                    output[at + 4] = ""
                    clear = clear + 1
                }
            }
        }
        index = index + 1
    }
    // A frame the fills did not need goes, and so does one whose only use is a
    // filled temporary borrow: that borrow becomes a retain the statement
    // end releases, exactly as a compiled borrow would have.
    let fixups = functionCycleFixups(returnTypes, 0)
    let function = 0
    while function < borrows.starts.length {
        let start = borrows.starts[function]
        let end = borrows.ends[function]
        if !kept[function] && borrows.elidable[function] {
            let free = !rangeUsesFrame(output, start + 1, end)
            if !free && borrowed[function] { free = releaseStatementTemporaries(output, start + 1, end, fixups) && !rangeUsesFrame(output, start + 1, end) }
            if free { elideProvisionalFrame(output, start, end) }
        }
        function = function + 1
    }
}

// Removes the frame a provisional function turned out not to need: its entry
// loses the enter, and every service point and idle query in the body goes.
function elideProvisionalFrame(output: List<Text>, start: Integer, end: Integer) {
    let entry = output[start]
    let enter = entry.find("  call void @minyar_rc_enter(i64 ")
    if enter >= 0 {
        let rest = entry.slice(enter, entry.length)
        let close = rest.find(")\n")
        output[start] = entry.slice(0, enter) + rest.slice(close + 2, rest.length)
        let piece = start + 1
        while piece < end {
            output[piece] = withoutServiceCalls(output[piece])
            piece = piece + 1
        }
        settleIdleQueriesIn(output, start + 1, end)
    }
}

// A piece can hold a whole loop copy on one entry, so every service call in
// it goes: the frame this loop runs in has no cleanup to service.
function withoutServiceCalls(text: Text): Text {
    let step = "  call void @minyar_rc_step()\n"
    if text.find(step) >= 0 { text = joinText(text.split(step)) }
    let leave = "  call void @minyar_rc_leave()\n"
    if text.find(leave) >= 0 { text = joinText(text.split(leave)) }
    return text
}

function blockAssignsName(tokenKinds: List<Integer>, tokenTexts: List<Text>, start: Integer, name: Text): Boolean {
    let position = start
    let depth = 0
    while tokenKinds[position] != 0 {
        if tokenKinds[position] == 4 {
            if tokenTexts[position] == "{" { depth = depth + 1 }
            if tokenTexts[position] == "}" {
                if depth == 0 { return false }
                depth = depth - 1
            }
        }
        if tokenKinds[position] == 1 && tokenKinds[position + 1] == 4 && isAssignmentOperator(tokenTexts[position + 1]) && tokenTexts[position] == name && (position == 0 || tokenTexts[position - 1] != ".") { return true }
        position = position + 1
    }
    return false
}

// One scan for two names.
function blockAssignsEither(tokenKinds: List<Integer>, tokenTexts: List<Text>, start: Integer, first: Text, second: Text): Boolean {
    let position = start
    let depth = 0
    while tokenKinds[position] != 0 {
        if tokenKinds[position] == 4 {
            if tokenTexts[position] == "{" { depth = depth + 1 }
            if tokenTexts[position] == "}" {
                if depth == 0 { return false }
                depth = depth - 1
            }
        }
        if tokenKinds[position] == 1 && tokenKinds[position + 1] == 4 && isAssignmentOperator(tokenTexts[position + 1]) && (tokenTexts[position] == first || tokenTexts[position] == second) && (position == 0 || tokenTexts[position - 1] != ".") { return true }
        position = position + 1
    }
    return false
}

// A temporary that one straight-line statement keeps (a protecting borrow of
// an argument, or an owned result) dies where that statement's cleanup would
// retire it. In a function with no owner slots, when every temporary is like
// that, a retain and an explicit release at that point replace the frame: the
// function needs no frame. A temporary whose call a cycle fixup may still
// rewrite keeps its frame. Returns false, changing nothing, otherwise.
function releaseStatementTemporaries(output: List<Text>, start: Integer, limit: Integer, fixups: List<Integer>): Boolean {
    let sites: List<Integer> = []
    let widths: List<Integer> = []
    let values: List<Text> = []
    let borrows: List<Boolean> = []
    let ends: List<Integer> = []
    let piece = start
    while piece < limit {
        let text = output[piece]
        // A loop keeps its frame: its back edge is the cleanup service point
        // that keeps a long loop from starving pending retirement.
        if text.find("minyar-owned-local-transfer") >= 0 || text.find("br label %for.condition.") >= 0 || text.find("br label %while.") >= 0 { return false }
        let at = text.find("@minyar_rc_")
        if at >= 0 {
            let rest = text.slice(at + 11, text.length)
            let keep = rest.startsWith("keep(")
            let borrow = rest.startsWith("borrow(")
            if keep || borrow {
                let fixed = 0
                while fixed < fixups.length {
                    if fixups[fixed] == piece { return false }
                    fixed = fixed + 1
                }
                let value = ""
                let width = 1
                if text.endsWith("(ptr ") && piece + 2 < output.length && output[piece + 2] == ")\n" {
                    value = output[piece + 1]
                    width = 3
                } else {
                    let open = rest.find("(ptr ")
                    if open < 0 || !rest.endsWith(")\n") { return false }
                    value = rest.slice(open + 5, rest.length - 2)
                }
                let end = statementCleanupAfter(output, piece + width)
                if end < 0 { return false }
                sites.add(piece)
                widths.add(width)
                values.add(value)
                borrows.add(borrow)
                ends.add(end)
                piece = piece + width - 1
            } else if rest.startsWith("local") || rest.startsWith("scope") || rest.startsWith("enter_stack") || rest.startsWith("leave_stack") || rest.startsWith("keep") || rest.startsWith("borrow") {
                return false
            }
        }
        piece = piece + 1
    }
    let index = 0
    while index < sites.length {
        let site = sites[index]
        let replacement = ""
        if borrows[index] { replacement = "  call void @minyar_rc_retain(ptr " + values[index] + ")\n" }
        output[site] = replacement
        if widths[index] == 3 {
            output[site + 1] = ""
            output[site + 2] = ""
        }
        // The function will have no frame, so the release replaces the
        // statement's cleanup call (later releases at the same point join it).
        let cleanup = output[ends[index]]
        if cleanup == "  call void @minyar_rc_step()\n" || cleanup == "  call void @minyar_rc_leave()\n" { cleanup = "" }
        output[ends[index]] = "  call void @minyar_rc_release(ptr " + values[index] + ")\n" + cleanup
        index = index + 1
    }
    return true
}

// The statement cleanup (`minyar_rc_step` or the frame's leave) that follows
// without a branch, label or return in between, or -1.
function statementCleanupAfter(output: List<Text>, start: Integer): Integer {
    let piece = start
    while piece < output.length {
        let text = output[piece]
        if text == "  call void @minyar_rc_step()\n" || text == "  call void @minyar_rc_leave()\n" { return piece }
        if text.find("br ") >= 0 || text.find("ret ") >= 0 || text.find("switch ") >= 0 || text.find("invoke ") >= 0 || text.find("unreachable") >= 0 || text.find(":\n") >= 0 { return -1 }
        // Other temporaries of the same statement may sit in between.
        let at = text.find("@minyar_rc_")
        if at >= 0 {
            let rest = text.slice(at + 11, text.length)
            if !(rest.startsWith("keep(") || rest.startsWith("borrow(") || rest.startsWith("retain(") || rest.startsWith("release(")) { return -1 }
        }
        piece = piece + 1
    }
    return -1
}

// The pieces of this function whose ownership calls a cycle fixup may rewrite:
// fixup entries recorded since `start` in returnTypes.
function functionCycleFixups(returnTypes: List<Integer>, start: Integer): List<Integer> {
    let pieces: List<Integer> = []
    let position = start
    while position < returnTypes.length {
        if returnTypes[position] == -2 && position + 1 < returnTypes.length {
            pieces.add(-1 - returnTypes[position + 1])
            position = position + 4
        } else if (returnTypes[position] == -3 || returnTypes[position] == -5) && position + 1 < returnTypes.length {
            position = position + 2
        } else {
            position = position + 1
        }
    }
    return pieces
}

// A readonly parameter or capture, and a binding whose block never reassigns
// it and whose value something keeps alive (its own count, or a source that
// outlives it), keeps its object alive for the whole scope that can name it.
// A binding that merely borrows from something mutable is not a root: that
// source can drop the value before a reader of its fields is done.
function stableBorrowRoot(context: CompilerContext, localNames: List<Text>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, name: Text, start: Integer): Boolean {
    if recoveryEnabled(state) { return false }
    let local = findLocal(localNames, localLengths, state, name)
    if local < 0 { return false }
    // The block can assign the binding after this read, and that assignment
    // drops the count or borrow the binding holds now.
    if blockAssignsName(context.tokenKinds, context.tokenTexts, start, name) { return false }
    if localIds[local] < 0 { return true }
    if localLengths[local] >= 0 { return false }
    return ownedLocal(context, state, localIds[local]) || stableCopyLocal(context, state, localIds[local])
}

// A field is stable when no compiled token assigns a field of that name, so a
// living record keeps the same value there. Module builds see one module, so
// they trust only private fields.
function stableRecordField(context: CompilerContext, type: Integer, name: Text): Boolean {
    if !plainRecordType(context, type) { return false }
    let field = findRecordField(context.functionParameterCounts, context.functionParameterNames, type, name)
    if field < 0 { return false }
    // A parallel function cannot assign fields or call code that does, and
    // its callers keep the records it reads unchanged until it returns.
    if context.parallelFunction { return true }
    if context.privateFieldsOnly && context.functionParameterNames[field].find(" ") < 0 { return false }
    let native = 0
    while native < context.nativeMutableTypes.length {
        if cycleTypeReaches(context.nativeMutableTypes[native], type, context.functionParameterCounts, context.functionParameterTypes) { return false }
        native = native + 1
    }
    return findIndexedSymbol(context.assignedFieldLookup, context.assignedFieldNames, context.assignedFieldKinds, name, 1) < 0
}

// A binding whose borrowed value outlives every copy of it: a match payload
// or walked element its arm/body never reassigns (the match input and the
// walked List keep it), or a binding of a stable field path.
function markStableCopy(context: CompilerContext, state: List<Integer>, id: Integer) {
    if id < 0 { return }
    context.stableBorrowCopies.add(state[9] * 100000 + id)
}

// The binding took a count of its value: a field read through it stays alive
// while the binding lives (its cell is released after the binding's scope).
function markOwnedLocal(context: CompilerContext, state: List<Integer>, id: Integer) {
    if id < 0 { return }
    context.ownedLocals.add(state[9] * 100000 + id)
}

function ownedLocal(context: CompilerContext, state: List<Integer>, id: Integer): Boolean {
    let key = state[9] * 100000 + id
    let index = context.ownedLocals.length - 1
    while index >= 0 {
        let entry = context.ownedLocals[index]
        if entry / 100000 != state[9] { return false }
        if entry == key { return true }
        index = index - 1
    }
    return false
}

// Whether the anchor of a stable path holds a count of its value (or is a
// readonly parameter or capture, whose caller keeps it). A cycle collection
// never frees a value reachable from such a count, so a traced value read
// through the path needs no count of its own either.
function stablePathAnchor(context: CompilerContext, localNames: List<Text>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, atom: Integer): Boolean {
    let local = findLocal(localNames, localLengths, state, context.tokenTexts[atom])
    if local < 0 { return false }
    if localIds[local] < 0 { return true }
    return ownedLocal(context, state, localIds[local]) || stableCopyLocal(context, state, localIds[local])
}

function stableCopyLocal(context: CompilerContext, state: List<Integer>, id: Integer): Boolean {
    let key = state[9] * 100000 + id
    let index = context.stableBorrowCopies.length - 1
    while index >= 0 {
        let entry = context.stableBorrowCopies[index]
        if entry / 100000 != state[9] { return false }
        if entry == key { return true }
        index = index - 1
    }
    return false
}

// A copy of one stable local names the same object that local already keeps
// alive: a readonly parameter or capture, which its caller keeps for the whole
// call, or a binding whose borrowed value outlives the copy. The copy ends no
// later than that binding's scope, so it owns no count of its own.
function stableLocalCopy(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, start: Integer, end: Integer, resultType: List<Integer>): Boolean {
    if end - start != 1 || context.tokenKinds[start] != 1 { return false }
    if !isReferenceType(resultType[0]) { return false }
    if resultType.length > 1 && resultType[1] >= 0 { return false }
    let name = context.tokenTexts[start]
    let source = findLocal(localNames, localLengths, state, name)
    if source < 0 || localTypes[source] != resultType[0] { return false }
    // The source can be reassigned after this copy, and that assignment
    // releases the value the copy borrows. A binding the enclosing block never
    // assigns keeps its value for the whole block, so the copy is safe.
    if blockAssignsName(context.tokenKinds, context.tokenTexts, start, name) { return false }
    if localIds[source] < 0 { return true }
    return stableCopyLocal(context, state, localIds[source])
}

// A binding initialized by a stable field path can borrow its value, like a
// parameter: nothing can replace a field on that path while its root lives.
// Later consumers of the binding create their own count first, as they do for
// parameters.
function stableFieldBorrow(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, start: Integer, end: Integer, resultType: List<Integer>): Boolean {
    if !isReferenceType(resultType[0]) { return false }
    if resultType.length > 1 && resultType[1] >= 0 { return false }
    if stableLocalCopy(context, localNames, localTypes, localIds, localLengths, state, start, end, resultType) { return true }
    if end - start < 3 || (end - start) % 2 == 0 { return false }
    let tokenKinds = context.tokenKinds
    let tokenTexts = context.tokenTexts
    if tokenKinds[start] != 1 || !stableBorrowRoot(context, localNames, localIds, localLengths, state, tokenTexts[start], start) { return false }
    let type = localTypes[findLocal(localNames, localLengths, state, tokenTexts[start])]
    let position = start + 1
    while position < end {
        if tokenKinds[position] != 4 || tokenTexts[position] != "." || tokenKinds[position + 1] != 1 { return false }
        let name = tokenTexts[position + 1]
        if !stableRecordField(context, type, name) { return false }
        type = context.functionParameterTypes[findRecordField(context.functionParameterCounts, context.functionParameterNames, type, name)]
        position = position + 2
    }
    // A traced value needs no count either when the path's anchor holds a count
    // of it: a cycle collection never frees a value reachable from such a count.
    return type == resultType[0] && (untracedBorrowType(context, type) || stablePathAnchor(context, localNames, localIds, localLengths, state, start))
}

function rootLocal(output: List<Text>, state: List<Integer>, id: Integer, value: Text, type: Integer) {
    // Clearing a binding that never owned a value has nothing to release.
    if value == "null" && !ownershipSlotAllocated(state, id) { return }
    if isReferenceType(type) {
        let owner = ownershipSlot(state, id)
        if owner < 0 { return }
        state[6] = 1
        output.add("  call void @minyar_rc_local(i64 ")
        output.add(Text(owner))
        output.add(", ptr ")
        output.add(value)
        output.add(")\n")
    }
}

function assignReference(output: List<Text>, state: List<Integer>, id: Integer, value: Text, resultType: List<Integer>, counts: List<Integer>, fields: List<Integer>, returnTypes: List<Integer>) {
    if takeResult(output, state, value, resultType) {
        state[6] = 1
        output.add("  call void @minyar_rc_local_take(i64 ")
        output.add(Text(ownershipSlot(state, id)))
        output.add(", ptr ")
        output.add(value)
        output.add(")\n")
    } else {
        let piece = output.length
        rootLocal(output, state, id, value, resultType[0])
        if piece < output.length { noteCycleFixup(output, returnTypes, counts, fields, piece, resultType[0], 0) }
    }
}

// `target = source` where source is one stable local the target's scope cannot
// outlive: the target names the same object and takes no count. A parameter or
// a capture is older than every local; a local must be declared before it.
function borrowedCopyAssignment(context: CompilerContext, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, start: Integer, end: Integer, resultType: List<Integer>, targetId: Integer): Boolean {
    if !stableLocalCopy(context, localNames, localTypes, localIds, localLengths, state, start, end, resultType) { return false }
    let source = findLocal(localNames, localLengths, state, context.tokenTexts[start])
    if source < 0 { return false }
    return localIds[source] < targetId
}

// A binding that borrows still takes part in its function's ownership frame:
// the exit stays a cleanup and cycle service point even when no cell is left.
function markBorrowFrame(state: List<Integer>) {
    state[6] = 1
}

// The binding now names a borrow: drop the count it owned and keep none for the
// borrowed value. A binding that never took a count has nothing to release.
function releaseOwnedBinding(output: List<Text>, state: List<Integer>, id: Integer, type: Integer) {
    if !isReferenceType(type) { return }
    // The binding still takes part in the function's ownership frame: its exit
    // stays a cleanup and cycle service point even when no cell is left.
    state[6] = 1
    if !ownershipSlotAllocated(state, id) { return }
    output.add("  call void @minyar_rc_local_take(i64 " + Text(ownershipSlot(state, id)) + ", ptr null)\n")
}

function borrowReference(output: List<Text>, state: List<Integer>, value: Text, type: Integer, counts: List<Integer>, fields: List<Integer>, returnTypes: List<Integer>) {
    if isReferenceType(type) {
        state[6] = 1
        state[7] = state[7] + 1
        noteCycleFixup(output, returnTypes, counts, fields, output.length, type, 0)
        output.add("  call void @minyar_rc_borrow(ptr ")
        output.add(value)
        output.add(")\n")
    }
}

function finishStackOwnership(output: List<Text>, slot: Integer, owners: Integer) {
    let prefix = "  call void @minyar_rc_enter(i64 " + Text(owners) + ")\n"
    let entry = output[slot]
    let start = recoveryTextPosition(entry, prefix)
    if start < 0 { failCompiler("recovery stack frame entry metadata drifted") }
    let storage = "  %rc.stack.header = alloca [64 x i8], align 8\n"
    storage = storage + "  %rc.stack.owners = alloca [" + Text(owners * 2) + " x i64], align 8\n"
    storage = storage + "  call void @minyar_rc_enter_stack_v1(ptr %rc.stack.header, ptr %rc.stack.owners, i64 " + Text(owners) + ")\n"
    output[slot] = entry.slice(0, start) + storage + entry.slice(start + prefix.length, entry.length)
    let piece = slot + 1
    while piece < output.length {
        if output[piece] == "  call void @minyar_rc_leave()\n" {
            output[piece] = "  call void @minyar_rc_leave_stack_v1(ptr %rc.stack.header)\n"
        }
        piece = piece + 1
    }
}

function finishFunctionEntry(output: List<Text>, slot: Integer, locals: Integer, parameters: Integer, owners: Integer, references: Boolean, returnedType: Text, features: Integer, caller: Text, globals: List<Text>, constants: Boolean) {
    let entry: List<Text> = []
    let recoverable = features / 8 % 2 != 0
    if recoverable {
        entry.add("  %recovery.accepted = call i32 @minyar_recovery_enter()\n")
        entry.add("  %recovery.allowed = icmp ne i32 %recovery.accepted, 0\n")
        entry.add("  br i1 %recovery.allowed, label %recovery.body, label %recovery.reject\n")
        entry.add("recovery.reject:\n" + recoveryDummy(returnedType) + "recovery.body:\n")
    } else if compilerCallDepthCounter() != 0 { entry.add("  call void @minyar_stack_enter()\n") }
    if references {
        entry.add("  call void @minyar_rc_enter(i64 ")
        entry.add(Text(owners))
        entry.add(")\n")
    } else {
        let piece = slot + 1
        while piece < output.length {
            output[piece] = withoutServiceCalls(output[piece])
            piece = piece + 1
        }
        settleIdleQueries(output, slot + 1)
    }
    hoistParallelStorage(output, slot, entry)
    let local = parameters
    while local < locals {
        entry.add("  %local.")
        entry.add(Text(local))
        entry.add(" = alloca i64\n")
        local = local + 1
    }
    output[slot] = joinText(entry)
    if recoverable {
        output.add("\nrecovery.unwind:\n")
        if features / 4 % 2 != 0 { threadJoinOnReturn(output, globals, caller) }
        if constants { output.add("  call void @.minyar.constants.release()\n") }
        if references { output.add("  call void @minyar_rc_leave()\n") }
        output.add("  call void @minyar_stack_leave()\n")
        output.add(recoveryDummy(returnedType))
    }
}

function activateCycleType(returnTypes: List<Integer>, type: Integer, start: Integer) {
    let position = start
    while position + 1 < returnTypes.length {
        if returnTypes[position] == -3 {
            if returnTypes[position + 1] == -1 - type { return }
            position = position + 2
        } else {
            if returnTypes[position] == -2 { position = position + 4 } else { position = position + 1 }
        }
    }
    returnTypes.add(-3)
    returnTypes.add(-1 - type)
}

function cycleTypeReaches(from: Integer, target: Integer, counts: List<Integer>, fields: List<Integer>): Boolean {
    if isScalarChoiceType(from) || isScalarChoiceType(target) { return false }
    if from == target { return true }
    if !isContainerType(from) && !isRecordType(from) { return false }
    let visited: List<Boolean> = []
    let position = 0
    while position < counts.length / 2 { visited.add(false)
        position = position + 1 }
    let pending: List<Integer> = [from]
    position = 0
    while position < pending.length {
        let type = pending[position]
        position = position + 1
        while isContainerType(type) {
            if type == target { return true }
            type = containerValueType(type)
        }
        if type == target { return true }
        if isRecordType(type) && !isScalarChoiceType(type) && !visited[recordTypeIndex(type)] {
            let record = recordTypeIndex(type)
            visited[record] = true
            let field = 0
            let first = functionParameterOffset(counts, record)
            while field < counts[record] {
                pending.add(fields[first + field])
                field = field + 1
            }
        }
    }
    return false
}

function possibleCycleType(type: Integer, counts: List<Integer>, fields: List<Integer>, returnTypes: List<Integer>): Boolean {
    let base = type
    while isContainerType(base) { base = containerValueType(base) }
    if !isRecordType(base) || isScalarChoiceType(base) { return false }
    let position = counts.length
    while position < returnTypes.length {
        if returnTypes[position] == -2 { position = position + 4 } else {
            if returnTypes[position] == -3 || returnTypes[position] == -5 { position = position + 2 } else {
                if type >= 0 && returnTypes[position] == type { return false }
                position = position + 1
            }
        }
    }
    let starts: List<Integer> = []
    if isContainerType(type) {
        starts.add(containerValueType(type))
    } else {
        let record = recordTypeIndex(type)
        let first = functionParameterOffset(counts, record)
        position = 0
        while position < counts[record] { starts.add(fields[first + position])
            position = position + 1 }
    }
    position = 0
    while position < starts.length {
        if cycleTypeReaches(starts[position], type, counts, fields) { return true }
        position = position + 1
    }
    if type >= 0 { returnTypes.add(type) }
    return false
}

function noteCycleFixup(output: List<Text>, returnTypes: List<Integer>, counts: List<Integer>, fields: List<Integer>, piece: Integer, typeA: Integer, typeB: Integer) {
    let baseA = typeA
    let baseB = typeB
    while isContainerType(baseA) { baseA = containerValueType(baseA) }
    while isContainerType(baseB) { baseB = containerValueType(baseB) }
    if (!isRecordType(baseA) || isScalarChoiceType(baseA)) && (!isRecordType(baseB) || isScalarChoiceType(baseB)) { return }
    returnTypes.add(-2)
    returnTypes.add(-1 - piece)
    returnTypes.add(-1 - typeA)
    returnTypes.add(-1 - typeB)
}

function cycleTypeActive(type: Integer, roots: List<Integer>, counts: List<Integer>, fields: List<Integer>, seenTypes: List<Integer>, activeTypes: List<Integer>): Boolean {
    if isScalarChoiceType(type) { return false }
    if !isContainerType(type) && !isRecordType(type) { return false }
    let position = 0
    while position < seenTypes.length {
        if seenTypes[position] == type { return activeTypes[position] == 1 }
        position = position + 1
    }
    seenTypes.add(type)
    position = 0
    while position < roots.length {
        let root = roots[position]
        if cycleTypeReaches(root, type, counts, fields) && cycleTypeReaches(type, root, counts, fields) {
            activeTypes.add(1)
            return true
        }
        position = position + 1
    }
    activeTypes.add(0)
    return false
}

function finishCycleFixups(context: CompilerContext, output: List<Text>, returnTypes: List<Integer>, counts: List<Integer>, fields: List<Integer>) {
    let position = counts.length
    let enabled = false
    while position + 1 < returnTypes.length {
        if returnTypes[position] == -3 {
            enabled = true
            position = position + 2
        } else {
            if returnTypes[position] == -2 { position = position + 4 } else { position = position + 1 }
        }
    }
    if !enabled { return }
    let roots: List<Integer> = []
    position = counts.length
    while position + 1 < returnTypes.length {
        if returnTypes[position] == -3 {
            let root = -1 - returnTypes[position + 1]
            let duplicate = false
            let index = 0
            while index < roots.length {
                if roots[index] == root { duplicate = true }
                index = index + 1
            }
            if !duplicate && possibleCycleType(root, counts, fields, returnTypes) { roots.add(root) }
            position = position + 2
        } else {
            if returnTypes[position] == -2 { position = position + 4 } else { position = position + 1 }
        }
    }
    if roots.length == 0 { return }
    let seenTypes: List<Integer> = []
    let activeTypes: List<Integer> = []
    enabled = false
    position = counts.length
    while position + 3 < returnTypes.length {
        if returnTypes[position] == -2 {
            let piece = -1 - returnTypes[position + 1]
            let typeA = choiceOwnershipType(context, -1 - returnTypes[position + 2])
            let typeB = choiceOwnershipType(context, -1 - returnTypes[position + 3])
            if cycleTypeActive(typeA, roots, counts, fields, seenTypes, activeTypes) || cycleTypeActive(typeB, roots, counts, fields, seenTypes, activeTypes) {
                enabled = true
                let text = output[piece]
                let end = 0
                while end < text.byteLength && text[end] != '(' { end = end + 1 }
                if end < text.byteLength {
                    output[piece] = text.slice(0, end) + "_traced" + text.slice(end, text.byteLength)
                } else {
                    if text != "" { output[piece] = text + "_traced" }
                }
            }
            position = position + 4
        } else {
            if returnTypes[position] == -3 { position = position + 2 } else { position = position + 1 }
        }
    }
    if !enabled { return }
    output.add("; minyar-cycle-runtime: 1\n")
    output.add("declare void @minyar_rc_retain_traced(ptr)\n")
    output.add("declare void @minyar_rc_local_traced(i64, ptr)\n")
    output.add("declare void @minyar_rc_borrow_traced(ptr)\n")
    output.add("declare void @minyar_rc_enable_cycles()\n")
    output.add("declare ptr @minyar_list_new_traced()\n")
    output.add("declare ptr @minyar_list_appended_traced(ptr, i64, i64, i64)\n")
    output.add("declare ptr @minyar_list_appended_take_traced(ptr, i64, i64, i64)\n")
    output.add("declare void @minyar_list_add_traced(ptr, i64)\n")
    output.add("declare void @minyar_list_add_take_traced(ptr, i64)\n")
    output.add("declare void @minyar_list_set_traced(ptr, i64, i64)\n")
    output.add("declare void @minyar_list_set_take_traced(ptr, i64, i64)\n")
    output.add("declare ptr @minyar_record_new_traced(i64)\n")
    output.add("declare void @minyar_record_set_traced(ptr, i64, i64)\n")
    output.add("declare void @minyar_record_set_take_traced(ptr, i64, i64)\n")
    output.add("declare void @minyar_record_set_reference_traced(ptr, i64, i64)\n")
    output.add("declare void @minyar_record_replace_traced(ptr, i64, i64, i64)\n")
    output.add("declare i64 @minyar_record_take_field_traced(ptr, i64)\n")
}
