// Loop versioning on hoisted List range checks.
//
// A call-free counted loop checks every List access. When its body reads or
// writes a List at the loop position, and that List is the same object with
// the same length on every iteration, one test before the loop covers every
// position: if the first position is not negative and the bound is at most
// the length, no access at the loop position can fail. While the runtime is
// idle such a loop enters a copy of itself whose accesses at the loop position
// are plain loads and stores, which LLVM can vectorize. Otherwise it runs the
// checked loop unchanged, which fails at the same access with the same message.
//
// A call-free loop cannot allocate, release, resize a List or store a
// reference (those are runtime calls), so these stay invariant inside it:
// locals the loop never stores or takes the address of, List lengths and
// values buffers, and the slots of reference Lists and reference record
// fields. The test computes each List from them before the loop; a check that
// would fail there sends the loop to its checked copy instead.
// The region is classified once: each line's defined name and loaded local.
// `%value.N` definitions are found by number; other names and labels by a
// short list.
record LoopCopy {
    lines: List<Text>
    defined: List<Text>
    loaded: List<Text>
    valueBase: Integer
    valueLines: List<Integer>
    otherNames: List<Text>
    otherLines: List<Integer>
    touched: List<Text>
    invariant: List<Text>
    hoisted: List<Text>
    guard: List<Text>
    suffix: Text
    loop: Text
    blocks: Integer
    position: Text
    variable: Text
    indexLocal: Text
    lists: List<Text>
    values: List<Text>
    lengths: List<Text>
    valueLoads: List<Boolean>
    positionLists: List<Boolean>
    windowLengths: List<Text>
    windowLists: List<Integer>
    windowOffsets: List<Text>
    windowCode: List<Text>
    windowNames: List<Text>
    windowHoisted: List<Text>
    scanLists: List<Text>
    scanBounds: List<Text>
    fields: Boolean
    texts: List<Text>
    textLengths: List<Text>
    textBytes: List<Text>
}

function loopNameCharacter(character: Character): Boolean {
    return (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || (character >= '0' && character <= '9') || character == '.' || character == '_' || character == '$' || character == '-'
}

function loopNamed(names: List<Text>, name: Text): Integer {
    let index = 0
    while index < names.length {
        if names[index] == name { return index }
        index = index + 1
    }
    return -1
}

// N for `%value.N`, otherwise -1.
function loopValueNumber(name: Text): Integer {
    if name.length < 8 || !name.startsWith("%value.") { return -1 }
    let number = 0
    let index = 7
    while index < name.length {
        let digit = Integer(name[index]) - 48
        if digit < 0 || digit > 9 { return -1 }
        number = number * 10 + digit
        index = index + 1
    }
    return number
}

// The line defining a region name, -2 for a region label, -1 for a name the
// region does not define.
function loopDefinitionLine(copy: LoopCopy, name: Text): Integer {
    let number = loopValueNumber(name)
    if number >= 0 {
        let index = number - copy.valueBase
        if index < 0 || index >= copy.valueLines.length { return -1 }
        return copy.valueLines[index] - 1
    }
    let other = loopNamed(copy.otherNames, name)
    if other < 0 { return -1 }
    return copy.otherLines[other]
}

// Each `%local.N` a line names.
function loopLocalsIn(line: Text, touched: List<Text>) {
    let parts = line.split("%local.")
    let index = 1
    while index < parts.length {
        let part = parts[index]
        let end = 0
        while end < part.length && loopNameCharacter(part[end]) { end = end + 1 }
        let local = "%local." + part.slice(0, end)
        if loopNamed(touched, local) < 0 { touched.add(local) }
        index = index + 1
    }
}

// The arguments of `call <type> @callee(<type> <value>, ...)` as values.
function loopCallArguments(line: Text, callee: Text): List<Text> {
    let result: List<Text> = []
    let start = line.find(callee + "(")
    if start < 0 || !line.endsWith(")") { return result }
    let parts = line.slice(start + callee.length + 1, line.length - 1).split(", ")
    let index = 0
    while index < parts.length {
        let argument = parts[index]
        let space = argument.find(" ")
        if space < 0 { return [] }
        result.add(argument.slice(space + 1, argument.length))
        index = index + 1
    }
    return result
}

// Classify every line: its definition, the local a load reads, the region's
// labels, and every local the region stores to or passes by address. Debug
// comments name locals but do not touch them.
function loopClassify(copy: LoopCopy) {
    let numbers: List<Integer> = []
    let numberLines: List<Integer> = []
    let index = 0
    while index < copy.lines.length {
        let line = copy.lines[index]
        let name = ""
        let local = ""
        if line.startsWith("  %") {
            let equals = line.find(" = ")
            if equals > 2 {
                name = line.slice(2, equals)
                let value = line.slice(equals + 3, line.length)
                if value.startsWith("load ") {
                    let slot = value.find(", ptr %local.")
                    if slot >= 0 {
                        local = value.slice(slot + 6, value.length)
                        if local.find(" ") >= 0 || local.find(",") >= 0 { local = "" }
                    }
                }
                if local == "" && value.find("%local.") >= 0 { loopLocalsIn(value, copy.touched) }
                let number = loopValueNumber(name)
                if number >= 0 {
                    numbers.add(number)
                    numberLines.add(index)
                } else {
                    copy.otherNames.add(name)
                    copy.otherLines.add(index)
                }
            }
        } else if line.length > 1 && line.endsWith(":") && line[0] != ' ' && line[0] != ';' {
            copy.otherNames.add("%" + line.slice(0, line.length - 1))
            copy.otherLines.add(-2)
        } else if !line.startsWith(";") && line.find("%local.") >= 0 {
            loopLocalsIn(line, copy.touched)
        }
        copy.defined.add(name)
        copy.loaded.add(local)
        index = index + 1
    }
    if numbers.length == 0 { return }
    let lowest = numbers[0]
    let highest = numbers[0]
    index = 1
    while index < numbers.length {
        if numbers[index] < lowest { lowest = numbers[index] }
        if numbers[index] > highest { highest = numbers[index] }
        index = index + 1
    }
    copy.valueBase = lowest
    while copy.valueLines.length <= highest - lowest { copy.valueLines.add(0) }
    index = 0
    while index < numbers.length {
        copy.valueLines[numbers[index] - lowest] = numberLines[index] + 1
        index = index + 1
    }
}

function loopGuardName(copy: LoopCopy, value: Text, part: Text): Text {
    return value + ".hoisted" + copy.loop + part
}

// Emit a check that branches to the checked loop when it fails, and continue
// the test in a new block.
function loopGuardCheck(copy: LoopCopy, condition: Text) {
    let block = "for.guard." + copy.loop + "." + Text(copy.blocks)
    copy.blocks = copy.blocks + 1
    copy.guard.add("  br i1 " + condition + ", label %" + block + ", label %for.checked." + copy.loop + "\n\n" + block + ":\n")
}

// The value before the loop of a region value that every iteration computes
// identically, or "" if the region may compute it differently. `slot` allows
// a checked List or record read, whose caller converts it to a reference.
function loopInvariant(copy: LoopCopy, value: Text, slot: Boolean): Text {
    if !value.startsWith("%") { return value }
    let known = loopNamed(copy.invariant, value)
    if known >= 0 { return copy.hoisted[known] }
    let defined = loopDefinitionLine(copy, value)
    if defined == -1 { return value }
    if defined < 0 { return "" }
    let line = copy.lines[defined]
    let name = loopGuardName(copy, value, "")
    let local = copy.loaded[defined]
    if local != "" {
        if loopNamed(copy.touched, local) >= 0 { return "" }
        copy.guard.add("  " + name + line.slice(line.find(" = "), line.length) + "\n")
    } else if line.find(" = inttoptr i64 ") >= 0 && line.endsWith(" to ptr") {
        let start = line.find(" = inttoptr i64 ") + 16
        let source = loopInvariant(copy, line.slice(start, line.length - 7), true)
        if source == "" { return "" }
        copy.guard.add("  " + name + " = inttoptr i64 " + source + " to ptr\n")
    } else if line.find(" = call i64 @.minyar.list.length(") >= 0 {
        let arguments = loopCallArguments(line, "@.minyar.list.length")
        if arguments.length != 1 { return "" }
        let list = loopInvariant(copy, arguments[0], false)
        if list == "" { return "" }
        copy.guard.add("  " + name + " = call i64 @.minyar.list.length(ptr " + list + ")\n")
    } else if slot && line.find(" = call i64 @.minyar.list.get.checked(") >= 0 {
        let arguments = loopCallArguments(line, "@.minyar.list.get.checked")
        if arguments.length != 2 { return "" }
        let list = loopInvariant(copy, arguments[0], false)
        let position = loopInvariant(copy, arguments[1], false)
        if list == "" || position == "" { return "" }
        let length = loopGuardName(copy, value, ".length")
        copy.guard.add("  " + length + ".pointer = getelementptr inbounds { ptr, i64, i64 }, ptr " + list + ", i32 0, i32 1\n  " + length + " = load i64, ptr " + length + ".pointer\n  " + name + ".valid = icmp ult i64 " + position + ", " + length + "\n")
        loopGuardCheck(copy, name + ".valid")
        copy.guard.add("  " + name + ".values = load ptr, ptr " + list + "\n  " + name + ".slot = getelementptr inbounds i64, ptr " + name + ".values, i64 " + position + "\n  " + name + " = load i64, ptr " + name + ".slot\n")
    } else if slot && line.find(" = call i64 @.minyar.record.get") >= 0 {
        // The generic helper takes the field as an argument; a tagged position
        // has its own accessor and spells the constant in its name.
        let at = line.find(" = call i64 @.minyar.record.get") + 3
        let opening = line.find("(")
        if opening < 0 { return "" }
        let callee = line.slice(at, opening)
        let arguments = loopCallArguments(line, callee)
        let field = ""
        if callee == "@.minyar.record.get" {
            if arguments.length != 2 { return "" }
            field = loopInvariant(copy, arguments[1], false)
        } else {
            if arguments.length != 1 || !callee.startsWith("@.minyar.record.get.") { return "" }
            field = callee.slice(20, callee.length)
        }
        let record = loopInvariant(copy, arguments[0], false)
        if record == "" || field == "" { return "" }
        // The type checker proved the constant field exists; records never resize.
        copy.guard.add("  " + name + ".values = getelementptr inbounds i8, ptr " + record + ", i64 8\n  " + name + ".slot = getelementptr inbounds i64, ptr " + name + ".values, i64 " + field + "\n  " + name + " = load i64, ptr " + name + ".slot\n")
    } else {
        return ""
    }
    copy.invariant.add(value)
    copy.hoisted.add(name)
    return name
}

// The loop position itself, or a load of the loop variable when the region
// stores only the position into it.
function loopAtPosition(copy: LoopCopy, value: Text): Boolean {
    if value == copy.position { return true }
    let defined = loopDefinitionLine(copy, value)
    if defined < 0 { return false }
    if copy.lines[defined].find(" = load i64, ") < 0 { return false }
    if copy.variable != "" && copy.loaded[defined] == copy.variable { return true }
    // A counter the region advances is the position only before that store:
    // after it, a load reads the next position.
    if copy.indexLocal == "" || copy.loaded[defined] != copy.indexLocal { return false }
    let index = 0
    while index < defined {
        if copy.lines[index].startsWith("  store i64 ") && copy.lines[index].endsWith(", ptr " + copy.indexLocal) { return false }
        index = index + 1
    }
    return true
}

// The number in `%local.N`, for a local the loop counts in.
function loopLocalNumber(local: Text): Integer {
    if local.length < 8 || !local.startsWith("%local.") { return -1 }
    let number = 0
    let index = 7
    while index < local.length {
        let digit = Integer(local[index]) - 48
        if digit < 0 || digit > 9 { return -1 }
        number = number * 10 + digit
        index = index + 1
    }
    return number
}

function loopTruncated(values: List<Text>, length: Integer): List<Text> {
    let result: List<Text> = []
    let index = 0
    while index < length {
        result.add(values[index])
        index = index + 1
    }
    return result
}

function loopTruncatedIntegers(values: List<Integer>, length: Integer): List<Integer> {
    let result: List<Integer> = []
    let index = 0
    while index < length {
        result.add(values[index])
        index = index + 1
    }
    return result
}

// Whether a text is an Integer literal.
function loopLiteral(text: Text): Boolean {
    if text.length == 0 { return false }
    let index = 0
    if text[0] == '-' {
        if text.length == 1 { return false }
        index = 1
    }
    while index < text.length {
        let character = text[index]
        if character < '0' || character > '9' { return false }
        index = index + 1
    }
    return true
}

// The loop position plus an offset that every iteration computes identically:
// the offset's value before the loop, or "" when the index is not such a
// window or its offset is not loop-invariant. A plain position has offset 0.
function loopWindowOffset(copy: LoopCopy, value: Text): Text {
    if loopAtPosition(copy, value) { return "0" }
    let defined = loopDefinitionLine(copy, value)
    if defined < 0 { return "" }
    let line = copy.lines[defined]
    if line.find(" = extractvalue { i64, i1 } ") < 0 && line.find(" = add i64 ") < 0 && line.find(" = sub i64 ") < 0 { return "" }
    let sum = line
    if line.find(" = extractvalue { i64, i1 } ") >= 0 {
        if !line.endsWith(", 0") { return "" }
        let source = line.slice(line.find(" = extractvalue { i64, i1 } ") + 28, line.length - 3)
        let sumLine = loopDefinitionLine(copy, source)
        if sumLine < 0 { return "" }
        sum = copy.lines[sumLine]
    }
    let at = sum.find("i64 ")
    if at < 0 || !sum.endsWith(")") { return "" }
    let parts = sum.slice(at + 4, sum.length - 1).split(", i64 ")
    if parts.length != 2 { return "" }
    let subtraction = sum.find("@llvm.ssub.with.overflow.i64(") >= 0 || sum.find(" = sub i64 ") >= 0
    if loopAtPosition(copy, parts[0]) {
        // The position minus a literal is below the start of the List for the
        // first positions, which the bound test cannot cover: not a window.
        if subtraction { return "" }
        return parts[1]
    }
    if !subtraction && loopAtPosition(copy, parts[1]) { return parts[0] }
    return ""
}

// The offset as a value available in the test block: unchanged when the loop
// does not define it, otherwise recomputed there with wrapping arithmetic. A
// wrapped offset only makes the test stricter; the copy still computes the
// index with the checked arithmetic of the region, which reports an overflow
// exactly as the checked loop does.
function loopWindowValue(copy: LoopCopy, value: Text): Text {
    if !value.startsWith("%") { return value }
    if loopNamed(copy.invariant, value) >= 0 { return copy.hoisted[loopNamed(copy.invariant, value)] }
    let known = loopNamed(copy.windowNames, value)
    if known >= 0 { return copy.windowHoisted[known] }
    let defined = loopDefinitionLine(copy, value)
    if defined == -1 { return value }
    if defined < 0 { return "" }
    let line = copy.lines[defined]
    let sum = line
    if line.find(" = extractvalue { i64, i1 } ") >= 0 {
        if !line.endsWith(", 0") { return "" }
        let source = line.slice(line.find(" = extractvalue { i64, i1 } ") + 28, line.length - 3)
        let sumLine = loopDefinitionLine(copy, source)
        if sumLine < 0 { return "" }
        sum = copy.lines[sumLine]
    }
    let at = sum.find("i64 ")
    if at < 0 || !sum.endsWith(")") { return "" }
    let parts = sum.slice(at + 4, sum.length - 1).split(", i64 ")
    if parts.length != 2 { return "" }
    let operator = "add"
    if sum.find("@llvm.ssub.with.overflow.i64(") >= 0 || sum.find(" = sub i64 ") >= 0 { operator = "sub" }
    if sum.find("@llvm.smul.with.overflow.i64(") >= 0 || sum.find(" = mul i64 ") >= 0 { operator = "mul" }
    let left = loopWindowValue(copy, parts[0])
    let right = loopWindowValue(copy, parts[1])
    if left == "" || right == "" { return "" }
    let name = value + ".window"
    copy.windowCode.add("  " + name + " = " + operator + " i64 " + left + ", " + right + "\n")
    copy.windowNames.add(value)
    copy.windowHoisted.add(name)
    return name
}

// One window test: the position plus `offset` stays inside a List of `length`
// elements for every position from `first` below `limit`. Returns the name of
// the condition that covers it, or `all` when the bound test already does.
function loopWindowTest(test: List<Text>, loop: Text, listIndex: Integer, slot: Integer, offset: Text, length: Text, first: Text, limit: Text, all: Text): Text {
    if offset == "0" { return all }
    let name = "%loop.window." + loop + "." + Text(listIndex) + "." + Text(slot)
    if loopLiteral(offset) {
        // The last position plus the offset stays below the length, so the
        // subtraction cannot wrap below it.
        test.add("  " + name + ".rest = sub i64 " + length + ", " + offset + "\n  " + name + ".high = icmp sle i64 " + limit + ", " + name + ".rest\n  " + name + ".all = and i1 " + all + ", " + name + ".high\n")
        return name + ".all"
    }
    // An offset of unknown sign: a non-negative one is inside when the length
    // covers it from the last position; a negative one runs the checked loop,
    // which reports what the checked accesses report.
    test.add("  " + name + ".nonnegative = icmp sgt i64 " + offset + ", -1\n  " + name + ".rest = sub i64 " + length + ", " + offset + "\n  " + name + ".high = icmp sle i64 " + limit + ", " + name + ".rest\n  " + name + ".ok = and i1 " + name + ".nonnegative, " + name + ".high\n  " + name + ".all = and i1 " + all + ", " + name + ".ok\n")
    return name + ".all"
}

// The List accessor a line calls, "" when it is not one this stage can prove:
// `@.minyar.list.get.checked`, `...get.known`, `...set.scalar.checked`,
// `...set.scalar.known`.
function loopAccessCallee(line: Text, prefix: Text): Text {
    let at = line.find(prefix)
    if at < 0 { return "" }
    let rest = line.slice(at + prefix.length, line.length)
    if rest.startsWith("checked(") { return prefix + "checked" }
    if rest.startsWith("known(") { return prefix + "known" }
    return ""
}

function loopAccessWrite(callee: Text): Boolean {
    return callee.startsWith("@.minyar.list.set")
}

// The index operand of an access: the last one a read takes, the one before
// the stored value for a write. A known header passes length and values first.
function loopAccessIndex(arguments: List<Text>, write: Boolean): Text {
    if write { return arguments[arguments.length - 2] }
    return arguments[arguments.length - 1]
}

function loopAccessValue(arguments: List<Text>): Text {
    return arguments[arguments.length - 1]
}

// The values buffer of an invariant List indexed inside the loop window.
function loopCheckedList(copy: LoopCopy, line: Text, callee: Text): Text {
    let arguments = loopCallArguments(line, callee)
    let write = loopAccessWrite(callee)
    if arguments.length < 2 { return "" }
    let offset = loopWindowOffset(copy, loopAccessIndex(arguments, write))
    if offset == "" { return "" }
    let mark = copy.guard.length
    let blocks = copy.blocks
    let invariantCount = copy.invariant.length
    let windows = copy.windowOffsets.length
    let code = copy.windowCode.length
    let names = copy.windowNames.length
    let list = loopInvariant(copy, arguments[0], false)
    let hoisted = loopWindowValue(copy, offset)
    if list == "" || hoisted == "" {
        // Drop the partial test; nothing in it is used.
        copy.guard = loopTruncated(copy.guard, mark)
        copy.invariant = loopTruncated(copy.invariant, invariantCount)
        copy.hoisted = loopTruncated(copy.hoisted, invariantCount)
        copy.windowLists = loopTruncatedIntegers(copy.windowLists, windows)
        copy.windowOffsets = loopTruncated(copy.windowOffsets, windows)
        copy.windowCode = loopTruncated(copy.windowCode, code)
        copy.windowNames = loopTruncated(copy.windowNames, names)
        copy.windowHoisted = loopTruncated(copy.windowHoisted, names)
        copy.blocks = blocks
        return ""
    }
    // A known-header access already carries the List's length and values buffer,
    // loaded once on entry with their range: reuse them so the test loads
    // nothing and sees the same bounds.
    let header = callee.endsWith("known") && arguments.length >= 4
    let known = loopNamed(copy.lists, list)
    if known < 0 {
        known = copy.lists.length
        copy.lists.add(list)
        if header {
            copy.lengths.add(arguments[1])
            copy.values.add(arguments[2])
            copy.valueLoads.add(false)
        } else {
            copy.lengths.add("")
            copy.values.add(list + ".values" + copy.loop)
            copy.valueLoads.add(true)
        }
        copy.positionLists.add(false)
    } else if header && copy.lengths[known] == "" {
        copy.lengths[known] = arguments[1]
        copy.values[known] = arguments[2]
        copy.valueLoads[known] = false
    }
    if offset == "0" { copy.positionLists[known] = true }
    // The position itself is covered by the bound test; every other offset
    // needs one more test that covers the window the loop visits.
    if hoisted != "0" {
        let existing = 0
        let present = false
        while existing < copy.windowOffsets.length {
            if copy.windowLists[existing] == known && copy.windowOffsets[existing] == hoisted { present = true }
            existing = existing + 1
        }
        if !present {
            copy.windowLists.add(known)
            copy.windowOffsets.add(hoisted)
        }
    }
    return copy.values[known]
}

// The copy's text for a line: region labels and names get the copy's suffix;
// values computed before the loop use their hoisted names.
function loopRename(copy: LoopCopy, line: Text): Text {
    if line.length > 1 && line.endsWith(":") && line[0] != ' ' && line[0] != ';' { return line.slice(0, line.length - 1) + copy.suffix + ":" }
    if line.find("%") < 0 { return line }
    let parts = line.split("%")
    let pieces: List<Text> = [parts[0]]
    let index = 1
    while index < parts.length {
        let part = parts[index]
        let end = 0
        while end < part.length && loopNameCharacter(part[end]) { end = end + 1 }
        let name = "%" + part.slice(0, end)
        let known = loopNamed(copy.invariant, name)
        if known >= 0 {
            pieces.add(copy.hoisted[known])
        } else if loopDefinitionLine(copy, name) != -1 {
            pieces.add(name + copy.suffix)
        } else {
            pieces.add(name)
        }
        pieces.add(part.slice(end, part.length))
        index = index + 1
    }
    return joinText(pieces)
}

// --- Range-guarded accumulation -----------------------------------------
//
// A versioned loop that accumulates with checked `+ - *` re-tests overflow on
// every addition, which stops LLVM from widening or vectorizing it. When each
// iteration adds a value the test can bound beforehand (a List element at the
// loop position, a literal, the loop position, or a product or sum of those),
// one test before the loop covers every addition: the largest step times the
// number of iterations, added to the accumulator's magnitude at entry, must
// stay below 2^63. A scan of each List the steps read supplies its elements'
// magnitude in one pass: the OR of their absolute values bounds every element
// by a subset of its bits, and LLVM vectorizes that pass. A loop that passes
// runs a copy whose additions are plain `add i64`; every other loop runs the
// checked copy, which traps at the same addition with the same message and the
// same partial writes.

// One checked operation of the region the plain copy computes without a test.
record LoopRangeOp {
    line: Integer
    operator: Text
    value: Text
    left: Text
    right: Text
}

// Every checked operation the guard covers, with one growth test per
// accumulator and one scan per List a step reads.
record LoopRanges {
    ok: Boolean
    ops: List<LoopRangeOp>
    slots: List<Text>
    deltas: List<Text>
    bounds: List<Text>
    scans: List<Text>
    tests: List<Text>
    fallback: Text
}

// The result for a loop the guard does not cover: nothing changes.
function loopRangeNone(): LoopRanges {
    return LoopRanges { ok: false, ops: [], slots: [], deltas: [], bounds: [], scans: [], tests: [], fallback: "" }
}

// The signed operation a line starts, "" for any other line.
// A loop shorter than this pays more for the guard than it saves: the guard
// costs a fixed ~20 instructions and each iteration saves ~9.
function loopRangeMinimum(): Integer {
    return 8
}

function loopCheckedOperator(line: Text): Text {
    if line.find(" = call { i64, i1 } @llvm.sadd.with.overflow.i64(") >= 0 { return "add" }
    if line.find(" = call { i64, i1 } @llvm.ssub.with.overflow.i64(") >= 0 { return "sub" }
    if line.find(" = call { i64, i1 } @llvm.smul.with.overflow.i64(") >= 0 { return "mul" }
    return ""
}

function loopCheckedCallee(operator: Text): Text {
    if operator == "sub" { return "@llvm.ssub.with.overflow.i64" }
    if operator == "mul" { return "@llvm.smul.with.overflow.i64" }
    return "@llvm.sadd.with.overflow.i64"
}

// The name an `extractvalue` of a checked result defines, "" for another line.
function loopCheckedPart(line: Text, part: Text): Text {
    let mark = " = extractvalue { i64, i1 } "
    let at = line.find(mark)
    if at < 0 || !line.endsWith(", " + part) { return "" }
    return line.slice(2, at)
}

// The whole checked operation a line starts; `operator` empty for any other
// shape, which the plain copy cannot take over.
function loopCheckedAt(copy: LoopCopy, line: Integer): LoopRangeOp {
    let none = LoopRangeOp { line: line, operator: "", value: "", left: "", right: "" }
    let operator = loopCheckedOperator(copy.lines[line])
    if operator == "" || line + 3 >= copy.lines.length { return none }
    let value = loopCheckedPart(copy.lines[line + 1], "0")
    let flag = loopCheckedPart(copy.lines[line + 2], "1")
    if value == "" || flag == "" { return none }
    if copy.lines[line + 3].find("@.minyar.integer.overflow.checked(i1 " + flag + ")") < 0 { return none }
    // The flag may only be read by that call: every other use needs the test.
    let uses = 0
    let at = 0
    while at < copy.lines.length {
        if copy.lines[at].find(flag) >= 0 { uses = uses + 1 }
        at = at + 1
    }
    if uses != 2 { return none }
    let arguments = loopCallArguments(copy.lines[line], loopCheckedCallee(operator))
    if arguments.length != 2 { return none }
    return LoopRangeOp { line: line, operator: operator, value: value, left: arguments[0], right: arguments[1] }
}

// The `%local.N` an i64 load of `value` reads, "" otherwise.
function loopLoadedLocal(copy: LoopCopy, value: Text): Text {
    let defined = loopDefinitionLine(copy, value)
    if defined < 0 { return "" }
    let line = copy.lines[defined]
    if !line.startsWith("  " + value + " = load i64, ptr %local.") { return "" }
    let local = line.slice(line.find("%local."), line.length)
    if local.length < 8 { return "" }
    let index = 7
    while index < local.length {
        if !(local[index] >= '0' && local[index] <= '9') { return "" }
        index = index + 1
    }
    return local
}

// The value a region store writes into `local` before `line`, "" unless
// exactly one store names that local.
function loopStoredValue(copy: LoopCopy, local: Text, before: Integer): Text {
    let found = ""
    let count = 0
    let index = 0
    while index < copy.lines.length {
        if loopStoredLocal(copy, copy.lines[index]) == local {
            if index < before && count == 0 {
                found = copy.lines[index].slice(12, copy.lines[index].find(", ptr %local."))
                count = 1
            } else {
                count = 2
            }
        }
        index = index + 1
    }
    if count != 1 { return "" }
    return found
}

// The `%local.N` a region store writes, "" for a line that stores nothing.
function loopStoredLocal(copy: LoopCopy, line: Text): Text {
    if !line.startsWith("  store i64 %") { return "" }
    let at = line.find(", ptr %local.")
    if at < 0 { return "" }
    let local = line.slice(at + 6, line.length)
    if local.length < 8 { return "" }
    let index = 7
    while index < local.length {
        if !(local[index] >= '0' && local[index] <= '9') { return "" }
        index = index + 1
    }
    return local
}

// The index of the covered operation a line starts, -1 when none does.
function loopRangeOperation(ranges: LoopRanges, line: Integer): Integer {
    let index = 0
    while index < ranges.ops.length {
        if ranges.ops[index].line == line { return index }
        index = index + 1
    }
    return -1
}

// Whether a covered operation already computes this line.
function loopRangeCovered(ranges: LoopRanges, line: Integer): Boolean {
    let index = 0
    while index < ranges.ops.length {
        let start = ranges.ops[index].line
        if line >= start && line <= start + 3 { return true }
        index = index + 1
    }
    return false
}

// Whether the plain copy simply omits this line: the checked operation's own
// intrinsic, its flag and its overflow call.
function loopRangeOmitted(ranges: LoopRanges, line: Integer): Boolean {
    let index = 0
    while index < ranges.ops.length {
        let start = ranges.ops[index].line
        if line == start || line == start + 2 || line == start + 3 { return true }
        index = index + 1
    }
    return false
}

// A scan of one List inside the guard, once per List: one pass over the
// positions the loop visits that ORs the elements' absolute values. A loop
// that visits a few positions of a long List pays for a few loads, not for
// the List. Returns the name of the bound.
function loopScan(copy: LoopCopy, ranges: LoopRanges, list: Text, counter: Text, limit: Text): Text {
    let known = 0
    while known < copy.scanLists.length {
        if copy.scanLists[known] == list { return copy.scanBounds[known] }
        known = known + 1
    }
    let tag = "." + copy.loop + "." + Text(copy.scanLists.length)
    let name = "loop.scan" + tag
    let ref = "%" + name
    let values = ref + ".values"
    let length = ref + ".length"
    let cursor = ref + ".at"
    let haystack = ref + ".or"
    let value = ref + ".value"
    let start = ref + ".start"
    let stop = ref + ".stop"
    // The loop visits [max(first, 0), min(limit, length)) at the position, so
    // the scan covers exactly those elements.
    // The trip test comes first: a short loop pays for nothing but it.
    ranges.scans.add("  " + ref + ".counter = load i64, ptr " + counter + "\n  " + ref + ".below = icmp slt i64 " + ref + ".counter, 0\n  " + start + " = select i1 " + ref + ".below, i64 0, i64 " + ref + ".counter\n  " + ref + ".trip = sub i64 " + limit + ", " + start + "\n  " + ref + ".short = icmp slt i64 " + ref + ".trip, " + Text(loopRangeMinimum()) + "\n  br i1 " + ref + ".short, label %" + ranges.fallback + ", label %" + name + ".entry\n\n" + name + ".entry:\n  " + values + " = call ptr @.minyar.list.values(ptr " + list + ")\n  " + length + " = call i64 @.minyar.list.length(ptr " + list + ")\n  " + ref + ".capped = icmp slt i64 " + limit + ", " + length + "\n  " + stop + " = select i1 " + ref + ".capped, i64 " + limit + ", i64 " + length + "\n  br label %" + name + ".head\n\n" + name + ".head:\n  " + cursor + " = phi i64 [ " + start + ", %" + name + ".entry ], [ " + cursor + ".next, %" + name + ".body ]\n  " + haystack + " = phi i64 [ 0, %" + name + ".entry ], [ " + haystack + ".next, %" + name + ".body ]\n  " + ref + ".more = icmp slt i64 " + cursor + ", " + stop + "\n  br i1 " + ref + ".more, label %" + name + ".body, label %" + name + ".done\n\n" + name + ".body:\n  " + ref + ".slot = getelementptr inbounds i64, ptr " + values + ", i64 " + cursor + "\n  " + value + " = load i64, ptr " + ref + ".slot\n  " + ref + ".negative = icmp slt i64 " + value + ", 0\n  " + ref + ".opposite = sub i64 0, " + value + "\n  " + ref + ".magnitude = select i1 " + ref + ".negative, i64 " + ref + ".opposite, i64 " + value + "\n  " + haystack + ".next = or i64 " + haystack + ", " + ref + ".magnitude\n  " + cursor + ".next = add i64 " + cursor + ", 1\n  br label %" + name + ".head\n\n" + name + ".done:\n")
    copy.scanLists.add(list)
    copy.scanBounds.add(haystack)
    return haystack
}

// The magnitude bound of one step value, or "" when the guard cannot bound it:
// a literal, the loop position, a List element at the loop position, a product
// or a sum of those, or a value the test already hoisted. Every checked
// operation on the way becomes one the plain copy computes.
function loopStepBound(copy: LoopCopy, ranges: LoopRanges, value: Text, slot: Text, counter: Text, limit: Text, depth: Integer): Text {
    if depth > 5 { return "" }
    if loopAtPosition(copy, value) { return "%loop.first." + copy.loop }
    if loopLiteral(value) {
        if !value.startsWith("-") { return value }
        let magnitude = value.slice(1, value.length)
        if magnitude == "9223372036854775808" { return "" }
        return magnitude
    }
    let defined = loopDefinitionLine(copy, value)
    if defined < 0 { return "" }
    let checked = loopCheckedAt(copy, defined)
    // The name is the checked operation's own result: it sits one line below
    // the intrinsic, flag and trap call that produce it.
    let start = defined
    if checked.operator == "" && defined >= 1 && copy.lines[defined].find(" = extractvalue { i64, i1 } ") >= 0 {
        checked = loopCheckedAt(copy, defined - 1)
        start = defined - 1
    }
    if checked.operator != "" {
        if loopLoadedLocal(copy, checked.left) == slot || loopLoadedLocal(copy, checked.right) == slot { return "" }
        let left = loopStepBound(copy, ranges, checked.left, slot, counter, limit, depth + 1)
        let right = loopStepBound(copy, ranges, checked.right, slot, counter, limit, depth + 1)
        if left == "" || right == "" { return "" }
        if loopRangeOperation(ranges, start) < 0 {
            ranges.ops.add(LoopRangeOp { line: start, operator: checked.operator, value: checked.value, left: checked.left, right: checked.right })
        }
        let parts = "." + copy.loop + "." + Text(ranges.bounds.length)
        let sum = "%loop.step.sum" + parts
        let bound = "%loop.step.bound" + parts
        if checked.operator == "mul" {
            ranges.bounds.add("  " + sum + " = icmp eq i64 " + right + ", 0\n  " + sum + ".safe = select i1 " + sum + ", i64 1, i64 " + right + "\n  " + sum + ".div = udiv i64 9223372036854775807, " + sum + ".safe\n  " + sum + ".fits = icmp ule i64 " + left + ", " + sum + ".div\n  " + sum + ".prod = mul i64 " + left + ", " + sum + ".safe\n  " + bound + " = select i1 " + sum + ".fits, i64 " + sum + ".prod, i64 -1\n")
        } else {
            ranges.bounds.add("  " + sum + " = add i64 " + left + ", " + right + "\n  " + sum + ".carry = icmp ult i64 " + sum + ", " + left + "\n  " + bound + " = select i1 " + sum + ".carry, i64 -1, i64 " + sum + "\n")
        }
        return bound
    }
    // A load of a local the iteration just stored reads that value.
    if copy.lines[defined].startsWith("  " + value + " = load i64, ptr %local.") {
        let local = loopLoadedLocal(copy, value)
        if local == "" || local == slot { return "" }
        let source = loopStoredValue(copy, local, defined)
        if source != "" { return loopStepBound(copy, ranges, source, slot, counter, limit, depth + 1) }
    }
    // A List element at the loop position: the scan of that List bounds it.
    let callee = ""
    if copy.lines[defined].startsWith("  " + value + " = call i64 @.minyar.list.get.") { callee = loopAccessCallee(copy.lines[defined], "@.minyar.list.get.") }
    if callee != "" {
        let arguments = loopCallArguments(copy.lines[defined], callee)
        if arguments.length < 2 { return "" }
        if loopWindowOffset(copy, loopAccessIndex(arguments, false)) != "0" { return "" }
        let list = loopInvariant(copy, arguments[0], false)
        if list == "" { return "" }
        return loopScan(copy, ranges, list, counter, limit)
    }
    // Any other value the test can read before the loop bounds every use.
    return loopInvariant(copy, value, false)
}

// One growth test: the largest step, times the number of iterations, must keep
// every value the accumulator takes inside the signed range.
function loopRangeTest(copy: LoopCopy, ranges: LoopRanges, slot: Text, delta: Text, limit: Text) {
    let index = Text(ranges.tests.length)
    let tag = "." + copy.loop + "." + index
    let name = "loop.grow" + tag
    let ref = "%" + name
    let trip = ref + ".trip"
    let account = ref + ".acc"
    let magnitude = ref + ".mag"
    let room = ref + ".room"
    let safe = ref + ".safe"
    ranges.tests.add("  " + trip + " = sub i64 " + limit + ", %loop.first." + copy.loop + "\n  " + account + " = load i64, ptr " + slot + "\n  " + ref + ".negative = icmp slt i64 " + account + ", 0\n  " + ref + ".opposite = sub i64 0, " + account + "\n  " + magnitude + " = select i1 " + ref + ".negative, i64 " + ref + ".opposite, i64 " + account + "\n  " + room + " = sub i64 9223372036854775807, " + magnitude + "\n  " + ref + ".zero = icmp eq i64 " + delta + ", 0\n  " + safe + " = select i1 " + ref + ".zero, i64 1, i64 " + delta + "\n  " + ref + ".quot = udiv i64 " + room + ", " + safe + "\n  " + ref + ".allowed = select i1 " + ref + ".zero, i64 -1, i64 " + ref + ".quot\n  " + ref + " = icmp ule i64 " + trip + ", " + ref + ".allowed\n")
}

// One growth test per accumulator, with its steps summed. A saturated sum makes
// the test fail, which is what an unbounded step means.
function loopRangeCombined(copy: LoopCopy, ranges: LoopRanges, limit: Text): Boolean {
    let slots: List<Text> = []
    let deltas: List<Text> = []
    let index = 0
    while index < ranges.slots.length {
        let slot = ranges.slots[index]
        let at = loopNamed(slots, slot)
        if at < 0 {
            slots.add(slot)
            deltas.add(ranges.deltas[index])
        } else {
            let name = "%loop.step.total." + copy.loop + "." + Text(at) + "." + Text(index)
            let left = deltas[at]
            let right = ranges.deltas[index]
            ranges.bounds.add("  " + name + " = add i64 " + left + ", " + right + "\n  " + name + ".carry = icmp ult i64 " + name + ", " + left + "\n  " + name + ".bound = select i1 " + name + ".carry, i64 -1, i64 " + name + "\n")
            deltas[at] = name + ".bound"
        }
        index = index + 1
    }
    ranges.slots = slots
    ranges.deltas = deltas
    let tests: List<Text> = []
    ranges.tests = tests
    index = 0
    while index < slots.length {
        loopRangeTest(copy, ranges, slots[index], deltas[index], limit)
        index = index + 1
    }
    return true
}

// The accumulations of a call-free region: which checked operation each store
// closes, and how fast its value may grow. `ok` false when the region is
// anything else, which leaves the checked copy in place.
function loopRangeGuard(copy: LoopCopy, counter: Text, limit: Text, walk: Boolean, fallback: Text): LoopRanges {
    let ranges = loopRangeNone()
    ranges.fallback = fallback
    // A List walk is the case worth a test: it reads every element once, so the
    // vectorized copy is a few instructions per element and the scan is one.
    if !walk { return ranges }
    // An element read at the loop position is hoisted only when the loop
    // writes no List: a written List may hold other values later.
    let index = 0
    while index < copy.lines.length {
        if copy.lines[index].find(".minyar.list.set.scalar.") >= 0 { return ranges }
        index = index + 1
    }
    // The region must be one block sequence: a branch back into it other than
    // the last line would run an accumulation more than once per iteration.
    index = 0
    while index < copy.lines.length - 1 {
        let line = copy.lines[index]
        if line.startsWith("  br ") {
            let targets = line.split("label %")
            let step = 1
            while step < targets.length {
                let target = targets[step]
                let end = 0
                while end < target.length && loopNameCharacter(target[end]) { end = end + 1 }
                let back = loopDefinitionLine(copy, "%" + target.slice(0, end))
                if back >= 0 && back < index { return loopRangeNone() }
                step = step + 1
            }
        }
        index = index + 1
    }
    // The counter must advance exactly once per iteration, or the positions the
    // loop visits are not the ones the scan reads.
    let advances = 0
    index = 0
    while index < copy.lines.length {
        if copy.lines[index].startsWith("  store ") && copy.lines[index].endsWith(", ptr " + counter) { advances = advances + 1 }
        index = index + 1
    }
    if advances != 1 { return loopRangeNone() }
    // Every store of a checked result is one iteration's accumulation of the
    // local it writes.
    index = 0
    while index < copy.lines.length {
        let slot = loopStoredLocal(copy, copy.lines[index])
        if slot != "" {
            let at = copy.lines[index].find(", ptr %local.")
            let stored = copy.lines[index].slice(12, at)
            let defined = loopDefinitionLine(copy, stored)
            if defined >= 1 {
                let operation = loopCheckedAt(copy, defined - 1)
                if operation.operator != "" && operation.value == stored {
                    let before = operation.left
                    let step = operation.right
                    if loopLoadedLocal(copy, before) != slot {
                        before = operation.right
                        step = operation.left
                    }
                    if loopLoadedLocal(copy, before) == slot {
                        let delta = loopStepBound(copy, ranges, step, slot, counter, limit, 0)
                        if operation.operator == "mul" {
                            // A factor bounded by zero is always zero; any other
                            // factor either grows the value or can negate its
                            // smallest one, which overflows on its own.
                            if delta != "0" { return loopRangeNone() }
                        }
                        if delta == "" { return loopRangeNone() }
                        if loopRangeOperation(ranges, defined - 1) < 0 {
                            ranges.ops.add(LoopRangeOp { line: defined - 1, operator: operation.operator, value: operation.value, left: operation.left, right: operation.right })
                        }
                        ranges.slots.add(slot)
                        ranges.deltas.add(delta)
                    }
                }
            }
        }
        index = index + 1
    }
    // A loop with no List element as an added value has nothing the trap costs:
    // LLVM already removes its checks and its counter alone is cheap.
    if ranges.slots.length == 0 || ranges.scans.length == 0 { return loopRangeNone() }
    // The counter's own `index += 1` is checked too. It cannot overflow in the
    // copy: the loop runs only while the counter is below a List length, and the
    // guard already tested the entry counter as not negative.
    index = 0
    while index < copy.lines.length {
        let slot = loopStoredLocal(copy, copy.lines[index])
        if slot == counter {
            let at = copy.lines[index].find(", ptr %local.")
            let stored = copy.lines[index].slice(12, at)
            let defined = loopDefinitionLine(copy, stored)
            if defined >= 1 {
                let operation = loopCheckedAt(copy, defined - 1)
                if operation.operator == "add" && operation.value == stored {
                    let step = operation.right
                    let before = operation.left
                    if step != "1" && before != "1" { return loopRangeNone() }
                    if step == "1" { step = operation.left; before = operation.right }
                    if loopLoadedLocal(copy, before) == counter && loopRangeOperation(ranges, defined - 1) < 0 {
                        ranges.ops.add(LoopRangeOp { line: defined - 1, operator: "add", value: operation.value, left: operation.left, right: operation.right })
                    }
                }
            }
        }
        index = index + 1
    }
    // One test per accumulator: a loop that adds twice per iteration grows by
    // the sum of both steps, so the tests are combined rather than repeated.
    if !loopRangeCombined(copy, ranges, limit) { return loopRangeNone() }
    // Every checked operation of the region must be covered, or the plain copy
    // would drop a test.
    index = 0
    while index < copy.lines.length {
        let line = copy.lines[index]
        if line.find(" = extractvalue { i64, i1 } ") >= 0 || line.startsWith("  call void @.minyar.integer.overflow.checked(") {
            if !loopRangeCovered(ranges, index) { return loopRangeNone() }
        }
        index = index + 1
    }
    ranges.ok = true
    return ranges
}

// Version the loop compiled into output after versionPureLoop. `region` is
// its condition block through its step block; it ends by branching back to
// the condition. Returns false, changing nothing, when no access qualifies.
// The classified copy of a loop region, with the loop variable aliased to the
// position when the region stores nothing else into it.
function loopRegionCopy(region: Text, loopLabel: Integer, variable: Integer, position: Text): LoopCopy {
    let loop = Text(loopLabel)
    let copy = LoopCopy { lines: region.split("\n"), defined: [], loaded: [], valueBase: 0, valueLines: [], otherNames: [], otherLines: [], touched: [], invariant: [], hoisted: [], guard: [], suffix: ".fast" + loop, loop: loop, blocks: 0, position: position, variable: "", indexLocal: "", lists: [], values: [], lengths: [], valueLoads: [], positionLists: [], windowLengths: [], windowLists: [], windowOffsets: [], windowCode: [], windowNames: [], windowHoisted: [], scanLists: [], scanBounds: [], fields: false, texts: [], textLengths: [], textBytes: [] }
    loopClassify(copy)
    // The loop variable is an alias of the position only if the region stores
    // nothing else into it.
    let variableSlot = "%local." + Text(variable)
    let stores = 0
    let positionStores = 0
    let index = 0
    while index < copy.lines.length {
        let line = copy.lines[index]
        if line.startsWith("  store ") && line.endsWith(", ptr " + variableSlot) {
            stores = stores + 1
            if line == "  store i64 " + position + ", ptr " + variableSlot { positionStores = positionStores + 1 }
        }
        index = index + 1
    }
    if variable >= 0 && stores == 1 && positionStores == 1 { copy.variable = variableSlot }
    return copy
}

// Whether the region is an accumulation the range guard can cover, which is
// the only reason to version a loop whose checks LLVM already removes.
function loopRangeCandidate(region: Text, loopLabel: Integer, counter: Integer, variable: Integer, position: Text, bound: Text, walk: Boolean, fallback: Text): Boolean {
    let copy = loopRegionCopy(region, loopLabel, variable, position)
    let limit = loopInvariant(copy, bound, false)
    if limit == "" { return false }
    return loopRangeGuard(copy, "%local." + Text(counter), limit, walk, fallback).ok
}

function versionCheckedLoop(output: List<Text>, entryPiece: Integer, region: Text, loopLabel: Integer, counter: Integer, variable: Integer, position: Text, bound: Text, walk: Boolean, whileLoop: Boolean, indexLocal: Text): Boolean {
    let loop = Text(loopLabel)
    // The copy's own condition label is where a guard that cannot pay sends the
    // loop: the checked copy, which runs the same code with every test in it.
    let fallback = "for.checked." + loop
    if whileLoop { fallback = "while.condition." + loop }
    let copy = loopRegionCopy(region, loopLabel, variable, position)
    // A while loop counts in a local of its own, which the body reloads: a load
    // of it before the region stores it reads the loop position.
    copy.indexLocal = indexLocal
    let index = 0
    let limit = loopInvariant(copy, bound, false)
    if limit == "" { return false }
    // A checked accumulation is worth a test of its own: LLVM cannot widen a
    // loop that traps on every addition. The analysis keeps the copy's guard
    // unchanged when the region is not a plain accumulation.
    let guardLines = copy.guard.length
    let invariantCount = copy.invariant.length
    let scanCount = copy.scanLists.length
    let blocksBefore = copy.blocks
    let ranges = loopRangeGuard(copy, "%local." + Text(counter), limit, walk, fallback)
    // A while loop has never been versioned for its bounds alone, and its body
    // may test List lengths LLVM cannot prove: only the growth test earns a
    // guard there.
    if whileLoop && !ranges.ok { return false }
    if !ranges.ok {
        copy.guard = loopTruncated(copy.guard, guardLines)
        copy.invariant = loopTruncated(copy.invariant, invariantCount)
        copy.hoisted = loopTruncated(copy.hoisted, invariantCount)
        copy.scanLists = loopTruncated(copy.scanLists, scanCount)
        copy.scanBounds = loopTruncated(copy.scanBounds, scanCount)
        copy.blocks = blocksBefore
    }
    // Find every qualifying access first, so the copy uses one value for each
    // hoisted name throughout.
    let getting: List<Text> = []
    let setting: List<Text> = []
    index = 0
    while index < copy.lines.length {
        let line = copy.lines[index]
        let reads = ""
        if copy.defined[index] != "" { reads = loopAccessCallee(line, "@.minyar.list.get.") }
        let writes = ""
        if reads == "" { writes = loopAccessCallee(line, "@.minyar.list.set.scalar.") }
        getting.add(reads)
        setting.add(writes)
        if reads != "" { let ignored = loopCheckedList(copy, line, reads) }
        if writes != "" { let ignored = loopCheckedList(copy, line, writes) }
        index = index + 1
    }
    if copy.lists.length == 0 { return false }
    let body: List<Text> = []
    let slots = 0
    index = 0
    while index < copy.lines.length {
        let line = copy.lines[index]
        let name = copy.defined[index]
        let values = ""
        if getting[index] != "" { values = loopCheckedList(copy, line, getting[index]) }
        if setting[index] != "" { values = loopCheckedList(copy, line, setting[index]) }
        let covered = -1
        if ranges.ok { covered = loopRangeOperation(ranges, index - 1) }
        // Hoisted values are computed once before the loop.
        if ranges.ok && loopRangeOmitted(ranges, index) {
            // The growth test covers this operation: no flag, no call.
        } else if covered >= 0 {
            body.add("  " + loopRename(copy, ranges.ops[covered].value) + " = " + ranges.ops[covered].operator + " i64 " + loopRename(copy, ranges.ops[covered].left) + ", " + loopRename(copy, ranges.ops[covered].right) + "\n")
        } else if name != "" && loopNamed(copy.invariant, name) >= 0 {
            values = ""
        } else if getting[index] != "" && values != "" {
            let arguments = loopCallArguments(line, getting[index])
            let renamed = name + copy.suffix
            body.add("  " + renamed + ".slot = getelementptr inbounds i64, ptr " + values + ", i64 " + loopRename(copy, loopAccessIndex(arguments, false)) + "\n  " + renamed + " = load i64, ptr " + renamed + ".slot\n")
        } else if setting[index] != "" && values != "" {
            let arguments = loopCallArguments(line, setting[index])
            let slot = "%loop.slot" + copy.suffix + "." + Text(slots)
            slots = slots + 1
            body.add("  " + slot + " = getelementptr inbounds i64, ptr " + values + ", i64 " + loopRename(copy, loopAccessIndex(arguments, true)) + "\n  store i64 " + loopRename(copy, loopAccessValue(arguments)) + ", ptr " + slot + "\n")
        } else {
            body.add(loopRename(copy, line) + "\n")
        }
        index = index + 1
    }
    let first = "%loop.first." + loop
    let test: List<Text> = [joinText(copy.windowCode), "  " + first + " = load i64, ptr %local." + Text(counter) + "\n  %loop.from." + loop + " = icmp sge i64 " + first + ", 0\n"]
    let all = "%loop.from." + loop
    index = 0
    while index < copy.lists.length {
        let list = copy.lists[index]
        let part = "%loop.fits." + loop + "." + Text(index)
        let length = copy.lengths[index]
        if length == "" {
            // Named so a parallel function can read its entry-loaded header.
            test.add("  " + part + ".length = call i64 @.minyar.list.length(ptr " + list + ")\n")
            length = part + ".length"
        }
        if copy.valueLoads[index] { test.add("  " + copy.values[index] + " = call ptr @.minyar.list.values(ptr " + list + ")\n") }
        // Only an access at the loop position needs the bound test; a window
        // test of its own already covers the whole range the loop visits.
        if copy.positionLists[index] {
            test.add("  " + part + " = icmp sle i64 " + limit + ", " + length + "\n  " + part + ".all = and i1 " + all + ", " + part + "\n")
            all = part + ".all"
        }
        copy.windowLengths.add(length)
        index = index + 1
    }
    // Each List accessed away from the loop position needs one more test that
    // covers every position the loop visits.
    index = 0
    while index < copy.windowOffsets.length {
        let listIndex = copy.windowLists[index]
        all = loopWindowTest(test, loop, listIndex, index, copy.windowOffsets[index], copy.windowLengths[listIndex], first, limit, all)
        index = index + 1
    }
    if ranges.ok {
        // Each List a step reads is scanned once, then each accumulator's
        // growth is bounded by the number of iterations.
        copy.guard.add(joinText(ranges.scans))
        test.add(joinText(ranges.bounds))
        test.add(joinText(ranges.tests))
        index = 0
        while index < ranges.tests.length {
            let part = "%loop.grow." + loop + "." + Text(index)
            test.add("  " + part + ".all = and i1 " + all + ", " + part + "\n")
            all = part + ".all"
            index = index + 1
        }
    }
    // A for loop gains a checked label for the original body; a while loop
    // keeps its own condition label and service blocks, so the guard stands
    // between the entry and the first condition and the copy is one more loop
    // that ends by branching back into itself.
    let guardName = "for.guard."
    let copyLabel = "for.condition." + loop + copy.suffix
    let tail = "\nfor.checked." + loop + ":\n" + output[entryPiece + 1]
    let piece = entryPiece + 1
    if whileLoop {
        guardName = "while.guard."
        copyLabel = "while.condition." + loop + copy.suffix
        tail = "\nwhile.guard.end." + loop + ":\n  br label %while.condition."
        piece = entryPiece + 2
    }
    output[piece] = "  br i1 %loop.idle." + loop + ", label %" + guardName + loop + ", label %" + fallback + "\n\n" + guardName + loop + ":\n" + joinText(copy.guard) + joinText(test) + "  br i1 " + all + ", label %" + copyLabel + ", label %" + fallback + "\n\n" + joinText(body) + tail
    return true
}

// Version a while loop whose condition compares a counter with a List length
// and whose body accumulates with checked arithmetic. `entryPiece + 4` opens the
// condition block, so the pieces after it hold the whole loop; the guard is
// written over the entry branch at `entryPiece + 2`.
function versionWhileAccumulation(output: List<Text>, entryPiece: Integer, stepPiece: Integer, loopLabel: Integer, bodyLabel: Integer): Boolean {
    let loop = Text(loopLabel)
    if stepPiece + 3 - (entryPiece + 4) > 2000 || stepPiece + 3 <= entryPiece + 4 { return false }
    let lines: List<Text> = []
    let piece = entryPiece + 4
    while piece <= stepPiece + 3 {
        lines.add(output[piece])
        piece = piece + 1
    }
    let region = joinText(lines)
    if region.find(".with.overflow.i64(") < 0 || region.find("@.minyar.list.get.") < 0 { return false }
    let copy = loopRegionCopy(region, loopLabel, -1, "")
    // The condition's comparison names the counter and the List it walks.
    let comparison = -1
    let index = 0
    while index < copy.lines.length && comparison < 0 {
        if copy.lines[index].find(" = icmp slt i64 ") >= 0 { comparison = index }
        index = index + 1
    }
    if comparison < 0 { return false }
    let at = copy.lines[comparison].find(" = icmp slt i64 ") + 16
    // A comparison repeats no types: its operands are separated by ", ".
    let parts = copy.lines[comparison].slice(at, copy.lines[comparison].length).split(", ")
    if parts.length != 2 { return false }
    let counterLocal = loopLoadedLocal(copy, parts[0])
    let counter = loopLocalNumber(counterLocal)
    if counter < 0 { return false }
    let defined = loopDefinitionLine(copy, parts[1])
    if defined < 0 || copy.lines[defined].find(" = call i64 @.minyar.list.length(") < 0 { return false }
    // Only a loop that advances its counter once per iteration visits the
    // positions one scan reads, which the guard checks again.
    return versionCheckedLoop(output, entryPiece, region, loopLabel, counter, -1, parts[0], parts[1], true, true, counterLocal)
}

// --- Text loops ---------------------------------------------------------
//
// A Text counts its characters lazily: a negative character length means the
// runtime has not counted it, and a counted Text without character offsets is
// ASCII. For such a Text a character position is its byte position, so a loop
// that reads `text[i]` or `text.length` of one Text can read the header once
// before the loop and then load bytes directly. A loop over any other Text
// still needs the counted or indexed path, so the loop is versioned: one test
// of every Text it reads picks a copy whose reads are plain byte loads, and
// every other Text runs the loop unchanged with the same traps.

// Whether a region line names `name` as a name of its own, not as a prefix.
function loopMentions(line: Text, name: Text): Boolean {
    let parts = line.split(name)
    let index = 1
    while index < parts.length {
        let part = parts[index]
        if part.length == 0 || !loopNameCharacter(part[0]) { return true }
        index = index + 1
    }
    return false
}

// Whether the region takes the address of a local other than to load its
// value. A callee given such an address may store through it, so the local is
// not the same value on the next iteration.
function loopLocalEscapes(copy: LoopCopy, local: Text): Boolean {
    let load = " = load i64, ptr " + local
    let pointer = " = load ptr, ptr " + local
    let index = 0
    while index < copy.lines.length {
        let line = copy.lines[index]
        if !line.startsWith(";") && loopMentions(line, local) && line.find(load) < 0 && line.find(pointer) < 0 { return true }
        index = index + 1
    }
    return false
}

// The field index text of `@.minyar.record.get.N`, or "".
function loopGetField(callee: Text): Text {
    let prefix = "@.minyar.record.get."
    if !callee.startsWith(prefix) { return "" }
    let field = callee.slice(prefix.length, callee.length)
    if field.length == 0 || field.startsWith(".") || field.find("(") >= 0 { return "" }
    return field
}

// Whether the region stores a scalar into field N of any record. A scalar
// store to another field cannot change this one, but a store of a reference
// (which a call-free loop never has) could.
function loopFieldStored(copy: LoopCopy, field: Text): Boolean {
    let prefix = "@.minyar.record.set.scalar("
    let index = 0
    while index < copy.lines.length {
        let line = copy.lines[index]
        let at = line.find(prefix)
        if at >= 0 {
            let rest = line.slice(at + prefix.length, line.length)
            let first = rest.find(", i64 ")
            if first >= 0 {
                let after = rest.slice(first + 6, rest.length)
                let second = after.find(",")
                if second >= 0 && after.slice(0, second) == field { return true }
            }
        }
        index = index + 1
    }
    return false
}

// The hoisted slot value of a Text the loop reads, or "" when the loop cannot
// prove it is the same header on every iteration. A value defined before the
// loop is one name throughout it; a local or parameter the region never stores
// to or takes the address of keeps its value; a reference record field keeps
// its slot in a call-free loop that never stores that field.
function loopTextSlot(copy: LoopCopy, value: Text): Text {
    if !value.startsWith("%") { return value }
    let known = loopNamed(copy.invariant, value)
    if known >= 0 { return copy.hoisted[known] }
    let defined = loopDefinitionLine(copy, value)
    if defined == -1 { return value }
    if defined < 0 { return "" }
    let line = copy.lines[defined]
    let local = copy.loaded[defined]
    let name = loopGuardName(copy, value, ".slot")
    if local != "" {
        if loopNamed(copy.touched, local) >= 0 || value.startsWith("%local.") || loopLocalEscapes(copy, local) { return "" }
        copy.guard.add("  " + name + line.slice(line.find(" = "), line.length) + "\n")
    } else if line.find(" = call i64 @.minyar.record.get") >= 0 {
        let at = line.find("@.minyar.record.get")
        let opening = line.find("(")
        if at < 0 || opening < at { return "" }
        let field = loopGetField(line.slice(at, opening))
        if field == "" || !copy.fields || loopFieldStored(copy, field) { return "" }
        let arguments = loopCallArguments(line, "@.minyar.record.get." + field)
        if arguments.length != 1 { return "" }
        let record = loopInvariant(copy, arguments[0], false)
        if record == "" { return "" }
        copy.guard.add("  " + name + ".values = getelementptr inbounds i8, ptr " + record + ", i64 8\n  " + name + ".pointer = getelementptr inbounds i64, ptr " + name + ".values, i64 " + field + "\n  " + name + " = load i64, ptr " + name + ".pointer\n")
    } else {
        return ""
    }
    copy.invariant.add(value)
    copy.hoisted.add(name)
    return name
}

// The hoisted pointer of a Text the loop reads, or "" when it cannot be
// hoisted. Text values reach a read as a pointer converted from a slot value.
function loopTextPointer(copy: LoopCopy, value: Text): Text {
    if !value.startsWith("%") { return value }
    let known = loopNamed(copy.invariant, value)
    if known >= 0 { return copy.hoisted[known] }
    let defined = loopDefinitionLine(copy, value)
    if defined == -1 {
        if value.startsWith("%local.") { return "" }
        return value
    }
    if defined < 0 { return "" }
    let line = copy.lines[defined]
    let name = loopGuardName(copy, value, ".text")
    let start = line.find(" = inttoptr i64 ")
    if start >= 0 && line.endsWith(" to ptr") {
        let slot = loopTextSlot(copy, line.slice(start + 16, line.length - 7))
        if slot == "" { return "" }
        copy.guard.add("  " + name + " = inttoptr i64 " + slot + " to ptr\n")
    } else if line.find(" = load ptr, ptr ") >= 0 {
        // A Text held in a local as its header pointer.
        let local = copy.loaded[defined]
        if local == "" || loopNamed(copy.touched, local) >= 0 || loopLocalEscapes(copy, local) { return "" }
        copy.guard.add("  " + name + line.slice(line.find(" = "), line.length) + "\n")
    } else {
        return ""
    }
    copy.invariant.add(value)
    copy.hoisted.add(name)
    return name
}

// The index of a Text's hoisted header reads, adding them on first use: the
// character length, whether it is counted and ASCII, and the bytes buffer.
function loopTextHeader(copy: LoopCopy, pointer: Text): Integer {
    let known = loopNamed(copy.texts, pointer)
    if known >= 0 { return known }
    let base = "%text." + copy.loop + "." + Text(copy.texts.length)
    let length = base + ".length"
    copy.guard.add("  " + length + ".pointer = getelementptr inbounds { ptr, i64, i64, ptr }, ptr " + pointer + ", i32 0, i32 2\n  " + length + " = load i64, ptr " + length + ".pointer\n  " + base + ".counted = icmp sgt i64 " + length + ", -1\n  " + length + ".offsets = getelementptr inbounds { ptr, i64, i64, ptr }, ptr " + pointer + ", i32 0, i32 3\n  " + length + ".offsets.value = load ptr, ptr " + length + ".offsets\n  " + length + ".ascii = icmp eq ptr " + length + ".offsets.value, null\n  " + length + ".known = and i1 " + base + ".counted, " + length + ".ascii\n  " + base + ".bytes = load ptr, ptr " + pointer + "\n")
    copy.texts.add(pointer)
    copy.textLengths.add(length)
    copy.textBytes.add(base + ".bytes")
    return copy.texts.length - 1
}

// The accesses a Text versioned loop found, by region line: 1 a character
// length, 2 a character, 0 neither.
function loopTextKinds(copy: LoopCopy): List<Integer> {
    let kinds: List<Integer> = []
    let index = 0
    while index < copy.lines.length {
        let line = copy.lines[index]
        let kind = 0
        if copy.defined[index] != "" {
            if line.find(" = call i64 @.minyar.text.length(") >= 0 { kind = 1 }
            if line.find(" = call i32 @.minyar.text.character(") >= 0 { kind = 2 }
        }
        kinds.add(kind)
        index = index + 1
    }
    return kinds
}

function loopDropTextTest(copy: LoopCopy, guard: Integer, invariantCount: Integer) {
    copy.guard = loopTruncated(copy.guard, guard)
    copy.invariant = loopTruncated(copy.invariant, invariantCount)
    copy.hoisted = loopTruncated(copy.hoisted, invariantCount)
    let texts: List<Text> = []
    let lengths: List<Text> = []
    let bytes: List<Text> = []
    copy.texts = texts
    copy.textLengths = lengths
    copy.textBytes = bytes
}

// The versioned test and fast copy of a Text loop: one test of every Text the
// region reads, then a copy whose reads are direct byte loads on a hoisted
// header, and a checked label for the unversioned loop. `label` is the
// condition label the copy branches back to; `loop` keeps names apart. The
// `.text` suffix keeps them apart from the List copy of the same loop and from
// every enclosing copy, which renames both copies again, so nesting any depth
// leaves one definition per local name.
function textLoopVersion(region: Text, loop: Text, label: Text, fields: Boolean): Text {
    let copy = LoopCopy { lines: region.split("\n"), defined: [], loaded: [], valueBase: 0, valueLines: [], otherNames: [], otherLines: [], touched: [], invariant: [], hoisted: [], guard: [], suffix: ".text" + loop, loop: loop, blocks: 0, position: "", variable: "", indexLocal: "", lists: [], values: [], lengths: [], valueLoads: [], positionLists: [], windowLengths: [], windowLists: [], windowOffsets: [], windowCode: [], windowNames: [], windowHoisted: [], scanLists: [], scanBounds: [], fields: fields, texts: [], textLengths: [], textBytes: [] }
    loopClassify(copy)
    // The loop's condition label is defined before the region, but the copy
    // ends by branching back to it.
    copy.otherNames.add("%" + label)
    copy.otherLines.add(-2)
    let kinds = loopTextKinds(copy)
    let guard = copy.guard.length
    let invariantCount = copy.invariant.length
    let index = 0
    while index < copy.lines.length {
        let kind = kinds[index]
        if kind != 0 {
            let callee = "@.minyar.text.length"
            let count = 1
            if kind == 2 {
                callee = "@.minyar.text.character"
                count = 2
            }
            let arguments = loopCallArguments(copy.lines[index], callee)
            if arguments.length != count {
                loopDropTextTest(copy, guard, invariantCount)
                return ""
            }
            let pointer = loopTextPointer(copy, arguments[0])
            if pointer == "" {
                loopDropTextTest(copy, guard, invariantCount)
                return ""
            }
            if kind == 1 {
                let header = loopTextHeader(copy, pointer)
                copy.invariant.add(copy.defined[index])
                copy.hoisted.add(copy.textLengths[header])
            } else {
                let ignored = loopTextHeader(copy, pointer)
            }
        }
        index = index + 1
    }
    if copy.texts.length == 0 { return "" }
    let body: List<Text> = []
    let replaced = 0
    index = 0
    while index < copy.lines.length {
        let line = copy.lines[index]
        let kind = kinds[index]
        let name = copy.defined[index]
        if name != "" && loopNamed(copy.invariant, name) >= 0 {
            // Computed once before the loop; uses name the hoisted value.
            if kind != 0 { replaced = replaced + 1 }
        } else if kind == 2 {
            let arguments = loopCallArguments(line, "@.minyar.text.character")
            let pointer = loopTextPointer(copy, arguments[0])
            let header = loopTextHeader(copy, pointer)
            body.add("  " + name + copy.suffix + " = call i32 @.minyar.text.character.known(ptr " + pointer + ", i64 " + loopRename(copy, arguments[1]) + ", i64 " + copy.textLengths[header] + ", ptr " + copy.textBytes[header] + ")\n")
            replaced = replaced + 1
        } else {
            body.add(loopRename(copy, line) + "\n")
        }
        index = index + 1
    }
    if replaced == 0 { return "" }
    // One test of every Text before the copy, so the copy is entered only when
    // each of them is counted ASCII.
    let all = ""
    index = 0
    while index < copy.texts.length {
        let known = copy.textLengths[index] + ".known"
        if index > 0 {
            let merged = "%text.all." + loop + "." + Text(index)
            copy.guard.add("  " + merged + " = and i1 " + all + ", " + known + "\n")
            all = merged
        } else {
            all = known
        }
        index = index + 1
    }
    let fast = label + copy.suffix
    return joinText(copy.guard) + "  br i1 " + all + ", label %" + fast + ", label %text.checked." + loop + "\n\n" + fast + ":\n" + joinText(body) + "\ntext.checked." + loop + ":\n"
}

// Version a while loop: `entryPiece + 2` is the branch to its condition label,
// which the pieces after it complete.
function versionTextLoop(output: List<Text>, entryPiece: Integer, region: Text, loopLabel: Integer, conditionLabel: Integer, fields: Boolean): Boolean {
    let test = textLoopVersion(region, Text(loopLabel), "while.condition." + Text(conditionLabel), fields)
    if test == "" { return false }
    output[entryPiece + 2] = test + "  br label %while.condition."
    return true
}

// Version a for loop: `entryPiece + 2` is the branch to its condition label,
// which the pieces after it complete.
function versionTextFor(output: List<Text>, entryPiece: Integer, region: Text, loopLabel: Integer, fields: Boolean): Boolean {
    let test = textLoopVersion(region, Text(loopLabel), "for.condition." + Text(loopLabel), fields)
    if test == "" { return false }
    // The strip setup comes first, so both copies share it.
    output[entryPiece + 2] = test + output[entryPiece + 2]
    return true
}
