function characterIsDigit(character: Character): Boolean {
    return character >= '0' && character <= '9'
}

function characterIsHexDigit(character: Character): Boolean {
    return characterIsDigit(character) || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F')
}

function hexDigitValue(character: Character): Integer {
    let digits = "0123456789abcdef"
    let lower = character
    if character >= 'A' && character <= 'F' {
        lower = digits[10 + findCharacter("ABCDEF", character)]
    }
    return findCharacter(digits, lower)
}

function findCharacter(text: Text, wanted: Character): Integer {
    let position = 0
    while position < text.length {
        if text[position] == wanted {
            return position
        }
        position = position + 1
    }
    return -1
}

function characterIsLetter(character: Character): Boolean {
    let lowercase = character >= 'a' && character <= 'z'
    let uppercase = character >= 'A' && character <= 'Z'
    return lowercase || uppercase
}

function characterIsWhitespace(character: Character): Boolean {
    return character == ' ' || character == '\n' || character == '\r' || character == '\t'
}

function sourceLocation(line: Integer, column: Integer): Text {
    return Text(line) + ", column " + Text(column)
}

function addToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, coordinates: List<Integer>, kind: Integer, text: Text, line: Integer, column: Integer) {
    tokenKinds.add(kind)
    tokenTexts.add(text)
    coordinates.add(line)
    coordinates.add(column)
}

function lineCanEndStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>): Boolean {
    let result = false
    if tokenKinds.length > 0 {
        let last = tokenKinds.length - 1
        let kind = tokenKinds[last]
        if kind == 1 || kind == 2 || kind == 3 || kind == 5 || kind == 7 {
            result = true
        } else {
            if kind == 4 {
                let text = tokenTexts[last]
                result = text == ")" || text == "]" || text == "}"
            }
        }
    }
    return result
}

function sourceCharacter(source: Text, bytes: Bytes, position: Integer, ascii: Boolean): Character {
    if ascii { return Character(bytes[position]) }
    return source[position]
}

function tokenize(source: Text, tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap) {
    let firstToken = tokenKinds.length
    let modifiers = false
    let delimiterFrames = Bytes(0)
    let delimiterDepth = 0
    let features = tokenLines.features
    let callbacks = features % 2 != 0
    let coordinates = tokenLines.coordinates
    let position = 0
    let line = 1
    let lineStart = 0
    let length = source.length
    let ascii = length == source.byteLength
    let bytes = Bytes(0)
    if ascii { bytes = Bytes(source) }
    let roundDepth = 0
    let squareDepth = 0
    if length > 0 && sourceCharacter(source, bytes, 0, ascii) == Character(65279) {
        position = 1
    }

    while position < length {
        let character = sourceCharacter(source, bytes, position, ascii)

        if character == ' ' || character == '\n' || character == '\r' || character == '\t' {
            if character == '\n' {
                if roundDepth == 0 && squareDepth == 0 && lineCanEndStatement(tokenKinds, tokenTexts) {
                    addToken(tokenKinds, tokenTexts, coordinates, 6, "end of line", line, position - lineStart + 1)
                }
                line = line + 1
                lineStart = position + 1
            }
            position = position + 1
        } else {
            if character == '/' && position + 1 < length && sourceCharacter(source, bytes, position + 1, ascii) == '/' {
                position = position + 2
                while position < length && sourceCharacter(source, bytes, position, ascii) != '\n' {
                    position = position + 1
                }
            } else {
                if character == '/' && position + 1 < length && sourceCharacter(source, bytes, position + 1, ascii) == '*' {
                    let commentLine = line
                    let commentColumn = position - lineStart + 1
                    position = position + 2
                    while position + 1 < length && !(sourceCharacter(source, bytes, position, ascii) == '*' && sourceCharacter(source, bytes, position + 1, ascii) == '/') {
                        if sourceCharacter(source, bytes, position, ascii) == '\n' {
                            line = line + 1
                            lineStart = position + 1
                        }
                        position = position + 1
                    }
                    if position + 1 >= length {
                        fail("line " + sourceLocation(commentLine, commentColumn) + ": block comment is missing its closing */")
                    }
                    position = position + 2
                } else {
                    if (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_' {
                        let start = position
                        let tokenLine = line
                        let tokenColumn = position - lineStart + 1
                        position = position + 1
                        let inName = true
                        while position < length && inName {
                            let next = sourceCharacter(source, bytes, position, ascii)
                            inName = (next >= 'a' && next <= 'z') || (next >= 'A' && next <= 'Z') || (next >= '0' && next <= '9') || next == '_'
                            if inName { position = position + 1 }
                        }
                        let name = source.slice(start, position)
                        if name == "parallel" || name == "thread" { modifiers = true; if features / 16 % 2 == 0 { features = features + 16 } }
                        if features / 4 % 2 == 0 && (character == 'f' || character == 'c' || character == 'b' || character == 't' || character == 's' || character == 'j' || character == 'r' || character == 'F' || character == 'B' || character == 'T') && (name == "thread" || threadFeatureName(name)) { features = features + 4 }
                        if features / 2 % 2 == 0 && name.byteLength > 14 && name[0] == 'm' && resultPrefix(name, "minyar_result_") { features = features + 2 }
                        addToken(tokenKinds, tokenTexts, coordinates, 1, name, tokenLine, tokenColumn)
                    } else {
                        if character >= '0' && character <= '9' {
                            let start = position
                            let tokenLine = line
                            let tokenColumn = position - lineStart + 1
                            while position < length && characterIsDigit(sourceCharacter(source, bytes, position, ascii)) {
                                position = position + 1
                            }
                            let numberKind = 2
                            let hexValue = -1
                            let hexMinimum = false
                            let octal = character == '0' && position == start + 1 && position < length && sourceCharacter(source, bytes, position, ascii) == 'o'
                            if octal {
                                position = position + 1
                                if position >= length || sourceCharacter(source, bytes, position, ascii) < '0' || sourceCharacter(source, bytes, position, ascii) > '7' {
                                    fail("line " + sourceLocation(tokenLine, tokenColumn) + ": an octal Integer literal needs only digits 0 through 7 after 0o")
                                }
                                hexValue = 0
                                while position < length && sourceCharacter(source, bytes, position, ascii) >= '0' && sourceCharacter(source, bytes, position, ascii) <= '7' {
                                    let digit = Integer(sourceCharacter(source, bytes, position, ascii)) - Integer('0')
                                    if hexValue > (9223372036854775807 - digit) / 8 {
                                        if hexValue == 1152921504606846976 && digit == 0 && (position + 1 == length || sourceCharacter(source, bytes, position + 1, ascii) < '0' || sourceCharacter(source, bytes, position + 1, ascii) > '7') {
                                            hexMinimum = true
                                        } else {
                                            fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Integer literal is outside the supported range")
                                        }
                                    }
                                    if !hexMinimum { hexValue = hexValue * 8 + digit }
                                    position = position + 1
                                }
                                if position < length && (characterIsLetter(sourceCharacter(source, bytes, position, ascii)) || characterIsDigit(sourceCharacter(source, bytes, position, ascii)) || sourceCharacter(source, bytes, position, ascii) == '_') {
                                    fail("line " + sourceLocation(tokenLine, tokenColumn) + ": an octal Integer literal needs only digits 0 through 7 after 0o")
                                }
                            }
                            if character == '0' && position == start + 1 && position + 1 < length && sourceCharacter(source, bytes, position, ascii) == 'x' && characterIsHexDigit(sourceCharacter(source, bytes, position + 1, ascii)) {
                                position = position + 1
                                hexValue = 0
                                while position < length && characterIsHexDigit(sourceCharacter(source, bytes, position, ascii)) {
                                    let digit = hexDigitValue(sourceCharacter(source, bytes, position, ascii))
                                    if hexValue > (9223372036854775807 - digit) / 16 {
                                        if hexValue == 576460752303423488 && digit == 0 && (position + 1 == length || !characterIsHexDigit(sourceCharacter(source, bytes, position + 1, ascii))) {
                                            hexMinimum = true
                                        } else {
                                            fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Integer literal is outside the supported range")
                                        }
                                    }
                                    if !hexMinimum { hexValue = hexValue * 16 + digit }
                                    position = position + 1
                                }
                            }
                            if hexValue >= 0 && position + 1 < length && sourceCharacter(source, bytes, position, ascii) == '.' && characterIsDigit(sourceCharacter(source, bytes, position + 1, ascii)) {
                                if octal { fail("line " + sourceLocation(tokenLine, tokenColumn) + ": octal literals are Integers and cannot have a decimal point") }
                                fail("line " + sourceLocation(tokenLine, tokenColumn) + ": hexadecimal literals are Integers and cannot have a decimal point")
                            }
                            if numberKind == 2 && position + 1 < length && sourceCharacter(source, bytes, position, ascii) == '.' && characterIsDigit(sourceCharacter(source, bytes, position + 1, ascii)) {
                                numberKind = 7
                                position = position + 1
                                while position < length && characterIsDigit(sourceCharacter(source, bytes, position, ascii)) {
                                    position = position + 1
                                }
                                if position < length && (sourceCharacter(source, bytes, position, ascii) == 'e' || sourceCharacter(source, bytes, position, ascii) == 'E') {
                                    position = position + 1
                                    if position < length && (sourceCharacter(source, bytes, position, ascii) == '+' || sourceCharacter(source, bytes, position, ascii) == '-') {
                                        position = position + 1
                                    }
                                    if position >= length || !characterIsDigit(sourceCharacter(source, bytes, position, ascii)) {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": a Float exponent needs digits, as in 1.5e3")
                                    }
                                    while position < length && characterIsDigit(sourceCharacter(source, bytes, position, ascii)) {
                                        position = position + 1
                                    }
                                }
                            }
                            let digits = source.slice(start, position)
                            if numberKind == 2 && hexValue < 0 && character == '0' && position > start + 1 {
                                fail("line " + sourceLocation(tokenLine, tokenColumn) + ": decimal Integer literals cannot have a leading zero; use 0o for octal")
                            }
                            if hexValue >= 0 {
                                if hexMinimum { digits = "9223372036854775808" } else { digits = Text(hexValue) }
                            }
                            addToken(tokenKinds, tokenTexts, coordinates, numberKind, digits, tokenLine, tokenColumn)
                        } else {
                            if character == '"' {
                                let tokenLine = line
                                let tokenColumn = position - lineStart + 1
                                position = position + 1
                                let chunkStart = position
                                while position < length && sourceCharacter(source, bytes, position, ascii) != '"' && sourceCharacter(source, bytes, position, ascii) != '\\' {
                                    if sourceCharacter(source, bytes, position, ascii) == '\n' {
                                        line = line + 1
                                        lineStart = position + 1
                                    }
                                    position = position + 1
                                }
                                if position >= length {
                                    fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Text literal is missing its closing quote")
                                }
                                let text = ""
                                if position < length && sourceCharacter(source, bytes, position, ascii) == '\\' {
                                    let pieces: List<Text> = []
                                    while position < length && sourceCharacter(source, bytes, position, ascii) != '"' {
                                        if sourceCharacter(source, bytes, position, ascii) == '\\' && position + 1 < length {
                                            if chunkStart < position {
                                                pieces.add(source.slice(chunkStart, position))
                                            }
                                            let escape = sourceCharacter(source, bytes, position + 1, ascii)
                                            if escape == '\n' {
                                                line = line + 1
                                                lineStart = position + 2
                                            }
                                            if escape == 'n' {
                                                pieces.add(Text('\n'))
                                            } else {
                                                if escape == 'r' {
                                                    pieces.add(Text('\r'))
                                                } else {
                                                    if escape == 't' {
                                                        pieces.add(Text('\t'))
                                                    } else {
                                                        pieces.add(Text(escape))
                                                    }
                                                }
                                            }
                                            position = position + 2
                                            chunkStart = position
                                        } else {
                                            if sourceCharacter(source, bytes, position, ascii) == '\n' {
                                                line = line + 1
                                                lineStart = position + 1
                                            }
                                            position = position + 1
                                        }
                                    }
                                    if position >= length {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Text literal is missing its closing quote")
                                    }
                                    if chunkStart < position {
                                        pieces.add(source.slice(chunkStart, position))
                                    }
                                    text = joinText(pieces)
                                } else {
                                    text = source.slice(chunkStart, position)
                                }
                                position = position + 1
                                if features / 8 % 2 == 0 && text == "calldepth" && tokenKinds.length > 0 && tokenKinds[tokenKinds.length - 1] == 1 && tokenTexts[tokenTexts.length - 1] == "native" { features = features + 8 }
                                addToken(tokenKinds, tokenTexts, coordinates, 3, text, tokenLine, tokenColumn)
                            } else {
                                if character > '~' {
                                    fail("line " + Text(line) + ", column " + Text(position - lineStart + 1) + ": names must use ASCII letters, digits, and '_'; found non-ASCII character '" + Text(character) + "'")
                                }
                                if character == '\'' {
                                    let tokenLine = line
                                    let tokenColumn = position - lineStart + 1
                                    position = position + 1
                                    if position >= length {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Character literal is missing its value and closing quote")
                                    }
                                    let value = sourceCharacter(source, bytes, position, ascii)
                                    if value == '\\' {
                                        position = position + 1
                                        if position >= length {
                                            fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Character literal has an unfinished escape")
                                        }
                                        let escape = sourceCharacter(source, bytes, position, ascii)
                                        if escape == 'n' {
                                            value = '\n'
                                        } else {
                                            if escape == 'r' {
                                                value = '\r'
                                            } else {
                                                if escape == 't' {
                                                    value = '\t'
                                                } else {
                                                    value = escape
                                                }
                                            }
                                        }
                                    }
                                    if sourceCharacter(source, bytes, position, ascii) == '\n' {
                                        line = line + 1
                                        lineStart = position + 1
                                    }
                                    position = position + 1
                                    if position >= length || sourceCharacter(source, bytes, position, ascii) != '\'' {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Character literal must contain exactly one character and a closing quote")
                                    }
                                    position = position + 1
                                    addToken(tokenKinds, tokenTexts, coordinates, 5, Text(value), tokenLine, tokenColumn)
                                } else {
                                    let punctuationColumn = position - lineStart + 1
                                    let punctuation = Text(character)
                                    if position + 1 < length {
                                        let next = sourceCharacter(source, bytes, position + 1, ascii)
                                        let doubled = false
                                        if next == '=' {
                                            doubled = character == '=' || character == '!' || character == '<' || character == '>' || character == '+' || character == '-' || character == '*' || character == '/' || character == '%'
                                        } else {
                                            doubled = (character == '&' && next == '&') || (character == '|' && next == '|') || (character == '<' && next == '<') || (character == '>' && next == '>') || (character == '.' && next == '.')
                                        }
                                        if doubled {
                                            punctuation = punctuation + Text(next)
                                            position = position + 1
                                        }
                                    }
                                    let punctuationKind = 4
                                    if (punctuation == "(" || punctuation == "<") && tokenKinds.length > 0 && tokenKinds[tokenKinds.length - 1] == 1 {
                                        let previous = tokenTexts[tokenTexts.length - 1]
                                        if !callbacks && ((punctuation == "(" && previous == "function") || (punctuation == "<" && previous == "Callback")) {
                                            callbacks = true
                                            features = features + 1
                                        }
                                        if features / 2 % 2 == 0 && punctuation == "<" && (previous == "Result" || previous == "Ok" || previous == "Err") { features = features + 2 }
                                    }
                                    if callbacks && punctuation == "{" {
                                        while delimiterFrames.length < delimiterDepth * 16 + 16 { delimiterFrames.addInt64(0) }
                                        delimiterFrames.setInt64(delimiterDepth * 16, roundDepth)
                                        delimiterFrames.setInt64(delimiterDepth * 16 + 8, squareDepth)
                                        delimiterDepth = delimiterDepth + 1
                                        roundDepth = 0
                                        squareDepth = 0
                                    }
                                    if callbacks && punctuation == "}" && delimiterDepth > 0 {
                                        delimiterDepth = delimiterDepth - 1
                                        roundDepth = delimiterFrames.getInt64(delimiterDepth * 16)
                                        squareDepth = delimiterFrames.getInt64(delimiterDepth * 16 + 8)
                                    }
                                    if punctuation == "(" { roundDepth = roundDepth + 1 }
                                    if punctuation == ")" && roundDepth > 0 { roundDepth = roundDepth - 1 }
                                    if punctuation == "[" { squareDepth = squareDepth + 1 }
                                    if punctuation == "]" && squareDepth > 0 { squareDepth = squareDepth - 1 }
                                    if punctuation == ";" {
                                        punctuationKind = 6
                                    }
                                    addToken(tokenKinds, tokenTexts, coordinates, punctuationKind, punctuation, line, punctuationColumn)
                                    position = position + 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    addToken(tokenKinds, tokenTexts, coordinates, 0, "", line, position - lineStart + 1)
    let scan = firstToken
    while modifiers && scan + 1 < tokenKinds.length {
        if scan + 2 < tokenKinds.length && tokenKinds[scan] == 1 && tokenTexts[scan] == "public" && tokenKinds[scan + 1] == 1 && (tokenTexts[scan + 1] == "parallel" || tokenTexts[scan + 1] == "thread") && tokenKinds[scan + 2] == 1 && tokenTexts[scan + 2] == "function" {
            tokenKinds[scan] = 6
            tokenTexts[scan] = tokenTexts[scan + 1]
            tokenTexts[scan + 1] = "public"
        }
        if tokenKinds[scan] == 1 && (tokenTexts[scan] == "parallel" || tokenTexts[scan] == "thread") && tokenKinds[scan + 1] == 1 && tokenTexts[scan + 1] == "function" {
            tokenKinds[scan] = 6
        }
        scan = scan + 1
    }
    tokenLines.features = features
}

function describeLocation(location: Text): Text {
    if location.length > 0 && location[0] >= '0' && location[0] <= '9' {
        return "line " + location
    }
    return location
}

function escapeLLVMText(text: Text): Text {
    let pieces: List<Text> = []
    let chunkStart = 0
    let changed = false
    let position = 0
    while position < text.length {
        let character = text[position]
        let replacement = ""
        if character == '\n' {
            replacement = "\\0A"
        } else {
            if character == '\r' {
                replacement = "\\0D"
            } else {
                if character == '\t' {
                    replacement = "\\09"
                } else {
                    if character == '"' {
                        replacement = "\\22"
                    } else {
                        if character == '\\' {
                            replacement = "\\5C"
                        }
                    }
                }
            }
        }
        if replacement != "" {
            if chunkStart < position {
                pieces.add(text.slice(chunkStart, position))
            }
            pieces.add(replacement)
            changed = true
            chunkStart = position + 1
        }
        position = position + 1
    }
    if !changed {
        return text
    }
    if chunkStart < position {
        pieces.add(text.slice(chunkStart, position))
    }
    return joinText(pieces)
}

function tokenIs(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: List<Integer>, expected: Text): Boolean {
    let kind = tokenKinds[cursor[0]]
    return kind != 2 && kind != 3 && kind != 5 && kind != 7 && tokenTexts[cursor[0]] == expected
}

function expectToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>, expected: Text) {
    if !tokenIs(tokenKinds, tokenTexts, cursor, expected) {
        fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": expected '" + expected + "', found '" + tokenTexts[cursor[0]] + "'")
    }
    cursor[0] = cursor[0] + 1
}

function skipTerminators(tokenKinds: List<Integer>, cursor: List<Integer>) {
    while tokenKinds[cursor[0]] == 6 {
        cursor[0] = cursor[0] + 1
    }
}

function finishStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>) {
    if tokenKinds[cursor[0]] == 6 {
        skipTerminators(tokenKinds, cursor)
    } else {
        if tokenKinds[cursor[0]] != 0 && !tokenIs(tokenKinds, tokenTexts, cursor, "}") {
            fail(describeLocation(tokenLocation(tokenLines, cursor[0])) + ": unexpected '" + tokenTexts[cursor[0]] + "'; start the next statement on a new line")
        }
    }
}
