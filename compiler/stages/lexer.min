function characterIsDigit(character: Character): Boolean {
    return character >= '0' && character <= '9'
}

function characterIsHexDigit(character: Character): Boolean {
    return characterIsDigit(character) || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F')
}

function hexDigitValue(character: Character): Integer {
    let digits = "0123456789abcdef"
    let lower = character
    if character >= 'A' && character <= 'F' {
        lower = digits[10 + findCharacter("ABCDEF", character)]
    }
    return findCharacter(digits, lower)
}

function findCharacter(text: Text, wanted: Character): Integer {
    let position = 0
    while position < text.length {
        if text[position] == wanted {
            return position
        }
        position = position + 1
    }
    return -1
}

function characterIsLetter(character: Character): Boolean {
    let lowercase = character >= 'a' && character <= 'z'
    let uppercase = character >= 'A' && character <= 'Z'
    return lowercase || uppercase
}

function characterIsWhitespace(character: Character): Boolean {
    return character == ' ' || character == '\n' || character == '\r' || character == '\t'
}

function sourceLocation(line: Integer, column: Integer): Text {
    return Text(line) + ", column " + Text(column)
}

function addToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, coordinates: List<Integer>, kind: Integer, text: Text, line: Integer, column: Integer) {
    tokenKinds.add(kind)
    tokenTexts.add(text)
    coordinates.add(line)
    coordinates.add(column)
}

function lineCanEndStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>): Boolean {
    let result = false
    if tokenKinds.length > 0 {
        let last = tokenKinds.length - 1
        let kind = tokenKinds[last]
        if kind == 1 || kind == 2 || kind == 3 || kind == 5 || kind == 7 {
            result = true
        } else {
            if kind == 4 {
                let text = tokenTexts[last]
                result = text == ")" || text == "]" || text == "}"
            }
        }
    }
    return result
}

// Interpolation is ordinary expression syntax after lexing. The synthetic name
// cannot be written as a source identifier and receives a printable-type check.
function isInterpolationConversion(name: Text): Boolean {
    return name == "text interpolation"
}

function isInterpolationJoin(name: Text): Boolean {
    return name == "text interpolation join"
}

function textDelimiterAt(source: Text, position: Integer, multiline: Boolean, raw: Boolean): Boolean {
    if position >= source.length || source[position] != '"' { return false }
    let after = position + 1
    if multiline {
        if position + 2 >= source.length || source[position + 1] != '"' || source[position + 2] != '"' { return false }
        after = position + 3
    }
    return !raw || (after < source.length && source[after] == '#')
}

// Decode only literal source ranges, so escaped newlines and expression source
// are never mistaken for the indentation of a physical content line.
function decodeTextPart(source: Text, sources: SourceMap, start: Integer, end: Integer, line: Integer, lineStart: Integer, indentation: Integer, multiline: Boolean, raw: Boolean): Text {
    let pieces: List<Text> = []
    let position = start
    let chunkStart = start
    while position < end {
        if multiline && position == lineStart {
            let whitespace = position
            while whitespace < end && (source[whitespace] == ' ' || source[whitespace] == '\t') { whitespace = whitespace + 1 }
            let blank = whitespace >= source.length || source[whitespace] == '\n' || (source[whitespace] == '\r' && whitespace + 1 < source.length && source[whitespace + 1] == '\n')
            if whitespace - position < indentation && !blank {
                failAtSource(sources, source, line, 1, "multi-line Text has less indentation than its closing delimiter")
            }
            let removed = indentation
            if whitespace - position < removed { removed = whitespace - position }
            if removed > 0 {
                if chunkStart < position { pieces.add(source.slice(chunkStart, position)) }
                position = position + removed
                chunkStart = position
            }
        }
        if position < end {
            let character = source[position]
            if !raw && character == '\\' && position + 1 < source.length && (position + 1 < end || (multiline && (source[position + 1] == '\n' || (source[position + 1] == '\r' && position + 2 < source.length && source[position + 2] == '\n')))) {
                if chunkStart < position { pieces.add(source.slice(chunkStart, position)) }
                let escape = source[position + 1]
                let continued = multiline && (escape == '\n' || (escape == '\r' && position + 2 < source.length && source[position + 2] == '\n'))
                if !continued {
                    if escape == 'n' { pieces.add(Text('\n')) } else {
                        if escape == 'r' { pieces.add(Text('\r')) } else {
                            if escape == 't' { pieces.add(Text('\t')) } else { pieces.add(Text(escape)) }
                        }
                    }
                }
                position = position + 2
                if continued && escape == '\r' { position = position + 1 }
                if position > end { position = end }
                if escape == '\n' || continued { line = line + 1; lineStart = position }
                chunkStart = position
            } else {
                if multiline && character == '\r' && position + 1 < end && source[position + 1] == '\n' {
                    if chunkStart < position { pieces.add(source.slice(chunkStart, position)) }
                    pieces.add(Text('\n'))
                    position = position + 2
                    line = line + 1
                    lineStart = position
                    chunkStart = position
                } else {
                    if character == '\n' { line = line + 1; lineStart = position + 1 }
                    position = position + 1
                }
            }
        }
    }
    if pieces.length == 0 { return source.slice(chunkStart, end) }
    if chunkStart < end { pieces.add(source.slice(chunkStart, end)) }
    return joinText(pieces)
}

function addTextPart(tokenKinds: List<Integer>, tokenTexts: List<Text>, coordinates: List<Integer>, parts: Bytes, start: Integer, end: Integer, line: Integer, lineStart: Integer) {
    parts.addInt64(tokenKinds.length)
    parts.addInt64(start)
    parts.addInt64(end)
    parts.addInt64(line)
    parts.addInt64(lineStart)
    addToken(tokenKinds, tokenTexts, coordinates, 3, "", line, start - lineStart + 1)
}

function tokenizeText(source: Text, sources: SourceMap, tokenKinds: List<Integer>, tokenTexts: List<Text>, coordinates: List<Integer>, cursor: Bytes, documentationLines: List<Integer>, documentationTexts: List<Text>) {
    let position = cursor.getInt64(0)
    let line = cursor.getInt64(8)
    let lineStart = cursor.getInt64(16)
    let tokenLine = line
    let tokenColumn = position - lineStart + 1
    let parts = Bytes(0)
    let interpolated = false
    let raw = source[position] == '#'
    if raw { position = position + 1 }
    let multiline = position + 2 < source.length && source[position + 1] == '"' && source[position + 2] == '"'
    position = position + 1
    if multiline {
        position = position + 2
        if position < source.length && source[position] == '\r' { position = position + 1 }
        if position >= source.length || source[position] != '\n' {
            failAtSource(sources, source, tokenLine, tokenColumn, "multi-line Text must begin on a new line after its opening delimiter")
        }
        position = position + 1
        line = line + 1
        lineStart = position
    }
    let bodyStart = position
    let chunkStart = position
    let chunkLine = line
    let chunkLineStart = lineStart
    while position < source.length && !textDelimiterAt(source, position, multiline, raw) {
        if !raw && source[position] == '\\' && position + 1 < source.length {
            let escape = source[position + 1]
            if escape == '(' {
                if !interpolated {
                    addToken(tokenKinds, tokenTexts, coordinates, 1, "text interpolation join", tokenLine, tokenColumn)
                    addToken(tokenKinds, tokenTexts, coordinates, 4, "(", tokenLine, tokenColumn)
                    addToken(tokenKinds, tokenTexts, coordinates, 4, "[", tokenLine, tokenColumn)
                    interpolated = true
                }
                addTextPart(tokenKinds, tokenTexts, coordinates, parts, chunkStart, position, chunkLine, chunkLineStart)
                addToken(tokenKinds, tokenTexts, coordinates, 4, ",", line, position - lineStart + 1)
                addToken(tokenKinds, tokenTexts, coordinates, 1, "text interpolation", line, position - lineStart + 1)
                addToken(tokenKinds, tokenTexts, coordinates, 4, "(", line, position - lineStart + 2)
                cursor.setInt64(0, position + 2)
                cursor.setInt64(8, line)
                cursor.setInt64(16, lineStart)
                tokenizePart(source, sources, tokenKinds, tokenTexts, coordinates, cursor, true, documentationLines, documentationTexts)
                position = cursor.getInt64(0)
                line = cursor.getInt64(8)
                lineStart = cursor.getInt64(16)
                addToken(tokenKinds, tokenTexts, coordinates, 4, ")", line, position - lineStart)
                addToken(tokenKinds, tokenTexts, coordinates, 4, ",", line, position - lineStart)
                chunkStart = position
                chunkLine = line
                chunkLineStart = lineStart
            } else {
                position = position + 2
                if escape == '\n' { line = line + 1; lineStart = position }
            }
        } else {
            if source[position] == '\n' { line = line + 1; lineStart = position + 1 }
            position = position + 1
        }
    }
    if position >= source.length {
        if raw { failAtSource(sources, source, tokenLine, tokenColumn, "raw Text is missing its closing delimiter") }
        if multiline { failAtSource(sources, source, tokenLine, tokenColumn, "multi-line Text is missing its closing delimiter") }
        failAtSource(sources, source, tokenLine, tokenColumn, "Text literal is missing its closing quote")
    }
    let contentEnd = position
    let indentation = 0
    if multiline {
        let scan = lineStart
        while scan < position && (source[scan] == ' ' || source[scan] == '\t') { scan = scan + 1 }
        if scan != position { failAtSource(sources, source, line, position - lineStart + 1, "the closing delimiter for multi-line Text must be on its own line") }
        indentation = position - lineStart
        contentEnd = lineStart
        if contentEnd > bodyStart {
            contentEnd = contentEnd - 1
            if contentEnd > bodyStart && source[contentEnd - 1] == '\r' { contentEnd = contentEnd - 1 }
        }
    }
    let finalEnd = contentEnd
    if finalEnd < chunkStart { finalEnd = chunkStart }
    addTextPart(tokenKinds, tokenTexts, coordinates, parts, chunkStart, finalEnd, chunkLine, chunkLineStart)
    let part = 0
    while part < parts.length {
        tokenTexts[parts.getInt64(part)] = decodeTextPart(source, sources, parts.getInt64(part + 8), parts.getInt64(part + 16), parts.getInt64(part + 24), parts.getInt64(part + 32), indentation, multiline, raw)
        part = part + 40
    }
    // Noninterpolated literals retain their opening-delimiter location.
    if !interpolated {
        coordinates[parts.getInt64(0) * 2] = tokenLine
        coordinates[parts.getInt64(0) * 2 + 1] = tokenColumn
    }
    let features = cursor.getInt64(24)
    let text = tokenTexts[parts.getInt64(0)]
    let previous = parts.getInt64(0) - 1
    if !interpolated {
        if features / 8 % 2 == 0 && text == "calldepth" && previous >= 0 && tokenKinds[previous] == 1 && tokenTexts[previous] == "native" { features = features + 8 }
        if features / 32 % 2 == 0 && (text == "c" || text == "c_packed" || registerLayoutWidth(text) > 0) && previous >= 2 && tokenTexts[previous] == "native" && tokenTexts[previous - 2] == "record" { features = features + 32 }
    }
    if interpolated {
        addToken(tokenKinds, tokenTexts, coordinates, 4, "]", line, position - lineStart + 1)
        addToken(tokenKinds, tokenTexts, coordinates, 4, ")", line, position - lineStart + 1)
    }
    position = position + 1
    if multiline { position = position + 2 }
    if raw { position = position + 1 }
    cursor.setInt64(0, position)
    cursor.setInt64(8, line)
    cursor.setInt64(16, lineStart)
    cursor.setInt64(24, features)
}

function tokenize(source: Text, tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap) {
    let cursor = Bytes(32)
    cursor.setInt64(8, 1)
    cursor.setInt64(24, tokenLines.features)
    let coordinates = tokenLines.coordinates
    let firstToken = tokenKinds.length
    let documentationLines: List<Integer> = []
    let documentationTexts: List<Text> = []
    tokenizePart(source, tokenLines, tokenKinds, tokenTexts, coordinates, cursor, false, documentationLines, documentationTexts)
    attachDocumentation(tokenKinds, tokenTexts, tokenLines, firstToken, documentationLines, documentationTexts)
    let features = cursor.getInt64(24)
    if tokenLines.features / 4096 % 2 == 0 && features / 4096 % 2 != 0 {
        let needed = false
        let scopeDepth = 0
        let position = 0
        while position < tokenKinds.length && !needed {
            if tokenKinds[position] == 1 && (tokenTexts[position] == "Maybe" || tokenTexts[position] == "Some" || tokenTexts[position] == "None") { needed = true }
            if scopeDepth == 0 && choiceDeclarationAt(tokenKinds, tokenTexts, position) { needed = true }
            if tokenKinds[position] == 4 && tokenTexts[position] == "{" { scopeDepth = scopeDepth + 1 }
            if tokenKinds[position] == 4 && tokenTexts[position] == "}" { scopeDepth = scopeDepth - 1 }
            position = position + 1
        }
        if !needed { features = features - 4096 }
    }
    tokenLines.features = features
}

function tokenizePart(source: Text, sources: SourceMap, tokenKinds: List<Integer>, tokenTexts: List<Text>, coordinates: List<Integer>, cursor: Bytes, interpolation: Boolean, documentationLines: List<Integer>, documentationTexts: List<Text>) {
    let firstToken = tokenKinds.length
    let modifiers = false
    let aliases = false
    let delimiterFrames = Bytes(0)
    let delimiterDepth = 0
    let features = cursor.getInt64(24)
    let callbacks = features % 2 != 0
    let position = cursor.getInt64(0)
    let line = cursor.getInt64(8)
    let lineStart = cursor.getInt64(16)
    let length = source.length
    let roundDepth = 0
    if interpolation { roundDepth = 1 }
    let squareDepth = 0
    if position == 0 && length > 0 && source[0] == Character(65279) {
        position = 1
    }

    while position < length {
        let character = source[position]
        if interpolation && character == ')' && roundDepth == 1 && delimiterDepth == 0 {
            cursor.setInt64(0, position + 1)
            cursor.setInt64(8, line)
            cursor.setInt64(16, lineStart)
            cursor.setInt64(24, features)
            return
        }

        if character == ' ' || character == '\n' || character == '\r' || character == '\t' {
            if character == '\n' {
                if roundDepth == 0 && squareDepth == 0 && lineCanEndStatement(tokenKinds, tokenTexts) {
                    addToken(tokenKinds, tokenTexts, coordinates, 6, "end of line", line, position - lineStart + 1)
                }
                line = line + 1
                lineStart = position + 1
            }
            position = position + 1
        } else {
            if character == '/' && position + 1 < length && source[position + 1] == '/' {
                let commentStart = position
                let leading = position + 2 < length && source[position + 2] == '/'
                if leading {
                    let before = lineStart
                    if before == 0 && source[0] == Character(65279) { before = 1 }
                    while before < position {
                        if source[before] != ' ' && source[before] != '\t' && source[before] != '\r' { leading = false }
                        before = before + 1
                    }
                }
                position = position + 2
                while position < length && source[position] != '\n' {
                    position = position + 1
                }
                if leading {
                    let start = commentStart + 3
                    if start < position && source[start] == ' ' { start = start + 1 }
                    let after = position
                    if after > start && source[after - 1] == '\r' { after = after - 1 }
                    documentationLines.add(line)
                    documentationTexts.add(source.slice(start, after))
                }
            } else {
                if character == '/' && position + 1 < length && source[position + 1] == '*' {
                    let commentLine = line
                    let commentColumn = position - lineStart + 1
                    position = position + 2
                    while position + 1 < length && !(source[position] == '*' && source[position + 1] == '/') {
                        if source[position] == '\n' {
                            line = line + 1
                            lineStart = position + 1
                        }
                        position = position + 1
                    }
                    if position + 1 >= length {
                        failAtSource(sources, source, commentLine, commentColumn, "block comment is missing its closing */")
                    }
                    position = position + 2
                } else {
                    if (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_' {
                        let start = position
                        let tokenLine = line
                        let tokenColumn = position - lineStart + 1
                        position = position + 1
                        let inName = true
                        while position < length && inName {
                            let next = source[position]
                            inName = (next >= 'a' && next <= 'z') || (next >= 'A' && next <= 'Z') || (next >= '0' && next <= '9') || next == '_'
                            if inName { position = position + 1 }
                        }
                        let name = source.slice(start, position)
                        if name == "type" || name == "capability" || name == "conform" { aliases = true }
                        if name == "parallel" || name == "interrupt" { modifiers = true }
                        if name == "function" && tokenKinds.length > firstToken {
                            let previous = tokenTexts[tokenTexts.length - 1]
                            if previous == "public" && tokenTexts.length > firstToken + 1 { previous = tokenTexts[tokenTexts.length - 2] }
                            if previous == "parallel" || previous == "thread" || previous == "interrupt" {
                                modifiers = true
                                if features / 16 % 2 == 0 { features = features + 16 }
                                if previous == "thread" && features / 4 % 2 == 0 { features = features + 4 }
                            }
                        }
                        if features / 4 % 2 == 0 && (character == 'f' || character == 'c' || character == 'b' || character == 't' || character == 's' || character == 'j' || character == 'r' || character == 'F' || character == 'B' || character == 'T') && threadFeatureName(name) { features = features + 4 }
                        if features / 2 % 2 == 0 && name.byteLength > 14 && name[0] == 'm' && resultPrefix(name, "minyar_result_") { features = features + 2 }
                        if features / 4096 % 2 == 0 && (name == "choice" || name == "Maybe" || name == "Some" || name == "None") { features = features + 4096 }
                        if features / 256 % 2 == 0 && ((tokenTexts.length > firstToken && tokenTexts[tokenTexts.length - 1] == "." && (name == "map" || name == "filter" || name == "fold")) || resultPrefix(name, "minyar_sequence_")) { features = features + 256 }
                        addToken(tokenKinds, tokenTexts, coordinates, 1, name, tokenLine, tokenColumn)
                    } else {
                        if character >= '0' && character <= '9' {
                            let start = position
                            let tokenLine = line
                            let tokenColumn = position - lineStart + 1
                            while position < length && characterIsDigit(source[position]) {
                                position = position + 1
                            }
                            let numberKind = 2
                            let hexValue = -1
                            let hexMinimum = false
                            if character == '0' && position == start + 1 && position + 1 < length && source[position] == 'b' && characterIsDigit(source[position + 1]) {
                                failAtSource(sources, source, tokenLine, tokenColumn, "binary Integer literals are not supported; use decimal digits, 0xFF for hexadecimal, or 0o755 for octal")
                            }
                            let octal = character == '0' && position == start + 1 && position < length && source[position] == 'o'
                            if octal {
                                position = position + 1
                                if position >= length || source[position] < '0' || source[position] > '7' {
                                    failAtSource(sources, source, tokenLine, tokenColumn, "an octal Integer literal needs only digits 0 through 7 after 0o")
                                }
                                hexValue = 0
                                while position < length && source[position] >= '0' && source[position] <= '7' {
                                    let digit = Integer(source[position]) - Integer('0')
                                    if hexValue > (9223372036854775807 - digit) / 8 {
                                        if hexValue == 1152921504606846976 && digit == 0 && (position + 1 == length || source[position + 1] < '0' || source[position + 1] > '7') {
                                            hexMinimum = true
                                        } else {
                                            failAtSource(sources, source, tokenLine, tokenColumn, "Integer literal is outside the supported range")
                                        }
                                    }
                                    if !hexMinimum { hexValue = hexValue * 8 + digit }
                                    position = position + 1
                                }
                                if position < length && (characterIsLetter(source[position]) || characterIsDigit(source[position]) || source[position] == '_') {
                                    failAtSource(sources, source, tokenLine, tokenColumn, "an octal Integer literal needs only digits 0 through 7 after 0o")
                                }
                            }
                            if character == '0' && position == start + 1 && position + 1 < length && source[position] == 'x' && characterIsHexDigit(source[position + 1]) {
                                position = position + 1
                                hexValue = 0
                                while position < length && characterIsHexDigit(source[position]) {
                                    let digit = hexDigitValue(source[position])
                                    if hexValue > (9223372036854775807 - digit) / 16 {
                                        if hexValue == 576460752303423488 && digit == 0 && (position + 1 == length || !characterIsHexDigit(source[position + 1])) {
                                            hexMinimum = true
                                        } else {
                                            failAtSource(sources, source, tokenLine, tokenColumn, "Integer literal is outside the supported range")
                                        }
                                    }
                                    if !hexMinimum { hexValue = hexValue * 16 + digit }
                                    position = position + 1
                                }
                            }
                            if hexValue >= 0 && position + 1 < length && source[position] == '.' && characterIsDigit(source[position + 1]) {
                                if octal { failAtSource(sources, source, tokenLine, tokenColumn, "octal literals are Integers and cannot have a decimal point") }
                                failAtSource(sources, source, tokenLine, tokenColumn, "hexadecimal literals are Integers and cannot have a decimal point")
                            }
                            if numberKind == 2 && position + 1 < length && source[position] == '.' && characterIsDigit(source[position + 1]) {
                                numberKind = 7
                                position = position + 1
                                while position < length && characterIsDigit(source[position]) {
                                    position = position + 1
                                }
                                if position < length && (source[position] == 'e' || source[position] == 'E') {
                                    position = position + 1
                                    if position < length && (source[position] == '+' || source[position] == '-') {
                                        position = position + 1
                                    }
                                    if position >= length || !characterIsDigit(source[position]) {
                                        failAtSource(sources, source, tokenLine, tokenColumn, "a Float exponent needs digits, as in 1.5e3")
                                    }
                                    while position < length && characterIsDigit(source[position]) {
                                        position = position + 1
                                    }
                                }
                            }
                            if position < length && source[position] == '_' {
                                failAtSource(sources, source, tokenLine, tokenColumn, "number separators are not supported; remove '_' from this number")
                            }
                            let digits = source.slice(start, position)
                            if numberKind == 2 && hexValue < 0 && character == '0' && position > start + 1 {
                                failAtSource(sources, source, tokenLine, tokenColumn, "decimal Integer literals cannot have a leading zero; use 0o for octal")
                            }
                            if hexValue >= 0 {
                                if hexMinimum { digits = "9223372036854775808" } else { digits = Text(hexValue) }
                            }
                            addToken(tokenKinds, tokenTexts, coordinates, numberKind, digits, tokenLine, tokenColumn)
                        } else {
                            if character == '"' || (character == '#' && position + 1 < length && source[position + 1] == '"') {
                                let plain = character == '"' && !(position + 2 < length && source[position + 1] == '"' && source[position + 2] == '"')
                                let end = position + 1
                                let endLine = line
                                let endLineStart = lineStart
                                while plain && end < length && source[end] != '"' && source[end] != '\\' {
                                    if source[end] == '\n' { endLine = endLine + 1; endLineStart = end + 1 }
                                    end = end + 1
                                }
                                if plain && end < length && source[end] == '"' {
                                    let text = source.slice(position + 1, end)
                                    if features / 8 % 2 == 0 && text == "calldepth" && tokenKinds.length > 0 && tokenKinds[tokenKinds.length - 1] == 1 && tokenTexts[tokenTexts.length - 1] == "native" { features = features + 8 }
                                    if features / 32 % 2 == 0 && (text == "c" || text == "c_packed" || registerLayoutWidth(text) > 0) && tokenKinds.length > 2 && tokenTexts[tokenTexts.length - 1] == "native" && tokenTexts[tokenTexts.length - 3] == "record" { features = features + 32 }
                                    addToken(tokenKinds, tokenTexts, coordinates, 3, text, line, position - lineStart + 1)
                                    position = end + 1
                                    line = endLine
                                    lineStart = endLineStart
                                } else {
                                    cursor.setInt64(0, position)
                                    cursor.setInt64(8, line)
                                    cursor.setInt64(16, lineStart)
                                    cursor.setInt64(24, features)
                                    tokenizeText(source, sources, tokenKinds, tokenTexts, coordinates, cursor, documentationLines, documentationTexts)
                                    features = cursor.getInt64(24)
                                    callbacks = features % 2 != 0
                                    position = cursor.getInt64(0)
                                    line = cursor.getInt64(8)
                                    lineStart = cursor.getInt64(16)
                                }
                            } else {
                                if character > '~' {
                                    failAtSource(sources, source, line, position - lineStart + 1, "names must use ASCII letters, digits, and '_'; found non-ASCII character '" + Text(character) + "'")
                                }
                                if character == '\'' {
                                    let tokenLine = line
                                    let tokenColumn = position - lineStart + 1
                                    position = position + 1
                                    if position >= length {
                                        failAtSource(sources, source, tokenLine, tokenColumn, "Character literal is missing its value and closing quote")
                                    }
                                    let value = source[position]
                                    if value == '\\' {
                                        position = position + 1
                                        if position >= length {
                                            failAtSource(sources, source, tokenLine, tokenColumn, "Character literal has an unfinished escape")
                                        }
                                        let escape = source[position]
                                        if escape == 'n' {
                                            value = '\n'
                                        } else {
                                            if escape == 'r' {
                                                value = '\r'
                                            } else {
                                                if escape == 't' {
                                                    value = '\t'
                                                } else {
                                                    value = escape
                                                }
                                            }
                                        }
                                    }
                                    if source[position] == '\n' {
                                        line = line + 1
                                        lineStart = position + 1
                                    }
                                    position = position + 1
                                    if position >= length || source[position] != '\'' {
                                        failAtSource(sources, source, tokenLine, tokenColumn, "Character literal must contain exactly one character and a closing quote")
                                    }
                                    position = position + 1
                                    addToken(tokenKinds, tokenTexts, coordinates, 5, Text(value), tokenLine, tokenColumn)
                                } else {
                                    let punctuationColumn = position - lineStart + 1
                                    let punctuation = Text(character)
                                    if position + 1 < length {
                                        let next = source[position + 1]
                                        let doubled = false
                                        if next == '=' {
                                            doubled = character == '=' || character == '!' || character == '<' || character == '>' || character == '+' || character == '-' || character == '*' || character == '/' || character == '%'
                                        } else {
                                            doubled = (character == '&' && next == '&') || (character == '|' && next == '|') || (character == '<' && next == '<') || (character == '>' && next == '>') || (character == '.' && next == '.') || (character == '-' && next == '>')
                                        }
                                        if doubled {
                                            punctuation = punctuation + Text(next)
                                            position = position + 1
                                        }
                                    }
                                    let punctuationKind = 4
                                    if punctuation == "->" {
                                        if !callbacks { callbacks = true; features = features + 1 }
                                        if features / 64 % 2 == 0 { features = features + 64 }
                                    }
                                    if (punctuation == "(" || punctuation == "<") && tokenKinds.length > 0 && tokenKinds[tokenKinds.length - 1] == 1 {
                                        let previous = tokenTexts[tokenTexts.length - 1]
                                        if features / 256 % 2 == 0 && punctuation == "<" && tokenTexts.length >= 2 && (tokenTexts[tokenTexts.length - 2] == "function" || tokenTexts[tokenTexts.length - 2] == "record" || tokenTexts[tokenTexts.length - 2] == "choice") { features = features + 256 }
                                        if !callbacks && ((punctuation == "(" && previous == "function") || (punctuation == "<" && previous == "Callback")) {
                                            callbacks = true
                                            features = features + 1
                                        }
                                        if features / 2 % 2 == 0 && punctuation == "<" && (previous == "Result" || previous == "Ok" || previous == "Err") { features = features + 2 }
                                    }
                                    if callbacks && punctuation == "{" {
                                        while delimiterFrames.length < delimiterDepth * 16 + 16 { delimiterFrames.addInt64(0) }
                                        delimiterFrames.setInt64(delimiterDepth * 16, roundDepth)
                                        delimiterFrames.setInt64(delimiterDepth * 16 + 8, squareDepth)
                                        delimiterDepth = delimiterDepth + 1
                                        roundDepth = 0
                                        squareDepth = 0
                                    }
                                    if callbacks && punctuation == "}" && delimiterDepth > 0 {
                                        delimiterDepth = delimiterDepth - 1
                                        roundDepth = delimiterFrames.getInt64(delimiterDepth * 16)
                                        squareDepth = delimiterFrames.getInt64(delimiterDepth * 16 + 8)
                                    }
                                    if punctuation == "(" { roundDepth = roundDepth + 1 }
                                    if punctuation == ")" && roundDepth > 0 { roundDepth = roundDepth - 1 }
                                    if punctuation == "[" { squareDepth = squareDepth + 1 }
                                    if punctuation == "]" && squareDepth > 0 { squareDepth = squareDepth - 1 }
                                    if punctuation == ";" {
                                        punctuationKind = 6
                                    }
                                    addToken(tokenKinds, tokenTexts, coordinates, punctuationKind, punctuation, line, punctuationColumn)
                                    position = position + 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if interpolation {
        failAtSource(sources, source, cursor.getInt64(8), cursor.getInt64(0) - cursor.getInt64(16), "text interpolation is missing its closing ')'")
    }
    addToken(tokenKinds, tokenTexts, coordinates, 0, "", line, position - lineStart + 1)
    let scan = firstToken
    while (modifiers || aliases) && scan + 1 < tokenKinds.length {
        if features / 256 % 2 == 0 && scan + 2 < tokenKinds.length && tokenKinds[scan] == 1 && tokenTexts[scan] == "type" && tokenKinds[scan + 1] == 1 && tokenKinds[scan + 2] == 4 && (tokenTexts[scan + 2] == "=" || tokenTexts[scan + 2] == "<") { features = features + 256 }
        if features / 256 % 2 == 0 && (capabilityDeclarationAt(tokenKinds, tokenTexts, scan) || conformanceToAt(tokenKinds, tokenTexts, scan) >= 0) { features = features + 256 }
        if parallelForAt(tokenKinds, tokenTexts, scan) && features / 16 % 2 == 0 { features = features + 16 }
        if scan + 2 < tokenKinds.length && tokenKinds[scan] == 1 && tokenTexts[scan] == "public" && tokenKinds[scan + 1] == 1 && (tokenTexts[scan + 1] == "parallel" || tokenTexts[scan + 1] == "thread" || tokenTexts[scan + 1] == "interrupt") && tokenKinds[scan + 2] == 1 && tokenTexts[scan + 2] == "function" {
            tokenKinds[scan] = 6
            tokenTexts[scan] = tokenTexts[scan + 1]
            tokenTexts[scan + 1] = "public"
        }
        if tokenKinds[scan] == 1 && (tokenTexts[scan] == "parallel" || tokenTexts[scan] == "thread" || tokenTexts[scan] == "interrupt") && tokenKinds[scan + 1] == 1 && (tokenTexts[scan + 1] == "function" || (scan + 2 < tokenKinds.length && tokenTexts[scan + 1] == "public" && tokenTexts[scan + 2] == "function")) {
            tokenKinds[scan] = 6
        }
        scan = scan + 1
    }
    cursor.setInt64(24, features)
}

function describeLocation(location: Text): Text {
    if location.length > 0 && location[0] >= '0' && location[0] <= '9' {
        return "line " + location
    }
    return location
}

function escapeLLVMText(text: Text): Text {
    let pieces: List<Text> = []
    let chunkStart = 0
    let changed = false
    let position = 0
    while position < text.length {
        let character = text[position]
        let replacement = ""
        if character == '\n' {
            replacement = "\\0A"
        } else {
            if character == '\r' {
                replacement = "\\0D"
            } else {
                if character == '\t' {
                    replacement = "\\09"
                } else {
                    if character == '"' {
                        replacement = "\\22"
                    } else {
                        if character == '\\' {
                            replacement = "\\5C"
                        }
                    }
                }
            }
        }
        if replacement != "" {
            if chunkStart < position {
                pieces.add(text.slice(chunkStart, position))
            }
            pieces.add(replacement)
            changed = true
            chunkStart = position + 1
        }
        position = position + 1
    }
    if !changed {
        return text
    }
    if chunkStart < position {
        pieces.add(text.slice(chunkStart, position))
    }
    return joinText(pieces)
}

function tokenIs(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: List<Integer>, expected: Text): Boolean {
    let kind = tokenKinds[cursor[0]]
    return kind != 2 && kind != 3 && kind != 5 && kind != 7 && tokenTexts[cursor[0]] == expected
}

function expectToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>, expected: Text) {
    if !tokenIs(tokenKinds, tokenTexts, cursor, expected) {
        failAtToken(tokenLines, cursor[0], "expected '" + expected + "', found '" + tokenTexts[cursor[0]] + "'")
    }
    cursor[0] = cursor[0] + 1
}

function skipTerminators(tokenKinds: List<Integer>, cursor: List<Integer>) {
    while tokenKinds[cursor[0]] == 6 {
        cursor[0] = cursor[0] + 1
    }
}

function finishStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, cursor: List<Integer>) {
    if tokenKinds[cursor[0]] == 6 {
        skipTerminators(tokenKinds, cursor)
    } else {
        if tokenKinds[cursor[0]] != 0 && !tokenIs(tokenKinds, tokenTexts, cursor, "}") {
            failAtToken(tokenLines, cursor[0], "unexpected '" + tokenTexts[cursor[0]] + "'; start the next statement on a new line")
        }
    }
}
