function isNativeType(type: Integer): Boolean {
    return type == 1 || type == 2 || type == 3 || type == 4 || type == 7 || type == 8
}

function nativeType(type: Integer): Text {
    if type == 4 {
        return "i1 zeroext"
    }
    return llvmType(type)
}

// `native "library"` is the whole body of a standard library function. It
// forwards the parameters to the C function minyar_<library>_<name>, which
// borrows Text and Bytes arguments and returns owned references. The marker
// comment lets compileTokens declare the symbol and name the library to link.
function compileNative(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, returnType: Integer) {
    let location = state[0]
    let name = textState[1]
    if name == "top level" || name == "main" {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": native can only provide the body of a library function")
    }
    let library = tokenTexts[state[0] + 1]
    let after: List<Integer> = []
    after.add(state[0] + 2)
    skipTerminators(tokenKinds, after)
    if state[0] != state[12] || !tokenIs(tokenKinds, tokenTexts, after, "}") {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": native must be the only statement in its function")
    }
    let letter = 0
    let validLibrary = library.length > 0
    while letter < library.length {
        let character = library[letter]
        if !characterIsLetter(character) && !characterIsDigit(character) && character != '_' {
            validLibrary = false
        }
        letter = letter + 1
    }
    if !validLibrary {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": native library names must use ASCII letters, digits, and '_'")
    }
    state[0] = state[0] + 2
    let function = findFunction(functionNames, symbolKinds, functionReturnTypes, name)
    let count = functionParameterCounts[function]
    if state[3] != count {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": native must be the only statement in its function")
    }
    if library == "integer_overflow" {
        // Only the scalar flag crosses this boundary. The errors library owns
        // its private Result fields and constructs success/failure values.
        let operation = ""
        let intrinsicName = readableDeclarationName(name)
        if intrinsicName == "addOverflows" { operation = "sadd" }
        if intrinsicName == "subtractOverflows" { operation = "ssub" }
        if intrinsicName == "multiplyOverflows" { operation = "smul" }
        if operation == "" {
            fail(describeLocation(tokenLocation(tokenLines, location)) + ": the integer_overflow package has no intrinsic named '" + intrinsicName + "'")
        }
        if count != 2 || localTypes[0] != 1 || localTypes[1] != 1 || returnType != 4 {
            fail(describeLocation(tokenLocation(tokenLines, location)) + ": integer_overflow expects two Integer parameters and a Boolean return")
        }
        output.add("  %integer.overflow.pair = call { i64, i1 } @llvm." + operation + ".with.overflow.i64(i64 %argument.0, i64 %argument.1)\n")
        output.add("  %integer.overflow.flag = extractvalue { i64, i1 } %integer.overflow.pair, 1\n")
        output.add("  call void @minyar_rc_leave()\n")
        output.add("  call void @minyar_stack_leave()\n")
        output.add("  ret i1 %integer.overflow.flag\n")
        return
    }
    if library == "machine" || library == "machine_arm64" {
        let intrinsic = ""
        if library == "machine" {
            intrinsic = machineIntrinsic(readableDeclarationName(name))
        } else {
            intrinsic = machineIntrinsicArm64(readableDeclarationName(name))
        }
        if intrinsic == "" {
            fail(describeLocation(tokenLocation(tokenLines, location)) + ": the machine package has no intrinsic named '" + readableDeclarationName(name) + "'")
        }
        let split = findCharacter(intrinsic, '\n') + 1
        if intrinsic[2] == ';' {
            // A declaration marker must be its own piece for appendNativeDeclarations.
            output.add(intrinsic.slice(0, split))
            output.add(intrinsic.slice(split, intrinsic.length))
        } else {
            output.add(intrinsic)
        }
        return
    }
    let callee = "minyar_" + library + "_" + readableDeclarationName(name)
    let signature = ""
    let arguments = ""
    let parameter = 0
    while parameter < count {
        let type = localTypes[parameter]
        if !isNativeType(type) {
            fail(describeLocation(tokenLocation(tokenLines, location)) + ": native functions accept Integer, Float, Boolean, Character, Text, and Bytes, not " + describeType(type))
        }
        if parameter > 0 {
            signature = signature + ", "
            arguments = arguments + ", "
        }
        signature = signature + nativeType(type)
        arguments = arguments + nativeType(type) + " %argument." + Text(parameter)
        parameter = parameter + 1
    }
    if returnType != 5 && !isNativeType(returnType) {
        fail(describeLocation(tokenLocation(tokenLines, location)) + ": native functions return Nothing, Integer, Float, Boolean, Character, Text, or Bytes")
    }
    let result = llvmType(returnType)
    if returnType == 4 {
        result = "zeroext i1"
    }
    output.add("  ; minyar-native: " + library + "|declare " + result + " @" + callee + "(" + signature + ")\n")
    if returnType == 5 {
        output.add("  call void @" + callee + "(" + arguments + ")\n")
    } else {
        output.add("  %native.result = call " + result + " @" + callee + "(" + arguments + ")\n")
    }
    output.add("  call void @minyar_rc_leave()\n")
    output.add("  call void @minyar_stack_leave()\n")
    if returnType == 5 {
        output.add("  ret void\n")
    } else {
        output.add("  ret " + llvmType(returnType) + " %native.result\n")
    }
}

// The `machine` package gives freestanding programs direct access to memory,
// I/O ports and the processor. Its functions compile to these inline bodies,
// with no runtime prologue. Raw hosted syscalls call the shared runtime helper.
// Arguments arrive as %argument.N; Integers are i64 and Bytes are pointers.
function machineIntrinsic(name: Text): Text {
    if name == "syscall" {
        let declaration = "  ; minyar-native: machine|declare i64 @minyar_machine_syscall(i64, i64, i64, i64, i64, i64, i64)\n"
        return declaration + "  %value = call i64 @minyar_machine_syscall(i64 %argument.0, i64 %argument.1, i64 %argument.2, i64 %argument.3, i64 %argument.4, i64 %argument.5, i64 %argument.6)\n  ret i64 %value\n"
    }
    let result = machineMemoryIntrinsic(name, "8")
    if result == "" { result = machineMemoryIntrinsic(name, "16") }
    if result == "" { result = machineMemoryIntrinsic(name, "32") }
    if result == "" { result = machineMemoryIntrinsic(name, "64") }
    if result == "" { result = machinePortIntrinsic(name, "8", "al", "b") }
    if result == "" { result = machinePortIntrinsic(name, "16", "ax", "w") }
    if result == "" { result = machinePortIntrinsic(name, "32", "eax", "l") }
    if result == "" { result = machineInstruction(name, "pause", "pause") }
    if result == "" { result = machineInstruction(name, "halt", "hlt") }
    if result == "" { result = machineInstruction(name, "enableInterrupts", "sti") }
    if result == "" { result = machineInstruction(name, "disableInterrupts", "cli") }
    if result == "" { result = machineInstruction(name, "waitForInterrupt", "sti; hlt") }
    if result != "" { return result }
    let pointer = "  %address = inttoptr i64 %argument.0 to ptr\n"
    let clobbers = "~{dirflag},~{fpsr},~{flags}"
    if name == "fill8" {
        let declaration = "  ; minyar-native: machine|declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n"
        return declaration + pointer + "  %byte = trunc i64 %argument.2 to i8\n  call void @llvm.memset.p0.i64(ptr %address, i8 %byte, i64 %argument.1, i1 false)\n  ret void\n"
    }
    if name == "fill32" {
        let head = pointer + "  %word = trunc i64 %argument.2 to i32\n  %any = icmp sgt i64 %argument.1, 0\n  br i1 %any, label %fill, label %done\n"
        let loop = "fill:\n  %index = phi i64 [ 0, %entry ], [ %next, %fill ]\n  %slot = getelementptr i32, ptr %address, i64 %index\n"
        let tail = "  store i32 %word, ptr %slot, align 4\n  %next = add nuw nsw i64 %index, 1\n  %more = icmp slt i64 %next, %argument.1\n  br i1 %more, label %fill, label %done\ndone:\n  ret void\n"
        return head + loop + tail
    }
    if name == "copy" {
        let declaration = "  ; minyar-native: machine|declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)\n"
        let pointers = "  %destination = inttoptr i64 %argument.0 to ptr\n  %source = inttoptr i64 %argument.1 to ptr\n"
        return declaration + pointers + "  call void @llvm.memmove.p0.p0.i64(ptr %destination, ptr %source, i64 %argument.2, i1 false)\n  ret void\n"
    }
    if name == "address" {
        return "  %storage = load ptr, ptr %argument.0, align 8\n  %value = ptrtoint ptr %storage to i64\n  ret i64 %value\n"
    }
    if name == "fence" {
        return "  fence seq_cst\n  ret void\n"
    }
    if name == "timestamp" {
        return "  %value = call i64 asm sideeffect \"rdtsc; shlq $$32, %rdx; orq %rdx, %rax\", \"={rax},~{rdx}," + clobbers + "\"()\n  ret i64 %value\n"
    }
    if name == "loadInterruptTable" {
        let descriptor = "  %descriptor = alloca [16 x i8], align 8\n  %limit = trunc i64 %argument.1 to i16\n  store i16 %limit, ptr %descriptor, align 8\n"
        let base = "  %base = getelementptr i8, ptr %descriptor, i64 2\n  store i64 %argument.0, ptr %base, align 1\n"
        return descriptor + base + "  call void asm sideeffect \"lidt ($0)\", \"r,~{memory}," + clobbers + "\"(ptr %descriptor)\n  ret void\n"
    }
    if name == "interruptHandler" || name == "interruptCount" {
        let table = "minyar_interrupt_handlers"
        let load = "load i64"
        if name == "interruptCount" {
            table = "minyar_interrupt_counts"
            load = "load volatile i64"
        }
        let address = "  %table = call ptr asm \"leaq " + table + "(%rip), $0\", \"=r\"()\n  %slot = getelementptr i64, ptr %table, i64 %argument.0\n"
        return address + "  %value = " + load + ", ptr %slot, align 8\n  ret i64 %value\n"
    }
    if name == "blendSpan" {
        return machineBlendSpan()
    }
    if name == "blendMask" {
        return machineBlendMask()
    }
    if name == "coverage" {
        return machineCoverage()
    }
    if name == "atomicAdd" {
        return pointer + "  %old = atomicrmw add ptr %address, i64 %argument.1 seq_cst, align 8\n  ret i64 %old\n"
    }
    if name == "callEntry" {
        return "  %target = inttoptr i64 %argument.0 to ptr\n  call void %target(i64 %argument.1, i64 %argument.2)\n  ret void\n"
    }
    if name == "symbol" {
        let address = "  %table = call ptr asm \"leaq minyar_machine_symbols(%rip), $0\", \"=r\"()\n  %slot = getelementptr i64, ptr %table, i64 %argument.0\n"
        return address + "  %value = load i64, ptr %slot, align 8\n  ret i64 %value\n"
    }
    if name == "jump" {
        return "  %target = inttoptr i64 %argument.0 to ptr\n  call void %target(i64 %argument.1)\n  ret void\n"
    }
    if name == "hypervisorCall" {
        let inputs = "  %magic = add i32 1447909480, 0\n  %parameter = trunc i64 %argument.1 to i32\n  %command = trunc i64 %argument.0 to i32\n"
        let constraints = "\"={eax},={ebx},={ecx},={edx},{eax},{ebx},{ecx},{edx},~{memory}," + clobbers + "\""
        let call = "  %registers = call { i32, i32, i32, i32 } asm sideeffect \"inl %dx, %eax\", " + constraints + "(i32 %magic, i32 %parameter, i32 %command, i32 22104)\n"
        let stores = storeRegister(0) + storeRegister(1) + storeRegister(2) + storeRegister(3)
        return inputs + call + "  %results = inttoptr i64 %argument.2 to ptr\n" + stores + "  ret void\n"
    }
    return ""
}

// The same package for 64-bit Arm (library/arch/arm64/machine.min). Memory,
// atomics and pixel loops are the portable bodies above; processor
// instructions are Arm's. I/O ports, the x86 interrupt table and the VMware
// hypervisor call do not exist there: they compile, so portable packages that
// offer them still build, but stop the processor if they are ever reached.
function machineIntrinsicArm64(name: Text): Text {
    let barrier = "~{memory}"
    if name == "pause" { return armInstruction("yield") }
    if name == "halt" { return armInstruction("wfi") }
    if name == "enableInterrupts" { return armInstruction("msr daifclr, #2") }
    if name == "disableInterrupts" { return armInstruction("msr daifset, #2") }
    // Wait with interrupts masked (a pending one still wakes the processor),
    // then unmask so its handler runs: like x86's `sti; hlt`.
    if name == "waitForInterrupt" { return armInstruction("wfi; msr daifclr, #2") }
    if name == "timestamp" {
        return "  %value = call i64 asm sideeffect \"isb; mrs $0, cntvct_el0\", \"=r," + barrier + "\"()\n  ret i64 %value\n"
    }
    if name == "timerFrequency" {
        return "  %value = call i64 asm \"mrs $0, cntfrq_el0\", \"=r\"()\n  ret i64 %value\n"
    }
    if name == "interruptCount" { return armTableLoad("minyar_interrupt_counts", "load volatile i64") }
    if name == "symbol" { return armTableLoad("minyar_machine_symbols", "load i64") }
    if name == "firmwareCall" {
        // SMCCC through HVC: function in x0, arguments in x1-x3, result in x0.
        let clobbers = "~{x4},~{x5},~{x6},~{x7},~{x8},~{x9},~{x10},~{x11},~{x12},~{x13},~{x14},~{x15},~{x16},~{x17},~{memory}"
        let call = "  %registers = call { i64, i64, i64, i64 } asm sideeffect \"hvc #0\", \"={x0},={x1},={x2},={x3},0,1,2,3," + clobbers + "\"(i64 %argument.0, i64 %argument.1, i64 %argument.2, i64 %argument.3)\n"
        return call + "  %value = extractvalue { i64, i64, i64, i64 } %registers, 0\n  ret i64 %value\n"
    }
    if name == "loadInterruptTable" || name == "interruptHandler" || name == "hypervisorCall" || armPortIntrinsic(name) {
        return "  ; minyar-native: machine|declare void @llvm.trap()\n  call void @llvm.trap()\n  unreachable\n"
    }
    if name == "syscall" || name == "jump" || name == "callEntry" || name == "atomicAdd" || name == "fence" || name == "address" || name == "copy" || name == "fill8" || name == "fill32" || name == "blendSpan" || name == "blendMask" || name == "coverage" {
        return machineIntrinsic(name)
    }
    let memory = machineMemoryIntrinsic(name, "8")
    if memory == "" { memory = machineMemoryIntrinsic(name, "16") }
    if memory == "" { memory = machineMemoryIntrinsic(name, "32") }
    if memory == "" { memory = machineMemoryIntrinsic(name, "64") }
    return memory
}

function armInstruction(instruction: Text): Text {
    return "  call void asm sideeffect \"" + instruction + "\", \"~{memory}\"()\n  ret void\n"
}

function armPortIntrinsic(name: Text): Boolean {
    return name == "in8" || name == "in16" || name == "in32" || name == "out8" || name == "out16" || name == "out32"
}

// A word of a table the boot code defines, such as the interrupt counts.
function armTableLoad(table: Text, load: Text): Text {
    let address = "  %table = call ptr asm \"adrp $0, " + table + "\\0A\\09add $0, $0, :lo12:" + table + "\", \"=r\"()\n"
    return address + "  %slot = getelementptr i64, ptr %table, i64 %argument.0\n  %value = " + load + ", ptr %slot, align 8\n  ret i64 %value\n"
}

// Pixel blending loops, written without overflow checks so LLVM can
// vectorize them. Pixels are 0x00RRGGBB; red and blue blend in one 32-bit
// multiply and green in another, with opacities scaled to 0-256.
function blendPixel(pixel: Text, opacity: Text, colorRedBlue: Text, colorGreen: Text, out: Text): Text {
    let keep = "  %keep." + out + " = sub i32 256, " + opacity + "\n"
    let redBlue = "  %rb." + out + " = and i32 " + pixel + ", 16711935\n  %rbk." + out + " = mul i32 %rb." + out + ", %keep." + out + "\n"
    let redBlueColor = "  %rbc." + out + " = mul i32 " + colorRedBlue + ", " + opacity + "\n  %rbs." + out + " = add i32 %rbk." + out + ", %rbc." + out + "\n"
    let redBlueOut = "  %rbo." + out + " = lshr i32 %rbs." + out + ", 8\n  %rbm." + out + " = and i32 %rbo." + out + ", 16711935\n"
    let green = "  %g." + out + " = and i32 " + pixel + ", 65280\n  %gk." + out + " = mul i32 %g." + out + ", %keep." + out + "\n"
    let greenColor = "  %gc." + out + " = mul i32 " + colorGreen + ", " + opacity + "\n  %gs." + out + " = add i32 %gk." + out + ", %gc." + out + "\n"
    let greenOut = "  %go." + out + " = lshr i32 %gs." + out + ", 8\n  %gm." + out + " = and i32 %go." + out + ", 65280\n"
    return keep + redBlue + redBlueColor + redBlueOut + green + greenColor + greenOut + "  %" + out + " = or i32 %rbm." + out + ", %gm." + out + "\n"
}

// blendSpan(address, count, color, opacity): blend `count` pixels toward one
// color, opacity from 0 to 256.
function machineBlendSpan(): Text {
    let head = "  %base = inttoptr i64 %argument.0 to ptr\n  %color = trunc i64 %argument.2 to i32\n  %opacity = trunc i64 %argument.3 to i32\n"
    let colors = "  %crb = and i32 %color, 16711935\n  %cg = and i32 %color, 65280\n  %any = icmp sgt i64 %argument.1, 0\n  br i1 %any, label %blend, label %done\n"
    let loop = "blend:\n  %index = phi i64 [ 0, %entry ], [ %next, %blend ]\n  %slot = getelementptr i32, ptr %base, i64 %index\n  %pixel = load i32, ptr %slot, align 4\n"
    let tail = "  store i32 %result, ptr %slot, align 4\n  %next = add i64 %index, 1\n  %more = icmp slt i64 %next, %argument.1\n  br i1 %more, label %blend, label %done\ndone:\n  ret void\n"
    return head + colors + loop + blendPixel("%pixel", "%opacity", "%crb", "%cg", "result") + tail
}

// blendMask(address, count, mask, color, scale, bias, limit): blend `count`
// pixels toward `color`, each through the byte at the same place in `mask`:
// opacity = min(mask + bias, limit) * scale / 256, so a coverage mask uses
// bias 0 and limit 255, and scale 256 for full strength.
function machineBlendMask(): Text {
    let head = "  %base = inttoptr i64 %argument.0 to ptr\n  %mask = inttoptr i64 %argument.2 to ptr\n  %color = trunc i64 %argument.3 to i32\n"
    let parameters = "  %scale = trunc i64 %argument.4 to i32\n  %bias = trunc i64 %argument.5 to i32\n  %limit = trunc i64 %argument.6 to i32\n"
    let colors = "  %crb = and i32 %color, 16711935\n  %cg = and i32 %color, 65280\n  %any = icmp sgt i64 %argument.1, 0\n  br i1 %any, label %blend, label %done\n"
    let loop = "blend:\n  %index = phi i64 [ 0, %entry ], [ %next, %blend ]\n  %slot = getelementptr i32, ptr %base, i64 %index\n  %pixel = load i32, ptr %slot, align 4\n"
    let cover = "  %coverSlot = getelementptr i8, ptr %mask, i64 %index\n  %cover8 = load i8, ptr %coverSlot, align 1\n  %cover = zext i8 %cover8 to i32\n"
    let opacity = "  %biased = add i32 %cover, %bias\n  %capped = call i32 @llvm.umin.i32(i32 %biased, i32 %limit)\n  %scaled = mul i32 %capped, %scale\n  %raw = lshr i32 %scaled, 8\n  %round = lshr i32 %raw, 7\n  %opacity = add i32 %raw, %round\n"
    let tail = "  store i32 %result, ptr %slot, align 4\n  %next = add i64 %index, 1\n  %more = icmp slt i64 %next, %argument.1\n  br i1 %more, label %blend, label %done\ndone:\n  ret void\n"
    let declaration = "  ; minyar-native: machine|declare i32 @llvm.umin.i32(i32, i32)\n"
    return declaration + head + parameters + colors + loop + cover + opacity + blendPixel("%pixel", "%opacity", "%crb", "%cg", "result") + tail
}

// coverage(source, target, count): the running sum of `count` float32 signed
// areas at `source`, as coverage bytes 0-255 at `target` (the last step of
// filling an outline).
function machineCoverage(): Text {
    let head = "  %source = inttoptr i64 %argument.0 to ptr\n  %target = inttoptr i64 %argument.1 to ptr\n  %any = icmp sgt i64 %argument.2, 0\n  br i1 %any, label %cover, label %done\n"
    let loop = "cover:\n  %index = phi i64 [ 0, %entry ], [ %next, %cover ]\n  %sum = phi double [ 0.0, %entry ], [ %total, %cover ]\n"
    let add = "  %slot = getelementptr float, ptr %source, i64 %index\n  %narrow = load float, ptr %slot, align 4\n  %delta = fpext float %narrow to double\n  %total = fadd double %sum, %delta\n"
    let magnitude = "  %negated = fneg double %total\n  %below = fcmp olt double %total, 0.0\n  %magnitude = select i1 %below, double %negated, double %total\n"
    let scale = magnitude + "  %over = fcmp ogt double %magnitude, 1.0\n  %capped = select i1 %over, double 1.0, double %magnitude\n  %scaled = fmul double %capped, 255.0\n  %rounded = fadd double %scaled, 0.5\n  %byte = fptoui double %rounded to i8\n"
    let tail = "  %out = getelementptr i8, ptr %target, i64 %index\n  store i8 %byte, ptr %out, align 1\n  %next = add i64 %index, 1\n  %more = icmp slt i64 %next, %argument.2\n  br i1 %more, label %cover, label %done\ndone:\n  ret void\n"
    return head + loop + add + scale + tail
}

function machineMemoryIntrinsic(name: Text, width: Text): Text {
    let type = "i" + width
    let pointer = "  %address = inttoptr i64 %argument.0 to ptr\n"
    let extend = "  %value = zext " + type + " %loaded to i64\n"
    let narrow = "  %narrow = trunc i64 %argument.1 to " + type + "\n"
    if width == "64" {
        extend = "  %value = add i64 %loaded, 0\n"
        narrow = "  %narrow = add i64 %argument.1, 0\n"
    }
    if name == "load" + width {
        return pointer + "  %loaded = load " + type + ", ptr %address, align 1\n" + extend + "  ret i64 %value\n"
    }
    if name == "read" + width {
        return pointer + "  %loaded = load volatile " + type + ", ptr %address, align 1\n" + extend + "  ret i64 %value\n"
    }
    if name == "store" + width {
        return pointer + narrow + "  store " + type + " %narrow, ptr %address, align 1\n  ret void\n"
    }
    if name == "write" + width {
        return pointer + narrow + "  store volatile " + type + " %narrow, ptr %address, align 1\n  ret void\n"
    }
    return ""
}

function machinePortIntrinsic(name: Text, width: Text, register: Text, suffix: Text): Text {
    let type = "i" + width
    let clobbers = "~{dirflag},~{fpsr},~{flags}"
    if name == "in" + width {
        let call = "  %loaded = call " + type + " asm sideeffect \"in" + suffix + " $1, $0\", \"={" + register + "},{dx}," + clobbers + "\"(i16 %port)\n"
        return "  %port = trunc i64 %argument.0 to i16\n" + call + "  %value = zext " + type + " %loaded to i64\n  ret i64 %value\n"
    }
    if name == "out" + width {
        let values = "  %port = trunc i64 %argument.0 to i16\n  %narrow = trunc i64 %argument.1 to " + type + "\n"
        return values + "  call void asm sideeffect \"out" + suffix + " $0, $1\", \"{" + register + "},{dx}," + clobbers + "\"(" + type + " %narrow, i16 %port)\n  ret void\n"
    }
    return ""
}

function machineInstruction(name: Text, expected: Text, instruction: Text): Text {
    if name != expected { return "" }
    return "  call void asm sideeffect \"" + instruction + "\", \"~{memory},~{dirflag},~{fpsr},~{flags}\"()\n  ret void\n"
}

function storeRegister(index: Integer): Text {
    let number = Text(index)
    let extract = "  %register." + number + " = extractvalue { i32, i32, i32, i32 } %registers, " + number + "\n"
    let widen = "  %wide." + number + " = zext i32 %register." + number + " to i64\n"
    let slot = "  %slot." + number + " = getelementptr i64, ptr %results, i64 " + number + "\n"
    return extract + widen + slot + "  store i64 %wide." + number + ", ptr %slot." + number + ", align 8\n"
}

// A parallel function may run on any processor at the same time as others, so
// it must not touch the single-threaded runtime: no reference values, no
// call-depth or ownership frames, and calls only to other parallel functions,
// machine intrinsics, checked-arithmetic helpers and mathematics. Its frames
// are removed here; its calls are recorded for checkParallelCalls.
