// Token positions stay numeric until a diagnostic or persisted interface needs Text.
// Coordinates are full-width line/column pairs. Default source paths need no index.
record SourceMap {
    coordinates: List<Integer>
    paths: List<Text>
    origins: List<Text>
    pathIndices: List<Integer>
}

function newSourceMap(): SourceMap {
    let coordinates: List<Integer> = []
    let paths: List<Text> = []
    let origins: List<Text> = []
    let pathIndices: List<Integer> = []
    paths.add("")
    return SourceMap { coordinates: coordinates, paths: paths, origins: origins, pathIndices: pathIndices }
}

function sourcePath(locations: SourceMap, path: Text): Integer {
    let paths = locations.paths
    let index = findText(paths, path)
    if index < 0 {
        index = paths.length
        paths.add(path)
    }
    return index
}

function tokenPath(locations: SourceMap, position: Integer): Text {
    let indices = locations.pathIndices
    if position < indices.length { return locations.paths[indices[position]] }
    return locations.paths[0]
}

// A private record field is stored as its name, a space and the path of the
// module that declares it, so symbol tables and cached interfaces carry its
// visibility unchanged. Names never contain spaces.
function declaredFieldName(stored: Text): Text {
    let position = 0
    while position < stored.length {
        if stored[position] == ' ' { return stored.slice(0, position) }
        position = position + 1
    }
    return stored
}

function isFieldNamed(stored: Text, name: Text): Boolean {
    if stored == name { return true }
    return stored.length > name.length && stored[name.length] == ' ' && stored.slice(0, name.length) == name
}

// Only code in the declaring module may read, assign or initialize a private field.
function checkFieldAccess(locations: SourceMap, stored: Text, recordName: Text, position: Integer) {
    let name = declaredFieldName(stored)
    if stored.length > name.length && stored.slice(name.length + 1, stored.length) != tokenPath(locations, position) {
        fail(describeLocation(tokenLocation(locations, position)) + ": field '" + name + "' of record '" + readableDeclarationName(recordName) + "' is private to its module")
    }
}

function setTokenPath(locations: SourceMap, position: Integer, path: Integer) {
    let indices = locations.pathIndices
    if path != 0 || position < indices.length {
        while indices.length <= position { indices.add(0) }
        indices[position] = path
    }
}

function tokenLocation(locations: SourceMap, position: Integer): Text {
    let coordinates = locations.coordinates
    let line = coordinates[position * 2]
    let indices = locations.pathIndices
    let pathIndex = 0
    if position < indices.length { pathIndex = indices[position] }
    let path = locations.paths[pathIndex]
    if line == 0 { return path }
    let result = ""
    if line == -1 {
        result = locations.origins[position]
    } else {
        result = sourceLocation(line, coordinates[position * 2 + 1])
    }
    if path != "" { return path + ":" + result }
    return result
}

// Cached interface origins retain their existing wire format. Only summaries
// use this sparse override; normal source tokens allocate no origin strings.
function setTokenOrigin(locations: SourceMap, position: Integer, origin: Text) {
    let origins = locations.origins
    while origins.length <= position { origins.add("") }
    origins[position] = origin
    locations.coordinates[position * 2] = -1
}

function copyModuleToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, locations: SourceMap, kind: Integer, text: Text, source: SourceMap, position: Integer, origin: Integer) {
    let target = tokenKinds.length
    tokenKinds.add(kind)
    tokenTexts.add(text)
    let from = source.coordinates
    let to = locations.coordinates
    to.add(from[position * 2])
    to.add(from[position * 2 + 1])
    setTokenPath(locations, target, origin)
    if from[position * 2] == -1 { setTokenOrigin(locations, target, source.origins[position]) }
}

function addEndToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, locations: SourceMap, description: Text) {
    let target = tokenKinds.length
    tokenKinds.add(0)
    tokenTexts.add("")
    let coordinates = locations.coordinates
    coordinates.add(0)
    coordinates.add(0)
    setTokenPath(locations, target, sourcePath(locations, description))
}

