use "io" as io
use "process" as processInfo
record SourceMap {
    coordinates: List<Integer>
    paths: List<Text>
    origins: List<Text>
    pathIndices: List<Integer>
    symbolLookup: List<Integer>
    nominalTypes: List<Integer>
    inputPath: Text
    diagnosticPath: Text
    documentation: List<Text>
    features: Integer
    stage: Integer
    lastPath: Integer
    escapedPaths: List<Text>
}

function newSourceMap(): SourceMap {
    let coordinates: List<Integer> = []
    let paths: List<Text> = []
    let origins: List<Text> = []
    let pathIndices: List<Integer> = []
    let symbolLookup: List<Integer> = []
    let nominalTypes: List<Integer> = []
    let documentation: List<Text> = []
    let escapedPaths: List<Text> = []
    paths.add("")
    return SourceMap { coordinates: coordinates, paths: paths, origins: origins, pathIndices: pathIndices, symbolLookup: symbolLookup, nominalTypes: nominalTypes, inputPath: "", diagnosticPath: "", documentation: documentation, features: 0, stage: 0, lastPath: 0, escapedPaths: escapedPaths }
}

// Token passes copy long runs of tokens from one file, so the path found last
// usually matches again. Each path is stored once, so the index is the same.
function sourcePath(locations: SourceMap, path: Text): Integer {
    let paths = locations.paths
    let last = locations.lastPath
    if last < paths.length && paths[last] == path { return last }
    let index = findText(paths, path)
    if index < 0 {
        index = paths.length
        paths.add(path)
    }
    locations.lastPath = index
    return index
}

function tokenPath(locations: SourceMap, position: Integer): Text {
    let indices = locations.pathIndices
    if position < indices.length { return locations.paths[indices[position]] }
    return locations.paths[0]
}

function declaredFieldName(stored: Text): Text {
    let position = 0
    while position < stored.length {
        if stored[position] == ' ' { return stored.slice(0, position) }
        position = position + 1
    }
    return stored
}

function isFieldNamed(stored: Text, name: Text): Boolean {
    if stored == name { return true }
    return stored.length > name.length && stored[name.length] == ' ' && stored.slice(0, name.length) == name
}

function checkFieldAccess(locations: SourceMap, stored: Text, recordName: Text, position: Integer) {
    if resultPrefix(recordName, "minyar_result_type_") {
        failCompiler("Result payloads are only accessible through match or try")
    }
    let name = declaredFieldName(stored)
    if stored.length > name.length && stored.slice(name.length + 1, stored.length) != tokenPath(locations, position) {
        failCompiler(describeLocation(tokenLocation(locations, position)) + ": field '" + name + "' of record '" + readableDeclarationName(recordName) + "' is private to its module")
    }
}

function setTokenPath(locations: SourceMap, position: Integer, path: Integer) {
    let indices = locations.pathIndices
    if path != 0 || position < indices.length {
        while indices.length <= position { indices.add(0) }
        indices[position] = path
    }
}

// Preserve numeric origins in IR comments, without eagerly formatting diagnostic
// locations. The link driver turns these into DWARF only for debug builds.
function emitDebugOrigin(output: List<Text>, locations: SourceMap, position: Integer, kind: Text) {
    if position < 0 || position * 2 + 1 >= locations.coordinates.length { return }
    let line = locations.coordinates[position * 2]
    if line <= 0 { return }
    let path = 0
    if position < locations.pathIndices.length { path = locations.pathIndices[position] }
    output.add("; minyar-debug-\(kind): \(line)|\(locations.coordinates[position * 2 + 1])|\(escapedSourcePath(locations, path))\n")
}

// Every debug line names its file; escape each path once. Paths only grow.
function escapedSourcePath(locations: SourceMap, path: Integer): Text {
    let escaped = locations.escapedPaths
    while escaped.length < locations.paths.length { escaped.add(escapeLLVMText(locations.paths[escaped.length])) }
    return escaped[path]
}

function tokenLocation(locations: SourceMap, position: Integer): Text {
    let coordinates = locations.coordinates
    let line = coordinates[position * 2]
    let indices = locations.pathIndices
    let pathIndex = 0
    if position < indices.length { pathIndex = indices[position] }
    let path = locations.paths[pathIndex]
    if line == 0 { return path }
    let result = ""
    if line == -1 {
        result = locations.origins[position]
    } else {
        result = sourceLocation(line, coordinates[position * 2 + 1])
    }
    if path != "" { return path + ":" + result }
    return result
}

function setTokenOrigin(locations: SourceMap, position: Integer, origin: Text) {
    let origins = locations.origins
    while origins.length <= position { origins.add("") }
    origins[position] = origin
    locations.coordinates[position * 2] = -1
}

function copyModuleToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, locations: SourceMap, kind: Integer, text: Text, source: SourceMap, position: Integer, origin: Integer) {
    if locations.inputPath.byteLength == 0 { locations.inputPath = source.inputPath }
    let target = tokenKinds.length
    tokenKinds.add(kind)
    tokenTexts.add(text)
    let documentation = source.documentation
    if position < documentation.length && documentation[position].byteLength > 0 { setTokenDocumentation(locations, target, documentation[position]) }
    let from = source.coordinates
    let to = locations.coordinates
    let line = from[position * 2]
    to.add(line)
    to.add(from[position * 2 + 1])
    if origin != 0 || target < locations.pathIndices.length { setTokenPath(locations, target, origin) }
    if line == -1 { setTokenOrigin(locations, target, source.origins[position]) }
}

// A token stage's Lists, aliased for the runtime's run copy. The field order is
// the ABI of compilerCopyTokens and compilerCopyPaths (runtime/minyar_diagnostics.h).
record TokenTables { kinds: List<Integer>; texts: List<Text>; coordinates: List<Integer>; paths: List<Integer>; documentation: List<Text>; origins: List<Text>; pathMap: List<Integer>; empty: Text }
function compilerCopyTokens(target: TokenTables, source: TokenTables, start: Integer, end: Integer) { native "runtime" }
function compilerCopyPaths(target: TokenTables, source: TokenTables, targetStart: Integer, start: Integer, end: Integer): Integer { native "runtime" }

// Two Integer Lists for the runtime's bulk List operations. The field order is
// the ABI of compilerAppendIntegers and compilerFillIntegers.
record CompilerIntegers { target: List<Integer>; source: List<Integer> }
function compilerAppendIntegers(lists: CompilerIntegers, start: Integer, end: Integer) { native "runtime" }
function compilerFillIntegers(lists: CompilerIntegers, count: Integer, value: Integer) { native "runtime" }

// Token passes copy most of their input unchanged. A pass advances over such
// a run and copies tokens [start, end) here when it reaches a rewrite or the
// end: the same stage copyModuleToken builds token by token with each token's
// own path, in a few runtime appends. keepPaths false drops the paths
// (copyModuleToken with origin 0).
function copyTokenRun(tokenKinds: List<Integer>, tokenTexts: List<Text>, locations: SourceMap, sourceKinds: List<Integer>, sourceTexts: List<Text>, source: SourceMap, start: Integer, end: Integer, keepPaths: Boolean) {
    if end <= start { return }
    if locations.inputPath == "" { locations.inputPath = source.inputPath }
    let target = tokenKinds.length
    let unused: List<Integer> = []
    let map: List<Integer> = []
    let into = TokenTables { kinds: tokenKinds; texts: tokenTexts; coordinates: locations.coordinates; paths: locations.pathIndices; documentation: locations.documentation; origins: locations.origins; pathMap: unused; empty: "" }
    let from = TokenTables { kinds: sourceKinds; texts: sourceTexts; coordinates: source.coordinates; paths: source.pathIndices; documentation: source.documentation; origins: source.origins; pathMap: map; empty: "" }
    compilerCopyTokens(into, from, start, end)
    if keepPaths && start < source.pathIndices.length {
        // Paths enter the stage in the order its tokens first use them.
        while map.length < source.paths.length { map.add(-1) }
        let next = start
        while next < end {
            next = compilerCopyPaths(into, from, target + next - start, next, end)
            if next < end { map[source.pathIndices[next]] = sourcePath(locations, source.paths[source.pathIndices[next]]) }
        }
    }
}

// Token passes copy the whole stream into a fresh stage and never read the
// previous one again. The compiler runs on an arena that never frees, so the
// owner of a superseded stage clears it: clear() returns large List storage.
// SourceMap.stage tells stages apart, since a pass with nothing to rewrite
// returns its input: 0 is a fresh stage, 1 belongs to a caller, 2 is owned.
// A caller hands its tokens over by marking them 2 before compileTokens.
function adoptTokenStage(kinds: List<Integer>, texts: List<Text>, lines: SourceMap, next: SourceMap) {
    if next.stage != 0 { return }
    next.stage = 2
    if lines.stage == 2 { releaseTokens(kinds, texts, lines) }
}

function releaseTokens(kinds: List<Integer>, texts: List<Text>, lines: SourceMap) {
    kinds.clear()
    texts.clear()
    lines.coordinates.clear()
    lines.origins.clear()
    lines.pathIndices.clear()
    lines.documentation.clear()
}

function addEndToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, locations: SourceMap, description: Text) {
    let target = tokenKinds.length
    tokenKinds.add(0)
    tokenTexts.add("")
    let coordinates = locations.coordinates
    coordinates.add(0)
    coordinates.add(0)
    setTokenPath(locations, target, sourcePath(locations, description))
}
