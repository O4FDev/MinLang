function appendLiteralDeclarations(output: List<Text>, tokenKinds: List<Integer>, tokenTexts: List<Text>, prefix: Text, threaded: Boolean) {
    let names = newGenericIndex()
    let contents: List<Text> = []
    let position = 0
    while position < tokenKinds.length {
        let literal = tokenTexts[position]
        let digest = ""
        if tokenKinds[position] == 3 { digest = genericInstanceDigest(literal) }
        if tokenKinds[position] == 3 && newConstantName(names, contents, digest, literal) {
            let data = "@" + literalName(prefix, digest, true)
            let value = "@" + literalName(prefix, digest, false)
            output.add(data)
            output.add(" = private unnamed_addr constant [")
            output.add(Text(literal.byteLength + 1))
            output.add(" x i8] c\"")
            output.add(escapeLLVMText(literal))
            output.add("\\00\"\n")
            if literal.length == literal.byteLength {
                output.add(value)
                output.add(" = private constant { i64, ptr, i64, i64, ptr, ptr } { i64 0, ptr ")
                output.add(data)
                output.add(", i64 ")
                output.add(Text(literal.byteLength))
                output.add(", i64 ")
                output.add(Text(literal.byteLength))
                output.add(", ptr null, ptr null }\n")
            } else {
                output.add(value)
                let storage = "global"
                if threaded { storage = "constant" }
                output.add(" = private " + storage + " { i64, ptr, i64, i64, ptr, ptr } { i64 0, ptr ")
                output.add(data)
                output.add(", i64 ")
                output.add(Text(literal.byteLength))
                output.add(", i64 -1, ptr null, ptr null }\n")
            }
        }
        position = position + 1
    }

}

// Inline Text length and Character reads, added to a module the first time
// it reads a Text's length or a Character (see declareTextReads).
function textReadHelpers(): Text {
    return "; Inline Text length and Character reads. ABI: { bytes, byte length, character
; length, character offsets, ... }. A negative character length means the
; runtime has not counted the Text yet; a counted Text without offsets is
; ASCII, so a character position is its byte position. Header and byte loads
; carry their own type tags: stores to record fields and List slots or headers
; cannot change them, so those stores force no reload. The runtime's own writes
; (counting, indexing) keep C tags, which alias every Minyar tag.
define internal i64 @.minyar.text.length(ptr %text) alwaysinline {
entry:
  %pointer = getelementptr inbounds { ptr, i64, i64, ptr }, ptr %text, i32 0, i32 2
  %length = load i64, ptr %pointer, !tbaa !{!{!\"minyar text header\", !{!\"minyar\"}, i64 0}, !{!\"minyar text header\", !{!\"minyar\"}, i64 0}, i64 0}
  %counted = icmp sgt i64 %length, -1
  br i1 %counted, label %good, label %count, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
good:
  ret i64 %length
count:
  %slow = call i64 @minyar_text_length(ptr %text)
  ret i64 %slow
}
define internal i32 @.minyar.text.character(ptr %text, i64 %position) alwaysinline {
entry:
  %length.pointer = getelementptr inbounds { ptr, i64, i64, ptr }, ptr %text, i32 0, i32 2
  %length = load i64, ptr %length.pointer, !tbaa !{!{!\"minyar text header\", !{!\"minyar\"}, i64 0}, !{!\"minyar text header\", !{!\"minyar\"}, i64 0}, i64 0}
  %offsets.pointer = getelementptr inbounds { ptr, i64, i64, ptr }, ptr %text, i32 0, i32 3
  %offsets = load ptr, ptr %offsets.pointer, !tbaa !{!{!\"minyar text header\", !{!\"minyar\"}, i64 0}, !{!\"minyar text header\", !{!\"minyar\"}, i64 0}, i64 0}
  %counted = icmp sgt i64 %length, -1
  %ascii = icmp eq ptr %offsets, null
  %inside = icmp ult i64 %position, %length
  %known = and i1 %counted, %ascii
  %fast = and i1 %known, %inside
  br i1 %fast, label %good, label %slow, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
good:
  %bytes = load ptr, ptr %text, !tbaa !{!{!\"minyar text header\", !{!\"minyar\"}, i64 0}, !{!\"minyar text header\", !{!\"minyar\"}, i64 0}, i64 0}
  %slot = getelementptr inbounds i8, ptr %bytes, i64 %position
  %byte = load i8, ptr %slot, !tbaa !{!{!\"minyar text byte\", !{!\"minyar\"}, i64 0}, !{!\"minyar text byte\", !{!\"minyar\"}, i64 0}, i64 0}
  %character = zext i8 %byte to i32
  ret i32 %character
slow:
  %other = call i32 @minyar_text_character_at(ptr %text, i64 %position)
  ret i32 %other
}
define internal i32 @.minyar.text.character.known(ptr %text, i64 %position, i64 %length, ptr %bytes) alwaysinline {
entry:
  %inside = icmp ult i64 %position, %length
  br i1 %inside, label %character, label %counted, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
character:
  %slot = getelementptr inbounds i8, ptr %bytes, i64 %position
  %byte = load i8, ptr %slot, !tbaa !{!{!\"minyar text byte\", !{!\"minyar\"}, i64 0}, !{!\"minyar text byte\", !{!\"minyar\"}, i64 0}, i64 0}
  %value = zext i8 %byte to i32
  ret i32 %value
counted:
  %other = call i32 @.minyar.text.character(ptr %text, i64 %position)
  ret i32 %other
}
"
}

function declareTextReads(globals: List<Text>) {
    let helpers = textReadHelpers()
    if findText(globals, helpers) < 0 { globals.add(helpers) }
}
