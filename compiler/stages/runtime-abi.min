    output.add("declare ptr @minyar_text_slice(ptr, i64, i64)\n")
    output.add("declare ptr @minyar_integer_text(i64)\n")
    output.add("declare ptr @minyar_character_text(i32)\n")
    output.add("declare ptr @minyar_boolean_text(i1 zeroext)\n")
    output.add("declare void @minyar_initialize_arguments(i32, ptr)\n")
    output.add("declare i64 @minyar_argument_count()\n")
    output.add("declare ptr @minyar_argument(i64)\n")
    output.add("declare ptr @minyar_read_text_file(ptr)\n")
    output.add("declare void @minyar_write_text_file(ptr, ptr)\n")
    output.add("declare void @minyar_write_text_parts(ptr, ptr)\n")
    output.add("declare ptr @minyar_list_new()\n")
    output.add("declare void @minyar_list_references(ptr)\n")
    output.add("declare void @minyar_list_add(ptr, i64)\n")
    output.add("declare void @minyar_list_append_scalars(ptr, ptr, i64)\n")
    output.add("declare void @minyar_list_add_take(ptr, i64)\n")
    output.add("declare i64 @minyar_list_length(ptr)\n")
    output.add("declare i64 @minyar_list_get(ptr, i64)\n")
    output.add("declare void @minyar_list_set(ptr, i64, i64)\n")
    output.add("declare void @minyar_list_set_take(ptr, i64, i64)\n")
    output.add("declare ptr @minyar_list_appended(ptr, i64, i64, i64)\n")
    output.add("declare ptr @minyar_list_appended_take(ptr, i64, i64, i64)\n")
    output.add("declare ptr @minyar_record_new(i64)\n")
    output.add("declare ptr @minyar_record_new_scalar(i64)\n")
    output.add("declare i64 @minyar_record_get(ptr, i64)\n")
    output.add("declare void @minyar_record_set(ptr, i64, i64)\n")
