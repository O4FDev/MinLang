function appendRuntimeHelpers(output: List<Text>) {
    output.add("
; Checked inline Bytes accesses. ABI prefix: { data pointer, byte length }.
; Visible length is nonnegative, including for shifted C-layout views.
define internal i64 @.minyar.bytes.length(ptr %bytes) alwaysinline {
entry:
  %length.pointer = getelementptr inbounds { ptr, i64 }, ptr %bytes, i32 0, i32 1
  %length = load i64, ptr %length.pointer, !range !{i64 0, i64 -9223372036854775808}
  ret i64 %length
}
define internal i64 @.minyar.bytes.get.checked(ptr %bytes, i64 %position) alwaysinline {
entry:
  %length = call i64 @.minyar.bytes.length(ptr %bytes)
  %get.valid = icmp ult i64 %position, %length
  br i1 %get.valid, label %good, label %bad
good:
  %data = load ptr, ptr %bytes
  %slot = getelementptr inbounds i8, ptr %data, i64 %position
  %byte = load i8, ptr %slot
  %value = zext i8 %byte to i64
  ret i64 %value
bad:
  %fallback = call i64 @minyar_bytes_get(ptr %bytes, i64 %position)
  ret i64 %fallback
}
define internal void @.minyar.bytes.set.checked(ptr %bytes, i64 %position, i64 %value) alwaysinline {
entry:
  %length = call i64 @.minyar.bytes.length(ptr %bytes)
  %position.valid = icmp ult i64 %position, %length
  %value.valid = icmp ult i64 %value, 256
  %set.valid = and i1 %position.valid, %value.valid
  br i1 %set.valid, label %good, label %bad
good:
  %data = load ptr, ptr %bytes
  %slot = getelementptr inbounds i8, ptr %data, i64 %position
  %byte = trunc i64 %value to i8
  store i8 %byte, ptr %slot
  ret void
bad:
  call void @minyar_bytes_set(ptr %bytes, i64 %position, i64 %value)
  ret void
}

; Checked inline List accesses. ABI: { values pointer, length, capacity }.
; Length is nonnegative; checked slots stay within the values allocation.
define internal i64 @.minyar.list.get.checked(ptr %list, i64 %position) alwaysinline {
entry:
  %length.pointer = getelementptr inbounds { ptr, i64, i64 }, ptr %list, i32 0, i32 1
  %length = load i64, ptr %length.pointer, !range !{i64 0, i64 -9223372036854775808}
  %get.valid = icmp ult i64 %position, %length
  br i1 %get.valid, label %good, label %bad
good:
  %values = load ptr, ptr %list
  %slot = getelementptr inbounds i64, ptr %values, i64 %position
  %value = load i64, ptr %slot
  ret i64 %value
bad:
  %fallback = call i64 @minyar_list_get(ptr %list, i64 %position)
  ret i64 %fallback
}
define internal void @.minyar.list.set.scalar.checked(ptr %list, i64 %position, i64 %value) alwaysinline {
entry:
  %length.pointer = getelementptr inbounds { ptr, i64, i64 }, ptr %list, i32 0, i32 1
  %length = load i64, ptr %length.pointer, !range !{i64 0, i64 -9223372036854775808}
  %set.valid = icmp ult i64 %position, %length
  br i1 %set.valid, label %good, label %bad
good:
  %values = load ptr, ptr %list
  %slot = getelementptr inbounds i64, ptr %values, i64 %position
  store i64 %value, ptr %slot
  ret void
bad:
  call void @minyar_list_set(ptr %list, i64 %position, i64 %value)
  ret void
}

define internal i64 @.minyar.list.length(ptr %list) alwaysinline {
entry:
  %pointer = getelementptr inbounds { ptr, i64, i64 }, ptr %list, i32 0, i32 1
  %length = load i64, ptr %pointer, !range !{i64 0, i64 -9223372036854775808}
  ret i64 %length
}

define internal void @.minyar.integer.overflow.checked(i1 %overflow) alwaysinline {
entry:
  br i1 %overflow, label %bad, label %good
bad:
  call void @minyar_fail_integer_overflow()
  unreachable
good:
  ret void
}
define internal void @.minyar.integer.division.checked(i64 %left, i64 %right) alwaysinline {
entry:
  %zero = icmp eq i64 %right, 0
  %minimum = icmp eq i64 %left, -9223372036854775808
  %negative.one = icmp eq i64 %right, -1
  %overflow = and i1 %minimum, %negative.one
  %invalid = or i1 %zero, %overflow
  br i1 %invalid, label %bad, label %good
bad:
  call void @minyar_fail_integer_division(i64 %right)
  unreachable
good:
  ret void
}

define internal void @.minyar.shift.checked(i64 %count) alwaysinline {
entry:
  %valid = icmp ult i64 %count, 64
  br i1 %valid, label %good, label %bad
bad:
  call void @minyar_check_shift(i64 %count)
  ret void
good:
  ret void
}
define internal i32 @.minyar.character.checked(i64 %value) alwaysinline {
entry:
  %range = icmp ult i64 %value, 1114112
  %below = icmp ult i64 %value, 55296
  %above = icmp ugt i64 %value, 57343
  %scalar = or i1 %below, %above
  %valid = and i1 %range, %scalar
  br i1 %valid, label %good, label %bad
bad:
  %fallback = call i32 @minyar_integer_character(i64 %value)
  ret i32 %fallback
good:
  %result = trunc i64 %value to i32
  ret i32 %result
}
define internal i64 @.minyar.float.integer.checked(double %value) alwaysinline {
entry:
  %above.minimum = fcmp oge double %value, -9.223372036854775808e18
  %below.maximum = fcmp olt double %value, 9.223372036854775808e18
  %valid = and i1 %above.minimum, %below.maximum
  br i1 %valid, label %good, label %bad
bad:
  %fallback = call i64 @minyar_float_integer(double %value)
  ret i64 %fallback
good:
  %result = fptosi double %value to i64
  ret i64 %result
}
define internal i64 @.minyar.integer.absolute.checked(i64 %value) alwaysinline {
entry:
  %valid = icmp ne i64 %value, -9223372036854775808
  br i1 %valid, label %good, label %bad
bad:
  %fallback = call i64 @minyar_integer_absolute(i64 %value)
  ret i64 %fallback
good:
  %negative = icmp slt i64 %value, 0
  %negated = sub i64 0, %value
  %result = select i1 %negative, i64 %negated, i64 %value
  ret i64 %result
}
define internal void @.minyar.clamp.integer.checked(i64 %lower, i64 %upper) alwaysinline {
entry:
  %valid = icmp sle i64 %lower, %upper
  br i1 %valid, label %good, label %bad
bad:
  call void @minyar_check_clamp_integer(i64 %lower, i64 %upper)
  ret void
good:
  ret void
}
define internal void @.minyar.clamp.float.checked(double %lower, double %upper) alwaysinline {
entry:
  %valid = fcmp ole double %lower, %upper
  br i1 %valid, label %good, label %bad
bad:
  call void @minyar_check_clamp_float(double %lower, double %upper)
  ret void
good:
  ret void
}
")

}

function literalName(prefix: Text, index: Integer, data: Boolean): Text {
    if prefix == "" {
        if data { return ".text.data." + Text(index) }
        return ".text." + Text(index)
    }
    let kind = "value"
    if data { kind = "data" }
    return "\"minyar.literal|" + prefix + "|" + kind + "|" + Text(index) + "\""
}

function appendRuntimeDeclarations(output: List<Text>, features: Integer) {
    if features / 32 % 2 != 0 { appendCLayoutDeclarations(output) }
    if features / 8 % 2 != 0 {
        output.add("; minyar-calldepth-policy: cooperative-v1-full-program
; minyar-callback-runtime: 1
declare i64 @minyar_callback_domain()
declare void @minyar_callback_check(ptr)
declare void @minyar_callback_check_environment(ptr)
declare i32 @minyar_recovery_enter()
declare i32 @minyar_recovery_pending()
declare void @minyar_calldepth_begin(ptr, i64)
declare i32 @minyar_calldepth_end(ptr)
declare i64 @minyar_calldepth_remaining()
declare i32 @minyar_calldepth_reporting_begin()
declare i32 @minyar_calldepth_reporting_end()
")
    }
    output.add("declare void @minyar_rc_release(ptr)

declare void @minyar_rc_enter(i64)
declare void @minyar_rc_leave()
declare void @minyar_stack_enter()
declare void @minyar_stack_leave()
declare void @minyar_rc_keep(ptr)
declare void @minyar_rc_borrow(ptr)
declare void @minyar_rc_retain(ptr)
declare void @minyar_rc_local(i64, ptr)
declare void @minyar_rc_local_take(i64, ptr)
declare void @minyar_rc_local_move(i64)
declare void @minyar_rc_local_move_owner(i64, ptr)
declare void @minyar_rc_step()
declare void @minyar_print_integer(i64)
declare void @minyar_print_text(ptr)
declare void @minyar_print_character(i32)
declare void @minyar_print_boolean(i1 zeroext)
declare void @minyar_fail(ptr)
declare void @minyar_exit(i64)
declare void @minyar_print_float(double)
declare void @minyar_record_replace(ptr, i64, i64, i64)
declare void @minyar_record_append_text(ptr, i64, ptr, ptr)
declare i64 @minyar_bytes_get(ptr, i64)
declare void @minyar_bytes_set(ptr, i64, i64)
declare i64 @minyar_bytes_length(ptr)
declare nonnull ptr @minyar_bytes_new(i64)
declare ptr @minyar_text_bytes(ptr)
declare ptr @minyar_bytes_text(ptr)
declare void @minyar_bytes_resize(ptr, i64)
declare void @minyar_bytes_clear(ptr)
declare void @minyar_bytes_add(ptr, i64)
declare void @minyar_bytes_append(ptr, ptr)
declare ptr @minyar_bytes_slice(ptr, i64, i64)
declare void @minyar_bytes_add_int16(ptr, i64)
declare void @minyar_bytes_set_int16(ptr, i64, i64)
declare i64 @minyar_bytes_get_int16(ptr, i64)
declare void @minyar_bytes_add_uint16(ptr, i64)
declare void @minyar_bytes_set_uint16(ptr, i64, i64)
declare i64 @minyar_bytes_get_uint16(ptr, i64)
declare void @minyar_bytes_add_int32(ptr, i64)
declare void @minyar_bytes_set_int32(ptr, i64, i64)
declare i64 @minyar_bytes_get_int32(ptr, i64)
declare void @minyar_bytes_add_uint32(ptr, i64)
declare void @minyar_bytes_set_uint32(ptr, i64, i64)
declare i64 @minyar_bytes_get_uint32(ptr, i64)
declare void @minyar_bytes_add_int64(ptr, i64)
declare void @minyar_bytes_set_int64(ptr, i64, i64)
declare i64 @minyar_bytes_get_int64(ptr, i64)
declare void @minyar_bytes_add_float32(ptr, double)
declare void @minyar_bytes_set_float32(ptr, i64, double)
declare double @minyar_bytes_get_float32(ptr, i64)
declare void @minyar_bytes_add_float64(ptr, double)
declare void @minyar_bytes_set_float64(ptr, i64, double)
declare double @minyar_bytes_get_float64(ptr, i64)
declare ptr @minyar_float_text(double)
declare i64 @minyar_float_integer(double)
declare i32 @minyar_integer_character(i64)
declare i64 @minyar_integer_absolute(i64)
declare void @minyar_check_clamp_integer(i64, i64)
declare void @minyar_check_clamp_float(double, double)
declare void @minyar_check_shift(i64)
declare double @llvm.fabs.f64(double)
declare double @llvm.minnum.f64(double, double)
declare double @llvm.maxnum.f64(double, double)
declare zeroext i1 @minyar_texts_are_equal(ptr, ptr)
declare ptr @minyar_join_text(ptr, ptr)
declare ptr @minyar_join_text_take_left(ptr, ptr)
declare ptr @minyar_join_texts(ptr)
declare i64 @minyar_text_length(ptr)
declare i64 @minyar_text_byte_length(ptr)
declare i32 @minyar_text_character_at(ptr, i64)
declare ptr @minyar_text_slice(ptr, i64, i64)
declare ptr @minyar_integer_text(i64)
declare ptr @minyar_character_text(i32)
declare ptr @minyar_boolean_text(i1 zeroext)
declare void @minyar_initialize_arguments(i32, ptr)
declare nonnull ptr @minyar_list_new()
declare void @minyar_list_references(ptr)
declare void @minyar_list_add(ptr, i64)
declare void @minyar_list_append_scalars(ptr, ptr, i64)
declare void @minyar_list_add_take(ptr, i64)
declare i64 @minyar_list_length(ptr)
declare i64 @minyar_list_get(ptr, i64)
declare void @minyar_list_set(ptr, i64, i64)
declare void @minyar_list_set_take(ptr, i64, i64)
declare ptr @minyar_list_appended(ptr, i64, i64, i64)
declare ptr @minyar_list_appended_take(ptr, i64, i64, i64)
declare nonnull ptr @minyar_record_new(i64)
declare nonnull ptr @minyar_record_new_scalar(i64)
declare i64 @minyar_record_get(ptr, i64)
declare void @minyar_record_set(ptr, i64, i64)
declare void @minyar_record_set_scalar(ptr, i64, i64)
declare void @minyar_record_set_reference(ptr, i64, i64)
declare void @minyar_record_set_take(ptr, i64, i64)
declare void @minyar_check_integer_overflow(i1)
declare void @minyar_check_integer_division(i64, i64)
declare void @minyar_fail_integer_overflow() cold noreturn
declare void @minyar_fail_integer_division(i64) cold noreturn
declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)
declare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)
declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)

")
    appendRuntimeHelpers(output)
}

function appendLiteralDeclarations(output: List<Text>, tokenKinds: List<Integer>, tokenTexts: List<Text>, prefix: Text, threaded: Boolean) {
    let dataHead = "@.text.data."
    let valueHead = "@.text."
    let tail = ""
    if prefix != "" {
        dataHead = "@\"minyar.literal|" + prefix + "|data|"
        valueHead = "@\"minyar.literal|" + prefix + "|value|"
        tail = "\""
    }
    let position = 0
    while position < tokenKinds.length {
        if tokenKinds[position] == 3 {
            let literal = tokenTexts[position]
            output.add(dataHead)
            output.add(Text(position))
            if tail != "" { output.add(tail) }
            output.add(" = private unnamed_addr constant [")
            output.add(Text(literal.byteLength + 1))
            output.add(" x i8] c\"")
            output.add(escapeLLVMText(literal))
            output.add("\\00\"\n")
            if literal.length == literal.byteLength {
                output.add(valueHead)
                output.add(Text(position))
                if tail != "" { output.add(tail) }
                output.add(" = private constant { i64, ptr, i64, i64, ptr, ptr } { i64 0, ptr ")
                output.add(dataHead)
                output.add(Text(position))
                if tail != "" { output.add(tail) }
                output.add(", i64 ")
                output.add(Text(literal.byteLength))
                output.add(", i64 ")
                output.add(Text(literal.byteLength))
                output.add(", ptr null, ptr null }\n")
            } else {
                output.add(valueHead)
                output.add(Text(position))
                if tail != "" { output.add(tail) }
                let storage = "global"
                if threaded { storage = "constant" }
                output.add(" = private " + storage + " { i64, ptr, i64, i64, ptr, ptr } { i64 0, ptr ")
                output.add(dataHead)
                output.add(Text(position))
                if tail != "" { output.add(tail) }
                output.add(", i64 ")
                output.add(Text(literal.byteLength))
                output.add(", i64 -1, ptr null, ptr null }\n")
            }
        }
        position = position + 1
    }

}
