function appendRuntimeHelpers(output: List<Text>) {
    output.add("
; Checked inline Bytes accesses. ABI prefix: { data pointer, byte length }.
; Visible length is nonnegative, including for shifted C-layout views.
; Only these leaf readers promise argument-memory-only effects. The header
; remains mutable through aliases; neither its data nor another header is disjoint.
define internal i64 @.minyar.bytes.length(ptr nonnull captures(none) dereferenceable(16) %bytes) alwaysinline nofree nosync nounwind willreturn memory(argmem: read) {
entry:
  %length.pointer = getelementptr inbounds { ptr, i64 }, ptr %bytes, i32 0, i32 1
  %length = load i64, ptr %length.pointer, !range !{i64 0, i64 -9223372036854775808}
  ret i64 %length
}
define internal i64 @.minyar.bytes.get.checked(ptr %bytes, i64 %position) alwaysinline {
entry:
  %length = call i64 @.minyar.bytes.length(ptr %bytes)
  %get.valid = icmp ult i64 %position, %length
  br i1 %get.valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
good:
  %data = load ptr, ptr %bytes, !nonnull !{}
  %slot = getelementptr inbounds i8, ptr %data, i64 %position
  %byte = load i8, ptr %slot
  %value = zext i8 %byte to i64
  ret i64 %value
bad:
  call i64 @minyar_bytes_get(ptr %bytes, i64 %position)
  unreachable
}
define internal void @.minyar.bytes.set.checked(ptr %bytes, i64 %position, i64 %value) alwaysinline {
entry:
  %length = call i64 @.minyar.bytes.length(ptr %bytes)
  %position.valid = icmp ult i64 %position, %length
  %value.valid = icmp ult i64 %value, 256
  %set.valid = and i1 %position.valid, %value.valid
  br i1 %set.valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
good:
  %data = load ptr, ptr %bytes, !nonnull !{}
  %slot = getelementptr inbounds i8, ptr %data, i64 %position
  %byte = trunc i64 %value to i8
  store i8 %byte, ptr %slot
  ret void
bad:
  call void @minyar_bytes_set(ptr %bytes, i64 %position, i64 %value)
  unreachable
}

; Appends within existing capacity. Bytes keeps its capacity in the third
; header word; C-layout views store a negative capacity and never take this
; path. Growth, views and invalid values use the runtime's exact behavior.
define internal void @.minyar.bytes.add.checked(ptr %bytes, i64 %value) alwaysinline {
entry:
  %length.pointer = getelementptr inbounds { ptr, i64, i64 }, ptr %bytes, i32 0, i32 1
  %length = load i64, ptr %length.pointer, !range !{i64 0, i64 -9223372036854775808}
  %capacity.pointer = getelementptr inbounds { ptr, i64, i64 }, ptr %bytes, i32 0, i32 2
  %capacity = load i64, ptr %capacity.pointer
  %room = icmp slt i64 %length, %capacity
  %value.valid = icmp ult i64 %value, 256
  %add.valid = and i1 %room, %value.valid
  br i1 %add.valid, label %good, label %bad
good:
  %data = load ptr, ptr %bytes
  %slot = getelementptr inbounds i8, ptr %data, i64 %length
  %byte = trunc i64 %value to i8
  store i8 %byte, ptr %slot
  %next = add nuw nsw i64 %length, 1
  store i64 %next, ptr %length.pointer
  ret void
bad:
  call void @minyar_bytes_add(ptr %bytes, i64 %value)
  ret void
}

; Checked inline List accesses. ABI: { values pointer, length, capacity }.
; Length is nonnegative; checked slots stay within the values allocation.
define internal i64 @.minyar.list.get.checked(ptr %list, i64 %position) alwaysinline {
entry:
  %length.pointer = getelementptr inbounds { ptr, i64, i64 }, ptr %list, i32 0, i32 1
  %length = load i64, ptr %length.pointer, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}, !range !{i64 0, i64 -9223372036854775808}
  %get.valid = icmp ult i64 %position, %length
  br i1 %get.valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
good:
  %values = load ptr, ptr %list, !nonnull !{}, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}
  %slot = getelementptr inbounds i64, ptr %values, i64 %position
  %value = load i64, ptr %slot, !tbaa !{!{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, !{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, i64 0}
  ret i64 %value
bad:
  call i64 @minyar_list_get(ptr %list, i64 %position)
  unreachable
}
define internal void @.minyar.list.set.scalar.checked(ptr %list, i64 %position, i64 %value) alwaysinline {
entry:
  %length.pointer = getelementptr inbounds { ptr, i64, i64 }, ptr %list, i32 0, i32 1
  %length = load i64, ptr %length.pointer, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}, !range !{i64 0, i64 -9223372036854775808}
  %set.valid = icmp ult i64 %position, %length
  br i1 %set.valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
good:
  %values = load ptr, ptr %list, !nonnull !{}, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}
  %slot = getelementptr inbounds i64, ptr %values, i64 %position
  store i64 %value, ptr %slot, !tbaa !{!{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, !{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, i64 0}
  ret void
bad:
  call void @minyar_list_set(ptr %list, i64 %position, i64 %value)
  unreachable
}

; Appends to a List of scalars. Scalar elements are never retained or
; released, so with room in the values buffer the runtime's append is exactly
; this store and length update; growth and every other case call it. Views
; store a negative capacity and always take the runtime path.
define internal void @.minyar.list.add.scalar(ptr %list, i64 %value) alwaysinline {
entry:
  %length.pointer = getelementptr inbounds { ptr, i64, i64 }, ptr %list, i32 0, i32 1
  %length = load i64, ptr %length.pointer, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}, !range !{i64 0, i64 -9223372036854775808}
  %capacity.pointer = getelementptr inbounds { ptr, i64, i64 }, ptr %list, i32 0, i32 2
  %capacity = load i64, ptr %capacity.pointer, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}
  %room = icmp slt i64 %length, %capacity
  br i1 %room, label %good, label %grow
good:
  %values = load ptr, ptr %list, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}
  %slot = getelementptr inbounds i64, ptr %values, i64 %length
  store i64 %value, ptr %slot, !tbaa !{!{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, !{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, i64 0}
  %next = add nuw nsw i64 %length, 1
  store i64 %next, ptr %length.pointer, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}
  ret void
grow:
  call void @minyar_list_add(ptr %list, i64 %value)
  ret void
}

; The same with the List's length and values pointer already loaded, for a
; List whose header cannot change in the caller (a parallel function's List
; parameter). A failing index reports through the List itself.
define internal i64 @.minyar.list.get.known(ptr %list, i64 %length, ptr %values, i64 %position) alwaysinline {
entry:
  %get.valid = icmp ult i64 %position, %length
  br i1 %get.valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
good:
  %slot = getelementptr inbounds i64, ptr %values, i64 %position
  %value = load i64, ptr %slot, !tbaa !{!{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, !{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, i64 0}
  ret i64 %value
bad:
  call i64 @minyar_list_get(ptr %list, i64 %position)
  unreachable
}
define internal void @.minyar.list.set.scalar.known(ptr %list, i64 %length, ptr %values, i64 %position, i64 %value) alwaysinline {
entry:
  %set.valid = icmp ult i64 %position, %length
  br i1 %set.valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
good:
  %slot = getelementptr inbounds i64, ptr %values, i64 %position
  store i64 %value, ptr %slot, !tbaa !{!{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, !{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, i64 0}
  ret void
bad:
  call void @minyar_list_set(ptr %list, i64 %position, i64 %value)
  unreachable
}
; A known-header access at `base + offset`, where the offset is a constant
; within 2^31 and the sum is used only here: an overflowing sum lands at or past
; any List length, so the failure path reports the overflow if there was one,
; and otherwise the position, exactly as checked arithmetic then indexing would.
define internal i64 @.minyar.list.get.known.offset(ptr %list, i64 %length, ptr %values, i64 %base, i64 %offset) alwaysinline {
entry:
  %position = add i64 %base, %offset
  %get.valid = icmp ult i64 %position, %length
  br i1 %get.valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
good:
  %slot = getelementptr inbounds i64, ptr %values, i64 %position
  %value = load i64, ptr %slot, !tbaa !{!{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, !{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, i64 0}
  ret i64 %value
bad:
  %sum = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %base, i64 %offset)
  %overflow = extractvalue { i64, i1 } %sum, 1
  call void @.minyar.integer.overflow.checked(i1 %overflow)
  call i64 @minyar_list_get(ptr %list, i64 %position)
  unreachable
}
define internal void @.minyar.list.set.scalar.known.offset(ptr %list, i64 %length, ptr %values, i64 %base, i64 %offset, i64 %value) alwaysinline {
entry:
  %position = add i64 %base, %offset
  %set.valid = icmp ult i64 %position, %length
  br i1 %set.valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
good:
  %slot = getelementptr inbounds i64, ptr %values, i64 %position
  store i64 %value, ptr %slot, !tbaa !{!{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, !{!\"minyar list slot\", !{!\"minyar\"}, i64 0}, i64 0}
  ret void
bad:
  %sum = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %base, i64 %offset)
  %overflow = extractvalue { i64, i1 } %sum, 1
  call void @.minyar.integer.overflow.checked(i1 %overflow)
  call void @minyar_list_set(ptr %list, i64 %position, i64 %value)
  unreachable
}

; Inline record fields. ABI: { length, values[] } in every runtime profile.
; Records never grow and the type checker resolves every field to a constant
; position below the record's field count, so access needs no length check.
; Positions below the tagged limit have their own accessor and TBAA tag, so a
; store to one field position cannot force a reload of another. Later positions
; share the parent tag, which aliases every tagged position.
define internal i64 @.minyar.record.get(ptr %record, i64 %field) alwaysinline {
entry:
  %values = getelementptr inbounds i8, ptr %record, i64 8
  %slot = getelementptr inbounds i64, ptr %values, i64 %field
  %value = load i64, ptr %slot, !tbaa !{!{!\"minyar record field\", !{!\"minyar\"}, i64 0}, !{!\"minyar record field\", !{!\"minyar\"}, i64 0}, i64 0}
  ret i64 %value
}
define internal void @.minyar.record.set.scalar(ptr %record, i64 %field, i64 %value) alwaysinline {
entry:
  %values = getelementptr inbounds i8, ptr %record, i64 8
  %slot = getelementptr inbounds i64, ptr %values, i64 %field
  store i64 %value, ptr %slot, !tbaa !{!{!\"minyar record field\", !{!\"minyar\"}, i64 0}, !{!\"minyar record field\", !{!\"minyar\"}, i64 0}, i64 0}
  ret void
}
; The failing branch of a consumed `try`: the Result record itself unless the
; final Result lowering returned the call's Result in registers, where it is
; rebuilt here (success and failure payload reference flags).
define internal ptr @.minyar.record.result.rebox(ptr %record, i64 %ok, i64 %error) alwaysinline {
entry:
  ret ptr %record
}
; A fresh pair choice consumed by a match or `is` test: only its tag reads,
; payload reads and takes follow, so the final Result lowering may keep the
; call's value in registers.
define internal void @.minyar.record.result.consume(ptr %record) alwaysinline {
entry:
  ret void
}
; The take of a consumed match or `is`: the payload's own count (retained when
; it is a reference) and the record released, as its owner would have; a value
; the final Result lowering keeps in registers reads its pair instead.
define internal i64 @.minyar.record.result.take(ptr %record, i64 %field, i64 %reference) alwaysinline {
entry:
  %value = call i64 @.minyar.record.get(ptr %record, i64 %field)
  %counted = icmp ne i64 %reference, 0
  br i1 %counted, label %retain, label %release
retain:
  call void @minyar_rc_retain_slot(i64 %value)
  br label %release
release:
  call void @minyar_rc_release(ptr %record)
  ret i64 %value
}

; An empty List has no values buffer (minyar_list_new stores null), so unlike
; the loads under a passed position check this pointer carries no !nonnull.
define internal ptr @.minyar.list.values(ptr nonnull captures(none) dereferenceable(16) %list) alwaysinline nofree nosync nounwind willreturn memory(argmem: read) {
entry:
  %values = load ptr, ptr %list, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}
  ret ptr %values
}

define internal i64 @.minyar.list.length(ptr nonnull captures(none) dereferenceable(16) %list) alwaysinline nofree nosync nounwind willreturn memory(argmem: read) {
entry:
  %pointer = getelementptr inbounds { ptr, i64, i64 }, ptr %list, i32 0, i32 1
  %length = load i64, ptr %pointer, !tbaa !{!{!\"minyar list header\", !{!\"minyar\"}, i64 0}, !{!\"minyar list header\", !{!\"minyar\"}, i64 0}, i64 0}, !range !{i64 0, i64 -9223372036854775808}
  ret i64 %length
}

define internal void @.minyar.integer.overflow.checked(i1 %overflow) alwaysinline {
entry:
  br i1 %overflow, label %bad, label %good, !prof !{!\"branch_weights\", !\"expected\", i32 1, i32 2000}
bad:
  call void @minyar_fail_integer_overflow()
  unreachable
good:
  ret void
}
define internal void @.minyar.integer.division.checked(i64 %left, i64 %right) alwaysinline {
entry:
  %zero = icmp eq i64 %right, 0
  %minimum = icmp eq i64 %left, -9223372036854775808
  %negative.one = icmp eq i64 %right, -1
  %overflow = and i1 %minimum, %negative.one
  %invalid = or i1 %zero, %overflow
  br i1 %invalid, label %bad, label %good, !prof !{!\"branch_weights\", !\"expected\", i32 1, i32 2000}
bad:
  call void @minyar_fail_integer_division(i64 %right)
  unreachable
good:
  ret void
}

define internal void @.minyar.shift.checked(i64 %count) alwaysinline {
entry:
  %valid = icmp ult i64 %count, 64
  br i1 %valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
bad:
  call void @minyar_check_shift(i64 %count)
  ret void
good:
  ret void
}
define internal i32 @.minyar.character.checked(i64 %value) alwaysinline {
entry:
  %range = icmp ult i64 %value, 1114112
  %below = icmp ult i64 %value, 55296
  %above = icmp ugt i64 %value, 57343
  %scalar = or i1 %below, %above
  %valid = and i1 %range, %scalar
  br i1 %valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
bad:
  %fallback = call i32 @minyar_integer_character(i64 %value)
  ret i32 %fallback
good:
  %result = trunc i64 %value to i32
  ret i32 %result
}
define internal i64 @.minyar.float.integer.checked(double %value) alwaysinline {
entry:
  %above.minimum = fcmp oge double %value, -9.223372036854775808e18
  %below.maximum = fcmp olt double %value, 9.223372036854775808e18
  %valid = and i1 %above.minimum, %below.maximum
  br i1 %valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
bad:
  %fallback = call i64 @minyar_float_integer(double %value)
  ret i64 %fallback
good:
  %result = fptosi double %value to i64
  ret i64 %result
}
define internal i64 @.minyar.integer.absolute.checked(i64 %value) alwaysinline {
entry:
  %valid = icmp ne i64 %value, -9223372036854775808
  br i1 %valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
bad:
  %fallback = call i64 @minyar_integer_absolute(i64 %value)
  ret i64 %fallback
good:
  %negative = icmp slt i64 %value, 0
  %negated = sub i64 0, %value
  %result = select i1 %negative, i64 %negated, i64 %value
  ret i64 %result
}
define internal void @.minyar.clamp.integer.checked(i64 %lower, i64 %upper) alwaysinline {
entry:
  %valid = icmp sle i64 %lower, %upper
  br i1 %valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
bad:
  call void @minyar_check_clamp_integer(i64 %lower, i64 %upper)
  ret void
good:
  ret void
}
define internal void @.minyar.clamp.float.checked(double %lower, double %upper) alwaysinline {
entry:
  %valid = fcmp ole double %lower, %upper
  br i1 %valid, label %good, label %bad, !prof !{!\"branch_weights\", !\"expected\", i32 2000, i32 1}
bad:
  call void @minyar_check_clamp_float(double %lower, double %upper)
  ret void
good:
  ret void
}
")

    // One accessor per tagged field position. A shared helper that switched on
    // the field would be simplified before inlining, merging the per-position
    // tags; distinct callees keep each access's tag through optimization.
    let position = 0
    while position < recordTaggedFieldLimit() {
        let field = Text(position)
        let tag = recordFieldTag(position)
        output.add("define internal i64 @.minyar.record.get." + field + "(ptr %record) alwaysinline {\nentry:\n  %values = getelementptr inbounds i8, ptr %record, i64 8\n  %slot = getelementptr inbounds i64, ptr %values, i64 " + field + "\n  %value = load i64, ptr %slot, " + tag + "\n  ret i64 %value\n}\n")
        output.add("define internal void @.minyar.record.set.scalar." + field + "(ptr %record, i64 %value) alwaysinline {\nentry:\n  %values = getelementptr inbounds i8, ptr %record, i64 8\n  %slot = getelementptr inbounds i64, ptr %values, i64 " + field + "\n  store i64 %value, ptr %slot, " + tag + "\n  ret void\n}\n")
        position = position + 1
    }
}

// Record positions below this limit have a distinct accessor and TBAA tag.
// Two different positions never overlap (slot K is byte offset 8 + 8K of
// whichever record holds the address), so the separation is sound without
// type information; a position at or past the limit keeps the parent tag,
// which aliases every tagged position.
function recordTaggedFieldLimit(): Integer {
    return 16
}

function recordFieldTagged(position: Integer): Boolean {
    return position >= 0 && position < recordTaggedFieldLimit()
}

function recordFieldTag(position: Integer): Text {
    let parent = "!{!\"minyar record field\", !{!\"minyar\"}, i64 0}"
    let field = "!{!\"minyar record field " + Text(position) + "\", " + parent + ", i64 0}"
    return "!tbaa !{" + field + ", " + field + ", i64 0}"
}

function recordGetCallee(position: Integer): Text {
    if recordFieldTagged(position) { return "@.minyar.record.get." + Text(position) }
    return "@.minyar.record.get"
}

// A store through a method's own receiver keeps the shared parent tag. Every
// access through `self` names one object at constant offsets, which BasicAA
// already separates, so the position tag adds no disambiguation there; the
// shared tag also keeps the store visible to the other positions' loads, so a
// loop counter assigned through `self` is not promoted into a value that every
// exit edge has to carry. The store still cannot be confused with another
// record's tagged field, because the parent tag aliases every child.
function recordSetTagged(position: Integer, shared: Boolean): Boolean {
    return !shared && recordFieldTagged(position)
}

function recordSetCallee(position: Integer, shared: Boolean): Text {
    if recordSetTagged(position, shared) { return "@.minyar.record.set.scalar." + Text(position) }
    return "@.minyar.record.set.scalar"
}

// String and List constants are named by a digest of their content (see
// genericInstanceDigest), never by token position: an edit that adds code before
// them must not rename them, or a live patch would treat every later function
// as changed. Equal constants share one definition.
function literalName(prefix: Text, digest: Text, data: Boolean): Text {
    if prefix == "" {
        if data { return ".text.data." + digest }
        return ".text." + digest
    }
    let kind = "value"
    if data { kind = "data" }
    return "\"minyar.literal|" + prefix + "|" + kind + "|" + digest + "\""
}

// Records a content-named constant; true when it still needs its definition.
// Two different contents with one digest are a compile error.
function newConstantName(names: GenericIndex, contents: List<Text>, digest: Text, content: Text): Boolean {
    let seen = genericIndexGet(names, digest)
    if seen >= 0 {
        if contents[seen] != content { failCompiler("two constants hash to the same name " + digest + "; change one of them") }
        return false
    }
    genericIndexPut(names, digest, contents.length)
    contents.add(content)
    return true
}

// Every Minyar target is a 64-bit little-endian one whose Integer (i64) has
// 8-byte ABI alignment. A load or store written without `align` takes the ABI
// alignment of the data layout in force when the IR is parsed; with no layout
// LLVM's default gives i64 only 4 bytes. Clang replaces this partial layout
// with the target's complete one, so it only fixes those parsed alignments.
function moduleDataLayout(): Text {
    return "target datalayout = \"e-i64:64\"\n\n"
}

function appendRuntimeDeclarations(output: List<Text>, features: Integer) {
    if features / 32 % 2 != 0 { appendCLayoutDeclarations(output) }
    if features / 8 % 2 != 0 {
        output.add("; minyar-calldepth-policy: cooperative-v1-full-program
; minyar-callback-runtime: 1
declare i64 @minyar_callback_domain()
declare void @minyar_callback_check(ptr)
declare void @minyar_callback_check_environment(ptr)
declare i32 @minyar_recovery_enter()
declare i32 @minyar_recovery_pending()
declare void @minyar_calldepth_begin(ptr, i64)
declare i32 @minyar_calldepth_end(ptr)
declare i64 @minyar_calldepth_remaining()
declare i32 @minyar_calldepth_reporting_begin()
declare i32 @minyar_calldepth_reporting_end()
")
    }
    output.add("declare void @minyar_rc_release(ptr)

declare void @minyar_rc_enter(i64)
declare void @minyar_rc_leave()
