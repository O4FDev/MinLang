function appendRuntimeHelpers(output: List<Text>) {
    output.add("\n")
    output.add("; Checked inline List accesses. ABI: { values pointer, length, capacity }.\n")
    output.add("define internal i64 @.minyar.list.get.checked(ptr %list, i64 %position) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %length.pointer = getelementptr { ptr, i64, i64 }, ptr %list, i32 0, i32 1\n")
    output.add("  %length = load i64, ptr %length.pointer\n")
    output.add("  %get.valid = icmp ult i64 %position, %length\n")
    output.add("  br i1 %get.valid, label %good, label %bad\n")
    output.add("good:\n")
    output.add("  %values = load ptr, ptr %list\n")
    output.add("  %slot = getelementptr i64, ptr %values, i64 %position\n")
    output.add("  %value = load i64, ptr %slot\n")
    output.add("  ret i64 %value\n")
    output.add("bad:\n")
    output.add("  %fallback = call i64 @minyar_list_get(ptr %list, i64 %position)\n")
    output.add("  ret i64 %fallback\n")
    output.add("}\n")
    output.add("define internal void @.minyar.list.set.scalar.checked(ptr %list, i64 %position, i64 %value) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %length.pointer = getelementptr { ptr, i64, i64 }, ptr %list, i32 0, i32 1\n")
    output.add("  %length = load i64, ptr %length.pointer\n")
    output.add("  %set.valid = icmp ult i64 %position, %length\n")
    output.add("  br i1 %set.valid, label %good, label %bad\n")
    output.add("good:\n")
    output.add("  %values = load ptr, ptr %list\n")
    output.add("  %slot = getelementptr i64, ptr %values, i64 %position\n")
    output.add("  store i64 %value, ptr %slot\n")
    output.add("  ret void\n")
    output.add("bad:\n")
    output.add("  call void @minyar_list_set(ptr %list, i64 %position, i64 %value)\n")
    output.add("  ret void\n")
    output.add("}\n")
    output.add("\n")
    output.add("define internal i64 @.minyar.list.length(ptr %list) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %pointer = getelementptr { ptr, i64, i64 }, ptr %list, i32 0, i32 1\n")
    output.add("  %length = load i64, ptr %pointer\n")
    output.add("  ret i64 %length\n")
    output.add("}\n")
    output.add("\n")
    output.add("define internal void @.minyar.integer.overflow.checked(i1 %overflow) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  br i1 %overflow, label %bad, label %good\n")
    output.add("bad:\n")
    output.add("  call void @minyar_fail_integer_overflow()\n")
    output.add("  unreachable\n")
    output.add("good:\n")
    output.add("  ret void\n")
    output.add("}\n")
    output.add("define internal void @.minyar.integer.division.checked(i64 %left, i64 %right) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %zero = icmp eq i64 %right, 0\n")
    output.add("  %minimum = icmp eq i64 %left, -9223372036854775808\n")
    output.add("  %negative.one = icmp eq i64 %right, -1\n")
    output.add("  %overflow = and i1 %minimum, %negative.one\n")
    output.add("  %invalid = or i1 %zero, %overflow\n")
    output.add("  br i1 %invalid, label %bad, label %good\n")
    output.add("bad:\n")
    output.add("  call void @minyar_fail_integer_division(i64 %right)\n")
    output.add("  unreachable\n")
    output.add("good:\n")
    output.add("  ret void\n")
    output.add("}\n")

    // Keep argument evaluation at each call site; only the already evaluated
    // scalar values enter these helpers. The good arms never call the runtime;
    // the bad arms preserve its checked ABI and exact existing diagnostics.
    output.add("\n")
    output.add("define internal void @.minyar.shift.checked(i64 %count) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %valid = icmp ult i64 %count, 64\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  call void @minyar_check_shift(i64 %count)\n")
    output.add("  ret void\n")
    output.add("good:\n")
    output.add("  ret void\n")
    output.add("}\n")
    output.add("define internal i32 @.minyar.character.checked(i64 %value) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %range = icmp ult i64 %value, 1114112\n")
    output.add("  %below = icmp ult i64 %value, 55296\n")
    output.add("  %above = icmp ugt i64 %value, 57343\n")
    output.add("  %scalar = or i1 %below, %above\n")
    output.add("  %valid = and i1 %range, %scalar\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  %fallback = call i32 @minyar_integer_character(i64 %value)\n")
    output.add("  ret i32 %fallback\n")
    output.add("good:\n")
    output.add("  %result = trunc i64 %value to i32\n")
    output.add("  ret i32 %result\n")
    output.add("}\n")
    output.add("define internal i64 @.minyar.float.integer.checked(double %value) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %above.minimum = fcmp oge double %value, -9.223372036854775808e18\n")
    output.add("  %below.maximum = fcmp olt double %value, 9.223372036854775808e18\n")
    output.add("  %valid = and i1 %above.minimum, %below.maximum\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  %fallback = call i64 @minyar_float_integer(double %value)\n")
    output.add("  ret i64 %fallback\n")
    output.add("good:\n")
    output.add("  %result = fptosi double %value to i64\n")
    output.add("  ret i64 %result\n")
    output.add("}\n")
    output.add("define internal i64 @.minyar.integer.absolute.checked(i64 %value) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %valid = icmp ne i64 %value, -9223372036854775808\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  %fallback = call i64 @minyar_integer_absolute(i64 %value)\n")
    output.add("  ret i64 %fallback\n")
    output.add("good:\n")
    output.add("  %negative = icmp slt i64 %value, 0\n")
    output.add("  %negated = sub i64 0, %value\n")
    output.add("  %result = select i1 %negative, i64 %negated, i64 %value\n")
    output.add("  ret i64 %result\n")
    output.add("}\n")
    output.add("define internal void @.minyar.clamp.integer.checked(i64 %lower, i64 %upper) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %valid = icmp sle i64 %lower, %upper\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  call void @minyar_check_clamp_integer(i64 %lower, i64 %upper)\n")
    output.add("  ret void\n")
    output.add("good:\n")
    output.add("  ret void\n")
    output.add("}\n")
    output.add("define internal void @.minyar.clamp.float.checked(double %lower, double %upper) alwaysinline {\n")
    output.add("entry:\n")
    output.add("  %valid = fcmp ole double %lower, %upper\n")
    output.add("  br i1 %valid, label %good, label %bad\n")
    output.add("bad:\n")
    output.add("  call void @minyar_check_clamp_float(double %lower, double %upper)\n")
    output.add("  ret void\n")
    output.add("good:\n")
    output.add("  ret void\n")
    output.add("}\n")

}

