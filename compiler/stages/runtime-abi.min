    output.add("declare double @llvm.maxnum.f64(double, double)\n")
    output.add("declare zeroext i1 @minyar_texts_are_equal(ptr, ptr)\n")
    output.add("declare ptr @minyar_join_text(ptr, ptr)\n")
    output.add("declare ptr @minyar_join_text_take_left(ptr, ptr)\n")
