function prepareSyntaxContext(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, scannedStarts: List<Integer>, scannedEnds: List<Integer>): CompilerContext {
    let features = tokenLines.features
    let syntax = parseSyntaxDeclarations(tokenKinds, tokenTexts, tokenLines, tokenLines.inputPath, scannedStarts, scannedEnds)
    let functionNames: List<Text> = []
    let symbolKinds: List<Integer> = []
    let symbolLocations: List<Text> = []
    let functionReturnTypes: List<Integer> = []
    let functionParameterCounts: List<Integer> = []
    let functionParameterNames: List<Text> = []
    let functionParameterTypes: List<Integer> = []
    let declarationEnds: List<Integer> = []
    discoverSyntaxSymbols(syntax, tokenTexts, tokenLines, functionNames, symbolKinds, symbolLocations, functionReturnTypes, functionParameterCounts, declarationEnds)
    tokenLines.symbolLookup = buildDeclarationIndex(functionNames, symbolKinds)
    if (features / 1 % 2) != 0 { prepareCallbackSymbols(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, symbolLocations, functionReturnTypes, functionParameterCounts) }
    let symbolLookup = tokenLines.symbolLookup
    if symbolLookup[0] != functionNames.length { symbolLookup = buildDeclarationIndex(functionNames, symbolKinds) }
    tokenLines.symbolLookup = symbolLookup
    requireUniqueSymbols(symbolLookup, functionNames, symbolKinds, symbolLocations)
    let parameterStarts: List<Integer> = []
    let recordIndex = 0
    while recordIndex < functionNames.length {
        parameterStarts.add(0)
        recordIndex = recordIndex + 1
    }
    discoverDeclarations(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, symbolLocations, functionReturnTypes, symbolLookup, functionParameterCounts, functionParameterNames, functionParameterTypes, parameterStarts, declarationEnds)
    appendParameterOffsets(functionParameterCounts, parameterStarts)
    symbolLookup = buildDeclarationIndex(functionNames, symbolKinds)
    tokenLines.symbolLookup = symbolLookup
    requireUniqueSymbols(symbolLookup, functionNames, symbolKinds, symbolLocations)
    let lookupPosition = 0
    // Keep the metadata boundary at twice the symbol count for ownership data.
    while lookupPosition < functionNames.length {
        functionReturnTypes.add(lookupPosition)
        lookupPosition = lookupPosition + 1
    }

    return newCompilerContext(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, syntax)
}

function compileTokens(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, scannedStarts: List<Integer>, scannedEnds: List<Integer>, stackOwnerLimit: Integer): List<Text> {
    let features = tokenLines.features
    if features / 4096 % 2 != 0 {
        let prelude = normalizeMaybePrelude(tokenKinds, tokenTexts, tokenLines)
        let normalized = normalizeChoiceTypes(prelude.kinds, prelude.texts, prelude.lines)
        tokenKinds = normalized.kinds
        tokenTexts = normalized.texts
        tokenLines = normalized.lines
        features = tokenLines.features
        let emptyStarts: List<Integer> = []
        let emptyEnds: List<Integer> = []
        scannedStarts = emptyStarts
        scannedEnds = emptyEnds
    }
    if features / 256 % 2 != 0 {
        let normalized = normalizeGenericTokens(tokenKinds, tokenTexts, tokenLines)
        tokenKinds = normalized.kinds
        tokenTexts = normalized.texts
        tokenLines = normalized.lines
        features = tokenLines.features
        let emptyStarts: List<Integer> = []
        let emptyEnds: List<Integer> = []
        scannedStarts = emptyStarts
        scannedEnds = emptyEnds
    }
    if features / 64 % 2 != 0 {
        let normalized = normalizeCallableTypes(tokenKinds, tokenTexts, tokenLines)
        tokenKinds = normalized.kinds
        tokenTexts = normalized.texts
        tokenLines = normalized.lines
        let emptyStarts: List<Integer> = []
        let emptyEnds: List<Integer> = []
        scannedStarts = emptyStarts
        scannedEnds = emptyEnds
    }
    if (features / 2 % 2) != 0 {
        let normalized = normalizeResultTypes(tokenKinds, tokenTexts, tokenLines)
        tokenKinds = normalized.kinds
        tokenTexts = normalized.texts
        tokenLines = normalized.lines
        let emptyStarts: List<Integer> = []
        let emptyEnds: List<Integer> = []
        scannedStarts = emptyStarts
        scannedEnds = emptyEnds
    }
    if features / 4096 % 2 != 0 {
        let normalized = normalizeChoiceTypes(tokenKinds, tokenTexts, tokenLines)
        tokenKinds = normalized.kinds
        tokenTexts = normalized.texts
        tokenLines = normalized.lines
        let emptyStarts: List<Integer> = []
        let emptyEnds: List<Integer> = []
        scannedStarts = emptyStarts
        scannedEnds = emptyEnds
    }
    if (features / 1 % 2) != 0 {
        let normalized = normalizeCallbackTokens(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds)
        tokenKinds = normalized.kinds
        tokenTexts = normalized.texts
        tokenLines = normalized.lines
    }
    let parallelMarkers: List<Text> = []
    if (features / 4 % 2) != 0 { parallelMarkers.add("; minyar-thread-runtime: 1\n") }
    let scan = 0
    while features / 16 % 2 != 0 && scan + 2 < tokenKinds.length {
        if tokenKinds[scan] == 6 && tokenTexts[scan] == "parallel" && tokenKinds[scan + 1] == 1 && tokenTexts[scan + 1] == "function" {
            parallelMarkers.add("; minyar-parallel: " + tokenTexts[scan + 2] + "\n")
        }
        if scan + 3 < tokenKinds.length && tokenKinds[scan] == 6 && tokenTexts[scan] == "parallel" && tokenTexts[scan + 1] == "public" && tokenTexts[scan + 2] == "function" {
            parallelMarkers.add("; minyar-parallel: " + tokenTexts[scan + 3] + "\n")
        }
        if tokenKinds[scan] == 6 && tokenTexts[scan] == "thread" {
            let target = scan + 2
            if tokenTexts[scan + 1] == "public" { target = scan + 3 }
            if tokenTexts[target - 1] != "function" { fail("thread requires a named function declaration") }
            if tokenTexts[target] == "main" { fail("main cannot be a thread entry") }
            parallelMarkers.add("; minyar-thread-entry: " + tokenTexts[target] + "\n")
        }
        scan = scan + 1
    }
    let context = prepareSyntaxContext(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds)
    if features / 256 % 2 != 0 { genericValidateConstraints(context) }
    let functionNames = context.functionNames
    let symbolKinds = context.symbolKinds
    let functionReturnTypes = context.functionReturnTypes
    let functionParameterCounts = context.functionParameterCounts
    let functionParameterTypes = context.functionParameterTypes
    let symbolLookup = tokenLines.symbolLookup
    let topLevelStatements = context.syntax.topLevel
    let output: List<Text> = []
    let globals: List<Text> = []
    let marker = 0
    while marker < parallelMarkers.length {
        globals.add(parallelMarkers[marker])
        marker = marker + 1
    }
    threadValidateEntries(globals, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterTypes, symbolLookup)
    output.add("; Generated by the compiler written in Minyar.\n\n")
    appendLiteralDeclarations(output, tokenKinds, tokenTexts, "", (features / 4 % 2) != 0)

    let runtimeStart = output.length
    appendRuntimeDeclarations(output, features)
    let runtimeEnd = output.length
    let noStats: List<Integer> = []
    let mainFunction = findIndexedSymbol(symbolLookup, functionNames, symbolKinds, "main", 1)
    if topLevelStatements && mainFunction >= 0 {
        fail(describeLocation(tokenLocation(tokenLines, context.syntax.nodes[context.syntax.symbolNodes[mainFunction]].start + 1)) + ": a program cannot combine top-level statements with function main()")
    }
    let constantDeclaration = output.length
    let constants = hasModuleConstants(symbolKinds, functionParameterCounts)
    compileModuleConstants(context, output, globals)
    let hasNative = compileFunctions(context, output, globals, stackOwnerLimit, "", noStats)
    if mainFunction < 0 {
        compileTopLevel(context, output, globals, "", noStats)
    }
    let callbackStart = -1
    if (features / 1 % 2) != 0 {
        callbackStart = compileClosureBodies(context, output, globals, stackOwnerLimit)
        finishCallbackGraph(functionReturnTypes, functionParameterCounts, functionParameterTypes)
    }
    let finalDeclarations = output.length
    checkSafeParallelCalls(context, globals)
    checkParallelCalls(globals)
    finishCycleFixups(output, functionReturnTypes, functionParameterCounts, functionParameterTypes)
    if stackOwnerLimit > 0 {
        output.add("declare void @minyar_rc_enter_stack_v1(ptr, ptr, i64)\n")
        output.add("declare void @minyar_rc_leave_stack_v1(ptr)\n")
    }
    if (features / 4 % 2) != 0 {
        threadCheckGraph(output, globals)
        threadAppendABI(output, globals, functionNames, symbolKinds, functionReturnTypes, features / 8 % 2 != 0, symbolLookup)
    }
    if hasNative {
        let runtimeDeclarations: List<Text> = []
        collectRuntimeDeclarations(output, runtimeDeclarations, runtimeStart, runtimeEnd)
        if constants { collectRuntimeDeclarations(output, runtimeDeclarations, constantDeclaration, constantDeclaration + 1) }
        collectRuntimeDeclarations(output, runtimeDeclarations, callbackStart, finalDeclarations)
        collectRuntimeDeclarations(output, runtimeDeclarations, finalDeclarations, output.length)
        appendNativeDeclarations(context, output, runtimeDeclarations)
    }
    if globals.length == 0 { return output }
    let globalCode = joinText(globals)
    if hasGlobalDeclarations(globals) {
        let declarations: List<Text> = []
        collectRuntimeDeclarations(output, declarations, runtimeStart, runtimeEnd)
        if constants { collectRuntimeDeclarations(output, declarations, constantDeclaration, constantDeclaration + 1) }
        collectRuntimeDeclarations(output, declarations, callbackStart, finalDeclarations)
        collectRuntimeDeclarations(output, declarations, finalDeclarations, output.length)
        globalCode = deduplicateGlobalDeclarations(globalCode, declarations)
    }
    output.add(globalCode)
    return output
}

function compileProgram(source: Text): Text {
    let tokenKinds: List<Integer> = []
    let tokenTexts: List<Text> = []
    let tokenLines = newSourceMap()
    tokenize(source, tokenKinds, tokenTexts, tokenLines)
    let scannedStarts: List<Integer> = []
    let scannedEnds: List<Integer> = []
    return joinText(compileTokens(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds, 0))
}
