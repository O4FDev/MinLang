function compileTokens(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: SourceMap, scannedStarts: List<Integer>, scannedEnds: List<Integer>, stackOwnerLimit: Integer): List<Text> {
    let features = tokenLines.features
    if features / 16 % 2 != 0 && features % 16 != 0 { fail("compiler build requires an ordinary compiler source") }
    if (features / 2 % 2) != 0 {
        let normalized = normalizeResultTypes(tokenKinds, tokenTexts, tokenLines)
        tokenKinds = normalized.kinds
        tokenTexts = normalized.texts
        tokenLines = normalized.lines
        let emptyStarts: List<Integer> = []
        let emptyEnds: List<Integer> = []
        scannedStarts = emptyStarts
        scannedEnds = emptyEnds
    }
    if (features / 1 % 2) != 0 {
        let normalized = normalizeCallbackTokens(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds)
        tokenKinds = normalized.kinds
        tokenTexts = normalized.texts
        tokenLines = normalized.lines
    }
    let parallelMarkers: List<Text> = []
    if (features / 4 % 2) != 0 { parallelMarkers.add("; minyar-thread-runtime: 1\n") }
    let scan = 0
    while scan + 2 < tokenKinds.length {
        if tokenKinds[scan] == 6 && tokenTexts[scan] == "parallel" && tokenKinds[scan + 1] == 1 && tokenTexts[scan + 1] == "function" {
            parallelMarkers.add("; minyar-parallel: " + tokenTexts[scan + 2] + "\n")
        }
        if scan + 3 < tokenKinds.length && tokenKinds[scan] == 6 && tokenTexts[scan] == "parallel" && tokenTexts[scan + 1] == "public" && tokenTexts[scan + 2] == "function" {
            parallelMarkers.add("; minyar-parallel: " + tokenTexts[scan + 3] + "\n")
        }
        if tokenKinds[scan] == 6 && tokenTexts[scan] == "thread" {
            let target = scan + 2
            if tokenTexts[scan + 1] == "public" { target = scan + 3 }
            if tokenTexts[target - 1] != "function" { fail("thread requires a named function declaration") }
            if tokenTexts[target] == "main" { fail("main cannot be a thread entry") }
            parallelMarkers.add("; minyar-thread-entry: " + tokenTexts[target] + "\n")
        }
        scan = scan + 1
    }
    if features / 16 % 2 != 0 && parallelMarkers.length > 0 { fail("compiler build cannot export parallel entries") }
    let functionNames: List<Text> = []
    let symbolKinds: List<Integer> = []
    let symbolLocations: List<Text> = []
    let functionReturnTypes: List<Integer> = []
    let functionParameterCounts: List<Integer> = []
    let functionParameterNames: List<Text> = []
    let functionParameterTypes: List<Integer> = []
    let declarationEnds: List<Integer> = []
    let topLevelStatements = false
    if scannedStarts.length > 0 {
        topLevelStatements = recordScannedDeclarations(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds, functionNames, symbolKinds, symbolLocations, functionReturnTypes, functionParameterCounts, declarationEnds)
    } else {
        topLevelStatements = discoverRecordNames(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, symbolLocations, functionReturnTypes, functionParameterCounts, declarationEnds)
    }
    if (features / 1 % 2) != 0 { prepareCallbackSymbols(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, symbolLocations, functionReturnTypes, functionParameterCounts) }
    let symbolLookup = buildSymbolLookup(functionNames, symbolKinds)
    requireUniqueSymbols(symbolLookup, functionNames, symbolKinds, symbolLocations)
    let parameterStarts: List<Integer> = []
    let recordIndex = 0
    while recordIndex < functionNames.length {
        parameterStarts.add(0)
        recordIndex = recordIndex + 1
    }
    discoverDeclarations(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, symbolLocations, functionReturnTypes, symbolLookup, functionParameterCounts, functionParameterNames, functionParameterTypes, parameterStarts, declarationEnds)
    appendParameterOffsets(functionParameterCounts, parameterStarts)
    symbolLookup = buildSymbolLookup(functionNames, symbolKinds)
    requireUniqueSymbols(symbolLookup, functionNames, symbolKinds, symbolLocations)
    let lookupPosition = 0
    while lookupPosition < symbolLookup.length {
        functionReturnTypes.add(symbolLookup[lookupPosition])
        lookupPosition = lookupPosition + 1
    }

    let output: List<Text> = []
    let globals: List<Text> = []
    let marker = 0
    while marker < parallelMarkers.length {
        globals.add(parallelMarkers[marker])
        marker = marker + 1
    }
    threadValidateEntries(globals, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterTypes)
    output.add("; Generated by the compiler written in Minyar.\n\n")
    appendLiteralDeclarations(output, tokenKinds, tokenTexts, "", (features / 4 % 2) != 0)

    appendRuntimeDeclarations(output, features)
    let noStats: List<Integer> = []
    let mainFunction = findIndexedSymbol(symbolLookup, functionNames, symbolKinds, "main", 1)
    if topLevelStatements && mainFunction >= 0 {
        fail(describeLocation(symbolLocations[mainFunction]) + ": a program cannot combine top-level statements with function main()")
    }
    compileModuleConstants(newCompilerContext(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes), output, globals)
    let hasNative = compileFunctions(newCompilerContext(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes), output, globals, stackOwnerLimit, "", noStats)
    if mainFunction < 0 {
        compileTopLevel(newCompilerContext(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes), output, globals, "", noStats)
    }
    if (features / 1 % 2) != 0 {
        compileClosureBodies(newCompilerContext(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes), output, globals, stackOwnerLimit)
        finishCallbackGraph(functionReturnTypes, functionParameterCounts, functionParameterTypes)
    }
    checkParallelCalls(globals)
    finishCycleFixups(output, functionReturnTypes, functionParameterCounts, functionParameterTypes)
    if stackOwnerLimit > 0 {
        output.add("declare void @minyar_rc_enter_stack_v1(ptr, ptr, i64)\n")
        output.add("declare void @minyar_rc_leave_stack_v1(ptr)\n")
    }
    if (features / 4 % 2) != 0 {
        threadCheckGraph(output, globals)
        threadAppendABI(output, globals, functionNames, symbolKinds, functionReturnTypes, features / 8 % 2 != 0)
    }
    if hasNative { appendNativeDeclarations(output) }
    if globals.length == 0 { return output }
    let globalCode = joinText(globals)
    if hasGlobalDeclarations(globals) {
        let declarations: List<Text> = []
        let declarationPiece = 0
        while declarationPiece < output.length {
            let piece = output[declarationPiece]
            if startsDeclaration(piece) && piece[piece.length - 1] == '\n' {
                deduplicateGlobalDeclarations(piece, declarations)
            }
            declarationPiece = declarationPiece + 1
        }
        globalCode = deduplicateGlobalDeclarations(globalCode, declarations)
    }
    output.add(globalCode)
    return output
}

function compileProgram(source: Text): Text {
    let tokenKinds: List<Integer> = []
    let tokenTexts: List<Text> = []
    let tokenLines = newSourceMap()
    tokenize(source, tokenKinds, tokenTexts, tokenLines)
    let scannedStarts: List<Integer> = []
    let scannedEnds: List<Integer> = []
    return joinText(compileTokens(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds, 0))
}
