function characterIsDigit(character: Character): Boolean {
    return character >= '0' && character <= '9'
}

function characterIsHexDigit(character: Character): Boolean {
    return characterIsDigit(character) || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F')
}

function hexDigitValue(character: Character): Integer {
    let digits = "0123456789abcdef"
    let lower = character
    if character >= 'A' && character <= 'F' {
        lower = digits[10 + findCharacter("ABCDEF", character)]
    }
    return findCharacter(digits, lower)
}

function findCharacter(text: Text, wanted: Character): Integer {
    let position = 0
    while position < text.length {
        if text[position] == wanted {
            return position
        }
        position = position + 1
    }
    return -1
}

function characterIsLetter(character: Character): Boolean {
    let lowercase = character >= 'a' && character <= 'z'
    let uppercase = character >= 'A' && character <= 'Z'
    return lowercase || uppercase
}

function characterIsWhitespace(character: Character): Boolean {
    return character == ' ' || character == '\n' || character == '\r' || character == '\t'
}

function sourceLocation(line: Integer, column: Integer): Text {
    return Text(line) + ", column " + Text(column)
}

function addToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, kind: Integer, text: Text, line: Text) {
    tokenKinds.add(kind)
    tokenTexts.add(text)
    tokenLines.add(line)
}

function lineCanEndStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>): Boolean {
    let result = false
    if tokenKinds.length > 0 {
        let last = tokenKinds.length - 1
        let kind = tokenKinds[last]
        if kind == 1 || kind == 2 || kind == 3 || kind == 5 || kind == 7 {
            result = true
        } else {
            if kind == 4 {
                let text = tokenTexts[last]
                result = text == ")" || text == "]" || text == "}"
            }
        }
    }
    return result
}

function tokenize(source: Text, tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>) {
    let position = 0
    let line = 1
    let lineStart = 0
    let length = source.length
    // UTF-8 permits a leading byte-order mark. Treat it as an encoding marker,
    // never as an invisible punctuation token in a later diagnostic.
    if length > 0 && source.slice(0, 1) == "﻿" {
        position = 1
    }

    while position < length {
        let character = source[position]

        if characterIsWhitespace(character) {
            if character == '\n' {
                if lineCanEndStatement(tokenKinds, tokenTexts) {
                    addToken(tokenKinds, tokenTexts, tokenLines, 6, "end of line", sourceLocation(line, position - lineStart + 1))
                }
                line = line + 1
                lineStart = position + 1
            }
            position = position + 1
        } else {
            if character == '/' && position + 1 < length && source[position + 1] == '/' {
                position = position + 2
                while position < length && source[position] != '\n' {
                    position = position + 1
                }
            } else {
                if character == '/' && position + 1 < length && source[position + 1] == '*' {
                    let commentLine = line
                    let commentColumn = position - lineStart + 1
                    position = position + 2
                    while position + 1 < length && !(source[position] == '*' && source[position + 1] == '/') {
                        if source[position] == '\n' {
                            line = line + 1
                            lineStart = position + 1
                        }
                        position = position + 1
                    }
                    if position + 1 >= length {
                        fail("line " + sourceLocation(commentLine, commentColumn) + ": block comment is missing its closing */")
                    }
                    position = position + 2
                } else {
                    if characterIsLetter(character) || character == '_' {
                        let start = position
                        let tokenLine = line
                        let tokenColumn = position - lineStart + 1
                        while position < length && (characterIsLetter(source[position]) || characterIsDigit(source[position]) || source[position] == '_') {
                            position = position + 1
                        }
                        let name = source.slice(start, position)
                        addToken(tokenKinds, tokenTexts, tokenLines, 1, name, sourceLocation(tokenLine, tokenColumn))
                    } else {
                        if characterIsDigit(character) {
                            let start = position
                            let tokenLine = line
                            let tokenColumn = position - lineStart + 1
                            while position < length && characterIsDigit(source[position]) {
                                position = position + 1
                            }
                            let numberKind = 2
                            let hexValue = -1
                            if character == '0' && position == start + 1 && position + 1 < length && source[position] == 'x' && characterIsHexDigit(source[position + 1]) {
                                position = position + 1
                                hexValue = 0
                                while position < length && characterIsHexDigit(source[position]) {
                                    let digit = hexDigitValue(source[position])
                                    if hexValue > (9223372036854775807 - digit) / 16 {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Integer literal is outside the supported range")
                                    }
                                    hexValue = hexValue * 16 + digit
                                    position = position + 1
                                }
                            }
                            // A Float needs digits on both sides of its point, so
                            // ranges such as 0..count remain two Integer tokens.
                            if numberKind == 2 && position + 1 < length && source[position] == '.' && characterIsDigit(source[position + 1]) {
                                numberKind = 7
                                position = position + 1
                                while position < length && characterIsDigit(source[position]) {
                                    position = position + 1
                                }
                                if position < length && (source[position] == 'e' || source[position] == 'E') {
                                    position = position + 1
                                    if position < length && (source[position] == '+' || source[position] == '-') {
                                        position = position + 1
                                    }
                                    if position >= length || !characterIsDigit(source[position]) {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": a Float exponent needs digits, as in 1.5e3")
                                    }
                                    while position < length && characterIsDigit(source[position]) {
                                        position = position + 1
                                    }
                                }
                            }
                            let digits = source.slice(start, position)
                            if hexValue >= 0 {
                                digits = Text(hexValue)
                            }
                            addToken(tokenKinds, tokenTexts, tokenLines, numberKind, digits, sourceLocation(tokenLine, tokenColumn))
                        } else {
                            if character == '"' {
                                let tokenLine = line
                                let tokenColumn = position - lineStart + 1
                                position = position + 1
                                let chunkStart = position
                                while position < length && source[position] != '"' && source[position] != '\\' {
                                    if source[position] == '\n' {
                                        line = line + 1
                                        lineStart = position + 1
                                    }
                                    position = position + 1
                                }
                                if position >= length {
                                    fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Text literal is missing its closing quote")
                                }
                                let text = ""
                                if position < length && source[position] == '\\' {
                                    let pieces: List<Text> = []
                                    while position < length && source[position] != '"' {
                                        if source[position] == '\\' && position + 1 < length {
                                            if chunkStart < position {
                                                pieces.add(source.slice(chunkStart, position))
                                            }
                                            let escape = source[position + 1]
                                            if escape == '\n' {
                                                line = line + 1
                                                lineStart = position + 2
                                            }
                                            if escape == 'n' {
                                                pieces.add(Text('\n'))
                                            } else {
                                                if escape == 'r' {
                                                    pieces.add(Text('\r'))
                                                } else {
                                                    if escape == 't' {
                                                        pieces.add(Text('\t'))
                                                    } else {
                                                        pieces.add(Text(escape))
                                                    }
                                                }
                                            }
                                            position = position + 2
                                            chunkStart = position
                                        } else {
                                            if source[position] == '\n' {
                                                line = line + 1
                                                lineStart = position + 1
                                            }
                                            position = position + 1
                                        }
                                    }
                                    if position >= length {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Text literal is missing its closing quote")
                                    }
                                    if chunkStart < position {
                                        pieces.add(source.slice(chunkStart, position))
                                    }
                                    text = joinText(pieces)
                                } else {
                                    text = source.slice(chunkStart, position)
                                }
                                position = position + 1
                                addToken(tokenKinds, tokenTexts, tokenLines, 3, text, sourceLocation(tokenLine, tokenColumn))
                            } else {
                                if character > '~' {
                                    fail("line " + Text(line) + ", column " + Text(position - lineStart + 1) + ": names must use ASCII letters, digits, and '_'; found non-ASCII character '" + Text(character) + "'")
                                }
                                if character == '\'' {
                                    let tokenLine = line
                                    let tokenColumn = position - lineStart + 1
                                    position = position + 1
                                    if position >= length {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Character literal is missing its value and closing quote")
                                    }
                                    let value = source[position]
                                    if value == '\\' {
                                        position = position + 1
                                        if position >= length {
                                            fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Character literal has an unfinished escape")
                                        }
                                        let escape = source[position]
                                        if escape == 'n' {
                                            value = '\n'
                                        } else {
                                            if escape == 'r' {
                                                value = '\r'
                                            } else {
                                                if escape == 't' {
                                                    value = '\t'
                                                } else {
                                                    value = escape
                                                }
                                            }
                                        }
                                    }
                                    if source[position] == '\n' {
                                        line = line + 1
                                        lineStart = position + 1
                                    }
                                    position = position + 1
                                    if position >= length || source[position] != '\'' {
                                        fail("line " + sourceLocation(tokenLine, tokenColumn) + ": Character literal must contain exactly one character and a closing quote")
                                    }
                                    position = position + 1
                                    addToken(tokenKinds, tokenTexts, tokenLines, 5, Text(value), sourceLocation(tokenLine, tokenColumn))
                                } else {
                                    let punctuation = Text(character)
                                    if position + 1 < length {
                                        let next = source[position + 1]
                                        let doubled = false
                                        if next == '=' {
                                            doubled = character == '=' || character == '!' || character == '<' || character == '>' || character == '+' || character == '-' || character == '*' || character == '/' || character == '%'
                                        } else {
                                            doubled = (character == '&' && next == '&') || (character == '|' && next == '|') || (character == '<' && next == '<') || (character == '>' && next == '>') || (character == '.' && next == '.')
                                        }
                                        if doubled {
                                            punctuation = punctuation + Text(next)
                                            position = position + 1
                                        }
                                    }
                                    let punctuationKind = 4
                                    if punctuation == ";" {
                                        punctuationKind = 6
                                    }
                                    addToken(tokenKinds, tokenTexts, tokenLines, punctuationKind, punctuation, sourceLocation(line, position - lineStart + 1))
                                    position = position + 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    addToken(tokenKinds, tokenTexts, tokenLines, 0, "", sourceLocation(line, position - lineStart + 1))
}

function describeLocation(location: Text): Text {
    if location.length > 0 && location[0] >= '0' && location[0] <= '9' {
        return "line " + location
    }
    return location
}

function escapeLLVMText(text: Text): Text {
    let pieces: List<Text> = []
    let chunkStart = 0
    let changed = false
    let position = 0
    while position < text.length {
        let character = text[position]
        let replacement = ""
        if character == '\n' {
            replacement = "\\0A"
        } else {
            if character == '\r' {
                replacement = "\\0D"
            } else {
                if character == '\t' {
                    replacement = "\\09"
                } else {
                    if character == '"' {
                        replacement = "\\22"
                    } else {
                        if character == '\\' {
                            replacement = "\\5C"
                        }
                    }
                }
            }
        }
        if replacement != "" {
            if chunkStart < position {
                pieces.add(text.slice(chunkStart, position))
            }
            pieces.add(replacement)
            changed = true
            chunkStart = position + 1
        }
        position = position + 1
    }
    if !changed {
        return text
    }
    if chunkStart < position {
        pieces.add(text.slice(chunkStart, position))
    }
    return joinText(pieces)
}

function tokenIs(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: List<Integer>, expected: Text): Boolean {
    let kind = tokenKinds[cursor[0]]
    return kind != 2 && kind != 3 && kind != 5 && kind != 7 && tokenTexts[cursor[0]] == expected
}

function expectToken(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, cursor: List<Integer>, expected: Text) {
    if !tokenIs(tokenKinds, tokenTexts, cursor, expected) {
        fail(describeLocation(tokenLines[cursor[0]]) + ": expected '" + expected + "', found '" + tokenTexts[cursor[0]] + "'")
    }
    cursor[0] = cursor[0] + 1
}

function skipTerminators(tokenKinds: List<Integer>, cursor: List<Integer>) {
    while tokenKinds[cursor[0]] == 6 {
        cursor[0] = cursor[0] + 1
    }
}

function finishStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, cursor: List<Integer>) {
    if tokenKinds[cursor[0]] == 6 {
        skipTerminators(tokenKinds, cursor)
    } else {
        if !tokenIs(tokenKinds, tokenTexts, cursor, "}") {
            fail(describeLocation(tokenLines[cursor[0]]) + ": unexpected '" + tokenTexts[cursor[0]] + "'; start the next statement on a new line")
        }
    }
}

function simpleTypeCode(name: Text): Integer {
    let code = 0
    if name == "Integer" {
        code = 1
    } else {
        if name == "Text" {
            code = 2
        } else {
            if name == "Character" {
                code = 3
            } else {
                if name == "Boolean" {
                    code = 4
                } else {
                    if name == "Nothing" {
                        code = 5
                    }
                    if name == "Float" {
                        code = 7
                    }
                    if name == "Bytes" {
                        code = 8
                    }
                }
            }
        }
    }
    return code
}

function findSymbol(symbolNames: List<Text>, symbolKinds: List<Integer>, name: Text, kind: Integer): Integer {
    let position = 0
    let found = -1
    while position < symbolNames.length && found == -1 {
        if symbolKinds[position] == kind && symbolNames[position] == name {
            found = position
        }
        position = position + 1
    }
    return found
}

function compareText(left: Text, right: Text): Integer {
    let shared = left.length
    if right.length < shared {
        shared = right.length
    }
    let position = 0
    while position < shared && left[position] == right[position] {
        position = position + 1
    }
    if position < shared {
        if left[position] < right[position] {
            return -1
        }
        return 1
    }
    if left.length < right.length {
        return -1
    }
    if left.length > right.length {
        return 1
    }
    return 0
}

function compareSymbol(symbolNames: List<Text>, symbolKinds: List<Integer>, left: Integer, right: Integer): Integer {
    let order = compareText(symbolNames[left], symbolNames[right])
    if order == 0 {
        if symbolKinds[left] < symbolKinds[right] {
            order = -1
        } else {
            if symbolKinds[left] > symbolKinds[right] {
                order = 1
            }
        }
    }
    return order
}

function siftSymbolLookup(lookup: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, start: Integer, count: Integer) {
    let root = start
    let searching = true
    while searching {
        let child = root * 2 + 1
        if child >= count {
            searching = false
        } else {
            let selected = child
            if child + 1 < count && compareSymbol(symbolNames, symbolKinds, lookup[child], lookup[child + 1]) < 0 {
                selected = child + 1
            }
            if compareSymbol(symbolNames, symbolKinds, lookup[root], lookup[selected]) < 0 {
                let held = lookup[root]
                lookup[root] = lookup[selected]
                lookup[selected] = held
                root = selected
            } else {
                searching = false
            }
        }
    }
}

function buildSymbolLookup(symbolNames: List<Text>, symbolKinds: List<Integer>): List<Integer> {
    let lookup: List<Integer> = []
    let position = 0
    while position < symbolNames.length {
        lookup.add(position)
        position = position + 1
    }
    let start = lookup.length / 2
    while start > 0 {
        start = start - 1
        siftSymbolLookup(lookup, symbolNames, symbolKinds, start, lookup.length)
    }
    let end = lookup.length
    while end > 1 {
        end = end - 1
        let held = lookup[0]
        lookup[0] = lookup[end]
        lookup[end] = held
        siftSymbolLookup(lookup, symbolNames, symbolKinds, 0, end)
    }
    return lookup
}

function requireUniqueSymbols(lookup: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>) {
    let position = 1
    while position < lookup.length {
        let previous = lookup[position - 1]
        let current = lookup[position]
        if symbolKinds[previous] == symbolKinds[current] && symbolNames[previous] == symbolNames[current] {
            let duplicate = current
            if previous > current { duplicate = previous }
            fail(describeLocation(symbolLocations[duplicate]) + ": module declares '" + readableDeclarationName(symbolNames[current]) + "' more than once")
        }
        position = position + 1
    }
}

function findIndexedSymbol(lookup: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, name: Text, kind: Integer): Integer {
    let low = 0
    let high = lookup.length
    while low < high {
        let middle = low + (high - low) / 2
        let symbol = lookup[middle]
        let order = compareText(symbolNames[symbol], name)
        if order == 0 {
            if symbolKinds[symbol] < kind {
                order = -1
            } else {
                if symbolKinds[symbol] > kind {
                    order = 1
                }
            }
        }
        if order < 0 {
            low = middle + 1
        } else {
            high = middle
        }
    }
    if low < lookup.length {
        let symbol = lookup[low]
        if symbolKinds[symbol] == kind && symbolNames[symbol] == name {
            return symbol
        }
    }
    return -1
}

function findCompiledSymbol(symbolNames: List<Text>, symbolKinds: List<Integer>, symbolReturnTypes: List<Integer>, name: Text, kind: Integer): Integer {
    let count = symbolNames.length
    let low = 0
    let high = count
    while low < high {
        let middle = low + (high - low) / 2
        let symbol = symbolReturnTypes[count + middle]
        let order = compareText(symbolNames[symbol], name)
        if order == 0 {
            if symbolKinds[symbol] < kind {
                order = -1
            } else {
                if symbolKinds[symbol] > kind {
                    order = 1
                }
            }
        }
        if order < 0 {
            low = middle + 1
        } else {
            high = middle
        }
    }
    if low < count {
        let symbol = symbolReturnTypes[count + low]
        if symbolKinds[symbol] == kind && symbolNames[symbol] == name {
            return symbol
        }
    }
    return -1
}

function takeType(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, cursor: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>): Integer {
    let name = tokenTexts[cursor[0]]
    let code = simpleTypeCode(name)
    if name == "List" {
        // Take every nested opener first: one '>>' token can close two Lists.
        let depth = 0
        while tokenKinds[cursor[0]] == 1 && tokenTexts[cursor[0]] == "List" {
            cursor[0] = cursor[0] + 1
            expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "<")
            depth = depth + 1
        }
        code = depth * 100000 + takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
        while depth > 0 {
            if depth >= 2 && tokenIs(tokenKinds, tokenTexts, cursor, ">>") {
                cursor[0] = cursor[0] + 1
                depth = depth - 2
            } else {
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ">")
                depth = depth - 1
            }
        }
    } else {
        if code == 0 {
            let record = findSymbol(symbolNames, symbolKinds, name, 2)
            if record < 0 {
                fail(describeLocation(tokenLines[cursor[0]]) + ": unknown type '" + name + "'")
            }
            code = 1000 + record
        }
        cursor[0] = cursor[0] + 1
    }
    return code
}

function takeValueType(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, cursor: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>): Integer {
    let type = takeType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
    if type == 5 {
        fail("Nothing cannot be used as a value type")
    }
    return type
}

function skipDeclaration(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: List<Integer>) {
    let position = cursor[0]
    let kind = tokenKinds[position]
    while kind != 0 && !(kind == 4 && tokenTexts[position] == "{") {
        position = position + 1
        kind = tokenKinds[position]
    }
    if kind == 0 {
        fail("a declaration is missing its '{ ... }' body")
    }
    position = position + 1
    let depth = 1
    kind = tokenKinds[position]
    while depth > 0 && kind != 0 {
        if kind == 4 {
            let token = tokenTexts[position]
            if token == "{" {
                depth = depth + 1
            }
            if token == "}" {
                depth = depth - 1
            }
        }
        position = position + 1
        kind = tokenKinds[position]
    }
    cursor[0] = position
    if depth > 0 {
        fail("a declaration is missing its closing '}'")
    }
}

function skipTopLevelStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, cursor: List<Integer>) {
    let roundDepth = 0
    let squareDepth = 0
    let curlyDepth = 0
    let position = cursor[0]
    let kind = tokenKinds[position]
    while kind != 0 && !(kind == 6 && roundDepth == 0 && squareDepth == 0 && curlyDepth == 0) {
        if kind == 4 {
            let token = tokenTexts[position]
            if token == "(" {
                roundDepth = roundDepth + 1
            }
            if token == ")" {
                roundDepth = roundDepth - 1
            }
            if token == "[" {
                squareDepth = squareDepth + 1
            }
            if token == "]" {
                squareDepth = squareDepth - 1
            }
            if token == "{" {
                curlyDepth = curlyDepth + 1
            }
            if token == "}" {
                curlyDepth = curlyDepth - 1
            }
        }
        position = position + 1
        kind = tokenKinds[position]
    }
    cursor[0] = position
    skipTerminators(tokenKinds, cursor)
}

function discoverRecordNames(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>, declarationEnds: List<Integer>): Boolean {
    let cursor: List<Integer> = []
    cursor.add(0)
    let topLevelStatements = false
    skipTerminators(tokenKinds, cursor)
    while tokenKinds[cursor[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
            let name = tokenTexts[cursor[0] + 1]
            let index = symbolNames.length
            symbolNames.add(name)
            symbolKinds.add(2)
            symbolLocations.add(tokenLines[cursor[0] + 1])
            symbolReturnTypes.add(1000 + index)
            symbolParameterCounts.add(0)
        }
        if tokenIs(tokenKinds, tokenTexts, cursor, "constant") {
            addConstantSymbol(tokenTexts, tokenLines, cursor[0], symbolNames, symbolKinds, symbolLocations, symbolReturnTypes, symbolParameterCounts)
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            declarationEnds.add(cursor[0])
        } else {
        if tokenIs(tokenKinds, tokenTexts, cursor, "record") || tokenIs(tokenKinds, tokenTexts, cursor, "function") {
            skipDeclaration(tokenKinds, tokenTexts, cursor)
            declarationEnds.add(cursor[0])
        } else {
            topLevelStatements = true
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
        }
        }
        skipTerminators(tokenKinds, cursor)
    }
    return topLevelStatements
}

function recordScannedDeclarations(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, scannedStarts: List<Integer>, scannedEnds: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>, declarationEnds: List<Integer>): Boolean {
    let topLevelStatements = false
    let scanned = 0
    let declaration = 0
    let cursor: List<Integer> = []
    cursor.add(0)
    while scanned < scannedStarts.length {
        let start = scannedStarts[scanned]
        if start < 0 {
            topLevelStatements = true
        } else {
            cursor[0] = start
            if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
                let index = symbolNames.length
                symbolNames.add(tokenTexts[start + 1])
                symbolKinds.add(2)
                symbolLocations.add(tokenLines[start + 1])
                symbolReturnTypes.add(1000 + index)
                symbolParameterCounts.add(0)
            }
            if tokenIs(tokenKinds, tokenTexts, cursor, "constant") {
                addConstantSymbol(tokenTexts, tokenLines, start, symbolNames, symbolKinds, symbolLocations, symbolReturnTypes, symbolParameterCounts)
            }
            declarationEnds.add(scannedEnds[declaration])
            declaration = declaration + 1
        }
        scanned = scanned + 1
    }
    return topLevelStatements
}

// Constants are symbols of kind 3. discoverDeclarations fills in the type and
// stores the literal's token position where functions keep a parameter count.
function addConstantSymbol(tokenTexts: List<Text>, tokenLines: List<Text>, start: Integer, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>) {
    symbolNames.add(tokenTexts[start + 1])
    symbolKinds.add(3)
    symbolLocations.add(tokenLines[start + 1])
    symbolReturnTypes.add(0)
    symbolParameterCounts.add(0)
}

// A constant's value is one literal, optionally negated. Its type comes from
// the literal and must match an optional annotation.
function takeConstant(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, cursor: List<Integer>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLookup: List<Integer>, symbolReturnTypes: List<Integer>, symbolParameterCounts: List<Integer>) {
    expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "constant")
    let name = tokenTexts[cursor[0]]
    let location = tokenLines[cursor[0]]
    if tokenKinds[cursor[0]] != 1 {
        fail(describeLocation(location) + ": expected a name after constant")
    }
    let constant = findIndexedSymbol(symbolLookup, symbolNames, symbolKinds, name, 3)
    cursor[0] = cursor[0] + 1
    let declared = 0
    if tokenIs(tokenKinds, tokenTexts, cursor, ":") {
        cursor[0] = cursor[0] + 1
        declared = takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "=")
    let valueStart = cursor[0]
    let literal = cursor[0]
    if tokenIs(tokenKinds, tokenTexts, cursor, "-") {
        literal = literal + 1
    }
    let kind = tokenKinds[literal]
    let type = 0
    if kind == 2 { type = 1 }
    if kind == 7 { type = 7 }
    if literal == valueStart {
        if kind == 3 { type = 2 }
        if kind == 5 { type = 3 }
        if kind == 1 && (tokenTexts[literal] == "true" || tokenTexts[literal] == "false") { type = 4 }
    }
    if type == 0 || (tokenKinds[literal + 1] != 6 && tokenKinds[literal + 1] != 0) {
        fail(describeLocation(location) + ": a constant needs one literal value, such as 16, -2.5, \"text\", 'c', or true")
    }
    if declared != 0 && declared != type {
        fail(describeLocation(location) + ": the value for constant '" + readableDeclarationName(name) + "' is " + describeType(type) + ", not " + describeType(declared))
    }
    symbolReturnTypes[constant] = type
    symbolParameterCounts[constant] = valueStart
    cursor[0] = literal + 1
}

function discoverDeclarations(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, symbolNames: List<Text>, symbolKinds: List<Integer>, symbolLocations: List<Text>, symbolReturnTypes: List<Integer>, symbolLookup: List<Integer>, symbolParameterCounts: List<Integer>, symbolParameterNames: List<Text>, symbolParameterTypes: List<Integer>, parameterStarts: List<Integer>, declarationEnds: List<Integer>) {
    let cursor: List<Integer> = []
    cursor.add(0)
    let declaration = 0
    skipTerminators(tokenKinds, cursor)
    while tokenKinds[cursor[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, cursor, "constant") {
            declaration = declaration + 1
            takeConstant(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds, symbolLookup, symbolReturnTypes, symbolParameterCounts)
        } else {
        if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
            declaration = declaration + 1
            cursor[0] = cursor[0] + 1
            let record = findIndexedSymbol(symbolLookup, symbolNames, symbolKinds, tokenTexts[cursor[0]], 2)
            cursor[0] = cursor[0] + 1
            expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "{")
            skipTerminators(tokenKinds, cursor)
            let count = 0
            let first = symbolParameterNames.length
            parameterStarts[record] = first
            while !tokenIs(tokenKinds, tokenTexts, cursor, "}") {
                let fieldName = tokenTexts[cursor[0]]
                let previous = 0
                let duplicate = false
                while previous < count {
                    if symbolParameterNames[first + previous] == fieldName {
                        duplicate = true
                    }
                    previous = previous + 1
                }
                if duplicate {
                    fail(describeLocation(tokenLines[cursor[0]]) + ": record '" + symbolNames[record] + "' declares '" + fieldName + "' twice")
                }
                symbolParameterNames.add(fieldName)
                cursor[0] = cursor[0] + 1
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ":")
                symbolParameterTypes.add(takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds))
                count = count + 1
                if tokenIs(tokenKinds, tokenTexts, cursor, ",") {
                    cursor[0] = cursor[0] + 1
                }
                skipTerminators(tokenKinds, cursor)
            }
            symbolParameterCounts[record] = count
            cursor[0] = cursor[0] + 1
        } else {
            if tokenIs(tokenKinds, tokenTexts, cursor, "function") {
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "function")
                let functionName = tokenTexts[cursor[0]]
                if isBuiltinName(readableDeclarationName(functionName)) {
                    fail(describeLocation(tokenLines[cursor[0]]) + ": '" + readableDeclarationName(functionName) + "' is a built-in function; choose another name")
                }
                symbolNames.add(functionName)
                symbolKinds.add(1)
                symbolLocations.add(tokenLines[cursor[0]])
                parameterStarts.add(symbolParameterNames.length)
                cursor[0] = cursor[0] + 1
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "(")

                let parameterCount = 0
                while !tokenIs(tokenKinds, tokenTexts, cursor, ")") {
                    symbolParameterNames.add(tokenTexts[cursor[0]])
                    cursor[0] = cursor[0] + 1
                    expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ":")
                    symbolParameterTypes.add(takeValueType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds))
                    parameterCount = parameterCount + 1
                    if tokenIs(tokenKinds, tokenTexts, cursor, ",") {
                        cursor[0] = cursor[0] + 1
                    }
                }
                symbolParameterCounts.add(parameterCount)
                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, ")")

                let returnType = 5
                if functionName == "main" {
                    returnType = 1
                }
                if tokenIs(tokenKinds, tokenTexts, cursor, ":") {
                    cursor[0] = cursor[0] + 1
                    returnType = takeType(tokenKinds, tokenTexts, tokenLines, cursor, symbolNames, symbolKinds)
                }
                if functionName == "main" {
                    if parameterCount != 0 {
                        fail("main expects no parameters; use argument() to read program arguments")
                    }
                    if returnType != 1 {
                        fail("main must return Integer")
                    }
                }
                symbolReturnTypes.add(returnType)

                expectToken(tokenKinds, tokenTexts, tokenLines, cursor, "{")
                cursor[0] = declarationEnds[declaration]
                declaration = declaration + 1
            } else {
                skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            }
        }
        }
        skipTerminators(tokenKinds, cursor)
    }
}

function addOutput(output: List<Text>, piece: Text) {
    output.add(piece)
}

function readableDeclarationName(name: Text): Text {
    let prefix = "minyar_module_"
    let matches = name.length > prefix.length
    let position = 0
    while position < prefix.length && matches {
        if name[position] != prefix[position] {
            matches = false
        }
        position = position + 1
    }
    if matches {
        while position < name.length && name[position] != '_' {
            position = position + 1
        }
        if position < name.length {
            position = position + 1
            let readable = ""
            while position < name.length {
                readable = readable + Text(name[position])
                position = position + 1
            }
            return readable
        }
    }
    return name
}

function isListType(type: Integer): Boolean {
    return type >= 100000
}

function isRecordType(type: Integer): Boolean {
    return type >= 1000 && type < 100000
}

function listElementType(type: Integer): Integer {
    return type - 100000
}

function isReferenceType(type: Integer): Boolean {
    return type == 2 || type == 8 || type >= 1000
}

function llvmType(type: Integer): Text {
    let result = "void"
    if type == 1 {
        result = "i64"
    } else {
        if isReferenceType(type) {
            result = "ptr"
        } else {
            if type == 3 {
                result = "i32"
            } else {
                if type == 4 {
                    result = "i1"
                }
                if type == 7 {
                    result = "double"
                }
            }
        }
    }
    return result
}

function valueName(textState: List<Text>, temporary: Integer): Text {
    let slot = temporary + 2
    while textState.length <= slot {
        textState.add("%value." + Text(textState.length - 2))
    }
    return textState[slot]
}

function newTemporary(state: List<Integer>): Integer {
    let temporary = state[1]
    state[1] = temporary + 1
    return temporary
}

function newLabel(state: List<Integer>): Integer {
    let label = state[2]
    state[2] = label + 1
    return label
}

function setType(resultType: List<Integer>, type: Integer) {
    resultType[0] = type
    if resultType.length > 1 {
        resultType[1] = -1
    }
}

function findLocal(localNames: List<Text>, localLengths: List<Integer>, state: List<Integer>, name: Text): Integer {
    let position = state[3] - 1
    let length = name.byteLength
    let found = -1
    while position >= 0 && found == -1 {
        if localLengths[position] == length && localNames[position] == name {
            found = position
        }
        position = position - 1
    }
    return found
}

function addLocal(localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, name: Text, type: Integer, id: Integer) {
    let position = state[3]
    if position < localNames.length {
        localNames[position] = name
        localTypes[position] = type
        localIds[position] = id
        localLengths[position] = name.byteLength
    } else {
        localNames.add(name)
        localTypes.add(type)
        localIds.add(id)
        localLengths.add(name.byteLength)
    }
    state[3] = position + 1
}

function findFunction(functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, name: Text): Integer {
    return findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, name, 1)
}

function functionParameterOffset(functionParameterCounts: List<Integer>, functionIndex: Integer): Integer {
    return functionParameterCounts[functionParameterCounts.length / 2 + functionIndex]
}

function appendParameterOffsets(functionParameterCounts: List<Integer>, parameterStarts: List<Integer>) {
    let position = 0
    while position < parameterStarts.length {
        functionParameterCounts.add(parameterStarts[position])
        position = position + 1
    }
}

function findRecordField(functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, recordType: Integer, fieldName: Text): Integer {
    let record = recordType - 1000
    let first = functionParameterOffset(functionParameterCounts, record)
    let position = 0
    let found = -1
    while position < functionParameterCounts[record] && found == -1 {
        if functionParameterNames[first + position] == fieldName {
            found = first + position
        }
        position = position + 1
    }
    return found
}

// New records and List literals cannot refer to themselves before construction
// finishes. A first heap cycle therefore needs a mutable List edge L -> T with
// an existing path T -> L. Reject exactly the mutations whose declared types
// permit that return path; immutable recursive construction remains legal.
// The first two symbol-count blocks of returnTypes hold return types and the
// lookup index. Its tail caches proven-safe List types for this compilation.
function checkListMutation(listType: Integer, counts: List<Integer>, fields: List<Integer>, returnTypes: List<Integer>) {
    let base = listElementType(listType)
    while isListType(base) {
        base = listElementType(base)
    }
    if !isRecordType(base) {
        return
    }
    let recordCount = counts.length / 2
    let cached = recordCount * 2
    while cached < returnTypes.length {
        if returnTypes[cached] == listType {
            return
        }
        cached = cached + 1
    }
    let visited: List<Boolean> = []
    let index = 0
    while index < recordCount {
        visited.add(false)
        index = index + 1
    }
    let pending: List<Integer> = []
    pending.add(listElementType(listType))
    index = 0
    while index < pending.length {
        let type = pending[index]
        index = index + 1
        while isListType(type) {
            if type == listType {
                fail("this List mutation could create a reference cycle; construct a new List instead")
            }
            type = listElementType(type)
        }
        if isRecordType(type) {
            let record = type - 1000
            if !visited[record] {
                visited[record] = true
                let first = functionParameterOffset(counts, record)
                let field = 0
                while field < counts[record] {
                    pending.add(fields[first + field])
                    field = field + 1
                }
            }
        }
    }
    returnTypes.add(listType)
}

function requireType(tokenLines: List<Text>, state: List<Integer>, actual: Integer, expected: Integer, explanation: Text) {
    if actual != expected {
        fail(describeLocation(tokenLines[state[0]]) + ": " + explanation)
    }
}

function valueAsListSlot(output: List<Text>, textState: List<Text>, state: List<Integer>, value: Text, type: Integer): Text {
    let result = value
    if type != 1 {
        let temporary = newTemporary(state)
        if isReferenceType(type) {
            addOutput(output, "  %value.")
            addOutput(output, Text(temporary))
            addOutput(output, " = ptrtoint ptr ")
            addOutput(output, value)
            addOutput(output, " to i64\n")
        } else {
            addOutput(output, "  %value.")
            addOutput(output, Text(temporary))
            if type == 7 {
                addOutput(output, " = bitcast double ")
            } else {
                addOutput(output, " = zext ")
                addOutput(output, llvmType(type))
                addOutput(output, " ")
            }
            addOutput(output, value)
            addOutput(output, " to i64\n")
        }
        result = valueName(textState, temporary)
    }
    return result
}

// List elements and record fields are stored in i64 slots. Recover the typed
// SSA value that valueAsListSlot encoded.
function slotAsValue(output: List<Text>, textState: List<Text>, state: List<Integer>, raw: Text, type: Integer): Text {
    if type == 1 {
        return raw
    }
    let value = valueName(textState, newTemporary(state))
    addOutput(output, "  ")
    addOutput(output, value)
    if isReferenceType(type) {
        addOutput(output, " = inttoptr i64 ")
        addOutput(output, raw)
        addOutput(output, " to ptr\n")
    } else {
        if type == 7 {
            addOutput(output, " = bitcast i64 ")
            addOutput(output, raw)
            addOutput(output, " to double\n")
        } else {
            addOutput(output, " = trunc i64 ")
            addOutput(output, raw)
            addOutput(output, " to ")
            addOutput(output, llvmType(type))
            addOutput(output, "\n")
        }
    }
    return value
}

function keepReference(output: List<Text>, state: List<Integer>, value: Text, type: Integer): Integer {
    let owner = -1
    if isReferenceType(type) {
        owner = output.length
        state[6] = 1
        state[7] = state[7] + 1
        addOutput(output, "  call void @minyar_rc_keep(ptr ")
        addOutput(output, value)
        addOutput(output, ")\n")
    }
    return owner
}

function markOwner(resultType: List<Integer>, owner: Integer) {
    if resultType.length == 1 {
        resultType.add(owner)
    } else {
        resultType[1] = owner
    }
}

function ownResult(output: List<Text>, state: List<Integer>, value: Text, resultType: List<Integer>) {
    if isReferenceType(resultType[0]) {
        markOwner(resultType, keepReference(output, state, value, resultType[0]))
    }
}

// A producer returns one owned reference. A consuming destination can take
// that exact reference, eliminating temporary registration and a retain/drop
// pair. Borrowed values never carry this token. No heap uniqueness is assumed.
function takeResult(output: List<Text>, state: List<Integer>, value: Text, resultType: List<Integer>): Boolean {
    if isReferenceType(resultType[0]) && resultType.length > 1 {
        let owner = resultType[1]
        if takeOwner(output, state, value, owner) {
            resultType[1] = -1
            return true
        }
    }
    return false
}

function takeOwner(output: List<Text>, state: List<Integer>, value: Text, owner: Integer): Boolean {
    if owner == -1 { return false }
    if output[owner] == "  ; minyar-owned-local-transfer\n" {
        // Delay clearing the slot until after the right operand has run. This
        // preserves expressions such as x = x + x while still handing the
        // left ownership count to the consuming join.
        addOutput(output, "  call void @minyar_rc_local_move(i64 ")
        addOutput(output, output[owner + 1])
        addOutput(output, ")\n")
        output[owner] = ""
        output[owner + 1] = ""
        return true
    }
    if output[owner] == "  call void @minyar_rc_keep(ptr " && output[owner + 1] == value {
        output[owner] = ""
        output[owner + 1] = ""
        output[owner + 2] = ""
        state[7] = state[7] - 1
        return true
    }
    return false
}

// LLVM local identifiers and runtime ownership slots are independent. Only
// bindings that acquire an owner need a slot. Generation tags reuse the map
// between functions without clearing its high-water capacity each time.
function ownershipSlot(state: List<Integer>, id: Integer): Integer {
    let entry = 12 + id * 2
    while state.length <= entry + 1 {
        state.add(-1)
    }
    if state[entry] != state[9] {
        state[entry] = state[9]
        state[entry + 1] = state[8]
        state[8] = state[8] + 1
    }
    return state[entry + 1]
}

// Negative ownership-map values identify scalar-replaced records. Their
// initializer SSA values are kept in harmless output comments, just as owned
// expression tokens identify editable output pieces elsewhere in this emitter.
function scalarRecordValues(state: List<Integer>, id: Integer): Integer {
    if id < 0 { return -1 }
    let entry = 12 + id * 2
    if entry + 1 < state.length && state[entry] == state[9] && state[entry + 1] < -1 {
        return -2 - state[entry + 1]
    }
    return -1
}

function markScalarRecord(state: List<Integer>, id: Integer, values: Integer) {
    let entry = 12 + id * 2
    while state.length <= entry + 1 { state.add(-1) }
    state[entry] = state[9]
    state[entry + 1] = -2 - values
}

// A let-bound scalar record can be replaced only when every occurrence of its
// name in the remaining lexical scope is a field projection. Reject aliases,
// assignments, argument passing, returns of the object, and shadowing. This is
// deliberately conservative and does not infer anything from return types.
function prepareScalarRecord(tokenKinds: List<Integer>, tokenTexts: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, counts: List<Integer>, fields: List<Integer>, state: List<Integer>, name: Text) {
    let record = findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, tokenTexts[state[0]], 2)
    if record < 0 { return }
    let cost = counts[record] * 8
    if cost == 0 { cost = 8 }
    if cost > 512 - state[11] { return }
    let first = functionParameterOffset(counts, record)
    let field = 0
    while field < counts[record] {
        if isReferenceType(fields[first + field]) { return }
        field = field + 1
    }
    // Charge rejected proofs too, so at most 64 suffix scans run per body.
    state[11] = state[11] + cost
    let cursor: List<Integer> = []
    cursor.add(state[0])
    skipDeclaration(tokenKinds, tokenTexts, cursor)
    let position = cursor[0]
    if tokenKinds[position] != 0 && tokenKinds[position] != 6 && tokenTexts[position] != "}" { return }
    let depth = 0
    let done = false
    while tokenKinds[position] != 0 && !done {
        if tokenKinds[position] == 1 && tokenTexts[position] == name {
            if position + 1 >= tokenTexts.length || tokenTexts[position + 1] != "." { return }
            if position + 3 < tokenTexts.length && tokenKinds[position + 3] == 4 && isAssignmentOperator(tokenTexts[position + 3]) { return }
        }
        if tokenKinds[position] == 4 {
            if tokenTexts[position] == "{" { depth = depth + 1 }
            if tokenTexts[position] == "}" {
                if depth == 0 { done = true } else { depth = depth - 1 }
            }
        }
        position = position + 1
    }
    state[10] = state[4]
}

function rootLocal(output: List<Text>, state: List<Integer>, id: Integer, value: Text, type: Integer) {
    if isReferenceType(type) {
        let owner = ownershipSlot(state, id)
        if owner < 0 { return }
        state[6] = 1
        addOutput(output, "  call void @minyar_rc_local(i64 ")
        addOutput(output, Text(owner))
        addOutput(output, ", ptr ")
        addOutput(output, value)
        addOutput(output, ")\n")
    }
}

function assignReference(output: List<Text>, state: List<Integer>, id: Integer, value: Text, resultType: List<Integer>) {
    if takeResult(output, state, value, resultType) {
        state[6] = 1
        addOutput(output, "  call void @minyar_rc_local_take(i64 ")
        addOutput(output, Text(ownershipSlot(state, id)))
        addOutput(output, ", ptr ")
        addOutput(output, value)
        addOutput(output, ")\n")
    } else {
        rootLocal(output, state, id, value, resultType[0])
    }
}
function borrowReference(output: List<Text>, state: List<Integer>, value: Text, type: Integer) {
    if isReferenceType(type) {
        state[6] = 1
        state[7] = state[7] + 1
        addOutput(output, "  call void @minyar_rc_borrow(ptr ")
        addOutput(output, value)
        addOutput(output, ")\n")
    }
}

function finishStackOwnership(output: List<Text>, slot: Integer, owners: Integer) {
    let stackEntry = "  call void @minyar_stack_enter()\n"
    let prefix = stackEntry + "  call void @minyar_rc_enter(i64 " + Text(owners) + ")\n"
    let entry = stackEntry + "  %rc.stack.header = alloca [64 x i8], align 8\n"
    entry = entry + "  %rc.stack.owners = alloca [" + Text(owners * 2) + " x i64], align 8\n"
    entry = entry + "  call void @minyar_rc_enter_stack_v1(ptr %rc.stack.header, ptr %rc.stack.owners, i64 " + Text(owners) + ")\n"
    output[slot] = entry + output[slot].slice(prefix.length, output[slot].length)
    output[slot - 1] = ") noinline {\nentry:\n"
    let piece = slot + 1
    while piece < output.length {
        if output[piece] == "  call void @minyar_rc_leave()\n" {
            output[piece] = "  call void @minyar_rc_leave_stack_v1(ptr %rc.stack.header)\n"
        }
        piece = piece + 1
    }
}

function finishFunctionEntry(output: List<Text>, slot: Integer, locals: Integer, parameters: Integer, owners: Integer, references: Boolean) {
    let entry: List<Text> = []
    entry.add("  call void @minyar_stack_enter()\n")
    if references {
        entry.add("  call void @minyar_rc_enter(i64 ")
        entry.add(Text(owners))
        entry.add(")\n")
    } else {
        let piece = slot + 1
        while piece < output.length {
            if output[piece] == "  call void @minyar_rc_step()\n" || output[piece] == "  call void @minyar_rc_leave()\n" {
                output[piece] = ""
            }
            piece = piece + 1
        }
    }
    let local = parameters
    while local < locals {
        entry.add("  %local.")
        entry.add(Text(local))
        entry.add(" = alloca i64\n")
        local = local + 1
    }
    output[slot] = joinText(entry)
}

function describeType(type: Integer): Text {
    if type == 1 { return "Integer" }
    if type == 2 { return "Text" }
    if type == 3 { return "Character" }
    if type == 4 { return "Boolean" }
    if type == 5 || type == 6 { return "Nothing" }
    if type == 7 { return "Float" }
    if type == 8 { return "Bytes" }
    if isListType(type) { return "List<" + describeType(listElementType(type)) + ">" }
    if isRecordType(type) { return "a record" }
    return "an unknown type"
}

function isArithmeticOperator(operator: Text): Boolean {
    return operator == "+" || operator == "-" || operator == "*" || operator == "/" || operator == "%"
}

function isBitwiseOperator(operator: Text): Boolean {
    return operator == "&" || operator == "|" || operator == "^" || operator == "<<" || operator == ">>"
}

function comparisonCondition(operator: Text, type: Integer): Text {
    if type == 7 {
        // Ordered comparisons are false for NaN; != is its exact opposite.
        if operator == "==" { return "oeq" }
        if operator == "!=" { return "une" }
        if operator == "<" { return "olt" }
        if operator == ">" { return "ogt" }
        if operator == "<=" { return "ole" }
        return "oge"
    }
    if operator == "==" { return "eq" }
    if operator == "!=" { return "ne" }
    if operator == "<" { return "slt" }
    if operator == ">" { return "sgt" }
    if operator == "<=" { return "sle" }
    return "sge"
}

function emitBinary(output: List<Text>, textState: List<Text>, state: List<Integer>, operator: Text, left: Text, leftType: Integer, leftOwner: Integer, right: Text, rightType: Integer, resultType: List<Integer>, location: Text): Text {
    let at = describeLocation(location) + ": "
    if leftType != rightType {
        let hint = ""
        if (leftType == 1 && rightType == 7) || (leftType == 7 && rightType == 1) {
            hint = "; convert one side with Float(value) or Integer(value)"
        }
        fail(at + "the two sides of '" + operator + "' have different types (" + describeType(leftType) + " and " + describeType(rightType) + ")" + hint)
    }
    if (operator == "==" || operator == "!=") && (isRecordType(leftType) || isListType(leftType) || leftType == 8) {
        fail(at + "records, Lists, and Bytes do not yet support equality")
    }
    if isArithmeticOperator(operator) {
        if leftType != 1 && leftType != 7 && !(operator == "+" && leftType == 2) {
            fail(at + "'" + operator + "' needs Integer or Float operands, not " + describeType(leftType))
        }
    } else {
        if isBitwiseOperator(operator) {
            if leftType != 1 {
                let hint = ""
                if leftType == 4 && (operator == "&" || operator == "|") {
                    hint = "; use " + operator + operator + " for Boolean logic"
                }
                fail(at + "'" + operator + "' needs Integer operands, not " + describeType(leftType) + hint)
            }
        } else {
            if operator == "==" || operator == "!=" {
                if (leftType < 1 || leftType > 4) && leftType != 7 {
                    fail(at + "equality needs two values")
                }
            } else {
                if leftType != 1 && leftType != 3 && leftType != 7 {
                    fail(at + "ordered comparison needs Integer, Float, or Character operands")
                }
            }
        }
    }
    let temporary = newTemporary(state)
    let result = valueName(textState, temporary)

    if operator == "+" && leftType == 2 {
        let runtimeName = "minyar_join_text"
        if takeOwner(output, state, left, leftOwner) {
            runtimeName = "minyar_join_text_take_left"
        }
        addOutput(output, "  ")
        addOutput(output, result)
        addOutput(output, " = call ptr @")
        addOutput(output, runtimeName)
        addOutput(output, "(ptr ")
        addOutput(output, left)
        addOutput(output, ", ptr ")
        addOutput(output, right)
        addOutput(output, ")\n")
        setType(resultType, 2)
    } else {
        if (operator == "==" || operator == "!=") && leftType == 2 {
            addOutput(output, "  ")
            addOutput(output, result)
            addOutput(output, " = call i1 @minyar_texts_are_equal(ptr ")
            addOutput(output, left)
            addOutput(output, ", ptr ")
            addOutput(output, right)
            addOutput(output, ")\n")
            if operator == "!=" {
                let opposite = newTemporary(state)
                addOutput(output, "  %value.")
                addOutput(output, Text(opposite))
                addOutput(output, " = xor i1 ")
                addOutput(output, result)
                addOutput(output, ", true\n")
                result = valueName(textState, opposite)
            }
            setType(resultType, 4)
        } else {
            if leftType == 7 && isArithmeticOperator(operator) {
                // IEEE 754 arithmetic: overflow gives infinity rather than stopping.
                let instruction = "fadd"
                if operator == "-" { instruction = "fsub" }
                if operator == "*" { instruction = "fmul" }
                if operator == "/" { instruction = "fdiv" }
                if operator == "%" { instruction = "frem" }
                addOutput(output, "  ")
                addOutput(output, result)
                addOutput(output, " = ")
                addOutput(output, instruction)
                addOutput(output, " double ")
                addOutput(output, left)
                addOutput(output, ", ")
                addOutput(output, right)
                addOutput(output, "\n")
                setType(resultType, 7)
            } else {
            if operator == "+" || operator == "-" || operator == "*" {
                let operation = "sadd"
                if operator == "-" {
                    operation = "ssub"
                }
                if operator == "*" {
                    operation = "smul"
                }
                addOutput(output, "  %checked.")
                addOutput(output, Text(temporary))
                addOutput(output, " = call { i64, i1 } @llvm.")
                addOutput(output, operation)
                addOutput(output, ".with.overflow.i64(i64 ")
                addOutput(output, left)
                addOutput(output, ", i64 ")
                addOutput(output, right)
                addOutput(output, ")\n")
                addOutput(output, "  ")
                addOutput(output, result)
                addOutput(output, " = extractvalue { i64, i1 } %checked.")
                addOutput(output, Text(temporary))
                addOutput(output, ", 0\n")
                addOutput(output, "  %overflow.")
                addOutput(output, Text(temporary))
                addOutput(output, " = extractvalue { i64, i1 } %checked.")
                addOutput(output, Text(temporary))
                addOutput(output, ", 1\n")
                addOutput(output, "  call void @minyar_check_integer_overflow(i1 %overflow.")
                addOutput(output, Text(temporary))
                addOutput(output, ")\n")
                setType(resultType, 1)
            } else {
                if operator == "/" || operator == "%" {
                    addOutput(output, "  call void @minyar_check_integer_division(i64 ")
                    addOutput(output, left)
                    addOutput(output, ", i64 ")
                    addOutput(output, right)
                    addOutput(output, ")\n")
                    let instruction = "sdiv"
                    if operator == "%" {
                        instruction = "srem"
                    }
                    addOutput(output, "  ")
                    addOutput(output, result)
                    addOutput(output, " = ")
                    addOutput(output, instruction)
                    addOutput(output, " i64 ")
                    addOutput(output, left)
                    addOutput(output, ", ")
                    addOutput(output, right)
                    addOutput(output, "\n")
                    setType(resultType, 1)
                } else {
                    if isBitwiseOperator(operator) {
                        let instruction = "and"
                        if operator == "|" { instruction = "or" }
                        if operator == "^" { instruction = "xor" }
                        if operator == "<<" || operator == ">>" {
                            // Shift counts outside 0..63 have no defined result.
                            addOutput(output, "  call void @minyar_check_shift(i64 ")
                            addOutput(output, right)
                            addOutput(output, ")\n")
                            instruction = "shl"
                            if operator == ">>" { instruction = "ashr" }
                        }
                        addOutput(output, "  ")
                        addOutput(output, result)
                        addOutput(output, " = ")
                        addOutput(output, instruction)
                        addOutput(output, " i64 ")
                        addOutput(output, left)
                        addOutput(output, ", ")
                        addOutput(output, right)
                        addOutput(output, "\n")
                        setType(resultType, 1)
                    } else {
                        addOutput(output, "  ")
                        addOutput(output, result)
                        if leftType == 7 {
                            addOutput(output, " = fcmp ")
                        } else {
                            addOutput(output, " = icmp ")
                        }
                        addOutput(output, comparisonCondition(operator, leftType))
                        addOutput(output, " ")
                        addOutput(output, llvmType(leftType))
                        addOutput(output, " ")
                        addOutput(output, left)
                        addOutput(output, ", ")
                        addOutput(output, right)
                        addOutput(output, "\n")
                        setType(resultType, 4)
                    }
                }
            }
            }
        }
    }
    ownResult(output, state, result, resultType)
    return result
}

function parseExpression(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, resultType: List<Integer>): Text {
    let left = parseAnd(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, resultType)
    while tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "||") {
        state[0] = state[0] + 1
        requireType(tokenLines, state, resultType[0], 4, "the left side of || must be Boolean")
        let rightLabel = newLabel(state)
        let endLabel = newLabel(state)
        let leftBlock = textState[0]
        addOutput(output, "  br i1 ")
        addOutput(output, left)
        addOutput(output, ", label %logical.end.")
        addOutput(output, Text(endLabel))
        addOutput(output, ", label %logical.right.")
        addOutput(output, Text(rightLabel))
        addOutput(output, "\n\n")
        addOutput(output, "logical.right.")
        addOutput(output, Text(rightLabel))
        addOutput(output, ":\n")
        textState[0] = "logical.right." + Text(rightLabel)
        let rightType: List<Integer> = []
        rightType.add(0)
        let right = parseAnd(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, rightType)
        requireType(tokenLines, state, rightType[0], 4, "the right side of || must be Boolean")
        let rightBlock = textState[0]
        addOutput(output, "  br label %logical.end.")
        addOutput(output, Text(endLabel))
        addOutput(output, "\n\nlogical.end.")
        addOutput(output, Text(endLabel))
        addOutput(output, ":\n")
        textState[0] = "logical.end." + Text(endLabel)
        let temporary = newTemporary(state)
        left = valueName(textState, temporary)
        addOutput(output, "  ")
        addOutput(output, left)
        addOutput(output, " = phi i1 [ true, %")
        addOutput(output, leftBlock)
        addOutput(output, " ], [ ")
        addOutput(output, right)
        addOutput(output, ", %")
        addOutput(output, rightBlock)
        addOutput(output, " ]\n")
        resultType[0] = 4
    }
    return left
}

function parseAnd(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, resultType: List<Integer>): Text {
    let left = parseBinary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, resultType, 1)
    while tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "&&") {
        state[0] = state[0] + 1
        requireType(tokenLines, state, resultType[0], 4, "the left side of && must be Boolean")
        let rightLabel = newLabel(state)
        let endLabel = newLabel(state)
        let leftBlock = textState[0]
        addOutput(output, "  br i1 ")
        addOutput(output, left)
        addOutput(output, ", label %logical.right.")
        addOutput(output, Text(rightLabel))
        addOutput(output, ", label %logical.end.")
        addOutput(output, Text(endLabel))
        addOutput(output, "\n\n")
        addOutput(output, "logical.right.")
        addOutput(output, Text(rightLabel))
        addOutput(output, ":\n")
        textState[0] = "logical.right." + Text(rightLabel)
        let rightType: List<Integer> = []
        rightType.add(0)
        let right = parseBinary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, rightType, 1)
        requireType(tokenLines, state, rightType[0], 4, "the right side of && must be Boolean")
        let rightBlock = textState[0]
        addOutput(output, "  br label %logical.end.")
        addOutput(output, Text(endLabel))
        addOutput(output, "\n\nlogical.end.")
        addOutput(output, Text(endLabel))
        addOutput(output, ":\n")
        textState[0] = "logical.end." + Text(endLabel)
        let temporary = newTemporary(state)
        left = valueName(textState, temporary)
        addOutput(output, "  ")
        addOutput(output, left)
        addOutput(output, " = phi i1 [ false, %")
        addOutput(output, leftBlock)
        addOutput(output, " ], [ ")
        addOutput(output, right)
        addOutput(output, ", %")
        addOutput(output, rightBlock)
        addOutput(output, " ]\n")
        resultType[0] = 4
    }
    return left
}

function operatorLevel(tokenKinds: List<Integer>, tokenTexts: List<Text>, state: List<Integer>): Integer {
    let level = 0
    if tokenKinds[state[0]] == 4 {
        let token = tokenTexts[state[0]]
        if token == "*" || token == "/" || token == "%" || token == "<<" || token == ">>" || token == "&" {
            level = 4
        } else {
            if token == "+" || token == "-" || token == "|" || token == "^" {
                level = 3
            } else {
                if token == "<" || token == ">" || token == "<=" || token == ">=" {
                    level = 2
                } else {
                    if token == "==" || token == "!=" {
                        level = 1
                    }
                }
            }
        }
    }
    return level
}

function parseBinary(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, resultType: List<Integer>, minimumLevel: Integer): Text {
    let left = parseUnary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, resultType)
    let level = operatorLevel(tokenKinds, tokenTexts, state)
    while level >= minimumLevel && level > 0 {
        let operator = tokenTexts[state[0]]
        let operatorLocation = tokenLines[state[0]]
        state[0] = state[0] + 1
        let leftType = resultType[0]
        let leftOwner = -1
        if resultType.length > 1 {
            leftOwner = resultType[1]
        }
        setType(resultType, 0)
        let right = parseBinary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, resultType, level + 1)
        left = emitBinary(output, textState, state, operator, left, leftType, leftOwner, right, resultType[0], resultType, operatorLocation)
        level = operatorLevel(tokenKinds, tokenTexts, state)
    }
    return left
}

function checkedIntegerLiteral(digits: Text, negative: Boolean, location: Text): Text {
    let first = 0
    while first + 1 < digits.length && digits[first] == '0' {
        first = first + 1
    }
    let canonical = digits
    if first > 0 {
        canonical = digits.slice(first, digits.length)
    }
    let limit = "9223372036854775807"
    if negative {
        limit = "9223372036854775808"
    }
    if canonical.length > 19 || (canonical.length == 19 && compareText(canonical, limit) > 0) {
        fail(describeLocation(location) + ": Integer literal is outside the supported range")
    }
    return canonical
}

// LLVM rounds decimal double constants correctly. Reject only literals whose
// decimal magnitude is beyond every finite Float, which would become infinity.
function checkedFloatLiteral(literal: Text, location: Text): Text {
    let position = 0
    let significant = false
    let integerDigits = 0
    while position < literal.length && literal[position] != '.' {
        if significant || literal[position] != '0' {
            significant = true
            integerDigits = integerDigits + 1
        }
        position = position + 1
    }
    position = position + 1
    let fractionZeros = 0
    while position < literal.length && literal[position] != 'e' && literal[position] != 'E' {
        if !significant {
            if literal[position] == '0' {
                fractionZeros = fractionZeros + 1
            } else {
                significant = true
            }
        }
        position = position + 1
    }
    let exponent = 0
    let negativeExponent = false
    if position < literal.length {
        position = position + 1
        if literal[position] == '-' || literal[position] == '+' {
            negativeExponent = literal[position] == '-'
            position = position + 1
        }
        while position < literal.length {
            if exponent < 100000 {
                exponent = exponent * 10 + findCharacter("0123456789", literal[position])
            }
            position = position + 1
        }
    }
    if negativeExponent {
        exponent = -exponent
    }
    if significant {
        let order = exponent - fractionZeros - 1
        if integerDigits > 0 {
            order = exponent + integerDigits - 1
        }
        if order > 308 {
            fail(describeLocation(location) + ": Float literal is larger than the largest Float")
        }
    }
    return literal
}

function parseUnary(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, resultType: List<Integer>): Text {
    let value = ""
    if tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "!" || tokenTexts[state[0]] == "-" || tokenTexts[state[0]] == "~") {
        let operator = tokenTexts[state[0]]
        state[0] = state[0] + 1
        if operator == "-" && tokenKinds[state[0]] == 2 {
            let digits = checkedIntegerLiteral(tokenTexts[state[0]], true, tokenLines[state[0]])
            state[0] = state[0] + 1
            setType(resultType, 1)
            return "-" + digits
        }
        if operator == "-" && tokenKinds[state[0]] == 7 {
            let literal = checkedFloatLiteral(tokenTexts[state[0]], tokenLines[state[0]])
            state[0] = state[0] + 1
            setType(resultType, 7)
            return "-" + literal
        }
        let rightType: List<Integer> = []
        rightType.add(0)
        let right = parseUnary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, rightType)
        let temporary = newTemporary(state)
        value = valueName(textState, temporary)
        if operator == "!" {
            requireType(tokenLines, state, rightType[0], 4, "logical not needs a Boolean")
            addOutput(output, "  ")
            addOutput(output, value)
            addOutput(output, " = xor i1 ")
            addOutput(output, right)
            addOutput(output, ", true\n")
            setType(resultType, 4)
        } else {
        if operator == "~" {
            requireType(tokenLines, state, rightType[0], 1, "bitwise not needs an Integer")
            addOutput(output, "  ")
            addOutput(output, value)
            addOutput(output, " = xor i64 ")
            addOutput(output, right)
            addOutput(output, ", -1\n")
            setType(resultType, 1)
        } else {
        if rightType[0] == 7 {
            addOutput(output, "  ")
            addOutput(output, value)
            addOutput(output, " = fneg double ")
            addOutput(output, right)
            addOutput(output, "\n")
            setType(resultType, 7)
        } else {
            requireType(tokenLines, state, rightType[0], 1, "negation needs an Integer or Float")
            addOutput(output, "  %checked.")
            addOutput(output, Text(temporary))
            addOutput(output, " = call { i64, i1 } @llvm.ssub.with.overflow.i64(i64 0, i64 ")
            addOutput(output, right)
            addOutput(output, ")\n")
            addOutput(output, "  ")
            addOutput(output, value)
            addOutput(output, " = extractvalue { i64, i1 } %checked.")
            addOutput(output, Text(temporary))
            addOutput(output, ", 0\n")
            addOutput(output, "  %overflow.")
            addOutput(output, Text(temporary))
            addOutput(output, " = extractvalue { i64, i1 } %checked.")
            addOutput(output, Text(temporary))
            addOutput(output, ", 1\n")
            addOutput(output, "  call void @minyar_check_integer_overflow(i1 %overflow.")
            addOutput(output, Text(temporary))
            addOutput(output, ")\n")
            setType(resultType, 1)
        }
        }
        }
    } else {
        value = parsePrimary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, resultType)
    }
    return value
}

// Bytes methods map one-to-one onto runtime functions. Typed accessors use a
// byte offset and little-endian order; `kinds` lists the supported widths.
function bytesKindSuffix(kind: Text): Text {
    if kind == "Int16" { return "int16" }
    if kind == "UInt16" { return "uint16" }
    if kind == "Int32" { return "int32" }
    if kind == "UInt32" { return "uint32" }
    if kind == "Int64" { return "int64" }
    if kind == "Float32" { return "float32" }
    if kind == "Float64" { return "float64" }
    return ""
}

function parseBytesMethod(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, receiver: Text, member: Text, memberLocation: Text, resultType: List<Integer>): Text {
    let values: List<Text> = []
    values.add(receiver)
    let types: List<Integer> = []
    types.add(8)
    while !tokenIs(tokenKinds, tokenTexts, state, ")") {
        let argumentType: List<Integer> = []
        argumentType.add(0)
        values.add(parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, argumentType))
        types.add(argumentType[0])
        if tokenIs(tokenKinds, tokenTexts, state, ",") {
            state[0] = state[0] + 1
        }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    let expected: List<Integer> = []
    expected.add(8)
    let callee = ""
    let returnType = 5
    if member == "add" {
        callee = "minyar_bytes_add"
        expected.add(1)
    }
    if member == "addBytes" {
        callee = "minyar_bytes_append"
        expected.add(8)
    }
    if member == "clear" {
        callee = "minyar_bytes_clear"
    }
    if member == "resize" {
        callee = "minyar_bytes_resize"
        expected.add(1)
    }
    if member == "slice" {
        callee = "minyar_bytes_slice"
        expected.add(1)
        expected.add(1)
        returnType = 8
    }
    if callee == "" && member.length > 3 {
        let verb = member.slice(0, 3)
        let suffix = bytesKindSuffix(member.slice(3, member.length))
        let valueType = 1
        if member[3] == 'F' {
            valueType = 7
        }
        if suffix != "" && (verb == "add" || verb == "get" || verb == "set") {
            callee = "minyar_bytes_" + verb + "_" + suffix
            if verb == "add" {
                expected.add(valueType)
            }
            if verb == "get" {
                expected.add(1)
                returnType = valueType
            }
            if verb == "set" {
                expected.add(1)
                expected.add(valueType)
            }
        }
    }
    if callee == "" {
        fail(describeLocation(memberLocation) + ": Bytes has no method named '" + member + "'")
    }
    let matches = values.length == expected.length
    let position = 1
    while matches && position < values.length {
        if types[position] != expected[position] {
            matches = false
        }
        position = position + 1
    }
    if !matches {
        let wanted = ""
        position = 1
        while position < expected.length {
            if position > 1 {
                wanted = wanted + ", "
            }
            wanted = wanted + describeType(expected[position])
            position = position + 1
        }
        fail(describeLocation(memberLocation) + ": Bytes." + member + " expects (" + wanted + ")")
    }
    setType(resultType, returnType)
    return emitCall(output, textState, state, returnType, callee, values, types)
}

function parsePrimary(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, resultType: List<Integer>): Text {
    let atom = state[0]
    let scalarValues = -1
    let value = parseAtom(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, resultType)
    if isRecordType(resultType[0]) && tokenKinds[atom] == 1 && atom + 1 < tokenTexts.length && tokenTexts[atom + 1] == "." {
        let local = findLocal(localNames, localLengths, state, tokenTexts[atom])
        if local >= 0 { scalarValues = scalarRecordValues(state, localIds[local]) }
    }
    if (tokenKinds[atom] == 1 && tokenTexts[atom + 1] == "(") || (tokenKinds[atom] == 4 && tokenTexts[atom] == "[") {
        ownResult(output, state, value, resultType)
    }

    while tokenKinds[state[0]] == 4 && (tokenTexts[state[0]] == "." || tokenTexts[state[0]] == "[") {
        let ownsResult = false
        if tokenTexts[state[0]] == "." {
            let receiver = value
            let receiverType = resultType[0]
            state[0] = state[0] + 1
            if tokenKinds[state[0]] != 1 {
                fail("expected a field or method name after '.'")
            }
            let member = tokenTexts[state[0]]
            let memberLocation = tokenLines[state[0]]
            state[0] = state[0] + 1
            if tokenIs(tokenKinds, tokenTexts, state, "(") {
                state[0] = state[0] + 1
                if receiverType == 8 {
                    value = parseBytesMethod(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, receiver, member, memberLocation, resultType)
                    ownsResult = resultType[0] == 8
                } else {
                let argumentType: List<Integer> = []
                argumentType.add(0)
                if (member == "add" || member == "appended") && isListType(receiverType) {
                    argumentType[0] = listElementType(receiverType)
                }
                let argument = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, argumentType)
                if receiverType == 2 && member == "slice" {
                    ownsResult = true
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
                    let endType: List<Integer> = []
                    endType.add(0)
                    let end = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, endType)
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    if argumentType[0] != 1 || endType[0] != 1 {
                        fail("Text.slice positions must be Integers")
                    }
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    addOutput(output, "  ")
                    addOutput(output, value)
                    addOutput(output, " = call ptr @minyar_text_slice(ptr ")
                    addOutput(output, receiver)
                    addOutput(output, ", i64 ")
                    addOutput(output, argument)
                    addOutput(output, ", i64 ")
                    addOutput(output, end)
                    addOutput(output, ")\n")
                    setType(resultType, 2)
                } else {
                    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    if member == "appended" && isListType(receiverType) {
                        if argumentType[0] != listElementType(receiverType) {
                            fail("the value appended to a List has the wrong type")
                        }
                        let slot = valueAsListSlot(output, textState, state, argument, argumentType[0])
                        let transfers = takeResult(output, state, argument, argumentType)
                        let temporary = newTemporary(state)
                        value = valueName(textState, temporary)
                        addOutput(output, "  ")
                        addOutput(output, value)
                        addOutput(output, " = call ptr @minyar_list_appended(ptr ")
                        addOutput(output, receiver)
                        addOutput(output, ", i64 ")
                        addOutput(output, slot)
                        addOutput(output, ", i64 ")
                        if isReferenceType(argumentType[0]) {
                            addOutput(output, "1")
                        } else {
                            addOutput(output, "0")
                        }
                        addOutput(output, ", i64 ")
                        if transfers {
                            addOutput(output, "1")
                        } else {
                            addOutput(output, "0")
                        }
                        addOutput(output, ")\n")
                        ownsResult = true
                        setType(resultType, receiverType)
                    } else {
                    if member != "add" || !isListType(resultType[0]) {
                        fail(describeLocation(memberLocation) + ": this value has no method named '" + member + "'")
                    }
                    if argumentType[0] != listElementType(resultType[0]) {
                        fail("the value added to a List has the wrong type")
                    }
                    checkListMutation(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    let slot = valueAsListSlot(output, textState, state, argument, argumentType[0])
                    if takeResult(output, state, argument, argumentType) {
                        addOutput(output, "  call void @minyar_list_add_take(ptr ")
                    } else {
                        addOutput(output, "  call void @minyar_list_add(ptr ")
                    }
                    addOutput(output, value)
                    addOutput(output, ", i64 ")
                    addOutput(output, slot)
                    addOutput(output, ")\n")
                    value = ""
                    setType(resultType, 5)
                    }
                }
                }
            } else {
                if isRecordType(receiverType) {
                    let field = findRecordField(functionParameterCounts, functionParameterNames, receiverType, member)
                    if field < 0 {
                        fail("record '" + readableDeclarationName(functionNames[receiverType - 1000]) + "' has no field named '" + member + "'")
                    }
                    let first = functionParameterOffset(functionParameterCounts, receiverType - 1000)
                    let fieldType = functionParameterTypes[field]
                    let temporary = newTemporary(state)
                    let raw = valueName(textState, temporary)
                    if scalarValues >= 0 {
                        raw = output[scalarValues + (field - first) * 3 + 1]
                    } else {
                        addOutput(output, "  ")
                        addOutput(output, raw)
                        addOutput(output, " = call i64 @minyar_record_get(ptr ")
                        addOutput(output, receiver)
                        addOutput(output, ", i64 ")
                        addOutput(output, Text(field - first))
                        addOutput(output, ")\n")
                    }
                    scalarValues = -1
                    value = slotAsValue(output, textState, state, raw, fieldType)
                    setType(resultType, fieldType)
                } else {
                    if receiverType != 2 && receiverType != 8 && !isListType(receiverType) {
                        fail("this value does not provide a field named '" + member + "'")
                    }
                    if member != "length" && !(receiverType == 2 && member == "byteLength") {
                        fail("this value does not provide a field named '" + member + "'")
                    }
                    let temporary = newTemporary(state)
                    let operation = "list_length"
                    if receiverType == 2 {
                        operation = "text_length"
                        if member == "byteLength" {
                            operation = "text_byte_length"
                        }
                    }
                    if receiverType == 8 {
                        operation = "bytes_length"
                    }
                    value = valueName(textState, temporary)
                    addOutput(output, "  ")
                    addOutput(output, value)
                    addOutput(output, " = call i64 @minyar_")
                    addOutput(output, operation)
                    addOutput(output, "(ptr ")
                    addOutput(output, receiver)
                    addOutput(output, ")\n")
                    setType(resultType, 1)
                }
            }
        } else {
            let collection = value
            let collectionType = resultType[0]
            state[0] = state[0] + 1
            let positionType: List<Integer> = []
            positionType.add(0)
            let position = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, positionType)
            expectToken(tokenKinds, tokenTexts, tokenLines, state, "]")
            requireType(tokenLines, state, positionType[0], 1, "a position must be an Integer")
            let temporary = newTemporary(state)
            if collectionType == 2 {
                value = valueName(textState, temporary)
                addOutput(output, "  ")
                addOutput(output, value)
                addOutput(output, " = call i32 @minyar_text_character_at(ptr ")
                addOutput(output, collection)
                addOutput(output, ", i64 ")
                addOutput(output, position)
                addOutput(output, ")\n")
                setType(resultType, 3)
            } else {
                if collectionType == 8 {
                    value = emitBytesRead(output, textState, state, collection, position)
                    setType(resultType, 1)
                } else {
                if !isListType(collectionType) {
                    fail("indexing needs Text, a List, or Bytes")
                }
                let raw = valueName(textState, temporary)
                addOutput(output, "  ")
                addOutput(output, raw)
                addOutput(output, " = call i64 @minyar_list_get(ptr ")
                addOutput(output, collection)
                addOutput(output, ", i64 ")
                addOutput(output, position)
                addOutput(output, ")\n")
                let elementType = listElementType(collectionType)
                value = slotAsValue(output, textState, state, raw, elementType)
                setType(resultType, elementType)
                }
            }
        }
        if ownsResult {
            ownResult(output, state, value, resultType)
        } else {
            // A following field read cannot change the receiver's owner.
            // Calls and indexed expressions can, so keep those receivers alive.
            if !(tokenIs(tokenKinds, tokenTexts, state, ".") && state[0] + 2 < tokenTexts.length && tokenTexts[state[0] + 2] != "(") {
                borrowReference(output, state, value, resultType[0])
            }
        }
    }
    return value
}

function parseRecord(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, resultType: List<Integer>): Text {
    let name = tokenTexts[state[0]]
    let record = findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, name, 2)
    if record < 0 {
        fail("I can't find a record named '" + readableDeclarationName(name) + "'")
    }
    state[0] = state[0] + 1
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "{")
    skipTerminators(tokenKinds, state)
    let temporary = newTemporary(state)
    let value = valueName(textState, temporary)
    let fieldCount = functionParameterCounts[record]
    let first = functionParameterOffset(functionParameterCounts, record)
    let scalarLocal = state[10]
    state[10] = -1
    let scalarValues = -1
    let scalar = true
    let inspect = 0
    while inspect < fieldCount {
        if isReferenceType(functionParameterTypes[first + inspect]) {
            scalar = false
        }
        inspect = inspect + 1
    }
    let owner = -1
    if scalarLocal >= 0 {
        value = "null"
        addOutput(output, "; scalar record " + Text(scalarLocal) + "\n")
        scalarValues = output.length
        let field = 0
        while field < fieldCount {
            addOutput(output, "; ")
            addOutput(output, "")
            addOutput(output, "\n")
            field = field + 1
        }
        markScalarRecord(state, scalarLocal, scalarValues)
    } else {
        addOutput(output, "  ")
        addOutput(output, value)
        if scalar {
            addOutput(output, " = call ptr @minyar_record_new_scalar(i64 ")
        } else {
            addOutput(output, " = call ptr @minyar_record_new(i64 ")
        }
        addOutput(output, Text(fieldCount))
        addOutput(output, ")\n")
        owner = keepReference(output, state, value, 1000 + record)
    }
    let seen: List<Boolean> = []
    let position = 0
    while position < fieldCount {
        seen.add(false)
        position = position + 1
    }
    while !tokenIs(tokenKinds, tokenTexts, state, "}") {
        let fieldName = tokenTexts[state[0]]
        let fieldLocation = tokenLines[state[0]]
        state[0] = state[0] + 1
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ":")
        let field = findRecordField(functionParameterCounts, functionParameterNames, 1000 + record, fieldName)
        if field < 0 {
            fail(describeLocation(fieldLocation) + ": record '" + readableDeclarationName(name) + "' has no field named '" + fieldName + "'")
        }
        let fieldPosition = field - first
        if seen[fieldPosition] {
            fail(describeLocation(fieldLocation) + ": record field '" + fieldName + "' was provided twice")
        }
        let fieldType: List<Integer> = []
        fieldType.add(functionParameterTypes[field])
        let valueLocation = tokenLines[state[0]]
        let fieldValue = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, fieldType)
        if fieldType[0] != functionParameterTypes[field] {
            fail(describeLocation(valueLocation) + ": record field '" + fieldName + "' has the wrong type")
        }
        let slot = valueAsListSlot(output, textState, state, fieldValue, fieldType[0])
        if scalarValues >= 0 {
            output[scalarValues + fieldPosition * 3 + 1] = slot
        } else {
        if isReferenceType(fieldType[0]) {
            if takeResult(output, state, fieldValue, fieldType) {
                addOutput(output, "  call void @minyar_record_set_take(ptr ")
            } else {
                addOutput(output, "  call void @minyar_record_set_reference(ptr ")
            }
        } else {
            if scalar {
                addOutput(output, "  call void @minyar_record_set_scalar(ptr ")
            } else {
                addOutput(output, "  call void @minyar_record_set(ptr ")
            }
        }
        addOutput(output, value)
        addOutput(output, ", i64 ")
        addOutput(output, Text(fieldPosition))
        addOutput(output, ", i64 ")
        addOutput(output, slot)
        addOutput(output, ")\n")
        }
        seen[fieldPosition] = true
        if tokenIs(tokenKinds, tokenTexts, state, ",") {
            state[0] = state[0] + 1
        }
        skipTerminators(tokenKinds, state)
    }
    let closingLocation = tokenLines[state[0]]
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "}")
    position = 0
    while position < fieldCount {
        if !seen[position] {
            fail(describeLocation(closingLocation) + ": record '" + readableDeclarationName(name) + "' is missing field '" + functionParameterNames[first + position] + "'")
        }
        position = position + 1
    }
    setType(resultType, 1000 + record)
    markOwner(resultType, owner)
    return value
}

function parseListLiteral(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, resultType: List<Integer>): Text {
    state[0] = state[0] + 1
    let elementType = 0
    if isListType(resultType[0]) {
        elementType = listElementType(resultType[0])
    }
    let temporary = newTemporary(state)
    let value = valueName(textState, temporary)
    addOutput(output, "  ")
    addOutput(output, value)
    addOutput(output, " = call ptr @minyar_list_new()\n")
    let references = false
    if isReferenceType(elementType) {
        addOutput(output, "  call void @minyar_list_references(ptr ")
        addOutput(output, value)
        addOutput(output, ")\n")
        references = true
    }
    skipTerminators(tokenKinds, state)
    while !tokenIs(tokenKinds, tokenTexts, state, "]") {
        let itemType: List<Integer> = []
        itemType.add(elementType)
        let item = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, itemType)
        if itemType[0] == 5 || itemType[0] == 6 {
            fail("Nothing cannot be stored in a List")
        }
        if itemType[0] == 100000 {
            fail("an empty List needs a type, such as List<Text>")
        }
        if elementType == 0 {
            elementType = itemType[0]
        }
        if itemType[0] != elementType {
            fail("all values in a List literal must have the same type")
        }
        if isReferenceType(elementType) && !references {
            addOutput(output, "  call void @minyar_list_references(ptr ")
            addOutput(output, value)
            addOutput(output, ")\n")
            references = true
        }
        let slot = valueAsListSlot(output, textState, state, item, elementType)
        if takeResult(output, state, item, itemType) {
            addOutput(output, "  call void @minyar_list_add_take(ptr ")
        } else {
            addOutput(output, "  call void @minyar_list_add(ptr ")
        }
        addOutput(output, value)
        addOutput(output, ", i64 ")
        addOutput(output, slot)
        addOutput(output, ")\n")
        skipTerminators(tokenKinds, state)
        if !tokenIs(tokenKinds, tokenTexts, state, "]") {
            expectToken(tokenKinds, tokenTexts, tokenLines, state, ",")
            skipTerminators(tokenKinds, state)
        }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "]")
    setType(resultType, 100000 + elementType)
    return value
}

function parseAtom(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, resultType: List<Integer>): Text {
    let tokenIndex = state[0]
    let kind = tokenKinds[tokenIndex]
    let token = tokenTexts[tokenIndex]
    let value = ""

    if kind == 1 {
        if token == "true" || token == "false" {
            value = token
            state[0] = tokenIndex + 1
            setType(resultType, 4)
        } else {
            if tokenTexts[tokenIndex + 1] == "(" {
                value = parseCall(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, resultType)
            } else {
                if tokenKinds[tokenIndex + 1] == 4 && tokenTexts[tokenIndex + 1] == "{" && findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, token, 2) >= 0 {
                    value = parseRecord(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, resultType)
                } else {
                    let local = findLocal(localNames, localLengths, state, token)
                    let constant = -1
                    if local < 0 {
                        constant = findCompiledSymbol(functionNames, symbolKinds, functionReturnTypes, token, 3)
                        if constant < 0 {
                            fail(describeLocation(tokenLines[tokenIndex]) + ": I can't find a value named '" + readableDeclarationName(token) + "'")
                        }
                    }
                    if constant >= 0 {
                        // Evaluate the declaration's literal in place of the name.
                        state[0] = functionParameterCounts[constant]
                        value = parseUnary(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, resultType)
                        state[0] = tokenIndex + 1
                    } else {
                    state[0] = tokenIndex + 1
                    let id = localIds[local]
                    if id < 0 {
                        value = output[-id - 1]
                    } else {
                        let temporary = newTemporary(state)
                        value = valueName(textState, temporary)
                        addOutput(output, "  ")
                        addOutput(output, value)
                        addOutput(output, " = load ")
                        addOutput(output, llvmType(localTypes[local]))
                        addOutput(output, ", ptr %local.")
                        addOutput(output, Text(id))
                        addOutput(output, "\n")
                    }
                    setType(resultType, localTypes[local])
                    if id >= 0 && resultType.length > 3 && resultType[2] == id && resultType[3] == tokenIndex {
                        let owner = output.length
                        addOutput(output, "  ; minyar-owned-local-transfer\n")
                        addOutput(output, Text(ownershipSlot(state, id)))
                        markOwner(resultType, owner)
                    }
                    }
                }
            }
        }
    } else {
        if kind == 2 {
            value = checkedIntegerLiteral(token, false, tokenLines[tokenIndex])
            state[0] = tokenIndex + 1
            setType(resultType, 1)
        } else {
        if kind == 7 {
            value = checkedFloatLiteral(token, tokenLines[tokenIndex])
            state[0] = tokenIndex + 1
            setType(resultType, 7)
        } else {
            if kind == 3 {
                value = "getelementptr (i8, ptr @.text." + Text(tokenIndex) + ", i64 8)"
                state[0] = tokenIndex + 1
                setType(resultType, 2)
            } else {
                if kind == 5 {
                    state[0] = tokenIndex + 1
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    addOutput(output, "  ")
                    addOutput(output, value)
                    addOutput(output, " = call i32 @minyar_text_character_at(ptr getelementptr (i8, ptr @.text.")
                    addOutput(output, Text(tokenIndex))
                    addOutput(output, ", i64 8), i64 0)\n")
                    setType(resultType, 3)
                } else {
                    if token == "(" {
                        state[0] = tokenIndex + 1
                        value = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, resultType)
                        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
                    } else {
                        if token == "[" {
                            value = parseListLiteral(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, resultType)
                        } else {
                            fail(describeLocation(tokenLines[tokenIndex]) + ": expected an expression, found '" + token + "'")
                        }
                    }
                }
            }
        }
        }
    }
    return value
}

function checkBuiltinArguments(name: Text, types: List<Integer>) {
    let count = -1
    if name == "print" || name == "Text" || name == "fail" || name == "exit" || name == "joinText" || name == "argument" || name == "readTextFile" {
        count = 1
    }
    if name == "argumentCount" {
        count = 0
    }
    if name == "writeTextFile" {
        count = 2
    }
    if count >= 0 {
        if types.length != count {
            fail(name + " expects " + Text(count) + " arguments, but received " + Text(types.length))
        }
        if count > 0 {
            let type = types[0]
            if (name == "print" || name == "Text") && (type < 1 || type > 4) && type != 7 {
                fail(name + " expects one Integer, Float, Text, Character, or Boolean value")
            }
            if (name == "fail" || name == "readTextFile") && type != 2 {
                fail(name + " expects one Text argument")
            }
            if (name == "exit" || name == "argument") && type != 1 {
                fail(name + " expects one Integer argument")
            }
            if name == "joinText" && type != 100002 {
                fail("joinText expects one List<Text> argument")
            }
            if name == "writeTextFile" && (type != 2 || types[1] != 2) {
                fail("writeTextFile expects two Text arguments")
            }
        }
    }
}

function isNumericBuiltin(name: Text): Boolean {
    return name == "Bytes" || name == "readBytesFile" || name == "writeBytesFile" || name == "Float" || name == "Integer" || name == "Character" || isFloatFunction(name) || name == "atan2" || name == "pow" || name == "abs" || name == "min" || name == "max" || name == "clamp" || name == "wrappingAdd" || name == "wrappingSubtract" || name == "wrappingMultiply"
}

function isFloatFunction(name: Text): Boolean {
    return name == "sqrt" || name == "sin" || name == "cos" || name == "tan" || name == "asin" || name == "acos" || name == "atan" || name == "exp" || name == "log" || name == "floor" || name == "ceil" || name == "round"
}

function isBuiltinName(name: Text): Boolean {
    return isNumericBuiltin(name) || name == "print" || name == "Text" || name == "fail" || name == "exit" || name == "joinText" || name == "argument" || name == "argumentCount" || name == "readTextFile" || name == "writeTextFile"
}

function requireBuiltinArguments(name: Text, types: List<Integer>, count: Integer, type: Integer) {
    let matches = types.length == count
    let position = 0
    while matches && position < types.length {
        if types[position] != type {
            matches = false
        }
        position = position + 1
    }
    if !matches {
        let noun = describeType(type)
        if count == 1 {
            fail(name + " expects one " + noun + " argument")
        }
        fail(name + " expects " + Text(count) + " " + noun + " arguments")
    }
}

function emitCall(output: List<Text>, textState: List<Text>, state: List<Integer>, returnType: Integer, callee: Text, values: List<Text>, types: List<Integer>): Text {
    let value = ""
    addOutput(output, "  ")
    if returnType != 5 {
        value = valueName(textState, newTemporary(state))
        addOutput(output, value)
        addOutput(output, " = ")
    }
    addOutput(output, "call ")
    addOutput(output, llvmType(returnType))
    addOutput(output, " @")
    addOutput(output, callee)
    addOutput(output, "(")
    let position = 0
    while position < values.length {
        if position > 0 {
            addOutput(output, ", ")
        }
        addOutput(output, llvmType(types[position]))
        addOutput(output, " ")
        addOutput(output, values[position])
        position = position + 1
    }
    addOutput(output, ")\n")
    return value
}

function pairOf(first: Text, second: Text): List<Text> {
    let pair: List<Text> = []
    pair.add(first)
    pair.add(second)
    return pair
}

function typePairOf(type: Integer): List<Integer> {
    let pair: List<Integer> = []
    pair.add(type)
    pair.add(type)
    return pair
}

function emitInstruction(output: List<Text>, textState: List<Text>, state: List<Integer>, instruction: Text): Text {
    let value = valueName(textState, newTemporary(state))
    addOutput(output, "  ")
    addOutput(output, value)
    addOutput(output, " = ")
    addOutput(output, instruction)
    addOutput(output, "\n")
    return value
}

// Conversions and arithmetic helpers. Float math follows IEEE 754; Integer
// helpers keep the checked-overflow rule unless their name says otherwise.
function emitNumericBuiltin(output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, values: List<Text>, types: List<Integer>, resultType: List<Integer>): Text {
    if name == "Bytes" {
        if types.length == 0 {
            values.add("0")
            types.add(1)
        }
        requireBuiltinArguments(name, types, 1, 1)
        setType(resultType, 8)
        return emitCall(output, textState, state, 8, "minyar_bytes_new", values, types)
    }
    if name == "readBytesFile" {
        requireBuiltinArguments(name, types, 1, 2)
        setType(resultType, 8)
        return emitCall(output, textState, state, 8, "minyar_read_bytes_file", values, types)
    }
    if name == "writeBytesFile" {
        if types.length != 2 || types[0] != 2 || types[1] != 8 {
            fail("writeBytesFile expects a Text path and Bytes")
        }
        setType(resultType, 5)
        return emitCall(output, textState, state, 5, "minyar_write_bytes_file", values, types)
    }
    if isFloatFunction(name) {
        requireBuiltinArguments(name, types, 1, 7)
        let callee = "llvm." + name + ".f64"
        if name == "tan" || name == "asin" || name == "acos" || name == "atan" {
            callee = "minyar_" + name
        }
        setType(resultType, 7)
        return emitCall(output, textState, state, 7, callee, values, types)
    }
    if name == "atan2" || name == "pow" {
        requireBuiltinArguments(name, types, 2, 7)
        let callee = "llvm.pow.f64"
        if name == "atan2" {
            callee = "minyar_atan2"
        }
        setType(resultType, 7)
        return emitCall(output, textState, state, 7, callee, values, types)
    }
    if name == "wrappingAdd" || name == "wrappingSubtract" || name == "wrappingMultiply" {
        requireBuiltinArguments(name, types, 2, 1)
        let instruction = "add"
        if name == "wrappingSubtract" { instruction = "sub" }
        if name == "wrappingMultiply" { instruction = "mul" }
        setType(resultType, 1)
        return emitInstruction(output, textState, state, instruction + " i64 " + values[0] + ", " + values[1])
    }
    if name == "abs" {
        if types.length == 1 && types[0] == 7 {
            setType(resultType, 7)
            return emitCall(output, textState, state, 7, "llvm.fabs.f64", values, types)
        }
        requireBuiltinArguments(name, types, 1, 1)
        setType(resultType, 1)
        return emitCall(output, textState, state, 1, "minyar_integer_absolute", values, types)
    }
    if name == "min" || name == "max" || name == "clamp" {
        let count = 2
        if name == "clamp" { count = 3 }
        let type = 1
        if types.length > 0 && types[0] == 7 { type = 7 }
        if types.length != count || (type != 1 && type != 7) {
            fail(name + " expects " + Text(count) + " Integer or " + Text(count) + " Float arguments")
        }
        requireBuiltinArguments(name, types, count, type)
        setType(resultType, type)
        if name == "clamp" {
            let pairTypes = typePairOf(type)
            let checkName = "minyar_check_clamp_integer"
            if type == 7 { checkName = "minyar_check_clamp_float" }
            emitCall(output, textState, state, 5, checkName, pairOf(values[1], values[2]), pairTypes)
            let raised = emitMinimumOrMaximum(output, textState, state, "max", type, pairOf(values[0], values[1]), pairTypes)
            return emitMinimumOrMaximum(output, textState, state, "min", type, pairOf(raised, values[2]), pairTypes)
        }
        return emitMinimumOrMaximum(output, textState, state, name, type, values, types)
    }
    if name == "Float" {
        if types.length == 1 && types[0] == 7 {
            setType(resultType, 7)
            return values[0]
        }
        requireBuiltinArguments(name, types, 1, 1)
        setType(resultType, 7)
        return emitInstruction(output, textState, state, "sitofp i64 " + values[0] + " to double")
    }
    if name == "Integer" {
        setType(resultType, 1)
        if types.length == 1 && types[0] == 1 {
            return values[0]
        }
        if types.length == 1 && types[0] == 3 {
            return emitInstruction(output, textState, state, "zext i32 " + values[0] + " to i64")
        }
        if types.length != 1 || types[0] != 7 {
            fail("Integer expects one Integer, Float, or Character argument")
        }
        return emitCall(output, textState, state, 1, "minyar_float_integer", values, types)
    }
    requireBuiltinArguments(name, types, 1, 1)
    setType(resultType, 3)
    return emitCall(output, textState, state, 3, "minyar_integer_character", values, types)
}

function emitMinimumOrMaximum(output: List<Text>, textState: List<Text>, state: List<Integer>, name: Text, type: Integer, values: List<Text>, types: List<Integer>): Text {
    if type == 7 {
        let callee = "llvm.minnum.f64"
        if name == "max" { callee = "llvm.maxnum.f64" }
        return emitCall(output, textState, state, 7, callee, values, types)
    }
    let condition = "slt"
    if name == "max" { condition = "sgt" }
    let chooseLeft = emitInstruction(output, textState, state, "icmp " + condition + " i64 " + values[0] + ", " + values[1])
    return emitInstruction(output, textState, state, "select i1 " + chooseLeft + ", i64 " + values[0] + ", i64 " + values[1])
}

function parseCall(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, resultType: List<Integer>): Text {
    let name = tokenTexts[state[0]]
    state[0] = state[0] + 1
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "(")
    let argumentValues: List<Text> = []
    let argumentTypes: List<Integer> = []
    let argumentType: List<Integer> = []
    argumentType.add(0)
    while !tokenIs(tokenKinds, tokenTexts, state, ")") {
        setType(argumentType, 0)
        // Only literals (possibly parenthesized) need an expected type here.
        // Resolve before parsing so a nested call cannot replace this context.
        if tokenIs(tokenKinds, tokenTexts, state, "[") || tokenIs(tokenKinds, tokenTexts, state, "(") {
            let contextFunction = findFunction(functionNames, symbolKinds, functionReturnTypes, name)
            if contextFunction >= 0 && argumentValues.length < functionParameterCounts[contextFunction] {
                let first = functionParameterOffset(functionParameterCounts, contextFunction)
                argumentType[0] = functionParameterTypes[first + argumentValues.length]
            }
            if name == "joinText" && argumentValues.length == 0 {
                argumentType[0] = 100002
            }
        }
        argumentValues.add(parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, argumentType))
        argumentTypes.add(argumentType[0])
        if tokenIs(tokenKinds, tokenTexts, state, ",") {
            state[0] = state[0] + 1
        }
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
    checkBuiltinArguments(name, argumentTypes)

    let value = ""
    if name == "print" {
        // checkBuiltinArguments has already established the single argument.
        if argumentTypes[0] > 4 && argumentTypes[0] != 7 {
            fail("print expects one Integer, Float, Text, Character, or Boolean value")
        }
        let suffix = "text"
        if argumentTypes[0] == 1 {
            suffix = "integer"
        }
        if argumentTypes[0] == 7 {
            suffix = "float"
        }
        if argumentTypes[0] == 3 {
            suffix = "character"
        }
        if argumentTypes[0] == 4 {
            suffix = "boolean"
        }
        addOutput(output, "  call void @minyar_print_")
        addOutput(output, suffix)
        addOutput(output, "(")
        addOutput(output, llvmType(argumentTypes[0]))
        addOutput(output, " ")
        addOutput(output, argumentValues[0])
        addOutput(output, ")\n")
        setType(resultType, 5)
    } else {
        if name == "fail" {
            addOutput(output, "  call void @minyar_fail(ptr ")
            addOutput(output, argumentValues[0])
            addOutput(output, ")\n")
            setType(resultType, 6)
        } else {
            if name == "exit" {
                if argumentValues.length != 1 || argumentTypes[0] != 1 {
                    fail("exit expects one Integer status")
                }
                addOutput(output, "  call void @minyar_exit(i64 ")
                addOutput(output, argumentValues[0])
                addOutput(output, ")\n")
                setType(resultType, 6)
            } else {
            if name == "Text" {
                if argumentTypes[0] == 2 {
                    value = argumentValues[0]
                    addOutput(output, "  call void @minyar_rc_retain(ptr ")
                    addOutput(output, value)
                    addOutput(output, ")\n")
                } else {
                    let suffix = "boolean"
                    if argumentTypes[0] == 1 {
                        suffix = "integer"
                    }
                    if argumentTypes[0] == 7 {
                        suffix = "float"
                    }
                    if argumentTypes[0] == 3 {
                        suffix = "character"
                    }
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    addOutput(output, "  ")
                    addOutput(output, value)
                    addOutput(output, " = call ptr @minyar_")
                    addOutput(output, suffix)
                    addOutput(output, "_text(")
                    addOutput(output, llvmType(argumentTypes[0]))
                    addOutput(output, " ")
                    addOutput(output, argumentValues[0])
                    addOutput(output, ")\n")
                }
                setType(resultType, 2)
            } else {
                if name == "joinText" {
                    let temporary = newTemporary(state)
                    value = valueName(textState, temporary)
                    addOutput(output, "  ")
                    addOutput(output, value)
                    addOutput(output, " = call ptr @minyar_join_texts(ptr ")
                    addOutput(output, argumentValues[0])
                    addOutput(output, ")\n")
                    setType(resultType, 2)
                } else {
                    if name == "argumentCount" {
                        let temporary = newTemporary(state)
                        value = valueName(textState, temporary)
                        addOutput(output, "  ")
                        addOutput(output, value)
                        addOutput(output, " = call i64 @minyar_argument_count()\n")
                        setType(resultType, 1)
                    } else {
                        if name == "argument" || name == "readTextFile" {
                            let temporary = newTemporary(state)
                            value = valueName(textState, temporary)
                            let runtimeName = "argument"
                            if name == "readTextFile" {
                                runtimeName = "read_text_file"
                            }
                            addOutput(output, "  ")
                            addOutput(output, value)
                            addOutput(output, " = call ptr @minyar_")
                            addOutput(output, runtimeName)
                            addOutput(output, "(")
                            addOutput(output, llvmType(argumentTypes[0]))
                            addOutput(output, " ")
                            addOutput(output, argumentValues[0])
                            addOutput(output, ")\n")
                            setType(resultType, 2)
                        } else {
                            if name == "writeTextFile" {
                                addOutput(output, "  call void @minyar_write_text_file(ptr ")
                                addOutput(output, argumentValues[0])
                                addOutput(output, ", ptr ")
                                addOutput(output, argumentValues[1])
                                addOutput(output, ")\n")
                                setType(resultType, 5)
                            } else {
                                if isNumericBuiltin(name) {
                                    value = emitNumericBuiltin(output, textState, state, name, argumentValues, argumentTypes, resultType)
                                } else {
                                    let functionIndex = state[5]
                                    if functionIndex < 0 || functionNames[functionIndex] != name {
                                        functionIndex = findFunction(functionNames, symbolKinds, functionReturnTypes, name)
                                        state[5] = functionIndex
                                    }
                                    if functionIndex < 0 {
                                        fail("I can't find a function named '" + readableDeclarationName(name) + "'")
                                    }
                                    if argumentValues.length != functionParameterCounts[functionIndex] {
                                        fail(readableDeclarationName(name) + " expects " + Text(functionParameterCounts[functionIndex]) + " arguments, but received " + Text(argumentValues.length) + " near " + describeLocation(tokenLines[state[0]]))
                                    }
                                    let parameterOffset = functionParameterOffset(functionParameterCounts, functionIndex)
                                    let argumentIndex = 0
                                    while argumentIndex < argumentValues.length {
                                        if argumentTypes[argumentIndex] != functionParameterTypes[parameterOffset + argumentIndex] {
                                            fail(describeLocation(tokenLines[state[0]]) + ": an argument passed to " + readableDeclarationName(name) + " has the wrong type")
                                        }
                                        argumentIndex = argumentIndex + 1
                                    }
                                    let returnType = functionReturnTypes[functionIndex]
                                    addOutput(output, "  ")
                                    if returnType != 5 {
                                        let temporary = newTemporary(state)
                                        value = valueName(textState, temporary)
                                        addOutput(output, value)
                                        addOutput(output, " = ")
                                    }
                                    addOutput(output, "call ")
                                    addOutput(output, llvmType(returnType))
                                    addOutput(output, " @")
                                    addOutput(output, name)
                                    addOutput(output, "(")
                                    argumentIndex = 0
                                    while argumentIndex < argumentValues.length {
                                        if argumentIndex > 0 {
                                            addOutput(output, ", ")
                                        }
                                        addOutput(output, llvmType(argumentTypes[argumentIndex]))
                                        addOutput(output, " ")
                                        addOutput(output, argumentValues[argumentIndex])
                                        argumentIndex = argumentIndex + 1
                                    }
                                    addOutput(output, ")\n")
                                    setType(resultType, returnType)
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }
    return value
}

function nextLocal(state: List<Integer>): Integer {
    let id = state[4]
    state[4] = id + 1
    return id
}

function isAssignmentOperator(token: Text): Boolean {
    return token == "=" || token == "+=" || token == "-=" || token == "*=" || token == "/=" || token == "%="
}

// Find the operator of `name(.field | [position])* op= value`, or -1 when the
// statement is not an assignment.
function assignmentOperatorPosition(tokenKinds: List<Integer>, tokenTexts: List<Text>, start: Integer): Integer {
    if tokenKinds[start] != 1 {
        return -1
    }
    let position = start + 1
    let searching = true
    while searching {
        if tokenKinds[position] == 4 && tokenTexts[position] == "." && tokenKinds[position + 1] == 1 {
            position = position + 2
        } else {
            if tokenKinds[position] == 4 && tokenTexts[position] == "[" {
                let depth = 1
                position = position + 1
                while depth > 0 && tokenKinds[position] != 0 {
                    if tokenKinds[position] == 4 && tokenTexts[position] == "[" {
                        depth = depth + 1
                    }
                    if tokenKinds[position] == 4 && tokenTexts[position] == "]" {
                        depth = depth - 1
                    }
                    position = position + 1
                }
                if depth > 0 {
                    return -1
                }
            } else {
                searching = false
            }
        }
    }
    if tokenKinds[position] == 4 && isAssignmentOperator(tokenTexts[position]) {
        return position
    }
    return -1
}

function loadLocal(output: List<Text>, textState: List<Text>, state: List<Integer>, id: Integer, type: Integer): Text {
    if id < 0 {
        return output[-id - 1]
    }
    let value = valueName(textState, newTemporary(state))
    addOutput(output, "  ")
    addOutput(output, value)
    addOutput(output, " = load ")
    addOutput(output, llvmType(type))
    addOutput(output, ", ptr %local.")
    addOutput(output, Text(id))
    addOutput(output, "\n")
    return value
}

function storeLocal(output: List<Text>, id: Integer, type: Integer, value: Text) {
    addOutput(output, "  store ")
    addOutput(output, llvmType(type))
    addOutput(output, " ")
    addOutput(output, value)
    addOutput(output, ", ptr %local.")
    addOutput(output, Text(id))
    addOutput(output, "\n")
}

function readRecordField(output: List<Text>, textState: List<Text>, state: List<Integer>, record: Text, field: Integer, type: Integer): Text {
    let raw = valueName(textState, newTemporary(state))
    addOutput(output, "  ")
    addOutput(output, raw)
    addOutput(output, " = call i64 @minyar_record_get(ptr ")
    addOutput(output, record)
    addOutput(output, ", i64 ")
    addOutput(output, Text(field))
    addOutput(output, ")\n")
    return slotAsValue(output, textState, state, raw, type)
}

function readListElement(output: List<Text>, textState: List<Text>, state: List<Integer>, list: Text, position: Text, type: Integer): Text {
    let raw = valueName(textState, newTemporary(state))
    addOutput(output, "  ")
    addOutput(output, raw)
    addOutput(output, " = call i64 @minyar_list_get(ptr ")
    addOutput(output, list)
    addOutput(output, ", i64 ")
    addOutput(output, position)
    addOutput(output, ")\n")
    return slotAsValue(output, textState, state, raw, type)
}

// Adding an edge R -> F can close a first cycle only when a value reachable
// from F can itself be an R. Mirror checkListMutation for record fields.
function checkFieldMutation(recordType: Integer, fieldType: Integer, counts: List<Integer>, fields: List<Integer>, location: Text) {
    let recordCount = counts.length / 2
    let visited: List<Boolean> = []
    let index = 0
    while index < recordCount {
        visited.add(false)
        index = index + 1
    }
    let pending: List<Integer> = []
    pending.add(fieldType)
    index = 0
    while index < pending.length {
        let type = pending[index]
        index = index + 1
        while isListType(type) {
            type = listElementType(type)
        }
        if isRecordType(type) {
            if type == recordType {
                fail(describeLocation(location) + ": assigning this field could create a reference cycle; construct a new record instead")
            }
            let record = type - 1000
            if !visited[record] {
                visited[record] = true
                let first = functionParameterOffset(counts, record)
                let field = 0
                while field < counts[record] {
                    pending.add(fields[first + field])
                    field = field + 1
                }
            }
        }
    }
}

// Parse the right side of `target op= value`. A compound operator combines the
// current value with the right side exactly as the binary operator would.
function assignedValue(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, binary: Text, current: Text, type: Integer, valueType: List<Integer>, location: Text): Text {
    setType(valueType, type)
    if binary == "" {
        return parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, valueType)
    }
    let rightType: List<Integer> = []
    rightType.add(type)
    let right = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, rightType)
    setType(valueType, 0)
    return emitBinary(output, textState, state, binary, current, type, -1, right, rightType[0], valueType, location)
}

// Assign through a local, record fields, and List positions. Plain `local = v`
// keeps its dedicated path in compileStatement for Text append ownership.
function compileAssignment(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, operatorPosition: Integer) {
    let operator = tokenTexts[operatorPosition]
    let operatorLocation = tokenLines[operatorPosition]
    let binary = ""
    if operator != "=" {
        binary = operator.slice(0, 1)
    }
    let name = tokenTexts[state[0]]
    let local = findLocal(localNames, localLengths, state, name)
    if local < 0 {
        fail(describeLocation(tokenLines[state[0]]) + ": I can't find a value named '" + name + "'")
    }
    let receiverType = localTypes[local]
    let receiver = loadLocal(output, textState, state, localIds[local], receiverType)
    state[0] = state[0] + 1
    let valueType: List<Integer> = []
    valueType.add(0)
    if state[0] == operatorPosition {
        state[0] = operatorPosition + 1
        let value = assignedValue(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, binary, receiver, receiverType, valueType, operatorLocation)
        if valueType[0] != receiverType {
            fail(describeLocation(operatorLocation) + ": an assignment to '" + name + "' has the wrong type")
        }
        assignReference(output, state, localIds[local], value, valueType)
        storeLocal(output, localIds[local], receiverType, value)
        return
    }
    let done = false
    while !done {
        if tokenTexts[state[0]] == "." {
            let member = tokenTexts[state[0] + 1]
            let memberLocation = tokenLines[state[0] + 1]
            state[0] = state[0] + 2
            if !isRecordType(receiverType) {
                fail(describeLocation(memberLocation) + ": only record fields can be assigned, and " + describeType(receiverType) + " has no field named '" + member + "'")
            }
            let field = findRecordField(functionParameterCounts, functionParameterNames, receiverType, member)
            if field < 0 {
                fail(describeLocation(memberLocation) + ": record '" + readableDeclarationName(functionNames[receiverType - 1000]) + "' has no field named '" + member + "'")
            }
            let fieldType = functionParameterTypes[field]
            let fieldIndex = field - functionParameterOffset(functionParameterCounts, receiverType - 1000)
            if state[0] == operatorPosition {
                state[0] = operatorPosition + 1
                if isReferenceType(fieldType) {
                    checkFieldMutation(receiverType, fieldType, functionParameterCounts, functionParameterTypes, memberLocation)
                }
                let current = ""
                if binary != "" {
                    current = readRecordField(output, textState, state, receiver, fieldIndex, fieldType)
                    borrowReference(output, state, current, fieldType)
                }
                let value = assignedValue(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, binary, current, fieldType, valueType, operatorLocation)
                if valueType[0] != fieldType {
                    fail(describeLocation(operatorLocation) + ": record field '" + member + "' needs " + describeType(fieldType) + ", not " + describeType(valueType[0]))
                }
                let slot = valueAsListSlot(output, textState, state, value, fieldType)
                if isReferenceType(fieldType) {
                    let transfers = "0"
                    if takeResult(output, state, value, valueType) {
                        transfers = "1"
                    }
                    addOutput(output, "  call void @minyar_record_replace(ptr ")
                    addOutput(output, receiver)
                    addOutput(output, ", i64 ")
                    addOutput(output, Text(fieldIndex))
                    addOutput(output, ", i64 ")
                    addOutput(output, slot)
                    addOutput(output, ", i64 ")
                    addOutput(output, transfers)
                    addOutput(output, ")\n")
                } else {
                    addOutput(output, "  call void @minyar_record_set_scalar(ptr ")
                    addOutput(output, receiver)
                    addOutput(output, ", i64 ")
                    addOutput(output, Text(fieldIndex))
                    addOutput(output, ", i64 ")
                    addOutput(output, slot)
                    addOutput(output, ")\n")
                }
                done = true
            } else {
                receiver = readRecordField(output, textState, state, receiver, fieldIndex, fieldType)
                receiverType = fieldType
                borrowReference(output, state, receiver, receiverType)
            }
        } else {
            let bracketLocation = tokenLines[state[0]]
            state[0] = state[0] + 1
            let positionType: List<Integer> = []
            positionType.add(0)
            let position = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, positionType)
            expectToken(tokenKinds, tokenTexts, tokenLines, state, "]")
            requireType(tokenLines, state, positionType[0], 1, "a position must be an Integer")
            if !isListType(receiverType) && receiverType != 8 {
                fail(describeLocation(bracketLocation) + ": indexed assignment needs a List or Bytes, not " + describeType(receiverType))
            }
            let elementType = 1
            if isListType(receiverType) {
                elementType = listElementType(receiverType)
            }
            if state[0] == operatorPosition {
                state[0] = operatorPosition + 1
                let current = ""
                if receiverType == 8 {
                    if binary != "" {
                        current = emitBytesRead(output, textState, state, receiver, position)
                    }
                    let value = assignedValue(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, binary, current, 1, valueType, operatorLocation)
                    requireType(tokenLines, state, valueType[0], 1, "a byte must be an Integer")
                    addOutput(output, "  call void @minyar_bytes_set(ptr ")
                    addOutput(output, receiver)
                    addOutput(output, ", i64 ")
                    addOutput(output, position)
                    addOutput(output, ", i64 ")
                    addOutput(output, value)
                    addOutput(output, ")\n")
                } else {
                    checkListMutation(receiverType, functionParameterCounts, functionParameterTypes, functionReturnTypes)
                    if binary != "" {
                        current = readListElement(output, textState, state, receiver, position, elementType)
                        borrowReference(output, state, current, elementType)
                    }
                    let value = assignedValue(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, binary, current, elementType, valueType, operatorLocation)
                    if valueType[0] != elementType {
                        fail(describeLocation(operatorLocation) + ": an indexed assignment needs " + describeType(elementType) + ", not " + describeType(valueType[0]))
                    }
                    let slot = valueAsListSlot(output, textState, state, value, elementType)
                    if takeResult(output, state, value, valueType) {
                        addOutput(output, "  call void @minyar_list_set_take(ptr ")
                    } else {
                        addOutput(output, "  call void @minyar_list_set(ptr ")
                    }
                    addOutput(output, receiver)
                    addOutput(output, ", i64 ")
                    addOutput(output, position)
                    addOutput(output, ", i64 ")
                    addOutput(output, slot)
                    addOutput(output, ")\n")
                }
                done = true
            } else {
                if receiverType == 8 {
                    fail(describeLocation(bracketLocation) + ": a byte has no fields or positions to assign")
                }
                receiver = readListElement(output, textState, state, receiver, position, elementType)
                receiverType = elementType
                borrowReference(output, state, receiver, receiverType)
            }
        }
    }
}

function emitBytesRead(output: List<Text>, textState: List<Text>, state: List<Integer>, bytes: Text, position: Text): Text {
    let value = valueName(textState, newTemporary(state))
    addOutput(output, "  ")
    addOutput(output, value)
    addOutput(output, " = call i64 @minyar_bytes_get(ptr ")
    addOutput(output, bytes)
    addOutput(output, ", i64 ")
    addOutput(output, position)
    addOutput(output, ")\n")
    return value
}

// Loops push a marker into the lexical scope so break and continue find the
// innermost loop. Its name cannot be written in source; its type is -1 for
// while and -2 for for, and its id is the loop's first label.
function findLoopMarker(localNames: List<Text>, localLengths: List<Integer>, state: List<Integer>): Integer {
    return findLocal(localNames, localLengths, state, " loop")
}

function compileLoopJump(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>) {
    let keyword = tokenTexts[state[0]]
    let marker = findLoopMarker(localNames, localLengths, state)
    if marker < 0 {
        fail(describeLocation(tokenLines[state[0]]) + ": '" + keyword + "' can only be used inside a loop")
    }
    state[0] = state[0] + 1
    let label = localIds[marker]
    if localTypes[marker] == -1 {
        if keyword == "continue" {
            addOutput(output, "  call void @minyar_rc_step()\n")
            addOutput(output, "  br label %while.condition." + Text(label) + "\n")
        } else {
            addOutput(output, "  br label %while.end." + Text(label + 2) + "\n")
        }
    } else {
        if keyword == "continue" {
            addOutput(output, "  br label %for.step." + Text(label + 2) + "\n")
        } else {
            addOutput(output, "  br label %for.end." + Text(label + 3) + "\n")
        }
    }
}

// for name in start..end iterates Integers; for name in collection visits each
// List element or Text character. Bounds and the collection are evaluated once;
// the loop variable is a fresh binding for each iteration.
function compileFor(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, returnType: Integer) {
    state[0] = state[0] + 1
    if tokenKinds[state[0]] != 1 {
        fail(describeLocation(tokenLines[state[0]]) + ": expected a name after for")
    }
    let name = tokenTexts[state[0]]
    state[0] = state[0] + 1
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "in")
    let firstLoopLocal = state[3]
    let sourceLocation = tokenLines[state[0]]
    let sourceType: List<Integer> = []
    sourceType.add(0)
    let source = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, sourceType)
    let loopLabel = newLabel(state)
    let bodyLabel = newLabel(state)
    let stepLabel = newLabel(state)
    let endLabel = newLabel(state)
    let counter = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, " for counter", 1, counter)
    let limit = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, " for limit", 1, limit)
    let collection = -1
    let elementType = 1
    if tokenIs(tokenKinds, tokenTexts, state, "..") {
        requireType(tokenLines, state, sourceType[0], 1, "a range starts with an Integer")
        state[0] = state[0] + 1
        let endType: List<Integer> = []
        endType.add(0)
        let end = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, endType)
        requireType(tokenLines, state, endType[0], 1, "a range ends with an Integer")
        storeLocal(output, counter, 1, source)
        storeLocal(output, limit, 1, end)
    } else {
        if isListType(sourceType[0]) {
            elementType = listElementType(sourceType[0])
        } else {
            if sourceType[0] == 2 {
                elementType = 3
            } else {
                if sourceType[0] == 8 {
                    elementType = 1
                } else {
                    fail(describeLocation(sourceLocation) + ": for needs a range such as 0..count, a List, Text, or Bytes, not " + describeType(sourceType[0]))
                }
            }
        }
        collection = nextLocal(state)
        addLocal(localNames, localTypes, localIds, localLengths, state, " for collection", sourceType[0], collection)
        assignReference(output, state, collection, source, sourceType)
        storeLocal(output, collection, sourceType[0], source)
        storeLocal(output, counter, 1, "0")
    }
    addOutput(output, "  br label %for.condition." + Text(loopLabel) + "\n\nfor.condition." + Text(loopLabel) + ":\n")
    textState[0] = "for.condition." + Text(loopLabel)
    let position = loadLocal(output, textState, state, counter, 1)
    let bound = ""
    if collection < 0 {
        bound = loadLocal(output, textState, state, limit, 1)
    } else {
        let items = loadLocal(output, textState, state, collection, sourceType[0])
        let lengthFunction = "minyar_list_length"
        if sourceType[0] == 2 {
            lengthFunction = "minyar_text_length"
        }
        if sourceType[0] == 8 {
            lengthFunction = "minyar_bytes_length"
        }
        let arguments: List<Text> = []
        arguments.add(items)
        let argumentTypes: List<Integer> = []
        argumentTypes.add(sourceType[0])
        bound = emitCall(output, textState, state, 1, lengthFunction, arguments, argumentTypes)
    }
    let continuing = emitInstruction(output, textState, state, "icmp slt i64 " + position + ", " + bound)
    addOutput(output, "  br i1 " + continuing + ", label %for.body." + Text(bodyLabel) + ", label %for.end." + Text(endLabel) + "\n\nfor.body." + Text(bodyLabel) + ":\n")
    textState[0] = "for.body." + Text(bodyLabel)
    let element = position
    if collection >= 0 {
        let items = loadLocal(output, textState, state, collection, sourceType[0])
        if isListType(sourceType[0]) {
            element = readListElement(output, textState, state, items, position, elementType)
        } else {
            if sourceType[0] == 8 {
                element = emitBytesRead(output, textState, state, items, position)
            } else {
                element = valueName(textState, newTemporary(state))
                addOutput(output, "  " + element + " = call i32 @minyar_text_character_at(ptr " + items + ", i64 " + position + ")\n")
            }
        }
    }
    let variable = nextLocal(state)
    addLocal(localNames, localTypes, localIds, localLengths, state, name, elementType, variable)
    let elementResult: List<Integer> = []
    elementResult.add(elementType)
    assignReference(output, state, variable, element, elementResult)
    storeLocal(output, variable, elementType, element)
    addLocal(localNames, localTypes, localIds, localLengths, state, " loop", -2, loopLabel)
    let bodyReturns = compileBlock(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, returnType)
    if !bodyReturns {
        addOutput(output, "  br label %for.step." + Text(stepLabel) + "\n")
    }
    addOutput(output, "\nfor.step." + Text(stepLabel) + ":\n")
    textState[0] = "for.step." + Text(stepLabel)
    let current = loadLocal(output, textState, state, counter, 1)
    // The condition proved current < bound, so this increment cannot overflow.
    let next = emitInstruction(output, textState, state, "add nsw i64 " + current + ", 1")
    storeLocal(output, counter, 1, next)
    addOutput(output, "  call void @minyar_rc_step()\n")
    addOutput(output, "  br label %for.condition." + Text(loopLabel) + "\n\nfor.end." + Text(endLabel) + ":\n")
    textState[0] = "for.end." + Text(endLabel)
    let scoped = firstLoopLocal
    while scoped < state[3] {
        rootLocal(output, state, localIds[scoped], "null", localTypes[scoped])
        scoped = scoped + 1
    }
    state[3] = firstLoopLocal
}

function isNativeType(type: Integer): Boolean {
    return type == 1 || type == 2 || type == 3 || type == 4 || type == 7 || type == 8
}

function nativeType(type: Integer): Text {
    if type == 4 {
        return "i1 zeroext"
    }
    return llvmType(type)
}

// `native "library"` is the whole body of a standard library function. It
// forwards the parameters to the C function minyar_<library>_<name>, which
// borrows Text and Bytes arguments and returns owned references. The marker
// comment lets compileTokens declare the symbol and name the library to link.
function compileNative(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, returnType: Integer) {
    let location = tokenLines[state[0]]
    let name = textState[1]
    if name == "top level" || name == "main" {
        fail(describeLocation(location) + ": native can only provide the body of a library function")
    }
    let library = tokenTexts[state[0] + 1]
    state[0] = state[0] + 2
    let function = findFunction(functionNames, symbolKinds, functionReturnTypes, name)
    let count = functionParameterCounts[function]
    if state[3] != count {
        fail(describeLocation(location) + ": native must be the only statement in its function")
    }
    let callee = "minyar_" + library + "_" + readableDeclarationName(name)
    let signature = ""
    let arguments = ""
    let parameter = 0
    while parameter < count {
        let type = localTypes[parameter]
        if !isNativeType(type) {
            fail(describeLocation(location) + ": native functions accept Integer, Float, Boolean, Character, Text, and Bytes, not " + describeType(type))
        }
        if parameter > 0 {
            signature = signature + ", "
            arguments = arguments + ", "
        }
        signature = signature + nativeType(type)
        arguments = arguments + nativeType(type) + " %argument." + Text(parameter)
        parameter = parameter + 1
    }
    if returnType != 5 && !isNativeType(returnType) {
        fail(describeLocation(location) + ": native functions return Nothing, Integer, Float, Boolean, Character, Text, or Bytes")
    }
    let result = llvmType(returnType)
    if returnType == 4 {
        result = "zeroext i1"
    }
    addOutput(output, "  ; minyar-native: " + library + "|declare " + result + " @" + callee + "(" + signature + ")\n")
    if returnType == 5 {
        addOutput(output, "  call void @" + callee + "(" + arguments + ")\n")
    } else {
        addOutput(output, "  %native.result = call " + result + " @" + callee + "(" + arguments + ")\n")
    }
    addOutput(output, "  call void @minyar_rc_leave()\n")
    addOutput(output, "  call void @minyar_stack_leave()\n")
    if returnType == 5 {
        addOutput(output, "  ret void\n")
    } else {
        addOutput(output, "  ret " + llvmType(returnType) + " %native.result\n")
    }
}

function appendNativeDeclarations(output: List<Text>) {
    let marker = "  ; minyar-native: "
    let libraries: List<Text> = []
    let declarations: List<Text> = []
    let count = output.length
    let piece = 0
    while piece < count {
        let text = output[piece]
        if text.length > marker.length && text[2] == ';' && text.slice(0, marker.length) == marker {
            let body = text.slice(marker.length, text.length - 1)
            let separator = findCharacter(body, '|')
            let library = body.slice(0, separator)
            let declaration = body.slice(separator + 1, body.length)
            if findText(libraries, library) < 0 {
                libraries.add(library)
            }
            if findText(declarations, declaration) < 0 {
                declarations.add(declaration)
            }
        }
        piece = piece + 1
    }
    piece = 0
    while piece < declarations.length {
        addOutput(output, declarations[piece] + "\n")
        piece = piece + 1
    }
    piece = 0
    while piece < libraries.length {
        addOutput(output, "; minyar-native-library: " + libraries[piece] + "\n")
        piece = piece + 1
    }
}

function compileBlock(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, returnType: Integer): Boolean {
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "{")
    skipTerminators(tokenKinds, state)
    let firstScopedLocal = state[3]
    let returns = false
    let terminated = false
    while !tokenIs(tokenKinds, tokenTexts, state, "}") {
        if terminated {
            textState[0] = "dead." + Text(newLabel(state))
            addOutput(output, "\n" + textState[0] + ":\n")
        }
        terminated = compileStatement(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, returnType)
        returns = returns || terminated
        finishStatement(tokenKinds, tokenTexts, tokenLines, state)
    }
    if returns && !terminated {
        addOutput(output, "  unreachable\n")
    }
    expectToken(tokenKinds, tokenTexts, tokenLines, state, "}")
    if !returns {
        let local = firstScopedLocal
        while local < state[3] {
            rootLocal(output, state, localIds[local], "null", localTypes[local])
            local = local + 1
        }
    }
    state[3] = firstScopedLocal
    return returns
}

function compileStatement(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, localNames: List<Text>, localTypes: List<Integer>, localIds: List<Integer>, localLengths: List<Integer>, state: List<Integer>, textState: List<Text>, output: List<Text>, returnType: Integer): Boolean {
    let returns = false
    let referenceEffects = state[7]
    if tokenIs(tokenKinds, tokenTexts, state, "else") {
        fail(describeLocation(tokenLines[state[0]]) + ": 'else' belongs on the same line as the closing brace of its if")
    }
    if tokenIs(tokenKinds, tokenTexts, state, "native") && tokenKinds[state[0] + 1] == 3 {
        compileNative(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, returnType)
        return true
    }
    if tokenIs(tokenKinds, tokenTexts, state, "let") {
        state[0] = state[0] + 1
        if tokenKinds[state[0]] != 1 {
            fail(describeLocation(tokenLines[state[0]]) + ": expected a name after let")
        }
        let name = tokenTexts[state[0]]
        let nameLocation = tokenLines[state[0]]
        state[0] = state[0] + 1
        let declaredType = 0
        if tokenIs(tokenKinds, tokenTexts, state, ":") {
            state[0] = state[0] + 1
            declaredType = takeType(tokenKinds, tokenTexts, tokenLines, state, functionNames, symbolKinds)
        }
        expectToken(tokenKinds, tokenTexts, tokenLines, state, "=")
        if tokenKinds[state[0]] == 1 && state[0] + 1 < tokenTexts.length && tokenTexts[state[0] + 1] == "{" {
            prepareScalarRecord(tokenKinds, tokenTexts, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterTypes, state, name)
        }
        let valueType: List<Integer> = []
        valueType.add(declaredType)
        let value = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, valueType)
        if valueType[0] == 100000 {
            if !isListType(declaredType) {
                fail("an empty List needs a type, such as List<Text>")
            }
            valueType[0] = declaredType
            if isReferenceType(listElementType(declaredType)) {
                addOutput(output, "  call void @minyar_list_references(ptr ")
                addOutput(output, value)
                addOutput(output, ")\n")
            }
        }
        if declaredType != 0 && declaredType != valueType[0] {
            fail(describeLocation(nameLocation) + ": the value for '" + name + "' does not match its declared type")
        }
        let type = valueType[0]
        if type == 5 || type == 6 {
            fail("Nothing cannot be stored in a binding")
        }
        let id = nextLocal(state)
        addLocal(localNames, localTypes, localIds, localLengths, state, name, type, id)
        assignReference(output, state, id, value, valueType)
        addOutput(output, "  store ")
        addOutput(output, llvmType(type))
        addOutput(output, " ")
        addOutput(output, value)
        addOutput(output, ", ptr %local.")
        addOutput(output, Text(id))
        addOutput(output, "\n")
    } else {
        if tokenIs(tokenKinds, tokenTexts, state, "return") {
            if textState[1] == "top level" {
                fail(describeLocation(tokenLines[state[0]]) + ": use exit(status) to finish a top-level program")
            }
            state[0] = state[0] + 1
            let valueType: List<Integer> = []
            valueType.add(returnType)
            let value = ""
            if tokenKinds[state[0]] != 6 && !tokenIs(tokenKinds, tokenTexts, state, "}") {
                value = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, valueType)
            } else {
                setType(valueType, 5)
            }
            if valueType[0] != returnType {
                fail("a returned value has the wrong type")
            }
            if isReferenceType(valueType[0]) && !takeResult(output, state, value, valueType) {
                addOutput(output, "  call void @minyar_rc_retain(ptr ")
                addOutput(output, value)
                addOutput(output, ")\n")
            }
            addOutput(output, "  call void @minyar_rc_leave()\n")
            addOutput(output, "  call void @minyar_stack_leave()\n")
            if textState[1] == "main" {
                let temporary = newTemporary(state)
                addOutput(output, "  %value.")
                addOutput(output, Text(temporary))
                addOutput(output, " = trunc i64 ")
                addOutput(output, value)
                addOutput(output, " to i32\n")
                addOutput(output, "  ret i32 %value.")
                addOutput(output, Text(temporary))
                addOutput(output, "\n")
            } else {
                addOutput(output, "  ret ")
                addOutput(output, llvmType(valueType[0]))
                addOutput(output, " ")
                addOutput(output, value)
                addOutput(output, "\n")
            }
            returns = true
        } else {
            if tokenIs(tokenKinds, tokenTexts, state, "if") {
                state[0] = state[0] + 1
                let conditionType: List<Integer> = []
                conditionType.add(0)
                let condition = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, conditionType)
                requireType(tokenLines, state, conditionType[0], 4, "an if condition must be Boolean")
                let thenLabel = newLabel(state)
                let elseLabel = newLabel(state)
                let endLabel = newLabel(state)
                let branchSlot = output.length
                addOutput(output, "")
                textState[0] = "if.then." + Text(thenLabel)
                let thenReturns = compileBlock(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, returnType)
                if !thenReturns {
                    addOutput(output, "  br label %if.end.")
                    addOutput(output, Text(endLabel))
                    addOutput(output, "\n")
                }
                let hasElse = tokenIs(tokenKinds, tokenTexts, state, "else")
                let falseTarget = "if.end." + Text(endLabel)
                if hasElse {
                    falseTarget = "if.else." + Text(elseLabel)
                }
                output[branchSlot] = "  br i1 " + condition + ", label %if.then." + Text(thenLabel) + ", label %" + falseTarget + "\n\nif.then." + Text(thenLabel) + ":\n"
                let elseReturns = false
                if hasElse {
                    state[0] = state[0] + 1
                    addOutput(output, "\nif.else.")
                    addOutput(output, Text(elseLabel))
                    addOutput(output, ":\n")
                    textState[0] = "if.else." + Text(elseLabel)
                    if tokenIs(tokenKinds, tokenTexts, state, "if") {
                        // else if: the nested if statement is the whole else branch.
                        elseReturns = compileStatement(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, returnType)
                    } else {
                        elseReturns = compileBlock(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, returnType)
                    }
                    if !elseReturns {
                        addOutput(output, "  br label %if.end.")
                        addOutput(output, Text(endLabel))
                        addOutput(output, "\n")
                    }
                }
                if !(thenReturns && hasElse && elseReturns) {
                    addOutput(output, "\nif.end.")
                    addOutput(output, Text(endLabel))
                    addOutput(output, ":\n")
                    textState[0] = "if.end." + Text(endLabel)
                }
                returns = thenReturns && hasElse && elseReturns
            } else {
                if tokenIs(tokenKinds, tokenTexts, state, "for") && tokenKinds[state[0] + 1] == 1 && tokenTexts[state[0] + 2] == "in" {
                    compileFor(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, returnType)
                } else {
                if (tokenIs(tokenKinds, tokenTexts, state, "break") || tokenIs(tokenKinds, tokenTexts, state, "continue")) && (tokenKinds[state[0] + 1] == 6 || tokenTexts[state[0] + 1] == "}") {
                    compileLoopJump(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output)
                    returns = true
                } else {
                if tokenIs(tokenKinds, tokenTexts, state, "while") {
                    state[0] = state[0] + 1
                    let conditionLabel = newLabel(state)
                    let bodyLabel = newLabel(state)
                    let endLabel = newLabel(state)
                    addOutput(output, "  br label %while.condition.")
                    addOutput(output, Text(conditionLabel))
                    addOutput(output, "\n\nwhile.condition.")
                    addOutput(output, Text(conditionLabel))
                    addOutput(output, ":\n")
                    textState[0] = "while.condition." + Text(conditionLabel)
                    let conditionType: List<Integer> = []
                    conditionType.add(0)
                    let condition = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, conditionType)
                    requireType(tokenLines, state, conditionType[0], 4, "a while condition must be Boolean")
                    addOutput(output, "  br i1 ")
                    addOutput(output, condition)
                    addOutput(output, ", label %while.body.")
                    addOutput(output, Text(bodyLabel))
                    addOutput(output, ", label %while.end.")
                    addOutput(output, Text(endLabel))
                    addOutput(output, "\n\nwhile.body.")
                    addOutput(output, Text(bodyLabel))
                    addOutput(output, ":\n")
                    textState[0] = "while.body." + Text(bodyLabel)
                    let markerScope = state[3]
                    addLocal(localNames, localTypes, localIds, localLengths, state, " loop", -1, conditionLabel)
                    let bodyReturns = compileBlock(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, returnType)
                    state[3] = markerScope
                    if !bodyReturns {
                        /* A long scalar loop must still service cleanup debt
                           created before it. Scalar-only functions erase this
                           call in finishFunctionEntry. */
                        addOutput(output, "  call void @minyar_rc_step()\n")
                        addOutput(output, "  br label %while.condition.")
                        addOutput(output, Text(conditionLabel))
                        addOutput(output, "\n")
                    }
                    addOutput(output, "\nwhile.end.")
                    addOutput(output, Text(endLabel))
                    addOutput(output, ":\n")
                    textState[0] = "while.end." + Text(endLabel)
                } else {
                    if tokenKinds[state[0]] == 1 && tokenTexts[state[0] + 1] == "=" {
                        let name = tokenTexts[state[0]]
                        let local = findLocal(localNames, localLengths, state, name)
                        if local < 0 {
                            fail("I can't find a value named '" + name + "'")
                        }
                        state[0] = state[0] + 2
                        let valueType: List<Integer> = []
                        valueType.add(localTypes[local])
                        // For x = x + e, transfer x's local owner into the
                        // consuming Text join. Runtime uniqueness still guards
                        // in-place growth; aliases take the copying fallback.
                        if localTypes[local] == 2 && tokenKinds[state[0]] == 1 && tokenTexts[state[0]] == name && tokenTexts[state[0] + 1] == "+" {
                            valueType.add(-1)
                            valueType.add(localIds[local])
                            valueType.add(state[0])
                        }
                        let value = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, valueType)
                        if valueType[0] != localTypes[local] {
                            fail("an assignment to '" + name + "' has the wrong type")
                        }
                        assignReference(output, state, localIds[local], value, valueType)
                        addOutput(output, "  store ")
                        addOutput(output, llvmType(valueType[0]))
                        addOutput(output, " ")
                        addOutput(output, value)
                        addOutput(output, ", ptr %local.")
                        addOutput(output, Text(localIds[local]))
                        addOutput(output, "\n")
                    } else {
                        let assignmentOperator = assignmentOperatorPosition(tokenKinds, tokenTexts, state[0])
                        if assignmentOperator >= 0 {
                            compileAssignment(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, assignmentOperator)
                        } else {
                            let ignoredType: List<Integer> = []
                            ignoredType.add(0)
                            let ignored = parseExpression(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, ignoredType)
                            if ignoredType[0] == 6 {
                                addOutput(output, "  unreachable\n")
                                returns = true
                            }
                        }
                        }
                        }
                    }
                }
            }
        }
    }
    if !returns && state[7] != referenceEffects {
        addOutput(output, "  call void @minyar_rc_step()\n")
    }
    return returns
}

// Parameter bindings that are never assigned retain their incoming SSA value.
// Scan the body once; same-name assignments in nested scopes conservatively
// disable replacement. List element writes do not change the binding itself.
// Limit name matching to 64 parameters so extra analysis remains linear.
function markAssignedParameters(tokenKinds: List<Integer>, tokenTexts: List<Text>, start: Integer, names: List<Text>, types: List<Integer>) {
    let count = names.length
    let parameter = 0
    while parameter < count {
        if count > 64 { types.add(1) } else { types.add(0) }
        parameter = parameter + 1
    }
    if count == 0 || count > 64 { return }
    let position = start
    let depth = 0
    let done = false
    while tokenKinds[position] != 0 && !done {
        if tokenKinds[position] == 1 && tokenKinds[position + 1] == 4 && isAssignmentOperator(tokenTexts[position + 1]) {
            parameter = 0
            while parameter < count {
                if tokenTexts[position] == names[parameter] { types[count + parameter] = 1 }
                parameter = parameter + 1
            }
        }
        if tokenKinds[position] == 4 {
            if tokenTexts[position] == "{" { depth = depth + 1 }
            if tokenTexts[position] == "}" {
                depth = depth - 1
                if depth == 0 { done = true }
            }
        }
        position = position + 1
    }
}

function compileFunctions(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, output: List<Text>, stackOwnerLimit: Integer) {
    let state: List<Integer> = []
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(-1)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(1)
    state.add(-1)
    state.add(0)
    let textState: List<Text> = []
    textState.add("entry")
    textState.add("")

    skipTerminators(tokenKinds, state)
    while tokenKinds[state[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, state, "record") {
            skipDeclaration(tokenKinds, tokenTexts, state)
        } else {
        if tokenIs(tokenKinds, tokenTexts, state, "function") {
        expectToken(tokenKinds, tokenTexts, tokenLines, state, "function")
        let name = tokenTexts[state[0]]
        state[0] = state[0] + 1
        textState[1] = name
        expectToken(tokenKinds, tokenTexts, tokenLines, state, "(")
        let parameterNames: List<Text> = []
        let parameterTypes: List<Integer> = []
        while !tokenIs(tokenKinds, tokenTexts, state, ")") {
            parameterNames.add(tokenTexts[state[0]])
            state[0] = state[0] + 1
            expectToken(tokenKinds, tokenTexts, tokenLines, state, ":")
            parameterTypes.add(takeType(tokenKinds, tokenTexts, tokenLines, state, functionNames, symbolKinds))
            if tokenIs(tokenKinds, tokenTexts, state, ",") {
                state[0] = state[0] + 1
            }
        }
        expectToken(tokenKinds, tokenTexts, tokenLines, state, ")")
        let returnType = 5
        if name == "main" {
            returnType = 1
        }
        if tokenIs(tokenKinds, tokenTexts, state, ":") {
            state[0] = state[0] + 1
            returnType = takeType(tokenKinds, tokenTexts, tokenLines, state, functionNames, symbolKinds)
        }

        markAssignedParameters(tokenKinds, tokenTexts, state[0], parameterNames, parameterTypes)
        state[1] = 0
        state[2] = 0
        state[3] = 0
        state[4] = parameterNames.length
        state[6] = 0
        state[7] = 0
        state[8] = 0
        state[9] = state[9] + 1
        state[10] = -1
        state[11] = 0
        // Only parseCall writes a resolved user-function index into this cache.
        // Reset it per body in bounded mode: -1 at finish proves no user call.
        // Ordinary mode retains its existing cross-body cache behavior.
        if stackOwnerLimit > 0 { state[5] = -1 }
        textState[0] = "entry"
        let localNames: List<Text> = []
        let localTypes: List<Integer> = []
        let localIds: List<Integer> = []
        let localLengths: List<Integer> = []

        let emittedReturn = llvmType(returnType)
        if name == "main" {
            emittedReturn = "i32"
        }
        addOutput(output, "define ")
        addOutput(output, emittedReturn)
        addOutput(output, " @")
        addOutput(output, name)
        addOutput(output, "(")
        if name == "main" {
            addOutput(output, "i32 %minyar.argument.count, ptr %minyar.argument.values")
        } else {
            let parameter = 0
            while parameter < parameterNames.length {
                if parameter > 0 {
                    addOutput(output, ", ")
                }
                addOutput(output, llvmType(parameterTypes[parameter]))
                addOutput(output, " ")
                let id = parameter
                if parameterTypes[parameterNames.length + parameter] == 0 {
                    id = -output.length - 1
                }
                parameterTypes[parameterNames.length + parameter] = id
                addOutput(output, "%argument." + Text(parameter))
                parameter = parameter + 1
            }
        }
        addOutput(output, ") {\nentry:\n")
        let entrySlot = output.length
        addOutput(output, "")
        if name == "main" {
            addOutput(output, "  call void @minyar_initialize_arguments(i32 %minyar.argument.count, ptr %minyar.argument.values)\n")
        }
        let parameter = 0
        while parameter < parameterNames.length {
            let id = parameterTypes[parameterNames.length + parameter]
            addLocal(localNames, localTypes, localIds, localLengths, state, parameterNames[parameter], parameterTypes[parameter], id)
            if id >= 0 {
            // Synchronous calls borrow arguments protected by the caller. The
            // ownership slot starts null; assignment establishes a local owner.
            addOutput(output, "  %local.")
            addOutput(output, Text(parameter))
            addOutput(output, " = alloca ")
            addOutput(output, llvmType(parameterTypes[parameter]))
            addOutput(output, "\n")
            addOutput(output, "  store ")
            addOutput(output, llvmType(parameterTypes[parameter]))
            addOutput(output, " %argument.")
            addOutput(output, Text(parameter))
            addOutput(output, ", ptr %local.")
            addOutput(output, Text(parameter))
            addOutput(output, "\n")
            }
            parameter = parameter + 1
        }
        let returns = compileBlock(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, returnType)
        if !returns {
            addOutput(output, "  call void @minyar_rc_leave()\n")
            addOutput(output, "  call void @minyar_stack_leave()\n")
            if name == "main" {
                addOutput(output, "  ret i32 0\n")
            } else {
                if returnType == 5 {
                    addOutput(output, "  ret void\n")
                } else {
                    fail("function '" + readableDeclarationName(name) + "' must return a value on every path")
                }
            }
        }
        finishFunctionEntry(output, entrySlot, state[4], parameterNames.length, state[8], state[6] == 1)
        if stackOwnerLimit > 0 && name != "main" && state[5] == -1 && state[6] == 1 && state[8] >= 1 && state[8] <= stackOwnerLimit {
            finishStackOwnership(output, entrySlot, state[8])
        }
        addOutput(output, "}\n\n")
        } else {
            skipTopLevelStatement(tokenKinds, tokenTexts, state)
        }
        }
        skipTerminators(tokenKinds, state)
    }
}

function compileTopLevel(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, functionNames: List<Text>, symbolKinds: List<Integer>, functionReturnTypes: List<Integer>, functionParameterCounts: List<Integer>, functionParameterNames: List<Text>, functionParameterTypes: List<Integer>, output: List<Text>) {
    let state: List<Integer> = []
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(-1)
    state.add(0)
    state.add(0)
    state.add(0)
    state.add(1)
    state.add(-1)
    state.add(0)
    let textState: List<Text> = []
    textState.add("entry")
    textState.add("top level")
    let localNames: List<Text> = []
    let localTypes: List<Integer> = []
    let localIds: List<Integer> = []
    let localLengths: List<Integer> = []

    addOutput(output, "define i32 @main(i32 %minyar.argument.count, ptr %minyar.argument.values) {\nentry:\n")
    let entrySlot = output.length
    addOutput(output, "")
    addOutput(output, "  call void @minyar_initialize_arguments(i32 %minyar.argument.count, ptr %minyar.argument.values)\n")

    skipTerminators(tokenKinds, state)
    let terminated = false
    while tokenKinds[state[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, state, "record") || tokenIs(tokenKinds, tokenTexts, state, "function") {
            skipDeclaration(tokenKinds, tokenTexts, state)
        } else {
            if tokenIs(tokenKinds, tokenTexts, state, "constant") {
                skipTopLevelStatement(tokenKinds, tokenTexts, state)
            } else {
            if terminated {
                textState[0] = "dead." + Text(newLabel(state))
            addOutput(output, "\n" + textState[0] + ":\n")
            }
            terminated = compileStatement(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, localNames, localTypes, localIds, localLengths, state, textState, output, 1)
            finishStatement(tokenKinds, tokenTexts, tokenLines, state)
            }
        }
        skipTerminators(tokenKinds, state)
    }
    if !terminated {
        addOutput(output, "  call void @minyar_rc_leave()\n")
        addOutput(output, "  call void @minyar_stack_leave()\n")
        addOutput(output, "  ret i32 0\n")
    }
    finishFunctionEntry(output, entrySlot, state[4], 0, state[8], state[6] == 1)
    addOutput(output, "}\n\n")
}

function compileTokens(tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, scannedStarts: List<Integer>, scannedEnds: List<Integer>, stackOwnerLimit: Integer): Text {
    let functionNames: List<Text> = []
    let symbolKinds: List<Integer> = []
    let symbolLocations: List<Text> = []
    let functionReturnTypes: List<Integer> = []
    let functionParameterCounts: List<Integer> = []
    let functionParameterNames: List<Text> = []
    let functionParameterTypes: List<Integer> = []
    let declarationEnds: List<Integer> = []
    let topLevelStatements = false
    if scannedStarts.length > 0 {
        topLevelStatements = recordScannedDeclarations(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds, functionNames, symbolKinds, symbolLocations, functionReturnTypes, functionParameterCounts, declarationEnds)
    } else {
        topLevelStatements = discoverRecordNames(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, symbolLocations, functionReturnTypes, functionParameterCounts, declarationEnds)
    }
    let symbolLookup = buildSymbolLookup(functionNames, symbolKinds)
    requireUniqueSymbols(symbolLookup, functionNames, symbolKinds, symbolLocations)
    let parameterStarts: List<Integer> = []
    let recordIndex = 0
    while recordIndex < functionNames.length {
        parameterStarts.add(0)
        recordIndex = recordIndex + 1
    }
    discoverDeclarations(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, symbolLocations, functionReturnTypes, symbolLookup, functionParameterCounts, functionParameterNames, functionParameterTypes, parameterStarts, declarationEnds)
    appendParameterOffsets(functionParameterCounts, parameterStarts)
    symbolLookup = buildSymbolLookup(functionNames, symbolKinds)
    requireUniqueSymbols(symbolLookup, functionNames, symbolKinds, symbolLocations)
    let lookupPosition = 0
    while lookupPosition < symbolLookup.length {
        functionReturnTypes.add(symbolLookup[lookupPosition])
        lookupPosition = lookupPosition + 1
    }

    let output: List<Text> = []
    addOutput(output, "; Generated by the compiler written in Minyar.\n\n")
    let position = 0
    while position < tokenKinds.length {
        if tokenKinds[position] == 3 || tokenKinds[position] == 5 {
            let literal = tokenTexts[position]
            addOutput(output, "@.text.data.")
            addOutput(output, Text(position))
            addOutput(output, " = private unnamed_addr constant [")
            addOutput(output, Text(literal.byteLength + 1))
            addOutput(output, " x i8] c\"")
            addOutput(output, escapeLLVMText(literal))
            addOutput(output, "\\00\"\n")
            if literal.length == literal.byteLength {
                addOutput(output, "@.text.")
                addOutput(output, Text(position))
                addOutput(output, " = private constant { i64, ptr, i64, i64, ptr, ptr } { i64 0, ptr @.text.data.")
                addOutput(output, Text(position))
                addOutput(output, ", i64 ")
                addOutput(output, Text(literal.byteLength))
                addOutput(output, ", i64 ")
                addOutput(output, Text(literal.byteLength))
                addOutput(output, ", ptr null, ptr null }\n")
            } else {
                addOutput(output, "@.text.")
                addOutput(output, Text(position))
                addOutput(output, " = private global { i64, ptr, i64, i64, ptr, ptr } { i64 0, ptr @.text.data.")
                addOutput(output, Text(position))
                addOutput(output, ", i64 ")
                addOutput(output, Text(literal.byteLength))
                addOutput(output, ", i64 -1, ptr null, ptr null }\n")
            }
        }
        position = position + 1
    }

    addOutput(output, "\ndeclare void @minyar_rc_enter(i64)\n")
    addOutput(output, "declare void @minyar_rc_leave()\n")
    addOutput(output, "declare void @minyar_stack_enter()\n")
    addOutput(output, "declare void @minyar_stack_leave()\n")
    addOutput(output, "declare void @minyar_rc_keep(ptr)\n")
    addOutput(output, "declare void @minyar_rc_borrow(ptr)\n")
    addOutput(output, "declare void @minyar_rc_retain(ptr)\n")
    addOutput(output, "declare void @minyar_rc_local(i64, ptr)\n")
    addOutput(output, "declare void @minyar_rc_local_take(i64, ptr)\n")
    addOutput(output, "declare void @minyar_rc_local_move(i64)\n")
    addOutput(output, "declare void @minyar_rc_step()\n")
    addOutput(output, "declare void @minyar_print_integer(i64)\n")
    addOutput(output, "declare void @minyar_print_text(ptr)\n")
    addOutput(output, "declare void @minyar_print_character(i32)\n")
    addOutput(output, "declare void @minyar_print_boolean(i1)\n")
    addOutput(output, "declare void @minyar_fail(ptr)\n")
    addOutput(output, "declare void @minyar_exit(i64)\n")
    addOutput(output, "declare void @minyar_print_float(double)\n")
    addOutput(output, "declare void @minyar_record_replace(ptr, i64, i64, i64)\n")
    addOutput(output, "declare i64 @minyar_bytes_get(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_set(ptr, i64, i64)\n")
    addOutput(output, "declare i64 @minyar_bytes_length(ptr)\n")
    addOutput(output, "declare ptr @minyar_bytes_new(i64)\n")
    addOutput(output, "declare void @minyar_bytes_resize(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_clear(ptr)\n")
    addOutput(output, "declare void @minyar_bytes_add(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_append(ptr, ptr)\n")
    addOutput(output, "declare ptr @minyar_bytes_slice(ptr, i64, i64)\n")
    addOutput(output, "declare ptr @minyar_read_bytes_file(ptr)\n")
    addOutput(output, "declare void @minyar_write_bytes_file(ptr, ptr)\n")
    addOutput(output, "declare void @minyar_bytes_add_int16(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_set_int16(ptr, i64, i64)\n")
    addOutput(output, "declare i64 @minyar_bytes_get_int16(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_add_uint16(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_set_uint16(ptr, i64, i64)\n")
    addOutput(output, "declare i64 @minyar_bytes_get_uint16(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_add_int32(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_set_int32(ptr, i64, i64)\n")
    addOutput(output, "declare i64 @minyar_bytes_get_int32(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_add_uint32(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_set_uint32(ptr, i64, i64)\n")
    addOutput(output, "declare i64 @minyar_bytes_get_uint32(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_add_int64(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_set_int64(ptr, i64, i64)\n")
    addOutput(output, "declare i64 @minyar_bytes_get_int64(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_add_float32(ptr, double)\n")
    addOutput(output, "declare void @minyar_bytes_set_float32(ptr, i64, double)\n")
    addOutput(output, "declare double @minyar_bytes_get_float32(ptr, i64)\n")
    addOutput(output, "declare void @minyar_bytes_add_float64(ptr, double)\n")
    addOutput(output, "declare void @minyar_bytes_set_float64(ptr, i64, double)\n")
    addOutput(output, "declare double @minyar_bytes_get_float64(ptr, i64)\n")
    addOutput(output, "declare ptr @minyar_float_text(double)\n")
    addOutput(output, "declare i64 @minyar_float_integer(double)\n")
    addOutput(output, "declare i32 @minyar_integer_character(i64)\n")
    addOutput(output, "declare i64 @minyar_integer_absolute(i64)\n")
    addOutput(output, "declare void @minyar_check_clamp_integer(i64, i64)\n")
    addOutput(output, "declare void @minyar_check_clamp_float(double, double)\n")
    addOutput(output, "declare void @minyar_check_shift(i64)\n")
    addOutput(output, "declare double @minyar_tan(double)\n")
    addOutput(output, "declare double @minyar_asin(double)\n")
    addOutput(output, "declare double @minyar_acos(double)\n")
    addOutput(output, "declare double @minyar_atan(double)\n")
    addOutput(output, "declare double @minyar_atan2(double, double)\n")
    addOutput(output, "declare double @llvm.sqrt.f64(double)\n")
    addOutput(output, "declare double @llvm.sin.f64(double)\n")
    addOutput(output, "declare double @llvm.cos.f64(double)\n")
    addOutput(output, "declare double @llvm.exp.f64(double)\n")
    addOutput(output, "declare double @llvm.log.f64(double)\n")
    addOutput(output, "declare double @llvm.floor.f64(double)\n")
    addOutput(output, "declare double @llvm.ceil.f64(double)\n")
    addOutput(output, "declare double @llvm.round.f64(double)\n")
    addOutput(output, "declare double @llvm.fabs.f64(double)\n")
    addOutput(output, "declare double @llvm.pow.f64(double, double)\n")
    addOutput(output, "declare double @llvm.minnum.f64(double, double)\n")
    addOutput(output, "declare double @llvm.maxnum.f64(double, double)\n")
    addOutput(output, "declare i1 @minyar_texts_are_equal(ptr, ptr)\n")
    addOutput(output, "declare ptr @minyar_join_text(ptr, ptr)\n")
    addOutput(output, "declare ptr @minyar_join_text_take_left(ptr, ptr)\n")
    addOutput(output, "declare ptr @minyar_join_texts(ptr)\n")
    addOutput(output, "declare i64 @minyar_text_length(ptr)\n")
    addOutput(output, "declare i64 @minyar_text_byte_length(ptr)\n")
    addOutput(output, "declare i32 @minyar_text_character_at(ptr, i64)\n")
    addOutput(output, "declare ptr @minyar_text_slice(ptr, i64, i64)\n")
    addOutput(output, "declare ptr @minyar_integer_text(i64)\n")
    addOutput(output, "declare ptr @minyar_character_text(i32)\n")
    addOutput(output, "declare ptr @minyar_boolean_text(i1)\n")
    addOutput(output, "declare void @minyar_initialize_arguments(i32, ptr)\n")
    addOutput(output, "declare i64 @minyar_argument_count()\n")
    addOutput(output, "declare ptr @minyar_argument(i64)\n")
    addOutput(output, "declare ptr @minyar_read_text_file(ptr)\n")
    addOutput(output, "declare void @minyar_write_text_file(ptr, ptr)\n")
    addOutput(output, "declare ptr @minyar_list_new()\n")
    addOutput(output, "declare void @minyar_list_references(ptr)\n")
    addOutput(output, "declare void @minyar_list_add(ptr, i64)\n")
    addOutput(output, "declare void @minyar_list_add_take(ptr, i64)\n")
    addOutput(output, "declare i64 @minyar_list_length(ptr)\n")
    addOutput(output, "declare i64 @minyar_list_get(ptr, i64)\n")
    addOutput(output, "declare void @minyar_list_set(ptr, i64, i64)\n")
    addOutput(output, "declare void @minyar_list_set_take(ptr, i64, i64)\n")
    addOutput(output, "declare ptr @minyar_list_appended(ptr, i64, i64, i64)\n")
    addOutput(output, "declare ptr @minyar_record_new(i64)\n")
    addOutput(output, "declare ptr @minyar_record_new_scalar(i64)\n")
    addOutput(output, "declare i64 @minyar_record_get(ptr, i64)\n")
    addOutput(output, "declare void @minyar_record_set(ptr, i64, i64)\n")
    addOutput(output, "declare void @minyar_record_set_scalar(ptr, i64, i64)\n")
    addOutput(output, "declare void @minyar_record_set_reference(ptr, i64, i64)\n")
    addOutput(output, "declare void @minyar_record_set_take(ptr, i64, i64)\n")
    addOutput(output, "declare void @minyar_check_integer_overflow(i1)\n")
    addOutput(output, "declare void @minyar_check_integer_division(i64, i64)\n")
    addOutput(output, "declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)\n")
    addOutput(output, "declare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)\n")
    addOutput(output, "declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)\n\n")
    let mainFunction = findIndexedSymbol(symbolLookup, functionNames, symbolKinds, "main", 1)
    if topLevelStatements && mainFunction >= 0 {
        fail(describeLocation(symbolLocations[mainFunction]) + ": a program cannot combine top-level statements with function main()")
    }
    compileFunctions(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, output, stackOwnerLimit)
    if mainFunction < 0 {
        compileTopLevel(tokenKinds, tokenTexts, tokenLines, functionNames, symbolKinds, functionReturnTypes, functionParameterCounts, functionParameterNames, functionParameterTypes, output)
    }
    if stackOwnerLimit > 0 {
        if findIndexedSymbol(symbolLookup, functionNames, symbolKinds, "minyar_rc_enter_stack_v1", 1) >= 0 || findIndexedSymbol(symbolLookup, functionNames, symbolKinds, "minyar_rc_leave_stack_v1", 1) >= 0 {
            fail("function name is reserved by the bounded ownership runtime")
        }
        addOutput(output, "declare void @minyar_rc_enter_stack_v1(ptr, ptr, i64)\n")
        addOutput(output, "declare void @minyar_rc_leave_stack_v1(ptr)\n")
    }
    appendNativeDeclarations(output)
    return joinText(output)
}

function compileProgram(source: Text): Text {
    let tokenKinds: List<Integer> = []
    let tokenTexts: List<Text> = []
    let tokenLines: List<Text> = []
    tokenize(source, tokenKinds, tokenTexts, tokenLines)
    let scannedStarts: List<Integer> = []
    let scannedEnds: List<Integer> = []
    return compileTokens(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds, 0)
}

function pathCharacterIsSeparator(character: Character): Boolean {
    return character == '/' || character == '\\'
}

function normalizePath(path: Text): Text {
    let parts: List<Text> = []
    let activeParts = 0
    let position = 0
    let absolute = false
    let drive = ""

    if path.length >= 2 && path[1] == ':' {
        drive = Text(path[0]) + ":"
        position = 2
        if position < path.length && pathCharacterIsSeparator(path[position]) {
            absolute = true
            position = position + 1
        }
    } else {
        if path.length > 0 && pathCharacterIsSeparator(path[0]) {
            absolute = true
            position = 1
        }
    }

    let part = ""
    while position <= path.length {
        let atEnd = position == path.length
        if atEnd || pathCharacterIsSeparator(path[position]) {
            if part == ".." {
                if activeParts > 0 && parts[activeParts - 1] != ".." {
                    activeParts = activeParts - 1
                } else {
                    if !absolute {
                        if activeParts < parts.length {
                            parts[activeParts] = part
                        } else {
                            parts.add(part)
                        }
                        activeParts = activeParts + 1
                    }
                }
            } else {
                if part != "" && part != "." {
                    if activeParts < parts.length {
                        parts[activeParts] = part
                    } else {
                        parts.add(part)
                    }
                    activeParts = activeParts + 1
                }
            }
            part = ""
        } else {
            part = part + Text(path[position])
        }
        position = position + 1
    }

    let result = drive
    if absolute {
        result = result + "/"
    }
    position = 0
    while position < activeParts {
        if result.length > 0 && result[result.length - 1] != '/' {
            result = result + "/"
        }
        result = result + parts[position]
        position = position + 1
    }
    if result == "" {
        result = "."
    }
    return result
}

function directoryOfPath(path: Text): Text {
    let normalized = normalizePath(path)
    let lastSeparator = -1
    let position = 0
    while position < normalized.length {
        if normalized[position] == '/' {
            lastSeparator = position
        }
        position = position + 1
    }
    let directory = ""
    position = 0
    while position < lastSeparator {
        directory = directory + Text(normalized[position])
        position = position + 1
    }
    if lastSeparator == 0 {
        directory = "/"
    }
    return directory
}

function resolveModulePath(importer: Text, specifier: Text): Text {
    let relative = false
    if specifier.length >= 2 && specifier[0] == '.' && pathCharacterIsSeparator(specifier[1]) {
        relative = true
    }
    if specifier.length >= 3 && specifier[0] == '.' && specifier[1] == '.' && pathCharacterIsSeparator(specifier[2]) {
        relative = true
    }
    if !relative {
        fail("package module '" + specifier + "' is not available yet; local modules begin with './' or '../'")
    }
    let directory = directoryOfPath(importer)
    if directory == "" {
        return normalizePath(specifier)
    }
    return normalizePath(directory + "/" + specifier)
}

// Names without ./ or ../ are standard library packages, found in the
// directory passed to the compiler with --library.
function resolveImport(importer: Text, specifier: Text, library: Text): Text {
    let relative = specifier.length >= 2 && specifier[0] == '.' && (pathCharacterIsSeparator(specifier[1]) || specifier[1] == '.')
    if relative || library == "" {
        return resolveModulePath(importer, specifier)
    }
    let position = 0
    while position < specifier.length {
        let character = specifier[position]
        if !characterIsLetter(character) && !characterIsDigit(character) && character != '-' && character != '_' {
            fail("package names use letters, digits, '-', and '_'; found '" + specifier + "'")
        }
        position = position + 1
    }
    return normalizePath(library + "/" + specifier + ".min")
}

function findText(values: List<Text>, wanted: Text): Integer {
    let position = 0
    let found = -1
    while position < values.length && found < 0 {
        if values[position] == wanted {
            found = position
        }
        position = position + 1
    }
    return found
}

function findModuleImport(importOwners: List<Integer>, importAliases: List<Text>, owner: Integer, alias: Text): Integer {
    let position = 0
    let found = -1
    while position < importOwners.length && found < 0 {
        if importOwners[position] == owner && importAliases[position] == alias {
            found = position
        }
        position = position + 1
    }
    return found
}

function loadModule(library: Text, path: Text, isEntry: Boolean, modulePaths: List<Text>, moduleSources: List<Text>, moduleStates: List<Integer>, modulePublic: List<Integer>, moduleTokenStarts: List<Integer>, allTokenKinds: List<Integer>, allTokenTexts: List<Text>, allTokenLines: List<Text>, importOwners: List<Integer>, importAliases: List<Text>, importTargets: List<Integer>, declarationStarts: List<Integer>, declarationEnds: List<Integer>): Integer {
    let canonicalPath = normalizePath(path)
    let existing = findText(modulePaths, canonicalPath)
    if existing >= 0 {
        if moduleStates[existing] == 1 {
            let cycle = ""
            let position = 0
            while position < modulePaths.length {
                if moduleStates[position] == 1 {
                    if cycle != "" {
                        cycle = cycle + " -> "
                    }
                    cycle = cycle + modulePaths[position]
                }
                position = position + 1
            }
            fail("module import cycle: " + cycle + " -> " + canonicalPath)
        }
        return existing
    }

    let module = modulePaths.length
    modulePaths.add(canonicalPath)
    moduleSources.add(readTextFile(canonicalPath))
    moduleStates.add(1)
    modulePublic.add(0)

    moduleTokenStarts.add(allTokenKinds.length)
    tokenize(moduleSources[module], allTokenKinds, allTokenTexts, allTokenLines)
    let cursor: List<Integer> = []
    cursor.add(moduleTokenStarts[module])
    skipTerminators(allTokenKinds, cursor)
    while allTokenKinds[cursor[0]] != 0 {
        if tokenIs(allTokenKinds, allTokenTexts, cursor, "use") {
            let importLine = allTokenLines[cursor[0]]
            cursor[0] = cursor[0] + 1
            if allTokenKinds[cursor[0]] != 3 {
                fail(canonicalPath + ":" + importLine + ": use expects a quoted module name")
            }
            let specifier = allTokenTexts[cursor[0]]
            cursor[0] = cursor[0] + 1
            if !tokenIs(allTokenKinds, allTokenTexts, cursor, "as") {
                fail(canonicalPath + ":" + importLine + ": use expects 'as' after the module name")
            }
            cursor[0] = cursor[0] + 1
            if allTokenKinds[cursor[0]] != 1 {
                fail(canonicalPath + ":" + importLine + ": use expects a module alias after 'as'")
            }
            let alias = allTokenTexts[cursor[0]]
            cursor[0] = cursor[0] + 1
            if findModuleImport(importOwners, importAliases, module, alias) >= 0 {
                fail(canonicalPath + ":" + importLine + ": module alias '" + alias + "' is already used")
            }
            finishStatement(allTokenKinds, allTokenTexts, allTokenLines, cursor)
            let targetPath = resolveImport(canonicalPath, specifier, library)
            let target = loadModule(library, targetPath, false, modulePaths, moduleSources, moduleStates, modulePublic, moduleTokenStarts, allTokenKinds, allTokenTexts, allTokenLines, importOwners, importAliases, importTargets, declarationStarts, declarationEnds)
            importOwners.add(module)
            importAliases.add(alias)
            importTargets.add(target)
        } else {
            let declarationCursor = cursor[0]
            let hasPublic = false
            if tokenIs(allTokenKinds, allTokenTexts, cursor, "public") {
                hasPublic = true
                modulePublic[module] = 1
                declarationCursor = declarationCursor + 1
            }
            let marker: List<Integer> = []
            marker.add(declarationCursor)
            if tokenIs(allTokenKinds, allTokenTexts, marker, "constant") {
                declarationStarts.add(declarationCursor)
                skipTopLevelStatement(allTokenKinds, allTokenTexts, marker)
                declarationEnds.add(marker[0])
                cursor[0] = marker[0]
            } else {
            if tokenIs(allTokenKinds, allTokenTexts, marker, "record") || tokenIs(allTokenKinds, allTokenTexts, marker, "function") {
                declarationStarts.add(declarationCursor)
                skipDeclaration(allTokenKinds, allTokenTexts, marker)
                declarationEnds.add(marker[0])
                cursor[0] = marker[0]
            } else {
                if hasPublic {
                    fail(canonicalPath + ":" + allTokenLines[cursor[0]] + ": public must describe a function, record, or constant declaration")
                }
                if !isEntry {
                    fail(canonicalPath + ":" + allTokenLines[cursor[0]] + ": imported modules may contain declarations but not executable top-level statements")
                }
                declarationStarts.add(-1)
                skipTopLevelStatement(allTokenKinds, allTokenTexts, cursor)
            }
            }
        }
        skipTerminators(allTokenKinds, cursor)
    }
    moduleStates[module] = 2
    return module
}

function qualifiedDeclarationName(module: Integer, name: Text): Text {
    let qualified = "minyar_module_" + Text(module) + "_" + name
    if module == 0 && name == "main" {
        qualified = "main"
    }
    return qualified
}

function findModuleDeclaration(declarationOwners: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, owner: Integer, name: Text, kind: Integer): Integer {
    let position = 0
    let found = -1
    while position < declarationOwners.length && found < 0 {
        if declarationOwners[position] == owner && declarationNames[position] == name && declarationKinds[position] == kind {
            found = position
        }
        position = position + 1
    }
    return found
}

function findIndexedModuleDeclaration(declarationLookup: List<Integer>, declarationQualifiedNames: List<Text>, declarationKinds: List<Integer>, owner: Integer, name: Text, kind: Integer): Integer {
    return findIndexedSymbol(declarationLookup, declarationQualifiedNames, declarationKinds, qualifiedDeclarationName(owner, name), kind)
}

function requireUniqueModuleDeclarations(declarationLookup: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, declarationQualifiedNames: List<Text>, declarationLocations: List<Text>) {
    let position = 1
    while position < declarationLookup.length {
        let previous = declarationLookup[position - 1]
        let current = declarationLookup[position]
        if declarationKinds[previous] == declarationKinds[current] && declarationQualifiedNames[previous] == declarationQualifiedNames[current] {
            let duplicate = current
            if previous > current { duplicate = previous }
            fail(describeLocation(declarationLocations[duplicate]) + ": module declares '" + declarationNames[current] + "' more than once")
        }
        position = position + 1
    }
}

function collectModuleDeclarations(module: Integer, modulePath: Text, tokenStart: Integer, tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, declarationOwners: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, declarationPublic: List<Integer>, declarationQualifiedNames: List<Text>, declarationLocations: List<Text>) {
    let cursor: List<Integer> = []
    cursor.add(tokenStart)
    skipTerminators(tokenKinds, cursor)
    while tokenKinds[cursor[0]] != 0 {
        if tokenIs(tokenKinds, tokenTexts, cursor, "use") {
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
        } else {
            let isPublic = 0
            if tokenIs(tokenKinds, tokenTexts, cursor, "public") {
                isPublic = 1
                cursor[0] = cursor[0] + 1
            }
            let kind = 0
            if tokenIs(tokenKinds, tokenTexts, cursor, "function") {
                kind = 1
            }
            if tokenIs(tokenKinds, tokenTexts, cursor, "record") {
                kind = 2
            }
            if tokenIs(tokenKinds, tokenTexts, cursor, "constant") {
                kind = 3
            }
            if kind > 0 {
                let name = tokenTexts[cursor[0] + 1]
                declarationOwners.add(module)
                declarationNames.add(name)
                declarationKinds.add(kind)
                declarationPublic.add(isPublic)
                declarationQualifiedNames.add(qualifiedDeclarationName(module, name))
                declarationLocations.add(modulePath + ":" + tokenLines[cursor[0] + 1])
                if kind == 3 {
                    skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
                } else {
                    skipDeclaration(tokenKinds, tokenTexts, cursor)
                }
            } else {
                if isPublic == 1 {
                    fail("public must describe a function, record, or constant declaration")
                }
                skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            }
        }
        skipTerminators(tokenKinds, cursor)
    }
}

function importedDeclarationName(module: Integer, alias: Text, name: Text, kind: Integer, location: Text, importOwners: List<Integer>, importAliases: List<Text>, importTargets: List<Integer>, declarationLookup: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, declarationPublic: List<Integer>, declarationQualifiedNames: List<Text>): Text {
    let imported = findModuleImport(importOwners, importAliases, module, alias)
    if imported < 0 {
        fail(describeLocation(location) + ": I can't find an imported module named '" + alias + "'")
    }
    let declaration = findIndexedModuleDeclaration(declarationLookup, declarationQualifiedNames, declarationKinds, importTargets[imported], name, kind)
    if declaration < 0 {
        let declarationKind = "record"
        if kind == 1 {
            declarationKind = "function"
        }
        if kind == 3 {
            declarationKind = "constant"
        }
        fail(describeLocation(location) + ": module '" + alias + "' has no " + declarationKind + " named '" + name + "'")
    }
    if declarationPublic[declaration] == 0 {
        fail(describeLocation(location) + ": '" + alias + "." + name + "' is private to its module")
    }
    return declarationQualifiedNames[declaration]
}

function appendModuleTokens(module: Integer, modulePath: Text, tokenStart: Integer, tokenKinds: List<Integer>, tokenTexts: List<Text>, tokenLines: List<Text>, importOwners: List<Integer>, importAliases: List<Text>, importTargets: List<Integer>, declarationLookup: List<Integer>, declarationNames: List<Text>, declarationKinds: List<Integer>, declarationPublic: List<Integer>, declarationQualifiedNames: List<Text>, outputKinds: List<Integer>, outputTexts: List<Text>, outputLines: List<Text>) {
    let position = tokenStart
    let declarationMode = 0
    let declarationDepth = 0
    let functionHeader = false
    let letDeclaration = false
    let typeMode = false
    let genericDepth = 0

    while tokenKinds[position] != 0 {
        if declarationMode == 0 && tokenKinds[position] == 1 && tokenTexts[position] == "use" {
            let cursor: List<Integer> = []
            cursor.add(position)
            skipTopLevelStatement(tokenKinds, tokenTexts, cursor)
            position = cursor[0]
        } else {
            if declarationMode == 0 && tokenKinds[position] == 1 && tokenTexts[position] == "public" {
                position = position + 1
            } else {
                let token = tokenTexts[position]
                let kind = tokenKinds[position]
                let rewritten = token
                // A field/method selector belongs to its receiver. Matching an
                // import alias or local declaration name must not rewrite it.
                let memberSelector = position > tokenStart && tokenTexts[position - 1] == "."

                if declarationMode == 0 && kind == 1 && (token == "record" || token == "function") {
                    if token == "record" {
                        declarationMode = 1
                    } else {
                        declarationMode = 2
                        functionHeader = true
                    }
                } else {
                    if kind == 1 && token == "let" {
                        letDeclaration = true
                    }
                }

                if token == ":" && (declarationMode == 1 || functionHeader || letDeclaration) {
                    typeMode = true
                    genericDepth = 0
                }

                if kind == 1 && !memberSelector && position + 2 < tokenKinds.length && tokenTexts[position + 1] == "." {
                    let imported = findModuleImport(importOwners, importAliases, module, token)
                    if imported >= 0 {
                        let wantedKind = 2
                        if position + 3 < tokenKinds.length && tokenTexts[position + 3] == "(" {
                            wantedKind = 1
                        } else {
                            let importedConstant = findIndexedModuleDeclaration(declarationLookup, declarationQualifiedNames, declarationKinds, importTargets[imported], tokenTexts[position + 2], 3)
                            if !typeMode && importedConstant >= 0 {
                                wantedKind = 3
                            }
                        }
                        rewritten = importedDeclarationName(module, token, tokenTexts[position + 2], wantedKind, modulePath + ":" + tokenLines[position], importOwners, importAliases, importTargets, declarationLookup, declarationNames, declarationKinds, declarationPublic, declarationQualifiedNames)
                        addToken(outputKinds, outputTexts, outputLines, 1, rewritten, modulePath + ":" + tokenLines[position])
                        position = position + 3
                        if typeMode && genericDepth == 0 {
                            typeMode = false
                        }
                    } else {
                        addToken(outputKinds, outputTexts, outputLines, kind, rewritten, modulePath + ":" + tokenLines[position])
                        position = position + 1
                    }
                } else {
                    if kind == 1 && !memberSelector {
                        let declarationKind = 0
                        if position > 0 && tokenTexts[position - 1] == "function" {
                            declarationKind = 1
                        }
                        if position > 0 && tokenTexts[position - 1] == "record" {
                            declarationKind = 2
                        }
                        if declarationKind == 0 && position + 1 < tokenKinds.length && tokenTexts[position + 1] == "(" {
                            declarationKind = 1
                        }
                        if declarationKind == 0 && position + 1 < tokenKinds.length && tokenTexts[position + 1] == "{" {
                            declarationKind = 2
                        }
                        if declarationKind == 0 && typeMode {
                            declarationKind = 2
                        }
                        if position > 0 && tokenTexts[position - 1] == "constant" {
                            declarationKind = 3
                        }
                        // Other bare names may use a constant of this module;
                        // a following ':' names a field or parameter instead.
                        if declarationKind == 0 && !(position + 1 < tokenKinds.length && tokenTexts[position + 1] == ":") {
                            declarationKind = 3
                        }
                        // `NAME {` is a record literal unless NAME is a constant, as in `if x == NAME {`.
                        if declarationKind == 2 && !typeMode && !(position > 0 && tokenTexts[position - 1] == "record") {
                            let blockConstant = findIndexedModuleDeclaration(declarationLookup, declarationQualifiedNames, declarationKinds, module, token, 3)
                            if blockConstant >= 0 {
                                declarationKind = 3
                            }
                        }
                        if declarationKind > 0 {
                            let declaration = findIndexedModuleDeclaration(declarationLookup, declarationQualifiedNames, declarationKinds, module, token, declarationKind)
                            if declaration >= 0 {
                                rewritten = declarationQualifiedNames[declaration]
                            }
                        }
                    }
                    addToken(outputKinds, outputTexts, outputLines, kind, rewritten, modulePath + ":" + tokenLines[position])

                    if typeMode && kind == 1 && token != "List" && genericDepth == 0 {
                        typeMode = false
                    }
                    if token == "<" && typeMode {
                        genericDepth = genericDepth + 1
                    }
                    if token == ">" && genericDepth > 0 {
                        genericDepth = genericDepth - 1
                        if genericDepth == 0 {
                            typeMode = false
                        }
                    }
                    if token == ">>" && genericDepth > 0 {
                        genericDepth = genericDepth - 2
                        if genericDepth <= 0 {
                            genericDepth = 0
                            typeMode = false
                        }
                    }
                    if token == "=" || kind == 6 {
                        letDeclaration = false
                    }
                    if token == "{" && declarationMode > 0 {
                        declarationDepth = declarationDepth + 1
                        if declarationMode == 2 && declarationDepth == 1 {
                            functionHeader = false
                        }
                    }
                    if token == "}" && declarationMode > 0 {
                        declarationDepth = declarationDepth - 1
                        if declarationDepth == 0 {
                            declarationMode = 0
                            functionHeader = false
                            letDeclaration = false
                        }
                    }
                    position = position + 1
                }
            }
        }
    }
    addToken(outputKinds, outputTexts, outputLines, 6, "end of module", modulePath + ":" + tokenLines[position])
}

function compileEntry(path: Text, stackOwnerLimit: Integer): Text {
    return compileEntryWithLibrary(path, stackOwnerLimit, "")
}

function compileEntryWithLibrary(path: Text, stackOwnerLimit: Integer, library: Text): Text {
    let modulePaths: List<Text> = []
    let moduleSources: List<Text> = []
    let moduleStates: List<Integer> = []
    let modulePublic: List<Integer> = []
    let moduleTokenStarts: List<Integer> = []
    let moduleTokenKinds: List<Integer> = []
    let moduleTokenTexts: List<Text> = []
    let moduleTokenLines: List<Text> = []
    let importOwners: List<Integer> = []
    let importAliases: List<Text> = []
    let importTargets: List<Integer> = []
    let declarationStarts: List<Integer> = []
    let declarationEnds: List<Integer> = []
    let entry = loadModule(library, path, true, modulePaths, moduleSources, moduleStates, modulePublic, moduleTokenStarts, moduleTokenKinds, moduleTokenTexts, moduleTokenLines, importOwners, importAliases, importTargets, declarationStarts, declarationEnds)
    if modulePaths.length == 1 && modulePublic[0] == 0 {
        return compileTokens(moduleTokenKinds, moduleTokenTexts, moduleTokenLines, declarationStarts, declarationEnds, stackOwnerLimit)
    }

    let declarationOwners: List<Integer> = []
    let declarationNames: List<Text> = []
    let declarationKinds: List<Integer> = []
    let declarationPublic: List<Integer> = []
    let declarationQualifiedNames: List<Text> = []
    let declarationLocations: List<Text> = []
    let module = 0
    while module < modulePaths.length {
        collectModuleDeclarations(module, modulePaths[module], moduleTokenStarts[module], moduleTokenKinds, moduleTokenTexts, moduleTokenLines, declarationOwners, declarationNames, declarationKinds, declarationPublic, declarationQualifiedNames, declarationLocations)
        module = module + 1
    }
    let declarationLookup = buildSymbolLookup(declarationQualifiedNames, declarationKinds)
    requireUniqueModuleDeclarations(declarationLookup, declarationNames, declarationKinds, declarationQualifiedNames, declarationLocations)

    let tokenKinds: List<Integer> = []
    let tokenTexts: List<Text> = []
    let tokenLines: List<Text> = []
    module = 0
    while module < modulePaths.length {
        appendModuleTokens(module, modulePaths[module], moduleTokenStarts[module], moduleTokenKinds, moduleTokenTexts, moduleTokenLines, importOwners, importAliases, importTargets, declarationLookup, declarationNames, declarationKinds, declarationPublic, declarationQualifiedNames, tokenKinds, tokenTexts, tokenLines)
        module = module + 1
    }
    addToken(tokenKinds, tokenTexts, tokenLines, 0, "", "end of program")
    let scannedStarts: List<Integer> = []
    let scannedEnds: List<Integer> = []
    return compileTokens(tokenKinds, tokenTexts, tokenLines, scannedStarts, scannedEnds, stackOwnerLimit)
}

function ownershipLimitForBudget(text: Text): Integer {
    let budget = 0
    let position = 0
    let digits = "0123456789"
    while position < text.length {
        let digit = 0
        while digit < 10 && text[position] != digits[digit] { digit = digit + 1 }
        if digit == 10 { fail("cleanup budget must be a positive decimal integer") }
        if budget < 9 {
            budget = budget * 10 + digit
            if budget > 9 { budget = 9 }
        }
        position = position + 1
    }
    if budget == 0 { fail("cleanup budget must be a positive decimal integer") }
    return budget - 1
}

function main() {
    if argumentCount() == 0 {
        print("Minyar compiler bootstrap is ready")
        print(characterIsLetter('M'))
        print(characterIsDigit('x'))
    } else {
        let stackOwnerLimit = 0
        let library = ""
        let position = 2
        while position < argumentCount() {
            if argument(position) == "--bounded-owners" {
                stackOwnerLimit = 8
                if position + 1 < argumentCount() && argument(position + 1).slice(0, 1) != "-" {
                    stackOwnerLimit = ownershipLimitForBudget(argument(position + 1))
                    position = position + 1
                }
            } else {
                if argument(position) == "--library" && position + 1 < argumentCount() {
                    library = argument(position + 1)
                    position = position + 1
                } else {
                    fail("usage: compiler SOURCE OUTPUT [--bounded-owners [BUDGET]] [--library DIRECTORY]")
                }
            }
            position = position + 1
        }
        let llvm = compileEntryWithLibrary(argument(0), stackOwnerLimit, library)
        if argumentCount() == 1 {
            print(llvm)
        } else {
            writeTextFile(argument(1), llvm)
        }
    }
}
